{
    "word_family": [
        "bezwijking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e8af2e5-3c06-34ed-8662-a67d609d161a",
                    "sense_definition": "niet langer weerstand kunnen bieden aan een sterke druk, verleiding of last",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weerstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude houten brug kon de zware last niet meer dragen en is uiteindelijk <w>bezweken</w>.",
                            "target_lang_translations": {
                                "en": "The old wooden bridge could no longer carry the heavy load and eventually <w>collapsed</w>."
                            }
                        },
                        {
                            "text": "Hij probeerde op dieet te blijven, maar hij kon niet anders dan <w>bezwijken</w> voor de verleiding van de chocoladetaart.",
                            "target_lang_translations": {
                                "en": "He tried to stay on a diet, but he couldn't help but <w>succumb</w> to the temptation of the chocolate cake."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwichten",
                        "toeven",
                        "toegeven"
                    ],
                    "antonyms": [
                        "weerstaan",
                        "volhouden"
                    ],
                    "common_phrases": [
                        "bezwijken voor verleiding",
                        "bezwijken onder druk",
                        "bezwijken onder de last"
                    ],
                    "target_lang_definitions": {
                        "en": "to no longer be able to resist a strong pressure, temptation, or burden"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "succumb",
                                "target_lang_sense_clarification": "to yield to an overpowering force or desire"
                            },
                            {
                                "target_lang_word": "collapse",
                                "target_lang_sense_clarification": "to break or fall down under physical weight or pressure"
                            },
                            {
                                "target_lang_word": "give in",
                                "target_lang_sense_clarification": "to stop resisting a temptation or demand"
                            },
                            {
                                "target_lang_word": "yield",
                                "target_lang_sense_clarification": "to give way under pressure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7269356a-eeb7-3016-9a79-435ad4aa5ddf",
                    "sense_definition": "komen te overlijden als gevolg van verwondingen, ziekte of uitputting",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overlijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt is helaas in het ziekenhuis aan zijn ernstige verwondingen <w>bezweken</w>.",
                            "target_lang_translations": {
                                "en": "The patient unfortunately <w>succumbed</w> to his serious injuries in the hospital."
                            }
                        },
                        {
                            "text": "Na een lange strijd tegen de ziekte is de oude man gisteravond rustig <w>bezweken</w>.",
                            "target_lang_translations": {
                                "en": "After a long battle against the illness, the old man peacefully <w>passed away</w> last night."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlijden",
                        "sterven",
                        "inslapen"
                    ],
                    "antonyms": [
                        "overleven",
                        "genezen"
                    ],
                    "common_phrases": [
                        "bezwijken aan verwondingen",
                        "bezwijken aan de gevolgen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in een medische of formele context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to pass away as a result of injuries, illness, or exhaustion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "succumb",
                                "target_lang_sense_clarification": "to die from a specific cause like an illness or injury"
                            },
                            {
                                "target_lang_word": "pass away",
                                "target_lang_sense_clarification": "to die (polite/formal)"
                            },
                            {
                                "target_lang_word": "perish",
                                "target_lang_sense_clarification": "to die, often in a tragic or formal context"
                            }
                        ]
                    }
                }
            ]
        }
    ]
