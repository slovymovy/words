                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "103d90a5-a22f-4ec9-8785-c21eb84a80c8",
                                "sense_id": "f734b354-fdbc-3079-9f4b-2f329a5b8431",
                                "text": "Son égo est carrément surdimensionné."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a229c344-5983-45b8-8aab-4a2104805f97",
                        "source_entry_id": "4a4f188a-bcaa-3709-aa6a-3f2be0522649",
                        "source_sense_id": "59583a38-819b-39aa-b5d2-7b2729ea0487",
                        "source_sense_description": "Moi, représentation et conscience que l’on a de soi-même",
                        "target_lang_word": "ego",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ego",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66fa48f6-57a5-377c-b77c-1aeb2c9b94b3",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "The self, especially with a sense of self-importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb688b43-05ab-4602-911b-3ab97371f80d",
                                                "sense_id": "66fa48f6-57a5-377c-b77c-1aeb2c9b94b3",
                                                "text": "When every thought absorbs your attention completely, when you are so identified with the voice in your head and the emotions that accompany it that you lose yourself in every thought and every emotion, then you are totally identified with form and therefore in the grip of ego. Ego is a conglomeration of recurring thought forms and conditioned mental-emotional patterns that are invested with a sense of I, a sense of self."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc6ec39-89c9-39ba-83e2-a1c29ce2c7c7",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "The most central part of the mind, which mediates with one's surroundings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bbe6ef2-0799-400f-afce-57d280dd0c88",
                                                "sense_id": "8dc6ec39-89c9-39ba-83e2-a1c29ce2c7c7",
                                                "text": "In the well adjusted person the ego is the executive of the personality and is governed by the reality principle."
                                            },
                                            {
                                                "example_id": "996f0bbc-9721-4f1b-840f-646fe6159680",
                                                "sense_id": "8dc6ec39-89c9-39ba-83e2-a1c29ce2c7c7",
                                                "text": "‘Everything begins with “I”, you mean. Which is ego,’ said Tom, placing an ankle behind his ear, ‘not id.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb042854-c8eb-3071-a520-e2c58428f538",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "A person's self-esteem and opinion of themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df45d3f5-630f-4294-ba48-7c4f58bf5720",
                                                "sense_id": "bb042854-c8eb-3071-a520-e2c58428f538",
                                                "text": "Too many gay people \"come out\" publicly, yet fail to achieve truly healthy egos. They \"adjust\" to being less than whole or integrated persons."
                                            },
                                            {
                                                "example_id": "4c328083-448b-4af4-a331-5092ba3ec3ea",
                                                "sense_id": "bb042854-c8eb-3071-a520-e2c58428f538",
                                                "text": "My columns in the early days of the Labour government often featured John Prescott, who was in charge of transport as part of a mega-department created to match his ego."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f836272b-db8f-3895-b29c-3e5fa493494a",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "The individual from whose point of view a family tree or pedigree chart is drawn, or the reference point from whom kinship terminology is relative. (Used without the definite article the.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2102aaa-c6a8-4c17-953b-9f8c1cd76638",
                                                "sense_id": "f836272b-db8f-3895-b29c-3e5fa493494a",
                                                "text": "the cousin of ego on the father's side"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
