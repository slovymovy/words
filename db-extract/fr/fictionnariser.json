                "senses": [
                    {
                        "sense_id": "7b27b913-3324-35d9-9688-4e5a92230554",
                        "entry_id": "ae031911-dbfa-3fad-ad8f-be3090931f44",
                        "glosses": [
                            "Donner un caractère de fiction à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c757ab8a-f73d-415c-a506-f6a89a3de2d1",
                                "sense_id": "7b27b913-3324-35d9-9688-4e5a92230554",
                                "text": "La star récupère tout, « fictionnarise » le réel."
                            },
                            {
                                "example_id": "c4c2c6ed-0e8b-4e3f-8a5f-f4e4b9f9f1ee",
                                "sense_id": "7b27b913-3324-35d9-9688-4e5a92230554",
                                "text": "Il n'est plus question, désormais, de fictionnariser l'auteur de « Spirits » en le transformant en on ne sait quel martyr de LA cause…"
                            },
                            {
                                "example_id": "4ddf249b-82ba-480c-a546-7114cb615bb8",
                                "sense_id": "7b27b913-3324-35d9-9688-4e5a92230554",
                                "text": "Notamment Le Traitement de Martin Crimp qui va être créé par la Compagnie Ariadne en janvier qui traite la thématique suivante : prendre un fait divers et le « fictionnariser »."
                            }
                        ]
                    }
