                        "examples": [
                            {
                                "example_id": "fe0ab940-d19c-4fa6-a9a5-7c2a21cc28e1",
                                "sense_id": "0026ea1a-585f-32a5-866e-881c663bda03",
                                "text": "PETERBONO – À qui l’as-tu fait, ce portefeuille, et où ?\nGUSTAVE – Je l’ai fait boulevard Ravachol à un vieux monsieur avec une grande barbe blanche…\nPETERBONO achève, terrible.– Un pantalon à carreaux, un Cronstadt et un rase-pet vert olive, n’est-ce pas, imbécile ?\nGUSTAVE, tremblant. – Oui, Monsieur Peterbono… Vous m’avez vu ?\nPETERBONO tombe affalé sous ce dernier coup. – C’était moi, imbécile, c’était moi !…"
                            },
                            {
                                "example_id": "c696aa5c-dfe0-490a-a694-bb88bc7ff79a",
                                "sense_id": "0026ea1a-585f-32a5-866e-881c663bda03",
                                "text": "Elle avait marié un fils un peu simple – maintenant âgé lui aussi et toujours en rase-pet mastic – et sa particule à de l'huile qu'on vendait depuis en bouteilles étiquetées « Monsieur de… »."
                            },
                            {
                                "example_id": "45aa7580-bd94-43a5-83b4-62c70f7280e8",
                                "sense_id": "0026ea1a-585f-32a5-866e-881c663bda03",
                                "text": "On a porté jadis des rase-pets mais cela n’a certainement pas de rapport avec la veste qui nous occupe."
                            }
                        ]
                    }
