                        "entry_id": "5da94880-c2ab-316d-93c8-031d228a893d",
                        "glosses": [
                            "Having relationships with multiple partners, with the knowledge and consent of all involved; engaging in polyamory."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2637c5bf-854b-4b16-8333-6e422d74e5a9",
                                "sense_id": "3167930c-a714-3727-af7f-3e792a559ce6",
                                "text": "Being polyamorous isn't inherently wrong. Neither is desiring threesomes or kinky sex."
                            }
                        ]
                    },
