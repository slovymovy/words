{
    "word_family": [
        "mangle",
        "mangler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "55586190-d2fb-3b91-b501-1c280d033e15",
                    "sense_definition": "The present participle and gerund of <w>mangle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_of_mangling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine was <w>mangling</w> the metal sheets into unrecognizable shapes.",
                            "target_lang_translations": {
                                "ru": "Машина <w>кромсала</w> металлические листы, превращая их в неузнаваемые формы."
                            }
                        },
                        {
                            "text": "He is constantly <w>mangling</w> the pronunciation of my last name.",
                            "target_lang_translations": {
                                "ru": "Он постоянно <w>коверкает</w> произношение моей фамилии."
                            }
                        }
                    ],
                    "synonyms": [
                        "crushing",
                        "mutilating",
                        "distorting"
                    ],
                    "common_phrases": [
                        "mangling the truth",
                        "mangling a song"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «mangle» (калечить, кромсать, искажать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "калечащий",
                                "target_lang_sense_clarification": "о физическом повреждении"
                            },
                            {
                                "target_lang_word": "искажающий",
                                "target_lang_sense_clarification": "о языке, произношении или фактах"
                            },
                            {
                                "target_lang_word": "кромсающий",
                                "target_lang_sense_clarification": "о грубом разрезании или деформации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4ab29e0-9a94-30a5-948e-c3af4ed868de",
                    "sense_definition": "An instance or act of something being severely damaged, crushed, or ruined.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_of_mangling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The survivor spoke of the horrific <w>manglings</w> caused by the industrial accident.",
                            "target_lang_translations": {
                                "ru": "Выживший рассказал об ужасающих <w>увечьях</w>, вызванных аварией на производстве."
                            }
                        },
                        {
                            "text": "The critic dismissed the cover songs as mere punk <w>manglings</w> of classic pop hits.",
                            "target_lang_translations": {
                                "ru": "Критик отверг кавер-версии, назвав их просто панковским <w>искажением</w> классических поп-хитов."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutilation",
                        "distortion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или акт сильного повреждения, раздавливания или порчи чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажение",
                                "target_lang_sense_clarification": "результат порчи оригинала"
                            },
                            {
                                "target_lang_word": "уродование",
                                "target_lang_sense_clarification": "процесс нанесения увечий или деформации"
                            },
                            {
                                "target_lang_word": "коверканье",
                                "target_lang_sense_clarification": "небрежное или грубое изменение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}