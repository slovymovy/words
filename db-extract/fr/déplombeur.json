                "senses": [
                    {
                        "sense_id": "f653b490-fc26-3bcf-b7fd-4ea9aae748e3",
                        "entry_id": "b15a5b34-8ff1-3938-a934-c493c34af06b",
                        "glosses": [
                            "Pirate informatique spécialisé dans le cassage des protections de sécurité des logiciels, sites, enregistrements, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c9c1a2-d4df-4b86-8b29-74b6726602ee",
                                "sense_id": "f653b490-fc26-3bcf-b7fd-4ea9aae748e3",
                                "text": "Les développeurs, repassant derrière le déplombeur, ont répondu par une mise à jour contournant les nouvelles protections."
                            },
                            {
                                "example_id": "c38605db-ecf5-402f-8047-734fac2a8250",
                                "sense_id": "f653b490-fc26-3bcf-b7fd-4ea9aae748e3",
                                "text": "Le vocabulaire employé par cette source nécessite d’être clarifié avant d’approcher le sujet, eu égard à un certain manque de rigueur dans l’usage des termes de pirate, copieur, déplombeur ou encore cracker et hacker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e03b9265-44bc-47bf-84f4-bf8fe18aac14",
                        "source_entry_id": "b15a5b34-8ff1-3938-a934-c493c34af06b",
                        "source_sense_id": "f653b490-fc26-3bcf-b7fd-4ea9aae748e3",
                        "source_sense_description": "Sens 1",
                        "target_lang_word": "cracker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cracker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "754e8486-8ad5-3281-b682-51e82e85d1d1",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A noisy boaster; a swaggering fellow."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74dd1fe9-898c-4b02-a812-67d63a13836d",
                                                "sense_id": "754e8486-8ad5-3281-b682-51e82e85d1d1",
                                                "text": "What cracker is this same that deafs our ears?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b506b7-bc6c-3710-8cb3-13e61bafd525",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A dry, thin, crispy baked bread (usually salty or savoury, but sometimes sweet, as in the case of graham crackers and animal crackers)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf71a539-f3bf-37d3-a523-739b8f798b10",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A prawn cracker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9976934f-9838-4b0b-90ad-041d75936ade",
                                                "sense_id": "bf71a539-f3bf-37d3-a523-739b8f798b10",
                                                "text": "There was feasting and joy from Shanghai to the Wall,\nWhat with dim-sims, chop-suey and crackers and all,\nAnd the donor of these, by the hook of my crook.\nWas Chiang Ki-Konglong, the Mandarin Cook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd553449-e3e0-3908-b77e-a472fc7f7b49",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "The final section of certain whips, which is made of a short, thin piece of unravelled rope, or which is a short piece of twisted string tied to the end of the whip, which produces a distinctive cracking sound when the whip is cracked."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0a82b93-836f-37f4-8ed9-490e9f0d8945",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A firecracker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1e51462-0666-3f29-88fe-047b92f90a68",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A Christmas cracker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be058a4-9af9-4906-8221-03f72d5428c9",
                                                "sense_id": "a1e51462-0666-3f29-88fe-047b92f90a68",
                                                "text": "It is customary in every part of China to fire off crackers on the last day and night of the year for the purpose of terrifying expelling the devils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287f395a-1b8e-3982-9c1b-8f03ddf84c32",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A northern pintail, a dabbling duck of species Anas acuta."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c797c952-7617-3183-a146-388eebd7ab11",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A person or thing that breaks a thing (e.g., nutcracker)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8d88ad6-fd50-43c6-b8e2-0e73fcb1a66b",
                                                "sense_id": "c797c952-7617-3183-a146-388eebd7ab11",
                                                "text": "a lobster and crab shell cracker"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c852a12-1b55-3e31-914d-78915d579f68",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A person or thing that breaks a thing (e.g., nutcracker).",
                                            "Refinery equipment used to pyrolyse organic feedstocks. If catalyst is used to aid pyrolysis it is informally called a cat-cracker"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22f41643-5e8f-3eb4-b001-4d80e525455c",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A person or thing that breaks a thing (e.g., nutcracker).",
                                            "A pair of fluted rolls for grinding caoutchouc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7696734c-e770-3481-894c-21a23e689c2c",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A person or thing that breaks a thing (e.g., nutcracker).",
                                            "One who cracks (i.e. overcomes) computer software or security restrictions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aab3833-7274-4dc3-b149-910b0ea47dd9",
                                                "sense_id": "7696734c-e770-3481-894c-21a23e689c2c",
                                                "text": "It stated to one of the company's operators, “The Phantom, the system cracker, strikes again . . . Soon I will zero (expletive deleted) your desks and your backups on System A. I have already cracked your System B."
                                            },
                                            {
                                                "example_id": "9f74f670-b667-462f-850e-8f279dd586e9",
                                                "sense_id": "7696734c-e770-3481-894c-21a23e689c2c",
                                                "text": "Likewise, early software pirates and \"crackers\" often used phrases like \"information wants to be free\" to protest the regulations against the copying of proprietary software packages and computer systems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a4f976-078f-39f2-8d0d-c0d92041ff01",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "A fine, great thing or person (crackerjack)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86d9e492-7a3d-48d1-96bc-d73c9ef8bdfd",
                                                "sense_id": "d2a4f976-078f-39f2-8d0d-c0d92041ff01",
                                                "text": "She's an absolute cracker!"
                                            },
                                            {
                                                "example_id": "3e2df404-b403-476b-9bc0-e0da540bbace",
                                                "sense_id": "d2a4f976-078f-39f2-8d0d-c0d92041ff01",
                                                "text": "The show was a cracker!"
                                            },
                                            {
                                                "example_id": "10626038-c0fb-406d-a91f-afef7b4017c5",
                                                "sense_id": "d2a4f976-078f-39f2-8d0d-c0d92041ff01",
                                                "text": "A cracker of a day."
                                            },
                                            {
                                                "example_id": "6dbe9071-e321-4fe4-beed-562398ed450e",
                                                "sense_id": "d2a4f976-078f-39f2-8d0d-c0d92041ff01",
                                                "text": "And just before the interval, Kolarov, who was having one of his better games in a City shirt, fizzed in a cracker from 30 yards which the Wolves stopper unconvincingly pushed behind for a corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fbd7957-3a69-3ba7-8b3d-d471e376fa47",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "An ambitious or hard-working person (i.e. someone who arises at the 'crack' of dawn)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "972c66af-4f6d-3dec-8f99-36d3731234e5",
                                        "entry_id": "5d45c8d5-519d-394c-ba1c-983fbbac68a8",
                                        "glosses": [
                                            "An impoverished white person from the southeastern United States, originally associated with Georgia and parts of Florida; (by extension) any white person (slang)."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e34fa1-e1f2-4aa0-be0e-c3e5702aed30",
                                                "sense_id": "972c66af-4f6d-3dec-8f99-36d3731234e5",
                                                "text": "Brothers and the whiteys / Blacks and the crackers / Police and their backers / They're all political actors"
                                            },
                                            {
                                                "example_id": "2786fc9a-7939-4820-88f0-70c9a5cdcb0e",
                                                "sense_id": "972c66af-4f6d-3dec-8f99-36d3731234e5",
                                                "text": "Check this shit: You got cracker farm boy Luke Skywalker, Nazi poster boy, blond hair, blue eyes. And then you got Darth Vader, the blackest brother in the galaxy, Nubian god!"
                                            },
                                            {
                                                "example_id": "45b4565d-ead6-4031-829b-5712e28f8efc",
                                                "sense_id": "972c66af-4f6d-3dec-8f99-36d3731234e5",
                                                "text": "“You know that old cracker beat them boys.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
