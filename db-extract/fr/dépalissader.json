                "senses": [
                    {
                        "sense_id": "c429f80e-5cc6-37c4-a8ef-daf98128d923",
                        "entry_id": "04387378-ca5a-3019-82d6-5317aa3c595b",
                        "glosses": [
                            "Enlever la palissade de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8c12dd-2b14-4284-9eb6-9d595061326f",
                                "sense_id": "c429f80e-5cc6-37c4-a8ef-daf98128d923",
                                "text": "Pour réduire cette place à une extrême faiblesse, il suffirait de détruire le fort de la Briqueterie, les lunettes, les traverses, les batardeaux. et les écluses, saigner l'inondation et dépalissader le chemin couvert; pour l'annihiler, il faut raser le Michelsberget le front qui lui fait face."
                            },
                            {
                                "example_id": "dc3c9877-b655-4ab0-8d26-fe07e2e623bb",
                                "sense_id": "c429f80e-5cc6-37c4-a8ef-daf98128d923",
                                "text": "Nos ouvrages sont parvenus à 80 toises de la place ; nous avons même plusieurs fois insulté et dépalissadé les chemins couverts."
                            }
                        ]
                    }
                ],
