                "senses": [
                    {
                        "sense_id": "99ba6a72-f1e0-37b1-8878-b30adad7a3ad",
                        "entry_id": "0abbeaf6-016f-3b5a-ae0e-5cfafe09586c",
                        "glosses": [
                            "jemand, der an einer Wallfahrt teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de2508c0-5d9d-4759-bef9-7d50357b60a7",
                                "sense_id": "99ba6a72-f1e0-37b1-8878-b30adad7a3ad",
                                "text": "„Als sich 1879 \"wunderbare Gebetserhörungen\" herumsprachen, pilgerten immer mehr Menschen zu dieser Kirche, in der seit 1881 Messen für die Wallfahrer gelesen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f8f1105-85ba-4297-b1a4-4ea9a8f54ec3",
                        "source_entry_id": "0abbeaf6-016f-3b5a-ae0e-5cfafe09586c",
                        "source_sense_id": "99ba6a72-f1e0-37b1-8878-b30adad7a3ad",
                        "source_sense_description": "jemand, der an einer Wallfahrt teilnimmt",
                        "target_lang_word": "pilgrim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
