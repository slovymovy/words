                ],
                "senses": [
                    {
                        "sense_id": "675c5764-8cef-3a56-8c89-fb62edaee685",
                        "entry_id": "05cbcf6c-3c46-3c05-b6be-dd34371aa939",
                        "glosses": [
                            "Aufhebens, Gebaren"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "oftmals abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "5eba9aed-d984-4bd5-8871-6698bc27f1e0",
                                "sense_id": "675c5764-8cef-3a56-8c89-fb62edaee685",
                                "text": "Nachdem wir Julian erklärt hatten, dass sein Ansinnen undurchführbar sein würde, gab es deswegen auch kein großes Gewese mehr."
                            },
                            {
                                "example_id": "520855e2-c64c-4bb5-8fb1-6e8f190f46bd",
                                "sense_id": "675c5764-8cef-3a56-8c89-fb62edaee685",
                                "text": "Es wird wegen Noras Krankheit immer ein riesiges Gewese veranstaltet."
                            },
                            {
                                "example_id": "1574c763-05a0-4622-97fa-50d180f41d15",
                                "sense_id": "675c5764-8cef-3a56-8c89-fb62edaee685",
                                "text": "„Ich habe von der wegen Nichtbeachtung ausgefallenen Lesung kein großes Gewese gemacht; aus gutem Grund, man erzählt nicht gern von Niederlagen, solange die Wunden noch nicht vernarbt sind.“"
                            },
                            {
                                "example_id": "166743d4-30ac-4691-bd28-71b83ea0593d",
                                "sense_id": "675c5764-8cef-3a56-8c89-fb62edaee685",
                                "text": "„Ums Kapieren wird ja sowieso viel zuviel Gewese gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09dcdb8f-7ea2-38ce-b8b3-457b7a5a50de",
                        "entry_id": "05cbcf6c-3c46-3c05-b6be-dd34371aa939",
                        "glosses": [
                            "Anwesen"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "c85c0bc4-4311-4b1e-9000-eead11f05a53",
                                "sense_id": "09dcdb8f-7ea2-38ce-b8b3-457b7a5a50de",
                                "text": "Brunhilde hat nach dem Tod ihres Erbonkels nun dessen Gewese mit jeder Menge Personal an der Backe."
                            },
                            {
                                "example_id": "40184057-538c-4217-8447-8c9adfd036f0",
                                "sense_id": "09dcdb8f-7ea2-38ce-b8b3-457b7a5a50de",
                                "text": "Dieses Gewese, das sich die Lohmanns zugelegt haben, ist ja viel zu groß für sie."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87c505d0-5c7d-4956-9776-a636ce7458d8",
                        "source_entry_id": "05cbcf6c-3c46-3c05-b6be-dd34371aa939",
                        "source_sense_id": "675c5764-8cef-3a56-8c89-fb62edaee685",
                        "source_sense_description": "umgangssprachlich, oftmals abwertend: Aufhebens, Gebaren",
                        "target_lang_word": "fuss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "Excessive activity, worry, bother, or talk about something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "676b296a-8496-48cf-84a5-fe234e6e5ff4",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "They made a big fuss about the wedding plans."
                                            },
                                            {
                                                "example_id": "02b41447-ebaa-46d8-85f9-afc5e82bd71d",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "What's all the fuss about?"
                                            },
                                            {
                                                "example_id": "a1419121-d9ca-4b22-a059-ac83f79bf8e4",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "Sickness did not last above a ten days; my poor wife zealously assiduous, and with a minimum of fuss or noise."
                                            },
                                            {
                                                "example_id": "b3fcd38e-98fb-4572-ab17-82aed8b3656e",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "“Anthea hasn't a notion in her head but to vamp a lot of silly mugwumps. She's set her heart on that tennis bloke[…]whom the papers are making such a fuss about.”"
                                            },
                                            {
                                                "example_id": "0564d516-79ea-4755-a82e-3b7e0b4761a8",
                                                "sense_id": "66bce4ea-d562-3a62-8bfa-66ac190b1d10",
                                                "text": "But in the reader comments section beneath the FT piece, many couldn’t understand what all the fuss was about. “I’m surprised to see the FT reporting this sort of thing,” one person wrote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1316775d-0d76-39ed-9e33-667951302405",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "A complaint or noise; a scene."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b060867-8f98-4bef-a8b4-e16d5ed6ab82",
                                                "sense_id": "1316775d-0d76-39ed-9e33-667951302405",
                                                "text": "If you make enough of a fuss about the problem, maybe they'll fix it for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c0fad0-e85d-3557-a8c3-27679a23b5dd",
                                        "entry_id": "f667c975-b116-38e7-ada6-78ca63903fd1",
                                        "glosses": [
                                            "An exhibition of affection or admiration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af648191-e585-47cb-aefc-8f50f707fa5e",
                                                "sense_id": "46c0fad0-e85d-3557-a8c3-27679a23b5dd",
                                                "text": "They made a great fuss over the new baby."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fuss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To be very worried or excited about something, often too much."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7855fbb-09d3-4e02-9016-9cb7d6e48424",
                                                "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                                "text": "His grandmother will never quit fussing over his vegetarianism."
                                            },
                                            {
                                                "example_id": "108d311a-8c7d-4e1b-9371-2ae4e6caf13b",
                                                "sense_id": "035dd445-9847-32f5-8863-8881cbcab842",
                                                "text": "Dear reader, spare me. I don't hate men, I love them; I eat 'em for breakfast. But it seems to me that fussing about masculinity is intimately related to homophobia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d48dc032-5d36-3ec0-80f1-f1df243afe31",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To fiddle; fidget; wiggle, or adjust"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f238fdd1-17a2-4573-874c-55b094e7f28d",
                                                "sense_id": "d48dc032-5d36-3ec0-80f1-f1df243afe31",
                                                "text": "Quit fussing with your hair. It looks fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b22380d-0ff2-32e8-876a-5ca60064428a",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To disturb (a person)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1edbf749-f840-3c79-bd53-e489b8344a51",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To cry or be ill-humoured."
                                        ],
                                        "tags": [
                                            "US",
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d072b864-e8ca-3c61-b489-47aabb3d3587",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To show affection for, especially animals."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d6a9f07-37b0-38b6-a8aa-5380d0f0d420",
                                        "entry_id": "dbf56873-24ab-3c30-968f-abdc7cebcf04",
                                        "glosses": [
                                            "To pet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dec1747-3971-4fa6-b4a5-0b019b78a969",
                                                "sense_id": "3d6a9f07-37b0-38b6-a8aa-5380d0f0d420",
                                                "text": "He fussed the cat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2370694d-b152-4ab2-bc36-e2e9799803a0",
                        "source_entry_id": "05cbcf6c-3c46-3c05-b6be-dd34371aa939",
                        "source_sense_id": "675c5764-8cef-3a56-8c89-fb62edaee685",
                        "source_sense_description": "umgangssprachlich, oftmals abwertend: Aufhebens, Gebaren",
                        "target_lang_word": "chiqué",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiqué",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f29767-eb8b-3e57-a660-dcc92b54573b",
                                        "entry_id": "e7554c42-9d21-311b-ab79-5ca9c5c2098a",
                                        "glosses": [
                                            "Excès d’élégance, fausse apparence dans un désir d’impressionner, bluff, simulation."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "309cc748-2bf6-4db0-93d9-e0f2417e440e",
                                                "sense_id": "a3f29767-eb8b-3e57-a660-dcc92b54573b",
                                                "text": "Sur cette même chaise longue sur laquelle j’étais assis, ma récente amie, dans les jours ordinaires, devait certainement faire l’amour et un peu de chiqué avec des messieurs divers, sans y attacher, non plus qu’eux, beaucoup d’importance. Un peu de satisfaction, un peu d’argent, et chacun s’en va content, ne pensant déjà plus aux gestes qu’il vient de faire."
                                            },
                                            {
                                                "example_id": "f2cf8d46-7879-4003-9465-1f4f07b92f33",
                                                "sense_id": "a3f29767-eb8b-3e57-a660-dcc92b54573b",
                                                "text": "Ah, comtesse ! Mais alors il n’y a que du maquillage, de artificiel, du chiqué ici, pour les hommes comme pour les fleurs ?"
                                            },
                                            {
                                                "example_id": "470c27ba-c5d4-4ea8-9cc8-26b2caeeb41c",
                                                "sense_id": "a3f29767-eb8b-3e57-a660-dcc92b54573b",
                                                "text": "Ah ! mais, je commence à en avoir assez, de vous autres et de vos simagrées. Je sais ce que vous valez, à présent, vous tous, et votre guerre, et votre Empire, et votre trompe-l’œil… De la camelote, tout ça, du chiqué !"
                                            },
                                            {
                                                "example_id": "082b1086-df77-442d-97a8-565ae8fdc758",
                                                "sense_id": "a3f29767-eb8b-3e57-a660-dcc92b54573b",
                                                "text": "Rien ne le gênait aussi cruellement que d’être obligé de lire à haute voix un passage lyrique ; il ricanait, il rougissait, il n’en pouvait plus de dégoût, de honte : « Quel chiqué ! »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
