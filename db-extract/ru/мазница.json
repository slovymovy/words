                        "entry_id": "25f9cc8c-7bf1-39a2-8317-67a98cafef2f",
                        "glosses": [
                            "устар., рег. деревянная или глиняная посудина для дёгтя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6da627-f0e2-41e9-b957-cdfc968fc450",
                                "sense_id": "8db90cd0-be48-3282-a59f-c1f5b5cc63cd",
                                "text": "Исправьте возы и мазницы, испробуйте оружье."
                            }
                        ]
                    },
                    {
                        "sense_id": "b29888d2-f416-39f4-aa6f-1ea5843d9a06",
                        "entry_id": "25f9cc8c-7bf1-39a2-8317-67a98cafef2f",
                        "glosses": [
                            "кисть для намазывания чего-либо; помазок, мазилка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eafea49-9bda-4ada-89d9-cf80a1479a98",
                                "sense_id": "b29888d2-f416-39f4-aa6f-1ea5843d9a06",
                                "text": "― Шире шаг! ― свирепо крикнул роте Качуровский. ― Тянутся, как татарская мазница! Чёртово быдло! Выше ногу!"
                            }
                        ]
                    }
