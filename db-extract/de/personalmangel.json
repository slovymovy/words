                "senses": [
                    {
                        "sense_id": "50e01127-e732-39d3-95fd-4b8499243f6b",
                        "entry_id": "1619ca2f-62f4-37a0-8830-294ec132e0b1",
                        "glosses": [
                            "Manque de personnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938d1b1f-255d-40ca-b4c4-ee90cd0f56ff",
                                "sense_id": "50e01127-e732-39d3-95fd-4b8499243f6b",
                                "text": "Der Luftverkehr hat mit Personalmangel in der Hochsaison zu kämpfen, vor allem bei Bodendiensten, zum Teil aber auch bei Flugbegleitern.",
                                "translation": "Le transport aérien est confronté à un manque de personnel en haute saison, surtout dans les services au sol, mais aussi en partie dans le personnel de cabine."
                            },
                            {
                                "example_id": "68208c7e-8045-4419-b1a6-e2f4bf928c2d",
                                "sense_id": "50e01127-e732-39d3-95fd-4b8499243f6b",
                                "text": "Aufgrund des extremen Personalmangels fallen Flüge aus, die Abfertigung an den Airports dauert mitunter so lange, dass Passagier:innen ihren Flug verpassen.",
                                "translation": "En raison du manque extrême de personnel, des vols sont annulés et le temps d’enregistrement dans les aéroports est parfois si long que les passagers ratent leur vol."
                            }
                        ]
                    }
                ],
