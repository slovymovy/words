                    {
                        "translation_id": "cfded484-0d93-439c-baba-816a6956ec81",
                        "source_entry_id": "f6878bc0-21df-31f7-8a03-01f28ca8e9c0",
                        "source_sense_id": "76195d4f-aa97-3a04-9249-79b72ddbc27c",
                        "target_lang_word": "актиний",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
