                "senses": [
                    {
                        "sense_id": "46222453-265f-3761-b24b-e177c7283eb2",
                        "entry_id": "6e8acde4-ebcb-3f64-9ede-aaa27b25d5a3",
                        "glosses": [
                            "Fürst eines Landes"
                        ],
                        "tags": [
                            "gehoben",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f36c9afb-e761-4e6c-97c8-4a69f2795d86",
                                "sense_id": "46222453-265f-3761-b24b-e177c7283eb2",
                                "text": "„Auch auf dem Reisemarkt am 24. März werden zahlreiche Stände Angebote rund um den markanten Jubilar präsentieren, der als Feldherr und kunstliebender Schöngeist, sarkastisches Rauhbein und aufgeklärter Landesvater früh zum Mythos wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23b3753d-4307-3d60-abe9-91f10aa3d258",
                        "entry_id": "6e8acde4-ebcb-3f64-9ede-aaa27b25d5a3",
                        "glosses": [
                            "Oberhaupt eines Staates oder eines Bundeslandes"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "cda91604-1aab-41c5-a367-11b2b05a15bd",
                                "sense_id": "23b3753d-4307-3d60-abe9-91f10aa3d258",
                                "text": "„Dennoch wird der national gesinnte Briefschreiber deutscher Zunge den Entschluss unseres Landesvaters bedauern.“"
                            },
                            {
                                "example_id": "8460cc34-a2b1-4493-88e2-011d151e30d2",
                                "sense_id": "23b3753d-4307-3d60-abe9-91f10aa3d258",
                                "text": "„So erschien er als der besorgte Landesvater, der mit den Übergriffen direkt nichts zu tun hatte und der sich für ihre Beendigung einsetzen wollte, während er in Wirklichkeit die Aktion befehligte und steuerte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "548368b0-4d51-3915-8b95-e2a820dc9e05",
                        "entry_id": "6e8acde4-ebcb-3f64-9ede-aaa27b25d5a3",
                        "glosses": [
                            "Gatte einer Landesmutter oder eines Landesvaters [2]"
                        ],
                        "tags": [
                            "humorous",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b3298fb0-3b14-4805-82a6-92d56704cc07",
                                "sense_id": "548368b0-4d51-3915-8b95-e2a820dc9e05",
                                "text": "2019 avancierte der Ex-Fußballer Markus Räikkönen zum Landesvater, als seine Gemahlin finnische Ministerpräsidentin wurde."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
