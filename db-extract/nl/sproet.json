                    {
                        "translation_id": "2c1e4232-7017-432c-b20c-5011b77088d7",
                        "source_entry_id": "068fb326-6ff1-34f1-9ff8-4bdfb8015e0b",
                        "source_sense_id": "0b45444d-51a5-35e0-a06b-87907c6acfea",
                        "source_sense_description": "een bruin vlekje op de huid dat veroorzaakt wordt door ultraviolet licht",
                        "target_lang_word": "tache de rousseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tache de rousseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d503ecd-3ecb-34b6-aa66-15f02537a3eb",
                                        "entry_id": "30051617-18c4-31e0-abb2-d68991653085",
                                        "glosses": [
                                            "Pigmentation de taches rousses sur la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddaf372b-1e09-4283-9354-7ed9a522f0df",
                                                "sense_id": "9d503ecd-3ecb-34b6-aa66-15f02537a3eb",
                                                "text": "D’ailleurs pas une seule de ces taches de rousseur, qui font payer à ces blondes dorées leur blancheur lactée, n’altérait son teint."
                                            },
                                            {
                                                "example_id": "43320f0d-15ba-4ba5-8f3f-b97631fe3998",
                                                "sense_id": "9d503ecd-3ecb-34b6-aa66-15f02537a3eb",
                                                "text": "Ses joues étaient couvertes de taches de rousseur si nombreuses, que sa figure avait une vague ressemblance avec un abricot piqueté"
                                            },
                                            {
                                                "example_id": "f118d85f-65fd-4566-9c2f-f4dfe27abdf5",
                                                "sense_id": "9d503ecd-3ecb-34b6-aa66-15f02537a3eb",
                                                "text": "Quelques petites taches de rousseur, semblables aux mouches du dix-huitième siècle, disent que Modeste est bien une fille de la terre, et non l’une de ces créations rêvées en Italie par l’École Angélique."
                                            },
                                            {
                                                "example_id": "c71f23ab-5ce2-4d41-8866-0fe939905d43",
                                                "sense_id": "9d503ecd-3ecb-34b6-aa66-15f02537a3eb",
                                                "text": "La plus jolie vous paraîtra avoir des taches de rousseur, mais c’est qu’avant de l’admirer, vous aurez regardé le soleil."
                                            },
                                            {
                                                "example_id": "7c842a89-ad0c-425a-a646-017710036753",
                                                "sense_id": "9d503ecd-3ecb-34b6-aa66-15f02537a3eb",
                                                "text": "– Travaillant sans chapeau comme tu fais, comment peux-tu éviter les taches de rousseur sur ton visage ? Tu as donc la peau bien épaisse !"
                                            },
                                            {
                                                "example_id": "23438de6-c769-4698-ae46-376f7cebba9f",
                                                "sense_id": "9d503ecd-3ecb-34b6-aa66-15f02537a3eb",
                                                "text": "Il avait un visage d’une rondeur enfantine, avec un nez camus, semé de taches de rousseur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
