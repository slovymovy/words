                "senses": [
                    {
                        "sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                        "entry_id": "ecf596dd-5fb7-3b23-bc93-ee47beb3995d",
                        "glosses": [
                            "gezielt geförderte Assimilation der nichtungarischen Bevölkerung; Anpassung an ungarische Gegebenheiten und Sitten"
                        ],
                        "tags": [
                            "Frühe Neuzeit"
                        ],
                        "examples": [
                            {
                                "example_id": "c6711035-3bb6-4de9-8d1f-98616a4824c5",
                                "sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                                "text": "„Die dunkelste Epoche erlebten die Deutschstämmigen in der ersten Hälfte des 20. Jahrhunderts: Erst waren sie gemeinsam mit den Slowaken einer rücksichtslosen Magyarisierung durch die ungarische Krone ausgesetzt […].“"
                            },
                            {
                                "example_id": "e0670451-9a60-4b4d-bcff-a4b0de4d4cea",
                                "sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                                "text": "„Zuerst kostete die Magyarisierung des Namens 5 Gulden, später ward die Gebühr auf 50 Kreuzer herabgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "845ee0cf-a8ce-4e3c-84ba-2a7b776d70b1",
                        "source_entry_id": "ecf596dd-5fb7-3b23-bc93-ee47beb3995d",
                        "source_sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                        "target_lang_word": "Magyarization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magyarization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "460701f7-f7e8-39a0-9f94-2249dd059475",
                                        "entry_id": "573f3dc4-a592-3f73-ab5a-13c2820f39b2",
                                        "glosses": [
                                            "The state or process of being Magyarized; assimilation to Hungarian language or culture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1cac6a3-a4d7-448f-8841-14763a53f6f9",
                                                "sense_id": "460701f7-f7e8-39a0-9f94-2249dd059475",
                                                "text": "The main instrument of Magyarization continued to be the schools."
                                            },
                                            {
                                                "example_id": "72c706e1-bea6-4742-8543-c1a8407d39eb",
                                                "sense_id": "460701f7-f7e8-39a0-9f94-2249dd059475",
                                                "text": "In the face of such resentment, the process of ‘Magyarization’ really was relentless – a Slovak could sit in his mountain fastness in a folk costume or he could move to Budapest or Transdanubia, learn Hungarian and get a factory job."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c915502-9bad-447c-b2b7-bfc1198c4a0f",
                        "source_entry_id": "ecf596dd-5fb7-3b23-bc93-ee47beb3995d",
                        "source_sense_id": "9c9c0105-8d7d-3628-be97-f4bc073e2e96",
                        "target_lang_word": "magyarisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magyarisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "621dfa57-cc66-3977-a441-5ce9109bf9dc",
                                        "entry_id": "42dcdf5f-3478-38b6-afba-3f4250645e20",
                                        "glosses": [
                                            "Action de rendre hongrois, de donner le caractère magyar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d928f6fd-f65f-4c57-97e6-58acf72dcc9b",
                                                "sense_id": "621dfa57-cc66-3977-a441-5ce9109bf9dc",
                                                "text": "A partir du Compromis, ils [les révolutionnaires hongrois] ont entrepris à l’égard de leur propres minorités nationales une véritable politique de magyarisation, ce qui a eu pour conséquence d’« exacerber les sentiments nationaux des Slaves de l’Empire »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
