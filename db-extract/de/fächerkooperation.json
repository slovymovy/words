                ],
                "senses": [
                    {
                        "sense_id": "86b9298f-bc4c-3298-97f8-cba8d632545f",
                        "entry_id": "78746a81-c87c-37f2-92d5-b18457b4dc80",
                        "glosses": [
                            "Zusammenarbeit unterschiedlicher Fachgebiete zur sachgerechten Erschließung einer komplexen Thematik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9121a81-a46f-493a-a133-2be3f0421433",
                                "sense_id": "86b9298f-bc4c-3298-97f8-cba8d632545f",
                                "text": "„Die hochgradige Komplexität des Lernfeldes erfordert Fächerkooperation, die sich zum Prinzip der Subsidiarität bekennt: Jedes beteiligte Fach beschränkt sich auf jene Aufgaben, die es besser lösen kann als andere Fächer.“"
                            },
                            {
                                "example_id": "de27a770-8630-4f9b-872c-f103f0513f56",
                                "sense_id": "86b9298f-bc4c-3298-97f8-cba8d632545f",
                                "text": "„Ziel der Fächerkooperation war die Vermittlung eines möglichst anschaulichen geschlossenen Mosaikbildes des Subkontinents mit seiner Landschaft, seiner Vegetation, seinen Tieren und Menschen, ihren Lebensbedingungen, Lebensgewohnheiten und geistigen Vorstellungen.“"
                            },
                            {
                                "example_id": "de7f885d-e08c-431f-82a4-f491c35cb079",
                                "sense_id": "86b9298f-bc4c-3298-97f8-cba8d632545f",
                                "text": "„In den Beschreibungen der Lernenden kommt zum Ausdruck, dass die Umsetzung der Idee der phasenbezogenen Fächerkooperation nicht den Erwartungen entspricht.“"
                            },
                            {
                                "example_id": "f97f77bc-fa75-453b-a13a-2b524e20d094",
                                "sense_id": "86b9298f-bc4c-3298-97f8-cba8d632545f",
                                "text": "„Damit ist eine Vorstellung angesprochen, die davon ausgeht, dass wir auf der einen Seite die verwaltungs- und haushaltsrechtlichen Verankerungen der einzelnen wissenschaftlichen Einrichtungen haben und auf der anderen Seite die fachlichen Zuordnungen, die organisatorischen Voraussetzungen für Fächerkooperationen.“"
                            },
                            {
                                "example_id": "4260dcab-6e8d-43d8-ba25-919eaf5d9a88",
                                "sense_id": "86b9298f-bc4c-3298-97f8-cba8d632545f",
                                "text": "„Weitere Präsentationen und Übungsmaterialien für die universitäre Lehrerausbildung sowie für Fortbildungsmaßnahmen wurden erarbeitet und bestehende Konzepte auf die Fächer Physik, Musik und Chemie ausgeweitet. Weitere Fächerkooperationen sind gegenwärtig in Arbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
