                        "entry_id": "39ea165e-6955-384b-a8c2-aef8ea6c026a",
                        "glosses": [
                            "In a satisfactory manner, in a manner adequate to requirements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0df1cdf-35e7-427e-826d-638e29de528b",
                                "sense_id": "d598d30d-5605-3dbf-bf8e-dfff039e8db9",
                                "text": "This is a task which has not yet been satisfactorily performed and which will have to be achieved before this particular impulse toward socialism can be removed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d42b987-74b9-4730-96b8-8a79888a7508",
