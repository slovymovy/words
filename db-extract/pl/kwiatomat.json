                ],
                "senses": [
                    {
                        "sense_id": "f3446d94-a8a0-3b11-9adf-e308439d5135",
                        "entry_id": "da032daa-4cff-3d03-a0ad-dcf5e2a3b6d9",
                        "glosses": [
                            "automat sprzedający bukiety kwiatów"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "c28471fe-828c-4df7-8c8b-5f71dbeeb01a",
                                "sense_id": "f3446d94-a8a0-3b11-9adf-e308439d5135",
                                "text": "Kwiatomaty działają identycznie jak automaty z przekąskami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7c5b338-b923-405e-95a1-89d1e54b5933",
                        "source_entry_id": "da032daa-4cff-3d03-a0ad-dcf5e2a3b6d9",
                        "source_sense_id": "f3446d94-a8a0-3b11-9adf-e308439d5135",
                        "target_lang_word": "flower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "528fc711-149a-321d-9c4d-1f61c8b9348e",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "A colorful, conspicuous structure associated with angiosperms, frequently scented and attracting various insects, and which may or may not be used for sexual reproduction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc3e5002-aa5e-43ba-a647-1b196082348e",
                                                "sense_id": "528fc711-149a-321d-9c4d-1f61c8b9348e",
                                                "text": "O Laurinella! little doſt thou wot / How fraile a flower thou doſt ſo highly prize: / Beauty's the flower, but love the flower-pot / That muſt preſerve it, els it quickly dyes."
                                            },
                                            {
                                                "example_id": "51d04b35-250b-4769-a08a-6afd6c18749a",
                                                "sense_id": "528fc711-149a-321d-9c4d-1f61c8b9348e",
                                                "text": "The flowers glowed red and golden: snapdragons and sunflowers, and nasturtians trailing all over the turf walls and peeping in at the round windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89d190b3-d198-3061-9e23-6b7287f26ffb",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "A reproductive structure in angiosperms (flowering plants), often conspicuously colourful and typically including sepals, petals, and either or both stamens and/or a pistil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76710200-5f86-42c8-8f13-8cf39294a7b4",
                                                "sense_id": "89d190b3-d198-3061-9e23-6b7287f26ffb",
                                                "text": "You know, Darwin studied their fertilisation, and showed that the whole structure of an ordinary orchid flower was contrived in order that moths might carry the pollen from plant to plant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea5eb94a-f2de-303c-afad-8892e44f8159",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "A plant that bears flowers, especially a plant that is small and lacks wood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af95aa0d-3ce7-456d-94a1-368386a8387a",
                                                "sense_id": "ea5eb94a-f2de-303c-afad-8892e44f8159",
                                                "text": "We transplanted the flowers to a larger pot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa367a1-82e6-3fea-a0cc-10d81b7f3def",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "The stem of a flowering plant with the blossom or blossoms attached, used for decoration, as a gift, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b13167e7-b305-4853-b653-aa55279d4d2f",
                                                "sense_id": "3fa367a1-82e6-3fea-a0cc-10d81b7f3def",
                                                "text": "He always keeps a vase full of flowers in his office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1765de5b-41b0-3c19-8471-77fbb5caec5f",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "Of plants, a state of bearing blooms."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a35ab41f-e9df-42ed-a76f-d60f8e7cf0eb",
                                                "sense_id": "1765de5b-41b0-3c19-8471-77fbb5caec5f",
                                                "text": "The dogwoods are in flower this week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3602618-e2bd-31da-b248-1a51f9d47cb5",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "The vulva, especially the labia majora."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "familiar",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59cd9040-3640-455b-8b79-a84836b3b68a",
                                                "sense_id": "f3602618-e2bd-31da-b248-1a51f9d47cb5",
                                                "text": "[F]or ſtill, that my virgin-flower was yet uncrop'd never once enter'd into his head, and he would have thought it idling with time and words to have queſtion'd me upon it.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "0ccd60b0-65d7-474b-9972-ebfcafef0d14",
                                                "sense_id": "f3602618-e2bd-31da-b248-1a51f9d47cb5",
                                                "text": "So was it asserted, that whenever a maiden was destined to die unmarried, as surely would the plant wither away and perish, and if a dughter of the Renseccos lost her honour or had given away her flower to an unworthy lover, then would the flower be blighted overnight."
                                            },
                                            {
                                                "example_id": "75f88a8a-8603-46f8-b096-2d5a1a22bdd2",
                                                "sense_id": "f3602618-e2bd-31da-b248-1a51f9d47cb5",
                                                "text": "In some local tradditions a fallen bride was married wearing a crown of straw rather than a garland of flowers, to symbolize her loss of virginity – the wilting of her flower."
                                            },
                                            {
                                                "example_id": "a5720611-c5af-4003-89cb-64d1544bba81",
                                                "sense_id": "f3602618-e2bd-31da-b248-1a51f9d47cb5",
                                                "text": "\"Our flesh as one!\" he laughed, speaking loudly. \"Sweating bodies entwined in carnal passion! As I plunge myself deep into her lady flower, again and again and again— !\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92552f97-5710-35f1-8228-99da84a290ac",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "The best examples or representatives of a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2bc217-5bf8-470f-a9b2-826bb6860ff4",
                                                "sense_id": "92552f97-5710-35f1-8228-99da84a290ac",
                                                "text": "At Floddon hyllys, / Our bowys, our byllys / Slew all the floure / Of theyr honoure."
                                            },
                                            {
                                                "example_id": "16116bc2-c255-47a5-b509-ea0a906fcdcb",
                                                "sense_id": "92552f97-5710-35f1-8228-99da84a290ac",
                                                "text": "The choice and flower of all things profitable the Psalms do more briefly contain."
                                            },
                                            {
                                                "example_id": "7479d9e0-2a28-4f9f-86d0-e289118c7e62",
                                                "sense_id": "92552f97-5710-35f1-8228-99da84a290ac",
                                                "text": "the flower of the chivalry of all Spain"
                                            },
                                            {
                                                "example_id": "e6f384ab-8cbf-439b-bec7-a33638c0c4a9",
                                                "sense_id": "92552f97-5710-35f1-8228-99da84a290ac",
                                                "text": "In times of peace, so clean and bright, / And with a new-washed morning face, / He walked Pall Mall, a goodly sight, / The finished flower of all the race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54397715-9e15-346f-8887-2a6be79963bb",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "The best state of things; the prime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9d3fb8d-cf66-4c56-a3f8-02dc83fb5cdc",
                                                "sense_id": "54397715-9e15-346f-8887-2a6be79963bb",
                                                "text": "She was in the flower of her life."
                                            },
                                            {
                                                "example_id": "39c0c034-b8c7-4fb9-bca3-39864e093956",
                                                "sense_id": "54397715-9e15-346f-8887-2a6be79963bb",
                                                "text": "A simple maiden in her flower / Is worth a hundred coats-of-arms."
                                            },
                                            {
                                                "example_id": "c7f718b3-536b-464b-8958-bbae9ca18a87",
                                                "sense_id": "54397715-9e15-346f-8887-2a6be79963bb",
                                                "text": "NO lady fair in hall or bower, / In days when knighthood was in flower, / Or high-born dame with jewels set, / Or Tudor or Plantagenet, / E’er wore enwreath’d on form and face / Thy royal robe of richest grace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e148a3-633d-3513-9624-0eba69e987b1",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "Flour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9465ba-98c5-4fe1-8b0f-dfe8ed8e7d87",
                                                "sense_id": "14e148a3-633d-3513-9624-0eba69e987b1",
                                                "text": "The Flovvers of Grains mix'd vvith VVater vvill make a ſort of Glue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9957ad6-7464-3059-a175-82594fc4c006",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "A substance in the form of a powder, especially when condensed from sublimation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ca7436f-839b-4450-83d8-ac6467be6cb2",
                                                "sense_id": "e9957ad6-7464-3059-a175-82594fc4c006",
                                                "text": "the flowers of sulphur"
                                            },
                                            {
                                                "example_id": "4f668585-ecfa-401f-8d46-cf0b195d7f65",
                                                "sense_id": "e9957ad6-7464-3059-a175-82594fc4c006",
                                                "text": "Exposed to a moderate fire in subliming pots, [brimstone] rises all into dry, and almost tasteless, flowers; whereas being exposed to a naked fire, it affords store of a saline and fretting liquor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3481804f-0ae5-363a-8666-e871e2f77f98",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "A figure of speech; an ornament of style."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "974731e7-4e59-3a13-8a38-9dd78f1f1366",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "Ornamental type used chiefly for borders around pages, cards, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bce756d8-2bb1-40b9-8bf1-b8243929efe9",
                                                "sense_id": "974731e7-4e59-3a13-8a38-9dd78f1f1366",
                                                "text": "I pointed out to the late Mr. Catherwood, of the firm of Caslon and Catherwood, the inconvenience of both these modes of cutting flowers,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aab03ff-552c-3409-aa51-9292e2c30020",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "Menstrual discharges."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae38d242-13e2-4832-8cc4-50eda905f040",
                                                "sense_id": "8aab03ff-552c-3409-aa51-9292e2c30020",
                                                "text": "And if any man lye with her at all, and her flowers be vpon him, hee shall be vncleane seuen dayes: and all the bed whereon he lyeth, shall be vncleane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebc1ad05-b907-3834-966c-070a7ed725e4",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "A delicate, fragile, or oversensitive person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8b1bc62-2e94-4b09-9d62-01f1864cdd62",
                                                "sense_id": "ebc1ad05-b907-3834-966c-070a7ed725e4",
                                                "text": "[…] she whispered leaning over and kissing her forehead; and then added, 'Mummy loves you, precious flower.'"
                                            },
                                            {
                                                "example_id": "b40098f7-7182-4fa0-bd3c-40a8c1a0303d",
                                                "sense_id": "ebc1ad05-b907-3834-966c-070a7ed725e4",
                                                "text": "“Take care of yourself out there, Brown, you delicate flower.”"
                                            },
                                            {
                                                "example_id": "47aad013-be7c-4ffe-9b7a-e63989ce8b91",
                                                "sense_id": "ebc1ad05-b907-3834-966c-070a7ed725e4",
                                                "text": "“Come on, you delicate flower, we just need to nap. It will be fine.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91fc5c96-e4db-35fc-9371-85d07063dba1",
                                        "entry_id": "3ba908ad-8018-3ce2-9774-8eb69469f7f2",
                                        "glosses": [
                                            "Credit, recognition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20af0b33-6ec0-4959-9b1a-0a5061e72824",
                                                "sense_id": "91fc5c96-e4db-35fc-9371-85d07063dba1",
                                                "text": "to give someone his flowers; to get one's flowers"
                                            },
                                            {
                                                "example_id": "702e4301-e7a4-40b8-9204-51c1bd94497c",
                                                "sense_id": "91fc5c96-e4db-35fc-9371-85d07063dba1",
                                                "text": "It has been my desire to find a way to express my gratitude to these women for quite some time but I really did not know how to give them their flowers as a method to tell them thanks."
                                            },
                                            {
                                                "example_id": "cb8583a7-ef84-421e-9b97-e49b9eef7a1b",
                                                "sense_id": "91fc5c96-e4db-35fc-9371-85d07063dba1",
                                                "text": "I was able to give Coach Bryant his flowers while he was alive, and I have always been thankful I was able to do that."
                                            },
                                            {
                                                "example_id": "88d4d144-f3e6-4c2b-ab35-7e347ef018e9",
                                                "sense_id": "91fc5c96-e4db-35fc-9371-85d07063dba1",
                                                "text": "Gonzalo managed to fake a smile. When will anyone ever give him his flowers? His hard work kept him and his kingdom this far. Wasn't anyone going to acknowledge the fact?"
                                            },
                                            {
                                                "example_id": "917f523c-a1fb-4782-8fce-9c22b04b221d",
                                                "sense_id": "91fc5c96-e4db-35fc-9371-85d07063dba1",
                                                "text": "Sabrina Carpenter is, finally, getting her flowers. Ever since demurely (I don't use that word lightly!!!) performing what would become the song of 2024 as part of her Coachella set—no, literally, \"Espresso\" just won the MTV Video Music Award for Song of the Year—all eyes have been on 'Brina."
                                            }
                                        ]
                                    },
                                    {
