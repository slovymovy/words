                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f6f4db-1760-4c9d-a90b-177a884c68bc",
                                "sense_id": "781c4827-79d4-3d2a-931e-64b1b947cc32",
                                "text": "The Baltimore and Ohio Railroad, the nation's oldest, was built in 1830 and cemented Baltimore's status as a transportation hub, giving producers in the Midwest and Appalachia access to the city's port."
                            }
                        ]
