                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea7c4f06-4e03-39e3-84fd-981e276eaa13",
                        "entry_id": "9af45f1c-e743-391c-8fd1-b3631c72ba8a",
                        "glosses": [
                            "стать злобным, бешеным, впасть в неистовство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65367c4-b352-4978-b0d7-eed38609c943",
                                "sense_id": "ea7c4f06-4e03-39e3-84fd-981e276eaa13",
                                "text": "Офицер осатанел, скверно заругался и стал стрелять."
                            },
                            {
                                "example_id": "82ef5174-54de-4d6d-b842-13893206248d",
                                "sense_id": "ea7c4f06-4e03-39e3-84fd-981e276eaa13",
                                "text": "Из носа компаньона хлынула кровь, и Хомяков вдруг осатанел: он бил и бил Гартинга, пока тот, заливаясь кровью, не упал со стула."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab7a7c2f-4c05-3eae-8738-58faa1e0f623",
                        "entry_id": "9af45f1c-e743-391c-8fd1-b3631c72ba8a",
                        "glosses": [
                            "прийти в состояние крайнего возбуждения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7305e9ff-d0a1-4425-84d4-165a621ba718",
                                "sense_id": "ab7a7c2f-4c05-3eae-8738-58faa1e0f623",
                                "text": "Баушка Лукерья совсем осатанела от денег-то."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e5172af-d8b2-3f69-abbd-424ac2b06513",
                        "entry_id": "9af45f1c-e743-391c-8fd1-b3631c72ba8a",
                        "glosses": [
                            "рассвирепеть (о ветре, море и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6f49454-4776-43cc-ab1b-40c4d3e900ad",
                                "sense_id": "5e5172af-d8b2-3f69-abbd-424ac2b06513",
                                "text": "Солнце осатанело. Это уже не солнце, а зажженная газовая конфорка."
                            },
                            {
                                "example_id": "85c12626-a13b-4720-b5f3-1693b9d38e21",
                                "sense_id": "5e5172af-d8b2-3f69-abbd-424ac2b06513",
                                "text": "Огромные валы с многоэтажный дом катились, как всегда, на закат. Ночью ветер совсем осатанел."
                            }
                        ]
                    }
                ],
