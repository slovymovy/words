        "fr-extract.jsonl": [
            {
                "entry_id": "e37bac0f-f0ac-3ec9-9166-3bcb9571bfa9",
                "word": "ringardise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d2cd0f5-cdc8-4bc7-be48-0bc427a49856",
                        "entry_id": "e37bac0f-f0ac-3ec9-9166-3bcb9571bfa9",
                        "tags": [
                            "plural"
                        ],
                        "form": "ringardises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c4b20ac-fc93-36b4-a67a-c107a1ff673c",
                        "entry_id": "e37bac0f-f0ac-3ec9-9166-3bcb9571bfa9",
                        "glosses": [
                            "Fait d’être ringard, d'être démodé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6d038d-6cbd-40bd-9ba5-0552cc36578d",
                                "sense_id": "7c4b20ac-fc93-36b4-a67a-c107a1ff673c",
                                "text": "[…], j'ai entendu une voix féminine qui chantait d'une justesse plus qu'approximative, deux chansons d'une ringardise affligeante, à cent mille lieues de tes goûts musicaux."
                            },
                            {
                                "example_id": "be35d488-31a9-4384-bd7e-5b4b7fea8f1b",
                                "sense_id": "7c4b20ac-fc93-36b4-a67a-c107a1ff673c",
                                "text": "Naguère considérée comme le symbole même de la ringardise, la tisane est aujourd’hui furieusement tendance."
                            },
                            {
                                "example_id": "283c6ad7-b4df-4ec6-a62a-8ae1f1443e18",
                                "sense_id": "7c4b20ac-fc93-36b4-a67a-c107a1ff673c",
                                "text": "On voulait des thés à la menthe, des joints, des promenades, mais un bourgogne avec un jambon cru espagnol c'était le summum de la ringardise."
                            },
                            {
                                "example_id": "6d0d797c-170d-46dc-9e19-b71110efe773",
                                "sense_id": "7c4b20ac-fc93-36b4-a67a-c107a1ff673c",
                                "text": "La culture anglo-saxonne est la plus puissante, la plus séduisante au monde, faisant passer pour une ringardise « quétaine » de vouloir chanter en français."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8cc4953-2d8a-36e7-8d84-f7bd065a712a",
                        "entry_id": "e37bac0f-f0ac-3ec9-9166-3bcb9571bfa9",
                        "glosses": [
                            "Grande médiocrité intellectuelle ou morale."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6e3be82-9560-4f36-b8d1-3db88b5accff",
                        "source_entry_id": "e37bac0f-f0ac-3ec9-9166-3bcb9571bfa9",
                        "target_lang_word": "Schäbigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schäbigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22507ba5-824d-3a64-84fd-508f19b464f8",
                                        "entry_id": "4df9b92c-8568-3508-a9a1-b8ea470141c9",
                                        "glosses": [
                                            "Eigenschaft/Zustand, überaltert, verbraucht, verschlissen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80604f66-c8b2-4c4f-a15a-88ddd0bf8612",
                                                "sense_id": "22507ba5-824d-3a64-84fd-508f19b464f8",
                                                "text": "Die Schäbigkeit des Anzuges ließ sich nicht verbergen."
                                            },
                                            {
                                                "example_id": "b978cab5-33a5-45ac-93c3-e565de1a1272",
                                                "sense_id": "22507ba5-824d-3a64-84fd-508f19b464f8",
                                                "text": "„Mir war kalt, und die Schäbigkeit von Maries Zimmer bedrückte mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9d5b549-5fb0-3499-9909-59f9069722ca",
                                        "entry_id": "4df9b92c-8568-3508-a9a1-b8ea470141c9",
                                        "glosses": [
                                            "moralische Anfechtbarkeit/Verkommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41a33a05-dafd-4dbb-9934-da60a0628355",
                                                "sense_id": "c9d5b549-5fb0-3499-9909-59f9069722ca",
                                                "text": "Die Schäbigkeit seiner Bekanntschaften war sprichwörtlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "be1178e1-bb5f-36b5-80cb-843a8c28a8bc",
                                        "entry_id": "4df9b92c-8568-3508-a9a1-b8ea470141c9",
                                        "glosses": [
                                            "übertriebener Eigennutz, Mangel an Freigiebigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b2480d-a07c-4130-b383-0ccc208799b8",
                                                "sense_id": "be1178e1-bb5f-36b5-80cb-843a8c28a8bc",
                                                "text": "Die Geburtstagsparty war an Schäbigkeit nicht zu übertreffen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75a75873-579a-41da-a454-daa1d4e38f87",
                        "source_entry_id": "e37bac0f-f0ac-3ec9-9166-3bcb9571bfa9",
