                "senses": [
                    {
                        "sense_id": "149e3454-07e6-38ec-b58b-5fed12f1d427",
                        "entry_id": "8c873942-c777-36c4-ba73-d4304a970e09",
                        "glosses": [
                            "Satz, bei dem mehrere Nebensätze aneinandergereiht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "badfe37c-18f4-473b-8ff1-606838084453",
                                "sense_id": "149e3454-07e6-38ec-b58b-5fed12f1d427",
                                "text": "„Satzgefüge, in denen Nebensatz an Nebensatz geleimt ist, nennt man Ketten- oder Treppensätze.“"
                            },
                            {
                                "example_id": "59eb4bf1-7ca3-4de5-b25e-4426798c652c",
                                "sense_id": "149e3454-07e6-38ec-b58b-5fed12f1d427",
                                "text": "„Ein spezieller »Treppensatz« wird daraus, wenn diese Glieder aus lauter Nebensätzen bestehen, die einer nach dem anderen an einen vorgängigen Hauptsatz angehängt werden:… “"
                            },
                            {
                                "example_id": "c8c13800-2ebe-402d-bb4b-f2af2bdc427c",
                                "sense_id": "149e3454-07e6-38ec-b58b-5fed12f1d427",
                                "text": "„Treppensätze mit der Konjunktion dass sollte man vermeiden, weil die mehrfache Wiederholung der gleichen Konjunktion eintönig ist.“"
                            },
                            {
                                "example_id": "b9ed2b73-ce99-48d9-bd9c-d6ffa0dca71b",
                                "sense_id": "149e3454-07e6-38ec-b58b-5fed12f1d427",
                                "text": "„Unter stilistischem Aspekt werden Nebensätze im ersten Beispiel auch Treppensätze genannt (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
