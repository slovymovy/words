    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67dedb9a-d08f-3729-85cb-33d84204f727",
                    "sense_definition": "A perennial woody plant with a single main trunk, branches, and leaves, typically growing to a considerable height.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children decided to climb the old <w>tree</w> in the backyard.",
                            "target_lang_translations": {
                                "ru": "Дети решили залезть на старое <w>дерево</w> на заднем дворе."
                            }
                        },
                        {
                            "text": "Birds often build a nest in a <w>tree</w> to keep their eggs safe from predators.",
                            "target_lang_translations": {
                                "ru": "Птицы часто вьют гнездо на <w>дереве</w>, чтобы защитить яйца от хищников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "climb a tree",
                        "nest in a tree",
                        "fallen tree",
                        "tall tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Многолетнее деревянистое растение с одним главным стволом, ветвями и листьями, обычно достигающее значительной высоты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дерево",
                                "target_lang_sense_clarification": "растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f534a6a5-94c8-34b1-9190-d4fdc5c09454",
                    "sense_definition": "A diagram or structure with branches representing relationships, lineages, or different possible choices.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "diagrams",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am researching my ancestors to complete my family <w>tree</w>.",
                            "target_lang_translations": {
                                "ru": "Я изучаю своих предков, чтобы составить своё генеалогическое <w>древо</w>."
                            }
                        },
                        {
                            "text": "The game allows you to unlock new abilities through a complex skill <w>tree</w>.",
                            "target_lang_translations": {
                                "ru": "Игра позволяет открывать новые способности через сложное <w>дерево</w> навыков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "family tree",
                        "skill tree",
                        "decision tree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Диаграмма или структура с ветвями, представляющая отношения, родословные или различные варианты выбора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древо",
                                "target_lang_sense_clarification": "генеалогическое или иерархическое"
                            },
                            {
                                "target_lang_word": "дерево",
                                "target_lang_sense_clarification": "структура или схема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c96a04f-74e8-33df-883a-1f79ff53eee3",
                    "sense_definition": "A data structure in computing where each element or node is linked to others in a hierarchical way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer used a binary <w>tree</w> to organize the data efficiently.",
                            "target_lang_translations": {
                                "ru": "Программист использовал бинарное <w>дерево</w> для эффективной организации данных."
                            }
                        },
                        {
                            "text": "Each node in the <w>tree</w> can have multiple child nodes.",
                            "target_lang_translations": {
                                "ru": "Каждый узел в <w>дереве</w> может иметь несколько дочерних узлов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "binary tree",
                        "search tree",
                        "tree structure"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
