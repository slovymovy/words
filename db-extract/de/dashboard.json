                "senses": [
                    {
                        "sense_id": "6f833a8b-e642-3657-b156-923ddcdbbd60",
                        "entry_id": "02453355-70f5-3f89-b6c6-30003f4719c0",
                        "glosses": [
                            "grafische Benutzeroberfläche zur Anzeige aufbereiteter Daten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf805a0-7dc4-4330-9428-7995ddc87e73",
                                "sense_id": "6f833a8b-e642-3657-b156-923ddcdbbd60",
                                "text": "„Diese Übersichtsseite nennen wir Dashboard. Im Englischen steht das für ein Armaturenbrett und genauso, wie Ihr Auto Ihnen auf dem Armaturenbrett alle wichtigen Informationen einblendet, so zeigt Ihnen das Dashboard, was gerade passiert.“"
                            },
                            {
                                "example_id": "a6b409e2-e858-45c1-8fc3-567207df4230",
                                "sense_id": "6f833a8b-e642-3657-b156-923ddcdbbd60",
                                "text": "„Für einen vollständigen Überblick wird auf das Dashboard im Appendix B verwiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36cf90f2-0d1c-4a81-9ea1-9dc69835e7a1",
