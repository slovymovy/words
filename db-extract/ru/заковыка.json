                "senses": [
                    {
                        "sense_id": "60475d91-0db6-3bdb-bc0a-6d7b708bd194",
                        "entry_id": "0a06e695-7570-36fd-bd35-5aa61dac2832",
                        "glosses": [
                            "устар. то, что напоминает кавыку, крючок, запятую"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f481c94d-28c9-4840-b6c6-8f934e08cfdc",
                                "sense_id": "60475d91-0db6-3bdb-bc0a-6d7b708bd194",
                                "text": "В узеньких серых глазах его, под двумя заковыками таких же маленьких бровей, сверкнул гнев, верхняя губа ушла под нос, нижняя приподнялась кверху."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2a4c93e-245a-3d8c-9d9a-900c490b35de",
                        "entry_id": "0a06e695-7570-36fd-bd35-5aa61dac2832",
                        "glosses": [
                            "перен. затруднение, препятствие, помеха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98196fb7-374b-445d-aadc-b8694e06712f",
                                "sense_id": "b2a4c93e-245a-3d8c-9d9a-900c490b35de",
                                "text": "Билеты от тебя получил, но насчет нового выходит заковыка."
                            },
                            {
                                "example_id": "b2862bed-cec4-42df-adc4-897f75b3fa07",
                                "sense_id": "b2a4c93e-245a-3d8c-9d9a-900c490b35de",
                                "text": "Я не понимаю, в чем заковыка, ― говорил будто бы Сим Симыч с необычайной для него возбуждённостью."
                            }
                        ]
                    }
                ],
