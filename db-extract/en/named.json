                                            {
                                                "example_id": "bcd8c1b6-2f5c-4a2b-965d-b7d002dfce78",
                                                "sense_id": "7e0014ef-6964-3861-b412-3d93562a998b",
                                                "text": "Dit deflatie genaamde proces van prijsverlagingen is nog gevaarlijker voor een economie dan zijn tegendeel, inflatie genaamd."
                                            },
                                            {
                                                "example_id": "e987501e-b189-433d-bce4-6cefb8e17ad3",
                                                "sense_id": "7e0014ef-6964-3861-b412-3d93562a998b",
                                                "text": "In 2024 rapporteerden onderzoekers van de STAR Collaboration bij de Relativistic Heavy Ion Collider (RHIC) van Brookhaven National Laboratory in New York over het kortstondig creëren van een toen ongekend zware antimateriekern, genaamd antihyperwaterstof-4."
                                            },
                                            {
                                                "example_id": "1761837e-efe6-48be-93ab-7edbd2550853",
                                                "sense_id": "7e0014ef-6964-3861-b412-3d93562a998b",
                                                "text": "Ik was aan het ontbijten aan een picknicktafel toen er een man genaamd Josh bij me kwam zitten."
                                            }
                                        ]
