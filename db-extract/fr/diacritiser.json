                "senses": [
                    {
                        "sense_id": "f1785d5d-0741-3f83-8935-aaf423388ff2",
                        "entry_id": "eba2b131-a626-3eba-a0d8-04db19c52ab6",
                        "glosses": [
                            "Pourvoir d’un signe diacritique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58fe7a17-4ac0-4c9f-bf3d-433099a0ae58",
                                "sense_id": "f1785d5d-0741-3f83-8935-aaf423388ff2",
                                "text": "L'invention a pour objet des procédés, des systèmes et des supports servant à diacritiser partiellement un texte."
                            },
                            {
                                "example_id": "7fac0631-65cf-4768-bc39-0da5e2eab318",
                                "sense_id": "f1785d5d-0741-3f83-8935-aaf423388ff2",
                                "text": "Très bien, mais le dit clavier ne permet pas de diacritiser les consonnes, sauf à recourir aux caractères spéciaux des logiciels de traitement de texte... ou attendre un clavier dédié au néofrançais Caractéristiques des normes du néofrançais (NNF)"
                            },
                            {
                                "example_id": "44463473-df98-47d4-a375-f9dc8711a893",
                                "sense_id": "f1785d5d-0741-3f83-8935-aaf423388ff2",
                                "text": "Elles servent principalement à accentuer (ou diacritiser) une voyelle."
                            }
                        ]
                    }
