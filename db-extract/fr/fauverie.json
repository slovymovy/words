                "senses": [
                    {
                        "sense_id": "57609afb-5c75-317f-813a-f299975241ad",
                        "entry_id": "9655cbfa-b456-312a-ba91-41241b440c3e",
                        "glosses": [
                            "Caractère de ce qui a la couleur fauve."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "25ae2ec6-6a1b-4fed-b088-0f1c276c5adc",
                                "sense_id": "57609afb-5c75-317f-813a-f299975241ad",
                                "text": "Les fauveries du tableau sont semblables à celle d'un soir d’automne."
                            }
                        ]
                    },
                    {
                        "sense_id": "97ed63fb-d1fa-386a-a9b7-1b782837cc06",
                        "entry_id": "9655cbfa-b456-312a-ba91-41241b440c3e",
                        "glosses": [
                            "Enclos où l’on garde les grands fauves, dans un jardin zoologique, ou un cirque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f2b15d-7a97-47c2-86eb-2e6f46e3b8b1",
                                "sense_id": "97ed63fb-d1fa-386a-a9b7-1b782837cc06",
                                "text": "Ce matin de mars, le fleuve était à deux pas, et Canabinche venait d’être réveillé par des feulements dans la fauverie toute proche."
                            },
                            {
                                "example_id": "3177a695-41a3-4209-9a51-aa8f32bc1f6d",
                                "sense_id": "97ed63fb-d1fa-386a-a9b7-1b782837cc06",
                                "text": "Cela sentait la fauverie, l’embrocation et la caoutchouc chaud."
                            },
                            {
                                "example_id": "fc035ab7-50be-4a9a-a118-cf50bddf3325",
                                "sense_id": "97ed63fb-d1fa-386a-a9b7-1b782837cc06",
                                "text": "Mais, Jérôme et moi avions étendu notre enquête jusqu’aux poissons les plus voraces, dignes d’une fauverie, et réussi à lire tout ce que la bibliothèque municipale possédait sur les requins, les murènes ou les piranhas."
                            }
                        ]
                    },
                    {
                        "sense_id": "e17225de-57ea-3149-af84-9ee21c7bcf97",
                        "entry_id": "9655cbfa-b456-312a-ba91-41241b440c3e",
                        "glosses": [
                            "Lieu qui évoque une ménagerie de fauves."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7ef0e5e8-d161-4845-8b75-ead976cbc19c",
                                "sense_id": "e17225de-57ea-3149-af84-9ee21c7bcf97",
                                "text": "On entra dans la fauverie qui lui servait d'appartement, et Jean tomba dans les pommes."
                            }
                        ]
                    }
                ],
