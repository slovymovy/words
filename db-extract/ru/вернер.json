                                                "sense_id": "7ff9783b-e1ed-326c-bd3a-eaab5d72eebe",
                                                "text": "Werner gießt mit Vergnügen Theos Blumen, wenn jener auf Reisen ist."
                                            },
                                            {
                                                "example_id": "691abe2c-bcc2-441b-b8dc-d7df4682e57e",
                                                "sense_id": "7ff9783b-e1ed-326c-bd3a-eaab5d72eebe",
                                                "text": "Anna und Werner haben sieben Kinder."
                                            },
                                            {
                                                "example_id": "6af20cd8-269d-421e-8161-e5007c4396dd",
                                                "sense_id": "7ff9783b-e1ed-326c-bd3a-eaab5d72eebe",
                                                "text": "Werner spielt gern."
                                            },
                                            {
                                                "example_id": "6a81ad0d-be72-4f5b-b84c-9d921a682066",
                                                "sense_id": "7ff9783b-e1ed-326c-bd3a-eaab5d72eebe",
                                                "text": "Werner Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "813cd499-e675-4a79-a1c1-45c56f27091c",
                                                "sense_id": "7ff9783b-e1ed-326c-bd3a-eaab5d72eebe",
                                                "text": "Kennen sie den Vornamen Werner?"
                                            }
                                        ],
