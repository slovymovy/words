                        "glosses": [
                            "het raamwerk waarin het glas gevat kan worden dat een opening in een muur afsluit"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "31c04983-0746-351c-98b0-eee9d118590e",
                        "entry_id": "f3014f2f-4a8a-3318-8fe4-473efe1d3395",
                        "glosses": [
                            "de glazen ruit die een opening in een muur afsluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c17166a3-b6ab-41b8-b1a9-375bab8d6434",
                                "sense_id": "31c04983-0746-351c-98b0-eee9d118590e",
                                "text": "Komarovski trommelde met zijn vingers op het vensterraam in de maat van een stel paarden dat beneden ongehaast over het asfalt klepperde."
                            },
                            {
                                "example_id": "e21c9375-7861-4ad4-abd5-64f8a23250b1",
                                "sense_id": "31c04983-0746-351c-98b0-eee9d118590e",
                                "text": "Bovendien is er in elke wijk wel zo'n buurman die dan heel opzichtig ook de stoepjes van zijn zogenaamd luie buren meepakt. Vaak gaat deze nijverheid gepaard met passief-agressieve blikken door het vensterraam waar jij net een gele rakker opentrekt na een lange dag werken. Kortom, onnodige groepsdruk waar niemand gelukkig van wordt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89e63f7f-661e-462b-baf2-6b98af394321",
                        "source_entry_id": "f3014f2f-4a8a-3318-8fe4-473efe1d3395",
                        "source_sense_id": "2549e8d3-92b3-3ca5-bbcc-63cfaf5fdceb",
                        "source_sense_description": "het raamwerk waarin het glas gevat kan worden dat een opening in een muur afsluit",
                        "target_lang_word": "window-frame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "window-frame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b64d453d-d253-36fa-9731-42aa0311eea1",
                                        "entry_id": "14e8c6b3-7948-36d5-9e59-e31c0c5078cf",
                                        "glosses": [
                                            "Archaic form of window frame."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcefe1a8-fb93-4bb1-9bdc-2ac75bf0e45d",
                                                "sense_id": "b64d453d-d253-36fa-9731-42aa0311eea1",
                                                "text": "She sat until all around her was in darkness, until not a spray of roses which twined about the window-frames from without, was discernible."
                                            },
                                            {
                                                "example_id": "47efb479-64da-4f35-977e-707cef004d44",
                                                "sense_id": "b64d453d-d253-36fa-9731-42aa0311eea1",
                                                "text": "Thoroughfares lying close by the Thames, which were wont to suffer from inundations, were raised; those which from limited breadth had caused inconvenience and bred pestilence were made wide; warehouses and dwellings of solid brick and carved stone, with doors, window-frames, and breastsummers of stout oak, replaced irregular though not unpicturesque habitations; […]"
                                            },
                                            {
                                                "example_id": "d892b54d-b621-446f-a99e-f019e5b72251",
                                                "sense_id": "b64d453d-d253-36fa-9731-42aa0311eea1",
                                                "text": "Some experts claim that it is a bad practice in stone buildings to build the window-frames in with the stone masonry of the wall, and that the openings should be carefully made, the stone wall being brought to a proper face, thoroughly pointed, and the window-frames put in afterward, if a weather-tight job is desired."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
