                "senses": [
                    {
                        "sense_id": "7c97ddf8-2123-376b-a725-4984e66f713c",
                        "entry_id": "310cf771-f9fa-3f57-bbfa-4ccafe3e7905",
                        "glosses": [
                            "etwas, das ohne Unterbrechung oder Lücke zusammenhängt"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7ab11951-0331-46fe-acc5-d0dd5a59c663",
                                "sense_id": "7c97ddf8-2123-376b-a725-4984e66f713c",
                                "text": "„Den Grad einer Suizidabsicht kann man sich als Punkt auf einer Skala vorstellen, an deren einem Ende die absolute Entschlossenheit, sich zu töten, und an deren anderem Ende die feste Absicht, weiterzuleben steht. An diesem Kontinuum finden die verschiedensten Absichten Platz.“"
                            },
                            {
                                "example_id": "78fc74bf-6cd6-44bb-8e7a-c2361821e08c",
                                "sense_id": "7c97ddf8-2123-376b-a725-4984e66f713c",
                                "text": "„Jedes beobachtete Verhalten kann auf diesem Kontinuum zwischen interpersonalem und intergruppalem Verhalten eingeordnet werden, wobei die beiden „Reinformen\" ausgesprochen selten in Erscheinung treten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "995ae96b-2bef-4572-8320-e35abfdf8ba5",
                        "source_entry_id": "310cf771-f9fa-3f57-bbfa-4ccafe3e7905",
                        "source_sense_id": "7c97ddf8-2123-376b-a725-4984e66f713c",
                        "source_sense_description": "gehoben: etwas, das ohne Unterbrechung oder Lücke zusammenhängt",
                        "target_lang_word": "continuum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac90fa31-b945-36bd-8c65-54a883434950",
                                        "entry_id": "2bb1eeb7-75ce-3870-b964-532097bdd2cc",
                                        "glosses": [
                                            "A continuous series or whole, no part of which is noticeably different from its adjacent parts, although the ends or extremes of it are very different from each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae957a5-3a09-42c6-91e0-74c3626c62f0",
                                                "sense_id": "ac90fa31-b945-36bd-8c65-54a883434950",
                                                "text": "Near-synonym: spectrum"
                                            },
                                            {
                                                "example_id": "5494088c-540f-429a-98d2-9e17be5bbace",
                                                "sense_id": "ac90fa31-b945-36bd-8c65-54a883434950",
                                                "text": "So, the white line implies Blacklessness and the black background implies Whitelessness – that is, once the white line, a continuum, has emerged from blackness, also a continuum, and the two continua engage in an “inter-penetrative” (Buddhist term) process."
                                            },
                                            {
                                                "example_id": "093a4633-88f2-49a5-bdc9-1fbb0c83a493",
                                                "sense_id": "ac90fa31-b945-36bd-8c65-54a883434950",
                                                "text": "In fact, the influence of signage in a certain area may exist anywhere on a continuum from profoundly effective to utterly trivial or completely insignificant, irrespective of the intent motivating the signs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b43c812-b3d7-366b-9145-ee9f2ad33518",
                                        "entry_id": "2bb1eeb7-75ce-3870-b964-532097bdd2cc",
                                        "glosses": [
                                            "A continuous extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fbfefa2-30c5-428e-ab04-781ef4247994",
                                                "sense_id": "1b43c812-b3d7-366b-9145-ee9f2ad33518",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a13a801-eec1-39f3-afe5-dc82808712b1",
                                        "entry_id": "2bb1eeb7-75ce-3870-b964-532097bdd2cc",
                                        "glosses": [
                                            "The nondenumerable set of real numbers; more generally, any compact connected metric space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc6939b1-f469-38dd-8013-78b8c8b2bb20",
                                        "entry_id": "2bb1eeb7-75ce-3870-b964-532097bdd2cc",
                                        "glosses": [
                                            "A touch-sensitive strip, similar to an electronic standard musical keyboard, except that the note steps are ¹⁄₁₀₀ of a semitone, and so are not separately marked."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc9f6b35-d26a-4712-93c1-1fac0aad5853",
                        "source_entry_id": "310cf771-f9fa-3f57-bbfa-4ccafe3e7905",
                        "source_sense_id": "7c97ddf8-2123-376b-a725-4984e66f713c",
                        "source_sense_description": "gehoben: etwas, das ohne Unterbrechung oder Lücke zusammenhängt",
                        "target_lang_word": "continu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e46eb2e-b855-3e7e-8222-efe32af18dfc",
                                        "entry_id": "dd9f2684-40e7-33e6-9ef1-b57a0bbfbd02",
                                        "glosses": [
                                            "Dont les parties ne sont pas séparées les unes des autres et tiennent les unes aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77e4b18e-2eb7-4e19-aa64-8775a8645438",
                                                "sense_id": "1e46eb2e-b855-3e7e-8222-efe32af18dfc",
                                                "text": "Le rivage n’était pas entièrement continu, le récif était frangé d’îles qui présentaient entre elles de minuscules passes."
                                            },
                                            {
                                                "example_id": "ed4d6a0a-a09d-47f6-a7ab-c8c229abe2bb",
                                                "sense_id": "1e46eb2e-b855-3e7e-8222-efe32af18dfc",
                                                "text": "Étendue continue."
                                            },
                                            {
                                                "example_id": "1fd03f8e-11e3-4e2e-93a1-a7d3fd07c32e",
                                                "sense_id": "1e46eb2e-b855-3e7e-8222-efe32af18dfc",
                                                "text": "Parties continues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4c73880-18d0-35d1-9c25-2028455c48f2",
                                        "entry_id": "dd9f2684-40e7-33e6-9ef1-b57a0bbfbd02",
                                        "glosses": [
                                            "Qui est d’une durée sans aucune interruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4483f4c-5329-4f26-8557-e11f1c625f79",
                                                "sense_id": "b4c73880-18d0-35d1-9c25-2028455c48f2",
                                                "text": "Certes, la France renferme plus d’un homme instruit, plus d’un patriote par Commune ; mais je suis certain qu’il n’existe pas dans chaque Canton un homme qui, à ces précieuses qualités, joigne le vouloir continu, la pertinacité du maréchal battant son fer."
                                            },
                                            {
                                                "example_id": "8d7dbf69-bf0c-4a0a-8591-53a05816afc7",
                                                "sense_id": "b4c73880-18d0-35d1-9c25-2028455c48f2",
                                                "text": "Aucune femme de tête n’eût pu résister à la puissance exhilarante de cet encensement continu."
                                            },
                                            {
                                                "example_id": "852dc15b-140e-43bc-b57a-b419bd9baea6",
                                                "sense_id": "b4c73880-18d0-35d1-9c25-2028455c48f2",
                                                "text": "Des communications fréquentes, sinon continues, existaient à l’Éocène entre les contrées du Sud de l’Europe et le continent africain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a068206-5ac0-3d62-a413-ea1f8addf947",
                                        "entry_id": "dd9f2684-40e7-33e6-9ef1-b57a0bbfbd02",
                                        "glosses": [
                                            "Qualifie le soubassement d’une file de colonnes avec base et corniche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fe7511-e168-4009-a247-dd773166e0af",
                                                "sense_id": "8a068206-5ac0-3d62-a413-ea1f8addf947",
                                                "text": "Piédestal continu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5261e2e7-2376-3233-b6b4-132d5f96dacc",
                                        "entry_id": "dd9f2684-40e7-33e6-9ef1-b57a0bbfbd02",
                                        "glosses": [
                                            "Proportion continue : qualifie une proportion où le conséquent de la première raison est l’antécédent de la seconde."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61ebe19f-20cb-3b96-8e79-87f1924f83ab",
                                        "entry_id": "dd9f2684-40e7-33e6-9ef1-b57a0bbfbd02",
                                        "glosses": [
                                            "Qualifie une fraction dont le dénominateur est composé d’un nombre entier et d’une autre fraction, qui a également pour dénominateur un entier et une fraction, et ainsi de suite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12ed5a70-9112-3364-9626-eac436893089",
                                        "entry_id": "dd9f2684-40e7-33e6-9ef1-b57a0bbfbd02",
                                        "glosses": [
                                            "Qualifie une fonction ou une application dont la variation est très petite, quand la variable varie très peu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
