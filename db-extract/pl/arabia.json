                        "entry_id": "e1945834-0d76-37d7-8d67-ea52f3f1b4e4",
                        "glosses": [
                            "kraina zazwyczaj utożsamiana z Półwyspem Arabskim, lecz początkowo obejmująca obszar Azji leżący na południowy zachód od Mezopotamii, obejmując poza półwyspem również część Lewantu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "370c5998-1793-465e-971c-3e1d848fc42b",
                                "sense_id": "89e10efa-10fd-31fc-8962-1db0c30705fe",
                                "text": "Jest bardzo prawdopodobne, że ludy semickie wyruszyły z Arabii na podbój Mezopotamii i Palestyny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "62e0f937-9b2e-3821-b505-2f66eca2e954",
                        "entry_id": "e1945834-0d76-37d7-8d67-ea52f3f1b4e4",
                        "glosses": [
                            "Arabia Saudyjska"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
