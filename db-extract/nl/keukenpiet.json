                "senses": [
                    {
                        "sense_id": "b25e02cc-82c7-3e4c-b926-363b832f13ee",
                        "entry_id": "377ff495-6797-34d3-9bc5-49a9ddfe3734",
                        "glosses": [
                            "iemand die goed kan koken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61eaf64a-cd2b-43f0-8382-c19b2460a7fb",
                                "sense_id": "b25e02cc-82c7-3e4c-b926-363b832f13ee",
                                "text": "Ondanks al het bewerkelijke lekkers dat ze de lezer voorschotelt, durft Buschman de hele opzet ook te relativeren. Het kookboek mag niet de indruk wekken dat Couperus een keukenpiet of een gulzige lekkerbek was."
                            },
                            {
                                "example_id": "9a1c1c73-72d0-4367-8102-ff08ae750fe4",
                                "sense_id": "b25e02cc-82c7-3e4c-b926-363b832f13ee",
                                "text": "Wat Tuymans met een ogenschijnlijk banaal onderwerp als een keukenpiet uithaalt, is gewoon verbluffend. Giftige kleuren, verblindend licht, een suggestie van geweld: het zit allemaal in dat ene beeld dat de toeschouwer opwacht bij het begin van de tentoonstelling."
                            }
                        ]
                    },
                    {
                        "sense_id": "577786e5-c26c-3c43-9736-395fbd740018",
                        "entry_id": "377ff495-6797-34d3-9bc5-49a9ddfe3734",
                        "glosses": [
                            "knecht van Sinterklaas die het hoofd is van de keuken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9dfa646-fc80-481e-8995-2dbebccc9d74",
                                "sense_id": "577786e5-c26c-3c43-9736-395fbd740018",
                                "text": "In het vierde deel worden Testpiet, Coole Piet, Muziekpiet, Hoge Piet, Keukenpiet en Danspiet geconfronteerd met slechterik Kornee, die vroeger nooit een cadeautje kreeg van Sinterklaas. Om wraak te nemen heeft hij een speelgoedknuffel ontwikkeld die cadeautjes uit schoenen van kinderen steelt."
                            },
                            {
                                "example_id": "b2942872-f816-40e4-831b-05b1259c076d",
                                "sense_id": "577786e5-c26c-3c43-9736-395fbd740018",
                                "text": "Ondertussen ruziet in het pietenhuis de Hoofdpiet met de Meesterpiet, over het niveau van zijn leerlingen. En met keukenpiet Piet Za over de pizza’s die ze iedere dag serveert. Kan dat niet gezonder? Voor de humor moet PAS (personal Assistent tot the Sint) zorgen. Die ontwerp voor Sinterklaas een nieuw kostuum: zilver met harige franjes. Sint weigert geamuseerd. Iets te veel vernieuwing."
                            }
                        ]
                    }
