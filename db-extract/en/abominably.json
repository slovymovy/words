                                        "glosses": [
                                            "dem guten Geschmack, persönlicher Empfindung oder moralischen Grundsätzen entgegenstrebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25affd16-fcbd-497d-b7d3-fa56af099e98",
                                                "sense_id": "d443707f-54f1-3a3b-928d-56b5bef14cca",
                                                "text": "Kaffee vom Vortag, der in der Mikrowelle ein weiteres Mal erhitzt wird, schmeckt absolut widerwärtig!"
                                            },
                                            {
                                                "example_id": "03e731db-4420-4333-a9c5-442d83c4a6a0",
                                                "sense_id": "d443707f-54f1-3a3b-928d-56b5bef14cca",
                                                "text": "„Die meisten Menschen bemerken nur die erotische Merkwürdigkeit, die für sie eine Widerwärtigkeit ist, eine widerwärtige Farce.“"
