                {
                    "sense_id": "2c68dd51-feb3-3289-a7c5-aed0ca3a44d6",
                    "sense_definition": "Any action or process that repeats in a cycle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cyclic_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>cycling</w> of the battery reduced its capacity over time.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>циклирование</w> аккумулятора со временем снизило его емкость.",
                                "zh": "电池不断的<w>循环</w>使用导致其容量随时间下降。"
                            }
                        },
                        {
                            "text": "Thermal <w>cycling</w> is used to test the durability of the materials.",
                            "target_lang_translations": {
                                "ru": "Термическое <w>циклирование</w> используется для проверки долговечности материалов.",
                                "zh": "热<w>循环</w>测试常被用来检验材料的耐用性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "thermal cycling",
                        "carbon cycling",
                        "nutrient cycling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое действие или процесс, который повторяется циклами",
                        "zh": "任何以周期性方式重复的动作或过程。"
