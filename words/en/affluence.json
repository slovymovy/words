{
    "word_family": [
        "affluent",
        "affluently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cef18203-13e4-3799-8ad2-e0286a1a8b4e",
                    "sense_definition": "An abundance of money, property, or material wealth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rapid economic growth brought unprecedented <w>affluence</w> to the region.",
                            "target_lang_translations": {
                                "nl": "De snelle economische groei bracht ongekende <w>welvaart</w> naar de regio."
                            }
                        },
                        {
                            "text": "His family lived in obvious <w>affluence</w>, residing in a sprawling country manor.",
                            "target_lang_translations": {
                                "nl": "Zijn familie leefde in overduidelijke <w>rijkdom</w> en woonde in een uitgestrekt landhuis."
                            }
                        }
                    ],
                    "synonyms": [
                        "ease",
                        "richdom"
                    ],
                    "antonyms": [
                        "indigence"
                    ],
                    "common_phrases": [
                        "growing affluence",
                        "relative affluence"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een overvloed aan geld, bezit of materiële welvaart."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "welvaart",
                                "target_lang_sense_clarification": "materiële en economische bloei"
                            },
                            {
                                "target_lang_word": "rijkdom",
                                "target_lang_sense_clarification": "het bezitten van veel geld of goederen"
                            },
                            {
                                "target_lang_word": "welstand",
                                "target_lang_sense_clarification": "goede financiële situatie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a65bc8f4-33b1-3c95-be50-5e95a371e839",
                    "sense_definition": "A comfortable or moderate level of wealth, distinguished from extreme riches.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had achieved <w>affluence</w>, but aspired to true wealth.",
                            "target_lang_translations": {
                                "nl": "Ze hadden <w>welstand</w> bereikt, maar streefden naar echte rijkdom."
                            }
                        },
                        {
                            "text": "A life of quiet <w>affluence</w> allowed them to travel without worrying about daily expenses.",
                            "target_lang_translations": {
                                "nl": "Een leven van rustige <w>welstand</w> stelde hen in staat te reizen zonder zich zorgen te maken over dagelijkse uitgaven."
                            }
                        }
                    ],
                    "common_phrases": [
                        "achieve affluence"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een comfortabel of gematigd niveau van welvaart, te onderscheiden van extreme rijkdom."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "welstand",
                                "target_lang_sense_clarification": "comfortabele financiële situatie"
                            },
                            {
                                "target_lang_word": "gegoedheid",
                                "target_lang_sense_clarification": "het hebben van voldoende middelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fd33ea5-9292-3037-bf14-70cd7ab31785",
                    "sense_definition": "An abundant flow, copious supply, or profusion of something non-material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet was overwhelmed by an <w>affluence</w> of creative thoughts.",
                            "target_lang_translations": {
                                "nl": "De dichter werd overweldigd door een <w>overvloed</w> aan creatieve gedachten."
                            }
                        },
                        {
                            "text": "She displayed an astonishing <w>affluence</w> of ideas during the symposium.",
                            "target_lang_translations": {
                                "nl": "Ze toonde een verbazingwekkende <w>rijkdom</w> aan ideeën tijdens het symposium."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een overvloedige stroom of grote hoeveelheid van iets niet-materiëels."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "overvloed",
                                "target_lang_sense_clarification": "grote hoeveelheid of rijkdom aan iets immaterieels"
                            },
                            {
                                "target_lang_word": "rijkdom",
                                "target_lang_sense_clarification": "figuurlijke overvloed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff7b27be-4592-3451-a497-f1b0237cff7c",
                    "sense_definition": "A continuous inward flow or influx, such as of people, fluids, or resources.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seasonal <w>affluence</w> of tourists completely filled the coastal town.",
                            "target_lang_translations": {
                                "nl": "De seizoensgebonden <w>toestroom</w> van toeristen vulde het kustplaatsje volledig."
                            }
                        },
                        {
                            "text": "The canal was designed to accommodate the sudden <w>affluence</w> of water from melting snow.",
                            "target_lang_translations": {
                                "nl": "Het kanaal was ontworpen om de plotselinge <w>toestroom</w> van smeltwater op te vangen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Largely replaced by influx"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een voortdurende toestroom van mensen, vloeistoffen of middelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "toestroom",
                                "target_lang_sense_clarification": "het toevloeien van personen of zaken"
                            },
                            {
                                "target_lang_word": "aanvoer",
                                "target_lang_sense_clarification": "het toestromen of aanvoeren van middelen of vloeistoffen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}