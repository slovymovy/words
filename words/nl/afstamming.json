                        "herkomst"
                    ],
                    "common_phrases": [
                        "gemeenschappelijke afstamming"
                    ],
                    "target_lang_definitions": {
                        "en": "The genetic or evolutionary history of an individual, population, or biological species."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "descent",
                                "target_lang_sense_clarification": "evolutionary or genetic lineage"
                            },
                            {
