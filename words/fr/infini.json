            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28be53c8-0fc6-307e-8813-b67d481d6fa4",
                    "sense_definition": "Qui n'a pas de bornes ou de limites dans l'espace ou dans le temps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "absence_de_limite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronomes continuent d'explorer cet espace <w>infini</w> qui nous entoure."
                        },
                        {
                            "text": "La mer semblait se prolonger vers un horizon <w>infini</w> et paisible."
                        }
                    ],
                    "synonyms": [
                        "illimité",
                        "sans fin"
                    ],
                    "antonyms": [
                        "fini",
                        "limité",
                        "borné"
                    ],
                    "common_phrases": [
