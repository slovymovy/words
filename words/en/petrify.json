{
    "word_family": [
        "petrifaction",
        "petrification"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6785a03c-8075-3cdc-9346-042a8209ff68",
                    "sense_definition": "To frighten someone so severely that they are unable to move or think clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud sound of gunfire in the dark began to <w>petrify</w> the young soldiers.",
                            "target_lang_translations": {
                                "zh": "黑暗中突然响起的巨大枪声开始让年轻的士兵们<w>吓呆</w>了。"
                            }
                        },
                        {
                            "text": "Fears of public speaking can completely <w>petrify</w> even experienced professionals before a presentation.",
                            "target_lang_translations": {
                                "zh": "对公开演讲的恐惧甚至能让经验丰富的专业人士在演讲前完全<w>吓傻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrify",
                        "horrify",
                        "scare"
                    ],
                    "common_phrases": [
                        "petrify with fear",
                        "petrify with terror"
                    ],
                    "target_lang_definitions": {
                        "zh": "使极为恐惧，使吓呆或吓得动弹不得"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吓呆",
                                "target_lang_sense_clarification": "使因极度恐惧而发愣或动弹不得"
                            },
                            {
                                "target_lang_word": "使目瞪口呆",
                                "target_lang_sense_clarification": "极度惊吓或震惊"
                            },
                            {
                                "target_lang_word": "吓傻",
                                "target_lang_sense_clarification": "极度受惊失去反应能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "864a04ce-c553-3f14-97d2-2f44a13c5542",
                    "sense_definition": "To turn organic matter into stone by the gradual deposition of dissolved minerals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fossilize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mineral-rich spring water will gradually <w>petrify</w> porous pieces of wood over centuries.",
                            "target_lang_translations": {
                                "zh": "富含矿物质的泉水经过数百年会逐渐使多孔的木块<w>石化</w>。"
                            }
                        },
                        {
                            "text": "Specific geological conditions can quickly bury and <w>petrify</w> ancient plants.",
                            "target_lang_translations": {
                                "zh": "特殊的地质条件能迅速掩埋并<w>石化</w>古代植物。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使有机物石化；由于矿物质沉积而转变成石头"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "石化",
                                "target_lang_sense_clarification": "转变成石头或化石"
                            },
                            {
                                "target_lang_word": "使石化",
                                "target_lang_sense_clarification": "促使有机物质变成石头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1392552d-872c-3191-b1b8-64951a7d8e83",
                    "sense_definition": "To become emotionally unfeeling, callous, or rigid over time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After suffering so many bitter disappointments, his once compassionate heart began to <w>petrify</w>.",
                            "target_lang_translations": {
                                "zh": "在经历了如此多痛苦的失望之后，他曾经富有同情心的心开始<w>变得麻木</w>。"
                            }
                        },
                        {
                            "text": "Constant exposure to brutality can cause human sympathy to wither and <w>petrify</w> completely.",
                            "target_lang_translations": {
                                "zh": "不断目睹残暴行径会导致人类的同情心彻底萎缩并<w>硬化</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "petrify with grief"
                    ],
                    "target_lang_definitions": {
                        "zh": "（情感或态度）变得麻木、冷酷或僵化"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变得麻木",
                                "target_lang_sense_clarification": "情感上失去知觉或同情心"
                            },
                            {
                                "target_lang_word": "硬化",
                                "target_lang_sense_clarification": "思想或态度变得僵硬冷漠"
                            },
                            {
                                "target_lang_word": "僵化",
                                "target_lang_sense_clarification": "情感或思想变得固执死板"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}