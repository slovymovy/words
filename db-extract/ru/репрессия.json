                ],
                "senses": [
                    {
                        "sense_id": "a83a8dae-9df3-315c-9c63-77f00b5a24ce",
                        "entry_id": "01c1f28a-a41e-3141-8e9d-9d90dacc2486",
                        "glosses": [
                            "карательная мера, наказание, обычно применяемые государством"
                        ],
                        "tags": [
                            "чаще мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "149ddbb6-c25e-4ef2-ba25-b87d5b8e2914",
                                "sense_id": "a83a8dae-9df3-315c-9c63-77f00b5a24ce",
                                "text": "Именно в это десятилетие репрессии были в первую очередь направлены против интеллигенции."
                            },
                            {
                                "example_id": "577fb3fc-709e-49f5-8d11-be1e1382b285",
                                "sense_id": "a83a8dae-9df3-315c-9c63-77f00b5a24ce",
                                "text": "Безусловно, репрессии за убеждения и действия, связанные с убеждениями, представляют собой относительно редкое явление в нашей действительности."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10fcc97e-9937-4a10-a7c0-51e250c8b08d",
                        "source_entry_id": "01c1f28a-a41e-3141-8e9d-9d90dacc2486",
                        "source_sense_id": "a83a8dae-9df3-315c-9c63-77f00b5a24ce",
                        "target_lang_word": "repression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "426274a8-4878-308e-af57-b949ffbe9f76",
                                        "entry_id": "5897df19-e5ab-3334-997b-3d4c3a026a9a",
                                        "glosses": [
                                            "The act of repressing; state of being repressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b36e19ff-6415-48ae-b820-8ea19528bdaf",
                                                "sense_id": "426274a8-4878-308e-af57-b949ffbe9f76",
                                                "text": "History shows that when governments fear the truth and increase repression, their days are limited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b82d5ad-738e-3953-a1f4-da004d7aa065",
                                        "entry_id": "5897df19-e5ab-3334-997b-3d4c3a026a9a",
                                        "glosses": [
                                            "The involuntary rejection from consciousness of painful or disagreeable ideas, memories, feelings, or impulses."
                                        ],
                                        "tags": [
