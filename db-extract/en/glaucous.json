                                    },
                                    {
                                        "sense_id": "096ecb03-9c17-3878-bcec-641dc8b2cf6a",
                                        "entry_id": "67edea5e-84e7-396e-bcac-7ad3c8ad53b6",
                                        "glosses": [
                                            "Riferito anche al tempo meteorologico (in particolare all'aria/vento), la grande frescura glauca della sera di giugno (D’Annunzio)."
