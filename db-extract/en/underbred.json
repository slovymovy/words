                "senses": [
                    {
                        "sense_id": "eba7d861-b3ae-3a29-a304-572ff645500b",
                        "entry_id": "f687508e-a384-39d6-ba4f-3c40da27c1ce",
                        "glosses": [
                            "Of inferior breeding or upbringing; vulgar, lacking in manners or finesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feece86f-4a13-4d80-8ded-ee102370106b",
                                "sense_id": "eba7d861-b3ae-3a29-a304-572ff645500b",
                                "text": "The art of governing these under-bred varlets lies more in the dignity of looks than in words […]."
                            },
                            {
                                "example_id": "f8182e81-358a-4cc5-8a3a-7c36b8c7a89c",
                                "sense_id": "eba7d861-b3ae-3a29-a304-572ff645500b",
                                "text": "Himself, he felt the most underbred of all; he was afraid of these Utopians: snobbish and abject before them, he was like a mannerless earthy lout in a drawing-room, and he was bitterly ashamed of his own abjection."
                            }
                        ]
                    },
                    {
                        "sense_id": "870b1caa-26af-3fee-a1b9-31ac7f6480ca",
                        "entry_id": "f687508e-a384-39d6-ba4f-3c40da27c1ce",
                        "glosses": [
                            "Not purebred; of an inferior strain."
                        ],
                        "tags": [
                            "of animals"
                        ],
                        "examples": [
                            {
                                "example_id": "c83bbf5a-ad87-48c0-9f39-0f332da9881f",
                                "sense_id": "870b1caa-26af-3fee-a1b9-31ac7f6480ca",
                                "text": "I prefer both sire and dam to be well-bred, but a well-bred mare and an underbred horse will produce a faster animal than a thoroughbred horse and an underbred mare."
                            }
                        ]
                    }
                ],
