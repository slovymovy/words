                },
                {
                    "sense_id": "c5c181b6-8cc4-384e-b51b-7e554a97e400",
                    "sense_definition": "A powdered substance, such as charcoal, applied to the face of a mould to give a fine smooth surface to the casting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metalworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The foundry worker dusted the sand mould with a coal <w>facing</w> before pouring the metal.",
                            "target_lang_translations": {
                                "ru": "Рабочий литейного цеха присыпал песчаную форму угольным <w>припылом</w> перед заливкой металла."
                            }
                        },
                        {
                            "text": "Using a high-quality <w>facing</w> prevents the molten iron from sticking to the mould.",
                            "target_lang_translations": {
                                "ru": "Использование высококачественной <w>облицовочной смеси</w> предотвращает прилипание расплавленного чугуна к форме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mould facing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порошкообразное вещество (например, древесный уголь), наносимое на поверхность литейной формы для получения гладкой отливки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припыл",
