                    },
                    {
                        "sense_id": "2dd6f1c5-4ab2-3281-87ae-212105b92bad",
                        "entry_id": "2d419261-9382-3baa-a2f7-e5f5f2c940a4",
                        "glosses": [
                            "перен. проявление особого почитания, уважения, преданности кому-либо или чему-либо; преклонение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd0d48b-0f65-40bc-8ccf-1ccb6f3698a0",
                                "sense_id": "2dd6f1c5-4ab2-3281-87ae-212105b92bad",
                                "text": "Из пришедших на поклонение в праздник были некоторые Еллины."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38b6d1e6-d828-4d5c-ac94-ec1c37adca57",
                        "source_entry_id": "2d419261-9382-3baa-a2f7-e5f5f2c940a4",
                        "target_lang_word": "worship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb3aa1f-1eee-3ee1-880d-9dc6e617b44b",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "The devotion accorded to a deity or to a sacred object."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf857d4-b8b5-460f-8c7c-4fa16562f470",
                                                "sense_id": "2eb3aa1f-1eee-3ee1-880d-9dc6e617b44b",
                                                "text": "Polytheistic theology and worship had to go underground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d1b9b1-3ab1-3784-80e1-d2551d8b0676",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "The adoration (or latria) owed to God alone, as greater than the hyperveneration / hyper-veneration (or hyperdulia) that is given to Saint Mary only and the veneration (or dulia) accorded to all other Roman Catholic saints."
                                        ],
                                        "tags": [
                                            "especially",
                                            "specifically",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80cc4a54-b010-3721-9e06-067fd368f33d",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "The religious ceremonies that express this devotion."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424da911-06ec-4a26-8bf6-1850a42fceea",
                                                "sense_id": "80cc4a54-b010-3721-9e06-067fd368f33d",
                                                "text": "The worſhip of God is an eminent part of Religion; and Prayer, which is often in Scripture expreſſed by ſeeking God, and calling upon his Name, is a chief part of Religious Worſhip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e28a4ea-9926-3465-99c4-2aa48f271476",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "Voluntary, utter submission; voluntary, utter deference."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23c4f7f5-c099-395a-baf1-ed7110d05c1a",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "Ardent love."
                                        ],
                                        "tags": [
                                            "also",
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44954d2b-75a4-303e-9070-77d6cfdb8838",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "An object of worship."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff72baaa-0361-46c4-9f29-6cf68920f006",
                                                "sense_id": "44954d2b-75a4-303e-9070-77d6cfdb8838",
                                                "text": "In attitude and aspect formed to be / At once the artist's worship and despair!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d65c60d3-5980-3111-a26e-2cf51e6e9f11",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "Used as a title or term of address for various officials, including magistrates"
                                        ],
                                        "tags": [
                                            "British",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdffae4d-74c4-47b3-87e0-399bfd37f859",
                                                "sense_id": "d65c60d3-5980-3111-a26e-2cf51e6e9f11",
                                                "text": "“I beg your worship’s pardon,” said Mr. Bumble, incredulous of his having heard aright,—“did your worship speak to me?”"
                                            },
                                            {
                                                "example_id": "071f37a7-eb5c-4a8b-be9d-95577c1b4f20",
                                                "sense_id": "d65c60d3-5980-3111-a26e-2cf51e6e9f11",
                                                "text": "'Your Worships, I have a submission to put before the court. As Your Worships are aware, it is the duty of the court under Section thirty-nine of the Children and Young Persons Act to protect the identity of minors who are victims of offences […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b092914a-6c9c-3a67-acb5-f0c2455eaa43",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "Honour; respect; civil deference."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bba3a72-006e-41b3-9608-113eaf1cf3e5",
                                                "sense_id": "b092914a-6c9c-3a67-acb5-f0c2455eaa43",
                                                "text": "And many ſtrange aduentures to bee fond, / Of which great worth and worſhip may be wonne; […]"
                                            },
                                            {
                                                "example_id": "fb04a0e8-a5ff-4dae-ac8f-75e8aeac2d22",
                                                "sense_id": "b092914a-6c9c-3a67-acb5-f0c2455eaa43",
                                                "text": "But when thou art bidden, goe and sit downe in the lowest roume, that when he that bade thee commeth, hee may say vnto thee, Friend, goe vp higher: then shalt thou haue worship in the presence of them that sit at meate with thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb50a49d-ea78-384d-b2f6-0eed3ec776a2",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "The condition of being worthy; honour, distinction."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8932c96c-f4fe-4e3c-aa70-ce8241dd9a45",
                                                "sense_id": "fb50a49d-ea78-384d-b2f6-0eed3ec776a2",
                                                "text": "I will be on horsbak said the knyght / thenne was Arthur wrothe and dressid his sheld toward hym with his swerd drawen / whan the knyght sawe that / he a lyghte / for hym thought no worship to haue a knyght at suche auaille he to be on horsbak and he on foot and so he alyght & dressid his sheld vnto Arthur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                                        "entry_id": "07176214-4595-375c-a81b-97aeb953c179",
                                        "glosses": [
                                            "The fact of an artist's music heavily drawing influence from some other artist's work in a way that appears too obvious or unapologetic; a piece of music that does that."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "063f97d3-88d9-47f3-85c7-3120a9590b70",
                                                "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                                                "text": "In that time, McLachlan’s music has developed from adolescent Kate Bush worship to mature roots-driven folk (like the hits “Building a Mystery” and “Sweet Surrender”) and ballads (“Witness,” “I Love You”) that border on hymnody."
                                            },
                                            {
                                                "example_id": "42307a78-1cd8-4c7b-8a16-5f483e7b77cf",
                                                "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                                                "text": "Of course, it's as studied as the current crop of girl-group zealots such as Best Coast, but we're all for Beach Boys worship, even if we do wish, just once, a band would form in honour of Sunflower/Surf's Up/Holland/Carl [Wilson] and the Passions-era BBs, when they were sort of post-hippie baroque."
                                            },
                                            {
                                                "example_id": "4d524dd5-5200-42f9-9377-6169dd122673",
                                                "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                                                "text": "During his 15-year recording career, first with Galaxie 500 and now with Luna, Dean Wareham has shown all the signs of incurable Velvet Underground worship. The predilection for churning out ironic but always melodic rhythm-guitar-based tunes; the deadpan, almost-bored vocals: Why, it's enough to send you to the cover of the third Velvet Underground album, the one with Lou Reed and company sitting on a sofa, to see if Wareham's head is peeking out from behind it."
                                            },
                                            {
                                                "example_id": "4b9201af-2903-4c54-b570-a571e213f833",
                                                "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                                                "text": "Rather, Lenny's new material covered a lot of ground, from the folk-to-hard rock build of \"Fields of Joy,\" to the technology-accented church hymns of \"Stand by My Woman,\" to the unapologetic Jimi Hendrix worship of \"Stop Draggin' Around\" to the stylish orchestrated Philly soul of \"It Ain't Over 'til It's Over.\""
                                            },
                                            {
                                                "example_id": "e3674846-6cf2-4e94-971f-48ea9952d019",
                                                "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                                                "text": "Of the songs with actual vocals, it’s much more derivative than anything else they would do. A couple songs are pretty close to My Bloody Valentine worship (which suits me fine). There’s very little of the glacial bowed-guitar and neo-classicism that made them one of the most celebrated bands in the world."
                                            },
                                            {
                                                "example_id": "549f7d27-7105-48a0-928d-3d6f77e8de3b",
                                                "sense_id": "508304f8-1090-3e83-a3ec-0f1fdea656bf",
                                                "text": "The pieces are so removed from Godspeed You! Black Emperor worship or [William] Basinski-style concrete constructions that listeners will question Munkus’ intentions – and that’s a shame, because the material’s ambitions soar above the structure of the disc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "worship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "297f69c2-b52a-3f9e-a73d-9fc3068b505e",
                                        "entry_id": "f3a38f96-4125-3358-b761-e330da28ae96",
                                        "glosses": [
                                            "To reverence (a deity, etc.) with supreme respect and veneration; to perform religious exercises in honour of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c171d240-f1ea-4dbb-9a2c-69d4b063ca1c",
                                                "sense_id": "297f69c2-b52a-3f9e-a73d-9fc3068b505e",
                                                "text": "[…] well ſaid yfaith neighbour Verges, God's a good man, and two men ride of a horſe, one muſt ride behinde, an honeſt ſoule yfaith ſir, by my troth he is, as euer broke bread, but God is to bee worſhipt, all men are not alike, alas good neighbour."
                                            },
                                            {
                                                "example_id": "2560a7b7-9308-4769-9b37-98d813baf115",
                                                "sense_id": "297f69c2-b52a-3f9e-a73d-9fc3068b505e",
                                                "text": "When all our Fathers worſhip't Stocks and Stones, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "314b9d9b-509a-308c-ac43-36cda658a064",
                                        "entry_id": "f3a38f96-4125-3358-b761-e330da28ae96",
                                        "glosses": [
                                            "To honour with extravagant love and extreme submission, as a lover; to adore; to idolize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f238e99-0929-4a62-a852-cbed59a09af3",
                                                "sense_id": "314b9d9b-509a-308c-ac43-36cda658a064",
                                                "text": "With bended knees I daily worship her, / Yet she consumes her own Idolater."
                                            },
                                            {
                                                "example_id": "f031ea49-d86b-4063-a371-4c8e25c89552",
                                                "sense_id": "314b9d9b-509a-308c-ac43-36cda658a064",
                                                "text": "“[…] And she would sit in the car and pretend to hold the wheel. All the household worshipped her! Even the police came to understand that. Ah, the beautiful little one!”"
                                            },
                                            {
                                                "example_id": "cda3a4a1-85df-4a39-a14b-181f3fba77df",
                                                "sense_id": "314b9d9b-509a-308c-ac43-36cda658a064",
                                                "text": "The social media accounts of Hu Chenfeng, an auto repairman turned influencer whose videos have highlighted poverty and inequality in China, have been removed from several platforms. Propaganda officials in Zhejiang have accused him of “worshiping the West.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3378c4f-ea9e-3486-9fbc-22be44e39f19",
                                        "entry_id": "f3a38f96-4125-3358-b761-e330da28ae96",
                                        "glosses": [
                                            "To participate in religious ceremonies."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e3b9a1-5529-4770-a14b-6b9a0606aae9",
                                                "sense_id": "f3378c4f-ea9e-3486-9fbc-22be44e39f19",
                                                "text": "We worship at the church down the road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1279229a-44c0-362c-904f-c68bc4dabda0",
                                        "entry_id": "f3a38f96-4125-3358-b761-e330da28ae96",
                                        "glosses": [
                                            "To touch, fondle, or kiss in an intensely sensual way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff9277bf-b7bc-4b2b-87e1-135d80ffc073",
                                                "sense_id": "1279229a-44c0-362c-904f-c68bc4dabda0",
                                                "text": "The kiss is heady and passionate. I show him how far we are from being over by worshipping him with my lips."
                                            },
                                            {
                                                "example_id": "868abc8d-0227-4307-b3a6-eb3dbce0f62a",
                                                "sense_id": "1279229a-44c0-362c-904f-c68bc4dabda0",
                                                "text": "He moves lower to worship my breasts with his mouth, his teeth raking lightly over my nipple with the perfect amount of friction to build the pleasure coiling tight within me."
                                            },
                                            {
                                                "example_id": "0ff8e19b-a614-4104-aa7d-93212fcb1a75",
                                                "sense_id": "1279229a-44c0-362c-904f-c68bc4dabda0",
                                                "text": "Telling Kieran exactly how to please me, Kieran listening to every word and taking his time, making sure everything felt amazing, worshipping me with his hands and his mouth."
                                            }
                                        ]
                                    }
                                ]
                            }
