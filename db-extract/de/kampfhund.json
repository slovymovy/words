                    {
                        "form_id": "d92a1beb-be25-4961-932d-c237eebae7b9",
                        "entry_id": "14e09f80-4b5b-37fa-b979-448d399370c7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kampfhunde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9aa1d7e7-8240-3b54-8779-6f4bb521a7b0",
                        "entry_id": "14e09f80-4b5b-37fa-b979-448d399370c7",
                        "glosses": [
                            "für Kämpfe besonders abgerichteter Hund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbbb7ed0-a195-47a6-ac7b-0beac2d0090d",
                                "sense_id": "9aa1d7e7-8240-3b54-8779-6f4bb521a7b0",
                                "text": "Nicht alle Hunderassen eignen sich gleich gut dafür, als Kampfhund abgerichtet zu werden."
                            },
                            {
                                "example_id": "7d91aa45-f675-47a4-a2ee-d5485438ada7",
                                "sense_id": "9aa1d7e7-8240-3b54-8779-6f4bb521a7b0",
                                "text": "„Vor nichts auf der Welt habe ich so viel Angst wie vor Kampfhunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8796fcf3-181f-3ae4-8e13-e119a7cf417b",
                        "entry_id": "14e09f80-4b5b-37fa-b979-448d399370c7",
                        "glosses": [
                            "ein als besonders gefährlich geltender Hund, meist von bestimmten Rassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2b3530-8814-4c83-92bc-ab93a769ba07",
                                "sense_id": "8796fcf3-181f-3ae4-8e13-e119a7cf417b",
                                "text": "„Vor nichts auf der Welt habe ich so viel Angst wie vor Kampfhunden.“"
                            },
                            {
                                "example_id": "02bf3f49-b9f4-45ed-ab17-04a73a5902ff",
                                "sense_id": "8796fcf3-181f-3ae4-8e13-e119a7cf417b",
                                "text": "In der öffentlichen Diskussion werden gefährliche Hunde oft als Kampfhunde bezeichnet."
                            },
                            {
                                "example_id": "012c1ada-b0dc-42d2-b07d-14993a9aaad4",
                                "sense_id": "8796fcf3-181f-3ae4-8e13-e119a7cf417b",
                                "text": "„Ich habe mal von einem Kampfhund gelesen, mit einer Bisskraft, die rund einer Tonne Gewicht entspricht.“"
                            },
                            {
                                "example_id": "5901ed94-bc02-44d8-815d-36456e519c55",
                                "sense_id": "8796fcf3-181f-3ae4-8e13-e119a7cf417b",
                                "text": "„Bei seiner Reise durch Panama 1513 ließ der Spanier 40 Two-Spirits von eigens importierten Kampfhunden zerfleischen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
