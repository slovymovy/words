                                        "glosses": [
                                            "Que guarda moderación o equilibrio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c96a05-d3ac-4699-bad4-eaa47dad4281",
                                                "sense_id": "1a218d63-9875-3371-8b2e-cf9d93484b29",
                                                "text": "A los asuntos tomados de la mitología pagana y la historia grecolatina, sucedieron los inspirados en la historia medieval española, y al estilo sobrio y frío del teatro de imitación francesa de la centuria anterior, el ímpetu, la arrogancia y la exageración propia de los románticos."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
