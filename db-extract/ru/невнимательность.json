                                "target_senses": [
                                    {
                                        "sense_id": "c7fdd73a-d308-3b9d-b3e2-3c66461a0490",
                                        "entry_id": "c3684650-57b0-3255-b6ac-21aa3021c5df",
                                        "glosses": [
                                            "mangelnde Sorgfalt bei der gezielten Wahrnehmung der Umwelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826f8639-d643-46ae-96ec-0d7c999f00f7",
                                                "sense_id": "c7fdd73a-d308-3b9d-b3e2-3c66461a0490",
                                                "text": "„Am 24. Dezember nutzten Requiem, Lucien und Malingeau die Unaufmerksamkeit ihrer Gastgeber und suchten das Weite.“"
                                            },
                                            {
                                                "example_id": "a2820ead-c800-4e3e-b473-d746b09ef4bf",
                                                "sense_id": "c7fdd73a-d308-3b9d-b3e2-3c66461a0490",
                                                "text": "„Eine Unaufmerksamkeit des Busfahrers war die Ursache für das Busunglück am 3. Juli auf der Autobahn9 in Oberfranken in der Nähe von Münchberg.“"
                                            },
                                            {
                                                "example_id": "dfa1150f-4c50-4a90-9d88-27f135e534bb",
                                                "sense_id": "c7fdd73a-d308-3b9d-b3e2-3c66461a0490",
                                                "text": "„Je länger Kleinkinder in die Röhre schauen, desto häufiger fallen sie nach Erkenntnissen amerikanischer Forsche in den ersten Schuljahren durch Unruhe und Unaufmerksamkeit auf.“"
                                            }
                                        ],
