                    "sense_definition": "Voorzien van een dak of overkapping, waardoor het beschut is tegen het weer.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
