                ],
                "senses": [
                    {
                        "sense_id": "54e6c25a-b2c1-34d4-ace5-5ec46d6d9dac",
                        "entry_id": "5cfb3eb8-0ffc-3655-ac07-c22afb281eec",
                        "glosses": [
                            "mögliches Szenario"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee3f85c-e031-4097-b882-765fbb5365f4",
                                "sense_id": "54e6c25a-b2c1-34d4-ace5-5ec46d6d9dac",
                                "text": "„Ein anderer Anwendungsfall sind sogenannte »bewaffnete Antikörper«. Hier dienen Antikörper als Transportvehikel, um einen Wirkstoff möglichst gezielt zu Tumorzellen zu bringen, um diese abzutöten…“"
                            },
                            {
                                "example_id": "18267b48-ce00-4e90-b9ad-04eb183fab97",
                                "sense_id": "54e6c25a-b2c1-34d4-ace5-5ec46d6d9dac",
                                "text": "„Die eigene Geschichte ist nicht mehr der Anwendungsfall der Großen Geschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1e6c58d2-b6dd-3e3c-bd0e-86ed1f4fa67b",
                        "entry_id": "5cfb3eb8-0ffc-3655-ac07-c22afb281eec",
                        "glosses": [
                            "Gesamtheit der möglichen Szenarien, die eintreten können, wenn ein Akteur versucht, mit dem betrachteten System ein bestimmtes fachliches Ziel zu erreichen"
                        ],
                        "tags": [
                            "Softwaredesign",
                            "Anforderungsmanagement"
                        ],
                        "examples": [
                            {
                                "example_id": "66333bfa-2b61-4c78-ba00-0993e4e48f5c",
                                "sense_id": "1e6c58d2-b6dd-3e3c-bd0e-86ed1f4fa67b",
                                "text": "„Anwendungsfälle werden typischerweise so benannt, wie die Ziele aus Sicht der Akteure heißen: Mitglied anmelden, Geld abheben, Auto zurückgeben.“"
                            },
                            {
                                "example_id": "c4e8d67f-5c2c-44a1-bc01-505a3c34f682",
                                "sense_id": "1e6c58d2-b6dd-3e3c-bd0e-86ed1f4fa67b",
                                "text": "„Auch ohne Treiber kommt man schnell mit dem Programm zurecht, und seine Fähigkeiten reichen für viele Anwendungsfälle aus.“"
                            },
                            {
                                "example_id": "7026a7a3-fe30-49d0-85ff-c72cfc7f4bc3",
                                "sense_id": "1e6c58d2-b6dd-3e3c-bd0e-86ed1f4fa67b",
                                "text": "„Ein möglicher Anwendungsfall wäre, dass eine Geschäftsanwendung die Voice Control API wie ein Webservice über sogenannte SOAP-Aufrufe ansteuert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "bb96d508-7498-3a11-8e7f-bdf0dcd66728",
                        "entry_id": "5cfb3eb8-0ffc-3655-ac07-c22afb281eec",
                        "glosses": [
                            "Modellelement in der Unified Modeling Language (UML)"
                        ],
                        "tags": [
                            "Softwaredesign",
                            "Anforderungsmanagement, UML"
                        ],
                        "examples": [
                            {
                                "example_id": "1deabc03-2bd0-4c4e-8862-e4bce3fb3222",
                                "sense_id": "bb96d508-7498-3a11-8e7f-bdf0dcd66728",
                                "text": "„Das Modellelement Anwendungsfall in der UML 2 kann eigentlich nur deklarieren, dass ein Verhalten mit einem bestimmten Namen erforderlich ist, nicht aber wie dieses Verhalten im Detail aussehen soll.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
