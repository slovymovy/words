                "senses": [
                    {
                        "sense_id": "253c76b2-3941-3850-b5fa-7da74838eed1",
                        "entry_id": "a0fc478e-baee-329e-9b9e-df5567540063",
                        "glosses": [
                            "Zimmer, das zum An- und Ausziehen der Kleidung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfd1f8d-cd99-442f-9b69-b4b10488224f",
                                "sense_id": "253c76b2-3941-3850-b5fa-7da74838eed1",
                                "text": "„Und als Fürst Andrej in das Ankleidezimmer seines Vaters trat – nicht mit dem mürrischen Gesichtsausdruck und Wesen, mit denen er sich in den Salons der Gesellschaft bewegte, sondern mit dem lebensvollen Gesicht, das er bei seinem Gespräch mit Pierre gehabt hatte –, sass der Greis im Pudermantel in einem breiten, saffianbezogenen Lehnstuhl und hatte seinen Kopf den Händen Tichons überlassen.“"
                            },
                            {
                                "example_id": "7fe6070f-9b43-45e7-a6e3-d4cf3c6133d0",
                                "sense_id": "253c76b2-3941-3850-b5fa-7da74838eed1",
                                "text": "„Nach zwei Minuten im Ankleidezimmer kam die Q. wieder heraus und bat mich, ich möge ihr den Unterrock holen; nachdem ich ihn ihr gebracht hatte, ging sie wieder hinein und zog sich um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89bd4471-7a46-4f1c-96cc-35da3d8cbff9",
                        "source_entry_id": "a0fc478e-baee-329e-9b9e-df5567540063",
