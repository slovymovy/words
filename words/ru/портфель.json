                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгих переговоров политик получил желанный министерский <w>портфель</w>.",
                            "target_lang_translations": {
                                "en": "After long negotiations, the politician received the coveted ministerial <w>portfolio</w>.",
                                "de": "Nach langen Verhandlungen erhielt der Politiker das begehrte ministerielle <w>Portefeuille</w>."
                            }
