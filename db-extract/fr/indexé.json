                ],
                "senses": [
                    {
                        "sense_id": "81c6799b-2ef7-3845-b153-387b3495fc4e",
                        "entry_id": "2635b5e1-40a1-38b9-b0a4-5c86b97b3119",
                        "glosses": [
                            "Qui fait l’objet d’une indexation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a204aaa-8a38-41fc-a8ca-201fa72f65be",
                                "sense_id": "81c6799b-2ef7-3845-b153-387b3495fc4e",
                                "text": "Le montant des pensions a longtemps été indexé sur les salaires."
                            },
                            {
                                "example_id": "1deac3f6-a1be-44e1-ad74-e674700b725a",
                                "sense_id": "81c6799b-2ef7-3845-b153-387b3495fc4e",
                                "text": "En juin, « l’augmentation reflète les besoins des administrations publiques (+15,3 milliards), la hausse des disponibilités liquides du Trésor (+13,5 milliards), ainsi que l’effet des spreads et primes d’émission et de remboursement, la réévaluation des titres indexés sur l’inflation et l’évolution des taux de change (+1,4 milliard) », détaille la Banque d’Italie."
                            }
                        ]
                    },
                    {
                        "sense_id": "afd2c4b8-8225-3b8f-a8ea-7f9b64f42ff2",
                        "entry_id": "2635b5e1-40a1-38b9-b0a4-5c86b97b3119",
                        "glosses": [
                            "Pourvu d’un index, en parlant d’une table de données."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "158b66c4-8be6-4f39-bebe-317beb47b1bf",
                                "sense_id": "afd2c4b8-8225-3b8f-a8ea-7f9b64f42ff2",
                                "text": "L’accès aux enregistrements sera plus rapide si les tables sont indexées."
                            }
                        ]
                    },
                    {
                        "sense_id": "625d05de-a1a2-3b99-888c-232db00a894c",
                        "entry_id": "2635b5e1-40a1-38b9-b0a4-5c86b97b3119",
                        "glosses": [
                            "Réglable par crans successifs, par opposition à un réglage par variation continue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cedffa23-ec52-4f08-86dd-6f3e0beba817",
                                "sense_id": "625d05de-a1a2-3b99-888c-232db00a894c",
                                "text": "Les dérailleurs de vélo sont quasiment tous, aujourd’hui, indexés, ce qui permet de positionner la chaîne exactement en face du pignon plus facilement que du temps des dérailleurs non indexés."
                            }
                        ]
                    }
