                                        "glosses": [
                                            "Bovidé domestique de grande taille caractérisé par une bosse plus ou moins grande au niveau du garrot, un grand fanon et souvent classé comme une sous-espèce du bœuf domestique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1925ca20-d1c4-4b28-8e6c-57e53ab32f34",
                                                "sense_id": "20d015e3-1104-301a-ab90-54645ed6c3cd",
                                                "text": "Le petit bœuf de Belon, que nous avons vu et que nous nommerons zébu, n'est qu'une variété dans l'espèce du bœuf."
                                            },
                                            {
                                                "example_id": "0e90175a-1bf6-46e1-b7a4-766f23f593d5",
                                                "sense_id": "20d015e3-1104-301a-ab90-54645ed6c3cd",
                                                "text": "Le zébu descend d’une sous-espèce indienne de l’aurochs asiatique."
                                            },
                                            {
                                                "example_id": "1bcd829f-ad77-4e35-a080-76ac24a18c4b",
                                                "sense_id": "20d015e3-1104-301a-ab90-54645ed6c3cd",
                                                "text": "Le zébu est répandu dans les pays tropicaux."
                                            },
                                            {
                                                "example_id": "9176aa46-0955-4958-8ec2-6ea39968c4c9",
                                                "sense_id": "20d015e3-1104-301a-ab90-54645ed6c3cd",
                                                "text": "Les zébus sont communs en Afrique et à Madagascar."
                                            }
