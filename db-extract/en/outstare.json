                    {
                        "sense_id": "94968570-05d0-3f68-9d3b-4e3511889baf",
                        "entry_id": "3f48de72-fb2f-3cfc-b93a-f3101bc84808",
                        "glosses": [
                            "To stare at (someone) so hard or long that they look away."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f35af191-0d65-4f88-ab24-38e27f80961d",
                                "sense_id": "94968570-05d0-3f68-9d3b-4e3511889baf",
                                "text": "[…]I would outstare the sternest eyes that look,\nOutbrave the heart most daring on earth,\nPluck the young sucking cubs from the she-bear,\nYea, mock the lion when he roars for prey,\nTo win thee, lady.[…]"
                            },
                            {
                                "example_id": "5dbf6062-0cbb-4730-bc5a-0a912f73ae01",
                                "sense_id": "94968570-05d0-3f68-9d3b-4e3511889baf",
                                "text": "He held a tray but did not move from where he stood and managed, without any trace of emotion, to outstare Henry, who was standing in a group, half-listening to an anecdote."
                            }
                        ]
                    }
