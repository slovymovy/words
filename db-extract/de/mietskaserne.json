                ],
                "senses": [
                    {
                        "sense_id": "a017455c-6d17-3261-b611-68a1d842e73c",
                        "entry_id": "b5e4d0d4-c75f-3a29-8833-d8799ff82f7b",
                        "glosses": [
                            "äußerlich eher schlichtes größeres Wohnhaus, das mehrere/viele Mietwohnungen geringer Qualität aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8a5108-ad47-446a-949d-0c32925d0558",
                                "sense_id": "a017455c-6d17-3261-b611-68a1d842e73c",
                                "text": "„Dort, wo der kleine Janosch seine ersten Lebenstage verbrachte, regierten die roten Backsteine der ärmlichen Mietskasernen, doch die neu erbauten Gebäude und Siedlungen der expandierenden Stadt entstanden bereits im Geiste des Modernismus und Funktionalismus.“"
                            },
                            {
                                "example_id": "ab844f84-00af-4b1d-9314-dc6cd22d2589",
                                "sense_id": "a017455c-6d17-3261-b611-68a1d842e73c",
                                "text": "„An vielen Mietskasernen bröckelte der Putz, weil sich niemand mehr um den Erhalt kümmerte.“"
                            },
                            {
                                "example_id": "d18884d8-2ce9-4d8e-86e7-4f8d732a8ecf",
                                "sense_id": "a017455c-6d17-3261-b611-68a1d842e73c",
                                "text": "„Dort errichtete der Klub ein schmuckes, von Mietskasernen und den angrenzenden Gassen eng eingefasstes Kleinstadion mit offener Sitzplatztribüne, das insgesamt 15.000-20.000 Zuschauern Platz bot.“"
                            },
                            {
                                "example_id": "8eb9d38b-b2ca-4661-b02b-f9ca607f094d",
                                "sense_id": "a017455c-6d17-3261-b611-68a1d842e73c",
                                "text": "„Hinter der Sperre öffnet sich vor ihnen breit und leer die Landsberger Allee mit ihren vierstöckigen Mietskasernen, da und dort ragen ausgebrannte und eingestürzte Ruinen wie abgebrochene Zahnstümpfe zwischen den unzerstörten oder nur beschädigten Häusern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
