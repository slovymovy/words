                "senses": [
                    {
                        "sense_id": "d7e934aa-a751-3a8d-a1c9-c855636f3c52",
                        "entry_id": "b647c8be-3a24-3718-bdab-98acfd997a37",
                        "glosses": [
                            "normalerweise blauviolette Verfärbung der Haut an bestimmten Körperpartien, welche nach dem Tod auftritt"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1ce3a72b-b8c0-47ef-bfad-67d33bdaefe0",
                                "sense_id": "d7e934aa-a751-3a8d-a1c9-c855636f3c52",
                                "text": "Die Totenflecke waren deutlich zu sehen."
                            },
                            {
                                "example_id": "96f5634b-b28d-44d6-9a67-d9f6f2be4e73",
                                "sense_id": "d7e934aa-a751-3a8d-a1c9-c855636f3c52",
                                "text": "„Elma hatte schon oft genug eine Leiche gesehen, um zu wissen, dass die Flecke im Gesicht der Frau Totenflecke waren und sie also schon seit einer Weile nicht mehr am Leben war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
