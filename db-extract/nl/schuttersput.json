                "senses": [
                    {
                        "sense_id": "2d5532d4-6093-377f-a181-1df9194dd8cf",
                        "entry_id": "8ce0d23e-fa9a-3f8a-9ac5-21a2801b7533",
                        "glosses": [
                            "een gegraven gat waar een militair in ligt om vanuit te schieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c5aaf4d-fa46-4f01-bfea-c3bcf0871d4b",
                                "sense_id": "2d5532d4-6093-377f-a181-1df9194dd8cf",
                                "text": "In het leger leer je hoe je een schuttersput moet graven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88d62ae4-0678-440e-9b39-2e74f39a606a",
                        "source_entry_id": "8ce0d23e-fa9a-3f8a-9ac5-21a2801b7533",
                        "source_sense_id": "2d5532d4-6093-377f-a181-1df9194dd8cf",
                        "target_lang_word": "Schießscharte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schießscharte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2b596d-149c-3f4f-b165-1b990446286a",
                                        "entry_id": "90bf4808-fdfb-31fe-a976-03931e53b4cd",
                                        "glosses": [
                                            "Lücke in einer Mauer, durch die nach draußen geschossen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3538856-3053-41ec-a83d-7f4e59145556",
                                                "sense_id": "ba2b596d-149c-3f4f-b165-1b990446286a",
                                                "text": "Die Bogenschützen schossen durch die Schießscharten des Burgwalls auf die anstürmenden Feinde."
                                            },
                                            {
                                                "example_id": "10dbb59e-074b-48a3-8a6e-55229e64c7b3",
                                                "sense_id": "ba2b596d-149c-3f4f-b165-1b990446286a",
                                                "text": "„Der Ankömmling schien jedoch andere Absichten zu verfolgen, denn er setzte sich mir gegenüber auf den Rand der Schießscharte und knüpfte ein Gespräch über die Landschaft an.“"
                                            },
                                            {
                                                "example_id": "014df59e-941b-435d-ad8a-7d5b0e8ff925",
                                                "sense_id": "ba2b596d-149c-3f4f-b165-1b990446286a",
                                                "text": "„Am Bahndamm und in den Gärten waren Barrikaden mit Schießscharten errichtet.“"
                                            },
                                            {
                                                "example_id": "4218582f-38bd-4fe7-89cf-fbd97a1a7736",
                                                "sense_id": "ba2b596d-149c-3f4f-b165-1b990446286a",
                                                "text": "„Eines Tages überraschte ihn der Vater, wie er mit der mühsam festgehaltenen Büchse, auf den Fußspitzen stehend, durch eine Schießscharte des Zaunes nach einem unfern aufgeblockten Hühnergeier zielte.“"
                                            },
                                            {
                                                "example_id": "6e39c93b-ea05-47a1-831c-04186fc21f1f",
                                                "sense_id": "ba2b596d-149c-3f4f-b165-1b990446286a",
                                                "text": "„Dann zog man sie an starken Tauen zum Granithaus hinauf und ließ die Geschützrohre durch vorher ausgesprengte Schießscharten schauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03ece9af-7f7f-43f8-9d19-c6941120d4ac",
                        "source_entry_id": "8ce0d23e-fa9a-3f8a-9ac5-21a2801b7533",
                        "source_sense_id": "2d5532d4-6093-377f-a181-1df9194dd8cf",
                        "target_lang_word": "foxhole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foxhole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31532b28-cc16-3c1c-a509-75c23170a261",
                                        "entry_id": "ffc8c650-4159-31b1-9cb8-0f3730cd5203",
                                        "glosses": [
                                            "The burrow in the ground where a fox lives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10821369-9211-3ca9-ba8b-f7f4b4bd2813",
                                        "entry_id": "ffc8c650-4159-31b1-9cb8-0f3730cd5203",
                                        "glosses": [
                                            "A small pit dug into the ground as a shelter for protection against enemy fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b70f6d-2248-48ae-bfef-22a918870f84",
                                                "sense_id": "10821369-9211-3ca9-ba8b-f7f4b4bd2813",
                                                "text": "The statement made during the Second World War that “there are no atheists in foxholes” is absurd. Foxholes teem with atheists—who, to be sure, frequently infringe the Third Commandment in their desperation."
                                            },
                                            {
                                                "example_id": "c6eb49c2-0938-44b5-80e6-29fe186c4a37",
                                                "sense_id": "10821369-9211-3ca9-ba8b-f7f4b4bd2813",
                                                "text": "Four pilots from the St. Lo, returning from a strike, land at the Dulag Airstrip and are promptly handed carbines, given a foxhole, and told to help repel a Japanese infantry counterattack. With that job done, with the aid of some stacked boxes and buckets full of petrol, they rearm and repair their aircraft, and then head back out to land on other ships."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "foxhole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d80bc8df-f061-371f-8a1f-87f00f95e444",
                                        "entry_id": "2029cdb3-a8ec-3ea5-b687-596ac6960b93",
                                        "glosses": [
                                            "To dig a military foxhole into, or convert into a foxhole by digging."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f34bf999-1aec-4056-a5a5-fc7d2af5939e",
                                                "sense_id": "d80bc8df-f061-371f-8a1f-87f00f95e444",
                                                "text": "Trogh and Charlie have started foxholing one corner of our tent, and I helped them a little."
                                            },
                                            {
                                                "example_id": "36d1fd85-271d-4cd0-bc2d-38adedbcc789",
                                                "sense_id": "d80bc8df-f061-371f-8a1f-87f00f95e444",
                                                "text": "The line was not foxholed in. This is one weakness of the Nungs. They resent digging and so they do not carry entrenching tools into the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d41623f-4f2a-3781-9ff5-fe9d619ddc5e",
                                        "entry_id": "2029cdb3-a8ec-3ea5-b687-596ac6960b93",
                                        "glosses": [
                                            "To drive into a military foxhole."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cfe5879-a8ee-4395-9018-e4efbd605a5c",
                                                "sense_id": "4d41623f-4f2a-3781-9ff5-fe9d619ddc5e",
                                                "text": "[…] the vet recalled with terrible anguish a scene where he and his friend had been foxholed several dozen yards apart, with a small group of enemy soldiers (Viet Cong) coming toward them over the crest of a hill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
