                {
                    "sense_id": "e6e7d4d9-3f08-39ff-bad2-334aad5fe61c",
                    "sense_definition": "Misschien of mogelijk; wordt vaak gebruikt om te waarschuwen voor een ongewenste gebeurtenis die kan plaatsvinden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "possibility_warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zet die vaas weg, want <w>straks</w> valt hij nog kapot.",
                            "target_lang_translations": {
                                "ru": "Убери вазу, а то <w>вдруг</w> она разобьется.",
                                "en": "Put that vase away, because <w>otherwise</w> it might break.",
                                "pl": "Odstaw ten wazon, bo <w>jeszcze</w> się rozbije.",
                                "de": "Stell die Vase weg, <w>sonst</w> fällt sie noch runter und geht kaputt.",
                                "fr": "Pose ce vase, <w>sinon</w> il risque de se casser.",
                                "it": "Metti via quel vaso, <w>altrimenti</w> cade e si rompe.",
                                "cs": "Ukliď tu vázu, <w>aby</w> se ještě nerozbila.",
