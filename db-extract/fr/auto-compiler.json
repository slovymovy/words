                        "examples": [
                            {
                                "example_id": "7c711758-12b7-4609-a7d1-7d7c14167e6c",
                                "sense_id": "c69218c4-3ecd-3ad1-b097-572bfe60c621",
                                "text": "TCC vient justement d'une de ses entrée à l'IOCCC : un compilateur C minimaliste capable de s'auto-compiler, en 2048 octets."
                            },
                            {
                                "example_id": "13ab0487-bab3-41a1-9c32-09705ee95d71",
                                "sense_id": "c69218c4-3ecd-3ad1-b097-572bfe60c621",
                                "text": "Nvidia propose un fichier archive qui s’auto-compile et auto-installe sous toutes les distributions linux ; mais il existe aussi la méthode debian beaucoup plus efficace et simple."
                            }
