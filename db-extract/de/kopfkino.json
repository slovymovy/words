                "senses": [
                    {
                        "sense_id": "625e6a5a-d7c9-31de-83c0-e77e6349fe43",
                        "entry_id": "bf894bd6-45ee-3844-8c03-a3e671d56339",
                        "glosses": [
                            "imagination; inner cinema (in one's mind's eye)"
                        ],
                        "tags": [
                            "informal",
                            "neuter",
                            "singular",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "52aa42e4-2d0a-4555-a5e5-67b911fcc25c",
                                "sense_id": "625e6a5a-d7c9-31de-83c0-e77e6349fe43",
                                "text": "In meinem Kopfkino bin ich ein Held, gefeit gegen die schreckliche Vernunft der Sparsamen, ich kann lieben und leben ohne Netz.",
                                "translation": "In my imagination I am a hero, immune to the terrible reasonableness of frugal people; I can love and live without a net.",
                                "english": "In my imagination I am a hero, immune to the terrible reasonableness of frugal people; I can love and live without a net."
                            },
                            {
                                "example_id": "c1e8468e-a880-4918-8dce-72c808e7ed3f",
                                "sense_id": "625e6a5a-d7c9-31de-83c0-e77e6349fe43",
                                "text": "Wenn Sie von einem attraktiven Mann aus Bochum angepingt werden, weil er Ihre Posts so umwerfend findet, geht bei Ihnen auch das Kopfkino los und Sie überlegen sich, ob sich nicht doch ein Treffen lohnt.",
                                "translation": "If you are pinged by an attractive man from Bochum because he finds your posts so stunning, your imagination takes off and you consider whether it's worth meeting him.",
                                "english": "If you are pinged by an attractive man from Bochum because he finds your posts so stunning, your imagination takes off and you consider whether it's worth meeting him."
                            },
                            {
                                "example_id": "e9fd3985-2e55-4022-9864-05fb60c28d14",
                                "sense_id": "625e6a5a-d7c9-31de-83c0-e77e6349fe43",
                                "text": "Der neue Auftritt sorge hingegen dafür, dass schon beim Lesen von „Berlin“ das „Kopfkino losgeht“.",
                                "translation": "The new appearance, on the other hand, ensures that the \"mental cinema starts up\" just by reading \"Berlin\".",
                                "english": "The new appearance, on the other hand, ensures that the \"mental cinema starts up\" just by reading \"Berlin\"."
                            }
                        ]
                    }
                ],
