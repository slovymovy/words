                        "glosses": [
                            "To convert (a state etc.) to republican principles."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bf3a3aea-7fa9-4c51-98fc-5c307a015d23",
                                "sense_id": "f71f0791-f807-3353-9b50-f7837ea06653",
                                "text": "France was republicanized."
                            },
                            {
                                "example_id": "0616bb64-4fec-426b-a28a-8fbb56c7779c",
                                "sense_id": "f71f0791-f807-3353-9b50-f7837ea06653",
                                "text": "June 14, 1807, Thomas Jefferson, \"Letter to John Norvell\"\nHe has taken the text of Hume as his ground work, abridging it by the omission of some details of little interest, and wherever he has found him endeavoring to mislead, by either the suppression of a truth or by giving it a false coloring, he has changed the text to what it should be, so that we may properly call it Hume’s history republicanised."
                            },
                            {
                                "example_id": "9f864079-6cc1-4ba6-b4ba-c6746105e978",
                                "sense_id": "f71f0791-f807-3353-9b50-f7837ea06653",
                                "text": "To republicanize the rising generation, the convention of the people of South-Carolina made it the duty of the constituted authorities to do away this accompaniment of royalty as far as was compatible with liberty."
                            }
                        ]
                    }
