    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "70969905-7797-3cc8-9493-af2636842a0c",
                "word": "keloid",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ddadca8b-c107-4888-aba2-a3a8d58f8d4b",
                        "entry_id": "70969905-7797-3cc8-9493-af2636842a0c",
                        "tags": [
                            "plural"
                        ],
                        "form": "keloids"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                        "entry_id": "70969905-7797-3cc8-9493-af2636842a0c",
                        "glosses": [
                            "A hard raised growth of scar tissue at the site of an injury."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319fb756-7785-4fc7-86cc-9964e2ffa86e",
                                "sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                                "text": "It gave her otherwise plain face a broken excitement and blue-blade threat like the keloid scar of the razored man who sometimes played checkers with her grandmother."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15613b8a-3ba7-4553-8545-e961f3767067",
                        "source_entry_id": "70969905-7797-3cc8-9493-af2636842a0c",
                        "source_sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                        "source_sense_description": "growth of scar tissue",
                        "target_lang_word": "Narbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2a1f77-ed87-36f4-b10f-2f5b3d834150",
                                        "entry_id": "fc4ef7cc-789b-3dae-b880-432b90982274",
                                        "glosses": [
                                            "verheilende Wunde oder sichtbares Überbleibsel einer Wunde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6351d521-25df-4aa7-a35c-e5143c7d271c",
                                                "sense_id": "cf2a1f77-ed87-36f4-b10f-2f5b3d834150",
                                                "text": "Wenn die Wunde gut verheilt, werden kaum Narben bleiben."
                                            },
                                            {
                                                "example_id": "20fa072e-a0ae-4212-84f1-61c8353b357e",
                                                "sense_id": "cf2a1f77-ed87-36f4-b10f-2f5b3d834150",
                                                "text": "„Er hatte seinen einzigen guten Anzug an, ein altmodisches Überbleibsel aus seiner großen Zeit, und die Narbe an seiner Nase war schneeweiß.“"
                                            },
                                            {
                                                "example_id": "9a83a087-b950-4f34-a870-c498d105e451",
                                                "sense_id": "cf2a1f77-ed87-36f4-b10f-2f5b3d834150",
                                                "text": "„Der Mann mit der Narbe und der Alte starren ihn ungläubig an.“"
                                            },
                                            {
                                                "example_id": "b0a0736d-24e6-47f5-aa35-b9c29b59aaf9",
                                                "sense_id": "cf2a1f77-ed87-36f4-b10f-2f5b3d834150",
                                                "text": "„Die körperlichen und seelischen Narben wurden von einigen als stolze Beweisstücke, als Trophäen, getragen der Zugehörigkeit zu einer Truppe, die an Leidensfähigkeit ihresgleichen sucht.“"
                                            },
                                            {
                                                "example_id": "4fb68f75-887a-4535-aefc-7dc8bed2013e",
                                                "sense_id": "cf2a1f77-ed87-36f4-b10f-2f5b3d834150",
                                                "text": "„Die dicke rote Narbe über meiner linken Augenbraue, wo mich eine Bärin mit ihrer Tatze verletzt hatte, war deutlich zu sehen.“"
                                            },
                                            {
                                                "example_id": "9e8273ed-e1e0-4679-b76d-6990dbc11041",
                                                "sense_id": "cf2a1f77-ed87-36f4-b10f-2f5b3d834150",
                                                "text": "„Seine Narbe an der Stirn hatte er für eine Mensurnarbe gehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c97248ca-512f-31fb-9bdc-e9ee7b3af381",
                                        "entry_id": "fc4ef7cc-789b-3dae-b880-432b90982274",
                                        "glosses": [
                                            "äußere bearbeitete Seite eines Tierfelles"
                                        ],
                                        "tags": [
                                            "Gerberei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ee4060-6dec-4b0d-b247-3ebf8660b764",
                                                "sense_id": "c97248ca-512f-31fb-9bdc-e9ee7b3af381",
                                                "text": "Nach dem Entfernen der Borsten bleibt die Narbe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5b8cb078-260c-3583-a700-5242b1d1607b",
                                        "entry_id": "fc4ef7cc-789b-3dae-b880-432b90982274",
                                        "glosses": [
                                            "Pollen empfangender Teil des Griffels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbbf3a34-9087-492e-8a23-06228ea134bb",
                                                "sense_id": "5b8cb078-260c-3583-a700-5242b1d1607b",
                                                "text": "Die Narbe ist ganz gelb vor lauter Blütenstaub."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dc4fd863-6f59-312d-91f5-701332acdfc1",
                                        "entry_id": "fc4ef7cc-789b-3dae-b880-432b90982274",
                                        "glosses": [
                                            "oberer Teil eines Rasens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c716397d-71c5-46f4-b682-c68e8aed091e",
                                                "sense_id": "dc4fd863-6f59-312d-91f5-701332acdfc1",
                                                "text": "Die Narbe ist dicht verfilzt und sollte durchlüftet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a2d29dd-8a13-43e8-8f68-8cc1e1181cf9",
                        "source_entry_id": "70969905-7797-3cc8-9493-af2636842a0c",
                        "source_sense_id": "c2c2ec11-20d1-3704-ba6a-fa2d0a738eab",
                        "source_sense_description": "growth of scar tissue",
                        "target_lang_word": "Narbengewebe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narbengewebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                        "entry_id": "22bcfdb1-694a-33c8-bcb1-ca6b5e773439",
                                        "glosses": [
                                            "Gewebe einer Narbe, als Folge von Narbenbildung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f1e7123-446b-4440-9223-9a5ca329ba1e",
                                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                                "text": "„Seine Nase war mindestens zweimal gebrochen und unter den Augen hatte sich eine Menge Narbengewebe gebildet.“"
                                            },
                                            {
                                                "example_id": "38cc015d-96bf-46ae-ab7c-a2a31438e760",
                                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                                "text": "„Seine breite Stirn war eine einzige Masse aus grauem, striemigem Narbengewebe und sein linkes Auge, das, auf dem er blind war, war milchig grau und ohne jede Farbe.“"
                                            },
                                            {
                                                "example_id": "9a72eeaf-0bd0-451a-b341-36c5d0120ef0",
                                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                                "text": "„Die Haut um die Augen bestand aus grausigem Narbengewebe, obwohl der Unfall, das Feuer, das Omar El-Khayabs Sehfähigkeit für immer zerstört hatte, vor über 60 Jahren gebrannt hatte.“"
                                            },
                                            {
                                                "example_id": "d5f661ab-d462-4987-bc90-0c8bc05253ad",
                                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                                "text": "„Neuronen werden durch hirntotes Narbengewebe ersetzt.“"
                                            },
                                            {
                                                "example_id": "64ebc818-ba1e-44b5-b83a-d0b508eb4025",
                                                "sense_id": "a28bd982-bfe8-325a-adfb-7634f6c7ade3",
                                                "text": "„Nur ein Schatten, ein Umriss, eine Sekunde lang, sogar weniger, in der er das Gesicht des Mannes sah, bevor es wieder verschwand. Der große Russe, der Bär, dessen linkes Ohr zu dickem Narbengewebe verformt war, als sei ein Stück davon abgebissen worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
