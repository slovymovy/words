                    {
                        "translation_id": "137a6467-2d81-41b4-a90a-1378d8217913",
                        "source_entry_id": "09cfe254-f910-39c8-a0b6-78169e72b9fc",
                        "source_sense_id": "ba906b97-2fbf-3ff9-8454-644a20698a46",
                        "target_lang_word": "pasarela",
