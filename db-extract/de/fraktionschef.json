                            {
                                "example_id": "6e3d719b-d550-4489-ac5a-3bc0dc58c1f5",
                                "sense_id": "d1295c4a-4543-371a-b300-cfd9053c0bb5",
                                "text": "„Der Fraktionschef der SPD im Stadtrat ist kein Mann für die Kuschelecke, jedenfalls nicht für die politische.“"
