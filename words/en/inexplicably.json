                    "sense_definition": "In a way that cannot be explained or understood; for an unknown reason.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>inexplicably</w> stopped in the middle of the busy highway.",
                            "target_lang_translations": {
                                "pl": "Samochód <w>niewytłumaczalnie</w> zatrzymał się na środku ruchliwej autostrady.",
                                "zh": "那辆车在繁忙的高速公路中央<w>莫名其妙地</w>停了下来。"
                            }
                        },
                        {
                            "text": "He <w>inexplicably</w> decided to quit his job without any warning.",
                            "target_lang_translations": {
                                "pl": "Podjął <w>niewytłumaczalną</w> decyzję o rzuceniu pracy bez żadnego ostrzeżenia.",
                                "zh": "他毫无预警，<w>不知为何</w>决定辞掉工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unexplainably"
                    ],
                    "target_lang_definitions": {
