                ],
                "senses": [
                    {
                        "sense_id": "46809966-1911-3448-a0c4-469906b6f8f8",
                        "entry_id": "2f9b792d-a319-3201-a098-5db053ad51e5",
                        "glosses": [
                            "Faire des glouglous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a34e08d-995e-416d-82d0-0d7ff45177c4",
                                "sense_id": "46809966-1911-3448-a0c4-469906b6f8f8",
                                "text": "Pour la femme de l'ex-président «les diseurs caquettent ou croassent, gloglotent, jacassent dans leurs poulaillers»."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba19f301-85bc-3720-b2f3-80555a7ca84d",
                        "entry_id": "2f9b792d-a319-3201-a098-5db053ad51e5",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "305b8bb0-8a38-4f2f-81a1-8afbdde748da",
                                "sense_id": "ba19f301-85bc-3720-b2f3-80555a7ca84d",
                                "text": "Pour ma part aucun souci de réglage, par contre ils gloglotent quand je roule sur routes en mauvais état, quelqu'un a déjà eu ce \"phénomène\"??"
                            },
                            {
                                "example_id": "abb7dc87-8105-4968-b7d3-9ae201f68b09",
                                "sense_id": "ba19f301-85bc-3720-b2f3-80555a7ca84d",
                                "text": "Ça finit toujours par lâcher ou glogloter un jour où l'autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "05fab7ca-3762-3202-b004-b73a6b50e4ad",
                        "entry_id": "2f9b792d-a319-3201-a098-5db053ad51e5",
                        "glosses": [
                            "Boire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46fe931-35b2-4d17-9798-ac6dd29eeb55",
                                "sense_id": "05fab7ca-3762-3202-b004-b73a6b50e4ad",
                                "text": "Je préférerais glogloter des vins de Pauillac plutôt que de la piquette."
                            }
                        ]
                    }
