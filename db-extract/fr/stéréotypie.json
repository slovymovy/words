                "senses": [
                    {
                        "sense_id": "01219319-e0ba-3a18-881b-1df910048c7a",
                        "entry_id": "673198f3-1215-3d55-8a01-ab678b3fab44",
                        "glosses": [
                            "Art de stéréotyper."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4907cd27-0821-380c-9f04-a35e0e55a785",
                        "entry_id": "673198f3-1215-3d55-8a01-ab678b3fab44",
                        "glosses": [
                            "Répétitions de mots ou de phrases, ou répétition de gestes de manière automatique. Ils sont propres à chaque sujet et ont donc une signification subjective."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd78f15e-da8f-4a36-9e19-d3e23ef64d69",
                                "sense_id": "4907cd27-0821-380c-9f04-a35e0e55a785",
                                "text": "Pour réactiver plus sûrement le processus automatique, on change de chanson à chaque fois en variant l’ordre pour éviter l’apparition d’une stéréotypie."
                            },
                            {
                                "example_id": "5c2937b3-1c79-42d7-898f-991a0b564bfa",
                                "sense_id": "4907cd27-0821-380c-9f04-a35e0e55a785",
                                "text": "Les petits enfants privés de liens affectifs montrent des manifestations telles que le repli sur soi, le regard vide, l’apathie, des terreurs injustifiées ou des stéréotypies."
                            }
                        ]
                    },
                    {
                        "sense_id": "feb8a4ad-7fc4-3821-b43c-a48a5b429a10",
                        "entry_id": "673198f3-1215-3d55-8a01-ab678b3fab44",
                        "glosses": [
                            "Action de suivre des stéréotypes."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b16feaff-1b19-4d7e-bd45-061d975c0998",
                                "sense_id": "feb8a4ad-7fc4-3821-b43c-a48a5b429a10",
                                "text": "La stéréotypie des gestes, des actes, des mensonges de l’Europe a accompli le cycle du dégoût."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
