                                "target_senses": [
                                    {
                                        "sense_id": "6960e3f4-391b-39bc-9e61-5f7bf112bd83",
                                        "entry_id": "c366a4b9-9ed0-3481-8ad9-9c782eabc4c6",
                                        "glosses": [
                                            "A person who commits fraud by making dishonest scams and business deals: swindler, cheat, grifter."
                                        ],
                                        "tags": [
                                            "common-gender",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "582b0329-6326-4705-a396-b17d2dcce0f3",
                                                "sense_id": "6960e3f4-391b-39bc-9e61-5f7bf112bd83",
                                                "text": "According to Netsafe, scammers send out a bunch of emails, hoping to snag a few gullible people, but simply deleting the offending email won’t do anything to impede the con."
                                            },
                                            {
                                                "example_id": "3bd08ff6-1f4c-4ec4-9bdb-bfb81f1362fb",
                                                "sense_id": "6960e3f4-391b-39bc-9e61-5f7bf112bd83",
                                                "text": "TransPennine Express has removed all QR codes from its 71 car parks after scammers covered up a genuine code sticker with a false one and stole £13,000 from a woman's bank account."
                                            }
                                        ]
                                    }
                                ]
                            }
