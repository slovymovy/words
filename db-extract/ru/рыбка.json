                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rybka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "21e24b6a-3b3a-3b26-be50-b86bfde782f6",
                                        "entry_id": "4ff5eccc-d523-3bbc-923d-48627d491f4a",
                                        "glosses": [
                                            "od: ryba"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b25ac89-0e4d-4677-bfe9-665ef2bb26f3",
                                                "sense_id": "21e24b6a-3b3a-3b26-be50-b86bfde782f6",
                                                "text": "Wtem się coś z lekka potrąci • Śród kryształowej przezroczy, • Woda się z lekka zamąci, • Rybka nad wodę podskoczy; • I jak skałka płaskim bokiem • Gdy z lekkich rąk chłopca pierzchnie, • Tak nasza rybka podskokiem • Mokre całuje powierzchnie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "a6e5a80c-bd5b-3f9f-9631-7f562dfb3ba8",
                                        "entry_id": "4ff5eccc-d523-3bbc-923d-48627d491f4a",
                                        "glosses": [
                                            "mała ryba"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfcbcc97-7b13-4641-9f91-a8fd532f08aa",
                                                "sense_id": "a6e5a80c-bd5b-3f9f-9631-7f562dfb3ba8",
                                                "text": "Wąż wodny gonił drobną rybkę, unosząc kłębki mułu spomiędzy kamieni."
                                            },
                                            {
                                                "example_id": "cc621089-0030-4258-a2a8-844fab00436f",
                                                "sense_id": "a6e5a80c-bd5b-3f9f-9631-7f562dfb3ba8",
                                                "text": "W akwarium wylęgły się nam rybki."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "5a4cd50f-c5dd-3d65-be6a-a8b3df3c8364",
