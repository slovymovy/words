                "senses": [
                    {
                        "sense_id": "3c35ba27-f40d-3d2d-b440-c4cf36e64554",
                        "entry_id": "c1776eb0-a421-3626-83d8-d974e1e2f28c",
                        "glosses": [
                            "związany z plazmą, dotyczący plazmy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21df9134-54d4-4687-91aa-741f51ecfacd",
                                "sense_id": "3c35ba27-f40d-3d2d-b440-c4cf36e64554",
                                "text": "Teraz mamy wreszcie klasę średnią, ale o preferencjach… mercedesowych. Ta klasa woli inwestować w telewizory plazmowe, samochody, mieszkania, a brązy kupuje w galeriach po wielokrotnie wyższej cenie niż u mnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
