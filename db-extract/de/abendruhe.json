                "senses": [
                    {
                        "sense_id": "a5bd8e51-ed6c-30c7-926f-c4bfc603386b",
                        "entry_id": "8cbc8a4b-c2e7-341e-b3b8-bc4d556a82d6",
                        "glosses": [
                            "Stille, die sich am Abend einstellen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba899ed-6920-49d9-a5e8-4a9d8e4221bf",
                                "sense_id": "a5bd8e51-ed6c-30c7-926f-c4bfc603386b",
                                "text": "„Der restliche Platz gehört der Abendruhe und ist der luftige Speisesaal aller Bewohner.“"
                            },
                            {
                                "example_id": "59cb2edc-8f58-40c3-943d-7b2181cbd9f4",
                                "sense_id": "a5bd8e51-ed6c-30c7-926f-c4bfc603386b",
                                "text": "„Die Landschaft lag in tiefem Schweigen. Aber es war nicht das Schweigen der Abendruhe, das Schweigen zum Plätschern in der rosa Plastikschüssel beim Füßewaschen, es war ein brütendes Schweigen.“"
                            },
                            {
                                "example_id": "9ad5295b-f89a-483b-9a85-9e97f7ccf8ca",
                                "sense_id": "a5bd8e51-ed6c-30c7-926f-c4bfc603386b",
                                "text": "„Es war ein müdes Pferd, das ungesattelt und ungezäumt, ohne Lenker noch Hüter in der Abendruhe seinen Stall aufsuchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
