                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ccd890a-d1cd-458e-8ad8-9380ce42bbfc",
                                                "sense_id": "70601b5a-d2c9-3f71-b4d4-703fed06c582",
                                                "text": "LAUNDRY.\n1 Dolly tub and pegs\n2 Mangle\n3 Washing machine"
                                            },
                                            {
                                                "example_id": "f24a9d2c-5282-4350-b26c-b3d3ce62e8b0",
                                                "sense_id": "70601b5a-d2c9-3f71-b4d4-703fed06c582",
                                                "text": "In its most common form, the dolly was a four- or five-legged stool attached to an upright handle about three feet long with a crossbar handle at the top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5b9a6ff-b064-3613-ac1e-7296bfc39900",
                                        "entry_id": "5ac1a680-e330-3eff-b277-5f0a04f1e7df",
                                        "glosses": [
                                            "A contrivance for stirring:",
                                            "A device turned on a vertical axis by a handle or a winch, giving a circular motion to ore being washed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3e74a0-1866-4e5a-aae5-7ec26aef2c6d",
                                                "sense_id": "e5b9a6ff-b064-3613-ac1e-7296bfc39900",
                                                "text": "The dolly tub or rinsing bucket, fig. 630., has an upright shaft which bears the vane or dolly a b, turned by the winch handle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ee6b76-e5a3-315d-983e-668b9b29b0e4",
                                        "entry_id": "5ac1a680-e330-3eff-b277-5f0a04f1e7df",
                                        "glosses": [
                                            "A tool with an indented head for shaping the head of a rivet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dde519d9-9cfd-49da-bad9-b01e43ad67c9",
                                                "sense_id": "c2ee6b76-e5a3-315d-983e-668b9b29b0e4",
                                                "text": "A, is the steam or air cylinder for forcing the dolly B, hard against the rivet head while rivetting: when used for making rivets the dolly B, is unshipped, and the rivet heading apparatus substituted."
                                            }
                                        ]
                                    },
