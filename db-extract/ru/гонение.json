                ],
                "senses": [
                    {
                        "sense_id": "45c0830f-d497-387b-bf3c-b390bb9056f9",
                        "entry_id": "ded44881-9c27-3d5f-af73-644edbfa8822",
                        "glosses": [
                            "преследование, притеснение кого-либо или чего-либо, постоянные нападки на кого-либо или на что-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e5cc41a-0e93-4afc-8a58-39123dcff048",
                        "source_entry_id": "ded44881-9c27-3d5f-af73-644edbfa8822",
                        "source_sense_id": "45c0830f-d497-387b-bf3c-b390bb9056f9",
                        "target_lang_word": "persecution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persecution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                        "entry_id": "fd6d8ce5-b99f-3b55-a51a-2be02e31a90e",
                                        "glosses": [
                                            "The act of persecuting, especially a specific group of people; an instance of persecution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb4e743-c9b7-4723-a108-ddeb58448960",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "Many apartheid perpetrators escaped prosecution for their persecution of black Africans and political dissidents."
                                            },
                                            {
                                                "example_id": "06bcd4fe-3f6a-4236-b586-cd94a2cec306",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "During the early 20th century, wolves were considered undesirable. They were subject to persecution and were extirpated from large areas of their original range. With increased environmental awareness in the 1970s, attitudes toward wolves began to change."
                                            },
                                            {
                                                "example_id": "996f60e7-a802-4573-b831-b5d29fb8c2a3",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "[…] to support or agree with the persecutions, beatings, dehumanizings, insults, murders, genocides, and oppressions of a perpetrator's target […]"
                                            },
                                            {
                                                "example_id": "3e2928ec-edd9-497b-a08c-00f5d6d09781",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                                            },
                                            {
                                                "example_id": "3ca83369-61f8-4ca4-bd90-89b21dab1dea",
                                                "sense_id": "49beedb0-393c-3800-bafa-d6db45e52fed",
                                                "text": "I see this not as persecution, but a learning chance to grow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2bbbc7-7221-4ee8-8d40-e32528ad4122",
                        "source_entry_id": "ded44881-9c27-3d5f-af73-644edbfa8822",
                        "source_sense_id": "45c0830f-d497-387b-bf3c-b390bb9056f9",
                        "target_lang_word": "suppression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suppression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cec9353b-31f6-3410-adc2-5bc42e9c7dc3",
                                        "entry_id": "ae4dc4ec-99ad-35e8-a701-c7419f82e8a8",
                                        "glosses": [
                                            "The act or instance of suppressing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc117d1d-1831-4bfb-8047-b032d53cc47d",
                                                "sense_id": "cec9353b-31f6-3410-adc2-5bc42e9c7dc3",
                                                "text": "The suppression of uncomfortable ideas may be common in religion and politics, but it is not the path to knowledge; it has no place in the endeavor of science."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fd285ce-738e-367a-aecd-0c28cc80f087",
                                        "entry_id": "ae4dc4ec-99ad-35e8-a701-c7419f82e8a8",
                                        "glosses": [
                                            "The state of being suppressed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4577fee4-811c-3aa6-8507-6284bbeabc15",
                                        "entry_id": "ae4dc4ec-99ad-35e8-a701-c7419f82e8a8",
                                        "glosses": [
                                            "A process in which a person consciously excludes anxiety-producing thoughts, feelings, or memories."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa3ea5bf-bceb-3fd4-b8ab-2778dc5b32fc",
                                        "entry_id": "ae4dc4ec-99ad-35e8-a701-c7419f82e8a8",
                                        "glosses": [
                                            "The entirety of acts aimed at stopping or preventing the enemy to execute such unwanted activities like firing, regrouping, observation or others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7353055d-1a07-4c7d-b1d5-5c25af1ce9c0",
                                                "sense_id": "aa3ea5bf-bceb-3fd4-b8ab-2778dc5b32fc",
                                                "text": "In these circumstances the Communist guerrillas had survived Kuomintang suppression and in the autumn of 1931 they had launched a rising in the Huanglung Mountains of north Shensi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f388dd-7043-3257-b903-aa85c78b3506",
                                        "entry_id": "ae4dc4ec-99ad-35e8-a701-c7419f82e8a8",
                                        "glosses": [
                                            "A subconscious adaptation by a person's brain to eliminate the symptoms of disorders of binocular vision such as strabismus, convergence insufficiency and aniseikonia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61f4010f-2ca4-48f6-ae99-cb231f6b1656",
                        "source_entry_id": "ded44881-9c27-3d5f-af73-644edbfa8822",
                        "source_sense_id": "45c0830f-d497-387b-bf3c-b390bb9056f9",
                        "target_lang_word": "Verfolgung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfolgung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc762745-4686-3937-9e16-edb49751235f",
                                        "entry_id": "ff9f6b21-97a9-3417-bfee-a3292a60f454",
                                        "glosses": [
                                            "das Nachstellen, zum Beispiel um etwas zu beobachten, einzuholen oder zu ergreifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9abcfec-ecd2-4c75-b9e8-210c592b06cc",
                                                "sense_id": "bc762745-4686-3937-9e16-edb49751235f",
                                                "text": "Maria organisierte die Verfolgung ihres Mannes an jenem Vormittag professionell. Drei Teams würden sich ablösen."
                                            },
                                            {
                                                "example_id": "7b9e26b7-ce82-45e3-9c3f-27ea32d8684a",
                                                "sense_id": "bc762745-4686-3937-9e16-edb49751235f",
                                                "text": "„Solche Situationen sind, wie man aus Hintergrundgesprächen erfährt, Verfolgungen und Festnahmen, bei denen es zu Rangeleien oder gar Prügeleien kommen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2ffd8a19-e353-30fe-8a15-a3feb47a9b3d",
                                        "entry_id": "ff9f6b21-97a9-3417-bfee-a3292a60f454",
                                        "glosses": [
                                            "konsequentes Bemühen, etwas zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7658be7b-36fd-46f2-96b3-15a1a5fd61b6",
                                                "sense_id": "2ffd8a19-e353-30fe-8a15-a3feb47a9b3d",
                                                "text": "Die Verfolgung seiner Ziele war ihm immer wichtig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3aa91909-900e-3edc-b71e-55ef10fba917",
                                        "entry_id": "ff9f6b21-97a9-3417-bfee-a3292a60f454",
                                        "glosses": [
                                            "Schikane von Menschen, die eine andere, zum Beispiel politische oder religiöse, Auffassung oder Lebensweise haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3691da31-d95e-4cf3-9474-eb366c188cb1",
                                                "sense_id": "3aa91909-900e-3edc-b71e-55ef10fba917",
                                                "text": "Die Verfolgung der Juden im dritten Reich war grauenvoll."
                                            },
                                            {
                                                "example_id": "1628ee2e-9090-42ff-94a7-81a2dd24f603",
                                                "sense_id": "3aa91909-900e-3edc-b71e-55ef10fba917",
                                                "text": "„Viele waren vor Strafen oder Verfolgung in ihren Heimatländern geflohen, von Mördern und Kriegsverbrechern über Pleitiers bis zu Kriegsdienstverweigerern und politischen Aktivisten.“"
                                            },
                                            {
                                                "example_id": "bfc679d0-c041-4c76-b759-de666ae9eaf6",
                                                "sense_id": "3aa91909-900e-3edc-b71e-55ef10fba917",
                                                "text": "„In Kursachsen waren Hexen- und Zaubereiprozesse während der gesamten ersten Hälfte des 16. Jahrhunderts, also bereits vor der Eskalation der Verfolgungen ab den 1560er-Jahren, zwar nicht an der Tagesordnung, aber auch keine Seltenheit.“"
                                            },
                                            {
                                                "example_id": "2990b4f0-321f-47f3-a007-deac9b1bafdf",
                                                "sense_id": "3aa91909-900e-3edc-b71e-55ef10fba917",
                                                "text": "„Problematisch ist nur eine Aufführung des Theaterstücks „Die Rassen“, in dem Ferdinand Bruckner, seit 1933 in Paris lebend, die Verfolgung von Juden durch die Nazis anprangert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
