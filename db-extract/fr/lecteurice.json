                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89d47619-3211-3fe2-a406-d52582dbf040",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "Any device that reads something."
