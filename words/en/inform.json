                {
                    "sense_id": "90d8b465-e7a6-3be7-8d1f-30604e378524",
                    "sense_definition": "To influence something such as an opinion, attitude, or style; to be the essential quality of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her experience as a teacher <w>informs</w> her approach to parenting.",
                            "target_lang_translations": {
                                "ru": "Ее опыт учителя <w>определяет</w> ее подход к воспитанию детей.",
                                "nl": "Haar ervaring als lerares <w>beïnvloedt</w> haar benadering van het ouderschap.",
                                "pl": "Jej doświadczenie jako nauczycielki <w>kształtuje</w> jej podejście do rodzicielstwa.",
                                "de": "Ihre Erfahrung als Lehrerin <w>prägt</w> ihre Herangehensweise an die Kindererziehung.",
                                "fr": "Son expérience d'enseignante <w>influence</w> sa façon d'élever ses enfants.",
                                "it": "La sua esperienza come insegnante <w>influenza</w> il suo approccio alla genitorialità.",
                                "cs": "Její zkušenost učitelky <w>ovlivňuje</w> její přístup k rodičovství.",
                                "tr": "Öğretmenlik deneyimi, ebeveynlik yaklaşımını <w>şekillendiriyor</w>.",
                                "es": "Su experiencia como maestra <w>influye</w> en su enfoque de la crianza de los hijos."
                            }
                        },
                        {
                            "text": "A strong sense of social justice <w>informs</w> all of his writing.",
                            "target_lang_translations": {
                                "ru": "Сильное чувство социальной справедливости <w>пронизывает</w> все его произведения.",
                                "nl": "Een sterk gevoel van sociale rechtvaardigheid <w>vormt de basis van</w> al zijn schrijven.",
                                "pl": "Silne poczucie sprawiedliwości społecznej <w>przenika</w> całą jego twórczość.",
                                "de": "Ein starkes Gespür für soziale Gerechtigkeit <w>durchzieht</w> all seine Schriften.",
                                "fr": "Un sens aigu de la justice sociale <w>façonne</w> tous ses écrits.",
                                "it": "Un forte senso di giustizia sociale <w>caratterizza</w> tutti i suoi scritti.",
                                "cs": "Silný smysl pro sociální spravedlnost <w>prolíná</w> celým jeho dílem.",
                                "tr": "Güçlü bir sosyal adalet duygusu, tüm yazılarına <w>yön veriyor</w>.",
                                "es": "Un fuerte sentido de justicia social <w>define</w> todos sus escritos."
                            }
                        }
