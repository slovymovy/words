                            {
                                "example_id": "d0c89272-1e5e-4f26-a421-96788bca7d26",
                                "sense_id": "b1be99ed-c2bf-3663-83f2-be63318aec88",
                                "text": "In Los Angeles begint opnieuw een rechtszaak over de dood van popicoon Michael Jackson. De familie van Jackson eist 30 miljard euro schadevergoeding van concertpromotor AEG Live, die in 2009 een concertreeks plande met de zanger."
                            },
                            {
                                "example_id": "128e83ff-9469-4afa-b8f8-56a317bfdb59",
                                "sense_id": "b1be99ed-c2bf-3663-83f2-be63318aec88",
                                "text": "December 2004: In een overvolle nachtclub in de Argentijnse hoofdstad Buenos Aires komen 194 mensen om bij een brand die sterk doet denken aan die in Santa Maria. Het vuur wordt veroorzaakt door fans van een optredende band die met fakkels onbedoeld isolatiemateriaal in het plafond aansteken. De eigenaar en een concertpromotor worden later veroordeeld tot twintig jaar cel."
                            }
                        ]
