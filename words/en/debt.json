{
    "word_family": [
        "debtor",
        "indebted",
        "indebtedness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "158b894f-0928-36a0-98e3-0f46c51c8ef1",
                    "sense_definition": "Money that one person or entity owes or is required to pay to another, generally as a result of a loan or other financial transaction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took him five years to finally pay off his student <w>debt</w>.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось пять лет, чтобы наконец выплатить свой <w>долг</w> за обучение.",
                                "zh": "他花了五年时间才终于还清了学生<w>债务</w>。"
                            }
                        },
                        {
                            "text": "The company is struggling to manage its massive corporate <w>debt</w>.",
                            "target_lang_translations": {
                                "ru": "Компания с трудом справляется со своей огромной корпоративной <w>задолженностью</w>.",
                                "zh": "这家公司正努力应对其庞大的企业<w>债务</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liability",
                        "arrears",
                        "dues",
                        "obligation",
                        "balance"
                    ],
                    "antonyms": [
                        "asset",
                        "credit"
                    ],
                    "common_phrases": [
                        "pay off debt",
                        "national debt",
                        "student debt",
                        "cancel debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, которые одно лицо или организация должны выплатить другому, обычно в результате займа или другой финансовой операции.",
                        "zh": "指个人或实体欠他人的钱，通常因贷款或其他金融交易产生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долг",
                                "target_lang_sense_clarification": "денежная сумма, взятая взаймы"
                            },
                            {
                                "target_lang_word": "задолженность",
                                "target_lang_sense_clarification": "сумма невыполненных финансовых обязательств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "债务",
                                "target_lang_sense_clarification": "指欠款的金额或财务义务"
                            },
                            {
                                "target_lang_word": "欠款",
                                "target_lang_sense_clarification": "指尚未偿还的款项"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21829f7d-5821-3ef6-ac01-27d2843bf5fe",
                    "sense_definition": "The state or condition of owing something to another.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financial_obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing his job, he fell deeply in <w>debt</w> to the bank.",
                            "target_lang_translations": {
                                "ru": "Потеряв работу, он глубоко погряз в <w>долгах</w> перед банком.",
                                "zh": "失业后，他背上了银行的沉重<w>负债</w>。"
                            }
                        },
                        {
                            "text": "They are working two jobs to get out of <w>debt</w> as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Они работают на двух работах, чтобы выбраться из <w>долгов</w> как можно скорее.",
                                "zh": "他们打两份工，希望能尽快摆脱<w>负债</w>状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indebtedness"
                    ],
                    "antonyms": [
                        "solvency"
                    ],
                    "common_phrases": [
                        "in debt",
                        "out of debt",
                        "fall into debt",
                        "heavily in debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или положение, при котором кто-либо должен что-то другому.",
                        "zh": "处于欠他人钱财的状态或境况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долг",
                                "target_lang_sense_clarification": "состояние финансовой зависимости"
                            },
                            {
                                "target_lang_word": "задолженность",
                                "target_lang_sense_clarification": "наличие невыплаченных обязательств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负债",
                                "target_lang_sense_clarification": "指处于欠债的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eda330ea-385f-313e-999d-ba0b3aa83381",
                    "sense_definition": "An action, state of mind, or object one has an obligation to perform for another, adopt toward another, or give to another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I owe a huge <w>debt</w> of gratitude to the doctors who saved my life.",
                            "target_lang_translations": {
                                "ru": "Я в огромном <w>долгу</w> перед врачами, которые спасли мне жизнь.",
                                "zh": "我对救了我的医生们怀有深厚的<w>恩情</w>。"
                            }
                        },
                        {
                            "text": "He felt it was a <w>debt</w> of honor to repay the kindness shown to him.",
                            "target_lang_translations": {
                                "ru": "Он считал <w>долгом</w> чести отплатить за проявленную к нему доброту.",
                                "zh": "他认为报答别人对他的善意是一种<w>道义责任</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obligation",
                        "duty"
                    ],
                    "common_phrases": [
                        "debt of gratitude",
                        "debt of honor",
                        "pay a debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Моральное обязательство, чувство необходимости совершить действие или проявить определенное отношение к кому-либо.",
                        "zh": "指在道德或情感上对他人负有的义务或责任。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долг",
                                "target_lang_sense_clarification": "моральная обязанность"
                            },
                            {
                                "target_lang_word": "обязанность",
                                "target_lang_sense_clarification": "то, что подлежит безусловному выполнению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恩情",
                                "target_lang_sense_clarification": "指对他人的感激之情或报答义务"
                            },
                            {
                                "target_lang_word": "道义责任",
                                "target_lang_sense_clarification": "指基于道德准则应尽的义务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "281fc505-5904-38af-af7c-b7054c915077",
                    "sense_definition": "An action at law to recover a certain specified sum of money alleged to be due.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer filed an action of <w>debt</w> to recover the unpaid rent from the tenant.",
                            "target_lang_translations": {
                                "ru": "Адвокат подал иск о взыскании <w>долга</w>, чтобы получить с арендатора неоплаченную арендную плату.",
                                "zh": "律师提起了<w>追偿诉讼</w>，以向租户收回未付的租金。"
                            }
                        },
                        {
                            "text": "In early legal systems, a writ of <w>debt</w> was the primary means to claim money owed.",
                            "target_lang_translations": {
                                "ru": "В ранних правовых системах судебный приказ о взыскании <w>долга</w> был основным средством истребования причитающихся денег.",
                                "zh": "在早期的法律体系中，债务令状是追讨欠款的主要手段。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "action of debt",
                        "writ of debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Судебный иск с целью взыскания определенной денежной суммы, которая считается причитающейся.",
                        "zh": "法律上为追讨特定欠款而提起的诉讼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долг",
                                "target_lang_sense_clarification": "предмет судебного взыскания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追偿诉讼",
                                "target_lang_sense_clarification": "法律上要求偿还债务的行动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}