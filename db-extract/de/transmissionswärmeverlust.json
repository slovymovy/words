                ],
                "senses": [
                    {
                        "sense_id": "ceb6e650-186f-3882-a2ac-605c07edf0e8",
                        "entry_id": "2662e363-17d0-3a62-92fe-b094fb16f0e3",
                        "glosses": [
                            "der Verlust/Gewinn an Wärme in einem Gebäude, der aufgrund der Bauphysik und dem Temperaturunterschied zwischen Innen und Außen auftritt; Energieverlust/Energiegewinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df53fd9a-5b77-4a3b-ae6c-aec86661fcaf",
                                "sense_id": "ceb6e650-186f-3882-a2ac-605c07edf0e8",
                                "text": "Transmissionswärmeverluste kann man nach DIN und DIN EN für jede Wand, für jede Decke und zu jeder Tages- oder Jahreszeit berechnen."
                            },
                            {
                                "example_id": "e33ef5d0-141e-4409-a422-ba17b3b2e499",
                                "sense_id": "ceb6e650-186f-3882-a2ac-605c07edf0e8",
                                "text": "„Der spezifische Transmissionswärmeverlust H_T um fasst die gesamte Wärmemenge des betrachteten Zeitraumes, die durch alle Bauteile fließt.“"
                            },
                            {
                                "example_id": "6d3c8268-0e3d-474e-ad15-af02c236e450",
                                "sense_id": "ceb6e650-186f-3882-a2ac-605c07edf0e8",
                                "text": "„Der Transmissionswärmeverlust entsteht infolge der Wärmeableitung beheizter Räume über die Umschließungsflächen, wie Dächer, Wände, Fußboden, Decke und Fenster.“"
                            },
                            {
                                "example_id": "e32fc86f-13c9-47e7-89c1-4c671139b05d",
                                "sense_id": "ceb6e650-186f-3882-a2ac-605c07edf0e8",
                                "text": "„Eine entscheidende Kennzahl für den Transmissionswärmeverlust eines Bauteils ist der jeweilige U-Wert, wobei kleinere U-Werte geringere Transmissionswärmeverluste zur Folge haben.“"
                            },
                            {
                                "example_id": "428c3dbc-8782-437a-b540-7b7574dc4a72",
                                "sense_id": "ceb6e650-186f-3882-a2ac-605c07edf0e8",
                                "text": "„Bei der Berechnung der Transmissionswärmeverluste nach DIN 4108-6 werden Wärmebrücken pauschal oder detailliert berücksichtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
