                        "examples": [
                            {
                                "example_id": "bb82f3b4-2e7d-431e-ad69-72a93e57a562",
                                "sense_id": "faedf2e9-8edf-3f89-8d4b-340286b701b9",
                                "text": "Ze draaide zich om. In de linkerhoek van het dakterras lag Lua op een stretcher en strandlaken in de zon. Ze was naakt, op een donkere zonnebril na, en haar huid glom van de olie."
                            },
                            {
                                "example_id": "addced9d-8d73-48ce-9ce7-72278aa71a0c",
                                "sense_id": "faedf2e9-8edf-3f89-8d4b-340286b701b9",
                                "text": "Ik verleg mijn blik naar de Deense, die een zak zachte schuimsnoepjes kneedt. Met haar andere hand speelt ze met een flesje water. Als een taartje zit ze op het geel met rood gestreepte strandlaken."
                            }
                        ]
                    }
