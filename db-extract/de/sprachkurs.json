                ],
                "senses": [
                    {
                        "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                        "entry_id": "ab8638e0-2e82-3045-aba3-da9f6729eade",
                        "glosses": [
                            "über eine bestimmte Zeit regelmäßig stattfindender Unterricht in einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "870ce9fa-8efe-41c0-b7c6-2deb6e41333c",
                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                "text": "„In solchen Momenten zeigt sich, dass Sprachkurse, auch wenn sie noch so intensiv sind, nie ausreichen, um die kleinen Tücken im Alltag eines binationalen Pärchens zu bewältigen."
                            },
                            {
                                "example_id": "2754c8db-02be-4fce-86cd-eb08c16a6d94",
                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                "text": "„Die Nachfrage nach Sprachkursen ist groß.“"
                            },
                            {
                                "example_id": "b27b9d2c-4e34-4ddb-8b06-66cf56b66284",
                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                "text": "„Unsere Eltern belegten einen Sprachkurs nach dem anderen, sie lernten unaufhörlich Vokabeln, sie waren irritiert, wenn sie merkten, dass die deutschen Nachbarn Dativ statt Genitiv benutzten, und schauten daheim in ihren Lehrbüchern nach.“"
                            },
                            {
                                "example_id": "2be12797-6482-44b5-a990-39232e23e756",
                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                "text": "„Demnach boten viele Fremdsprachenabteilungen gezwungenermaßen Sprachkurse für die nicht in geistes- beziehungsweise sozialwissenschaftlichen Studiengängen immatrikulierten Studierenden an, damit die Einschreibezahlen und auch die Einnahmen gesteigert werden konnten.“"
                            },
                            {
                                "example_id": "5f13cbe6-577a-480b-8ca9-2d2d71646026",
                                "sense_id": "62a3fc3b-3206-39e4-afe2-c461a654249d",
                                "text": "„Ich will nach Paris reisen, an den französischen Sprachkursen der Sorbonne teilnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
