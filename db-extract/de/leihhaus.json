                "senses": [
                    {
                        "sense_id": "b075a030-6be4-3df3-9694-ca908629970d",
                        "entry_id": "7a4e4d53-dec3-33b0-abea-8e0ee451726f",
                        "glosses": [
                            "Geschäft, welches gegen Annahme von Wertgegenständen Darlehen vergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57575663-02ca-447f-91ff-18a40dfa74c7",
                                "sense_id": "b075a030-6be4-3df3-9694-ca908629970d",
                                "text": "„Der studierte Soziologe zählt auf, an welche Vorschriften alle Leihhäuser gebunden sind […].“"
                            },
                            {
                                "example_id": "cef39235-18f3-448a-9064-a2347780792d",
                                "sense_id": "b075a030-6be4-3df3-9694-ca908629970d",
                                "text": "„Die erste Enttäuschung war die, daß die Leihhäuser erst um neun aufmachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
