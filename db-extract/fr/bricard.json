                "senses": [
                    {
                        "sense_id": "4cf972af-4e94-357e-b4b7-0fc20bd1cdc5",
                        "entry_id": "1070c477-dafb-30fe-8618-9646111dccb7",
                        "glosses": [
                            "Brigadier."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "33c583b3-dc52-43cf-952a-d4e1bce77f72",
                                "sense_id": "4cf972af-4e94-357e-b4b7-0fc20bd1cdc5",
                                "text": "Ça ne prouve rien, dit le gendarme. Mon beau-père est mort comme ça. On l'a retrouvé deux heures après. Faut dire qu'il était cardiaque. Le bricard hocha la tête et se remit en marche en direction de l'édicule."
                            },
                            {
                                "example_id": "cabfecbf-04c4-4764-919f-dfab0a76747e",
                                "sense_id": "4cf972af-4e94-357e-b4b7-0fc20bd1cdc5",
                                "text": "Qu’il redevînt d’un seul coup deuxième classe, ou qu’on consentît, par miséricorde, à lui laisser quelque temps encore des galons de bricard, cela ne le mortifiait point."
                            },
                            {
                                "example_id": "2265bd0e-f6d5-400d-b8a4-f9a6d5cd9c51",
                                "sense_id": "4cf972af-4e94-357e-b4b7-0fc20bd1cdc5",
                                "text": "Le Bordelais préméditait le meurtre d'un bricard qui nous menait la vie trop dure."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8c9cd09-b5e1-3dc4-8321-05c51ad177fb",
                        "entry_id": "1070c477-dafb-30fe-8618-9646111dccb7",
                        "glosses": [
                            "Surveillant de prison."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8612be4c-c86d-4da0-aef4-01e813b0779b",
                                "sense_id": "e8c9cd09-b5e1-3dc4-8321-05c51ad177fb",
                                "text": "Il n'est pas encore arrivé quand un bricard de la maison d'arrêt monte dans l'escalier du mirador 3 et y découvre, prostrée, la surveillante Dominique P."
                            },
                            {
                                "example_id": "4669875c-7e3a-47a6-bc09-3a49e1d5fc97",
                                "sense_id": "e8c9cd09-b5e1-3dc4-8321-05c51ad177fb",
                                "text": "Le bricard mit fin au concert des pulmonaires. — Y vous faut une suppression de parloir, pour vous guérir fulmina-t-il."
                            }
                        ]
                    }
