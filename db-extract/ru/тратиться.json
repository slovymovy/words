                "senses": [
                    {
                        "sense_id": "d11b6b1d-ba52-3308-aadd-619ab7b34294",
                        "entry_id": "02275d63-52a5-360a-b6de-89d382a5f611",
                        "glosses": [
                            "расходовать деньги, средства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f11bdab-a988-4453-8576-aff15a48a0f0",
                                "sense_id": "d11b6b1d-ba52-3308-aadd-619ab7b34294",
                                "text": "Говорили мне знающие люди, что не́чего и на билет тратиться, впусту́ю проезжу."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0c61cbc-53e2-376b-bd7e-f5e9f5dea401",
                        "entry_id": "02275d63-52a5-360a-b6de-89d382a5f611",
                        "glosses": [
                            "страд. к тратить; расходоваться"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "492b6fce-0c55-44f0-a0cf-140aa0b1b0b2",
                                "sense_id": "d0c61cbc-53e2-376b-bd7e-f5e9f5dea401",
                                "text": "По его настоянию все сре́дства на книги тратились в Москве, в книжных магазинах."
                            }
                        ]
                    },
                    {
                        "sense_id": "7dfb993b-c58a-3e6d-9d8e-266b93e42613",
                        "entry_id": "02275d63-52a5-360a-b6de-89d382a5f611",
                        "glosses": [
                            "травиться, портиться, гибнуть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aedda77a-2df6-4116-a3d6-a8e39ee0bed9",
                                "sense_id": "7dfb993b-c58a-3e6d-9d8e-266b93e42613",
                                "text": "Зимний путь тратится."
                            }
                        ]
                    }
                ],
