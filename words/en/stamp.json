{
    "word_family": [
        "stamper",
        "restamp"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "307bcde9-2e0b-3fb2-b4a0-76142d8f3f26",
                    "sense_definition": "A small piece of paper with a design and value, stuck to a letter or package to pay for mailing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_postage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a <w>stamp</w> to send this birthday card.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить <w>марку</w>, чтобы отправить эту открытку на день рождения.",
                                "zh": "我需要买一张<w>邮票</w>来寄这张生日贺卡。"
                            }
                        },
                        {
                            "text": "He collects rare <w>stamps</w> from countries all over the world.",
                            "target_lang_translations": {
                                "ru": "Он коллекционирует редкие <w>марки</w> из стран со всего мира.",
                                "zh": "他收集来自世界各国的稀有<w>邮票</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "postage stamp"
                    ],
                    "common_phrases": [
                        "collect stamps",
                        "stick a stamp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький кусочек бумаги с рисунком и номиналом, наклеиваемый на письмо или посылку для оплаты пересылки.",
                        "zh": "贴在信件或包裹上用于支付邮费的带有图案和面值的纸片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марка",
                                "target_lang_sense_clarification": "почтовая"
                            },
                            {
                                "target_lang_word": "почтовая марка",
                                "target_lang_sense_clarification": "полное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邮票",
                                "target_lang_sense_clarification": "邮政用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a330767-8a31-3b19-8b98-393b2b9c9801",
                    "sense_definition": "A tool used to print a design, date, or word onto a surface using ink.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher used a star <w>stamp</w> on the student's homework.",
                            "target_lang_translations": {
                                "ru": "Учитель поставил <w>штамп</w> в виде звезды на домашнюю работу ученика.",
                                "zh": "老师在学生的作业上盖了一个星星<w>印章</w>。"
                            }
                        },
                        {
                            "text": "She bought a custom rubber <w>stamp</w> with her return address on it.",
                            "target_lang_translations": {
                                "ru": "Она купила заказной резиновый <w>штамп</w> со своим обратным адресом.",
                                "zh": "她买了一个刻有回邮地址的定制橡胶<w>图章</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rubber stamp",
                        "date stamp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, используемый для нанесения рисунка, даты или слова на поверхность с помощью чернил.",
                        "zh": "用于蘸取墨水在表面印上图案、日期或文字的工具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штамп",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "печать",
                                "target_lang_sense_clarification": "официальная/гербовая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印章",
                                "target_lang_sense_clarification": "工具"
                            },
                            {
                                "target_lang_word": "图章",
                                "target_lang_sense_clarification": "常用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90066cb3-db28-3d94-b062-9d65f89a8bd7",
                    "sense_definition": "A mark, design, or text made by pressing a tool onto a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The immigration officer looked at the entry <w>stamp</w> in my passport.",
                            "target_lang_translations": {
                                "ru": "Иммиграционный офицер посмотрел на <w>штамп</w> о въезде в моем паспорте.",
                                "zh": "移民官查看了我护照上的入境<w>戳记</w>。"
                            }
                        },
                        {
                            "text": "The box had a red <w>stamp</w> on the side that said 'Fragile'.",
                            "target_lang_translations": {
                                "ru": "На боку коробки стоял красный <w>штамп</w> с надписью 'Хрупкое'.",
                                "zh": "盒子的侧面有一个写着“易碎”的红色<w>印记</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imprint",
                        "mark",
                        "seal"
                    ],
                    "common_phrases": [
                        "passport stamp",
                        "official stamp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отметка, рисунок или текст, сделанные путем прижатия инструмента к поверхности.",
                        "zh": "通过将工具按压在表面上而留下的标记、图案或文字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штамп",
                                "target_lang_sense_clarification": "отметка"
                            },
                            {
                                "target_lang_word": "оттиск",
                                "target_lang_sense_clarification": "след от печати"
                            },
                            {
                                "target_lang_word": "печать",
                                "target_lang_sense_clarification": "знак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "印记",
                                "target_lang_sense_clarification": "痕迹"
                            },
                            {
                                "target_lang_word": "戳记",
                                "target_lang_sense_clarification": "官方标记"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d8e02a4-a6f1-3753-bfe1-24885299490e",
                    "sense_definition": "The act of bringing a foot down heavily and noisily.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_feet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With an angry <w>stamp</w> of his foot, he demanded silence.",
                            "target_lang_translations": {
                                "ru": "С сердитым <w>топаньем</w> ноги он потребовал тишины.",
                                "zh": "他愤怒地<w>跺</w>了一下脚，要求保持安静。"
                            }
                        },
                        {
                            "text": "The horse gave a loud <w>stamp</w> to scare away the flies.",
                            "target_lang_translations": {
                                "ru": "Лошадь громко <w>топнула</w>, чтобы отогнать мух.",
                                "zh": "马用力<w>跺</w>脚以赶走苍蝇。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stamp of the foot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, при котором нога тяжело и шумно опускается вниз.",
                        "zh": "用力且大声地跺脚的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топанье",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "топот",
                                "target_lang_sense_clarification": "звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跺脚",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2185426c-a3c2-3100-9b0f-fe6e0d106031",
                    "sense_definition": "A particular type, character, or quality that distinguishes someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a man of a different <w>stamp</w> than his brother.",
                            "target_lang_translations": {
                                "ru": "Он человек другого <w>склада</w>, чем его брат.",
                                "zh": "他和他兄弟是不同<w>类型</w>的人。"
                            }
                        },
                        {
                            "text": "Her early work already bore the <w>stamp</w> of genius.",
                            "target_lang_translations": {
                                "ru": "Ее ранняя работа уже несла на себе <w>печать</w> гениальности.",
                                "zh": "她早期的作品已经带有天才的<w>印记</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый тип, характер или качество, отличающее кого-то или что-то.",
                        "zh": "区分某人或某物的特定类型、性格或品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склад",
                                "target_lang_sense_clarification": "характер/тип"
                            },
                            {
                                "target_lang_word": "печать",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "след влияния"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烙印",
                                "target_lang_sense_clarification": "比喻义"
                            },
                            {
                                "target_lang_word": "印记",
                                "target_lang_sense_clarification": "特征"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67aa5380-915d-319d-b1fc-8174769a9474",
                    "sense_definition": "To bring a foot down heavily and noisily on the ground.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_feet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience began to <w>stamp</w> their feet to the rhythm of the music.",
                            "target_lang_translations": {
                                "ru": "Зрители начали <w>топать</w> ногами в ритм музыке.",
                                "zh": "观众开始随着音乐的节奏<w>跺</w>脚。"
                            }
                        },
                        {
                            "text": "He <w>stamped</w> the snow off his boots before entering the house.",
                            "target_lang_translations": {
                                "ru": "Он <w>сбил</w> снег с сапог, топая ногами, перед тем как войти в дом.",
                                "zh": "进屋前，他<w>跺</w>掉靴子上的雪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stomp"
                    ],
                    "common_phrases": [
                        "stamp one's feet",
                        "stamp out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело и шумно опускать ногу на землю.",
                        "zh": "用力且大声地在地上跺脚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "топать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "топнуть",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跺",
                                "target_lang_sense_clarification": "动词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1783cd76-8634-3c25-8f2b-910dd22bd61c",
                    "sense_definition": "To print a mark, design, or words onto something using a tool.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official <w>stamped</w> my passport at the border control.",
                            "target_lang_translations": {
                                "ru": "Чиновник <w>поставил штамп</w> в мой паспорт на пограничном контроле.",
                                "zh": "边境检查站的官员在我的护照上<w>盖章</w>。"
                            }
                        },
                        {
                            "text": "Please <w>stamp</w> the date on the back of the receipt.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>поставьте штамп</w> с датой на обратной стороне чека.",
                                "zh": "请在收据背面<w>盖上</w>日期戳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "imprint",
                        "impress",
                        "mark"
                    ],
                    "common_phrases": [
                        "stamp a passport",
                        "stamp a document"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить отметку, рисунок или слова на что-либо с помощью инструмента.",
                        "zh": "使用工具在某物上印上标记、图案或文字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штамповать",
                                "target_lang_sense_clarification": "ставить штамп"
                            },
                            {
                                "target_lang_word": "ставить печать",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盖章",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "盖戳",
                                "target_lang_sense_clarification": "口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "739084dc-ceb2-3bb5-815f-79a7ac8018c3",
                    "sense_definition": "To stick a postage stamp onto a letter or package.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_postage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I forgot to <w>stamp</w> the envelope before I put it in the mailbox.",
                            "target_lang_translations": {
                                "ru": "Я забыл <w>наклеить марку</w> на конверт перед тем, как опустить его в почтовый ящик.",
                                "zh": "我忘了在信封上<w>贴邮票</w>就把它投进了邮箱。"
                            }
                        },
                        {
                            "text": "Make sure the letter is properly <w>stamped</w> or it will be returned.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что на письме <w>наклеена марка</w>, иначе оно вернется.",
                                "zh": "确保信件已正确<w>贴好邮票</w>，否则会被退回。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклеивать почтовую марку на письмо или посылку.",
                        "zh": "在信件或包裹上贴上邮票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклеивать марку",
                                "target_lang_sense_clarification": "фраза"
                            },
                            {
                                "target_lang_word": "маркировать",
                                "target_lang_sense_clarification": "официально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贴邮票",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1787f62-6117-30af-82f3-540702d292c2",
                    "sense_definition": "To leave a lasting impression or clearly reveal a quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The terrible event <w>stamped</w> a memory in his mind forever.",
                            "target_lang_translations": {
                                "ru": "Ужасное событие навсегда <w>запечатлело</w> воспоминание в его памяти.",
                                "zh": "那件可怕的事在他脑海中留下了永远的<w>铭刻</w>。"
                            }
                        },
                        {
                            "text": "The team <w>stamped</w> their authority on the game with an early goal.",
                            "target_lang_translations": {
                                "ru": "Команда <w>утвердила</w> свое превосходство в игре ранним голом.",
                                "zh": "球队凭借开场进球，在比赛中<w>打上了自己统治力的烙印</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stamp on memory",
                        "stamp authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставлять неизгладимое впечатление или явно обнаруживать качество.",
                        "zh": "留下持久的印象或清晰地显露某种品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запечатлевать",
                                "target_lang_sense_clarification": "в памяти"
                            },
                            {
                                "target_lang_word": "накладывать отпечаток",
                                "target_lang_sense_clarification": "влиять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铭刻",
                                "target_lang_sense_clarification": "记忆"
                            },
                            {
                                "target_lang_word": "打上烙印",
                                "target_lang_sense_clarification": "影响"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "97d3963e-c917-327d-be86-fb7304968422",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Stamp</w> is waiting for you in the lobby.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Стэмп</w> ждет вас в вестибюле.",
                                "zh": "<w>斯坦普</w>先生正在大厅等你。"
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Stamp</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Стэмп</w>.",
                                "zh": "我以前从未见过姓<w>斯坦普</w>的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стэмп",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯坦普",
                                "target_lang_sense_clarification": "音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}