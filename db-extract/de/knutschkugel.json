                "senses": [
                    {
                        "sense_id": "1f0ae2d8-7c6c-3a72-b940-9d4f9958c902",
                        "entry_id": "3bcfeae4-a799-36f1-943b-b55d304ee3ac",
                        "glosses": [
                            "kleines Auto, kleiner Wohnwagen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "06065773-b09a-492b-b57d-5b3a232c10c7",
                                "sense_id": "1f0ae2d8-7c6c-3a72-b940-9d4f9958c902",
                                "text": "„Knutschkugel mit Mehrwert“"
                            },
                            {
                                "example_id": "2c08c5f7-948c-472a-a023-9618a557d238",
                                "sense_id": "1f0ae2d8-7c6c-3a72-b940-9d4f9958c902",
                                "text": "„\"Wir lieben beide Autos und wir machen es wahnsinnig gerne, sogar Hotel und Museum und kochen natürlich für meine Gäste. Unsere ersten Rendez-vous, unsere ersten Küsse, die waren im Käfer.\" Nicht ganz ohne Grund wird der Käfer also Knutschkugel genannt.“"
                            },
                            {
                                "example_id": "e048f7ff-f820-4148-b305-f59745906fe4",
                                "sense_id": "1f0ae2d8-7c6c-3a72-b940-9d4f9958c902",
                                "text": "„Kosenamen wie \"Knutschkugel\", \"Asphaltblase\" oder \"Schlaglochsuchgerät\" kursierten im Volksmund. Das Fahrgefühl ist mit dem heutiger Autos kaum vergleichbar. “"
                            },
                            {
                                "example_id": "89a78519-0a63-43df-a0d9-e3a16f9763be",
                                "sense_id": "1f0ae2d8-7c6c-3a72-b940-9d4f9958c902",
                                "text": "„Dann aber fällt das Wort doch, das den Wohnwagen-Winzling kaum treffender beschreiben könnte: „Knutschkugel“.“"
                            },
                            {
                                "example_id": "7e62b15a-cf4e-45ee-a4cf-1bf654ced1ca",
                                "sense_id": "1f0ae2d8-7c6c-3a72-b940-9d4f9958c902",
                                "text": "„Die verlängerte Knutschkugel bot einer Kleinfamilie auf zwei Bänken Platz und war in ein oder zweifarbiger Lackierung zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
