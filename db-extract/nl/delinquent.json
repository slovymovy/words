                    {
                        "translation_id": "4bc640db-cb1f-4831-ae95-6a8cd98fb8b6",
                        "source_entry_id": "0b49d068-91b0-34a7-bd7f-24db89c97162",
                        "source_sense_id": "fc249277-ecf7-3658-935e-89daf769a786",
                        "target_lang_word": "délinquant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
