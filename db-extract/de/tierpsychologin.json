                "senses": [
                    {
                        "sense_id": "26c7f1e6-f5ab-3137-bb6e-49821e34567f",
                        "entry_id": "3c3b9bbc-95a2-3499-b3a0-c98d892f4c4a",
                        "glosses": [
                            "weibliche Person, die sich beruflich um das Verhalten von Tieren kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22bd43b6-28c7-4bea-b962-4a154e6cb789",
                                "sense_id": "26c7f1e6-f5ab-3137-bb6e-49821e34567f",
                                "text": "Peters Schwester ist Tierpsychologin."
                            },
                            {
                                "example_id": "7dfe8343-bd55-4b33-823e-737c3e898cf2",
                                "sense_id": "26c7f1e6-f5ab-3137-bb6e-49821e34567f",
                                "text": "„Die Tierpsychologin aus Gaißach empfiehlt, sich einen Bummel auf einem Christkindlmarkt mal aus der Perspektive eines Hundes vorzustellen – inklusive dessen tierisch guten Geruchssinns.“"
                            },
                            {
                                "example_id": "61491554-4b9e-4250-9a67-96d544538aa6",
                                "sense_id": "26c7f1e6-f5ab-3137-bb6e-49821e34567f",
                                "text": "„Um das Problem zu lösen, ließ sie nun beide Katzen auf Anraten der Tierpsychologin nicht mehr hinaus – in der Hoffnung, wenn beide ständig miteinander konfrontiert wären, müssten sie zwangsläufig einen Weg zueinander finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
