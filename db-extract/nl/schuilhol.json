                                    },
                                    {
                                        "sense_id": "16371812-6835-3509-b6bc-8e4af428d897",
                                        "entry_id": "9fafc42c-3740-3bd2-833a-14639ba82695",
                                        "glosses": [
                                            "That which provides protection or cover."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8affe50d-af39-4fd2-bdc4-8557696ff766",
                                                "sense_id": "16371812-6835-3509-b6bc-8e4af428d897",
                                                "text": "Along with air, water, and food, shelter is often recognized as a human necessity."
                                            }
