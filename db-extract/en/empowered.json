                            {
                                "example_id": "78cf6538-9f22-495b-ac01-daddaf8ed1be",
                                "sense_id": "14f9b031-eef1-3706-b061-f57bb165bd70",
                                "text": "Empowered staff deliver the goods and exceed your expectations. Disempowered staff develop a 'sullen obedience' where they stop driving new initiatives and just await orders."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad525965-116e-390d-8dc9-accf1a57d800",
                        "entry_id": "58e628e5-f66c-33ac-b5e2-252ba041575b",
                        "glosses": [
                            "Having been given the power to make choices relevant to one's situation."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "f7b5003a-7f2d-46cf-aa0c-3fff68f052e6",
                                "sense_id": "ad525965-116e-390d-8dc9-accf1a57d800",
                                "text": "Policy moderation in the past, I argued above, has depended on a coalition between civic elites and newly empowered minorities—or at least a resolve by civic elites to discourage a racially polarizing politics of law and order."
                            }
                        ]
                    },
                    {
