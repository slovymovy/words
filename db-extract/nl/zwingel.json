                                                "example_id": "1d3bbc5c-3dfa-4463-bb87-95930409d1f9",
                                                "sense_id": "e93e1fbb-668f-302a-a0d5-e412ff17ba87",
                                                "text": "2005, John Martin, Warren Leonard, David Stamp, and Richard Waldren, Principles of Field Crop Production (4th Edition), section 32.10 “Processing Fiber Flax”, the title of subsection 32.10.3 “Scutching”."
                                            },
                                            {
                                                "example_id": "356b2a6c-eed3-4d52-a615-08ad16817175",
                                                "sense_id": "e93e1fbb-668f-302a-a0d5-e412ff17ba87",
                                                "text": "His prey was more often the over-scutched huswives, the threepenny whores with well-whipped backs, both from the beadle and their own hot-blooded clients."
                                            }
                                        ]
                                    }
                                ]
