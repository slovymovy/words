                "senses": [
                    {
                        "sense_id": "15961c97-914c-3f9c-810d-f0b72f5619d3",
                        "entry_id": "9ff40262-119a-3dc4-99a1-d5e5d34c0171",
                        "glosses": [
                            "Variante orthographique de rassoter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d83d46-5428-4845-a3db-0e97a9ce63a9",
                                "sense_id": "15961c97-914c-3f9c-810d-f0b72f5619d3",
                                "text": "Du temps de Montaigne, les Sorbonnards, saturés de mémoire jusqu’à la gueule, rassottés par leur tête bien pleine, manquèrent la Renaissance, accrochés aux pics du Moyen Âge, sous les éclats de rire de Rabelais."
                            },
                            {
                                "example_id": "9fc3d22c-ce40-4f3c-b987-6f97798a4bb0",
                                "sense_id": "15961c97-914c-3f9c-810d-f0b72f5619d3",
                                "text": "Comme si l’on ne pouvait vivre en commun autour d’une même vérité sans s’étriquer, s’appauvrir, se rassotter…"
                            }
                        ]
                    }
