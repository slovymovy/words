                "senses": [
                    {
                        "sense_id": "93e5f89f-4fc8-35d4-933a-ea68933e9b3d",
                        "entry_id": "bfa9ddf8-07f5-3fb5-adb2-c05e37c5ead8",
                        "glosses": [
                            "Se mettre à plat ventre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20769616-a366-4c57-be6e-81c8e602cc9e",
                                "sense_id": "93e5f89f-4fc8-35d4-933a-ea68933e9b3d",
                                "text": "Mais là, parfois, quand je vois les deux mignons minots des voisins venir se planquer dans les bambous, s'à-plat-ventrer au bord de la mare pour regarder les poissons, picorer les raisins comme des moineaux ou gratouiller la bêbête qui stridule dans un trou, je me dis que...."
                            },
                            {
                                "example_id": "86b01916-7c17-49c6-85ca-347e39676b5a",
                                "sense_id": "93e5f89f-4fc8-35d4-933a-ea68933e9b3d",
                                "text": "On ne sait pas s'à-plat-ventrer devant Bruxelles afin de dissoudre notre pays dans ce marécage nauséabond de privilèges et de prébendes."
                            },
                            {
                                "example_id": "32b6161b-c977-425b-9eac-8328bc9b851f",
                                "sense_id": "93e5f89f-4fc8-35d4-933a-ea68933e9b3d",
                                "text": "Nos vendus de Berne vont-ils encore oser s'à-plat-ventrer devant toi et ta clique?"
                            }
                        ]
                    }
                ],
