                        "sense_id": "0cc89f82-64a2-3679-b8f9-6b305f0750f2",
                        "entry_id": "1fc6d9a5-fda1-3805-a7b0-63d0eea036f9",
                        "glosses": [
                            "Having breezes."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "8d51d1f3-8851-4291-8cc4-1cbef86b3636",
                                "sense_id": "0cc89f82-64a2-3679-b8f9-6b305f0750f2",
                                "text": "Oft' in the mournful shade I sit\nAmidst the breezeful wind :\nAnd, by its sighs, their mem'ry lorn\nComes rushing on my mind."
                            },
                            {
                                "example_id": "8005a8f0-b9b3-4b8d-a26a-c7fa973759cb",
                                "sense_id": "0cc89f82-64a2-3679-b8f9-6b305f0750f2",
                                "text": "[…] and there is a confusion of embroidery and white linen and silk hose that fills the eye of the man in the parquette with a flash of joy and causes a warm still wind to roll in a breezeful way around his cardiacal region."
                            },
                            {
                                "example_id": "3f4d3f06-ae82-4905-a6b2-830b5e098889",
                                "sense_id": "0cc89f82-64a2-3679-b8f9-6b305f0750f2",
                                "text": "From exercising in the open air all that delightful, breezeful morning, their appetites became immensely whetted for a full enjoyment of the rich repast."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "09efa943-ed01-37b0-a394-6754bf048cfb",
