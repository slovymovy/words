                                        "examples": [
                                            {
                                                "example_id": "4407e0d1-68a7-4133-b789-798bbac06e2d",
                                                "sense_id": "b136755b-aa93-3319-bef6-4a7655e77700",
                                                "text": "The publication of these papers was not owing to our folly, but that of others."
                                            },
                                            {
                                                "example_id": "4cb121e6-853a-43f3-9744-baa5d45e2f34",
                                                "sense_id": "b136755b-aa93-3319-bef6-4a7655e77700",
                                                "text": "Owing to the time lag which must occur between the dates of closing for press and publication, it sometimes happens that items of news are out of date, or inaccurate, by the time they reach readers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0dace37-734d-3042-81e2-72496c698f0a",
                                        "entry_id": "4ddc5737-615e-33a7-909b-1ed5b0ef7caf",
