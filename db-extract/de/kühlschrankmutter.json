                        "glosses": [
                            "Mutter/weibliches Elternteil, welches durch emotionale Kälte ihrem Kind gegenüber charakterisiert wird"
                        ],
                        "tags": [
                            "Psychoanalyse"
                        ],
                        "examples": [
                            {
                                "example_id": "7bb4ef20-70ca-433c-995f-ce2238bc8b64",
                                "sense_id": "ada7d0f6-a566-312b-bba7-16bdcc576d97",
                                "text": "„Kanner, Bettelheim und andere Psychoanalytiker prägten den Begriff der \"Kühlschrankmutter\", deren Gefühlskälte ihr Kind regelrecht krank mache.“"
                            }
                        ],
