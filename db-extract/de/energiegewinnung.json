                        "form": "die Energiegewinnung"
                    },
                    {
                        "form_id": "bb4aad5d-e012-430a-935c-d3b55292e53b",
                        "entry_id": "14b40e34-0705-398e-93a4-4161d91c9c4c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Energiegewinnungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                        "entry_id": "14b40e34-0705-398e-93a4-4161d91c9c4c",
                        "glosses": [
                            "Produktion von Strom oder Wärme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a79f69-49bd-47d5-a209-65a68a3ee34e",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Zur Energiegewinnung sollen Großwärmepumpen und auch Photovoltaik-Anlagen eingesetzt werden.“"
                            },
                            {
                                "example_id": "ffe2217e-c1ce-497a-a15d-a73080fa00ce",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Auf dem Dach“ […] „wird eine 1.850 Quadratmeter große Solaranlage zur Energiegewinnung installiert.“"
                            },
                            {
                                "example_id": "3d70acdd-42b5-4806-aa8c-e3c477546c0d",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Überall auf der Welt werden Milliarden von Euro in die Entwicklung der Energiegewinnung durch Kernfusion gesteckt.“"
                            },
                            {
                                "example_id": "76283631-2251-40d2-8100-b6917c14ab14",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Aus riesigen, offenen Löchern in der Erde wird seit den 1950er Jahren Braunkohle gefördert und in den umliegenden Kraftwerken zur Energiegewinnung verbrannt.“"
                            },
                            {
                                "example_id": "dd3fc904-a5c3-4d97-8247-1be7a6dbae17",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "[Erdgas ist] „ein brennbares Gas, das unter der Erde vorkommt und als Rohstoff zur Energiegewinnung eingesetzt wird“."
                            },
                            {
                                "example_id": "fcd42c87-d725-4c0e-964d-58418ba747a4",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Die Verbrennung von Kohle und anderen fossilen Brennstoffen zur Energiegewinnung wird weltweit bald ihren Höhepunkt überschreiten.“"
                            },
                            {
                                "example_id": "5401c1df-e07e-46c2-9ef7-ae7e69a3f34f",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Trotz der Erdbeben in St. Gallen bleibt die Energiegewinnung über Tiefenwärme in der Zentralschweiz eine wichtige Option.“"
                            },
                            {
                                "example_id": "9bfc701d-5832-4dab-95a1-a5a06d78b5c3",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Seewasser soll Zuger Gebäude heizen – Wärmeproduktion aus Seewasser: diese umweltfreundliche Form von Energiegewinnung soll es künftig auch in der Stadt Zug geben.“"
                            },
                            {
                                "example_id": "9672ccc6-58a3-404d-8df5-32908a143357",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "[Biogasanlagen:] „So begrüßenswert die Energiegewinnung (Strom, Abwärme oder „Biomethan“) aus erneuerbaren Energieträgern auch ist, Biogasanlagen sind komplexe Industrieanlagen mit erheblichem Risikopotenzial.“"
                            },
                            {
                                "example_id": "247412e4-2adb-4f1a-8ffd-200f530a6ac5",
                                "sense_id": "15b5bb8b-26e2-3cd7-b9ca-0b9cdb7d07c8",
                                "text": "„Der notwendige Ausstieg aus der fossilen Energiegewinnung ist ein Verlustgeschäft, wenigstens gesamtwirtschaftlich betrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                        "entry_id": "14b40e34-0705-398e-93a4-4161d91c9c4c",
                        "glosses": [
                            "Erzeugung von Energie in Lebewesen durch Stoffwechsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "431e3bf8-0371-4207-970f-f9752d5f8e65",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "[Fasten:] „Der totale Verzicht auf Nahrung löst allerdings auch Stress aus: Da der Körper keine Energiezufuhr aus der Nahrung bekommt, reduziert er seinen Energieverbrauch (Grundumsatz) und baut zur Energiegewinnung Eiweiß in den Muskeln ab.“"
                            },
                            {
                                "example_id": "aad4e9fc-3195-4174-a07b-3388aa274239",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "„Zucker ist der wichtigste Brennstoff unserer Zellen. Die Körperzellen bevorzugen allerdings Glukose zur Energiegewinnung. Glukose gelangt mithilfe des Hormons Insulin schnell aus dem Blut in die Zellen.“"
                            },
                            {
                                "example_id": "2e15b299-b5e3-4927-bc6f-c4f63403d9e7",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "[Insulin:] „Der Signalstoff stellt sicher, dass die Zellen den nötigen Zucker aufnehmen, zur Energiegewinnung verbrennen oder als Reserve speichern können.“"
                            },
                            {
                                "example_id": "617d84c5-579c-4210-89a1-8edb1ddffd9b",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "„Der Körper kann die verschiedenen Zwei-, Mehr- und Vielfachzucker nicht unmittelbar zur Energiegewinnung nutzen. Er braucht Einfachzucker.“"
                            },
                            {
                                "example_id": "911094c6-79ae-401e-996a-4d944ef32c85",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "„Was geschieht mit den bei der Verdauung entstandenen Bausteinen unserer Nahrungsstoffe? Sie dienen in erster Linie der Energiegewinnung.“"
                            },
                            {
                                "example_id": "3c57470f-e372-4719-ae45-41356293cfac",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "„Mitochondrien sind die Zellorganellen, in denen bei Pflanzen und Tieren die Energiegewinnung stattfindet.“"
                            },
                            {
                                "example_id": "14881dff-d9ef-4f8d-9799-b7f259af4c67",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "„Bei niedriger Intensität erfolgt die Energiegewinnung überwiegend aerob durch Oxidation von Fettsäuren und aerobe Verstoffwechselung des aus Glucose auf dem Wege der Glykolyse entstandenen Pyruvats beziehungsweise Laktats. Wird der Muskel stärker beansprucht, nimmt der Anteil der Energiegewinnung durch Glykolyse zu (siehe Aerobe Schwelle).“"
                            },
                            {
                                "example_id": "f1ed16b7-e863-41f4-8d7b-1cc9ff49057a",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "[Alkoholische Gärung:] „Die meisten Mikroorganismen (Mikroben) mit der Fähigkeit zur alkoholischen Gärung nutzen diesen Stoffwechselweg nur vorübergehend zur Energiegewinnung, wenn der zur Atmung benötigte Sauerstoff fehlt.“"
                            },
                            {
                                "example_id": "2f825e02-7db1-453f-b897-a4df3107c243",
                                "sense_id": "d9f194a4-46b5-3244-bfb4-1c2999b13d1e",
                                "text": "„Der Katabolismus dient den Lebewesen zur Energiegewinnung, zur Lieferung von Baustoffen sowie zur Entgiftung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
