    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83ed94ee-5667-37bc-bff3-81ea1a717f78",
                    "sense_definition": "An adult female of the cattle species, especially one that has produced a calf.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cattle_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer wakes up early every morning to milk the <w>cow</w>.",
                            "target_lang_translations": {
                                "ru": "Фермер просыпается рано каждое утро, чтобы подоить <w>корову</w>.",
                                "zh": "农夫每天清晨醒来去挤<w>母牛</w>的奶。"
                            }
                        },
                        {
                            "text": "A dairy <w>cow</w> can produce a large amount of milk each day.",
                            "target_lang_translations": {
                                "ru": "Молочная <w>корова</w> может давать большое количество молока каждый день.",
                                "zh": "一头奶<w>母牛</w>每天能产大量的奶。"
                            }
                        }
                    ],
                    "antonyms": [
                        "bull"
                    ],
                    "common_phrases": [
                        "dairy cow",
                        "milk cow",
                        "holy cow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослая самка крупного рогатого скота, особенно та, которая уже давала потомство.",
                        "zh": "成年雌性牛，尤指已经产过小牛的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корова",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "母牛",
                                "target_lang_sense_clarification": "成年雌性牛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0aed12c-9158-3bcc-9ff8-0fbfe81b3328",
                    "sense_definition": "Any animal of the cattle species, regardless of sex or age.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cattle_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a herd of <w>cows</w> grazing peacefully in the green field.",
                            "target_lang_translations": {
                                "ru": "Мы видели стадо <w>коров</w>, мирно пасущихся на зеленом поле.",
                                "zh": "我们看到一群<w>牛</w>在绿色的田野里安静地吃草。"
                            }
                        },
                        {
                            "text": "Drivers must be careful because <w>cows</w> sometimes cross the country roads.",
                            "target_lang_translations": {
                                "ru": "Водители должны быть осторожны, потому что <w>коровы</w> иногда переходят сельские дороги.",
                                "zh": "司机必须小心，因为<w>牛</w>有时会穿过乡村公路。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "herd of cows",
                        "mad cow disease"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое животное из семейства полорогих (крупный рогатый скот), независимо от пола или возраста.",
                        "zh": "牛科动物，不分性别或年龄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корова",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牛",
                                "target_lang_sense_clarification": "牛科动物总称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b437272-b8ba-3473-b7d0-2b9007a074f4",
                    "sense_definition": "The female of certain large animal species, such as the elephant, whale, or seal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "female_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elephant <w>cow</w> fiercely protected her young calf from the predators.",
                            "target_lang_translations": {
                                "ru": "<w>Самка</w> слона яростно защищала своего детеныша от хищников.",
                                "zh": "这头大象<w>母兽</w>拼命保护她的小象免受捕食者的伤害。"
                            }
                        },
                        {
                            "text": "Researchers observed a whale <w>cow</w> swimming alongside her offspring.",
                            "target_lang_translations": {
                                "ru": "Исследователи наблюдали за <w>самкой</w> кита, плывущей рядом со своим потомством.",
                                "zh": "研究人员观察到一头鲸鱼<w>母兽</w>正带着她的幼崽游动。"
                            }
                        }
                    ],
                    "antonyms": [
                        "bull"
                    ],
                    "common_phrases": [
                        "elephant cow",
                        "manatee cow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самка некоторых крупных животных, таких как слон, кит или тюлень.",
                        "zh": "某些大型哺乳动物的雌性，如大象、鲸鱼或海豹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самка",
                                "target_lang_sense_clarification": "животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "母兽",
                                "target_lang_sense_clarification": "大型哺乳动物的雌性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a19f1462-7389-3691-989a-cf04c9c2901a",
                    "sense_definition": "An unpleasant, nasty, or stupid woman.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was acting like a miserable <w>cow</w> all day, complaining about everything.",
                            "target_lang_translations": {
                                "ru": "Она вела себя как жалкая <w>корова</w> весь день, жалуясь на всё подряд.",
                                "zh": "她整天表现得像个讨人厌的女人，对什么都抱怨。"
                            }
                        },
                        {
                            "text": "I cannot believe she said that to you; what a silly <w>cow</w>.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что она сказала тебе это; какая глупая <w>корова</w>.",
                                "zh": "真不敢相信她会对你说那种话，真是个愚蠢的女人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bitch"
                    ],
                    "common_phrases": [
                        "silly cow",
                        "stupid cow",
                        "miserable cow"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятная, злая или глупая женщина.",
                        "zh": "令人讨厌、刻薄或愚蠢的女人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корова",
                                "target_lang_sense_clarification": "ругательство"
                            }
                        ],
                        "zh": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "329dad12-a6ff-345a-9875-ee415503c08a",
                    "sense_definition": "To intimidate or frighten someone into obedience or submission.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_intimidate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave protesters were not <w>cowed</w> by the threats of the government.",
                            "target_lang_translations": {
                                "ru": "Смелые протестующие не были <w>запуганы</w> угрозами правительства.",
                                "zh": "勇敢的抗议者并没有被政府的威胁所<w>恐吓</w>。"
                            }
                        },
                        {
                            "text": "He tried to <w>cow</w> his employees into working overtime without pay.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>запугать</w> своих сотрудников, чтобы заставить их работать сверхурочно без оплаты.",
                                "zh": "他试图<w>威逼</w>员工无偿加班。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidate",
                        "daunt",
                        "bully"
                    ],
                    "common_phrases": [
                        "cowed into submission",
                        "cowed by fear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запугивать или внушать страх, чтобы добиться подчинения.",
                        "zh": "恐吓或威胁某人使其服从。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запугивать",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "запугать",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恐吓",
                                "target_lang_sense_clarification": "威胁使人服从"
                            },
                            {
                                "target_lang_word": "威逼",
                                "target_lang_sense_clarification": "用压力强迫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d5a354af-831a-30cd-b78b-48ed66ba0aac",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cow</w> was listed in the old town directory from the last century.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Кау</w> был указан в старом городском справочнике прошлого века.",
                                "zh": "<w>考</w>先生的名字出现在上个世纪的旧城镇名录中。"
                            }
                        },
                        {
                            "text": "We met a family with the surname <w>Cow</w> during our travels.",
                            "target_lang_translations": {
                                "ru": "Мы встретили семью с фамилией <w>Кау</w> во время наших путешествий.",
                                "zh": "我们在旅行中遇到了一户姓<w>考</w>的人家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кау",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "考",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "266166b2-1c13-346c-8bde-d9e4ff0bd371",
                    "sense_definition": "A place name, often used in geographical locations like creeks or islands.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They went fishing near <w>Cow</w> Creek last weekend.",
                            "target_lang_translations": {
                                "ru": "В прошлые выходные они ходили на рыбалку возле ручья <w>Кау</w>-Крик.",
                                "zh": "上周末他们去<w>考</w>溪附近钓鱼了。"
                            }
                        },
                        {
                            "text": "The map shows a small settlement called <w>Cow</w> Island in the middle of the river.",
                            "target_lang_translations": {
                                "ru": "На карте показано небольшое поселение под названием Остров <w>Кау</w> посреди реки.",
                                "zh": "地图显示河中央有一个叫<w>考</w>岛的小定居点。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название, часто используемое для ручьев или островов.",
                        "zh": "地名，常用于溪流或岛屿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кау",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "考",
                                "target_lang_sense_clarification": "音译地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
