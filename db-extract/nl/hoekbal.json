                                    {
                                        "sense_id": "542397ff-05dd-3f0b-88e6-81eb406d5434",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "The point where two converging lines meet; an angle, either external or internal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d14093-99b9-4520-ada2-c05b3a60ff40",
                                                "sense_id": "542397ff-05dd-3f0b-88e6-81eb406d5434",
                                                "text": "The corners of the wire mesh were reinforced with little blobs of solder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbd17d7f-01fa-3716-ab8a-757f1ac463ac",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "The point where two converging lines meet; an angle, either external or internal.",
                                            "The space in the angle between converging lines or walls which meet in a point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d24910ad-220a-445b-9a7d-9b44cf9015f5",
                                                "sense_id": "bbd17d7f-01fa-3716-ab8a-757f1ac463ac",
                                                "text": "The chimney corner was full of cobwebs."
                                            },
                                            {
                                                "example_id": "2c65f937-bdc3-4861-b58d-62ee2a5f18bc",
                                                "sense_id": "bbd17d7f-01fa-3716-ab8a-757f1ac463ac",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. Otherwise his pelt would not have been so perfect. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "8cb638a1-8d0e-4346-85a8-3fb5ab3725e1",
                                                "sense_id": "bbd17d7f-01fa-3716-ab8a-757f1ac463ac",
                                                "text": "The Altay Mountains to the north prevent rain clouds from reaching the Gurbantünggüt Desert, which fills the center of the Junggar Basin in China's northwest corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "434c21ee-40d3-3d4a-b14b-2bd4dd5739fb",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "The point where two converging lines meet; an angle, either external or internal.",
                                            "The projection into space of an angle in a solid object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92897ec9-f851-4c84-a3ed-393d54fc2e25",
                                                "sense_id": "434c21ee-40d3-3d4a-b14b-2bd4dd5739fb",
                                                "text": "Herbert bruised his shin on the corner of the coffee table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f77de1-1d9a-3e9c-bbc4-9d21f249ce66",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "The point where two converging lines meet; an angle, either external or internal.",
                                            "An intersection of two streets; any of the four outer points off the street at that intersection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d85e9f-6072-46b8-8c18-e95d825a360e",
                                                "sense_id": "66f77de1-1d9a-3e9c-bbc4-9d21f249ce66",
                                                "text": "The liquor store on the corner also sold lottery tickets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e6201d0-4e8f-3358-a604-c479afe2164f",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "The point where two converging lines meet; an angle, either external or internal.",
                                            "The neighborhood surrounding an intersection of rural roads."
                                        ],
                                        "tags": [
                                            "Maine"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e18aeee7-2685-3d6a-a3cf-b66d57cf65a5",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "The point where two converging lines meet; an angle, either external or internal.",
                                            "Denoting a premises that is in a convenient local location, notionally, but not necessarily literally, on the corner of two streets."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7908a8a3-41cb-442c-b947-6c793ddd1510",
                                                "sense_id": "e18aeee7-2685-3d6a-a3cf-b66d57cf65a5",
                                                "text": "corner store, corner deli, corner newsagent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6721e20-1139-3a01-b6fd-c54cd77f5104",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "An edge or extremity; the part farthest from the center; hence, any quarter or part, or the direction in which it lies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dfd42fb-005e-460a-934e-b094625830a7",
                                                "sense_id": "e6721e20-1139-3a01-b6fd-c54cd77f5104",
                                                "text": "Shining a light in the dark corners of the mind.  I took a trip out to his corner of town."
                                            },
                                            {
                                                "example_id": "219dafaa-3e4f-4c33-8005-139a5ee1f72b",
                                                "sense_id": "e6721e20-1139-3a01-b6fd-c54cd77f5104",
                                                "text": "Why, that’s the lady: all the world desires her; / From the four corners of the earth they come, / To kiss this shrine, this mortal-breathing saint:"
                                            },
                                            {
                                                "example_id": "f15406fa-2d88-462a-a7a5-6f63e66d68fc",
                                                "sense_id": "e6721e20-1139-3a01-b6fd-c54cd77f5104",
                                                "text": "Indian English is today one of the most widespread and abundantly used varieties of English, in extensive use not only throughout South Asia but in virtually every corner of the globe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9617a88b-210a-36aa-825c-42e6632181d4",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "A secret or secluded place; a remote or out of the way place; a nook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51278c38-cbca-4477-af7d-222d9607f80f",
                                                "sense_id": "9617a88b-210a-36aa-825c-42e6632181d4",
                                                "text": "On weekends, Emily liked to find a quiet corner and curl up with a good book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fccb5fef-ac0c-3794-bdec-9f3372fe2cb3",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "An embarrassing situation; a difficulty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8500eeb-39b1-3d3d-995a-c54d4555ea65",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "A sufficient interest in a salable security or commodity to allow the cornering party to influence prices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9465edf-f674-4722-82c0-9d8169f79211",
                                                "sense_id": "f8500eeb-39b1-3d3d-995a-c54d4555ea65",
                                                "text": "In the 1970s, private investors tried to get a corner on the silver market, but were ultimately unsuccessful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "871a0af1-22fb-3aa6-b22c-fef61a1cfcdb",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "A sufficient interest in a salable security or commodity to allow the cornering party to influence prices.",
                                            "Complete control or ownership of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40237155-f253-4642-8098-c7b5585313b0",
                                                "sense_id": "871a0af1-22fb-3aa6-b22c-fef61a1cfcdb",
                                                "text": "It's not my oppression, it's not your oppression but rather our oppression. No one of us has a corner on oppression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc39f6e0-c9b4-3c86-a1d9-e2fdd37f6871",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
                                            "Relating to the playing field.",
                                            "One of the four vertices of the strike zone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729d6576-35da-49ae-a3fb-a8c5f1c09318",
                                                "sense_id": "fc39f6e0-c9b4-3c86-a1d9-e2fdd37f6871",
                                                "text": "The pitch was just off the corner, low and outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63c5dfb-cc4f-3d6a-aaa4-7092c2f54ac3",
                                        "entry_id": "db387fcb-279d-3497-86b7-794e5ddd89bd",
                                        "glosses": [
