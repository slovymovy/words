                    {
                        "sense_id": "a7e76df5-50ec-3dc7-801f-dd19507f4639",
                        "entry_id": "5a345783-5b92-3ef7-9fff-cf70374627b0",
                        "glosses": [
                            "Level of saturation (especially of oxygen in the blood)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ee17d8-4791-470b-82eb-57f4e76eed9d",
                                "sense_id": "a7e76df5-50ec-3dc7-801f-dd19507f4639",
                                "text": "Also, your blood pressure and oxygen sats – that's the amount of oxygen in your blood."
                            },
                            {
                                "example_id": "c4bc3d40-adf1-49d0-a3ad-682daa126af9",
                                "sense_id": "a7e76df5-50ec-3dc7-801f-dd19507f4639",
                                "text": "[T]his is her third admission for breathing difficulties. The first two admissions we managed to control her and discharge her home with her mum. This time we can't get her oxygen sats up—they're actually falling."
                            },
                            {
                                "example_id": "7e68f3d1-2074-46c3-9eb7-3b1792fab7b1",
                                "sense_id": "a7e76df5-50ec-3dc7-801f-dd19507f4639",
                                "text": "Intubation is not necessary unless his oxygen sat reading is low."
                            }
                        ]
                    }
