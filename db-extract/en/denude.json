                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c9132c8-5cbe-3008-8d17-8255da2f3c3c",
                        "entry_id": "55042d44-82c6-3360-bc27-c64e44ca4094",
                        "glosses": [
                            "To divest of all covering; to make bare or naked; to strip."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65829e9-c4af-4063-9c6d-7a3da80db631",
                                "sense_id": "4c9132c8-5cbe-3008-8d17-8255da2f3c3c",
                                "text": "He denuded himself of his clothes."
                            },
                            {
                                "example_id": "c7701fed-35cb-4800-bdb0-292a0068fe28",
                                "sense_id": "4c9132c8-5cbe-3008-8d17-8255da2f3c3c",
                                "text": "Widespread deforestation has led to lands being denuded."
                            },
                            {
                                "example_id": "9d2f2391-6ea9-43eb-9326-4647b5c79f25",
                                "sense_id": "4c9132c8-5cbe-3008-8d17-8255da2f3c3c",
                                "text": "But King Piko had been long harassed with the thought, that the unobstructed and indefinite increase of his browsing subjects might eventually denude of herbage his portion of the island."
                            },
                            {
                                "example_id": "98afcce6-c378-4f9e-8159-2f4af434ed80",
                                "sense_id": "4c9132c8-5cbe-3008-8d17-8255da2f3c3c",
                                "text": "They not only visit adultery on the guilty man himself by beating him, but the men proceed en masse to the house of his parents and denude it of all furniture, stores of grain, and merchandise."
                            }
                        ]
                    },
                    {
                        "sense_id": "2acf1262-f47b-39aa-b582-c42a02bcce23",
                        "entry_id": "55042d44-82c6-3360-bc27-c64e44ca4094",
                        "glosses": [
                            "To remove (something or someone) of their possessions or assets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eda26b55-43de-4097-be4d-66940ac8780d",
                                "sense_id": "2acf1262-f47b-39aa-b582-c42a02bcce23",
                                "text": "Their property was seized, denuded and confiscated."
                            },
                            {
                                "example_id": "0e407e21-f227-4cc9-b22b-4b1aa46a84d1",
                                "sense_id": "2acf1262-f47b-39aa-b582-c42a02bcce23",
                                "text": "The service was denuded of its capacity to deliver."
                            },
                            {
                                "example_id": "b2921e5b-610e-4aec-85ea-6e6f38763442",
                                "sense_id": "2acf1262-f47b-39aa-b582-c42a02bcce23",
                                "text": "And Louisa, a niece of Pierre, claimed his inheritance on the death of Suzanne. Thus, in her cruel anger, she hoped to denude the Constable of the whole of the heritage of his dead wife."
                            }
                        ]
                    }
                ],
