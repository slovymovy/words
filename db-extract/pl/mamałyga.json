                                "target_senses": [
                                    {
                                        "sense_id": "8d6fd46a-7dbb-388a-a78b-8b7a8f06cb85",
                                        "entry_id": "268810c4-fed6-35d0-8825-7a2f602dc6c5",
                                        "glosses": [
                                            "A food made from hulled corn (maize) kernels soaked in lye water, rinsed, then cooked and eaten; or, the rinsed kernels are dried and coarsely ground into hominy grits."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "803fe5e6-8285-4be3-9ecc-6c338fd318cf",
                                                "sense_id": "8d6fd46a-7dbb-388a-a78b-8b7a8f06cb85",
                                                "text": "Then his plate was put before him: hominy grits and a scrap of bacon. He wanted to cry, like a child: ‘But, Mama, it's my birthday!’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4505b40-59e9-419e-85a7-98ae37fbc866",
                        "source_entry_id": "99ee61bc-f632-32c0-8530-1ba4e1b5c672",
                        "source_sense_id": "a1bc71ed-e043-396e-aa32-6d2e9b4e424d",
