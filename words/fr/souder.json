                    "frequency": "Middle",
                    "semantic_group_id": "assemblage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan va <w>souder</w> deux pièces de métal pour réparer la grille du jardin."
                        },
                        {
                            "text": "Le mécanicien a pris son appareil pour <w>souder</w> au chalumeau le pot d'échappement."
                        }
                    ],
                    "antonyms": [
