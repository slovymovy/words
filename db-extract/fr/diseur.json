                ],
                "senses": [
                    {
                        "sense_id": "aa058df8-4ada-3538-8cd1-5fd1eaa39d31",
                        "entry_id": "6cf0d260-edbf-3f9a-8de8-59657e482b79",
                        "glosses": [
                            "Personne qui dit."
                        ],
                        "tags": [],
                        "note": "dans cette acception, ne se rencontre que dans un certain nombre de locutions toutes faites :",
                        "examples": [
                            {
                                "example_id": "782d8fc5-c47e-4efd-b723-7037e3f1eeed",
                                "sense_id": "aa058df8-4ada-3538-8cd1-5fd1eaa39d31",
                                "text": "Diseur de bons mots."
                            },
                            {
                                "example_id": "38d3c634-2e8f-4cce-b1d1-fc728d585613",
                                "sense_id": "aa058df8-4ada-3538-8cd1-5fd1eaa39d31",
                                "text": "Diseuse de bonne aventure."
                            },
                            {
                                "example_id": "a6efd898-de2b-42fb-b4b4-0c8372ee9198",
                                "sense_id": "aa058df8-4ada-3538-8cd1-5fd1eaa39d31",
                                "text": "Diseur de nouvelles."
                            },
                            {
                                "example_id": "5ef6e3b1-ff73-4268-9ad6-8293d84baa21",
                                "sense_id": "aa058df8-4ada-3538-8cd1-5fd1eaa39d31",
                                "text": "En revanche, Assange, le diseur de vérité qui dérange, accusé de journalisme plutôt que de torture et de meurtre, ne bénéficie pas d'une assignation à résidence.",
                                "translation": "Nils Melzer, Cajoler Pinochet, briser Assange, Le Monde Diplomatique, numéro 821, août 2022, page 28"
                            }
                        ]
                    },
                    {
                        "sense_id": "afaa22b9-0d11-3b95-951e-adab54c3b0af",
                        "entry_id": "6cf0d260-edbf-3f9a-8de8-59657e482b79",
                        "glosses": [
                            "Personne qui dit, qui récite, qui déclame avec art et agrément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30d00857-eb09-4c9b-811d-fcc7af3666f9",
                                "sense_id": "afaa22b9-0d11-3b95-951e-adab54c3b0af",
                                "text": "Mesdames et messieurs, notre bon camarade Bignon, le plus talentueux de nos artistes, le plus bel homme de la troupe, le diseur impeccable que vous admirez, va avoir l’honneur de vous réciter : La Grève des Forgerons de « Monsieur » François Coppée… Notre bon camarade Bignon, c’est moi…"
                            },
                            {
                                "example_id": "6b0ee86c-fc73-4834-8873-ad6a9edef4dd",
                                "sense_id": "afaa22b9-0d11-3b95-951e-adab54c3b0af",
                                "text": "Ce premier regroupement d'artistes francophones de l'Ontario, fondé en 1932, … est constitué de trois corporations principales : a) les arts décoratifs (peinture), b) les lettres; et c) les diseurs (théâtre et poésie)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03e816e4-0a66-40ae-a780-ec8c5a7636ec",
                        "source_entry_id": "6cf0d260-edbf-3f9a-8de8-59657e482b79",
                        "target_lang_word": "teller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "293b9f78-122a-3438-a2fe-515ef605ca64",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A person who tells stories."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42695eea-863d-3a6a-9002-af08e764baae",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A bank clerk who receives and pays out money."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0216cc-a31a-42c6-a8cb-6dc5500d9b3d",
                                                "sense_id": "42695eea-863d-3a6a-9002-af08e764baae",
                                                "text": "Sukumar was thirty years old, four years into his bank job, where he’d moved up to the role of teller, turning up to work on time every day, counting the money, making the deposits, entering in the ledger, filing the reports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A cashier at any place of business."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2a9238-8384-4c8b-ae39-528e12d167b1",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "In the case discussed above, for example, the employee who stole money did so by waiting until another teller was on break, then logging on to that teller's register, ringing a “no sale,” and taking the cash."
                                            },
                                            {
                                                "example_id": "0b75dbe0-06ef-40ce-be97-55d371e3c22f",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "The young femail teller fingered the prices into the cash register at great speed with great dexterity while simultaneously holding a conversation with the teller in the next lane."
                                            },
                                            {
                                                "example_id": "6848b34d-db92-48c6-9f3e-435916e827a1",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "The main street was shuttered; the only sign of life she detected was behind the window of the petrol station, where the teller was counting the day's cash balance into the till."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "272fb4cd-e9f7-314a-8a17-1489f4017870",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "Synonym of automated teller machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "506c981a-fb5d-3b68-b5ac-69c49c31ba26",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A person who counts the votes in an election."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
