                                        "glosses": [
                                            "The situation of something being clogged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e81e26a-d5f6-4d14-b7b7-d94f2a9956b5",
                                                "sense_id": "c218a87d-6e57-305a-bc46-11136ceab709",
                                                "text": "This feature has been found effective in reducing injector trouble, resulting either from the clogging of sieves or the choking of the annular orifices of the injectors by fine particles of coal."
                                            },
                                            {
                                                "example_id": "2817b3b7-75d4-4c3b-b567-97bbb2d5b394",
                                                "sense_id": "c218a87d-6e57-305a-bc46-11136ceab709",
                                                "text": "The biofilm is allowed to develop uninhibited which leads to local cloggings."
                                            }
                                        ]
                                    },
