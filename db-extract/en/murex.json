                        "glosses": [
                            "Any of the genus Murex of marine gastropods."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e686b4-f3ae-4924-94cf-e82eeec743c2",
                                "sense_id": "41e6d7c0-58c4-308d-8fcb-d20a5b5c3779",
                                "text": "The bank of crushed murex shell that Professor Bosanquet found here, and again at Palaikastro, in company with a whole mass of Kamáres pottery, shows that the men of Sidon and Tyre were not the first to practise the dying of purple."
                            },
                            {
                                "example_id": "27beb9b6-41d5-4d13-a5da-56087e826afe",
                                "sense_id": "41e6d7c0-58c4-308d-8fcb-d20a5b5c3779",
                                "text": "The murexes (family Muricidae) are one of the most beautiful and sought-after families by shell collectors."
                            }
                        ]
                    }
                ],
