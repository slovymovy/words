                    {
                        "sense_id": "022b763c-45eb-32cb-b481-ddfe729b4772",
                        "entry_id": "6357de39-fdf6-3f38-96e1-f7a1320f12db",
                        "glosses": [
                            "Mangel an Zucker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2142d00-23d1-4b33-9cbe-426622cd14b8",
                                "sense_id": "022b763c-45eb-32cb-b481-ddfe729b4772",
                                "text": "„Der Sektor funktioniert aufgrund eines staatlichen Protektionismus, der bewussten Blockade rechtzeitiger Zuckereinfuhren in Zeiten, in denen sich Zuckerknappheit abzeichnet, und der völligen politischen Marginalisierung der Zuckeranbauer und Konsumenten.“"
                            },
                            {
                                "example_id": "2b63db8e-f5ce-48b4-9c43-87872829391d",
                                "sense_id": "022b763c-45eb-32cb-b481-ddfe729b4772",
                                "text": "„Einmal herrschte Zuckerknappheit, man bekam ein paar Wochen lang nur eine begrenzte Menge, dann war alles wieder normal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
