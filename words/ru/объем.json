                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я аккуратно <объем> мякоть вокруг косточки.",
                            "target_lang_translations": {
                                "en": "I will carefully <eat around> the pulp around the bone.",
                                "de": "Ich werde vorsichtig das Fruchtfleisch um den Kern <w>abessen</w>."
