        "nl-extract.jsonl": [
            {
                "entry_id": "1c0c9040-1974-3609-a475-081f6a71f328",
                "word": "tulpengekte",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "92068f0c-00b8-314a-b30f-0669fb48ae5b",
                        "entry_id": "1c0c9040-1974-3609-a475-081f6a71f328",
                        "glosses": [
                            "de maniakale speculatie met tulpenbollen zoals die plaatsvond van 1634 tot 1637 in Nederland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64680188-c6d2-4afc-bc63-fee5275c2832",
                                "sense_id": "92068f0c-00b8-314a-b30f-0669fb48ae5b",
                                "text": "Een metershoog bosje opblaastulpen die voortdurend van kleur verschieten; dat is Peter Koros' opgeblazen interpretatie van de Nederlandse tulpengekte. Kitscherig, maar wel leuk."
                            },
                            {
                                "example_id": "73106c57-bcea-4ba8-bbeb-660293d16bc6",
                                "sense_id": "92068f0c-00b8-314a-b30f-0669fb48ae5b",
                                "text": "Tijdens de tulpengekte in de 17e eeuw wisten ze het al: de Nederlandse tulp is goud waard. Ter opening van het tulpenseizeon verandert de Dam in een reusachtige tulpentuin met 200.000 bloemen."
                            }
                        ]
                    }
