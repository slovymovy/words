                                "target_lang_word": "исключи́тельный",
                                "target_lang_sense_clarification": "чрезвычайный"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "particular",
                                "target_lang_sense_clarification": "describing specific emphasis or detail"
                            },
                            {
                                "target_lang_word": "special",
                                "target_lang_sense_clarification": "extraordinary or extra"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36f59318-9415-3e0d-aa16-503cbead7e6d",
                    "sense_definition": "Taki, który ma dla kogoś osobiste, wyjątkowe znaczenie lub wartość.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unique_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Darzę to stare miasto <w>szczególnym</w> sentymentem, ponieważ tam się urodziłem.",
                            "target_lang_translations": {
                                "ru": "Я питаю к этому старому городу <w>особую</w> привязанность, так как я там родился.",
                                "en": "I have a <w>special</w> affection for this old town because I was born there."
                            }
                        },
                        {
                            "text": "Nowy pracownik cieszy się u dyrektora <w>szczególnymi</w> względami.",
                            "target_lang_translations": {
                                "ru": "Новый сотрудник пользуется у директора <w>особым</w> расположением.",
                                "en": "The new employee enjoys <w>special</w> favor with the director."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyjątkowy",
                        "specjalny"
                    ],
                    "common_phrases": [
                        "szczególne względy",
                        "szczególny sentyment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий для кого-то личное, исключительное значение или ценность.",
                        "en": "Having a personal, unique meaning, value, or significance for someone."
                    },
