                                        "glosses": [
                                            "Characterized by strong, divided opinions among people; divisive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998557fc-63e1-4045-b630-bdab0976a0ca",
                                                "sense_id": "b282de15-8093-3662-a93f-66bcff6a5909",
                                                "text": "It is a polarizing novel, loved by some and hated by others."
                                            },
                                            {
                                                "example_id": "0b1d420e-9f7f-4b18-93a1-fd25733bfdcc",
                                                "sense_id": "b282de15-8093-3662-a93f-66bcff6a5909",
                                                "text": "Che Guevara remains a polarizing Marxist revolutionary, feted by some as a champion of the poor and reviled by others as a bloodthirsty monster."
                                            }
                                        ]
                                    }
