                    ],
                    "synonyms": [
                        "instant",
                        "jiffy",
                        "moment",
                        "second",
                        "trice"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare temporal sense."
                        }
                    ]
                },
                {
                    "sense_id": "ff652c62-5c6f-3cef-8747-103b94d967ba",
                    "sense_definition": "A brief, quickly written note or memorandum.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept a hurried <w>jot</w> in his pocket for later reference."
                        },
                        {
                            "text": "A brief <w>jot</w> on the envelope reminded her of the appointment."
