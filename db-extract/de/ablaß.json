                "senses": [
                    {
                        "sense_id": "83d4bf10-37d0-3d81-861f-8ecbb370ce5d",
                        "entry_id": "546e1f48-4cb6-3e1b-8dd2-d7f9222ff9cc",
                        "glosses": [
                            "Erlass oder Nachlass von Bußstrafen (nicht aber von Sünden) für Lebende oder Verstorbene, der als von Gott geschenkt durch die Kirche vermittelt wird"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "b9899ad8-352b-4c21-adca-b59df3d68632",
                                "sense_id": "83d4bf10-37d0-3d81-861f-8ecbb370ce5d",
                                "text": "„Er brach in schallendes Gelächter aus und bat mich um Verzeihung, wenn er es mir nicht zu sagen wage; aber er regte an, ich solle mir doch selbst dort einen Ablaß holen, und versicherte mir, meine Neugier würde gestillt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
