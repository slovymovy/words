                                            {
                                                "example_id": "1b065278-c685-46ef-b4a6-2a69c2f55652",
                                                "sense_id": "212434d7-ecda-3509-8657-8552dba55427",
                                                "text": "„Eine 47-jährige Kajakfahrerin ist Sonntagnachmittag auf der Traun bei Bad Ischl (Bezirk Gmunden) in ein Rohr mit etwa einem Meter Durchmesser gezogen worden.“"
                                            }
