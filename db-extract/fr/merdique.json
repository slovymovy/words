                                "target_senses": [
                                    {
                                        "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Very bad; unpleasant; miserable; insignificant."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67275724-7f3d-4285-a6ee-b1c1e113809e",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "The television I bought there was so shitty that I will never shop there again."
                                            },
                                            {
                                                "example_id": "39b4e5a8-a6a8-49bc-9062-4a81da85a6ee",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "I'm feeling shitty today; I don't want to go out."
                                            },
                                            {
                                                "example_id": "02c4f782-f58f-4c1d-a7a8-c6b943bf83e4",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "It's a well-known fact that reading is about the shittiest thing you can do for your eyes."
                                            },
                                            {
                                                "example_id": "f7127d7c-9c58-4c80-8ac1-ecbbaea191f9",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "Except for Rasheena, the rest of the baby mamas was at least struggling to live halfway right. They used to clown and act shitty whenever they came by Noojie's and saw Carmiesha there. But every last one of them ended up being grateful to her for the things she did for their kids."
                                            },
                                            {
                                                "example_id": "8295ab29-12f2-4e66-bb8d-7714ca78e02f",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "The difference is they usually have a shittier singer, and no originality."
                                            },
                                            {
                                                "example_id": "9e762d1d-035e-474f-9e20-f86dfc1812e5",
                                                "sense_id": "a3b49b81-0da8-39f8-bb24-f18749e39d0d",
                                                "text": "Halfway there we turned off the highway onto possibly the shittiest gravel road I have ever driven. In Canada, we would call it washboard; in Australia they call it corrugated, but you get the point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0d5652-300c-34b6-8446-7a61c66eea4c",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Under the influence of illicit drugs or alcohol; drunk; high."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41b27ac1-60d7-30a3-afd3-9a04ec897338",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Annoyed."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b1cb3c-8e5a-4d8e-9c03-33d0e2d8fc8f",
                                                "sense_id": "41b27ac1-60d7-30a3-afd3-9a04ec897338",
                                                "text": "Don't get shitty with me!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fc7d26b-4343-3bde-874c-5adc8e7313a6",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Covered in faeces/feces; feculent."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c45a0f2b-1d1f-3c0e-9f62-adc8152f2fc6",
                                        "entry_id": "21f1a129-5f51-3539-aee5-9e2149ee7542",
                                        "glosses": [
                                            "Of low quality or standard; inferior; not up to par, or failing one's expectations"
                                        ],
                                        "tags": [
                                            "informal",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c4f0591-c866-4b28-b861-6aaa45e6b342",
                                                "sense_id": "c45a0f2b-1d1f-3c0e-9f62-adc8152f2fc6",
                                                "text": "“She's a shitty teacher, but Ault was in a bind.” But she hadn't been a shitty teacher when she'd been hired. She'd never taught before. And who was Aspeth to decide she was shitty now? She was still inexperienced."
                                            }
                                        ]
                                    }
                                ]
                            }
