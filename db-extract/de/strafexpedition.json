                ],
                "senses": [
                    {
                        "sense_id": "29a24d8b-70f1-3cb3-ac66-b28962dbde44",
                        "entry_id": "a12d101b-b70e-3356-9b92-1161f0e7c572",
                        "glosses": [
                            "militärische Unternehmung zur Unterdrückung von Widerstand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9305fea1-e184-44b3-aca4-ae356eb1331c",
                                "sense_id": "29a24d8b-70f1-3cb3-ac66-b28962dbde44",
                                "text": "„Deshalb hatte Rom mit den üblichen Strafexpeditionen zunächst weiterhin Erfolg.“"
                            },
                            {
                                "example_id": "8bbcf6a1-a550-406f-aea0-5fb28b71398a",
                                "sense_id": "29a24d8b-70f1-3cb3-ac66-b28962dbde44",
                                "text": "„Die Strafexpeditionen der Compagnie gegen unbotmäßige Bauern verurteilte er als »barbarisch«.“"
                            },
                            {
                                "example_id": "b9700ce1-2ccc-4efd-8240-2d4f70d457ba",
                                "sense_id": "29a24d8b-70f1-3cb3-ac66-b28962dbde44",
                                "text": "„Im August 1955 werden bei Strafexpeditionen halbe Dörfer ausgelöscht, die Militärs setzen dabei auch Napalmbomben ein.“"
                            },
                            {
                                "example_id": "f0ed0ef3-b428-4a47-9712-b6abf150db87",
                                "sense_id": "29a24d8b-70f1-3cb3-ac66-b28962dbde44",
                                "text": "„Die Strafexpedition ist von Erfolg gekrönt und Mayréna gewinnt die Sympathie des französischen Bischofs in Indochina.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
