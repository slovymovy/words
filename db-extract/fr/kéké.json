        "fr-extract.jsonl": [
            {
                "entry_id": "43a2f27e-b425-3b48-85d1-03ac75677b70",
                "word": "Kéké",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "777f3dc9-721b-3d7b-96fa-aff062a34c87",
                        "entry_id": "43a2f27e-b425-3b48-85d1-03ac75677b70",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33993d56-8eff-4a7c-9b23-a0bffe4469ee",
                                "sense_id": "777f3dc9-721b-3d7b-96fa-aff062a34c87",
                                "text": "Rachel Kéké, qui a mené une longue grève à l’hôtel Ibis Batignolles, se présente pour la Nupes aux législatives dans le Val-de-Marne."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "415c74bd-61cc-3572-8b2e-d966a42d8835",
                "word": "Kéké",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "887bc926-cd0c-3b55-9a07-656e6e272863",
                        "entry_id": "415c74bd-61cc-3572-8b2e-d966a42d8835",
                        "glosses": [
                            "Diminutif du prénom Kévin."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cd4c991e-16c8-4981-ba03-2bf50fb377e2",
                                "sense_id": "887bc926-cd0c-3b55-9a07-656e6e272863",
                                "text": "« Kéké » ne revêtira donc pas sa cape de super-héros pour sauver une nouvelle fois une équipe de France en détresse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52b5d3b5-66d8-48d6-836f-6cb3c4bb069b",
                        "source_entry_id": "415c74bd-61cc-3572-8b2e-d966a42d8835",
                        "source_sense_id": "887bc926-cd0c-3b55-9a07-656e6e272863",
                        "target_lang_word": "Kevin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kevin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1c1f5c8-ad8c-3d9e-b5eb-9a0ba4a5d162",
                                        "entry_id": "9f44e69b-0a7c-3b33-9739-3abcf878e842",
                                        "glosses": [
                                            "A male given name from Irish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9fafbeb-391a-4673-9e53-e81b4ef528ab",
                                                "sense_id": "e1c1f5c8-ad8c-3d9e-b5eb-9a0ba4a5d162",
                                                "text": "“My message to Kevin McCarthy is, take all of her committee assignments away … also, don’t support her when she runs for re-election again and try to get her primaried. If you say this is not your party, actually call it out and hold her accountable,” Hogg told CNN’s Alisyn Camerota on “New Day.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72e289e1-7456-3021-af8b-77a49151afa1",
                                        "entry_id": "9f44e69b-0a7c-3b33-9739-3abcf878e842",
                                        "glosses": [
                                            "A working-class male."
                                        ],
                                        "tags": [
                                            "British",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "e4d19e7d-3dd3-3c9c-b02b-1d196b565768",
                "word": "kéké",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "509e1280-cc3d-4f87-92ed-3c35501ad71a",
                        "entry_id": "e4d19e7d-3dd3-3c9c-b02b-1d196b565768",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "kékés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                        "entry_id": "e4d19e7d-3dd3-3c9c-b02b-1d196b565768",
                        "glosses": [
                            "Individu qui cherche à impressionner par son comportement et s’avère finalement ridicule et lourd."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7e9907ec-7ea9-4559-babd-6cc5a4d1abed",
                                "sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                                "text": "Trois kékés hip-hop, joggings de marque bouffants, casquettes à l’envers, phone à fond, baskets aux lacets dorés, s’arrêtent devant nous. Allons bon."
                            },
                            {
                                "example_id": "1b1c7d2a-6c6c-4eae-bf13-bba0cc8d9ae5",
                                "sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                                "text": "[Faire] un audit sur la sécurité nucléaire [c’est] plus urgent pour un ministre que de faire le kéké sur twitter non ?"
                            },
                            {
                                "example_id": "266d3407-6ee9-48d9-a6d9-e2b985f2e052",
                                "sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                                "text": "Maman a renchéri qu’elle n’en pouvait plus de tous ces « kékés » qui faisaient les zouaves sur la route en équilibre sur leur roue arrière et qu’il y avait des endroits pour ça."
                            },
                            {
                                "example_id": "685fd65a-213a-458b-ad82-6bee5ded0211",
                                "sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                                "text": "On leur parle de tuning, ils font la grimace, ce n’est pas un terme qu’ils aiment voir accoler à la transformation automobile et à leurs cabriolets : « Il y a toujours du kéké, comme on dit. Mais ils parlent de leur passion avec les mêmes mots. « On a ça dans le sang depuis tout petit », disent-ils aussi, comme ces « kékés » qu’ils méprisent un peu."
                            },
                            {
                                "example_id": "e11ae877-883c-4552-9aa1-11606ada4c5c",
                                "sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                                "text": "Il y a vingt ans, à l’époque où je l’avais achetée, la Mercedes Classe G était une voiture peu répandue, les gens l’achetaient quand ils envisageaient de traverser l’Afrique, ou au minimum la Sardaigne ; elle était aujourd’hui à la mode, son côté vintage avait séduit, enfin c’était plus ou moins devenu une voiture de kéké."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef032aaa-4cc5-4186-b1e0-177a333212ac",
                        "source_entry_id": "e4d19e7d-3dd3-3c9c-b02b-1d196b565768",
                        "source_sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                        "target_lang_word": "Angeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                        "entry_id": "b03214ad-0a3e-3a7f-b121-356a75e57dd9",
                                        "glosses": [
                                            "Person, die ihre eigenen Leistungen freiwillig und unaufgefordert in den Vordergrund stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc20af85-5b39-44ce-8343-6ce74b2d85b1",
                                                "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                                "text": "So ein Angeber hat mir gerade noch gefehlt!"
                                            },
                                            {
                                                "example_id": "dc28ff32-0070-4ae4-94ab-be55c7faa319",
                                                "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                                "text": "„Das Achtergewicht liegt nicht selten bei einem Amerikaner, der im Witz oft die Rolle eines übertrumpfungssüchtigen Angebers spielt, der alles noch schöner, noch größer und noch praktischer besitzt als sein Gegenüber aus der alten Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f8d10bf-3734-44bb-bef2-54a6587ac514",
                        "source_entry_id": "e4d19e7d-3dd3-3c9c-b02b-1d196b565768",
                        "source_sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                        "target_lang_word": "Protzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ed9f6f5f-9f4b-4a81-b44c-97c90113859e",
                        "source_entry_id": "e4d19e7d-3dd3-3c9c-b02b-1d196b565768",
                        "source_sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                        "target_lang_word": "show-off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "show-off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                        "entry_id": "ba9cab3a-d8fe-3b35-8956-0349f2eed8c4",
                                        "glosses": [
                                            "One who shows off; a person given to egotistically demonstrating their prowess or ability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28745b27-9973-467a-ae25-1882516dce7b",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "Quit being such a show-off, before someone gets hurt."
                                            },
                                            {
                                                "example_id": "a8055650-3827-445a-b20b-cacf944fff6f",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "“Don’t tell me what to do, you double-crossing little show-off!” he grated. “Here, stand aside there, and let a man pass.”"
                                            },
                                            {
                                                "example_id": "8ffda4ea-a9fb-4f2c-8c57-7142f540c7fb",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "He was still a tad disgruntled about being used as a work-horse, but he allowed this feeling to be repressed in favor of the pomp and circumstance of the parade. He was, after all, a bit of a show-off when he could get away with it. And that is a real understatement!"
                                            },
                                            {
                                                "example_id": "2127bd20-1a9a-415c-930f-5524634742ec",
                                                "sense_id": "d348d115-a0f4-37d0-a2d2-23b617372f21",
                                                "text": "Totally obsessive fans are a good measure of a ride’s popularity, but they’re kind of a pain in the ass, too. They lipsynch the soundtrack, cadge souvenirs and pester you with smarmy, show-off questions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d942f668-e7e9-4788-884e-a4fde795571a",
                        "source_entry_id": "e4d19e7d-3dd3-3c9c-b02b-1d196b565768",
                        "source_sense_id": "de78e7cc-3c2b-36e0-91f5-91ec21706716",
                        "target_lang_word": "swagger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8a6807-3391-3e91-8270-4906188c66a2",
                                        "entry_id": "2d4a84ca-b2a1-3872-9922-0c9b99e11b49",
                                        "glosses": [
                                            "To behave (especially to walk or carry oneself) in a pompous, superior manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa3170e-ae71-4895-9824-08cf584f1410",
                                                "sense_id": "1f8a6807-3391-3e91-8270-4906188c66a2",
                                                "text": "What hempen home-ſpuns haue we ſwaggering here, / So neere the Cradle of the Faierie Queene?"
                                            },
                                            {
                                                "example_id": "3d75734c-869e-4d6f-89c8-e7e47e66ae49",
                                                "sense_id": "1f8a6807-3391-3e91-8270-4906188c66a2",
                                                "text": "He is a political humbug, the greatest of all humbugs; a man who swaggers about London clubs and consults solemnly about his influence, and in the country is a nonentity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0c560f-07e4-364f-8107-1c530f5bd051",
                                        "entry_id": "2d4a84ca-b2a1-3872-9922-0c9b99e11b49",
                                        "glosses": [
                                            "To boast or brag noisily; to bluster; to bully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa868a0-3983-4158-b7c9-f525f030d66c",
                                                "sense_id": "1b0c560f-07e4-364f-8107-1c530f5bd051",
                                                "text": "To be great is not […] to swagger at our footmen."
                                            },
                                            {
                                                "example_id": "305754f9-5574-42d8-87e3-d932f198faaf",
                                                "sense_id": "1b0c560f-07e4-364f-8107-1c530f5bd051",
                                                "text": "For the common Soldier when he goes to the Market or Ale-house will offer this Money, and if it be refused, perhaps he will SWAGGER and HECTOR, and Threaten to Beat the BUTCHER or Ale-Wife, or take the Goods by Force, and throw them the bad HALF-PENCE."
                                            },
                                            {
                                                "example_id": "ca373f6b-c9b8-4656-8ca3-1ac4b2e8e638",
                                                "sense_id": "1b0c560f-07e4-364f-8107-1c530f5bd051",
                                                "text": "“They say there’s something wrong with our president!” Mr. Trump swaggered at his indoor Tulsa rally in June,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e61a0abb-4ae8-3a28-ad82-96b516d56084",
                                        "entry_id": "2d4a84ca-b2a1-3872-9922-0c9b99e11b49",
                                        "glosses": [
                                            "To walk with a swaying motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781baa5f-9363-4765-90ce-43b889159551",
                                                "sense_id": "e61a0abb-4ae8-3a28-ad82-96b516d56084",
                                                "text": "It's the injustice… he is so unjust—\nwhiskey-blind, swaggering home at five."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b802d6d1-d956-3d9b-b5d6-0e59356618e6",
                                        "entry_id": "fbac9d1b-d829-3a3e-a5dc-50489a1854c6",
                                        "glosses": [
                                            "Confidence, pride."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be92ac0c-086e-4385-91c7-a4ca2e6dc88a",
                                                "sense_id": "b802d6d1-d956-3d9b-b5d6-0e59356618e6",
                                                "text": "After spending so much of the season looking upwards, the swashbuckling style and swagger of early season Spurs was replaced by uncertainty and frustration against a Norwich side who had the quality and verve to take advantage"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9e76e42-64a1-373d-9ea9-88a133ac7501",
                                        "entry_id": "fbac9d1b-d829-3a3e-a5dc-50489a1854c6",
                                        "glosses": [
                                            "A bold or arrogant strut."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6885af68-9634-44a8-a33e-d5dbac077043",
                                                "sense_id": "d9e76e42-64a1-373d-9ea9-88a133ac7501",
                                                "text": "He steered with no end of a swagger while you were by; but if he lost sight of you, he became instantly the prey of an abject funk, and would let that cripple of a steamboat get the upper hand of him in a minute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "328b3daf-76c5-3d6b-8615-d2723a84f3f7",
                                        "entry_id": "fbac9d1b-d829-3a3e-a5dc-50489a1854c6",
                                        "glosses": [
                                            "A prideful boasting or bragging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "970565b5-96e2-4169-8fd5-298477f66da0",
                                                "sense_id": "328b3daf-76c5-3d6b-8615-d2723a84f3f7",
                                                "text": "Too often we honor swagger and bluster and the wielders of force; too often we excuse those who are willing to build their lives on the shattered dreams of others."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5a05fb-863b-3db5-82cf-051ad337c0ae",
                                        "entry_id": "c434dede-0116-340e-9c05-e9957f7aef15",
                                        "glosses": [
                                            "Fashionable; trendy."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc25f01-0adc-4522-8867-a212f66a87f8",
                                                "sense_id": "5a5a05fb-863b-3db5-82cf-051ad337c0ae",
                                                "text": "It is to be a very swagger affair, with notables from every part of Europe, and they seem determined that no one connected with a newspaper shall be admitted."
                                            },
                                            {
                                                "example_id": "0bed49f2-4f5b-4f10-8954-dd96798ec869",
                                                "sense_id": "5a5a05fb-863b-3db5-82cf-051ad337c0ae",
                                                "text": "15 March, 1896, Ernest Rutherford, letter to Mary Newton\nMrs J.J. [Thomson] looked very well and was dressed very swagger and made a very fine hostess."
                                            },
                                            {
                                                "example_id": "f0abf859-2f02-4b54-bdfc-8b039fc6dd20",
                                                "sense_id": "5a5a05fb-863b-3db5-82cf-051ad337c0ae",
                                                "text": "Mrs. Morton was well known for her Americanisms, her swagger dinner parties, and beautiful Paris gowns."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swagger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3455181-9d7a-3678-88a7-de123e055d2b",
                                        "entry_id": "9bb0d4db-5f42-3c3e-8d5e-80fd92d55826",
                                        "glosses": [
                                            "Someone carrying a swag; a swagman."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3386069a-feee-48f2-a537-f93de3b93f23",
                                                "sense_id": "f3455181-9d7a-3678-88a7-de123e055d2b",
                                                "text": "There were now more swaggers passing down Ferry Street and more coming to ask for food […]."
                                            },
                                            {
                                                "example_id": "c3eef563-28ff-408a-9a43-92c8e8f10661",
                                                "sense_id": "f3455181-9d7a-3678-88a7-de123e055d2b",
                                                "text": "She looked down in her half-dreaming state and thought they might be swaggers. There were lots of them that year, camped out on the riverbank netting for whitebait, then fanning out around the streets selling their catch door to door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
