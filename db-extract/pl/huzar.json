                                        "glosses": [
                                            "воен., истор. : военнослужащий из частей лёгкой кавалерии, носивших особую форму венгерского образца с галунами"
                                        ],
                                        "tags": [
                                            "в армии Российского государства до 1917 г. и ряде европейских стран в XVII–XX в."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7affbc0a-f179-47c0-93a8-fd50163d1479",
                                                "sense_id": "11651f32-1e53-3f2c-8315-a69835482cb3",
                                                "text": "Эскадрон гусар."
                                            },
                                            {
                                                "example_id": "74bc8177-3cbd-43cd-9d53-913aeeaf444c",
                                                "sense_id": "11651f32-1e53-3f2c-8315-a69835482cb3",
                                                "text": "В казарме они застали двух гусаров."
                                            }
                                        ]
