    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0cd7f64-23fd-3e1e-9ea1-11b2b0094548",
                    "sense_definition": "Circonstance favorable ou propice qui permet d'accomplir un projet ou de faire quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opportunite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas rater cette belle <w>occasion</w> de voyager à l'étranger."
                        },
                        {
                            "text": "Dès qu'il a du temps libre, il profite de l'<w>occasion</w> pour lire un livre."
                        }
                    ],
                    "synonyms": [
                        "opportunité"
                    ],
                    "common_phrases": [
                        "saisir l'occasion",
                        "profiter de l'occasion",
                        "à la première occasion"
                    ]
                },
                {
                    "sense_id": "c1db37f1-4863-35c1-8722-9b437e034058",
                    "sense_definition": "Objet vendu à un prix réduit, souvent parce qu'il a déjà servi, ou achat avantageux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté un vélo d'<w>occasion</w> en très bon état pour aller au travail."
                        },
                        {
                            "text": "Ce manteau chaud était une véritable <w>occasion</w> pendant les soldes d'hiver."
                        }
                    ],
                    "common_phrases": [
                        "voiture d'occasion",
                        "marché de l'occasion",
                        "livre d'occasion"
                    ]
                },
                {
                    "sense_id": "6ef505b5-9da9-308c-a7c0-cc798411d9cb",
                    "sense_definition": "Circonstance particulière ou événement marquant un moment déterminé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "evenement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille s'est réunie à l'<w>occasion</w> de son quatre-vingtième anniversaire."
                        },
                        {
                            "text": "Il garde toujours son plus beau costume pour les grandes <w>occasions</w>."
                        }
                    ],
                    "common_phrases": [
                        "pour l'occasion",
                        "en toute occasion",
                        "grandes occasions"
                    ]
                },
                {
                    "sense_id": "11a410f5-6ceb-3143-97a5-df1f78649694",
                    "sense_definition": "Cause, motif ou événement fortuit qui produit ou provoque quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette discussion inattendue a été l'<w>occasion</w> d'un malentendu durable entre les deux collègues."
                        },
                        {
                            "text": "Une remarque maladroite du maire fut l'<w>occasion</w> de la crise qui divisa le village."
                        }
                    ],
                    "common_phrases": [
                        "donner l'occasion de",
                        "fournir l'occasion"
                    ]
                }
            ]
        }
    ]
