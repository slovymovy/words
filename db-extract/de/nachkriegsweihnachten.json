                "senses": [
                    {
                        "sense_id": "089965bd-2fd4-3266-b65e-dd34c4218632",
                        "entry_id": "32da2a75-b342-3bd9-8589-0dad4cd3ee41",
                        "glosses": [
                            "Weihnachtsfest nach Ende eines Krieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e25d5ae-4869-46ff-b167-a33aabfede80",
                                "sense_id": "089965bd-2fd4-3266-b65e-dd34c4218632",
                                "text": "„Das erste Nachkriegsweihnachten ohne Propagandageschrei und Kriegsdonner verläuft dennoch ein wenig schmerzhaft.“"
                            },
                            {
                                "example_id": "fab7bbc2-ddf3-4891-a869-76e377d9e36a",
                                "sense_id": "089965bd-2fd4-3266-b65e-dd34c4218632",
                                "text": "„Die ersten Weihnachten 1945 waren so einschneidend, diese werden wohl für immer als die traurigsten Nachkriegsweihnachten für alle Menschen in Österreich und Deutschland in Erinnerung bleiben.“"
                            },
                            {
                                "example_id": "3776fe45-d6a5-4637-ac8c-107636f8316f",
                                "sense_id": "089965bd-2fd4-3266-b65e-dd34c4218632",
                                "text": "„Die ersten Nachkriegsweihnachten waren völlig anders.“"
                            },
                            {
                                "example_id": "6badfe63-0113-4abf-a4df-211f1cabd3b1",
                                "sense_id": "089965bd-2fd4-3266-b65e-dd34c4218632",
                                "text": "„So lieferten sich, während das erste Nachkriegsweihnachten näherrückte, revolutionäre Matrosen […] in der Stadtmitte blutige Gefechte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
