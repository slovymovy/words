                    },
                    {
                        "translation_id": "27d81d90-9101-46a5-9e84-113ae249739f",
                        "source_entry_id": "53e185be-66ea-38ec-91e8-fa10670e7bd2",
                        "source_sense_description": "a large garage-like structure where aircraft are kept",
                        "target_lang_word": "hangar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hangar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad14741-1be7-3c85-9a7b-7af919dd161c",
                                        "entry_id": "ba33d15f-7694-32a6-8a8d-8f543643b02f",
                                        "glosses": [
                                            "Entrepôt ou remise ordinairement destinée à servir d’abri à des charrettes, à des récoltes, à des marchandises ou encore à des appareils d’aéronautique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eed9ab8-23d1-4705-b2b4-85dc361a9054",
                                                "sense_id": "8ad14741-1be7-3c85-9a7b-7af919dd161c",
                                                "text": "La bergerie était longue, la grange était haute, à murs lisses comme la main. Il y avait sous le hangar deux grandes charrettes et quatre charrues, avec leurs fouets, leurs colliers, leurs équipages complets."
                                            },
                                            {
                                                "example_id": "8c4eb9e8-b857-4f77-9aca-ffd95fec4139",
                                                "sense_id": "8ad14741-1be7-3c85-9a7b-7af919dd161c",
                                                "text": "Il ne reste plus qu’à faire sécher l’écorce sur un lit de perches disposées en plan incliné, à la nettoyer à l’intérieur avec un râcloir et à la lier en bottes que l’on met en meules ou que l’on transporte dans un hangar."
                                            },
                                            {
                                                "example_id": "dc3b2c51-d7dc-45b4-a06a-c3a0926af88f",
                                                "sense_id": "8ad14741-1be7-3c85-9a7b-7af919dd161c",
                                                "text": "Le hangar, dans lequel le bois était renfermé, s’élevait à cinquante pas environ sur la gauche et en arrière de la maison principale."
                                            },
                                            {
                                                "example_id": "00513e5c-8c28-48f3-83ca-c01f380d4b25",
                                                "sense_id": "8ad14741-1be7-3c85-9a7b-7af919dd161c",
                                                "text": "Sous le hangar, les chevaux, harcelés par les mouches et piqués par les taons, s’ébrouaient."
                                            },
                                            {
                                                "example_id": "301533ec-b8e1-42d7-ae04-b3710fa741ce",
                                                "sense_id": "8ad14741-1be7-3c85-9a7b-7af919dd161c",
                                                "text": "Ils guignaient depuis longtemps, pour leur nouvelle installation, […], une petite boutique, en forme de hangar, avec une vitrine d’une seule glace et une unique pièce sur le derrière."
                                            },
                                            {
                                                "example_id": "920cb54d-19bc-4c21-b7c4-b4ea6f6f2c02",
                                                "sense_id": "8ad14741-1be7-3c85-9a7b-7af919dd161c",
                                                "text": "Comme aux très anciennes bâtisses, l’auvent du toit dévale presque jusqu’au sol, en guise de hangar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7acb8c6-7fd6-489d-8ef6-6e9cb7ec8a5e",
                        "source_entry_id": "53e185be-66ea-38ec-91e8-fa10670e7bd2",
                        "source_sense_description": "a large garage-like structure where aircraft are kept",
                        "target_lang_word": "Hangar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hangar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "130d6c5c-41dd-3729-9127-58e1985cc241",
                                        "entry_id": "89a86950-a320-3107-8d53-1d50e2e0edec",
                                        "glosses": [
                                            "große, überdachte Halle, meistens aus Metall oder Holz, die zum Unterbringen, Warten und Reparieren von Luftfahrzeugen (vornehmlich Luftschiffe, Flugzeuge, Raumfähren) dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4398123-d0e9-48d3-9d7d-a5fb66b1f404",
                                                "sense_id": "130d6c5c-41dd-3729-9127-58e1985cc241",
                                                "text": "„Im Hangar der Reederei wird schon an einem vierten Zeppelin NT gebaut.“"
                                            },
                                            {
                                                "example_id": "ee2aadaa-a215-4b6b-9ae7-419c5ee46ddd",
                                                "sense_id": "130d6c5c-41dd-3729-9127-58e1985cc241",
                                                "text": "„München und der Orkan \"Kyrill\": Rettungshubschrauber bleiben im Hangar, bei der Bahn geht nichts mehr, die Schulen sind geschlossen.“"
                                            },
                                            {
                                                "example_id": "8d0037ad-e6f7-4928-93d6-da0772ed5e37",
                                                "sense_id": "130d6c5c-41dd-3729-9127-58e1985cc241",
                                                "text": "Dieser militärisch genutzte Hangar ist ein als Betonröhre konzipierter, mit Erde bedeckter und zur Tarnung mit Gras bewachsener Luftschutzbunker, in dem auf dem Militärflugplatz militärisches Fluggerät zum Schutz vor Fremdeinwirkung untergestellt wird."
                                            },
                                            {
                                                "example_id": "c0aa59a5-1a79-44f1-a993-80303309ebf7",
                                                "sense_id": "130d6c5c-41dd-3729-9127-58e1985cc241",
                                                "text": "„Man hatte das Schiff vor dem Tor des Hangars liegen sehen.“"
                                            },
                                            {
                                                "example_id": "c6f9b101-e200-4848-9b95-91cc9dd6642d",
                                                "sense_id": "130d6c5c-41dd-3729-9127-58e1985cc241",
                                                "text": "„Das Sägwerk liegt im Westen der Insel, mit großem Hafen und Hangars aus Blech.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
