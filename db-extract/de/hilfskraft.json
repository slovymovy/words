                "senses": [
                    {
                        "sense_id": "3be2e907-a951-3943-9cdf-62e61fb0e8b9",
                        "entry_id": "46355f83-1361-3fba-8618-9f122686f0a2",
                        "glosses": [
                            "Person, die unterstützende Tätigkeiten übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0052ec32-7ae6-4d64-8ed1-ec12f4d03ad9",
                                "sense_id": "3be2e907-a951-3943-9cdf-62e61fb0e8b9",
                                "text": "„In zweistündigen Einzelsitzungen stellen die Testleiter — Promovierende oder Hilfskräfte — jedem Kind Fragen nach Einstellungen, Gedanken oder Gefühlen, lassen es je nach Alter spielerisch aufbereite Aufgaben am Computer lösen und filmen einzelne Szenen.“"
                            },
                            {
                                "example_id": "4b171c01-0fc5-42ca-944e-35557b894875",
                                "sense_id": "3be2e907-a951-3943-9cdf-62e61fb0e8b9",
                                "text": "„Sie hat es verstanden, nicht nur Hilfskräfte mit fachlich guten Voraussetzungen an den Berliner Universitäten zufinden, sondern diese auch für die Arbeit zu interessieren.“"
                            },
                            {
                                "example_id": "85da9c51-3baa-4a27-853d-55895214df60",
                                "sense_id": "3be2e907-a951-3943-9cdf-62e61fb0e8b9",
                                "text": "„Es sei wünschenswert, dass in den Familien mehr als seit Kriegsbeginn weibliche Hilfskräfte zum Nähen, Waschen, Kochen, Bedienen und so weiter angestellt würden, damit die beschäftigungslosen Frauen und Mädchen Ihren Unterhalt selbst verdienen könnten.“"
                            },
                            {
                                "example_id": "c53b8e06-8353-4ad0-922b-8b98be36a94d",
                                "sense_id": "3be2e907-a951-3943-9cdf-62e61fb0e8b9",
                                "text": "„Ich holte meine Pflichten als studentische Hilfskraft nach und vertiefte mich noch einmal in Brecht.“"
                            },
                            {
                                "example_id": "42965341-279b-4402-b2d7-09502cbf3d37",
                                "sense_id": "3be2e907-a951-3943-9cdf-62e61fb0e8b9",
                                "text": "„Weil Sorgearbeit informell, in freiwilligem Einsatz und prädisziplinär von Hilfskräften […] geleistet wird und dieser Einsatz effektiv sein soll, ist zu ihm ebenso eine begleitende Anleitung und Weiterbildung nötig wie die Hauptberuflichen für die Zusammenarbeit qualifiziert sein wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
