                        "examples": [
                            {
                                "example_id": "a316ad12-e500-4cf7-92e1-d7fb5e9b2d31",
                                "sense_id": "be7b198e-5eea-3959-b582-b476261426ba",
                                "text": "Gisteravond zijn er ook nog een groot drugslaboratorium en ondergrondse hennepkwekerij ontdekt in Lage Zwaluwe. Het afval dat daar gevonden was, werd geschat op 30.000 liter. Vandaag wordt dat lab ontmanteld."
                            },
                            {
                                "example_id": "a2668248-22b8-40be-965e-833e31501e79",
                                "sense_id": "be7b198e-5eea-3959-b582-b476261426ba",
                                "text": "In een huis in Spijkenisse heeft de politie vuurwerk gevonden en grondstoffen om zelf vuurwerk te maken. Ook was er volgens de politie een hennepkwekerij op het adres aan de Willem Kloosstraat. De bewoner is aangehouden."
                            }
                        ]
