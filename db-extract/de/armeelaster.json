                "senses": [
                    {
                        "sense_id": "1ebce89a-46ae-3df4-9c8f-9883294efdc7",
                        "entry_id": "200d68b3-5861-3179-9922-b5eab757cd65",
                        "glosses": [
                            "von der Armee benutzter Lastwagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a262ca7d-c7a4-40b8-9fe9-ebcd15cec232",
                                "sense_id": "1ebce89a-46ae-3df4-9c8f-9883294efdc7",
                                "text": "„Diese Sachen packten sie als Geschenk ein und legten sie auf der Schwelle der Hütte ab, bevor der Armeelaster sie zurück zum Hauptquartier fuhr.“"
                            },
                            {
                                "example_id": "2072370b-c09a-44be-9900-92b5e246e5e4",
                                "sense_id": "1ebce89a-46ae-3df4-9c8f-9883294efdc7",
                                "text": "„Er deutete auf einen mit Kisten beladenen Armeelaster.“"
                            },
                            {
                                "example_id": "eb7cc673-71df-4595-970b-6b20fea6e7e1",
                                "sense_id": "1ebce89a-46ae-3df4-9c8f-9883294efdc7",
                                "text": "„Es ging los mit einer Reihe spontaner Proteste, die aufkamen, nachdem ein Armeelaster der israelischen Verteidigungskräfte in Gaza mit einem Kombi kollidiert war, wobei vier palästinensische Arbeiter getötet wurden.“"
                            },
                            {
                                "example_id": "be481d89-35a5-45de-b730-1aa149f06ea3",
                                "sense_id": "1ebce89a-46ae-3df4-9c8f-9883294efdc7",
                                "text": "„Als gegen Abend die Armeelaster anrücken, wird es allmählich leer auf den Straßen“"
                            },
                            {
                                "example_id": "b8f18dd2-bc26-4afa-92b1-ee7fe129a934",
                                "sense_id": "1ebce89a-46ae-3df4-9c8f-9883294efdc7",
                                "text": "„Zweimal gingen sie kurzzeitig mit Armeelastern auf Tuchfühlung, ohne dass ein einziger Schuss gefallen wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
