                        "glosses": [
                            "житель, гражданин или уроженец Иордании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc255b5-0437-4748-b20d-2e55e3a5b7d4",
                                "sense_id": "159affca-4dc6-3748-98e0-be0557a8cc8d",
                                "text": "Иерусалим разделен колючей проволокой, иорданцы не пропускают евреев к Стене Плача, и школьникам о ней рассказывают на специальном уроке, привозя классы на некую горку, с которой виден краешек этой самой святыни."
                            }
                        ]
                    }
