                "senses": [
                    {
                        "sense_id": "4b0d7fc4-73c2-309b-b3ca-917bb8900300",
                        "entry_id": "98c91a3d-0f72-333c-9614-95cbc3809860",
                        "glosses": [
                            "iets door verwaarlozing achteruit laten gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e109cd1a-0cd2-4b8c-a68a-8cb9e259d69c",
                                "sense_id": "4b0d7fc4-73c2-309b-b3ca-917bb8900300",
                                "text": "Ook het dossier binnenstad zou Elferink volgens ProHengelo hebben laten versloffen. Zo zei VVD-fractievoorzitter Onno Fiechter vorige week nog in een politieke markt: „Je hebt er 3,5 jaar een zootje van gemaakt.”"
                            },
                            {
                                "example_id": "343230a1-1cb1-46a9-a05b-fac390a5ccc9",
                                "sense_id": "4b0d7fc4-73c2-309b-b3ca-917bb8900300",
                                "text": "Kritisch is Kamphuis wel over de rol van de gemeente. Die zit volgens hem teveel op schoot bij vastgoedbedrijf Unibail-Rodamco, eigenaar van winkelcentrum In den Vijfhoek. ,,Ik zeg: kijk eerst naar de lokale ondernemers en de vastgoedeigenaren en pas daarna naar zo'n multinational die de Vijfhoek tien jaar heeft laten versloffen. De bibliotheek had toch ook perfect gekund in het oude postkantoor?\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09487dd3-d180-46f4-af7a-5267f3c9f3d6",
                        "source_entry_id": "98c91a3d-0f72-333c-9614-95cbc3809860",
                        "source_sense_id": "4b0d7fc4-73c2-309b-b3ca-917bb8900300",
                        "target_lang_word": "neglect",
