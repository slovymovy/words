                        "source_sense_id": "92d6a6d4-2a60-3231-b938-cc99821718d7",
                        "source_sense_description": "het geleiden van damp of uitwaseming van warme geneesmiddelen naar een ziekelijk deel des lichaams voor inhalatie, huidreiniging",
                        "target_lang_word": "Inhalation",
