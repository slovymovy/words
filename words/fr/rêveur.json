    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46fe3934-3a74-3caf-b5fc-212d8fae092a",
                    "sense_definition": "Qui est enclin à la rêverie ou dont l'esprit est absorbé par des pensées lointaines.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est resté <w>rêveur</w> pendant toute la leçon, regardant par la fenêtre sans écouter le professeur."
                        },
                        {
                            "text": "Pourquoi es-tu si <w>rêveur</w> ce matin, as-tu des soucis en tête ?"
                        }
                    ],
                    "synonyms": [
                        "pensif",
                        "songeur",
                        "méditatif"
                    ],
                    "antonyms": [
                        "attentif",
                        "pragmatique",
                        "réaliste"
                    ],
                    "common_phrases": [
                        "rester rêveur",
                        "d'un naturel rêveur"
                    ]
                },
                {
                    "sense_id": "ea182ebc-1312-3552-8cba-ccd1ea88f721",
                    "sense_definition": "Qui exprime ou manifeste un état de rêverie ou d'abandon aux pensées.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il contemplait le coucher de soleil avec un regard <w>rêveur</w> empreint de nostalgie."
                        },
                        {
                            "text": "Elle affichait un air <w>rêveur</w> en repensant aux vacances qu'elle venait de passer au bord de la mer."
                        }
                    ],
                    "synonyms": [
                        "pensif",
                        "songeur"
                    ],
                    "common_phrases": [
                        "un air rêveur",
                        "un regard rêveur",
                        "un sourire rêveur"
                    ]
                },
                {
                    "sense_id": "36e0d55d-dd85-3adb-8b30-540fd582bd56",
                    "sense_definition": "Qui évoque ou inspire la rêverie, la contemplation poétique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "evocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pianiste jouait une mélodie <w>rêveuse</w> qui invitait le public au voyage intérieur."
                        },
                        {
                            "text": "Le tableau baignait dans une atmosphère <w>rêveuse</w> et mystérieuse."
                        }
                    ],
                    "synonyms": [
                        "poétique"
                    ],
                    "common_phrases": [
                        "une mélodie rêveuse",
                        "une atmosphère rêveuse"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83698048-17c3-3dfe-b6bb-ff7f1a5f93ea",
                    "sense_definition": "Personne portée à la rêverie, qui vit volontiers dans l'imaginaire ou poursuit des idéaux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un grand <w>rêveur</w> qui préfère imaginer des mondes idéaux plutôt que de se confronter à la réalité."
                        },
                        {
                            "text": "On le traitait souvent de doux <w>rêveur</w>, mais ses idées finirent par convaincre toute la communauté."
                        }
                    ],
                    "synonyms": [
                        "idéaliste",
                        "utopiste",
                        "songeur"
                    ],
                    "antonyms": [
                        "réaliste",
                        "pragmatique"
                    ],
                    "common_phrases": [
                        "un grand rêveur",
                        "un doux rêveur"
                    ]
                }
            ]
        }
    ]
}