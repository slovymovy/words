                        "source_sense_id": "7d51d950-913d-3d20-9c3b-76920cf9694c",
                        "source_sense_description": "Medizin, Anatomie: Eingang eines Hohlorgans des Körpers (insbesondere der Scheideneingang)",
                        "target_lang_word": "orifice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orifice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                                        "entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
                                        "glosses": [
                                            "Ouverture qui forme l’entrée de certaines excavations naturelles ou artificielles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a12a46-ab90-4a29-ab7c-59f38fa5af0e",
                                                "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                                                "text": "Les couches supérieures étant tout-à-fait meubles, il eût fallu un orifice très large à cette excavation pour que les éboulements ne la bouchassent pas en même temps qu'on la creusait."
                                            },
                                            {
                                                "example_id": "40b1e9ec-0c1b-4e56-b509-dde00fb1f120",
                                                "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                                                "text": "Après un tel paroxysme, l’éboulement des côtés du cratère obstrue encore plus l’orifice du volcan, et l’oblitère entièrement. On peut alors procéder à des observations […]."
                                            },
                                            {
                                                "example_id": "5245eb66-28c8-4429-810a-0abb54b1a84f",
                                                "sense_id": "1f0a473a-066c-33d7-9378-decba902855f",
                                                "text": "Ce tunnel a son orifice inférieur à Modane, au nord, et l’orifice supérieur à Bardonnèche, au sud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                                        "entry_id": "2223fcac-6c46-37d6-b443-d318f4207b01",
                                        "glosses": [
                                            "Ouverture plus ou moins étroite qui sert d’entrée ou d’issue à certains organes, à certains appareils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17619709-24f5-4112-9158-eb5af7efbb59",
                                                "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                                                "text": "Les orifices de l’estomac."
                                            },
                                            {
                                                "example_id": "d5be4df7-21f1-480c-ac09-10fa4cb0f4b7",
                                                "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                                                "text": "L’orifice d’un tuyau."
                                            },
                                            {
                                                "example_id": "0036f5ad-6e7b-4004-94a2-6107b11ce1c3",
                                                "sense_id": "ed8ffcfc-5d61-3dad-b082-71b157187cb9",
                                                "text": "L’orifice d’une cornue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
