                                "sense_id": "65fecbfd-b431-3f99-8524-7d79f7c0297a",
                                "text": "De onderkoelde slachtoffers kregen direct een isolerende deken om zich heen."
                            },
                            {
                                "example_id": "abc10600-217f-46e6-ace3-2adb6fd0472c",
                                "sense_id": "65fecbfd-b431-3f99-8524-7d79f7c0297a",
                                "text": "Oververhitting, onderkoeling, blikseminslag, poema’s en het oversteken van rivieren vormen een veel reëler gevaar."
                            }
                        ]
                    }
