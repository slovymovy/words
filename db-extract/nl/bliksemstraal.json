                "senses": [
                    {
                        "sense_id": "b7541ec9-b35f-326f-9699-2dc8b3d17a75",
                        "entry_id": "b13d32a7-dd9c-3f82-aad3-f5529994c252",
                        "glosses": [
                            "een straal van de bliksem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3481e9c2-12d3-440a-858d-1e0cde7ef0d5",
                                "sense_id": "b7541ec9-b35f-326f-9699-2dc8b3d17a75",
                                "text": "Hierdoor schiet er direct een bliksemstraal uit de hemel die de vogelmannen bijna verzengt."
                            },
                            {
                                "example_id": "c81a0b40-cb14-4e4e-9603-45b85b7d3e6d",
                                "sense_id": "b7541ec9-b35f-326f-9699-2dc8b3d17a75",
                                "text": "De bliksemschicht bevat een enorme hoeveelheid energie waarbij heel veel warmte vrijkomt. De binnenkant van de bliksemstraal kan volgens Weerplaza wel 33.000 graden zijn. Ter vergelijking: de oppervlakte van de zon is ongeveer 5.500 graden. De hitte zorgt ervoor dat de lucht rondom de bliksemschicht uitzet waardoor een schokgolf ontstaat in de lucht. En dat horen wij als de donder."
                            }
                        ]
                    },
