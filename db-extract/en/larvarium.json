                            {
                                "example_id": "39ec9d02-fe2a-47cc-a58f-2573f660fba9",
                                "sense_id": "b55bb2ea-1c6f-376d-b0c6-54bd72209a56",
                                "text": "Such a range of shelving, facing north, forms an excellent larvarium; the winds will blow about your larvæ and they will be reared in a state which closely approaches the natural one."
                            },
                            {
                                "example_id": "6fbf0ccf-9569-4d85-b12c-54e6c0c5416b",
                                "sense_id": "b55bb2ea-1c6f-376d-b0c6-54bd72209a56",
                                "text": "At the end of his so remote, so near, 1884 summer Van, before leaving Ardis, was to make a visit of adieu to Ada's larvarium."
                            }
                        ]
