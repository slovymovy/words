                "translations": [
                    {
                        "translation_id": "fd638758-fd9d-4988-b64b-d63203707981",
                        "source_entry_id": "079d249c-b777-3e18-ab72-1bfe78d9b8ac",
                        "source_sense_id": "efa1c3bf-45a2-3d60-be78-732ec4a5f74c",
                        "target_lang_word": "phallic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phallic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73a9c4a7-c946-32b0-91e6-f4f5e5c6c3a4",
                                        "entry_id": "2ac5f55c-d2dd-3ea2-a295-d9cd94240fe7",
                                        "glosses": [
                                            "Relating to, or characteristic of the penis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af1d8083-449b-4a8c-b947-af10f11db6af",
                                                "sense_id": "73a9c4a7-c946-32b0-91e6-f4f5e5c6c3a4",
                                                "text": "A little later the phallic explanation of everything came into fashion. The deities were all polite names for the organs and powers of procreation."
                                            },
                                            {
                                                "example_id": "0dc8c6e0-bd6a-4083-ba13-b4911c85486d",
                                                "sense_id": "73a9c4a7-c946-32b0-91e6-f4f5e5c6c3a4",
                                                "text": "The natural rhythm of the male is a phallic one of rise and fall, whether it involves towers, stock markets, or whole civilizations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdac9d48-0230-3df5-bca8-b44beba6c47e",
                                        "entry_id": "2ac5f55c-d2dd-3ea2-a295-d9cd94240fe7",
                                        "glosses": [
                                            "Shaped like an erect human penis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6b690b-9ae4-442c-986e-f5d7b1e585b7",
                                                "sense_id": "bdac9d48-0230-3df5-bca8-b44beba6c47e",
                                                "text": "My mother has a very phallic salt shaker."
                                            },
                                            {
                                                "example_id": "8f0ec6eb-c269-4837-87b7-bce1a5d633f9",
                                                "sense_id": "bdac9d48-0230-3df5-bca8-b44beba6c47e",
                                                "text": "For many first-time visitors, a common initial impression of the Washington Monument is that it is incredibly phallic."
                                            },
                                            {
                                                "example_id": "308727c9-0fe9-4b4f-8de1-0c5f460f9502",
                                                "sense_id": "bdac9d48-0230-3df5-bca8-b44beba6c47e",
                                                "text": "The incinerator and a big smoke stack / It's a phallic symbol and it makes me laugh"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c437cc5e-5a92-3c79-aa25-4a8355a1f33c",
                                        "entry_id": "2ac5f55c-d2dd-3ea2-a295-d9cd94240fe7",
                                        "glosses": [
                                            "Relating to or exhibiting masculine or patriarchal traits, seen metaphorically as seated in the male genitalia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af0aa83-c05f-4471-b851-913fed312369",
                                                "sense_id": "c437cc5e-5a92-3c79-aa25-4a8355a1f33c",
                                                "text": "Opposing the war in El Salvador and opposing the phallic aggression everywhere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
