                                "target_senses": [
                                    {
                                        "sense_id": "20331dce-fc4c-3952-a81f-48f38abf51fe",
                                        "entry_id": "977880fe-7e22-362b-8f69-b7e6b9836321",
                                        "glosses": [
                                            "город на северо-западе России, административный центр Мурманской области; крупнейший в мире город, расположенный за Северным полярным кругом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5076ecd-b04a-4b94-9599-ac1b57956d8a",
                                                "sense_id": "20331dce-fc4c-3952-a81f-48f38abf51fe",
                                                "text": "Мурманск — столица Заполярья."
                                            },
                                            {
                                                "example_id": "f4f8916f-52a6-4da1-95e3-fb67847c6f6a",
                                                "sense_id": "20331dce-fc4c-3952-a81f-48f38abf51fe",
                                                "text": "В Мурманске особенно чувствуешь широту размаха государственного строительства."
                                            },
                                            {
                                                "example_id": "b3c0804d-ec3c-418c-9e9d-d9cdabac7c82",
                                                "sense_id": "20331dce-fc4c-3952-a81f-48f38abf51fe",
                                                "text": "Мурманск, город мой широкоплечий…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6238ae-4a6f-31ac-83dc-c765ca915b95",
                                        "entry_id": "977880fe-7e22-362b-8f69-b7e6b9836321",
                                        "glosses": [
                                            "порт на Баренцевом море"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97fcc28-9af4-4bfb-a236-a74fc3f8e238",
                                                "sense_id": "bc6238ae-4a6f-31ac-83dc-c765ca915b95",
                                                "text": "Порт Мурманск является местом базирования ледоколов и вспомогательных судов атомного гражданского флота."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f8bcdde-8340-3f86-a6e6-569561e61f07",
                                        "entry_id": "977880fe-7e22-362b-8f69-b7e6b9836321",
                                        "glosses": [
                                            "международный аэропорт в России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68847955-54b5-4037-b6bf-11321d7c8e68",
                                                "sense_id": "1f8bcdde-8340-3f86-a6e6-569561e61f07",
                                                "text": "Статус международного обрёл аэропорт Мурманск."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b9cc52b-d772-3f14-9e03-8d0c191c3db3",
                                        "entry_id": "977880fe-7e22-362b-8f69-b7e6b9836321",
                                        "glosses": [
                                            "железнодорожная станция Октябрьской железной дороги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84df01f-9911-4ede-9fa9-98410ce41fcc",
                                                "sense_id": "5b9cc52b-d772-3f14-9e03-8d0c191c3db3",
                                                "text": "Ожесточенной бомбардировке подвергалась станция Мурманск."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc07acc-c962-32d3-b3e7-f76b69f0decd",
                                        "entry_id": "977880fe-7e22-362b-8f69-b7e6b9836321",
                                        "glosses": [
                                            "название нескольких кораблей и судов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "477e8723-33ff-4abd-83fe-50b9eaf7f1b0",
                                                "sense_id": "6cc07acc-c962-32d3-b3e7-f76b69f0decd",
                                                "text": "Крейсер «Мурманск» к началу Великой Отечественной войны не отличался особыми качествами среди судов-одноклассников, однако именно ему довелось войти в историю…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16e5c8a4-959c-3e2c-ac6b-03de8d2fb817",
                                        "entry_id": "977880fe-7e22-362b-8f69-b7e6b9836321",
                                        "glosses": [
                                            "астероид главного пояса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8341a16-c3d2-4a63-a772-d3be2b16d0cf",
                                                "sense_id": "16e5c8a4-959c-3e2c-ac6b-03de8d2fb817",
                                                "text": "В ледяной глубине пояса астероидов вертится по орбите вокруг Солнца небольшой астероид Мурманск."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e782450b-3dab-314b-9f9f-6db3e5913069",
                                        "entry_id": "977880fe-7e22-362b-8f69-b7e6b9836321",
                                        "glosses": [
                                            "горная вершина Памиро-Алая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa6c2486-706c-46e9-a3f9-9e9bfa425cee",
                                                "sense_id": "e782450b-3dab-314b-9f9f-6db3e5913069",
                                                "text": "Вершина высотой четыре с половиной тысячи километров в Фанских горах Памиро-Алая (Таджикистан) была названа Мурманском в 1985 году"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
