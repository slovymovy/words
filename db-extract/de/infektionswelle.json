                    {
                        "sense_id": "7c359f53-6449-339c-bd0c-fb08e6c6bea2",
                        "entry_id": "a46ed3da-636d-3ac7-9d5b-7724d068eedc",
                        "glosses": [
                            "ansteigende Zahl an Neuinfektionen bei einem (erneuten) Ausbruch einer Infektionskrankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7709347d-71bc-4f99-8a13-9ebefb5003fb",
                                "sense_id": "7c359f53-6449-339c-bd0c-fb08e6c6bea2",
                                "text": "„So erkrankten im Herbst 2012 mehr als 11 000 Kinder an Brechdurchfall – nach Angaben des Robert-Koch-Instituts (RKI) handelte es sich dabei um die bisher größte durch Lebensmittel ausgelöste Infektionswelle in der Bundesrepublik […].“"
                            },
                            {
                                "example_id": "adadaba6-ba0a-4115-a100-ef19371da451",
                                "sense_id": "7c359f53-6449-339c-bd0c-fb08e6c6bea2",
                                "text": "„Nachdem in Wuhan neue Coronafälle aufgetreten sind, könnte China eine weitere Infektionswelle bevorstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
