                "senses": [
                    {
                        "sense_id": "5e5e2d37-de14-37d0-b546-cc3b954dd24f",
                        "entry_id": "19cc4aea-6d84-30f8-95b1-528ec2e62789",
                        "glosses": [
                            "nach hier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01570a23-6a8f-48f8-b247-709606135c27",
                                "sense_id": "5e5e2d37-de14-37d0-b546-cc3b954dd24f",
                                "text": "Jetzt habe ich drei Jahre lang Deutsch gelernt, komme hierher und verstehe kein einziges Wort!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a25a8a7-7956-457b-a564-90990d8914fd",
                        "source_entry_id": "19cc4aea-6d84-30f8-95b1-528ec2e62789",
                        "source_sense_id": "5e5e2d37-de14-37d0-b546-cc3b954dd24f",
                        "source_sense_description": "nach hier",
                        "target_lang_word": "hither",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a33f1ab6-d278-3aa5-8cc6-ee697330f641",
                                        "entry_id": "149da2fb-cac2-347d-b920-b0ae025f129a",
                                        "glosses": [
                                            "To this place, to here."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf111bf-04fa-47d0-8bf3-b371251a8d83",
                                                "sense_id": "a33f1ab6-d278-3aa5-8cc6-ee697330f641",
                                                "text": "He went hither and thither."
                                            },
                                            {
                                                "example_id": "507b32f3-8cd2-46b0-9b2d-a420f2cac6f1",
                                                "sense_id": "a33f1ab6-d278-3aa5-8cc6-ee697330f641",
                                                "text": "SATURNINUS: Go fetch them hither to us presently.\nTITUS: Why, there they are, both baked in that pie,\nWhereof their mother daintily hath fed,\nEating the flesh that she herself hath bred."
                                            },
                                            {
                                                "example_id": "632cdec5-5e85-4840-8d5b-2ce3f46e3aec",
                                                "sense_id": "a33f1ab6-d278-3aa5-8cc6-ee697330f641",
                                                "text": "Unto her handmaid she cried,\n\"Go fetch my gold harp hither to me,\nSir Thynnè, I'll draw to my side.\""
                                            },
                                            {
                                                "example_id": "721e27b3-f01e-45ea-9d15-27a2c61376aa",
                                                "sense_id": "a33f1ab6-d278-3aa5-8cc6-ee697330f641",
                                                "text": "But the road left the river again; there were certainly twistings and turnings, as the old woman had said, for at one moment it wound hither and the next thither, and at some places it was almost imperceptible."
                                            },
                                            {
                                                "example_id": "4a26361d-2352-4646-9c46-341398dba18f",
                                                "sense_id": "a33f1ab6-d278-3aa5-8cc6-ee697330f641",
                                                "text": "\"How now, you scullions and cullions: bring hither a pair of cow's hooves to out face this contumelious caitiff.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf9db8b0-5242-3697-9501-bbcc116bd814",
                                        "entry_id": "149da2fb-cac2-347d-b920-b0ae025f129a",
                                        "glosses": [
                                            "over here"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f3c690-c263-359b-b64d-d64e677d3a32",
                                        "entry_id": "1326c370-9ddb-3e92-9595-292cb897f3a4",
                                        "glosses": [
                                            "On this side; the nearer."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62198ee5-f062-4691-bc4a-73640ba77741",
                                                "sense_id": "d8f3c690-c263-359b-b64d-d64e677d3a32",
                                                "text": "The essential Not-self could be perceived very clearly in things and in living creatures on the hither side of good and evil."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d00c555-cebc-3f4c-8a0e-5881911ee607",
                                        "entry_id": "0af76565-afc8-3fdd-a673-f65615a61ba5",
                                        "glosses": [
                                            "only used in the phrase hither and thither"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "416cd079-829c-4423-8538-a34d7f356460",
                        "source_entry_id": "19cc4aea-6d84-30f8-95b1-528ec2e62789",
                        "source_sense_id": "5e5e2d37-de14-37d0-b546-cc3b954dd24f",
                        "source_sense_description": "nach hier",
                        "target_lang_word": "par ici",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "par ici",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                        "entry_id": "007de66a-4fe9-3cec-8dc1-ef75dfa7e47d",
                                        "glosses": [
                                            "À l’endroit, ou autour de l’endroit où l’on est, ou que l’on désigne précisément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8a1cf6-4c04-4e61-84e8-32123fc1b86f",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "Ceux-là, les rouges, t’en trouveras des nuées par ici, ça pullule comme les mouches à merde sur une charogne."
                                            },
                                            {
                                                "example_id": "9f6f399c-67e0-4f9a-a124-21351653da85",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "Il y a une drôle de lumière par ici."
                                            },
                                            {
                                                "example_id": "36ba1820-06b5-409a-9a08-4bd8326a4717",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "Viens par ici tout de suite !"
                                            },
                                            {
                                                "example_id": "282914bd-5c30-486e-b451-fbaf1c27d386",
                                                "sense_id": "b7c9bd1d-653e-3768-bd53-6d9c2d9fc083",
                                                "text": "« Vous pouvez passer par ici. » dit-il en pointant du doigt la carte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "par ici",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a86e9892-2a0f-3e68-b4eb-0dfadf648780",
                                        "entry_id": "24d3655f-7d6a-3c75-9e13-741da87e67e3",
                                        "glosses": [
                                            "En passant par l’endroit où l’on est, ou par un lieu que l’on désigne précisément (sur une carte par exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7f9768-699d-4bf6-9eec-23a3b3dbf777",
                                                "sense_id": "a86e9892-2a0f-3e68-b4eb-0dfadf648780",
                                                "text": "Par où faut-il aller ? - Par ici !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb510cc2-983c-32e0-9ce8-238a2d5d34a9",
                                        "entry_id": "24d3655f-7d6a-3c75-9e13-741da87e67e3",
                                        "glosses": [
                                            "Ici. Permet de se signaler à une personne qui nous cherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9839afec-a6c2-4fdf-9e28-f4929e01acdb",
                                                "sense_id": "bb510cc2-983c-32e0-9ce8-238a2d5d34a9",
                                                "text": "Où êtes-vous ? - Par ici !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
