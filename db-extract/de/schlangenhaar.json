                "senses": [
                    {
                        "sense_id": "b63ffbb9-6afb-3b26-b7d3-00727d92696f",
                        "entry_id": "461780b5-fb4d-3a58-856e-95fc4fd7244e",
                        "glosses": [
                            "aus Schlangen bestehendes Haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6faf0569-4894-49ae-9c76-ab8b7cd80731",
                                "sense_id": "b63ffbb9-6afb-3b26-b7d3-00727d92696f",
                                "text": "„Auf dem Kopf und unterhalb des Rüssels waren die meisten Tentakel länger, dicker und spiralförmig gestreift. Sie erinnerten an die Schlangenhaare der Medusa.“"
                            },
                            {
                                "example_id": "7e2dd675-4140-4be4-a8ed-836da596a5a8",
                                "sense_id": "b63ffbb9-6afb-3b26-b7d3-00727d92696f",
                                "text": "„Seine Majestät griff […] selbst gern zum Spaten und erlebte, wie das Relief einer Gorgo zu Tage gefördert wurde – jenes mythologischen Monsters mit Schlangenhaar, das Sterbliche mit seinem Blick in Stein verwandeln konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
