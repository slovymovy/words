                                "target_senses": [
                                    {
                                        "sense_id": "1c697a42-923e-35f2-ae74-decf4f2997d8",
                                        "entry_id": "665a1b73-6f49-38ea-9964-e8abb12f382b",
                                        "glosses": [
                                            "nicht miteinander zu vereinbaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d066cf-7784-48dd-b798-a900fa0a8fce",
                                                "sense_id": "1c697a42-923e-35f2-ae74-decf4f2997d8",
                                                "text": "Das Seminar handelt davon, wie man mit inkompatiblen Gruppeninteressen umgehen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "142132a7-226d-306e-ba90-8689b761c13b",
                                        "entry_id": "665a1b73-6f49-38ea-9964-e8abb12f382b",
                                        "glosses": [
                                            "nicht zusammenpassend, so, dass diese Komponenten nicht zusammen funktionieren und das gewünschte Ergebnis zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f495fbb-fbd5-4958-8586-25390539d034",
                                                "sense_id": "142132a7-226d-306e-ba90-8689b761c13b",
                                                "text": "Durch diese Anpassungen wird die neue Version des Programms teilweise inkompatibel zu früheren Versionen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a487c009-6027-34bb-a744-716e8e36d893",
                                        "entry_id": "665a1b73-6f49-38ea-9964-e8abb12f382b",
                                        "glosses": [
                                            "so, dass die Blutgruppe (das Gewebe) eines Spenders nicht zum Empfängers passt; unverträglich miteinander"
                                        ],
                                        "tags": [
                                            "auch über Arzneimittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deeda5ce-34b7-4ffa-b5cd-ec4e5098b60f",
                                                "sense_id": "a487c009-6027-34bb-a744-716e8e36d893",
                                                "text": "Natriumbikarbonat ist mit Adrenalin inkompatibel. Beides kann also nicht in einer gemeinsamen Infusion zugeführt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e34ed4b1-5795-3291-9c2d-008096ff2796",
                                        "entry_id": "665a1b73-6f49-38ea-9964-e8abb12f382b",
                                        "glosses": [
                                            "so, dass diese zwei Ämter nicht gleichzeitig wahrgenommen werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1fb078-5ea0-4636-ba10-070bbdbce0bc",
                                                "sense_id": "e34ed4b1-5795-3291-9c2d-008096ff2796",
                                                "text": "Das Amt eines Bundesverfassungsrichters ist mit dem Amt eines Bundestagsabgeordneten inkompatibel."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
