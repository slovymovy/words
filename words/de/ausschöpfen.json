                    "frequency": "High",
                    "semantic_group_id": "nutzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir müssen alle Möglichkeiten <w>ausschöpfen</w>, um das wichtige Projekt noch rechtzeitig abzuschließen."
                        },
                        {
                            "text": "Das junge Unternehmen <w>schöpft</w> sein kreatives Potenzial voll <w>aus</w>, um sich am Markt durchzusetzen."
                        }
                    ],
                    "synonyms": [
