                        "glosses": [
                            "The visor of a helmet, especially when made in two parts."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6832933c-6300-4c3c-bff5-6981ea0cc575",
                                "sense_id": "8b38fa58-eec2-33ee-a245-f863d5871d9f",
                                "text": "The mesail face-defence, still consisting of the visor with its eye-slits and noseguard attached to the helmet by two pivots, could be raised or lowered at will, while the two shell-shaped cheek-pieces formed a bevor or chin [guard]."
                            },
                            {
                                "example_id": "b61ea8d8-a571-43ff-b7f1-7502a43e2be9",
                                "sense_id": "8b38fa58-eec2-33ee-a245-f863d5871d9f",
                                "text": "The workmanship is sound, but not fine—portions of a visor and a mesail and a chin-piece of the period of Elizabeth have been added to it."
                            }
                        ]
                    }
