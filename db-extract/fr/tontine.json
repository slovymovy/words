                                        "entry_id": "5a289386-2423-3945-b0f3-f7b7eeb1ae98",
                                        "glosses": [
                                            "regeling tussen samenwonenden partners die het eigendom van een goed vastlegt als een van de partners sterft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c8dc81d-6c6c-4bd7-939b-20a72db255a2",
                                                "sense_id": "8b1a8d77-c984-3958-9de0-8337c54eb972",
                                                "text": "Een tontineclausule werd vroeger vaak gebruikt tussen samenwonenden, gezien zij geen automatisch erfrecht hadden en de successierechten tussen hen ook erg hoog lagen (vroeger tarief vreemden tussen 45 en 65 %). Tussen gehuwden was een tontine minder nuttig omdat gehuwden sowieso aan lage tarieven konden erven (vanaf 3 % tot 27 %)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
