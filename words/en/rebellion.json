{
    "word_family": [
        "rebel",
        "rebellious",
        "rebelliously",
        "rebelliousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af44c42f-5d6d-3732-94e8-e8982ca49f5f",
                    "sense_definition": "Armed resistance to an established government or ruler.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "resistance_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is doing its best to stop <w>rebellion</w> in the country.",
                            "target_lang_translations": {
                                "ru": "Правительство делает всё возможное, чтобы остановить <w>восстание</w> в стране.",
                                "tr": "Hükümet, ülkedeki <w>isyanı</w> durdurmak için elinden geleni yapıyor."
                            }
                        },
                        {
                            "text": "The army general led a successful <w>rebellion</w> against the dictator.",
                            "target_lang_translations": {
                                "ru": "Армейский генерал возглавил успешный <w>мятеж</w> против диктатора.",
                                "tr": "Ordu generali diktatöre karşı başarılı bir <w>ayaklanmaya</w> liderlik etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "uprising",
                        "revolt",
                        "insurrection"
                    ],
                    "common_phrases": [
                        "armed rebellion",
                        "crush a rebellion",
                        "open rebellion",
                        "peasant rebellion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вооруженное сопротивление установленному правительству или правителю",
                        "tr": "Kurulu bir hükümete veya lidere karşı silahlı direnme veya kalkışma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстание",
                                "target_lang_sense_clarification": "массовое вооруженное выступление"
                            },
                            {
                                "target_lang_word": "мятеж",
                                "target_lang_sense_clarification": "вооруженное выступление против власти, часто военное"
                            },
                            {
                                "target_lang_word": "бунт",
                                "target_lang_sense_clarification": "стихийное восстание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "isyan",
                                "target_lang_sense_clarification": "silahlı veya kitlesel başkaldırı"
                            },
                            {
                                "target_lang_word": "ayaklanma",
                                "target_lang_sense_clarification": "düzene karşı toplu başkaldırı"
                            },
                            {
                                "target_lang_word": "başkaldırma",
                                "target_lang_sense_clarification": "otoriteye karşı direnme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b58814d-c75a-377e-a3b6-6fb7aa672c1f",
                    "sense_definition": "Defiance of authority or control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Having a tattoo was Mathilda's personal <w>rebellion</w> against her parents.",
                            "target_lang_translations": {
                                "ru": "Татуировка была личным <w>бунтом</w> Матильды против родителей.",
                                "tr": "Dövme yaptırmak Mathilda'nın ailesine karşı kişisel <w>başkaldırısıydı</w>."
                            }
                        },
                        {
                            "text": "Staying out late was a small act of <w>rebellion</w> for the teenager.",
                            "target_lang_translations": {
                                "ru": "Позднее возвращение домой было для подростка маленьким актом <w>неповиновения</w>.",
                                "tr": "Geç saatlere kadar dışarıda kalmak, genç için küçük bir <w>itaatsizlik</w> göstergesiydi."
                            }
                        }
                    ],
                    "antonyms": [
                        "obedience",
                        "submission"
                    ],
                    "common_phrases": [
                        "act of rebellion",
                        "teenage rebellion",
                        "personal rebellion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытое неповиновение авторитету или контролю",
                        "tr": "Otoriteye, kurala veya kontrole karşı gelme, boyun eğmeme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бунт",
                                "target_lang_sense_clarification": "выражение протеста или несогласия"
                            },
                            {
                                "target_lang_word": "неповиновение",
                                "target_lang_sense_clarification": "отказ подчиняться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "başkaldırı",
                                "target_lang_sense_clarification": "otoriteye veya kurallara meydan okuma"
                            },
                            {
                                "target_lang_word": "isyan",
                                "target_lang_sense_clarification": "kurallara veya baskıya karşı çıkma"
                            },
                            {
                                "target_lang_word": "itaatsizlik",
                                "target_lang_sense_clarification": "söz dinlememe, boyun eğmeme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}