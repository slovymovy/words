                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b0e16b0-51a6-4150-bead-2a49595e37a0",
                                                "sense_id": "3df5af03-1d46-3614-903e-34c127c88676",
                                                "text": "Every day, some sailor's wife, / The masters of some merchant, and the merchant, / Have just our theme of woe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec0c6290-6e5b-34da-92b8-740a13a9eac3",
                                        "entry_id": "f4281165-f6cc-3597-8c31-94eb4ff7ae86",
                                        "glosses": [
                                            "Someone who is noted for a stated type of activity or behaviour."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1c2bd2-717e-424f-9487-91d83f49d435",
                                                "sense_id": "ec0c6290-6e5b-34da-92b8-740a13a9eac3",
                                                "text": "He's some kind of speed merchant — he drives way too fast."
                                            },
                                            {
                                                "example_id": "35e52aaf-0a66-4070-b628-f0ffcec49fcc",
                                                "sense_id": "ec0c6290-6e5b-34da-92b8-740a13a9eac3",
                                                "text": "Goal merchant Smith scored twice again in the match against Mudchester Rovers."
                                            }
