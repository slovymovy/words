{
    "word_family": [
        "droopy",
        "droopiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b388451a-1423-3d69-b561-2d0945aa6385",
                    "sense_definition": "To hang downward or sag.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy flowers began to <w>droop</w> after the long, hot afternoon.",
                            "target_lang_translations": {
                                "ru": "Тяжелые цветы начали <w>поникать</w> после долгого жаркого дня."
                            }
                        },
                        {
                            "text": "The old fence started to <w>droop</w> because the wooden posts were rotting.",
                            "target_lang_translations": {
                                "ru": "Старый забор начал <w>провисать</w>, потому что деревянные столбы сгнили."
                            }
                        }
                    ],
                    "common_phrases": [
                        "droop downward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свисать или прогибаться под тяжестью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свисать",
                                "target_lang_sense_clarification": "спускаться вниз, висеть"
                            },
                            {
                                "target_lang_word": "провисать",
                                "target_lang_sense_clarification": "прогибаться под собственной тяжестью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "556e8d1a-92fd-3e0a-a494-d4d7365a478e",
                    "sense_definition": "To slowly become limp or bend gradually.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her eyelids began to <w>droop</w> as she struggled to stay awake during the lecture.",
                            "target_lang_translations": {
                                "ru": "Ее веки начали <w>опускаться</w>, пока она пыталась не заснуть во время лекции."
                            }
                        },
                        {
                            "text": "The plant will <w>droop</w> if you do not water it regularly.",
                            "target_lang_translations": {
                                "ru": "Растение <w>поникнет</w>, если вы не будете его регулярно поливать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eyelids droop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно становиться вялым, опускаться или наклоняться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поникнуть",
                                "target_lang_sense_clarification": "склониться, пригнуться (о растениях или частях тела)"
                            },
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "становиться ниже, клониться вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a6e1713-2243-3e8f-81db-b914ff99ac9e",
                    "sense_definition": "To lose energy, enthusiasm, or happiness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His spirits began to <w>droop</w> after receiving the disappointing news.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>падать духом</w> после получения разочаровывающих новостей."
                            }
                        },
                        {
                            "text": "The team's morale did not <w>droop</w> even when they were losing the game.",
                            "target_lang_translations": {
                                "ru": "Боевой дух команды не <w>упал</w>, даже когда они проигрывали игру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spirits droop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять энергию, энтузиазм или радость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать духом",
                                "target_lang_sense_clarification": "отчаиваться, приходить в уныние"
                            },
                            {
                                "target_lang_word": "унывать",
                                "target_lang_sense_clarification": "быть в подавленном настроении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9bf91ec-d118-3e57-8bd1-f32474ca9494",
                    "sense_definition": "A condition or posture of hanging downward.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a noticeable <w>droop</w> in his shoulders that showed he was tired.",
                            "target_lang_translations": {
                                "ru": "В его плечах было заметно <w>поникшее положение</w>, которое показывало, что он устал."
                            }
                        },
                        {
                            "text": "The <w>droop</w> of the branches made the tree look very sad.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>свисания</w> ветвей дерево выглядело очень грустным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "noticeable droop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или поза, при которой что-либо свисает или опущено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поникшее состояние",
                                "target_lang_sense_clarification": "внешний вид чего-то опущенного"
                            },
                            {
                                "target_lang_word": "провисание",
                                "target_lang_sense_clarification": "процесс или результат прогибания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}