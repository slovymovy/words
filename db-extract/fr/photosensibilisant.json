                        "entry_id": "85a6f984-1f28-3e5b-b0b7-16781e702e92",
                        "glosses": [
                            "Qui rend sensible à la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4d88b3c-3adc-4942-8787-5c7c5099fff5",
                                "sense_id": "9ded9ab9-e06c-3945-aeea-c98fb7c57254",
                                "text": "Dès cette époque on signale son action photosensibilisante, pouvoir partagé avec d'autres ombellifères, donnant lieu à ce que les médecins — peu intéressés par ce type d'allergie — appellent pudiquement dermite printanière."
                            },
                            {
                                "example_id": "43c23b59-fc6a-48ca-90af-ccfe8a5753fa",
                                "sense_id": "9ded9ab9-e06c-3945-aeea-c98fb7c57254",
                                "text": "L’aloe vera est, en outre, photosensibilisant."
                            },
                            {
                                "example_id": "79e7f317-861a-4b6c-aa74-b3b94b4d274a",
                                "sense_id": "9ded9ab9-e06c-3945-aeea-c98fb7c57254",
                                "text": "Le facteur soleil est à prendre en compte : certains actifs anti-âge sont photosensibilisants."
                            }
                        ]
                    }
                ],
