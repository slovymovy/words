                "senses": [
                    {
                        "sense_id": "c6e7e431-c6bb-3992-b082-725bb6ca379e",
                        "entry_id": "e5ce4bc5-54e8-323b-9fea-562de184d970",
                        "glosses": [
                            "Enlever le canon de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e8ac1b8-9949-4412-8d4a-2ee82443ea59",
                                "sense_id": "c6e7e431-c6bb-3992-b082-725bb6ca379e",
                                "text": "L'outil pour démonter la chambre flottante tu l'aurais pas eu : pour démonter la chambre il faut décanonner..."
                            },
                            {
                                "example_id": "bd3ec556-e205-46f6-912f-993dfbceedc4",
                                "sense_id": "c6e7e431-c6bb-3992-b082-725bb6ca379e",
                                "text": "A part faire décanonner par un armurier, quelqu'un a une idée?"
                            },
                            {
                                "example_id": "6647c6b3-9601-4c81-a62f-c1ad676ac8b7",
                                "sense_id": "c6e7e431-c6bb-3992-b082-725bb6ca379e",
                                "text": "Attention, pour retirer la hausse sur une TOZ 17, il faut décanonner !"
                            }
                        ]
                    },
                    {
                        "sense_id": "3adcaa25-e2a9-3546-b726-2ac4cddecf6d",
                        "entry_id": "e5ce4bc5-54e8-323b-9fea-562de184d970",
                        "glosses": [
                            "Supprimer les canons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "992dde2f-60c9-4a8b-9fb9-8f3ebf7a9f66",
                                "sense_id": "3adcaa25-e2a9-3546-b726-2ac4cddecf6d",
                                "text": "Le résultat est un message poignant, à l'image du refrain de leur chanson, Nous continuerons à vivre, dont le titre est celui de la veillée : « Construire le monde. Faire une ronde. Faire des nids pour les colombes. Démitrailler. Décanonner. Déguerrifier le monde. »"
                            }
                        ]
                    }
