                        "glosses": [
                            "The eating of raw food, especially raw flesh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b9b819-5b96-4a87-9027-33f3c3afb532",
                                "sense_id": "11cb4b4b-b1cf-3be9-a8cf-2e642c8d3733",
                                "text": "Omophagia, that’s it! Do you like that word? Take it away with you!"
                            },
                            {
                                "example_id": "8863ac41-f555-4a97-8f37-20ede525f946",
                                "sense_id": "11cb4b4b-b1cf-3be9-a8cf-2e642c8d3733",
                                "text": "Uncomfortably, I thought of the Bacchae: hooves and bloody ribs, scraps dangling from the fir trees. There was a word for it in Greek: omophagia."
                            }
                        ]
                    }
                ],
