                ],
                "senses": [
                    {
                        "sense_id": "6fd98654-0fed-3a86-8e7b-de19babe5db5",
                        "entry_id": "6a00bd01-1cbe-36fd-bc61-bdda6a3017a8",
                        "glosses": [
                            "Faire bouger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e04e17-bfbd-4a8a-823c-2861c2354d69",
                                "sense_id": "6fd98654-0fed-3a86-8e7b-de19babe5db5",
                                "text": "Le lendemain matin, en arrivant sur le site, Shana fut étonnée de trouver Pierre Lancarneau, accroupi devant la paroi, montrant aux trois jeunes de l’équipe une technique permettant de prélever un fragment sans mouvementer le reste des éléments."
                            }
                        ]
                    },
                    {
                        "sense_id": "af608f05-c234-326d-b102-ea5eeb84a3bb",
                        "entry_id": "6a00bd01-1cbe-36fd-bc61-bdda6a3017a8",
                        "glosses": [
                            "Bouger (la main)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b678c786-fe54-413f-9d71-481083866a4e",
                                "sense_id": "af608f05-c234-326d-b102-ea5eeb84a3bb",
                                "text": "Lorsqu'on polit une pierre et qu’il y reste des fils ou traits, il faut, en arrêtant doucement la roue, mouvementer la main de droite à gauche pour les faire disparaître."
                            }
                        ]
                    },
                    {
                        "sense_id": "c394a17b-cae0-34d2-bd80-5d267b017c99",
                        "entry_id": "6a00bd01-1cbe-36fd-bc61-bdda6a3017a8",
                        "glosses": [
                            "Se mouvementer, se donner du mouvement, un mouvement."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "79123145-59c3-4817-9310-5b8ae4ae0fd0",
                                "sense_id": "c394a17b-cae0-34d2-bd80-5d267b017c99",
                                "text": "La femme dont la jambe est déjà presque submergée se mouvemente bien."
                            },
                            {
                                "example_id": "ea1f4936-917d-46e5-8e41-5970e6618597",
                                "sense_id": "c394a17b-cae0-34d2-bd80-5d267b017c99",
                                "text": "La contrée se mouvementait de petites hauteurs boisées de sapins et de chênes, qui s’incurvaient en rives agrestes autour de lacs cristallins."
                            }
                        ]
                    }
                ],
