                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c5d88e-e7f5-41ac-a039-ee69df4bfaa1",
                                "sense_id": "b72719b6-f525-3a65-a773-49b768e7d583",
                                "text": "„Demnach soll der Mann eine Oberärztin im Streit attackiert haben.“"
                            },
                            {
                                "example_id": "f2302ec1-14a1-4c6e-8ae5-aa226436082d",
                                "sense_id": "b72719b6-f525-3a65-a773-49b768e7d583",
                                "text": "„Ein Tumor in solch einer Größe ist laut Irene Teichert von Lüttichau, Oberärztin an der Schwabinger Kinderklinik, eine Seltenheit und wäre vor fünf Jahren sicher nur schwer zu behandeln gewesen.“"
                            },
                            {
                                "example_id": "335ffb48-dab7-4b5b-ba81-b02647cc75b8",
                                "sense_id": "b72719b6-f525-3a65-a773-49b768e7d583",
                                "text": "„Bettina hat ihr Forschungsjahr in Bordurien beendet und ihre neue Stelle als Oberärztin bei Professor Doktor Pitter Pille angetreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
