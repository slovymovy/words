                        "examples": [
                            {
                                "example_id": "5172c018-3fd2-476f-8c7f-b8a1bef56b14",
                                "sense_id": "092beb26-9ffe-3171-8efa-9d565ce79049",
                                "text": "Господа́!\nОстанови́тесь!\nВы не ни́щие,\nвы не сме́ете проси́ть пода́чки!",
                                "translation": "Gentlemen!\nStop!\nYou’re not beggars,\nHow dare you beg for alms!",
                                "english": "Gentlemen!\nStop!\nYou’re not beggars,\nHow dare you beg for alms!"
                            }
                        ]
                    }
