                    "sense_definition": "Past participle of <w>break</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't believe you have <w>broke</w> another window playing baseball.",
