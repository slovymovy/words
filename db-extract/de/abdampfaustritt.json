                "senses": [
                    {
                        "sense_id": "fd974af0-29bd-3688-8c83-39d0a5203e5a",
                        "entry_id": "fc4ebca3-faa0-37bc-a164-d6ceceeda0bf",
                        "glosses": [
                            "Ventil oder Hahn, durch den Dampf abgelassen oder ausgestoßen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88f14656-19a3-4d4c-b6c3-28e6cd1128ab",
                                "sense_id": "fd974af0-29bd-3688-8c83-39d0a5203e5a",
                                "text": "„Hierbei machte sich am Abdampfaustritt ins Freie trotz gleichmässigster Einstellung der Steuerung ein ganz erheblich ungleichmässiger Dampfanspufl bemerkbar.“"
                            },
                            {
                                "example_id": "c423ddc7-2b37-40f0-9dad-841925f379c2",
                                "sense_id": "fd974af0-29bd-3688-8c83-39d0a5203e5a",
                                "text": "„Es kann dabei vorkommen, daß durch den Abdampfaustritt die schäumende Masse mit fortgerissen wird und so Substanzverluste entstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
