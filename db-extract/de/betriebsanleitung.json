                                    {
                                        "sense_id": "ac66ab9d-a957-3692-8b0a-10591fa557b1",
                                        "entry_id": "4223c50c-ab67-308f-b03f-4d9791d1e045",
                                        "glosses": [
                                            "Indications (souvent sous forme de petit livret) qui renseignent sur la manière d’utiliser un appareil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afe5e98-ea3e-4b09-abeb-48ca6da2de9d",
                                                "sense_id": "ac66ab9d-a957-3692-8b0a-10591fa557b1",
                                                "text": "J’abandonne ma peinture au regardeur. Je ne mets pas de mode d’emploi dessous, je ne mets pas de titre anecdotique comme le font souvent les peintres figuratifs qui sont dans la nécessité de le faire."
                                            },
                                            {
                                                "example_id": "a20b1833-768f-428d-b504-e7ee2017386a",
                                                "sense_id": "ac66ab9d-a957-3692-8b0a-10591fa557b1",
                                                "text": "Ben oui, on ne lit pas les modes d’emploi, hein."
                                            },
                                            {
                                                "example_id": "22d747e4-326a-4c48-be27-975820cd7ac0",
                                                "sense_id": "ac66ab9d-a957-3692-8b0a-10591fa557b1",
                                                "text": "Le mode d’emploi de cet ordinateur est incompréhensible."
                                            }
                                        ]
                                    }
                                ]
                            }
