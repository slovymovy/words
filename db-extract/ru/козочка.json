                        ]
                    },
                    {
                        "translation_id": "570cbf1b-dec0-4fb8-9452-3ae3216261de",
                        "source_entry_id": "f73dcb45-49f0-3313-82cd-81684ee727b8",
                        "source_sense_id": "3dfbd820-9bbd-3828-acb8-00c9f286227f",
                        "target_lang_word": "chevrette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevrette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8333c4b0-5dc6-336b-9b37-8533f7cd415d",
                                        "entry_id": "5aea9b9d-05c7-3a62-8ca1-b347676d8346",
                                        "glosses": [
                                            "Petite chèvre, chevreau femelle."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c07e401-cf06-4759-baad-9b39e05679b0",
                                                "sense_id": "8333c4b0-5dc6-336b-9b37-8533f7cd415d",
                                                "text": "Oui, j’ai vu les chevrettes de la montagne d’Occone ; j’ai entendu les propos des hommes rassasiés de jours ; mais la douceur des chevreaux et la sagesse des vieillards sont moins plaisantes et moins fortes que tes paroles."
                                            },
                                            {
                                                "example_id": "1864178b-2eaa-4975-9475-cd7c14bff881",
                                                "sense_id": "8333c4b0-5dc6-336b-9b37-8533f7cd415d",
                                                "text": "Ah ! la brave chevrette, comme elle y allait de bon cœur ! Plus de dix fois, je ne mens pas, Gringoire, elle força le loup à reculer pour reprendre haleine."
                                            },
                                            {
                                                "example_id": "96535521-d7e7-496b-9342-869f951b20b3",
                                                "sense_id": "8333c4b0-5dc6-336b-9b37-8533f7cd415d",
                                                "text": "Elle avait caressé les chevrettes sur le cou et le dos, mais, quand elle arriva au chevreau, elle lui pris la tête dans ses mains.\n– C’est toi le plus beau ! Tu as un petit museau d’amadou. Si tu étais à moi, je t’appellerais Amadou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e09e35a-0de3-30a7-8276-3d627fdb5d64",
                                        "entry_id": "5aea9b9d-05c7-3a62-8ca1-b347676d8346",
                                        "glosses": [
                                            "Femelle du chevreuil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce822830-b9a0-45ef-97f9-6f58ed08d9fe",
                                                "sense_id": "4e09e35a-0de3-30a7-8276-3d627fdb5d64",
                                                "text": "Il aimait aussi voir passer les chevrettes, derrière les cépées, et bondir les écureuils, la queue en l’air, au bout des pins..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7addd238-7b79-302f-bb4f-8219ff17043b",
                                        "entry_id": "5aea9b9d-05c7-3a62-8ca1-b347676d8346",
                                        "glosses": [
                                            "ou (Antilles françaises, Guyane, Océanie française, Vendée), , Nom vulgaire de la crevette (animal crustacé) ; on désigne également du nom de chevrettes d’autres petits arthropodes, notamment les gamarres (genre Gammarus spp.)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85c6f928-f213-4e17-a9af-ef190bf6fca8",
                                                "sense_id": "7addd238-7b79-302f-bb4f-8219ff17043b",
                                                "text": "Rousret. C'est le nom qu'on donne à Calais aux folles ou bouteux qui servent à prendre des chevrettes & des sauterelles."
                                            },
                                            {
                                                "example_id": "dee88c90-36c7-45e9-90de-b5761ef67712",
                                                "sense_id": "7addd238-7b79-302f-bb4f-8219ff17043b",
                                                "text": "Pendant ce temps, les jeunes filles promènent leurs filets en forme de poches dans les mares que la mer a laissées en se retirant, et récoltent la chevrette ou font prisonnier quelque homard, quel que crabe tourteau, quelque poisson de rivage attardé loin de sa retraite."
                                            },
                                            {
                                                "example_id": "44f34399-a19b-4438-867e-7a1e84efeb34",
                                                "sense_id": "7addd238-7b79-302f-bb4f-8219ff17043b",
                                                "text": "Sur leur passage, les crabes effarés se sauvent, s’embusquent, s’aplatissent, tendent leurs pinces, et les chevrettes transparentes se perdent dans la couleur de l’eau troublée."
                                            },
                                            {
                                                "example_id": "f55fa742-7aaa-4a2d-9262-d915c81a8a27",
                                                "sense_id": "7addd238-7b79-302f-bb4f-8219ff17043b",
                                                "text": "Et puis, tous les matins je vous porterai des chevrettes ou des homards, […]."
                                            },
                                            {
                                                "example_id": "c7555632-5a0f-49f8-b084-bda178d821b3",
                                                "sense_id": "7addd238-7b79-302f-bb4f-8219ff17043b",
                                                "text": "[…] j’apprenais à goûter l’exquise saveur des chevrettes d’eau douce enveloppées dans des feuilles d’hibiscus et rôties sur des pierres rougies au feu, un mets digne des dieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd6f820-27c6-3bfd-870e-07c035d372e0",
                                        "entry_id": "5aea9b9d-05c7-3a62-8ca1-b347676d8346",
                                        "glosses": [
                                            "Petit chenet sans branche, trépied."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "574be90f-51c9-3eaa-b10a-1088167b9a72",
                                        "entry_id": "5aea9b9d-05c7-3a62-8ca1-b347676d8346",
                                        "glosses": [
                                            "Petite machine pour soulever."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c2a7c05-b1da-488c-a330-480efb8d1997",
                                                "sense_id": "574be90f-51c9-3eaa-b10a-1088167b9a72",
                                                "text": "Les 4 Servans de l’affût s’y portent alors : ils ôtent la chevrette et la mettent sur le traîneau avec le reste des armemens ; […]."
                                            }
                                        ]
                                    },
                                    {
