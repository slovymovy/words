                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Harpyie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb48c4f0-b9ae-3a32-98e9-fb6093709733",
                                        "entry_id": "617728ca-25e0-31c6-a175-3c23b99abc81",
                                        "glosses": [
                                            "großer Greifvogel, der in den tropischen Regenwäldern Mittel- und Südamerikas lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9e3528-f6ca-43db-86d2-0ad803dae690",
                                                "sense_id": "bb48c4f0-b9ae-3a32-98e9-fb6093709733",
                                                "text": "Harpyien erbeuten und fressen auch ganze Faultiere und mittelgroße Affen."
                                            },
                                            {
                                                "example_id": "3844b7ec-7518-4cc7-828c-e7e1a5c99847",
                                                "sense_id": "bb48c4f0-b9ae-3a32-98e9-fb6093709733",
                                                "text": "Der Körperbau der Harpyie ermöglicht das Erjagen von Tieren in den dicht bewachsenen Baumkronen des Regenwaldes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c0bd1bf-aa03-3ff5-8733-f477dc8ef020",
                                        "entry_id": "617728ca-25e0-31c6-a175-3c23b99abc81",
                                        "glosses": [
                                            "Sturmdämon in Gestalt eines Vogels mit Frauenkopf in der griechischen Mythologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3524ee06-9130-434e-a2d7-5a5d67cf787b",
                                                "sense_id": "9c0bd1bf-aa03-3ff5-8733-f477dc8ef020",
                                                "text": "Die Harpyien wohnten in einer Höhle auf Kreta und mussten auf Geheiß des Zeus Seelen von Toten in den Tartarus tragen oder Leute töten, die seinen Zorn erregten."
                                            },
                                            {
                                                "example_id": "51f00191-aa27-4b6f-8e00-8425b1bb06ea",
                                                "sense_id": "9c0bd1bf-aa03-3ff5-8733-f477dc8ef020",
                                                "text": "„Ich ging dann in mein Zimmer, voll Ungeduld, den Brief dieser Harpyie zu lesen, die mich zum unglücklichsten aller Menschen gemacht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36200d49-dd07-4868-9fd9-3d7f0308a9cc",
