                "senses": [
                    {
                        "sense_id": "311577e0-556b-3795-abc3-ae27b723ce64",
                        "entry_id": "da4c0da2-94e8-3341-a7ad-8a24fc7d46ff",
                        "glosses": [
                            "Cracher."
                        ],
                        "tags": [
                            "Beaujolais",
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "d06c5482-1dcb-4bd0-975a-e1505f67f252",
                                "sense_id": "311577e0-556b-3795-abc3-ae27b723ce64",
                                "text": "L’mauvais œil va nous cramioter des bocons, sauf s’il a la gogotte !"
                            },
                            {
                                "example_id": "1d1f1df4-5a29-4e66-b61d-4653582ab72f",
                                "sense_id": "311577e0-556b-3795-abc3-ae27b723ce64",
                                "text": "J’imagine mal ma douce Lili cramioter pour un oui pour un non."
                            },
                            {
                                "example_id": "5b823be5-9a63-43c1-9dac-40a3ebdddaf8",
                                "sense_id": "311577e0-556b-3795-abc3-ae27b723ce64",
                                "text": "Les néologismes utilisés sont d’ailleurs plus « cramiotés » que prononcés, comme autant d’onomatopées : « il cragouille », « elle croustille » tous les jours, « il farfotte » le matin, « il carcaviole » la nuit, « elle commence à rampionner », il « craquotte au point de remettre » (sic)."
                            }
                        ]
                    }
