                                            {
                                                "example_id": "69848c97-0c2a-4857-8d8a-44ed51f09012",
                                                "sense_id": "89052c20-9334-34c9-977b-cb9c6ea027de",
                                                "text": "Une des quatre tendances comportementales, utile en management, est l’assertivité confiante."
                                            },
                                            {
                                                "example_id": "1672f810-7641-4838-87f2-813daf84b1a5",
                                                "sense_id": "89052c20-9334-34c9-977b-cb9c6ea027de",
                                                "text": "Il faut savoir dire « non » sans agressivité avec assertivité."
                                            },
