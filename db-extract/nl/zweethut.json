                "senses": [
                    {
                        "sense_id": "042429b3-85c7-3374-860f-8e3695656a30",
                        "entry_id": "b4590f2b-363d-3866-b33a-8e3505ebeb31",
                        "glosses": [
                            "een tent of hut waarin gezweet wordt door een of meerdere personen wanneer in de tent hete stenen liggen en de tent of hut is afgesloten, een werkingsprincipe waarop ook de sauna is gebaseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67093afc-2635-4de0-aaf2-127d4b52a90b",
                                "sense_id": "042429b3-85c7-3374-860f-8e3695656a30",
                                "text": "Vijf toeristen die een traditionele Maya-sauna in het noorden van Guatemala bezochten, zijn omgekomen door verstikking....Wellicht zijn ze door rookvorming gestikt. Waarom ze niet tijdig de zweethut konden ontvluchten, is voorlopig nog een raadsel. De politie sluit kwade opzet uit."
                            },
                            {
                                "example_id": "7c62fc06-e2c0-4cf9-829c-96bfa4750d2a",
                                "sense_id": "042429b3-85c7-3374-860f-8e3695656a30",
                                "text": "Er is een zweethut, waar de bezoeker ongeveer drie uur in kan gaan zitten. \"Om bevrijd te worden, alles los te laten en fris en fruitig de maatschappij aan te kunnen.\""
                            },
                            {
                                "example_id": "7b0fcc46-ec22-4e91-82ee-93e1fb99e3ca",
                                "sense_id": "042429b3-85c7-3374-860f-8e3695656a30",
                                "text": "De reporters van Newsroom Enschede gaan deze zomer elke dag op pad met Enschedeërs met een bijzondere hobby, baan of lifestyle. Vandaag gingen we langs bij Stan Raateland. Hij is elke maand te vinden in een Enschedese zweethut."
                            }
                        ]
                    }
