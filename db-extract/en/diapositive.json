                                            {
                                                "example_id": "9e298fcb-f642-4648-a0cb-17c20ccb5b86",
                                                "sense_id": "536742f2-344f-3519-981e-53e2f5306d96",
                                                "text": "Heute zeigen uns unsere Nachbarn ihre Dias vom letzten Urlaub."
                                            },
                                            {
                                                "example_id": "90433c84-d46f-474a-8870-283b8574adb6",
                                                "sense_id": "536742f2-344f-3519-981e-53e2f5306d96",
                                                "text": "„Da hockt der Papa, nur weil es ihm im Keller und im Garten zu kalt geworden ist, halb krank in seinem Zimmer, studiert Sprachen, fertigt vergleichende Lauttabellen an, legt Reiseziele mit Grünen Führern fest, rahmt Dias vom letzten Urlaub, beantwortet ausländische Briefe.“"
                                            },
                                            {
                                                "example_id": "94d28f85-fb9d-4a22-9d7e-8e5efd7fbf35",
                                                "sense_id": "536742f2-344f-3519-981e-53e2f5306d96",
                                                "text": "„Auf dem Boden, unter einer Schicht aus Kleidern, lag eine Serie von Dias in weißen Plastikschalen, jedes Diafoto in einem eigenen Rahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
