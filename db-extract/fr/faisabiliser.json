                "senses": [
                    {
                        "sense_id": "77a1f551-e782-3a3d-8b3e-0d1bbcaf709a",
                        "entry_id": "e8ec6704-4ae3-3a65-ac9e-777a42a41900",
                        "glosses": [
                            "Rendre faisable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b96369-f0e3-4cc8-b68c-21ea8421d421",
                                "sense_id": "77a1f551-e782-3a3d-8b3e-0d1bbcaf709a",
                                "text": "Notre rôle, comme celui de toute la communauté pour les droits de l’homme et internationale, est de rappeler la responsabilité des gouvernements à assurer des solutions durables et, si possible, à faisabiliser leur retour au pays."
                            },
                            {
                                "example_id": "06d12ecb-2523-4948-b397-d85ddca7a5fd",
                                "sense_id": "77a1f551-e782-3a3d-8b3e-0d1bbcaf709a",
                                "text": "Tu demande ^([sic : demandes]) si la première grande puissance mondiale a la possibilité de faisabiliser un tel projet ?"
                            },
                            {
                                "example_id": "325dafa7-3ef4-4f7e-906a-629a968f1224",
                                "sense_id": "77a1f551-e782-3a3d-8b3e-0d1bbcaf709a",
                                "text": "[…] la chose sera analysée, numérisée, faisabilisée, wypointisée ^([sic : waypointisée]) …"
                            }
                        ]
                    }
