        "fr-extract.jsonl": [
            {
                "entry_id": "6cfb0600-5411-36e5-ba2b-913315105879",
                "word": "audacieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
                        "entry_id": "6cfb0600-5411-36e5-ba2b-913315105879",
                        "glosses": [
                            "D’une manière audacieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66646602-b426-4cb2-99b7-e5de3942c484",
                                "sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
                                "text": "Toutefois, il est prudent, dans une halte, de ne point s’abandonner au dolce farniente d’une manière trop absolue, crainte de voir le gibier assister audacieusement à vos reposailles."
                            },
                            {
                                "example_id": "622cb091-ce55-40a1-b0f1-4ae19476f731",
                                "sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
                                "text": "Jamais homme ne tira tant parti d’une blessure ; je disais de lui qu’il boitait audacieusement, et il était vrai."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f33881d-1522-4b1f-ba24-32bb73167197",
                        "source_entry_id": "6cfb0600-5411-36e5-ba2b-913315105879",
                        "source_sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
                        "target_lang_word": "audaciously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audaciously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d40522-272a-35b6-99fd-46b552fd5c1b",
                                        "entry_id": "519b8357-2c12-3831-a040-169338e3e9a0",
                                        "glosses": [
                                            "In an audacious manner; bravely, daringly, but not foolheartedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e907b6-d6c8-421e-9d93-7f6993148160",
                                                "sense_id": "a0d40522-272a-35b6-99fd-46b552fd5c1b",
                                                "text": "In short, all those whom the gentry had despised, those whom they had trodden into the dirt, people with no place in society, people with no right to speak, have now audaciously lifted up their heads. They have not only lifted up their heads but taken power into their hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd114b21-8177-3944-98e5-db083ae2d0cd",
                                        "entry_id": "519b8357-2c12-3831-a040-169338e3e9a0",
                                        "glosses": [
                                            "In a brazen, forthright manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e68d87e3-e71d-45c8-9d13-24ffd1e2a3e9",
                        "source_entry_id": "6cfb0600-5411-36e5-ba2b-913315105879",
                        "source_sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
                        "target_lang_word": "boldly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boldly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea4fcc74-d4df-327e-b70c-2b78d44ae983",
                                        "entry_id": "f93bdf2b-7686-3623-8aa7-409aff5a5994",
                                        "glosses": [
                                            "In a bold manner; with confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f7eecee-6590-4149-a4fb-0bf8bdb77431",
                                                "sense_id": "ea4fcc74-d4df-327e-b70c-2b78d44ae983",
                                                "text": "to boldly go where no man has gone before"
                                            },
                                            {
                                                "example_id": "32f81e02-e526-489a-975a-d332a2b47afc",
                                                "sense_id": "ea4fcc74-d4df-327e-b70c-2b78d44ae983",
                                                "text": "Postcards that are billboardlike communications with an immediate message stated boldly and creatively."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "719956d4-ed38-4bc1-871e-b4ad55ac0e8c",
                        "source_entry_id": "6cfb0600-5411-36e5-ba2b-913315105879",
                        "source_sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
                        "target_lang_word": "bravely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bravely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                        "entry_id": "af06285a-389f-31a9-a47e-ded0c213034c",
                                        "glosses": [
                                            "In a brave manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc15363-cf0b-490e-9b66-4929950541cb",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "The soldiers faced the enemy bravely."
                                            },
                                            {
                                                "example_id": "fe6194dc-737b-4d12-a115-6f3f4028bb1c",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "Here, here, here's an excellent place; here we may see most bravely: I'll tell you them all by their names as they pass by; but mark Troilus above the rest."
                                            },
                                            {
                                                "example_id": "ba74d131-0fac-4ca7-845c-9e79c2c2bcc1",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "No, they hold there a large, round wad of tow and cork, enveloped in the thickest and toughest of ox-hide. That bravely and uninjured takes the jam which would have snapped all their oaken handspikes and iron crow-bars."
                                            },
                                            {
                                                "example_id": "f5033be6-a1ea-429a-93d6-1797fcd465a4",
                                                "sense_id": "4bc217df-cff6-3b83-a0cf-19a6a1cbec6c",
                                                "text": "[H]e stepped forward and said bravely, though his hand trembled, and his face was as pale as snow:—\n“My true friend, from the bottom of my broken heart I thank you. Tell me what I am to do, and I shall not falter!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eecbd101-a773-4620-ae51-56903dcf6d2c",
                        "source_entry_id": "6cfb0600-5411-36e5-ba2b-913315105879",
                        "source_sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
                        "target_lang_word": "daringly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daringly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4bb9154-0c77-3869-bd1f-85c3bd1e16a5",
                                        "entry_id": "69c9b57e-85d7-3665-af90-fa2ab5f0e960",
                                        "glosses": [
                                            "In a daring manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17be22bd-d819-4028-9391-9812727d4008",
                                                "sense_id": "c4bb9154-0c77-3869-bd1f-85c3bd1e16a5",
                                                "text": "“Here, waiter,” cried the Johnnie who had dejeunered daringly at 12, “take this bill to the manager and tell him it’s an imposition. Why, you’ve charged more for one poached egg on toast than for an entire portion of those eggs that you scramble.”"
                                            },
                                            {
                                                "example_id": "dc71c607-4840-4b5f-bf6d-c4133fdea58f",
                                                "sense_id": "c4bb9154-0c77-3869-bd1f-85c3bd1e16a5",
                                                "text": "The corridor stinks of sweat and cigarette smoke, and I daringly open the window a little. The freshest air floats in, smelling of sappy grasses, the delicate pollens of wild flowers, the resins of the pine forests; hinting at the chill blue scent of distant snows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ccfef5a-74b5-47cc-bc8b-9f312f69470f",
                        "source_entry_id": "6cfb0600-5411-36e5-ba2b-913315105879",
                        "source_sense_id": "f9abd5e4-e55b-3815-bcb1-f461477794af",
