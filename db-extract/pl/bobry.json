                                    {
                                        "sense_id": "1c8c01c6-0289-37f8-81aa-96c7f397a37e",
                                        "entry_id": "ec8947eb-f228-3c11-8820-f3ec940ab217",
                                        "glosses": [
                                            "προϊόν από γούνα κάστορα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c59baf1-02d7-4aa5-bd3b-e78297285ae9",
                                                "sense_id": "1c8c01c6-0289-37f8-81aa-96c7f397a37e",
                                                "text": "Αγόρασα μια τσάντα καστόρι ασορτί με τα παπούτσια."
                                            },
                                            {
                                                "example_id": "310ae3ef-4029-4958-ae62-b9b6dc4ee075",
                                                "sense_id": "1c8c01c6-0289-37f8-81aa-96c7f397a37e",
                                                "text": "※ 1892 Αλεξάνδρα Παππαδοπούλου. Η καλή μοίρα. Εστία, 32, 1892, σελ.81-82 @books.google",
                                                "translation": "[γλώσσα καθαρεύουσα] Ἦτο κτενισμένη à la Chinoise, εἶχεν ὀσφὺν λεπτοτάτην, ἐσθῆτα σκιεροῦ χρώματος μὲ πασμαντερί· ὑποδηματάκια ἀπὸ λεπτότατον δέρμα· μαύρας μεταξίνας περικνημίδας, χειρόκτια σύμφωνα μὲ τὸ χρῶμα τῆς ἐσθῆτός της, ἕνα πῖλον ἀπὸ μαλλὶ καστόρι μ' ἕνα μεγάλο πτερὸν ἀμαζόνειον καὶ ἕνα ἐπανωφόρι rotonde ἀπό pluche […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "καστόρι",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab5b63a-3424-3bce-9713-00b885ef0164",
                                        "entry_id": "d58a8536-28f1-35d2-ace6-2ff6e611d337",
                                        "glosses": [
                                            "δέρμα από κάστορα ή από άλλο ζώο που του μοιάζει σε υφή"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44707d64-f089-47a3-a804-9b9c8297c4e6",
                                                "sense_id": "9ab5b63a-3424-3bce-9713-00b885ef0164",
                                                "text": "※ 19ος/20ός αιώνας ⌘ Γεώργιος Σουρής, 1853‑1919 Ο Φασουλής φιλόσοφος, Μέρος Γ'",
                                                "translation": "Κατάρα σ' ὅ,τι κάλυμμα ἡ κεφαλὴ φορέσῃ,\nψηλὸ καπέλο ψάθινο, καστόρι, σκούφια, φέσι,\nκι' εἰς ὅ,τι τὰ ποδάρια μας κοσμεῖ καὶ περιβάλλει,\nπαντοῦφλα, καραμάντουλο, τσαροῦχι καὶ στιβάλι."
                                            },
                                            {
                                                "example_id": "ba76b781-7857-4bf4-8371-c09404c3ced2",
                                                "sense_id": "9ab5b63a-3424-3bce-9713-00b885ef0164",
                                                "text": "※ «...Αλλά τα άλλα; Και πού είναι τα κομψά γυναικεία καπέλα;» μου είπε η μαμά. «Για τις γυναίκες έχουμε μόνο πλεκτούς σκούφους και αυτά εδώ από καστόρι» μας εξήγησε ο ευγενικός υπάλληλος του μαγαζιού",
                                                "translation": "Ελένη Τορόση, Όταν σου έδειξα τον ήχο του κόσμου, εκδ. Πατάκη, 2017"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
