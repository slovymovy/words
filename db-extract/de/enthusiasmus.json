                        "form": "den Enthusiasmus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee89630d-e0f5-34e7-9496-9a156751d70f",
                        "entry_id": "6d5d32dd-5a13-3f82-bd29-87ab6b25fa15",
                        "glosses": [
                            "empfundene Begeisterung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48819088-8727-4efc-b203-55314cb471a7",
                                "sense_id": "ee89630d-e0f5-34e7-9496-9a156751d70f",
                                "text": "Für seinen Beruf bringt er viel Enthusiasmus mit."
                            },
                            {
                                "example_id": "9a6660af-4893-428c-88ff-41104abd58b2",
                                "sense_id": "ee89630d-e0f5-34e7-9496-9a156751d70f",
                                "text": "„Doch Gelberg imponierte ihm mit seinem Enthusiasmus und großen Engagement.“"
                            },
                            {
                                "example_id": "4df67a02-1179-453e-aaf2-ac4711fd80c1",
                                "sense_id": "ee89630d-e0f5-34e7-9496-9a156751d70f",
                                "text": "„Letztlich mußte ich mich für eine Seite entscheiden, und so wurde ich schrittweise, begleitet von einer Art ernüchtertem Enthusiasmus, zum Positivisten und hörte damit sukzessive auf, Schopenhauerianer zu sein.“"
                            },
                            {
                                "example_id": "4cfa9880-a8c4-4b34-afd4-14e4c3938ebd",
                                "sense_id": "ee89630d-e0f5-34e7-9496-9a156751d70f",
                                "text": "„Er liebte den Enthusiasmus, der in allen diesen Mitarbeitern steckte, wodurch er sich erstmals auf einer übergeordneten Ebene mit Menschen verbunden fühlte, und er war froh und dankbar, dass er Damiels Überlegung gefolgt war.“"
                            },
                            {
                                "example_id": "70c65597-ec17-4b6a-8b52-6c666c613639",
                                "sense_id": "ee89630d-e0f5-34e7-9496-9a156751d70f",
                                "text": "„Es gab jedoch etwas, das meinen Enthusiasmus dämpfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f20989a3-a751-49dd-b363-95007f987bea",
