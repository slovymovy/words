                "senses": [
                    {
                        "sense_id": "f19ba5d1-6634-37ff-b726-d0745240a773",
                        "entry_id": "4708d9e3-9b2a-3f0d-9b07-f3897db7c7b3",
                        "glosses": [
                            "kleur hebbend tussen grijs en groen in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca458b6d-9c10-428e-9ad7-0b2f90d0dd20",
                                "sense_id": "f19ba5d1-6634-37ff-b726-d0745240a773",
                                "text": "Het bleke herfstlicht zorgde binnen voor een grijsgroen schijnsel."
                            },
                            {
                                "example_id": "e6f18030-0fa1-4a69-8be6-8d8bd1d20420",
                                "sense_id": "f19ba5d1-6634-37ff-b726-d0745240a773",
                                "text": "De berkenwants is een halve centimeter groot en is grijsgroen, groen of roodbruin. Zoals de naam al zegt zitten ze voornamelijk in berkenbomen. De wantsen hebben een zuigsnuit, waarmee ze sappen uit de vruchten van de berk zuigen."
                            }
                        ]
                    }
                ],
                "translations": [
