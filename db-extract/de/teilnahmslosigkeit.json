                        "examples": [
                            {
                                "example_id": "d2c4a5a1-adfc-4e7e-a84a-280a4f4d7199",
                                "sense_id": "e79f658e-c5d4-3b87-917e-2dc72798bee7",
                                "text": "„Die Teilnahmslosigkeit, die sie an den vergangenen Verhandlungstagen gezeigt hat, ist gewichen.“"
                            },
                            {
                                "example_id": "09954232-9296-4bfc-886f-c92e6d654114",
                                "sense_id": "e79f658e-c5d4-3b87-917e-2dc72798bee7",
                                "text": "„Was den guten Pfarrer aber an dem querköpfigen Knaben am meisten verdroß, war seine totale Teilnahmslosigkeit.“"
                            },
                            {
                                "example_id": "5556313c-9a31-42d2-8d4c-5b18ca63ac67",
                                "sense_id": "e79f658e-c5d4-3b87-917e-2dc72798bee7",
                                "text": "„Elma ließ sich von Ásas Teilnahmslosigkeit nicht irritieren und lächelte sie weiter an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
