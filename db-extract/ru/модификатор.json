                                        "sense_id": "1ddeb377-4005-3206-83a3-6153374ef266",
                                        "entry_id": "d252fd4a-0a9e-3389-b04c-601def0abf26",
                                        "glosses": [
                                            "Qui bloque ou favorise l’expression d’un autre objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f9a927-b8f0-4b56-b00e-a8e1efda0ff2",
                                                "sense_id": "1ddeb377-4005-3206-83a3-6153374ef266",
                                                "text": "Sur un clavier d'ordinateur, le modificateur de touche Majuscule (shift en anglais) permet aux autres touches de passer de minuscule en majuscule."
                                            },
                                            {
                                                "example_id": "b989f46b-0736-4a4b-a9c6-f42815488e87",
                                                "sense_id": "1ddeb377-4005-3206-83a3-6153374ef266",
                                                "text": "un gène modificateur."
                                            }
