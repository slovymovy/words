{
    "word_family": [
        "caver",
        "caving",
        "cavern",
        "cavernous",
        "cave-in"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5ddf951-d092-36a6-9132-71e501a44bdf",
                    "sense_definition": "A large, naturally-occurring cavity formed underground or in the face of a cliff or a hillside.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "natural_cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We found a <w>cave</w> on the mountainside where we could take shelter.",
                            "target_lang_translations": {
                                "ru": "Мы нашли на склоне горы <w>пещеру</w>, где смогли укрыться.",
                                "zh": "我们在山坡上发现了一个可以避雨的<w>洞穴</w>。"
                            }
                        },
                        {
                            "text": "The explorers entered the dark <w>cave</w> with their flashlights.",
                            "target_lang_translations": {
                                "ru": "Исследователи вошли в темную <w>пещеру</w> с фонариками.",
                                "zh": "探险家们拿着手电筒走进了黑暗的<w>洞穴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "earthhole"
                    ],
                    "common_phrases": [
                        "dark cave",
                        "deep cave",
                        "mountain cave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая естественная полость под землей или в склоне горы.",
                        "zh": "一种天然形成的地下或山崖上的大型空洞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пещера",
                                "target_lang_sense_clarification": "естественная полость"
                            },
                            {
                                "target_lang_word": "подземелье",
                                "target_lang_sense_clarification": "пространство под землей"
                            },
                            {
                                "target_lang_word": "грот",
                                "target_lang_sense_clarification": "неглубокая пещера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洞穴",
                                "target_lang_sense_clarification": "天然形成的地下空间"
                            },
                            {
                                "target_lang_word": "洞",
                                "target_lang_sense_clarification": "通用的空洞称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1644731b-4fbb-3642-8e45-6935a6f39f3d",
                    "sense_definition": "A place of retreat or a private room where one can escape from others.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retreat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My room was a cozy <w>cave</w> where I could escape from my family.",
                            "target_lang_translations": {
                                "ru": "Моя комната была уютным <w>убежищем</w>, где я мог скрыться от семьи.",
                                "zh": "我的房间是我可以躲避家人的舒适<w>避难所</w>。"
                            }
                        },
                        {
                            "text": "He spent the whole weekend in his man <w>cave</w> watching sports.",
                            "target_lang_translations": {
                                "ru": "Он провел все выходные в своей <w>берлоге</w>, смотря спортивные передачи.",
                                "zh": "他整个周末都待在自己的<w>私人空间</w>里看体育比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "man cave",
                        "cozy cave"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the context of a 'man cave'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место уединения или личная комната, где можно скрыться от окружающих.",
                        "zh": "指可以躲避他人、进行私人活动的隐秘空间或房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убежище",
                                "target_lang_sense_clarification": "место, где можно укрыться"
                            },
                            {
                                "target_lang_word": "логово",
                                "target_lang_sense_clarification": "переносное значение, личное место"
                            },
                            {
                                "target_lang_word": "берлога",
                                "target_lang_sense_clarification": "иронично о комнате или жилище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "避难所",
                                "target_lang_sense_clarification": "躲避外界干扰的地方"
                            },
                            {
                                "target_lang_word": "私人空间",
                                "target_lang_sense_clarification": "个人独处的房间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d97a07c-3977-3e82-94b6-03a66779ad15",
                    "sense_definition": "A storage cellar, especially for wine or cheese.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This wine has been aged in our <w>cave</w> for thirty years.",
                            "target_lang_translations": {
                                "ru": "Это вино выдерживалось в нашем <w>погребе</w> тридцать лет.",
                                "zh": "这款酒已经在我们的<w>酒窖</w>里陈酿了三十年。"
                            }
                        },
                        {
                            "text": "The cheese is kept in a cool <w>cave</w> to mature properly.",
                            "target_lang_translations": {
                                "ru": "Сыр хранят в прохладном <w>подвале</w>, чтобы он правильно созрел.",
                                "zh": "奶酪被存放在凉爽的<w>地窖</w>里以使其充分成熟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wine cave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Погреб для хранения, особенно вина или сыра.",
                        "zh": "用于储存物品（特别是酒或奶酪）的地下室或地窖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погреб",
                                "target_lang_sense_clarification": "для хранения продуктов"
                            },
                            {
                                "target_lang_word": "подвал",
                                "target_lang_sense_clarification": "нижний ярус здания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "地窖",
                                "target_lang_sense_clarification": "用于储存食物的地下室"
                            },
                            {
                                "target_lang_word": "酒窖",
                                "target_lang_sense_clarification": "专门储存酒的地下室"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50cc4368-14ef-34a8-be91-822f36784afe",
                    "sense_definition": "A group that breaks from a larger political party or faction on a particular issue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "political_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without joining the <w>cave</w>, the politician had abstained from the vote.",
                            "target_lang_translations": {
                                "ru": "Не присоединившись к <w>фракции</w>, политик воздержался от голосования.",
                                "zh": "由于没有加入那个<w>派系</w>，这位政治家在投票中弃权了。"
                            }
                        },
                        {
                            "text": "The party was split when a small <w>cave</w> formed to oppose the new law.",
                            "target_lang_translations": {
                                "ru": "Партия раскололась, когда образовалась небольшая <w>группировка</w> противников нового закона.",
                                "zh": "当一个反对新法律的<w>小团体</w>形成时，党内出现了分裂。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British political context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа, отколовшаяся от политической партии по определенному вопросу.",
                        "zh": "指从较大的政治团体中因特定议题而分裂出来的派系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фракция",
                                "target_lang_sense_clarification": "обособленная группа в партии"
                            },
                            {
                                "target_lang_word": "отколовшаяся группа",
                                "target_lang_sense_clarification": "политический контекст"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "派系",
                                "target_lang_sense_clarification": "政党内部的分裂团体"
                            },
                            {
                                "target_lang_word": "小团体",
                                "target_lang_sense_clarification": "从大组织中分离出的群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb542ed3-12f7-331c-a796-5cda960467ab",
                    "sense_definition": "A series of null bytes in an executable file that can be used to inject custom code.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once a code <w>cave</w> is created, you can execute it using thread injection.",
                            "target_lang_translations": {
                                "ru": "Как только <w>кодовая пещера</w> создана, вы можете выполнить её с помощью инъекции потока.",
                                "zh": "一旦创建了<w>代码空洞</w>，你就可以通过线程注入来执行它。"
                            }
                        },
                        {
                            "text": "The hacker looked for a <w>cave</w> in the binary to hide his script.",
                            "target_lang_translations": {
                                "ru": "Хакер искал <w>пустоту</w> в бинарном файле, чтобы спрятать свой скрипт.",
                                "zh": "黑客在二进制文件中寻找<w>代码空洞</w>以隐藏他的脚本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "code cave"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность пустых байтов в исполняемом файле для вставки кода.",
                        "zh": "计算机可执行文件中用于注入自定义代码的空字节序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кодовая пещера",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "пустота",
                                "target_lang_sense_clarification": "в контексте бинарного файла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "代码空洞",
                                "target_lang_sense_clarification": "技术术语，指二进制文件中的空白区域"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2e3ee17-bfc9-326f-b217-be760efb00f1",
                    "sense_definition": "To surrender or give in to pressure or demands.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surrender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>caved</w> under pressure and told them the secret.",
                            "target_lang_translations": {
                                "ru": "Он <w>сдался</w> под давлением и рассказал им секрет.",
                                "zh": "他在压力下<w>屈服</w>了，并告诉了他们那个秘密。"
                            }
                        },
                        {
                            "text": "The company refused to <w>cave</w> to the demands of the strikers.",
                            "target_lang_translations": {
                                "ru": "Компания отказалась <w>уступать</w> требованиям забастовщиков.",
                                "zh": "公司拒绝向罢工者的要求<w>妥协</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cave in",
                        "cave under pressure"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'in'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдаться или уступить под давлением требований.",
                        "zh": "在压力下屈服或放弃抵抗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдаться",
                                "target_lang_sense_clarification": "прекратить сопротивление"
                            },
                            {
                                "target_lang_word": "уступить",
                                "target_lang_sense_clarification": "согласиться под давлением"
                            },
                            {
                                "target_lang_word": "прогнуться",
                                "target_lang_sense_clarification": "разговорное, поддаться влиянию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屈服",
                                "target_lang_sense_clarification": "在压力下妥协"
                            },
                            {
                                "target_lang_word": "妥协",
                                "target_lang_sense_clarification": "放弃立场以达成某种结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfc63216-1d22-3676-ac18-0b642885fed4",
                    "sense_definition": "To collapse or fall inward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "First the braces buckled, then the roof began to <w>cave</w>.",
                            "target_lang_translations": {
                                "ru": "Сначала погнулись опоры, а затем крыша начала <w>рушиться</w>.",
                                "zh": "先是支撑架弯曲，接着屋顶开始<w>坍塌</w>。"
                            }
                        },
                        {
                            "text": "The old tunnel might <w>cave</w> in if we don't reinforce it.",
                            "target_lang_translations": {
                                "ru": "Старый туннель может <w>обвалиться</w>, если мы его не укрепим.",
                                "zh": "如果我们不加固，旧隧道可能会<w>塌陷</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cave in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрушиться или провалиться внутрь.",
                        "zh": "指结构向内坍塌或坠落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрушиться",
                                "target_lang_sense_clarification": "упасть внутрь"
                            },
                            {
                                "target_lang_word": "провалиться",
                                "target_lang_sense_clarification": "о крыше или почве"
                            },
                            {
                                "target_lang_word": "осесть",
                                "target_lang_sense_clarification": "о конструкции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坍塌",
                                "target_lang_sense_clarification": "建筑物或结构倒塌"
                            },
                            {
                                "target_lang_word": "塌陷",
                                "target_lang_sense_clarification": "地面或结构向下凹陷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc5b2ec3-b816-3109-b02c-b47b10c4d4c5",
                    "sense_definition": "To engage in the recreational exploration of caves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exploration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pam has been <w>caving</w> for twenty-five years and is an expert guide.",
                            "target_lang_translations": {
                                "ru": "Пэм занимается <w>спелеологией</w> уже двадцать пять лет и является опытным гидом.",
                                "zh": "帕姆从事<w>洞穴探险</w>已经二十五年了，是一位专家级向导。"
                            }
                        },
                        {
                            "text": "We plan to go <w>caving</w> in the national park this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные мы планируем <w>полазить по пещерам</w> в национальном парке.",
                                "zh": "我们计划这个周末去国家公园<w>探洞</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spelunk"
                    ],
                    "common_phrases": [
                        "go caving"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься спелеологией или исследованием пещер.",
                        "zh": "进行洞穴探险的休闲活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься спелеологией",
                                "target_lang_sense_clarification": "научное или спортивное"
                            },
                            {
                                "target_lang_word": "лазить по пещерам",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "洞穴探险",
                                "target_lang_sense_clarification": "专业的探险活动"
                            },
                            {
                                "target_lang_word": "探洞",
                                "target_lang_sense_clarification": "口语化的探险活动称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4c0223a9-8f48-3297-b7a9-6330de4e9a32",
                    "sense_definition": "An exclamation used to warn others to look out or beware.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ssh! <w>Cave</w>! The teacher is coming down the hall!",
                            "target_lang_translations": {
                                "ru": "Тсс! <w>Атас</w>! Учитель идет по коридору!",
                                "zh": "嘘！<w>小心</w>！老师正顺着走廊走过来！"
                            }
                        },
                        {
                            "text": "The boys shouted <w>cave</w> when they saw the guard approaching.",
                            "target_lang_translations": {
                                "ru": "Мальчики крикнули «<w>шухер</w>», когда увидели приближающегося охранника.",
                                "zh": "当男孩们看到警卫走近时，大喊了一声“<w>小心</w>”。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heads up",
                        "look out",
                        "watch it"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "British schoolboy slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для предупреждения об опасности.",
                        "zh": "用于警告他人注意危险或有人靠近的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атас",
                                "target_lang_sense_clarification": "сленговое предупреждение"
                            },
                            {
                                "target_lang_word": "шухер",
                                "target_lang_sense_clarification": "сленговое предупреждение"
                            },
                            {
                                "target_lang_word": "осторожно",
                                "target_lang_sense_clarification": "общее предупреждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小心",
                                "target_lang_sense_clarification": "通用的警告用语"
                            },
                            {
                                "target_lang_word": "注意",
                                "target_lang_sense_clarification": "提醒他人警惕"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "795e03ba-b16b-302f-85b3-f0e1141f9699",
                    "sense_definition": "A town and comune in Lazio, Italy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historic town of <w>Cave</w> is located near Rome.",
                            "target_lang_translations": {
                                "ru": "Исторический город <w>Каве</w> расположен недалеко от Рима.",
                                "zh": "历史悠久的<w>卡韦</w>镇位于罗马附近。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город и коммуна в Лацио, Италия.",
                        "zh": "意大利拉齐奥大区的一个城镇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Каве",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡韦",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d84afc3b-ec01-3b0e-a5dc-3002b3e830cf",
                    "sense_definition": "A surname.",
