                    {
                        "translation_id": "ebeed86b-cfb4-4cf7-9f7d-2d0299707223",
                        "source_entry_id": "fedab0ad-fe10-3c2c-9667-3d438e121627",
                        "source_sense_description": "process leading to formation of layers",
                        "target_lang_word": "Ablagerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ablagerung",
