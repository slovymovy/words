                ],
                "senses": [
                    {
                        "sense_id": "422aea2b-753c-392d-b81a-dc95d09d2b74",
                        "entry_id": "77de3a65-f247-31e2-ad10-2b99ae6c03f1",
                        "glosses": [
                            "eine Dokumentation in Betrieben, Behörden, Schulen und Kindertagesstätten, in der jede geleistete Erste-Hilfe-Maßnahme schriftlich aufgezeichnet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60a9543-b985-4c34-bb78-156e96ccf64c",
                                "sense_id": "422aea2b-753c-392d-b81a-dc95d09d2b74",
                                "text": "„In der Einrichtung muss sich ein Verbandkasten mit Verbandbuch befinden und die Mitarbeiter sollen im Umgang mit dem Verbandbuch unterwiesen worden sein.“"
                            },
                            {
                                "example_id": "aecb75c6-3512-4710-87f1-bd56e2c79437",
                                "sense_id": "422aea2b-753c-392d-b81a-dc95d09d2b74",
                                "text": "„Die Dokumentation im Verbandbuch ist dann immer hilfreich. Sie muss mindestens fünf Jahre nach dem letzten Eintrag in das Verbandbuch aufbewahrt werden.“"
                            },
                            {
                                "example_id": "d4129fd3-ecce-45f9-9a6e-cdf64cce4ca1",
                                "sense_id": "422aea2b-753c-392d-b81a-dc95d09d2b74",
                                "text": "„Die Dokumente, üblicherweise ein Verbandbuch, sind vertraulich zu behandeln, das heißt, vor Unbefugten zu schützen. Jede Verletzung, auch solche, für die z.B. nur ein Pflaster ausgegeben wurde, tragen Sie bitte ins Verbandbuch ein, um den Bezug zur beruflichen Tätigkeit zu beweisen.“"
                            },
                            {
                                "example_id": "2c8af8a8-6c0a-465a-bfd5-dfa0a660d668",
                                "sense_id": "422aea2b-753c-392d-b81a-dc95d09d2b74",
                                "text": "Im Verbandbuch sollte jedes arbeitsmedizinisch relevante Vorkommnis von Mitarbeitern einer Firma, das während oder auf dem Weg zur Arbeit eingetreten ist, aufgezeichnet werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
