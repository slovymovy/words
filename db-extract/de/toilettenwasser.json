                                                "sense_id": "fd9616e2-80a9-3242-b83d-d92af6a40b06",
                                                "text": "A toilet water with a strong scent, originally produced at Cologne, Germany."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d27dc0e5-0607-3155-9106-47e7e08640ce",
                                        "entry_id": "ef581927-b540-3546-aa0b-2e26b72f1407",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see toilet, water: wastewater in a toilet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8fee9c8-27aa-41dd-a249-2613a4c64974",
                                                "sense_id": "d27dc0e5-0607-3155-9106-47e7e08640ce",
                                                "text": "This may provide a simple explanation for the seemingly universal desire of all dogs to drink from the toilet. Since toilet water has likely been refreshed more recently than the water in Fido's bowl, it tastes better."
                                            }
                                        ]
                                    }
                                ]
