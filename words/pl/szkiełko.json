    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eeb9b50b-aee4-344f-8011-ec1a5ebba949",
                    "sense_definition": "zdrobnienie od: <w>szkło</w>; mały przedmiot ze szkła, np. element optyczny, soczewka lub płytka laboratoryjna",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "szkło_ogólne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wypadło mi jedno <w>szkiełko</w> z moich nowych okularów przeciwsłonecznych.",
                            "target_lang_translations": {
                                "ru": "У меня выпало одно <w>стёклышко</w> из новых солнцезащитных очков."
                            }
                        },
                        {
                            "text": "Naukowiec ostrożnie położył preparat na <w>szkiełko</w> mikroskopowe.",
                            "target_lang_translations": {
                                "ru": "Учёный осторожно положил препарат на предметное <w>стёклышко</w> микроскопа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "szkiełko mikroskopowe",
                        "szkiełko zegarka"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительное к «стекло»; небольшой стеклянный предмет, например линза, стекло очков или лабораторное предметное стекло"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стёклышко",
                                "target_lang_sense_clarification": "небольшой стеклянный предмет, деталь оптического прибора или часов"
                            },
                            {
                                "target_lang_word": "стекло",
                                "target_lang_sense_clarification": "стеклянная деталь, например линза очков или стекло циферблата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35322a83-e034-361b-8d9b-33a9f07bdb5e",
                    "sense_definition": "odłamek rozbitego szkła",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "szkło_odłamek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uważaj na podłodze, bo wszędzie leżą ostre <w>szkiełka</w> z rozbitej butelki.",
                            "target_lang_translations": {
                                "ru": "Осторожнее на полу: повсюду лежат острые <w>осколки</w> от разбитой бутылки."
                            }
                        },
                        {
                            "text": "Dziecko skaleczyło się w stopę małym <w>szkiełkiem</w> na plaży.",
                            "target_lang_translations": {
                                "ru": "Ребёнок порезал ногу маленьким <w>стёклышком</w> на пляже."
                            }
                        }
                    ],
                    "synonyms": [
                        "odłamek"
                    ],
                    "common_phrases": [
                        "ostre szkiełko",
                        "drobne szkiełka"
                    ],
                    "target_lang_definitions": {
                        "ru": "осколок разбитого стекла"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осколок стекла",
                                "target_lang_sense_clarification": "острый обломок разбитого стекла"
                            },
                            {
                                "target_lang_word": "стёклышко",
                                "target_lang_sense_clarification": "небольшой осколок стекла"
                            },
                            {
                                "target_lang_word": "стекляшка",
                                "target_lang_sense_clarification": "осколок, кусочек стекла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff5fa8ac-3a96-3085-ba03-d5feb5b70c63",
                    "sense_definition": "kawałek kolorowego szkła używany jako ozdoba lub imitacja kamienia szlachetnego",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "szkło_ozdoba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta tania biżuteria nie ma prawdziwych diamentów, to tylko błyszczące <w>szkiełka</w>.",
                            "target_lang_translations": {
                                "ru": "В этой дешёвой бижутерии нет настоящих бриллиантов, это всего лишь блестящие <w>стекляшки</w>."
                            }
                        },
                        {
                            "text": "Sukienka wieczorowa była pięknie ozdobiona drobnymi <w>szkiełkami</w>.",
                            "target_lang_translations": {
                                "ru": "Вечернее платье было красиво расшито мелкими <w>стёклышками</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kolorowe szkiełka"
                    ],
                    "target_lang_definitions": {
                        "ru": "кусочек цветного стекла, используемый в качестве украшения или имитации драгоценного камня"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стекляшка",
                                "target_lang_sense_clarification": "дешёвая имитация драгоценного камня, страз"
                            },
                            {
                                "target_lang_word": "стёклышко",
                                "target_lang_sense_clarification": "цветной кусочек стекла как декоративный элемент"
                            }
                        ]
                    }
                }
            ]
        }
    ]
