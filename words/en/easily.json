                {
                    "sense_id": "74f8b005-0de0-34a6-8f13-a303b9ded51e",
                    "sense_definition": "In a comfortable or relaxed manner; without anxiety.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot rest <w>easily</w> until we know they are safe.",
                            "target_lang_translations": {
                                "ru": "Мы не сможем спать <w>спокойно</w>, пока не узнаем, что они в безопасности.",
                                "zh": "在确认他们安全之前，我们无法<w>安心</w>。",
                                "nl": "We kunnen niet <w>rustig</w> slapen totdat we weten dat ze veilig zijn.",
                                "pl": "Nie możemy <w>spokojnie</w> odpocząć, dopóki nie dowiemy się, że są bezpieczni.",
                                "de": "Wir können nicht <w>beruhigt</w> sein, bis wir wissen, dass sie in Sicherheit sind.",
                                "fr": "Nous ne pouvons pas être <w>tranquilles</w> tant que nous ne savons pas qu'ils sont en sécurité.",
                                "it": "Non possiamo riposare <w>tranquillamente</w> finché non sapremo che sono al sicuro.",
                                "cs": "Nemůžeme být <w>v klidu</w>, dokud nebudeme vědět, že jsou v bezpečí.",
                                "tr": "Güvende olduklarını bilene kadar <w>huzurla</w> dinlenemeyiz.",
                                "es": "No podemos descansar <w>tranquilamente</w> hasta saber que están a salvo."
                            }
                        },
                        {
                            "text": "The wealthy couple lived <w>easily</w> in their large estate.",
                            "target_lang_translations": {
                                "ru": "Богатая пара жила <w>беззаботно</w> в своем огромном поместье.",
                                "zh": "这对富有的夫妇在他们的大庄园里过着<w>安逸</w>的生活。",
                                "nl": "Het rijke echtpaar leefde <w>zorgeloos</w> op hun grote landgoed.",
                                "pl": "Zamożna para żyła <w>beztrosko</w> w swojej wielkiej posiadłości.",
                                "de": "Das wohlhabende Paar lebte <w>sorgenfrei</w> auf seinem großen Anwesen.",
                                "fr": "Le couple fortuné vivait <w>paisiblement</w> dans leur vaste domaine.",
                                "it": "La ricca coppia viveva <w>serenamente</w> nella loro grande tenuta.",
                                "cs": "Bohatý pár žil <w>bezstarostně</w> na svém velkém sídle.",
