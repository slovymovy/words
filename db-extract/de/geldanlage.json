                "senses": [
                    {
                        "sense_id": "12869ec7-de59-3d1d-a984-a0e526d821f8",
                        "entry_id": "d8b67e77-3a6c-30c1-bb1a-6a384ea56a38",
                        "glosses": [
                            "Investition von Geld in etwas, von dem man sich einen Ertrag verspricht"
                        ],
                        "tags": [
                            "Finanzen"
                        ],
                        "examples": [
                            {
                                "example_id": "78e92326-1a85-4697-8472-0496b59fd537",
                                "sense_id": "12869ec7-de59-3d1d-a984-a0e526d821f8",
                                "text": "Um meine Geldanlagen mache ich mir keine Gedanken: Ich habe keine."
                            },
                            {
                                "example_id": "093047d7-f437-4595-ae93-a4188369350b",
                                "sense_id": "12869ec7-de59-3d1d-a984-a0e526d821f8",
                                "text": "„Manche Geldanlagen dort werfen höheren Gewinn ab als im französischen Mutterland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2be7c9fb-f813-30cb-9ee2-ebf694f4a3cc",
                        "entry_id": "d8b67e77-3a6c-30c1-bb1a-6a384ea56a38",
                        "glosses": [
                            "das, worin man sein Geld investiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8629dd67-0807-4ff1-b061-c65fc4ff7971",
                                "sense_id": "2be7c9fb-f813-30cb-9ee2-ebf694f4a3cc",
                                "text": "Die Firma ist meine Geldanlage."
