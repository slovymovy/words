                "senses": [
                    {
                        "sense_id": "19dc0ba5-3043-38db-9e02-f3777a167945",
                        "entry_id": "c5e6b7ee-131d-3b4c-886b-cc2e35a5220b",
                        "glosses": [
                            "Ronronner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ca3c59-f9d6-471d-aa60-81c06e84fe67",
                                "sense_id": "19dc0ba5-3043-38db-9e02-f3777a167945",
                                "text": "Ni vu ni connu, aucune trace, aucun débris, plus un bruit, le carrefour reronronne normalement, comme si de rien n'était."
                            },
                            {
                                "example_id": "3f9b0e77-31e9-4bc9-8ad5-78d7e5b92f55",
                                "sense_id": "19dc0ba5-3043-38db-9e02-f3777a167945",
                                "text": "Avec un peu de chance, elle pourra reronronner ce week-end si le temps me permet de faire de la mécanique sur la place de mon village!"
                            }
                        ]
                    }
