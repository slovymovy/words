                        "cross_references": [
                            {
                                "target_word": "ephebe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef84095-5850-3253-9840-98317ba6468d",
                                        "entry_id": "87b063c0-df35-34cb-a558-7c31ff8a818b",
                                        "glosses": [
                                            "An 18- to 20-year-old man in ancient Greece undergoing military training."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6fb7cff-1df0-3287-997e-a3e379782f43",
                                        "entry_id": "87b063c0-df35-34cb-a558-7c31ff8a818b",
                                        "glosses": [
                                            "A young man; a youth."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "536f969b-174a-47ac-bf3e-8b45e1ee6b71",
                                                "sense_id": "e6fb7cff-1df0-3287-997e-a3e379782f43",
                                                "text": "His glance touched their faces lightly as he smiled, a blond ephebe. Tame essence of [Oscar] Wilde."
                                            },
                                            {
                                                "example_id": "1fc77dba-097d-45ba-849f-fa777e3c99c8",
                                                "sense_id": "e6fb7cff-1df0-3287-997e-a3e379782f43",
                                                "text": "Indeed Tom was much still the ephebe, sharing boys with his friend though talking of the gravity of marriage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
