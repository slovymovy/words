                ],
                "senses": [
                    {
                        "sense_id": "cee0af05-35fd-384d-9394-5c60c756ace6",
                        "entry_id": "3bd08ddf-3f34-3435-b3e7-d8f5de7161c1",
                        "glosses": [
                            "Prozess in der Natur mit hoher, bedrohlicher Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11cdabd-569d-46dc-bda8-5c1f367eb062",
                                "sense_id": "cee0af05-35fd-384d-9394-5c60c756ace6",
                                "text": "Vulkanausbrüche und Tsunamis sind oft besonders drastische Naturgewalten."
                            },
                            {
                                "example_id": "8db3f1b8-2d8a-4fd8-b8bb-b429903f0950",
                                "sense_id": "cee0af05-35fd-384d-9394-5c60c756ace6",
                                "text": "„Dann wandelte sich der Malecón unter meinem Balkon in ein Spektakulum der Naturgerwalten.“"
                            },
                            {
                                "example_id": "f79d99c6-96b0-4a9c-96cf-f19fcbdcd979",
                                "sense_id": "cee0af05-35fd-384d-9394-5c60c756ace6",
                                "text": "„Seit Jahrtausenden nutzten die Menschen eine Vielzahl von Energiequellen: Sie verbrannten organische Materialien wie Holz und machten Naturgewalten wie Wind- und Wasserkraft nutzbar.“"
                            },
                            {
                                "example_id": "64a8abec-8527-42b9-9b48-5f044f9e707f",
                                "sense_id": "cee0af05-35fd-384d-9394-5c60c756ace6",
                                "text": "„Falls der Vulkan ausbrach, waren die Siedler hilflos den Naturgewalten preisgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4e65d550-b305-3272-9633-66f0909d3a20",
                        "entry_id": "3bd08ddf-3f34-3435-b3e7-d8f5de7161c1",
                        "glosses": [
                            "Person, die durch Erscheinung oder Leistung beträchtliche Wirkung entfaltet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7a5d9d42-0beb-4766-a85f-fb5162c5d54a",
                                "sense_id": "4e65d550-b305-3272-9633-66f0909d3a20",
                                "text": "\"Die norwegische Naturgewalt [Erling Haaland] ist sowieso allzeit bereit.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
