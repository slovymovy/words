                                                "sense_id": "ae71128c-160a-35da-b748-c7acd4a183bb",
                                                "text": "Les ides de mars furent fatales à Jules César."
                                            },
                                            {
                                                "example_id": "6be8af47-2ed0-4133-844d-26ce45dcc7b0",
                                                "sense_id": "ae71128c-160a-35da-b748-c7acd4a183bb",
                                                "text": "Le second, le troisième, le quatrième, etc., des ides : Le premier, le second, le troisième jour, etc., avant les ides."
                                            }
                                        ]
                                    }
                                ]
