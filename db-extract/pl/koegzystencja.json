                "translations": [
                    {
                        "translation_id": "7df9b307-8a8e-401c-8628-59d5b012a8e4",
                        "source_entry_id": "8844a930-06f5-354f-96f2-9dfedbf6d4c2",
                        "source_sense_id": "ff0b0b50-b46f-35bf-8304-17052c2b4052",
                        "target_lang_word": "coexistence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coexistence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                                        "entry_id": "83f3870a-8931-33d3-af73-abf5494911be",
                                        "glosses": [
                                            "The state of two or more things existing together, usually in a temporal or spatial sense, with or without mutual interaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9e494d-0e23-42ba-b8c5-00a0bb57f743",
                                                "sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                                                "text": "The day of horror Israel has just experienced signals the end of the Netanyahu experiment in violent coexistence."
                                            },
                                            {
                                                "example_id": "070d633e-456d-4cac-83c5-b295bd16304d",
                                                "sense_id": "d73c34ba-e536-361f-9aa8-5f640a384441",
                                                "text": "While the PSOE’s leader and caretaker prime minister, Pedro Sánchez, argues that the act of clemency would help promote coexistence after the tumultuous political and territorial crisis of 2017, his opponents have decried the move as a cynical and self-serving means of remaining in power."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b81495b8-cb2b-4f4f-bc6d-497310cfcb37",
                        "source_entry_id": "8844a930-06f5-354f-96f2-9dfedbf6d4c2",
                        "source_sense_id": "ff0b0b50-b46f-35bf-8304-17052c2b4052",
                        "target_lang_word": "coexistence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coexistence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0edb16b-33a5-39a0-955d-457ae7a8963d",
                                        "entry_id": "6a3feff3-a89a-3e20-b89f-79f8fbf88151",
                                        "glosses": [
                                            "Fait de coexister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a597385b-e476-40af-a331-807d6d5b3bea",
                                                "sense_id": "a0edb16b-33a5-39a0-955d-457ae7a8963d",
                                                "text": "La coexistence pacifique fait partie, depuis quelque vingt-cinq ans, du langage courant des relations internationales."
                                            },
                                            {
                                                "example_id": "3b1204e2-577d-4f5f-81d1-77d768ffdda5",
                                                "sense_id": "a0edb16b-33a5-39a0-955d-457ae7a8963d",
                                                "text": "D’ailleurs, il a affirmé tout récemment que les déclarations de Biden concernant l’Amazonie constituaient «un signal clair de mépris envers la coexistence cordiale et fructueuse» entre les deux pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
