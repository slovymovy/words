                "senses": [
                    {
                        "sense_id": "4885d1b0-e7b7-3b9e-be6e-7ba8d2b6bed0",
                        "entry_id": "17c843a0-045a-3bd9-b164-7ce456ecc846",
                        "glosses": [
                            "persönlicher Einsatz im Sinne des Spielgedankens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eece7d8-7401-4761-9852-a5959a2a7c3f",
                                "sense_id": "4885d1b0-e7b7-3b9e-be6e-7ba8d2b6bed0",
                                "text": "„Ihr Spielengagement sollte sich nicht gegeneinander richten, sondern miteinander auf eine gemeinsame Aufgabe zielen.“"
                            },
                            {
                                "example_id": "9566918e-9298-4e76-83ac-3513b5347385",
                                "sense_id": "4885d1b0-e7b7-3b9e-be6e-7ba8d2b6bed0",
                                "text": "„Die Kinder fühlen sich in das Spiel aktiv einbezogen, dabei kann es vorkommen, dass sie in ihrem Spielengagement das Gefühl für die Zeit verlieren.“"
                            },
                            {
                                "example_id": "81f4d5a7-fc80-4b6c-81ce-06545ce7a9ae",
                                "sense_id": "4885d1b0-e7b7-3b9e-be6e-7ba8d2b6bed0",
                                "text": "„Die dritte Form des auftretenden Spielverhaltens, das soziale Spielengagement, beginnt allmählich im dritten Lebensjahr des Kindes, da die emotionalen wie kognitiven Voraussetzungen soweit gegeben sind, dass die Interaktion mit anderen Kindern in Kleingruppen möglich wird.“"
                            },
                            {
                                "example_id": "6b1ebcfc-4dbf-456f-a722-68b519b5ccb3",
                                "sense_id": "4885d1b0-e7b7-3b9e-be6e-7ba8d2b6bed0",
                                "text": "„Als allerdings Pia, die aus dem gegnerischen Team ebenfalls nicht mehr angespielt werden soll, sie auf die sportunterrichtliche Benachteiligungssituation aufmerksam macht, nimmt Lana ihr Spielengagement zurück.“"
                            },
                            {
                                "example_id": "8a2565db-8c69-4b11-8a78-15415afe78c7",
                                "sense_id": "4885d1b0-e7b7-3b9e-be6e-7ba8d2b6bed0",
                                "text": "„Das Trainerduo Bernd Scheiderer und Andreas Pollich lobten die Spielerinnen für ihre Konzentration und ihr Spielengagement und forderten für die zweite Halbzeit weiterhin konsequente Torabschlüsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
