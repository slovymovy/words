                ],
                "senses": [
                    {
                        "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                        "entry_id": "c140a866-0b1f-32d8-a875-3df37ec16dad",
                        "glosses": [
                            "Bereich, der den Transport von Gütern und Menschen umfasst;\\nVerkehrssektor wird a) häufig im Zusammenhang von schädlichen Emissionen mit Wirkungen auf die Umwelt benutzt, b) als Bereich der Wirtschaft benutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d13edd1-9439-40d3-98d0-603da700fe7d",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Der Verkehrssektor ist der einzige Bereich, in dem der klimaschädliche CO₂-Ausstoß seit 1990 kaum gesunken ist.“"
                            },
                            {
                                "example_id": "22a78711-5192-4408-a0c6-6af1a8e15241",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Der Verkehrssektor soll bis 2030 zumindest in hohem Maße ohne Sprit auskommen.“"
                            },
                            {
                                "example_id": "431b1c91-a7ab-4187-8882-ebdd146f16ff",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„»Wenn wir dem Klimawandel wenigstens halbwegs entgegentreten wollen, müssen wir unbedingt vom Verbrenner im Verkehrssektor weg.«“"
                            },
                            {
                                "example_id": "fdc076c6-a634-4d57-a88a-9f8ffc5f1bc2",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "[Treibhausgasemissionen in Deutschland:] „Auch der Verkehrs- und Gebäudesektor konnte seine Vorgaben im vergangenen Jahr wieder nicht erfüllen.“"
                            },
                            {
                                "example_id": "fee680d4-cdd0-498d-857e-88b999821250",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Der einhergehende Mangel an politischen Maßnahmen für eine Reduktion der Emissionen im Verkehrssektor hat auch zum Verfehlen des Ziels beigetragen.“"
                            },
                            {
                                "example_id": "ca89edd2-32e0-4157-8457-4041dbf11c5a",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Gerade im Verkehrssektor bewegt sich bislang nichts.“"
                            },
                            {
                                "example_id": "3d940889-9761-4a89-9caa-053a9090ac2d",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Der Gebäudesektor verursachte im Jahr 2021 laut einer UN-Studie 37 Prozent der energiebedingten CO2-Emissionen weltweit - mehr als die Industrie (30%) und der Verkehrssektor (22%).“"
                            },
                            {
                                "example_id": "729900f1-de05-40d8-a154-5ddab6d2d8d4",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Die Möglichkeit günstigen Wasserstoff durch sauberen Strom zu produzieren, könnte den Verkehrssektor langfristig von schwindenden fossilen Brennstoffen unabhängiger machen.“"
                            },
                            {
                                "example_id": "4dcc291e-0350-4771-baff-b8970acc8ce6",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "[Energiewende:] […] „zudem wurde“ […] „für 2015 die Einführung der Euro-5-Norm im Verkehrssektor festgelegt, um Fahrzeuge mit besonders hoher Luftverschmutzung von den Straßen zu entfernen.“"
                            },
                            {
                                "example_id": "d1057e2d-5108-44d1-998b-086314d56faa",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "[Alternative Kraftstoffe:] „Der Vorteil: Die Ausgangsprodukte wie Raps oder Stroh könnte die heimische Landwirtschaft herstellen. Damit wären allerdings höchsten 10% der Energie des Verkehrssektors abdeckbar.“"
                            },
                            {
                                "example_id": "218ccbfe-b80b-4afc-8a07-cade43d37c18",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Unterziel 3: Bis 2012 sollen im Verkehrssektor die CO₂-Emissionen um 15 Millionen Tonnen reduziert werden.“"
                            },
                            {
                                "example_id": "2e6e037b-8660-44e9-b18a-3866d3e0d286",
                                "sense_id": "84fa0128-1371-3f1b-92df-94b2cd425886",
                                "text": "„Aufgrund seiner Lage als Knotenpunkt zwischen Asien und Europa ist der Verkehrssektor eine wichtige Einnahmequelle der Türkei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
