                "senses": [
                    {
                        "sense_id": "eeb9868e-489f-310e-b1cd-645f6c3cdeaa",
                        "entry_id": "39ee503f-b6e6-3af9-b76c-3740c8b82417",
                        "glosses": [
                            "разг. женск. к полуночник; женщина, которая до поздней ночи не ложится спать, занимаясь чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09bfdc6e-83ae-4a99-9c59-40153fc2dd6b",
                                "sense_id": "eeb9868e-489f-310e-b1cd-645f6c3cdeaa",
                                "text": "Среди ночи скрипнула дверь, вошла Полина. Сбросила с головы на плечи душный платок, жадно выпила ковш воды. ― Явилась-таки полуночница, ― проворчала, не поднимаясь, Ульяна."
                            }
                        ]
                    }
                ],
