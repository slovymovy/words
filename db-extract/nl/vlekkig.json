                                    },
                                    {
                                        "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Sleety; gusty; stormy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4311143a-b003-473a-851b-00109dcb62fa",
                                                "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                                "text": "dirty weather"
                                            },
                                            {
                                                "example_id": "dd12b51e-b902-48c3-9e07-5e96384e637d",
                                                "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                                "text": "Storms of wind, clouds of dust, an angry, dirty sea."
                                            },
                                            {
                                                "example_id": "96a411d7-a38e-4662-bdcb-236a619c61c7",
                                                "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                                "text": "Rain type 17 was a dirty blatter battering against his windscreen so hard that it didn't make much odds whether he had his wipers on or off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b5f603-bbbc-308b-b470-c3b05abfd4f1",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Of an alcoholic beverage, especially a cocktail or mixed drink: served with the juice of olives."
