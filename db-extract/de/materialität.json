                ],
                "senses": [
                    {
                        "sense_id": "5f205f31-88ac-3575-b921-4e2d35290fa6",
                        "entry_id": "4b90c6bf-4ee9-3588-a818-dba4198784a1",
                        "glosses": [
                            "Eigenschaft, einen Körper zu besitzen (der Raum einnimmt und der greifbar ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1e7906-8546-41d7-84f1-930ec6f91c88",
                                "sense_id": "5f205f31-88ac-3575-b921-4e2d35290fa6",
                                "text": "„Mit demselben Rechte, mit dem man behauptet, die Form sei das Wesen des Dinges, kann man behaupten, die Materialität sei das Wesen des Dinges, denn materiell zu sein ist eine allgemeine Bestimmtheit aller Naturwesen.“ (1863)"
                            },
                            {
                                "example_id": "dcf7730b-d306-420f-a2d5-f45b0cddd7a3",
                                "sense_id": "5f205f31-88ac-3575-b921-4e2d35290fa6",
                                "text": "„Während sich derzeit die Materialität der Toten in den errechneten Repräsentationen der virtuellen Welten zunehmend verflüchtigt, lässt sich in der Kunst eine gegenteilige Tendenz beobachten. Hier insistieren viele Arbeiten auf die Körperlichkeit des Leichnams, die Markierung und Spur seiner Anwesenheit, seine physische Präsenz im Hier und Jetzt des Raums der Lebenden.“"
                            },
                            {
                                "example_id": "26b2b19f-6051-4214-8a6a-fb0246ee5fc0",
                                "sense_id": "5f205f31-88ac-3575-b921-4e2d35290fa6",
                                "text": "„Als Zeichen und Zeichenträger sind Medien notwendigerweise immer schon materiell, auch wenn ihre Materialität sehr unterschiedlich sein kann (man vergleiche etwa eine Radioübertragung mit einem Buch).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
