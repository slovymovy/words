                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44b83cc6-52e4-3398-9f54-37a92ce1c71b",
                                        "entry_id": "81d0303b-d4ab-34e0-a1b3-87e8287adb23",
                                        "glosses": [
                                            "Conjunto de fármacos y procedimientos que se prescriben para curar o aliviar una dolencia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593254d0-097a-42bd-9d62-3de03ffa1184",
                                                "sense_id": "44b83cc6-52e4-3398-9f54-37a92ce1c71b",
                                                "text": "«“Al analizar proteínas para determinar su función se puede dar la circunstancia de que dichas funciones pueden ser válidas en campos como la detección o el tratamiento de enfermedades. Lo importante es abrir campos para seguir avanzando en el conocimiento”, concluye el investigador»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "92530cbb-4d42-3d4e-a149-b9e4169bbc36",
                                        "entry_id": "81d0303b-d4ab-34e0-a1b3-87e8287adb23",
                                        "glosses": [
                                            "Más generalmente, conjunto de métodos que se emplean para transformar un material"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "55514304-7084-3969-ba24-1882d953f4d8",
                                        "entry_id": "81d0303b-d4ab-34e0-a1b3-87e8287adb23",
                                        "glosses": [
                                            "Epíteto que se usa para designar o interpelar a una persona, en atención a su condición social."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952da2bf-6221-4f07-9228-3866e3e299fa",
                                                "sense_id": "55514304-7084-3969-ba24-1882d953f4d8",
                                                "text": "“Los tratamientos se escriben con minúsculas aunque se apliquen al nombre de un personaje literario: «don Quijote», «don Juan», «doña Perfecta»…”."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fc93a492-4260-305c-97ab-4b8dd61acf5f",
                                        "entry_id": "81d0303b-d4ab-34e0-a1b3-87e8287adb23",
                                        "glosses": [
                                            "Acuerdo al que llegan dos o más partes para decidir el curso de un asunto en disputa"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "514bbacd-2c38-41bb-85bc-9e09086cf93d",
                        "source_entry_id": "f14b80a7-605e-3599-8742-13be0d052d3f",
                        "source_sense_id": "fac8fc32-1ef6-3f47-8432-6551df4a829f",
                        "target_lang_word": "Behandlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Behandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3707e5f0-ef9b-3ecb-b8c2-d8b219d5cb7a",
                                        "entry_id": "77786800-a74b-3c8c-b1b7-526218af1ea7",
                                        "glosses": [
                                            "das Umgehen, Verfahren mit etwas oder jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48dadf81-eabe-43a6-b784-6c2196b6e893",
                                                "sense_id": "3707e5f0-ef9b-3ecb-b8c2-d8b219d5cb7a",
                                                "text": "Die Behandlung des Konflikts führte zu keiner Lösung."
                                            },
                                            {
                                                "example_id": "d17cb30b-6ae7-4d72-8f3f-c8a6e58e61ee",
                                                "sense_id": "3707e5f0-ef9b-3ecb-b8c2-d8b219d5cb7a",
                                                "text": "„Als Christ und Mensch hatte auch der Unfreie zumindest einen moralischen Anspruch auf menschenwürdige Behandlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "996b8cb9-2d01-39ce-b4ce-a40af8f61eca",
                                        "entry_id": "77786800-a74b-3c8c-b1b7-526218af1ea7",
                                        "glosses": [
                                            "Anwendung eines Heilverfahrens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4028e215-da25-4767-b9c0-0795aff113b1",
                                                "sense_id": "996b8cb9-2d01-39ce-b4ce-a40af8f61eca",
                                                "text": "Die Behandlung mit den Insulintabletten reichte nicht aus."
                                            },
                                            {
                                                "example_id": "bda98459-787c-4cfc-aac5-d5d731fee0ed",
                                                "sense_id": "996b8cb9-2d01-39ce-b4ce-a40af8f61eca",
                                                "text": "„Übereinstimmend wurde die positive Erfahrung wiedergegeben, diese Behandlungen im Kriegslazarett hinter der Front durchzuführen, nicht etwa weit weg von der Entstehungssituation, also nicht im Heimatlazarett, was sich weniger bewährt habe.“"
                                            },
                                            {
                                                "example_id": "28ec4e65-4cec-4491-9e9a-49b0b1c09232",
                                                "sense_id": "996b8cb9-2d01-39ce-b4ce-a40af8f61eca",
                                                "text": "„Um die Behandlung des Ausschlags würde man sich dann kümmern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13dce7db-0130-3043-b936-75e3f07325fe",
                                        "entry_id": "77786800-a74b-3c8c-b1b7-526218af1ea7",
                                        "glosses": [
                                            "Betreuung durch einen Arzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c46cd34f-a905-41d9-8c90-0ac8e1228b6b",
                                                "sense_id": "13dce7db-0130-3043-b936-75e3f07325fe",
                                                "text": "„Es handelt sich um einen leidenschaftlichen Segelflieger, der sich wegen zwischenmenschlicher Probleme in die Behandlung begeben hat.“"
                                            },
                                            {
                                                "example_id": "2273b05e-a7dd-4666-8dd6-784dec8755f9",
                                                "sense_id": "13dce7db-0130-3043-b936-75e3f07325fe",
                                                "text": "Die Behandlung durch den Arzt hätte intensiver sein können."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e4c31155-0efb-3216-812f-dd6d0301af4f",
                                        "entry_id": "77786800-a74b-3c8c-b1b7-526218af1ea7",
                                        "glosses": [
                                            "Darstellung eines Themas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceadabfb-9e83-4ae7-8624-482ad1c7073a",
                                                "sense_id": "e4c31155-0efb-3216-812f-dd6d0301af4f",
                                                "text": "Die Behandlung des Themas war zu lückenhaft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "285c3c79-1fc5-4728-bf4c-7488056f6982",
                        "source_entry_id": "f14b80a7-605e-3599-8742-13be0d052d3f",
                        "source_sense_id": "fac8fc32-1ef6-3f47-8432-6551df4a829f",
                        "target_lang_word": "Umgang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0a45d7c-7073-3d70-9a8a-c827f1d4d04e",
                                        "entry_id": "09b1b8cd-9dd3-3c53-a9cb-7585d53a92a7",
                                        "glosses": [
                                            "Beziehung mit jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c763061-6097-40fb-a9e6-d7b32827d6fb",
                                                "sense_id": "d0a45d7c-7073-3d70-9a8a-c827f1d4d04e",
                                                "text": "Er hatte in der Jugend schlechten Umgang und kam in die Drogenszene."
                                            },
                                            {
                                                "example_id": "c0c6a0fe-7817-4e96-a0b4-55bfdf488697",
                                                "sense_id": "d0a45d7c-7073-3d70-9a8a-c827f1d4d04e",
                                                "text": "„Mit anderen Fahndern wurde er vor vier Jahren aus dem Dienst geworfen - nachdem er intern gegen einen zu laxen Umgang mit Steuersünden protestiert hatte.“"
                                            },
                                            {
                                                "example_id": "d2fdf06f-8c7c-4290-a371-86b183540ae5",
                                                "sense_id": "d0a45d7c-7073-3d70-9a8a-c827f1d4d04e",
                                                "text": "„Es sind im Rahmen der Umgänge eigentlich drei Kriterien im Hinblick auf einen Beziehungsaufbau relevant: 1. Umgang der (beim KV [Kindsvater] lebenden) Tochter, 5 J, mit der KM [Kindsmutter]“"
                                            },
                                            {
                                                "example_id": "14a28fde-39f2-4455-8a43-7b7c754154bd",
                                                "sense_id": "d0a45d7c-7073-3d70-9a8a-c827f1d4d04e",
                                                "text": "„Im Wesentlichen beschäftigen Sie die Umstände, dass der Vater kein Interesse an den Umgängen mit den Kindern zeigt und die mit den Umgängen beauftragte Organisation die Bedenken der jungen Frau nicht ernst nimmt.“"
                                            },
                                            {
                                                "example_id": "bde7df2e-3533-4cec-9047-434baad3f2a9",
                                                "sense_id": "d0a45d7c-7073-3d70-9a8a-c827f1d4d04e",
                                                "text": "„Larroque sucht noch nach einem Umgang mit Trump.“"
                                            },
                                            {
                                                "example_id": "a6fd17cc-023a-46b8-98af-81fb720c8b2e",
                                                "sense_id": "d0a45d7c-7073-3d70-9a8a-c827f1d4d04e",
                                                "text": "Der Umgang in den Jobcentern ist teilweise rüde, es wird ständig versucht, den Leuten vorzumachen, dass sie selber schuld an ihrer Arbeitslosigkeit sind.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cadb17c-8811-3568-b2b2-4bb1d7a7dc50",
                                        "entry_id": "09b1b8cd-9dd3-3c53-a9cb-7585d53a92a7",
                                        "glosses": [
                                            "das Hantieren oder Beschäftigen mit etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90dee4c-823d-484a-84f9-09a08657f1bc",
                                                "sense_id": "8cadb17c-8811-3568-b2b2-4bb1d7a7dc50",
                                                "text": "„Das Motorfliegen erfordert ein beträchtliches navigatorisches Wissen und Können bzw. […] vestibuläre Belastbarkeit, Raumorientierungsvermögen und ein feinmotorisches Gespür für den Umgang mit der Maschine.“"
                                            },
                                            {
                                                "example_id": "617f4056-58ba-43fe-82f7-2b1f670d3f4f",
                                                "sense_id": "8cadb17c-8811-3568-b2b2-4bb1d7a7dc50",
                                                "text": "Ich musste den Umgang mit einem Computer erst erlernen."
                                            },
                                            {
                                                "example_id": "418b9584-e5c8-40b3-9eda-a3f655fbf88d",
                                                "sense_id": "8cadb17c-8811-3568-b2b2-4bb1d7a7dc50",
                                                "text": "„Der Positive Trend zur Reduzierung des Energieverbrauches konnte bis jetzt konstant fortgeführt werden … Ohne Zweifel, die günstigen Wetterbedingungen und der Produktionsumfang haben einen erheblichen Einfluss darauf. Doch viele kleine bewusstere Umgänge mit Energie haben auch ihren Beitrag geleistet.“"
                                            },
                                            {
                                                "example_id": "f1d81480-3f0e-469d-bd5b-4dfd16a18cda",
                                                "sense_id": "8cadb17c-8811-3568-b2b2-4bb1d7a7dc50",
                                                "text": "„Clemenza, der Caporegime, nahm Sonnys Ausbildung in die Hand und lehrte ihn den Umgang mit Schußwaffen und mit der Garotte.“"
                                            },
                                            {
                                                "example_id": "64d01fee-d06f-4eee-9db5-7afbd98cb578",
                                                "sense_id": "8cadb17c-8811-3568-b2b2-4bb1d7a7dc50",
                                                "text": "[Jakarta/Indonesien:] „Überhaupt ist Wasser für die 18 Millionen Menschen im Ballungsgebiet ein Grund zur täglichen Sorge. Ursache ist der unverantwortliche Umgang mit Abwässern jeder Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab355fae-b52a-3994-8c37-d665b8b2d0ed",
                                        "entry_id": "09b1b8cd-9dd3-3c53-a9cb-7585d53a92a7",
                                        "glosses": [
                                            "Gang um einen Gebäudeteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea4c3021-caea-4e3a-814d-500798ecbc1d",
                                                "sense_id": "ab355fae-b52a-3994-8c37-d665b8b2d0ed",
                                                "text": "Der Umgang um den Innengarten ist überdacht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "860bbc35-9c0c-3e4c-97e0-8556fbdcb288",
                                        "entry_id": "09b1b8cd-9dd3-3c53-a9cb-7585d53a92a7",
                                        "glosses": [
                                            "das Gehen um etwas herum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
