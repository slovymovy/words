                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a07961f-436b-38dc-a497-1a530abc3ca0",
                        "entry_id": "3a40862c-b81b-3e45-ae8e-fe61257e8380",
                        "glosses": [
                            "Stylo permettant d’effacer l’encre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dac63d0-9238-4038-b29b-757b1a07e757",
                                "sense_id": "7a07961f-436b-38dc-a497-1a530abc3ca0",
                                "text": "Il utilise trop souvent son effaceur."
                            }
                        ]
                    },
                    {
                        "sense_id": "080513f5-5819-3586-bae3-8bb71f27e5e4",
                        "entry_id": "3a40862c-b81b-3e45-ae8e-fe61257e8380",
                        "glosses": [
                            "Qui estompe ou supprime."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d94725cc-2d76-4570-9738-25e159db1e55",
                                "sense_id": "080513f5-5819-3586-bae3-8bb71f27e5e4",
                                "text": "Adrien Simkolochuski appartenait à cette race d’artisans pour qui toute journée passée est une journée de gagnée. Il vivait avec une sorte d’effaceur dans la tête. Sitôt qu’il avait raccroché, qu’il n’entendait pas votre voix, vous n’existiez plus."
                            },
                            {
                                "example_id": "b2ebf07d-4ac4-4f68-b111-0091b1502cf9",
                                "sense_id": "080513f5-5819-3586-bae3-8bb71f27e5e4",
                                "text": "On veut protéger un art de vivre qui est un brassage culturel populaire, un effaceur social, ethnique et confessionnel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59c08780-6702-4ff0-bb0d-ea4e8e005688",
                        "source_entry_id": "3a40862c-b81b-3e45-ae8e-fe61257e8380",
                        "target_lang_word": "Tintenkiller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tintenkiller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                                        "entry_id": "553b24cd-4238-3675-8343-b44378949d83",
                                        "glosses": [
                                            "Stift zum Löschen von mit löschbarer Tinte geschriebenen Textabschnitten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964913fa-8a05-48f9-a0a7-17e449e1532f",
                                                "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                                                "text": "Auch der beste Tintenkiller hinterlässt noch Spuren."
                                            },
                                            {
                                                "example_id": "f9e1d882-286d-44c3-8745-ab4c4a6acaa0",
                                                "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                                                "text": "„An einigen Stellen waren die Umrisslinien der Gegenstände herausgefiltert, sodass die Objekte wie mit einem Tintenkiller bearbeitet aussahen.“"
                                            },
                                            {
                                                "example_id": "31ccec41-84e9-45b2-85b6-b20d1152333c",
                                                "sense_id": "07f9a6b2-0065-3d86-bf80-f46dc4bb0ce7",
                                                "text": "„Mit Tintenkiller wurde der richtige Name des Besitzers des Maturazeugnisses weggelöscht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28db55ef-3907-4337-9487-cf9673b1d8ba",
                        "source_entry_id": "3a40862c-b81b-3e45-ae8e-fe61257e8380",
                        "target_lang_word": "Tintenlöscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tintenlöscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85d70e12-1559-3024-acda-7dca83300ec9",
                                        "entry_id": "7846172d-e84d-3f1a-af48-c261b4f5eaec",
                                        "glosses": [
                                            "Stift zum Entfernen von mit löschbarer Tinte geschriebenen Textabschnitten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a6fc9b-3c1c-4ace-9149-8e294e760477",
                                                "sense_id": "85d70e12-1559-3024-acda-7dca83300ec9",
                                                "text": "„Methoden zur Entfernung von Tinte gibt es schon seit fast hundert Jahren. Die erste Firma, die einen Tintenlöscher entwickelte, war Pelikan.“"
                                            },
                                            {
                                                "example_id": "d38141c2-4929-4a93-92c9-2011f5945365",
                                                "sense_id": "85d70e12-1559-3024-acda-7dca83300ec9",
                                                "text": "„Wenn die Persönlichkeiten im Buch unterschrieben haben, können sie mit dem Tintenlöscher drübergehen, damit nichts verschmiert.“"
                                            },
                                            {
                                                "example_id": "58276eeb-f0e3-43b4-9ac9-7e2e7113f286",
                                                "sense_id": "85d70e12-1559-3024-acda-7dca83300ec9",
                                                "text": "„Demnach zeigt dieses Amateurvideo, dass an der Wahlurne Stifte mit gewöhnlicher Tinte bereitliegen, mit denen die Wähler ihren Stimmzettel ausfüllen sollen. Mit einem gewöhnlichen Tintenlöscher kann die Tinte jedoch problemlos wieder entfernt werden. Das – so der Verdacht kritischer Bürger - vereinfacht die nachträgliche Modifizierung von Wahlzetteln erheblich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "88b3e787-2a6c-3943-bfe9-8b639016959a",
                                        "entry_id": "7846172d-e84d-3f1a-af48-c261b4f5eaec",
                                        "glosses": [
                                            "mit saugfähigem Papier bezogenes Gerät, mit dem überschüssige Tinte aufgenommen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5afc631-9962-4f96-b716-344d9f1fddef",
                        "source_entry_id": "3a40862c-b81b-3e45-ae8e-fe61257e8380",
