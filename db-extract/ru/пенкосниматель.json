                "senses": [
                    {
                        "sense_id": "7df38578-c59c-3294-a2a6-fd1430e2ed1c",
                        "entry_id": "7923535a-e3c0-3159-9609-8b58ce13c1b3",
                        "glosses": [
                            "неодобр. тот, кто присваивает себе плоды чужого труда, использует их как свои собственные"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb558fd-851a-4e07-a986-37596f923c01",
                                "sense_id": "7df38578-c59c-3294-a2a6-fd1430e2ed1c",
                                "text": "Им бы только пенки снимать, а он на таких насмотрелся, на пенкоснимателей."
                            },
                            {
                                "example_id": "b5c77e4e-6e21-4413-a860-e2d8ef910ef9",
                                "sense_id": "7df38578-c59c-3294-a2a6-fd1430e2ed1c",
                                "text": "Поэзия по Щедрину: «Вольным пенкоснимателем может быть всякий, кто способен непредосудительным образом излагать смутность наполняющих его чувств»."
                            }
                        ]
                    }
