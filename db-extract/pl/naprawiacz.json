                ],
                "senses": [
                    {
                        "sense_id": "479fe4cf-f008-3d8c-9103-2e8f0154dcb8",
                        "entry_id": "7b1697bc-7809-303f-9992-363b162e6757",
                        "glosses": [
                            "osoba, która naprawia jakieś urządzenie lub rzecz, usuwa usterkę i przywraca przydatność danego przedmiotu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f11fc1b-397c-44a9-87ef-63ea1445ce61",
                                "sense_id": "479fe4cf-f008-3d8c-9103-2e8f0154dcb8",
                                "text": "Zepsuła mi się szafka, więc zatelefonowałam po naprawiacza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acb512dd-7615-400f-9f72-8e7caae03209",
                        "source_entry_id": "7b1697bc-7809-303f-9992-363b162e6757",
                        "source_sense_id": "479fe4cf-f008-3d8c-9103-2e8f0154dcb8",
                        "target_lang_word": "repairer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "repairer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0651a210-810e-34c0-85ad-8be3acb1e73b",
                                        "entry_id": "21f97bc8-450d-3ead-b102-906dd437c2d0",
                                        "glosses": [
                                            "A person who repairs things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "592238de-7589-4e9a-8f70-46bac1b8492c",
                                                "sense_id": "0651a210-810e-34c0-85ad-8be3acb1e73b",
                                                "text": "And they that shall be of thee shall build the old waste places: thou shalt raise up the foundations of many generations; and thou shalt be called, The repairer of the breach, The restorer of paths to dwell in."
                                            },
                                            {
                                                "example_id": "b833f3ad-5c0e-4234-ae17-9b98d27e7219",
                                                "sense_id": "0651a210-810e-34c0-85ad-8be3acb1e73b",
                                                "text": "The men on the freight trains, who go over the whole length of the road, bow to me as to an old acquaintance, they pass me so often, and apparently they take me for an employee; and so I am. I too would fain be a track-repairer somewhere in the orbit of the earth."
                                            },
                                            {
                                                "example_id": "2a860351-5c57-4b6c-900c-ce25e82fa2ef",
                                                "sense_id": "0651a210-810e-34c0-85ad-8be3acb1e73b",
                                                "text": "1987, Nadine Gordimer, A Sport of Nature, New York: Alfred Knopf, p. 168,\nWhere the European city grid of right angles was overgrown and broken up by the purposeful tangle of African pursuits—the shortest point-to-point meander taken on foot between barbers and fruit-sellers, scribes and bicycle repairers—to be white was to feel invisible; only a sensuous self-assurance, while it lasted, could counter that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
