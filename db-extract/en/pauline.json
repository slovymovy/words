                "senses": [
                    {
                        "sense_id": "a3bac74b-10d9-3fe3-9520-ceaab3b006c2",
                        "entry_id": "4d3a9868-38c7-32b4-b795-03c818449468",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90b77baf-fd77-4ddd-909a-eafea3ba904d",
                                "sense_id": "a3bac74b-10d9-3fe3-9520-ceaab3b006c2",
                                "text": "The youngest child of George and Emily Johnson was named Emily after her mother, and Pauline in honor of the only sibling of Emperor Napoleon of France, whose life was the object of George Johnson's consuming interest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "985d72cf-ee2c-4640-b4ec-9d7f1b1209a4",
                        "source_entry_id": "4d3a9868-38c7-32b4-b795-03c818449468",
