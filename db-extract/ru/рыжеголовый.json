                "senses": [
                    {
                        "sense_id": "aaa37d0f-a7d4-3a2d-891d-95053e4a8e3e",
                        "entry_id": "6b3c52d8-7507-3b13-918f-0a232ed67e54",
                        "glosses": [
                            "имеющий рыжие волосы (шерсть, оперение) на голове"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33154a00-0e8c-49bf-8092-71988691a4ac",
                                "sense_id": "aaa37d0f-a7d4-3a2d-891d-95053e4a8e3e",
                                "text": "Китай покупает электроэнергию по 1 руб. 20 копеек за киловатт, а предприятие, в котором я работаю, платит 14 рублей за киловатт, благодаря инновациям рыжеголового Чубайса, верного подданного этого режима."
                            },
                            {
                                "example_id": "712ec785-08e3-4d5c-8802-7b43fe5ca896",
                                "sense_id": "aaa37d0f-a7d4-3a2d-891d-95053e4a8e3e",
                                "text": "Один из черепов — самый крупный, медвежий, — давно уже упал наземь, укатился в бурьян и треснул надвое; мелкая рыжеголовая птаха свила в нем гнездо и теперь, сидя на отложенных яйцах, беспокойно озиралась, провожала глазками двух торопливо шагающих в урман людей."
                            }
                        ]
                    }
