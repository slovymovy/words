                "senses": [
                    {
                        "sense_id": "c7166a63-dd28-3d91-bb09-4c2c9827f901",
                        "entry_id": "33e6ba0a-8a2d-3c5b-bcff-a132588974ba",
                        "glosses": [
                            "Rendre stupide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8fa1d47-9beb-4a3b-ae62-8f54ae0d2ee6",
                                "sense_id": "c7166a63-dd28-3d91-bb09-4c2c9827f901",
                                "text": "Je vais réduire le budget réservé à l'école et imposer des programmes médiocres pour « stupidiser » vos enfants."
                            },
                            {
                                "example_id": "271fe42f-5af9-4182-b60c-2e5239a11ca7",
                                "sense_id": "c7166a63-dd28-3d91-bb09-4c2c9827f901",
                                "text": "Moi non plus, d'ailleurs je ne comprend plus le rap français. C'est devenu une machine à stupidiser les jeunes."
                            },
                            {
                                "example_id": "ce4fae3c-34ae-4556-9878-df954d6ea79d",
                                "sense_id": "c7166a63-dd28-3d91-bb09-4c2c9827f901",
                                "text": "Il est obligatoire pour ne pas se stupidiser d'avoir un sens critique existant avant tout."
                            }
                        ]
                    }
                ],
