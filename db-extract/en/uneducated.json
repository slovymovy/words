                                        "sense_id": "0d98b460-32ba-3e6e-81a4-7955e08a601c",
                                        "entry_id": "17e7cb41-94e4-3b24-8e6a-3ab4b6f78f97",
                                        "glosses": [
                                            "van een persoon dat deze geen (vak)opleiding heeft genoten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58bc1ead-1a65-4ef6-ac5d-c31ccd6b4e67",
                                                "sense_id": "0d98b460-32ba-3e6e-81a4-7955e08a601c",
                                                "text": "Arm, ongeschoold en ongezond: ook Duitsland heeft zijn Borinage: Pirmasens schafft es (nicht): Het stadje Pirmasens in de Duitse Palts rijgt de trieste records aaneen: hoge werkloosheid, hoge schuldenlast, veel schooluitval en kansarmoede. Maar de stad en haar inwoners blijven niet bij de pakken zitten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bee450f4-510a-3061-9fd4-8c3764b9bb54",
                                        "entry_id": "17e7cb41-94e4-3b24-8e6a-3ab4b6f78f97",
                                        "glosses": [
                                            "van arbeid dat er geen speciale opleiding voor nodig is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "646c0239-e7ee-4d25-abfa-44f67eba4c5f",
                                                "sense_id": "bee450f4-510a-3061-9fd4-8c3764b9bb54",
                                                "text": "UWV meldt op dit moment 787 vacatures in Twente van vaklieden in de bouw. Een toename van bijna tweehonderd ten opzichte van begin dit jaar. De stijging van ongeschoolde hulpkrachten is nog veel groter. Daarvan kunnen er nu in de Twentse bouw- en industriesector tezamen direct 309 aan het werk, tegen 144 in januari van dit jaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d8d5fd-a157-373c-b768-f689d94a2512",
                                        "entry_id": "17e7cb41-94e4-3b24-8e6a-3ab4b6f78f97",
                                        "glosses": [
                                            "van een zangstem dat deze niet door scholing gevormd is"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fe5e63e-b780-446b-b1da-314f5f0a1fee",
                        "source_entry_id": "d14e7a02-c95b-3411-8d1b-421b22328c87",
                        "source_sense_id": "5ded63c9-2ba5-3ccb-9d73-062dfd145b71",
                        "source_sense_description": "not educated",
                        "target_lang_word": "inculte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inculte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71203fc9-2cc5-314b-a0b3-1f5ba512183c",
                                        "entry_id": "73ef9c7f-5d69-3920-bb2a-29800d09cf6e",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f2a392c-812c-4062-99db-cfb1fccefc33",
                                                "sense_id": "71203fc9-2cc5-314b-a0b3-1f5ba512183c",
                                                "text": "En pratique, les violences de populations ulcérées de se voir retirer des incultes indispensables au pâturage de leurs bestiaux sont quotidiennes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inculte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "714d690f-3027-33ba-b09a-02d8d57fbf4c",
                                        "entry_id": "423cbbee-6451-30c3-97a5-6ac3aaec1da7",
                                        "glosses": [
                                            "Qui n’est pas cultivé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c57dd839-0757-470b-ae43-18bb8a66000f",
                                                "sense_id": "714d690f-3027-33ba-b09a-02d8d57fbf4c",
                                                "text": "Des trois bandes ou régions qui divisaient devant nous la plaine d’Athènes, nous traversâmes les deux premières, la région inculte et la région cultivée."
                                            },
                                            {
                                                "example_id": "3d4b26aa-064a-4dc2-8215-5986e247b505",
                                                "sense_id": "714d690f-3027-33ba-b09a-02d8d57fbf4c",
                                                "text": "Les plaines incultes succèdent aux champs de maïs."
                                            },
                                            {
                                                "example_id": "4a542ac9-cb02-4a41-9d01-e20c56b24b60",
                                                "sense_id": "714d690f-3027-33ba-b09a-02d8d57fbf4c",
                                                "text": "Vous avez pu constater que, sauf un lopin de terre où le jardinier sème des plants de carottes et de choux pour la table de sa Grandeur, tout le jardin est inculte ; c’est du bien perdu et sans profit pour personne."
                                            },
                                            {
                                                "example_id": "f8ee93d9-c9c1-436d-a22f-f9953cddce8d",
                                                "sense_id": "714d690f-3027-33ba-b09a-02d8d57fbf4c",
                                                "text": "Les cadres administratifs et sociaux étaient détruits, les kasbas et les gottas (fermes) en ruines, les champs incultes, les silos vides, les marchés abandonnés, les pistes désertes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dd712b-fc8a-3157-80d2-6deb79bd4db3",
                                        "entry_id": "423cbbee-6451-30c3-97a5-6ac3aaec1da7",
                                        "glosses": [
                                            "Qui n’est pas arrangé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39dcec52-5a54-4322-8906-459ee003ecbc",
                                                "sense_id": "60dd712b-fc8a-3157-80d2-6deb79bd4db3",
                                                "text": "La première scène qui s'offre à nos yeux est une scène de carnage : des hommes roux, aux cheveux incultes, armés de coutelas, les bras nus et rouges de sang, éventrent des morues fraîches et les décapitent; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "031ace5a-1de3-3c11-ab60-81544ebebdfe",
                                        "entry_id": "423cbbee-6451-30c3-97a5-6ac3aaec1da7",
                                        "glosses": [
                                            "Qui est dépourvu de culture ou d’éducation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da22d1c3-e19c-4308-aab9-08856fd3a8a1",
                                                "sense_id": "031ace5a-1de3-3c11-ab60-81544ebebdfe",
                                                "text": "Une sourde lutte qui se traduit en toutes choses dans la vie quotidienne met sans cesse en présence les 85 % de déshérités et les 15 % de privilégiés, qui se sentent des usurpateurs, incultes au surplus, souvent incapables de diriger ce qu’ils devraient savoir diriger pour justifier leur existence."
                                            },
                                            {
                                                "example_id": "1e55587c-76c3-4304-9968-46c7c12156f9",
                                                "sense_id": "031ace5a-1de3-3c11-ab60-81544ebebdfe",
                                                "text": "Pour Suzanne, les Saint-Victoriens étaient tous des connards incultes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
