                    "sense_definition": "A diminutive of the male given name Friedrich.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The young boy named <w>Fritz</w> played in the garden all afternoon.",
                            "target_lang_translations": {
