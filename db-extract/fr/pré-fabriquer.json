                ],
                "senses": [
                    {
                        "sense_id": "0987ffa5-89ed-3eda-90f0-3657bf47d361",
                        "entry_id": "6afda6f7-dcb6-3cab-a3b7-de4b2dfdda74",
                        "glosses": [
                            "Autre orthographe, moins courante, et qui peut être utilisée pour insister sur le préfixe, de préfabriquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d83750b-3663-4747-b22e-8b52860d2ea4",
                                "sense_id": "0987ffa5-89ed-3eda-90f0-3657bf47d361",
                                "text": "Ainsi le groupe d’habitation concentré, les pièces d’étude, la chambre à coucher suspendues nous font apercevoir la possibilité de voir pré-fabriquer en série non plus la maison entière, mais des unités distinctes (unités-pièces)."
                            },
                            {
                                "example_id": "b416044f-053a-4569-90e7-287612b6cdd7",
                                "sense_id": "0987ffa5-89ed-3eda-90f0-3657bf47d361",
                                "text": "Par conséquent, le programmeur/designer ne peut se contenter de fabriquer un univers digital clé en main, de fournir à l’utilisateur des outils et un mode d’emploi, de lui pré-fabriquer son rapport à son média."
                            },
                            {
                                "example_id": "94e28a8b-8bfb-42d1-95bf-3991cb55536a",
                                "sense_id": "0987ffa5-89ed-3eda-90f0-3657bf47d361",
                                "text": "Et ceci étant le cas, il vaudrait mieux se taire et non pré-fabriquer du doute dans les esprits des gens…"
                            }
                        ]
                    }
                ],
