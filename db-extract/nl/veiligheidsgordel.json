                        "source_entry_id": "2cb677cc-9690-34ae-b077-e334841fdcf3",
                        "source_sense_id": "b0c2906c-4b0b-301f-8263-2b2d0005b8c1",
                        "source_sense_description": "een stevige band die iemand in een voer- of vliegtuig vasthoudt in zijn zetel ter bescherming tegen onverhoedse bewegingen",
                        "target_lang_word": "ceinture de sécurité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
