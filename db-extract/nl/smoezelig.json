                                    {
                                        "sense_id": "12bbc9e7-44f5-3dc7-90c1-1e9f904d725a",
                                        "entry_id": "aac73de8-cb80-3584-b89e-94b0441822b1",
                                        "glosses": [
                                            "Sloppy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c264ec3a-02e6-473d-9827-5c8734a07bba",
                                                "sense_id": "12bbc9e7-44f5-3dc7-90c1-1e9f904d725a",
                                                "text": "I have never seen such an untidy bedroom!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a42da22a-7219-34a9-ba16-486ccab2bd74",
                                        "entry_id": "aac73de8-cb80-3584-b89e-94b0441822b1",
                                        "glosses": [
                                            "Disorganized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2a2af2-541c-4150-8509-dc5b3a7b10cd",
                                                "sense_id": "a42da22a-7219-34a9-ba16-486ccab2bd74",
                                                "text": "His finances were in an untidy state when he died."
                                            },
                                            {
                                                "example_id": "1e31cc01-4ae2-4888-aba7-74d8dad92d4f",
                                                "sense_id": "a42da22a-7219-34a9-ba16-486ccab2bd74",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "untidy",
