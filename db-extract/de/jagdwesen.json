                "translations": [
                    {
                        "translation_id": "e4fbc6bc-ba04-43ec-ab6f-7bc67f82635d",
                        "source_entry_id": "4f3421a2-8f47-3854-b4c7-888ea2de9426",
                        "source_sense_id": "bb291d1b-2f12-372c-ab1c-e90880005f85",
                        "source_sense_description": "Gesamtheit der Dinge, die mit der Jagd, ihrem Brauchtum, ihren Gesetzen und Ähnlichem zusammenhängen",
                        "target_lang_word": "chasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3954bcff-799e-329c-ada8-8bfb3e7eee73",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Action de chasser, c’est-à-dire poursuivre pour capturer ou tuer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d39e5751-a2a4-4dfd-a119-fc4a2dda8634",
                                                "sense_id": "3954bcff-799e-329c-ada8-8bfb3e7eee73",
                                                "text": "Entre autres manies, mon oncle avait celle de tuer tous les chats qu’il rencontrait. Il faisait, à ces pauvres bêtes, une chasse impitoyable, une guerre acharnée de trappeur."
                                            },
                                            {
                                                "example_id": "6d79e3b9-44d6-4d52-bd9e-d63d7d42c393",
                                                "sense_id": "3954bcff-799e-329c-ada8-8bfb3e7eee73",
                                                "text": "Le chimpanzé est omnivore, et il est occasionnellement carnivore. Il pratique occasionnellement la chasse et l’on peut voir se manifester à la fois coopération et stratégie d’encerclement et de diversion dans la chasse aux petits potamochères."
                                            },
                                            {
                                                "example_id": "974418e9-1ddf-4f23-ac2f-26bc35f61535",
                                                "sense_id": "3954bcff-799e-329c-ada8-8bfb3e7eee73",
                                                "text": "Quelques chiffres donneront l'idée des prises que la police peut faire sur les chiens errants des grandes villes et montreront combien son action peut être efficace à diminuer, par une chasse régulière, le nombre des chiens errants qui peuvent devenir les propagateurs de la rage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f15b9b6-e86e-3799-ac9f-6cdb09cb73ea",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Activité humaine qui consiste à poursuivre ou surveiller le gibier en forêt ou en nature pour le tuer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10c68541-4878-495d-9265-4fc3102ec678",
                                                "sense_id": "4f15b9b6-e86e-3799-ac9f-6cdb09cb73ea",
                                                "text": "Un gentilhomme croit sincèrement qu'il y a quelque chose de grand et de noble à la chasse ; il dira que c'est un plaisir royal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef50c47-1613-36a7-a22e-5a7f8bca4a52",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Réserve, terre ou domaine consacré à la chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f366465-8ddb-41e9-8c5f-ee37a8d07d29",
                                                "sense_id": "fef50c47-1613-36a7-a22e-5a7f8bca4a52",
                                                "text": "Ce propriétaire a une belle chasse."
                                            },
                                            {
                                                "example_id": "cd409318-3a63-42ca-abe1-b39db4bf8290",
                                                "sense_id": "fef50c47-1613-36a7-a22e-5a7f8bca4a52",
                                                "text": "Il a loué une chasse."
                                            },
                                            {
                                                "example_id": "0299747c-aa48-4b44-a0e4-f9c8cd44912c",
                                                "sense_id": "fef50c47-1613-36a7-a22e-5a7f8bca4a52",
                                                "text": "Chasse réservée, gardée."
                                            },
                                            {
                                                "example_id": "da973f58-dd8b-4625-a02d-8e9a4cd11bfd",
                                                "sense_id": "fef50c47-1613-36a7-a22e-5a7f8bca4a52",
                                                "text": "Les chasses de ce domaine sont abondamment fournies de gibier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c659bf-636c-326d-892a-a1a31e2f3d8c",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Collectivement, les chasseurs, les chiens et tout l’équipage qui chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe4f0b4-81d0-4bb8-a82e-e3399ec95b9d",
                                                "sense_id": "d2c659bf-636c-326d-892a-a1a31e2f3d8c",
                                                "text": "La chasse est loin, est près."
                                            },
                                            {
                                                "example_id": "4b3eec6a-8d17-4e79-9dbc-cd4adc6f6f38",
                                                "sense_id": "d2c659bf-636c-326d-892a-a1a31e2f3d8c",
                                                "text": "La chasse a passé par là."
                                            },
                                            {
                                                "example_id": "75a96b84-c141-4d5f-89a2-299c0504882b",
                                                "sense_id": "d2c659bf-636c-326d-892a-a1a31e2f3d8c",
                                                "text": "Suivre la chasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fe44a0b-91e2-3a93-aa9d-138e28414c59",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Gibier que l’on prend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13741abb-cdba-45e4-8f51-833be3ebfe66",
                                                "sense_id": "4fe44a0b-91e2-3a93-aa9d-138e28414c59",
                                                "text": "Je vous enverrai de ma chasse."
                                            },
                                            {
                                                "example_id": "da42892e-37c4-476c-804a-669ed2e5544a",
                                                "sense_id": "4fe44a0b-91e2-3a93-aa9d-138e28414c59",
                                                "text": "Faites-nous manger de votre chasse."
                                            },
                                            {
                                                "example_id": "4d733ed5-6358-4c3f-971c-c05a743a35c0",
                                                "sense_id": "4fe44a0b-91e2-3a93-aa9d-138e28414c59",
                                                "text": "À plusieurs broches superposées, que faisait mouvoir un chien se démenant comme un possédé à l’intérieur d’une roue, se doraient des chapelets d’oies, de poulardes et de coqs vierges, brunissaient des quartiers de bœuf, roussissaient des longes de veaux, sans compter les perdrix, bécassines, cailles et autres menues chasses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74310d44-4471-3208-b7bb-7b1f35495345",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Poursuite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d47f6bf-bbba-493d-adc2-43f52c151e12",
                                                "sense_id": "74310d44-4471-3208-b7bb-7b1f35495345",
                                                "text": "— Ah, oui ! Tu continues d'espérer. La chasse aux yoyettes, c'est de la pure loterie. Dénicher l’oiseau rare équivaut à gagner le jackpot au loto ou au tiercé."
                                            },
                                            {
                                                "example_id": "2281ee1c-98c7-4301-8e6b-ed70c25b7dc4",
                                                "sense_id": "74310d44-4471-3208-b7bb-7b1f35495345",
                                                "text": "Appuyer une chasse : Poursuivre vigoureusement."
                                            },
                                            {
                                                "example_id": "cae0ae22-4e84-46a6-90da-4b08da073b03",
                                                "sense_id": "74310d44-4471-3208-b7bb-7b1f35495345",
                                                "text": "Soutenir la chasse : Seconder le vaisseau qui donne chasse ; et, dans un autre sens, fuir à égalité de marche sans être joint par l’ennemi."
                                            },
                                            {
                                                "example_id": "a59d0ee8-5a34-418f-aad6-4657951532a2",
                                                "sense_id": "74310d44-4471-3208-b7bb-7b1f35495345",
                                                "text": "Lever, abandonner la chasse, etc."
                                            },
                                            {
                                                "example_id": "e3814e43-3e0d-49a4-a82b-b4ae6d57dded",
                                                "sense_id": "74310d44-4471-3208-b7bb-7b1f35495345",
                                                "text": "Être en chasse : Se dit de la femelle de certains animaux à l’époque où elle recherche le mâle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b14ffdb-eef3-3bbb-ab9a-3eadb42c6a93",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Dimension variable d’un caractère typographique, mesurée dans un plan parallèle à la surface imprimante parallèlement à la ligne de base."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f683caa1-139e-3d3b-abe3-2c20956fea5f",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Facilité plus ou moins grande qu’une voiture, ou tout autre véhicule, a de se porter en avant."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5b8e66c-ea07-4686-8b79-f94d4b464a93",
                                                "sense_id": "f683caa1-139e-3d3b-abe3-2c20956fea5f",
                                                "text": "Ce cabriolet n’a pas assez de chasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f156e679-d352-3017-bb0b-44c779ba57e1",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Jeu, liberté de course qu’on laisse à quelques parties d’une machine, pour qu’elle puisse se prêter à des irrégularités accidentelles de force et de mouvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba1c0f3-281a-44d5-bcab-053169b7a2c6",
                                                "sense_id": "f156e679-d352-3017-bb0b-44c779ba57e1",
                                                "text": "Il ne faut ni trop ni trop peu de chasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3f510a3-18a7-3a66-baea-85e92249dfd3",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Jeu, liberté de course qu’on laisse à quelques parties d’une machine, pour qu’elle puisse se prêter à des irrégularités accidentelles de force et de mouvement.",
                                            "Écart entre l’axe des roues et le pivot de direction qui permet le réalignement automatiquement des roues avant d’une voiture dès que l’on lâche le volant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4226bd7-fb76-4d4d-a820-264e143e7ee7",
                                                "sense_id": "c3f510a3-18a7-3a66-baea-85e92249dfd3",
                                                "text": "Cet axe est caractérisé par deux angles principaux : l'angle de chasse géométrique et l'angle du pivot. Cette géométrie particulière donne naissance à un moment, quand le pneumatique est soumis à des sollicitations transversales qui tend à ramener la roue dans son plan vertical, d'où l'appellation «moment d'auto-alignement»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98c4c664-5c3c-322b-8a59-50ef1194a735",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Courant artificiel que l’on produit dans les ports pour dégager le chenal des sables qu’y apportent les marées."
                                        ],
                                        "tags": [
                                            "Ponts et chaussées"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66c101d8-7762-362f-b03d-8bd4b0c2deab",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Chasse d’eau."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "236a589d-a382-4086-b96f-d5a0890803a3",
                                                "sense_id": "66c101d8-7762-362f-b03d-8bd4b0c2deab",
                                                "text": "Tirer la chasse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b67367c2-0674-3f7e-a8db-74241dcb21bd",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Matériau explosif permettant de propulser une charge utile."
                                        ],
                                        "tags": [
                                            "Pyrotechnie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80231b00-4a57-3512-bcb4-86ff0b3bad2e",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Combat entre ou contre des animaux sauvages dans les jeux du cirque."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f829a21-11ad-4af1-bea6-50e7c90088db",
                                                "sense_id": "80231b00-4a57-3512-bcb4-86ff0b3bad2e",
                                                "text": "C'est un jour de festivités ordinaires à Rome. Demain, l'édile en charge des jeux a promis une venatio, une « chasse », et chacun espère que les décors seront à la hauteur des promesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9f646ed-d1f8-3b86-b05d-b256c223b9ad",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Au cricket ce sont les actions que fait l'équipe qui lance la balle, pour pouvoir la récupérer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89613b62-14c0-39ef-a31e-1476c4c8581f",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Chemin dans le bocage."
                                        ],
                                        "tags": [
                                            "Normandie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13ea2077-922e-426a-bc92-477a8e85d366",
                                                "sense_id": "89613b62-14c0-39ef-a31e-1476c4c8581f",
                                                "text": "De nos jours, de nombreuses chasses sont goudronnées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a833f2a-6a61-35f5-8311-e1bae347b936",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Ensemble des avions de chasse d'un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca6bae1-5c44-40d6-9962-9ff83f9a17c9",
                                                "sense_id": "3a833f2a-6a61-35f5-8311-e1bae347b936",
                                                "text": "En partant de l'aérodrome de Gordon's Tree, à Khartoum, on ne rencontrait plus la chasse italienne et les quelques volutes de fumée des canons anti-aériens que l'on apercevait à l'horizon ressemblaient aux derniers soupirs d'un vaincu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d23d6ea5-4ef8-3eec-972b-6de453beabb7",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Partie de carton débordant du volume en tête ou en queue ou en gouttière."
                                        ],
                                        "tags": [
                                            "Reliure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e1850ca-a676-41e0-9b63-da4ff9e9b7fa",
                                                "sense_id": "d23d6ea5-4ef8-3eec-972b-6de453beabb7",
                                                "text": "Nine parla des livres, des coiffes, des cuirs, des nerfs et des signets, des chasses de queue et des chants du plat, Hélène éclata de rire, Nine se joignit à elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84ac5df1-86f4-30e5-9352-8b8ae6abf096",
                                        "entry_id": "58c17e04-5c35-39d2-bc43-5fee14fc0ea1",
                                        "glosses": [
                                            "Outil de carrier servant à polir ou creuser une pierre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad5b750-b3d3-4fc2-be5f-f140ede42451",
                                                "sense_id": "84ac5df1-86f4-30e5-9352-8b8ae6abf096",
                                                "text": "Avec sa chasse et sa massette[sorte de marteau], il s creusé la roche et s'est aménagé une couche de branchages, de fleurs et de fougères selon ses envies."
                                            }
                                        ]
                                    }
                                ]
                            },
