                ],
                "senses": [
                    {
                        "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                        "entry_id": "ebe50d8f-1c9e-3e63-9526-ed56dc487e90",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3665e41-f1c5-46fe-bbaf-b5b4df411c4d",
                                "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                                "text": "Frau Bäuerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9a1a32f3-bf00-4e26-be35-4f78d60af6f9",
                                "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                                "text": "Herr Bäuerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "604b3676-47ad-4d9a-8bbd-696ee650cfe9",
                                "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                                "text": "Die Bäuerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ed67fd49-77fb-4d3a-bc5a-775cc32d3c4f",
                                "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                                "text": "Der Bäuerle trägt nie die Pullover, die die Bäuerle ihm strickt."
                            },
                            {
                                "example_id": "ca23541a-002e-4ea7-99f9-72ccf1bac5b9",
                                "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bäuerle kommt, geht der Herr Bäuerle.“"
                            },
                            {
                                "example_id": "06787078-40bf-447e-b938-2927fe23ab28",
                                "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                                "text": "Bäuerle kommt und geht."
                            },
                            {
                                "example_id": "a80fa5a2-6ac4-4c4e-b34d-83754edaaeca",
                                "sense_id": "83322d1f-10c2-39be-ae5c-edc4bf8dcea6",
                                "text": "Bäuerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
