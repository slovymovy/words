                        "sense_id": "fe4e27ed-8ed6-3616-b68d-b2eddfec2f83",
                        "entry_id": "81e827dd-6141-362c-b110-1754b948acb0",
                        "glosses": [
                            "мужское отчество от имени Пётр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59374dcb-e8c5-4b99-aeb0-3b4d4d1c02ac",
                                "sense_id": "fe4e27ed-8ed6-3616-b68d-b2eddfec2f83",
                                "text": "Но Иван Петрович сам уже выходил, приподнимая рукой занавеску."
                            },
                            {
                                "example_id": "e9fc45a2-d955-4833-99db-8d1e98cb7491",
                                "sense_id": "fe4e27ed-8ed6-3616-b68d-b2eddfec2f83",
                                "text": "― Василий Петрович, ― сказал есаул, подойдя к майору, ― он не сдастся ― я его знаю."
                            }
                        ]
                    }
                ],
