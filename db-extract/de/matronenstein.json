                "senses": [
                    {
                        "sense_id": "0f230f83-b62a-313d-9d7e-1ad329e99a12",
                        "entry_id": "5d55262d-3291-38aa-9304-a787ca07f69e",
                        "glosses": [
                            "gehauene Steintafel mit drei Matronen, oft mit farblicher Gestaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7db2d04-a9fd-4920-a6b4-9c26db415379",
                                "sense_id": "0f230f83-b62a-313d-9d7e-1ad329e99a12",
                                "text": "„Fast für jede ältere Ortschaft in der Euskirchener Gegend ist der Kult der Matronen durch den Fund von Matronensteinen bezeugt.“"
                            },
                            {
                                "example_id": "fb5bc84f-91aa-4b43-a1b1-d62cccca011a",
                                "sense_id": "0f230f83-b62a-313d-9d7e-1ad329e99a12",
                                "text": "„Matronenstein unter Altarmensa entdeckt“"
                            },
                            {
                                "example_id": "3b3b15d6-a70a-4cac-9704-aa3994cb60eb",
                                "sense_id": "0f230f83-b62a-313d-9d7e-1ad329e99a12",
                                "text": "„Obwohl die Stifter der Steine vermutlich keltischer, römischer und germanischer Herkunft waren, tragen alle Matronensteine lateinische Inschriften und latinisierte Namen.“"
                            },
                            {
                                "example_id": "fbbe07b8-2df4-48ab-a13d-6c4981b8da4b",
                                "sense_id": "0f230f83-b62a-313d-9d7e-1ad329e99a12",
                                "text": "„Der Grumbacher Matronenstein zeigt denselben Stil wie die Altäre in Bonn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
