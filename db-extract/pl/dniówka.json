                                "sense_id": "356655d0-7f79-3ea0-940f-3a9549d413cf",
                                "text": "Zenek nie ma stałej pracy. Pracuje na dniówki po różnych budowach."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
