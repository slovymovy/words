                "senses": [
                    {
                        "sense_id": "23a03f43-97d4-3153-899c-f5245c5ca837",
                        "entry_id": "4e8f8946-9530-3f5b-9113-5f5131c929f2",
                        "glosses": [
                            "Withered; lean and wrinkled by shrinkage as from age or illness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48039294-7005-486a-862a-32fa6906b92a",
                                "sense_id": "23a03f43-97d4-3153-899c-f5245c5ca837",
                                "text": "\"Ill-fard, crazy, crack-brained gowk, that she is!\" exclaimed the housekeeper. . . \"If it hadna been that I am mair than half a gentlewoman by my station, I wad hae tried my ten nails in the wizen'd hide o' her!\""
                            },
                            {
                                "example_id": "2b8e760e-3778-4b0a-b8a7-e9a9bf4a65f1",
                                "sense_id": "23a03f43-97d4-3153-899c-f5245c5ca837",
                                "text": "He was old, too, wizened with age, and the hair on his face was gray."
                            },
                            {
                                "example_id": "4e1d4a8c-c0a1-4d60-b5df-b319ce628401",
                                "sense_id": "23a03f43-97d4-3153-899c-f5245c5ca837",
                                "text": "In the simple fable about old age reconciling itself to memory and destiny, Mastroianni wears the wizened smile of a man who knows he is visiting his youth for the last time."
                            }
                        ]
                    }
                ],
