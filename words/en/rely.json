{
    "word_family": [
        "reliable",
        "reliability",
        "reliance",
        "reliant",
        "unreliable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5e66248-be64-3c79-b7d8-777959c0ae0c",
                    "sense_definition": "To trust, have confidence in, or depend on someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>rely</w> on public transport to get to work every day.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>полагаются</w> на общественный транспорт, чтобы каждый день добираться на работу.",
                                "zh": "许多人每天都<w>依靠</w>公共交通工具去上班。"
                            }
                        },
                        {
                            "text": "You can always <w>rely</w> on him to help when you are in trouble.",
                            "target_lang_translations": {
                                "ru": "Ты всегда можешь <w>положиться</w> на него, если попадешь в беду.",
                                "zh": "当你遇到困难时，总可以<w>信赖</w>他来帮忙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "depend",
                        "lean",
                        "trust",
                        "count on"
                    ],
                    "antonyms": [
                        "stand on its own"
                    ],
                    "common_phrases": [
                        "rely on",
                        "rely upon",
                        "rely heavily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доверять, быть уверенным в ком-либо или зависеть от кого-либо или чего-либо.",
                        "zh": "信任、信赖某人或某事，或者依靠某人或某事提供帮助或支持。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полагаться",
                                "target_lang_sense_clarification": "доверяться кому-либо или надеяться на что-либо"
                            },
                            {
                                "target_lang_word": "рассчитывать",
                                "target_lang_sense_clarification": "возлагать надежды, ожидать помощи"
                            },
                            {
                                "target_lang_word": "положиться",
                                "target_lang_sense_clarification": "довериться (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "依靠",
                                "target_lang_sense_clarification": "指依赖某人或某物来维持生活或完成任务"
                            },
                            {
                                "target_lang_word": "信赖",
                                "target_lang_sense_clarification": "指信任并依靠某人"
                            },
                            {
                                "target_lang_word": "指望",
                                "target_lang_sense_clarification": "指把希望寄托在某人或某事上"
                            }
                        ]
                    }
                }
            ]
        }
    ]
