                                "target_senses": [
                                    {
                                        "sense_id": "a929f505-4421-3842-b4cb-81d8225eedbb",
                                        "entry_id": "a0c14792-0806-3e6c-a0d9-e00ff7d5344a",
                                        "glosses": [
                                            "Ensemble de pièces formant une habitation indépendante dans un immeuble collectif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29e56cd-605a-4642-be40-ed09fff5c033",
                                                "sense_id": "a929f505-4421-3842-b4cb-81d8225eedbb",
                                                "text": "Elle avait dans sa poche la clef de la porte de la rue, la clé de l’appartement que vous voyez, des allumettes et un rat de cave pour monter l'escalier, car la maison était déjà abandonnée."
                                            },
                                            {
                                                "example_id": "c1758e53-9901-495b-9b46-f15bb9fb3c6b",
                                                "sense_id": "a929f505-4421-3842-b4cb-81d8225eedbb",
                                                "text": "Elle partait pour un mois en Belgique voir sa mère et me demandait comme un service de bien vouloir occuper son appartement en son absence, afin d'arroser les plantes vertes."
                                            },
                                            {
                                                "example_id": "9d14ae0f-d37e-4ba3-9ace-5a0553035607",
                                                "sense_id": "a929f505-4421-3842-b4cb-81d8225eedbb",
                                                "text": "Les gens aisés ont peur. Ils patientent, avant de faire retapisser leurs appartements."
                                            },
                                            {
                                                "example_id": "47b21886-6b68-44ff-8627-a5485753ee03",
                                                "sense_id": "a929f505-4421-3842-b4cb-81d8225eedbb",
                                                "text": "Des devis vont être également demandés à des entreprises afin de changer certains éléments vétustes de six appartements : les baignoires à remplacer par des douches à l’italienne, des lavabos, des éviers et la robinetterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256ec37d-00f6-3f75-83f7-a4b758d9957a",
                                        "entry_id": "a0c14792-0806-3e6c-a0d9-e00ff7d5344a",
                                        "glosses": [
                                            "Pièce où l’on a ses habitudes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac634ae4-31c8-4bb8-84d1-dfdbe874b65d",
                                                "sense_id": "256ec37d-00f6-3f75-83f7-a4b758d9957a",
                                                "text": "S’enfermer chaque soir dans un sale appartement public, pour y taper sur des tables de marbre de petits os de mouton marqués de points noirs, lui semblait un acte précieux de sa liberté, qui le rehaussait d’estime vis-à-vis de lui-même."
                                            },
                                            {
                                                "example_id": "605410f0-0ef7-4f0e-b1c2-8ab8212f0172",
                                                "sense_id": "256ec37d-00f6-3f75-83f7-a4b758d9957a",
                                                "text": "Et voici vos appartements, senor commodore : j'espère que vous vous y plairez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfd6a0ed-3741-3303-802e-53d20ea6f5e9",
                                        "entry_id": "a0c14792-0806-3e6c-a0d9-e00ff7d5344a",
                                        "glosses": [
                                            "Pièce d'une maison ou d'un logement locatif."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b51f8624-300b-4d4f-9fd6-8cf55ad1eacc",
                                                "sense_id": "dfd6a0ed-3741-3303-802e-53d20ea6f5e9",
                                                "text": "Un logement à quatre appartements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
