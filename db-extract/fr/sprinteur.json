                    {
                        "sense_id": "6edafd79-a0f0-3397-9a07-12a7c8e2e725",
                        "entry_id": "6477646b-477a-3fa6-9035-6d36bbd7efaf",
                        "glosses": [
                            "Personne spécialisée dans le sprint, surtout comme sportif professionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05136d61-7161-4bab-b406-3d034f8b4868",
                                "sense_id": "6edafd79-a0f0-3397-9a07-12a7c8e2e725",
                                "text": "Le sprinteur français Bryan Coquard a remporté une deuxième étape en trois jours sur la Région Pays de la Loire Tour, jeudi, après avoir été impliqué dans une chute massive sur l’étape précédente."
                            },
                            {
                                "example_id": "414e449a-9bc6-436b-9848-4516820c3d4a",
                                "sense_id": "6edafd79-a0f0-3397-9a07-12a7c8e2e725",
                                "text": "Parmi les sprinteurs, c’est le Danois Mads Pedersen qui a été le plus fort."
                            },
                            {
                                "example_id": "39a9c525-38e5-4cc0-b7a2-bbce19eb633d",
                                "sense_id": "6edafd79-a0f0-3397-9a07-12a7c8e2e725",
                                "text": "Le sprinteur australien Caleb Ewan (Lotto-Dstny) a abandonné le Tour de France hier."
                            }
                        ]
                    }
