                                        "glosses": [
                                            "Eucalyptus L'Hér., drzewo lub krzew o wiecznie zielonych liściach rosnące w Australii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "936b382b-4849-42e7-a24e-b42bd735f31b",
                                                "sense_id": "d331400d-2504-360c-8a44-477a2c82707e",
                                                "text": "Szerokie doliny leżące między łagodnymi pagórkami porośnięte były skrubem, to jest krzaczastą, kłującą gęstwiną wiecznie zielonych skarłowaciałych akacji i eukaliptusów"
                                            }
