                                "sense_id": "68058aec-11c3-3867-aaf1-5c0681003409",
                                "text": "Hij houdt zijn werkplek altijd schoon en opgeruimd.",
                                "translation": "He always keeps his workplace clean and tidy.",
                                "english": "He always keeps his workplace clean and tidy."
                            },
                            {
