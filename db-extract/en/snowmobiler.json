                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c20b05c1-1a2f-4ed4-8321-75fa7a0402fc",
                                                "sense_id": "8ffbc64b-029c-3e2d-9653-3893af68e632",
                                                "text": "J’avais presque fait la une quelques jours auparavant, avec ma couverture de l’accident mortel d’un motoneigiste à Cowansville."
                                            },
                                            {
                                                "example_id": "730f0f90-1409-4846-9bdf-b905eeb5d351",
                                                "sense_id": "8ffbc64b-029c-3e2d-9653-3893af68e632",
                                                "text": "Le corps d’un des cinq motoneigistes français portés disparus lors d’une excursion dans le nord du Québec a été repêché hier vendredi 24 janvier 2020."
                                            },
                                            {
                                                "example_id": "052ecb24-d055-4933-807f-56f2453c2b99",
                                                "sense_id": "8ffbc64b-029c-3e2d-9653-3893af68e632",
                                                "text": "On compte plus de 2,5 millions de propriétaires de motoneiges enregistrés dans le monde avec les États américains du Michigan, du Minnesota et du Wisconsin ayant le plus de motoneigistes."
                                            },
                                            {
                                                "example_id": "88c344f8-8a12-485c-89c8-b37b6c46be0e",
                                                "sense_id": "8ffbc64b-029c-3e2d-9653-3893af68e632",
                                                "text": "Les motoneigistes qui parcourent les sentiers de la Gaspésie ont la chance de passer par Cap-Chat où se trouve la plus grande éolienne à axe vertical au monde."
                                            }
                                        ]
                                    }
