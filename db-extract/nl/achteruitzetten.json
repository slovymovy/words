                                        "entry_id": "b7e63c9b-7e48-3ad1-becf-46511ffff4c7",
                                        "glosses": [
                                            "To lower in value or social position."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d71f49-1b00-4c1f-8346-390ab84fb3d6",
                                                "sense_id": "e4c96806-d923-3e77-acff-045635efb0a1",
                                                "text": "Fred degrades himself by his behaviour."
                                            },
                                            {
                                                "example_id": "58b08c04-1d9a-4064-aed7-491fb2fe6517",
                                                "sense_id": "e4c96806-d923-3e77-acff-045635efb0a1",
                                                "text": "[…] [William] Prynne was sentenced by the Star-Chamber Court to be degraded from the bar, to stand in pillory at two places in London and lose an ear at each, to be branded on the forehead, to pay a fine of five thousand pounds, and to be imprisoned for life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b3d9b5-f7ee-3aab-96e2-f3d2266c9910",
                                        "entry_id": "b7e63c9b-7e48-3ad1-becf-46511ffff4c7",
                                        "glosses": [
                                            "To reduce in quality or purity."
                                        ],
