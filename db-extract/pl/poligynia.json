                        "sense_id": "1cba5c93-c5eb-326c-a580-ea0c8f5b35d3",
                        "entry_id": "7c956529-d33d-332f-aa98-e1a517ae9c79",
                        "glosses": [
                            "forma poligamii, w której mężczyzna jest żonaty jednocześnie z dwiema lub więcej kobietami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019aa32f-745c-4d2e-8899-f4fd8a8525c7",
                                "sense_id": "1cba5c93-c5eb-326c-a580-ea0c8f5b35d3",
                                "text": "Można przypuszczać, że głównym motywem akceptacji przez kobietę poligynii jest lęk przed samotnością."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5a489785-4682-3642-ae0b-5aca5e22f5c8",
                        "entry_id": "7c956529-d33d-332f-aa98-e1a517ae9c79",
                        "glosses": [
                            "kojarzenie się w okresie godowym jednego samca z więcej niż jedną samicą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc333d6-046f-4297-863a-1a59f22cc1bf",
                                "sense_id": "5a489785-4682-3642-ae0b-5aca5e22f5c8",
                                "text": "Poligynia występuje powszechnie u wielu gatunków zwierząt, m.in. kuraków, kopytnych."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
