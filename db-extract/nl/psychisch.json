                    }
                ],
                "senses": [
                    {
                        "sense_id": "32c2135a-e08b-394f-8835-7538d2825b7f",
                        "entry_id": "41f6b2b7-0aec-3b92-85af-28a7297e1213",
                        "glosses": [
                            "geestelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d66b059-af95-4c6e-8399-0e9a12cf4ec7",
                                "sense_id": "32c2135a-e08b-394f-8835-7538d2825b7f",
                                "text": "Helft van studenten kampt met psychische klachten"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c068d57-f34c-4773-a8f8-d2df63d4355b",
                        "source_entry_id": "41f6b2b7-0aec-3b92-85af-28a7297e1213",
                        "source_sense_id": "32c2135a-e08b-394f-8835-7538d2825b7f",
                        "source_sense_description": "geestelijk",
                        "target_lang_word": "psychisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                        "entry_id": "f37e9526-6229-3ea3-a224-7189870b9b77",
                                        "glosses": [
                                            "die Psyche betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23f67bef-be39-41b2-9315-a98042304791",
                                                "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                                "text": "Ich bin der Sache psychisch nicht gewachsen."
                                            },
                                            {
                                                "example_id": "99a5ee6a-f270-42f1-8657-2530e141d6b0",
                                                "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                                "text": "„Auf der anderen Seite aber sind psychische Volksleiden auf dem Vormarsch.“"
                                            },
                                            {
                                                "example_id": "b84ad514-201a-46be-8902-47310da4062b",
                                                "sense_id": "82b629f4-65a1-35ad-ba89-a15165a81f83",
                                                "text": "„Die Landung, der technisch anspruchsvollste Teil eines Drachenflugs, wird nicht mehr geschildert, und der Leser fragt sich, wie der psychisch und wohl auch flugtechnisch total überforderte Mann wohl gelandet sein mag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e78ebb3-3f20-4c36-94c0-4a53f8c451df",
                        "source_entry_id": "41f6b2b7-0aec-3b92-85af-28a7297e1213",
                        "source_sense_id": "32c2135a-e08b-394f-8835-7538d2825b7f",
                        "source_sense_description": "geestelijk",
                        "target_lang_word": "seelisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seelisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                        "entry_id": "8cab35e2-06e0-3cf3-b66f-f5fdb1125a8c",
                                        "glosses": [
                                            "die Seele, die innere Verfassung des Menschen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad737e40-f2c4-4d0b-96b6-126489e0cb93",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Seine seelische Verfassung hat unter der Trennung gelitten."
                                            },
                                            {
                                                "example_id": "5cd37300-6319-4f0b-bce1-1c9eabc660df",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Dabei zeigt sich häufig: Nicht körperliche, sondern seelische Ursachen führen zu Schwindel."
                                            },
                                            {
                                                "example_id": "56a20ac1-f7a0-4283-80ce-d4a5262bbf2c",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "\"Ein ausgeglichenes Wesen, keine seelischen Probleme\", hatten die psychologischen Experten befunden."
                                            },
                                            {
                                                "example_id": "c21f8ca5-08b6-47a7-ba9e-a022f09fe941",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Nach der AOK-Studie liegen seelische Störungen mittlerweile an vierter Stelle bei den Ursachen für eine Erkrankung Berufstätiger."
                                            },
                                            {
                                                "example_id": "aa5f3968-179f-4cd8-bee2-b586a683a888",
                                                "sense_id": "42094a17-0077-33f8-92d3-7fa276677f98",
                                                "text": "Es war etwas seelisch Schönes und seelisch Glückliches über sie gekommen, was sie nicht verstand und nicht zu deuten wußte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd80e0a7-d0c3-4de2-b895-bbaea5a822ba",
                        "source_entry_id": "41f6b2b7-0aec-3b92-85af-28a7297e1213",
                        "source_sense_id": "32c2135a-e08b-394f-8835-7538d2825b7f",
                        "source_sense_description": "geestelijk",
                        "target_lang_word": "psychic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0660fadd-dc08-3110-9d83-b9ae07a79998",
                                        "entry_id": "2dfd4cdc-40d3-3e73-97d2-7d1357496d8e",
                                        "glosses": [
                                            "A person who possesses, or appears to possess, extra-sensory abilities such as precognition, clairvoyance, and telepathy, or who appears to be susceptible to paranormal or supernatural influences."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba3ff0df-0da5-37e4-9f49-77ee82024b53",
                                        "entry_id": "2dfd4cdc-40d3-3e73-97d2-7d1357496d8e",
                                        "glosses": [
                                            "A person who supposedly contacts the dead; a medium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76337c70-8b25-3cfc-b519-9f5b4cfab549",
                                        "entry_id": "2dfd4cdc-40d3-3e73-97d2-7d1357496d8e",
                                        "glosses": [
                                            "In gnostic theologian Valentinus' triadic grouping of man the second type; a person focused on intellectual reality (the other two being hylic and pneumatic)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "psychic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4ef9746-5cb3-312d-8a39-519906306df5",
                                        "entry_id": "688d102e-fcfc-3d25-bf33-23048861db73",
                                        "glosses": [
                                            "Relating to or having the abilities of a psychic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561e3af9-4945-4f67-8d19-46ba8e12bc85",
                                                "sense_id": "e4ef9746-5cb3-312d-8a39-519906306df5",
                                                "text": "You must be psychic—I was just about to say that."
                                            },
                                            {
                                                "example_id": "18e5a460-cf2c-4ec0-82e6-0fa03ce3a696",
                                                "sense_id": "e4ef9746-5cb3-312d-8a39-519906306df5",
                                                "text": "She is a psychic person—she hears messages from beyond."
                                            },
                                            {
                                                "example_id": "48454122-7af4-4bca-9d83-9c5483f5628e",
                                                "sense_id": "e4ef9746-5cb3-312d-8a39-519906306df5",
                                                "text": "Having exhausted the sporting adventures of this terrestrial globe, he is now turning to those of the dim, dark and dubious regions of psychic research."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96716a1-9a91-3dfd-8873-1e78b9a3ffc5",
                                        "entry_id": "688d102e-fcfc-3d25-bf33-23048861db73",
                                        "glosses": [
                                            "Relating to the psyche or mind, or to mental activity in general."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d24eb16-0ee4-4708-838f-d538362cd215",
                                                "sense_id": "c96716a1-9a91-3dfd-8873-1e78b9a3ffc5",
                                                "text": "In the following pages I shall demonstrate that there is a psychological technique which makes it possible to interpret dreams, and that on the application of this technique every dream will reveal itself as a psychological structure, full of significance, and one which may be assigned to a specific place in the psychic activities of the waking state."
                                            },
                                            {
                                                "example_id": "d5fa938d-06cb-4af9-8a40-692ed5b5e433",
                                                "sense_id": "c96716a1-9a91-3dfd-8873-1e78b9a3ffc5",
                                                "text": "A pathological process called 'psychiatrosis' may well be found, by the same methods, to be a delineable entity, with somatic correlates, and psychic mechanisms […]"
                                            },
                                            {
                                                "example_id": "066a39d8-a413-4bcc-8d75-03c6e5989744",
                                                "sense_id": "c96716a1-9a91-3dfd-8873-1e78b9a3ffc5",
                                                "text": "Merely by comprehending this, the lack of support that black feminists have for being black feminists, white women might be able to give at least psychic and preferably practical support to black women who they know and not assume that it means the same thing for us to be feminists and lesbians as it does for them to be feminists and lesbians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5caf66cf-2548-4697-be2a-5103f31b20ff",
                        "source_entry_id": "41f6b2b7-0aec-3b92-85af-28a7297e1213",
                        "source_sense_id": "32c2135a-e08b-394f-8835-7538d2825b7f",
                        "source_sense_description": "geestelijk",
                        "target_lang_word": "psychique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e4ea888-428e-3a6e-9add-2dc2c21a84d7",
                                        "entry_id": "0c9d6688-9cbc-3225-81dc-d257c143e056",
                                        "glosses": [
                                            "Relatif au psychisme, à la psyché, à l'esprit en général ; mental au sens large ; (c'est l'objet d'étude de la psychologie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f87b4248-f139-4e8d-a5cc-e3e3a78f96c9",
                                                "sense_id": "0e4ea888-428e-3a6e-9add-2dc2c21a84d7",
                                                "text": "Quand il est amené dans notre clinique, on constate mouvement subfébrile à 37,8 ; albuminurie légère. Au point de vue psychique, dépression avec anxiété et préoccupations hypocondriaques."
                                            },
                                            {
                                                "example_id": "aa229862-18c8-45e0-a695-7a199e6626bd",
                                                "sense_id": "0e4ea888-428e-3a6e-9add-2dc2c21a84d7",
                                                "text": "C'est cet état général d’incertitude intellectuelle qui permet chez beaucoup la persistance d’attitudes doctrinales périmées, irréalistes, sans que l'on puisse faire de leurs égarements des symptômes psycho-pathologiques. […]. Mais on ne doit pas oublier que l’indéfinition des structures sociales crée chez beaucoup un état de trouble psychique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c592ddaa-9cfb-3071-a556-fb31fe5fb13c",
                                        "entry_id": "0c9d6688-9cbc-3225-81dc-d257c143e056",
                                        "glosses": [
                                            "Relatif à l’âme, aux facultés intellectuelles et morales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3d5ea4-6052-4fb0-a0fd-a75a59fcc6b7",
                                                "sense_id": "c592ddaa-9cfb-3071-a556-fb31fe5fb13c",
                                                "text": "Or savez-vous quels sont ses deux instincts naturels, irrésistibles dans l’ordre psychique ? c'est l'amour et la liberté. Ces deux instincts naturels se sont socialement combattus jusqu'à présent ; il a fallu que l'homme immolât ou plutôt subordonnât l'un à l'autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68b1d74e-df3c-48ef-a4cb-12e918a6a715",
