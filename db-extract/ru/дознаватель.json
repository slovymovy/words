                ],
                "senses": [
                    {
                        "sense_id": "ff2fddd6-5488-3a59-a85d-511b12da1967",
                        "entry_id": "24a65a3c-ce85-3761-a01c-300c0e393c35",
                        "glosses": [
                            "должностное лицо органа дознания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b678a1-a325-43f8-8e9b-089add19ef09",
                                "sense_id": "ff2fddd6-5488-3a59-a85d-511b12da1967",
                                "text": "– Господин главный дознаватель… – замешкался комендант. – Бьерри! Почему в рабочей зоне беспорядок?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b703f3-5225-46f3-8bcc-b5494c82aa1b",
                        "source_entry_id": "24a65a3c-ce85-3761-a01c-300c0e393c35",
                        "source_sense_id": "ff2fddd6-5488-3a59-a85d-511b12da1967",
                        "target_lang_word": "enquêteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enquêteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "258574df-fd59-3c37-b604-915e4e8b08ea",
                                        "entry_id": "a9bdd549-9c58-3b02-a0e7-55b2dadca031",
                                        "glosses": [
                                            "Qui enquête"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04886269-7cae-4415-85c2-303b73eb4215",
                                                "sense_id": "258574df-fd59-3c37-b604-915e4e8b08ea",
                                                "text": "Structurés en association, les pénichards se sont mobilisés pour porter un avis commun auprès du commissaire enquêteur."
                                            },
                                            {
                                                "example_id": "96708d7e-4bd6-4f33-b864-b368ed15b895",
                                                "sense_id": "258574df-fd59-3c37-b604-915e4e8b08ea",
                                                "text": "Je vous écris pour vous informer que l’équipe enquêtrice m’en a informé hier, et que j’ai donné mon accord pour que le FBI prenne les mesures d’enquête appropriées […] », poursuit James Comey."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enquêteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7044ecd7-f5a0-3fd5-94bf-bed0f09449ca",
                                        "entry_id": "e70f2536-f0e8-3cbf-8153-a7b05a02edb8",
                                        "glosses": [
                                            "Juge qui était commis pour faire des enquêtes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4968dd5b-7547-49b2-82f8-e2cb6a3ab38f",
                                                "sense_id": "7044ecd7-f5a0-3fd5-94bf-bed0f09449ca",
                                                "text": "« Heremi nullius sunt » : les hermes ne sont à personne, affirment les habitants de Saint-Martin-de-Queyrières, en Briançonnais, aux enquêteurs delphinaux."
                                            },
                                            {
                                                "example_id": "99050c73-fc04-4bb8-a51a-0fec091f4fc8",
                                                "sense_id": "7044ecd7-f5a0-3fd5-94bf-bed0f09449ca",
                                                "text": "Commissaires examinateurs et enquêteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c4dcc79-16ad-3a5d-b5ce-65dfb2751202",
                                        "entry_id": "e70f2536-f0e8-3cbf-8153-a7b05a02edb8",
                                        "glosses": [
                                            "Celui qui est chargé de faire des enquêtes pour la police, une compagnie d’assurances, un bureau de bienfaisance, une œuvre de charité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf237050-f99f-4d7b-976e-062edc760a14",
                                                "sense_id": "7c4dcc79-16ad-3a5d-b5ce-65dfb2751202",
                                                "text": "C’est à une course contre la montre haletante que se livrent les enquêteurs, incarnés par Sandrine Kiberlain, Anaïs Demoustier, Lyna Khoudri, Jean Dujardin et Jérémie Renier."
                                            },
                                            {
                                                "example_id": "a4a797e3-ea67-4452-9c0e-255b019f988f",
                                                "sense_id": "7c4dcc79-16ad-3a5d-b5ce-65dfb2751202",
                                                "text": "Sa coéquipière au PSG, Aminata Diallo, considérée par les enquêteurs comme la commanditaire des violences, a été mise en examen et placée sous contrôle judiciaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6162b215-78c5-35d6-8882-f875892c50e9",
                                        "entry_id": "e70f2536-f0e8-3cbf-8153-a7b05a02edb8",
                                        "glosses": [
                                            "Journaliste qui procède à des enquêtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8691ac21-5d39-4ac9-b87d-2e02e7fe0b97",
                                                "sense_id": "6162b215-78c5-35d6-8882-f875892c50e9",
                                                "text": "Son traitement, sa couverture médiatique pourront être assuré par un fait-diversier, journaliste en charge des faits-divers, un enquêteur spécialisé dans les affaires politico-financières ou un chroniqueur judiciaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "617dfa95-d936-3531-ae78-0a7b7c76b53e",
                                        "entry_id": "e70f2536-f0e8-3cbf-8153-a7b05a02edb8",
                                        "glosses": [
                                            "Celui qui est chargé de faire des enquêtes d’opinion, des sondages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
