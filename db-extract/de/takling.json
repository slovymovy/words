                "senses": [
                    {
                        "sense_id": "efebb306-86f4-3d07-860b-18e536485391",
                        "entry_id": "1cb7c821-79b2-3a6f-a86d-c4030e729b28",
                        "glosses": [
                            "Die Umwicklung eines Seiles oder Tampen mit (dünnerem) Takelgarn, das verhindert, dass das Seil ausfranst oder die Kardeele sich aufdrehen"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "16c4deb3-befa-437a-93d3-b6d4ed1d2d8e",
                                "sense_id": "efebb306-86f4-3d07-860b-18e536485391",
                                "text": "Ein sauberer Takling ist die beste und ansehnlichste Methode, ein Seilende vor dem Aufschlagen zu sichern."
                            },
                            {
                                "example_id": "f4fb6a6d-5b61-4d1b-bf9d-2a4a563857d2",
                                "sense_id": "efebb306-86f4-3d07-860b-18e536485391",
                                "text": "Wer heute noch einen Takling aufsetzen, gar nähen kann, gehört schon zu den großen Ausnahmen unter den Fahrtenseglern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
