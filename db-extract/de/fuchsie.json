                                        "glosses": [
                                            "geslacht, Fuchsia, uit de teunisbloemfamilie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae61152-6e22-4879-8635-74f97c93c1d2",
                                                "sense_id": "9eff81bc-1788-3690-a0b7-c400416d8b73",
                                                "text": "Zij gaf haar buurvrouw een stekje van de fuchsia."
                                            },
                                            {
                                                "example_id": "42e13931-4ada-4310-b0ae-8e8db5456bc3",
                                                "sense_id": "9eff81bc-1788-3690-a0b7-c400416d8b73",
                                                "text": "Kijken naar de natuur is geruststellend, zegt ze, en toont een fuchsia."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fuchsia",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fd135c02-e6f6-3f45-872f-0936c599f3a5",
                                        "entry_id": "cd934e4b-0509-3eee-bcdd-68ff1654b8aa",
                                        "glosses": [
                                            "bepaalde roze kleur, zoals de bloemen van fuchsia's hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a06853-6784-4c93-8328-1c567cee8287",
                                                "sense_id": "fd135c02-e6f6-3f45-872f-0936c599f3a5",
                                                "text": "Heeft u die ook in het fuchsia?"
                                            },
                                            {
                                                "example_id": "9f4acaf7-f82b-4fae-a14d-1be1c85799fa",
                                                "sense_id": "fd135c02-e6f6-3f45-872f-0936c599f3a5",
                                                "text": "Want Van Roosmalen zit in het centrum van Tiel te werken aan het stukje dat hij die avond zal voorlezen en laat weten dat er een smartlappenfestival gaande is, inclusief in fuchsia geklede koren van 65-plussers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
