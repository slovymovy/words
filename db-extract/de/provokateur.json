                    {
                        "sense_id": "872bbec3-e72a-3356-a36d-c9b69d487589",
                        "entry_id": "87267880-fda2-3cad-9d06-790f864d400f",
                        "glosses": [
                            "jemand, der durch sein Verhalten andere herausfordert; der absichtlich für Unfrieden sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd77b642-1a6c-4442-a75b-1f5db01ac1f3",
                                "sense_id": "872bbec3-e72a-3356-a36d-c9b69d487589",
                                "text": "„In unzähligen Fabriken des Landes fanden Kundgebungen gegen den Provokateur und Kriegstreiber Stern statt, das Land wollte Frieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2dfa388-6ddc-41e0-852b-767b721976a5",
                        "source_entry_id": "87267880-fda2-3cad-9d06-790f864d400f",
                        "source_sense_id": "872bbec3-e72a-3356-a36d-c9b69d487589",
                        "source_sense_description": "jemand, der durch sein Verhalten andere herausfordert; der absichtlich für Unfrieden sorgt",
                        "target_lang_word": "provocateur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provocateur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31eb73e4-77d5-31a8-997e-5d8e20aae3c4",
                                        "entry_id": "798bdf61-7425-33fa-8246-e6a6eb4f350f",
                                        "glosses": [
                                            "One who engages in provocative behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b1d0dc-6696-44e0-a571-431d61e96ebb",
                                                "sense_id": "31eb73e4-77d5-31a8-997e-5d8e20aae3c4",
                                                "text": "Near-synonyms: provoker (sometimes synonymous), agitator"
                                            },
                                            {
                                                "example_id": "959623a7-e02a-4bd6-8ee4-187bb48ed623",
                                                "sense_id": "31eb73e4-77d5-31a8-997e-5d8e20aae3c4",
                                                "text": "Gerard Mortier, an iconoclastic impresario and one of the opera world’s premier provocateurs, will become general manager and artistic director of the New York City Opera in 2009."
                                            },
                                            {
                                                "example_id": "41df3a39-f491-402d-8ef6-2c8efba51f3a",
                                                "sense_id": "31eb73e4-77d5-31a8-997e-5d8e20aae3c4",
                                                "text": "Cannes is smacking its lips in anticipation of filmmaker and provocateur Michael Moore's latest jeremiad against the US administration, which receives its premiere at the film festival today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66414229-56d4-38cc-8986-14fb1cb52c52",
                                        "entry_id": "798bdf61-7425-33fa-8246-e6a6eb4f350f",
                                        "glosses": [
                                            "An undercover agent who incites suspected persons to partake in or commit criminal acts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f56971a-f635-49fa-82f7-57428ead976c",
                                                "sense_id": "66414229-56d4-38cc-8986-14fb1cb52c52",
                                                "text": "Near-synonyms: agitator, inciter"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3100cab4-e7ef-4e17-88b3-c5a74d3ea0da",
                        "source_entry_id": "87267880-fda2-3cad-9d06-790f864d400f",
                        "source_sense_id": "872bbec3-e72a-3356-a36d-c9b69d487589",
                        "source_sense_description": "jemand, der durch sein Verhalten andere herausfordert; der absichtlich für Unfrieden sorgt",
                        "target_lang_word": "провокатор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "провокатор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3142da61-a892-3dba-b9c1-e44cb3d2239b",
                                        "entry_id": "e37c793e-05e4-34b6-b87c-83f9cf609981",
                                        "glosses": [
                                            "истор. тайный агент (полиции, политического сыска и т. п.), внедряемый, проникающий в нелегальную организацию с предательскими целями, то есть действующий путём провокации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "720623d7-8a30-4dc4-86ee-88652721ee07",
                                                "sense_id": "3142da61-a892-3dba-b9c1-e44cb3d2239b",
                                                "text": "Пример Азефа учил, что провокатором может быть и лицо, менее других подлежащее подозрению."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e59b67d-5dd5-326f-a830-7688f07e1af9",
                                        "entry_id": "e37c793e-05e4-34b6-b87c-83f9cf609981",
                                        "glosses": [
                                            "тот, кто провоцирует кого-либо к чему-либо, на совершение чего-либо; подстрекатель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726a7570-0db3-4992-ab21-8baa206bbcaf",
                                                "sense_id": "9e59b67d-5dd5-326f-a830-7688f07e1af9",
                                                "text": "― Вы настоящий провокатор ― заставляете людей принимать рискованные позы, провоцируете их на несвойственное им поведение, почему ваши герои идут на это?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad7c1686-1d72-4949-8228-68da1d944d0c",
                        "source_entry_id": "87267880-fda2-3cad-9d06-790f864d400f",
