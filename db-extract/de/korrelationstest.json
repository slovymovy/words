                ],
                "senses": [
                    {
                        "sense_id": "a44b03f9-299a-3d19-9871-31fb4da25cdd",
                        "entry_id": "9addbf41-e3df-3c9c-b0b1-ad455a99d94f",
                        "glosses": [
                            "Überprüfung, ob Merkmale oder Ereignisse gehäuft zusammen auftreten"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "9c935c2e-00a0-4bce-b81e-7178535d6a10",
                                "sense_id": "a44b03f9-299a-3d19-9871-31fb4da25cdd",
                                "text": "„Da eine punktbiseriale Korrelation durch die Kodierung des dichotomen Merkmals mit 0 und 1 der Bʀᴀᴠᴀɪs-Pᴇᴀʀsᴏɴ-Korrelation entspricht, erfolgt die Signifikanzüberprüfung durch den gleichen Test wie bei dem Korrelationstest nach Bʀᴀᴠᴀɪs / Pᴇᴀʀsᴏɴ.“"
                            },
                            {
                                "example_id": "f6bd1670-187e-44d7-9923-0640d8b28fd1",
                                "sense_id": "a44b03f9-299a-3d19-9871-31fb4da25cdd",
                                "text": "„Gibt es konkurrierende Hypothesen, die sowohl den Korrelationstest erfüllen als auch theoretisch begründbar sind, so kann man sich für die Hypothese entscheiden, deren Begründung man für einleuchtender hält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5b7396c-1b73-3045-9c97-d50da92a64c7",
                        "entry_id": "9addbf41-e3df-3c9c-b0b1-ad455a99d94f",
                        "glosses": [
                            "gemeinsame Überprüfung mehrerer Parameter auf Plausibilität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6c4765-1bbf-4599-8453-e994973d14f7",
                                "sense_id": "f5b7396c-1b73-3045-9c97-d50da92a64c7",
                                "text": "„Ein Korrelationstest bezeichnet in der Softwaretechnik ein Verfahren, in dem nicht nur einzelne Parameter einer Funktion auf Plausibilität (zum Beispiel in Datentyp oder Wertebereich) geprüft werden, sondern auch Kombinationen dieser Parameter berücksichtigt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
