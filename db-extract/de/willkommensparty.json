                        "glosses": [
                            "Fest, um jemanden Willkommen zu heißen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1497514-ec02-440c-a406-b53bbad1ac36",
                                "sense_id": "13e50c45-0d54-37b8-a610-2458f87f5888",
                                "text": "„In einer Izakaya-Kneipe stieg eine Willkommensparty, und obwohl ich schrecklich erkältet war, ging ich hin, da das quasi Pflicht war.“"
                            },
                            {
                                "example_id": "0e1f8a3b-073e-49c4-9c5a-c9604454a255",
                                "sense_id": "13e50c45-0d54-37b8-a610-2458f87f5888",
                                "text": "„An dem Abend gab es für uns eine Willkommensparty im Casino, nur eine kleine Party, die MacLeishes, die Murphys, die Fitzgeralds und wir, die wir in der Villa wohnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
