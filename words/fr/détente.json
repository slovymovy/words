{
    "word_family": [
        "détendre",
        "détendeur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b10a4c26-a9d6-3842-b1a1-024270379d99",
                    "sense_definition": "Relâchement d'une tension physique ou psychologique ; période de repos et de calme qui en résulte.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue semaine de travail, nous avons profité d'un agréable moment de <w>détente</w>."
                        },
                        {
                            "text": "Une musique calme favorise la <w>détente</w> musculaire et permet d'évacuer tout le stress."
                        }
                    ],
                    "synonyms": [
                        "relaxation",
                        "repos",
                        "relâchement"
                    ],
                    "antonyms": [
                        "tension",
                        "stress"
                    ],
                    "common_phrases": [
                        "moment de détente",
                        "détente musculaire",
                        "pause détente"
                    ]
                },
                {
                    "sense_id": "64302443-d208-39c0-87df-468209169201",
                    "sense_definition": "Petite pièce métallique d'une arme à feu sur laquelle on appuie avec le doigt pour actionner le mécanisme de tir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tireur d'élite a posé prudemment son index sur la <w>détente</w> du fusil."
                        },
                        {
                            "text": "Une légère pression exercée sur la <w>détente</w> a suffi pour déclencher le tir."
                        }
                    ],
                    "common_phrases": [
                        "presser la détente",
                        "doigt sur la détente",
                        "lâcher la détente"
                    ]
                },
                {
                    "sense_id": "50cf4006-f7d8-3da9-b855-0dee2acce969",
                    "sense_definition": "Capacité musculaire à bondir vivement et à s'élever haut lors d'un saut.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son excellente <w>détente</w>, ce joueur de basket attrape tous les rebonds sans difficulté."
                        },
                        {
                            "text": "Le chat a montré une formidable <w>détente</w> pour franchir le mur d'un seul bond."
                        }
                    ],
                    "synonyms": [
                        "impulsion",
                        "ressort"
                    ],
                    "common_phrases": [
                        "bonne détente",
                        "détente verticale"
                    ]
                },
                {
                    "sense_id": "b1b68801-8da1-3b81-a2c5-0140c9c94d20",
                    "sense_definition": "Diminution de la pression d'un fluide qui gagne en volume, ou retour d'un ressort bandé à sa position initiale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La brusque <w>détente</w> du gaz comprimé a provoqué un refroidissement immédiat de la bouteille."
                        },
                        {
                            "text": "L'énergie libérée par la <w>détente</w> du ressort propulse le mécanisme vers l'avant."
                        }
                    ],
                    "synonyms": [
                        "décompression",
                        "expansion"
                    ],
                    "antonyms": [
                        "compression"
                    ],
                    "common_phrases": [
                        "détente d'un gaz",
                        "détente d'un ressort"
                    ]
                }
            ]
        }
    ]
