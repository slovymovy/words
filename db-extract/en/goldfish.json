                                        "entry_id": "aebb7d96-9893-3433-b078-8f204e9b5231",
                                        "glosses": [
                                            "bepaald soort kleine goudkleurige of rode vis die uit China afkomstig is en die door veel mensen thuis gehouden wordt Carassius auratus auratus"
                                        ],
