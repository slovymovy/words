            {
                "entry_id": "828cbb8b-8b09-3b22-b5b5-e276183066d7",
                "word": "bio",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71ce08fb-2c35-4190-9af8-697d1d2c3a70",
                        "entry_id": "828cbb8b-8b09-3b22-b5b5-e276183066d7",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "bios"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "427e40fb-046a-3343-b96c-2caa57986d4f",
                        "entry_id": "828cbb8b-8b09-3b22-b5b5-e276183066d7",
                        "glosses": [
                            "Qui provient de l’agriculture biologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8abfccbf-de8f-4b13-951a-83e765d218f2",
                                "sense_id": "427e40fb-046a-3343-b96c-2caa57986d4f",
                                "text": "Les yaourts se font de préférence avec du lait de vache entier ou bio."
                            },
                            {
                                "example_id": "6e150f0a-9717-4eec-b66f-353eb52eb76c",
                                "sense_id": "427e40fb-046a-3343-b96c-2caa57986d4f",
                                "text": "À Loire-les-Marais, Frédéric Moinier fabrique des jonchées bio au lait thermisé et sur des joncs en synthétique, qu’il vend dans les épiceries et supérettes locales."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ba13ea6-13cc-323c-9592-2761536f4e70",
                        "entry_id": "828cbb8b-8b09-3b22-b5b5-e276183066d7",
                        "glosses": [
                            "Qui vend de tels produits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c4cca2-8fd4-4eb6-90bb-6ee7c4ce3507",
                                "sense_id": "1ba13ea6-13cc-323c-9592-2761536f4e70",
                                "text": "Mais le lecteur s'attardera sans doute tout autant sur les meilleures adresses des restaurants chics, bio et halals de la capitale, mêlant le « doux parfum d'antan » à un cadre moderne ; […]."
                            },
                            {
                                "example_id": "b6e086d7-f31d-42e7-983f-c4586e229de4",
                                "sense_id": "1ba13ea6-13cc-323c-9592-2761536f4e70",
                                "text": "Et, c’est bête comme chou, faute d’avoir suffisamment d’agriculteurs bio, la France ne produit que la moitié de ce qu’elle consomme."
                            }
                        ]
                    }
                ],
