                    "sense_id": "583c0ebc-eb42-38e8-9e67-32a5221a50cc",
                    "sense_definition": "An abbreviation for Wide Area Telephone Service, a specialized telecommunications service for large-scale long-distance calling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "telecommunications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corporation implemented <w>WATS</w> lines to manage their high volume of long-distance business calls.",
                            "target_lang_translations": {
                                "ru": "Корпорация внедрила линии <w>WATS</w> для управления большим объемом междугородних деловых звонков."
                            }
                        },
                        {
                            "text": "Before the advent of modern internet protocols, many companies relied on <w>WATS</w> for cost-effective communication.",
                            "target_lang_translations": {
                                "ru": "До появления современных интернет-протоколов многие компании полагались на <w>WATS</w> для обеспечения экономичной связи."
                            }
