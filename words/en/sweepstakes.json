            "senses": [
                {
                    "sense_id": "a2657ca7-cfb3-377d-bd2b-6353ce3f6f53",
                    "sense_definition": "A form of gambling, lottery, or contest in which the prize is made up of the money contributed by the participants, or a promotional drawing in which prizes are given away to participants at no cost.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lottery_contest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was thrilled to find out she had won the grand prize in the national <w>sweepstakes</w>.",
                            "target_lang_translations": {
                                "de": "Sie war begeistert, als sie erfuhr, dass sie den Hauptpreis im nationalen <w>Gewinnspiel</w> gewonnen hatte."
                            }
                        },
                        {
                            "text": "Many companies use an online <w>sweepstakes</w> to attract new customers to their website.",
                            "target_lang_translations": {
                                "de": "Viele Unternehmen nutzen ein Online-<w>Gewinnspiel</w>, um neue Kunden auf ihre Website zu locken."
                            }
                        }
                    ],
                    "synonyms": [
