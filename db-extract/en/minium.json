                "entry_id": "53738106-f597-3fb1-a3ca-cbd22802160d",
                "word": "minium",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "febcf307-ebc4-4481-895b-6353db4ec535",
