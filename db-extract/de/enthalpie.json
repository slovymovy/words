                                "target_senses": [
                                    {
                                        "sense_id": "c3e390c0-8f86-3612-8aff-efc4130242c0",
                                        "entry_id": "af98a6fa-808a-3b05-bc46-7a94f1f565ba",
                                        "glosses": [
                                            "A measure of the heat content of a chemical or physical system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfd1571d-8231-4dc3-af0a-dc3603153ed4",
                                                "sense_id": "c3e390c0-8f86-3612-8aff-efc4130242c0",
                                                "text": "H=U+pV, where H is enthalpy, U is internal energy, p is pressure, and V is volume."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67f39f5f-2ff2-46ce-b493-b1d6d9a9e99e",
                        "source_entry_id": "75dbc241-55f1-30e7-90bc-00dd3e957095",
                        "source_sense_id": "2a96a180-8b17-3cbf-a520-c9442a42dcd8",
                        "source_sense_description": "Chemie: Maß für die Energie",
                        "target_lang_word": "enthalpie",
