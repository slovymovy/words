                        "examples": [
                            {
                                "example_id": "3ea699f7-8f2e-4ef0-b2c6-792e7566e0e2",
                                "sense_id": "502b7707-2de4-3791-add4-fc2eab6e1b6d",
                                "text": "„Dr. Rosentuch kam aus dem Behandlungszimmer, in seinem weißen Kittel und mit ernstem Gesicht.“"
                            },
                            {
                                "example_id": "0c11b633-eb38-4b10-a3a2-d86c389ec4f2",
                                "sense_id": "502b7707-2de4-3791-add4-fc2eab6e1b6d",
                                "text": "„Also schleiche ich ins Behandlungszimmer und vermisse plötzlich das Wartezimmer – denn dort hatte ich immerhin nicht alleine Angst.“"
                            }
                        ],
