{
    "word_family": [
        "tarry",
        "tarp",
        "tarpaulin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0b36e61-f3b2-322a-aeee-6c1e80b32085",
                    "sense_definition": "A black, sticky, oily substance made from wood, coal, or peat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road workers poured hot <w>tar</w> over the gravel to create a smooth surface.",
                            "target_lang_translations": {
                                "ru": "Дорожные рабочие залили гравий горячим <w>гудроном</w>, чтобы создать ровную поверхность."
                            }
                        },
                        {
                            "text": "The old wooden fence was coated in <w>tar</w> to protect it from the rain.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный забор покрыли <w>смолой</w>, чтобы защитить его от дождя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hot tar",
                        "coal tar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чёрное, вязкое вещество, получаемое из древесины, угля или торфа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гудрон",
                                "target_lang_sense_clarification": "для дорожного покрытия или гидроизоляции"
                            },
                            {
                                "target_lang_word": "дёготь",
                                "target_lang_sense_clarification": "продукт сухой перегонки древесины, торфа или угля"
                            },
                            {
                                "target_lang_word": "смола",
                                "target_lang_sense_clarification": "каменноугольная смола, пек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "966761b3-de4e-389d-9c9d-1d43c171f914",
                    "sense_definition": "A dark, sticky residue found in tobacco smoke.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cigarette smoke contains harmful <w>tar</w> that damages the lungs over time.",
                            "target_lang_translations": {
                                "ru": "Сигаретный дым содержит вредные <w>смолы</w>, которые со временем разрушают лёгкие."
                            }
                        },
                        {
                            "text": "Filters are designed to reduce the amount of <w>tar</w> inhaled by the smoker.",
                            "target_lang_translations": {
                                "ru": "Фильтры предназначены для снижения количества <w>смол</w>, вдыхаемых курильщиком."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тёмный вязкий осадок, содержащийся в табачном дыме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смола",
                                "target_lang_sense_clarification": "в сигаретном дыме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af02c463-d992-340f-8bfb-31809ec60017",
                    "sense_definition": "A sailor, historically named for their tar-coated clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>tar</w> told stories of his many years spent sailing across the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Старый <w>моряк</w> рассказывал истории о годах, проведённых в плаваниях по Атлантике."
                            }
                        },
                        {
                            "text": "Every brave <w>tar</w> on the ship prepared for the coming storm.",
                            "target_lang_translations": {
                                "ru": "Каждый храбрый <w>матрос</w> на корабле готовился к надвигающемуся шторму."
                            }
                        }
                    ],
                    "synonyms": [
                        "jack"
                    ],
                    "common_phrases": [
                        "British tar"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical maritime terminology."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Моряк, матрос (устаревшее прозвище моряков, произошедшее от просмоленной одежды)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моряк",
                                "target_lang_sense_clarification": "устаревшее разговорное"
                            },
                            {
                                "target_lang_word": "матрос",
                                "target_lang_sense_clarification": "морской волк"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ba6c27b-aab0-3452-a583-438c168c189c",
                    "sense_definition": "A dark, impure form of heroin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police seized a large quantity of black <w>tar</w> during the drug raid.",
                            "target_lang_translations": {
                                "ru": "Во время антинаркотического рейда полиция изъяла крупную партию <w>чёрного героина</w>."
                            }
                        },
                        {
                            "text": "Addiction to black <w>tar</w> has devastating effects on the user's health.",
                            "target_lang_translations": {
                                "ru": "Зависимость от <w>чёрного героина</w> оказывает разрушительное воздействие на здоровье потребителя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "black tar"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in the context of illegal drugs."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тёмная, неочищенная разновидность героина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёрный героин",
                                "target_lang_sense_clarification": "жаргонное название низкокачественного героина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "556174f6-28fe-34cf-8670-342a6ba382dc",
                    "sense_definition": "A round frame drum from the Middle East or North Africa.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician played a rhythmic beat on the <w>tar</w> during the traditional performance.",
                            "target_lang_translations": {
                                "ru": "Во время традиционного выступления музыкант выбивал ритмичный бой на <w>таре</w>."
                            }
                        },
                        {
                            "text": "The ensemble included a <w>tar</w> to provide a deep, resonant sound.",
                            "target_lang_translations": {
                                "ru": "В состав ансамбля включили <w>тар</w>, чтобы обеспечить глубокое и резонансное звучание."
                            }
                        }
                    ],
                    "target_lang_definitions": {
