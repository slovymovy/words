                    },
                    {
                        "translation_id": "fba38886-1b72-4556-9957-9930fd31415a",
                        "source_entry_id": "5ef4d36a-4a63-31cf-a1d6-ac79c4f043b8",
                        "source_sense_id": "5f7e9265-a67d-3aee-a942-7b97991e3d2b",
                        "target_lang_word": "magazine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magazine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3828a0e-735d-3ccf-af11-e3958b151a64",
                                        "entry_id": "d77716b9-8c12-3704-8e82-c1359cc83879",
                                        "glosses": [
                                            "A nonacademic, periodical publication which consists of articles by multiple writers on some broad topic or theme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc1dbf80-4dca-363d-b3f7-0300e1feef25",
                                        "entry_id": "d77716b9-8c12-3704-8e82-c1359cc83879",
                                        "glosses": [
                                            "A nonacademic, periodical publication which consists of articles by multiple writers on some broad topic or theme.",
                                            "A radio or television show where each episode comprises a variety of features or segments, akin to the format of a print magazine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78062ffe-a939-43a4-808a-283e011e18ee",
                                                "sense_id": "fc1dbf80-4dca-363d-b3f7-0300e1feef25",
                                                "text": "After several months' delay, The Emerald City, New York's hour-long gay television show, is on the air. In magazine format, the show offers interviews, gay news and commentary, visits to New York's entertainment spots and gay shows, and a bit of camping from George Sardi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a926665d-507f-3b9d-b79e-139c16888bda",
                                        "entry_id": "d77716b9-8c12-3704-8e82-c1359cc83879",
                                        "glosses": [
                                            "An ammunition storehouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66ad655-d91f-43db-9790-58130c809bd3",
                                                "sense_id": "a926665d-507f-3b9d-b79e-139c16888bda",
                                                "text": "He all thir Ammunition / And feats of War defeats / With plain Heroic magnitude of mind / And celeſtial vigour arm’d, / Thir Armories and Magazins contemns, / Renders them uſeleſs, while / With winged expedition / Swift as the lightning glance he executes / His errand on the wicked, who ſurpris’d / Loſe thir defence diſtracted and amaz’d."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6786ef3-3048-37bb-987e-42f907818415",
                                        "entry_id": "d77716b9-8c12-3704-8e82-c1359cc83879",
                                        "glosses": [
                                            "An ammunition storehouse.",
                                            "The portion of a warship where munitions are stored."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e008080d-d115-4102-ba92-385d184f64d9",
                                                "sense_id": "e6786ef3-3048-37bb-987e-42f907818415",
                                                "text": "The cruiser blew up when a shell hit its magazine."
                                            },
                                            {
                                                "example_id": "b5c316f1-c431-4240-9d66-2f2adf961714",
                                                "sense_id": "e6786ef3-3048-37bb-987e-42f907818415",
                                                "text": "Juneau was making good time with the other surviving U.S. Navy ships, despite her damage, when the I-26 spotted her and sent a salvo of Type 95 torpedoes in her direction. Passing between the Helena and San Francisco, some indication being they had actually been shot at the San Francisco and gone long because San Francisco was travelling significantly slower than expected, they nonetheless hit Juneau and detonated the ship's magazine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c64afa0-390e-3ec6-b0ab-95bc0d25db18",
                                        "entry_id": "d77716b9-8c12-3704-8e82-c1359cc83879",
                                        "glosses": [
                                            "A chamber in or attachable to a firearm enabling multiple rounds of ammunition to be fed into the firearm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b595a50c-8614-380a-939c-f89c226ed68c",
                                        "entry_id": "d77716b9-8c12-3704-8e82-c1359cc83879",
                                        "glosses": [
                                            "A reservoir or supply chamber for a stove, battery, camera, typesetting machine, or other apparatus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "261f7f39-a7c0-3e31-884a-6aa67a42c302",
                                        "entry_id": "d77716b9-8c12-3704-8e82-c1359cc83879",
