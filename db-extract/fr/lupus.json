                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71d6949a-19d0-3315-843d-df8e4bee981c",
                                        "entry_id": "32c56d7d-2afd-333a-ad71-edb221077436",
                                        "glosses": [
                                            "Any of a number of autoimmune diseases, the most common of which is systemic lupus erythematosus."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac47ff4-11e2-4a5f-ac96-c772312b6f4a",
                                                "sense_id": "71d6949a-19d0-3315-843d-df8e4bee981c",
                                                "text": "You like the name quesalupa? That is a little like \"case of lupus\". I just keep thinking about that."
                                            },
                                            {
                                                "example_id": "76b58eb3-ba2d-45d0-ad0f-3b88775d444c",
                                                "sense_id": "71d6949a-19d0-3315-843d-df8e4bee981c",
                                                "text": "Iberdomide, a cereblon modulator promoting degradation of the transcription factors Ikaros and Aiolos, which affect leukocyte development and autoimmunity, is being evaluated for the treatment of systemic lupus erythematosus (SLE)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
