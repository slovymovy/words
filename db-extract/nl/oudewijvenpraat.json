                        "sense_id": "181e0ceb-afb7-372a-89cd-23f2687640fb",
                        "entry_id": "8cbf6a27-0bdd-334f-9e2c-a642fd4736e0",
                        "glosses": [
                            "onzin die past bij een demente oude vrouw"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0cf5f9f1-a29d-4080-9558-a779375b4a47",
                                "sense_id": "181e0ceb-afb7-372a-89cd-23f2687640fb",
                                "text": "Oudewijvenpraat, oudewijvenpraat, zei hij, maar hij klopte Pierre toch vriendelijk op de schouder, en liep naar de tafel waar vorst Andrej, die duidelijk geen zin had aan het gesprek deel te nemen, in de papieren bladerde die de vorst uit de stad had meegenomen."
                            },
                            {
                                "example_id": "430c2427-c320-4544-90d0-c8700286571b",
                                "sense_id": "181e0ceb-afb7-372a-89cd-23f2687640fb",
                                "text": "„Het was in Israël bekend dat het verhaal dat (de Iraakse) massavernietigingswapens binnen 45 minuten geactiveerd konden worden oudewijvenpraat was”, zei Sarid, die lid is van de Knesset-commissie voor Buitenlandse Zaken en Defensie."
                            }
                        ]
                    }
