                "senses": [
                    {
                        "sense_id": "6b5a1e28-a150-3d39-bed5-c3fb20f77059",
                        "entry_id": "be79a94c-61fa-3241-a4f3-7bb5ca38cf9f",
                        "glosses": [
                            "Vorliebe für einen bestimmten Musikstil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d078904-5e6b-4baf-8d4b-f0cbe94e8ae5",
                                "sense_id": "6b5a1e28-a150-3d39-bed5-c3fb20f77059",
                                "text": "Piet hat einen sehr gewöhnungsbedürftigen Musikgeschmack."
                            },
                            {
                                "example_id": "f08707b5-6e59-4c1e-9870-13816016cdcd",
                                "sense_id": "6b5a1e28-a150-3d39-bed5-c3fb20f77059",
                                "text": "„Jutta hatte meinen Musikgeschmack, der bei den frühen Beatles und Stones steckengeblieben war, entschlossen auf neuesten Stand gebracht.“"
                            },
                            {
                                "example_id": "ad7b380e-f345-4554-a6ad-c1f622e176af",
                                "sense_id": "6b5a1e28-a150-3d39-bed5-c3fb20f77059",
                                "text": "„Sein Musikgeschmack hatte sich seit Jahrzehnten nicht verändert, und er kannte fast alle Lieder auswendig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
