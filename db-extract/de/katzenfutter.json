                ],
                "senses": [
                    {
                        "sense_id": "40031b77-5c82-337d-8ea2-33ff05b333d9",
                        "entry_id": "2affbe0f-bd98-3518-b180-fc285953385c",
                        "glosses": [
                            "Tiernahrung speziell für Katzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f373e0b6-0f5e-4509-9ef2-51df9a136a78",
                                "sense_id": "40031b77-5c82-337d-8ea2-33ff05b333d9",
                                "text": "Hat unsere Katze heute schon ihr Katzenfutter bekommen?"
                            },
                            {
                                "example_id": "06f4abde-a2d5-4752-82ba-1ca30e6e8ce7",
                                "sense_id": "40031b77-5c82-337d-8ea2-33ff05b333d9",
                                "text": "Klothilde hat sieben Katzen und muss immer verschiedene Katzenfutter einkaufen, damit jeder ihrer Lieblinge etwas nach seinem Geschmack vorfindet."
                            },
                            {
                                "example_id": "898437f5-c432-4b49-921b-5bbc8e5a00e6",
                                "sense_id": "40031b77-5c82-337d-8ea2-33ff05b333d9",
                                "text": "In unserem Sortiment finden Sie auch solche Katzenfutter, die auf die Bedürfnisse von kranken und alten Tieren abgestimmt sind."
                            },
                            {
                                "example_id": "e10b1914-a37a-4ee2-a973-ff7249dc5e7f",
                                "sense_id": "40031b77-5c82-337d-8ea2-33ff05b333d9",
                                "text": "„Hast du daran gedacht, Katzenfutter zu besorgen“?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
