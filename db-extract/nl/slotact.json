                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7097ce5e-1dbf-420f-bcce-1b21b777a232",
                                "sense_id": "ebcd3db0-4a46-3bd1-a070-2b9747ee8781",
                                "text": "Vorig jaar stond de slotact van Circus BoesKool al in de finale van het Open Podium van Twente. Nu is ook de anderhalf uur die vooraf gaat aan de finale-act klaar om opgevoerd te worden."
                            },
                            {
                                "example_id": "53af986f-a1cd-4a3e-9ea8-e963ef841692",
                                "sense_id": "ebcd3db0-4a46-3bd1-a070-2b9747ee8781",
                                "text": "Pharrell Williams had blijkbaar geen idee waar in Nederland hij vanavond optrad. Tijdens het muziekfestival Pinkpop, waar de zanger de slotact was, riep hij aan het begin van zijn show 'Hello Amsterdam' naar de tienduizenden mensen op het terrein. Het gemor dat uit het publiek opsteeg leek hem te ontgaan, want hij bleef tot drie maal toe refereren aan de hoofdstad."
                            },
                            {
                                "example_id": "73077805-6478-4572-bc8c-ef4cbc2b513e",
                                "sense_id": "ebcd3db0-4a46-3bd1-a070-2b9747ee8781",
                                "text": "Radical Redemption staat vandaag twee keer op Airforce Festival. Tussen 22.00 en 23.00 solo op de Radar-stage en als slotact op het hoofdpodium onder het synoniem Denekamps gespuis."
                            }
                        ]
                    }
