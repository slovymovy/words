                        "glosses": [
                            "alles en iedereen die betrokken is bij de handel en productie van verboden, verdovende middelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0e9636-ac01-45e7-baa5-4aa5d71d4b47",
                                "sense_id": "cab64471-9fa9-35e2-ac5e-1c84f4c473a4",
                                "text": "De man is van Turkse komaf en staat bekend als een grote vis in de drugswereld. De afgelopen jaren zijn veel mensen uit zijn omgeving opgepakt."
                            },
                            {
                                "example_id": "7b357026-3599-4fe8-99bf-00d6a5683a4b",
                                "sense_id": "cab64471-9fa9-35e2-ac5e-1c84f4c473a4",
                                "text": "De oprichting van een 'Dutch-DEA' lijkt een antwoord op een bevinding van Pieter Tops, lector aan de Politieacademie, en onderzoeksjournalist Jan Tromp. Zij schrijven in een rapport over de drugscriminaliteit in Amsterdam dat de kennis en aanpak van de drugswereld zijn versplinterd."
                            },
                            {
                                "example_id": "ee63ffa7-cde9-4217-a964-b3a854cfee94",
                                "sense_id": "cab64471-9fa9-35e2-ac5e-1c84f4c473a4",
                                "text": "De zaak gaat over de moord op ggz-directeur Rob Zweekhorst, die in 2014 werd doodgeschoten in zijn woonplaats Berkel en Rodenrijs. De schutter zag hem aan voor een vijand in de drugswereld. De zaak kwam bekend te staan als een vergismoord."
                            }
                        ]
                    }
