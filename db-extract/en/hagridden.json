                        "entry_id": "024cc107-0c69-3d72-9785-bd3da24d9da4",
                        "glosses": [
                            "Tormented, harassed or worried."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8694bffb-5568-420d-94c6-cb6125560bcb",
                                "sense_id": "b08743cf-c7cb-399a-a9e4-0468e6271d95",
                                "text": "So Sir Walter Scott, hag-ridden by debt, if he finished a novel in the morning began another in the afternoon, because, as he explained, it was less difficult to keep the machine running than to start it again after a rest."
                            }
                        ]
                    },
