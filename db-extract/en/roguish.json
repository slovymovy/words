                                        "entry_id": "49d772bb-2faa-3bf6-93b2-29f1d6731604",
                                        "glosses": [
                                            "keinerlei Hemmungen für etwaige Schandtaten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4576732a-28e0-4f75-8c1e-4d3e23bd0b5d",
                                                "sense_id": "a01a12b5-575e-30a3-978c-d24f1e45c25c",
                                                "text": "Du bist vielleicht skrupellos!"
                                            },
                                            {
                                                "example_id": "55f9ac79-75e4-479b-b471-970693afe716",
                                                "sense_id": "a01a12b5-575e-30a3-978c-d24f1e45c25c",
                                                "text": "„Sie wäre aber nicht verwunderlich bei einer Crew, die skrupellos eine gesamte Besatzung kidnappt und in eigene Dienste zwingt.“"
                                            },
                                            {
                                                "example_id": "9ab9be80-67e3-4ce9-87df-79f4ca37adf3",
                                                "sense_id": "a01a12b5-575e-30a3-978c-d24f1e45c25c",
                                                "text": "„Ohne Frage war er machtbewusst, skrupellos und visionär.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
