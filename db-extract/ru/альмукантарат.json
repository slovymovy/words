                "senses": [
                    {
                        "sense_id": "b4709495-68ae-3e48-9fd3-1c7926b358d3",
                        "entry_id": "726a57f9-fad7-33b8-b379-2cae9e0c8d4c",
                        "glosses": [
                            "астрон. любой малый круг небесной сферы, плоскость которого параллельна плоскости математического горизонта; круг равных высот"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9387f6b0-8046-447d-802c-f76523a874d6",
                                "sense_id": "b4709495-68ae-3e48-9fd3-1c7926b358d3",
                                "text": "Альмукантараты образуют на тимпане гиперболический пучок окружностей, азимутальные линии — сопряжённый с ним эллиптический пучок окружностей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b4f92a3-0b7d-4209-b26c-3b5c9a4d0b16",
                        "source_entry_id": "726a57f9-fad7-33b8-b379-2cae9e0c8d4c",
                        "source_sense_id": "b4709495-68ae-3e48-9fd3-1c7926b358d3",
                        "target_lang_word": "almucantar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "almucantar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "498aa79a-b0c6-3364-b6d1-1e570b933e9b",
                                        "entry_id": "db28242c-ab77-3dfc-89af-dd381a479f85",
                                        "glosses": [
                                            "A small circle on the celestial sphere, parallel to the horizon, that is used in astronomy and navigation to show altitude of a star or any other heavenly body."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85bbcca4-6b01-4735-9998-e522c1e693dd",
                                                "sense_id": "498aa79a-b0c6-3364-b6d1-1e570b933e9b",
                                                "text": "Almucantars, or parallels of altitude, are circles parallel to the horizon, or whose poles are the zenith and nadir. All the points of any one almucantar are at equal altitudes above the horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9ad48d9-77b0-344a-9e83-33c011ad3888",
                                        "entry_id": "db28242c-ab77-3dfc-89af-dd381a479f85",
                                        "glosses": [
                                            "An instrument for observing the heavenly bodies as they cross such a circle."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf5318a-dcba-463e-ac49-ccce26eb7768",
                                                "sense_id": "c9ad48d9-77b0-344a-9e83-33c011ad3888",
                                                "text": "A wide field of work appears open in the application of photography to meridian instruments, or to the almucantar. The sensitive plate should be substituted for the reticule, and the position marked by a graver attached to the tail-piece of the telescope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebbbf250-3fb8-4e67-bfc9-1724f6543c8b",
                        "source_entry_id": "726a57f9-fad7-33b8-b379-2cae9e0c8d4c",
