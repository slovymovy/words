                "senses": [
                    {
                        "sense_id": "18ea1816-8109-3ee5-80bf-5c44793716a1",
                        "entry_id": "5b7bc3ec-625d-315b-8729-fc575ff1b0b9",
                        "glosses": [
                            "An undesirable, lackluster, and artificial foodstuff, as a substitute for real meat."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2cf77ab-f0c1-417d-a63e-021e58c02e72",
                                "sense_id": "18ea1816-8109-3ee5-80bf-5c44793716a1",
                                "text": "The soylent steaks were sitting like lead in his stomach and twice he had to go back to the dark and miserable toilet in the rear of the building."
                            },
                            {
                                "example_id": "a0eb36ef-88af-4470-9353-732b225e8e9d",
                                "sense_id": "18ea1816-8109-3ee5-80bf-5c44793716a1",
                                "text": "It is decided that the product will be composed of three elements — soylent green, red, and blue. Each pound of the final product must contain at least 2000 calories of energy and 1000 units of vitamins."
                            },
                            {
                                "example_id": "798f9799-da52-42d4-b996-9954aa303408",
                                "sense_id": "18ea1816-8109-3ee5-80bf-5c44793716a1",
                                "text": "“Today's selection is Superaide with a choice of soylent yellow or soylent red,” the servodroid said."
                            }
                        ]
                    }
                ],
