                        "examples": [
                            {
                                "example_id": "81a9048c-cb91-4376-8905-60ef9b64d70c",
                                "sense_id": "608f0195-f396-387f-a5c7-4ebcee9cc862",
                                "text": "Dieses Bengelchen hat eine Strafe verdient!"
                            },
                            {
                                "example_id": "bc57b5b8-f239-4584-8134-380d0fcd1d11",
                                "sense_id": "608f0195-f396-387f-a5c7-4ebcee9cc862",
                                "text": "„Die Leute im Dorf waren so verärgert, dass sie schon das Bengelchen samt seiner Familie aus dem Dorf vertreiben wollten.“"
                            },
                            {
                                "example_id": "e85e8754-7b4c-4fe1-8acd-8b534ca99089",
                                "sense_id": "608f0195-f396-387f-a5c7-4ebcee9cc862",
                                "text": "„Ob als Schlusselanhänger, Glücksbringer, für den Rucksack oder nur so, das Bengelchen bringt nicht nur Dich zum schmunzeln, auch jeden den Du damit beschenkst!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
