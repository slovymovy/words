    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59bea430-e24e-3f6f-9158-e1b0bcc8b4b2",
                    "sense_definition": "Glisser de façon involontaire ou perdre son adhérence au sol, en parlant d'un véhicule ou d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "glisser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture a commencé à <w>déraper</w> sur la chaussée glissante à cause du verglas."
                        },
                        {
                            "text": "Il courait trop vite sous la pluie et a failli <w>déraper</w> dans le virage."
                        }
                    ],
                    "synonyms": [
                        "glisser"
                    ],
                    "antonyms": [
                        "adhérer"
                    ],
                    "common_phrases": [
                        "faire déraper"
                    ]
                },
                {
                    "sense_id": "b01e80cb-4d40-35ac-89e7-0fdbbf11d63a",
                    "sense_definition": "Échapper à tout contrôle ou dépasser les limites raisonnables, en parlant d'une situation ou d'un événement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dégénérer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La manifestation pacifique a malheureusement commencé à <w>déraper</w> en fin d'après-midi."
                        },
                        {
                            "text": "Le modérateur est rapidement intervenu pour empêcher que le débat ne <w>dérape</w> complètement."
                        }
                    ],
                    "synonyms": [
                        "dégénérer"
                    ],
                    "common_phrases": [
                        "laisser déraper"
                    ]
                },
                {
                    "sense_id": "aa7298b2-6c83-3921-851e-27b707fefcca",
                    "sense_definition": "Tenir des propos déplacés, injurieux ou contraires aux règles de bienséance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "propos_choquants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'homme politique a sévèrement <w>dérapé</w> lors de son interview en direct à la radio."
                        },
                        {
                            "text": "Il a présenté ses excuses publiquement après avoir <w>dérapé</w> devant les journalistes."
                        }
                    ]
                },
                {
                    "sense_id": "45eb4f7e-2609-3b4a-81e4-ccf65a994a9f",
                    "sense_definition": "Quitter prise sur le fond marin et glisser, en parlant de l'ancre d'un navire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous la force de la tempête, l'ancre a fini par <w>déraper</w> sur les fonds sableux."
                        },
                        {
                            "text": "Le navigateur s'est aperçu que le bateau bougeait car le mouillage <w>dérapait</w>."
                        }
                    ],
                    "synonyms": [
                        "chasser"
                    ],
                    "antonyms": [
                        "crocher"
                    ]
                }
            ]
        }
    ]
