                                                "sense_id": "b03e548f-d160-3253-a557-5807e9aa3dad",
                                                "text": "Fenol był jednym z najwcześniej stosowanych środków przeciwbakteryjnych."
                                            },
                                            {
                                                "example_id": "5ba49bf2-54a2-4e8d-bac5-9773e46970f2",
                                                "sense_id": "b03e548f-d160-3253-a557-5807e9aa3dad",
                                                "text": "Skrzyp polny jest rośliną o działaniu moczopędnym, przeciwkrwotocznym, przeciwzapalnym, przeciwbakteryjnym i redukującym obrzęki."
                                            },
                                            {
                                                "example_id": "9718c701-49e7-4d95-9cf8-aaab9a118302",
                                                "sense_id": "b03e548f-d160-3253-a557-5807e9aa3dad",
