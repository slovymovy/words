                        "glosses": [
                            "Aufruhr, ausgelöst durch eine unzureichende Versorgung mit Lebensmitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5acba0-cfac-46b3-aa9e-51d9b573c8ee",
                                "sense_id": "e7c7f486-6c37-3f54-b669-d92b8aa0d6ce",
                                "text": "„In Berlin und anderen Großstädten hatte es bereits Hungerkrawalle gegeben und Plünderungen in Geschäften, die wegen Preistreiberei verschrien waren.“"
                            },
                            {
                                "example_id": "dab566d9-fe92-4ae1-a922-9507a15a6f1d",
                                "sense_id": "e7c7f486-6c37-3f54-b669-d92b8aa0d6ce",
                                "text": "„Infolge der Kartoffelfäule kam es 1847 jedoch zu Hungerkrawallen, da die Kartoffeln das Hauptnahrungsmittel der Kleinhäusler waren.“"
                            }
                        ],
