                        "entry_id": "d50081a8-8feb-3ca6-81fe-4cd260dfa922",
                        "glosses": [
                            "разг. кабардинская лошадь; лошадь кабардинской породы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a1fb17-09c7-41b5-b108-d46485b3d39f",
                                "sense_id": "ba8de1e2-aa7d-3971-a747-f7fb4f670399",
                                "text": "― Кабардинки в лаве ушами прядут, ― говорил прапорщик, упрямо не соглашаясь признавать выдающихся свойств у местной породы."
                            }
                        ]
                    }
