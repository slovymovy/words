                "senses": [
                    {
                        "sense_id": "660c646b-a59d-3618-b69b-ac3f1c22de40",
                        "entry_id": "2e25b5ab-200a-304e-a722-a98a7cd940ab",
                        "glosses": [
                            "Instrument de mesure qui enregistre la hauteur des marées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1832f255-a4a3-416b-98f3-5cdb56336485",
                                "sense_id": "660c646b-a59d-3618-b69b-ac3f1c22de40",
                                "text": "Les mesures sont effectuées à partir dʼun marégraphe, inventé en 1842 par lʼingénieur hydrographe Chazallon."
                            },
                            {
                                "example_id": "e3f3d1ef-116b-4fd7-a41e-bf3ac2578675",
                                "sense_id": "660c646b-a59d-3618-b69b-ac3f1c22de40",
                                "text": "Pour lancer des grands travaux d’aménagement du pays, il est décidé en 1879 de procéder à un nivellement général de précision du territoire. On installe alors un marégraphe à Marseille pour déterminer le niveau moyen de la mer à cet endroit. Ce repère servira de référence pour le calcul de toutes les altitudes sur le continent français."
                            }
                        ]
                    }
                ],
