    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a34d2e0b-caa5-3083-af8b-7fcaa066da42",
                    "sense_definition": "Een werktuig met veel kleine gaatjes om vloeistof of fijn poeder te scheiden van grotere vaste delen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "keukengerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gebruik een fijne <w>zeef</w> om de bloem te zeven voor het bakken.",
                            "target_lang_translations": {
                                "en": "Use a fine <w>sieve</w> to sift the flour before baking."
                            }
                        },
                        {
                            "text": "Hij goot de gekookte pasta in een grote <w>zeef</w> om het water te laten weglopen.",
                            "target_lang_translations": {
                                "en": "He poured the cooked pasta into a large <w>strainer</w> to drain the water."
                            }
                        }
                    ],
                    "synonyms": [
                        "teems",
                        "stramijn"
                    ],
                    "common_phrases": [
                        "fijne zeef",
                        "door een zeef"
                    ],
                    "target_lang_definitions": {
                        "en": "A tool with many small holes used to separate liquid or fine powder from larger solid parts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sieve",
                                "target_lang_sense_clarification": "a tool with a mesh for straining or sifting"
                            },
                            {
                                "target_lang_word": "strainer",
                                "target_lang_sense_clarification": "a kitchen utensil used to drain liquid"
                            },
                            {
                                "target_lang_word": "colander",
                                "target_lang_sense_clarification": "a perforated bowl used to drain liquid from food"
                            }
                        ]
                    }
                }
            ]
        },
        {
