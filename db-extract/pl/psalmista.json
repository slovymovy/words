                "senses": [
                    {
                        "sense_id": "1d8acbd5-75c2-3446-b520-5b0ba673f571",
                        "entry_id": "bb2e9e93-8c56-3254-9cdc-3c97a00dce60",
                        "glosses": [
                            "autor psalmów biblijnych"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0ac45071-cbd1-3041-b927-20440d91e710",
                        "entry_id": "bb2e9e93-8c56-3254-9cdc-3c97a00dce60",
                        "glosses": [
                            "śpiewający psalmy podczas liturgii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cab2615-742c-4777-9adf-be3c105a41a3",
                                "sense_id": "0ac45071-cbd1-3041-b927-20440d91e710",
                                "text": "Ksiądz wskazał psalmiście miejsce obok lektora."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42ecd521-eb1b-436a-bf5a-2085576fccb8",
                        "source_entry_id": "bb2e9e93-8c56-3254-9cdc-3c97a00dce60",
                        "source_sense_id": "1d8acbd5-75c2-3446-b520-5b0ba673f571",
                        "target_lang_word": "psalmist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psalmist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "307a0dbc-4e6a-3822-bd2c-65ea8f8c23ac",
                                        "entry_id": "bf240464-ab78-37cf-81a1-164d4f5ae9ce",
                                        "glosses": [
                                            "A composer of psalms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a442be-9835-4b6f-b667-180147486af4",
                                                "sense_id": "307a0dbc-4e6a-3822-bd2c-65ea8f8c23ac",
                                                "text": "An environment which would have made a contented woman a poet, a suffering woman a devotee, a pious woman a psalmist, even a giddy woman thoughtful, made a rebellious woman saturnine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c74224e8-d428-376b-8868-571ecb4b2507",
                                        "entry_id": "bf240464-ab78-37cf-81a1-164d4f5ae9ce",
                                        "glosses": [
                                            "A composer of one of the Biblical Psalms."
                                        ],
                                        "tags": [
                                            "capitalized"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc51631-0839-4025-ae6f-51ec8d411179",
                                                "sense_id": "c74224e8-d428-376b-8868-571ecb4b2507",
                                                "text": "The hunter is taken in his own snare, as the great Psalmist says."
                                            },
                                            {
                                                "example_id": "f128f87f-5953-4eaf-bcee-a7a48be0e2df",
                                                "sense_id": "c74224e8-d428-376b-8868-571ecb4b2507",
                                                "text": "Either man is the creature whom the Psalmist described as \"a little lower than the angels,\" crowned with glory and honor, holding \"dominion over the works\" of his Creator; or man is a soulless, animated machine to be enslaved, used and consumed by the state for its own glorification."
                                            },
                                            {
                                                "example_id": "5744c116-2ef2-4d07-9320-c230e99dc204",
                                                "sense_id": "c74224e8-d428-376b-8868-571ecb4b2507",
                                                "text": "More than 2,500 years ago, the Psalmist of the Old Testament, for example, wrote that “the days of our years are threescore years and ten; and if by reason of strength they be fourscore years, yet is their strength labour and sorrow.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8756458c-1ae3-4bba-8054-abbf7f11594b",
                        "source_entry_id": "bb2e9e93-8c56-3254-9cdc-3c97a00dce60",
                        "source_sense_id": "1d8acbd5-75c2-3446-b520-5b0ba673f571",
                        "target_lang_word": "psalmiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psalmiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92174e02-d698-3a0c-ac38-eb396a7b44ae",
                                        "entry_id": "9fa89145-0d85-3539-97c3-3435decb5355",
                                        "glosses": [
                                            "Auteur des Psaumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db7ed9c1-c898-44a8-8190-08239c95f0de",
                                                "sense_id": "92174e02-d698-3a0c-ac38-eb396a7b44ae",
                                                "text": "Elle était inexaucée ; et enveloppée d’obscurités et de ténèbres, pleine d’incertitude et d’angoisse, ne pouvant trouver la raison qui la rendait indigne de toutes les miséricordes divines, elle élevait tout haut la plainte du Psalmiste : « Mon Dieu ! vous avez détourné de moi votre visage, et je suis tombée dans le trouble. »"
                                            },
                                            {
                                                "example_id": "74b52691-26d0-45de-94bd-961c1d111513",
                                                "sense_id": "92174e02-d698-3a0c-ac38-eb396a7b44ae",
                                                "text": "Lire les Psaumes, c'est nous décentrer de nos émotions pour entrer en résonance avec celles du psalmiste, pas toujours identiques aux nôtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
