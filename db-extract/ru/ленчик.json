                "senses": [
                    {
                        "sense_id": "163c4407-5ccd-3449-a2d6-d6f30d2e43f2",
                        "entry_id": "1abd7934-f14a-38f2-ad07-3e890f32abd7",
                        "glosses": [
                            "разг. уменьш.-ласк. к Лена"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3df6e90-819a-4058-8dd0-340bcf31e8dd",
                                "sense_id": "163c4407-5ccd-3449-a2d6-d6f30d2e43f2",
                                "text": "Это наш друг, не бойся. Его мама совсем замучила — женись да женись! Вот я и подсказала: сфотографируй нашего Ленчика и скажи маме, что это твоя невеста. ¶ Шли дни, а Лена не переставала думать о своем «женихе»."
                            }
                        ]
                    }
