                    },
                    {
                        "sense_id": "f727b166-d8c2-3be0-add8-b99cf6192c23",
                        "entry_id": "2471334f-dfb6-33ad-b33b-549cc1acfbda",
                        "glosses": [
                            "The act by which something is blasted, or blighted."
