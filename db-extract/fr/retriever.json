                "senses": [
                    {
                        "sense_id": "e339f33a-e618-3366-b3db-b75637d8a878",
                        "entry_id": "907b5b1e-8d00-3516-995d-cef097eca376",
                        "glosses": [
                            "Chien de rapport."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d71d6412-9f5e-43ea-bc56-c94ca00f54b2",
                                "sense_id": "e339f33a-e618-3366-b3db-b75637d8a878",
                                "text": "Lorsque Charlotte coupa le moteur de sa voiture devant la maison Leduc, un retriever à la fourrure d’un marron foncé se redressa et, immobile près de la galerie, les menaça de ses crocs, sonnant l’alerte en aboyant de toutes ses forces."
                            },
                            {
                                "example_id": "917acb16-2bba-4bae-9779-bc2729c00c15",
                                "sense_id": "e339f33a-e618-3366-b3db-b75637d8a878",
                                "text": "Les retrievers font partie du groupe 8 du classement des races de chien par la société centrale canine ou SCC."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf158068-ae41-4180-85cd-0fb11d712dc6",
                        "source_entry_id": "907b5b1e-8d00-3516-995d-cef097eca376",
                        "source_sense_id": "e339f33a-e618-3366-b3db-b75637d8a878",
                        "target_lang_word": "Apportierhund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apportierhund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baa89fe4-a0fd-34a6-9b26-5d6228ec4fec",
                                        "entry_id": "d92a22f1-d3c7-3f36-a99b-c31326abdc82",
                                        "glosses": [
                                            "Hund, der darauf abgerichtet ist, erlegtes/geschossenes Wild herbeizubringen (zu apportieren)"
                                        ],
                                        "tags": [
                                            "Jagd"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6b1a4b0-0efb-4b4d-bcad-a301e5beb0f2",
                                                "sense_id": "baa89fe4-a0fd-34a6-9b26-5d6228ec4fec",
                                                "text": "„…; während die eingeborenen Polizeidiener in langen weißen, bis oben zugeknöpften Kitteln an der Mauer entlang glitten, barfuß, mit roten Schärpen, den roten Turban auf dem Kopf, hurtig hin und her flitzten, geräuschlos wie Geister und immer auf dem Sprung wie Apportierhunde.“"
                                            },
                                            {
                                                "example_id": "8b3f828f-0675-434e-8445-e4487baadc87",
                                                "sense_id": "baa89fe4-a0fd-34a6-9b26-5d6228ec4fec",
                                                "text": "„Liebe Ann Landers, ich besitze einen prächtigen Apportierhund, der ziemlich bissig werden kann, wenn er von anderen Hunden angegriffen wird, mit Menschen geht er aber höchst zahm um. …“"
                                            },
                                            {
                                                "example_id": "3093746d-e38e-4976-8092-54096f99d1c2",
                                                "sense_id": "baa89fe4-a0fd-34a6-9b26-5d6228ec4fec",
                                                "text": "Denn der Lagotto Romagnolo, übrigens einer der ältesten bekannten Wasser- und Apportierhunde, gilt als Arbeitstier, will seinen Menschen gefallen und verliert nicht schnell den Spaß an der Suche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
