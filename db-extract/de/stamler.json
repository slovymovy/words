                "senses": [
                    {
                        "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                        "entry_id": "f28caea5-fc8b-307b-863e-6771d9d3fcb3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fda9d416-ddcc-4a2e-9cfa-7d34f58a4d68",
                                "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                                "text": "Frau Stamler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6c32a95e-c240-48c4-84e8-2dbfa261811f",
                                "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                                "text": "Herr Stamler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a8f53dcc-5a72-4a0e-a3e3-0888d529db9b",
                                "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                                "text": "Die Stamlers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3fd29f63-4049-479c-a832-4f0fbecfb626",
                                "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                                "text": "Der Stamler trägt nie die Schals, die die Stamler ihm strickt."
                            },
                            {
                                "example_id": "5a0c361d-5601-4f2f-bb00-38ac402f3436",
                                "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stamler kommt, geht der Herr Stamler.“"
                            },
                            {
                                "example_id": "40d4ae3d-aa88-4887-b15f-963a56021c3a",
                                "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                                "text": "Stamler kommt und geht."
                            },
                            {
                                "example_id": "81449946-322b-4640-b398-5d1df5254a78",
                                "sense_id": "51e1efee-d971-3950-8585-232732df9458",
                                "text": "Stamlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
