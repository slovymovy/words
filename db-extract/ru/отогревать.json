                                                "example_id": "45f29dc8-b359-4b3d-9a4b-ef21751d5830",
                                                "sense_id": "b0fa3e55-3426-32c8-86d5-883da27a5038",
                                                "text": "The speaker warms as he proceeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f912a90-51bb-3950-b51e-80b3797ce6cc",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To make engaged or earnest; to interest; to engage; to excite ardor or zeal in; to enliven."
