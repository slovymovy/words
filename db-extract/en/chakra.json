                        "cross_references": [
                            {
                                "target_word": "Chakra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                        "entry_id": "80b84ffe-53a3-3496-98ad-156c1d69e69d",
                                        "glosses": [
                                            "Akupunktur, Esoterik, Meditation, Spiritualismus, Bezeichnung für eins der energetischen Zentren des Körpers, verantwortlich für den Austausch von Bioenergie; energetischer Wirbel, Zentrum für spiritueller Kraft oder psychische Energie"
                                        ],
                                        "tags": [
                                            "Yoga (indische Lehre)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52133feb-9bbe-4e52-a29d-0eee4a71e7a3",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "Die Energie, die durch das Sex-Chakra fließt, nennt man Kundalini."
                                            },
                                            {
                                                "example_id": "ee76027d-924c-4fdb-b283-8e6b0c82245b",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "„Stellen Sie sich vor, dass die Seele, die Prinzessin Diana war, genau auf diese Weise zu sterben wählte, wie sie es tat, um das Herz-Chakra Englands zu öffnen.“"
                                            },
                                            {
                                                "example_id": "b1504764-b61e-49f3-9ac8-d54aa1273d76",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "„Man geht davon aus, dass jedes Chakra physischen und psychischen Einfluss auf uns Menschen hat.“"
                                            },
                                            {
                                                "example_id": "4cd54778-52ce-4cd1-a3ee-51a4afc9f409",
                                                "sense_id": "a73ebced-d5ec-3612-a3ee-49872e06e6a3",
                                                "text": "„Mein Freund hat durch viel Übung permanent alle Chakren offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
