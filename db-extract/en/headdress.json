                "translations": [
                    {
                        "translation_id": "2b76dcb2-09a3-487e-8233-fc480f0de268",
                        "source_entry_id": "8e77a618-0909-3fd6-bf9c-fa69d3655a7a",
                        "source_sense_description": "a decorative covering or ornament worn on the head",
                        "target_lang_word": "couvre-chef",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couvre-chef",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                        "entry_id": "43f021a0-03bf-35f0-add2-290cafeef779",
                                        "glosses": [
                                            "Coiffe, telle un bonnet, un chapeau, une capuche, ou un chaperon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288f2909-6b00-48cc-8df2-05df1d94aab9",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "On ne porte pas de couvre-chef dans un bureau, c’est du savoir-vivre élémentaire!"
                                            },
                                            {
                                                "example_id": "c537b0da-f0eb-4230-9d82-dc9b57bd5f9d",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "C’était un très vieux magicien\nQui sortait de son couvre-chef\nDes facteurs, des politiciens,\nDes employés SNCF, […]"
                                            },
                                            {
                                                "example_id": "a5a7faea-30e4-4369-a2e3-ed39b7083078",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "C’était un accident. Jim n’avait pas voulu aplatir son couvre-chef."
                                            },
                                            {
                                                "example_id": "d641ded2-1dac-453a-a3a9-3b854d17e852",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "Les Américains se ruèrent à terre, sans un regard pour notre guide, dont le couvre-chef négligemment tendu laissait entendre qu'il ne dédaignerait pas un pourboire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08e2404d-d2ce-43e5-ac1d-2c1f49d4d71e",
                        "source_entry_id": "8e77a618-0909-3fd6-bf9c-fa69d3655a7a",
                        "source_sense_description": "a decorative covering or ornament worn on the head",
                        "target_lang_word": "Kopfbedeckung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopfbedeckung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79ea0da9-e78e-356d-80a7-ccfb18893e4c",
                                        "entry_id": "376ceff3-7108-32b8-a0b8-c066bb872458",
                                        "glosses": [
                                            "Kleidungsstück, das auf dem Kopf getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "865107b3-e17c-460c-94ae-902a60cd5cc0",
                                                "sense_id": "79ea0da9-e78e-356d-80a7-ccfb18893e4c",
                                                "text": "„Es war eine jener bunt zusammengesetzten Kopfbedeckungen, in denen sich die Grundbestandteile der Bärenfellmütze, der Tschapka, des steifen Huts, der Otterfellkappe und der baumwollenen Zipfelmütze vereinigt fanden; …“"
                                            },
                                            {
                                                "example_id": "9560bd27-a0e0-4a21-bbb7-6cd72ee14648",
                                                "sense_id": "79ea0da9-e78e-356d-80a7-ccfb18893e4c",
                                                "text": "„Mich störten damals - und stören allerdings auch heute noch - die Kopfbedeckungen der unbekannten Leute, die waren eine Mischung zwischen Fez und Turban und schienen aus irgendwelchen türkischen Kriegen zu stammen.“"
                                            },
                                            {
                                                "example_id": "98d7f8d9-f24d-4705-a770-708f7e9b702f",
                                                "sense_id": "79ea0da9-e78e-356d-80a7-ccfb18893e4c",
                                                "text": "„Wer als Mann ohne Kopfbedeckung oder als Frau allzu weiblich gekleidet hineinging, mußte auf Angriffe gefaßt sein.“"
                                            },
                                            {
                                                "example_id": "7fa984c2-5fee-4b5a-9ff7-36ed41aff506",
                                                "sense_id": "79ea0da9-e78e-356d-80a7-ccfb18893e4c",
                                                "text": "„Manche Gäste tragen traditionelle Kopfbedeckungen, mit Federn, Muscheln, Tierfellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2042d98c-cee4-4634-86c1-3dbc05b7a39e",
                        "source_entry_id": "8e77a618-0909-3fd6-bf9c-fa69d3655a7a",
