                        "sense_id": "61861e47-1472-3f4e-9b6e-a2127002d81e",
                        "entry_id": "e53e4056-7719-3a97-ac6c-a3eabf826313",
                        "glosses": [
                            "Wald, der aus Gehölzen besteht, die nur eine geringe Höhe erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc14e05-5ad6-4844-8f97-d0e2f9031283",
                                "sense_id": "61861e47-1472-3f4e-9b6e-a2127002d81e",
                                "text": "„Sie besteht aus einem erloschenen Vulkan und ist mit Buschwald bewachsen.“"
                            },
                            {
                                "example_id": "dcb7c0e8-c9a0-4534-8edc-76c14b3b98e1",
                                "sense_id": "61861e47-1472-3f4e-9b6e-a2127002d81e",
                                "text": "„Bei solchen Anlässen hält ihn keine Uferböschung, dann fließt er voller Zerstörungswut über Wiesen, Weiden, Kiesbänke und Buschwald.“"
                            }
                        ],
