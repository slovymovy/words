                        "examples": [
                            {
                                "example_id": "8eae6868-705d-42ff-92e0-c5b07397fb79",
                                "sense_id": "1a9da5d0-5290-3bda-be2e-72e716f06420",
                                "text": "„Der Papst selbst konnte sich, als er Karl V. die Reichskrone aufs Haupt setzte, sagen, daß er nun krönte, was er sein Leben lang bestritten hatte: die Herrschaft Spaniens über das italienische Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
