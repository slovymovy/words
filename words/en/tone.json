                                "zh": "装饰和音乐为派对定下了节日的<w>基调</w>。"
                            }
                        },
                        {
                            "text": "His angry speech lowered the <w>tone</w> of the entire debate.",
                            "target_lang_translations": {
                                "ru": "Его гневная речь понизила <w>тон</w> всех дебатов.",
                                "zh": "他愤怒的演讲降低了整场辩论的<w>格调</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "set the tone",
                        "lower the tone",
                        "change the tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий характер, атмосфера или настроение места, ситуации или события.",
                        "zh": "某个地方、情况或事件的总体特征、氛围或情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тон",
                                "target_lang_sense_clarification": "общий характер, атмосфера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基调",
                                "target_lang_sense_clarification": "整体氛围或主旨"
                            },
                            {
                                "target_lang_word": "氛围",
                                "target_lang_sense_clarification": "环境给人的感觉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fa04de5-f65e-349b-8f4e-c73ff9802651",
                    "sense_definition": "The shade or quality of a colour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used warm earth <w>tones</w> to paint the landscape.",
                            "target_lang_translations": {
                                "ru": "Художник использовал теплые земляные <w>тона</w> для написания пейзажа.",
                                "zh": "艺术家用温暖的泥土<w>色调</w>来绘制这幅风景画。"
                            }
                        },
                        {
                            "text": "She chose a foundation makeup that matched her skin <w>tone</w> perfectly.",
                            "target_lang_translations": {
                                "ru": "Она выбрала тональный крем, который идеально подходил к <w>тону</w> ее кожи.",
                                "zh": "她选了一款与她肤<w>色</w>完美匹配的粉底液。"
                            }
