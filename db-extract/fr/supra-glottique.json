                        "sense_id": "5f5b308d-7e90-3da1-9a63-25f581a759e4",
                        "entry_id": "0760fe3c-f4ae-331c-b17e-a125a2162954",
                        "glosses": [
                            "Situé au-dessus de la glotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae2cc05-20f4-490e-928b-392c66121e61",
                                "sense_id": "5f5b308d-7e90-3da1-9a63-25f581a759e4",
                                "text": "Ces nouveaux orifices respiratoires internes en position supra-glottique ne résultent pas d’un recul des orifices narinaires internes des dipneustes et des amphibiens."
                            },
                            {
                                "example_id": "1806aa9a-396d-4ae7-ab5c-9476122277de",
                                "sense_id": "5f5b308d-7e90-3da1-9a63-25f581a759e4",
                                "text": "Le processus de production des sons met en œuvre trois ensembles d’organes : l’ensemble sous-glottique, l’ensemble laryngé et l’ensemble supra-glottique."
                            },
                            {
                                "example_id": "56c97dde-2634-4a98-890c-ec8678f50ec2",
                                "sense_id": "5f5b308d-7e90-3da1-9a63-25f581a759e4",
                                "text": "Après être sorti du larynx, l’air circule par les cavités supra-glottiques qui sont les cavités pharyngale, nasale et buccale."
                            }
                        ]
                    }
