                        "examples": [
                            {
                                "example_id": "d44f231e-ad74-4b01-85b0-f3ecf2e123a3",
                                "sense_id": "6229db57-586a-3545-9540-d9bd267a2814",
                                "text": "Ik herinnerde me vaag dat we vlak nadat de zon opkwam het honkbalveld hadden verlaten en zigzaggend teruggelopen waren naar het parkeerterrein."
                            },
                            {
                                "example_id": "6046c7da-07b5-48fe-bcc7-ed06a91775f9",
                                "sense_id": "6229db57-586a-3545-9540-d9bd267a2814",
                                "text": "FBI-agent Tim Slater, die de woordvoering deed namens de dienst, zegt niet bekend te zijn met het gerucht dat de schutter eerder met de Congresleden op het honkbalveld heeft gesproken. Amerikaanse media meldden dat hij mogelijk voorafgaand aan de schietpartij aan de aanwezige Congresleden vroeg of ze inderdaad leden van het Congres waren en van welke partij ze waren."
                            }
                        ]
                    }
