                    },
                    {
                        "translation_id": "66d475c2-05ed-405c-b684-0ca085dec5c1",
                        "source_entry_id": "10c42c70-7dfe-3d16-afb3-3df013bd29f2",
                        "source_sense_id": "e5028b78-105c-335f-94f5-40b1350e82f5",
                        "target_lang_word": "neodymium",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neodymium",
