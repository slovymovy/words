                    "frequency": "Low",
                    "semantic_group_id": "Technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem Einschalten muss man den neuen Hauptprozessor vorsichtig in den <w>Sockel</w> einsetzen."
