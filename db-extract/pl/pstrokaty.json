                "senses": [
                    {
                        "sense_id": "267e1667-4130-311b-9110-83e811963d32",
                        "entry_id": "bb4219fb-4530-33da-acb9-7f80bbd128f2",
                        "glosses": [
                            "odznaczający się rozmaitością barw, najczęściej jaskrawych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "029ddeaf-7fc4-43ba-97a3-f9a00065e7af",
                                "sense_id": "267e1667-4130-311b-9110-83e811963d32",
                                "text": "Wdzieję strój pstrokaty dziwacznego kroju i pomiędzy kwiaty pobiegnę w tym stroju!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
