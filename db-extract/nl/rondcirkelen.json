        "nl-extract.jsonl": [
            {
                "entry_id": "02aed149-66a1-3f1d-a5f3-cad9b100c8aa",
                "word": "rondcirkelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7d651d9-df16-3ea4-a2e4-c4bc8f74b737",
                        "entry_id": "02aed149-66a1-3f1d-a5f3-cad9b100c8aa",
                        "glosses": [
                            "in rondjes bewegen zonder zich naar een verderaf gelegen bestemming te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "955367da-ce56-4c2b-ae14-50fd5353a25a",
                                "sense_id": "e7d651d9-df16-3ea4-a2e4-c4bc8f74b737",
                                "text": "'De wandelaar die af en toe de oogen omhoog slaat, ziet de zwermen duiven rondcirkelen en wie zich op den Westertoren waagt kan de duivenplatten aanschouwen.'"
                            },
                            {
                                "example_id": "3689d521-c36c-4566-b14f-916014235cde",
                                "sense_id": "e7d651d9-df16-3ea4-a2e4-c4bc8f74b737",
                                "text": "Al die rondcirkelende opleggers, dit moet de droom zijn van de internationale drugshandelaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be59c228-3edd-4671-9048-dd8e49418ac0",
                        "source_entry_id": "02aed149-66a1-3f1d-a5f3-cad9b100c8aa",
                        "source_sense_id": "e7d651d9-df16-3ea4-a2e4-c4bc8f74b737",
                        "target_lang_word": "circle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51ef3026-8a75-3f59-8f3b-935debdeca3b",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A two-dimensional geometric figure, a line, consisting of the set of all those points in a plane that are equally distant from a given point (center)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e878ef8d-e8f6-4425-8f04-0a6543d15c03",
                                                "sense_id": "51ef3026-8a75-3f59-8f3b-935debdeca3b",
                                                "text": "The set of all points (x, y) such that (x − 1)² + y² = r² is a circle of radius r around the point (1, 0)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "903c8e1c-4907-3d1d-8d72-995e18d52798",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A two-dimensional geometric figure, a disk, consisting of the set of all those points of a plane at a distance less than or equal to a fixed distance (radius) from a given point."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b83ec7d9-9d7f-34f2-8b30-f9161672a00e",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "Any shape, curve or arrangement of objects that approximates to or resembles the geometric figures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e7a944e-2833-454d-8ffa-de8b4881bc69",
                                                "sense_id": "b83ec7d9-9d7f-34f2-8b30-f9161672a00e",
                                                "text": "Children, please join hands and form a circle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521ec77d-ce2e-3113-83aa-07a1d40eb481",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "Any shape, curve or arrangement of objects that approximates to or resembles the geometric figures.",
                                            "Any thin three-dimensional equivalent of the geometric figures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b39a7d84-12b8-4e48-b088-28d5d54207c0",
                                                "sense_id": "521ec77d-ce2e-3113-83aa-07a1d40eb481",
                                                "text": "Cut a circle out of that sheet of metal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "971bd5a9-2bfc-3237-bced-1e6d7722e0af",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "Any shape, curve or arrangement of objects that approximates to or resembles the geometric figures.",
                                            "A curve that more or less forms part or all of a circle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c448b906-c5bf-4632-8f17-43aaf3275d56",
                                                "sense_id": "971bd5a9-2bfc-3237-bced-1e6d7722e0af",
                                                "text": "The crank moves in a circle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A specific group of persons; especially one who shares a common interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7dd07aa-aaf2-4bc1-8a12-47f0bf14ade4",
                                                "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                                "text": "inner circle"
                                            },
                                            {
                                                "example_id": "e710c2b6-ff13-4cf6-a076-a917ea6ab0e2",
                                                "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                                "text": "circle of friends"
                                            },
                                            {
                                                "example_id": "eed91a69-8bc5-45ce-8a26-fdbba7694fe9",
                                                "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                                "text": "literary circle"
                                            },
                                            {
                                                "example_id": "0476d443-9960-4e0b-84c5-e2b2f61475c3",
                                                "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                                "text": "As his name gradually became known, the circle of his acquaintance widened."
                                            },
                                            {
                                                "example_id": "65d633ae-3b1b-4e91-913f-04d916149549",
                                                "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            },
                                            {
                                                "example_id": "6b58c9d4-0060-4457-a53b-63b9597b798b",
                                                "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers,[…], the jewelled animals whose moral code is the code of the barnyard—!\""
                                            },
                                            {
                                                "example_id": "fac9bf1e-155b-4ded-9705-8032af58e3a7",
                                                "sense_id": "eb53561f-ee96-312e-bef9-c5639414b399",
                                                "text": "The Rabbit could not claim to be a model of anything, for he didn’t know that real rabbits existed; he thought they were all stuffed with sawdust like himself, and he understood that sawdust was quite out-of-date and should never be mentioned in modern circles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02085655-1da3-373a-99e2-cc142b36d75b",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "The orbit of an astronomical body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2168b806-e26f-3aaf-8cd3-34bf0b1fe3aa",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A line comprising two semicircles of 30 yards radius centred on the wickets joined by straight lines parallel to the pitch used to enforce field restrictions in a one-day match."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd3531e2-5c08-35a6-a4ad-9d6f00a3d6e8",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A ritual circle that is cast three times deosil and closes three times widdershins either in the air with a wand or literally with stones or other items used for worship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1955610b-e260-3535-a838-5f4c9a67f8c3",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A traffic circle or roundabout."
                                        ],
                                        "tags": [
                                            "India",
                                            "Philippines",
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23d45bcb-aac3-49ea-b096-4b9b91aeecee",
                                                "sense_id": "1955610b-e260-3535-a838-5f4c9a67f8c3",
                                                "text": "He arrived at the lakefront and drove around the circle where the amusement park and beach used to be when he was a kid[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95c4af88-b059-3041-b427-7f30441cfc12",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "Compass; circuit; enclosure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40609c47-9546-4e56-82ed-a815b67afd67",
                                                "sense_id": "95c4af88-b059-3041-b427-7f30441cfc12",
                                                "text": "in the circle of this forest"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5732e2dd-a1ad-312c-8e4b-91ca1c330bf9",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "An instrument of observation, whose graduated limb consists of an entire circle. When fixed to a wall in an observatory, it is called a mural circle; when mounted with a telescope on an axis and in Y's, in the plane of the meridian, a meridian or transit circle; when involving the principle of reflection, like the sextant, a reflecting circle; and when that of repeating an angle several times continuously along the graduated limb, a repeating circle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97a34151-15b9-333e-8442-0706b307ff6c",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A series ending where it begins, and repeating itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0685b567-a38d-43e5-b93f-ed09ac617eee",
                                                "sense_id": "97a34151-15b9-333e-8442-0706b307ff6c",
                                                "text": "Thus in a circle runs the peasant's pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc5ee525-3e1e-3383-b278-dee52e068491",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A form of argument in which two or more unproved statements are used to prove each other; inconclusive reasoning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33326f07-4326-4472-a73a-4037df6cecd8",
                                                "sense_id": "bc5ee525-3e1e-3383-b278-dee52e068491",
                                                "text": "That heavy Bodies deſcend by gravity, is no better an account then we might expect from a Ruſtick: and again; that Gravity is a quality whereby an heavy body deſcends, is an impertinent Circle, and teacheth nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff9e945-8a37-3e6e-ac1a-5bc38369885f",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "Indirect form of words; circumlocution."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "indirect"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ce2f5c-0449-414b-87e5-5dee5066de3f",
                                                "sense_id": "2ff9e945-8a37-3e6e-ac1a-5bc38369885f",
                                                "text": "Has he given the lie, / In circle, or oblique, or semicircle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47ddaecb-d174-3895-b8b2-df2d9206bac4",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A territorial division or district."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dec7c67-90e1-4d97-9e2e-c665e014c7ab",
                                                "sense_id": "47ddaecb-d174-3895-b8b2-df2d9206bac4",
                                                "text": "The ten Circles of the Holy Roman Empire were those principalities or provinces which had seats in the German Diet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90ee57e6-3d29-3062-9a73-ae67e78c0573",
                                        "entry_id": "8c9922c5-182a-30aa-b403-910ca939badf",
                                        "glosses": [
                                            "A bagginess of the skin below the eyes from lack of sleep."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee20f25-4eb2-4ea2-8af0-3b8819aed0d9",
                                                "sense_id": "90ee57e6-3d29-3062-9a73-ae67e78c0573",
                                                "text": "After working all night, she had circles under her eyes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "circle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54929ef5-0552-3584-8b49-6a6518b2e8c0",
                                        "entry_id": "d6671169-1605-3114-9f5e-e0a6e75a9886",
                                        "glosses": [
                                            "To travel around along a curved path."
