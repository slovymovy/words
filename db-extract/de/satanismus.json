                                "target_senses": [
                                    {
                                        "sense_id": "1477bce2-fb0d-31ba-a0df-2320cc52f9ae",
                                        "entry_id": "a320a3ed-8c07-30c9-a87b-f4ee7fdea2f4",
                                        "glosses": [
                                            "Worship or reverence to Satan (usually synonymous with \\\"the Devil\\\")."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c05a7b-2e80-4991-b4af-d2405e35ce40",
                                                "sense_id": "1477bce2-fb0d-31ba-a0df-2320cc52f9ae",
                                                "text": "Religious groups that follow Satanism include Luciferians and Laveyans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5fe05e-9174-3d46-accf-2b06b23ca6e5",
                                        "entry_id": "a320a3ed-8c07-30c9-a87b-f4ee7fdea2f4",
                                        "glosses": [
                                            "A profession, philosophy, or ideological construct featuring a positive, admirable, or useful association to the figure, character or entity known as 'Satan'; or, featuring opposition to all morality and the procurement of what is wanted regardless of the consequences concerning others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68f9b6ad-9ec6-3adc-9716-69116aa295a9",
                                        "entry_id": "a320a3ed-8c07-30c9-a87b-f4ee7fdea2f4",
                                        "glosses": [
                                            "LaVeyan Satanism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b576c97c-5153-3459-998a-241fb0f0ab0e",
                                        "entry_id": "a320a3ed-8c07-30c9-a87b-f4ee7fdea2f4",
