                "senses": [
                    {
                        "sense_id": "65f5d898-8cfe-3295-9b79-740f099bfd07",
                        "entry_id": "1ade1bf6-b931-3f01-9559-efd3d85cfb75",
                        "glosses": [
                            "een overblijfsel van het lichaam van een heilige of een voorwerp dat in aanraking met een heilige geweest is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "240db947-5da5-4f41-898f-8754f21ed7e0",
                                "sense_id": "65f5d898-8cfe-3295-9b79-740f099bfd07",
                                "text": "Duizenden gelovigen staan in de Italiaanse stad Padua in de rij om een glimp op te vangen van de relikwieën van de heilige Antonius. Het skelet is voor het eerst sinds 1981 weer van dichtbij te zien voor het publiek."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec8a8a5f-66fd-3e3b-be20-9c55e2e21859",
                        "entry_id": "1ade1bf6-b931-3f01-9559-efd3d85cfb75",
                        "glosses": [
                            "voorwerp, afkomstig van een bemind of vereerd persoon of afkomstig uit vroeger tijd, waaraan de bezitter veel waarde toekent"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aca5330f-ce91-4abc-a39b-2c5c8ef747d0",
                        "source_entry_id": "1ade1bf6-b931-3f01-9559-efd3d85cfb75",
                        "source_sense_id": "65f5d898-8cfe-3295-9b79-740f099bfd07",
                        "source_sense_description": "een overblijfsel van het lichaam van een heilige of een voorwerp dat...",
                        "target_lang_word": "Reliquie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reliquie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f25251b9-ef83-3413-84d3-aee7ab2f2bb1",
                                        "entry_id": "cb7e2322-6df8-36e2-9eb9-932d9535fd9d",
                                        "glosses": [
                                            "körperlicher Überrest oder Gegenstand eines Heiligen, der aufbewahrt und religiös verehrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe57f35-1e4c-4ab1-9679-8f11cc5bfd50",
                                                "sense_id": "f25251b9-ef83-3413-84d3-aee7ab2f2bb1",
                                                "text": "Mit jener Reliquie erhielt das Kloster einen wertvollen Schatz."
                                            },
                                            {
                                                "example_id": "f80977ef-bfde-4eff-a531-e467443f6029",
                                                "sense_id": "f25251b9-ef83-3413-84d3-aee7ab2f2bb1",
                                                "text": "„Sieben Jahre lang ziehen die Mönche rastlos durch England, versuchen sogar samt der Reliquie nach Irland überzusetzen, doch ein Sturm zwingt sie zur Umkehr.“"
                                            },
                                            {
                                                "example_id": "564cdcb1-178a-4470-bae4-8436360fe30b",
                                                "sense_id": "f25251b9-ef83-3413-84d3-aee7ab2f2bb1",
                                                "text": "„In der Krypta wurden in erster Linie die heiligen Reliquien aufbewahrt und verehrt.“"
                                            },
                                            {
                                                "example_id": "162cd528-5395-4d83-bc1f-9bbd8c722b90",
                                                "sense_id": "f25251b9-ef83-3413-84d3-aee7ab2f2bb1",
                                                "text": "„Der Exorzist zog im Stehen sein Rituale aus der Tasche sowie die Stola, die er sich umhängte, und schließlich eine Reliquie, die er der Schlafenden auf die Brust legte.“"
                                            },
                                            {
                                                "example_id": "6f2e4e92-e1b4-4041-86e9-2f93899c2287",
                                                "sense_id": "f25251b9-ef83-3413-84d3-aee7ab2f2bb1",
                                                "text": "„Wenn auch Reliquien längst nicht mehr Brauch seien, dieses Ding jedenfalls hätte der ganzen Familie Glück gebracht.“"
                                            },
                                            {
                                                "example_id": "bed6e580-d881-427b-98fd-5bc02a287f6a",
                                                "sense_id": "f25251b9-ef83-3413-84d3-aee7ab2f2bb1",
                                                "text": "„Diese sehr kostbare Reliquie sei der Heilige Rock, also der Rock, den der Herr Jesus getragen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f902ccd-6ff0-40fa-a123-2fcf6f49d466",
                        "source_entry_id": "1ade1bf6-b931-3f01-9559-efd3d85cfb75",
                        "source_sense_id": "65f5d898-8cfe-3295-9b79-740f099bfd07",
                        "source_sense_description": "een overblijfsel van het lichaam van een heilige of een voorwerp dat...",
                        "target_lang_word": "relic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c389991f-9f0b-3b39-bb5f-851fcceeb8c4",
                                        "entry_id": "a9003875-b5d0-3728-9568-133e740687fc",
                                        "glosses": [
                                            "That which remains; that which is left after loss or decay; a remaining portion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b225d489-4b06-404a-b6d8-79fb389c66cd",
                                                "sense_id": "c389991f-9f0b-3b39-bb5f-851fcceeb8c4",
                                                "text": "[…] let him not ask our pardon;\nThe nature of his great offence is dead,\nAnd deeper than oblivion we do bury\nThe incensing relics of it […]"
                                            },
                                            {
                                                "example_id": "2dd37f48-3f42-4645-a1dd-6b3c41ec1edb",
                                                "sense_id": "c389991f-9f0b-3b39-bb5f-851fcceeb8c4",
                                                "text": "Though a Cup of cold water from ſome hand may not be without it's reward, yet ſtick not thou for Wine and Oyl for the Wounds of the Distreſſed, and treat the poor, as our Saviour did the Multitude, to the reliques of ſome baskets."
                                            },
                                            {
                                                "example_id": "d41d350f-0937-4f32-a4da-3f939995cafe",
                                                "sense_id": "c389991f-9f0b-3b39-bb5f-851fcceeb8c4",
                                                "text": "1797, Ann Radcliffe, The Italian, London: T. Cadell Jun. & W. Davies, Volume 2, Chapter 6, p. 184,\nIt appeared, from […] the ruins scattered distantly along its skirts, to be a part of the city entirely abandoned by the modern inhabitants to the reliques of its former grandeur."
                                            },
                                            {
                                                "example_id": "09c3e9fe-67ea-4b0b-8d4a-0d2bcdadaa6b",
                                                "sense_id": "c389991f-9f0b-3b39-bb5f-851fcceeb8c4",
                                                "text": "She exerted the last relics of her wasted strength to gain a prominent position upon a ledge of the rocks behind her […]"
                                            },
                                            {
                                                "example_id": "9ecedf21-ba6a-4778-a5ab-c4b9b23bff5a",
                                                "sense_id": "c389991f-9f0b-3b39-bb5f-851fcceeb8c4",
                                                "text": "[T]hey know that the low social level of the mass of the race is responsible for much discrimination against it, but they also know, and the nation knows, that relentless color-prejudice is more often a cause than a result of the Negro’s degradation; they seek the abatement of this relic of barbarism, and not its systematic encouragement and pampering by all agencies of social power from the Associated Press to the Church of Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5785416-cd85-3dd4-91e0-26ae1c1976d2",
                                        "entry_id": "a9003875-b5d0-3728-9568-133e740687fc",
                                        "glosses": [
                                            "Something old and outdated, possibly kept for sentimental reasons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a053f3-8989-4030-838a-43c2a4658f2a",
                                                "sense_id": "d5785416-cd85-3dd4-91e0-26ae1c1976d2",
                                                "text": "[…] the imperfect light entering by their narrow casements showed bedsteads of a hundred years old; chests in oak or walnut, looking, with their strange carvings of palm branches and cherubs’ heads, like types of the Hebrew ark; rows of venerable chairs, high-backed and narrow; stools still more antiquated, on whose cushioned tops were yet apparent traces of half-effaced embroideries, wrought by fingers that for two generations had been coffin-dust. All these relics gave to the third storey of Thornfield Hall the aspect of a home of the past: a shrine of memory."
                                            },
                                            {
                                                "example_id": "2f8f7057-4b1d-400b-a93b-8cb936908caa",
                                                "sense_id": "d5785416-cd85-3dd4-91e0-26ae1c1976d2",
                                                "text": "Published in 1982, the now out-of-print computer guide is a real relic, full of dozens of black-and-white pictures of large, bulky computers that you would sooner find in the Smithsonian than on anybody's desk today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b0bfc6-9833-3eeb-96a4-335d6210b92f",
                                        "entry_id": "a9003875-b5d0-3728-9568-133e740687fc",
                                        "glosses": [
                                            "A part of the body of a saint, or an ancient religious object, kept for veneration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cbf742d-582f-4ea8-a72d-410af81bbb24",
                                                "sense_id": "98b0bfc6-9833-3eeb-96a4-335d6210b92f",
                                                "text": "Why ſhould onely I,\nOf all the other Princes of the World,\nBe caſ’d-vp, like a holy Relique?"
                                            },
                                            {
                                                "example_id": "8f5d6ba3-496b-438e-bdbe-ee3df292e1b8",
                                                "sense_id": "98b0bfc6-9833-3eeb-96a4-335d6210b92f",
                                                "text": "No Anchorite in the exstasy of devotion, ever adored a relique with more fervour than that with which I kissed this inimitable proof of my charmer’s candour, generosity and affection!"
                                            },
                                            {
                                                "example_id": "3603bcc5-fec3-4cd2-b59a-402e7383c077",
                                                "sense_id": "98b0bfc6-9833-3eeb-96a4-335d6210b92f",
                                                "text": "[…] the duke, in order to support their drooping hopes, ordered a procession to be made with the reliques of St. Valori, and prayers to be said for more favourable weather."
                                            },
                                            {
                                                "example_id": "d045a512-85e2-442f-befa-4585094a4028",
                                                "sense_id": "98b0bfc6-9833-3eeb-96a4-335d6210b92f",
                                                "text": "During that time he had been living with his youthful memory of her; but she had doubtless had other and more tangible companionship. Perhaps she too had kept her memory of him as something apart; but if she had, it must have been like a relic in a small dim chapel, where there was not time to pray every day...."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "145ca413-8152-3f18-9e96-c96b3dff7009",
                                        "entry_id": "a9003875-b5d0-3728-9568-133e740687fc",
                                        "glosses": [
                                            "A particle or entity that has existed since the Big Bang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86cd29a2-857a-42bf-87fc-f2cef4dedb52",
                                                "sense_id": "145ca413-8152-3f18-9e96-c96b3dff7009",
                                                "text": "One of the primary targets of current and especially future cosmological observations are light thermal relics of the hot big bang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "relic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "903192be-d200-3077-9d0e-ad36c28cbcfb",
                                        "entry_id": "cd7ce87d-c59b-33ae-ba21-7d1d54ba3f65",
                                        "glosses": [
                                            "To cause (an object) to appear old or worn, to distress."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c16e878-4bfe-4f2b-94d5-499948eab4b4",
                                                "sense_id": "903192be-d200-3077-9d0e-ad36c28cbcfb",
                                                "text": "Age has become a fetish in the world of guitars where large amounts of money are paid for a specially “reliced” guitar. As one company, Relic Guitars, which offers this service claims, “The idea behind relicing a guitar is to artificially replicate the natural wear that occurs over many years […]”"
                                            },
                                            {
                                                "example_id": "60c455d5-d1c1-4880-9d9e-ec048498247c",
                                                "sense_id": "903192be-d200-3077-9d0e-ad36c28cbcfb",
                                                "text": "The whole idea of relicing an instrument is to accelerate the wear and tear that normally occurs over decades."
                                            },
                                            {
                                                "example_id": "059ba60c-4515-4a69-94de-063e67593fd7",
                                                "sense_id": "903192be-d200-3077-9d0e-ad36c28cbcfb",
                                                "text": "He's since run his own shop, building, winding/making pickups, doing restorations and relicing guitars."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "relic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38f8083a-12ee-3d74-af3a-054fb5fa387f",
                                        "entry_id": "c2f576e2-b37a-3258-a1a5-34d27221f6be",
                                        "glosses": [
                                            "Pertaining to the Big Bang."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c01453-eaa5-496f-ade1-e7a112976ce3",
                                                "sense_id": "38f8083a-12ee-3d74-af3a-054fb5fa387f",
                                                "text": "A more realistic model must include the presence of perturbations whose extra energy can produce distortions of the relic radiation spectrum."
                                            },
                                            {
                                                "example_id": "f4866455-fa6b-4d3c-8a41-f24918d5acf7",
                                                "sense_id": "38f8083a-12ee-3d74-af3a-054fb5fa387f",
                                                "text": "While Lasserre acknowledges that physicists are still decades away from observing a direct relic neutrino signal, he says that this work represents an important step forward in the search for the holy grail of neutrino physics."
                                            },
                                            {
                                                "example_id": "4d3f7448-ba67-4f9a-8cb8-c4706a5a870d",
                                                "sense_id": "38f8083a-12ee-3d74-af3a-054fb5fa387f",
                                                "text": "We carry out model-independent analysis to obtain the temperature at the end of inflation and the estimate for the upper bound on the Hubble parameter to circumvent the problem due to relic gravitational waves"
                                            },
                                            {
                                                "example_id": "813648ac-6a22-447a-9d71-467f5935a1b2",
                                                "sense_id": "38f8083a-12ee-3d74-af3a-054fb5fa387f",
                                                "text": "This has been very successfully employed by measuring the relic abundances of the light elements, which were synthesized about three minutes after the beginning of the universe during big bang nucleosynthesis (BBN)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a37a7e3-c50e-409c-b83f-0f164d54fbf2",
                        "source_entry_id": "1ade1bf6-b931-3f01-9559-efd3d85cfb75",
                        "source_sense_id": "65f5d898-8cfe-3295-9b79-740f099bfd07",
                        "source_sense_description": "een overblijfsel van het lichaam van een heilige of een voorwerp dat...",
                        "target_lang_word": "relique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f27f5289-8acd-327a-8c10-d3a8e8875d95",
                                        "entry_id": "06eb1383-f78b-3cf7-8b34-e7c2bd9c04d5",
                                        "glosses": [
                                            "Ce qui reste d’un saint, d’un martyr, voire de Jésus-Christ lui-même, après sa mort."
                                        ],
                                        "tags": [
                                            "Funéraire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f736fcd-f2a8-4e28-936f-c37e58896d02",
                                                "sense_id": "f27f5289-8acd-327a-8c10-d3a8e8875d95",
                                                "text": "Le vol des choses consacrées à Dieu était un sacrilège, parce que ce vol renfermait une profanation de choses saintes : tel était le vol des calices, ciboires, reliques, images et même des troncs d’église."
                                            },
                                            {
                                                "example_id": "7afc1d42-b5a5-4754-b1a9-793bcbb2fc34",
                                                "sense_id": "f27f5289-8acd-327a-8c10-d3a8e8875d95",
                                                "text": "En 1708, le deuxième dimanche de Carême, les reliques de sainte Gaudence, envoyées de Rome pour la paroisse d’Hauteville, ont été enchâssées dans un reliquaire de bois doré dans l'église de cette ville par M. le doyen de Rethel avec solennité."
                                            },
                                            {
                                                "example_id": "52da7785-d1ec-426d-a338-7af8c3bcda90",
                                                "sense_id": "f27f5289-8acd-327a-8c10-d3a8e8875d95",
                                                "text": "Souvent, histoire de passer le temps, les paléopathologistes entrent dans les églises dans l’espoir d’y repérer une tombe atypique, une relique extravagante, une inscription funéraire plus ou moins attirante."
                                            },
                                            {
                                                "example_id": "00eb37ef-8608-4541-aa1d-6063f94f3664",
                                                "sense_id": "f27f5289-8acd-327a-8c10-d3a8e8875d95",
                                                "text": "L’histoire du culte de saint Bond à Sens, à Paris et dans le diocèse de Soissons, de même que l’histoire de ses reliques, ont fait l’objet d’un long développement en 1867 de la part des bollandistes, travail nécessitant une actualisation."
                                            },
                                            {
                                                "example_id": "3e1a6e9d-e6be-42e2-8c5b-0dccf84ba153",
                                                "sense_id": "f27f5289-8acd-327a-8c10-d3a8e8875d95",
                                                "text": "Une boutique, un bouge obscur, rempli d’images de sainteté : paroissiens slaves, images byzantines, icons dorées, reliques, vieilleries saugrenues, débris humains, os de morts enchâssés dans des dorures et des perles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623482bd-2566-3fd2-a247-e314c66efc81",
                                        "entry_id": "06eb1383-f78b-3cf7-8b34-e7c2bd9c04d5",
                                        "glosses": [
                                            "Ce qui reste d’une personne importante après sa mort, soit le corps entier, soit une partie du corps, soit même ce qui lui a appartenu, qui a été à son usage, et qui est gardé en souvenir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48783127-73fb-4ca8-a5d8-007af1037fab",
                                                "sense_id": "623482bd-2566-3fd2-a247-e314c66efc81",
                                                "text": "C’est une collection de reliques, non pas de saints, mais de rois. En effet, chaque papier enveloppait un os, des cheveux ou de la barbe. — Il y avait une rotule de Charles IX, le pouce de François Iᵉʳ, un fragment du crâne de Louis XIV, une côte de Henri II, une vertèbre de Louis XV, de la barbe de Henri IV et des cheveux de Louis XIII."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28479dfb-906a-347a-94f4-b1057e07cebc",
                                        "entry_id": "06eb1383-f78b-3cf7-8b34-e7c2bd9c04d5",
                                        "glosses": [
                                            "Quelque chose de précieux que l’on garde en souvenir."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32d1e2ad-b488-4b91-b0c0-97135caa4b6a",
                                                "sense_id": "28479dfb-906a-347a-94f4-b1057e07cebc",
                                                "text": "Pour arracher l’espèce entière à l’animalité il ne fallait que deux conditions : que l’on conservât dans des locaux surveillés les reliques – toiles, livres, statues – des clercs morts ; qu’il restât au moins un clerc vivant pour continuer la besogne et fabriquer les reliques futures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065cdb51-daf9-3055-9cb3-e96b36817032",
                                        "entry_id": "06eb1383-f78b-3cf7-8b34-e7c2bd9c04d5",
                                        "glosses": [
                                            "Dernier descendant d’une espèce presque disparue ; fossile vivant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "137f1d83-d667-445f-8d29-306d8a70af52",
                                                "sense_id": "065cdb51-daf9-3055-9cb3-e96b36817032",
                                                "text": "Les arbres cauliflores tels l'arbre de Judée ou le caroubier, ou encore des herbacées reviviscentes comme Haberlea et Ramonda peuvent aussi être considérés comme des reliques de cette époque."
                                            },
                                            {
                                                "example_id": "4ee70ca1-9d05-4d8d-bdda-133a39a92ba9",
                                                "sense_id": "065cdb51-daf9-3055-9cb3-e96b36817032",
                                                "text": "Ces petits ARN qui infectent les plantes pourraient être les reliques d’un « monde ARN » ancestral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4adf0674-f669-3975-b6f4-a893d9458e49",
                                        "entry_id": "06eb1383-f78b-3cf7-8b34-e7c2bd9c04d5",
                                        "glosses": [
                                            "Témoin d’une époque ancienne, d’un climat passé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9caf7a4f-a606-4275-94ea-eda56d377cc4",
                                                "sense_id": "4adf0674-f669-3975-b6f4-a893d9458e49",
                                                "text": "Quelques massifs de feuillus, comprenant surtout des Chênes sessiles (Quercus sessiliflora), parfois des Chênes pubescents (Q. pubescens), seraient les reliques d’une forêt climacique discontinue ; des défrichements successifs commencés à l’époque gallo-romaine, poursuivis au Moyen-Age, auraient fait disparaître la majeure partie de ces bois (LAURENT, 1920)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc5d307-73c5-3d88-9a2d-b1f51c5b7c3f",
                                        "entry_id": "06eb1383-f78b-3cf7-8b34-e7c2bd9c04d5",
                                        "glosses": [
                                            "Chose qui appartient au passé ou à une époque révolue."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca76173f-4d6a-4e4a-98ce-4b1e57e2d34f",
                                                "sense_id": "5fc5d307-73c5-3d88-9a2d-b1f51c5b7c3f",
                                                "text": "Le passe vaccinal, relique de la double vague Delta-Omicron de décembre, est devenu au fil des semaines un objet encombrant pour le gouvernement, dont l’utilité fait débat à l’heure de la décrue et qu’il faudra de surcroît débrancher à quelques encablures du premier tour de l'élection présidentielle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
