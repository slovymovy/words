                        "examples": [
                            {
                                "example_id": "8bc8121b-edf5-43d8-b549-24cdec382b88",
                                "sense_id": "2fd15d93-2986-346c-99d1-eb6999d84463",
                                "text": "\"The decimation among the Indians I knew of personally, and the hospital, established for their benefit, was a Hudson's Bay building not a stone's throw from my own quarters.\"",
                                "translation": "Die Dezimierung unter den Indianern kannte ich aus eigener Anschauung, und das Spital, das zu ihrem Wohl errichtet wurde, war ein Gebäude der Hudson Bay [Gesellschaft] keinen Steinwurf von meinem Quartier entfernt."
                            }
                        ],
