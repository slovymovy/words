                "senses": [
                    {
                        "sense_id": "60ff86a3-601c-3ee5-b618-6311ede29506",
                        "entry_id": "6db5b347-bdae-3ed9-9e8d-5c66128a2837",
                        "glosses": [
                            "zeer zware machine met rollen die gebruikt wordt om wegen te effenen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4862a2c8-347b-3433-940c-ed66f77e3cc9",
                        "entry_id": "6db5b347-bdae-3ed9-9e8d-5c66128a2837",
                        "glosses": [
                            "bijnaam voor de werking of het beleid van een staat, organisatie of instelling die gewone burgers overweldigt, danwel voor een persoon die andere mensen in een gesprek of wedstrijd volledig domineert."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1287aa73-8185-42f7-b503-74c5b0c1bf18",
                                "sense_id": "4862a2c8-347b-3433-940c-ed66f77e3cc9",
                                "text": "De pariastatus van zijn familie maakt Steven Avery tot een ideale verdachte. Wie neemt het voor hem op? Hij dreigt onder de pletwals van de rechtstaat terecht te komen."
                            },
                            {
                                "example_id": "320159d7-5e5b-4a34-a13e-bf9258218000",
                                "sense_id": "4862a2c8-347b-3433-940c-ed66f77e3cc9",
                                "text": "De Franse ambtenaren hebben vandaag het openbare leven in Frankrijk goeddeels lamgelegd. Spoorwegen, ziekenhuizen, onderwijs en de luchtverkeersleiders staken tegen maatregelen van de regering van president Macron. Hij is volgens de vakbonden een 'liberale pletwals'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07b8379f-7a7f-4d68-9fea-973121210f50",
                        "source_entry_id": "6db5b347-bdae-3ed9-9e8d-5c66128a2837",
                        "source_sense_id": "60ff86a3-601c-3ee5-b618-6311ede29506",
                        "source_sense_description": "machine die wegen effent",
                        "target_lang_word": "Straßenwalze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8b33e818-b8e8-4e1d-b663-4d1dca244b2e",
                        "source_entry_id": "6db5b347-bdae-3ed9-9e8d-5c66128a2837",
                        "source_sense_id": "60ff86a3-601c-3ee5-b618-6311ede29506",
                        "source_sense_description": "machine die wegen effent",
                        "target_lang_word": "Walze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "627facad-e68f-3919-9b63-b0df9dbde2c1",
                                        "entry_id": "7960d504-4f10-3893-a917-39848ae29c80",
                                        "glosses": [
                                            "runder und sehr breiter, sehr schwerer Maschinenteil der Dampfwalze oder Straßenwalze, der vorn angenietet wird und dessen Einsatz im Straßenbau vorkommt, um Kies und andere kleine Steine zu zerdrücken und so die Oberfläche zu glätten"
                                        ],
                                        "tags": [
                                            "Baumaschine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c281b589-fd37-4bc2-a85f-b118b3ed6a90",
                                                "sense_id": "627facad-e68f-3919-9b63-b0df9dbde2c1",
                                                "text": "Vor der Verlegung der Schottersteine muss der Kies der Straße mit einer Walze geglättet werden."
                                            },
                                            {
                                                "example_id": "00ae3286-4484-4b6c-86c7-a1a15feb2b22",
                                                "sense_id": "627facad-e68f-3919-9b63-b0df9dbde2c1",
                                                "text": "„Da, wo der Rasen hinkommen sollte, zog Papa eine schwere Walze hinter sich her.“"
                                            },
                                            {
                                                "example_id": "9466ccf1-f915-41fa-b5cd-eab20634a89b",
                                                "sense_id": "627facad-e68f-3919-9b63-b0df9dbde2c1",
                                                "text": "„Auf den knorrigen Sesseln lagen Schafsfelle, auf dem Boden Rentierfelle, die ihre Beine seitlich wegstreckten, eigentlich sahen sie aus wie nach schweren Unfällen, wie von Walzen überfahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ecb9ecb8-b274-3efc-b0a5-8b6d1fa90f7e",
                                        "entry_id": "7960d504-4f10-3893-a917-39848ae29c80",
                                        "glosses": [
                                            "organisiertes Knäuel aufgewickelten Seils in Form eines Kreises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5429ba3-d2b3-4fad-90a0-689f99fa0df8",
                                                "sense_id": "ecb9ecb8-b274-3efc-b0a5-8b6d1fa90f7e",
                                                "text": "Nachdem die Matrosen alle Segel abgenommen hatten, rollten sie die Seile zu Walzen, die sie dann auf dem Deck ordentlich aufstapelten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0fd52a21-4bbc-366c-9849-6e62f72294e1",
                                        "entry_id": "7960d504-4f10-3893-a917-39848ae29c80",
                                        "glosses": [
                                            "der zylinderförmige Teil eines Revolvers, der oft aus drei Patronenkammern besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "119c5061-a2d6-4728-bf24-5837f4122773",
                                                "sense_id": "0fd52a21-4bbc-366c-9849-6e62f72294e1",
                                                "text": "Der Polizist entnahm dem Revolver seine Walze, um sechs frische Patronen nachzuladen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "63c10709-2881-3c70-bc63-0f8a2d0cd7bc",
                                        "entry_id": "7960d504-4f10-3893-a917-39848ae29c80",
                                        "glosses": [
                                            "die Form eines geraden Kreiszylinders"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df5db293-f08d-4f72-9737-8a2f6322afb8",
                                                "sense_id": "63c10709-2881-3c70-bc63-0f8a2d0cd7bc",
                                                "text": "Es wurden hauptsächlich geometrische Formen für Schmuckstücke geschliffen, wie zum Beispiel Walzen oder Kugeln."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "70f1b2ab-c972-3acd-b09e-2b426603402a",
                                        "entry_id": "7960d504-4f10-3893-a917-39848ae29c80",
                                        "glosses": [
                                            "Ackerwalze"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b468b71-5ddf-41b9-975e-6d3e323f85fe",
                                                "sense_id": "70f1b2ab-c972-3acd-b09e-2b426603402a",
                                                "text": "Bei 10 ha Ackerland lohnt es sich nicht, eine eigene Walze zu haben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1193c13c-e453-30cc-98d2-c4e411bda1c9",
                                        "entry_id": "7960d504-4f10-3893-a917-39848ae29c80",
                                        "glosses": [
                                            "ein längliches, rundes Teil in Maschinen, zum Beispiel in einer Druckmaschine oder in der Blechherstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e212ff9-2a7e-418a-997a-04de8bdda492",
                                                "sense_id": "1193c13c-e453-30cc-98d2-c4e411bda1c9",
                                                "text": "Die Walze muss ausgetauscht werden, wenn sie eine Scharte oder auch nur Kratzer aufweist."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
