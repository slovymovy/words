                                "target_senses": [
                                    {
                                        "sense_id": "fc441822-55b5-3f86-bc47-73121c72de8a",
                                        "entry_id": "a1cf7851-ec7d-33eb-acf5-d4d655cc6d28",
                                        "glosses": [
                                            "Wildpferd, das in der nordamerikanischen Prärie lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b676639b-a413-4e98-af0d-23568efa34e0",
                                                "sense_id": "fc441822-55b5-3f86-bc47-73121c72de8a",
                                                "text": "„Unterwegs fand ich einen Mustang (wildes Pferd), einen schönen Hengst von glänzend brauner Farbe.“"
                                            },
                                            {
                                                "example_id": "3da62674-73f4-4e5e-aec2-a4473d8f3580",
                                                "sense_id": "fc441822-55b5-3f86-bc47-73121c72de8a",
                                                "text": "„Bei der Befreiung der Mustangs aus der Hand der Pferdediebe geht es um Leben und Tod.“"
                                            },
                                            {
                                                "example_id": "9423dff1-292f-42ce-b911-6cd10dc45298",
                                                "sense_id": "fc441822-55b5-3f86-bc47-73121c72de8a",
                                                "text": "„Aus Aufzeichnungen spanischer Behörden ist bekannt, dass vor 1650 kein einziger Mustang in der Prärie lebte.“"
                                            },
                                            {
                                                "example_id": "632464f5-e370-4bf4-b692-fde4591ff37b",
                                                "sense_id": "fc441822-55b5-3f86-bc47-73121c72de8a",
                                                "text": "„In einer Schattenjagd kam eine Herde Mustangs heran, wendete, zerschlug sich und rottete sich führerlos unentschlossen wieder zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8979310-7133-3132-9f9b-de95d3395583",
                                        "entry_id": "a1cf7851-ec7d-33eb-acf5-d4d655cc6d28",
                                        "glosses": [
                                            "Name eines Sportwagens der Firma Ford"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74300f7a-58c0-466d-8420-6e72e65f0400",
                                                "sense_id": "a8979310-7133-3132-9f9b-de95d3395583",
                                                "text": "Ich hörte noch wie der Motor des Mustangs beschleunigte, danach war es wieder totenstill."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
