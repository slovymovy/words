                "senses": [
                    {
                        "sense_id": "3275ec34-1a6d-349a-bd91-740b7351213d",
                        "entry_id": "c9314803-69f6-3cb2-9ea5-f20f23f13254",
                        "glosses": [
                            "Anémone de mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b928c241-c0dc-4b1b-8bb5-fa58d776d52a",
                                "sense_id": "3275ec34-1a6d-349a-bd91-740b7351213d",
                                "text": "Sur les côtes de la Bretagne et de l’Anjou, Bernard de Jussieu et Guettard mirent en pièces à l’envi actinies et astéries."
                            },
                            {
                                "example_id": "3bd31f4d-2886-4519-a2b2-0fa70ea1b744",
                                "sense_id": "3275ec34-1a6d-349a-bd91-740b7351213d",
                                "text": "Le temps écoulé entre la dernière nourriture et la mort de l’actinie a varié entre 6 et 16 jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ee78fb7-0593-424e-b7cd-3fdf83c82991",
                        "source_entry_id": "c9314803-69f6-3cb2-9ea5-f20f23f13254",
                        "source_sense_id": "3275ec34-1a6d-349a-bd91-740b7351213d",
                        "target_lang_word": "actinia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actinia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a6a623-cdf8-3cc2-8360-67d442240a6c",
                                        "entry_id": "7c733e51-4a6f-37b8-94f6-70d9dd6254c7",
                                        "glosses": [
                                            "A sea anemone, specifically a member of the genus Actinia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a90c412-6413-4a14-95a2-676ff6b94239",
                                                "sense_id": "b5a6a623-cdf8-3cc2-8360-67d442240a6c",
                                                "text": "The Abbe Dicquemarre has further elucidated the history of the actinia; and observed their manner of taking their prey by inclosing it in these beautiful rays like a net."
                                            },
                                            {
                                                "example_id": "01a927db-dbb8-47c1-b76d-f5fcee0e50c4",
                                                "sense_id": "b5a6a623-cdf8-3cc2-8360-67d442240a6c",
                                                "text": "Cut off the tentacles of an actinia, and they are replaced in a short time, and the experiment may be repeated indefinitely."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b21b6af0-aa9d-4f0a-be7a-034756852331",
                        "source_entry_id": "c9314803-69f6-3cb2-9ea5-f20f23f13254",
                        "source_sense_id": "3275ec34-1a6d-349a-bd91-740b7351213d",
