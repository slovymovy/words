                    {
                        "translation_id": "9bdaa8b8-e262-4a60-835c-faf75ea486f7",
                        "source_entry_id": "fca4bb3f-8009-30ad-b463-2ccbaa905bed",
                        "source_sense_description": "one who studies theology",
                        "target_lang_word": "Theologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
