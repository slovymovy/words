                ],
                "senses": [
                    {
                        "sense_id": "3dab8f06-5313-3fdc-9881-423cd1a99c7f",
                        "entry_id": "43347765-13bf-3d7d-bb4d-8133ceee7512",
                        "glosses": [
                            "wilde, dichte Büsche, die dicht nebeneinander stehen und Dornen tragen"
                        ],
                        "tags": [
                            "outdated",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "a463e3e3-75fb-4efc-b573-c84261622b31",
                                "sense_id": "3dab8f06-5313-3fdc-9881-423cd1a99c7f",
                                "text": "„Ohne Waffe mit einem dicken Knüttel, dringt er in ihr Lagergesteck, in das dichteste Dornicht, wo hinein unsere schärfsten Hunde nicht schlüpfen und erschlägt sie, die Mutter und die Welpe.“"
                            },
                            {
                                "example_id": "efb9b6aa-46d1-4648-b810-46e51820c32b",
                                "sense_id": "3dab8f06-5313-3fdc-9881-423cd1a99c7f",
                                "text": "„Der rätselhafte Weiher, der raue Fels, die steile Tanne, das struppige Dornicht und der grellgelbe Falter und der zarte, glitzernde Nachsommerfaden in der Luft waren ihm neu und wunderbar.“"
                            },
                            {
                                "example_id": "f85f5dd9-59ee-4e07-8bf2-61ef9c2c4906",
                                "sense_id": "3dab8f06-5313-3fdc-9881-423cd1a99c7f",
                                "text": "„Während sie sich weiter durch das Dornicht schlagen, hören sie plötzlich einen überaus lauten Knall.“"
                            },
                            {
                                "example_id": "71d56f3a-07b1-41ac-9448-7fdb147cf7a0",
                                "sense_id": "3dab8f06-5313-3fdc-9881-423cd1a99c7f",
                                "text": "„Er hatte Humor, er erzählte, wenn man abends nach der Arbeit auf der Hausstufe saß, gern amüsante Geschichten, auch ernste, auch tragische, aus den ›alten Tagen‹ und aus der Welt des heutigen Farmerlebens, er kannte jedes Haus, jede Familie im Umkreis von fünfzig Meilen, auch die Schicksale solcher Häuser, von denen nur noch mit Dornicht überwucherte Kellerhöhlen in der Wildnis bestanden, und solcher Geschlechter, deren Namen nur auf den schlichten Grabsteinen der im Land verstreuten offenen Hausfriedhöfe zu finden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
