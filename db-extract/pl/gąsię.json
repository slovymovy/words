                                        "examples": [
                                            {
                                                "example_id": "f49d3ccb-6021-4f20-a729-2d5f9c602871",
                                                "sense_id": "c983cf70-f381-3462-92a8-d94dfeb280f0",
                                                "text": "Один маленький гусёнок всё отставал, жалобно пища и напрасно стараясь догнать уплывавшую мать…"
                                            },
                                            {
                                                "example_id": "8f0c2110-4f2d-40a2-9c96-d2e10c6b0141",
                                                "sense_id": "c983cf70-f381-3462-92a8-d94dfeb280f0",
                                                "text": "На том берегу, важно качаясь, шла гусыня, за нею желтыми шариками пуха катились гусенята."
                                            }
                                        ]
                                    }
                                ]
