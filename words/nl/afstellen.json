    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4e9c88e-0929-3d56-8fae-5813f5a4939a",
                    "sense_definition": "het nauwkeurig instellen of regelen van een apparaat of instrument voor een optimaal resultaat",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aanpassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben de verwarming op 21 graden <w>afgesteld</w>.",
                            "target_lang_translations": {
                                "en": "We have <w>set</w> the heating to 21 degrees."
                            }
                        },
                        {
                            "text": "Je moet de spiegels van de auto goed <w>afstellen</w> voordat je wegrijdt.",
                            "target_lang_translations": {
                                "en": "You must <w>adjust</w> the car mirrors properly before driving away."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijstellen",
                        "reguleren",
                        "instellen"
                    ],
                    "antonyms": [
                        "ontregelen"
                    ],
                    "common_phrases": [
                        "nauwkeurig afstellen",
                        "de motor afstellen",
                        "optimaal afstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "the precise adjustment or regulation of a device or instrument for optimal results"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adjust",
                                "target_lang_sense_clarification": "to modify or regulate a device"
                            },
                            {
                                "target_lang_word": "set",
                                "target_lang_sense_clarification": "to put a device into a specific state or value"
                            },
                            {
                                "target_lang_word": "tune",
                                "target_lang_sense_clarification": "to adjust for optimal performance or frequency"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d5c7959-52ad-38f3-8bcd-a60afc038f34",
                    "sense_definition": "een geplande activiteit of afspraak niet door laten gaan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "annuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanwege de hevige regen moesten we de voetbalwedstrijd helaas <w>afstellen</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, we had to <w>cancel</w> the football match due to the heavy rain."
                            }
                        },
                        {
                            "text": "Zij besloten het feest op het laatste moment <w>af</w> te <w>stellen</w>.",
                            "target_lang_translations": {
                                "en": "They decided to <w>call off</w> the party at the last minute."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzeggen",
                        "annuleren",
                        "afgelasten"
                    ],
                    "antonyms": [
                        "doorgaan",
                        "bevestigen"
                    ],
                    "common_phrases": [
                        "een afspraak afstellen",
                        "het bezoek afstellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cancel a planned activity or appointment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cancel",
                                "target_lang_sense_clarification": "to decide that a planned event will not take place"
                            },
                            {
                                "target_lang_word": "call off",
                                "target_lang_sense_clarification": "to cancel an event or agreement"
                            },
                            {
                                "target_lang_word": "postpone",
                                "target_lang_sense_clarification": "to delay or put off to a later time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7e26ca3-1654-3970-a4b4-5358833605d6",
                    "sense_definition": "iemand uit zijn functie ontheffen of een groep mensen naar huis sturen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ontslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur besloot na het schandaal de hele afdeling <w>af</w> te <w>stellen</w>.",
                            "target_lang_translations": {
                                "en": "The director decided to <w>dismiss</w> the entire department after the scandal."
                            }
                        },
                        {
                            "text": "Het leger werd na de vredesonderhandelingen direct <w>afgesteld</w>.",
                            "target_lang_translations": {
                                "en": "The army was <w>discharged</w> immediately after the peace negotiations."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontslaan",
                        "afdanken",
                        "ontbinden"
                    ],
                    "antonyms": [
                        "aanstellen",
                        "inhuren"
                    ],
                    "common_phrases": [
