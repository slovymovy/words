                        "examples": [
                            {
                                "example_id": "4eeab684-dc9d-4b37-b26e-212fddac2993",
                                "sense_id": "51e6cc93-cfd5-3f53-9124-47680e7b0ee5",
                                "text": "Uiteraard moest het gezin het tijdelijk stellen met minder weekgeld, maar het was te doen. Vooral na de tips die ik hen meegaf."
                            },
                            {
                                "example_id": "6301536d-35cc-470a-a609-bf1aebdfaebd",
                                "sense_id": "51e6cc93-cfd5-3f53-9124-47680e7b0ee5",
                                "text": "Wanneer er ruimte is, probeer ik altijd te reserveren, maar is die ruimte er niet dan adviseer ik mijn cliënten altijd om van hun weekgeld te gaan reserveren. Al is het maar twee euro die je die week over houdt, probeer het opzij te leggen."
                            }
                        ]
