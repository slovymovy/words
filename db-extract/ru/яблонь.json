                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e146f6f-a10a-479a-a412-2115b2f1eef7",
                        "source_entry_id": "2a7a6277-ad4f-344d-931e-1bdedd4122be",
                        "source_sense_id": "bc7f77dc-28ae-3294-a2d6-70e34dfbc8bc",
                        "source_sense_description": "veraltet, Botanik: Apfelbaum, Apfel (Malus)",
                        "target_lang_word": "Apfelbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfelbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1036f9de-c0de-3f12-b7d4-5630888e5e71",
                                        "entry_id": "08d12eb5-3e08-38ed-866e-ef8abb4bc11c",
                                        "glosses": [
                                            "Obstbaum (Malus), der Äpfel als Früchte trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac49b07-131f-44c0-a629-90f5e10dc045",
                                                "sense_id": "1036f9de-c0de-3f12-b7d4-5630888e5e71",
                                                "text": "In unserem Garten steht ein großer Apfelbaum."
                                            },
                                            {
                                                "example_id": "b3771662-6090-4d96-894d-66d3d7fc4718",
                                                "sense_id": "1036f9de-c0de-3f12-b7d4-5630888e5e71",
                                                "text": "„Die Blätter der Apfelbäume waren so braunrötlich, wie sie im Oktober sind.“"
                                            },
                                            {
                                                "example_id": "f2aab9e9-7849-488c-b7a4-b007698d5c38",
                                                "sense_id": "1036f9de-c0de-3f12-b7d4-5630888e5e71",
                                                "text": "„Hier stehen ein Kirschbaum, Apfel-, Mandel- und Zwetschgenbäume, eine Himalaja-Kiefer, eine Hängebuche und eine weiße Magnolie, auf die Amalia immer sehr stolz war, obwohl der Baum geradezu entgegen ihren Bemühungen überleben musste; Amalia hatte das Gegenteil eines grünen Daumens.“"
                                            },
                                            {
                                                "example_id": "f837ba17-c48a-49bd-b3d6-5cb4f2fdd2d1",
                                                "sense_id": "1036f9de-c0de-3f12-b7d4-5630888e5e71",
                                                "text": "„Die Zweige der Apfelbäume krümmten sich unter der Last der Früchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46e1a249-b756-3dda-9159-405d3606248c",
                                        "entry_id": "08d12eb5-3e08-38ed-866e-ef8abb4bc11c",
                                        "glosses": [
                                            "das Holz von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398d6d6a-8edb-432e-a176-168c32658cbf",
                                                "sense_id": "46e1a249-b756-3dda-9159-405d3606248c",
                                                "text": "„Knorrige Lampen aus einem jahrhundertealten Olivenbaum, Sitzwürfel aus Elsbeere oder Apfelbaum: Tischler Jan Beyer aus Dresden fertigt ausgefallene Möbel aus Holz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36698e64-7aee-48b5-b0ca-483ecd2281b3",
                        "source_entry_id": "2a7a6277-ad4f-344d-931e-1bdedd4122be",
                        "source_sense_id": "bc7f77dc-28ae-3294-a2d6-70e34dfbc8bc",
                        "source_sense_description": "veraltet, Botanik: Apfelbaum, Apfel (Malus)",
                        "target_lang_word": "Apfel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55759783-edf3-3265-9618-f9b6a7037454",
                                        "entry_id": "2f47d7fc-20a0-3762-8ad3-6eda7ddebff9",
                                        "glosses": [
                                            "rundliche Frucht des Apfelbaums mit Schale, Fruchtfleisch und Kerngehäuse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459b0183-f103-460b-a5bc-f8e3b9e70bcb",
                                                "sense_id": "55759783-edf3-3265-9618-f9b6a7037454",
                                                "text": "Der Apfel ist eine Obstart."
                                            },
                                            {
                                                "example_id": "12d2ecb5-0aa3-4dd7-90c4-7a503ec76f4d",
                                                "sense_id": "55759783-edf3-3265-9618-f9b6a7037454",
                                                "text": "„Danach ging es [das Mädchen] weiter und kam zu einem Baum, der hing voll Äpfel und rief ihm zu: ‚Ach, schüttel mich, schüttel mich, wir Äpfel sind alle miteinander reif.‘ “"
                                            },
                                            {
                                                "example_id": "ea9cca42-016f-4d6e-8b32-74afd7b853f9",
                                                "sense_id": "55759783-edf3-3265-9618-f9b6a7037454",
                                                "text": "„Sie erhielten den Befehl, keine unreifen Äpfel aus dem Garten zu essen, weil davon eine ganze Armee krank werden könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f05c4406-6d26-307d-b7f3-93d5a25ab046",
                                        "entry_id": "2f47d7fc-20a0-3762-8ad3-6eda7ddebff9",
                                        "glosses": [
                                            "Apfelbaum"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a18d464-6c57-4b74-9bfe-f68dac61aad4",
                                                "sense_id": "f05c4406-6d26-307d-b7f3-93d5a25ab046",
                                                "text": "Im Garten habe ich mehrere Äpfel stehen."
                                            },
                                            {
                                                "example_id": "b515d7ef-c12b-4b64-a0be-6107b974f87c",
                                                "sense_id": "f05c4406-6d26-307d-b7f3-93d5a25ab046",
                                                "text": "„Sie können Pfirsiche und Nektarinen auf dieselbe Weise wie Äpfel pflanzen.“"
                                            },
                                            {
                                                "example_id": "a86a7c93-6213-42cf-9312-2fbf3eb2cc6c",
                                                "sense_id": "f05c4406-6d26-307d-b7f3-93d5a25ab046",
                                                "text": "„In den bunten Laubwäldern, an denen sie vorüberfuhren, wuchsen wilde Äpfel, Birnen und Kirschen, wie der junge Kutscher erklärte, der in der Nachbarschaft geboren war.“"
                                            },
                                            {
                                                "example_id": "d192e99b-5f16-4097-ab94-e267aeceff4e",
                                                "sense_id": "f05c4406-6d26-307d-b7f3-93d5a25ab046",
                                                "text": "„Besonders gut wachsen Äpfel in eher kühleren Regionen, in denen es auch im Sommer immer wieder regnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6514c06f-00e3-3cd9-b92a-a0743b9a2aa3",
                                        "entry_id": "2f47d7fc-20a0-3762-8ad3-6eda7ddebff9",
                                        "glosses": [
                                            "die weiblichen Brüste"
                                        ],
                                        "tags": [
                                            "plural",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cae1b92-1c4c-4c87-8952-ced90feaddfa",
                                                "sense_id": "6514c06f-00e3-3cd9-b92a-a0743b9a2aa3",
                                                "text": "Als sie dreizehn war, konnte man von Äpfeln sprechen."
                                            },
                                            {
                                                "example_id": "763a4fcd-093b-4789-8e0e-fa4016e09c85",
                                                "sense_id": "6514c06f-00e3-3cd9-b92a-a0743b9a2aa3",
                                                "text": "„Er streichelte die prallen Äpfel, drückte sie und wünschte sich, wenigstens einmal seine Lippen auf die steifen Knospen senken zu können, die sich so unverschämt gut anfühlten.“"
                                            },
                                            {
                                                "example_id": "de5acbb8-50ce-4b0f-a521-20a7d5bc41c7",
                                                "sense_id": "6514c06f-00e3-3cd9-b92a-a0743b9a2aa3",
                                                "text": "„Man beginnt mit der Brustfesselung, die ihre beiden Äpfel fest einschnürt und nur die Hälfte ihrer Rundungen freiließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8758d8ae-e64b-3848-ab9d-49f8b4406478",
                                        "entry_id": "2f47d7fc-20a0-3762-8ad3-6eda7ddebff9",
                                        "glosses": [
                                            "Pferdeapfel"
                                        ],
                                        "tags": [
                                            "rare",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a3155a2-132e-4626-83cd-d35acdf035ed",
                                                "sense_id": "8758d8ae-e64b-3848-ab9d-49f8b4406478",
                                                "text": "Grüne, weiche Pferdeäpfel stammen von Tieren, die sich von frischer, grüner Nahrung ernähren, während gelb-hellbraune Äpfel von Tieren stammen, die mit Stroh, Heu und Hafer gefüttert werden."
                                            },
                                            {
                                                "example_id": "c561b61a-d080-4f0e-a80c-e95140831085",
                                                "sense_id": "8758d8ae-e64b-3848-ab9d-49f8b4406478",
                                                "text": "Meine 7-jährige Stute frisst seit kurzem ihre eigenen Äpfel und die von anderen Pferden, die sie bekommen kann."
                                            },
                                            {
                                                "example_id": "951af157-59ac-47d2-aebc-b9406cb53d1c",
                                                "sense_id": "8758d8ae-e64b-3848-ab9d-49f8b4406478",
                                                "text": "„Sobald das Pferd ein paar Äpfel fallen ließ, sprang eine aparte Deutsche herbei, die an der Empfangstheke auf einem Drehstuhl saß, und schaufelte den Mist in die Wanne.“"
                                            },
                                            {
                                                "example_id": "dbc73947-a5da-4318-9e2f-eb461001930e",
                                                "sense_id": "8758d8ae-e64b-3848-ab9d-49f8b4406478",
                                                "text": "„Damals gab es ja noch viele Pferdefuhrwerke und die Pferde hinterließen Äpfel.“"
                                            },
                                            {
                                                "example_id": "9426055b-ca6e-4172-97fb-0deb565692ef",
                                                "sense_id": "8758d8ae-e64b-3848-ab9d-49f8b4406478",
                                                "text": "„Darauf kam auch der Mist der Pferde, die ihre Äpfel gelegentlich auf der Straße fallen ließen und vor allem der Schafsmist, der die Straße übersäte, wenn der Schäfer seine Herde auf die Wiesen trieb, die das Altersheim umgaben.“"
                                            },
                                            {
                                                "example_id": "6312e79b-a552-4eaf-8578-eb09981b62d7",
                                                "sense_id": "8758d8ae-e64b-3848-ab9d-49f8b4406478",
                                                "text": "„Offenbar kennt er dieses Phänomen, denn mit einer geübten Armbewegung setzt er die Schaufel an und versenkt Lottes Äpfel im Rhein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Apfel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a68c5454-1880-3928-9882-628f5c8d303f",
                                        "entry_id": "30e466e9-5d65-300e-83ed-9c934d695c9a",
                                        "glosses": [
                                            "ein deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b36b6dc-a7f5-4615-a8ea-a098b00aaf10",
                                                "sense_id": "a68c5454-1880-3928-9882-628f5c8d303f",
                                                "text": "Frau Apfel backt das beste Brot der Stadt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
