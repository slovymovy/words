{
    "word_family": [
        "clencher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "312a0991-959e-3e99-b767-66a6fe4a1acc",
                    "sense_definition": "To close a body part, such as a hand or jaw, tightly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "closing_tightly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>clenched</w> his fist in anger when he heard the bad news.",
                            "target_lang_translations": {
                                "cs": "Když uslyšel tu špatnou zprávu, vztekle <w>sevřel</w> pěst."
                            }
                        },
                        {
                            "text": "She <w>clenched</w> her teeth to stop herself from crying out in pain.",
                            "target_lang_translations": {
                                "cs": "<w>Sevřela</w> zuby, aby se neozvala bolestným výkřikem."
                            }
                        }
                    ],
                    "synonyms": [
                        "clutch",
                        "grip"
                    ],
                    "antonyms": [
                        "unclench"
                    ],
                    "common_phrases": [
                        "clench fist",
                        "clench teeth"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pevně uzavřít nebo stáhnout část těla, například ruku nebo čelist."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sevřít",
                                "target_lang_sense_clarification": "pevně zavřít nebo stáhnout část těla, např. pěst či čelist"
                            },
                            {
                                "target_lang_word": "zatnout",
                                "target_lang_sense_clarification": "silně stáhnout svaly nebo čelist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6303a170-d5d6-3b87-9b7b-fd8cc6c2aea8",
                    "sense_definition": "To hold something firmly or tightly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "holding_tightly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened child <w>clenched</w> her mother's hand during the storm.",
                            "target_lang_translations": {
                                "cs": "Vystrašené dítě během bouře pevně <w>svíralo</w> matčinu ruku."
                            }
                        },
                        {
                            "text": "He <w>clenched</w> the rope tightly to avoid falling from the ledge.",
                            "target_lang_translations": {
                                "cs": "Aby nespadl z římsy, pevně <w>svíral</w> lano."
                            }
                        }
                    ],
                    "synonyms": [
                        "clasp",
                        "clutch",
                        "grip"
                    ],
                    "target_lang_definitions": {
                        "cs": "Držet něco pevně nebo silně."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "svírat",
                                "target_lang_sense_clarification": "držet něco pevně v ruce"
                            },
                            {
                                "target_lang_word": "sevřít",
                                "target_lang_sense_clarification": "uchopit velmi pevně"
                            },
                            {
                                "target_lang_word": "stisknout",
                                "target_lang_sense_clarification": "pevně držet, často ze strachu nebo napětí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2118c6d5-a850-3a2e-9873-61549110c384",
                    "sense_definition": "To make a final decision or settle an argument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finalizing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They managed to <w>clench</w> the deal after hours of intense negotiation.",
                            "target_lang_translations": {
                                "cs": "Po hodinách intenzivního vyjednávání se jim podařilo dohodu <w>dotáhnout</w>."
                            }
                        },
                        {
                            "text": "The final evidence helped to <w>clench</w> the argument in his favor.",
                            "target_lang_translations": {
                                "cs": "Poslední důkaz pomohl spor <w>rozhodnout</w> v jeho prospěch."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clench argument",
                        "clench deal"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is now more commonly expressed as clinch."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit konečné rozhodnutí nebo definitivně urovnat spor."
                    },
                    "translations": {
                        "cs": [
