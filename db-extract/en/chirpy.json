                    {
                        "translation_id": "e4aa3881-d0a7-457f-ac5c-3e98125f4fb1",
                        "source_entry_id": "60e13aca-735f-3b9d-8847-fb3606b83bbb",
                        "source_sense_id": "978f0a71-3725-30d8-95ce-3a29a6ec889a",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "quietschvergnügt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quietschvergnügt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                        "entry_id": "fd2f4f63-1468-3c55-a821-d9989fd28b69",
                                        "glosses": [
                                            "sehr vergnügt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "236a5cfc-5a82-451c-b22f-69334af36de9",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Ich ging neulich quietſchvergnügt ſo durch den Schnee hin, da fiel mir ein, um mich ein bißchen im Kopfrechnen zu üben, einmal heraus zu dividieren, wieviel eigentlich deine Rente, Mamchen, in der Sekunde macht.“"
                                            },
                                            {
                                                "example_id": "01a3ecd6-b3e0-486e-8320-33f7d39ba055",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Es geht nicht an, Berlin das ganze Jahr über in allen Tonarten zu ſchmähen – und dann im Sommer quietſchvergnügt das Geld der verfluchten Berliner – aber in hohem Bogen – zu nehmen.“"
                                            },
                                            {
                                                "example_id": "2657ff20-f801-49f2-8c45-cbe98fa77113",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Ich kann auch verſichern, daß er dieſe Schule — um eine ſeinen Jahren ebenfalls entſprechende Sprache zu führen — immer ‚quietſchvergnügten‘ Sinnes betrat, wenn er ſie auch — das iſt Naturgeſetz — nach Stundenſchluß noch quietſchvergnügteren Sinnes verließ.“"
                                            },
                                            {
                                                "example_id": "9716bc65-e5de-4e09-bdb8-5da99b713d36",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Das letzte Bild zeigt eine hübsche Waldidylle und vier quietschvergnügte Waschbären in einem Badetümpel planschen.“"
                                            },
                                            {
                                                "example_id": "34ab05c2-833a-4dc3-bbbb-cf0a8f8d101b",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Der Mann scheint nach Auskunft von Zeitgenossen ein quietschvergnügtes Haus gewesen zu sein – inmitten eines Münchner Bohème-Lebens, das sich als eine Art Dauerkostümfest verstand und reiche, einflußmächtige Kreise zu allseitigem Nutzen vereinte.“"
                                            },
                                            {
                                                "example_id": "f7e81296-f00e-4a00-a47f-ea99e9b1b658",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Im verfremdeten Biedermeier-Habit läßt Kriegenburg die Puppen der postmodernen Spaßgesellschaft tanzen, taumelnd zwischen quietschvergnügter Leere und verzweifelter Brutalität.“"
                                            },
                                            {
                                                "example_id": "d00734a4-f279-47de-86ec-a897d6958e49",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Ach ja, die Musik. Mit quietschvergnügtem Wesen weisen sie Wege aus der Sackgasse der Britpop-Klischees.“"
                                            },
                                            {
                                                "example_id": "c916b56b-bb4b-4433-8cb2-7926e66c13ac",
                                                "sense_id": "c2a02fa4-8faa-338c-a4c8-874caa00ae1e",
                                                "text": "„Der darf sein altes Auto, einen Liebhaber-Oldtimer, wieder auf Vordermann bringen, und prompt unternimmt das Trio samt weiblichem Anhang einen quietschvergnügten Ausflug ins Grüne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
