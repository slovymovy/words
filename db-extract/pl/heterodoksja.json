                                        "glosses": [
                                            "Opposition aux opinions orthodoxes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb1954f-6b8d-44d3-aeb5-0e2aa5cb53b3",
                                                "sense_id": "91778e2f-3046-32ca-97d9-bc68fe4f0787",
                                                "text": "Il est suspect d’hétérodoxie."
                                            },
                                            {
                                                "example_id": "28b6667f-0aff-48cf-98d8-384fda89952f",
                                                "sense_id": "91778e2f-3046-32ca-97d9-bc68fe4f0787",
                                                "text": "On ne saurait nier l’hétérodoxie de cette proposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0bd02d3-3048-378b-b4fc-f8c26c87baf2",
                                        "entry_id": "58629a84-d19a-39c6-993f-f47d2db78c35",
                                        "glosses": [
                                            "Originalité, caractère de ce qui ne se conforme pas aux opinions, aux idées traditionnelles ou communément admises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d71f6aaa-6bf3-43bb-8cd6-87ee61bcb7c6",
                                                "sense_id": "e0bd02d3-3048-378b-b4fc-f8c26c87baf2",
                                                "text": "Parce que je jouis dans cette maison [une clinique] d'une certaine réputation d’hétérodoxie et que, de ce fait, mes jugements apparaissent souvent comme trop optimistes et trop indulgents,…"
                                            }
