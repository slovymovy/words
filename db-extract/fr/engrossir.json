                ],
                "senses": [
                    {
                        "sense_id": "53d5883e-f5a7-3340-b3a1-bbb16d0e3494",
                        "entry_id": "9fd22de3-6f7f-30b7-9244-c319d3c38f73",
                        "glosses": [
                            "Rendre plus gros."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "29c34894-3f88-44de-9ff0-40ade1b91a59",
                                "sense_id": "53d5883e-f5a7-3340-b3a1-bbb16d0e3494",
                                "text": "Qui viendra engrossir nos panses, et nous donner fêtes et joies, (...)"
                            },
                            {
                                "example_id": "2c3d2218-8e90-4a52-b77f-9cd4c9e24044",
                                "sense_id": "53d5883e-f5a7-3340-b3a1-bbb16d0e3494",
                                "text": "Aux coins d'autres quais, des chapelets de pêcheurs semaient fils et bouchons un peu partout dans la Seine pluvieusement engrossie et limoneuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cf303fa-51e5-3c2a-aa08-30fafe66878a",
                        "entry_id": "9fd22de3-6f7f-30b7-9244-c319d3c38f73",
                        "glosses": [
                            "Devenir plus gros."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "340296fa-b963-3679-99ed-f3d944371b94",
                        "entry_id": "9fd22de3-6f7f-30b7-9244-c319d3c38f73",
                        "glosses": [
                            "Engrosser, rendre enceinte."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1ca791e5-9bb3-4e0a-a55a-d5b2dbc6d08a",
                                "sense_id": "340296fa-b963-3679-99ed-f3d944371b94",
                                "text": "Mon homme sort des bois pour venir m'engrossir."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aefd502-3d4e-3733-aefe-640c00f704a9",
                        "entry_id": "9fd22de3-6f7f-30b7-9244-c319d3c38f73",
                        "glosses": [
                            "Se faire devenir plus gros."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "8a3dccac-0b55-4920-a376-5a96bc2c3146",
                                "sense_id": "3aefd502-3d4e-3733-aefe-640c00f704a9",
                                "text": "Pour les autres, critiques, sceptiques ou tout simplement moins euphoriques devant cette thèse qui ne cesse de s’engrossir de ses certitudes énonciatives, il reste les places de l’opposition réactionnaire, celles, au mieux, de l’assemblée rétrograde des « inconvertis »."
                            }
                        ]
                    }
                ],
