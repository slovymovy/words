        "fr-extract.jsonl": [
            {
                "entry_id": "80cd30ab-f644-33c5-b683-f7d788ff472c",
                "word": "vomissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0dc657c-071c-4aac-b893-4d6ac6ce5ef6",
                        "entry_id": "80cd30ab-f644-33c5-b683-f7d788ff472c",
                        "tags": [
                            "plural"
                        ],
                        "form": "vomissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                        "entry_id": "80cd30ab-f644-33c5-b683-f7d788ff472c",
                        "glosses": [
                            "Action de vomir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c89d5634-7e5b-4a6b-b0db-a3ed7d4bd914",
                                "sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                                "text": "Ces comprimés lui feront un pansement gastrique, et s’il n’a pas d’autres vomissements ou diarrhées, tu pourras considérer qu’il est sorti d’affaire."
                            },
                            {
                                "example_id": "0d7b7180-47f5-4f47-8838-09718dbe847d",
                                "sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                                "text": "Deux ou trois jours après, plusieurs autres personnes, des enfants surtout, atteintes de vomissements suspects, durent à leur tour garder la chambre et le lit."
                            },
                            {
                                "example_id": "5b08bc80-a4ac-4cdd-aa62-33bb9490fd9c",
                                "sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                                "text": "La seule fois que j'en aie goûté, j'en ai pris trois jours de migraine, des vomissements de bile verte, un dévoiement sans pareil."
                            },
                            {
                                "example_id": "5c198194-daff-4d1a-bbb9-08ddd9242986",
                                "sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                                "text": "L’observateur rapporte qu'une paysanne ayant vendu des oignons de perce-neige en guise de ciboulette, toutes les personnes qui en mangèrent furent surprises de vomissement, qui n'eurent aucunes suites fâcheuses."
                            },
                            {
                                "example_id": "155f9a74-d538-4fbc-80db-906a100a637c",
                                "sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                                "text": "Lors de l’intoxication aiguë, la présentation classique initiale est la triade : céphalées, nausées, vomissements et sensations vertigineuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb0514a1-f81b-4aca-b81d-623c821c588b",
                        "source_entry_id": "80cd30ab-f644-33c5-b683-f7d788ff472c",
                        "source_sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                        "target_lang_word": "Erbrechen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbrechen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                        "entry_id": "9fae39f9-d446-3b28-8f5b-2ea1bce09106",
                                        "glosses": [
                                            "Entleerung des Magens über den Mund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cc4954-4c6b-43b9-a862-7dc3428657e8",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "Bei Magenbeschwerden kommt es oft auch zum Erbrechen."
                                            },
                                            {
                                                "example_id": "fc00c6ba-1e44-4eb5-94c7-62467e37777e",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "„Die ersten Anzeichen einer Vergiftung [mit Blausäure] sind Schwindelgefühl, Ohrensausen, Kopfschmerzen, Übelkeit und Erbrechen.“"
                                            },
                                            {
                                                "example_id": "f2845e44-8beb-4725-83da-d683ce187474",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "„Mir war zum Erbrechen übel.“"
                                            },
                                            {
                                                "example_id": "1f070e33-1439-4185-a81a-8af68ce26072",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "„Der Pfarrer brachte mich in das Seminar; aber auf halbem Weg ließ er die Gondel bei San Michele halten, weil mich ein solches Erbrechen befiel, daß ich zu ersticken meinte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2bba59b9-0af3-3ee0-8370-d2f679d80ba5",
                                        "entry_id": "9fae39f9-d446-3b28-8f5b-2ea1bce09106",
                                        "glosses": [
                                            "Öffnung eines verschlossenen Gegenstandes mit Gewalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87357c49-6d3b-46ca-be40-dd9009545b8d",
                                                "sense_id": "2bba59b9-0af3-3ee0-8370-d2f679d80ba5",
                                                "text": "„So war beispielsweise nur das Erbrechen des meisterlichen Siegels unter Strafe gestellt, doch wollten einige der Ältesten diesen Tatbestand auch auf das unbefugte Erbrechen des Siegels des Stellvertreters erweitern wegen des Schadens, der daraus entstehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a34f6502-481b-4394-909e-15b30b6d94be",
                        "source_entry_id": "80cd30ab-f644-33c5-b683-f7d788ff472c",
                        "source_sense_id": "4d7c9b9e-ad40-392c-9ce8-59f0236d8ec0",
                        "target_lang_word": "Kotzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kotzen",
