                                                "sense_id": "01e5c0d1-7195-318e-af68-c3aebccc48c9",
                                                "text": "Christen, Juden und Muslime sehen sich als Monotheisten."
                                            },
                                            {
                                                "example_id": "70773988-b496-481e-b037-004c9b7696ad",
                                                "sense_id": "01e5c0d1-7195-318e-af68-c3aebccc48c9",
                                                "text": "„Die Protobulgaren waren Monotheisten, beteten zu Tangra, dem Himmelsgott.“"
                                            }
