                "senses": [
                    {
                        "sense_id": "093ea9eb-ab98-328e-b6eb-4cfad0379684",
                        "entry_id": "1fb8f0a6-5473-3b7e-b6e9-fe1325e20163",
                        "glosses": [
                            "Relié avec."
                        ],
                        "tags": [
                            "Reliure"
                        ],
                        "examples": [
                            {
                                "example_id": "058a87d2-397a-479e-a5ab-d23cd284178a",
                                "sense_id": "093ea9eb-ab98-328e-b6eb-4cfad0379684",
                                "text": "Une reliure en maroquin doublé. — Une reliure doublée de moire."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bb083e8-bd86-33b3-9ac5-b878ef55f0c4",
                        "entry_id": "1fb8f0a6-5473-3b7e-b6e9-fe1325e20163",
                        "glosses": [
                            "Qui est aussi ou en même temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e00d09-d2df-4619-a476-1e0b4368db4a",
                                "sense_id": "5bb083e8-bd86-33b3-9ac5-b878ef55f0c4",
                                "text": "C’est là que ma colère explose : « Ce sont des cague-brailles, des minables, des traîtres doublés d’idiots, c’est une honte pour la France, d’abandonner en rase campagne des gens, ça nous coûtera une fortune ! Il aura ma démission. »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                "word": "doublé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78c993c3-fba0-4685-995b-03bff223d815",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "tags": [
                            "plural"
                        ],
                        "form": "doublés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2758ba87-84b7-3e4c-81f7-344880489083",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Soudure sur un métal commun d’une mince couche d’or, d’argent ou d’un autre métal précieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "291a4257-da72-491b-9b83-676bd0a44a38",
                                "sense_id": "2758ba87-84b7-3e4c-81f7-344880489083",
                                "text": "Au second rendez-vous, Maurice lui offrit une bague en doublé avec un brillant rose."
                            }
                        ]
                    },
                    {
                        "sense_id": "926cd08d-9b5f-3f3b-a494-6764b467c1b9",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Feuille métallique composée de deux métaux rendus adhérant par compression de l’un sur l’autre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eb955667-67eb-3b40-8304-81184d312243",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Verre ou cristal recouvert d'un mince couche de verre coloré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "675458e5-f139-43fa-80d9-01ee92c94e20",
                                "sense_id": "eb955667-67eb-3b40-8304-81184d312243",
                                "text": "Ce verre se travaille en doublé comme le rouge, et comme il est assez dispendieux, on se garde bien de le cueillir à la canne, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "9924ea5a-6040-3cb1-85ec-952c2f5f5d43",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Double tir avec un fusil de chasse à deux coups."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8ae85973-fe0a-3d44-8f3e-9cef070453b9",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Remporter deux compétitions distinctes la même saison."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "172e9b6e-869c-37fe-a1ae-a6530ab0e416",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Remporter le championnat de son pays ainsi que la coupe nationale lors de la même saison."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7de794ae-b058-3eca-b464-24e4b010f18a",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Deux buts marqués durant le même match par le même joueur ou la même joueuse."
                        ],
                        "tags": [
                            "Hockey sur glace"
                        ],
                        "examples": [
                            {
                                "example_id": "af73eec5-54c1-4371-8e7f-8117cdeff72d",
                                "sense_id": "7de794ae-b058-3eca-b464-24e4b010f18a",
                                "text": "Auteur d'un doublé face à l'Australie, qui lui permet d'égaler le record de Thierry Henry et ses 51 buts, Olivier Giroud entre un peu plus dans l'histoire du football français."
                            },
                            {
                                "example_id": "3bc721ef-6863-4d43-a7b5-b22620c3f0c3",
                                "sense_id": "7de794ae-b058-3eca-b464-24e4b010f18a",
                                "text": "Quoi de mieux pour une première en professionnel avec l’En Avant Guingamp qu’un doublé au Roudourou, devant sa famille, pour Jules Gaudin, le gamin d’Yffiniac ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b2cac4c5-be1d-31cb-b631-f617e1c292d0",
                        "entry_id": "4f02dd72-42ad-388d-8d5a-337efe61273c",
                        "glosses": [
                            "Deux actes commis avec le même dessein."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5930b43b-89f8-42b4-bd61-1877bc1aef07",
                                "sense_id": "b2cac4c5-be1d-31cb-b631-f617e1c292d0",
                                "text": "À Ottawa, Justin Trudeau, toujours devancé par les conservateurs dans les sondages, annonce un grand doublé préélectoral."
                            }
                        ]
                    }
                ],
