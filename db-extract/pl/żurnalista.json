                "senses": [
                    {
                        "sense_id": "54300bff-131a-3b55-a251-ba678e631105",
                        "entry_id": "8f14fbcd-428c-3750-b9c7-f1bebf4190ef",
                        "glosses": [
                            "Journalist"
                        ],
                        "tags": [
                            "Medien"
                        ],
