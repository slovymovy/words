{
    "word_family": [
        "supplement",
        "supplementary",
        "supplementation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81332d09-34ae-3460-8ad3-8b0357bbc948",
                    "sense_definition": "Serving to complete or add to something else to improve it or provide more information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor provided <w>supplemental</w> materials to help the students understand the complex topic.",
                            "target_lang_translations": {
                                "ru": "Профессор предоставил <w>дополнительные</w> материалы, чтобы помочь студентам понять сложную тему."
                            }
                        },
                        {
                            "text": "You might need to take <w>supplemental</w> vitamins if your diet is not balanced enough.",
                            "target_lang_translations": {
                                "ru": "Вам может потребоваться принимать <w>дополнительные</w> витамины, если ваш рацион недостаточно сбалансирован."
                            }
                        }
                    ],
                    "synonyms": [
                        "additional",
                        "supplementary",
                        "extra",
                        "added"
                    ],
                    "antonyms": [
                        "basic",
                        "fundamental",
                        "primary"
                    ],
                    "common_phrases": [
                        "supplemental materials",
                        "supplemental income",
                        "supplemental information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для завершения или дополнения чего-либо с целью улучшения или предоставления дополнительной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительный",
                                "target_lang_sense_clarification": "являющийся дополнением к чему-либо"
                            },
                            {
                                "target_lang_word": "вспомогательный",
                                "target_lang_sense_clarification": "помогающий основному"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f7f883e-d257-3f06-bb46-7c9330afe296",
                    "sense_definition": "Operating outside of a regular or fixed schedule, often referring to transportation services.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scheduling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>supplemental</w> airline was hired to transport the team during the busy holiday season.",
                            "target_lang_translations": {
                                "ru": "Для перевозки команды в разгар праздничного сезона была нанята <w>дополнительная</w> авиакомпания."
                            }
                        },
                        {
                            "text": "Due to the sudden increase in demand, the company authorized a <w>supplemental</w> flight.",
                            "target_lang_translations": {
                                "ru": "Из-за внезапного роста спроса компания разрешила <w>дополнительный</w> рейс."
                            }
                        }
                    ],
                    "synonyms": [
                        "unscheduled",
                        "extra"
                    ],
                    "antonyms": [
                        "scheduled",
                        "regular"
                    ],
                    "common_phrases": [
                        "supplemental airline",
                        "supplemental carrier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работающий вне регулярного или фиксированного графика, часто применительно к транспортным услугам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительный",
                                "target_lang_sense_clarification": "внеплановый, сверх обычного расписания"
                            },
                            {
                                "target_lang_word": "чартерный",
                                "target_lang_sense_clarification": "выполняемый по специальному заказу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90389f88-c703-312e-a534-847a76c2d837",
                    "sense_definition": "Functioning as an appendix or an added part at the end of a document.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please refer to the <w>supplemental</w> pages at the back of the manual for technical specifications.",
                            "target_lang_translations": {
                                "ru": "Технические характеристики смотрите на <w>дополнительных</w> страницах в конце руководства."
                            }
                        },
                        {
                            "text": "The author included <w>supplemental</w> notes to clarify the historical context of the novel.",
                            "target_lang_translations": {
                                "ru": "Автор включил <w>дополнительные</w> примечания, чтобы прояснить исторический контекст романа."
                            }
