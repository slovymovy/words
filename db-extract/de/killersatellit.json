                "senses": [
                    {
                        "sense_id": "425b42c8-5631-3539-9507-1f51830f2b03",
                        "entry_id": "93794556-c809-3cc9-a334-c0b37bc793bb",
                        "glosses": [
                            "Satellit, der in der Lage ist andere Objekte im erdnahen Weltraum zu zerstören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c0a18a-80f2-47d1-8b10-fa52813fe155",
                                "sense_id": "425b42c8-5631-3539-9507-1f51830f2b03",
                                "text": "„An Bord bedienen Militärkosmonauten riesige Beobachtungskameras, zur Abwehr von Killersatelliten gibt es eine \"Nudelman-Kanone\"!“"
                            },
                            {
                                "example_id": "67ea18a5-bc91-49fa-8110-48490161432f",
                                "sense_id": "425b42c8-5631-3539-9507-1f51830f2b03",
                                "text": "„Unklar ist, welche Schrottmengen von Killersatelliten stammen, die während des Kalten Krieges (und vielleicht auch noch heute) gegnerische Spionagesatelliten „neutralisierten“, sie also einfach rammten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
