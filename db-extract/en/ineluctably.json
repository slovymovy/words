                        "glosses": [
                            "In an ineluctable manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2187eeec-6ee4-4723-9ab4-8462efb91627",
                                "sense_id": "8bf21b2d-b1d2-35bc-aba6-6f587b965659",
                                "text": "Ineluctably I was led to believe that the first whisperers of these accursed tales must have had discourse with Akeley’s Outer Ones, and perhaps have visited outer cosmic realms as Akeley now proposed visiting them."
                            },
                            {
                                "example_id": "74fa3c53-845b-441d-91ea-b164324b5298",
                                "sense_id": "8bf21b2d-b1d2-35bc-aba6-6f587b965659",
                                "text": "So insistent is the presence of money in Newport that the mind springs ineluctably to the raw beginnings of it."
                            }
                        ]
                    }
                ],
