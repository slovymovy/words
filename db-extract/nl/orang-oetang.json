                "senses": [
                    {
                        "sense_id": "ccfe5203-3815-3baf-a230-0511d2ba31ad",
                        "entry_id": "f209fe87-4536-3c91-87d1-4e92df6fda4e",
                        "glosses": [
                            "Ponginae een onderfamilie van de familie mensachtigen (Hominidae) die het levende geslacht orang-oetans bevat, en daarnaast de uitgestorven geslachten Ankarapithecus, Gigantopithecus, Khoratpithecus, Lufengpithecus en Sivapithecus. De dieren komen voor in de bossen van Borneo en Sumatra"
                        ],
                        "tags": [
                            "primaten"
                        ],
                        "examples": [
                            {
                                "example_id": "3e4bec09-59b9-41c7-a26b-13b28bffde1a",
                                "sense_id": "ccfe5203-3815-3baf-a230-0511d2ba31ad",
                                "text": "Chantek, de wereldberoemde orang-oetang die door de Amerikaanse antropologe Lyn Miles werd opgevoed en van haar gebarentaal leerde, is overleden. De slimste aap ter wereld werd 39, ging naar de universiteit, had een zwak voor fastfood en hield van knutselen en schilderen."
                            },
                            {
                                "example_id": "2cec979a-8266-4041-9028-a9de8623b5d1",
                                "sense_id": "ccfe5203-3815-3baf-a230-0511d2ba31ad",
                                "text": "Fotograaf Tim Laman bedwong een 30 meter hoge boom op het Indonesische Borneo om zijn GoPro-camera's te kunnen installeren. Dat leverde deze spectaculaire plaat op van een jonge orang-oetang boven het bladerdak. Het is de natuurfoto van het jaar."
                            }
                        ]
                    }
