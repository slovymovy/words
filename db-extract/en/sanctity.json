                    },
                    {
                        "sense_id": "667e69bd-fdf3-3d69-863c-02319b7241f1",
                        "entry_id": "0f2769bc-bf91-3b12-b142-916f23546361",
                        "glosses": [
                            "Something considered sacred."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "670a74d2-8b80-424a-abc0-c37f125563c3",
                                "sense_id": "667e69bd-fdf3-3d69-863c-02319b7241f1",
                                "text": "Or would they have it believed, that there is in their ſelves ſome ſuperior ſanctity, ſome peculiar privilege, by which theſe things are lawful to them, which are unlawful to all the world beſides?"
                            },
                            {
                                "example_id": "8228e453-7fef-415c-9db0-043a0080f7a5",
                                "sense_id": "667e69bd-fdf3-3d69-863c-02319b7241f1",
                                "text": "[…] allowed the Israeli occupation over 75 years to commit the worst crimes ever against the Palestinian people, land and sanctities."
                            }
                        ]
                    }
                ],
