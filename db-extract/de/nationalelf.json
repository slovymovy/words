                "senses": [
                    {
                        "sense_id": "0179b53b-a03d-3e06-8efe-ca1ec8eadfe9",
                        "entry_id": "517fd480-a06b-3b59-a739-4a4ced424b86",
                        "glosses": [
                            "Mannschaft, die in internationalen Wettbewerben gegen die Auswahlmannschaften anderer Nationen antritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb11ec0-e74e-403d-ac15-7f8f021eff9a",
                                "sense_id": "0179b53b-a03d-3e06-8efe-ca1ec8eadfe9",
                                "text": "„Eine bundesdeutsche Fußball-Nationalmannschaft aus Amateurspielern besiegt in London die englische Nationalelf mit 3:2.“"
                            },
                            {
                                "example_id": "a16b188c-ac58-40ef-877a-47ad853338ab",
                                "sense_id": "0179b53b-a03d-3e06-8efe-ca1ec8eadfe9",
                                "text": "„Der Deutsche Fußballbund (DFB) sperrt Spieler des FC Schalke 04 wegen Bestechungsverdachts von der Nationalelf aus.“"
                            },
                            {
                                "example_id": "ffd640a1-5a7d-4ffc-b2fb-c532ef7f742f",
                                "sense_id": "0179b53b-a03d-3e06-8efe-ca1ec8eadfe9",
                                "text": "„Die Fußballer Paul Breitner und Günther Netzer erklären, dass sie nicht mehr in der Nationalelf spielen wollen.“"
                            },
                            {
                                "example_id": "dbb9109c-77dc-4110-8650-875a4d6ed627",
                                "sense_id": "0179b53b-a03d-3e06-8efe-ca1ec8eadfe9",
                                "text": "„Mit dem Gewinn der Fußball-Europameisterschaft feiert die griechische Nationalelf ihren bislang größten Erfolg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
