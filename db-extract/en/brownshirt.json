                                    {
                                        "sense_id": "860aebad-0501-39e0-b90e-f939610d1dca",
                                        "entry_id": "16e79656-6753-3adf-afe2-f4e7e2904a72",
                                        "glosses": [
                                            "nationaal-socialist of fascist"
                                        ],
