                ],
                "senses": [
                    {
                        "sense_id": "0fb58391-e780-338a-85b3-7b0fb69b4fe4",
                        "entry_id": "76ca9089-3db0-3798-adb9-9468070a987b",
                        "glosses": [
                            "wertvolles gesegnetes Öl für Salbungen, das unter anderem bei der Firmung, Taufe und der Priesterweihe benutzt wird"
                        ],
                        "tags": [
                            "Katholische Kirche",
                            "Orthodoxe Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "a95e82f1-ee8b-4d24-b0f8-ecd455b8bada",
                                "sense_id": "0fb58391-e780-338a-85b3-7b0fb69b4fe4",
                                "text": "„Denn alle, die durch die Salbung mit dem heiligen Chrisamöl benetzt sind, sind Priester geworden, so wie auch Petrus zur ganzen Kirche sagt: […].“"
                            },
                            {
                                "example_id": "0cd78215-4934-43c1-9751-db090714cb69",
                                "sense_id": "0fb58391-e780-338a-85b3-7b0fb69b4fe4",
                                "text": "„Nach einem kurzen Gebet, in dem er den Heiligen Geist zur Hilfe rief, sagte er: ›So wie einst Sadok König David salbte und Nathan König Salomon, salbe ich Dich mit dem heiligen Chrisamöl.“"
                            },
                            {
                                "example_id": "27b46812-1b9c-40ce-8b6d-4e97692acf9a",
                                "sense_id": "0fb58391-e780-338a-85b3-7b0fb69b4fe4",
                                "text": "„Sofort nach der Salbung mit Chrisamöl spürte ich eine Leichtigkeit im Denken und Handeln; mein Kopf wurde frei von allen unnützen und unsinnigen Gedanken.“"
                            },
                            {
                                "example_id": "2a7fcc4a-4cc3-4663-a9f8-14d5936e4169",
                                "sense_id": "0fb58391-e780-338a-85b3-7b0fb69b4fe4",
                                "text": "„Neben Evangeliar und Kreuz wurden in der Eingangsprozession auch die Osterkerze und das Chrisamöl mitgetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
