                "senses": [
                    {
                        "sense_id": "c1564fba-0082-3720-8018-2a82ef3c9e9a",
                        "entry_id": "3419d72c-9cbd-3cd7-8f2a-d726af527e68",
                        "glosses": [
                            "luxuriöses Auto"
