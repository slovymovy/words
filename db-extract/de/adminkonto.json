                "senses": [
                    {
                        "sense_id": "705b71a4-b312-399f-b371-12191d36565c",
                        "entry_id": "46aa6a15-b603-3380-8b3b-8ae4d0891a1e",
                        "glosses": [
                            "Benutzerkonto mit erweiterten Rechten, das es dem Administrator eines Systems ermöglicht, dieses zu verwalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a506ee7-ba21-478d-8b5e-4a1617a75cf6",
                                "sense_id": "705b71a4-b312-399f-b371-12191d36565c",
                                "text": "„Es ist an dieser Stelle zudem wichtig, dass jeder Administrator sein eigenes Adminkonto erhält und kein gemeinsames Konto zum Einsatz kommt.“"
                            },
                            {
                                "example_id": "05176709-37da-44bf-b0dd-329931371449",
                                "sense_id": "705b71a4-b312-399f-b371-12191d36565c",
                                "text": "„Öffnen Sie nun die Seite von openHAB und geben Sie, falls gefordert, das vorher vergebene Adminkonto samt Passwort an.“"
                            },
                            {
                                "example_id": "8bae6850-0dc5-4bf6-949c-04e56391a9b6",
                                "sense_id": "705b71a4-b312-399f-b371-12191d36565c",
                                "text": "„Nach der Authentifizierung mit einem Adminkonto lässt sich die Passthrough-Authentifizierung aktivieren, wichtig ist auch, dass die Option zur Aktivierung von SSO generell aktiviert ist.“"
                            },
                            {
                                "example_id": "d1df344d-597c-4d68-9d7c-a9bc8b9b92ea",
                                "sense_id": "705b71a4-b312-399f-b371-12191d36565c",
                                "text": "„Während der Installation muss ein Adminkonto eingerichtet werden“"
                            },
                            {
                                "example_id": "51447d2a-5c1b-437a-81b2-12c1e74b96bd",
                                "sense_id": "705b71a4-b312-399f-b371-12191d36565c",
                                "text": "„Das geheime Adminkonto existiert ebenfalls noch, dass habe ich aber noch nie gebraucht und aufgerufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
