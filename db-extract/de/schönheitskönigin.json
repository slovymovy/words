                "senses": [
                    {
                        "sense_id": "e9a45239-3af4-36be-aef0-285b022c5aa6",
                        "entry_id": "9eb4f62e-7675-37e1-ae12-f6dfbfd9fc8c",
                        "glosses": [
                            "Gewinnerin eines Schönheitswettbewerbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69094391-04b8-4e26-9f0d-d6d328b9f7e3",
                                "sense_id": "e9a45239-3af4-36be-aef0-285b022c5aa6",
                                "text": "„In der Vergangenheit mussten Schönheitsköniginnen immer wieder auf ihren Titel verzichten, weil mehr oder weniger freizügige Bilder von ihnen aufgetaucht waren.“"
                            },
                            {
                                "example_id": "12fec6e6-d4e0-4ea5-8931-022afd53cfc4",
                                "sense_id": "e9a45239-3af4-36be-aef0-285b022c5aa6",
                                "text": "„Dean spürt, wie er anfängt zu taumeln, sich aufzulösen, und ich bin wie ein Saxophonspieler in einer Marschkapelle, der in die Schönheitskönigin verliebt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
