        "vitalize",
        "vitalism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59d36008-0159-3849-b82e-d17f85ab6b59",
                    "sense_definition": "Energy or vigour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete is full of <w>vitality</w>.",
                            "target_lang_translations": {
                                "nl": "De jonge atleet zit vol <w>levenskracht</w>."
                            }
                        },
                        {
                            "text": "The city's cultural <w>vitality</w> impressed the visitors.",
                            "target_lang_translations": {
                                "nl": "De culturele <w>levendigheid</w> van de stad maakte indruk op de bezoekers."
                            }
                        }
                    ],
                    "synonyms": [
                        "energy",
                        "vigour",
                        "liveliness"
                    ],
                    "antonyms": [
                        "lethargy",
                        "apathy"
                    ],
                    "common_phrases": [
                        "full of vitality",
                        "youthful vitality"
                    ],
                    "target_lang_definitions": {
                        "nl": "De energie of kracht die iemand of iets uitstraalt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "levenskracht",
                                "target_lang_sense_clarification": "De algemene energie en vitaliteit van een persoon."
                            },
                            {
                                "target_lang_word": "vitaliteit",
                                "target_lang_sense_clarification": "De algemene staat van energie en levendigheid."
                            },
                            {
                                "target_lang_word": "levendigheid",
                                "target_lang_sense_clarification": "De mate waarin iemand of iets bruist van energie."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ba2e727-06db-3ed7-af7c-aafc22f34f00",
                    "sense_definition": "The capacity to live and develop.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant showed a surprising <w>vitality</w> despite the harsh winter conditions.",
                            "target_lang_translations": {
                                "nl": "De plant toonde een verrassende <w>levenskracht</w> ondanks de barre winterse omstandigheden."
                            }
                        },
                        {
                            "text": "Scientists are studying the <w>vitality</w> of the ecosystem in the protected forest.",
                            "target_lang_translations": {
                                "nl": "Wetenschappers bestuderen de <w>levensvatbaarheid</w> van het ecosysteem in het beschermde bos."
                            }
                        }
                    ],
                    "synonyms": [
                        "life",
                        "vivacity"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het vermogen om te leven, te groeien en zich te ontwikkelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "levensvatbaarheid",
                                "target_lang_sense_clarification": "Het vermogen om te overleven en te gedijen."
                            },
                            {
                                "target_lang_word": "levenskracht",
                                "target_lang_sense_clarification": "De innerlijke kracht die groei mogelijk maakt."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45904ff7-3bae-31a2-ab79-05e543b816b0",
                    "sense_definition": "The state of being alive or animate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>vitality</w> of the organism was confirmed by its movement.",
                            "target_lang_translations": {
                                "nl": "De <w>levendigheid</w> van het organisme werd bevestigd door zijn beweging."
                            }
                        },
                        {
                            "text": "He pondered the mysterious <w>vitality</w> that separates the living from the dead.",
                            "target_lang_translations": {
                                "nl": "Hij peinsde over de mysterieuze <w>levenskracht</w> die de levenden van de doden scheidt."
                            }
                        }
                    ],
                    "synonyms": [
                        "animateness",
                        "life"
                    ],
                    "antonyms": [
                        "inanimateness"
                    ],
                    "target_lang_definitions": {
                        "nl": "De toestand van het levend of bezield zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "levendigheid",
                                "target_lang_sense_clarification": "De staat van het bezield zijn."
                            },
                            {
                                "target_lang_word": "leven",
                                "target_lang_sense_clarification": "Het biologische feit van in leven zijn."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}