                    }
                ],
                "senses": [
                    {
                        "sense_id": "039d2268-8876-3124-a261-d720964fb178",
                        "entry_id": "e4438109-93f9-3e21-87d9-c2fd60044921",
                        "glosses": [
                            "Alternative form of flat-footed.",
                            "Of an animal: having feet which are naturally flat; (specifically) of a horse: having hoofs with soles close to the ground."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acd60c98-6ceb-4b2b-9f8a-d3c18967fb2b",
                                "sense_id": "039d2268-8876-3124-a261-d720964fb178",
                                "text": "He claimed that Jews walk flatfooted like a camel—including me."
                            }
                        ]
                    },
                    {
                        "sense_id": "033f9eb0-2e2f-37a3-99a1-eaf46f898002",
                        "entry_id": "e4438109-93f9-3e21-87d9-c2fd60044921",
                        "glosses": [
                            "Alternative form of flat-footed.",
                            "Of a person: having the physical condition of flat feet (“a condition where the soles of the feet are in full contact with the ground, either because the arches have collapsed or because they never developed”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a95637e-35fe-4efd-adf8-d988ee6e4c94",
                                "sense_id": "033f9eb0-2e2f-37a3-99a1-eaf46f898002",
                                "text": "Most small children are flatfooted."
                            },
                            {
                                "example_id": "0b5fc0d2-369b-42fa-afc9-dc46e7a229ad",
                                "sense_id": "033f9eb0-2e2f-37a3-99a1-eaf46f898002",
                                "text": "The figure came up and squatted flatfooted on his haunches next to Patsy. In the dim glow of starlight and streetlight he saw a wrinkled face and a silvery goatee."
                            },
                            {
                                "example_id": "122ef248-740f-46fd-8cfc-7c1ea314cd15",
                                "sense_id": "033f9eb0-2e2f-37a3-99a1-eaf46f898002",
                                "text": "Hit take-off board flatfooted in a hard stamp; take-off feet under body with slight dip at knee."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e444f45-505e-365e-ac67-7af6fadfccd0",
                        "entry_id": "e4438109-93f9-3e21-87d9-c2fd60044921",
                        "glosses": [
                            "Alternative form of flat-footed.",
                            "Blunt and unsubtle; lacking finesse; clumsy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15090160-157d-4db1-84ba-072d124af138",
                                "sense_id": "1e444f45-505e-365e-ac67-7af6fadfccd0",
                                "text": "This flatfooted sketch of how experience provides us with reasons has two nodes."
                            },
                            {
                                "example_id": "38df5114-4a19-4c0e-9f70-fb6ce5159cd3",
                                "sense_id": "1e444f45-505e-365e-ac67-7af6fadfccd0",
                                "text": "I have many top ranked sectional and national level kids come to my program and I cannot even believe how flatfooted they are—not because they lack the talent—simply because no coach ever demanded the extra footwork effort from them."
                            },
                            {
                                "example_id": "bf6a9d80-49d7-427b-815b-63e0c1dc07ac",
                                "sense_id": "1e444f45-505e-365e-ac67-7af6fadfccd0",
                                "text": "It's contrived and flatfooted, and neither Loy nor Powell enjoyed making it, despite its bang-up finale: a free-for-all wedding featuring two brides (Margit and Irene), two grooms, a confused preacher, quite a few drunks from the bar next door, and a maximum of conmmotion—all crammed into Charlie's tiny trailer in a Capra-esque crowd scene."
                            }
                        ]
                    },
                    {
                        "sense_id": "23f87f64-66cc-37e2-bde8-547fd8c4fc4b",
                        "entry_id": "e4438109-93f9-3e21-87d9-c2fd60044921",
                        "glosses": [
                            "Alternative form of flat-footed.",
                            "Unprepared, unready."
                        ],
                        "tags": [
                            "US",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3a0164a9-df93-4994-ad0e-a8960b91c102",
                                "sense_id": "23f87f64-66cc-37e2-bde8-547fd8c4fc4b",
                                "text": "To those who are younger, perhaps still building a career, I say to you, plan for it! No one should be caught flatfooted by the lengthening of middle age"
                            },
                            {
                                "example_id": "8e7526b2-3cab-48fd-b618-b7f83bc74933",
                                "sense_id": "23f87f64-66cc-37e2-bde8-547fd8c4fc4b",
                                "text": "Caught mentally flatfooted, Anne couldn't think of a response. She was guilty as charged. She didn't deserve to defend herself."
                            },
                            {
                                "example_id": "730b06c8-8ca3-4f3e-92b5-cadff521e0be",
                                "sense_id": "23f87f64-66cc-37e2-bde8-547fd8c4fc4b",
                                "text": "In contrast, as the crisis unfolded, India stood flatfooted, only reacting after the damage was done."
                            }
                        ]
                    },
                    {
                        "sense_id": "d863eed6-0938-358c-9393-c9eaa81cf858",
                        "entry_id": "e4438109-93f9-3e21-87d9-c2fd60044921",
                        "glosses": [
                            "Alternative form of flat-footed.",
                            "Direct, downright, straightforward; also, holding firmly to and maintaining a decision; standing one's ground."
                        ],
                        "tags": [
                            "dated",
                            "figuratively",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3f1733ca-a4ae-4c8f-ad12-b06225830785",
                                "sense_id": "d863eed6-0938-358c-9393-c9eaa81cf858",
                                "text": "Proficient drinkers could spill out an ounce, or an ounce and a half, or two, from the neck of a Solo Soda bottle in the dark, measured to the very dram, refill it with corn whisky, turn it upside down with the thumb placed carefully over the bottle's lip—for a good mix, and luck—and drink it down, flatfooted."
                            }
                        ]
                    }
