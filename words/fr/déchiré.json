                {
                    "sense_id": "b70bbfae-6195-3999-91cc-1bf6d9ba0388",
                    "sense_definition": "Qui éprouve une violente souffrance morale causée par un conflit intérieur ou une séparation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a quitté son pays natal le cœur <w>déchiré</w> par le chagrin.",
                            "target_lang_translations": {
                                "en": "He left his native country with his heart <w>torn</w> by grief.",
                                "ru": "Он покинул родину с <w>разбитым</w> от горя сердцем.",
                                "de": "Er verließ seine Heimat mit vor Kummer <w>gebrochenem</w> Herzen.",
                                "es": "Abandonó su país natal con el corazón <w>desgarrado</w> por la pena.",
                                "zh": "他心里<w>痛苦</w>不堪，离开了自己的故乡。"
                            }
                        },
                        {
                            "text": "Le juge se sentait <w>déchiré</w> entre son devoir et sa compassion.",
                            "target_lang_translations": {
                                "en": "The judge felt <w>torn</w> between his duty and his compassion.",
                                "ru": "Судья <w>разрывался</w> между долгом и состраданием.",
                                "de": "Der Richter fühlte sich zwischen seiner Pflicht und seinem Mitgefühl <w>zerrissen</w>.",
                                "es": "El juez se sentía <w>dividido</w> entre su deber y su compasión.",
                                "zh": "法官夹在职责与同情之间，内心十分<w>纠结</w>。"
                            }
                        }
                    ],
                    "synonyms": [
