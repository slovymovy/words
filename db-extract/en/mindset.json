                    },
                    {
                        "translation_id": "ffe637f9-427f-467f-9106-007802715daf",
                        "source_entry_id": "5633164d-194f-3e94-9af3-f5da35deeab5",
                        "source_sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
                        "source_sense_description": "a way of thinking — see also mentality",
                        "target_lang_word": "mentalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mentalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f166c452-c22a-33f2-9143-70333e25d84f",
                                        "entry_id": "1c15a946-9688-331c-bea9-bf8a44271241",
                                        "glosses": [
                                            "État d’esprit ; habitudes de pensée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee855b07-09be-4953-b686-fa71c1b4ff55",
                                                "sense_id": "f166c452-c22a-33f2-9143-70333e25d84f",
                                                "text": "Il narra, en une esquisse sommaire et avec les omissions et les inexactitudes naturelles à son genre de mentalité, la série de ses aventures."
                                            },
                                            {
                                                "example_id": "1f9733cb-bcb1-4ec9-bd39-7051df6b655d",
                                                "sense_id": "f166c452-c22a-33f2-9143-70333e25d84f",
                                                "text": "La Scolastique […] a accrédité une mentalité qui n’a pas prise sur le réel, qui tient pour légitimes certaines illusions structurales de notre esprit : notre tendance à réaliser nos concepts et à réifier toutes choses."
                                            },
                                            {
                                                "example_id": "e68be5f3-ce60-4332-8dd1-3727dabf7de0",
                                                "sense_id": "f166c452-c22a-33f2-9143-70333e25d84f",
                                                "text": "Il ne faut pas être finaliste. Il n’est vraiment guère scientifique de se demander à quoi sert telle ou telle chose, et c’est la preuve d’une mentalité peu avancée de se demander, comme Voltaire, « à quoi sert la précession des équinoxes. »"
                                            },
                                            {
                                                "example_id": "6fe6b66c-43e5-4bb0-b38a-a4b7b69fae17",
                                                "sense_id": "f166c452-c22a-33f2-9143-70333e25d84f",
                                                "text": "Les années quatre-vingt ont consacré l’enfant-roi mais aussi travaillé en profondeur les mentalités vers toujours plus d’individualisme, cet état ambivalent de l’autonomie et de l’hypersolitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87788d35-b702-411d-998a-fef42367fc8c",
                        "source_entry_id": "5633164d-194f-3e94-9af3-f5da35deeab5",
                        "source_sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
                        "source_sense_description": "a way of thinking — see also mentality",
                        "target_lang_word": "Denkweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denkweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                        "entry_id": "b237a1aa-76a9-3038-ab7b-7db6a22f45d4",
                                        "glosses": [
                                            "Art und Weise zu denken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fecbcb32-c42f-42c8-95e8-6d68dcce3c7e",
                                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                                "text": "Die Denkweise verändert sich beim Menschen, wenn er Stress ausgesetzt ist."
                                            },
                                            {
                                                "example_id": "14883cae-b8a4-4aad-b9a7-d4a80ef51de7",
                                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                                "text": "Mit dieser eingeschränkten Denkweise kommt das Projekt nicht vorwärts."
                                            },
                                            {
                                                "example_id": "9931cba1-4c69-4c33-8565-75b007b9049f",
                                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                                "text": "„Wir können sagen, daß die Naturphilosophen die ersten Schritte in Richtung einer wissenschaftlichen Denkweise machten.“"
                                            },
                                            {
                                                "example_id": "d47610b6-07d8-4d0a-948b-95c3fd8850c4",
                                                "sense_id": "a8a1e405-1ff9-3dd6-81f2-f54fc997b2ce",
                                                "text": "„Doktor Vielguts Denkweise ist in der Forschung weit verbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                        "entry_id": "b237a1aa-76a9-3038-ab7b-7db6a22f45d4",
                                        "glosses": [
                                            "geistige und sittliche Grundhaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89984a33-ea85-4247-ba62-d020a5079349",
                                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                                "text": "„Die Medizin war in jenen Jahren eng mit der Philosophie verbunden, begünstigt von der aufklärerischen, empiristischen Denkweise.“"
                                            },
                                            {
                                                "example_id": "ac8bcda4-0ea7-4d31-8ee6-d1c363409fd8",
                                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                                "text": "„Das setzt eine Denkweise voraus, die nicht nur dem eigenen Interesse folgt, sondern für das Ganze Verantwortung übernehmen kann.“"
                                            },
                                            {
                                                "example_id": "38788282-a578-4d66-95c4-4f09be86f6f6",
                                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                                "text": "„Er kochte vor Wut angesichts dieses Senators, der die stumpfsinnige Korrektheit und Beschränktheit seiner Denkweise ganz einfach auf diese ganz neu aufgetauchten Aufgaben des Adels übertragen wollte.“"
                                            },
                                            {
                                                "example_id": "f5d7a4fe-1385-4295-bb32-8ae478d1bcd1",
                                                "sense_id": "8137955f-0883-3675-97ab-574e4cd9e104",
                                                "text": "„Diese Ignoranten in Rom sind ihrer Denkweise nach völlig antiquiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
