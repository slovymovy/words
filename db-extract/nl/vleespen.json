                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd32c6b6-4cdf-4401-a3ab-651444fe674e",
                                "sense_id": "b7b3d485-535d-3585-a18c-6c700075f3ba",
                                "text": ",,Dit verzin je niet, zegt Koji Ebersole. ,,Het was echt een kans van één op een miljoen om door het gezicht heen te gaan en op weg naar achteren niets te raken. Omdat de wond nagenoeg niet bloedt, wordt besloten de vleespen pas zondagochtend te verwijderen. Gezien het feit dat het ding niet rond is, maar vierkant, een bijzonder lastig klusje."
                            },
                            {
                                "example_id": "30f0139f-b40d-482d-b99b-8b49c018165d",
                                "sense_id": "b7b3d485-535d-3585-a18c-6c700075f3ba",
                                "text": "Gebruik voor het dompelen van de pretzel twists een lange metalen vleespen, dat werkt makkelijker dan een vork."
                            },
                            {
                                "example_id": "b44cee28-263e-44ca-982c-799dfdfc62ed",
                                "sense_id": "b7b3d485-535d-3585-a18c-6c700075f3ba",
                                "text": "Een metalen vleespen, die in de cake wordt gestoken, moet er weer schoon uitkomen."
                            }
                        ]
                    }
