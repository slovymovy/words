                ],
                "senses": [
                    {
                        "sense_id": "bca7efec-1ee9-36b2-bf9e-a3d5ec61e4d9",
                        "entry_id": "7d57815d-a95c-3367-81b7-72a9a9c87f71",
                        "glosses": [
                            "женск. к наследник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b8dd493-d211-4ac4-995e-1243c6aeb7fd",
                                "sense_id": "bca7efec-1ee9-36b2-bf9e-a3d5ec61e4d9",
                                "text": "... при случае смерти моей прежде супруги, да будет она во всём недвижимом и движимом моём имении единственная наследница, и да отдастся всё без изъятия оставшее после меня имение в её владение, но недвижимое по её только смерть."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ebbc74a-d627-4dab-9472-9ae4c3bb71fb",
                        "source_entry_id": "7d57815d-a95c-3367-81b7-72a9a9c87f71",
                        "source_sense_id": "bca7efec-1ee9-36b2-bf9e-a3d5ec61e4d9",
                        "target_lang_word": "Erbin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                        "entry_id": "4681d6fd-8012-387b-9c82-32f49228c657",
                                        "glosses": [
                                            "weibliche Person, der die Güter von Verstorbenen zufallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7471c9c8-2976-4a2d-876b-69dc657a1764",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Als reiche Erbin kann sie ein Leben in Saus und Braus führen."
                                            },
                                            {
                                                "example_id": "f7eecdb6-a307-4675-b061-80b7e8cf4a83",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Die junge Erbin hat jetzt ein sorgenfreies Leben."
                                            },
                                            {
                                                "example_id": "420c0b49-91a7-44f1-984c-5dc4b0968722",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Das Landgericht Köln zweifelt an der Darstellung von Quelle-Erbin Madeleine Schickedanz , dass die Bank Sal. Oppenheim sie zu einer riskanten Anlage ihres Vermögens gedrängt habe."
                                            },
                                            {
                                                "example_id": "3f4a0261-ad24-4d35-b1c8-6fc5709d6683",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Ise Bosch, Stifterin und Erbin der Bosch-Familie, beklagt in ihrem Beitrag die „Reichen-Hetze“. Als kritische Erbin freue sie sich, dass endlich über Ressourcenverteilung geredet werde."
                                            },
                                            {
                                                "example_id": "ce6f80b5-f07c-42ee-95eb-17dc07d1c12f",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "Zusammen mit ihrem Bruder Dietrich wäre [Uta] Werner [, die 86-jährige Cousine des verstorbenen Cornelius Gurlitt,] als nächste lebende Verwandte ohne Testament die gesetzliche Erbin gewesen."
                                            },
                                            {
                                                "example_id": "130ad358-23fe-47f6-ad81-5760d1bc1c97",
                                                "sense_id": "52b964b0-a504-31d0-b797-65f0fe105455",
                                                "text": "„Diese Partie war Julie Karagina, die Tochter angesehener und ordentlicher Eltern, mit der Familie Rostow von Kindesbeinen an bekannt und jetzt, nachdem der letzte ihrer Brüder gefallen war, eine sehr reiche Erbin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
