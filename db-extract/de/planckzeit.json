                ],
                "senses": [
                    {
                        "sense_id": "36040b76-ba4c-38ab-9660-17e4ebe090d3",
                        "entry_id": "13b0b51d-3473-379b-9a99-4131618bbd42",
                        "glosses": [
                            "kleinstmögliches Zeitintervall (≈ 5,391 · 10⁻⁴⁴ Sekunden), für das die bekannten Gesetze der Physik gültig sind; die Zeit, die Licht benötigt, um eine Planck-Länge zurückzulegen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "8a19203a-18fd-4910-807c-98765445104a",
                                "sense_id": "36040b76-ba4c-38ab-9660-17e4ebe090d3",
                                "text": "„Sie eignen sich daher erst für eine Beschreibung ab einem Zeitpunkt, zu dem der Urknall deutlich mehr als eine Planckzeit (ca. 5,391·10⁻⁴⁴ Sekunden) zurückliegt.“"
                            },
                            {
                                "example_id": "134cc198-6f9c-4ac7-b108-a1df4f9d5067",
                                "sense_id": "36040b76-ba4c-38ab-9660-17e4ebe090d3",
                                "text": "„Die Planckzeit beschreibt das kleinste Zeitintervall, für das die bekannten Gesetze der Physik gültig sind.“"
                            },
                            {
                                "example_id": "743f07cb-9ed1-424c-ba47-e6733d23c8e1",
                                "sense_id": "36040b76-ba4c-38ab-9660-17e4ebe090d3",
                                "text": "„Wir haben schon festgestellt, daß zur Planckzeit das gesamte heute beobachtbare Universum einen Bereich von nur etwa einem zehntel Millimeter Durchmesser umschloß.“"
                            },
                            {
                                "example_id": "e7502456-d628-44ee-b1f4-afa31e3a6768",
                                "sense_id": "36040b76-ba4c-38ab-9660-17e4ebe090d3",
                                "text": "„Innerhalb der Planckzeit nimmt man an, dass alle Kräfte vereinheitlicht waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
