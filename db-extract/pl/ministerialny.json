                "senses": [
                    {
                        "sense_id": "7062ee8b-61d1-3906-9ad9-e21fde931de0",
                        "entry_id": "e4f60a46-7113-35fa-bc6e-036d9d5c16ae",
                        "glosses": [
                            "dotyczący ministerstwa albo ministra, związany z ministerstwem albo ministrem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4b05e7-d24d-4556-b356-3065e8d3e0e6",
                                "sense_id": "7062ee8b-61d1-3906-9ad9-e21fde931de0",
                                "text": "Ta pozycja nie figuruje w ministerialnym wykazie podręczników."
                            },
                            {
                                "example_id": "28e2757c-9d6f-41d6-8dc2-28f10032d9fb",
                                "sense_id": "7062ee8b-61d1-3906-9ad9-e21fde931de0",
                                "text": "Większość kandydatów nie zdała egzaminu na stanowisko naczelnika, ministerialny test przeszło tylko trzech pełniących obowiązki naczelnika"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "190a2ea5-41d2-4be4-ba5e-7f4101ddf9a8",
                        "source_entry_id": "e4f60a46-7113-35fa-bc6e-036d9d5c16ae",
                        "source_sense_id": "7062ee8b-61d1-3906-9ad9-e21fde931de0",
                        "target_lang_word": "ministerial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
