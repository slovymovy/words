                "senses": [
                    {
                        "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                        "entry_id": "c254cab5-a701-39d1-aa70-26f6e8f7f98e",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a1d7653-a56a-422b-b4e1-dee4e189f470",
                                "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                                "text": "Frau Asi ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "882b5203-1425-492c-b11d-bc9525c06dd2",
                                "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                                "text": "Herr Asi wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "600007e2-f708-426e-b8a1-0505b715dc78",
                                "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                                "text": "Die Asis kommen heute aus den Alpen."
                            },
                            {
                                "example_id": "59205325-b09f-488c-977e-5711880e2296",
                                "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                                "text": "Der Asi trägt nie die Schals, die die Asi ihm strickt."
                            },
                            {
                                "example_id": "f1e5fbd8-d321-490e-a56d-a64ecdc093cc",
                                "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Asi kommt, geht der Herr Asi.“"
                            },
                            {
                                "example_id": "0d74eea7-6ec8-486f-a278-509ad0ba5192",
                                "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                                "text": "Asi kommt und geht."
                            },
                            {
                                "example_id": "e921f2d5-3fe3-4343-b04e-0164538c7014",
                                "sense_id": "1c24134e-efbd-3454-ae1f-7f33c412203c",
                                "text": "Asis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
