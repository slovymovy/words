                "senses": [
                    {
                        "sense_id": "cec0e87b-66df-3d2e-b54c-23e7214c2058",
                        "entry_id": "f61538c5-dbdf-3320-893e-de89b0abe69f",
                        "glosses": [
                            "Remplacer la couche de rhodium mise pour protéger une surface métallique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc70c07-3aa1-4f30-b3ab-85e818d3a2d1",
                                "sense_id": "cec0e87b-66df-3d2e-b54c-23e7214c2058",
                                "text": "Bague en excellent état, l'or est un peu jaunissant, il sera bon de la faire rerhodier par votre bijoutier, cela coûtera de 20 à 30 euros (...)"
                            },
                            {
                                "example_id": "91be394b-4cf5-4ca1-8c77-4cac28dee1a6",
                                "sense_id": "cec0e87b-66df-3d2e-b54c-23e7214c2058",
                                "text": "il suffit de demander à un bijoutier de nettoyer et rerhodier le bijou et il redevient comme neuf"
                            },
                            {
                                "example_id": "de558273-1f11-4d3a-aedf-e76046bac587",
                                "sense_id": "cec0e87b-66df-3d2e-b54c-23e7214c2058",
                                "text": "Et tant qu'on y est, quelqu'un connait la poudre magique à rerhodier ?"
                            }
                        ]
                    }
