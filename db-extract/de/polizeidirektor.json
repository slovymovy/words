                "senses": [
                    {
                        "sense_id": "fb1b2fab-f4a4-3ad5-b794-39da6df96af1",
                        "entry_id": "bddbcab3-6306-3dd9-916d-ab619becaf48",
                        "glosses": [
                            "Person bei der Polizei in leitender Position"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713ec6d9-86c5-439f-a95f-e4170e0258b9",
                                "sense_id": "fb1b2fab-f4a4-3ad5-b794-39da6df96af1",
                                "text": "„Dem Polizeidirektor stehen zur Drogenbekämpfung ganze 20 Polizisten zur Verfügung – landesweit.“"
                            },
                            {
                                "example_id": "184330d2-cfc6-413f-b09c-9836c5ca1997",
                                "sense_id": "fb1b2fab-f4a4-3ad5-b794-39da6df96af1",
                                "text": "„Der Polizeidirektor ist um so schneller darüber ins Bild gesetzt, als Hoffmann sich offen seiner Absichten gerühmt hat.“"
                            },
                            {
                                "example_id": "740b7f4e-7283-4b22-83db-d844d69bfd34",
                                "sense_id": "fb1b2fab-f4a4-3ad5-b794-39da6df96af1",
                                "text": "„Hörđur hatte mit zusammengebissenen Zähnen berichtet, dass der Polizeidirktor in Reykjavík gefragt habe, ob sie Unterstützung bräuchten.“"
                            }
                        ],
