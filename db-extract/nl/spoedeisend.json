                ],
                "senses": [
                    {
                        "sense_id": "63216b09-6714-30d7-9c5d-cc000e1e6217",
                        "entry_id": "0209d852-d1db-315b-b0b9-c5f3a92e9569",
                        "glosses": [
                            "waar haast bij (geboden) is."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a683bbb-cdb3-447f-9949-895455af9101",
                                "sense_id": "63216b09-6714-30d7-9c5d-cc000e1e6217",
                                "text": "Op de afdeling spoedeisende hulp van het ziekenhuis kwamen gewonden binnen."
                            },
                            {
                                "example_id": "be268c00-cb1e-4c12-899b-1f0a51154cf8",
                                "sense_id": "63216b09-6714-30d7-9c5d-cc000e1e6217",
                                "text": "Dat moet veranderen, vindt minister Madlener van Infrastructuur, want elk jaar belanden veel mensen na een fietsongeluk op de spoedeisende hulp. Vorig jaar waren dat 74.300 fietsers, van wie 48.900 met ernstig letsel, blijkt uit nieuwe cijfers van VeiligheidNL. En de groep met ernstig letsel wordt steeds groter."
                            }
                        ]
                    }
