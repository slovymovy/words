                        "glosses": [
                            "A small, young, or immature ape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3782b391-b218-4025-86cd-20d6df40032b",
                                "sense_id": "d6eb128e-cc5a-32b7-9634-5ec918652895",
                                "text": "Just now the apeling was developing those arboreal tendencies which were to stand him in such good stead during the years of his youth, when rapid flight into the upper terraces was of far more importance and value than his undeveloped muscles and untried fighting fangs."
                            },
                            {
                                "example_id": "9d97a357-8bee-4fa8-b9d0-5e5011f0c5dd",
                                "sense_id": "d6eb128e-cc5a-32b7-9634-5ec918652895",
                                "text": "The murder had occurred only a week before and the baby weighed but ten-or-so pounds, barely twice its birth weight. In spite of its traumatic first experience at the hands of humans, the apeling showed little fear of us."
                            }
                        ]
                    }
