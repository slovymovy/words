    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0430c271-dbaa-3a96-9ca0-0ab1475a563a",
                "word": "canned",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6de92da7-47d3-3ec9-bbba-8817ee16118a",
                        "entry_id": "0430c271-dbaa-3a96-9ca0-0ab1475a563a",
                        "glosses": [
                            "Preserved in cans."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "baa95c19-b3ec-4f4a-9f44-ea5190282323",
                                "sense_id": "6de92da7-47d3-3ec9-bbba-8817ee16118a",
                                "text": "canned tomatoes"
                            },
                            {
                                "example_id": "86c74cd8-0c9d-477c-ace7-b0b9de0f5e3b",
                                "sense_id": "6de92da7-47d3-3ec9-bbba-8817ee16118a",
                                "text": "If you don't have fresh cardoon I'll take canned."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a5c9924-4b0e-3c8a-8328-998119b8f0bc",
                        "entry_id": "0430c271-dbaa-3a96-9ca0-0ab1475a563a",
                        "glosses": [
                            "Previously prepared; not fresh or new; standardized, mass-produced, or lacking originality or customization."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a9fc287c-4359-4b38-ad03-154dfadd5e97",
                                "sense_id": "4a5c9924-4b0e-3c8a-8328-998119b8f0bc",
                                "text": "canned laughter"
                            },
                            {
                                "example_id": "d96a7594-461f-45db-8e18-df9ac9a82226",
                                "sense_id": "4a5c9924-4b0e-3c8a-8328-998119b8f0bc",
                                "text": "The form letter included a canned answer stating that what I asked was against policy."
                            },
                            {
                                "example_id": "28f13a39-924c-4724-8529-6efe32c76584",
                                "sense_id": "4a5c9924-4b0e-3c8a-8328-998119b8f0bc",
                                "text": "And the punch-lines seem to disappear like clouds across the sky / And the laughter could be real or could be canned"
                            },
                            {
                                "example_id": "7a83d6a3-b0e7-4c0a-a110-6ab105bfc3ab",
                                "sense_id": "4a5c9924-4b0e-3c8a-8328-998119b8f0bc",
                                "text": "Unfortunately, some of the canned code, which Visual C++ gives to you when creating an application, is not CE aware and gives you compile errors."
                            },
                            {
                                "example_id": "093a07bd-d004-4836-89d4-053c10c25050",
                                "sense_id": "4a5c9924-4b0e-3c8a-8328-998119b8f0bc",
                                "text": "The vested owners of all those sun-drenched tract houses may stick around for a while and fight over the region, perhaps thinking that they are reenacting the great historical dramas of the nineteenth century—such is the long-term effect of canned entertainment on the collective imagi­nation."
                            },
                            {
                                "example_id": "480ab93f-a4f5-4827-abb1-866b85656ac7",
                                "sense_id": "4a5c9924-4b0e-3c8a-8328-998119b8f0bc",
                                "text": "Throughout the evening, Mr. Christie’s admonition about canned lines and rehearsed speeches hovered and seemed to recalibrate how the crowd — and television viewers — processed what Mr. Rubio said (and resaid, over and over)."
                            }
                        ]
                    },
                    {
                        "sense_id": "143d69d9-cd38-3158-a77f-06ef706e090e",
                        "entry_id": "0430c271-dbaa-3a96-9ca0-0ab1475a563a",
                        "glosses": [
                            "Drunk."
                        ],
                        "tags": [
                            "not-comparable",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7ea4551b-8cec-339e-9065-31891d76419c",
                        "entry_id": "0430c271-dbaa-3a96-9ca0-0ab1475a563a",
                        "glosses": [
                            "Terminated, fired from a job."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "49b3920a-2731-3984-a309-c95b811754f9",
                        "entry_id": "0430c271-dbaa-3a96-9ca0-0ab1475a563a",
                        "glosses": [
                            "Cancelled or thrown away, said of a project or news article."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bc82a050-0154-4845-aeba-04f2a2a106e1",
                                "sense_id": "49b3920a-2731-3984-a309-c95b811754f9",
                                "text": "The raider story was canned by the censor on instructions from the naval authorities."
                            }
                        ]
                    }
                ],
