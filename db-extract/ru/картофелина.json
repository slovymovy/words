                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76bdd9ac-dfad-45bd-bc19-7e08f1f31110",
                                                "sense_id": "9203942a-2e0d-388b-b2e2-a46c144ba69e",
                                                "text": "When most people refer to their computers as a potato they're being hyperbolic, but not Ethan. He plays Overwatch at 800x600 resolution with all settings on low and is excited when he gets 30 fps."
                                            },
                                            {
                                                "example_id": "ee5e35d9-8874-47e7-a5e6-a42c379975f2",
                                                "sense_id": "9203942a-2e0d-388b-b2e2-a46c144ba69e",
