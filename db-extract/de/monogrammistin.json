                                "sense_id": "46863f82-db34-3743-93a4-d10b61bd92b1",
                                "text": "„Monogrammistin 20. Jahrhundert (Irene Fellinger-Mlekus), Blumenstilleben, monogrammiert IFM, Arbeit um 1980, Öl auf Karton, 45,5 x 34,5 cm, Profilholzrahmen“"
                            }
                        ],
                        "sense_index_json": "\"1\""
