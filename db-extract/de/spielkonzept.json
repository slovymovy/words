                ],
                "senses": [
                    {
                        "sense_id": "3ccce588-4667-3ff6-9d22-495d901efd0f",
                        "entry_id": "c67a4955-1d46-3dee-b26c-837fecc6207d",
                        "glosses": [
                            "strategische Vorstellung von der Gestaltung eines erfolgreichen Spielablaufs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eab5dd0-608a-4cc7-bbf0-43a5a47f8803",
                                "sense_id": "3ccce588-4667-3ff6-9d22-495d901efd0f",
                                "text": "„Dieses Spielkonzept fußt auf den Prinzipien des genetischen Lernens, bei dem der Weg zum Ziel als eigentliche Aufgabe erscheint, die von den am Spiel Beteiligten bewältigt werden muß.“"
                            },
                            {
                                "example_id": "57fab9ee-12e5-49d3-84d7-dd663d2e6df5",
                                "sense_id": "3ccce588-4667-3ff6-9d22-495d901efd0f",
                                "text": "„Ist dies nun der neue Weg, daß die persönliche Spielgestaltung zunächst völlig zurückgestellt wird, wohldurchdachte Spielkonzepte ständig praktiziert werden und erst nach deren Festigung und Stabilisierung persönliche Noten und Varianten erlaubt werden, die endlich zu einem Spiel führen, welches die Attribute planvoll und ideenreich verdient?“"
                            },
                            {
                                "example_id": "bf29cc86-72d7-452e-9c21-2feab0c74a88",
                                "sense_id": "3ccce588-4667-3ff6-9d22-495d901efd0f",
                                "text": "„Die wohl einfallsreichsten Spielkonzepte sind auf der Messe im Bereich Kinder- und Familienspiele zu finden: ‚EyePet’ ist so etwas wie die Weiterentwicklung des wohlbekannten Tamagotchi.“"
                            },
                            {
                                "example_id": "56c52170-2f1b-4467-8f72-1d188a983264",
                                "sense_id": "3ccce588-4667-3ff6-9d22-495d901efd0f",
                                "text": "„Denn selbst nach Siegen wie gegen Mainz werde ich das Gefühl nicht los, dass das Hamburger Spielkonzept größtenteils auf Glück, Zufall und Hoffnung basiert.“"
                            },
                            {
                                "example_id": "b82afb56-99e9-4b4a-84eb-d42fd39c2fb9",
                                "sense_id": "3ccce588-4667-3ff6-9d22-495d901efd0f",
                                "text": "„Er passt in unser Spielkonzept sehr gut rein, egal ob er über außen oder aus der Mitte kommt, sagte Hecking zur künftigen Integration Draxlers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
