                                        "sense_id": "16408c29-8e1c-326d-9689-731dd682a16d",
                                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                                        "glosses": [
                                            "kegelsnede waarbij het snijvlak parallel loopt met een lijn die aan de kegel raakt en tevens het toppunt snijdt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cab366e-dd23-4f32-9479-ace3d5ae476c",
                                                "sense_id": "16408c29-8e1c-326d-9689-731dd682a16d",
                                                "text": "Als er geen wrijving was en de aarde plat was, dan zou de baan van een kogel een perfecte parabool beschrijven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "018249ca-4304-3999-8dc6-ab33b962935c",
                                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                                        "glosses": [
                                            "de paraboloïde reflector met een zeer sterke richtwerking vooral toegepast voor geluid, warmte, licht en bij antennes voor de hogere zend- en ontvangfrequenties van het radiospectrum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a6fee1-311f-40ab-a47d-77e180e64dd3",
                                                "sense_id": "018249ca-4304-3999-8dc6-ab33b962935c",
                                                "text": "Een schotelantenne heeft doorgangs een parabool als reflector."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ffbe559-0981-3852-8dfb-6f3e8be3d309",
                                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                                        "glosses": [
                                            "naam van de antenne met een parabool als reflector"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281a653a-940d-4f15-b682-ed5e1cb87a4d",
                                                "sense_id": "7ffbe559-0981-3852-8dfb-6f3e8be3d309",
                                                "text": "Een radiotelescoop voor ruimteonderzoek met een enorme parabool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67801840-e41b-368e-b760-c34bee31660c",
                                        "entry_id": "38c983cf-3b22-33c3-a5df-d75e7613ca40",
                                        "glosses": [
                                            "een bewoording waarbij iets doelbewust zwakker of onbeduidender wordt voorgesteld dan het in werkelijkheid is"
                                        ],
                                        "tags": [
                                            "stijlfiguur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d69e68-b3b0-49c8-ae5b-16be957277d7",
                                                "sense_id": "67801840-e41b-368e-b760-c34bee31660c",
                                                "text": "Als jij het Concertgebouworkest \"een aardig strijkje\" noemt, dan is dat een parabool, je weet wel beter!"
                                            }
                                        ]
                                    }
                                ]
                            }
