                        "glosses": [
                            "geheimer Fonds, der Gelder enthält, die nach freiem Ermessen und ohne weitere Rechenschaft verwendet werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e751c97-05a3-452a-a0fb-28f94064acac",
                                "sense_id": "b1f64518-4aaa-320f-9549-3c161d9800c7",
                                "text": "Ein Reptilienfonds ist eine feine Sache: Man kann Geld ausgeben, ohne dass man dafür im gleichen Maß wie beim normalen Haushalt Rechenschaft ablegen muss."
                            }
                        ],
                        "sense_index_json": "\"1\""
