                                "target_senses": [
                                    {
                                        "sense_id": "498e65b0-adc3-3ffc-950f-de0de53091da",
                                        "entry_id": "075c8ced-c358-3691-8261-788e89c3b4a3",
                                        "glosses": [
                                            "Fermented green forage fodder stored in an airtight silo or clamp."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a82b63-6cfb-4870-801d-406e5f0a99d0",
                                                "sense_id": "498e65b0-adc3-3ffc-950f-de0de53091da",
                                                "text": "Compared to the corn silages, the sweetclover silages are much higher in digestible crude protein, but lower in total digestible nutrients."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "silage",
