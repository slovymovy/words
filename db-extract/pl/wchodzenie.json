                                        "entry_id": "b363289d-1af8-3b69-922c-f5828562db76",
                                        "glosses": [
                                            "действие по значению гл. входить; перемещение кого-то или чего-то куда-либо, внутрь чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ea6dc7-612c-41ac-828c-735659fb33c4",
                                                "sense_id": "a331195b-b787-3e65-8c8b-1c483d47bdd5",
                                                "text": "Вход процессии в храм."
                                            },
                                            {
                                                "example_id": "04bb9749-6a9a-4c2b-b928-e3697c3c6c4d",
                                                "sense_id": "a331195b-b787-3e65-8c8b-1c483d47bdd5",
                                                "text": "В тот же день состоялся, наконец, торжественный вход в Петербург войск, участвовавших в турецкой кампании."
                                            },
                                            {
                                                "example_id": "0f5ee452-ceb4-4eb2-8238-5799667f6d21",
                                                "sense_id": "a331195b-b787-3e65-8c8b-1c483d47bdd5",
                                                "text": "Вход воспрещён."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be7215e7-38b8-3c35-88dc-0a9c290fec81",
                                        "entry_id": "b363289d-1af8-3b69-922c-f5828562db76",
                                        "glosses": [
                                            "место, предназначенное для такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e16be6d-2c0c-449e-b9c0-0ff1b17b4d78",
                                                "sense_id": "be7215e7-38b8-3c35-88dc-0a9c290fec81",
                                                "text": "Вход в дом."
                                            },
                                            {
                                                "example_id": "980aae72-41b2-48cc-bf5f-8babbb851c88",
                                                "sense_id": "be7215e7-38b8-3c35-88dc-0a9c290fec81",
                                                "text": "Вход в метро."
                                            }
                                        ]
                                    }
                                ]
                            }
