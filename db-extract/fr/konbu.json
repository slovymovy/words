                        "glosses": [
                            "Variante de kombu (« algue comestible cultivée au Japon »)."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f075ff7c-9e98-49a4-9b66-c5c7bfea0ffe",
                                "sense_id": "039caed0-7d6f-3a85-917a-52deabc291c2",
                                "text": "Les îles de Rishiri-Rebun, à la pointe Nord-Ouest, visitées il y a fort longtemps, m’ont laissé une impression de bout du monde, avec leurs rivages sans fin où séchaient à perte de vue, alignées sur le sable, des algues konbu (celles qui, avec la bonite séchée, donnent au bouillon japonais son inimitable saveur)."
                            },
                            {
                                "example_id": "4bfb0559-cb26-4b6f-833c-22e9b441a0fe",
                                "sense_id": "039caed0-7d6f-3a85-917a-52deabc291c2",
                                "text": "Dans la composition la plus fréquente du dashi, on trouve de l’eau, du katsuobushi (flocons de bonite séchée) et du konbu (algue séchée)."
                            }
                        ]
                    }
