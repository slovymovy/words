                "senses": [
                    {
                        "sense_id": "339fbb06-c68a-3457-80cd-714c8044b186",
                        "entry_id": "ce1d5739-3624-3119-a285-4fd12ff953b9",
                        "glosses": [
                            "melange, mengelmoes, mengsel waarvan de verschillende componenten nog herkenbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1808822a-efd3-4740-893f-f45373751e47",
                                "sense_id": "339fbb06-c68a-3457-80cd-714c8044b186",
                                "text": "De bevolking van Amsterdam is een mengeling van vele nationaliteiten."
                            },
                            {
                                "example_id": "7e344281-d7f8-4fb8-b12c-9f438d0a1cea",
                                "sense_id": "339fbb06-c68a-3457-80cd-714c8044b186",
                                "text": "Het was een mengeling van heimwee en schuldgevoel en veroorzaakte een onaangename knoop in mijn buik."
                            },
                            {
                                "example_id": "6068b01b-0196-4447-b54c-f272467eb64c",
                                "sense_id": "339fbb06-c68a-3457-80cd-714c8044b186",
                                "text": "Haar geliefde - haar verloofde! - ruikt naar olieverf, zeep en zijn eigen ondefinieerbare mengeling van schone katoen en Walter, en het is een adembenemende geur."
                            },
                            {
                                "example_id": "d523ad48-e6b3-4ea5-975d-bb5caf0a1c87",
                                "sense_id": "339fbb06-c68a-3457-80cd-714c8044b186",
                                "text": "Nella voelt een mengeling van ontzag en ergernis boven een onderstroom van angst."
                            }
                        ]
                    }
                ],
