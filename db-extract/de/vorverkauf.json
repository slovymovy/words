                "senses": [
                    {
                        "sense_id": "080677ec-6e76-31df-868d-813bc71ea052",
                        "entry_id": "a3f5f7c3-97a5-339c-92ff-de433a8735b9",
                        "glosses": [
                            "Verkauf von Eintrittskarten mehrere Tage oder Wochen vor Beginn einer Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7008269b-03a4-4d9c-adbf-ca4566cf4655",
                                "sense_id": "080677ec-6e76-31df-868d-813bc71ea052",
                                "text": "Im Vorverkauf sind Eintrittskarten häufig günstiger als an der Abendkasse."
                            },
                            {
                                "example_id": "e9bbe8b7-e56c-4863-8107-de37504332c2",
                                "sense_id": "080677ec-6e76-31df-868d-813bc71ea052",
                                "text": "Die Vorverkäufe für das neue Theaterstück gehen nur schleppend voran."
                            },
                            {
                                "example_id": "9246c37c-c38a-4cea-a88c-b45878cbffb6",
                                "sense_id": "080677ec-6e76-31df-868d-813bc71ea052",
                                "text": "Die Beliebtheit des Festivals hatte derart zugenommen, dass es bereits im Vorverkauf ausverkauft war."
                            }
                        ],
                        "sense_index_json": "\"1\""
