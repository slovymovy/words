                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "def83193-3b29-38be-95d1-90d4b9eec3f6",
                                        "entry_id": "f619f5b1-8b31-36c4-9702-8e3b0475befa",
                                        "glosses": [
                                            "In a pitiful manner; pitifully; piteously; pathetically."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93efe10c-3b7d-4b05-909c-0ed19ddb0731",
                                                "sense_id": "def83193-3b29-38be-95d1-90d4b9eec3f6",
                                                "text": "‘She followed ’em, cryin’ pitiful, to the old boat on the Wall[.]’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pitiful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfa0300f-5207-3cf6-a35c-9c8badd16edc",
                                        "entry_id": "e335147f-08f6-3876-98ba-8d60ef3a30af",
                                        "glosses": [
                                            "So appalling or sad that one feels or should feel sorry for it; eliciting pity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e731ecb6-756f-4286-bf77-621ca9ba6a3a",
                                                "sense_id": "bfa0300f-5207-3cf6-a35c-9c8badd16edc",
                                                "text": "Scotland has a pitiful climate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e1ddd49-d231-3f68-83a6-70d8d74a4427",
                                        "entry_id": "e335147f-08f6-3876-98ba-8d60ef3a30af",
                                        "glosses": [
                                            "Of an amount or number: very small."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7985cd1-86af-4556-8301-5124ccec164a",
                                                "sense_id": "2e1ddd49-d231-3f68-83a6-70d8d74a4427",
                                                "text": "A pitiful number of students bothered to turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b55f02c-b3cd-37a6-be7a-dd126fd3a7c4",
                                        "entry_id": "e335147f-08f6-3876-98ba-8d60ef3a30af",
                                        "glosses": [
                                            "Feeling pity; merciful."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f338a7b2-a80f-42cf-bc4a-8b944b88a6f4",
                                                "sense_id": "2b55f02c-b3cd-37a6-be7a-dd126fd3a7c4",
                                                "text": "Some ſay that Rauens foſter forlorne children, / The vvhilſt their ovvne birds famiſh in their neſts: / Oh be to me though thy hard hart ſay no, / Nothing ſo kinde but ſomething pittifull."
                                            },
                                            {
                                                "example_id": "b6aa8e75-dfa8-41b5-8155-029a034c2996",
                                                "sense_id": "2b55f02c-b3cd-37a6-be7a-dd126fd3a7c4",
                                                "text": "Straightway, he now goes on to make a full confession; whereupon the mariners became more and more appalled, but still are pitiful."
                                            }
                                        ]
                                    }
                                ]
                            }
