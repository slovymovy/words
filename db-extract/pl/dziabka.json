                        "translation_id": "3d88c13b-6b35-4c86-b5bd-be597d103213",
                        "source_entry_id": "7b8a6736-74fb-35a2-a1f8-f90cec83e0cb",
                        "source_sense_id": "b8feffb2-6b57-345d-9b1a-8fb329bb44a0",
