                    {
                        "sense_id": "85085717-4080-380a-9b57-5032bbda92fa",
                        "entry_id": "ef250a43-ad63-3c41-aa3b-c925b74b53e9",
                        "glosses": [
                            "verticaal omgekeerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7028404f-905b-49f0-a716-89b9915ce151",
                                "sense_id": "85085717-4080-380a-9b57-5032bbda92fa",
                                "text": "Dat schilderij hangt, denk ik, ondersteboven."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a3bdd78-5c57-3f01-a41a-10dd18d87a79",
                        "entry_id": "ef250a43-ad63-3c41-aa3b-c925b74b53e9",
                        "glosses": [
                            "niet meer rechtopstaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0939f4-2d10-4070-b365-d0ff335a6acb",
                                "sense_id": "5a3bdd78-5c57-3f01-a41a-10dd18d87a79",
                                "text": "Toen de bus ging rijden gingen de staande mensen ondersteboven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a00a15bf-9173-4475-a678-4de87c1c30a3",
                        "source_entry_id": "ef250a43-ad63-3c41-aa3b-c925b74b53e9",
                        "source_sense_id": "85085717-4080-380a-9b57-5032bbda92fa",
                        "source_sense_description": "verticaal omgekeerd",
                        "target_lang_word": "kopfüber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kopfüber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                        "entry_id": "d0e7ae64-b9be-37c4-928c-cfd7d3a9a73c",
                                        "glosses": [
                                            "mit dem Kopf zuerst; mit dem Kopf voran"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb061160-0cf1-4590-98b4-6e55eb6187bf",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "„Fledermäuse tun etwas, was sonst kein Tier tut: sie schlafen kopfüber!“"
                                            },
                                            {
                                                "example_id": "09f6c1b1-8a57-4324-b2c7-e84b4d53020f",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "„Die tragischsten Fälle waren zwei Jungen, die kopfüber in die Regentonne gekippt sind“, sagt Kirschstein."
                                            },
                                            {
                                                "example_id": "51100cb9-d2ae-4a62-82d7-803954654b53",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "„Plötzlich geht er leicht in die Knie, stösst sich ab und springt kopfüber in die Tiefe.“"
                                            },
                                            {
                                                "example_id": "4ff851c3-e983-4589-86a7-5e5f2d026fef",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "übertragen: „Statt über die Bürde der Tradition zu klagen und sich in der Nische der Tanzverweigerung zu verkriechen, stürzt er sich kopfüber ins Experiment.“"
                                            },
                                            {
                                                "example_id": "2ba90170-b129-4324-a85c-51d63899798a",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "übertragen: „Olga Esina nähert sich neuerlich der Kindfrau, die sich kopfüber in die Liebe stürzt, und es fällt ihr wieder schwer.“"
                                            },
                                            {
                                                "example_id": "bec46855-ee6b-430d-b45d-6fcf83aac418",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "„Um wirklich alle zu reinigenden Stellen zu erreichen, müssen Gebäudereiniger/innen auch manchmal kopfüber am Seil arbeiten – aber das ist eher die Ausnahme.“"
                                            },
                                            {
                                                "example_id": "c47ac9b8-07be-4192-af45-0022291e2e3a",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "übertragen: „Als er sich entschloß, beruflich auf eigenen Beinen zu stehen, hatte sie sich kopfüber in die Arbeit gestürzt.“"
                                            },
                                            {
                                                "example_id": "66c495a5-6e49-4a0f-8304-e6d52fc6cb7e",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "übertragen: „Kopfüber ist ein Baggerfahrer mit seinem Gefährt drei Meter tief in einen Bauschutt-Container gestürzt.“"
                                            },
                                            {
                                                "example_id": "0eb0d831-833f-406e-9bb6-f1b925977660",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "„Polizeibeamte haben einen 18-Jährigen Dieb in Hamburg-St. Georg gefasst, als er noch kopfüber in ein Auto gebeugt war.“"
                                            },
                                            {
                                                "example_id": "611f0f49-819a-46fb-879f-1eb4be780e87",
                                                "sense_id": "fbb962c5-cd7f-3740-accc-a42cb6b679e7",
                                                "text": "„Rund 40 Minuten lang hat ein Mann in Hamburg-St. Pauli kopfüber in einem Sielschacht festgesteckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
