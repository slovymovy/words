                        "target_lang_word": "ungestraft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungestraft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68f0f78f-4fde-3d4e-84aa-f8595faac299",
                                        "entry_id": "c35174d0-a8fc-3952-8f68-02eb61f5ca77",
                                        "glosses": [
                                            "ohne eine Strafe zu bekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b73a16-a573-43c1-aa53-3d8dd9b905a5",
                                                "sense_id": "68f0f78f-4fde-3d4e-84aa-f8595faac299",
                                                "text": "„Nur einmal tat sich was, und das war 1866. Es war das Jahr, von dem eingefleischte Bayern mit verzückten Augen berichten, daß damals die letzte Gelegenheit gewesen wäre, ungestraft auf Preußen zu schießen.“"
                                            },
                                            {
                                                "example_id": "7bfca9b9-573a-4bf9-a009-729a014fcb76",
                                                "sense_id": "68f0f78f-4fde-3d4e-84aa-f8595faac299",
                                                "text": "„Übrigens war die Darstellung von allerlei allegorischen Gestalten, Märchenfiguren und Heldenjungfrauen nicht zuletzt deswegen so beliebt, weil man ihnen ungestraft auf den Busen gucken durfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
