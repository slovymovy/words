{
    "word_family": [
        "subparagraph"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa7046eb-6d95-3469-9ebd-622d43165bda",
                    "sense_definition": "A distinct section of a piece of writing that usually deals with a single theme and starts on a new line.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "text_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the first <w>paragraph</w> of the story aloud to the class.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте первый <w>абзац</w> рассказа вслух классу.",
                                "zh": "请把故事的第一<w>段落</w>大声读给全班听。"
                            }
                        },
                        {
                            "text": "The essay should contain at least one introductory <w>paragraph</w>.",
                            "target_lang_translations": {
                                "ru": "Эссе должно содержать по крайней мере один вступительный <w>абзац</w>.",
                                "zh": "这篇文章应该包含至少一个引言<w>段落</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "section",
                        "passage"
                    ],
                    "common_phrases": [
                        "new paragraph",
                        "opening paragraph",
                        "final paragraph",
                        "short paragraph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная часть письменного текста, которая обычно посвящена одной теме и начинается с новой строки.",
                        "zh": "文章中通常围绕一个主题展开并以新行开始的独立部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абзац",
                                "target_lang_sense_clarification": "часть текста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "段落",
                                "target_lang_sense_clarification": "文章的组成部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9a1d132-53b2-353a-a16b-fb277bc5dc9a",
                    "sense_definition": "A short news article, notice, or announcement in a newspaper or magazine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "journalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity was upset by a gossip <w>paragraph</w> in the local paper.",
                            "target_lang_translations": {
                                "ru": "Знаменитость была расстроена <w>заметкой</w> со сплетнями в местной газете.",
                                "zh": "那位名人对当地报纸上的一则八卦<w>简讯</w>感到很不高兴。"
                            }
                        },
                        {
                            "text": "She wrote a small <w>paragraph</w> about the charity event for the weekly news.",
                            "target_lang_translations": {
                                "ru": "Она написала небольшую <w>заметку</w> о благотворительном мероприятии для еженедельных новостей.",
                                "zh": "她为周报写了一篇关于慈善活动的短<w>简讯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "item",
                        "snippet",
                        "piece",
                        "blurb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая новостная статья, заметка или объявление в газете или журнале.",
                        "zh": "报纸或杂志中的短篇新闻、简讯或公告。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметка",
                                "target_lang_sense_clarification": "в газете"
                            },
                            {
                                "target_lang_word": "короткое сообщение",
                                "target_lang_sense_clarification": "новость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简讯",
                                "target_lang_sense_clarification": "报刊中的短文"
                            },
                            {
                                "target_lang_word": "短文",
                                "target_lang_sense_clarification": "新闻报道"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c8e954e-fcc4-3d22-8c1e-fbfdfa790938",
                    "sense_definition": "A specific symbol (¶) used to mark the beginning of a new section of text or for reference.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor inserted a <w>paragraph</w> mark to show where the break should be.",
                            "target_lang_translations": {
                                "ru": "Редактор вставил знак <w>абзаца</w>, чтобы показать, где должен быть разрыв.",
                                "zh": "编辑插入了一个<w>段落标记</w>来显示断行位置。"
                            }
                        },
                        {
                            "text": "Look for the <w>paragraph</w> symbol in the margin of the old manuscript.",
                            "target_lang_translations": {
                                "ru": "Ищите символ <w>абзаца</w> на полях старой рукописи.",
                                "zh": "在旧手稿的页边空白处寻找<w>段落标记</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pilcrow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальный символ (¶), используемый для обозначения начала нового раздела текста или для ссылки.",
                        "zh": "用于标记文本新部分开始或用于引用的特定符号（¶）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знак абзаца",
                                "target_lang_sense_clarification": "символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "段落标记",
                                "target_lang_sense_clarification": "排版符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4660068-9a63-324d-b106-fee3316ba869",
                    "sense_definition": "A specific unit of memory size equal to 16 bytes, used in certain computer architectures.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The memory segment is aligned to a <w>paragraph</w> boundary.",
                            "target_lang_translations": {
                                "ru": "Сегмент памяти выровнен по границе <w>параграфа</w>.",
                                "zh": "内存段与<w>段</w>边界对齐。"
                            }
                        },
                        {
                            "text": "In real mode, a segment register points to a <w>paragraph</w> in memory.",
                            "target_lang_translations": {
                                "ru": "В реальном режиме регистр сегмента указывает на <w>параграф</w> в памяти.",
                                "zh": "在实模式下，段寄存器指向内存中的一个<w>段</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица объема памяти, равная 16 байтам, используемая в определенных компьютерных архитектурах.",
                        "zh": "计算机体系结构中等于16字节的内存大小单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "параграф",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "段",
                                "target_lang_sense_clarification": "计算机内存单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c89e6d7b-2b31-3d0d-9a4d-5a3dcc735065",
                    "sense_definition": "To divide a piece of writing into distinct sections or paragraphs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "text_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>paragraph</w> your essay to make it easier to read.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>разбить на абзацы</w> свое эссе, чтобы его было легче читать.",
                                "zh": "你需要给你的文章<w>分段</w>，这样读起来更容易。"
                            }
                        },
                        {
                            "text": "The editor <w>paragraphed</w> the long manuscript effectively.",
                            "target_lang_translations": {
                                "ru": "Редактор эффективно <w>разбил на абзацы</w> длинную рукопись.",
                                "zh": "编辑有效地将长篇手稿进行了<w>分段</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "section",
                        "segment"
                    ],
                    "common_phrases": [
                        "paragraph the text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять текст на отдельные части или абзацы.",
                        "zh": "将文章划分为不同的部分或段落。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивать на абзацы",
                                "target_lang_sense_clarification": "форматирование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分段",
                                "target_lang_sense_clarification": "文章排版"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63940ca8-3193-3460-9d95-dd45729b74fb",
                    "sense_definition": "To write or publish a short news item about someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "journalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal was <w>paragraphed</w> in every major newspaper.",
                            "target_lang_translations": {
                                "ru": "О скандале <w>написали заметки</w> во всех крупных газетах.",
                                "zh": "各大报纸都对这起丑闻<w>写了简讯</w>。"
                            }
                        },
                        {
                            "text": "He <w>paragraphed</w> the event for the society column.",
                            "target_lang_translations": {
                                "ru": "Он <w>написал заметку</w> о событии для светской хроники.",
                                "zh": "他为社交专栏<w>写了简讯</w>报道这次活动。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать или публиковать короткую новостную заметку о ком-то или чем-то.",
                        "zh": "撰写或发布关于某人或某事的简短新闻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писать заметки",
                                "target_lang_sense_clarification": "журналистика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "写简讯",
                                "target_lang_sense_clarification": "新闻报道"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}