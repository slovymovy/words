                        "form": "uxoricides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6084a583-3564-3a05-b8bd-8e263af6e825",
                        "entry_id": "3b7f9a74-c03d-3565-a79f-e058c6be2f52",
                        "glosses": [
                            "Relatif au meurtre de l’épouse par l’époux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc69c70-cb3f-440d-87ef-3b1552611e20",
                                "sense_id": "6084a583-3564-3a05-b8bd-8e263af6e825",
                                "text": "Le présent travail débute par le contexte théorique qui présente les définitions, l’ampleur du phénomène, la compréhension du passage à l’acte uxoricide, la synthèse et une critique des études portant sur l’uxoricide."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b69d46d-2f87-3c36-a21f-d21fd9110434",
                        "entry_id": "3b7f9a74-c03d-3565-a79f-e058c6be2f52",
                        "glosses": [
                            "Qualifie l’époux qui a tué son épouse."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3675908c-1456-4d09-acb1-f9721ba78272",
                                "sense_id": "2b69d46d-2f87-3c36-a21f-d21fd9110434",
                                "text": "Aussi, pour l’expiation d’un tel Crime, ce Pape n’exige pas moins du mari uxoricide, qu’une pénitence continuelle, qui doit durer pendant tout le reste de ses jours."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2b4a5f7e-6977-3cff-8323-a5fee60a38da",
                "word": "uxoricide",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a973cb63-701e-45b4-b708-2c427c9626c1",
                        "entry_id": "2b4a5f7e-6977-3cff-8323-a5fee60a38da",
                        "tags": [
                            "plural"
                        ],
                        "form": "uxoricides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a5c261e-70b0-3dfb-82b9-dc669f031037",
                        "entry_id": "2b4a5f7e-6977-3cff-8323-a5fee60a38da",
                        "glosses": [
                            "Meurtre de l’épouse par l’époux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8d2b54-4241-4e55-a389-402188a3783d",
                                "sense_id": "8a5c261e-70b0-3dfb-82b9-dc669f031037",
                                "text": "C’est-à-dire : nᵒ 1 Sauf les empoisonnements par adultère, tous les autres uxoricides déterminés par l’adultère et les dissensions domestiques sont diminués après le rétablissement du divorce ; […]."
                            },
                            {
                                "example_id": "b6a72e3a-53a5-4a74-9716-dd566d4ec3ed",
                                "sense_id": "8a5c261e-70b0-3dfb-82b9-dc669f031037",
                                "text": "Ces analyses font ressortir la similitude des finalités entre l’uxoricide et les autres gestes de violence physique, verbale et psychologique exercés par des hommes envers leurs conjointes et leurs enfants."
                            },
                            {
                                "example_id": "140dbbab-ec2d-4c07-bd17-b4fcb8eb7fcb",
                                "sense_id": "8a5c261e-70b0-3dfb-82b9-dc669f031037",
                                "text": "Les révolutionnaires vont fonder la responsabilité pénale sur la raison et non sur une logique de passion, sous-jacente à l’uxoricide. Le terme d’uxoricide n’apparaît donc pas dans le premier Code pénal, en 1791 mais est discuté un crime de «conjugicide» pour l’élaboration du second Code Pénal de 1810."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
