                "senses": [
                    {
                        "sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                        "entry_id": "163c9cc0-5922-3fb6-9f0b-075f843f154d",
                        "glosses": [
                            "schmaler, für Lasttiere begehbarer Weg im Gebirge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7fe3806-f1a7-4075-8b60-53b3bb73df79",
                                "sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                                "text": "Der Versuch des Menschen, die Berge zu überwinden, hat eine lange Geschichte. Es gibt uralte, nur zu Fuß erreichbare Saumpfade."
                            },
                            {
                                "example_id": "d7ba88d5-05b4-4635-8744-ea5d82c51600",
                                "sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                                "text": "Die Wanderung entlang des Archaikwegs stellt uns einen ur- und frühgeschichtlichen Saumpfad vor, der das Etschtal mit dem Veltlin verband und damit einen Zusammenschluss des südlichen Alpenvorlandes mit dem inneralpinen Raum herstellte."
                            },
                            {
                                "example_id": "0deed3a7-08e1-4c6d-bd07-4eb4ce686d94",
                                "sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                                "text": "Das Tal liegt bereits tief unter uns, und bald haben wir entlang des Saumpfades das rätoromanische Dorf Stilfs erreicht (1311 m)."
                            },
                            {
                                "example_id": "eacac82b-2d31-43b8-b220-ab806fc79dd9",
                                "sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                                "text": "Auf dem einst bedeutenden Saumpfad wurde ab dem 15. Jh. das Salz aus Hall in Tirol, als wertvollstes Handelsgut des Landesfürsten, vom Lechtal kommend ins Große Walsertal und den Bregenzerwald gebracht."
                            },
                            {
                                "example_id": "b509dbb3-12d3-4c5c-99fd-0198ec569e24",
                                "sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                                "text": "Von Steinach über Vinaders führte ein Saumpfad zum Brenner."
                            },
                            {
                                "example_id": "9acf5b2e-399f-4c1e-82ef-d2496c22e87a",
                                "sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                                "text": "Die alte Magistrale ist nur ein Saumpfad auf einem von dichtem Grün bewachsenen Erdwall."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a7c4abb-d652-49aa-b9cc-3e687f55bf72",
                        "source_entry_id": "163c9cc0-5922-3fb6-9f0b-075f843f154d",
