                        "glosses": [
                            "Orthographe (ancienne) de paumoyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24944645-15e8-4fe1-a247-da9e1cbd3048",
                                "sense_id": "60dadebe-82cd-3451-bab1-8d1b5f9b4a16",
                                "text": "En style de marin, il se « pomoya » avec tant d’activité, que le 29 août, il put prendre son billet pour Farina-Town."
                            },
                            {
                                "example_id": "3b1e0b87-3634-4db7-adad-8690f63112aa",
                                "sense_id": "60dadebe-82cd-3451-bab1-8d1b5f9b4a16",
                                "text": "On en prit un bout qu’on entra par un trou d’écubier et la corvette se pomoya dessus pendant plusieurs centaines de mètres après lesquels il fut de nouveau coupé."
                            }
                        ]
                    }
