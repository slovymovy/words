                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd6242f3-dcf0-4d8a-9f1a-ee65bc2ace86",
                                "sense_id": "980159aa-a7b2-3d8a-bd1d-4adc1eb485f3",
                                "text": "Die auftretenden Engpässe im Dienstleistungsgeschäft sind oft situationsbedingt und zeitlich begrenzt."
                            },
                            {
                                "example_id": "05f2e2af-e9ac-474f-8655-5227d3b26a79",
                                "sense_id": "980159aa-a7b2-3d8a-bd1d-4adc1eb485f3",
                                "text": "„Deshalb wird vielfach eine Differenzierung verwendet, die beispielsweise in situationsbedingte, strukturelle und netzwerkartige Korruption untergliedert.“"
                            }
                        ],
