                                        "glosses": [
                                            "An acute, severe, intermittent pain that radiates along a nerve."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "619412e0-5d99-3a05-a7e2-2abd6fb98ce4",
                                        "entry_id": "bdcccb83-d8a7-31ac-ab27-3bbe77fde060",
                                        "glosses": [
                                            "Acute emotional distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f67bc13-a474-497a-b2ec-7b5145947a8c",
                                                "sense_id": "619412e0-5d99-3a05-a7e2-2abd6fb98ce4",
                                                "text": "A century later, the UK’s post-Brexit dispute with Brussels about Northern Ireland’s trading arrangements with the EU has stirred the same neuralgia."
                                            },
                                            {
                                                "example_id": "dbe5b921-ace2-4657-8b33-45d3edccbf23",
                                                "sense_id": "619412e0-5d99-3a05-a7e2-2abd6fb98ce4",
                                                "text": "Ukrainian strikes on legitimate military targets far in the Russian rear continue to be points of neuralgia for the Russian milblogger community."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3f274fe-00a3-42ec-ba77-dd2c3db35edf",
                        "source_entry_id": "f3f90f6d-121c-3b41-85e9-47ffedc43e0e",
                        "source_sense_id": "e4009d1b-7066-3153-b59a-a17cbeefa463",
                        "source_sense_description": "Schmerzen im Bereich sensibler Nerven",
                        "target_lang_word": "névralgie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "névralgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a377a4c-f1ed-31b5-896d-1bbc0cd243b8",
                                        "entry_id": "b373b58c-3d7e-3488-a89a-d208640517c4",
                                        "glosses": [
                                            "Douleur spontanée ou continue, siégeant sur le trajet des nerfs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91053620-7b07-4eec-95f1-8266b88c0843",
                                                "sense_id": "7a377a4c-f1ed-31b5-896d-1bbc0cd243b8",
                                                "text": "Névralgie frontale, maxillaire, faciale ou de la face, etc."
                                            },
                                            {
                                                "example_id": "14f16b28-1aed-4e28-baeb-652e611c8fb5",
                                                "sense_id": "7a377a4c-f1ed-31b5-896d-1bbc0cd243b8",
                                                "text": "C’est une hernie molle créant une névralgie cervicobrachiale uniradiculaire."
                                            },
                                            {
                                                "example_id": "328d68f3-99ed-4241-8de2-59ce9025bd1f",
                                                "sense_id": "7a377a4c-f1ed-31b5-896d-1bbc0cd243b8",
                                                "text": "Les névroses idiopathiques de la vie de relation, dont le siége peut être dans les expansions ou les cordons nerveux, sont également précédées de phlegmasies, lorsque l’inflammation, en ramollissant les tissus, a exalté la sensibilité, au point de développer des névralgies, des mouvemens convulsifs, des paralysies, a augmenté, diminué ou aboli l’irritabilité des expansions vasculo-nerveuses qui forment les sens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
