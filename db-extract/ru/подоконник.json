                                                "text": "Es ist kein Stuhl mehr frei, setz dich doch aufs Fensterbrett."
                                            },
                                            {
                                                "example_id": "248fc305-39ee-41ed-9a17-07cfe0ed4f33",
                                                "sense_id": "1c586ec8-ddca-3f0c-9897-f2ccc1a9d2ac",
                                                "text": "Die Wandintarsien und Fensterbretter aus Marmor trugen zum imposanten Eindruck des Empfangsaales bei."
                                            },
                                            {
                                                "example_id": "498e614e-7244-4861-a0b8-19a87da94b39",
                                                "sense_id": "1c586ec8-ddca-3f0c-9897-f2ccc1a9d2ac",
                                                "text": "„Dann begriff er auf einmal die ganze freudige Bedeutung dieses Geschreis, die Tränen wollten ihn ersticken, er stützte sich mit beiden Ellbogen auf das Fensterbrett und weinte schluchzend vor sich hin, wie Kinder es tun.“"
                                            },
                                            {
                                                "example_id": "0014b0a4-3373-4ab3-8899-be871970973a",
                                                "sense_id": "1c586ec8-ddca-3f0c-9897-f2ccc1a9d2ac",
                                                "text": "„Ich stellte sie auf das Fensterbrett und betrachtete sie im schwindenden Licht.“"
                                            },
                                            {
                                                "example_id": "ca9759f3-7b09-4307-a07b-6f9e86f1912d",
                                                "sense_id": "1c586ec8-ddca-3f0c-9897-f2ccc1a9d2ac",
                                                "text": "„Über dem Fensterbrett konnte ich von meinem Kissen aus gerade noch ein Stük Rathausdach sehen, schwer verhüllt in Schnee.“"
                                            },
                                            {
                                                "example_id": "af9561e1-8dce-4867-9ccd-b4b8119f7f17",
                                                "sense_id": "1c586ec8-ddca-3f0c-9897-f2ccc1a9d2ac",
                                                "text": "„Auf dem Fensterbrett zwitscherte ein früher Vogel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b65e10f4-4aa7-4fc9-99cc-4bd4500b3b75",
                        "source_entry_id": "b2cc9bdd-07ab-3b7f-882a-c689d8ce4fe5",
                        "source_sense_id": "4b88c41b-2ee8-3d5b-9a1b-d9bbb9d0bf55",
                        "target_lang_word": "Fensterbank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fensterbank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9aa30a6-cf13-3093-993e-f04d96188885",
                                        "entry_id": "7734c04c-ccd9-3423-9e8e-8964aac1c5c1",
                                        "glosses": [
                                            "die Ablage vor einem Fenster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46546d18-8fb5-4060-8e0f-647a4153654e",
                                                "sense_id": "e9aa30a6-cf13-3093-993e-f04d96188885",
                                                "text": "Auf meiner Fensterbank stehen mehrere Kakteen."
                                            },
                                            {
                                                "example_id": "f4067eb6-9a95-4131-b130-2caee1d42195",
                                                "sense_id": "e9aa30a6-cf13-3093-993e-f04d96188885",
                                                "text": "Unter der Fensterbank ist meistens ein Heizkörper."
                                            },
                                            {
                                                "example_id": "6f73cd35-eea1-4b8a-ac17-e7c7722ca9c2",
                                                "sense_id": "e9aa30a6-cf13-3093-993e-f04d96188885",
                                                "text": "„Roman und Cesar stiegen über die Fensterbank auf den Hof des Sattlermeisters und traten in den Stall.“"
                                            },
                                            {
                                                "example_id": "a632377c-0884-4f00-9782-0eb9ed752910",
                                                "sense_id": "e9aa30a6-cf13-3093-993e-f04d96188885",
                                                "text": "„Auf der Fensterbank lagen die Bilder, die ich als letzte gemalt hatte.“"
                                            },
                                            {
                                                "example_id": "0e4035d4-7d73-41e6-aca0-9ebbb6bca0b7",
                                                "sense_id": "e9aa30a6-cf13-3093-993e-f04d96188885",
                                                "text": "„Reuter hob seinen eingewickelten Fuß vorsichtig von der Fensterbank und setzte ihn vor sich hin.“"
                                            },
                                            {
                                                "example_id": "4c4e6771-5c78-465f-855b-8f0a75125b52",
                                                "sense_id": "e9aa30a6-cf13-3093-993e-f04d96188885",
                                                "text": "[…] „Petersilie ist pflegeleicht und wächst auch auf dem Balkon oder der Fensterbank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
