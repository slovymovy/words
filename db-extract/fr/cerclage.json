            {
                "entry_id": "aa5cbd89-798c-362c-8520-f5c5172dd177",
                "word": "cerclage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3d6d8fb-4848-4050-b493-b7af57457436",
                        "entry_id": "aa5cbd89-798c-362c-8520-f5c5172dd177",
                        "tags": [
