                        "tags": [],
                        "examples": [
                            {
                                "example_id": "679b65ee-ee68-4b48-a3d4-02f6bf689eff",
                                "sense_id": "d0b2c2d4-a87b-3ca7-b069-60878028afdc",
                                "text": "Се мысль, побудившая меня начертать, что читать будешь."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d5013f1-0168-3194-b308-5c1b12e7741c",
                        "entry_id": "aa266a11-dc96-3d7a-b3d0-d0a899f0aa6c",
                        "glosses": [
                            "перен. высок. указать, определить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13b87e15-c3f9-4be2-be3e-a6472ef90dfa",
                                "sense_id": "0d5013f1-0168-3194-b308-5c1b12e7741c",
                                "text": "На рабочих столах и во всемирной паутине громоздятся дорожные карты, на которых начертан наш славный путь в светлое цифровое будущее."
                            }
                        ]
                    }
