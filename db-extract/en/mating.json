                                                "sense_id": "e52a4297-6a05-3c21-af64-b19e46f1b297",
                                                "text": "Ce cheval, cet étalon a fait la monte."
                                            },
                                            {
                                                "example_id": "fafde968-3881-4ea9-aaa1-c8f5297e6043",
                                                "sense_id": "e52a4297-6a05-3c21-af64-b19e46f1b297",
                                                "text": "La monte commence en février et finit en juin."
                                            },
                                            {
                                                "example_id": "d1c095cb-c873-46a8-bb25-d1d337990428",
                                                "sense_id": "e52a4297-6a05-3c21-af64-b19e46f1b297",
                                                "text": "Pour que la fécondité soit plus élevée, les canards ne se reproduisent pas par monte naturelle mais par insémination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57aaa4aa-d6c3-328e-975e-fa885eabc8f4",
                                        "entry_id": "c81a1664-199d-3d28-b171-0de57967e552",
                                        "glosses": [
                                            "Action de monter un cheval dans une course, manière dont un jockey mène un cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edaff34b-7546-4622-a751-006bb38d5aff",
                                                "sense_id": "57aaa4aa-d6c3-328e-975e-fa885eabc8f4",
                                                "text": "Ce représentant de Christophe Ferland bénéficie de la monte de Maxime Guyon et a démontré qu’il pouvait lutter pour les premières places en valeur 40, pris à ce poids il est en effet monté sur le podium 3 fois en 4 sorties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1212917d-87e6-35ce-bb43-35e2cab37041",
                                        "entry_id": "c81a1664-199d-3d28-b171-0de57967e552",
                                        "glosses": [
                                            "Trot monté."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f387c5-5d3e-4a82-bdaa-a32a75127ebe",
                                                "sense_id": "1212917d-87e6-35ce-bb43-35e2cab37041",
                                                "text": "Ce cheval débute à la monte après avoir fait ses preuves à l’attelé."
                                            }
                                        ]
                                    }
                                ]
                            },
