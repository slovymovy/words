                            },
                            {
                                "target_word": "fringe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c0a80ec-a5ab-3408-8662-255570a4134d",
                                        "entry_id": "cbc0309c-f87e-3e7d-b83f-78b7a2bc6ef2",
                                        "glosses": [
                                            "Outside the mainstream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66344795-bd3c-49d9-bb7e-e6a053b4897d",
                                                "sense_id": "6c0a80ec-a5ab-3408-8662-255570a4134d",
                                                "text": "So was the cellist Charlotte Moorman, muse to Nam June Paik and proactivist champion of all things fringe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fringe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e152b4b-7978-3a11-b45a-b5ea925773d4",
                                        "entry_id": "01e4abba-6a67-3063-850d-f0c84c596448",
                                        "glosses": [
                                            "To decorate with fringe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a918e523-71ef-4e5c-9202-48bc761ff26d",
                                                "sense_id": "8e152b4b-7978-3a11-b45a-b5ea925773d4",
                                                "text": "[Y]onder cloud / That rises upward always higher, / ⁠And onward drags a labouring breast, / ⁠And topples round the dreary west, / A looming bastion fringed with fire."
                                            },
                                            {
                                                "example_id": "4dae0dc4-b09f-4d50-85de-4ba0824f06da",
                                                "sense_id": "8e152b4b-7978-3a11-b45a-b5ea925773d4",
                                                "text": "Presently she saw the King's palace. Pillars of ice held up the roof fringed with icicles, which would have sparkled splendidly if there had been any sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "427a6ccd-902e-3d39-b2d1-d3db46011b5e",
                                        "entry_id": "01e4abba-6a67-3063-850d-f0c84c596448",
                                        "glosses": [
                                            "To serve as a fringe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c2e4e15-460d-4ed8-b581-35eff1ec630c",
                                                "sense_id": "427a6ccd-902e-3d39-b2d1-d3db46011b5e",
                                                "text": "Purple bonnets fringed soft, pink, querulous faces on pillows in bath chairs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
