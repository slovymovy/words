                ],
                "senses": [
                    {
                        "sense_id": "b1f1861b-241a-31f6-a0a6-c006e9b8a645",
                        "entry_id": "291068fa-e88f-3a4c-b3ec-e69c944471bf",
                        "glosses": [
                            "Dativ Singular Maskulin des Demonstrativpronomens derjenige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b428f6a3-b11d-4811-a119-2f0394fd0f8e",
                                "sense_id": "b1f1861b-241a-31f6-a0a6-c006e9b8a645",
                                "text": "„Dieser König hatte seine Tochter demjenigen Wettkämpfer versprochen, der ihn und seine Söhne im Bogenschießen übertreffen würde.“"
                            },
                            {
                                "example_id": "439f662c-86b7-45bc-bfee-4b706ddd3ae2",
                                "sense_id": "b1f1861b-241a-31f6-a0a6-c006e9b8a645",
                                "text": "„Ihre Loyalität lag eher bei demjenigen, der sie rekrutiert hatte, als bei der militärischen Kommandostruktur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "567588c6-d4db-3c19-9905-91dcb8845c6c",
                        "entry_id": "291068fa-e88f-3a4c-b3ec-e69c944471bf",
                        "glosses": [
                            "Dativ Singular Neutrum des Demonstrativpronomens derjenige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c601620-fcaa-48e1-a224-c21f6ca676ab",
                                "sense_id": "567588c6-d4db-3c19-9905-91dcb8845c6c",
                                "text": "„Ich verstand die stumme Mahnung und nähte die beiden Herzen mit der roten Seide auf das Papier; aber ich hielt es mit demjenigen, das zwischen dem Tännchen und dem Rosenstrauch auf dem grünen Rasen stehenblieb.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
