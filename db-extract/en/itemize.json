                                "target_senses": [
                                    {
                                        "sense_id": "0144fed1-11b9-361e-8c94-45068dae073d",
                                        "entry_id": "1631f4c7-b994-326e-90da-69daca198da9",
                                        "glosses": [
                                            "eine Materie nach bestimmten Kriterien aufteilen"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2436421e-5ecb-448b-965a-d29b16fedfe6",
                                                "sense_id": "0144fed1-11b9-361e-8c94-45068dae073d",
                                                "text": "Die Verben kann man in starke, schwache und unregelmäßige Verben aufgliedern."
                                            },
                                            {
                                                "example_id": "b81ea7b9-f09f-4c25-96bf-eef4a3cbde84",
                                                "sense_id": "0144fed1-11b9-361e-8c94-45068dae073d",
                                                "text": "Zu diesem Zeitpunkt hatte sich die ursprünglich homogene Sprache, mit der die Indogermanen ihre lange Wanderung begonnen hatten, in eine Vielzahl von Dialekten und nachfolgend von Sprachen aufgegliedert und sich immer weiter differenziert."
                                            },
                                            {
                                                "example_id": "639ed571-7945-4374-993c-103fbdbc1ca5",
                                                "sense_id": "0144fed1-11b9-361e-8c94-45068dae073d",
                                                "text": "Die Anwendung besitzt Eingabefelder für das Firmenkredit-Exposure einer Sparkasse, aufgegliedert nach Branchen anhand der Segmentierungsebenen für Firmenkunden in Anlehnung an die CPV-Standard-Gliederung (siehe Abbildung 5)."
                                            },
                                            {
                                                "example_id": "f2565d0e-ff4b-4764-93eb-ca174cebae41",
                                                "sense_id": "0144fed1-11b9-361e-8c94-45068dae073d",
                                                "text": "Die Klasse (auch lateinisch: classis) kann bei Bedarf noch in Unterklassen (subclassis) aufgegliedert werden, diese Gliederung ist aber optional."
                                            },
                                            {
                                                "example_id": "c0151054-0a92-4459-9141-566e77e25edc",
                                                "sense_id": "0144fed1-11b9-361e-8c94-45068dae073d",
                                                "text": "Der von der Richtlinie vorgesehene Planungsprozess lässt sich in verschiedene Phasen aufgliedern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "498485bf-233e-4f54-a159-fb624431d787",
