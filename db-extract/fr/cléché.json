                        "entry_id": "35e28bc6-b962-3995-8a6a-13dc3916d583",
                        "glosses": [
                            "Se dit d’une pièce ouverte à jour qui laisse voir le champ de l’écu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d24a6dd-0f0d-4dcf-a5a4-cc53111b3a0c",
                                "sense_id": "cad01519-3512-3075-b576-fab8530ab49b",
                                "text": "J’avais trop affaire d’esquiver la machine roulante pour voir si elle était historiée de lions léopardés ou issants, d’alérions ou de merlettes, de besans ou de tourteaux, de croix cléchées ou vivrées, ou de tous autres emblèmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "2368a37b-ca57-3e61-8a72-0fab3b4d4408",
                        "entry_id": "35e28bc6-b962-3995-8a6a-13dc3916d583",
                        "glosses": [
                            "Se dit d’une croix dont les branches se finissent par des anneaux, tels ceux d’une clé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733792a1-51e8-45c4-9aa0-05d03b8d0e19",
                                "sense_id": "2368a37b-ca57-3e61-8a72-0fab3b4d4408",
                                "text": "Croix cléchée. Se dit des arrondissements de la croix de Toulouse, dont les quatre extrémités ont la forme des anneaux des clés."
                            }
                        ]
                    }
