            "senses": [
                {
                    "sense_id": "32f37a4a-89bc-3f0c-b20b-20ad940660fa",
                    "sense_definition": "urządzenie służące do oświetlania pomieszczeń lub miejsc pracy",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "oświetlenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wieczorem włączam <w>lampę</w> na biurku, żeby lepiej widzieć tekst."
                        },
                        {
                            "text": "Nowoczesna <w>lampa</w> sufitowa daje bardzo jasne światło w całym pokoju."
                        }
                    ],
                    "synonyms": [
                        "latarnia"
                    ],
                    "common_phrases": [
                        "włączyć lampę",
                        "zgaszona lampa"
                    ]
                },
                {
                    "sense_id": "4903316b-6aca-332c-a568-c22ca815531f",
                    "sense_definition": "urządzenie emitujące światło za pomocą spalania paliwa lub energii elektrycznej",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "oświetlenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach <w>lampa</w> naftowa była głównym źródłem światła w domu."
                        },
                        {
                            "text": "Podczas wycieczki w góry zabraliśmy ze sobą mocną <w>lampę</w> turystyczną."
                        }
                    ],
                    "common_phrases": [
                        "lampa naftowa"
                    ]
                },
                {
                    "sense_id": "f5cf42fa-f377-33ec-b9c5-eca65f5feec1",
