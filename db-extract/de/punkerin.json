                "senses": [
                    {
                        "sense_id": "0c19d7ba-6284-3a4d-931e-41fce07bde54",
                        "entry_id": "ee094f71-c672-3696-9c1f-e31c9ead136a",
                        "glosses": [
                            "Angehörige der Subkultur des Punks, die bewusst die Wertvorstellungen der bürgerlichen Gesellschaft ablehnt und durch provozierendes Aussehen und rebellisches Verhalten auffällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba980627-19f7-46a9-a8bb-60fa31533b1b",
                                "sense_id": "0c19d7ba-6284-3a4d-931e-41fce07bde54",
                                "text": "In ihrer Zeit als Punkerin trug sie natürlich so wie alle ihre Freundinnen Irokesenschnitt und Sicherheitsnadeln in Jeans und Ohren."
                            },
                            {
                                "example_id": "46fe1942-6aeb-4436-9e43-deb361e1b767",
                                "sense_id": "0c19d7ba-6284-3a4d-931e-41fce07bde54",
                                "text": "„Azhar wandte sich an die Älteste von ihnen, eine junge Frau mit unreiner Haut und so viel Gel im Haar, dass es stachlig abstand wie bei einer Punkerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
