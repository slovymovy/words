                            }
                        },
                        {
                            "text": "He spent the whole afternoon <w>chopping</w> wood for the fireplace.",
                            "target_lang_translations": {
                                "nl": "Hij bracht de hele middag door met het <w>hakken</w> van hout voor de open haard."
