                                    },
                                    {
                                        "sense_id": "d71f3f30-0fab-35fa-a62d-5058c1b8cf43",
                                        "entry_id": "cf5cbff9-7067-3bae-a59a-a5480b07aea7",
                                        "glosses": [
                                            "Convertir, un peuple, une communauté ou un individu à la religion islamique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf961b0-3d28-4c2f-a128-7aa41239226b",
                                                "sense_id": "d71f3f30-0fab-35fa-a62d-5058c1b8cf43",
                                                "text": "Les pires craintes des partisans de la Charte des valeurs se sont concrétisées ce matin : quarante-huit heures après la défaite du Parti québécois, des millions de fondamentalistes radicaux ont atterri à Dorval afin d’islamiser la province en construisant des minarets de Gaspé à Gatineau et en forçant toutes les femmes à porter le voile sous peine de coups de fouet."
                                            },
                                            {
                                                "example_id": "c3082296-4494-456c-a321-2c72af03502e",
                                                "sense_id": "d71f3f30-0fab-35fa-a62d-5058c1b8cf43",
                                                "text": "Le rap s’africanise, se « maghrébise », s’islamise en s’enferrant dans une contradiction existentielle : faire disparaître la réalité qui constitue le corollaire de son identité."
                                            },
                                            {
                                                "example_id": "41d98882-54a6-4f1b-8b14-02d1820ea3b3",
                                                "sense_id": "d71f3f30-0fab-35fa-a62d-5058c1b8cf43",
                                                "text": "La rage d’Erdogan à islamiser la Turquie touche les programmes scolaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2e22a62-337c-4787-aa9f-e535857a8cff",
                        "source_entry_id": "f883520b-52f1-3bbb-bf7e-af2ae463e0f6",
                        "source_sense_description": "convert to Islam",
                        "target_lang_word": "islamisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
