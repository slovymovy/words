                ],
                "senses": [
                    {
                        "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                        "entry_id": "b99ffef2-15ac-35f1-8580-483e18bc0dbf",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0defe9e4-9a20-41e5-9eaa-fd74f5d210da",
                                "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                                "text": "Frau Stäble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "db758f35-a5aa-4568-a1ca-53d6cd2ae08c",
                                "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                                "text": "Herr Stäble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "64fb3c30-b6fd-4d91-a958-4116cd45a8d3",
                                "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                                "text": "Die Stäbles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b7739452-2de9-4934-9f70-4859865e593e",
                                "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                                "text": "Der Stäble trägt nie die Schals, die die Stäble ihm strickt."
                            },
                            {
                                "example_id": "8475a155-d7f2-48b7-8765-ed07cd933154",
                                "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stäble kommt, geht der Herr Stäble.“"
                            },
                            {
                                "example_id": "a651c0cf-7ebc-48ec-aeb2-6a94e087f6e7",
                                "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                                "text": "Stäble kommt und geht."
                            },
                            {
                                "example_id": "f1384b20-a059-4ab0-b8f5-b282411daf76",
                                "sense_id": "0afc355d-d7d6-35e3-80fc-aaac97a63fa0",
                                "text": "Stäbles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
