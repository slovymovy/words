{
    "word_family": [
        "condemnation",
        "condemnatory",
        "condemnable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b677a04-7c61-3c92-8d7c-57c0f46f244d",
                    "sense_definition": "Simple past and past participle of <w>condemn</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge <w>condemned</w> the criminal to ten years in prison for his crimes.",
                            "target_lang_translations": {
                                "ru": "Судья <w>приговорил</w> преступника к десяти годам тюрьмы за его преступления.",
                                "de": "Der Richter <w>verurteilte</w> den Kriminellen für seine Verbrechen zu zehn Jahren Haft."
                            }
                        },
                        {
                            "text": "Politicians from all sides <w>condemned</w> the violence that occurred at the protest.",
                            "target_lang_translations": {
                                "ru": "Политики со всех сторон <w>осудили</w> насилие, произошедшее во время протеста.",
                                "de": "Politiker aller Seiten <w>verurteilten</w> die Gewalt, die bei dem Protest auftrat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола condemn.",
                        "de": "Vergangenheitsform und Partizip Perfekt von verurteilen oder verdammen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осудил",
                                "target_lang_sense_clarification": "выразил неодобрение"
                            },
                            {
                                "target_lang_word": "приговорил",
                                "target_lang_sense_clarification": "вынес приговор"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verurteilte",
                                "target_lang_sense_clarification": "juristisch zu einer Strafe verurteilt"
                            },
                            {
                                "target_lang_word": "verurteilten",
                                "target_lang_sense_clarification": "juristisch zu einer Strafe verurteilt (Plural/Partizip)"
                            },
                            {
                                "target_lang_word": "verurteilte",
                                "target_lang_sense_clarification": "öffentlich missbilligte oder kritisierte"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fb7b754e-bff3-35f6-a359-effd451187ba",
                    "sense_definition": "Adjudged or sentenced to severe punishment, especially death.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>condemned</w> prisoner was allowed to write a final letter to his family.",
                            "target_lang_translations": {
                                "ru": "<w>Приговорённому</w> заключённому разрешили написать прощальное письмо семье.",
                                "de": "Dem <w>zum Tode verurteilten</w> Gefangenen wurde erlaubt, einen letzten Brief an seine Familie zu schreiben."
                            }
                        },
                        {
                            "text": "Guards kept a close watch on the <w>condemned</w> man in his cell.",
                            "target_lang_translations": {
                                "ru": "Охранники внимательно следили за <w>приговорённым</w> в его камере.",
                                "de": "Wachen behielten den <w>zum Tode verurteilten</w> Mann in seiner Zelle genau im Auge."
                            }
                        }
                    ],
                    "common_phrases": [
                        "condemned cell",
                        "condemned prisoner",
                        "condemned man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признанный виновным и приговорённый к суровому наказанию, особенно к смертной казни.",
                        "de": "Zu einer schweren Strafe, insbesondere zum Tode, verurteilt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приговорённый",
                                "target_lang_sense_clarification": "осуждённый на наказание"
                            },
                            {
                                "target_lang_word": "осуждённый",
                                "target_lang_sense_clarification": "признанный виновным"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zum Tode verurteilt",
                                "target_lang_sense_clarification": "jemand, der die Todesstrafe erhalten hat"
                            },
                            {
                                "target_lang_word": "verurteilt",
                                "target_lang_sense_clarification": "allgemein zu einer Strafe verurteilt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb4d6df3-d7ed-3eed-a372-cbbbfd59c147",
                    "sense_definition": "Officially marked as unsafe or unfit for use or habitation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council decided to tear down the <w>condemned</w> building due to safety concerns.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил снести <w>аварийное</w> здание из соображений безопасности.",
                                "de": "Der Stadtrat beschloss, das <w>abrissreife</w> Gebäude aus Sicherheitsgründen abzureißen."
                            }
                        },
                        {
                            "text": "They were warned not to enter the <w>condemned</w> house because the roof might collapse.",
                            "target_lang_translations": {
                                "ru": "Их предупредили не входить в <w>аварийный</w> дом, так как крыша могла обрушиться.",
                                "de": "Sie wurden gewarnt, das <w>gesperrte</w> Haus nicht zu betreten, da das Dach einstürzen könnte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "condemned building",
                        "condemned house",
                        "condemned property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально признанный небезопасным или непригодным для использования или проживания.",
                        "de": "Offiziell als unsicher oder unbewohnbar eingestuft."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аварийный",
                                "target_lang_sense_clarification": "о здании или жилье"
                            },
                            {
                                "target_lang_word": "предназначенный на снос",
                                "target_lang_sense_clarification": "подлежащий сносу"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "abrissreif",
                                "target_lang_sense_clarification": "ein Gebäude, das abgerissen werden muss"
                            },
                            {
                                "target_lang_word": "gesperrt",
                                "target_lang_sense_clarification": "ein Gebäude, das aus Sicherheitsgründen nicht betreten werden darf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01ffcbbd-cdb5-34bf-95c5-2289ee9aede8",
                    "sense_definition": "Having been sharply scolded or judged unfavorably.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The widely <w>condemned</w> policy was eventually reversed by the government.",
                            "target_lang_translations": {
                                "ru": "Широко <w>осуждаемая</w> политика была в конечном итоге отменена правительством.",
                                "de": "Die weithin <w>verurteilte</w> Politik wurde schließlich von der Regierung rückgängig gemacht."
                            }
                        },
                        {
                            "text": "His <w>condemned</w> behavior at the dinner party left everyone feeling uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Его <w>порицаемое</w> поведение на званом ужине заставило всех чувствовать себя неловко.",
                                "de": "Sein <w>missbilligtes</w> Verhalten auf der Dinnerparty ließ alle sich unwohl fühlen."
                            }
                        }
