        "fr-extract.jsonl": [
            {
                "entry_id": "3177986d-ce14-3629-ba05-b697cad1fd4f",
                "word": "fronce",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "67ad4de9-5288-4c7a-8d4d-839a682ba925",
                        "entry_id": "3177986d-ce14-3629-ba05-b697cad1fd4f",
                        "tags": [
                            "plural"
                        ],
                        "form": "fronces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                        "entry_id": "3177986d-ce14-3629-ba05-b697cad1fd4f",
                        "glosses": [
                            "Pli menu et serré que l’on fait à l’étoffe d’un vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e133c3fc-efd4-496d-bbee-a2b74c9b4022",
                                "sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                                "text": "Pourquoi ces fronces, qui étriquaient le vêtement ? et celui-ci, carré des épaules, ne l’aurait-on pas dit taillé à coups de hache ?"
                            },
                            {
                                "example_id": "3acf201b-5029-491c-9d9c-c83aa8e19877",
                                "sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                                "text": "Telcide se réveille en sursaut. Tenant avant tout à la correction, elle remet, exactement au centre de sa poitrine plate, son crucifix d’argent et cherche, dans les multiples fronces de sa jupe, celle de ses innombrables poches qui contient son mouchoir."
                            },
                            {
                                "example_id": "5c4e7a76-9633-42fb-b5e5-988344a674ae",
                                "sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                                "text": "[…] d’ailleurs, pour ce qu’elle était chic, cette robe, toute verte, avec tant de fronces à la taille que Carmen avait l’air d’un gros chou […]"
                            },
                            {
                                "example_id": "e4b101d6-8bb5-48bc-85fe-1e0d2de5cdde",
                                "sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                                "text": "La traîne de la longue robe d’intérieur la suivait, une robe qui avait des manches bouffantes et dont la jupe faisait tant de fronces autour de la taille que celle-ci paraissait fine à se casser."
                            },
                            {
                                "example_id": "0ef3c56b-c647-489b-935f-6b76188c4edc",
                                "sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                                "text": "Les godets froncés, par contre, seront choisis de préférence aux deux autres quand on désirera beaucoup d'ampleur d'un côté et un léger « gonflant » donné par quelques fronces, […]."
                            },
                            {
                                "example_id": "2bdc26d3-6313-4ff7-a1c5-2c0103708c7d",
                                "sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                                "text": "Cette révélation ne fut pas sans conséquence : dorénavant, je décidai qu'une femme ne m'aimait pas si elle me refusait ce petit cratère étoilé dont je caressais délicatement les fronces lors de mes premières approches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71d0be47-2597-4f63-9876-b1f8bf0e896a",
                        "source_entry_id": "3177986d-ce14-3629-ba05-b697cad1fd4f",
                        "source_sense_id": "11c70380-cda2-3bf5-92e5-106c549e0f54",
                        "target_lang_word": "wrinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cc6495b-f2b0-3a03-8397-7aef0bf1b238",
                                        "entry_id": "5deb9239-6bf0-3311-9784-db1e5af98934",
                                        "glosses": [
                                            "A small furrow, ridge or crease in an otherwise smooth surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad087dd5-0fb7-3950-9f20-0d559317ea9f",
                                        "entry_id": "5deb9239-6bf0-3311-9784-db1e5af98934",
                                        "glosses": [
                                            "A line or crease in the skin, especially when caused by age or fatigue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "460a7f2d-13c5-45e7-992c-7a25539bcc12",
                                                "sense_id": "ad087dd5-0fb7-3950-9f20-0d559317ea9f",
                                                "text": "Spending time out in the sun may cause you to develop wrinkles sooner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fa451c3-c070-30e4-9c9c-b96babf7752a",
                                        "entry_id": "5deb9239-6bf0-3311-9784-db1e5af98934",
                                        "glosses": [
                                            "A fault, imperfection or bug especially in a new system or product; typically, they will need to be ironed out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4e4161-bddb-4a2b-a46e-aa0d34b1d6d8",
                                                "sense_id": "1fa451c3-c070-30e4-9c9c-b96babf7752a",
                                                "text": "Three months later, we're still discovering new wrinkles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c65062-7b5e-36a2-ae4e-ebec2915d103",
                                        "entry_id": "5deb9239-6bf0-3311-9784-db1e5af98934",
                                        "glosses": [
                                            "A twist on something existing; a novel difference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d89719e-896d-46cb-9834-f19017094b64",
                                                "sense_id": "29c65062-7b5e-36a2-ae4e-ebec2915d103",
                                                "text": "There were now a grab bag of southern country-rock units with a new wrinkle—Black Oak Arkansas, for one, combined psychedelia, fifties rock, Hindu spiritualism, and gospel into “psycho-boogie,” or “raunch 'n' roll.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wrinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86ead98e-76b7-3698-a55f-c2706168fecd",
                                        "entry_id": "3b5a58ab-89f4-33e8-a9be-1f0ac8e9b5ea",
                                        "glosses": [
                                            "To make wrinkles in; to cause to have wrinkles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ceef45d-653c-4263-91df-44d68e1b375b",
                                                "sense_id": "86ead98e-76b7-3698-a55f-c2706168fecd",
                                                "text": "Be careful not to wrinkle your dress before we arrive."
                                            },
                                            {
                                                "example_id": "ddf1ee1a-5e64-4c89-83f7-a426d675166f",
                                                "sense_id": "86ead98e-76b7-3698-a55f-c2706168fecd",
                                                "text": "her wrinkled form in black and white array'd"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd7c1cd6-4208-3935-ad93-aaf322277526",
                                        "entry_id": "3b5a58ab-89f4-33e8-a9be-1f0ac8e9b5ea",
                                        "glosses": [
                                            "To pucker or become uneven or irregular."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4e954f9-a52a-4651-81b3-ab0baca63014",
                                                "sense_id": "cd7c1cd6-4208-3935-ad93-aaf322277526",
                                                "text": "An hour in the tub will cause your fingers to wrinkle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e91d3f2-f5da-3fd6-bb57-13a37d84de91",
                                        "entry_id": "3b5a58ab-89f4-33e8-a9be-1f0ac8e9b5ea",
                                        "glosses": [
                                            "To develop irreversibly wrinkles; to age."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c436f1b4-d540-452d-b358-f63edc1238b2",
                                                "sense_id": "2e91d3f2-f5da-3fd6-bb57-13a37d84de91",
                                                "text": "The skin is the substance that wrinkles, shows age, stretches, scars and cuts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae06f1ff-f67e-33fd-b678-bb3f0ec8f4a8",
                                        "entry_id": "3b5a58ab-89f4-33e8-a9be-1f0ac8e9b5ea",
                                        "glosses": [
                                            "To sneer (at)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "477370fa-7920-4a28-a272-399627203fa6",
                                                "sense_id": "ae06f1ff-f67e-33fd-b678-bb3f0ec8f4a8",
                                                "text": "Ther's some weakenes in your brother you wrinkle at"
                                            }
                                        ]
                                    }
                                ]
