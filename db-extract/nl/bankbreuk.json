                                "target_senses": [
                                    {
                                        "sense_id": "d36deb92-8bcb-381f-b998-8942f529da83",
                                        "entry_id": "7659076e-b1e0-3227-812b-4535194586b5",
                                        "glosses": [
                                            "A legally declared or recognized condition of insolvency of a person or organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58f610ec-df5e-4e3a-88cc-70f9648ec685",
                                                "sense_id": "d36deb92-8bcb-381f-b998-8942f529da83",
                                                "text": "The company ended up filing for bankruptcy."
                                            },
                                            {
                                                "example_id": "16060d33-16a0-4c62-a1b2-db8044ea5f6a",
                                                "sense_id": "d36deb92-8bcb-381f-b998-8942f529da83",
                                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                                            },
                                            {
                                                "example_id": "839d65ef-1f02-416f-beaf-48dedd3a5a0f",
                                                "sense_id": "d36deb92-8bcb-381f-b998-8942f529da83",
                                                "text": "[T]he form of and redress for defamation are, for the most part, gendered. Imputations of bankruptcy, for example, which could have damaged a merchant and thus were actionable for a man, would probably have had little effect if directed toward a woman. In contrast, allegations of whoredom—which, while occasionally leveled at men, were not usually thought to injure male reputations—were overwhelmingly cited by women in the slander suits they brought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa735053-a97e-49cc-9114-0dd7f4ea796c",
                        "source_entry_id": "af3fa3aa-39e8-37f7-b35d-3ee2ce4eb310",
                        "source_sense_id": "a1d10c0a-61dd-3f2a-92d2-41ddb562f3b0",
