                ],
                "senses": [
                    {
                        "sense_id": "bc469356-fd61-399a-a2d5-e23d4d2c8bda",
                        "entry_id": "c3c4268f-340b-3ee2-bff3-0a1bdcb4d221",
                        "glosses": [
                            "sprachliche Regel, die die lautliche Gestaltung des Auslauts der Wörter betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942e2aaf-e228-475b-8872-85df6e1569d7",
                                "sense_id": "bc469356-fd61-399a-a2d5-e23d4d2c8bda",
                                "text": "„Bestimmte Gesetze dafür (sogenannte „Auslautgesetze“) lassen sich in gewissem Umfang schon für die indogermanische Grundsprache erkennen.“"
                            },
                            {
                                "example_id": "7a51ebf0-8dfe-4926-b49c-1491d5949abb",
                                "sense_id": "bc469356-fd61-399a-a2d5-e23d4d2c8bda",
                                "text": "„Die konsonantischen Auslautgesetze sind früher wirksam geworden als die vokalischen.“"
                            },
                            {
                                "example_id": "769c6e00-2b90-4fd6-96a5-6760ef1c7d8b",
                                "sense_id": "bc469356-fd61-399a-a2d5-e23d4d2c8bda",
                                "text": "„Die Nebensilben…erliegen im 9./10. Jahrhundert der normalalthochdeutschen Vorsilbenangleichung…sowie spurenweise in der Sprechsprache seit dem 8./9. Jahrhundert in den Denkmälern i.a. seit dem 10./11. Jahrhundert der gemeinalthochdeutschen Nebensilbenabschwächung, die bei Notker von St. Gallen im Sinne eines Auslautgesetzes nach Voll- oder Schwachton und Positionen streng geregelt erscheint…und sich ins Frühmittelhochdeutsche weiterzieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
