                                "example_id": "2b652e14-100a-4a31-8064-f105bac8c08d",
                                "sense_id": "2c0123ec-4ec5-32aa-91d7-27a231ac444f",
                                "text": "Quatre vingt dix huit compaignons mariniers, qui ont vacqué chacun quatre journées aux tirotz [bateaux remorqueurs] à conduire le roy nostre sire, la royne madame, avec leur bande, de ceste ville d'Orleans jusqu'à Blois."
                            },
                            {
                                "example_id": "ca7f8e58-0944-4b4b-8df8-8cb16ebbb0b9",
                                "sense_id": "2c0123ec-4ec5-32aa-91d7-27a231ac444f",
                                "text": "Marc empoignait les mancherons ; les fils, tour à tour, s’attelaient au tirot, comme des bêtes de somme."
                            }
                        ]
                    }
