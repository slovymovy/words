                                                "example_id": "41cc2ae1-c566-4d00-900e-d274411fb151",
                                                "sense_id": "740c5cee-c5e8-31b8-b54e-75f862a5e84a",
                                                "text": "Da hinten ist ein hoher Berg. Darauf wollte er heute steigen."
                                            },
