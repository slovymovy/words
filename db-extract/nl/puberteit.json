                    {
                        "sense_id": "528b049e-1a05-3efc-8a4d-e2920d3f32e8",
                        "entry_id": "32cfca73-baf5-333c-b36a-4dff35603a4e",
                        "glosses": [
                            "het proces van seksuele rijping van kind naar volwassene en het gedrag dat daar bij hoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15dbb9f5-c6a4-457e-b142-5d154eaf7898",
                                "sense_id": "528b049e-1a05-3efc-8a4d-e2920d3f32e8",
                                "text": "De puberteit leidt vaak tot conflicten met het ouderlijk gezag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f6ac725-57b9-405a-92d7-9f16976bb005",
                        "source_entry_id": "32cfca73-baf5-333c-b36a-4dff35603a4e",
                        "source_sense_id": "528b049e-1a05-3efc-8a4d-e2920d3f32e8",
                        "source_sense_description": "het proces van seksuele rijping van kind naar volwassene en het gedrag dat daar bij hoort",
                        "target_lang_word": "Pubertät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pubertät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                        "entry_id": "1b98145a-ecb0-3bf4-b26e-21f2e06a85d3",
                                        "glosses": [
                                            "biologische Übergangsphase des Menschen, in der der Mensch mit diversen Verhaltensweisen und körperlichen Veränderungen aus dem Kinds- zum Erwachsenenstadium wechselt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dcc5a6d-42fb-4d67-9ddb-b19b9238fbb8",
                                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                                "text": "In der Pubertät kommen die Jugendlichen auf die außergewöhnlichsten Gedanken und stellen alles in Frage."
                                            },
                                            {
                                                "example_id": "7df50769-4a43-4cdf-a68c-5fb318859a50",
                                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                                "text": "„Es naht der Zeitpunkt, da unsere Tochter in die Pubertät kommt.“"
                                            },
                                            {
                                                "example_id": "9477b59d-a78f-4685-9785-226c3393344a",
                                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                                "text": "„Die Pubertät hatte früh bei ihm eingesetzt.“"
                                            },
                                            {
                                                "example_id": "0670773f-37e6-4930-a6e4-9bef3935d174",
                                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                                "text": "„Die waren schon in der Pubertät.“"
                                            },
                                            {
                                                "example_id": "c576b119-37c4-481a-a7d2-5f901f2c5bd0",
                                                "sense_id": "5f5f2c5d-2d0f-3544-9103-1e1c4d37e398",
                                                "text": "„Was sicherlich daran liegt, dass ich meine Pubertät in Deutschland verbracht habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9e017c5-e939-4e14-8aae-5808ef5f3087",
                        "source_entry_id": "32cfca73-baf5-333c-b36a-4dff35603a4e",
