                    {
                        "sense_id": "46a5cfec-3abc-33fd-877e-e45f42a95ac6",
                        "entry_id": "cdf2fe62-ed9f-3b6e-9766-caf1272fd443",
                        "glosses": [
                            "van iets dat het een goede, mooie ligging heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ef336d-30b2-4c30-826a-5ef1422f4c37",
                                "sense_id": "46a5cfec-3abc-33fd-877e-e45f42a95ac6",
                                "text": "Dat zegt Pieter de Keuninck van camping Welgelegen in Cadzand-Bad, tevens voorzitter van Stichting De Springer. Bij deze stichting is een aantal campings aangesloten. De Keuninck reageert hiermee op pogingen van de gemeente Sluis om de toerist terug te winnen."
                            },
                            {
                                "example_id": "dda2217c-bf52-4141-8a88-de12a69b5db1",
                                "sense_id": "46a5cfec-3abc-33fd-877e-e45f42a95ac6",
                                "text": "Aan de noordzijde van de Haarlemmerhout staat het monumentale Paviljoen Welgelegen, een monument dat tijdens de Franse bezetting tijdelijk bewoond is geweest door de broer van Napoleon. Tegenwoordig vormt de Haarlemmerhout het jaarlijkse decor voor Bevrijdingspop."
                            }
                        ]
                    }
