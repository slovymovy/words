        "nl-extract.jsonl": [
            {
                "entry_id": "0a75d29f-b029-3b03-b33a-10255b3bd5c5",
                "word": "opdiepen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "30ef4353-0ff0-3c1f-bc1b-27f80ac5b03a",
                        "entry_id": "0a75d29f-b029-3b03-b33a-10255b3bd5c5",
                        "glosses": [
                            "iets uit het verborgene te voorschijn halen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f5cafcad-f74d-416f-b5e3-e0f67b6edea3",
                                "sense_id": "30ef4353-0ff0-3c1f-bc1b-27f80ac5b03a",
                                "text": "De cijfers, die De Witte en Hindriks in hun rapport opdiepen, zijn stuitend."
                            },
                            {
                                "example_id": "07bfed27-298d-4419-85a8-72498aa3fd5a",
                                "sense_id": "30ef4353-0ff0-3c1f-bc1b-27f80ac5b03a",
                                "text": "George Baker kan tal van anekdotes opdiepen. ,,Hij kon meesterlijk sterke verhalen vertellen. Hij was een gigant."
                            },
                            {
                                "example_id": "d9a39b88-4cb9-48be-906c-1c8476ca954e",
                                "sense_id": "30ef4353-0ff0-3c1f-bc1b-27f80ac5b03a",
                                "text": "Ze deed een poging om in het zwarte gat van haar geheugen beelden op te diepen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dcd27f1f-1f23-48f8-8add-9da7db7d1a24",
                        "source_entry_id": "0a75d29f-b029-3b03-b33a-10255b3bd5c5",
                        "source_sense_id": "30ef4353-0ff0-3c1f-bc1b-27f80ac5b03a",
                        "source_sense_description": "(figuurlijk) iets uit het verborgene te voorschijn halen",
