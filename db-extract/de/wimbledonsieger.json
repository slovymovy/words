                "senses": [
                    {
                        "sense_id": "e8260016-d41e-3ccc-be55-ade984fc6f23",
                        "entry_id": "cdf66841-42c3-36cb-aab8-169f09da0d72",
                        "glosses": [
                            "Person, die beim Tennisturnier in Wimbledon den Sieg errungen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f84514-9366-41e7-8ba6-e93e6f5e5665",
                                "sense_id": "e8260016-d41e-3ccc-be55-ade984fc6f23",
                                "text": "„Nur eine Woche nach dem bereits sensationellen Lauf bis ins Halbfinale der French Open hat Thiem, der mit einer 2:6-Rasenbilanz in seiner Karriere nach Stuttgart gereist war, den siebenfachen Wimbledonsieger Federer bezwungen - auf Gras.“"
                            },
                            {
                                "example_id": "da40dfb2-6959-43ea-a24e-1a4d1fbb6453",
                                "sense_id": "e8260016-d41e-3ccc-be55-ade984fc6f23",
                                "text": "„Der Wimbledonsieger Murray ist der erste Tennisspieler der Geschichte, der im Einzel zweimal die Goldmedaille gewonnen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
