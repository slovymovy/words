    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b65f4940-9034-3a6d-a979-b5febd9176ed",
                    "sense_definition": "An act of moving one's hand gently over a surface, usually as a sign of affection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_caress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave the cat a gentle <w>stroke</w>.",
                            "target_lang_translations": {
                                "ru": "Она нежно <w>погладила</w> кошку.",
                                "zh": "她轻轻地<w>抚摸</w>了那只猫。"
                            }
                        },
                        {
                            "text": "The dog wagged its tail at the <w>stroke</w> of his hand.",
                            "target_lang_translations": {
                                "ru": "Собака виляла хвостом от <w>поглаживания</w> его руки.",
                                "zh": "狗在他的<w>抚摸</w>下摇起了尾巴。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a stroke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, когда проводят рукой по поверхности, обычно в знак ласки.",
                        "zh": "用手在物体表面轻轻抚摸，通常表示喜爱或安抚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поглаживание",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抚摸",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fe5fb8f-6533-3907-8a86-11dd3f62203d",
                    "sense_definition": "A specific style of moving the arms and legs to swim.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_swimming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is learning a new swimming <w>stroke</w>.",
                            "target_lang_translations": {
                                "ru": "Она осваивает новый <w>стиль</w> плавания.",
                                "zh": "她正在学习一种新的<w>泳姿</w>。"
                            }
                        },
                        {
                            "text": "The butterfly <w>stroke</w> requires a lot of energy.",
                            "target_lang_translations": {
                                "ru": "<w>Стиль</w> баттерфляй требует много энергии.",
                                "zh": "蝶<w>泳</w>非常消耗体力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breaststroke",
                        "backstroke",
                        "butterfly stroke",
                        "freestyle stroke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный стиль движения рук и ног при плавании.",
                        "zh": "游泳时手臂和腿部运动的特定方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиль плавания",
                                "target_lang_sense_clarification": "способ плавания"
                            },
                            {
                                "target_lang_word": "гребок",
                                "target_lang_sense_clarification": "единичное движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泳姿",
                                "target_lang_sense_clarification": "游泳姿势"
                            },
                            {
                                "target_lang_word": "划水",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b2075e5-d90b-3e42-a785-b4ad34521c7d",
                    "sense_definition": "A sudden serious illness that occurs when a blood vessel in the brain bursts or is blocked, often causing loss of function.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suffered a minor <w>stroke</w> last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году он перенес микро<w>инсульт</w>.",
                                "zh": "他去年轻微<w>中风</w>过。"
                            }
                        },
                        {
                            "text": "High blood pressure increases the risk of having a <w>stroke</w>.",
                            "target_lang_translations": {
                                "ru": "Высокое кровяное давление повышает риск <w>инсульта</w>.",
                                "zh": "高血压会增加<w>中风</w>的风险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cerebrovascular accident",
                        "CVA"
                    ],
                    "common_phrases": [
                        "suffer a stroke",
                        "have a stroke",
                        "massive stroke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное серьезное заболевание, при котором нарушается кровоснабжение мозга.",
                        "zh": "因脑部血管阻塞或破裂导致的突发性严重疾病。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инсульт",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中风",
                                "target_lang_sense_clarification": "医学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d385e5c3-d229-3f6e-b906-39da396dbaff",
                    "sense_definition": "A single movement of a pen or brush, or the line made by it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted the sky with broad <w>strokes</w>.",
