                                        "entry_id": "f10d284f-2d3f-33af-86b5-6817df547d94",
                                        "glosses": [
                                            "sich auf ein Drama beziehend, das Drama (in seiner Eigenart) beschreibend, darstellend; zum Drama gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb1acfe-8232-44ba-9bdc-ee79bbc2b5b2",
                                                "sense_id": "ca1684df-2aef-3831-bdca-51cb7935a7b5",
                                                "text": "Die dramatische Aufführung zeigte die Missstände der Gesellschaft auf."
                                            },
                                            {
                                                "example_id": "fb381118-ff4b-4e2f-994d-825b41e1ad1d",
                                                "sense_id": "ca1684df-2aef-3831-bdca-51cb7935a7b5",
                                                "text": "Man konnte nur schätzen wie viel Wahrheit die dramatische Schilderung des Verkehrsunfalls enthielt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec23cd56-5128-3d0e-9149-601be5ff6497",
                                        "entry_id": "f10d284f-2d3f-33af-86b5-6817df547d94",
                                        "glosses": [
                                            "in Erregung geratend, in Erregung versetzend; voller Spannung"
                                        ],
                                        "tags": [
                                            "oft im Bezug auf Sport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d0f98e-5471-40b0-a813-0d4e21ed82db",
                                                "sense_id": "ec23cd56-5128-3d0e-9149-601be5ff6497",
                                                "text": "Das Rennen zwischen den beiden Kontrahenten war/verlief äußerst dramatisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                        "entry_id": "f10d284f-2d3f-33af-86b5-6817df547d94",
                                        "glosses": [
                                            "sehr, oft auch beunruhigend klar und deutlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e79247-973a-49c6-927d-81cf9be63984",
                                                "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                                "text": "In […] vielen deutschen Städten [ist die Zahl wohnungsloser Menschen …] in den vergangenen Jahren dramatisch gestiegen."
                                            },
                                            {
                                                "example_id": "644eb342-5bef-4833-aff7-9472388d9a0d",
                                                "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                                "text": "„Nach einer Studie deutscher, britischer und niederländischer Wissenschaftler [… hat] hat sich die Zahl der Falter, Käfer, Wespen, Bienen und aller möglichen anderen fliegenden Insekten in Deutschland in den letzten 27 Jahren dramatisch verringert - um 76 Prozent.“"
                                            },
                                            {
                                                "example_id": "8e073ba7-110b-4820-8ed7-0a76148d7ea9",
                                                "sense_id": "64f5da60-ee44-3908-a24e-ce1037307194",
                                                "text": "[Klimakrise – Trockenheit in Südeuropa 2022:] „Dramatisch sind die Folgen für die Landwirtschaft in Italiens Nordregionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
