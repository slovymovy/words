                            {
                                "example_id": "db6a71bb-e18e-476c-a370-0074129d7d6b",
                                "sense_id": "6a5c7762-9bf0-3eb5-8dc8-57e0344a0b1c",
                                "text": "Wie wordt de nieuwe president van Rusland? Voor het officiële antwoord moeten we nog een ruime maand wachten, maar bij deze koffietent weten ze het al."
                            },
                            {
                                "example_id": "c906c4df-b2d1-44e8-9009-c99682a58b5e",
                                "sense_id": "6a5c7762-9bf0-3eb5-8dc8-57e0344a0b1c",
                                "text": "Het Amerikaanse televisiestation NBC zat hier toen met tientallen mensen, zelfs met een eigen Starbucks koffietent, hoorde ik. Tijdens de Paralympische Winterspelen werkte er nog een handjevol mensen. NBC zond de Paralympische Spelen wel uit, maar veelal op tijdstippen waarop ze in de Verenigde Staten lagen te tukken."
                            }
                        ]
