                    ]
                },
                {
                    "sense_id": "4567f30f-9906-30b3-9cc8-e73a8b6022fd",
                    "sense_definition": "Éprouver un profond chagrin, se lamenter ou s'affliger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affliction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle continue de se <w>désoler</w> pour cette erreur commise il y a plusieurs mois."
                        },
                        {
                            "text": "Il ne sert à rien de se <w>désoler</w> devant une situation devenue irréversible."
                        }
                    ],
                    "synonyms": [
