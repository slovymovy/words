                                            "To visit (a website)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cd01a95-7dac-4ec3-9285-5921fe4b221c",
                                                "sense_id": "00c4b91c-7b35-3b73-91ff-44495c221ee1",
                                                "text": "Visit a location, call, or click www.example.com."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0293b92d-26bc-3f2a-8c30-de374568c5cb",
                                        "entry_id": "36761259-d7d6-3470-8011-2a3fd3f4fe17",
                                        "glosses": [
                                            "To navigate by clicking a mouse button."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d868a203-70b2-4ada-a10a-28426a01d8a0",
                                                "sense_id": "0293b92d-26bc-3f2a-8c30-de374568c5cb",
                                                "text": "I soon grew bored and clicked away from the site."
                                            },
                                            {
                                                "example_id": "80bc25e4-43f0-468c-8227-32782dd6dcb0",
                                                "sense_id": "0293b92d-26bc-3f2a-8c30-de374568c5cb",
                                                "text": "From the home page, click through to the Products section."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a578ac-9c9c-3794-a6eb-480b87f8369f",
                                        "entry_id": "36761259-d7d6-3470-8011-2a3fd3f4fe17",
                                        "glosses": [
                                            "To make sense suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf1cbd6e-c98a-4776-821e-55fc79c185ed",
                                                "sense_id": "b6a578ac-9c9c-3794-a6eb-480b87f8369f",
                                                "text": "Then it clicked—I had been going the wrong way all that time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10df15a-9ea7-3f4c-a832-beb5376a159d",
                                        "entry_id": "36761259-d7d6-3470-8011-2a3fd3f4fe17",
                                        "glosses": [
                                            "To get along well."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9616ada5-6bf8-40e3-900c-daca7a15b1ca",
                                                "sense_id": "c10df15a-9ea7-3f4c-a832-beb5376a159d",
                                                "text": "When we met at the party, we just clicked and we’ve been best friends ever since."
                                            },
                                            {
                                                "example_id": "615aa65d-467f-4165-8297-084b269b3ee7",
                                                "sense_id": "c10df15a-9ea7-3f4c-a832-beb5376a159d",
                                                "text": "After tea, the bright boys wash, clean their boots, and change into their “second-best” attire, and stroll forth[…]; sometimes to saunter, in company with others, up and down that parade until they “click” with one of the “birds.”"
                                            }
                                        ]
                                    },
