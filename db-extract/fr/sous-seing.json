                        "glosses": [
                            "Acte fait entre des particuliers, sans l’intervention d’un officier ministériel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a04c44b6-f315-4193-89f7-308f8410316f",
                                "sense_id": "a5489ddd-66fe-33c8-9b0b-d80c052652e8",
                                "text": "Dans le sous-seing qu’ils avaient passé, il était stipulé que ce dernier toucherait, en plus de son traitement fixe, cinq pour cent sur les ventes et autant sur les achats."
                            },
                            {
                                "example_id": "1e5514f9-5d5a-400f-a1c1-27da2b2a9a38",
                                "sense_id": "a5489ddd-66fe-33c8-9b0b-d80c052652e8",
                                "text": "Le sous-seing sera signé dans un second temps, après la délibération du conseil municipal d’Agen qui se réunit ce samedi 15 décembre au matin au Théâtre Ducourneau."
                            }
                        ]
                    }
