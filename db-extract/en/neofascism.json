                        "source_entry_id": "29f25fba-d54c-3d52-94ab-ef3c4abb4cb6",
                        "source_sense_id": "a2f13cb5-f955-3fea-b223-18307f2ad1ce",
                        "source_sense_description": "right-wing political movement",
                        "target_lang_word": "néofascisme",
