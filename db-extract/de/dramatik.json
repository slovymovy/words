                                    {
                                        "sense_id": "a541b6dd-c0cb-37b6-b3e2-075dce133c64",
                                        "entry_id": "c41fa041-a4f5-36fe-a60b-6b5e145b4695",
                                        "glosses": [
                                            "A composition, normally in prose, telling a story and intended to be represented by actors impersonating the characters and speaking the dialogue"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a97edc5-0e5d-4035-9ae7-2bbbd6d8fa30",
                                                "sense_id": "a541b6dd-c0cb-37b6-b3e2-075dce133c64",
                                                "text": "The author released her latest drama, which became a best-seller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78abede6-2d91-3f70-a42e-7dac1fecf03f",
                                        "entry_id": "c41fa041-a4f5-36fe-a60b-6b5e145b4695",
                                        "glosses": [
                                            "Such a work for television, radio or the cinema, usually one that is not a comedy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c62bee0c-7ab5-3071-96e2-50f0e61b82ba",
                                        "entry_id": "c41fa041-a4f5-36fe-a60b-6b5e145b4695",
                                        "glosses": [
                                            "Theatrical plays in general."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a141bd7-1bb9-306e-937b-bd5a735b3048",
                                        "entry_id": "c41fa041-a4f5-36fe-a60b-6b5e145b4695",
                                        "glosses": [
                                            "A situation in real life that has the characteristics of such a theatrical play."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80002ee2-dc73-4f91-b7a6-35498608a9af",
                                                "sense_id": "0a141bd7-1bb9-306e-937b-bd5a735b3048",
                                                "text": "After losing my job, having a car crash, and the big row with my neighbours, I don't need any more drama."
                                            },
                                            {
                                                "example_id": "b67bed43-ecd3-4acd-afbf-323abf30703c",
                                                "sense_id": "0a141bd7-1bb9-306e-937b-bd5a735b3048",
                                                "text": "Thais have been gripped by the two-week drama unfolding at the Tham Luang cave system, and took to social media Sunday as rescue efforts unfolded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3807221-5871-3b3d-9d1c-33b8e29263e5",
                                        "entry_id": "c41fa041-a4f5-36fe-a60b-6b5e145b4695",
                                        "glosses": [
                                            "Rumor, lying or exaggerated reaction to life or online events; melodrama; an angry dispute or scene; a situation made more complicated or worse than it should be; intrigue or spiteful interpersonal maneuvering."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
