                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ee5d25cd-acfe-473e-aeca-6a2a15ac7b28",
                                "sense_id": "96e75240-c1cc-3d95-ae31-2f9569eab3ee",
                                "text": "Sam is a real footy, he's always watching it on TV and talking about it."
                            }
