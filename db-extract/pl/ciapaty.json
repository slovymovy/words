                "senses": [
                    {
                        "sense_id": "755a4d75-380a-3f90-a222-8c67914fb536",
                        "entry_id": "94551bc3-7e9a-3971-92eb-97c7eb93dfe4",
                        "glosses": [
                            "osoba pochodząca z Indii, Pakistanu, Bangladeszu lub krajów arabskich"
                        ],
                        "tags": [
                            "offensive",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "f6594f9b-b00d-4786-a057-df46e37ca20c",
                                "sense_id": "755a4d75-380a-3f90-a222-8c67914fb536",
                                "text": "Powstało nowe obraźliwe słownictwo stworzone przez polskich imigrantów na określenie mieszkańców Bliskiego Wschodu, Afryki Północnej i Azji Południowej – „ciapki”, „ciapaci”, „beżowi” (…), „szmatogłowi”, „muzole” oraz „muslimy”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8181e5e3-d76a-3b13-906f-be7fdf24fbb4",
                        "entry_id": "94551bc3-7e9a-3971-92eb-97c7eb93dfe4",
                        "glosses": [
                            "osoba ciemnoskóra"
                        ],
                        "tags": [
