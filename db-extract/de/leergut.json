                        "examples": [
                            {
                                "example_id": "ad1e46ed-d538-45cc-81da-fe0f1c0f58c5",
                                "sense_id": "10f946f0-dda0-3636-b602-05d1bfd7b79c",
                                "text": "15 PET-Leergutkisten im Wert von 56,25 Euro wurden einem Landhandel in der Obergriesheimer Heuchlinger Straße zwischen Samstag und Montag entwendet. Die bislang unbekannten Täter stahlen das Leergut der Marke Löwensteiner Mineralquelle vom Hof des Landhandels."
                            },
                            {
                                "example_id": "74cf3f89-3e03-4a1d-8d18-1d0aff5eb624",
                                "sense_id": "10f946f0-dda0-3636-b602-05d1bfd7b79c",
                                "text": "„In Vallendar sollten wir Leergut abgeben, vier Flaschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
