                "senses": [
                    {
                        "sense_id": "f835420b-b54f-3388-895e-ee66bad36410",
                        "entry_id": "db2337b6-d212-310b-a794-8051d21f4f4b",
                        "glosses": [
                            "Lampe, die an der Decke befestigt ist"
                        ],
                        "tags": [
                            "Beleuchtung"
                        ],
                        "examples": [
                            {
                                "example_id": "f13110e5-3257-46d6-85b5-cbcee9d2ce01",
                                "sense_id": "f835420b-b54f-3388-895e-ee66bad36410",
                                "text": "„Auf dem Rückweg durch den Flur mußte Jürgen wieder an der Tasche vorbei, deren schwarzes, glänzendes Leder das Licht der Deckenlampe reflektierte.“"
                            },
                            {
                                "example_id": "bca28d04-0151-4deb-9239-98a5e92f00b5",
                                "sense_id": "f835420b-b54f-3388-895e-ee66bad36410",
                                "text": "„In der Deckenlampe sind die Glühbirnen aus klarem Glas.“"
                            },
                            {
                                "example_id": "beecb4a9-f81a-415f-8767-525081a3b47c",
                                "sense_id": "f835420b-b54f-3388-895e-ee66bad36410",
                                "text": "„Obwohl der Raum bis auf die etwa 30 Zentimeter bis zur Decke vollständig unter Wasser stand, leuchteten die sechs Deckenlampen immer noch.“"
                            },
                            {
                                "example_id": "b39eb4df-8ff1-405d-b457-0dcbb68001c8",
                                "sense_id": "f835420b-b54f-3388-895e-ee66bad36410",
                                "text": "„Der Schein mehrerer Deckenlampen hüllte den Raum in warmes Licht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
