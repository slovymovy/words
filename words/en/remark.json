{
    "word_family": [
        "remarkable",
        "remarkably"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96c14c4d-a34e-3f71-a8b5-ca47b79524b3",
                    "sense_definition": "A spoken or written comment, often expressing an opinion or observation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a polite <w>remark</w> about the meal to the chef.",
                            "target_lang_translations": {
                                "ru": "Она сделала вежливое <w>замечание</w> повару по поводу еды.",
                                "de": "Sie machte dem Koch eine höfliche <w>Bemerkung</w> zum Essen.",
                                "zh": "她向厨师对这顿饭做了一番礼貌的<w>评论</w>。",
                                "es": "Ella le hizo un <w>comentario</w> amable sobre la comida al chef."
                            }
                        },
                        {
                            "text": "His rude <w>remark</w> upset everyone in the meeting.",
                            "target_lang_translations": {
                                "ru": "Его грубое <w>замечание</w> расстроило всех на собрании.",
                                "de": "Seine unhöfliche <w>Bemerkung</w> verärgerte alle bei dem Treffen.",
                                "zh": "他那句粗鲁的<w>评语</w>让会议上的每个人都很不高兴。",
                                "es": "Su <w>comentario</w> grosero molestó a todos en la reunión."
                            }
                        }
                    ],
                    "synonyms": [
                        "comment",
                        "observation",
                        "statement"
                    ],
                    "common_phrases": [
                        "make a remark",
                        "casual remark",
                        "rude remark",
                        "opening remark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устный или письменный комментарий, часто выражающий мнение или наблюдение.",
                        "de": "Eine mündliche oder schriftliche Äußerung, die oft eine Meinung oder Beobachtung ausdrückt.",
                        "zh": "口头或书面的评论，通常表达一种观点或观察。",
                        "es": "Un comentario hablado o escrito que expresa una opinión u observación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечание",
                                "target_lang_sense_clarification": "высказывание, комментарий"
                            },
                            {
                                "target_lang_word": "реплика",
                                "target_lang_sense_clarification": "краткое высказывание"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bemerkung",
                                "target_lang_sense_clarification": "allgemeine Äußerung zu einem Thema"
                            },
                            {
                                "target_lang_word": "Anmerkung",
                                "target_lang_sense_clarification": "zusätzliche Information oder Kommentar"
                            },
                            {
                                "target_lang_word": "Äußerung",
                                "target_lang_sense_clarification": "das, was ausgesprochen wurde"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评论",
                                "target_lang_sense_clarification": "对某事发表的看法或意见"
                            },
                            {
                                "target_lang_word": "评语",
                                "target_lang_sense_clarification": "针对特定内容所作的评价"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comentario",
                                "target_lang_sense_clarification": "opinión o consideración expresada oralmente o por escrito"
                            },
                            {
                                "target_lang_word": "observación",
                                "target_lang_sense_clarification": "comentario que complementa o aclara un asunto"
                            },
                            {
                                "target_lang_word": "acotación",
                                "target_lang_sense_clarification": "nota o señal que se hace sobre un escrito"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6c63463-694b-3864-8b20-9d7b0ea9dd3d",
                    "sense_definition": "The act of noticing or paying attention to something; observation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange event passed without <w>remark</w> from the crowd.",
                            "target_lang_translations": {
                                "ru": "Странное событие прошло без <w>внимания</w> со стороны толпы.",
                                "de": "Das seltsame Ereignis blieb ohne <w>Beachtung</w> durch die Menge.",
                                "zh": "这件奇怪的事情发生时，人群中并没有引起任何<w>注意</w>。",
                                "es": "El extraño suceso pasó sin <w>observación</w> por parte de la multitud."
                            }
                        },
                        {
                            "text": "It is worthy of <w>remark</w> that the system failed twice in one day.",
                            "target_lang_translations": {
                                "ru": "Заслуживает <w>внимания</w> тот факт, что система отказала дважды за один день.",
                                "de": "Es ist <w>bemerkenswert</w>, dass das System an einem Tag zweimal ausgefallen ist.",
                                "zh": "系统在一天内故障了两次，这很值得<w>关注</w>。",
                                "es": "Es digno de <w>notar</w> que el sistema falló dos veces en un día."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worthy of remark",
                        "pass without remark"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт обнаружения или обращения внимания на что-либо; наблюдение.",
                        "de": "Der Akt, etwas wahrzunehmen oder Aufmerksamkeit auf etwas zu richten; Beobachtung.",
                        "zh": "注意到或关注某事物的行为；观察。",
                        "es": "El acto de notar o prestar atención a algo; observación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внимание",
                                "target_lang_sense_clarification": "интерес, наблюдение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Beachtung",
                                "target_lang_sense_clarification": "das Bemerken und die Aufmerksamkeit gegenüber einer Sache"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注意",
                                "target_lang_sense_clarification": "关注或留心某事"
                            },
                            {
                                "target_lang_word": "关注",
                                "target_lang_sense_clarification": "对某事给予重视或观察"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atención",
                                "target_lang_sense_clarification": "acto de fijarse en algo"
                            },
                            {
                                "target_lang_word": "observación",
                                "target_lang_sense_clarification": "acción de examinar algo con detenimiento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f70acf29-5ed4-33c2-90ae-de63a9fc9d1b",
                    "sense_definition": "To say or write something as a comment or observation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>remarked</w> that the weather was getting much colder.",
                            "target_lang_translations": {
                                "ru": "Он <w>заметил</w>, что погода становится гораздо холоднее.",
                                "de": "Er <w>bemerkte</w>, dass das Wetter viel kälter wurde.",
                                "zh": "他<w>评论</w>说天气变得冷多了。",
                                "es": "Él <w>comentó</w> que el clima se estaba volviendo mucho más frío."
                            }
                        },
                        {
                            "text": "The teacher <w>remarked</w> on the high quality of the student's essay.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>отметил</w> высокое качество эссе студента.",
                                "de": "Der Lehrer <w>merkte</w> die hohe Qualität des Aufsatzes des Schülers an.",
                                "zh": "老师<w>指出</w>了这名学生论文的高质量。",
                                "es": "El profesor <w>señaló</w> la alta calidad del ensayo del estudiante."
                            }
                        }
                    ],
                    "synonyms": [
                        "comment",
                        "observe"
                    ],
                    "common_phrases": [
                        "remark on",
                        "remark upon",
                        "remark that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать или написать что-либо в качестве комментария или наблюдения.",
                        "de": "Etwas als Kommentar oder Beobachtung sagen oder schreiben.",
                        "zh": "作为评论或观察说出或写下某事。",
                        "es": "Decir o escribir algo como un comentario u observación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "высказываться, комментировать"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "указывать на факт"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bemerken",
                                "target_lang_sense_clarification": "einen mündlichen oder schriftlichen Beitrag leisten"
                            },
                            {
                                "target_lang_word": "anmerken",
                                "target_lang_sense_clarification": "eine Feststellung treffen"
                            },
                            {
                                "target_lang_word": "äußern",
                                "target_lang_sense_clarification": "seine Meinung oder einen Gedanken mitteilen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评论",
                                "target_lang_sense_clarification": "发表看法或意见"
                            },
                            {
                                "target_lang_word": "指出",
                                "target_lang_sense_clarification": "明确说出某一点"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comentar",
                                "target_lang_sense_clarification": "hacer juicios u observaciones sobre algo"
                            },
                            {
                                "target_lang_word": "señalar",
                                "target_lang_sense_clarification": "resaltar un dato o hecho"
                            },
                            {
                                "target_lang_word": "apuntar",
                                "target_lang_sense_clarification": "hacer notar o indicar algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad0cee8a-9b22-3cf8-acb7-d56febeb4bb2",
                    "sense_definition": "To notice or perceive something; to become aware of.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>remarked</w> a slight change in her attitude during the conversation.",
                            "target_lang_translations": {
                                "ru": "Я <w>заметил</w> небольшую перемену в её отношении во время разговора.",
                                "de": "Ich <w>bemerkte</w> eine leichte Veränderung in ihrer Haltung während des Gesprächs.",
                                "zh": "在谈话过程中，我<w>察觉</w>到她的态度有细微的变化。",
                                "es": "Yo <w>noté</w> un ligero cambio en su actitud durante la conversación."
                            }
                        },
                        {
                            "text": "Did you <w>remark</w> the strange car parked outside the house?",
                            "target_lang_translations": {
                                "ru": "Ты <w>заметил</w> странную машину, припаркованную у дома?",
                                "de": "Hast du das seltsame Auto <w>bemerkt</w>, das vor dem Haus parkte?",
                                "zh": "你<w>注意到</w>停在房子外面的那辆奇怪的车了吗？",
                                "es": "¿<w>Notaste</w> el coche extraño aparcado fuera de la casa?"
                            }
                        }
                    ],
                    "synonyms": [
                        "observe"
                    ],
                    "antonyms": [
                        "ignore",
                        "overlook",
                        "miss"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметить или воспринять что-либо; осознать.",
                        "de": "Etwas wahrnehmen oder bemerken; sich einer Sache bewusst werden.",
                        "zh": "注意到或感知到某事；意识到。",
                        "es": "Notar o percibir algo; darse cuenta de algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "обнаруживать, видеть"
                            },
                            {
                                "target_lang_word": "подмечать",
                                "target_lang_sense_clarification": "замечать детали"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bemerken",
                                "target_lang_sense_clarification": "etwas wahrnehmen, zu Bewusstsein kommen"
                            },
                            {
                                "target_lang_word": "wahrnehmen",
                                "target_lang_sense_clarification": "mit den Sinnen erfassen"
                            },
                            {
                                "target_lang_word": "merken",
                                "target_lang_sense_clarification": "sich einer Sache bewusst werden"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "察觉",
                                "target_lang_sense_clarification": "发现细微的变化或情况"
                            },
                            {
                                "target_lang_word": "注意到",
                                "target_lang_sense_clarification": "感知到某事物的存在"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "notar",
                                "target_lang_sense_clarification": "darse cuenta de algo"
                            },
                            {
                                "target_lang_word": "percibir",
                                "target_lang_sense_clarification": "captar algo a través de los sentidos"
                            },
                            {
                                "target_lang_word": "advertir",
                                "target_lang_sense_clarification": "darse cuenta de un detalle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}