{
    "word_family": [
        "chagrined"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9df4c34-ed93-39ab-896e-f90beb859c70",
                    "sense_definition": "Distress of mind caused by a failure of aims or plans, want of appreciation, or mistakes; vexation or mortification.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Much to the <w>chagrin</w> of the team, the project was cancelled at the last minute.",
                            "target_lang_translations": {
                                "nl": "Tot groot <w>chagrijn</w> van het team werd het project op het laatste moment geannuleerd."
                            }
                        },
                        {
                            "text": "He hid his <w>chagrin</w> behind a polite smile when he realized he had lost the competition.",
                            "target_lang_translations": {
                                "nl": "Hij verborg zijn <w>chagrijn</w> achter een beleefde glimlach toen hij besefte dat hij de wedstrijd had verloren."
                            }
                        }
                    ],
                    "synonyms": [
                        "mortification",
                        "vexation"
                    ],
                    "common_phrases": [
                        "much to the chagrin"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gevoel van onbehagen of teleurstelling door falen, gebrek aan waardering of fouten; ergernis of mortificatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "chagrijn",
                                "target_lang_sense_clarification": "ontevreden stemming of ergernis"
                            },
                            {
                                "target_lang_word": "ongenoegen",
                                "target_lang_sense_clarification": "gevoel van ontevredenheid"
                            },
                            {
                                "target_lang_word": "irritatie",
                                "target_lang_sense_clarification": "gevoel van ergernis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c95b2ea7-bb90-323c-9267-cb0b325c95ff",
                    "sense_definition": "A type of leather or skin with a rough surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique box was covered in fine <w>chagrin</w>.",
                            "target_lang_translations": {
                                "nl": "Het antieke doosje was bekleed met fijn <w>segrijn</w>."
                            }
                        },
                        {
                            "text": "Artisans often used <w>chagrin</w> to create durable and textured book covers.",
                            "target_lang_translations": {
                                "nl": "Ambachtslieden gebruikten vaak <w>segrijn</w> om duurzame en getextureerde boekomslagen te maken."
                            }
                        }
                    ],
                    "synonyms": [
                        "shagreen"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een type leer of huid met een ruw oppervlak (segrijn)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "segrijn",
                                "target_lang_sense_clarification": "hard, fijn gekorreld leer"
                            },
                            {
                                "target_lang_word": "chagrijn",
                                "target_lang_sense_clarification": "verouderde term voor segrijnleer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f20b76a-a7f0-3fdb-9c92-cf8f5419dbca",
                    "sense_definition": "To bother, vex, or mortify someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It did not <w>chagrin</w> him to admit his mistake in front of his colleagues.",
                            "target_lang_translations": {
                                "nl": "Het <w>stoorde</w> hem niet om zijn fout voor zijn collega's toe te geven."
                            }
                        },
                        {
                            "text": "The constant delays began to <w>chagrin</w> the waiting passengers.",
                            "target_lang_translations": {
                                "nl": "De voortdurende vertragingen begonnen de wachtende passagiers te <w>ergeren</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand storen, ergeren of mortificeren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "storen",
                                "target_lang_sense_clarification": "iemand hinderen of irriteren"
                            },
                            {
                                "target_lang_word": "ergeren",
                                "target_lang_sense_clarification": "iemand tot ergernis brengen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6cbe08b-5603-3770-8273-dd653cdb0cb6",
                    "sense_definition": "To be vexed or annoyed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>chagrin</w> yourself over things that are beyond your control.",
                            "target_lang_translations": {
                                "nl": "Laat je niet <w>ergeren</w> door zaken waar je geen controle over hebt."
                            }
                        },
                        {
                            "text": "She refused to <w>chagrin</w> herself about the minor criticism she received.",
                            "target_lang_translations": {
                                "nl": "Ze weigerde zich te <w>ergeren</w> aan de kleine kritiek die ze ontving."
                            }
                        }
                    ],
                    "synonyms": [
                        "vexation"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Reflexive usage is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich ergeren of geërgerd zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zich ergeren",
                                "target_lang_sense_clarification": "zich storen aan iets"
                            },
                            {
                                "target_lang_word": "zich druk maken",
                                "target_lang_sense_clarification": "zich onnodig zorgen of ergeren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f82daba5-0d2f-328d-a442-ed4c8c83d085",
                    "sense_definition": "Feeling annoyed, vexed, or fretful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>chagrin</w> after the unexpected failure of his plans.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich <w>geërgerd</w> na het onverwachte falen van zijn plannen."
                            }
                        },
                        {
                            "text": "The <w>chagrin</w> expression on her face revealed her deep disappointment.",
                            "target_lang_translations": {
                                "nl": "De <w>geërgerde</w> uitdrukking op haar gezicht onthulde haar diepe teleurstelling."
                            }
                        }
                    ],
                    "synonyms": [
                        "chagrined"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Usage as an adjective is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Geërgerd, verveeld of ontevreden voelend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geërgerd",
                                "target_lang_sense_clarification": "gevoel van irritatie"
                            },
                            {
                                "target_lang_word": "ontevreden",
                                "target_lang_sense_clarification": "gevoel van ongenoegen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}