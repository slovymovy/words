                                "target_senses": [
                                    {
                                        "sense_id": "01e5a368-2252-305c-ab95-1855c76bc0e5",
                                        "entry_id": "b3db9e1e-a326-366d-b968-1c20af572d4b",
                                        "glosses": [
                                            "Bezeichnung für einen Richter in einigen arabischen Staaten"
                                        ],
                                        "tags": [
                                            "spezieller"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ad7d52-c519-48f5-b56e-aa88fc033428",
                                                "sense_id": "01e5a368-2252-305c-ab95-1855c76bc0e5",
                                                "text": "„Ibn Beschir war Kadi in der Stadt. Er ließ sich den Fall vortragen und fand ihn bedenklich; […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19f9052c-57e2-3c66-8413-8768793340e8",
                                        "entry_id": "b3db9e1e-a326-366d-b968-1c20af572d4b",
                                        "glosses": [
                                            "allgemein, Person oder Einrichtung, welche für die Rechtssprechung zuständig ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0d29b47-aa5d-4a94-bb11-71d1a90dbaf7",
                                                "sense_id": "19f9052c-57e2-3c66-8413-8768793340e8",
                                                "text": "„In Deutschland zerren Unternehmen ihre gescheiterten Manager selten vor den Kadi.“"
                                            },
                                            {
                                                "example_id": "381c38b1-2db3-47b5-a972-47c1761903e9",
                                                "sense_id": "19f9052c-57e2-3c66-8413-8768793340e8",
                                                "text": "„Er hat seine halbkriminellen und kriminellen Praktiken, ohne jeden Respekt vor Tabus und oft haarscharf am Kadi vorbei, nie aufgegeben; hat dabei andere jedoch oft ins Messer laufen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
