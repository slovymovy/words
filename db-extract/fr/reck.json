                                                "example_id": "8c36c712-c0e8-477f-a76b-79dc1ac1929e",
                                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                                "text": "Der Reck trägt nie die Schals, die die Reck ihm strickt."
                                            },
