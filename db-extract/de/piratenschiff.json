                ],
                "senses": [
                    {
                        "sense_id": "a0e1d971-7bf0-3b68-9d31-1899f45448fa",
                        "entry_id": "7b89ba89-8632-336e-834a-b14c76b8381b",
                        "glosses": [
                            "von Piraten verwendetes Schiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a588f2-3402-4572-899b-a522f7b4e470",
                                "sense_id": "a0e1d971-7bf0-3b68-9d31-1899f45448fa",
                                "text": "Solange ein Piratenschiff auf der Suche nach Beute war, lief es oft unter falscher Flagge …, um sich seinem Opfer ungestört nähern zu können."
                            },
                            {
                                "example_id": "68edf0e6-e609-4368-9385-6f5285d7a2b9",
                                "sense_id": "a0e1d971-7bf0-3b68-9d31-1899f45448fa",
                                "text": "„Er hatte vielmehr Angst, dass sie einem Piratenschiff begegnet waren, dessen aufgezogene englische Fahne nur eine List war, um die Diligent aus nächster Nähe angreifen zu können.“"
                            },
                            {
                                "example_id": "0003804c-b73b-4471-84f8-efefa75ab4b9",
                                "sense_id": "a0e1d971-7bf0-3b68-9d31-1899f45448fa",
                                "text": "„Und auf dem Grund der Bucht liegen mehrere Dutzend versenkter Piratenschiffe.“"
                            },
                            {
                                "example_id": "c2042fc1-5027-4ec4-9412-df0a7e510edd",
                                "sense_id": "a0e1d971-7bf0-3b68-9d31-1899f45448fa",
                                "text": "„Wir finden also Agathon auf dem Piratenschiff wieder, in Sklavenkleidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
