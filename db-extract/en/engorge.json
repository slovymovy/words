                    {
                        "sense_id": "d357402f-5643-3010-8743-8b04739be83a",
                        "entry_id": "ccf7b4dc-5e68-3e33-b4dd-452868afebb4",
                        "glosses": [
                            "To devour something greedily, gorge, glut."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bbf3e34b-ca35-477c-84fe-299d71bb5b3e",
                                "sense_id": "d357402f-5643-3010-8743-8b04739be83a",
                                "text": "One typical Grecian kiln engorged one thousand muleloads of juniper wood in a single burn. Fifty such kilns would devour six thousand metric tons of trees and brush annually."
                            }
                        ]
                    },
                    {
                        "sense_id": "52f319cd-2ae5-3a41-9e00-96134ebc3806",
                        "entry_id": "ccf7b4dc-5e68-3e33-b4dd-452868afebb4",
                        "glosses": [
                            "To feed ravenously."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "72d4cac8-e7d3-461a-a701-1186ee76e8e6",
                                "sense_id": "52f319cd-2ae5-3a41-9e00-96134ebc3806",
                                "text": "Greedily she engorged without restraint"
                            }
                        ]
                    },
                    {
                        "sense_id": "c121ac7a-134a-3110-91fd-0c52e3ade56a",
                        "entry_id": "ccf7b4dc-5e68-3e33-b4dd-452868afebb4",
