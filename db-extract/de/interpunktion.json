                "senses": [
                    {
                        "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                        "entry_id": "0a9753a4-82f4-39ab-810b-d1d066310df1",
                        "glosses": [
                            "Verwendung der Interpunktionszeichen (Satzzeichen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8ee700-ecae-4406-adc4-761c60580d8d",
                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                "text": "Die Rechtschreibregeln enthalten auch Regeln für die Interpunktion."
                            },
                            {
                                "example_id": "11ffa975-27b2-414a-9c28-edcc80aebc0d",
                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                "text": "„Unter Interpunktion (auch Zeichensetzung) versteht man das Setzen von Satzzeichen in Sätzen zur Verdeutlichung syntaktischer Strukturen und das Setzen von Wortzeichen in Wörtern zur Verdeutlichung morphologischer Strukturen. Sie folgt in jeder Sprache entsprechenden Interpunktionsregeln.“"
                            },
                            {
                                "example_id": "9de02173-d892-4587-ad3d-1e5c67b9d3a0",
                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                "text": "„Die Nachrichten, die wir gegenseitig verfassen, sind zumeist kurz, oft sehr kurz, und missverständlich, oft in falscher Interpunktion und mit kruden Abkürzungen, ohne Kommata und Bindestriche, ohne Frage- und Ausrufezeichen.“"
                            },
                            {
                                "example_id": "7135f5ad-9f43-45b1-beac-675684d88978",
                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                "text": "„Schließlich kann durch falsche Interpunktion ein Sinnzusammenhang ins Gegenteil und damit ins Komische verzerrt werden.“"
                            },
                            {
                                "example_id": "a0459aed-8141-4292-939e-1fda39987e48",
                                "sense_id": "34e2ad97-e468-3afe-902a-99fc72462575",
                                "text": "„Noch mehr Interpunktion macht alles nur noch schlimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
