                        ],
                        "examples": [
                            {
                                "example_id": "f5e38c01-a9c1-4f15-b691-5c8153cd90c3",
                                "sense_id": "92e65859-8320-3fd5-bdc0-597fc2b38fa5",
                                "text": "„Und schon strömt die Milch, sozusagen das Fertigfabrikat aus dem Blut der Kuh, von den Milchdrüsen in die besonderen Vorratskammern des Euters, in die Milchzisternen, aus denen der Mensch sie herausbefördert, sobald er an den Zitzen melkt und die Milch kuhwarm in den Eimer strullen läßt.“"
                            }
                        ],
