                                    }
                                ]
                            },
                            {
                                "target_word": "rhinestone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15fae50d-9cc4-3ab3-8691-57f5615101e3",
                                        "entry_id": "d159cda4-2b58-3767-b3bf-d32e2b052df7",
                                        "glosses": [
                                            "Made of or encrusted with rhinestones."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e30cf4-6570-4930-aca5-a297286ff7ac",
                                                "sense_id": "15fae50d-9cc4-3ab3-8691-57f5615101e3",
                                                "text": "Karl wore a cowboy hat with a rhinestone hatband when he played his country and western gigs."
                                            },
                                            {
                                                "example_id": "8d7e972f-2630-4304-9434-119ac8b417d8",
                                                "sense_id": "15fae50d-9cc4-3ab3-8691-57f5615101e3",
                                                "text": "I'm a scary gargoyle on a tower / That you made with plastic power / Your rhinestone eyes are like factories far away"
                                            }
