                            "target_lang_translations": {
                                "ru": "Семья <w>Гор</w> жила в этом городе на протяжении поколений.",
                                "de": "Die Familie <w>Gore</w> lebt seit Generationen in dieser Stadt."
                            }
                        }
                    ],
                    "traits": [
                        {
