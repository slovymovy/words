                "senses": [
                    {
                        "sense_id": "bb79bf77-2899-3975-a51c-0ae9269bc4b6",
                        "entry_id": "bef3930b-dbdd-38ae-b58f-dc09f0a0a42a",
                        "glosses": [
                            "Gewebe, aus dem das Gehirn besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60b5238a-18df-48a9-a6b2-75e15cd18fa3",
                                "sense_id": "bb79bf77-2899-3975-a51c-0ae9269bc4b6",
                                "text": "„Die Leichen mussten außergewöhnlich frisch sein, oder der leichte Verfall des Hirngewebes würde eine vollkommene Wiederbelebung unmöglich machen.“"
                            },
                            {
                                "example_id": "5d40da83-5dda-487a-b2ef-1b24be38dd78",
                                "sense_id": "bb79bf77-2899-3975-a51c-0ae9269bc4b6",
                                "text": "„›Oh, nach der Abtreibung dürften sie sich ein bisschen damit amüsiert haben. Natürlich erst, nachdem sie dem Fötus das Hirngewebe absaugten. Das benutzen sie zu Forschungszwecken.‹“"
                            },
                            {
                                "example_id": "c729b0ab-c07d-4f54-93ef-54b23d2b4623",
                                "sense_id": "bb79bf77-2899-3975-a51c-0ae9269bc4b6",
                                "text": "„Dieses Zittern ist bloß traumatisches Parkinson. Traumatische Enzephalopathie, wo es zur Nekrose von Hirngewebe kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
