                {
                    "sense_id": "13611a5a-1759-3925-a140-35384055c484",
                    "sense_definition": "Ensemble de cris confus et tumultueux poussés par une foule de personnes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cris",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès que le but a été marqué, une immense <w>clameur</w> est montée des tribunes du stade. "
                        },
                        {
                            "text": "Les manifestants ont fait entendre leurs <w>clameurs</w> jusque sous les fenêtres de la mairie."
                        }
                    ],
                    "synonyms": [
                        "tumulte",
                        "vocifération",
                        "rumeur",
                        "hurlement"
                    ],
                    "antonyms": [
                        "silence",
                        "calme"
                    ],
                    "common_phrases": [
                        "clameur de la foule",
                        "clameurs assourdissantes",
                        "pousser une clameur"
                    ]
                },
                {
                    "sense_id": "c3eca64c-2413-39c1-9c31-54ee3838a5b6",
                    "sense_definition": "Manifestation vive et collective d'indignation, de protestation ou de réclamation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La hausse brutale des tarifs a provoqué une vive <w>clameur</w> parmi tous les usagers des transports. "
                        },
                        {
                            "text": "Face à la <w>clameur</w> publique, le ministre a été contraint de retirer sa proposition de loi."
                        }
                    ],
                    "synonyms": [
                        "tollé",
                        "protestation",
                        "réprobation",
                        "indignation"
                    ],
                    "antonyms": [
                        "approbation",
                        "consentement"
                    ],
                    "common_phrases": [
                        "clameur publique",
                        "soulever une clameur"
                    ]
                },
                {
                    "sense_id": "0dd62f61-4ab5-3eab-be2d-9e235a5d8fc6",
                    "sense_definition": "Bruit fort, continu et retentissant produit par des éléments naturels ou des instruments.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins luttaient courageusement au milieu de la terrible <w>clameur</w> des vagues déchaînées."
                        },
                        {
                            "text": "Le son du violon s'est éteint brusquement dans la puissante <w>clameur</w> des cuivres de l'orchestre."
                        }
                    ],
                    "synonyms": [
                        "fracas",
                        "grondement",
                        "vacarme",
                        "rugissement"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "clameur des flots",
                        "clameur du vent"
                    ]
                },
                {
                    "sense_id": "7666b8cc-d48b-3c5b-9d9e-fa5793e875f2",
                    "sense_definition": "Cri puissant poussé par une personne pour se plaindre d'une souffrance ou d'une injustice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cris",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la salle d'audience, l'accusé a poussé une poignante <w>clameur</w> pour clamer son innocence."
                        },
                        {
                            "text": "La longue <w>clameur</w> du blessé résonnait tristement dans la nuit glaciale."
                        }
                    ],
                    "synonyms": [
