                            {
                                "example_id": "bb2c3e25-fe69-470f-bd00-bf399db9dec0",
                                "sense_id": "425c1adb-59b0-398b-b001-2ec27864ad42",
                                "text": "Sie ist Venezianerin."
                            },
                            {
                                "example_id": "126e4210-a9f5-4344-9669-1ed0da547d5e",
                                "sense_id": "425c1adb-59b0-398b-b001-2ec27864ad42",
                                "text": "„Sie war Venezianerin, und da ich es lächerlich fand, daß sie mit mir Französisch sprach, das ich nicht verstand, bat ich sie, doch in unserer Muttersprache zu reden.“"
                            }
                        ],
