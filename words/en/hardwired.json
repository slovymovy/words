{
    "word_family": [
        "hardwire"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a53e9b3-93a2-3581-a26d-64f7c92b7ed7",
                    "sense_definition": "Having a deeply ingrained belief, habit, or pattern of behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ingrained",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Humans are <w>hardwired</w> to seek social connection with others.",
                            "target_lang_translations": {
                                "it": "Gli esseri umani sono <w>programmati</w> per cercare connessioni sociali con gli altri."
                            }
                        },
                        {
                            "text": "I am <w>hardwired</w> to have a shower every single morning.",
                            "target_lang_translations": {
                                "it": "Sono <w>programmato</w> per fare la doccia ogni singola mattina."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingrained",
                        "instinctive"
                    ],
                    "common_phrases": [
                        "hardwired to behave"
                    ],
                    "target_lang_definitions": {
                        "it": "Che ha convinzioni, abitudini o schemi comportamentali profondamente radicati."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "programmato",
                                "target_lang_sense_clarification": "riferito a un comportamento o inclinazione naturale"
                            },
                            {
                                "target_lang_word": "predisposto",
                                "target_lang_sense_clarification": "avere una tendenza naturale verso qualcosa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7853ac5c-959e-3d73-8ed6-adbe33fb1730",
                    "sense_definition": "Describing behavior that is genetically determined and instinctive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ingrained",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many scientists believe that fear of snakes is <w>hardwired</w> in humans.",
                            "target_lang_translations": {
                                "it": "Molti scienziati credono che la paura dei serpenti sia <w>innata</w> negli esseri umani."
                            }
                        },
                        {
                            "text": "The <w>hardwired</w> response helps animals survive in the wild.",
                            "target_lang_translations": {
                                "it": "La risposta <w>istintiva</w> aiuta gli animali a sopravvivere in natura."
                            }
                        }
                    ],
                    "synonyms": [
                        "innate",
                        "instinctive"
                    ],
                    "antonyms": [
                        "learned"
                    ],
                    "common_phrases": [
                        "hardwired response"
                    ],
                    "target_lang_definitions": {
                        "it": "Che descrive un comportamento determinato geneticamente e istintivo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "innato",
                                "target_lang_sense_clarification": "presente fin dalla nascita"
                            },
                            {
                                "target_lang_word": "istintivo",
                                "target_lang_sense_clarification": "che deriva dall'istinto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cca6bd38-19d6-39c5-8992-c50aa63f14bb",
                    "sense_definition": "Not capable of being changed or altered.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fixed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software has <w>hardwired</w> settings that the user cannot modify.",
                            "target_lang_translations": {
                                "it": "Il software ha impostazioni <w>fisse</w> che l'utente non può modificare."
                            }
                        },
                        {
                            "text": "These rules are <w>hardwired</w> into the system architecture.",
                            "target_lang_translations": {
                                "it": "Queste regole sono <w>incorporate</w> nell'architettura del sistema."
                            }
                        }
                    ],
                    "synonyms": [
                        "fixed",
                        "immutable"
                    ],
                    "antonyms": [
                        "flexible",
                        "changeable"
                    ],
                    "common_phrases": [
                        "hardwired settings"
                    ],
                    "target_lang_definitions": {
                        "it": "Che non può essere cambiato o modificato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fisso",
                                "target_lang_sense_clarification": "non modificabile"
                            },
                            {
                                "target_lang_word": "immutabile",
                                "target_lang_sense_clarification": "che non può subire cambiamenti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67e8d222-b5de-3920-8f47-e04ea68b1e41",
                    "sense_definition": "Designed or built to perform one specific task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fixed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine uses a <w>hardwired</w> circuit to process data quickly.",
                            "target_lang_translations": {
                                "it": "La macchina utilizza un circuito <w>dedicato</w> per elaborare i dati rapidamente."
                            }
                        },
                        {
                            "text": "This <w>hardwired</w> device is only used for security monitoring.",
                            "target_lang_translations": {
                                "it": "Questo dispositivo <w>specializzato</w> è usato solo per il monitoraggio della sicurezza."
                            }
                        }
                    ],
                    "synonyms": [
                        "specialized"
                    ],
                    "common_phrases": [
                        "hardwired circuit"
                    ],
                    "target_lang_definitions": {
                        "it": "Progettato o costruito per eseguire un compito specifico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "dedicato",
                                "target_lang_sense_clarification": "progettato per una funzione specifica"
                            },
                            {
                                "target_lang_word": "specializzato",
                                "target_lang_sense_clarification": "fatto apposta per un unico scopo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02a10d99-31a7-3461-8a59-478c15059f4d",
                    "sense_definition": "Of electronic devices, closely or tightly connected by physical wires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fixed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alarm system is <w>hardwired</w> directly into the main power supply.",
                            "target_lang_translations": {
                                "it": "Il sistema di allarme è <w>cablato</w> direttamente all'alimentazione principale."
                            }
                        },
                        {
                            "text": "We prefer a <w>hardwired</w> connection for a more stable internet.",
                            "target_lang_translations": {
                                "it": "Preferiamo una connessione <w>cablata</w> per un internet più stabile."
                            }
                        }
                    ],
                    "synonyms": [
                        "wired"
                    ],
                    "antonyms": [
                        "wireless"
                    ],
                    "common_phrases": [
                        "hardwired connection"
                    ],
                    "target_lang_definitions": {
                        "it": "Di dispositivi elettronici, collegati strettamente tramite cavi fisici."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "cablato",
                                "target_lang_sense_clarification": "collegato tramite cavi"
                            },
                            {
                                "target_lang_word": "collegato via cavo",
                                "target_lang_sense_clarification": "connessione fisica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99656271-d6f7-3ada-910a-ab4f2a4a54dc",
                    "sense_definition": "Having a fixed, unchangeable position on a screen or display.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fixed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The logo is <w>hardwired</w> to the top corner of the interface.",
                            "target_lang_translations": {
                                "it": "Il logo è <w>fissato</w> nell'angolo superiore dell'interfaccia."
                            }
                        },
                        {
                            "text": "You cannot move the <w>hardwired</w> menu bar on this screen.",
                            "target_lang_translations": {
                                "it": "Non puoi spostare la barra dei menu <w>fissa</w> su questo schermo."
                            }
                        }
                    ],
                    "synonyms": [
                        "fixed"
                    ],
                    "common_phrases": [
                        "hardwired position"
                    ],
                    "target_lang_definitions": {
                        "it": "Che ha una posizione fissa e non modificabile su uno schermo o un'interfaccia."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fisso",
                                "target_lang_sense_clarification": "non spostabile"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59f25bc4-e076-309f-a132-081e40aba513",
                    "sense_definition": "Past tense and past participle of <w>hardwire</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician <w>hardwired</w> the new security cameras yesterday.",
                            "target_lang_translations": {
                                "it": "Il tecnico ha <w>cablato</w> le nuove telecamere di sicurezza ieri."
                            }
                        },
                        {
                            "text": "They have <w>hardwired</w> all the sensors to the central hub.",
                            "target_lang_translations": {
                                "it": "Hanno <w>cablato</w> tutti i sensori all'hub centrale."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Tempo passato e participio passato di hardwire."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "cablato",
                                "target_lang_sense_clarification": "forma verbale"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}