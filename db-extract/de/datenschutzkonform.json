                ],
                "senses": [
                    {
                        "sense_id": "5efea549-777c-3743-9a3b-bc37197c7d40",
                        "entry_id": "4dc89263-195b-381d-b1a7-510677439531",
                        "glosses": [
                            "die Bestimmungen des Datenschutzes erfüllend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b323b8d-2156-4687-a941-2f18a46d95ed",
                                "sense_id": "5efea549-777c-3743-9a3b-bc37197c7d40",
                                "text": "„Dies geschieht jedoch nicht immer datenschutzkonform, was in den vergangenen Wochen auch die eine Beratergruppe der EU-Kommission für Google sollen demnächst unter die Lupe genommen werden.“"
                            },
                            {
                                "example_id": "c7534a99-cfcb-41e9-8caa-9be9fa0fb1e2",
                                "sense_id": "5efea549-777c-3743-9a3b-bc37197c7d40",
                                "text": "„Für Unternehmen, die schon bisher das Thema Datenschutz ernst genommen und datenschutzkonform gearbeitet haben, wird sich nicht viel ändern.“"
                            },
                            {
                                "example_id": "d9c06989-62be-4aea-90b9-d75bfc4ee092",
                                "sense_id": "5efea549-777c-3743-9a3b-bc37197c7d40",
                                "text": "„Ein datenschutzkonformer Betrieb einer Facebook-Fanpage ist für Behörden nicht möglich.“"
                            },
                            {
                                "example_id": "330a4407-b287-435e-90e3-adff57cabfc8",
                                "sense_id": "5efea549-777c-3743-9a3b-bc37197c7d40",
                                "text": "„Auch die datenschutzkonforme Dokumentation für die Kontaktnachverfolgung muss weiter gewährleistet werden.“"
                            },
                            {
                                "example_id": "dc560edc-8bdf-4c7c-a4e9-e41c64c71bab",
                                "sense_id": "5efea549-777c-3743-9a3b-bc37197c7d40",
                                "text": "„Die jetzt gefundene Lösung sei datenschutzkonform und ermögliche es, ‚größere Kontingente für Patienten mit kurzfristiger Terminanfrage‘ bereitzuhalten.“"
                            },
                            {
                                "example_id": "b93beddb-4ed3-416b-b458-1a1f09299d92",
                                "sense_id": "5efea549-777c-3743-9a3b-bc37197c7d40",
                                "text": "„Da auf diese Weise ein Profil der Bewegungen im Internet erstellt werden kann, das all die Seiten mit der Anwendung aufzeigt, die ein Nutzer besucht hat, entschied das deutsche Verbraucherschutzministerium, dass die Anwendung, bis zur Sicherstellung einer datenschutzkonformen Lösung, nicht mehr auf Websites von Behörden eingebunden werden soll.“"
                            }
                        ],
