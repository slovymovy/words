                "senses": [
                    {
                        "sense_id": "3a265e82-1341-388b-a2a7-2d47ad2f42be",
                        "entry_id": "5c23cacb-5726-3c6f-abc8-9e4cdc28abe0",
                        "glosses": [
                            "angeborene oder erworbene Störung der Wahrnehmung von Farben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb53c3b1-e6a0-4541-8756-73a2576c9568",
                                "sense_id": "3a265e82-1341-388b-a2a7-2d47ad2f42be",
                                "text": "„Ebenso erkannte Garron auf Anhieb die Farben richtig; es lagen keinerlei Anzeichen für Dyschromasie vor.“"
                            },
                            {
                                "example_id": "62d4c031-2632-4dde-a94d-ea39e6c2fa0f",
                                "sense_id": "3a265e82-1341-388b-a2a7-2d47ad2f42be",
                                "text": "„Die Dyschromasie der Haut und der Haare wird vermutlich durch den Mangel an Phenylalanin in der Nahrung verursacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
