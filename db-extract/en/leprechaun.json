        "de-extract.jsonl": [
            {
                "entry_id": "668d792f-813e-3d95-8171-8e6ee5eb5dc5",
                "word": "leprechaun",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9737fd9e-7b67-3ec2-a9e4-99771f87a634",
                        "entry_id": "668d792f-813e-3d95-8171-8e6ee5eb5dc5",
                        "glosses": [
                            "kleines, übernatürliches Wesen: Leprechaun, Kobold"
                        ],
                        "tags": [
                            "irische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "12c1e711-a067-45ad-b844-7cee20a03a0e",
                                "sense_id": "9737fd9e-7b67-3ec2-a9e4-99771f87a634",
                                "text": "The most famous creature in Irish mythology is surely the leprechaun.",
                                "translation": "Das berühmteste Geschöpf aus der irischen Mythologie ist sicherlich der Leprechaun."
                            },
                            {
                                "example_id": "4717b3cc-d35c-4ab8-ba47-34d1f437d351",
                                "sense_id": "9737fd9e-7b67-3ec2-a9e4-99771f87a634",
                                "text": "\"They all own pots of gold. If you ever find a leprechaun, you can ask him to give you some gold, but he will always try to trick you.\"",
                                "translation": "Sie alle besitzen Töpfe voll Gold. Solltest du je auf einen Leprechaun treffen, kannst du ihn bitten, dir etwas von dem Gold zu geben; aber er wird dabei immer versuchen, dich auszutricksen."
                            },
                            {
                                "example_id": "d133c944-efd4-46dc-9be3-e1c924b09d53",
                                "sense_id": "9737fd9e-7b67-3ec2-a9e4-99771f87a634",
                                "text": "\"As for Darby Kelleher, nothing could ever persuade him that it was not a real leprechaun he had caught, which by some villanous contrivance, on the Fairy's part, changed itself into the semblance of the doctor; and he often said the great mistake he made was \"givin' the little vagabone so much time, for that if he done right he'd have set about cutting his throat at wanst.\"\"",
                                "translation": "Was Darby Kelleher betrifft, so konnte ihn nichts je davon überzeugen, dass es kein echter Leprechaun war, den er gefangen hatte und der nur durch einen niederträchtigen Trick des Wesens wie der Doktor ausgesehen hatte; oft sagte er, sein größter Fehler sei gewesen, dem kleinen Strolch zu viel Zeit gegeben zu haben, statt es gleich richtig zu machen und ihm die Gurgel durchzuschneiden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
