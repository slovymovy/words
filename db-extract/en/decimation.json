                    },
                    {
                        "translation_id": "321ea472-8abe-41b9-b111-37f53090681a",
                        "source_entry_id": "1b79b2c3-b391-3a41-9421-7e0e83cdb491",
                        "source_sense_id": "2fd15d93-2986-346c-99d1-eb6999d84463",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Verminderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verminderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36cab640-d765-3f3b-b9a6-f97211944d3f",
                                        "entry_id": "7042303b-65f9-3acf-bd71-395d3f576b2c",
                                        "glosses": [
                                            "Verkleinerung der Anzahl oder Qualität von Dingen; Abschwächung von Empfindungen oder Gefühlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864b7a24-1d57-40d2-8273-46c61292d839",
                                                "sense_id": "36cab640-d765-3f3b-b9a6-f97211944d3f",
                                                "text": "Das Übereinkommen zur Verminderung der Staatenlosigkeit enthält Bestimmungen, welche die Staatenlosigkeit vermeiden soll."
                                            },
                                            {
                                                "example_id": "35404139-385f-438d-9cde-40364177af9f",
                                                "sense_id": "36cab640-d765-3f3b-b9a6-f97211944d3f",
                                                "text": "Die Richtlinie dient der integrierten Vermeidung und Verminderung der Umweltverschmutzung, die durch die im Anhang I aufgeführten Tätigkeiten verursacht wird, damit insgesamt ein hoher Umweltschutz erreicht wird."
                                            },
                                            {
                                                "example_id": "d3ca23a8-5229-4418-9e71-dac9400bf28a",
                                                "sense_id": "36cab640-d765-3f3b-b9a6-f97211944d3f",
                                                "text": "„Die Verminderung der Lasten in Unserer Stadt Regensburg und die Herstellung ihres öffentlichen Credits sind Gegenstände Unserer väterlichen Sorgfalt.“"
                                            },
                                            {
                                                "example_id": "a19abcf7-9c7f-4c5d-a7b1-ff7482235a6f",
                                                "sense_id": "36cab640-d765-3f3b-b9a6-f97211944d3f",
                                                "text": "Noch wichtiger aber ist, dass die Verminderung des registrierten Kapitals es der Firma erlauben könnte, Gewinne als Dividenden zurückzuführen."
                                            },
                                            {
                                                "example_id": "ce28baf0-d549-4ac8-9437-608e1ae42f9e",
                                                "sense_id": "36cab640-d765-3f3b-b9a6-f97211944d3f",
                                                "text": "Das Werk stellt die wichtigsten Ergebnisse und Erkenntnisse im Zusammenhang mit Erzeugung, Abstrahlung, Ausbreitung, Prognose und Verminderung des Verkehrslärms dar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb892c28-7009-4016-af4b-151154f31b53",
                        "source_entry_id": "1b79b2c3-b391-3a41-9421-7e0e83cdb491",
                        "source_sense_id": "2fd15d93-2986-346c-99d1-eb6999d84463",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "décimation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décimation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7c97e13-098a-3d25-8d62-af60029fca59",
                                        "entry_id": "7136fe89-a9ff-3995-a33a-811f6027fb02",
                                        "glosses": [
                                            "Châtiment militaire, en usage chez les Romains, qui consistait à punir de mort un soldat sur dix, lorsqu’il y en avait un grand nombre qui avaient commis quelque lâcheté ou manqué à l’obéissance ; on les faisait tirer au sort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cbe19eb-c5f0-4fbf-8fe9-0dbe068d9298",
                                                "sense_id": "b7c97e13-098a-3d25-8d62-af60029fca59",
                                                "text": "On voit dans Tite-Live un exemple de la décimation dès les commencements de la république."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "856b17e9-3882-3fec-a764-c010c8efd656",
                                        "entry_id": "7136fe89-a9ff-3995-a33a-811f6027fb02",
                                        "glosses": [
                                            "Mise à mort aveugle d’un large nombre d’individus, telle une armée ou une partie d’une population spécifique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ade2d15e-3d9e-4556-90d0-55f0c1046a26",
                                                "sense_id": "856b17e9-3882-3fec-a764-c010c8efd656",
                                                "text": "La concentration de la population juive d’Europe sur l’un de ces territoires aurait entraîné une décimation considérable ; cette solution n’en était pas moins différente, par sa nature, de l’extermination."
                                            },
                                            {
                                                "example_id": "8a2ec41c-a734-482e-9f8f-db6730600e22",
                                                "sense_id": "856b17e9-3882-3fec-a764-c010c8efd656",
                                                "text": "« Les développements auxquels nous assistons témoignent de tentatives de déplacer les Palestiniens vers l’Égypte, qu’ils y restent ou qu’ils soient réinstallés ailleurs (...) La décimation du nord de Gaza et le déplacement de millions de Gazaouis vers le sud constituent la première étape d’un tel scénario, et elle est déjà achevée », écrit dans le LA Times, Philippe Lazzarini, Commissaire général de l’Office de secours et de travaux des Nations Unies pour les réfugiés de Palestine dans le Proche-Orient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6164ab-7b8c-39d7-b88d-03c407c74ffc",
                                        "entry_id": "7136fe89-a9ff-3995-a33a-811f6027fb02",
                                        "glosses": [
                                            "Destruction massive et indifférenciée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8db6e70f-9925-49e7-b36f-6f58e0c3cf03",
                                                "sense_id": "7c6164ab-7b8c-39d7-b88d-03c407c74ffc",
                                                "text": "« La décimation du système de santé de Gaza est une tragédie », a déclaré le directeur général de l’OMS Tedros Adhanom Ghebreyesus sur X."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
