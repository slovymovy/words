                        "examples": [
                            {
                                "example_id": "dd638d85-d705-4060-af4d-2db300ba2a7f",
                                "sense_id": "7dd2d126-be2a-3a8a-97c4-eef7bef81e85",
                                "text": "Pour distinguer les voyelles des consonnes « h », « r », « l », « w » et « y », il faut recourir à un autre trait caractérisant les voyelles : le trait de syllabicité."
                            },
                            {
                                "example_id": "89513ad8-f98b-46b3-a6ee-6eeecef62928",
                                "sense_id": "7dd2d126-be2a-3a8a-97c4-eef7bef81e85",
                                "text": "Ainsi, le fait que la syllabicité des nasales et des liquides soit prédite en fonction de leur position dans la syllabe, come nous l’avons vu plus haut, est un résultat qui ne déchaînera sans doute pas une polémique échevelée."
                            }
                        ]
