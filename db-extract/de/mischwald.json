                        "form": "die Mischwälder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "532f7531-e84f-3d52-8ae7-c8fda7479bca",
                        "entry_id": "44b9f08e-e27f-3c98-a56d-cb875197d7c3",
                        "glosses": [
                            "ein Wald, in dem sowohl Laubbäume als auch Nadelbäume vorkommen"
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "6c6b7ba5-2e65-4beb-8427-cb52c2984897",
                                "sense_id": "532f7531-e84f-3d52-8ae7-c8fda7479bca",
                                "text": "„Der Mischwald ist reicher als der eintönige, nur aus einer Baumart bestehende ‚Kulturwald‘.“"
                            },
                            {
                                "example_id": "eb15f94a-a8a5-437c-bb56-814747a484ca",
                                "sense_id": "532f7531-e84f-3d52-8ae7-c8fda7479bca",
                                "text": "„Heute noch erkennbar: der Rest eines einst gewaltigen Walls, der sich im Schatten des bayerischen Mischwalds erhebt.“"
                            },
                            {
                                "example_id": "b4f6d966-e97d-4c3f-89fb-a50ed9ec0b91",
                                "sense_id": "532f7531-e84f-3d52-8ae7-c8fda7479bca",
                                "text": "„So wachsen auf vielen ehemaligen Fichtenforsten junge Mischwälder heran, die von Laubbäumen geprägt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
