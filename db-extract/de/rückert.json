                ],
                "senses": [
                    {
                        "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                        "entry_id": "617d2eb4-e130-3081-bfc1-84b54f709714",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3b5e2b-dbcb-4fcc-b934-54b7768439eb",
                                "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                                "text": "Herr Rückert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4f1efd2f-9c9a-4ef1-bc99-93e9c7a9f6a6",
                                "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                                "text": "Die Rückerts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "4030a568-4f6a-406d-b470-ccddc46e41a8",
                                "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                                "text": "Frau Rückert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "27e9f090-e253-448d-9973-15a89a50c7fb",
                                "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                                "text": "Der Rückert trägt nie die Pullover, die die Rückert ihm strickt."
                            },
                            {
                                "example_id": "62eee6cc-e577-4b9a-b56a-a04a04aaf0ac",
                                "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rückert kommt, geht der Herr Rückert.“"
                            },
                            {
                                "example_id": "a5d4a2d5-d611-49f6-be43-e8fea0fbe0f8",
                                "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                                "text": "Rückert kommt und geht."
                            },
                            {
                                "example_id": "3157cf1e-5cff-47f0-857b-4b871da932d0",
                                "sense_id": "0b1ac807-faba-30d2-8932-c3f4deebc26b",
                                "text": "Rückerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
