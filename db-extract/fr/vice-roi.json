                    }
                ],
                "senses": [
                    {
                        "sense_id": "501894ba-97b7-3f93-b0c4-30283a99d99f",
                        "entry_id": "eac3c116-a48c-376c-8eb0-552757b0757e",
                        "glosses": [
                            "Délégué direct de la puissance royale dans un pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51ab8914-58cf-4cc1-8be0-a6c3782923c5",
                                "sense_id": "501894ba-97b7-3f93-b0c4-30283a99d99f",
                                "text": "Le vice-roi des Indes."
                            },
                            {
                                "example_id": "f49deb6d-eb30-4ddb-ae89-829d8ff2d2e7",
                                "sense_id": "501894ba-97b7-3f93-b0c4-30283a99d99f",
                                "text": "Il amenait deux missionnaires envoyés par le vice-roi du Pérou."
                            },
                            {
                                "example_id": "c0262bb0-7043-4f57-bc8c-79c8478485fb",
                                "sense_id": "501894ba-97b7-3f93-b0c4-30283a99d99f",
                                "text": "Le vice-roi Saïd Pacha dépensera une fortune pour ce spectacle : un million de piastres, la valeur, en 1861, de 12 800 napoléons d'or. Un canal vaut bien un opéra !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f72c6027-2bee-3623-b71a-24a0a7095ca3",
                        "entry_id": "eac3c116-a48c-376c-8eb0-552757b0757e",
                        "glosses": [
                            "Papillon nord-américain de nom scientifique Limenitis archippus dont les ailes sont orange avec des nervures noires et une marge noire marquée d'une ligne de points blancs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41b1a1c-2ef3-4eca-a912-a61109e71df7",
                                "sense_id": "f72c6027-2bee-3623-b71a-24a0a7095ca3",
                                "text": "Ensuite, Jane Brower donne aux quatre geais un papillon du groupe des vice-rois, dénommé Limenitis archippus, qui est réputé mangeable mais qui ressemble curieusement aux Danaus plexippus. Elle constate alors que les geais qui ont goûté à ce dernier refusent les vice-rois à simple vue.."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e960d889-ee96-466a-8677-16c26f747c5e",
                        "source_entry_id": "eac3c116-a48c-376c-8eb0-552757b0757e",
                        "source_sense_description": "Noblesse",
                        "target_lang_word": "Vizekönig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vizekönig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                        "entry_id": "15c03e77-f615-3c66-9c2c-05524a16f47e",
                                        "glosses": [
                                            "Person, die einen Monarchen vertritt, Stellvertreter eines Monarchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447387f1-6649-4a63-928e-a4df0462aefd",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Der berühmte indische Poet Mohammed Eqbal beschrieb Afghanistan als das ‹Herz Asiens›, während Lord Curzon, der britische Vizekönig Indiens im frühen 20. Jahrhundert, Afghanistan den ‹Hahnenkampfplatz Asiens› nannte.“"
                                            },
                                            {
                                                "example_id": "d1432b87-9ddb-4914-8a2a-e760ce978988",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Und der Taiko persönlich hatte unseren Vizekönig in Manila gebeten, Franziskanermönche sowie einen Gesandten nach Japan zu schicken.“"
                                            },
                                            {
                                                "example_id": "bbc76af3-0620-4392-8aa6-4c82bbf4f797",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Cortés befand sich zu der Zeit in Spanien, und es war noch offen, wer zum Vizekönig, zum Repräsentanten des Königs, ernannt werden würde.“"
                                            },
                                            {
                                                "example_id": "d1644b15-97ec-40a4-b869-3fcbf508a9e0",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Sie haben sich schnell an die neuen Verhältnisse der spanischen Kolonialgesellschaft angepasst und diese bald schon ihrerseits mitgeprägt, wenn auch nur als Untertanen der Vizekönige in Mexiko und des spanischen Königs im fernen Europa.“"
                                            },
                                            {
                                                "example_id": "6536f1de-cce3-4939-8f79-c0a63eb9915d",
                                                "sense_id": "55fa4031-1d68-33d2-a9be-427291da69af",
                                                "text": "„Der Codex Mendoza entstand um 1541 im Auftrag des spanischen Vizekönigs und enthielt eine aztekische Darstellung der eigenen Geschichte sowie wichtige Informationen zur Verwaltung und Organisation des Reichs der Mexica.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87766afe-ccd6-4942-bf31-ec3f7d28d719",
                        "source_entry_id": "eac3c116-a48c-376c-8eb0-552757b0757e",
                        "source_sense_description": "Noblesse",
                        "target_lang_word": "viceroy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viceroy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e3ad48c-bb3e-3f9f-8676-e14534e3a83d",
                                        "entry_id": "92520895-1feb-37b8-89c1-fa70230ebc37",
                                        "glosses": [
                                            "One who governs a country, province, or colony as the representative of a monarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cecc7179-2795-4639-83e9-b06ea4e08397",
                                                "sense_id": "8e3ad48c-bb3e-3f9f-8676-e14534e3a83d",
                                                "text": "Ireland was governed by a Viceroy representing the English King/Queen when it was part of the United Kingdom of Great Britain and Ireland."
                                            },
                                            {
                                                "example_id": "907432be-c658-40cb-9dd0-356526babd13",
                                                "sense_id": "8e3ad48c-bb3e-3f9f-8676-e14534e3a83d",
                                                "text": "The Viceroy's on board - tends to liven things up."
                                            },
                                            {
                                                "example_id": "a9ea41ba-aa31-43c4-bdfc-7ef52ef7e664",
                                                "sense_id": "8e3ad48c-bb3e-3f9f-8676-e14534e3a83d",
                                                "text": "Mike Davis, a former Senate GOP staffer on Supreme Court nominations and current “viceroy” of Trumpworld, wrote that Alito was “gleefully packing up his chambers” after the 2024 election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba8844ac-6f6f-35da-bc9f-3e4e767e23d7",
                                        "entry_id": "92520895-1feb-37b8-89c1-fa70230ebc37",
                                        "glosses": [
                                            "A zongdu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eef468cf-09ce-37d4-8b91-a526cd025a69",
                                        "entry_id": "92520895-1feb-37b8-89c1-fa70230ebc37",
                                        "glosses": [
                                            "An orange and black North American butterfly (Limenitis archippus), so named because it is similar to, but smaller than, the monarch butterfly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
