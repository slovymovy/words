                        "source_entry_id": "f9d5a6d9-1bac-3fb0-a351-0ff656fdce59",
                        "source_sense_id": "bbb12a70-56c8-3b8f-a18f-be3ddd434fe4",
                        "target_lang_word": "vexillologic",
                        "target_lang_code": "en",
