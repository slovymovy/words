                                "target_lang_sense_clarification": "в роли причастия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb7a138a-2a61-3e47-9e60-40fccec318a4",
                    "sense_definition": "A cry of joy, pleasure, or satisfaction, typically made by an infant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tiny mouth is uttering the most satisfied of <w>crowings</w>, and her eyes have that pure, soft expression never seen except in baby eyes.",
                            "target_lang_translations": {
                                "ru": "Крошечный ротик издает самое довольное <w>гуление</w>, а ее глаза светятся тем чистым, нежным выражением, которое бывает только у младенцев."
                            }
                        },
                        {
                            "text": "We were delighted by the happy <w>crowing</w> of the baby playing with her new toys.",
                            "target_lang_translations": {
                                "ru": "Мы были в восторге от счастливого <w>лепета</w> малышки, играющей со своими новыми игрушками."
                            }
                        }
                    ],
                    "synonyms": [
                        "cooing",
                        "gurgling"
                    ],
                    "common_phrases": [
                        "happy crowing of babies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Радостный крик, гуление или лепет, обычно издаваемый младенцем от удовольствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гуление",
                                "target_lang_sense_clarification": "радостные звуки младенца"
                            },
                            {
                                "target_lang_word": "радостный лепет",
                                "target_lang_sense_clarification": "звуки удовольствия ребенка"
                            },
                            {
                                "target_lang_word": "повизгивание от восторга",
                                "target_lang_sense_clarification": "выражение детской радости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
