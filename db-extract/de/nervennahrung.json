                ],
                "senses": [
                    {
                        "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                        "entry_id": "e0141582-d863-3482-92ea-89b2634e7e44",
                        "glosses": [
                            "Essen, das in Stresssituationen der Beruhigung dienen soll, meist aber viele Kalorien hat"
                        ],
                        "tags": [
                            "euphemistisch"
                        ],
                        "examples": [
                            {
                                "example_id": "76d69c4d-64a4-421b-b45a-93324f029c68",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "In der Vorbereitung auf eine Prüfung kann Nervennahrung ein bisschen helfen."
                            },
                            {
                                "example_id": "3196b098-d8dd-4263-8fb9-d2b3de355350",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "Meine Nervennahrung ist Schokolade."
                            },
                            {
                                "example_id": "64b288f5-3fc7-44cd-a0bf-8e61e11fe8cb",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "Süßigkeiten, wie Schokolade, Gummibärchen oder Kuchen, sollen Nervennahrung sein, in Wahrheit sind es reine Kalorienbomben."
                            },
                            {
                                "example_id": "af6fd447-e687-466d-9863-cf4fbfb2641c",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "„Nüsse sind gesund und eignen sich gut als Nervennahrung.“"
                            },
                            {
                                "example_id": "dd3e9543-223c-4dc8-82fe-10b1db534d66",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "„Ihr hoher Gehalt an Magnesium und Vitamin B machen Nüsse zur \"Nervennahrung\", Ballaststoffe regen die Verdauung an.“"
                            },
                            {
                                "example_id": "6e22189b-c712-48e2-8dcd-853eabda95fc",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "„Harte Schale, gesunder Kern: Walnüsse gelten als Nervennahrung, regen die Verdauung an und können auch zu einer guten Nachtruhe verhelfen.“"
                            },
                            {
                                "example_id": "a0227d00-8aaf-4c17-99db-1f1a74ce8d87",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "„Eine Tasse Kakao mit Milch ist also auch eine tolle „Nervennahrung“, besonders in der kalten Jahreszeit.“"
                            },
                            {
                                "example_id": "322a41d4-a1c5-4e9a-a21c-ad5c427b57e5",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "„Der Test zieht sich über den ganzen Tag hin. Deswegen ist es wichtig, dass ihr euch wohl fühlt. Schnappt euch bequeme Klamotten, genügend zu Trinken und viel Nervennahrung.“"
                            },
                            {
                                "example_id": "d24773b7-d283-4571-86fe-b540dcea7509",
                                "sense_id": "4e006afa-7675-3a02-9d90-f553ef13b071",
                                "text": "„Die kleinen Eichhörnchen unter den Studis, die während der Klausur was zum Snacken brauchen, sollten sich an Nüsse als Nervennahrung halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
