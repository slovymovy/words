                    ]
                },
                {
                    "sense_id": "50209b28-3228-30ef-93a6-10ac95738c1a",
                    "sense_definition": "Personne qui excelle remarquablement dans un art, une science ou une discipline, et qui sert de référence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expertise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tableau remarquable a été peint par un grand <w>maître</w> de la Renaissance."
                        },
                        {
                            "text": "Il s'entraîne depuis des années sous la direction d'un <w>maître</w> d'échecs renommé."
                        }
                    ],
                    "common_phrases": [
                        "grand maître",
                        "maître de conférences"
                    ]
                },
                {
                    "sense_id": "fd5d64f0-6ce7-322e-86c8-e35e610ebee2",
                    "sense_definition": "Personne qui a le commandement, qui exerce une autorité ou une domination sur d'autres ou sur un lieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine est resté seul <w>maître</w> à bord après l'incident."
                        },
                        {
                            "text": "Il veut être le <w>maître</w> absolu de son propre destin."
                        }
                    ],
                    "synonyms": [
                        "chef",
                        "dirigeant"
                    ],
                    "common_phrases": [
                        "maître à bord",
                        "maître de maison",
                        "maître des lieux"
                    ]
                },
                {
                    "sense_id": "ce8339c2-d824-305b-948a-b88e8aedee56",
                    "sense_definition": "Guide intellectuel ou spirituel qui inspire et forme des disciples.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe est considéré comme le véritable <w>maître</w> à penser de toute cette génération."
                        },
                        {
                            "text": "Le jeune chercheur a toujours suivi fidèlement la méthode de son premier <w>maître</w>."
