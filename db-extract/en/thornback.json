                        "glosses": [
                            "A woman over a certain age (variously 26 or 30) who has never married, older than a spinster."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9f3457f4-6d0e-4385-bff9-e1d6a04e1755",
                                "sense_id": "b65b8728-c073-3cd3-917f-933c557509da",
                                "text": "[A] society of honest gentlemen [is holding a lottery] for the benefit of all single ladies, widows, maids, or thornbacks […]"
                            },
                            {
                                "example_id": "3bab5205-0903-4cde-a79d-81396498f18e",
                                "sense_id": "b65b8728-c073-3cd3-917f-933c557509da",
                                "text": "Spinsters. — In a society where marriages were formed very early, girls often wedding at sixteen or under, […] At the age of thirty a spinster was called a \"thornback ,” but bachelors and thornbacks were not the only people who […]"
                            },
                            {
                                "example_id": "d6bb2d32-e38c-4038-af64-0352e1ca7816",
                                "sense_id": "b65b8728-c073-3cd3-917f-933c557509da",
                                "text": "\"And I'll be a thornback spinster! Oh, I'd rather die of the pox than that!\" She bolted away to spill her bitter tears out of doors in a place where no one could observe her. Her bold adventure had suddenly turned against her."
                            }
                        ]
