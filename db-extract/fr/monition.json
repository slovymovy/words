                ],
                "senses": [
                    {
                        "sense_id": "35694a2b-6f80-32f9-9a7e-17aaa27fe472",
                        "entry_id": "bc291ffe-655a-3fd0-b7bc-2b016ab7d830",
                        "glosses": [
                            "Avertissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58630ee3-da47-462e-8598-02f5b1651a23",
                                "sense_id": "35694a2b-6f80-32f9-9a7e-17aaa27fe472",
                                "text": "Je vis dans cette dent cassée une monition obscure que je comprendrais plus tard."
                            },
                            {
                                "example_id": "55a8f3d4-7ca4-4b88-b1ed-220272ad3d7c",
                                "sense_id": "35694a2b-6f80-32f9-9a7e-17aaa27fe472",
                                "text": "Elle se bâtit pour cela son propre microcosme, espace ouvert aux vérités les plus secrètes, sur la toile d’internet, loin des ciseaux d’Anastasie, des monitions du PAF, du corps des médiacrates qui distribuent l’imprimatur."
                            }
                        ]
                    },
                    {
                        "sense_id": "27b03887-2c2a-3f26-bc0e-c9e092a03c0e",
                        "entry_id": "bc291ffe-655a-3fd0-b7bc-2b016ab7d830",
                        "glosses": [
                            "Avertissement juridique qui se fait en certains cas par l’autorité de l’évêque, avant de procéder à l’excommunication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c92a4c8-5808-4de3-955b-0ffd8017fecb",
                                "sense_id": "27b03887-2c2a-3f26-bc0e-c9e092a03c0e",
                                "text": "On a fait jusqu’à trois monitions."
                            },
                            {
                                "example_id": "5eb02db8-d7a9-40bb-8cf0-6fe391b4bf01",
                                "sense_id": "27b03887-2c2a-3f26-bc0e-c9e092a03c0e",
                                "text": "Procéder à la troisième monition."
                            },
                            {
                                "example_id": "ddc57ee8-cdf9-4b97-80a1-fd5271e7f2c5",
                                "sense_id": "27b03887-2c2a-3f26-bc0e-c9e092a03c0e",
                                "text": "Pour la troisième et péremptoire monition."
                            }
                        ]
                    }
