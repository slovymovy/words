                            {
                                "example_id": "a8af1df9-8918-4637-b85c-dc9e07ac2182",
                                "sense_id": "7bc151e0-99ef-34b8-815e-8761eda6195f",
                                "text": "Minister Dekker voor Rechtsbescherming wil de verjaringstermijn voor het ten uitvoer leggen van straffen afschaffen. Zo wil hij voorkomen dat veroordeelden hun straf ontlopen door lang genoeg uit handen van de politie te blijven."
                            },
                            {
                                "example_id": "a8fb7b98-c361-4d27-9988-6419cc8aed8d",
                                "sense_id": "7bc151e0-99ef-34b8-815e-8761eda6195f",
                                "text": "\"De verjaringstermijnen zijn zo ongelooflijk lang, voor een straf waar acht jaar op staat moet je 26 jaar uit handen van justitie blijven.\" Daarnaast denkt Van Oosten dat het contraproductief werkt om iemand na jaren - als diegene zijn leven weer op orde heeft - nog een celstraf te laten uitzitten."
                            }
