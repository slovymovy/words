                                                "sense_id": "c4378824-03cd-3ebb-a84a-b11b8d676481",
                                                "text": "Mein Sekretär nimmt jeden Tag 100 Anrufe entgegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68c91799-e14b-302c-9345-5284289fb653",
                                        "entry_id": "8a5621ed-e14c-3a85-b6fc-b358461d608e",
                                        "glosses": [
                                            "Person, die in einer Organisation an leitender Stelle arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e085e90-bb0e-4e46-85c5-44f58b8c3159",
                                                "sense_id": "68c91799-e14b-302c-9345-5284289fb653",
                                                "text": "Er ist der Sekretär einer bekannten Partei."
                                            },
                                            {
                                                "example_id": "4763acd0-cd1e-41c9-8496-cbf242f5437a",
                                                "sense_id": "68c91799-e14b-302c-9345-5284289fb653",
                                                "text": "„Wiederholt hatte Robert in den nächsten Tagen die Absicht gehabt, eine Unterredung mit dem Sekretär der Präfektur herbeizuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dedd6e9b-5f94-3bdb-b895-21abd5ad4bfc",
                                        "entry_id": "8a5621ed-e14c-3a85-b6fc-b358461d608e",
                                        "glosses": [
                                            "Beamtenposition im mittleren Dienst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8599d1ed-2d81-41be-8e21-6aa31624e2f7",
                                                "sense_id": "dedd6e9b-5f94-3bdb-b895-21abd5ad4bfc",
                                                "text": "Als es noch Postbeamte gab, gab es auch den Rang eines Postsekretärs."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9f8b1c96-6723-3af1-8456-d39dbeb18378",
                                        "entry_id": "8a5621ed-e14c-3a85-b6fc-b358461d608e",
                                        "glosses": [
                                            "Möbelstück mit – oft ausklappbarer – Schreibplatte und Aufbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe97534d-0780-4dd0-a59b-9faab4f41f36",
                                                "sense_id": "9f8b1c96-6723-3af1-8456-d39dbeb18378",
                                                "text": "Unser Sekretär muss dringend vom Tischler neu aufgearbeitet werden."
                                            },
                                            {
                                                "example_id": "51fa38bb-4729-4ef6-910d-2b99436a3ea4",
                                                "sense_id": "9f8b1c96-6723-3af1-8456-d39dbeb18378",
                                                "text": "„Als die Eltern zuvor laut geworden waren, hatte der Vater im Hausmantel an seinem Sekretär gesessen und in ein Notenheft geschrieben.“"
                                            },
                                            {
                                                "example_id": "7d967832-8c3e-4368-851a-b435bdb5dd96",
                                                "sense_id": "9f8b1c96-6723-3af1-8456-d39dbeb18378",
                                                "text": "„Danach genossen sie die Stille, die nur vom kaum hörbaren Schlag der kleinen Uhr auf dem Sekretär durchtickt wurde.“"
                                            },
                                            {
                                                "example_id": "5bccc9cb-d98b-4acb-8bd0-dc30833f534f",
                                                "sense_id": "9f8b1c96-6723-3af1-8456-d39dbeb18378",
                                                "text": "„In seinem grossen über und über mit persischen Teppichen, Bärenfellen und Waffen geschmückten Kabinett sass Dolochow in hohen Stiefeln und einem reisemässigen tartarischen Halbrock vor dem geöffneten Sekretär, auf dessen Klappe Banknotenpäckchen und mit Zahlenkolonnen bedeckte Papiere lagen.“"
                                            },
                                            {
                                                "example_id": "9e0dd619-d8cf-4811-9d05-26ee3f1302e3",
                                                "sense_id": "9f8b1c96-6723-3af1-8456-d39dbeb18378",
                                                "text": "„Man führte mich in eine Flucht von drei Räumen; das Schlafzimmer war mit Damast tapeziert und enthielt ein Himmelbett und einen geöffneten Sekretär mit allem nötigen Schreibgerät.“"
                                            },
                                            {
                                                "example_id": "c13b7acc-d3db-47f5-97c0-d6fc0fc490cc",
                                                "sense_id": "9f8b1c96-6723-3af1-8456-d39dbeb18378",
                                                "text": "„Im Flur stand ein antiker französischer Sekretär mit geschwungenen Beinen, der viel zu fragil war, als dass man ernsthaft hätte daran arbeiten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fc339464-0594-3d94-b26c-26e84b8b2cc4",
                                        "entry_id": "8a5621ed-e14c-3a85-b6fc-b358461d608e",
