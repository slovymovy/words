                "senses": [
                    {
                        "sense_id": "6e2b7828-6386-3e36-977d-7497164c39f0",
                        "entry_id": "7dfabfe0-618f-3bb4-9189-12af9b75e257",
                        "glosses": [
                            "устар. тот, кто совершает противозаконные поступки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e605f1d4-b1ed-441e-bc3e-33f6a86a63c0",
                                "sense_id": "6e2b7828-6386-3e36-977d-7497164c39f0",
                                "text": "И чем меньше беззаконники погибают от правосудия, тем больше погибают невинные от беззаконников."
                            },
                            {
                                "example_id": "dfaea973-f5a6-4ac3-b669-49649e413c5d",
                                "sense_id": "6e2b7828-6386-3e36-977d-7497164c39f0",
                                "text": "Закон ― с вами, вы идёте против беззаконников, щадить их преступно, их надо искоренять, как вредную траву."
                            }
                        ]
                    }
                ],
