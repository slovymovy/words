                        "examples": [
                            {
                                "example_id": "a8a1fdb0-4546-4188-83ae-edc34773d228",
                                "sense_id": "eca313fd-e1ae-3aad-b6ca-49e4e6bd231f",
                                "text": "En daartussenin de dorpjes, de weiden waar schapen en koeien grazen, de akkers, landerijen en boomgaarden waar al die producten groeien die hun weg vinden naar de markten, bars en onovertroffen restaurants."
                            },
                            {
                                "example_id": "e7d148e1-381a-498e-9524-5fe1113dc909",
                                "sense_id": "eca313fd-e1ae-3aad-b6ca-49e4e6bd231f",
                                "text": "De band staat vooral bekend om hun scherpe en humoristische teksten, veelal in het dialect, over thema's rondom het leven in het oosten van Nederland. Met een mix van rock, blues, country en alles wat daartussenin zit was Dokter Watjes de laatste jaren een graag geziene gast op festivals als Mañana Mañana, de Zwarte Cross en tal van kroegen in de omliggende regio."
                            },
                            {
                                "example_id": "884d1b1d-0d9a-4fe6-ad13-4a8940c2a5f5",
                                "sense_id": "eca313fd-e1ae-3aad-b6ca-49e4e6bd231f",
                                "text": "Uit de knipoog die volgde sprak vijfendertig jaar van geluk, verdriet en alles wat daartussenin zat."
                            }
                        ]
                    }
