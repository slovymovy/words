                                "sense_id": "40c0a80e-680c-3c00-a54a-39442329aeb0",
                                "text": "In de lessen zedenleer wordt ethiek en moraliteit besproken.",
                                "translation": "Moral philosophy and ethics are discussed in the classes of moral philosophy.",
                                "english": "Moral philosophy and ethics are discussed in the classes of moral philosophy."
                            },
                            {
                                "example_id": "af5cfd66-15f6-4ae5-955c-4cc911d66c78",
                                "sense_id": "40c0a80e-680c-3c00-a54a-39442329aeb0",
                                "text": "Zedenleer onderzoekt de principes die ons gedrag en onze keuzes beïnvloeden.",
                                "translation": "Moral philosophy examines the principles that influence our behavior and choices.",
                                "english": "Moral philosophy examines the principles that influence our behavior and choices."
                            },
                            {
                                "example_id": "d851569d-87e9-453f-a5c5-e3746a33c3f4",
                                "sense_id": "40c0a80e-680c-3c00-a54a-39442329aeb0",
                                "text": "Zedenleer is een belangrijk vakgebied dat ons helpt nadenken over wat juist en fout is.",
                                "translation": "Moral philosophy is an important field that helps us reflect on what is right and wrong.",
                                "english": "Moral philosophy is an important field that helps us reflect on what is right and wrong."
                            }
                        ]
                    },
