                            "target_lang_translations": {
                                "en": "The <w>Royal</w> Dutch Football Association organizes all competitions in the country."
                            }
                        },
                        {
                            "text": "Dit bedrijf mag de titel <w>koninklijk</w> voeren vanwege zijn honderdjarig bestaan.",
                            "target_lang_translations": {
