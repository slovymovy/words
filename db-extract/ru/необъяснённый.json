                "senses": [
                    {
                        "sense_id": "267b7201-ef0c-3a66-b150-f49496294e79",
                        "entry_id": "48998df7-5995-3a23-9a72-f84f5fe77674",
                        "glosses": [
                            "страд. прич. прош. вр. от не объяснить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "47d2001d-b8dc-4ead-94dd-7f3da68bd572",
                                "sense_id": "267b7201-ef0c-3a66-b150-f49496294e79",
                                "text": "Как много в ней осталось необъяснённого, непонятого, недосказанного."
                            },
                            {
                                "example_id": "c2a5f2e4-7e85-43a8-a500-b61f1a6e15d1",
                                "sense_id": "267b7201-ef0c-3a66-b150-f49496294e79",
                                "text": "Она улетела, а тоска осталась необъяснённой, ибо не могла же её объяснить мелькнувшая как молния и тут же погасшая какая-то короткая другая мысль: «Бессмертие… пришло бессмертие…»"
                            },
                            {
                                "example_id": "6a237f05-d7d4-4039-8b1e-f9bb722c20d1",
                                "sense_id": "267b7201-ef0c-3a66-b150-f49496294e79",
                                "text": "На данный момент полицейские называют её кончину необъясненной."
                            }
                        ]
                    }
                ],
