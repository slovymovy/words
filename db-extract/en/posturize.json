                    {
                        "sense_id": "6c19f9a8-d496-326f-92cd-e0e462e8fc91",
                        "entry_id": "f3316fbe-68fe-3bf2-85d2-acea4376898a",
                        "glosses": [
                            "To posture."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2b0ca13e-904b-4c12-a3f3-536bc6c292df",
                                "sense_id": "6c19f9a8-d496-326f-92cd-e0e462e8fc91",
                                "text": "Nobber has no small opinion of himself: he considers himself the Adonis of the Pondaati eleven, and he contemplates society as though it were Venus, and it was his mission to posturize before it, and coquette and toy with it."
                            },
                            {
                                "example_id": "dca38e86-9c21-4a59-8d36-f1c942554e4b",
                                "sense_id": "6c19f9a8-d496-326f-92cd-e0e462e8fc91",
                                "text": "He did not destroy the reality by the exhibition of more energy than belongs to the exhausted powers of a dying man; he did not caricature and posturize in the representation of this awful close of human life."
                            }
                        ]
                    }
