                "translations": [
                    {
                        "translation_id": "39ca7502-afdc-4119-8723-c26ee94627ce",
                        "source_entry_id": "8f0d2d50-4856-3784-ac08-91c86f501aaf",
                        "source_sense_description": "decorated ceiling",
                        "target_lang_word": "Plafond",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plafond",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab28eb3-aa67-320b-a447-b28dad161bc4",
                                        "entry_id": "3310b5cf-e9a4-39d3-809d-1331e723a9f9",
                                        "glosses": [
                                            "Flachdecke, (Zimmer)Decke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ba4538d-2936-4840-ab42-e758563f3353",
                                                "sense_id": "2ab28eb3-aa67-320b-a447-b28dad161bc4",
                                                "text": "„Zu sehen ist \"Illegal\" auch am 1. März um 19:30 Uhr im Schwarzen Salon unterm Plafond des Wiener Volkstheaters.“"
                                            },
                                            {
                                                "example_id": "a2c235e9-399d-478c-a41a-8bb7e41f1dea",
                                                "sense_id": "2ab28eb3-aa67-320b-a447-b28dad161bc4",
                                                "text": "„Der Plafond war zur Hälfte mit Weingirlanden geschmückt und mit Bildern, die in flüchtig hingeworfener Manier Frauen mit griechischem Profil darstellten, umringt von Kindern, die aus den Strahlen einer gewaltigen Sonne hervortraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7483ed6-fe90-3faf-bcec-4bcd8cc2dad0",
                                        "entry_id": "3310b5cf-e9a4-39d3-809d-1331e723a9f9",
                                        "glosses": [
                                            "obere Grenze bei Kreditvergabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7d9fac-f213-406d-9fbb-e0a7b073f0a2",
                                                "sense_id": "a7483ed6-fe90-3faf-bcec-4bcd8cc2dad0",
                                                "text": "So bilden die Arbeits- und Lebensvorstellungen einen breiten Plafond, auf den sich das Fernsehen bezieht."
                                            },
                                            {
                                                "example_id": "06166f82-458b-468f-8120-9c0e956d1453",
                                                "sense_id": "a7483ed6-fe90-3faf-bcec-4bcd8cc2dad0",
                                                "text": "„Der Etat des Bundesministeriums der Verteidigung liegt für das Jahr 2006 […] rund 3 Mrd. € unter dem Plafond des Jahres 1991.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e463125-cacd-4c68-a165-aae2215ea193",
                        "source_entry_id": "8f0d2d50-4856-3784-ac08-91c86f501aaf",
