    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "34134270-abad-3746-822d-d2e87dff22e2",
                "word": "gentlemanly",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "19652575-45b0-4f8a-accd-5e84a5a174cc",
                        "entry_id": "34134270-abad-3746-822d-d2e87dff22e2",
                        "tags": [
                            "comparative"
                        ],
                        "form": "gentlemanlier"
                    },
                    {
                        "form_id": "091a7c28-8cb0-45d0-a8c1-92733b4538a0",
                        "entry_id": "34134270-abad-3746-822d-d2e87dff22e2",
                        "tags": [
                            "superlative"
                        ],
                        "form": "gentlemanliest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2a9c91d-7131-38d0-802e-2fc91972f200",
                        "entry_id": "34134270-abad-3746-822d-d2e87dff22e2",
                        "glosses": [
                            "Of, being, pertaining to, or resembling a gentleman or gentlemen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1054e895-19b2-4df2-8105-fae79726cf4e",
                                "sense_id": "a2a9c91d-7131-38d0-802e-2fc91972f200",
                                "text": "Best of all, he ought to imagine his fellow-gamblers and the rest of the mob which stands trembling over a coin to be equally rich and gentlemanly with himself, and playing solely for recreation and pleasure."
                            },
                            {
                                "example_id": "cfa27312-2a80-4cb8-8065-1f3c406ff286",
                                "sense_id": "a2a9c91d-7131-38d0-802e-2fc91972f200",
                                "text": "With an election to cover and the soccer season in full swing, the sudoku newspaper rivalry stayed relatively gentlemanly until this month, when some of the last sudoku holdouts, including The Independent and The Guardian, joined the fray."
                            },
                            {
                                "example_id": "d6853d63-e759-4f85-aa33-47748865f9e3",
                                "sense_id": "a2a9c91d-7131-38d0-802e-2fc91972f200",
                                "text": "Some schools bump up everyone’s grades, some just allow for more As and others all but eliminate the once-gentlemanly C."
                            },
                            {
                                "example_id": "93d2995e-1959-4a0f-94d1-60cab9082327",
                                "sense_id": "a2a9c91d-7131-38d0-802e-2fc91972f200",
                                "text": "The stationmaster was an important part of the local community. Anyon Kay, in his reminiscences of Horwich in the early 20th century, remembers a Mr Horsfield as stationmaster - \"a gentlemanly character who took his job very seriously\"."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3f7d0dd7-677f-4284-ae9d-e1229a06dd52",
                        "source_entry_id": "34134270-abad-3746-822d-d2e87dff22e2",
