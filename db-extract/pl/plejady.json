                        "cross_references": []
                    },
                    {
                        "translation_id": "ae51e969-531f-46b7-b0cf-30f49011de0c",
                        "source_entry_id": "6297620c-194e-3a1c-9361-aff59c727c76",
                        "source_sense_id": "2a33b4d6-702c-3f67-a091-7b12b52aacd1",
                        "target_lang_word": "Πλειάδες",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Πλειάδες",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "9664870e-5231-30ba-93e6-21ead4346908",
                                        "entry_id": "a5cfbb30-286e-3402-b30e-9db4f86bbd9a",
                                        "glosses": [
                                            "οι επτά κόρες του Τιτάνα Άτλαντα και της Πλειόνης"
                                        ],
                                        "tags": [
                                            "ελληνική μυθολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47cc9ec4-53a6-408c-92f8-184b21301bfb",
                                                "sense_id": "9664870e-5231-30ba-93e6-21ead4346908",
                                                "text": "Οι επτά Πλειάδες ήταν η Αλκυόνη, η Μαία, η Μερόπη, η Ηλέκτρα, η Στερόπη, η Κελαινώ και η Ταϋγέτη, αδελφές των Υάδων, που μεταμορφώθηκαν σε περιστέρια ή αστέρια και πιστευόταν ότι δημιούργησαν το τραγούδι και τις νυχτερινές γιορτές."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37d17eb2-b56c-3a37-b2ea-c495048573fb",
                                        "entry_id": "a5cfbb30-286e-3402-b30e-9db4f86bbd9a",
                                        "glosses": [
                                            "ανοικτό αστρικό σμήνος που ανήκει στον αστερισμό του Ταύρου"
                                        ],
                                        "tags": [
                                            "αστρονομία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1100209-b337-4dd6-8284-86c7b195e363",
                                                "sense_id": "37d17eb2-b56c-3a37-b2ea-c495048573fb",
                                                "text": "Από τους αστέρες του σμήνους των Πλειάδων είναι ορατοί μόνο έξι, αλλά με το τηλεσκόπιο αποκαλύπτεται ότι το σμήνος αυτό αποτελείται από 2.500 περίπου αστέρες με φαινόμενο μέγεθος μέχρι 17. Οι πιο λαμπροί έχουν μυθολογικά ονόματα όπως των μυθολογικών Πλειάδων, και του Άτλαντα."
                                            },
                                            {
                                                "example_id": "7ddebd39-118b-4faf-bc88-00aaa846b3c3",
                                                "sense_id": "37d17eb2-b56c-3a37-b2ea-c495048573fb",
                                                "text": "άλλες μορφές: Πλειάς (στον ενικό), συντομογραφία: Μ45"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbadd810-da7c-31b9-b789-b5edfc65f429",
                                        "entry_id": "a5cfbb30-286e-3402-b30e-9db4f86bbd9a",
                                        "glosses": [
                                            "για τους επτά αλεξανδρινούς ποιητές"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d161ff40-e4af-4b88-a664-bc1891f94d48",
                        "source_entry_id": "6297620c-194e-3a1c-9361-aff59c727c76",
                        "source_sense_id": "2a33b4d6-702c-3f67-a091-7b12b52aacd1",
                        "target_lang_word": "Πούλια",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Πούλια",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "4e37bcd1-dc26-3f49-9a30-12412cbcca21",
                                        "entry_id": "57fb09e2-3500-3756-b106-f47c9df0c6ea",
                                        "glosses": [
                                            "κοινή ονομασία του αστρικού σμήνους των Πλειάδων"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c2c44f6-5be1-4ab4-945e-38448a1b59af",
                                                "sense_id": "4e37bcd1-dc26-3f49-9a30-12412cbcca21",
                                                "text": "※ Η Μεγάλη Άρκτος έχει χαμηλώσει, η Πούλια ταξιδεύει πια κατά τα δυτικά.",
                                                "translation": "⌘ Ηλίας Βενέζης Θεώνιχος και Μνησαρέτη [διήγημα]"
                                            },
                                            {
                                                "example_id": "6844d327-68c4-41b1-90ba-51cb7fcfe9e4",
                                                "sense_id": "4e37bcd1-dc26-3f49-9a30-12412cbcca21",
                                                "text": "※ Καὶ βγῆκε ὄξω, κ' ἔκαμε τὸ γύρο τοῦ σπιτιοῦ, κ' ἐσταμάτησε στὸν κῆπο του γιὰ νὰ ἰδεῖ στὴν Ἀνατολὴ ἄν ἔβγαινε ὁ Αὐγερινός, καὶ πασκίζοντας ἀπὸ ἄλλους ἀστερισμοὺς νὰ μαντέψει τὴ θέση τῆς Πούλιας, γιατὶ τὰ γέρικα μάτια του δὲν ἔβλεπαν πλιὰ τὰ μικρὰ της ἀστέρια. (Κωνσταντίνος Θεοτόκης, Η ζωή και ο θάνατος του Καραβέλα, 1920)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
