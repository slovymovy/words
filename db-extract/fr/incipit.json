                    {
                        "sense_id": "4bae4834-1ae9-3d96-8470-2ada8571f132",
                        "entry_id": "853fdbff-dfce-3294-ab79-38dd0b481cc2",
                        "glosses": [
                            "Premiers mots d’un texte, d’une œuvre musicale ou d’un manuscrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7467235d-2a0b-4189-8ce1-16ac35578697",
                                "sense_id": "4bae4834-1ae9-3d96-8470-2ada8571f132",
                                "text": "Il m'a fallu ainsi soigner la forme, et tout particulièrement l'incipit, les enchaînements et la chute, …."
                            },
                            {
                                "example_id": "ad5db7c8-a042-4bdc-8e5b-bf961465330b",
                                "sense_id": "4bae4834-1ae9-3d96-8470-2ada8571f132",
                                "text": "Voici l’incipit en rubriques de ce précieux exemplaire"
                            },
                            {
                                "example_id": "9cea0017-89b7-417b-bb9f-69855cc4e675",
                                "sense_id": "4bae4834-1ae9-3d96-8470-2ada8571f132",
                                "text": "En suivant les pistes qu’elle esquisse dans ses deux incipit, vous allez pouvoir réinventer l’espace urbain, lui donner la forme et le sens que vous voudrez, trouver le rythme, les mots, le ton, pour peindre à vos couleurs ce monde de béton qui tous nous attend."
                            },
                            {
                                "example_id": "f7e56783-5bc8-42c1-8f53-1f752564b018",
                                "sense_id": "4bae4834-1ae9-3d96-8470-2ada8571f132",
                                "text": "Mahfouz s'est intéressé dès l'incipit de son roman au côté religieux chez Akhénaton."
                            }
                        ]
                    }
                ],
