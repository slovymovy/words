                "senses": [
                    {
                        "sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                        "entry_id": "cc9105af-284a-3735-bec7-e241c7893158",
                        "glosses": [
                            "synthetischer Kraftstoff, der mittels elektrischer Energie aus Wasser und Kohlenstoffdioxid hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b3e9eb-8656-4c6a-bf75-8962a4129f91",
                                "sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                                "text": "„Schrittweise sollen dann sogenannte E-Treibstoffe hinzukommen.“"
                            },
                            {
                                "example_id": "1a067468-95aa-439e-a59a-8c32742978da",
                                "sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                                "text": "„Die Herstellung von umweltfreundlichen E-Treibstoffen ist ein sehr energieintensiver Prozess – ein schwieriges Unterfangen, wenn man bedenkt, dass die Kapazität der erneuerbaren Energieerzeugung in Europa derzeit relativ begrenzt ist. “"
                            },
                            {
                                "example_id": "e4f44daa-15f2-47cf-a719-ac8f7f4df246",
                                "sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                                "text": "„Ausserdem sei der Betrieb eines Autos mit E-Treibstoff für die Besitzer viel teurer als der eines Elektrofahrzeugs.“"
                            },
                            {
                                "example_id": "0c774446-9eb7-4c2d-a38a-f7da75c70097",
                                "sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                                "text": "„Ineratec baut und betreibt Chemieanlagen, die nachhaltige E-Treibstoffe aus synthetischem Wasserstoff produzieren.“"
                            },
                            {
                                "example_id": "9e38a05e-12a1-49e3-b1c7-ca0d8c667d7c",
                                "sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                                "text": "„Es muss sichergestellt werden, dass der europäische Green Deal keine Technologien verbietet und nicht nur die Einführung der E-Mobilität unterstützt, sondern auch Anreize für Investitionen in Wasserstoff und E-Treibstoffe schafft.“"
                            },
                            {
                                "example_id": "4cf9f7eb-968e-4515-905d-322270cfab23",
                                "sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                                "text": "„In der Forschung ist es mittlerweile weitgehend Konsens, dass die sogenannten E-Treibstoffe gegenwärtig in erster Linie für Luft- und Schifffahrt, den Schwerverkehr und bestimmte Bereiche der Industrie sinnvoll sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eb2d764-5576-4974-9ec0-0c8db1ee83f6",
                        "source_entry_id": "cc9105af-284a-3735-bec7-e241c7893158",
                        "source_sense_id": "fa5a6730-e4cc-33b8-863a-b24230355717",
                        "source_sense_description": "synthetischer Kraftstoff, der elektrisch aus Wasser und Kohlenstoffdioxid hergestellt wird",
                        "target_lang_word": "e-fuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "e-fuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbccf60a-5bf3-3e98-b144-8411afb066e4",
                                        "entry_id": "0e9b8027-26d3-35c2-8365-52f2da7efb46",
                                        "glosses": [
                                            "A combustion fuel that is theoretically environmentally friendly and is carbon neutral. A range of combustibles that is produced by combining hydrogen from water with atmospheric carbon dioxide using renewable energy sources to make the fuels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42b6f81c-bd14-46d8-8b74-8355ba5b7a95",
                                                "sense_id": "cbccf60a-5bf3-3e98-b144-8411afb066e4",
                                                "text": "Fuels produced from hydrogen can be used as straight replacements for oil and gas and can be low-carbon, if renewable electricity is used to produce these “e-fuels”. However, the research found that using the electricity directly to power cars and warm houses was far more efficient."
                                            },
                                            {
                                                "example_id": "9e7f4e65-dd83-49de-8390-e4a7b1cfb592",
                                                "sense_id": "cbccf60a-5bf3-3e98-b144-8411afb066e4",
                                                "text": "E-fuels can subsequently end up in any of the sectors shown, but mainly get used as transport fuels for aviation and shipping, depending on the scenario."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
