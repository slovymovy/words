                ],
                "senses": [
                    {
                        "sense_id": "f4175ca0-6374-3d6e-89cd-b5ae93ac4aad",
                        "entry_id": "6e9a68a0-4365-3fe5-bad3-720698cf7e36",
                        "glosses": [
                            "Délivrer (un diplôme, par exemple) en commun avec d’autres qui participent aussi à cette délivrance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efde24d-d3fd-48dc-a4e8-09fd29c491f5",
                                "sense_id": "f4175ca0-6374-3d6e-89cd-b5ae93ac4aad",
                                "text": "Sur ce principe, des masters co-délivrés par plusieurs partenaires étrangers fleurissent sur le marché."
                            },
                            {
                                "example_id": "00ebafd6-9338-439f-b2a0-9b8b37a9235c",
                                "sense_id": "f4175ca0-6374-3d6e-89cd-b5ae93ac4aad",
                                "text": "27 diplômes de Master OASC ont par ailleurs été co-délivrés avec l'Université Paul Sabatier."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7fb6495-ba9c-3749-8db6-825935ac23e3",
                        "entry_id": "6e9a68a0-4365-3fe5-bad3-720698cf7e36",
                        "glosses": [
                            "Délivrer en même temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af2398e-7f7b-4fb9-be7f-671631069997",
                                "sense_id": "f7fb6495-ba9c-3749-8db6-825935ac23e3",
                                "text": "Une analyse des traitements co-délivrés avec le baclofène (et plus particulièrement le suivi des co-délivrances avec des benzodiazépines et des antiépileptiques) nous permet d’estimer que sur les 45.000 patients traités par baclofène sur le mois d’août 2012 près de 11.000 le serait dans le cadre d’un sevrage alcoolique, souligne le Dr Guérin."
                            }
                        ]
                    }
