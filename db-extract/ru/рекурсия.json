                                    {
                                        "sense_id": "eca2a8a8-460e-33f8-b5fd-f5a31608a337",
                                        "entry_id": "70f4e4b1-42d6-365c-a6aa-37a09555db38",
                                        "glosses": [
                                            "eine Definition, die zur Beschreibung des Definitionsgegenstand auf sich selbst verweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60261da4-7e9b-472a-a8af-7ae3db363742",
                                                "sense_id": "eca2a8a8-460e-33f8-b5fd-f5a31608a337",
                                                "text": "Die Summe der ersten n Zahlen kann als Rekursion definiert werden: Ist n = 0, so ist sie Null, sonst ist sie die Summe der ersten (n-1) Zahlen plus n."
                                            }
                                        ],
