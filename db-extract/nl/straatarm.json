                        "sense_id": "7eb2e43b-2fc5-36b8-add2-c964d21c6ec9",
                        "entry_id": "531aae15-b3d1-35e3-a9d9-176bb254e063",
                        "glosses": [
                            "bijzonder arm; zo arm dat men op straat moet leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3756bae1-6024-4cae-b82b-2b9eadfa3c3a",
                                "sense_id": "7eb2e43b-2fc5-36b8-add2-c964d21c6ec9",
                                "text": "Door de economische crisis zijn er veel mensen straatarm geworden."
                            },
                            {
                                "example_id": "b44f94a8-1299-47bb-9b17-a3826ac7e01e",
                                "sense_id": "7eb2e43b-2fc5-36b8-add2-c964d21c6ec9",
                                "text": "Ik zou daar hoe dan ook terecht zijn gekomen, want mijn vader had slechts zes hectare land en was straatarm, en ik was de jongste van de drie kinderen."
                            }
                        ]
                    }
