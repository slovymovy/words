                ],
                "senses": [
                    {
                        "sense_id": "2df59e5d-f78b-3e46-9f0a-168900c6cfb9",
                        "entry_id": "e176c224-e96d-34c0-a66a-066b81f36636",
                        "glosses": [
                            "überwiegend aus Braunkohle bestehendes Sedimentgestein"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "902dede8-89fd-41db-a855-61e3f62e5a9f",
                                "sense_id": "2df59e5d-f78b-3e46-9f0a-168900c6cfb9",
                                "text": "Die ersten bedeutenden tertiären Braunkohlelager entstehen in Europa, Asien und Nordamerika."
                            },
                            {
                                "example_id": "71e1b28f-0acc-446a-b120-96552b7dda81",
                                "sense_id": "2df59e5d-f78b-3e46-9f0a-168900c6cfb9",
                                "text": "Riesige Sumpfwälder wurden Grundlage für Braunkohlelager."
                            },
                            {
                                "example_id": "6102996d-e6c5-4ac4-a95d-22084508f8c5",
                                "sense_id": "2df59e5d-f78b-3e46-9f0a-168900c6cfb9",
                                "text": "Reiche Braunkohlelager finden sich vor allem in Nordwestdeutschland und Böhmen."
                            },
                            {
                                "example_id": "b9156e57-2b98-4271-be61-b54542fa8de2",
                                "sense_id": "2df59e5d-f78b-3e46-9f0a-168900c6cfb9",
                                "text": "„Erst im 18. Jahrhundert wurde dieses Braunkohlelager des Hausruckgebirges zufällig sichtbar als der Bierbrauer Johann Georg Mayr zu Wolfsegg 9 den Kuhstall erweiterte und durch eine höhere Mauerwand gegen den Berg schützte. …“"
                            },
                            {
                                "example_id": "d0277131-e40a-4247-ab8e-eef2358ba325",
                                "sense_id": "2df59e5d-f78b-3e46-9f0a-168900c6cfb9",
                                "text": "Die Horloffniederung und weitere Senkungsgebiete füllten sich mit Sedimenten des Oberpliozäns, der jüngsten Phase des Tertiärs. Hier bildeten sich vor etwa 1–1,2 Mio. Jahren Braunkohlelager mit einer Mächtigkeit von durchschnittlich 9 m aus."
                            },
                            {
                                "example_id": "d4c20b69-378d-4528-81b2-fa6b4c525819",
                                "sense_id": "2df59e5d-f78b-3e46-9f0a-168900c6cfb9",
                                "text": "Fast 15 Stunden lang hat es in einem Braunkohlelager neben dem Bahnhof im Aalener Stadtbezirk Unterkochen (Ostalbkreis) gebrannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
