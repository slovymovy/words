                    "frequency": "Low",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler needs a diaper change because he had a <w>stinky</w>.",
                            "target_lang_translations": {
                                "zh": "那个幼儿需要换尿布，因为他拉了<w>臭臭</w>。"
                            }
                        },
                        {
                            "text": "The puppy had a <w>stinky</w> on the carpet.",
                            "target_lang_translations": {
                                "zh": "小狗在地毯上拉了<w>臭臭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "poop",
                        "stool"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Childish or euphemistic language."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "排便，指幼儿用语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "臭臭",
