                        "form": "hiérophantide"
                    },
                    {
                        "form_id": "a528e1cd-31cd-4b49-ac3d-aaa68063c6f3",
                        "entry_id": "35e72cef-4338-3bd7-bef2-9bd4dc0782dd",
                        "tags": [
                            "feminine"
                        ],
                        "form": "hiérophantesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "993edc73-f0f9-3102-b224-d930b4b16fe6",
                        "entry_id": "35e72cef-4338-3bd7-bef2-9bd4dc0782dd",
                        "glosses": [
                            "Prêtre qui présidait aux mystères d’Éleusis et instruisait les initiés."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "16bbbb1d-f46d-45bd-ab37-b8fca8179031",
                                "sense_id": "993edc73-f0f9-3102-b224-d930b4b16fe6",
                                "text": "Que la fameuse île de Samothrace soit à l’embouchure de l’Hèbre, comme le disent tant de dictionnaires, ou qu’elle en soit à vingt milles, comme c’est la vérité, ce n’est pas ce que je recherche.\nCette île fut longtemps la plus célèbre de tout l’Archipel, et même de toutes les îles. Ses dieux Cabires, ses hiérophantes, ses mystères, lui donnèrent autant de réputation que le trou Saint-Patrice en eut en Irlande il n’y a pas longtemps."
                            },
                            {
                                "example_id": "748cd746-5079-476a-ba2d-f284c09f9c65",
                                "sense_id": "993edc73-f0f9-3102-b224-d930b4b16fe6",
                                "text": "Ces deux figures sont probablement celles du Hiérophante et de la Hiérophantesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "490c41ed-3bb8-36d2-a087-cc29479eb408",
                        "entry_id": "35e72cef-4338-3bd7-bef2-9bd4dc0782dd",
                        "glosses": [
                            "Prêtre qui explique les mystères du sacré."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "74622e66-cdda-403b-a643-3735923cb9a1",
                                "sense_id": "490c41ed-3bb8-36d2-a087-cc29479eb408",
                                "text": "puis c’est toute l’histoire primitive, acceptée jusque-là avec une grossière littéralité, qui trouve d’ingénieux interprètes, hiérophantes rationalistes, qui lèvent le voile des vieux mystères."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8aa7a54-84d6-4083-83a3-91d9079773fd",
                        "source_entry_id": "35e72cef-4338-3bd7-bef2-9bd4dc0782dd",
                        "target_lang_word": "hierophant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hierophant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b2cb63a-58a4-3c65-9bb8-34e92b706398",
                                        "entry_id": "20301b66-5344-3c89-92d5-ff02dcdbe499",
                                        "glosses": [
                                            "An ancient Greek priest who interpreted sacred mysteries, especially the priest of the Eleusinian Mysteries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6102d9ea-3717-43f3-8073-ee47f8d8264c",
                                                "sense_id": "8b2cb63a-58a4-3c65-9bb8-34e92b706398",
                                                "text": "The exhibition of ancient statues, relics, and symbols, concealed from daily adoration (as in the Catholic festivals of this day), probably, made a main duty of the Hierophant."
                                            },
                                            {
                                                "example_id": "380e13e1-e771-4d17-97cd-f8c528b29d4b",
                                                "sense_id": "8b2cb63a-58a4-3c65-9bb8-34e92b706398",
                                                "text": "If books are as provocative as you suggest, one would expect every librarian to utter the shrill screams of a hierophant, to clash ecstatic castanets in his silent alcoves!"
                                            },
                                            {
                                                "example_id": "a15ac728-a1d3-45d7-a866-ea25a8b84a67",
                                                "sense_id": "8b2cb63a-58a4-3c65-9bb8-34e92b706398",
                                                "text": "Most scholars name the rectangular enclosure anaktoron, locate in it the throne of the hierophant, and suppose that from it emanated the central revelation which occurred, in Plutarch's phrase, ‘when the anaktora were opened’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e4be813-4e41-30c7-a273-cdc6c15248d4",
                                        "entry_id": "20301b66-5344-3c89-92d5-ff02dcdbe499",
                                        "glosses": [
                                            "An interpreter of sacred mysteries or arcane knowledge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d72ee2a9-09ed-49d3-98ff-8e5674f8fd66",
                                                "sense_id": "0e4be813-4e41-30c7-a273-cdc6c15248d4",
                                                "text": "Thus I became the hierophant of those three worthy and talented men, who, in spite of their literary accomplishments, were not wise, since they were infatuated with occult and fabulous sciences, and believed in the existence of phenomena impossible in the moral as well as in the physical order of things."
                                            },
                                            {
                                                "example_id": "2f1e5f17-9d0a-4619-ac28-7a0244df650b",
                                                "sense_id": "0e4be813-4e41-30c7-a273-cdc6c15248d4",
                                                "text": "What did even the hierophants of science know of the potencies of, for them, unvintageable evil?"
                                            },
                                            {
                                                "example_id": "421faec5-59dc-491d-99a5-e1382ff0303d",
                                                "sense_id": "0e4be813-4e41-30c7-a273-cdc6c15248d4",
                                                "text": "Ambassadors of northern countries stand / Impassive while our hierophants intone / Long canticles of Christ the Contraband: / Our grandees' hearts are shrunk to kidney stones."
                                            },
                                            {
                                                "example_id": "3bcee174-b9f6-4a87-9b12-fdb8028d6fad",
                                                "sense_id": "0e4be813-4e41-30c7-a273-cdc6c15248d4",
                                                "text": "No, I must play creator / And make them up, these hierophants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90654f3-5d36-3433-aeb2-efbcaba7d333",
                                        "entry_id": "20301b66-5344-3c89-92d5-ff02dcdbe499",
                                        "glosses": [
                                            "One who explains or makes a commentary."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
