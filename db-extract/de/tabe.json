                ],
                "senses": [
                    {
                        "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                        "entry_id": "f6628c6d-cf60-303a-98ca-84d712ad8de5",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1e8731-1144-4607-81fd-68661c0f35dd",
                                "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                                "text": "Frau Tabe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1b9dfe54-96a0-480f-b2b0-7e659f388bd3",
                                "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                                "text": "Herr Tabe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e9e8244b-7d41-4e44-9e77-4afbc21e298f",
                                "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                                "text": "Die Tabes kommen heute aus dem Harz."
                            },
                            {
                                "example_id": "dce1416b-39e8-49f0-88b4-d0e95cf7f640",
                                "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                                "text": "Der Tabe trägt nie die Schals, die die Tabe ihm strickt."
                            },
                            {
                                "example_id": "0cfd4ed2-2950-485d-a4f6-76c443f4581a",
                                "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tabe kommt, geht der Herr Tabe.“"
                            },
                            {
                                "example_id": "3a46dfc2-c30d-4275-b25f-c5c9d61ec5e2",
                                "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                                "text": "Tabe kommt und geht."
                            },
                            {
                                "example_id": "d4aa3dd4-a552-4c9d-88ca-afd745d1fa62",
                                "sense_id": "6fa168d2-22e2-37ac-9dad-6a1df1ed53f5",
                                "text": "Tabes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
