                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2ffcf4c-d3c2-4998-beeb-cb8eff5398f9",
                                "sense_id": "97bd8fc9-2e1f-3029-94c1-05f9d366337d",
                                "text": "Zapewniam panią, iż ta katechetka ma dobre przygotowanie teologiczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1212d662-71ed-47cc-a1e9-e13428d289a1",
                        "source_entry_id": "10f00dc0-0ddf-3aef-bb39-9ea5afc66a4a",
                        "source_sense_id": "97bd8fc9-2e1f-3029-94c1-05f9d366337d",
                        "target_lang_word": "theological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theological",
