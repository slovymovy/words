                "senses": [
                    {
                        "sense_id": "1537aa62-1899-3fd1-a483-13d04b02188a",
                        "entry_id": "5e68ca4d-114e-313c-aa30-d912c1bc5271",
                        "glosses": [
                            "Frau, die mit Kolonialwaren, also Waren aus überseeischen Kolonien, handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8242380-5b32-48b5-beab-ae9e74dd8ee3",
                                "sense_id": "1537aa62-1899-3fd1-a483-13d04b02188a",
                                "text": "„Damals war das im linken Gebäudeflügel vorhandene Ladenlokal an die Kolonialwarenhändlerin Emilie Rathsack vermietet.“"
                            },
                            {
                                "example_id": "973af43d-6dba-4a2c-b79c-d8ed61efec19",
                                "sense_id": "1537aa62-1899-3fd1-a483-13d04b02188a",
                                "text": "[Zeit des Nationalsozialismus:] „Eine Kolonialwarenhändlerin, die Zahlen auf Bezugsscheinen ausradiert und dann um das Zehnfache erhöht hatte, musste nach einem Urteil des Kölner Sondergerichts wegen Verstoß gegen § 1 der KWVO in schwerer Tateinheit mit Urkundenfälschung für zwei Jahre ins Zuchthaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
