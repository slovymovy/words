{
    "word_family": [
        "проведение",
        "проводка",
        "проводник",
        "времяпрепровождение"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce8751db-933c-3986-8f31-4526574c5653",
                    "sense_definition": "Прожить, пробыть какое-то время где-либо или каким-либо образом.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_spending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили <провести> летний отпуск на берегу моря.",
                            "target_lang_translations": {
                                "en": "We decided to <spend> our summer vacation at the seaside.",
                                "zh": "我们决定在海边<w>度过</w>暑假。"
                            }
                        },
                        {
                            "text": "Как вы <провели> вчерашний вечер с друзьями?",
                            "target_lang_translations": {
                                "en": "How did you <spend> yesterday evening with friends?",
                                "zh": "你昨天晚上是怎么和朋友<w>度过</w>的？"
                            }
                        },
                        {
                            "text": "Бабушка любила <проводить> время за чтением книг.",
                            "target_lang_translations": {
                                "en": "Grandma loved to <spend> time reading books.",
                                "zh": "奶奶喜欢<w>度过</w>读书时光。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "провести время",
                        "провести отпуск",
                        "провести лето",
                        "хорошо провести день",
                        "провести выходные"
                    ],
                    "target_lang_definitions": {
                        "en": "To live through or stay for a period of time in a specific place or manner.",
                        "zh": "在某地或以某种方式度过一段时间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spend",
                                "target_lang_sense_clarification": "time, vacation, etc."
                            },
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "度过",
                                "target_lang_sense_clarification": "用于时间、假期等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "219c1c7a-de0b-35e8-9d5c-2bb9a0d8d109",
                    "sense_definition": "Выполнить, осуществить какое-либо действие, мероприятие или работу.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компания планирует <провести> собрание акционеров в следующем месяце.",
                            "target_lang_translations": {
                                "en": "The company plans to <hold> a shareholders' meeting next month.",
                                "zh": "公司计划下个月<w>举行</w>股东大会。"
                            }
                        },
                        {
                            "text": "Учёным необходимо <провести> ряд сложных экспериментов.",
                            "target_lang_translations": {
                                "en": "Scientists need to <conduct> a series of complex experiments.",
                                "zh": "科学家们需要<w>进行</w>一系列复杂的实验。"
                            }
                        },
                        {
                            "text": "Врач решил <провести> осмотр пациента немедленно.",
                            "target_lang_translations": {
                                "en": "The doctor decided to <perform> an examination of the patient immediately.",
                                "zh": "医生决定立即<w>进行</w>病人检查。"
                            }
                        }
                    ],
                    "synonyms": [
                        "осуществить"
                    ],
                    "common_phrases": [
                        "провести собрание",
                        "провести эксперимент",
                        "провести исследование",
                        "провести урок",
                        "провести реформу"
                    ],
                    "target_lang_definitions": {
                        "en": "To perform, execute, or manage an action, event, or work.",
                        "zh": "执行、实施某项活动、工作或任务。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conduct",
                                "target_lang_sense_clarification": "experiments, meetings, investigations"
                            },
                            {
                                "target_lang_word": "hold",
                                "target_lang_sense_clarification": "meetings, events"
                            },
                            {
                                "target_lang_word": "carry out",
                                "target_lang_sense_clarification": "work, experiments, reforms"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "举行",
                                "target_lang_sense_clarification": "用于会议、活动"
                            },
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "用于实验、调查、研究"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb83e099-0b09-3752-ba41-d5e85f445404",
                    "sense_definition": "Идя вместе с кем-либо, указать путь или помочь пройти куда-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "guiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Охранник согласился <провести> посетителя к директору.",
                            "target_lang_translations": {
                                "en": "The security guard agreed to <take> the visitor to the director.",
                                "zh": "保安同意<w>带领</w>访客去见经理。"
                            }
                        },
                        {
                            "text": "Он вызвался <провести> девушку до дома, так как было уже темно.",
                            "target_lang_translations": {
                                "en": "He volunteered to <walk> the girl home, as it was already dark.",
                                "zh": "因为天已经黑了，他主动提出<w>护送</w>那位女孩回家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сопроводить",
                        "проводить"
                    ],
                    "common_phrases": [
                        "провести домой",
                        "провести гостя",
                        "провести к выходу",
                        "провести через толпу"
                    ],
                    "target_lang_definitions": {
                        "en": "To show the way or help someone go somewhere by accompanying them.",
                        "zh": "陪同某人去某地，为其指引方向。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guide",
                                "target_lang_sense_clarification": "show the way"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "go in front of"
                            },
                            {
                                "target_lang_word": "take",
                                "target_lang_sense_clarification": "escort someone to a place"
                            },
                            {
                                "target_lang_word": "escort",
                                "target_lang_sense_clarification": "accompany for protection or guidance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带领",
                                "target_lang_sense_clarification": "指引方向"
                            },
                            {
                                "target_lang_word": "护送",
                                "target_lang_sense_clarification": "陪同以确保安全"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c880fafc-1acb-3db8-aa95-701a4bda3d3b",
                    "sense_definition": "Начертить линию или черту на какой-либо поверхности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drawing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель попросил ученика <провести> прямую линию на доске.",
                            "target_lang_translations": {
                                "en": "The teacher asked the student to <draw> a straight line on the board.",
                                "zh": "老师请学生在黑板上<w>画</w>一条直线。"
                            }
                        },
                        {
                            "text": "На карте нужно <провести> чёткую границу между участками.",
                            "target_lang_translations": {
                                "en": "It is necessary to <draw> a clear boundary between the plots on the map.",
                                "zh": "需要在地图上<w>画</w>出地块之间清晰的界限。"
                            }
                        }
                    ],
                    "synonyms": [
                        "начертить",
                        "обозначить"
                    ],
                    "common_phrases": [
                        "провести линию",
                        "провести черту",
                        "провести параллель",
                        "провести границу"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a line or mark on a surface.",
                        "zh": "在表面上画出线条或界限。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "draw",
                                "target_lang_sense_clarification": "a line, a boundary"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "画",
                                "target_lang_sense_clarification": "用于线条、界限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9454a5e2-d592-37a0-af11-f04cf18c29e5",
                    "sense_definition": "Сделать плавное движение рукой или предметом по поверхности чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "touching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама ласково <провела> рукой по волосам ребёнка.",
                            "target_lang_translations": {
                                "en": "Mom affectionately <ran> her hand through the child's hair.",
                                "zh": "妈妈温柔地用手<w>抚摸</w>了孩子的头发。"
                            }
                        },
                        {
                            "text": "Он задумчиво <провёл> пальцем по корешку старой книги.",
                            "target_lang_translations": {
                                "en": "He thoughtfully <ran> his finger along the spine of the old book.",
                                "zh": "他若有所思地用手指<w>划过</w>旧书的书脊。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "провести рукой",
                        "провести ладонью",
                        "провести пальцем",
                        "провести взглядом"
                    ],
                    "target_lang_definitions": {
                        "en": "To move a hand or object smoothly along a surface.",
                        "zh": "用手或物体在某物表面平滑地移动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "hand, finger, or object over something"
                            },
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "hand over something"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抚摸",
                                "target_lang_sense_clarification": "用手轻触"
                            },
                            {
                                "target_lang_word": "划过",
                                "target_lang_sense_clarification": "物体在表面移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "608e7e69-a0f3-3e54-bb7e-fe4e19c506dd",
                    "sense_definition": "Проложить или построить что-либо протяжённое (дорогу, коммуникации).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашу деревню наконец-то обещали <провести> газ.",
                            "target_lang_translations": {
                                "en": "They finally promised to <install> gas in our village.",
                                "zh": "他们终于承诺要为我们村<w>安装</w>煤气。"
                            }
                        },
                        {
                            "text": "Строители успели <провести> новую дорогу до начала зимы.",
                            "target_lang_translations": {
                                "en": "The builders managed to <build> the new road before the start of winter.",
                                "zh": "工人们在冬天到来之前完成了新路的<w>修建</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "провести газ",
                        "провести свет",
                        "провести интернет",
                        "провести дорогу",
                        "провести воду"
                    ],
                    "target_lang_definitions": {
                        "en": "To install or build infrastructure such as roads or utilities.",
                        "zh": "铺设或建设基础设施，如道路、管道或公用设施。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "install",
                                "target_lang_sense_clarification": "utilities like gas, internet"
                            },
                            {
                                "target_lang_word": "lay",
                                "target_lang_sense_clarification": "cables, pipes, roads"
                            },
                            {
                                "target_lang_word": "build",
                                "target_lang_sense_clarification": "roads, structures"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安装",
                                "target_lang_sense_clarification": "用于煤气、网络等设施"
                            },
                            {
                                "target_lang_word": "修建",
                                "target_lang_sense_clarification": "用于道路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef629c11-a4fa-3747-92b1-4a7829d09e41",
                    "sense_definition": "Ввести в заблуждение, обмануть или перехитрить кого-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот опытный мошенник сумел <провести> даже полицию.",
                            "target_lang_translations": {
                                "en": "This experienced con artist managed to <fool> even the police.",
                                "zh": "这个经验丰富的骗子甚至成功<w>欺骗</w>了警察。"
                            }
                        },
                        {
                            "text": "Меня не так-то просто <провести>, я знаю все твои уловки.",
                            "target_lang_translations": {
                                "en": "It's not so easy to <trick> me; I know all your tricks.",
                                "zh": "我没那么容易被<w>糊弄</w>，我知道你所有的花招。"
                            }
                        }
                    ],
                    "synonyms": [
                        "обмануть",
                        "перехитрить"
                    ],
                    "common_phrases": [
                        "его не провести",
                        "удалось провести",
                        "провести дурака"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To mislead, trick, or outwit someone.",
                        "zh": "误导、欺骗或戏弄某人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fool",
                                "target_lang_sense_clarification": "deceive"
                            },
                            {
                                "target_lang_word": "trick",
                                "target_lang_sense_clarification": "outwit"
                            },
                            {
                                "target_lang_word": "deceive",
                                "target_lang_sense_clarification": "mislead"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欺骗",
                                "target_lang_sense_clarification": "误导他人"
                            },
                            {
                                "target_lang_word": "糊弄",
                                "target_lang_sense_clarification": "口语，戏弄"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66b0ebb7-0f6f-3096-9d6e-e52ac20337c4",
                    "sense_definition": "Оформить документы или финансовые операции согласно официальным правилам.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accounting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бухгалтер забыл <провести> этот счёт в прошлом месяце.",
                            "target_lang_translations": {
                                "en": "The accountant forgot to <process> this invoice last month.",
                                "zh": "会计忘了在上个月<w>处理</w>这张账单。"
                            }
                        },
                        {
                            "text": "Банк отказался <провести> подозрительную операцию без подтверждения.",
                            "target_lang_translations": {
                                "en": "The bank refused to <process> the suspicious transaction without confirmation.",
                                "zh": "银行拒绝在没有确认的情况下<w>处理</w>这笔可疑交易。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "провести по бухгалтерии",
                        "провести платёж",
                        "провести документ",
                        "провести сделку"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial/business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To officially record or process documents or financial transactions.",
                        "zh": "按照官方规定正式记录或处理文件及财务交易。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "process",
                                "target_lang_sense_clarification": "payments, documents"
                            },
                            {
                                "target_lang_word": "register",
                                "target_lang_sense_clarification": "in accounting records"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处理",
                                "target_lang_sense_clarification": "用于财务、文件"
                            },
                            {
                                "target_lang_word": "登记",
                                "target_lang_sense_clarification": "用于会计记录"
                            }
                        ]
                    }
                }
            ]
        }
    ]
