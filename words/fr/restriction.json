            "senses": [
                {
                    "sense_id": "9c897a2d-0b50-3a41-be30-625c24a1f803",
                    "sense_definition": "Action de restreindre ou règle limitant la liberté, l'accès ou l'usage de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a imposé une nouvelle <w>restriction</w> pour protéger les ressources naturelles."
                        },
                        {
                            "text": "Vous pouvez circuler librement dans le parc sans aucune <w>restriction</w>."
                        }
                    ],
                    "synonyms": [
                        "limitation",
                        "contrainte",
                        "réserve"
                    ],
                    "antonyms": [
                        "élargissement",
                        "extension"
                    ],
                    "common_phrases": [
                        "sans restriction",
                        "restriction de circulation",
                        "lever les restrictions"
                    ]
                },
                {
