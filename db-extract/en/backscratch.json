                ],
                "senses": [
                    {
                        "sense_id": "1c8c84b0-f3af-345e-84da-c25bc48bfd95",
                        "entry_id": "10b64075-04b8-3a43-b8ff-9e9014d774b3",
                        "glosses": [
                            "To scratch one's or another's back."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a2d0c2-1fe8-46bc-a7ac-ceb06632df2b",
                                "sense_id": "1c8c84b0-f3af-345e-84da-c25bc48bfd95",
                                "text": "That thought appeared to discompose her greatly, though Jasper made light of it by rapidly back-scratching with his hind legs and giving a short stern bark, just to assure her that strangers would be rushed off the property on sight."
                            },
                            {
                                "example_id": "275d3426-2aeb-4167-818b-d01284239c6b",
                                "sense_id": "1c8c84b0-f3af-345e-84da-c25bc48bfd95",
                                "text": "He enjoyed being hugged, backscratched, and tickled and sat quietly next to the examiner after testing while a parental interview was conducted."
                            },
                            {
                                "example_id": "57bf2433-e554-42ad-8bac-c1e3823fe7af",
                                "sense_id": "1c8c84b0-f3af-345e-84da-c25bc48bfd95",
                                "text": "So it is to the mutual advantage of social primates to backscratch for each other."
                            },
                            {
                                "example_id": "5dcadc77-0a1a-49dd-ae0d-28f925817875",
                                "sense_id": "1c8c84b0-f3af-345e-84da-c25bc48bfd95",
                                "text": "[…] primate's inclination to backscratch and delouse rather than venture into the dangerous country beyond familiar tramping grounds."
                            }
                        ]
                    },
                    {
                        "sense_id": "34377782-37e9-3f04-832c-1d914bade1ce",
                        "entry_id": "10b64075-04b8-3a43-b8ff-9e9014d774b3",
                        "glosses": [
                            "To engage in a reciprocal beneficial action."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ac516b2a-144c-44e7-b355-92a76226ab59",
                                "sense_id": "34377782-37e9-3f04-832c-1d914bade1ce",
                                "text": "It was backscratched into existence, cost nearly a billion pounds, and now they are wondering why they let it happen."
                            },
                            {
                                "example_id": "8f918987-33f7-4e5a-8476-ef4c03825b92",
                                "sense_id": "34377782-37e9-3f04-832c-1d914bade1ce",
                                "text": "The fount of social problems, he argues, is that human morality grew out of the natural principles of tit-for-tat and mutual backscratching."
                            },
                            {
                                "example_id": "47275c3d-be3e-4fe3-8b52-0fde4c24d994",
                                "sense_id": "34377782-37e9-3f04-832c-1d914bade1ce",
                                "text": "Whether referred to as bargaining, logrolling, or backscratching, the effect is the same: \"you support me, I'll support you.\""
                            }
                        ]
                    }
                ],
