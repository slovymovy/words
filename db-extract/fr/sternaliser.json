                "senses": [
                    {
                        "sense_id": "ee8346df-7ac8-39fa-8395-0c1d548635f2",
                        "entry_id": "30698f53-1681-33f2-9e46-6fe82519dfe3",
                        "glosses": [
                            "Donner un caractère sternal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad8de40-5eb2-40fa-a5ef-2e682f4c3cfc",
                                "sense_id": "ee8346df-7ac8-39fa-8395-0c1d548635f2",
                                "text": "On sait que les côtes des Batraciens, très réduites, ne s’engagent jamais dans les parties latérales du tronc; à plus forte raison ne se sternalisent-elles point."
                            },
                            {
                                "example_id": "60b49a7f-5d64-45db-9626-91ebd1c4ba88",
                                "sense_id": "ee8346df-7ac8-39fa-8395-0c1d548635f2",
                                "text": "Quant aux côtes concentriques, il n’en existe que quelques rudiments par ci par là, relevés vers le dos, mais non sternalisés : le thorax se trouve ainsi largement ouvert postérieurement entre les deux épines dorsales (fig. 6)."
                            }
                        ]
                    }
