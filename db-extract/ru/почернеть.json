                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noircir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Rendre noir, passer au noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ff6a36-adc8-4e0c-8684-ff1350f7a476",
                                                "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                                "text": "Dès qu'il fait beau, la moindre brise soulève une fine poussière basaltique qui noircit tous les objets et pénètre dans les habitations les mieux closes."
                                            },
                                            {
                                                "example_id": "436df92f-1379-4991-b2fd-893d599c3286",
                                                "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                                "text": "Ils portaient, sous la couche de huita qui les noircissait des pieds à la tête, des tatouages géométriques, et leurs oreilles étaient percées pour livrer passage à des petits bouts de bois."
                                            },
                                            {
                                                "example_id": "4f7643e5-9748-4977-a21a-e4805a9badc3",
                                                "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                                "text": "Elle dérobait du kohl à sa mère pour s’en noircir les cils et donner à ses yeux agrandis la langueur du regard des gazelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12f87ff9-5de4-3a85-83e2-e4b0bde10f15",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Faire naître, dans l’esprit, des pensées tristes, sombres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a152643d-74da-4127-a387-c85e7e12e8a2",
                                                "sense_id": "12f87ff9-5de4-3a85-83e2-e4b0bde10f15",
                                                "text": "Cette lecture m’a noirci l’esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eceb4993-f4aa-32a5-9d30-0b0440d4b5f3",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Diffamer, faire passer pour méchant, pour infâme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4725e75e-d293-4be8-bfff-380ae1fa58ab",
                                                "sense_id": "eceb4993-f4aa-32a5-9d30-0b0440d4b5f3",
                                                "text": "La calomnie peut noircir l’homme le plus innocent, la conduite la plus pure."
                                            },
                                            {
                                                "example_id": "5acb0e78-7fb8-48c6-8526-5fa8f7fc15ce",
                                                "sense_id": "eceb4993-f4aa-32a5-9d30-0b0440d4b5f3",
                                                "text": "Noircir la réputation de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e38ab0-7c05-3b7c-b407-249cbb6b832e",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Remplir par l'écriture. → voir noircir du papier"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d691d56-0643-4824-9de5-4c8418b4fed9",
                                                "sense_id": "b8e38ab0-7c05-3b7c-b407-249cbb6b832e",
                                                "text": "Cependant, quand je regarde des carnets que je noircissais enfant, vers sept ou huit ans, c'était déjà sous forme poétique, en vers, en forme hachurée très graphique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Devenir noir."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd044c33-b47f-486c-b4a7-24c8a79e8848",
                                                "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                                "text": "Je regarde noircir les arbres et verdir le ciel, Vénus y brille seule, je t’attends."
                                            },
                                            {
                                                "example_id": "426fb8fe-b213-4fe7-abde-d6ad34984263",
                                                "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                                "text": "Un teint, une peau qui noircit."
                                            },
                                            {
                                                "example_id": "363f306b-a828-4e88-8d3a-509af4f54db0",
                                                "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                                "text": "Ce bois ne brûle pas, il ne fait que noircir, il noircit au feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f28286-0c9b-3740-8fe1-6315c432e432",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Se rendre odieux, infâme par quelque mauvaise action."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2786bdb-41c6-4918-9a84-9c6ac248708a",
                                                "sense_id": "b3f28286-0c9b-3740-8fe1-6315c432e432",
                                                "text": "Voudrait-il se noircir d’un tel crime ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49aaae67-337e-3c82-893d-566d49346ffd",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Devenir noir."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50808eca-8ae2-469c-99ed-9a63db4333a5",
                                                "sense_id": "49aaae67-337e-3c82-893d-566d49346ffd",
                                                "text": "Cela s’est noirci à la fumée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0246cc0-c301-3cdd-9750-926bcda57cf3",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Devenir obscur, se couvrir de nuages épais, en parlant du ciel."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3307cec-ae2c-4161-b744-069672c87b99",
                                                "sense_id": "d0246cc0-c301-3cdd-9750-926bcda57cf3",
                                                "text": "Le temps se noircit, le ciel se noircit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185f4e3b-0d28-36f8-a132-7cea60ffa6c3",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "S’enivrer."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3af2f2e-99fc-44ea-a055-01a7bd229544",
                                                "sense_id": "185f4e3b-0d28-36f8-a132-7cea60ffa6c3",
                                                "text": "Elle ne veut pas comprendre que je vis là des journées confiantes et préservées, que si-je-n’en-fais-jamais-d’autres, du moins je ne fais rien de mal ; elle a peur que je me noircisse pendant qu’elle se brunit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
