                "senses": [
                    {
                        "sense_id": "839592c3-fe5f-3e1d-9ba1-485e8c0114b0",
                        "entry_id": "4a291671-b80f-3606-b8ec-bf259cdab774",
                        "glosses": [
                            "Transformer un terrain ou sa végétation par une activité humaine désordonnée (décombres, terrains vagues, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4bdb833-bad7-489c-a96d-6f0bbd0545bc",
                                "sense_id": "839592c3-fe5f-3e1d-9ba1-485e8c0114b0",
                                "text": "Cette Ormaie sépicole s'étend facilement et tend, par places, à se « rudéraliser » (boqueteaux du bocage, bordures forestières)."
                            },
                            {
                                "example_id": "331905ff-690b-43a6-a84b-d83f1c2b075b",
                                "sense_id": "839592c3-fe5f-3e1d-9ba1-485e8c0114b0",
                                "text": "La prairie fraîche à Anthémis nobilis se rudéralise à proximité du village. Sa végétation est remplacée par celle de l'association à Hordeum murinum et Centaurea calcitrapa."
                            }
                        ]
                    }
