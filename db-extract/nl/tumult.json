                                                "example_id": "23f41c97-0320-4413-8e10-51b0677adfde",
                                                "sense_id": "f0df31f9-7bba-31bb-a256-0f7c32999e82",
                                                "text": "[…] a logical agitation of the matter […]"
                                            },
