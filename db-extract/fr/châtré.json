                        "glosses": [
                            "Homme ou animal mâle ayant été castré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca45561-3b77-47b1-a020-8a1aec2031e4",
                                "sense_id": "a7688af8-7584-309e-a177-1276c568bc12",
                                "text": "Ernest, l’aîné, qui accomplissait son service militaire à Épinal, avait le profil sec, pas tout à fait celui du vétérinaire, mais il y avait à dire. Et une petite voix de châtré comme son oncle, bon Dieu ! Comme son oncle."
                            },
                            {
                                "example_id": "14de6494-6e31-4df0-89ed-6882cd6b547a",
                                "sense_id": "a7688af8-7584-309e-a177-1276c568bc12",
                                "text": "On a relevé ses erreurs dogmatiques, certains ont dit qu’il fut écarté de la sainteté au motif qu’on ne pouvait canoniser un châtré."
                            }
                        ]
                    }
