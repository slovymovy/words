        "fr-extract.jsonl": [
            {
                "entry_id": "9f49f2bd-cc8f-360b-b1b5-03945454a097",
                "word": "iniquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24ecdfd1-ba18-3f40-9d15-3528a38b5937",
                        "entry_id": "9f49f2bd-cc8f-360b-b1b5-03945454a097",
                        "glosses": [
                            "D’une manière inique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ae1525-1ca0-45e2-a416-4fcc0662fb43",
                                "sense_id": "24ecdfd1-ba18-3f40-9d15-3528a38b5937",
                                "text": "Juger iniquement."
                            },
                            {
                                "example_id": "4b6f2b24-d563-4cbe-bbeb-b38bf7b2ebc3",
                                "sense_id": "24ecdfd1-ba18-3f40-9d15-3528a38b5937",
                                "text": "Mais Thyl [Ulenspiegel], auquel il dénie iniquement toute poésie, le choqua sans doute par son violent réalisme, et plus encore par le vent de révolte qui monte de ses pages."
                            },
                            {
                                "example_id": "7e05df6d-87ad-4211-b948-035f6e8d6cce",
                                "sense_id": "24ecdfd1-ba18-3f40-9d15-3528a38b5937",
                                "text": "Une désolation sans but, un vide désir enivre le cœur de l’enfant solitaire, que son indifférence physique garde iniquement, absurdement pure après ses fautes, et qui cherche, parmi les hommes, son amant inconnu."
                            }
                        ]
                    }
                ],
