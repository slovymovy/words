                "senses": [
                    {
                        "sense_id": "eb6936b2-a7e7-3979-8a27-7caf3d5e56fd",
                        "entry_id": "48de403b-39f4-32bb-862f-b7f19a29f1e7",
                        "glosses": [
                            "verwendbarer Abfall, der bei der Bearbeitung von Seide anfällt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8f656c22-fb35-4411-895f-9a78d35eb603",
                                "sense_id": "eb6936b2-a7e7-3979-8a27-7caf3d5e56fd",
                                "text": "„Dazu kommt noch die Strazza (76.000 Pfd. im Werthe von 114.000 fl.)“"
                            },
                            {
                                "example_id": "a786dd98-45e4-4342-8103-ef98e7bb061f",
                                "sense_id": "eb6936b2-a7e7-3979-8a27-7caf3d5e56fd",
                                "text": "„Ausserdem werden auch noch alle beim Filiren und Doubliren der Seide, beim Spinnen der Floretstämme etc. entstehenden Abfälle zu Floretseide verarbeitet und gewöhnlich unter dem allgemeinen Namen Strazzen begriffen.“"
                            },
                            {
                                "example_id": "eb616495-3ec8-45c1-b339-85f82b5f4a8e",
                                "sense_id": "eb6936b2-a7e7-3979-8a27-7caf3d5e56fd",
                                "text": "„Im Jahre 1790 kaufte Schönfeld 25 240 Maulbeerbäume aus der Prager Umgebung, um ein neues Rohmaterial an Stelle der Strazzen zu gewinnen.“"
                            },
                            {
                                "example_id": "3f0e2b9f-219b-4814-af74-910958b64505",
                                "sense_id": "eb6936b2-a7e7-3979-8a27-7caf3d5e56fd",
                                "text": "„Unter den Strazzen nimmt die weisse chinesische den ersten Rang ein.“ (1894)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
