    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c92eadba-0c31-355f-a9ed-622839c5f6ed",
                "word": "breathlessness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e2b7ed15-93b3-4622-b641-d9c739d2bf8f",
                        "entry_id": "c92eadba-0c31-355f-a9ed-622839c5f6ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "breathlessnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "807c87be-b20c-36c1-9d13-99d83e01d5c8",
                        "entry_id": "c92eadba-0c31-355f-a9ed-622839c5f6ed",
                        "glosses": [
                            "The state of being breathless or out of breath, especially merely temporarily from exertion."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "68b49695-e803-4bbb-978b-aec872c831ed",
                                "sense_id": "807c87be-b20c-36c1-9d13-99d83e01d5c8",
                                "text": "Climbing eight flights of stairs while the elevator is out of service can easily produce some breathlessness in people whose physical fitness is otherwise not noticeably impaired."
                            },
                            {
                                "example_id": "3b673f0c-4f65-4c80-a57e-7503af2f3e47",
                                "sense_id": "807c87be-b20c-36c1-9d13-99d83e01d5c8",
                                "text": "Dickinson's longer lines and use of ampersands ^([Bronski means dashes]) creates a breathlessness that evokes sexual excitement, an urgency that precludes, or at least, overshadows thought."
                            }
                        ]
                    },
                    {
                        "sense_id": "41ec07ae-973d-39d8-bf9f-f40a4adccaa1",
                        "entry_id": "c92eadba-0c31-355f-a9ed-622839c5f6ed",
                        "glosses": [
                            "Difficult or labored breathing, as a symptom or sign of a medical condition."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "553c1c8d-acd3-4887-aaad-bf7bd20d4179",
                                "sense_id": "41ec07ae-973d-39d8-bf9f-f40a4adccaa1",
                                "text": "Since he'd entered the urgent care center, his breathlessness had only gotten worse, even though he'd been sitting quietly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "695d28a6-0155-406a-b84c-5e34ad980e29",
                        "source_entry_id": "c92eadba-0c31-355f-a9ed-622839c5f6ed",
                        "source_sense_description": "state of being breathless or out of breath",
                        "target_lang_word": "essoufflement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essoufflement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd30a28-683f-363b-a029-926bf2cdd3d0",
                                        "entry_id": "4baf0d64-c79b-3793-8bb6-94a9cc79f4c3",
                                        "glosses": [
                                            "État de celui, de celle, qui est essoufflé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67899c1a-e6dd-4976-a089-dd5c9b9f258b",
                                                "sense_id": "0cd30a28-683f-363b-a029-926bf2cdd3d0",
                                                "text": "En effet, la température s’abaissait sensiblement, et le moindre travail, le moindre effort produisait chez chaque individu un essoufflement qui le paralysait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                        "entry_id": "4baf0d64-c79b-3793-8bb6-94a9cc79f4c3",
                                        "glosses": [
                                            "Fort ralentissement qui annonce une fin prochaine."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1719f99-95f4-4f47-b8c3-2e74e4616c73",
                                                "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                                "text": "Une restauration n’est possible qu’aux brefs instants de lassitude quand les idées, les hommes et les faits s’accordent une trêve, quand l’essoufflement rompt l’assaut des générations montantes."
                                            },
                                            {
                                                "example_id": "6fbd42af-aa11-4067-9359-9011201e0f40",
                                                "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                                "text": "La rengaine de l’essoufflement de la mobilisation sans cesse matraqué par les grands médias commence à s’user."
                                            },
                                            {
                                                "example_id": "5d8eca05-10ab-479c-bf5d-c402df926881",
                                                "sense_id": "78c3fc67-9a21-334e-8276-e5dad7f270c4",
                                                "text": "L’analyste note également un maintien au cours des dernières années. « Il est quand même notable qu’il n’y ait pas eu plus d’essoufflement au cours des années », dit-elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f737f7ce-038a-4889-9ce3-821332d42dda",
                        "source_entry_id": "c92eadba-0c31-355f-a9ed-622839c5f6ed",
                        "source_sense_description": "state of being breathless or out of breath",
                        "target_lang_word": "halètement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halètement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c870b90c-4e42-39fa-bff2-1c3dd351da34",
                                        "entry_id": "68434336-0672-3bae-afea-d880fefd8227",
                                        "glosses": [
                                            "Action de haleter ou état de celui qui est haletant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a9cedd-e53b-4a34-bffa-0d1cf480793a",
                                                "sense_id": "c870b90c-4e42-39fa-bff2-1c3dd351da34",
                                                "text": "Ne te retourne jamais : derrière toi accourt le halètement des flammes de Sodome, et tu serais changé en statue de larmes pétrifiées."
                                            },
                                            {
                                                "example_id": "cc25c8ec-7045-4934-a616-7db76a7f6208",
                                                "sense_id": "c870b90c-4e42-39fa-bff2-1c3dd351da34",
                                                "text": "[…] et, à cet instant précis, le halètement sourd d'une locomotive et son cri rauque montant dans un jet de vapeur, m'emplirent d'un tel tumulte de sensations heurtées qu'eussé-je vu l'océan surgir et balayer de contraste le hideux mur de l'hôpital Lariboisière, ma stupéfaction n'aurait pas été plus profonde."
                                            },
                                            {
                                                "example_id": "1e1afe04-291d-4aa3-8ddc-ad15745bd58c",
                                                "sense_id": "c870b90c-4e42-39fa-bff2-1c3dd351da34",
                                                "text": "Yves, aveuglé par les larmes et qui n’entendait plus rien, entendit tout de même – dominant le bruit du cercueil raclé contre la pierre et le halètement des fossoyeurs à tête d’assassins – la voix implacable, la voix satisfaite de Dussol :\n— C’était une maîtresse femme !"
                                            },
                                            {
                                                "example_id": "44a3d507-117a-4ea7-bf65-eec661c95a23",
                                                "sense_id": "c870b90c-4e42-39fa-bff2-1c3dd351da34",
                                                "text": "Un halètement rauque, régulier et comme tiré des entrailles par un tourment bienheureux se liait à une plainte longue, fêlée, filée, qui, bien qu’humaine, ressemblait au cri des bêtes en pâmoison."
                                            },
                                            {
                                                "example_id": "2661f76f-e6af-461d-9003-ea5a7ec13205",
                                                "sense_id": "c870b90c-4e42-39fa-bff2-1c3dd351da34",
                                                "text": "[…], elle plongea une première fois la main dans son sac et commença à filmer nos ébats avec son iPhone 6 ! Comme en transe, elle psalmodiait des je-ne-sais-quoi dans son sabir magyar, entrecoupés de petits halètements saccadés de chienne mettant bas sa portée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e042f039-f6d7-3634-8897-f7c2e5e99775",
                                        "entry_id": "68434336-0672-3bae-afea-d880fefd8227",
                                        "glosses": [
                                            "Instabilité de combustion caractérisée par une succession périodique d'extinctions et d'allumages avec une période de l’ordre de la seconde."
                                        ],
                                        "tags": [
                                            "Propulsion spatiale"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
