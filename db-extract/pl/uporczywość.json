                "senses": [
                    {
                        "sense_id": "03a9fe4e-ea1b-3ab2-9f29-a593af25e0a3",
                        "entry_id": "ab17a9a3-4004-3a67-800e-db988a18fe9e",
                        "glosses": [
                            "cecha tego, co jest długotrwałe, powtarzalne i trudne do przezwyciężenia"
