                ],
                "senses": [
                    {
                        "sense_id": "706c9622-91a6-336a-8d6f-cbbb82c663bc",
                        "entry_id": "ca9e57a1-a2e7-37a4-8f7c-bddc8cdc12c3",
                        "glosses": [
                            "Unité de mesure de masse en dehors du Système international (mais dont l’usage est accepté avec le SI), valant 10⁶ tonnes, et dont le symbole est Mt."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "de4c37af-1923-3660-adf5-384fd6866f02",
                        "entry_id": "ca9e57a1-a2e7-37a4-8f7c-bddc8cdc12c3",
                        "glosses": [
                            "Unité de mesure d’énergie explosive, équivalant à un million de tonnes de TNT. Son symbole est Mt ou MtTNT."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2de5aa-d563-4f2f-b05c-93ef3b4f54bc",
                                "sense_id": "de4c37af-1923-3660-adf5-384fd6866f02",
                                "text": "Nous savons officieusement mais de façon à peu près certaine, que la puissance atomique globale de l’Amérique est approximativement quatre fois celle de la Russie ; la proportion se situe autour des chiffres suivants : 25.000 mégatonnes pour l’Amérique et 7.000 mégatonnes pour la Russie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5f3393a-3a98-4947-bb06-0e87077f27b1",
                        "source_entry_id": "ca9e57a1-a2e7-37a4-8f7c-bddc8cdc12c3",
                        "target_lang_word": "megaton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megaton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d91ecc33-1571-3498-bb66-ce2158d48899",
                                        "entry_id": "2eeb484d-4466-3770-afb0-c662dee935cd",
                                        "glosses": [
                                            "A measure of the strength of an explosion or a bomb based on how many million tons of TNT would be needed to produce the same energy. (A derived unit for TNT equivalent.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610e563b-bb6f-426c-b27c-ff749463e50d",
                                                "sense_id": "d91ecc33-1571-3498-bb66-ce2158d48899",
                                                "text": "Holonyms: gigaton < teraton < petaton < exaton (rare) < zettaton (rare) < yottaton (rare)"
                                            },
                                            {
                                                "example_id": "ff4f05f8-1d03-4c98-9ae6-836414f8201c",
                                                "sense_id": "d91ecc33-1571-3498-bb66-ce2158d48899",
                                                "text": "Meronyms: ton of TNT < kiloton"
                                            },
                                            {
                                                "example_id": "6c54f748-eb00-4cca-bb2e-b8efbd0578f5",
                                                "sense_id": "d91ecc33-1571-3498-bb66-ce2158d48899",
                                                "text": "The sins of all our fathers, being dumped on us — the sons\nThe only choice we're given is: How many megatons?\nAnd I eschew you!\nAnd I say: Screw you!\nAnd I hope you're blue, too."
                                            },
                                            {
                                                "example_id": "c19aef1e-6c16-4b85-93fe-679345feb98e",
                                                "sense_id": "d91ecc33-1571-3498-bb66-ce2158d48899",
                                                "text": "Integrating data from all continents and major biomes, we conservatively estimate 20 × 1015 (20 quadrillion) ants on Earth, with a total biomass of 12 megatons of dry carbon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494d77f5-c916-3c9f-a7e1-0d7290e791cd",
                                        "entry_id": "2eeb484d-4466-3770-afb0-c662dee935cd",
                                        "glosses": [
                                            "One million tons.",
                                            "One million short tons (10⁶ × 2000 lb)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa31d47f-d8e0-3eab-aabf-2177de778cc4",
                                        "entry_id": "2eeb484d-4466-3770-afb0-c662dee935cd",
                                        "glosses": [
                                            "One million tons.",
                                            "One million long tons (10⁶ × 2240 lb)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b32beb61-499b-3eeb-b015-9a1f25d047d8",
                                        "entry_id": "2eeb484d-4466-3770-afb0-c662dee935cd",
                                        "glosses": [
                                            "One million tons.",
                                            "One million metric tons (10⁶ × 2204.6 lb)."
                                        ],
