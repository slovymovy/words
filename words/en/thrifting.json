                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени или герундия от глагола thrift; покупка подержанных вещей в секонд-хендах или на барахолках."
                    },
                    "translations": {
                        "ru": [
                            {
