                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c7b34d0-9a41-4fc6-9114-88056d663148",
                        "source_entry_id": "13174fac-dc3e-32cf-8913-e63741a6914a",
                        "source_sense_id": "8bb76ebf-7244-301d-b384-6c565859ce7b",
                        "target_lang_word": "philanthropist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philanthropist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c288971e-35e3-337f-b5c5-9a9786b06484",
                                        "entry_id": "b178c394-45a2-3845-abef-daaa4c9d6218",
                                        "glosses": [
                                            "A person who loves humankind in general."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdc62a46-3825-3bfc-b15a-f97bb856af1b",
                                        "entry_id": "b178c394-45a2-3845-abef-daaa4c9d6218",
                                        "glosses": [
                                            "A person or institution who seeks to improve the world, especially by monetary gifts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c30120-3634-4941-b9c7-092310ed6385",
                                                "sense_id": "cdc62a46-3825-3bfc-b15a-f97bb856af1b",
                                                "text": "[…]and with a passing vague wonder as to what manner of man the ‘philanthropist’ might be who had more money than he knew what to do with,[…]"
                                            },
                                            {
                                                "example_id": "f8f7ff34-127a-4b46-915d-cd0a56fad6ae",
                                                "sense_id": "cdc62a46-3825-3bfc-b15a-f97bb856af1b",
                                                "text": "It is not uncommon for young philanthropists to retool their giving as they learn from their mistakes. Many other charities have only a single focus. But it has been jarring to allies of the Chan Zuckerberg Initiative to see such a wholesale discarding and downplaying of its prior work, especially given how public it had been about its goals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "366ebd83-e6f0-4eac-a81c-ce8d794a045b",
                        "source_entry_id": "13174fac-dc3e-32cf-8913-e63741a6914a",
                        "source_sense_id": "8bb76ebf-7244-301d-b384-6c565859ce7b",
                        "target_lang_word": "filantrop",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filantrop",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b1114acd-3bfc-36f5-a4dd-e8158ae1b7cb",
                                        "entry_id": "624fa025-ebc5-3273-9315-1814187d203f",
                                        "glosses": [
                                            "dobročinný člověk"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa663223-12f9-474e-b4c0-e73d0b795e48",
                        "source_entry_id": "13174fac-dc3e-32cf-8913-e63741a6914a",
                        "source_sense_id": "8bb76ebf-7244-301d-b384-6c565859ce7b",
                        "target_lang_word": "Philanthrop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philanthrop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f7ce03d-ed65-3a4c-85ca-d21e4583a2d8",
                                        "entry_id": "3cd9c102-d8fb-327d-92cc-7573b88d5ef4",
                                        "glosses": [
                                            "den Menschen bzw. der Menschheit freundlich gesinnte Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dc5db97-4751-43eb-ab41-ab593fee15de",
                                                "sense_id": "0f7ce03d-ed65-3a4c-85ca-d21e4583a2d8",
                                                "text": "Viele Philosophen werden wegen ihres Weltdurchblickes zu Philanthropen."
                                            },
                                            {
                                                "example_id": "6a62bb4c-f477-435f-a631-6c8c935b6b0d",
                                                "sense_id": "0f7ce03d-ed65-3a4c-85ca-d21e4583a2d8",
                                                "text": "„Der Philanthrop fördert Pläne zutage, äußert Ideen, vertraut ihre Ausführung dem Menschen, dem Schweigen, der Arbeit, Weisungen, stummen und machtlosen Dingen an.“"
                                            },
                                            {
                                                "example_id": "45e760f0-da36-4722-bd38-59f865b098d6",
                                                "sense_id": "0f7ce03d-ed65-3a4c-85ca-d21e4583a2d8",
                                                "text": "„Übrigens bin ich immerhin noch soweit Philanthrop, um meinen Lieben lieber zum Glücke zu verhelfen, als daß ich sie ins Unglück stürze.“"
                                            },
                                            {
                                                "example_id": "6179a9e8-fb35-4ece-a2ba-738d508c585c",
                                                "sense_id": "0f7ce03d-ed65-3a4c-85ca-d21e4583a2d8",
                                                "text": "„Solange er als bloßer Philanthrop aufgetreten, hatte er nichts geerntet als Reichtum, Beifall, Ehre und Ruhm.“"
                                            },
                                            {
                                                "example_id": "46ed34c4-b74b-4145-90ac-970dde97f52e",
                                                "sense_id": "0f7ce03d-ed65-3a4c-85ca-d21e4583a2d8",
                                                "text": "„\"Dies ist ein Weckruf für Politiker auf der ganzen Welt\", sagte der Leiter der Studie, der australische Unternehmer und Philanthrop Steve Killelea.“"
                                            },
                                            {
                                                "example_id": "9b1fc2b4-e2fe-4e3a-af7b-a821b44bd2ab",
                                                "sense_id": "0f7ce03d-ed65-3a4c-85ca-d21e4583a2d8",
                                                "text": "„Erstaunliche 50 Prozent der ugandisch-asiatischen Kinder studieren heute, um Ärzte, Kaufleute oder Anwälte zu werden – und haben die Gelegenheit, sich später einmal als Philanthropen zu betätigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d99457be-a2b6-442a-b83a-d69f4fd14e31",
                        "source_entry_id": "13174fac-dc3e-32cf-8913-e63741a6914a",
                        "source_sense_id": "8bb76ebf-7244-301d-b384-6c565859ce7b",
                        "target_lang_word": "филантроп",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "филантроп",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "995a7fab-4756-3346-9076-7430dab74fd2",
                                        "entry_id": "04b0ae04-3fb7-3cdd-aa74-c1b1ed5b9f9b",
                                        "glosses": [
                                            "то же, что благотворитель; покровитель нуждающихся, приверженец благотворительности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031afae4-1111-444f-b2b3-2cc3dc6a19cc",
                                                "sense_id": "995a7fab-4756-3346-9076-7430dab74fd2",
                                                "text": "Сегодня у памятника известного филантропа д-ра Ф. П. Гааза близ Александровской больницы экспромтом состоялось чествование биографа Газа А. Ф. Кони, приехавшего сегодня же в Москву."
                                            },
                                            {
                                                "example_id": "147fd504-7980-4122-9d8f-f2a506b2a05e",
                                                "sense_id": "995a7fab-4756-3346-9076-7430dab74fd2",
                                                "text": "Известный московский филантроп Н. А. Шахов имеет интересное обыкновение откликаться на крупнейшие выступления наших политических деятелей тем, что увековечивает каждый яркий шаг учреждением стипендий для недостаточных студентов московского университета."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362bb031-767d-3dd1-8924-6bc354c30a34",
                                        "entry_id": "04b0ae04-3fb7-3cdd-aa74-c1b1ed5b9f9b",
                                        "glosses": [
                                            "то же, что человеколюбец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ded7bc-585f-437e-91b8-00188cf8eb2f",
                                                "sense_id": "362bb031-767d-3dd1-8924-6bc354c30a34",
                                                "text": "Лука утешает и врёт, но он нисколько не филантроп и не моралист."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
