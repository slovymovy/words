                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebc41ecc-d7ff-4cd5-b296-cc57956ebab5",
                        "source_entry_id": "48a05760-767b-38a3-9535-03ee5bdbc5f2",
                        "source_sense_id": "a9fccf7a-9ba7-3628-9636-b97028bca7fa",
                        "source_sense_description": "Gefühl, dass man keine Kontrolle über Ereignisse hat",
                        "target_lang_word": "Verhängnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhängnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87b55a70-b125-3c5b-adb6-681e51ed88c9",
                                        "entry_id": "2f6f794d-3af5-3efa-90ee-7689f8d013a3",
                                        "glosses": [
                                            "ein Ereignis oder ein Zusammenwirken verschiedener Ereignisse, wodurch eine ungünstige Wendung des Schicksals herbeigeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1ab28f-54c1-47d8-964a-3acc55926385",
                                                "sense_id": "87b55a70-b125-3c5b-adb6-681e51ed88c9",
                                                "text": "Das Verhängnis nahm seinen Lauf."
                                            },
                                            {
                                                "example_id": "10c4d2d8-9e89-41b8-85ae-cf71647441ef",
                                                "sense_id": "87b55a70-b125-3c5b-adb6-681e51ed88c9",
                                                "text": "Die Wildschweinjagd wurde ihm zum Verhängnis."
                                            },
                                            {
                                                "example_id": "594d7074-8cb5-4c70-a959-5b0ba045c25f",
                                                "sense_id": "87b55a70-b125-3c5b-adb6-681e51ed88c9",
                                                "text": "Der frühe Wintereinbruch war sein Verhängnis."
                                            },
                                            {
                                                "example_id": "12c4114a-20c9-4014-a748-29de900fabd8",
                                                "sense_id": "87b55a70-b125-3c5b-adb6-681e51ed88c9",
                                                "text": "„Die von Mainz sanktionierten Verordnungen sollten zwei jungen Eichsfelderinnen zum Verhängnis werden.“"
                                            },
                                            {
                                                "example_id": "b0a31351-ecb3-4b75-9787-bf5682682d37",
                                                "sense_id": "87b55a70-b125-3c5b-adb6-681e51ed88c9",
                                                "text": "„Der Krieg ließ mich zum Kriegsgegner werden, ich hatte erkannt, daß der Krieg das Verhängnis Europas, die Pest der Menschheit, die Schande unseres Jahrhunderts ist.“"
                                            },
                                            {
                                                "example_id": "63bd66dd-82ea-40dc-bbcd-1c8059af66ec",
                                                "sense_id": "87b55a70-b125-3c5b-adb6-681e51ed88c9",
                                                "text": "„Sie schien einem furchtbaren Verhängnis mutig entgegensehen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06e9c586-9b71-433c-a261-1f5967df8257",
                        "source_entry_id": "48a05760-767b-38a3-9535-03ee5bdbc5f2",
                        "source_sense_id": "f5c22a9c-b670-3810-a55e-5b41bd88f727",
                        "source_sense_description": "eine durch Unfall, gewaltsamer Auseinandersetzung oder Krankheit getötete Person",
                        "target_lang_word": "Todesopfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Todesopfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd11c66-65b0-36f5-8243-9fecadb04185",
                                        "entry_id": "1cf0487a-aab5-3df4-8c23-4f66f7f73577",
                                        "glosses": [
                                            "jemand, der bei einem Unglück, einer Katastrophe oder Ähnlichem zu Tode gekommen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "687cad34-b608-4cde-8414-f2cae8b3bfca",
                                                "sense_id": "9cd11c66-65b0-36f5-8243-9fecadb04185",
                                                "text": "„Heftige Kämpfe zwischen der Armee und prorussischen Separatisten in der Ostukraine haben auch am Freitag mehrere Todesopfer gefordert.“"
                                            },
                                            {
                                                "example_id": "830279b2-bf5e-4dda-b8cb-fc187e38ae17",
                                                "sense_id": "9cd11c66-65b0-36f5-8243-9fecadb04185",
                                                "text": "„Die mit Abstand meisten der 16 Millionen Todesopfer unter 70 Jahren - nämlich 82 Prozent - lebten in Entwicklungs- und Schwellenländern.“"
                                            },
                                            {
                                                "example_id": "a21f94e7-baa6-4866-9a4b-e2e6c5afb7a4",
                                                "sense_id": "9cd11c66-65b0-36f5-8243-9fecadb04185",
                                                "text": "„Nach dem Absturz eines griechischen Kampfflugzeugs auf einem spanischen Luftwaffenstützpunkt hat sich die Zahl der Todesopfer auf elf erhöht.“"
                                            },
                                            {
                                                "example_id": "c5e5b947-8a0d-4bdd-882a-799ac468d401",
                                                "sense_id": "9cd11c66-65b0-36f5-8243-9fecadb04185",
                                                "text": "„Die Sache endete mit einem Bürgerkrieg, in den viele malaiische Häuptlinge hineingezogen wurden und der Tausende Todesopfer forderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
