                        "glosses": [
                            "Vorstellung von dem, was man riechen wird; Erwartungshaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d4975d-7ae9-4b27-81ba-2be28605c6ad",
                                "sense_id": "d7e831b3-6c49-31d9-8134-f3c1c7ca4488",
                                "text": "„Auch die Geruchserwartung erfüllt sich nicht.“"
                            },
                            {
                                "example_id": "104a6616-f8c7-44ae-9833-061d0335683f",
                                "sense_id": "d7e831b3-6c49-31d9-8134-f3c1c7ca4488",
                                "text": "„Eine andere mögliche Erklärung wäre, daß die konditionierte Kopplung des Versuchsraums mit der Geruchserwartung bei unangenehmen Geruchen starker ist als bei angenehmen.“"
                            },
                            {
                                "example_id": "acccfd24-7007-4620-a2ab-949279022471",
                                "sense_id": "d7e831b3-6c49-31d9-8134-f3c1c7ca4488",
                                "text": "„Es besteht also eine subjektive Diskrepanz zwischen der Geruchserwartung und der Geruchswahrnehmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
