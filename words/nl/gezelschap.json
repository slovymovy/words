            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e20140c8-87dc-3c7a-a4a3-548f0958f98d",
                    "sense_definition": "Het samenzijn met anderen of de aanwezigheid van iemand.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind het erg prettig om in jouw <w>gezelschap</w> te verkeren.",
                            "target_lang_translations": {
                                "ru": "Мне очень приятно находиться в твоей <w>компании</w>.",
                                "en": "I find it very pleasant to be in your <w>company</w>.",
                                "zh": "我觉得有你<w>陪伴</w>非常愉快。"
                            }
                        },
                        {
                            "text": "Mijn broer hield mij <w>gezelschap</w> tijdens het lange wachten op de trein.",
                            "target_lang_translations": {
                                "ru": "Мой брат составил мне <w>компанию</w> во время долгого ожидания поезда.",
                                "en": "My brother kept me <w>company</w> during the long wait for the train.",
                                "zh": "在漫长地等火车期间，我哥哥给我<w>作伴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aanwezigheid",
                        "omgang",
                        "bijzijn"
                    ],
                    "antonyms": [
                        "eenzaamheid",
                        "afzondering"
                    ],
                    "common_phrases": [
                        "gezelschap houden",
                        "in gezelschap van"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние пребывания вместе с другими или присутствие кого-либо.",
                        "en": "The state of being together with others or the presence of someone.",
                        "zh": "与他人在一起的状态，或某人的陪伴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компания",
                                "target_lang_sense_clarification": "пребывание вместе"
                            },
                            {
                                "target_lang_word": "общество",
                                "target_lang_sense_clarification": "присутствие кого-либо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "company",
                                "target_lang_sense_clarification": "presence of others"
                            },
                            {
                                "target_lang_word": "companionship",
                                "target_lang_sense_clarification": "fellowship"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陪伴",
                                "target_lang_sense_clarification": "陪同在一起的状态"
                            },
                            {
                                "target_lang_word": "作伴",
                                "target_lang_sense_clarification": "当伴儿、一起相处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de9adba0-364d-39c2-b9d2-257959630ad0",
                    "sense_definition": "Een groep mensen die samen iets onderneemt of bij elkaar is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het hele <w>gezelschap</w> ging na het diner nog even wandelen in het park.",
                            "target_lang_translations": {
                                "ru": "Вся <w>компания</w> после ужина отправилась немного прогуляться в парк.",
                                "en": "The whole <w>party</w> went for a short walk in the park after dinner.",
                                "zh": "晚餐后，这<w>一行人</w>去公园散了一会儿步。"
                            }
                        },
                        {
                            "text": "Er zat een luidruchtig <w>gezelschap</w> aan de tafel naast ons in het restaurant.",
                            "target_lang_translations": {
                                "ru": "За соседним столиком в ресторане сидела шумная <w>компания</w>.",
                                "en": "There was a noisy <w>party</w> sitting at the table next to us in the restaurant.",
                                "zh": "餐馆里我们隔壁桌坐着<w>一群人</w>，非常吵闹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "groep",
                        "kring"
                    ],
                    "common_phrases": [
                        "een vrolijk gezelschap",
                        "gemêleerd gezelschap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, которые делают что-то вместе или находятся вместе.",
                        "en": "A group of people doing something together or gathered together.",
                        "zh": "聚集在一起或共同参与某事的一群人。"
                    },
