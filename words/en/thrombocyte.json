                    "sense_id": "ed3b99bf-8f6d-361a-8763-e50740a6b9ef",
                    "sense_definition": "A small, colorless cell fragment in the blood that helps it clot; a platelet.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that a low count of <w>thrombocytes</w> can lead to excessive bleeding.",
                            "target_lang_translations": {
                                "zh": "医生解释说，<w>血小板</w>计数过低会导致出血不止。"
                            }
                        },
                        {
                            "text": "During the injury, the <w>thrombocytes</w> quickly gathered at the site to form a protective clot.",
                            "target_lang_translations": {
                                "zh": "受伤时，<w>血小板</w>会迅速聚集在伤口处，形成保护性的血凝块。"
                            }
                        }
                    ],
                    "synonyms": [
                        "platelet"
                    ],
                    "target_lang_definitions": {
                        "zh": "血液中一种无色的小细胞碎片，有助于血液凝固；即血小板。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "血小板",
                                "target_lang_sense_clarification": "医学术语，指血液中参与凝血过程的细胞碎片。"
                            }
                        ]
                    }
                }
            ]
