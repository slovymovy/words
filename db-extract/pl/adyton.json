                    }
                ],
                "senses": [
                    {
                        "sense_id": "9694bf14-7c30-377a-9ce0-f4bd27cbeda4",
                        "entry_id": "c0719d3d-6895-3edc-b105-21a619e7834c",
                        "glosses": [
                            "ukryta przestrzeń w sanktuarium greckim (np. w świątyni, gaju, grocie), dostępna tylko dla kapłanów i osób wybranych, które przeszły obrzęd oczyszczenia, gdzie przechowywane były świętości: posąg bóstwa, przedmioty kultu i dary dla niego, czasem mieściła się tam także wyrocznia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31280739-8304-4fdc-845f-a2b8b707fc38",
                                "sense_id": "9694bf14-7c30-377a-9ce0-f4bd27cbeda4",
                                "text": "Apokryficzna literatura żydowska i heretycka wzór swój brała z tajemniczych ksiąg poganizmu, które miały pochodzić bezpośrednio od bogów (…) Księgi te, zapisujące ceremonje kapłańskie, tłumaczące znaczenie mytów, zajmujące się zjawiskami natury, były księgami przystępnemi tylko dla kapłanów i wtajemniczonych (…) Po większej części chowano je w najświętszém miejscu świątyni, w tak nazwaném adyton."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f24acbef-522a-48f0-92b9-c7e2bd3ad3f4",
                        "source_entry_id": "c0719d3d-6895-3edc-b105-21a619e7834c",
                        "source_sense_id": "9694bf14-7c30-377a-9ce0-f4bd27cbeda4",
                        "target_lang_word": "adyton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adyton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                                        "entry_id": "c8acfd32-d067-373f-b1e6-96d8820a103d",
                                        "glosses": [
                                            "Synonym of adytum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d02d26a-79e9-4bcc-9391-cd10cda91d31",
                                                "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                                                "text": "The temple had no opisthodomos as usually understood, but this name was given at Didyma to the west wall of the adyton. The adyton floor was covered with a pavement in later centuries, but in the third century B.C. a grove of bay trees, it appears, grew in the adyton (and this is probably true of the archaic Didymeion)."
                                            },
                                            {
                                                "example_id": "7aebee48-ad21-4d94-8091-fd93b55beffe",
                                                "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                                                "text": "1998 [Routledge], Rodney Castleden, Atlantis Destroyed, 2001, Taylor & Francis (Routledge), Paperback, page 101,\nHere too is the only adyton so far discovered at Akrotiri. There are four in the temple at Knossos, and because the Akrotiri adyton is embellished with frescoes illuminating its use it is a crucial example, throwing light on the way the four adyta at Knossos were used."
                                            },
                                            {
                                                "example_id": "06cbf5ae-1357-4ce2-86e5-ad5222abaa53",
                                                "sense_id": "4305d6c8-d5bd-32dd-8f93-da9c9d614ac8",
                                                "text": "Others with similar elaborate adytons are at Qasr Neba and Sfira in Lebanon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecffe44a-5ee5-47f1-932d-5e87fcac7af5",
                        "source_entry_id": "c0719d3d-6895-3edc-b105-21a619e7834c",
                        "source_sense_id": "9694bf14-7c30-377a-9ce0-f4bd27cbeda4",
                        "target_lang_word": "adyton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adyton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9cbded3-b27d-34f3-bbba-ed509fc23002",
                                        "entry_id": "d2a1aec5-7868-3556-b055-5c1f03a40a0a",
                                        "glosses": [
                                            "Espace sacré interdit aux profanes, aux non-initiés. Il pouvait s’agir d’un temple ou d’un endroit sauvage comme une forêt sacrée."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84c5a052-6d86-3b57-80ac-ac4ec4589885",
                                        "entry_id": "d2a1aec5-7868-3556-b055-5c1f03a40a0a",
                                        "glosses": [
                                            "Crypte, cella, espace secret dans un temple."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41f29f44-4294-42ba-b0a2-ab170d188d4a",
                                                "sense_id": "84c5a052-6d86-3b57-80ac-ac4ec4589885",
                                                "text": "Dans une troisième salle (adyton) fort obscure, et au milieu de laquelle s'élève un petit autel carré, le pharaon est mis au rang des dieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1f0ce98-10d4-48d2-9633-4945adb6f572",
                        "source_entry_id": "c0719d3d-6895-3edc-b105-21a619e7834c",
                        "source_sense_id": "9694bf14-7c30-377a-9ce0-f4bd27cbeda4",
                        "target_lang_word": "adytum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adytum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa11d0c3-6d16-34ef-bc6d-7797b457506d",
                                        "entry_id": "091871c5-e000-3813-8ca4-28033cb9ba5f",
                                        "glosses": [
                                            "Chambre particulière ou secrète dans un temple."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8651f5e8-e5bd-44ee-bf94-fb83d3668858",
                                                "sense_id": "fa11d0c3-6d16-34ef-bc6d-7797b457506d",
                                                "text": "Lorsque la porte d'entrée est à l’est, l’adytum est reculé sensiblement en arrière vers l’ouest, et il est déplacé d’une bien moins grande quantité à droite, vers le nord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
