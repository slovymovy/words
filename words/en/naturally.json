    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f04e0abd-b119-338f-9770-964f03d2fa67",
                    "sense_definition": "In a normal way that is not artificial or forced.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to act <w>naturally</w> when the teacher entered the room.",
                            "target_lang_translations": {
                                "ru": "Он старался вести себя <w>естественно</w>, когда учитель вошёл в комнату.",
                                "zh": "老师进屋时，他尽量表现得<w>自然</w>一些。"
                            }
                        },
                        {
                            "text": "The plants grow <w>naturally</w> in this climate without any help.",
                            "target_lang_translations": {
                                "ru": "Растения растут <w>естественно</w> в этом климате без какой-либо помощи.",
                                "zh": "在这种气候下，这些植物无需任何人工辅助就能<w>自然</w>生长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unaffectedly",
                        "genuinely",
                        "normally"
                    ],
                    "antonyms": [
                        "artificially",
                        "unnaturally"
                    ],
                    "common_phrases": [
                        "act naturally",
                        "behave naturally",
                        "occur naturally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественным образом, без притворства или напряжения.",
                        "zh": "以一种不造作、不勉强的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "естественно",
                                "target_lang_sense_clarification": "непринуждённо"
                            },
                            {
                                "target_lang_word": "непринуждённо",
                                "target_lang_sense_clarification": "свободно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自然地",
                                "target_lang_sense_clarification": "表现得不刻意"
                            },
                            {
                                "target_lang_word": "不加修饰地",
                                "target_lang_sense_clarification": "真实且不造作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4204e591-3a88-387e-9a60-77b1fe4d7aca",
                    "sense_definition": "As you would expect; of course.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Naturally</w>, I was very happy to hear the good news.",
                            "target_lang_translations": {
                                "ru": "<w>Естественно</w>, я был очень рад услышать хорошие новости.",
                                "zh": "<w>当然</w>，听到这个好消息我非常高兴。"
                            }
                        },
                        {
                            "text": "She <w>naturally</w> wanted to see her family again after so long.",
                            "target_lang_translations": {
                                "ru": "Она, <w>естественно</w>, хотела снова увидеть свою семью после столь долгой разлуки.",
                                "zh": "分别这么久，她<w>当然</w>想再见到家人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certainly",
                        "undoubtedly",
                        "without a doubt",
                        "of course",
                        "obviously"
                    ],
                    "antonyms": [
                        "surprisingly",
                        "unexpectedly"
                    ],
                    "common_phrases": [
                        "quite naturally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Как и следовало ожидать; разумеется.",
                        "zh": "正如所料；理所当然。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "естественно",
                                "target_lang_sense_clarification": "разумеется"
                            },
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "безусловно"
                            },
                            {
                                "target_lang_word": "разумеется",
                                "target_lang_sense_clarification": "само собой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当然",
                                "target_lang_sense_clarification": "表示理应如此"
                            },
                            {
                                "target_lang_word": "理所当然",
                                "target_lang_sense_clarification": "强调事情发生的必然性"
                            },
                            {
                                "target_lang_word": "不用说",
                                "target_lang_sense_clarification": "表示显而易见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcfdf839-7b3c-3b32-b864-565a867067c3",
                    "sense_definition": "By birth or basic character; inherently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>naturally</w> gifted athlete who learns sports quickly.",
                            "target_lang_translations": {
                                "ru": "Он <w>от природы</w> одарённый спортсмен, который быстро учится.",
                                "zh": "他是一位<w>天生</w>有天赋的运动员，学起运动项目来很快。"
                            }
                        },
                        {
                            "text": "Some people are <w>naturally</w> better at learning languages than others.",
                            "target_lang_translations": {
                                "ru": "Некоторым людям языки даются <w>от природы</w> лучше, чем другим.",
                                "zh": "有些人<w>天生</w>就比别人更擅长学习语言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "innately",
                        "intrinsically",
                        "essentially"
                    ],
                    "antonyms": [
                        "artificially"
                    ],
                    "common_phrases": [
                        "naturally gifted",
                        "naturally talented"
                    ],
                    "target_lang_definitions": {
                        "ru": "От рождения, по своей природе или сущности.",
                        "zh": "天生；本质上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "от природы",
                                "target_lang_sense_clarification": "врождённо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天生",
                                "target_lang_sense_clarification": "与生俱来"
                            },
                            {
                                "target_lang_word": "生来",
                                "target_lang_sense_clarification": "从出生起就具备"
                            }
                        ]
                    }
                }
