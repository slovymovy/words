                "senses": [
                    {
                        "sense_id": "56d02921-ecdb-3f20-bb22-0d3997be9dfb",
                        "entry_id": "d8e999c9-07ae-3e66-8031-f24a0e7ed16a",
                        "glosses": [
                            "Of, pertaining to, or characteristic of a mouse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cbac2d2-0349-4a2d-8aa4-07ac6a45e998",
                                "sense_id": "56d02921-ecdb-3f20-bb22-0d3997be9dfb",
                                "text": "They had watched, paralysed, as, squeaking with terror, her small murine body was ripped to pieces, Tilly yipping gleefully with excitement all the while."
                            }
                        ]
                    },
                    {
                        "sense_id": "77cf877d-086f-387b-a2cd-b9bde12a38e0",
                        "entry_id": "d8e999c9-07ae-3e66-8031-f24a0e7ed16a",
                        "glosses": [
                            "More generally, of, pertaining to, or characteristic of any rodent up to the taxonomic rank of Muroidea, most often with reference to mice and rats of the subfamily Murinae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a9b13c-1693-4d6b-b525-0304f474d028",
                                "sense_id": "77cf877d-086f-387b-a2cd-b9bde12a38e0",
                                "text": "1977, Richard Peto⁽ᵂᴾ⁾\nAre our stem cells really, then, a billion or a trillion times more \"cancerproof\" than murine stem cells?"
                            },
                            {
                                "example_id": "8d8bf68d-0e48-48ac-9220-6c3dcdeb7c5e",
                                "sense_id": "77cf877d-086f-387b-a2cd-b9bde12a38e0",
                                "text": "One of the first examples of the immunogenicity of recombinantly derived antibodies was with murine anti-CD3 monoclonal antibody (OKT3) used in the induction of immunosupression after organ transplantation."
                            }
                        ]
                    }
                ],
