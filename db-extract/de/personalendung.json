                "senses": [
                    {
                        "sense_id": "64ff3526-f39b-380d-96e3-fdac1489c1f7",
                        "entry_id": "30be4e86-6f11-39be-9361-8aa764e7ac8e",
                        "glosses": [
                            "Bestandteil von Verben (Suffix), der die Kategorie Person ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f27accc2-eed7-4a86-921e-3fee8c616dbc",
                                "sense_id": "64ff3526-f39b-380d-96e3-fdac1489c1f7",
                                "text": "\"-st\" ist im Deutschen eine häufig verwendete Personalendung für die 2. Person Singular von Verben (Konjugation)."
                            },
                            {
                                "example_id": "8b87ea67-0e50-49b7-beb1-b48fcc8af549",
                                "sense_id": "64ff3526-f39b-380d-96e3-fdac1489c1f7",
                                "text": "Im Deutschen gibt es Personalendungen für die erste, die zweite und die dritte Person, und zwar im Singular und im Plural."
                            },
                            {
                                "example_id": "c4671091-7ba8-4883-ae70-0f0b356e761d",
                                "sense_id": "64ff3526-f39b-380d-96e3-fdac1489c1f7",
                                "text": "„Die Flexion der Tempora und ihrer Modi kommt dadurch zustande, daß an den jeweiligen Stamm die Personalendungen treten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
