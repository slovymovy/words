                        "examples": [
                            {
                                "example_id": "763fea4f-0be7-4f2e-a976-bcdfdb4d72b8",
                                "sense_id": "50b712bc-43d0-3a04-911c-ab9f7019e7ad",
                                "text": "„Spätestens ab dem 13. Jahrhundert, so konnten Forscher nachweisen, haben die Bewohner die Palmwälder der [Oster-]Insel nach und nach gerodet.“"
                            },
                            {
                                "example_id": "3aa94124-1a67-45c8-a946-a6fd9edb2c45",
                                "sense_id": "50b712bc-43d0-3a04-911c-ab9f7019e7ad",
                                "text": "„Wo einst dichte Palmwälder standen, gibt es auf ›Rapa Nui‹ heute nur mehr karge Grasflächen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
