                "senses": [
                    {
                        "sense_id": "eab22bcd-801b-3cef-a2a7-36cc798770cf",
                        "entry_id": "a2372584-d6d8-3c70-be95-4e7d4dc62854",
                        "glosses": [
                            "физ. связанный с протоном, относящийся к нему"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1abd03aa-e429-40ca-9437-c24953deca79",
                                "sense_id": "eab22bcd-801b-3cef-a2a7-36cc798770cf",
                                "text": "Протонная радиоактивность характерна для возбуждённых протонно-избыточных ядер."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8d0afff-1fcf-3a71-b57a-2bc905e45912",
                        "entry_id": "a2372584-d6d8-3c70-be95-4e7d4dc62854",
                        "glosses": [
                            "хим. (о растворителе) содержащий в составе своих молекул атомы водорода, способные перемещаться к другим молекулам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9ca176-f3b9-46a9-8531-bb9be81e68e5",
                                "sense_id": "c8d0afff-1fcf-3a71-b57a-2bc905e45912",
                                "text": "Вода и этанол являются протонными растворителями."
                            }
                        ]
                    }
