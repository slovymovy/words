                "senses": [
                    {
                        "sense_id": "d1f00a8f-98bc-3604-b66b-4e8b90f6aeda",
                        "entry_id": "8afeee82-cc69-3150-854a-6f7f2403a79c",
                        "glosses": [
                            "Voyager en sous-marin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "217d76b3-7d3f-4cce-a250-b3c86972cdc0",
                                "sense_id": "d1f00a8f-98bc-3604-b66b-4e8b90f6aeda",
                                "text": "Héhéhé plein d’indices pour éviter les erreurs de parents / darons… c’est pour ça que je te suis à 44 ans, avec l’impression de sous-mariner dans un monde qui m’échappe et me touche… merci !"
                            },
                            {
                                "example_id": "0b51a32f-d5fb-4877-a759-3ea7d08cfe5e",
                                "sense_id": "d1f00a8f-98bc-3604-b66b-4e8b90f6aeda",
                                "text": "Pendant qu’on continue à sous-mariner, le régime a les mains libres."
                            },
                            {
                                "example_id": "0565aa1e-51b8-4a6b-be3a-7dc10cfb0107",
                                "sense_id": "d1f00a8f-98bc-3604-b66b-4e8b90f6aeda",
                                "text": "Ils traînent sur tous les chemins vicinaux, connaissent toutes les salles de vente, tous les marrons qui sous-marinent dans le truc à travers toutes les provinces d’Europe."
                            }
                        ]
                    }
