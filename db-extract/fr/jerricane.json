                    {
                        "sense_id": "da9f0554-0a53-32bd-b2e2-5a3c4af8ff3f",
                        "entry_id": "b234366f-4399-38b5-abbb-6d07cd16e010",
                        "glosses": [
                            "Variante orthographique de jerrican."
                        ],
                        "tags": [
