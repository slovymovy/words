                                            {
                                                "example_id": "f4381c2c-4f57-4ad2-883a-6f0516a8abbc",
                                                "sense_id": "d830eb4d-07ae-3388-90e2-372f5b8692cc",
                                                "text": "Er liebt Pfannkuchen mit Apfelmus."
                                            },
                                            {
                                                "example_id": "6084b38b-b9d0-4ca4-817c-84283d3c28bb",
                                                "sense_id": "d830eb4d-07ae-3388-90e2-372f5b8692cc",
                                                "text": "„Sie reichte mir dafür zwei Pfannkuchen mit Streuzucker.“"
                                            },
                                            {
                                                "example_id": "07d04ee6-6643-479e-97df-cec6c6079191",
                                                "sense_id": "d830eb4d-07ae-3388-90e2-372f5b8692cc",
                                                "text": "„Ob klein oder groß, dünn oder dick, herzhaft oder süß – Pfannkuchen gehören zweifelsohne zu den beliebtesten Eierspeisen.“"
                                            },
                                            {
                                                "example_id": "df936875-db6d-444b-8c88-aedffc45c703",
                                                "sense_id": "d830eb4d-07ae-3388-90e2-372f5b8692cc",
                                                "text": "„Geben Sie den Teig löffelweise in die heiße Pfanne und braten Sie die Pfannkuchen kurz von einer Seite braun an.“"
                                            },
                                            {
                                                "example_id": "aa8c7a10-0771-40dd-a6ce-17c18b05ea24",
                                                "sense_id": "d830eb4d-07ae-3388-90e2-372f5b8692cc",
                                                "text": "„Die Hälfte des Öls in einer großen, beschichteten Pfanne erhitzen und aus der Hälfte des Teigs einen Pfannkuchen backen, Pfannkuchen herausnehmen und zur Seite stellen.“"
                                            },
                                            {
                                                "example_id": "6f662307-94a4-4b79-a8e0-cf09224a8ade",
                                                "sense_id": "d830eb4d-07ae-3388-90e2-372f5b8692cc",
                                                "text": "Zum Kaffee bringt Oma Pfannkuchen mit Zuckerguss mit."
                                            }
                                        ],
