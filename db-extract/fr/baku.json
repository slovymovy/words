                                "target_senses": [
                                    {
                                        "sense_id": "abdb2644-2a1e-394f-8799-b7a2b66c55c4",
                                        "entry_id": "c16a75ac-9e07-3291-b0d9-5962b226faa2",
                                        "glosses": [
                                            "A type of supernatural being said to devour nightmares."
                                        ],
                                        "tags": [
                                            "Japanese"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc4a3368-6bce-43d7-a879-3e03d01d0390",
                                                "sense_id": "abdb2644-2a1e-394f-8799-b7a2b66c55c4",
                                                "text": "2005, David Booth, Story Drama, 2nd edition, Pembroke Publishers, page 49,\nThe creature explained that he was a baku. A baku eats dreams and nightmares. To a baku, a bad dream is delicious!"
                                            },
                                            {
                                                "example_id": "7eaaaf3f-836f-4398-bc69-2e1c1b2dddbc",
                                                "sense_id": "abdb2644-2a1e-394f-8799-b7a2b66c55c4",
                                                "text": "2008, \"Baku\", entry in Brenda Rosen, The Mythical Creatures Bible, Octopus Publishing Group, page 113,\nA person awakening from a nightmare should call three times saying, \"Baku, eat my dreams.\" Thus summoned, the Baku will turn bad omens into good fortune by devouring evil influences."
                                            },
                                            {
                                                "example_id": "1824b15f-b25c-4417-927c-7892bff01f66",
                                                "sense_id": "abdb2644-2a1e-394f-8799-b7a2b66c55c4",
                                                "text": "Shouting out \"Devour my dream, Baku!\" is said to bring Baku to a child's side to take away his or her bad dreams. Not only does Baku take the dreams away, but he also leaves good fortune in their place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
