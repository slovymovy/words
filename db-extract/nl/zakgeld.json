                ],
                "senses": [
                    {
                        "sense_id": "3b66bb9f-59fb-34de-9202-ac3de0af874d",
                        "entry_id": "22e7f519-7e38-342e-b387-ff144d96793f",
                        "glosses": [
                            "een hoeveelheid geld die een jongere per week of maand van zijn of haar ouders ontvangt om vrij te besteden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6981a5d-7936-492b-b111-47dd9f7aa6c6",
                                "sense_id": "3b66bb9f-59fb-34de-9202-ac3de0af874d",
                                "text": "Wanneer krijg ik eens wat meer zakgeld?"
                            },
                            {
                                "example_id": "65004b5f-9012-4de4-8d50-5097774e2575",
                                "sense_id": "3b66bb9f-59fb-34de-9202-ac3de0af874d",
                                "text": "En ik had al drie weken geen zakgeld gekregen. Ze werd natuurlijk meteen chagrijnig toen ik over geld begon."
                            },
                            {
                                "example_id": "d6e52bf2-5fea-4ea3-b013-c16e8a0e52c0",
                                "sense_id": "3b66bb9f-59fb-34de-9202-ac3de0af874d",
                                "text": "Ze was ook weer begonnen met zakgeld, ik kon zowel flipperen als twee keer per week naar de bioscoop gaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94262d5d-642d-4046-890f-d2891ff05427",
                        "source_entry_id": "22e7f519-7e38-342e-b387-ff144d96793f",
                        "source_sense_id": "3b66bb9f-59fb-34de-9202-ac3de0af874d",
                        "target_lang_word": "Taschengeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschengeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                                        "entry_id": "1f4e660e-9a83-31fb-861c-49618533733b",
                                        "glosses": [
                                            "Geld, das einer Person, meist einem Heranwachsenden oder dem Lebenspartner, zur freien Verfügung geben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c99a366-546a-4a9a-805c-4d445c2bfb6c",
                                                "sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                                                "text": "Papi! Kann ich mehr Taschengeld bekommen?"
                                            },
                                            {
                                                "example_id": "c4a37155-acb4-427f-943a-33c0c35e4b36",
                                                "sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                                                "text": "Dein Taschengeld tät dir reichen, wenn du nicht laufend unnötige Dinge kaufen würdest."
                                            },
                                            {
                                                "example_id": "b0501b8a-a7f0-409b-bcdf-e7c8ccc546c4",
                                                "sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                                                "text": "„Und Taschengeld gab es ohnehin keins.“"
                                            },
                                            {
                                                "example_id": "ca2240ce-4ed1-4235-9240-76b556a9323f",
                                                "sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                                                "text": "„Von seinem Taschengeld hatte sich Robert ein Grammophon gekauft, eins zum Aufziehen.“"
                                            },
                                            {
                                                "example_id": "1b26412b-9586-4155-b441-b80c218ab1a3",
                                                "sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                                                "text": "„Es wurde ein Taschengeld von einer Mark pro Tag gezahlt, also ein Fünftel des Durchschnittslohns deutscher Hilfsarbeiter.“"
                                            },
                                            {
                                                "example_id": "bf0edf54-088b-43f6-ad28-98c51f29049b",
                                                "sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                                                "text": "„Chanel hatte uns Taschengeld für das Hotel gegeben, eine bestimmte Summe, die wir dort ausgeben könnten, es wäre töricht, diese Gelegenheit nicht zu nutzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
