                        "glosses": [
                            "kaart die toegang geeft tot een bepaald vervoermiddel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d227d12-b2d2-4f48-ba71-d5b022a2ca06",
                                "sense_id": "4023edf8-20b4-3360-b41f-75cf5e9a3551",
                                "text": "Sommige studenten waren vermoedelijk vergeten de reiskaart te annuleren, anderen hebben het mogelijk bewust gedaan om goedkoper te kunnen reizen."
                            },
                            {
                                "example_id": "c5e76115-a695-49d1-afa5-be91d34515db",
                                "sense_id": "4023edf8-20b4-3360-b41f-75cf5e9a3551",
                                "text": "Binnenkort kan er met de ov-chipkaart betaald worden in alle winkels op de stations in Nederland. Dat maakte Servex, een dochterbedrijf van de NS vandaag bekend. Het plan is om deze manier van betalen dit najaar in te voeren. Betalen met de elektronische reiskaart zou slechts 1 of 2 seconde duren, terwijl pinnen 10 tot 15 seconde in beslag neemt."
                            }
                        ]
                    },
                    {
                        "sense_id": "338417e9-c67c-391b-87af-3623d7cd3ce9",
                        "entry_id": "7d90d937-b259-3c87-96f5-26b03d7f7f43",
                        "glosses": [
                            "een landkaart waarop voor reizigers belangrijke informatie staat afgebeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "083201a2-5f02-4ca4-87ab-c6e2e30c3a3c",
                                "sense_id": "338417e9-c67c-391b-87af-3623d7cd3ce9",
                                "text": "De Romeinse reiskaart uit de 3e en 4e eeuw na Christus beslaat het gebied van Groot-Brittannië tot aan de rivier de Ganges, die door India en Bangladesh stroomt."
                            }
                        ]
