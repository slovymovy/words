                        "examples": [
                            {
                                "example_id": "b6cc8512-baf3-4088-8a0e-765048280a9d",
                                "sense_id": "a31abfc6-2186-3820-a190-39ba41499a8c",
                                "text": "Het is weer de negenendertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "13d58986-c272-48b5-9b7d-820e1a0b0e6d",
                                "sense_id": "a31abfc6-2186-3820-a190-39ba41499a8c",
                                "text": "Haar veertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de negenendertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "b785e8c3-bf84-3b5c-90dd-6342407b8ea0",
                        "entry_id": "de7a52c8-be81-3c9b-badf-dc02dc687554",
                        "glosses": [
