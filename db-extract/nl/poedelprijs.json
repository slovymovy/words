                                        "entry_id": "4eb2c2b0-3153-3c4d-85bf-dea3b50b2214",
                                        "glosses": [
                                            "A prize or status, often unwelcome, awarded as a joke or disincentive to the loser of a contest or for poor performance."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d221ab52-9735-4c7a-b826-6ea56f29307a",
                                                "sense_id": "09b722a1-ed2b-386c-a4ea-84975c819d63",
                                                "text": "At the end of the conference, they awarded him with a rubber chicken as a booby prize for complaining the loudest."
                                            },
                                            {
                                                "example_id": "2206c335-7541-4c60-8687-bb9a99c79706",
                                                "sense_id": "09b722a1-ed2b-386c-a4ea-84975c819d63",
                                                "text": "\"Network Rail needs to take all the booby prizes going, for a ham-fisted, over-budget, over-time infrastructure project,\" local activist John Mair told RAIL."
                                            }
                                        ]
                                    }
                                ]
