                            {
                                "example_id": "46f7ea83-a401-4a0e-acd2-cfc3b78a03a8",
                                "sense_id": "e0a1c206-11e2-39dc-8cf2-58bdcb051954",
                                "text": "Natuurmonumenten en het waterschap werken al een paar jaar aan maatregelen om de beek minder droogtegevoelig te maken maar daarvoor heeft de natuur tijd nodig, zeggen de organisaties."
                            },
                            {
                                "example_id": "aba304e6-d085-4d03-ab83-c72166d0b782",
                                "sense_id": "e0a1c206-11e2-39dc-8cf2-58bdcb051954",
                                "text": "Volgens het Hoogheemraadschap van Rijnland loopt het neerslagtekort nog steeds op. Daarom worden alle dijken en kades in de regio met een man of 25 gecontroleerd. Zeker 60 kilometer dijk in het gebied is zeer droogtegevoelig en wordt nauwlettend in de gaten gehouden."
                            }
                        ]
