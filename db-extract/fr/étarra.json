                    {
                        "sense_id": "0d1f1932-0fc9-3a96-8ac4-955ed87104d3",
                        "entry_id": "8fbbf354-da34-3479-b107-0ca8606d1682",
                        "glosses": [
                            "Relatif à l’ETA."
