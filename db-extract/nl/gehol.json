                                        "entry_id": "34192522-489e-3007-b2d1-def80dafefe3",
                                        "glosses": [
                                            "The act of one who hurries; hasty motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d808800-4631-44da-a44b-19274b7635fa",
                                                "sense_id": "19473036-d85f-35fa-bd2e-e2ce5b874bd7",
                                                "text": "Consider the hurryings of Jesus from Caiaphas to Pilate; now he stands before Pilate where he was accused of sedition, seduction and usurpation."
                                            }
