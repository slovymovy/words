                        ],
                        "form": "einem Allerheiligsten"
                    },
                    {
                        "form_id": "6ee38ba7-e191-4692-8921-a76393966638",
                        "entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "ein Allerheiligstes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e967f017-bd7e-3e95-bb89-3b16513421f9",
                        "entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "glosses": [
                            "der innerste Teil des Tempels, in welchem die Bundeslade aufbewahrt wurde und der nur einmal im Jahr vom Hohepriester betreten werden durfte"
                        ],
                        "tags": [
                            "Judentum"
                        ],
                        "examples": [
                            {
                                "example_id": "d71345f0-ee70-4bfd-93c1-87a5945bef97",
                                "sense_id": "e967f017-bd7e-3e95-bb89-3b16513421f9",
                                "text": "Das Allerheiligste durfte nur am Versöhnungsfest betreten werden."
                            },
                            {
                                "example_id": "d03937d8-9e21-44fa-bbf5-63351ccdd0c6",
                                "sense_id": "e967f017-bd7e-3e95-bb89-3b16513421f9",
                                "text": "„Der Überlieferung nach stand das Allerheiligste im Inneren des Tempels auf dem Felsen selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
                        "entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "glosses": [
                            "ein Ort, Gebäude, Gegenstand von zentraler kultischer Bedeutung"
                        ],
                        "tags": [
                            "im Christentum"
                        ],
                        "examples": [
                            {
                                "example_id": "457e4446-09a3-4613-9276-83ebc090ff9d",
                                "sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
                                "text": "Meine Kinderstube darfst du leider nicht betreten – die ist mein Allerheiligstes."
                            },
                            {
                                "example_id": "6c75d9d3-bb58-4c48-89c6-fa5793738a7e",
                                "sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
                                "text": "„Jetzt lächelte sie nur und teilte ihm mit, dass der Direktor ihn gern im Allerheiligsten sehen möchte.“"
                            },
                            {
                                "example_id": "7813f346-3f95-4ea0-970e-0bf4dd32a068",
                                "sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
                                "text": "„Lampe hört in diesem Augenblick Divisch in seinem Allerheiligsten an einer Bewässerungspumpe arbeiten, um den Regen auf den Kopf zu stellen.“"
                            },
                            {
                                "example_id": "4fe8fb6a-fe62-485d-8e64-c4d98a516541",
                                "sense_id": "e620a86a-8a3a-3396-930c-f990b0ac031a",
                                "text": "„Einen Tag zuvor hatte ich die Tür zu meiner Werkstatt aufgeschlossen und Benjamin Ballantyne in mein Allerheiligstes geführt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "eb094aac-d7d3-3f5f-a149-bd39a1bfe794",
                        "entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "3a93e3a8-7dec-4efb-b559-6d614a8b43eb",
                                "sense_id": "eb094aac-d7d3-3f5f-a149-bd39a1bfe794",
                                "text": "Das Allerheiligste wird an Fronleichnam in der Monstranz durch die Straßen getragen."
                            }
                        ],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "7e272ed7-79e1-3333-8c78-3765f8886729",
                        "entry_id": "770a6e53-35e8-3550-9d2d-b0302ae27f41",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "0c57ece2-71cb-42c2-999d-d4b76e6cc7a2",
                                "sense_id": "7e272ed7-79e1-3333-8c78-3765f8886729",
                                "text": "Das Allerheiligste einer orthodoxen Kirche, auch Altarraum genannt, darf beim Gottesdienst nur von Klerikern betreten werden."
                            }
                        ],
                        "sense_index_json": "\"2b\""
                    }
                ],
