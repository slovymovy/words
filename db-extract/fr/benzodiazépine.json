                                    {
                                        "sense_id": "d11c312f-4716-3a40-aeb3-9d201769f0ca",
                                        "entry_id": "351de86c-ac22-3630-8573-6c7cfb164a86",
                                        "glosses": [
                                            "Any of a class of psychoactive drugs, structured upon diazepine, used in the treatment of anxiety, insomnia and other related disorders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d2cc48-2e15-490e-8ef8-4821aca7a0a1",
                                                "sense_id": "d11c312f-4716-3a40-aeb3-9d201769f0ca",
                                                "text": "That week we were in the desert I couldn't sleep—perhaps a couple of hours each night at the most even with a steady intake of benzodiazepine."
                                            },
                                            {
                                                "example_id": "1c908ccc-b2f3-488b-a491-fa3326f6bbbd",
                                                "sense_id": "d11c312f-4716-3a40-aeb3-9d201769f0ca",
                                                "text": "His modus operandi was to drug them with wine or tea laced with benzodiazepines, which incapacitated them and wiped out their memories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
