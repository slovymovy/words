                        "entry_id": "ed5d5eeb-2a7a-3ee0-9446-741eed62e3ad",
                        "glosses": [
                            "Femme qui est fantasque, qui est sujet à des quintes, à des accès de mauvaise humeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f951a11-4aae-4a70-98f7-8ae6ec6d2347",
                                "sense_id": "782de00b-d73a-35e1-b102-878c3d4e846c",
                                "text": "Un quinteux ou une quinteuse sont sujets à des quintes… de toux ou à d’autres accès ou quintes : ceux de la mauvaise humeur !"
                            },
                            {
                                "example_id": "8cf4eaec-f791-4642-8ff6-a16e04e05db6",
                                "sense_id": "782de00b-d73a-35e1-b102-878c3d4e846c",
                                "text": "Tantôt la créature la plus douce est quinteuse, et jamais les quinteuses ne deviennent douces ; […]. Je suis las du mariage."
                            }
                        ]
                    }
