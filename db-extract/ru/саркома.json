                                        "entry_id": "9c1c105c-d40d-34e2-bb28-bf0fc026fac8",
                                        "glosses": [
                                            "A type of malignant tumor of the bone, cartilage, fat, muscle, blood vessels, or other connective or supportive tissue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdaa5d50-7732-45ba-8234-7c709164bd88",
                                                "sense_id": "538725db-1726-3427-9ebf-321525f30c5a",
                                                "text": "Only about 1 per cent of cancers are found in connective tissue; these are known as sarcomas."
                                            }
