                "senses": [
                    {
                        "sense_id": "c5da5368-8aef-3bcb-9a9d-5a0a8f84c9fe",
                        "entry_id": "486d4939-8379-3479-898a-687155b637f2",
                        "glosses": [
                            "Sourire à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f4df39a-cb2f-4199-a28e-2f4a3bc3d21e",
                                "sense_id": "c5da5368-8aef-3bcb-9a9d-5a0a8f84c9fe",
                                "text": "Par exemple, en fureur contre son neveu au point de remplir la maison de ses vociférations, il avait subitement le plus accueillant sourire si la porte s'ouvrait sur un client, quitte à reprendre sa colère entre les dents tout de suite après et à resourire au besoin dans la minute."
                            },
                            {
                                "example_id": "60ed28e0-90b4-40e5-bc36-94530d15f38a",
                                "sense_id": "c5da5368-8aef-3bcb-9a9d-5a0a8f84c9fe",
                                "text": "Et ainsi que M. Hoffman le dit: «Nous avons aidé le «Postal Service» à resourire...»"
                            }
                        ]
                    }
                ],
