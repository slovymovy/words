                "senses": [
                    {
                        "sense_id": "5d4dba69-df1e-3010-8974-56cc16d22b10",
                        "entry_id": "12a3f760-a4aa-3ea0-9c6a-a41ca376624e",
                        "glosses": [
                            "Facture, note à payer, addition à payer."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c00f8af0-9090-46e9-80b5-f33b5149c94d",
                                "sense_id": "5d4dba69-df1e-3010-8974-56cc16d22b10",
                                "text": "L’argot s’est enrichi d’un mot charmant. La carte à payer, connue sous le nom d’addition, s’appelle, depuis quelque temps, la douloureuse."
                            },
                            {
                                "example_id": "cced63f4-812d-4817-a5af-31683cf7c076",
                                "sense_id": "5d4dba69-df1e-3010-8974-56cc16d22b10",
                                "text": "V. ne disait rien, mais j’avais l’impression qu’il me faisait payer quelque chose. C’était l’heure de la facture, de la douloureuse."
                            },
                            {
                                "example_id": "e5dd13ad-2180-4745-97ff-acc674bfa1bc",
                                "sense_id": "5d4dba69-df1e-3010-8974-56cc16d22b10",
                                "text": "Qu’est-ce qui t’a pris de lui balancer la douloureuse direct ?! Il n’a même pas encore consommé !"
                            }
                        ]
                    }
                ],
