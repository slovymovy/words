{
    "word_family": [
        "anyhow",
        "anywhere",
        "anyplace",
        "anywise"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "624e8085-dc54-3de9-8cb7-ad48ea71c66d",
                    "sense_definition": "Used to indicate that something happens or is true in spite of other factors.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was raining heavily, but we decided to go for a walk <w>anyway</w>.",
                            "target_lang_translations": {
                                "ru": "Шёл сильный дождь, но мы <w>всё равно</w> решили пойти на прогулку.",
                                "zh": "雨下得很大，但我们还是决定<w>反正</w>要去散步。",
                                "tr": "Hava çok yağmurluydu ama biz <w>yine de</w> yürüyüşe çıkmaya karar verdik."
                            }
                        },
                        {
                            "text": "I knew it would be difficult, but I wanted to try to do it <w>anyway</w>.",
                            "target_lang_translations": {
                                "ru": "Я знал, что будет трудно, но <w>всё равно</w> хотел попытаться это сделать.",
                                "zh": "我知道这会很困难，但我<w>反正</w>想试一试。",
                                "tr": "Zor olacağını biliyordum ama <w>yine de</w> denemek istedim."
                            }
                        }
                    ],
                    "synonyms": [
                        "regardless",
                        "anyhow"
                    ],
                    "common_phrases": [
                        "do it anyway",
                        "thanks anyway",
                        "go anyway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы указать, что что-то происходит или является правдой, несмотря на другие факторы.",
                        "zh": "用于表示尽管有其他因素，某事仍然发生或属实。",
                        "tr": "Bir şeyin diğer faktörlere rağmen gerçekleştiğini veya doğru olduğunu belirtmek için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё равно",
                                "target_lang_sense_clarification": "независимо от обстоятельств"
                            },
                            {
                                "target_lang_word": "в любом случае",
                                "target_lang_sense_clarification": "при любых условиях"
                            },
                            {
                                "target_lang_word": "так или иначе",
                                "target_lang_sense_clarification": "тем или иным образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反正",
                                "target_lang_sense_clarification": "无论如何，表示不受前述条件影响"
                            },
                            {
                                "target_lang_word": "无论如何",
                                "target_lang_sense_clarification": "不管怎样"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yine de",
                                "target_lang_sense_clarification": "koşullara rağmen"
                            },
                            {
                                "target_lang_word": "her hâlükârda",
                                "target_lang_sense_clarification": "her koşulda"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ef4644b-5caf-3353-aceb-ba8b7e78d3de",
                    "sense_definition": "Used to change the subject, return to a previous subject, or get to the most interesting point of a story.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a long story, but <w>anyway</w>, we finally arrived home safely.",
                            "target_lang_translations": {
                                "ru": "Это долгая история, но, <w>так или иначе</w>, мы наконец благополучно добрались домой.",
                                "zh": "说来话长，但<w>总之</w>我们最终平安到家了。",
                                "tr": "Uzun hikaye ama <w>neyse</w>, sonunda sağ salim eve vardık."
                            }
                        },
                        {
                            "text": "<w>Anyway</w>, let's not talk about work right now and enjoy our dinner.",
                            "target_lang_translations": {
                                "ru": "<w>Ладно</w>, давай не будем сейчас говорить о работе и насладимся ужином.",
                                "zh": "<w>好了</w>，我们现在别谈工作了，好好享受晚餐吧。",
                                "tr": "<w>Neyse</w>, şimdi iş hakkında konuşmayalım ve yemeğimizin tadını çıkaralım."
                            }
                        }
                    ],
                    "synonyms": [
                        "anyroad",
                        "any road up",
                        "anyhow",
                        "in any case"
                    ],
                    "common_phrases": [
                        "but anyway",
                        "well anyway",
                        "so anyway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы сменить тему, вернуться к предыдущей теме или перейти к сути рассказа.",
                        "zh": "用于转换话题、回到之前的话题，或引出故事中最有趣的部分。",
                        "tr": "Konuyu değiştirmek, önceki bir konuya dönmek veya bir hikayenin en ilginç noktasına gelmek için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в общем",
                                "target_lang_sense_clarification": "для подведения итога или возврата к теме"
                            },
                            {
                                "target_lang_word": "так или иначе",
                                "target_lang_sense_clarification": "для возврата к теме после отступления"
                            },
                            {
                                "target_lang_word": "короче говоря",
                                "target_lang_sense_clarification": "для перехода к сути"
                            },
                            {
                                "target_lang_word": "ладно",
                                "target_lang_sense_clarification": "разг. для смены темы или завершения разговора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总之",
                                "target_lang_sense_clarification": "用于总结或回到正题"
                            },
                            {
                                "target_lang_word": "话说回来",
                                "target_lang_sense_clarification": "用于转换话题或回到原话题"
                            },
                            {
                                "target_lang_word": "好了",
                                "target_lang_sense_clarification": "口语中用于结束当前话题或转换话题"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "neyse",
                                "target_lang_sense_clarification": "konuyu kapatmak veya değiştirmek için"
                            },
                            {
                                "target_lang_word": "her neyse",
                                "target_lang_sense_clarification": "konuyu değiştirmek için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a96c8d4-d45f-3937-b84d-55451e27e6ea",
                    "sense_definition": "Used to add a further thought that explains, supports, or slightly corrects what was just said.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to go to the party, and I have no ride <w>anyway</w>.",
                            "target_lang_translations": {
                                "ru": "Я не хочу идти на вечеринку, и <w>в любом случае</w> мне не на чем туда поехать.",
                                "zh": "我不想去参加聚会，<w>再说</w>我也没有车去。",
                                "tr": "Partiye gitmek istemiyorum, <w>zaten</w> gidecek bir aracım da yok."
                            }
                        },
                        {
                            "text": "The coat is too small for me, and I do not like the color <w>anyway</w>.",
                            "target_lang_translations": {
                                "ru": "Пальто мне мало, <w>да и вообще</w> цвет мне не нравится.",
                                "zh": "这件外套对我来说太小了，<w>况且</w>我也不喜欢这个颜色。",
                                "tr": "Ceket bana çok küçük, <w>zaten</w> rengini de sevmedim."
                            }
                        }
                    ],
                    "synonyms": [
                        "anyroad",
                        "besides",
                        "at any rate"
                    ],
                    "common_phrases": [
                        "not anyway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для добавления мысли, которая объясняет, подкрепляет или уточняет сказанное ранее.",
                        "zh": "用于补充说明，以解释、支持或稍微修正刚才所说的话。",
                        "tr": "Az önce söylenenleri açıklayan, destekleyen veya hafifçe düzelten ek bir düşünce eklemek için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "во всяком случае",
                                "target_lang_sense_clarification": "по крайней мере"
                            },
                            {
                                "target_lang_word": "в любом случае",
                                "target_lang_sense_clarification": "независимо от сказанного ранее"
                            },
                            {
                                "target_lang_word": "да и вообще",
                                "target_lang_sense_clarification": "для добавления весомого аргумента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再说",
                                "target_lang_sense_clarification": "用于补充理由或论据"
                            },
                            {
                                "target_lang_word": "况且",
                                "target_lang_sense_clarification": "用于进一步说明理由"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zaten",
                                "target_lang_sense_clarification": "bir argümanı desteklemek için"
                            },
                            {
                                "target_lang_word": "hem",
                                "target_lang_sense_clarification": "ek bir neden belirtirken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c6fa63c-7c76-35a8-abad-644040b4a8dc",
                    "sense_definition": "Used at the end of a question to emphasize curiosity, frustration, or to ask for the most important detail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What are you doing in here <w>anyway</w>?",
                            "target_lang_translations": {
                                "ru": "Что ты <w>вообще</w> здесь делаешь?",
                                "zh": "你<w>到底</w>在这里做什么？",
                                "tr": "Sen burada <w>aslında</w> ne yapıyorsun?"
                            }
                        },
                        {
                            "text": "Who is in charge of this project <w>anyway</w>?",
                            "target_lang_translations": {
                                "ru": "Кто <w>вообще</w> отвечает за этот проект?",
                                "zh": "这个项目<w>究竟</w>是谁负责的？",
                                "tr": "Bu projeden <w>aslında</w> kim sorumlu?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "who is he anyway",
                        "what is it anyway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в конце вопроса для выражения любопытства, раздражения или уточнения важной детали.",
                        "zh": "用于疑问句末尾，以强调好奇心、挫败感，或询问最重要的细节。",
                        "tr": "Merakı, hayal kırıklığını vurgulamak veya en önemli detayı sormak için bir sorunun sonunda kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вообще",
                                "target_lang_sense_clarification": "усилительная частица"
                            },
                            {
                                "target_lang_word": "в конце концов",
                                "target_lang_sense_clarification": "для выражения нетерпения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底",
                                "target_lang_sense_clarification": "用于疑问句中加强语气"
                            },
                            {
                                "target_lang_word": "究竟",
                                "target_lang_sense_clarification": "用于疑问句中表示追问"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aslında",
                                "target_lang_sense_clarification": "merak veya şaşkınlık belirtirken"
                            },
                            {
                                "target_lang_word": "yahu",
                                "target_lang_sense_clarification": "sitem veya merak belirtirken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba4e186f-cc78-3bba-8668-19f467c702bc",
                    "sense_definition": "In any manner or by any means.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must get the job done <w>anyway</w> you can.",
                            "target_lang_translations": {
                                "ru": "Ты должен выполнить работу <w>любым способом</w>, каким сможешь.",
                                "zh": "你必须<w>想方设法</w>把工作完成。",
                                "tr": "Bu işi <w>ne yapıp edip</w> bitirmelisin."
                            }
                        },
                        {
                            "text": "The team promised to help <w>anyway</w> possible to ensure success.",
                            "target_lang_translations": {
                                "ru": "Команда обещала помочь <w>любым способом</w>, чтобы обеспечить успех.",
                                "zh": "团队承诺会<w>无论如何</w>提供帮助以确保成功。",
                                "tr": "Ekip, başarıyı sağlamak için <w>her nasıl olursa olsun</w> yardım etmeye söz verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "anywise",
                        "any old way"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often written as two words: any way"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Каким-либо образом или любыми средствами.",
                        "zh": "以任何方式或手段。",
                        "tr": "Herhangi bir şekilde veya herhangi bir yolla."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любым способом",
                                "target_lang_sense_clarification": "любым методом"
                            },
                            {
                                "target_lang_word": "как угодно",
                                "target_lang_sense_clarification": "любым образом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无论如何",
                                "target_lang_sense_clarification": "不计代价或方法"
                            },
                            {
                                "target_lang_word": "想方设法",
                                "target_lang_sense_clarification": "用尽各种办法"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "her nasıl olursa olsun",
                                "target_lang_sense_clarification": "yöntem fark etmeksizin"
                            },
                            {
                                "target_lang_word": "ne yapıp edip",
                                "target_lang_sense_clarification": "bir şekilde başararak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}