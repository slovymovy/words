                ],
                "senses": [
                    {
                        "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                        "entry_id": "09b2eca2-681a-366b-8317-5b21947cc759",
                        "glosses": [
                            "Person, die in eine Partei eingetreten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32db91cb-549e-4c0d-9deb-4affa7e14cb2",
                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                "text": "Nur die Grünen haben in letzter Zeit die Zahl ihrer Parteimitglieder steigern können."
                            },
                            {
                                "example_id": "62543831-4686-4e8d-943d-f684e8a77b96",
                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                "text": "„Stattdessen jedoch fanden in der Reichshauptstadt und ihren Vororten insgesamt 32 formal geschlossene Versammlungen für Parteimitglieder statt, mit insgesamt mindestens 30000, wahrscheinlich aber mehr als 100000 Teilnehmern.“"
                            },
                            {
                                "example_id": "759f6575-33c0-4953-bba9-adeeccdc8c53",
                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                "text": "„Zuerst tritt dafür ein Parteimitgleid aus dem Ruhrgebiet auf.“"
                            },
                            {
                                "example_id": "e7d61e2f-c0c9-4f60-8cdd-eba2d0e3a9f4",
                                "sense_id": "9e5be313-7d91-3345-b63f-dae75f2d9e0f",
                                "text": "„Die Parteimitglieder werden zum Dialog auch mit oppositionellen Parteien und Organisationen aufgefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
