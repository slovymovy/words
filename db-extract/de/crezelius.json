                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40411ca-84b1-4e73-86da-0444c9ce5dd5",
                                "sense_id": "42454ab0-b904-3f8a-a2c1-3f3cbf38dfd5",
                                "text": "Die Crezelius sind äußerst kultivierte Menschen."
                            },
                            {
                                "example_id": "577c11f7-de9f-446e-8c7d-8d41c6c3d792",
                                "sense_id": "42454ab0-b904-3f8a-a2c1-3f3cbf38dfd5",
                                "text": "Herrn Crezelius ist sein Hut abhandengekommen."
                            },
                            {
                                "example_id": "f6235188-17d1-4369-b1ab-71f1542866c9",
                                "sense_id": "42454ab0-b904-3f8a-a2c1-3f3cbf38dfd5",
                                "text": "Habt ihr euch schon Crezelius’ neuen Pool angesehen?"
                            },
                            {
                                "example_id": "b6227159-6e78-47aa-9f2d-39ad279b06a3",
                                "sense_id": "42454ab0-b904-3f8a-a2c1-3f3cbf38dfd5",
                                "text": "Hoffen wir, dass der alten Crezelius’ Leiden bald ein Ende hat."
                            },
                            {
                                "example_id": "2bcedbe8-ebd1-4d39-8825-31ddd911d0c0",
                                "sense_id": "42454ab0-b904-3f8a-a2c1-3f3cbf38dfd5",
                                "text": "Von Crezelius gibt es immer nur Widerworte."
                            }
                        ],
