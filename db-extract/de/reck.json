                        "source_sense_id": "e457f849-b026-34a7-a584-964bf83df219",
                        "source_sense_description": "Turngerät für Männer, das aus zwei senkrechten Stangen und einer Querstange besteht",
                        "target_lang_word": "hrazda",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
