                "senses": [
                    {
                        "sense_id": "eba9afd0-e972-35e6-8255-efcbe94f6b37",
                        "entry_id": "35da99dc-af14-369a-be32-bed42382c306",
                        "glosses": [
                            "Tor, das mit einem Kopfball erzielt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cec9f98e-e9df-4bc8-9147-f6b3458f30d2",
                                "sense_id": "eba9afd0-e972-35e6-8255-efcbe94f6b37",
                                "text": "„Klose, der zuvor als Spezialist für Kopfballtore galt, wurde auch auf dem Boden effektiver und entwickelte sich zu einem mannschaftsdienlichen Spieler, was sich durch seine neun Vorlagen (bei 15 eigenen Treffern) am Ende seiner ersten Saison in Bremen zeigte.“"
                            },
                            {
                                "example_id": "f8411979-2683-4922-975f-c1251a59598d",
                                "sense_id": "eba9afd0-e972-35e6-8255-efcbe94f6b37",
                                "text": "„Rapid führte im schwachen 320. Derby gegen die Austria durch ein Kopfballtor des Georgiers Giorgi Kvilitaia bis zur 94. Minute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
