                                "target_senses": [
                                    {
                                        "sense_id": "ce6dee9a-3a19-3771-b30a-e60de7d4f399",
                                        "entry_id": "bedd333d-fa4e-3ba0-bb55-b7bb111b9aa3",
                                        "glosses": [
                                            "A female given name from English."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9971eb-643c-4382-8ddb-3d56317a76ac",
                                                "sense_id": "ce6dee9a-3a19-3771-b30a-e60de7d4f399",
                                                "text": "And hear me swear a solemn oath, / That only by thy side / Will I to Olive plight my troth, / And gain her for my bride."
                                            },
                                            {
                                                "example_id": "c9ccbe0d-513d-45b1-9384-9fa9c49f5071",
                                                "sense_id": "ce6dee9a-3a19-3771-b30a-e60de7d4f399",
                                                "text": "\"Elspie, I have a thought! The baby shall be christened Olive!\"\n\"It's a strange, heathen name, Mrs. Rothesay.\"\n\"Not at all. Listen how I chanced to think of it. This very morning, just before you came to waken me, I had such a queer, delicious dream. [ - - - ] Then I looked up, after awhile, and saw standing at the foot of the bed a little angel—a child-angel—with a green olive-branch in its hand. [ - - - ] \""
                                            },
                                            {
                                                "example_id": "adc040b8-4898-471f-9c2b-c8043073f643",
                                                "sense_id": "ce6dee9a-3a19-3771-b30a-e60de7d4f399",
                                                "text": "There was Olive, a soft drowsy girl who didn't like me because I called her Olive Oyl. Even after I was made to apologize she didn't like me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e5a3c4-3842-3d9b-835c-65d41f1eabc9",
