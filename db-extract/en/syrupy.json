                                "target_senses": [
                                    {
                                        "sense_id": "7c94f21c-5419-35a8-a748-543d19ef541b",
                                        "entry_id": "72a81d33-6bcc-3d5c-88fd-014b70db7738",
                                        "glosses": [
                                            "Variante de sirupeux."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f7e9eee-de00-4d5e-8f3e-30da0b16e875",
                                                "sense_id": "7c94f21c-5419-35a8-a748-543d19ef541b",
                                                "text": "Ces moûts très siropeux ne fermentent qu'avec une extrême lenteur, et cette fermentation se prolonge durant plusieurs années."
                                            },
                                            {
                                                "example_id": "a173e1af-2ed9-429a-b00d-80d9a9d8de26",
                                                "sense_id": "7c94f21c-5419-35a8-a748-543d19ef541b",
                                                "text": "Si, à cette époque, on retire le feu de dessous la cornue, la liqueur prendra en refroidissant une consistance siropeuse ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6937ba59-1e45-4549-bb0b-58530ec71cbe",
                        "source_entry_id": "a3b0516b-3488-3be5-9a7d-a0ca3c75722b",
                        "source_sense_description": "having the taste or consistency or syrup",
                        "target_lang_word": "sirupartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sirupartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "383fa24a-3f8e-34a9-9fdf-d6548051196d",
                                        "entry_id": "98274dcc-a604-366b-967b-d6114f5a11c6",
                                        "glosses": [
                                            "Sirup ähnelnd, an Sirup erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa16807-6292-44d3-8e3f-e0914b81746d",
                                                "sense_id": "383fa24a-3f8e-34a9-9fdf-d6548051196d",
                                                "text": "„Mit einer gestohlenen Taschenlampe durchforschte er die feuchten alveolaren Tiefen unter der Stadt; jeder Stein eine Wegmarke, ab und zu bestimmte er anhand seines konfusen Kompasses eine aus falschen Daten hergeleitete Position. Durch alte Kavernen, wo karbonschwarzes Nass von oben herabsickerte oder ein sirupartiger Glibber aus Abwasser.“"
                                            },
                                            {
                                                "example_id": "e503efb7-285e-4774-8aff-c7bfc342ab30",
                                                "sense_id": "383fa24a-3f8e-34a9-9fdf-d6548051196d",
                                                "text": "„In diesem Gebäude, in dem wir Zuflucht gefunden haben, habe ich eine Flasche selbst gekelterten Wein entdeckt, der immer noch gut war - oder besser gesagt: der noch trinkbar war, denn er schmeckte genauso sirupartig und klebrig süß wie Hustensaft -, sowie ein paar Streifen einer Art Trockenfleisch - zäh und salzig - und mehrere verirrte Krebse, die es, genau wie wir, bis hierher geschafft hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
