                "senses": [
                    {
                        "sense_id": "b746db79-d476-34bd-bcdc-e6e0c99cef26",
                        "entry_id": "35ac001c-7388-369c-8ee8-b486ae31f44b",
                        "glosses": [
                            "Qui inspire ou conçoit un sentiment de tristesse funèbre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8aac826f-0489-4d69-946b-e2da8d66430a",
                                "sense_id": "b746db79-d476-34bd-bcdc-e6e0c99cef26",
                                "text": "Reginald, à ces panégyriques de Cléopâtre, comme un enfant docile qu'on catéchise, ne répondait que par de brèves interjections approbatives; mais en rosée lénifiante les paroles de sa belle-sœur tombaient sur son coeur luctueux."
                            },
                            {
                                "example_id": "f2747cba-9821-4a2c-8bfc-6bb26b8bed5b",
                                "sense_id": "b746db79-d476-34bd-bcdc-e6e0c99cef26",
                                "text": "Durtal avait suivi les incomparables offices de ces jours luctueux, de ces minutes noires, écouté la douleur infinie de la Passion."
                            },
                            {
                                "example_id": "2d6ae5b2-0a23-447c-93e5-4281bc7cf074",
                                "sense_id": "b746db79-d476-34bd-bcdc-e6e0c99cef26",
                                "text": "L’équinoxe d’automne n’a pas peu contribué à saturer d’angoisse les esprits désenchantés. Les hymnes de deuil répondent aux accents luctueux de la bourrasque."
                            },
                            {
                                "example_id": "23929d85-d732-4571-ac60-1c6c45987008",
                                "sense_id": "b746db79-d476-34bd-bcdc-e6e0c99cef26",
                                "text": "J'oserais même avancer que son âme, jusqu'alors plaintive et luctueuse comme sa respiration, sembla s'apaiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "29032c69-e0f7-3f27-816c-41351eb7ca3f",
                        "entry_id": "35ac001c-7388-369c-8ee8-b486ae31f44b",
                        "glosses": [
                            "Caractérise une respiration dont la phase d'expiration est constituée de gémissements."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "657d92de-71e6-4ebf-a953-fd14ad4ef62d",
                                "sense_id": "29032c69-e0f7-3f27-816c-41351eb7ca3f",
                                "text": "Une respiration luctueuse."
                            },
                            {
                                "example_id": "9d351ce4-4cc1-41d8-b7e7-004b2f5b1342",
                                "sense_id": "29032c69-e0f7-3f27-816c-41351eb7ca3f",
                                "text": "Un souffle luctueux."
                            }
                        ]
