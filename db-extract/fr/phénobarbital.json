                        "sense_id": "123f2dde-e7a4-345c-bcd2-b60832d9b168",
                        "entry_id": "f8662996-577d-34f4-a9e2-55e080ecb946",
                        "glosses": [
                            "Médicament utilisé comme anticonvulsivant, somnifère et sédatif, toxique à fortes doses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40c47c1-e429-4fcb-be63-9b86d3d8cf5d",
                                "sense_id": "123f2dde-e7a4-345c-bcd2-b60832d9b168",
                                "text": "En France, en dehors du thiopental, barbiturique d’action rapide utilisé en anesthésie, seul le phénobarbital reste utilisé comme anticonvulsivant."
                            }
                        ]
                    }
                ],
