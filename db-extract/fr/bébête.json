                                            },
                                            {
                                                "example_id": "29df856e-6b79-440a-ae1a-f5b586dcee32",
                                                "sense_id": "8aa079bd-be65-3b9d-a4ea-0c6da4157945",
                                                "text": "As soon as the King and the rest of the hunting party had set off, she began making a tour of the whole castle and asking questions, but all in such an innocent, babyish way that no one could suspect her of any secret design."
                                            }
