                        "glosses": [
                            "Person, die zwischen Leben und Tod schwebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0bffecf-4d3d-49a2-ac27-1bd3fd0348f8",
                                "sense_id": "4ef835a9-7a52-34e9-9a45-77c8b71da2d6",
                                "text": "„Der Halbtote war aus seinem Wrack gefriemelt worden.“"
                            },
                            {
                                "example_id": "303bd9ce-a5d8-44d6-b54c-058bc86d12ba",
                                "sense_id": "4ef835a9-7a52-34e9-9a45-77c8b71da2d6",
                                "text": "„Ich weiß nicht, was mich Halbtoten veranlaßte, die Augen zu öffnen; da sah ich den Mann mit der Lanzette, der dabei war, mir die Vene aufzustechen.“"
                            }
                        ],
