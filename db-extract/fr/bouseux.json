                    {
                        "translation_id": "c766f5c3-3612-44d1-9be2-c806a8f7f6ea",
                        "source_entry_id": "70dfb2d0-af45-3567-9b7f-498a5a061344",
                        "source_sense_id": "9d7ef671-bd82-3490-9c9d-fb87df1c2b6e",
                        "target_lang_word": "boer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "74633f6c-1f03-3395-bbaa-c2d6a1c2ebba",
                                        "entry_id": "ca907599-bd4a-3d6b-ac46-a41d83fe5eb1",
                                        "glosses": [
                                            "landbouwer, agrariër, landman"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4901d5e6-be54-4ff5-9c34-f7603c7ff892",
                                                "sense_id": "74633f6c-1f03-3395-bbaa-c2d6a1c2ebba",
                                                "text": "In Groningen wonen rijke boeren op het Hoogeland."
                                            },
                                            {
                                                "example_id": "67159918-28b9-4dae-8dd0-f4caa12c0cfc",
                                                "sense_id": "74633f6c-1f03-3395-bbaa-c2d6a1c2ebba",
                                                "text": "Ook boer Henk Koster kwam afscheid nemen. \"Ik heb de hele ontwikkeling meegemaakt, vanaf het begin. Lenie 't Hart kwam vroeger bij ons spullen lenen om zeehondenpups groot te krijgen. Wat hier is opgebouwd, is een succes voor Pieterburen én voor de zeehonden. Voor de levendigheid in het dorp was het beter geweest als het hier was gebleven\", zei hij."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd35fe41-0400-38d5-83f9-4607b4f1f079",
                                        "entry_id": "ca907599-bd4a-3d6b-ac46-a41d83fe5eb1",
                                        "glosses": [
                                            "iedereen die iets levert of produceert (als uitbreiding van bet. 1)"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b9c591-d9c8-4e04-a3e7-1e69c3eee94c",
                                                "sense_id": "dd35fe41-0400-38d5-83f9-4607b4f1f079",
                                                "text": "Ik ga naar de patatboer, even een vette bek halen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f481e3-386d-3b6e-8128-ae553e187d73",
                                        "entry_id": "ca907599-bd4a-3d6b-ac46-a41d83fe5eb1",
                                        "glosses": [
                                            "persoon zonder of met weinig beschaving, lomperd"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02e31141-e2be-4f06-b7a4-d8ef65a5f4dd",
                                                "sense_id": "b0f481e3-386d-3b6e-8128-ae553e187d73",
                                                "text": "Wat is dat een lompe boer!"
                                            },
                                            {
                                                "example_id": "6b75207e-c881-49e3-b19d-a8751e2c24aa",
                                                "sense_id": "b0f481e3-386d-3b6e-8128-ae553e187d73",
                                                "text": "De supporters van PSV worden ook wel uitgescholden voor boeren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c303e555-418b-38df-b113-306461851412",
                                        "entry_id": "ca907599-bd4a-3d6b-ac46-a41d83fe5eb1",
                                        "glosses": [
                                            "speelkaart met daarop een boer [1] uitgebeeld, waarvan de waarde meestal tussen die van de 10 en de vrouw ligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1717c5-8ee8-491b-88d9-96a9366974db",
                                                "sense_id": "c303e555-418b-38df-b113-306461851412",
                                                "text": "Bij klaverjassen heet de troef-boer ook wel jas vandaar de term klaverjassen."
                                            }
                                        ]
                                    },
                                    {
