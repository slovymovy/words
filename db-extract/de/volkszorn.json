                ],
                "senses": [
                    {
                        "sense_id": "499d97ec-d49b-3ff8-9bf5-727c6f6eec54",
                        "entry_id": "d44b7be2-db81-3b90-b710-777a5d443960",
                        "glosses": [
                            "der Zorn eines ganzen Volkes, kollektive Wut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07145de-1f74-4e0b-95eb-3e53a87ffb88",
                                "sense_id": "499d97ec-d49b-3ff8-9bf5-727c6f6eec54",
                                "text": "Steuererhöhungen ziehen oft den Volkszorn auf sich."
                            },
                            {
                                "example_id": "171ca080-1f9a-4a02-89ca-17c784deb66c",
                                "sense_id": "499d97ec-d49b-3ff8-9bf5-727c6f6eec54",
                                "text": "„Poroschenko und Jazenjuk müssen befürchten, dass sich der Volkszorn irgendwann gegen sie entlädt.“"
                            },
                            {
                                "example_id": "b1529225-a906-466a-9c17-5a392b0680ea",
                                "sense_id": "499d97ec-d49b-3ff8-9bf5-727c6f6eec54",
                                "text": "„Der spontane Volkszorn, der die Mau-Mau wachsen ließ, ebbt nun ab oder richtet sich gegen die Aufständischen selbst.“"
                            },
                            {
                                "example_id": "150c5697-8974-4a73-b901-42584b739c1f",
                                "sense_id": "499d97ec-d49b-3ff8-9bf5-727c6f6eec54",
                                "text": "„In der Hauptstadt der Tschechoslowakei, deren Moldaubrücken das deutsche Militär fast gesprengt hätte, gab es genügend spontanen Volkszorn, den man nicht erst aufstacheln musste.“"
                            },
                            {
                                "example_id": "c80358c7-7aa4-44bc-a51f-6b83fc68e605",
                                "sense_id": "499d97ec-d49b-3ff8-9bf5-727c6f6eec54",
                                "text": "„Dass ein Premierminister vom Präsidenten zur Besänftigung des Volkszorns geopfert wird, das hat in Frankreich eine lange Tradition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
