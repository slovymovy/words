                    },
                    {
                        "translation_id": "b8cf0b1e-b0fa-4239-b162-9dcdb56f0957",
                        "source_entry_id": "9e0438c1-40dc-3aa7-8468-1a81b940c1ee",
                        "source_sense_id": "58ec8267-50b2-33f9-8c52-e1740dca1fc1",
                        "target_lang_word": "Thermostat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thermostat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                        "entry_id": "a14bdc3d-abbc-33cf-be4e-b13a57b19e21",
                                        "glosses": [
                                            "Gerät, das eine Temperatur konstant hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01a76af6-6257-4589-a89b-cda7534dedbf",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„In vielen Haushalten sind noch Thermostate ohne digitale Anzeige der Raumtemperatur verbaut, auf denen sich lediglich Stufen von eins bis fünf per Drehbewegung einstellen lassen.“"
                                            },
                                            {
                                                "example_id": "cfaf4fa6-4b21-4fd2-b9d0-96374704080e",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Das Symbol der Schneeflocke oder des Sterns bildet bei vielen Thermostaten die kälteste Stufe ab.“"
                                            },
                                            {
                                                "example_id": "fc46e86d-050d-415e-a6ee-4a86f76de06d",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Beim Lüften sollte das Thermostat auf Frostschutz (Stufe *) gedreht werden.“"
                                            },
                                            {
                                                "example_id": "370417ca-6efe-427f-bbfc-04c25fa6b570",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Steht der Thermostat auf der Flocke, springt die Heizung dann automatisch an, wenn die Raumtemperatur unter 5 Grad sinkt.“"
                                            },
                                            {
                                                "example_id": "d1685ad0-0a5d-4b14-a84a-6650ddfdaccd",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "[Programmierbares Thermostat:] „Geht man morgens aus dem Haus, schaltet das Thermostat beispielsweise auf eine niedrigere Temperatur.“"
                                            },
                                            {
                                                "example_id": "2e556813-4d8c-42ca-95eb-f8d062ab8f57",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Der Einsatz programmierbarer Thermostate kann etwa 10 % Energie sparen.“"
                                            },
                                            {
                                                "example_id": "211ebefe-5d00-4794-bc64-b0a435e526c5",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Es kann sich also lohnen nur einzelne Räume zu beheizen, in denen man sich meistens aufhält oder eben nur zu Zeiten aufheizen, in denen tatsächlich jemand da ist. Digitale Thermostate können das übernehmen.“"
                                            },
                                            {
                                                "example_id": "bebebd1f-a553-4e32-8869-0ce25a5b9855",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Nachdem man das Haus verlassen hat, drosselt die Heizung Ihre Leistung. Zwei Stunden vor der Rückkehr fährt sie wieder hoch. Das ist heute möglich mit motorgetriebenen, programmierbaren Thermostaten.“"
                                            },
                                            {
                                                "example_id": "c9059919-53cd-4d6e-b220-9384bccb6524",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Digitale Thermostate an Heizungen können mittlerweile meistens recht einfach statt der herkömmlichen Drehregler installiert werden.“"
                                            },
                                            {
                                                "example_id": "216fbc04-dc4a-4840-9c22-ee710e7c980d",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Je nach Art des alten Thermostats muss dieses mit einer Rohrzange (Überwurfmutter) oder einem Schraubenzieher (Klemmring) gelockert werden. Danach wird das neue Thermostat mit zwei Batterien bestückt, aufgesteckt und fixiert.“"
                                            },
                                            {
                                                "example_id": "a929bfef-b256-4c4f-b6c8-17c5221ba943",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Höherpreisige Thermostate lassen sich dann sogar per App steuern.“"
                                            },
                                            {
                                                "example_id": "634049a1-a6e2-40d6-8980-9945fa574253",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "[Verbrennungsmotor:] „Der Kühlkreislauf, und damit die Motortemperatur, wird durch einen Thermostat geregelt.“"
                                            },
                                            {
                                                "example_id": "c7e06475-37bb-44e6-8551-4b9711d240a3",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Der Thermostat teilt den Kühlmittelstrom auf den Kühler und eine Kurzschlussleitung auf.“"
                                            },
                                            {
                                                "example_id": "1852b947-7239-419d-82ed-96bdd6e48183",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "„Öffnet der Thermostat, je nach Fahrzeug und Motor zwischen 75 °C und 88 °C, so wird ein Teil des Stroms zum Wasserkühler geleitet, und die Kühlung setzt ein.“"
                                            },
                                            {
                                                "example_id": "c993cf87-3279-42f8-920f-dce66ce03000",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "[Kühlschrank:] „Die Temperaturregelung erfolgt mit einem Thermostat, der den Kompressor je nach gewünschter Temperatur ein- bzw. ausschaltet.“"
                                            },
                                            {
                                                "example_id": "5465ddfa-b4fd-45d4-88c1-a50982c7272a",
                                                "sense_id": "b7b41812-a5d3-3eac-aefa-a6100305173d",
                                                "text": "[Unglück der Apollo 13:] „Der Grund der Explosion war“ [… die Folge] „eines unter zu hoher Spannung kurzgeschlossenen Thermostats sowie einer Kette von Versäumnissen und Fehleinschätzungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
