        "fr-extract.jsonl": [
            {
                "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                "word": "armement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b3ad6635-0d99-4e40-b2ae-159d362b9474",
                        "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "tags": [
                            "plural"
                        ],
                        "form": "armements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ff658d6-bf47-38fb-b903-fd7167ac2a4c",
                        "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "glosses": [
                            "Action d’armer, de préparer en vue de la guerre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ce3044-96e2-42bd-9934-50e0b1ac1108",
                                "sense_id": "0ff658d6-bf47-38fb-b903-fd7167ac2a4c",
                                "text": "L’armement d’une place, d’une forteresse."
                            },
                            {
                                "example_id": "9f4baef1-3cdf-4787-b4dd-3d865d656c7c",
                                "sense_id": "0ff658d6-bf47-38fb-b903-fd7167ac2a4c",
                                "text": "Faire un armement naval."
                            }
                        ]
                    },
                    {
                        "sense_id": "d13f1131-e70f-3356-bf53-b7cffb08e336",
                        "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "glosses": [
                            "Ensemble des armes qui constitue une partie de l’équipement d’un soldat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75247df-1ce7-4e49-95cc-efa2794fc2a1",
                                "sense_id": "d13f1131-e70f-3356-bf53-b7cffb08e336",
                                "text": "Ceux des montagnards qui obéirent à l’appel du chef austrasien vinrent au rendez-vous, les uns à pied, les autres à cheval, avec leur armement habituel, c’est-à-dire, en équipage de chasse, l’épieu à la main et la trompe ou le cornet en bandoulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "61d718de-2869-327d-aa94-e85636fa9aae",
                        "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "glosses": [
                            "Ensemble des armes offensives d’un navire de guerre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "eaa10b8c-b955-4e57-b7f8-3b631778a092",
                                "sense_id": "61d718de-2869-327d-aa94-e85636fa9aae",
                                "text": "Mais, somme toute, les dirigeables n’étaient pas mieux fournis, en fait de cuirassement et d’armement, que la plus petite canonnière."
                            }
                        ]
                    },
                    {
                        "sense_id": "60991f74-e469-3063-bc00-92974b0002fd",
                        "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "glosses": [
                            "Fin de la construction d’un bateau (pose de la peinture, pose des canots de sauvetage,…)."
                        ],
                        "tags": [
                            "Construction navale"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "18b0e11a-0016-3c8c-bcdc-a0b68b32281e",
                        "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "glosses": [
                            "Action d’armer un bâtiment en vue du commerce, en parlant de la marine marchande."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c5a49608-6423-36b9-9f88-85126856e5eb",
                        "entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "glosses": [
                            "Compagnie maritime."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d9a99ccd-a20d-421b-9dc7-9945120ba26c",
                                "sense_id": "c5a49608-6423-36b9-9f88-85126856e5eb",
                                "text": "L’armement Dockwise est connu pour ses puissants navires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "497d9c8e-d58a-44ad-bd99-6ee7d94b172d",
                        "source_entry_id": "02c2734a-c959-39e2-9f2f-75fe9e059ae7",
                        "target_lang_word": "Bewaffnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewaffnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb66027d-b345-3986-a706-5b4bcee2a27e",
                                        "entry_id": "84215937-9439-30d3-8698-010721452ebd",
                                        "glosses": [
                                            "Maßnahme, um jemand mit Waffen zu versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69334944-8607-449f-a4a1-edb9cc62575b",
                                                "sense_id": "cb66027d-b345-3986-a706-5b4bcee2a27e",
                                                "text": "Ohne die Bewaffnung durch die Verbündeten wäre ihre Lage hoffnungslos geblieben."
                                            }
