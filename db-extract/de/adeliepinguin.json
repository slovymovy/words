                "senses": [
                    {
                        "sense_id": "220aa02c-fca3-3cc8-8386-4a7a08d5640c",
                        "entry_id": "e22d18e5-4906-36d7-8ad5-b89e00249b49",
                        "glosses": [
                            "45 bis 70 cm große Pinguinart, die in der Antarktis vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a66e15-ebad-4310-ac4a-1152311e2d02",
                                "sense_id": "220aa02c-fca3-3cc8-8386-4a7a08d5640c",
                                "text": "Adeliepinguine brüten in sehr großen Kolonien."
                            },
                            {
                                "example_id": "67b28b30-1b34-4ac3-8389-d97e8edf5514",
                                "sense_id": "220aa02c-fca3-3cc8-8386-4a7a08d5640c",
                                "text": "Der Adeliepinguin ist der häufigste Vogel der Antarktis."
                            },
                            {
                                "example_id": "53b50b9a-1088-4a5e-92fb-1656066daf48",
                                "sense_id": "220aa02c-fca3-3cc8-8386-4a7a08d5640c",
                                "text": "„Der Adeliepinguin verbringt die meiste Zeit des Jahres auf dem Packeis, wo das umgebende Wasser für mildere Temperaturen sorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
