                ],
                "senses": [
                    {
                        "sense_id": "024f03ec-2288-3b1b-84a6-590566c05168",
                        "entry_id": "9ba1e7fe-e4d4-3a78-bc30-26474e1d8ec5",
                        "glosses": [
                            "(natürliche) Fähigkeit, schicklich zu handeln"
                        ],
                        "tags": [
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ca827391-4a64-414d-a191-ec9b4442a229",
                                "sense_id": "024f03ec-2288-3b1b-84a6-590566c05168",
                                "text": "„Ihr Schicklichkeitsgefühl ist eine Frucht religiösen Bewußtseins, – mein Schicklichkeitsgefühl findet nichts Anstößiges darin, den Dienst eines hübschen Mädchens zu fordern. Mein Schicklichkeitsgefühl harmoniert mit den Rechten der Natur und mit den Eingebungen gesunder Vernunft.“"
                            },
                            {
                                "example_id": "087aff77-a5a0-4bfa-8a4d-e11f587c54b4",
                                "sense_id": "024f03ec-2288-3b1b-84a6-590566c05168",
                                "text": "„Er verweilte besonders bei dem Schicklichkeitsgefühl, welches der Doctor an den Tag legte, indem er verlangte, der Squire solle vor allem befragt und dann erst der Cousine ein förmlicher Antrag gemacht werden.“"
                            },
                            {
                                "example_id": "c4c72193-ea65-4ad2-a756-2de8891b4215",
                                "sense_id": "024f03ec-2288-3b1b-84a6-590566c05168",
                                "text": "„»Sehen Sie,« sagte er, »dies ist die Art und Weise, wie ich daheim bei mir meine Frauenzimmer auf derartige Verstöße gegen alles Scham- und Schicklichkeitsgefühl, die sie natürlich nicht von sich aus sehen und korrigieren würden, aufmerksam mache. O, Unordnung, dein Name ist Weib!«“"
                            },
                            {
                                "example_id": "75e54d20-e407-4a45-8e9d-b6729632977f",
                                "sense_id": "024f03ec-2288-3b1b-84a6-590566c05168",
                                "text": "„Der Amerikaner nimmt nicht nur aus Freiheits-, Ehr- und Schicklichkeitsgefühl oder gar aus einer Schamhaftigkeit, die den Nebenmenschen durch Roheit und Häßlichkeit zu verletzen befürchtet, sondern deshalb noble Fassons an, weil er zu hohl und seelenlos, zu geistesarm ist, um eine eigne, volkstümliche Lebensart und Sitte von innen heraus zu gestalten, wie es der deutsche Bauer- und Handwerkerstand vermocht hat.“"
                            },
                            {
                                "example_id": "1f6793f6-0bf6-42bf-81e6-4f6fe9e13f5d",
                                "sense_id": "024f03ec-2288-3b1b-84a6-590566c05168",
                                "text": "„Zum Überfluß fehlt ihnen auch das Schicklichkeitsgefühl, ich meine männliches Schicklichkeitsgefühl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
