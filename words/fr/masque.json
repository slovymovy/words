                        "porter un masque"
                    ]
                },
                {
                    "sense_id": "d135b8a3-9321-3387-b150-94c8c8543cfb",
                    "sense_definition": "Dispositif couvrant la bouche et le nez pour filtrer l'air et protéger des microbes ou de la poussière.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection_respiratoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin ajuste son <w>masque</w> chirurgical avant d'entrer dans la salle d'opération."
                        },
                        {
                            "text": "Le port du <w>masque</w> reste fortement conseillé dans les transports publics en cas de maladie."
                        }
                    ],
                    "common_phrases": [
