                        "form_id": "c3e12378-06d8-4070-849c-e8e750a5775f",
                        "entry_id": "f9c88a5c-c8e9-3ac7-998a-565d14a0aa90",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Angriffsflächen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef9cd752-0681-3467-8683-21754bf5b333",
                        "entry_id": "f9c88a5c-c8e9-3ac7-998a-565d14a0aa90",
                        "glosses": [
                            "Oberfläche, auf die bestimmte Kräfte einwirken können (zum Beispiel Wind)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b57093-24ac-4341-b67d-ab4c41f303f4",
                                "sense_id": "ef9cd752-0681-3467-8683-21754bf5b333",
                                "text": "„Wind findet vor allem dort große Angriffsflächen, wo sich riesige Felder aneinanderreihen, schützende Wälle aus Hecken und Waldstreifen fehlen – Areale, wie sie schon in den 50er Jahren mit der Bodenreform der DDR entstanden sind.“"
                            },
                            {
                                "example_id": "956cf212-a90f-4452-812e-dad7bbb6ac10",
                                "sense_id": "ef9cd752-0681-3467-8683-21754bf5b333",
                                "text": "„Darüber hinaus sind die Fettkügelchen der Ziegenmilch kleiner als die der Kuhmilch. Die vielen kleinen Fettkügelchen ergeben eine größere Gesamtoberfläche und somit eine größere Angriffsfläche für Enzyme, was die Verdaulichkeit weiter verbessert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "febcebf4-ac30-3573-a972-90e61dd6e8e7",
                        "entry_id": "f9c88a5c-c8e9-3ac7-998a-565d14a0aa90",
                        "glosses": [
                            "sensibler Themenbereich, in dem jemand anfällig für negative Kritik ist, der Chancen für Widerspruch, Beanstandung eröffnet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "040e9143-63ae-43cf-88b9-76f33381fc9d",
                                "sense_id": "febcebf4-ac30-3573-a972-90e61dd6e8e7",
                                "text": "„Der Kanzler will angesichts der jüngsten Probleme in den eigenen Reihen nicht länger auch noch durch das Maut-Desaster eine unnötige Angriffsfläche bieten.“"
                            },
                            {
                                "example_id": "41fff948-3536-4789-b0c6-5da1ddc5a91c",
                                "sense_id": "febcebf4-ac30-3573-a972-90e61dd6e8e7",
                                "text": "„All diese Versuche, den konservativ-orthodoxen Kräften entgegenzukommen, liefen letztlich ins Leere. Denn als säkularer Premier, dessen Vorliebe für Alkohol und schöne Frauen allgemein bekannt war, bot Bhutto die perfekte Angriffsfläche für politische Gegner, allen voran für das religiöse Establishment.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
