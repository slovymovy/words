                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kwebbel</w> niet zo hard in de bibliotheek!",
                            "target_lang_translations": {
