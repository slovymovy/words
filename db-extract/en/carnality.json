                        "translation_id": "c0ee9cbf-e84f-4180-b43b-273483ac5166",
                        "source_entry_id": "34389739-8a15-3038-888f-201750e612b5",
                        "source_sense_id": "950ecf0b-1e66-3904-941b-cb58f7febc2f",
                        "source_sense_description": "die Sinnlichkeit, Fleischeslust",
                        "target_lang_word": "Sinnlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sinnlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                        "entry_id": "948f3ef3-1033-3d77-9bd7-3e143d2fc063",
                                        "glosses": [
                                            "Empfänglichkeit und Hingabe für die Empfindungen und das (angenehme) Erleben der äußeren Sinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55327336-4210-411d-a284-04152dbdb80c",
                                                "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                                "text": "Ich bin wie berauscht von der Sinnlichkeit expressionistischer Gemälde."
                                            },
                                            {
                                                "example_id": "22dbdf11-55a5-4ac2-b596-9dea47df5fae",
                                                "sense_id": "9c60c18d-6b66-3f21-a8d9-d69cfb01b210",
                                                "text": "„Die Vorstellung, daß meine oder irgend jemandes Sinnlichkeit gedämpft wurde, war mir ekelhaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                        "entry_id": "948f3ef3-1033-3d77-9bd7-3e143d2fc063",
                                        "glosses": [
                                            "Offenheit für/Lust auf Erotisches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b1f823-580f-4ff2-80ac-cb380469f791",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Das Bidet ist Zeuge einer gelebten Sinnlichkeit.“"
                                            },
                                            {
                                                "example_id": "cd897890-10b7-4b8f-bc88-a795af148e14",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Dafür strahlte Adele mehr Sinnlichkeit aus.“"
                                            },
                                            {
                                                "example_id": "46de3234-c3ab-4769-aede-b6d12f9917e9",
                                                "sense_id": "73a86ccf-fded-3a3e-acfb-87464e45b801",
                                                "text": "„Während sie darüber sprachen, entdeckte er ihre Sinnlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaf6375a-8263-4c31-b7ad-7a46333a435b",
                        "source_entry_id": "34389739-8a15-3038-888f-201750e612b5",
                        "source_sense_id": "950ecf0b-1e66-3904-941b-cb58f7febc2f",
                        "source_sense_description": "die Sinnlichkeit, Fleischeslust",
                        "target_lang_word": "Fleischeslust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fleischeslust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e74963c9-c229-3d48-9b3d-8bd83f65d959",
                                        "entry_id": "5489100a-1404-3339-956a-72dcc79e77da",
                                        "glosses": [
                                            "sexuelle Begierde/Lust"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31965f41-e776-4a31-9985-2b5e7765f031",
                                                "sense_id": "e74963c9-c229-3d48-9b3d-8bd83f65d959",
                                                "text": "„Er kochte vor Wut, und in ihm regte sich, obwohl er selbst der Fleischeslust gefrönt hatte, so etwas wie ein altmodischer jüdischer Zorn auf die Welt und ihre Torheit.“"
                                            },
                                            {
                                                "example_id": "941eed90-a1f9-461d-ac94-f1459a9483ab",
                                                "sense_id": "e74963c9-c229-3d48-9b3d-8bd83f65d959",
                                                "text": "„Wenn er erwachte, ließ er sie einsperren, ging zur Beichte und las die Messe; dann speiste er zu Mittag, der Teufel der Fleischeslust bemächtigte sich seiner, man verschaffte ihm ein anderes Mädchen, er erfreute sich ihrer, und am nächsten Morgen begann er von neuem das gleiche Spiel wie am Vortag.“"
                                            },
                                            {
                                                "example_id": "853822f9-c4fb-4aba-8b21-d3865b3df1ef",
                                                "sense_id": "e74963c9-c229-3d48-9b3d-8bd83f65d959",
                                                "text": "„Dennoch priesen es die großen Weltreligionen seit Menschengedenken als segensreich, die Fleischeslust abzutöten.“"
                                            },
                                            {
                                                "example_id": "ddcef9ed-fa7d-44e7-908c-b51213289c01",
                                                "sense_id": "e74963c9-c229-3d48-9b3d-8bd83f65d959",
                                                "text": "„Hamann will den Karneval, die Fleischslust, den ewigen Jahrmarkt der Sprache inszenieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
