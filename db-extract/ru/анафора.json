                                "target_senses": [
                                    {
                                        "sense_id": "5341a8c0-b69a-3b5e-8ec6-560e2336e990",
                                        "entry_id": "f2d3824a-cccf-3ceb-a9e0-17a24fb049dc",
                                        "glosses": [
                                            "odwołanie się w wypowiedzi do czegoś, co wcześniej zostało już wspomniane"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "dfb8a26b-52bd-371b-beb5-96e828e0372f",
                                        "entry_id": "f2d3824a-cccf-3ceb-a9e0-17a24fb049dc",
                                        "glosses": [
                                            "figura stylistyczna polegająca na powtórzeniu tego samego słowa lub zwrotu na początku kolejnych wersów, zdań lub fraz, co służy wzmocnieniu wyrazu emocjonalnego lub rytmicznego"
                                        ],
                                        "tags": [],
