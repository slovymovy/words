                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa60b7e2-197e-4172-a812-01ebedd98d1b",
                                "sense_id": "452e8995-fba9-3f14-9f3f-590e71389a60",
                                "text": "„In der Jury des Songwettbewerbs saßen mehrere alte Krauterer, die den Fans der unterlegenen Bands komplett das Kraut ausgeschüttet haben.“"
                            },
                            {
                                "example_id": "44a4cbf7-6720-4862-9d7d-90f23fb8dd7f",
                                "sense_id": "452e8995-fba9-3f14-9f3f-590e71389a60",
                                "text": "„Im Zuge dieser ‚Modernisierung‘ wurden etliche Grantler, Krauterer und Exzentriker aus der Hocharistokratie durch Vertreter der Parlamentsparteien ersetzt; diese wurden nicht gewählt, sondern ernannt.“"
                            }
                        ],
