                    },
                    {
                        "form_id": "abffae64-06f7-4871-b3de-be8dbec3ac80",
                        "entry_id": "d3365b8c-9a1d-3f6c-aaa8-caaf63f9ac61",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "huitrier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "912151ce-8dfe-3832-9355-cc833533b3a2",
                        "entry_id": "d3365b8c-9a1d-3f6c-aaa8-caaf63f9ac61",
                        "glosses": [
                            "Oiseau échassier, limicole cosmopolite, de taille moyenne, friand d'huîtres et de coquillages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "570b4ec6-5ea8-4b5f-bc1b-6980f96c87bf",
                                "sense_id": "912151ce-8dfe-3832-9355-cc833533b3a2",
                                "text": "Les huîtriers ont un plumage noir ou blanc et noir, des pattes rosâtres et un long bec rouge-orangé."
                            },
                            {
                                "example_id": "975ea7c9-85ac-4d89-8d1f-5724b52beef7",
                                "sense_id": "912151ce-8dfe-3832-9355-cc833533b3a2",
                                "text": "Il existe une douzaine d'espèces d'huîtriers qui constituent la famille des hématopodidés."
                            },
                            {
                                "example_id": "c3839a6f-22b8-4dc7-b704-26867996d7b4",
                                "sense_id": "912151ce-8dfe-3832-9355-cc833533b3a2",
                                "text": "Là encore, cet oiseau est très probablement présent par hasard sur le tell : l’huîtrier est une espèce très fréquente en contexte côtier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13176731-5760-4784-9875-ee7f1beb1820",
                        "source_entry_id": "d3365b8c-9a1d-3f6c-aaa8-caaf63f9ac61",
                        "source_sense_id": "912151ce-8dfe-3832-9355-cc833533b3a2",
                        "target_lang_word": "Austernfischer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Austernfischer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5da073bc-905c-3e62-ac01-90f2ddbded22",
                                        "entry_id": "0b6eadf6-9e33-3ce8-8b9d-59c0e6180fa2",
                                        "glosses": [
                                            "Seevogel mit rotem Schnabel; Gattung Haematopus, speziell die Art Haematopus ostralegus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a545bac3-7d97-40a6-9e30-ffdfb34a76ee",
                                                "sense_id": "5da073bc-905c-3e62-ac01-90f2ddbded22",
                                                "text": "Austernfischer haben einen roten Schnabel."
                                            },
                                            {
                                                "example_id": "7330ea45-3e91-488c-9dff-5c275d952051",
                                                "sense_id": "5da073bc-905c-3e62-ac01-90f2ddbded22",
                                                "text": "„Im Sommer kamen noch viel mehr Vögel auf den Steinen zusammen, dann tummelten sich dort Meeresstrandläufer, Steinwälzer, Austernfischer und Eiderenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f83f022b-091c-3b1f-8032-3bdaef517941",
                                        "entry_id": "0b6eadf6-9e33-3ce8-8b9d-59c0e6180fa2",
                                        "glosses": [
                                            "Beruf; Fischer, der sich auf das Fangen von Austern spezialisiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b5398d-d451-4739-b711-cfae4cf49f8f",
                                                "sense_id": "f83f022b-091c-3b1f-8032-3bdaef517941",
                                                "text": "Dann ist er Austernfischer geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dec7b906-646a-3f3b-9d3c-1c3e40dffa5e",
                                        "entry_id": "0b6eadf6-9e33-3ce8-8b9d-59c0e6180fa2",
                                        "glosses": [
                                            "flach gebauter Schiffstyp für die Austernfischerei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e23022-7af8-44bf-ab28-8a4d3bbef7e0",
                                                "sense_id": "dec7b906-646a-3f3b-9d3c-1c3e40dffa5e",
                                                "text": "Austernfischer sind seit der Erfindung der Schiffsmotoren weitgehend verschwunden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78fbd489-90f2-4f61-ac33-edf9ee9e0f2f",
