                "senses": [
                    {
                        "sense_id": "ce2d9136-8f5e-3e78-a8e8-cc2b22a4456e",
                        "entry_id": "478f8635-ac02-327c-8689-8e1082777bad",
                        "glosses": [
                            "jemand, der beruflich einen Lastwagen fährt; Fahrer eines Lastwagens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c3c90d8-1c73-4982-99a1-ebe3253739c3",
                                "sense_id": "ce2d9136-8f5e-3e78-a8e8-cc2b22a4456e",
                                "text": "Der Lastwagenfahrer holte sich die Frachtpapiere vom Disponenten."
                            },
                            {
                                "example_id": "15b637ca-c260-43f0-92cf-3fb3d1d8bd10",
                                "sense_id": "ce2d9136-8f5e-3e78-a8e8-cc2b22a4456e",
                                "text": "„Sie spürte die humorvolle, stillschweigende Nachsicht des Lastwagenfahrers, der heftig auf die Bremsen treten mußte, weil sie unachtsam über die Straße ging, und der lächelte, weil sie es war: alle freuten sich, wenn sie durch ihr Blickfeld ging.“"
                            },
                            {
                                "example_id": "a0ac6b6b-139f-4f40-a38a-518fcc129877",
                                "sense_id": "ce2d9136-8f5e-3e78-a8e8-cc2b22a4456e",
                                "text": "„Der Lastwagenfahrer hatte sie nicht verraten. Er hatte sie durch mehrere Straßensperren gebracht und sie in Schachty abgesetzt, wo sie die Nacht bei seiner Schwiegermutter und deren Familie verbracht hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
