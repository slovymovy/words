                        "entry_id": "762be848-1653-3ee2-a9c5-4f670c9cc161",
                        "glosses": [
                            "Affectionate; friendly."
                        ],
                        "tags": [
                            "Ireland",
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "de020f55-721f-3a9c-a269-f8b53b2f9318",
                        "entry_id": "762be848-1653-3ee2-a9c5-4f670c9cc161",
                        "glosses": [
                            "Lovable on account of beauty; lovely, beautiful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bffc5df1-b1e3-4efa-8a82-b1502fea3cb5",
                                "sense_id": "de020f55-721f-3a9c-a269-f8b53b2f9318",
                                "text": "A garden is a lovesome thing, God wot!"
                            },
                            {
                                "example_id": "e49d4ace-4d75-438c-95fb-9f8d60608655",
                                "sense_id": "de020f55-721f-3a9c-a269-f8b53b2f9318",
                                "text": "Through all the living Regions dost thou move,\nAnd scatter'st, where thou goest, the kindly Seeds of Love:\nSince then the race of every living thing,\nObeys thy pow'r; since nothing new can spring\nWithout thy Warmth, without thy Influence bear,\nOr beautiful or lovesome can appear,\nBe thou my Aid: my tuneful Song inspire,\nAnd kindle with thy own productive Fire;"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3446fc2-2bf0-3c5a-b199-b9bf9f2918e6",
                        "entry_id": "762be848-1653-3ee2-a9c5-4f670c9cc161",
                        "glosses": [
                            "Amorous; showing or feeling love."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "21bd9f3d-cc5a-4435-b27a-b55157ce2066",
                                "sense_id": "e3446fc2-2bf0-3c5a-b199-b9bf9f2918e6",
                                "text": "[T]he Lady seems Lovesome, & I fancy lends him Money from Time to Time."
                            }
                        ]
                    }
