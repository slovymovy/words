                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op die slimme zet van de tegenstander had ik helaas geen <w>antwoord</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I had no <w>answer</w> to that clever move by the opponent."
                            }
                        },
                        {
                            "text": "De aanval van het leger was een direct <w>antwoord</w> op de provocatie.",
                            "target_lang_translations": {
