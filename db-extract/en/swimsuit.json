                        "glosses": [
                            "A garment worn for swimming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e30bb1c-64d6-4034-9f85-b9f6aa1a1102",
                                "sense_id": "a338f094-33c8-33ca-987b-40760bbf7c20",
                                "text": "Put on your swimsuit and let's go for a swim."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e26e373-5241-3ec2-b6ed-1bdc58f34b50",
                        "entry_id": "a4989064-1ae3-3b67-bb0e-2c080a647595",
                        "glosses": [
                            "A tight-fitting one-piece garment worn by women and girls."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c5f9665-fb34-4896-920c-d9c93ea0e1e2",
                                "sense_id": "4e26e373-5241-3ec2-b6ed-1bdc58f34b50",
                                "text": "Jade refused to go swimming with her brother until he helped her find her favorite swimsuit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7db53f1b-685e-44a0-8c63-6bc433e1e383",
