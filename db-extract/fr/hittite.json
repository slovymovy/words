                ],
                "senses": [
                    {
                        "sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
                        "entry_id": "f7fa5d07-670b-3a87-b87c-07087f46243a",
                        "glosses": [
                            "Relatif aux Hittites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fbb9532-b284-404b-88d8-ef836f6d9a2a",
                                "sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
                                "text": "On peut considérer que ce monument est l'annonce publique de ce mariage royal entre le grand roi hittite et la reine d'origine hourrite. Cet événement va avoir des conséquences très importantes."
                            },
                            {
                                "example_id": "5f18b575-46e5-4689-a596-13e35a74bf42",
                                "sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
                                "text": "L’écriture cunéiforme hittite, une langue indo-européenne, fut déchiffrée en 1915 par Bartel Hrozny à partir des très nombreuses tablettes découvertes par Hugo Winkler […]. L’écriture hiéroglyphique hittite fit l'objet de longues tentatives de déchiffrement de Pietro Merigi (1927,1937), Ignace Gelb, Émile Forrer et Théodore Bossert, qui eut la chance de trouver à Karatepe, en 1947, une stèle bilingue phénicien/hittite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b5a9531-1184-4f6f-8c60-2a38983dd258",
                        "source_entry_id": "f7fa5d07-670b-3a87-b87c-07087f46243a",
                        "source_sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
                        "target_lang_word": "hethitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hethitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d990dd2d-3295-36f6-b548-82d2dfee6409",
                                        "entry_id": "8801c539-d42b-39b9-8412-8f82121edf23",
                                        "glosses": [
                                            "die Hethiter oder ihre Kultur betreffend, zu den Hethitern gehörend, von ihnen stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c57cb7-4909-4b5a-9248-54ba9eb31311",
                                                "sense_id": "d990dd2d-3295-36f6-b548-82d2dfee6409",
                                                "text": "„Der hethitische Großkönig übrigens überwand sein Misstrauen und schickte den Prinzen Zananza nach Ägypten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68aab881-ff52-35be-aa75-465fe0b48ae1",
                                        "entry_id": "8801c539-d42b-39b9-8412-8f82121edf23",
                                        "glosses": [
                                            "die Sprache der Hethiter (Hethitisch) betreffend, in ihr geschrieben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b55f27-3bef-47be-bf7c-e7525932c372",
                                                "sense_id": "68aab881-ff52-35be-aa75-465fe0b48ae1",
                                                "text": "„Nur in geringer Anzahl wurden hethitische Schriftstücke in anderen Siedlungen des Reiches gefunden.“"
                                            },
                                            {
                                                "example_id": "c9431caf-b57a-4d74-a540-d5b7a4d0293b",
                                                "sense_id": "68aab881-ff52-35be-aa75-465fe0b48ae1",
                                                "text": "„Vor allem die Existenz einer großen Anzahl von hethitischen Wörtern, die ihrem Ursprung nach nicht zum indoeuropäischen Sprachstamm gehören können, führte zu einer Verunsicherung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8d5771c-7a1e-4274-8c27-d177c7025968",
                        "source_entry_id": "f7fa5d07-670b-3a87-b87c-07087f46243a",
                        "source_sense_id": "a2bf149a-d725-3360-b42b-e2269848afe8",
