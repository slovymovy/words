                                        "entry_id": "bc049f8b-2547-3177-83d7-19f537f23765",
                                        "glosses": [
                                            "rechtlich und organisatorisch abgegrenzte Gemeinschaft von Gläubigen in der Kirche, der ein Pfarrer vorsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ca6ab6a-ecc4-46be-8f91-3a135897dd55",
                                                "sense_id": "0d267a68-49b0-39d7-85c7-cb85204564dc",
                                                "text": "„Allerdings hatte die Pfarrgemeinde schon vor einiger Zeit eine Frau beauftragt, von Zeit zu Zeit in der Kirche nach dem Rechten zu sehen.“"
                                            }
