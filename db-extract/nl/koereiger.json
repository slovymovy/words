                        ],
                        "examples": [
                            {
                                "example_id": "b4ba50ae-6187-482f-b41f-363f8fec44a9",
                                "sense_id": "86f697f0-0c3b-3e1e-8c70-612595983bcc",
                                "text": "De koereiger is één van de zeldzaamste reigersoorten in Nederland. In 1998 werd er voor het eerst met zekerheid gebroed in de Wieden. De aantallen lijken de laatste jaren toe te nemen en in in de Kop van Overijssel wordt de koereiger steeds vaker gespot."
                            },
                            {
                                "example_id": "5d794062-6d4d-4ba9-b3dd-9d017fe65214",
                                "sense_id": "86f697f0-0c3b-3e1e-8c70-612595983bcc",
                                "text": "Costa Rica ligt op een van de grote trekvogelroutes. Tijdens de tocht spotten we ibissen, grote jabiroes (een ooievaarssoort), koereigers en aalscholvers."
                            }
                        ]
                    }
