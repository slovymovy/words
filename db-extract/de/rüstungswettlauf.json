                                    {
                                        "sense_id": "6baddb80-bb9d-34c1-8dbb-e65b029e9d9b",
                                        "entry_id": "53ecd74a-4352-3e78-ae3d-770fbf889f22",
                                        "glosses": [
                                            "Rivalité entre deux camps qui les pousse à créer des armes toujours plus puissantes pour rester le plus fort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b94abe-c757-4afe-a5cc-434a039ee307",
                                                "sense_id": "6baddb80-bb9d-34c1-8dbb-e65b029e9d9b",
                                                "text": "Cette nouvelle démonstration de force occidentale ravive aussi les craintes d’une nouvelle course à l’armement, d’autant que Trump a menacé ce lundi de se retirer d’un traité sur les missiles intermédiaires signé avec la Russie en 1987."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b510a2c9-d7de-40b7-95f0-13e7a58d2722",
                        "source_entry_id": "eeea27c6-400e-3511-91ac-2cdfd50124e4",
                        "source_sense_id": "5792fb8b-1025-385f-95ae-fe215cf33d44",
