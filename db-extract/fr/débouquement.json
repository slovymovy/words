                        "entry_id": "04d9ebd1-0350-303d-adeb-7145b06a8cb2",
                        "glosses": [
                            "Canal ou passage étroit par lequel on rejoint la mer libre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5428e3b0-559b-4409-9569-20d6aeee0321",
                                "sense_id": "5f93188f-42b7-3354-9724-9663ce9046e3",
                                "text": "Vous êtes, dit-il, le seul homme qui connaissiez bien les débouquements des Antilles et les côtes du Brésil. Voulez-vous..."
                            }
                        ]
                    },
                    {
                        "sense_id": "649a3c02-da28-3e46-9694-8c5acbe3c826",
                        "entry_id": "04d9ebd1-0350-303d-adeb-7145b06a8cb2",
                        "glosses": [
