                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129daec0-8c87-4fc3-9769-fdbef316726f",
                                "sense_id": "d6eb5377-b261-342b-a2f9-d6195f7b42b7",
                                "text": "Het land werd drooggelegd en geschikt gemaakt voor bebouwing."
