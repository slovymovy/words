                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "469f50aa-7ba9-486a-bcc1-bf65470ec170",
                                "sense_id": "8d8444f5-c95e-3ce3-934d-9c733c9ccdaf",
                                "text": "Атакованные пехотой, драгунами и казаками, французы обратились в бегство и укрылись за реку."
                            },
                            {
                                "example_id": "b922ffc4-3f41-466d-aa33-5093e2ffea2a",
                                "sense_id": "8d8444f5-c95e-3ce3-934d-9c733c9ccdaf",
                                "text": "Атакованный противник, рубя канаты, в беспорядке и панике стремился вступить под паруса и выйти из-под удара в море."
                            }
                        ]
                    }
                ],
