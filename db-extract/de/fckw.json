                "senses": [
                    {
                        "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                        "entry_id": "dbe2ff73-8c17-3466-943f-6156ac5d653d",
                        "glosses": [
                            "Fluorchlorkohlenwasserstoffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c10af92-68e7-41ff-a9fa-37bf2a478c86",
                                "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                                "text": "Verantwortlich für die Lücke im Ozonschutzschild sind chemische Prozesse, die vom ultravioletten Licht der Sonne angetrieben, zunächst einzelne Chloratome aus den FCKW abspalten."
                            },
                            {
                                "example_id": "63082d4e-7bfd-4e7e-afce-9e0f00dda9d4",
                                "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                                "text": "In dem Umweltabkommen wurde 1987 zum Schutz der Ozonschicht ein Verzicht auf Fluorchlorkohlenwasserstoffe (FCKW) vereinbart."
                            },
                            {
                                "example_id": "64f9808a-aa01-40ae-a9e3-cc13736275bd",
                                "sense_id": "018696c3-7c32-37b4-83f4-918196617ffa",
                                "text": "„Ich wollte all das Schöne zerstören, das ich nie haben würde. Die Regenwälder am Amazonas niederbrennen. FCKW in die Atmosphäre pumpen, um das Ozon zu killen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
