                    "sense_id": "7879398f-88e6-31bd-894f-add87fe6e5ac",
                    "sense_definition": "plechtige religieuze optocht van geestelijken en gelovigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "optocht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de feestdag trok een lange <w>processie</w> door de straten van het dorp.",
                            "target_lang_translations": {
                                "it": "Durante il giorno di festa, una lunga <w>processione</w> ha attraversato le strade del paese."
                            }
                        },
                        {
                            "text": "De gelovigen zongen liederen terwijl zij meeliepen in de jaarlijkse <w>processie</w>.",
                            "target_lang_translations": {
                                "it": "I fedeli cantavano inni mentre partecipavano alla <w>processione</w> annuale."
                            }
                        }
                    ],
                    "synonyms": [
                        "ommegang"
                    ],
                    "common_phrases": [
                        "religieuze processie"
                    ],
                    "target_lang_definitions": {
                        "it": "corteo religioso solenne di fedeli ed ecclesiastici"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "processione",
                                "target_lang_sense_clarification": "corteo religioso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57bc13e5-4ad2-370b-b82c-678e20d94a50",
                    "sense_definition": "geordende rij van mensen of voertuigen die langzaam voortbewegen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "optocht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er ontstond een hele <w>processie</w> van auto's achter de langzame tractor.",
                            "target_lang_translations": {
                                "it": "Si è formata una vera e propria <w>processione</w> di auto dietro il trattore lento."
                            }
                        },
                        {
                            "text": "De demonstranten liepen in een stille <w>processie</w> naar het centrale plein.",
                            "target_lang_translations": {
                                "it": "I manifestanti hanno sfilato in un <w>corteo</w> silenzioso verso la piazza centrale."
                            }
                        }
                    ],
                    "synonyms": [
