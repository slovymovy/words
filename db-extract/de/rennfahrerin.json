                "senses": [
                    {
                        "sense_id": "0bc10365-41bb-3ed5-a84e-3f01c8782c7d",
                        "entry_id": "66753d8c-fef0-3f3e-94e4-206cc2471a61",
                        "glosses": [
                            "Sportlerin, die mit einem Sportgerät Rennen fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ebb44b8-917b-49e3-89ca-e91a2616a3ad",
                                "sense_id": "0bc10365-41bb-3ed5-a84e-3f01c8782c7d",
                                "text": "Das schlechte Wetter bereitete der Rennfahrernin Schwierigkeiten."
                            },
                            {
                                "example_id": "2c570264-1e48-4603-8d30-ad0f2ad2261d",
                                "sense_id": "0bc10365-41bb-3ed5-a84e-3f01c8782c7d",
                                "text": "„Gemeinsam fuhren sie mit dem Sessellift zu einem Trainingshang, der den Rennfahrerinnen zum Aufwärmen dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44d8e125-db85-4202-9538-c184ac653792",
                        "source_entry_id": "66753d8c-fef0-3f3e-94e4-206cc2471a61",
                        "source_sense_id": "0bc10365-41bb-3ed5-a84e-3f01c8782c7d",
                        "source_sense_description": "Sportlerin, die mit einem Sportgerät Rennen fährt",
                        "target_lang_word": "coureuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coureuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7fafd3e-9912-3689-b719-39c759b5bbd1",
                                        "entry_id": "b4b74c71-6a2b-3bc5-a39e-914ff5271dd8",
                                        "glosses": [
                                            "Celle qui se livre à l’exercice de la course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d9ea7a-2c51-4f00-b9de-56cc6fb08b17",
                                                "sense_id": "c7fafd3e-9912-3689-b719-39c759b5bbd1",
                                                "text": "La championne Paula Radcliffe estime que les courtes distances ont l’avantage d’être accessibles à plus de coureuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "061912aa-a9f3-3c38-9ac2-934e6792f9bf",
                                        "entry_id": "b4b74c71-6a2b-3bc5-a39e-914ff5271dd8",
                                        "glosses": [
                                            "Celle qui dispute le prix dans une course à pied, à bicyclette ou à cheval."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8671245-f32f-45ef-b41a-51c0da5107f9",
                                                "sense_id": "061912aa-a9f3-3c38-9ac2-934e6792f9bf",
                                                "text": "Même si on a une pression forte au niveau du staff, on doit l’isoler de nos coureuses, pour qu’elles soient concentrées sur leurs performances, décrit également Stephen Delcourt, manager général de l’équipe féminine FDJ-Nouvelle-Aquitaine."
                                            },
                                            {
                                                "example_id": "880a4fb1-6035-4aa7-85ab-ca717686f2f1",
                                                "sense_id": "061912aa-a9f3-3c38-9ac2-934e6792f9bf",
                                                "text": "Après la belle échappée de Coralie Delay la veille, les six coureuses régionales encore en lice n’ont pas eu l’occasion de se signaler à l’avant de la course, jeudi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d84946a-dcde-3fb5-9133-a3df2ac0979e",
                                        "entry_id": "b4b74c71-6a2b-3bc5-a39e-914ff5271dd8",
                                        "glosses": [
                                            "Celle qui va et vient, qui est souvent par la ville ou en voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce2b7ea6-bf58-4101-a4db-fedd814ec1d0",
                                                "sense_id": "8d84946a-dcde-3fb5-9133-a3df2ac0979e",
                                                "text": "Exploratrice pionnière en Asie, Ella Maillart a transformé ses voyages en exploits, en quêtes spirituelles. Vagabonde sportive, “coureuse d’univers”, elle parcourra la Russie, la Chine, l’Inde, l’Iran, appareil photo et carnet à la main pour capturer la beauté du monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0857e267-a7e5-3d14-ad80-995db66edb8d",
                                        "entry_id": "b4b74c71-6a2b-3bc5-a39e-914ff5271dd8",
                                        "glosses": [
                                            "Celle qui aime à séduire en quantité."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56eac7f3-773a-4f83-991f-0855a52830b1",
                                                "sense_id": "0857e267-a7e5-3d14-ad80-995db66edb8d",
                                                "text": "Ne voudrait-on point que je mariasse mon fils avec elle ? une fille inconnue qui fait le métier de coureuse ?"
                                            },
                                            {
                                                "example_id": "b6ee7af8-7cdd-428f-90d9-6629fd29a04f",
                                                "sense_id": "0857e267-a7e5-3d14-ad80-995db66edb8d",
                                                "text": "— D’où sors-tu donc, coureuse ? cria une autre voix."
                                            },
                                            {
                                                "example_id": "c76a66c3-9de1-43a1-99ce-b9de94278c09",
                                                "sense_id": "0857e267-a7e5-3d14-ad80-995db66edb8d",
                                                "text": "Ah mon argent ! tu le lui porterais encore et elle serait bien capable de le prendre… Cet argent, il n’est pas à moi, il est à ces enfants que tu vois. A cette heure, je trouve qu’elle les a assez volés, ta coureuse !…"
                                            },
                                            {
                                                "example_id": "15030b15-6724-4a3d-921b-1a4f3659f6c2",
                                                "sense_id": "0857e267-a7e5-3d14-ad80-995db66edb8d",
                                                "text": "Un homme comme ça, d’âge, l’uniforme et tout, et la femme, une coureuse, elle a fui avec un caporal, un individu pas intéressant."
                                            },
                                            {
                                                "example_id": "eb25d771-22a1-4147-8fdc-7cfcad229916",
                                                "sense_id": "0857e267-a7e5-3d14-ad80-995db66edb8d",
                                                "text": "Cette surveillance des mères ne se relâchait pas avec les années, car elles redoutaient les conséquences fâcheuses de l’assiduité d’un garçon auprès de leur fille, elles ne voulaient pas qu’elles fussent accablées du surnom de « coureuses »."
                                            },
                                            {
                                                "example_id": "a9c353da-18c9-4d5f-9ef6-b8e7156178ee",
                                                "sense_id": "0857e267-a7e5-3d14-ad80-995db66edb8d",
                                                "text": "Ainsi dans les Thesmophories, Mica se plaint du mal qu’Euripide fait aux femmes en les traitant de « cocufieuses, de coureuses, de pochardes, de traîtresses, de commères […], de grandes plaies des hommes »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a975688-ee75-30d9-9b82-dc0c02fe0d36",
                                        "entry_id": "b4b74c71-6a2b-3bc5-a39e-914ff5271dd8",
                                        "glosses": [
                                            "Chariot se déplaçant sur rail d’une machine à faire les cordes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
