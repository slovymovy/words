                ],
                "senses": [
                    {
                        "sense_id": "be6f00c6-08e7-35b1-acbc-4447c8beb3f9",
                        "entry_id": "92a64f93-0d63-3dc3-b690-e1f31f5671ee",
                        "glosses": [
                            "женск. к владелец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515ca489-9297-47d3-8fbb-479584c842b0",
                                "sense_id": "be6f00c6-08e7-35b1-acbc-4447c8beb3f9",
                                "text": "Нежно облегая тело, словно кожа, он придавал некоторую футуристичность владелице, одновременно защищая от внешних воздействий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcf69892-e741-4a19-b5b0-c4fdce43be7b",
                        "source_entry_id": "92a64f93-0d63-3dc3-b690-e1f31f5671ee",
                        "source_sense_id": "be6f00c6-08e7-35b1-acbc-4447c8beb3f9",
                        "target_lang_word": "owner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "owner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c409852-c7dd-36d4-81e2-3e46cdd3554e",
                                        "entry_id": "a9e2a49a-85ed-32ff-8231-a2fe27ff10d8",
                                        "glosses": [
                                            "One who owns something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4037dd2e-56a2-46d1-b21c-614b85e3bf3c",
                                                "sense_id": "5c409852-c7dd-36d4-81e2-3e46cdd3554e",
                                                "text": "The police recovered the stolen car and returned it to its owner."
                                            },
                                            {
                                                "example_id": "813c30ed-706f-456f-a1c2-a91f6b66465e",
                                                "sense_id": "5c409852-c7dd-36d4-81e2-3e46cdd3554e",
                                                "text": "The marina was filled with yachts and powerboats, sleek multihulls fitted with the latest satellite-navigation gear that would steer the owners painlessly towards similar luxury berths at Portofino and Bandol."
                                            },
                                            {
                                                "example_id": "c26f12c6-9071-4973-a651-062ab77e28c7",
                                                "sense_id": "5c409852-c7dd-36d4-81e2-3e46cdd3554e",
                                                "text": "Sometimes the sound was close, as the owner of the voice was wandering just on the outside walls of his living quarters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3829d1f5-32fa-3aba-909b-02ed3b3b7cc2",
                                        "entry_id": "a9e2a49a-85ed-32ff-8231-a2fe27ff10d8",
                                        "glosses": [
                                            "The captain of a ship."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "871f07dc-ef79-3d0e-956c-d897f7954721",
                                        "entry_id": "a9e2a49a-85ed-32ff-8231-a2fe27ff10d8",
                                        "glosses": [
                                            "Ellipsis of owner-type jeepney."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "112c1477-66ae-4153-97dc-9dc5f3f90d15",
                        "source_entry_id": "92a64f93-0d63-3dc3-b690-e1f31f5671ee",
                        "source_sense_id": "be6f00c6-08e7-35b1-acbc-4447c8beb3f9",
                        "target_lang_word": "Besitzerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besitzerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                        "entry_id": "325cfe21-3d38-357e-9f2b-0aa46dcbeb02",
                                        "glosses": [
                                            "weibliche Person, die etwas in ihrem Besitz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a92702-be1c-4da7-9da1-3722458d9e8f",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin des Geschäftes umarmte mich zum Abschied und gab mir wieder drei Schillerlocken mit.“"
                                            },
                                            {
                                                "example_id": "4f809061-d331-410a-8de8-3274aca7f639",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Nach vielem Hin und Her mit der Besitzerin hatte ich es geschafft, dass im Gästehaus eine Klimaanlage eingebaut wurde.“"
                                            },
                                            {
                                                "example_id": "e7fdbdcf-0cc5-4e7c-8d99-cf6bc58a43bb",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin führte sie in einen Raum hinter dem Laden, der abgeblendet war.“"
                                            },
                                            {
                                                "example_id": "7904b344-faeb-4c40-8529-67f59b32efe5",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Eine Woche später waren sie stolze Besitzerinnen eines kleinen blauen Citroën.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
