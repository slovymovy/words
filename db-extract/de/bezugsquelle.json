                ],
                "senses": [
                    {
                        "sense_id": "2cbfa3e5-afd2-3986-bc98-a7ad7e260f5e",
                        "entry_id": "db9ecea9-a8b7-31e5-a3ef-e3cbe69a8426",
                        "glosses": [
                            "virtueller oder tatsächlicher Ort an oder von dem ideelle oder reale Waren gekauft, bestellt oder bezogen werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f75fbda3-8d55-4e61-89db-0f83429ad404",
                                "sense_id": "2cbfa3e5-afd2-3986-bc98-a7ad7e260f5e",
                                "text": "Die Bezugsquelle seiner Waren war durch Insolvenz versiegt."
                            },
                            {
                                "example_id": "3324713a-a9bf-45ca-8a66-895e977d97d4",
                                "sense_id": "2cbfa3e5-afd2-3986-bc98-a7ad7e260f5e",
                                "text": "Er hatte die Chemikalien bisher immer bei seinen ausgewählten Bezugsquellen bestellt und auch von ihnen geliefert bekommen."
                            },
                            {
                                "example_id": "593e63b0-af58-4a3c-8624-8130a06712ed",
                                "sense_id": "2cbfa3e5-afd2-3986-bc98-a7ad7e260f5e",
                                "text": "In der dunklen Gasse, in der abgeschatteten Ecke, stand sein Dealer, seine Bezugsquelle für all die Drogen, die er so dringend benötigte."
                            },
                            {
                                "example_id": "7a032c63-17fa-4856-858a-7c72b2b80b27",
                                "sense_id": "2cbfa3e5-afd2-3986-bc98-a7ad7e260f5e",
                                "text": "Alle Informationen, die sie suchte, konnte sie aus den Bezugsquellen des Internets herunterladen."
                            },
                            {
                                "example_id": "1b15351f-939b-492a-b5f7-b62051a68e5b",
                                "sense_id": "2cbfa3e5-afd2-3986-bc98-a7ad7e260f5e",
                                "text": "Für die Recherche des Journalisten war sein Informant die wichtigste Bezugsquelle von entscheidenden Hinweisen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
