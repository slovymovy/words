        "fr-extract.jsonl": [
            {
                "entry_id": "659565aa-2a11-34c0-a198-f0f8013797ff",
                "word": "musicalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c725250-775c-4dcd-8abb-1c7d9f2bc5c0",
                        "entry_id": "659565aa-2a11-34c0-a198-f0f8013797ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "musicalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75cfc38f-bb31-3333-9d6a-0e21e67f092e",
                        "entry_id": "659565aa-2a11-34c0-a198-f0f8013797ff",
                        "glosses": [
                            "Caractère musical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8dbc45-8882-4ce7-8605-101bf035e6c6",
                                "sense_id": "75cfc38f-bb31-3333-9d6a-0e21e67f092e",
                                "text": "Fort habilement, grâce aux sollicitations lentes de sa musicalité toujours contestable mais toujours suggestive, M. Massenet déshérisse et déraidit l’âpre conception du poète."
                            },
                            {
                                "example_id": "c6f09da2-64a1-44b2-8842-ae3eb84f4023",
                                "sense_id": "75cfc38f-bb31-3333-9d6a-0e21e67f092e",
                                "text": "Les voix des chanteuses sont magnifiques de pureté et de musicalité, qu'il s'agisse de la bretonne Bleunwenn sur Strinkadenn'Ys ou de Doro.T (qui n'est pas d'Armorique) sur Samsâra. Sur l'inaugurale « Selaou » , Bleunwenn délivre l'une des plus belles performances vocales de l'histoire de la musique moderne et qui justifie la rédaction d'un livre comme celui-ci."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49b64818-b22a-4207-9cfd-9d762d61c590",
                        "source_entry_id": "659565aa-2a11-34c0-a198-f0f8013797ff",
                        "source_sense_id": "75cfc38f-bb31-3333-9d6a-0e21e67f092e",
                        "target_lang_word": "Musikalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Musikalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a27a528-7037-35b7-9983-2149e588b869",
                                        "entry_id": "9030513c-51dd-3f29-b085-eca90ff7395b",
                                        "glosses": [
                                            "Begabung, Empfindungsvermögen für Musik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9af3e7d-9896-4d5f-a0c1-d554e8f9bcab",
                                                "sense_id": "8a27a528-7037-35b7-9983-2149e588b869",
                                                "text": "„Lorca wuchs in einer andalusischen Großfamilie auf, die sich durch ihre Musikalität auszeichnete.“"
                                            },
                                            {
                                                "example_id": "bef0428a-cb12-488c-8e96-352b72742dc2",
                                                "sense_id": "8a27a528-7037-35b7-9983-2149e588b869",
                                                "text": "„Die Musikalität eines Kindes steht in ständiger Wechselwirkung mit einem Teil seiner Umwelt, die die persönliche Umwelt des Kindes genannt werden soll.“"
                                            },
                                            {
                                                "example_id": "7bdff163-6cc7-4736-84b3-3f85fe907659",
                                                "sense_id": "8a27a528-7037-35b7-9983-2149e588b869",
                                                "text": "„Die Frage, ob Musikalität erblich ist oder nicht, hat bekanntlich immer wieder zu grundverschiedenen Antworten geführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41f60cc0-c181-33e6-b2c9-741e32fe2795",
                                        "entry_id": "9030513c-51dd-3f29-b085-eca90ff7395b",
                                        "glosses": [
                                            "klangliche Fülle, musikalische Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a28fdb-7c06-4cd0-b5a9-ef5275ab3c17",
                                                "sense_id": "41f60cc0-c181-33e6-b2c9-741e32fe2795",
                                                "text": "„Die besondere Musikalität der griechischen Sprache ist durch den Reichtum an Vokalen gegeben.“"
                                            },
                                            {
                                                "example_id": "da1203d3-58e0-43de-ae82-57ce5ae10ec2",
                                                "sense_id": "41f60cc0-c181-33e6-b2c9-741e32fe2795",
                                                "text": "„Zusammen mit der Harmonie der Bewegungen, den Gesetzen des Rhythmus, der Dynamik, Plastik, Gestik und Musikalität dringt das ästhetische Wesen des Tanzes in das Bewußtsein des Schülers ein.“"
                                            },
                                            {
                                                "example_id": "d5abbe34-ca8e-43f5-8f83-11c94b012e04",
                                                "sense_id": "41f60cc0-c181-33e6-b2c9-741e32fe2795",
                                                "text": "„Ich wollte dann auch wissen , auf welchen Stimmungen oder Denkfiguren oder Musikalitäten oder Sprachformen er sozusagen aufbaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
