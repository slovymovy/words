                "senses": [
                    {
                        "sense_id": "8b60e815-dd98-3973-8ec5-bca5be9a6c02",
                        "entry_id": "10adcf73-6d18-3ddb-8763-d0d348f99b25",
                        "glosses": [
                            "Wohnunterkunft für Flüchtlinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efdb6b80-c57f-4039-b3d8-5d34b31fb9e2",
                                "sense_id": "8b60e815-dd98-3973-8ec5-bca5be9a6c02",
                                "text": "„Seinen Bekannten im Flüchtlingsheim fällt auf, dass er sich in den Wochen vor der Tat zurückzieht.“"
                            },
                            {
                                "example_id": "2fbeeb4c-caa7-41d3-bcd8-6f41b22e1054",
                                "sense_id": "8b60e815-dd98-3973-8ec5-bca5be9a6c02",
                                "text": "„Für 5,5 Millionen Euro wurde das Flüchtlingsheim darum in ein Gerichtsgebäude für nur einen Prozess verwandelt, in einen Hochsicherheitsbau.“"
                            },
                            {
                                "example_id": "60eecab4-cd32-4ce0-bb26-e7ef54084f63",
                                "sense_id": "8b60e815-dd98-3973-8ec5-bca5be9a6c02",
                                "text": "„Es stellte sich aber heraus, dass ihr Mann gar nicht gestorben war, sondern in einem Flüchtlingsheim in Winterbach wohnte, fünfzig Kilometer südlich von uns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
