        "pl-extract.jsonl": [
            {
                "entry_id": "8b46445d-39eb-30c6-8ba2-ac27c2e9aa06",
                "word": "technicznie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2eb6b37-5108-36d8-8f8b-893e2eb27be6",
                        "entry_id": "8b46445d-39eb-30c6-8ba2-ac27c2e9aa06",
                        "glosses": [
                            "w sposób odnoszący się do techniki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cc50090-2ef6-43a8-ab4e-bef94a085d53",
                                "sense_id": "d2eb6b37-5108-36d8-8f8b-893e2eb27be6",
                                "text": "Nie są one trudne technicznie, wymagają jednak pewnej kondycji fizycznej ze względu na wyspowy charakter tych gór: spore wysokości względne pomiędzy dnami dolin a szczytami i głębokie przełęcze pomiędzy szczytami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a60336c3-fb99-4265-b945-f100cd8fb127",
                        "source_entry_id": "8b46445d-39eb-30c6-8ba2-ac27c2e9aa06",
                        "source_sense_id": "d2eb6b37-5108-36d8-8f8b-893e2eb27be6",
                        "target_lang_word": "technically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "Based on precise facts, which, however, may be contrary to common belief or casual terminology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd8c6ea-9b20-44fd-9270-b19a2ebdec5e",
                                                "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                                "text": "Near-synonym: stricto sensu"
                                            },
                                            {
                                                "example_id": "d2195851-6d0f-4162-9415-cb29973b071b",
                                                "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                                "text": "Technically, he was Canadian, but everyone assumed he was American."
                                            },
                                            {
                                                "example_id": "f7dfc83d-35e3-4ff6-ba30-90cea2a7cd49",
                                                "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                                "text": "Technically, a guinea pig is not a pig, nor is it from Guinea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "Based on formal (de jure) arguments, which, however, may be misleading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a599111-4391-4eae-88fe-6d1d46334f84",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "technically correct"
                                            },
                                            {
                                                "example_id": "3a367a48-be29-455b-858c-7ca8d951dfa1",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "Due to an omission in the peace treaty of the Russo-Japanese War, Montenegro was technically at war with Japan for 102 years."
                                            },
                                            {
                                                "example_id": "0c6f3d43-660c-480a-9aef-efd0ba2ba43b",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "Stalin was not technically the Head of State."
                                            },
                                            {
                                                "example_id": "d41d576a-1f81-4e88-b6cf-63bed77f3ca8",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "Number 1.0 [the head bureaucrat of a legion of bureaucrats]: Bureaucrat Conrad, you are technically correct — the best kind of correct. I hereby promote you to grade 37."
                                            },
                                            {
                                                "example_id": "8db5885c-4b58-4eb1-88c1-1deba84ceab0",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "\"I warned you not to gaze upon my grand godson with that spell. I warned you it would not work properly. Granted, you couldn't hear me then any more than you can now, and you'd never met Tedd, but I diiiid technically say it!\""
                                            },
                                            {
                                                "example_id": "61970393-5b20-410c-a0ab-9f214250004e",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "For the Japanese, however, it's easier to summarize what is still afloat. Nagato, Kongō, and Haruna are technically still afloat, but all three are quite clearly on their way to the bottom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0012e8-4be0-3b04-b6d9-3dda32a01cfe",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "In terms of technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41896c6-1983-45a0-863e-ab2c965b2926",
                                                "sense_id": "9c0012e8-4be0-3b04-b6d9-3dda32a01cfe",
                                                "text": "Although she is technically gifted, her piano playing lacks passion."
                                            },
                                            {
                                                "example_id": "73c6d6a7-6b12-4581-a446-771318b90813",
                                                "sense_id": "9c0012e8-4be0-3b04-b6d9-3dda32a01cfe",
                                                "text": "In Choosing Children one literally feels as if one were entering the lives of these parents and feels welcomed as they share their experiences with us openly and generously. Technically, this effect is enhanced by the straightforward camera work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d13113-8353-3a61-b58c-7d697e834f58",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "In a technical (involving specialized knowledge) way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0273f96f-3366-445b-9af3-9d4fc5dc226c",
                                                "sense_id": "c5d13113-8353-3a61-b58c-7d697e834f58",
                                                "text": "The ladies were not much the wiser, though, I confess, they were not far removed from the door. The great men inside talked indistinctly and technically, and once Doctor Dillon was so unfeeling as to crack a joke […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00edd874-3624-34f8-a939-6c43e76aedc9",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "According to the current state of technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabd124e-e5f3-4555-bc33-856fa4cdf7d0",
                                                "sense_id": "00edd874-3624-34f8-a939-6c43e76aedc9",
                                                "text": "For now, it is technically impossible to have a manned flight to Mercury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cbffdc7-e64b-46ea-9074-8ffec1dcf216",
                        "source_entry_id": "8b46445d-39eb-30c6-8ba2-ac27c2e9aa06",
                        "source_sense_id": "d2eb6b37-5108-36d8-8f8b-893e2eb27be6",
                        "target_lang_word": "technologically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technologically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b375f626-9936-3e94-be62-6ea3c430c5dc",
                                        "entry_id": "0a6b5480-c663-339b-afb7-c0552f141c56",
                                        "glosses": [
                                            "In a technological manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9caa340-8bfc-4cb6-b1fc-193a58414bbf",
                                                "sense_id": "b375f626-9936-3e94-be62-6ea3c430c5dc",
                                                "text": "what humans have accomplished technologically"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "407868be-b5a5-3d1a-8899-15f17136f9d9",
                                        "entry_id": "0a6b5480-c663-339b-afb7-c0552f141c56",
                                        "glosses": [
                                            "Concerning or using technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1771f9-3870-4707-a176-a3cef1c2a6a0",
                                                "sense_id": "407868be-b5a5-3d1a-8899-15f17136f9d9",
                                                "text": "For now, it is technologically impossible to have a manned flight to Mercury."
                                            },
                                            {
                                                "example_id": "15d3e95c-ddae-47ac-901a-27a1fad87536",
                                                "sense_id": "407868be-b5a5-3d1a-8899-15f17136f9d9",
                                                "text": "A “moving platform” scheme […] is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays. This set-up solves several problems […]"
                                            },
                                            {
                                                "example_id": "f1900cf0-56dc-4249-8356-95b186de3094",
                                                "sense_id": "407868be-b5a5-3d1a-8899-15f17136f9d9",
                                                "text": "Sighted on Habitat 7, this unknown species has proven to be extremely dangerous. Their armor and equipment suggest a technologically advanced species capable of spaceflight, while their battle tactics indicate attritional warfare with a centralized command."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68cea8c1-208a-483f-81a3-26fe59f0cf02",
                        "source_entry_id": "8b46445d-39eb-30c6-8ba2-ac27c2e9aa06",
                        "source_sense_id": "d2eb6b37-5108-36d8-8f8b-893e2eb27be6",
                        "target_lang_word": "techniquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "techniquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf2583f-fb92-3534-aec0-f6dbdf05445f",
                                        "entry_id": "58f96fe5-1e61-3a56-a772-683a186bbc59",
                                        "glosses": [
                                            "D’une manière technique; selon les procédés techniques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35fe52b1-01fc-3072-87f3-f13ef567f6d0",
                                        "entry_id": "58f96fe5-1e61-3a56-a772-683a186bbc59",
                                        "glosses": [
                                            "Du point de vue technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac1ab74-62e5-480f-bcbe-db30a5868eb1",
                                                "sense_id": "35fe52b1-01fc-3072-87f3-f13ef567f6d0",
                                                "text": "Pour le stratégiste, elle risque, entre autres problèmes, de « tacticiser » la stratégie — réduisant la stratégie à une pure exécution technique, la dépolitisant au passage — imposant également de reconsidérer l’articulation entre efficacité et efficience militaire, au risque de déboucher sur de « nouvelles armées d’ancien régime », techniquement très avancées, mais stratégiquement inaptes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d7a275-9f47-3ed4-859c-25143643398f",
                                        "entry_id": "58f96fe5-1e61-3a56-a772-683a186bbc59",
                                        "glosses": [
                                            "Du point de vue purement technique, en faisant abstraction de points essentiels."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc2eef54-4c3c-4d41-8e6a-3060276d4fed",
                                                "sense_id": "f6d7a275-9f47-3ed4-859c-25143643398f",
                                                "text": "La guerre de 1950-1953 avait en effet été conclue avec un armistice et non par un traité de paix : Nord et Sud sont donc techniquement toujours en guerre."
                                            },
                                            {
                                                "example_id": "a171810d-00ea-4ec7-954e-ea2716f5df24",
                                                "sense_id": "f6d7a275-9f47-3ed4-859c-25143643398f",
                                                "text": "Bien que la faille soit techniquement critique, sa sévérité fait débat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c63b81a0-a1b0-464c-805e-93e1e5c53ec5",
                        "source_entry_id": "8b46445d-39eb-30c6-8ba2-ac27c2e9aa06",
                        "source_sense_id": "d2eb6b37-5108-36d8-8f8b-893e2eb27be6",
