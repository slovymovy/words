                                            "große Fähigkeiten, etwa handwerklicher oder technischer Art, unter Beweis stellend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2d994e-3500-47ef-aeed-05587f1e6e61",
                                                "sense_id": "82e6e80f-875a-306d-8c4e-27dbb3152b96",
                                                "text": "Mit wenigen gekonnten Strichen bringt der Künstler auch komplexeste Stadtansichten in kürzester Zeit zu Papier."
                                            },
                                            {
                                                "example_id": "a079024d-49bd-483c-bf7f-31a38545600c",
                                                "sense_id": "82e6e80f-875a-306d-8c4e-27dbb3152b96",
                                                "text": "Die gekonnteste Darbietung des Abends stammte von dem Zauberkünstler Damian."
                                            },
                                            {
                                                "example_id": "39d3fe1f-2cb0-4592-8741-24dcf4c9fed7",
                                                "sense_id": "82e6e80f-875a-306d-8c4e-27dbb3152b96",
                                                "text": "Gekonnt manövrierte Silvia ihr Einrad durch den Parcours."
                                            },
                                            {
                                                "example_id": "54c851a0-abc2-46b5-b2ac-5701d023a49f",
                                                "sense_id": "82e6e80f-875a-306d-8c4e-27dbb3152b96",
                                                "text": "Mit einer gekonnten Drehung brachte der Stürmer den Ball in den Strafraum."
                                            }
