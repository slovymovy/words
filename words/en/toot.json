                    "sense_definition": "The short, sharp sound made by a horn or whistle.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver gave a quick <w>toot</w> of the horn to warn the pedestrian.",
                            "target_lang_translations": {
                                "cs": "Řidič krátce <w>zatroubil</w>, aby varoval chodce.",
                                "ru": "Водитель коротко <w>погудел</w>, чтобы предупредить пешехода.",
                                "nl": "De bestuurder gaf een korte <w>toeter</w> met de claxon om de voetganger te waarschuwen.",
                                "pl": "Kierowca krótko <w>zatrąbił</w>, aby ostrzec pieszego.",
                                "de": "Der Fahrer <w>hupte</w> kurz, um den Fußgänger zu warnen.",
                                "fr": "Le conducteur a donné un bref <w>coup de klaxon</w> pour avertir le piéton.",
                                "it": "Il conducente ha dato un rapido <w>colpo di clacson</w> per avvertire il pedone.",
                                "tr": "Sürücü, yayayı uyarmak için kornaya kısa bir <w>korna sesi</w> verdi.",
                                "es": "El conductor dio un <w>bocinazo</w> rápido para advertir al peatón.",
                                "zh": "司机短促地按了一下喇叭，用<w>喇叭声</w>提醒行人。"
                            }
                        },
                        {
                            "text": "I heard a loud <w>toot</w> from the train whistle as it left the station.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem hlasité <w>zahoukání</w> vlakové píšťalky, když vlak opouštěl stanici.",
                                "ru": "Я услышал громкий <w>гудок</w> паровоза, когда он отходил от станции.",
                                "nl": "Ik hoorde een harde <w>fluittoon</w> van de trein toen deze het station verliet.",
                                "pl": "Usłyszałem głośny <w>gwizd</w> lokomotywy, gdy pociąg opuszczał stację.",
                                "de": "Ich hörte ein lautes <w>Tuten</w> der Zugpfeife, als der Zug den Bahnhof verließ.",
                                "fr": "J'ai entendu un <w>pouët</w> sonore du sifflet du train alors qu'il quittait la gare.",
                                "it": "Ho sentito un forte <w>fischio</w> del treno mentre lasciava la stazione.",
                                "tr": "Tren istasyondan ayrılırken tren düdüğünden gelen yüksek bir <w>düdük sesi</w> duydum.",
                                "es": "Escuché un <w>pitido</w> fuerte del silbato del tren cuando salía de la estación.",
                                "zh": "火车离开车站时，我听到了响亮的<w>鸣笛声</w>。"
                            }
                        }
