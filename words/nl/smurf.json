{
    "word_family": [
        "smurfen",
        "smurftaal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cec6d56b-73f3-3ef5-b17f-911a1d20c1ab",
                    "sense_definition": "Strip- en tekenfilmfiguur in de vorm van een kleine blauwe kabouter met een witte muts.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fictief_wezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine <w>smurf</w> zingt vrolijk een liedje terwijl hij door het bos wandelt.",
                            "target_lang_translations": {
                                "de": "Der kleine <w>Schlumpf</w> singt fröhlich ein Lied, während er durch den Wald spaziert."
                            }
                        },
                        {
                            "text": "Mijn jongere broertje kijkt elke zaterdagochtend naar een aflevering over de blauwe <w>smurf</w>.",
                            "target_lang_translations": {
                                "de": "Mein jüngerer Bruder schaut jeden Samstagmorgen eine Folge über die blauen <w>Schlümpfe</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blauwe smurf"
                    ],
                    "target_lang_definitions": {
                        "de": "Comic- und Zeichentrickfigur in Form eines kleinen blauen Wichts mit weißer Mütze."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schlumpf",
                                "target_lang_sense_clarification": "Comicfigur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a9be070-6c63-38ab-bcf5-5f30fd325d6b",
                    "sense_definition": "Woord gebruikt om naar een voorwerp te verwijzen waarvan men de naam niet weet of niet wil noemen; dinges.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plaatsvervangend_woord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geef me die <w>smurf</w> even aan, want ik kan er zelf niet goed bij.",
                            "target_lang_translations": {
                                "de": "Reich mir mal dieses <w>Dings</w>, denn ich komme selbst nicht richtig dran."
                            }
                        },
                        {
                            "text": "Hoe heet die handige <w>smurf</w> ook alweer waarmee je flessen kunt openmaken?",
                            "target_lang_translations": {
                                "de": "Wie heißt noch mal dieses praktische <w>Dingsda</w>, mit dem man Flaschen öffnen kann?"
                            }
                        }
                    ],
                    "synonyms": [
                        "dinges"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruikt als stopwoord of dinges"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Wort als Platzhalter für einen Gegenstand, dessen Namen man nicht weiß oder nicht nennen möchte; Dings."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dings",
                                "target_lang_sense_clarification": "umgangssprachlicher Platzhalter für Gegenstände"
                            },
                            {
                                "target_lang_word": "Dingsda",
                                "target_lang_sense_clarification": "umgangssprachlicher Platzhalter für Gegenstände"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f33f84b-b71e-32a9-8348-968bfbce8651",
                    "sense_definition": "Iemand die als onbelangrijk wordt beschouwd en niet echt meetelt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbelangrijk_persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het grote bedrijf voelde hij zich slechts een kleine <w>smurf</w> zonder enige invloed.",
                            "target_lang_translations": {
                                "de": "In dem großen Unternehmen fühlte er sich bloß wie eine kleine <w>Nummer</w> ohne jeden Einfluss."
                            }
                        },
                        {
                            "text": "Niemand luisterde naar hem tijdens de vergadering, alsof hij een onbeduidende <w>smurf</w> was.",
                            "target_lang_translations": {
                                "de": "Niemand hörte ihm während der Besprechung zu, als wäre er ein unbedeutender <w>Schlumpf</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figuurlijk en pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemand, der als unbedeutend gilt und keine Rolle spielt; kleine Nummer."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schlumpf",
                                "target_lang_sense_clarification": "abwertend für eine unbedeutende Person"
                            },
                            {
                                "target_lang_word": "Wurst",
                                "target_lang_sense_clarification": "abwertend für eine unbedeutende Person / kleine Nummer"
                            },
                            {
                                "target_lang_word": "kleine Nummer",
                                "target_lang_sense_clarification": "unwichtige Person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90db9eac-7a3b-3061-b56c-b6c971b46580",
                    "sense_definition": "Eerste persoon enkelvoud van de tegenwoordige tijd van <w>smurfen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>smurf</w> elke dag een nieuw deuntje wanneer ik naar mijn werk fiets.",
                            "target_lang_translations": {
                                "de": "Ich <w>schlumpfe</w> jeden Tag eine neue Melodie, wenn ich mit dem Rad zur Arbeit fahre."
                            }
                        },
                        {
                            "text": "Als ik even tijd heb, <w>smurf</w> ik graag met mijn vrienden in de tuin.",
                            "target_lang_translations": {
                                "de": "Wenn ich ein wenig Zeit habe, <w>schlumpfe</w> ich gern mit meinen Freunden im Garten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van het werkwoord smurfen"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Erste Person Singular Präsens von „smurfen“ (schlumpfen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schlumpfe",
                                "target_lang_sense_clarification": "1. Person Singular Präsens von schlumpfen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cdee351-2610-358d-ad55-3fa68a4e2512",
                    "sense_definition": "Gebiedende wijs van <w>smurfen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Smurf</w> nu meteen naar huis voordat het buiten donker begint te worden!",
                            "target_lang_translations": {
                                "de": "<w>Schlumpf</w> jetzt sofort nach Hause, bevor es draußen dunkel wird!"
                            }
                        },
                        {
                            "text": "Wacht niet langer op de anderen en <w>smurf</w> direct aan de slag.",
                            "target_lang_translations": {
                                "de": "Warte nicht länger auf die anderen und <w>schlumpf</w> direkt an die Arbeit."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs van het werkwoord smurfen"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Imperativ Singular von „smurfen“ (schlumpfen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schlumpf",
                                "target_lang_sense_clarification": "Befehlsform Singular von schlumpfen"
                            },
                            {
                                "target_lang_word": "schlumpfe",
                                "target_lang_sense_clarification": "Befehlsform Singular von schlumpfen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2ad9f19-9d69-3ae2-b467-f3bc526199c4",
                    "sense_definition": "Tweede persoon enkelvoud van de tegenwoordige tijd in inversie van <w>smurfen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Smurf</w> je vandaag weer mee naar het grote feest in het dorp?",
                            "target_lang_translations": {
                                "de": "<w>Schlumpfst</w> du heute wieder mit zum großen Fest im Dorf?"
                            }
                        },
                        {
                            "text": "Waarom <w>smurf</w> je niet gewoon even met me mee naar de winkel?",
                            "target_lang_translations": {
                                "de": "Warum <w>schlumpfst</w> du nicht einfach kurz mit mir zum Laden?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inversievorm van het werkwoord smurfen"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Zweite Person Singular Präsens in Inversion von „smurfen“ (schlumpfen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schlumpfst",
                                "target_lang_sense_clarification": "2. Person Singular Präsens von schlumpfen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}