                ],
                "translations": [
                    {
                        "translation_id": "71270aa3-3cca-4049-80d7-183166fd3804",
                        "source_entry_id": "a8f5a2ad-430b-3707-86b7-aa31611af41d",
                        "source_sense_id": "7ce62aa5-c4c2-3670-a5fe-726ce8d7f8ee",
                        "source_sense_description": "eine Schule für Kinder im Alter zwischen 2 und 5 Jahren",
                        "target_lang_word": "Kindergarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kindergarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                        "entry_id": "8e2412f9-eb9f-36e0-b6a1-60bcbbf53f15",
                                        "glosses": [
                                            "Ort, an dem Kinder vor dem schulpflichtigen Alter betreut und gefördert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85591be5-de22-4985-8e8a-1980a00f9f08",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "Lena geht noch in den Kindergarten."
                                            },
                                            {
                                                "example_id": "07b013e3-6bb0-4f9d-aa8f-ee884ff71c8c",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Vietnamesisch war zwar meine Muttersprache, aber im Kindergarten habe ich viel davon verlernt.“"
                                            },
                                            {
                                                "example_id": "f36dd43d-eee2-42c6-a853-5bea8c300ac6",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Unser Kindergarten und die dazugehörige Abenteuerveranda waren ebenfalls mit einem hohen Metallgitter umgeben.“"
                                            },
                                            {
                                                "example_id": "f686b4b7-c97a-407e-a45c-91bd86208368",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Wenn ich um kurz nach achtzehn Uhr nach Hause komme, sind alle Kinder vom Kindergarten abgeholt und einer der beiden Ärztefreunde hat etwas zu essen vorbereitet.“"
                                            },
                                            {
                                                "example_id": "a2be02ce-659e-44f5-a996-dee5fdee996a",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Nun hat sie im Kindergarten mitbekommen, dass in dem Land, in dem ihre Großeltern, Tanten, Cousinen und Cousins leben, Menschen auf die Straße gehen, um für Gerechtigkeit zu kämpfen.“"
                                            },
                                            {
                                                "example_id": "02be19e5-bb8b-4852-9076-94f687a6c284",
                                                "sense_id": "fbcba777-9b83-350e-a7a4-605ec5c57f03",
                                                "text": "„Männer fehlen in Kindergärten, aber auch in Grundschulen, wo zu mehr als 85 Prozent Frauen unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1bf15ef-14af-41f4-8b16-5b45c1285e42",
                        "source_entry_id": "a8f5a2ad-430b-3707-86b7-aa31611af41d",
                        "source_sense_id": "7ce62aa5-c4c2-3670-a5fe-726ce8d7f8ee",
                        "source_sense_description": "eine Schule für Kinder im Alter zwischen 2 und 5 Jahren",
                        "target_lang_word": "Vorschule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorschule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c0038b0-a744-314e-aa17-b851031935fe",
                                        "entry_id": "37b8aabb-68e8-339d-9496-5c01da955253",
                                        "glosses": [
                                            "Einrichtung zur Erziehung vor dem Schuleintritt für Kinder im zwischen 5 und 6 Jahren, welche im letzten Kindergartenjahr oder nach dem Kindergarten und vor dem (Grund-)Schuleintritt erfolgt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1f3e72f-107a-4f6e-be5c-b36d711ee5f3",
                                                "sense_id": "2c0038b0-a744-314e-aa17-b851031935fe",
                                                "text": "„Wenn die Kinder aus der Vorschule entlassen werden, gibt es eine große Feier.“"
                                            },
                                            {
                                                "example_id": "f888b871-73ad-45a6-b242-936854ca3579",
                                                "sense_id": "2c0038b0-a744-314e-aa17-b851031935fe",
                                                "text": "„Mit fünf hat er schon Krawatte und Blazer in der Vorschule getragen, und ob man es glaubt oder nicht: Der kleine Kerl liebt es.“"
                                            },
                                            {
                                                "example_id": "5b4fb235-8c11-4b38-80fc-a60b7152006b",
                                                "sense_id": "2c0038b0-a744-314e-aa17-b851031935fe",
                                                "text": "„Wir fahren mit dem Auto zur Vorschule, für mich ist das purer Luxus, da ich die meiste Zeit zu Fuß unterwegs bin.“"
                                            },
                                            {
                                                "example_id": "efec6a17-fbe7-4312-ac1a-9c027938e506",
                                                "sense_id": "2c0038b0-a744-314e-aa17-b851031935fe",
                                                "text": "[Wolfgang Clement, Ex-Ministerpräsident des Landes Nordrhein-Westfalen:] „Spätestens ab dem vierten Lebensjahr sollte die Vorschule beginnen wie in anderen Ländern auch, möglichst bilingual, wir brauchen eine flächendeckende Ganztagsschule, wir brauchen kleinere Klassen, ich würde sagen, nicht größer als 20 Kinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87252c97-3c86-3d86-8080-54422d0f9d58",
                                        "entry_id": "37b8aabb-68e8-339d-9496-5c01da955253",
                                        "glosses": [
                                            "arrangierte Spielnachmittage und Lernnachmittage für Kinder, die keinen Kindergarten besuchten"
                                        ],
                                        "tags": [
                                            "umgangssprachlich,",
                                            "DDR"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62d7ef8-9738-4bf5-88d6-6ce1b6687bea",
                                                "sense_id": "87252c97-3c86-3d86-8080-54422d0f9d58",
                                                "text": "Viele können sich dunkel daran erinnern, wie sie als Kinder in der DDR nachmittags die Vorschulen besuchten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6e592f0e-e1ba-3601-9e37-ee807f8042e5",
                                        "entry_id": "37b8aabb-68e8-339d-9496-5c01da955253",
                                        "glosses": [
                                            "Möglichkeit der Vorbereitung/vorausgehende Übung für den Übertritt in eine höhere Schule"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4014b2d0-bb6d-4502-ad02-d222990b62a9",
                                                "sense_id": "6e592f0e-e1ba-3601-9e37-ee807f8042e5",
                                                "text": "„Auf diese Weise gelang auch die Mehrzahl der Bundesglieder nach Deutschland, und durch sie bewährte sich der Bund als eine treffliche Vorschule der Revolution.“"
                                            },
                                            {
                                                "example_id": "0327f3f8-3a11-42bf-903f-8c675316d3a9",
                                                "sense_id": "6e592f0e-e1ba-3601-9e37-ee807f8042e5",
                                                "text": "Das tägliche Üben war für sie eine gute Vorschule für ihren späteren Beruf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
