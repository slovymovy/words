                                            },
                                            {
                                                "example_id": "922061d9-8fca-4a71-b714-8bf01bbf229d",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "And shame at what you thought was fard! It’s only make-upping your face."
                                            },
                                            {
                                                "example_id": "860070d2-33ae-4a3a-910a-463e7cb8044f",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "The make-up artist stops make-upping."
                                            },
                                            {
                                                "example_id": "216eec08-966b-4254-9738-88cc33375e77",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "As we’re in the bathroom side-by-side, silently make-upping, Sophie turns to me."
                                            },
                                            {
                                                "example_id": "f422b153-ca19-486e-a7f8-f622aaaca68f",
                                                "sense_id": "bf5b8000-8590-3af3-aa1f-9a30427d47b0",
                                                "text": "Like Carnelle in The Miss Firecracker Contest, Teddy will attempt to transform herself on the outside by shaving, plucking, dressing, make-uping, and acting like a lady."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17b9c38e-84e6-4466-829d-fc89928b0227",
                        "source_entry_id": "0f8618e8-a25e-3832-a98b-d9078b4a4213",
                        "source_sense_id": "e4305cb8-a714-30ea-bc67-9e3856eb7c6a",
                        "target_lang_word": "caracterización",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "de7d9f5d-70c7-40b9-b7c2-0e0840c1af9f",
                        "source_entry_id": "0f8618e8-a25e-3832-a98b-d9078b4a4213",
                        "source_sense_id": "e4305cb8-a714-30ea-bc67-9e3856eb7c6a",
                        "target_lang_word": "Maske",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maske",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70afdad2-300a-3943-95f5-3d47ad110733",
                                        "entry_id": "76abf34c-bef8-3300-ae03-2d22927071bd",
                                        "glosses": [
                                            "Gegenstand zur Verhüllung oder zum Schutz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "567aa571-5889-47f8-bf8b-ffedda4b0feb",
                                                "sense_id": "70afdad2-300a-3943-95f5-3d47ad110733",
                                                "text": "Der Räuber trug eine Maske."
                                            },
                                            {
                                                "example_id": "7b112111-4631-4add-8003-5c8f95a4d6ac",
                                                "sense_id": "70afdad2-300a-3943-95f5-3d47ad110733",
                                                "text": "„In der letzten Zeit hat sie die Maske ganz fallen lassen.“"
                                            },
                                            {
                                                "example_id": "96d87886-7960-44a2-b593-72f64096650a",
                                                "sense_id": "70afdad2-300a-3943-95f5-3d47ad110733",
                                                "text": "„Als er eines Tages auf einen Maskenball gehen wollte, fragte er einen seiner Freunde, welche Maske er wählen solle, um nicht erkannt zu werden.“"
                                            },
                                            {
                                                "example_id": "9c238913-6db7-4551-94c1-6365aaa52b2d",
                                                "sense_id": "70afdad2-300a-3943-95f5-3d47ad110733",
                                                "text": "„Ich trug damals eine Maske, und ihre Kapuze leistete ihr den gleichen Dienst.“"
                                            },
                                            {
                                                "example_id": "25d4e1f0-0d59-410f-96b8-8d63b32a3dec",
                                                "sense_id": "70afdad2-300a-3943-95f5-3d47ad110733",
                                                "text": "„Small hatte seine Maske unerschütterlicher Ruhe fallengelassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91bd10cd-0bde-3702-8267-969274078642",
                                        "entry_id": "76abf34c-bef8-3300-ae03-2d22927071bd",
                                        "glosses": [
                                            "charakteristische Strukturen auf Köpfen von Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b70754d-f56c-4729-8422-9dd7436d1563",
                                                "sense_id": "91bd10cd-0bde-3702-8267-969274078642",
                                                "text": "„Das erwachsene Tier trug die dunkle Maske schon den ganzen Sommer. Vermutlich stammt sie vom Wühlen in den Eingeweiden erlegter Moschusochsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c38963f3-13c8-3c00-8dc9-1491bae06c6b",
                                        "entry_id": "76abf34c-bef8-3300-ae03-2d22927071bd",
                                        "glosses": [
                                            "Eingabeformular im Computer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0780b8d-1ddf-47a1-8e14-a0508d2ff005",
                                                "sense_id": "c38963f3-13c8-3c00-8dc9-1491bae06c6b",
                                                "text": "Geben Sie bitte Ihren Namen in die Maske ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "012fa99d-ca27-3f21-8cfa-77f173763d33",
                                        "entry_id": "76abf34c-bef8-3300-ae03-2d22927071bd",
                                        "glosses": [
                                            "zur Straffung der Haut auf das Gesicht aufgetragene Kosmetik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc05a996-8958-4760-a194-f2b00210c2f8",
                                                "sense_id": "012fa99d-ca27-3f21-8cfa-77f173763d33",
                                                "text": "Nachdem sie ihre Maske aufgetragen hatte, sah sie aus wie ein Alien."
                                            },
                                            {
                                                "example_id": "64c8d68e-f950-43ba-a3b4-3d9bfa881289",
                                                "sense_id": "012fa99d-ca27-3f21-8cfa-77f173763d33",
                                                "text": "„In der Maske auf meinem Gesicht hatten sich schon kleine Risse gebildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e66c04c5-753b-3a45-996c-a2477ab04e87",
                                        "entry_id": "76abf34c-bef8-3300-ae03-2d22927071bd",
                                        "glosses": [
                                            "Gipsabguss des Kopfes eines Toten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680b76a0-e50a-42cc-8273-dc9f2abf5197",
                                                "sense_id": "e66c04c5-753b-3a45-996c-a2477ab04e87",
                                                "text": "In Museen findet man oft Masken berühmter Leute."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "77c87f81-409e-3c49-86ee-bc9a66703f0f",
                                        "entry_id": "76abf34c-bef8-3300-ae03-2d22927071bd",
                                        "glosses": [
                                            "maskierte beziehungsweise verkleidete Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cb7116-5e33-4393-8018-278d838d2869",
                                                "sense_id": "77c87f81-409e-3c49-86ee-bc9a66703f0f",
                                                "text": "Man darf nicht alles glauben, was einem eine Maske im Karneval erzählt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
