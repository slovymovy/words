                    },
                    {
                        "translation_id": "70cd926b-f505-4b77-828f-07d04477ef08",
                        "source_entry_id": "38a9cf80-6b3e-3d84-a872-d47be2213915",
                        "source_sense_id": "c79e9a29-14fa-3699-9e95-43533cc1cbd4",
                        "source_sense_description": "Linguistik: diakritisches Zeichen, das den fallenden Ton und häufig auch die Betonung angibt",
                        "target_lang_word": "grave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "An excavation in the earth as a place of burial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6960e38-8582-4eb9-bd0d-d8b1e521cae8",
                                                "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                                "text": "He had lain in the grave four days."
                                            },
                                            {
                                                "example_id": "919e3358-db91-44d9-8fda-6771d369715b",
                                                "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                                "text": "Let mee not be ashamed, O Lord, for I haue called vpon thee: let the wicked be ashamed, and let them be silent in the graue."
                                            },
                                            {
                                                "example_id": "7e7ee969-a142-48a4-a553-9ab9d7bf9c8c",
                                                "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                                                "text": "They reached the cemetery. The men went right down to a place in the grass where a grave was dug. They ranged themselves all round; and while the priest spoke, the red soil thrown up at the sides kept noiselessly slipping down at the corners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4658d3f-a94c-36f2-97d4-8f1a8ec7ed4c",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Any place of interment."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6b9c00b-1eca-31f4-9eb8-8f794b52dd6a",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Any place containing one or more corpses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "181f8537-19f3-3a80-ae9c-032167757b46",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Death, destruction."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d17c202-a78d-447a-87d1-8ffa500fa4f0",
                                                "sense_id": "181f8537-19f3-3a80-ae9c-032167757b46",
                                                "text": "[…]Meeting is pleasure, parting is a grief; / An inconstant lover is worse than a thief; / A thief can but rob you, and take all you have, / An inconstant lover will bring you to the grave![…]"
                                            },
                                            {
                                                "example_id": "73108976-a233-483d-b9ec-44c736e75d8d",
                                                "sense_id": "181f8537-19f3-3a80-ae9c-032167757b46",
                                                "text": "[…]balanced on the biggest wave you race towards an early grave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe560984-a676-3b52-980a-8c814fed3eb9",
                                        "entry_id": "34b52378-9557-3558-b31c-ef341528cfc7",
                                        "glosses": [
                                            "Deceased people; the dead."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b0c5bf-5f16-40ce-a12f-568287ee360c",
                                                "sense_id": "fe560984-a676-3b52-980a-8c814fed3eb9",
                                                "text": "\"Hold your jaw, woman! I've had enough to vex me to-day without you startin' your tantrums. You're jealous of the grave. That's wot's the matter with you.\" \"And her brats can insult me as they like - me that 'as cared for you these five years.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31eccbb8-2701-3544-86c0-a01f91368fe1",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To dig."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181c91fd-2915-4fe1-bd49-935dac360b02",
                                                "sense_id": "31eccbb8-2701-3544-86c0-a01f91368fe1",
                                                "text": "He hath graven and digged up a pit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To carve or cut, as letters or figures, on some hard substance; to engrave."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e816d514-03ac-450f-b807-cd4ec7104a41",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "Thou shalt take two onyx stones, and grave on them the names of the children of Israel."
                                            },
                                            {
                                                "example_id": "afbd942b-654e-4286-afc1-454ae7969ce9",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "Deep lines were graven on her pale forehead, and on her wan, thin cheeks."
                                            },
                                            {
                                                "example_id": "6ed433ce-0535-43a6-844d-0adaf4cbf72f",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "a. 1894, Robert Louis Stevenson, \"Requiem\"\nThis be the verse you grave for me / \"Here he lies where he longs to be\""
                                            },
                                            {
                                                "example_id": "4df4d475-9453-4c3b-9e8c-4ff2d32bbced",
                                                "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                                                "text": "'It may be so,' I answered; 'but if the loved one prove a broken reed to pierce us, or if the love be loved in vain - what then? Shall a man grave his sorrows upon a stone when he hath but need to write them on the water?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f2bf281-b58a-357b-abc6-be8bc9d8e5b4",
                                        "entry_id": "a156862e-2872-33a3-acf8-efefdf322ef0",
                                        "glosses": [
                                            "To carve out or give shape to, by cutting with a chisel; to sculpture."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7051fddc-d8ec-4f20-8db5-4f3d9fc0dfdf",
