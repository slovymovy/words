    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "62cf70bf-1b05-38cd-b154-85695505553b",
                "word": "emendation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a3a03098-3713-4a10-852b-eb26016678e9",
                        "entry_id": "62cf70bf-1b05-38cd-b154-85695505553b",
                        "tags": [
                            "plural"
                        ],
                        "form": "emendations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "be611e4a-9c91-3a49-8d40-e0fea97e8f9a",
                        "entry_id": "62cf70bf-1b05-38cd-b154-85695505553b",
                        "glosses": [
                            "The act of altering for the better, or correcting what is erroneous or faulty; correction; improvement."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b79d7d3-dc8e-49bf-9872-c7234162da8c",
                                "sense_id": "be611e4a-9c91-3a49-8d40-e0fea97e8f9a",
                                "text": "‘Aye, aye,’ quoth she, and it will be observed that no emendation whatever is necessary to be made in these two initiative remarks, ‘Aye, aye! […]"
                            },
                            {
                                "example_id": "c923c1da-9455-48ad-8371-c6a4861d50e2",
                                "sense_id": "be611e4a-9c91-3a49-8d40-e0fea97e8f9a",
                                "text": "Then, less melodiously, dissenters of different sects issue a cantankerous emendation."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f231893-71b3-3655-9c7e-585d5b7896a1",
                        "entry_id": "62cf70bf-1b05-38cd-b154-85695505553b",
                        "glosses": [
                            "Alteration by editorial criticism, as of a text so as to give a better reading; removal of errors or corruptions from a document."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "b04a76a9-8811-4a7f-9300-593a0276fbf5",
                                "sense_id": "9f231893-71b3-3655-9c7e-585d5b7896a1",
                                "text": "The book might be improved by judicious emendations."
                            },
                            {
                                "example_id": "4fa9a545-7560-450e-bd35-85e1a7d8c076",
                                "sense_id": "9f231893-71b3-3655-9c7e-585d5b7896a1",
                                "text": "After some deliberation I decided to publish this journal, with only such emendations and corrections as its hasty writing in camp necessitated."
                            },
                            {
                                "example_id": "9ffc022b-ac65-46f1-b5c9-7fd3af38ef6f",
                                "sense_id": "9f231893-71b3-3655-9c7e-585d5b7896a1",
                                "text": "Why, he had all the earmarks of a typewriter copyist, if you leave out the disposition to contribute uninvited emendations of your grammar and punctuation."
                            },
                            {
                                "example_id": "d53afe10-b9b1-4ea1-9437-d417f27e54ec",
                                "sense_id": "9f231893-71b3-3655-9c7e-585d5b7896a1",
                                "text": "Thus he beheld her recede, and in the anguish of his heart quoted a line from a poet, with peculiar emendations of his own— God’s not in his heaven: All’s wrong with the world!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4ecb722d-dcdb-3fae-b503-eeb0c1b971fe",
                        "entry_id": "62cf70bf-1b05-38cd-b154-85695505553b",
                        "glosses": [
                            "An intentional change in the spelling of a scientific name, which is usually not allowed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f8721a49-3646-412c-919e-71f05bf2e256",
                                "sense_id": "4ecb722d-dcdb-3fae-b503-eeb0c1b971fe",
                                "text": "The genus name Uramyia is an unjustified emendation of Uramya even though it uses a better transliteration of the Greek word μυῖα."
                            }
                        ]
                    }
                ],
