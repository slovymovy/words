                                        "examples": [
                                            {
                                                "example_id": "7648e95b-f5e2-4391-bcd8-f4d8c5e2a692",
                                                "sense_id": "6c7fc703-d87e-36a4-83eb-432a3db7877e",
                                                "text": "En math, je coulais à pic. Le reste, bof."
                                            },
                                            {
                                                "example_id": "7335aa5d-070b-4f82-83c7-31c6486f043e",
                                                "sense_id": "6c7fc703-d87e-36a4-83eb-432a3db7877e",
                                                "text": "LES BOFFISTES\n Partout, en Iran, en Chine, en Syrie, en Afghanistan, en Afrique, en Corée du Nord, à Hong Kong, les gens se battent pour avoir un peu de libertés.\n Juste un peu.\n Ici, bof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7887362e-b76b-374a-8ebc-3b576d88323b",
                                        "entry_id": "4e63120f-e9e5-30e9-80d7-c8ee26053d69",
                                        "glosses": [
                                            "Exprime le doute quant à la valeur d'une personne ou d'une chose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bof",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c66f22a3-31ee-3d2e-ae6d-509c00ca1eeb",
                                        "entry_id": "1eb8adaf-28b1-348e-9da5-54347fa36b0c",
                                        "glosses": [
                                            "Qui est en dessous du médiocre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3afbe99-38a9-4530-952e-5610fb336a7f",
                                                "sense_id": "c66f22a3-31ee-3d2e-ae6d-509c00ca1eeb",
                                                "text": "Ce que j'écrivais n'était pas bon. Ce n'était pas non plus horrible à vomir. Juste super bof. Plat. Fade. Des textes qui cassaient pas trois pattes à un canard."
                                            },
                                            {
                                                "example_id": "f1b79b56-2e7e-4e36-be3f-f618ca656e0a",
                                                "sense_id": "c66f22a3-31ee-3d2e-ae6d-509c00ca1eeb",
                                                "text": "Je fume tout le shit de Salomé en regardant The Walking Dead, une série sur les zombies (bof), puis Homeland (très bof), puis Mission : Impossible 4 (inepte), jusqu'à ce que je tombe sur Tarnation, en entier, sur YouTube."
                                            }
                                        ]
                                    }
                                ]
                            }
