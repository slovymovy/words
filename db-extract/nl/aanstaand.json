                    }
                ],
                "senses": [
                    {
                        "sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                        "entry_id": "3176643d-efb1-3579-9e6d-21d64ef85daa",
                        "glosses": [
                            "eerstvolgend, komend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd8a0dbc-5b2f-4ccb-b124-d347ddcbf4ed",
                                "sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                                "text": "De volgende vergadering zal aanstaande maandag plaats vinden."
                            },
                            {
                                "example_id": "2a698ce9-deef-4e20-98ac-d7d59a4a0485",
                                "sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                                "text": "De aanstaande moeder verwacht over één maand haar baby."
                            },
                            {
                                "example_id": "15eae396-7445-4f7b-8994-681c99ac62ba",
                                "sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                                "text": "De aanstaande president wordt morgen gekozen."
                            },
                            {
                                "example_id": "75392ffa-5f24-4779-bca0-90fb6cd674f6",
                                "sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                                "text": "Aangezien de tweeling vrijdagavond steevast bloednerveus werd vanwege de aanstaande cadeautjes en het partijtje, sliep niemand die nacht fatsoenlijk."
                            },
                            {
                                "example_id": "ff839510-e972-46cf-985a-f1bc32097cc1",
                                "sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                                "text": "De zoon was eindelijk in behouden haven, als je dat kon zeggen van een aanstaande marineofficier die niet op zee zou opereren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d863d01-e79d-4698-85f1-1e33bdd74ecd",
                        "source_entry_id": "3176643d-efb1-3579-9e6d-21d64ef85daa",
                        "source_sense_id": "a90b64dc-16db-36c8-bd94-85141cc2fff7",
                        "target_lang_word": "forthcoming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forthcoming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae059744-e0a3-39e1-8942-1d8850b0f2d3",
                                        "entry_id": "c29519e6-9ac3-3076-ae08-ea4719005eb8",
                                        "glosses": [
                                            "Approaching or about to take place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6d1623-89de-42d9-9784-497e72b30c8c",
                                                "sense_id": "ae059744-e0a3-39e1-8942-1d8850b0f2d3",
                                                "text": "I shall vote in the forthcoming election."
                                            },
                                            {
                                                "example_id": "335d8b7e-cd34-4d8f-8636-ea1ceee8b2b9",
                                                "sense_id": "ae059744-e0a3-39e1-8942-1d8850b0f2d3",
                                                "text": "The visitors began to hold a much higher line, passing and moving with greater urgency, and their reward was forthcoming."
                                            },
                                            {
                                                "example_id": "feca2873-1a8a-4c36-86d9-63e470b96c02",
                                                "sense_id": "ae059744-e0a3-39e1-8942-1d8850b0f2d3",
                                                "text": "Never one to waste an opportunity, he says now: \"The low points? You can read about them in my forthcoming book! It's at the printers now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bc72270-e137-3785-b5c2-7fa5f60d8167",
                                        "entry_id": "c29519e6-9ac3-3076-ae08-ea4719005eb8",
                                        "glosses": [
                                            "Available when needed; in place, ready."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643c7b15-9dbf-4701-93f0-d4a2a57634c5",
                                                "sense_id": "8bc72270-e137-3785-b5c2-7fa5f60d8167",
                                                "text": "The money was not forthcoming."
                                            },
                                            {
                                                "example_id": "aa8be66c-a3dc-4c6d-b98f-45869e796a7e",
                                                "sense_id": "8bc72270-e137-3785-b5c2-7fa5f60d8167",
                                                "text": "Unfortunately, sufficient public support has not been forthcoming, and the trains were withdrawn from September 15."
                                            },
                                            {
                                                "example_id": "726c743b-5e8b-421f-95df-683cb25edc0a",
                                                "sense_id": "8bc72270-e137-3785-b5c2-7fa5f60d8167",
                                                "text": "This may perhaps throw some light on the fact that in democratic countries defending themselves against aggression, sufficient support may be forthcoming for the necessary far-reaching measures (which may even take on the character of holistic planning) without suppression of public criticism, while in countries preparing for an attack or waging an aggressive war, public criticism as a rule must be suppressed, in order that public support may be mobilized by presenting aggression as defence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e47899b-7e41-360b-af1e-02034882dc48",
                                        "entry_id": "c29519e6-9ac3-3076-ae08-ea4719005eb8",
                                        "glosses": [
                                            "Willing to co-operate or provide information; candid, frank, responsive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "139c1166-d7f2-4a75-80a3-a79b1c350618",
                                                "sense_id": "3e47899b-7e41-360b-af1e-02034882dc48",
                                                "text": "Once I explained why I needed to know, she was really forthcoming."
                                            },
                                            {
                                                "example_id": "92530ed0-63e4-4c80-898a-3e89012b1e9e",
                                                "sense_id": "3e47899b-7e41-360b-af1e-02034882dc48",
                                                "text": "So the lawyer talks to him, and tries to get the details of the case, but the guy's not really forthcoming, you know, he won't say exactly where he lives, won't give any names, and the lawyer is thinking something's funny, but still there's real panic [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forthcoming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69280c04-d091-3942-88b5-626bc4f5f82b",
                                        "entry_id": "25036d1d-13f2-339a-89ad-ae7a553e09ec",
                                        "glosses": [
                                            "An act of coming forth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03855e0a-1fc8-36fc-b135-a97fbaf690ae",
                                        "entry_id": "25036d1d-13f2-339a-89ad-ae7a553e09ec",
                                        "glosses": [
                                            "Something that is yet to come."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65df09aa-cd24-486f-a773-050f58b84011",
                                                "sense_id": "03855e0a-1fc8-36fc-b135-a97fbaf690ae",
                                                "text": "The reader, has had presented to him things not belonging to time or mortality, but awful realities issuing out from eternity, the audible forthcomings of a present living God."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forthcoming",
                                "target_lang_code": "en",
                                "target_senses": [
