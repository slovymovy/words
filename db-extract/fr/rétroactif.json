                    }
                ],
                "senses": [
                    {
                        "sense_id": "16d87966-d562-32e8-8512-bab8f78bb396",
                        "entry_id": "678e657f-8087-38d6-91da-5ae0a53789dd",
                        "glosses": [
                            "Qui agit sur le passé. S’emploie surtout avec le mot effet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54504b2c-270b-48bc-b219-b3dfd78ef534",
                                "sense_id": "16d87966-d562-32e8-8512-bab8f78bb396",
                                "text": "L’âge, la beauté, la pâleur, la nationalité de cette enfant, l’impressionnaient beaucoup. Et la teinte de la robe jaune, si décolorée par de fréquents lavages, et cette mauvaise reprise des bas et et les talons éculés des chaussures et cet air de souffrance rétroactive !"
                            },
                            {
                                "example_id": "53d7f099-8985-47f1-9457-3f73e6780b76",
                                "sense_id": "16d87966-d562-32e8-8512-bab8f78bb396",
                                "text": "13 octobre 44 – Un jour, à Philadelphie, Pennsylvania, il parlera peut-être de moi à sa femme, avec un sourire rétroactif et une voix un peu mélancolique, celle des occasions perdues."
                            }
                        ]
                    },
                    {
                        "sense_id": "53771765-d424-3629-b428-75191db5695b",
                        "entry_id": "678e657f-8087-38d6-91da-5ae0a53789dd",
                        "glosses": [
                            "Se dit d'une décision législative ou réglementaire dont l'exécution est étendue á une période antérieure à leur date d'adoption."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "941e6539-b3a8-4ee5-ac9a-8a720e16743c",
                                "sense_id": "53771765-d424-3629-b428-75191db5695b",
                                "text": "La loi ne dispose que pour l'avenir ; elle n'a point d'effet rétroactif."
                            },
                            {
                                "example_id": "baf693c3-e7bb-41dc-b3de-010cc71a33fa",
                                "sense_id": "53771765-d424-3629-b428-75191db5695b",
                                "text": "La décision du juge qui prononce la nullité prend le nom d’annulation, elle est en principe rétroactive (…)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c62c8b2-9708-4f03-9bb2-9d74bd2e6123",
                        "source_entry_id": "678e657f-8087-38d6-91da-5ae0a53789dd",
                        "target_lang_word": "rückwirkend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rückwirkend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                        "entry_id": "6033504a-388b-3afa-a3bb-3ea27b15a7b2",
                                        "glosses": [
                                            "von einem in der Vergangenheit liegenden Zeitpunkt an gültig / in Kraft tretend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bd3d1f1-e746-4c8c-a847-c1e9491ca988",
                                                "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                                "text": "Die Anträge gelten rückwirkend zum 1. Januar 2018."
                                            },
                                            {
                                                "example_id": "09bb90e0-184a-415e-bc1b-f669c1fc14c8",
                                                "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                                "text": "Für Zweitwohnungen muss kein weiterer [Rundfunk-]Beitrag bezahlen werden - und zwar rückwirkend ab Urteilsverkündung."
                                            },
                                            {
                                                "example_id": "aba780b7-a350-4dfc-9f03-377948d7bddb",
                                                "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                                "text": "Wer lange zuwartet, verliert viel Geld. Denn die zu viel bezahlte Miete kann nicht rückwirkend eingefordert werden."
                                            },
                                            {
                                                "example_id": "bc0b007e-528f-4d6f-a4cb-2b89a5337062",
                                                "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                                "text": "Die Sperre [für den amerikanischen Schwimmer und Goldmedaillengewinner Ryan Lochte wegen Dopings] gilt rückwirkend ab Mai bis zum Juli 2019."
                                            },
                                            {
                                                "example_id": "e27269bd-ac43-4be1-985d-17399a08596a",
                                                "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                                "text": "Heine Jensen ist nicht mehr Bundestrainer der deutschen Handballerinnen. Sein Vertrag wurde rückwirkend aufgelöst - „in beiderseitigem Einvernehmen“."
                                            },
                                            {
                                                "example_id": "2c3b41b6-9f6c-4330-bcc0-7e298a25ec45",
                                                "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                                "text": "Im Falle fehlender Bereitschaft auf Seiten des Konzerns [Microsoft] sollen die angedrohten Strafen sogar rückwirkend ab dem 15. Dezember gelten."
                                            },
                                            {
                                                "example_id": "a3c0fe50-3341-42ee-a5ec-bf34c3e7eb0c",
                                                "sense_id": "298a7bdc-3446-38e5-9560-d95e5c530453",
                                                "text": "Vor gut zehn Jahren investierten Bürger und Unternehmen in Spanien in die Sonnenenergie. Die Regierung lockte mit interessanten Vergütungen. Mit der Wirtschaftskrise musste der Staat sparen und kürzte diese Vergütungen rückwirkend um bis zu 40 Prozent."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9c037c6-7261-31f9-b658-066effd57242",
                                        "entry_id": "6033504a-388b-3afa-a3bb-3ea27b15a7b2",
                                        "glosses": [
                                            "mit Auswirkungen auf denjenigen/dasjenige, der/das etwas auslöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e190232-dc04-4491-be32-a6d4a8d7e952",
                                                "sense_id": "b9c037c6-7261-31f9-b658-066effd57242",
                                                "text": "Bei der rückwirkenden Hemmung (retroaktive Hemmung) wird das Lernen und Behalten eines zuerst gelernten Stoffes durch Lernstoffe, die später eingeübt werden, behindert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "rückwirkend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac56dedf-8664-3cd5-8f9f-9093a3cabbee",
                                        "entry_id": "2e4a9e44-2def-347b-8a18-126bc8b057cd",
