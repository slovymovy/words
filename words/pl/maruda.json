{
    "word_family": [
        "marudzić",
        "marudny",
        "marudzenie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d5c1950-3d60-31a8-a3a8-7413a4d6e1bb",
                    "sense_definition": "osoba, która często narzeka, jest niezadowolona i głośno wyraża swoje pretensje",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "osoba narzekająca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie bądź taką <w>marudą</w> i ciesz się wreszcie z wyjazdu na wakacje.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>нытиком</w> и порадуйся наконец поездке в отпуск."
                            }
                        },
                        {
                            "text": "Mój brat to straszna <w>maruda</w>, zawsze znajdzie powód do narzekania na pogodę.",
                            "target_lang_translations": {
                                "ru": "Мой брат — ужасный <w>ворчун</w>, всегда найдет повод пожаловаться на погоду."
                            }
                        }
                    ],
                    "synonyms": [
                        "gderacz",
                        "zrzęda",
                        "malkontent"
                    ],
                    "common_phrases": [
                        "straszna maruda"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который часто жалуется, всем недоволен и громко выражает свое недовольство"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нытик",
                                "target_lang_sense_clarification": "разговорное, о человеке, который постоянно жалуется"
                            },
                            {
                                "target_lang_word": "ворчун",
                                "target_lang_sense_clarification": "о человеке, который постоянно выражает недовольство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f7b18c5-a62e-3d1f-b213-69a994824c83",
                    "sense_definition": "osoba, która wykonuje swoje zadania bardzo powoli i nieefektywnie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "osoba powolna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przestań być taką <w>marudą</w> i pospiesz się, bo spóźnimy się na pociąg.",
                            "target_lang_translations": {
                                "ru": "Перестань быть такой <w>копушей</w> и поторопись, а то мы опоздаем на поезд."
                            }
                        },
                        {
                            "text": "Wszyscy już dawno skończyli pracę, tylko ta <w>maruda</w> wciąż siedzi nad jednym zadaniem.",
                            "target_lang_translations": {
                                "ru": "Все уже давно закончили работу, только эта <w>копуша</w> всё сидит над одним заданием."
                            }
                        }
                    ],
                    "synonyms": [
                        "guzdrała",
                        "ślamazara",
                        "grzebała"
                    ],
                    "antonyms": [
                        "żywe srebro"
                    ],
                    "common_phrases": [
                        "wielka maruda"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который делает свою работу очень медленно и неэффективно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копуша",
                                "target_lang_sense_clarification": "разговорное, о медлительном человеке"
                            },
                            {
                                "target_lang_word": "рохля",
                                "target_lang_sense_clarification": "о вялом, медлительном и нерасторопном человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd10fa9d-e341-3e89-b0ad-ed81bd42eced",
                    "sense_definition": "osoba mająca skłonności do kapryszenia i grymaszenia",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "osoba narzekająca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko jest dzisiaj wyjątkową <w>marudą</w> i nie chce zjeść żadnego obiadu.",
                            "target_lang_translations": {
                                "ru": "Ребенок сегодня такой <w>привереда</w> и не хочет есть никакой обед."
                            }
                        },
                        {
                            "text": "Nie zachowuj się jak <w>maruda</w>, tylko spróbuj tego nowego dania.",
                            "target_lang_translations": {
                                "ru": "Не веди себя как <w>привереда</w>, а просто попробуй это новое блюдо."
                            }
                        }
                    ],
                    "synonyms": [
                        "kapryśnik",
                        "chimeryk"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, склонный к капризам и привередливости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привереда",
                                "target_lang_sense_clarification": "о человеке, который трудно угодить"
                            },
                            {
                                "target_lang_word": "капризуля",
                                "target_lang_sense_clarification": "разговорное, часто о детях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "381b2b27-d4b4-38d3-bed5-0416335fc2c5",
                    "sense_definition": "w wierzeniach ludowych: demon żeński dręczący niemowlaki i doprowadzający je do płaczu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "demonologia",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Według dawnych wierzeń, <w>maruda</w> zakradała się nocą do kołyski, by niepokoić dziecko.",
                            "target_lang_translations": {
                                "ru": "Согласно древним поверьям, <w>мара</w> пробиралась ночью к колыбели, чтобы беспокоить ребенка."
                            }
                        },
                        {
                            "text": "Wiele ludowych opowieści wspomina o tym, jak <w>maruda</w> odbierała niemowlętom spokojny sen.",
                            "target_lang_translations": {
                                "ru": "Многие народные сказания упоминают о том, как <w>мара</w> лишала младенцев спокойного сна."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "termin z zakresu demonologii ludowej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "в народных поверьях: женский демон, мучающий младенцев и заставляющий их плакать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мара",
                                "target_lang_sense_clarification": "в славянской мифологии дух, приносящий беспокойство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}