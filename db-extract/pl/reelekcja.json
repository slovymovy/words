                                "target_senses": [
                                    {
                                        "sense_id": "c2f6d67e-4977-3655-801e-06ad8da785e1",
                                        "entry_id": "7f5c99c6-ddc9-38ae-a28b-c8ce43927473",
                                        "glosses": [
                                            "Alternative spelling of reelection."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21032e49-d1c0-440e-9870-7fd5649e2413",
                                                "sense_id": "c2f6d67e-4977-3655-801e-06ad8da785e1",
                                                "text": "Having served for 11 years (he was elected in 2011 and 2016), Cortes announced his intention in September not to stand for re-election."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1760653a-6832-4023-8205-04a64c6d7f5f",
                        "source_entry_id": "bd676421-0327-3fdd-b46f-04f185e584d1",
                        "source_sense_id": "fa8a7100-e518-3f3c-8d55-1b7103c78585",
