                        "glosses": [
                            "Qui ne peut pas être réveillé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2710243f-fe95-4cf0-81e5-bf563a3a0fc7",
                                "sense_id": "305b2517-fd66-36b1-b61c-cc8edb32c8b8",
                                "text": "Lestement, il regrimpa l’escalier, et, dans la pièce où des flammes, déjà, développées par le courant d’air, léchaient le lit où Chantereine dormait, irréveillable, il ramassa en hâte les hardes de son ancien client."
                            },
                            {
                                "example_id": "62bddc32-1316-4f54-84bc-c3aa29298655",
                                "sense_id": "305b2517-fd66-36b1-b61c-cc8edb32c8b8",
                                "text": "J’avais connu cet irréveillable personnage alors qu’il fabriquait à l’aide de pendulettes empruntées une machine à réveiller dont le schéma délirant m’est sorti de la mémoire."
                            },
                            {
                                "example_id": "a9a1a2d5-40a3-4b1c-9bc4-51c05938efc2",
                                "sense_id": "305b2517-fd66-36b1-b61c-cc8edb32c8b8",
                                "text": "- Si je ne me douche pas, je vais finir comme la belle au bois dormant : je vais être irréveillable !"
                            }
                        ]
                    }
                ],
