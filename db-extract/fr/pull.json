                    },
                    {
                        "translation_id": "fe2b2c55-5760-4ba5-b776-3f5c5c90e42a",
                        "source_entry_id": "62855e94-d4a4-3e94-9d2b-42622807ed0b",
                        "source_sense_id": "cca1debd-c21c-3fc3-bb03-8bfb7c3cdc61",
                        "target_lang_word": "свитер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "свитер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "abc44636-db71-318d-8906-8608bde90626",
                                        "entry_id": "034de705-67a2-3e9d-9498-4f5abe516572",
                                        "glosses": [
                                            "тёплая вязаная рубашка без застёжек с высоким воротником, надеваемая через голову"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b939130-3cbc-4055-a6be-cec26514c7dd",
                                                "sense_id": "abc44636-db71-318d-8906-8608bde90626",
                                                "text": "Мы пытались сохранить, сберечь это тепло, Таня подтягивала ворот свитера к подбородку, я засовывал руки поглубже в карманы брюк, но весенний пронзительный ветерок всё равно пронимал, до дрожи."
                                            },
                                            {
                                                "example_id": "a867e3ed-6f23-4194-83eb-fe3a50ea2ee3",
                                                "sense_id": "abc44636-db71-318d-8906-8608bde90626",
                                                "text": "Брок был в длинном сером пиджаке, чёрных брюках и коричневой жилетке, одетой поверх свитера."
                                            },
                                            {
                                                "example_id": "6167eeea-2f86-4259-8770-b130042fb9e9",
                                                "sense_id": "abc44636-db71-318d-8906-8608bde90626",
                                                "text": "На сизом катке (там, где летом площадки для тенниса), слегка припудренном сухим снежком, опасливо резвились горожане, и в ту минуту, как мимо, по тротуару, проходили Лужины, совершавшие утреннюю прогулку, самый бойкий из конькобежцев, молодец в свитере, изящно раскатился голландским шагом и с размаху сел на лед."
                                            },
                                            {
                                                "example_id": "d754b72b-25c9-42ec-9f58-8972ad5c32ab",
                                                "sense_id": "abc44636-db71-318d-8906-8608bde90626",
                                                "text": "Она вязала на заказчиков свитера, кормила семью, никогда не жаловалась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
