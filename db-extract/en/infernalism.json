    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4e78e2f9-21c8-3c44-a902-a99c51b0234c",
                "word": "infernalism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a87a6d8a-be7d-449d-b7f1-9b5429d9eabd",
                        "entry_id": "4e78e2f9-21c8-3c44-a902-a99c51b0234c",
                        "tags": [
                            "plural"
                        ],
                        "form": "infernalisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39e8f947-56f4-34b0-b202-be58e339ddd4",
                        "entry_id": "4e78e2f9-21c8-3c44-a902-a99c51b0234c",
                        "glosses": [
                            "Belief in the existence of hell, especially as a place of eternal and conscious torment after death."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "71a55edb-ef6e-434d-82d2-9b20945e0c28",
                                "sense_id": "39e8f947-56f4-34b0-b202-be58e339ddd4",
                                "text": "To these conceptions Protestant churches will gradually yield, and while still nominally the same in their faith, its infernalism will disappear, and the idea of future punishment will become a rational instead of a diabolical picture of Divine justice."
                            },
                            {
                                "example_id": "aef3a401-1040-413d-ad8a-7da6fc7f3231",
                                "sense_id": "39e8f947-56f4-34b0-b202-be58e339ddd4",
                                "text": "Sheltered in my tiny corner of Christendom, like many evangelicals I was unaware of […] alternative prespectives on hell that did not transform God into a wrathful tyrant-judge who consigns the unrepentant to Dante-tesque tortures for eternity. As it turns out, the view of hell with which I grew up—infernalism—is only one of several options […]"
                            },
                            {
                                "example_id": "499a683d-b1e3-497d-9e58-4f288a80d8dc",
                                "sense_id": "39e8f947-56f4-34b0-b202-be58e339ddd4",
                                "text": "Embedded within his argument is the view that infernalism is a less severe form of retributive punishment than annihilationism; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c694e83c-ddf8-3999-9f94-79ba035f8f76",
                        "entry_id": "4e78e2f9-21c8-3c44-a902-a99c51b0234c",
                        "glosses": [
                            "Hellishness."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "715d47de-096c-46fb-b4d4-24281ecce7c2",
                                "sense_id": "c694e83c-ddf8-3999-9f94-79ba035f8f76",
                                "text": "It is because worship has been slavishly bestowed on the personification of the worst of the human qualities magnified to infernalism, that it has been considered a degrading, or at least a pusilanimous thing […]"
                            },
                            {
                                "example_id": "5dfd2cd2-1ae0-41ad-b86c-03925969fbb0",
                                "sense_id": "c694e83c-ddf8-3999-9f94-79ba035f8f76",
                                "text": "Paternalism has no terrors for me; indeed, I much prefer paternalism any time, in any form, and anywhere to infernalism in the way of bad roads."
                            },
                            {
                                "example_id": "4dc9afab-30b6-4a48-922b-cbdf69f5b469",
                                "sense_id": "c694e83c-ddf8-3999-9f94-79ba035f8f76",
                                "text": "If the production of men from a planet is continuous and the inhabitants should turn out to favor infernalism above heavenly things, then the Infinite Grand Universe of the Lord would be in danger of getting too many inhabitants for the hells and too few for the heavens."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd207582-25a0-324a-8dfc-93f44ced8896",
                        "entry_id": "4e78e2f9-21c8-3c44-a902-a99c51b0234c",
                        "glosses": [
                            "An infernal thing or act."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cc9d428d-c9eb-44eb-bf31-838af1005044",
                                "sense_id": "dd207582-25a0-324a-8dfc-93f44ced8896",
                                "text": "Is not the State an infernal institution? Why expect from it, then, anything but infernalisms?"
                            },
                            {
                                "example_id": "39dc8b07-847a-4072-bec8-5437fd020f43",
                                "sense_id": "dd207582-25a0-324a-8dfc-93f44ced8896",
                                "text": "To me the long catalogue of matrimonial infernalisms has no significance other than that of congratulation at my escape from such loving woes."
                            }
                        ]
                    }
                ],
