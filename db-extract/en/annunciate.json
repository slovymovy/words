                "senses": [
                    {
                        "sense_id": "522b456d-783b-3d98-8e22-00a678fc8069",
                        "entry_id": "c1f6904b-d84b-38d3-a8ae-d7c516c57a77",
                        "glosses": [
                            "To announce."
                        ],
                        "tags": [
