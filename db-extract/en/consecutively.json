                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95940dfa-71ff-488c-a64b-4b30ab11cebb",
                                                "sense_id": "dcda567a-c43d-349d-b3bd-0ce0e543fb89",
                                                "text": "Das sollten wir nacheinander erledigen."
                                            },
                                            {
                                                "example_id": "128761fa-780f-46d4-9831-af36a0e6b2f7",
                                                "sense_id": "dcda567a-c43d-349d-b3bd-0ce0e543fb89",
                                                "text": "„Rücksichtslos schickt er seine Sklaven zwei Sommer nacheinander auf Thorsteins Land - obwohl er weiß, dass der Nachbar angekündigt hat, solche Eindringlinge zu erschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c1f861f-16ac-3416-99a9-42c64d99bd5c",
