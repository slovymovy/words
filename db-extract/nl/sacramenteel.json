                "translations": [
                    {
                        "translation_id": "bbe4ef83-a68c-4fab-8c4f-980032775c65",
                        "source_entry_id": "1aa82107-7484-34d1-a8a0-0d61f4f7f080",
                        "source_sense_id": "cc2781ae-7b4a-3e61-a294-1f8092655e97",
                        "target_lang_word": "sakramental",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "687d2421-0d0e-4a11-bd9c-067983e3bcae",
                        "source_entry_id": "1aa82107-7484-34d1-a8a0-0d61f4f7f080",
                        "source_sense_id": "cc2781ae-7b4a-3e61-a294-1f8092655e97",
                        "target_lang_word": "sacramental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacramental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e1394fb-acbf-36d8-b617-409b927817f7",
                                        "entry_id": "7f631c68-79f8-39fa-8274-e94a4fd60f2c",
                                        "glosses": [
                                            "Used in, or relating to, a sacrament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258ca5da-0e7b-40e9-a52b-fecb8a84443f",
                                                "sense_id": "8e1394fb-acbf-36d8-b617-409b927817f7",
                                                "text": "The altar boys got in trouble after they were caught sampling the sacramental wine instead of just passing it to the priest before communion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacramental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                                        "entry_id": "48eec65c-0125-3a96-97bc-ae9905452b46",
                                        "glosses": [
                                            "An object (such as holy water or a crucifix) or an action (such as making the sign of the cross) which is regarded as encouraging devotion and thus spiritually aiding the person who uses it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898adedb-8164-4178-99f5-dc15e211e035",
                                                "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                                                "text": "But under the twofold pressure of solafideism’s rejection of \"good works\" for the sake of merit and sola scriptura’s denial of anything not explicitly mentioned in the Bible, sacramentals such as images, relics, blessings, and pilgrimages became the objects of the dissenters' most bitter condemnation and scorn."
                                            },
                                            {
                                                "example_id": "c3183a75-bfd9-46d1-86fe-3689e92dc3ef",
                                                "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                                                "text": "The Sacramentals.\nBesides the holy sacraments there are things which the Church blesses in order that by the pious use of them the Christian may obtain from God temporal benefits and spiritual health. Now as these things bear a certain resemblance to the sacraments, they are called sacramentals."
                                            },
                                            {
                                                "example_id": "8217fab4-9ce2-4d78-b317-074ab5f0ccb7",
                                                "sense_id": "23095f16-67a6-3082-bb19-3081e97160f4",
                                                "text": "The activities in this strategy immerse the young people in the many sacramentals that are part of the daily, weekly, and seasonal Catholic individual and communal religious expressions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c543679-5d5d-4d77-9a97-f871f8db3b6b",
                        "source_entry_id": "1aa82107-7484-34d1-a8a0-0d61f4f7f080",
                        "source_sense_id": "cc2781ae-7b4a-3e61-a294-1f8092655e97",
                        "target_lang_word": "sacramentel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacramentel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f349473f-8e11-3585-9bde-92f534bcddb8",
                                        "entry_id": "8e5aceab-6508-32e9-b4a9-07ed4bb55203",
                                        "glosses": [
                                            "Qui appartient à un sacrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278c6018-f5fe-41f2-aa9a-b7a90c0057f3",
                                                "sense_id": "f349473f-8e11-3585-9bde-92f534bcddb8",
                                                "text": "L'usage du chrémeau nous conduit ainsi naturellement à celui du bandeau de lin que les confirmands tiennent à la main en s'approchant du Pontife et dont on leur bande le front après l’onction sacramentelle."
                                            },
                                            {
                                                "example_id": "e557cb1c-c758-44b8-9004-bf38045f71ff",
                                                "sense_id": "f349473f-8e11-3585-9bde-92f534bcddb8",
                                                "text": "L’organisation catholique attache tous les « pouvoirs » sacramentels à l’ordination, et donc aux hommes, et ne donne aux femmes aucun rôle en la matière."
                                            },
                                            {
                                                "example_id": "53f614b6-8baf-4367-aa4c-8cd74e89e914",
                                                "sense_id": "f349473f-8e11-3585-9bde-92f534bcddb8",
                                                "text": "La viande cuite au soir des chasses avait elle aussi cette qualité presque sacramentelle, nous ramenait plus loin, aux origines sauvages des races."
                                            },
                                            {
                                                "example_id": "51472388-1a2c-433e-8906-5252adfff5bd",
                                                "sense_id": "f349473f-8e11-3585-9bde-92f534bcddb8",
                                                "text": "Il n’y a eu, du moins au départ, chez Marie, aucun calcul, aucune idée de chantage au mariage dans le rappel de mes pratiques chrétiennes et de mes habitudes sacramentelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee4223f-7e41-3c08-9784-2d0d01ddf6a5",
                                        "entry_id": "8e5aceab-6508-32e9-b4a9-07ed4bb55203",
                                        "glosses": [
                                            "Qualifie un mot qui est essentiel à la validité d’un acte ou d’une convention."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c50e8d45-b57a-4792-ae74-67f04f19ef81",
                                                "sense_id": "aee4223f-7e41-3c08-9784-2d0d01ddf6a5",
                                                "text": "C'est la manière sacramentelle et héroïque pour exprimer l'idée sublime dargent comptant."
                                            },
                                            {
                                                "example_id": "5f4b9192-e5f4-4ce8-a114-13407b98e31d",
                                                "sense_id": "aee4223f-7e41-3c08-9784-2d0d01ddf6a5",
                                                "text": "Les femmes décidèrent que Lucien était parfaitement bien. Ce fut madame de Commercy qui prononça le mot sacramentel dans la partie de la salle qui était réservée à la plus haute noblesse."
                                            },
                                            {
                                                "example_id": "77720011-03c4-4f9b-88b3-c7028280f923",
                                                "sense_id": "aee4223f-7e41-3c08-9784-2d0d01ddf6a5",
                                                "text": "Le sacramentel « Allez, messieurs ! » fut prononcé."
                                            },
                                            {
                                                "example_id": "b86982e7-b488-4f3f-92b3-a815a4086691",
                                                "sense_id": "aee4223f-7e41-3c08-9784-2d0d01ddf6a5",
                                                "text": "Et peut-être croirez-vous bon d'y ajouter la phrase sacramentelle : « Tout ce que vous répondrez pourra être retenu contre vous », repartit l'étranger avec un peu d'ironie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5fad9c3-530a-337a-9706-58d9c29b843a",
                                        "entry_id": "8e5aceab-6508-32e9-b4a9-07ed4bb55203",
                                        "glosses": [
                                            "Qui ressemble à un sacrement par son caractère rituel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aee834ad-3d4d-4fe3-bc0a-303e8b220103",
                                                "sense_id": "d5fad9c3-530a-337a-9706-58d9c29b843a",
                                                "text": "Il regarda l’affiche, y vit une bande blanche au milieu de laquelle brillait ce mot sacramentel :\nRELÂCHE PAR INDISPOSITION."
                                            },
                                            {
                                                "example_id": "b10a6d44-e82f-490a-96a0-6675756d45c9",
                                                "sense_id": "d5fad9c3-530a-337a-9706-58d9c29b843a",
                                                "text": "Enfin, Baptiste ouvrit une porte à deux battants, et, majestueusement, il dit la phrase sacramentelle : — Madame est servie."
                                            },
                                            {
                                                "example_id": "8e8c1d58-332e-4347-8d94-3ae4b9825766",
                                                "sense_id": "d5fad9c3-530a-337a-9706-58d9c29b843a",
                                                "text": "Assis sur sa chaise dans la meilleure position pour s’épargner de la fatigue, il ne faisait pas le plus léger mouvement qui n’eût son utilité, et ses lèvres ne s’ouvraient que pour prononcer les mots sacramentels : « J’en demande, j’en refuse, le roi. »"
                                            },
                                            {
                                                "example_id": "fb618a5e-402c-4918-bbf1-ba0fe3b19d5d",
                                                "sense_id": "d5fad9c3-530a-337a-9706-58d9c29b843a",
                                                "text": "Jésus ! comme il ressemble à son papa ! Comme il vous ressemble, Jourgeot ! s’extasia-t-elle, la bouche en chose de poule, selon la sacramentelle formule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dd4117f-be72-4f9b-bbf6-44267bb437f3",
                        "source_entry_id": "1aa82107-7484-34d1-a8a0-0d61f4f7f080",
                        "source_sense_id": "cc2781ae-7b4a-3e61-a294-1f8092655e97",
                        "target_lang_word": "sacramental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacramental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7258ca4d-5c37-3b2f-91df-fb369d6d48a9",
                                        "entry_id": "feed9f66-6edf-3e0b-9403-ea6dac1f8cef",
                                        "glosses": [
                                            "Un des signes sensibles et sacrés institués par l’Église, qui ont une certaine analogie avec les sacrements et qui sont destinés à produire certains effets spirituels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ae427d-a1e2-41bb-9d7f-c9c35cca411a",
                                                "sense_id": "7258ca4d-5c37-3b2f-91df-fb369d6d48a9",
                                                "text": "Il est utile (mais pas forcément nécessaire) d'avoir également quelques sacramentaux à disposition : eau et sel exorcisés, ou huile bénite pour des onctions."
                                            },
                                            {
                                                "example_id": "019879b5-50db-4df4-913f-db868eb75f8e",
                                                "sense_id": "7258ca4d-5c37-3b2f-91df-fb369d6d48a9",
                                                "text": "Cela ressort de la définition du sacramental donnée par le concile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacramental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80553fd7-7762-3b6d-961c-f1db9f2e1e7a",
                                        "entry_id": "004474ed-8c5a-3eb8-8bc6-13b12f3d93c5",
                                        "glosses": [
                                            "Variante de sacramentel."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc7c9ac2-9730-40a1-8d1e-01d03e602667",
                                                "sense_id": "80553fd7-7762-3b6d-961c-f1db9f2e1e7a",
                                                "text": "[À Londres, aux Communes], le président et les secrétaires seuls portaient la robe de soie et la perruque sacramentale de laine grise à deux ou trois boudins."
                                            },
                                            {
                                                "example_id": "c0a14992-625c-45ae-ba43-079794e593ce",
                                                "sense_id": "80553fd7-7762-3b6d-961c-f1db9f2e1e7a",
                                                "text": "Celui-ci, apoplectique, bredouillant des borborygmes, réussit enfin à retrouver son souffle pour dire à mon témoin le sacramental : « Veuillez reprendre votre place », parmi les rires même pas étouffés de l’assistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce604e75-42e8-4661-8afc-60d529a752a9",
