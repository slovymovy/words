                            {
                                "target_word": "gletsjerspleet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f6cfb303-58b2-36a1-8bac-75bcc149de4d",
                                        "entry_id": "c8c9a589-5385-3a23-b4a4-4b0e647108da",
                                        "glosses": [
                                            "verticale splijting van een gletsjer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20c3254-77ad-4052-bb38-a9bbf2b14466",
                                                "sense_id": "f6cfb303-58b2-36a1-8bac-75bcc149de4d",
                                                "text": "In Nieuw-Zeeland is een helikopter met zeven mensen aan boord neergestort op een gletsjer. Het wrak ligt in een gletsjerspleet. Alle inzittenden zijn om het leven gekomen. Behalve de piloot waren dat toeristen. De politie van Nieuw-Zeeland zegt dat het gaat om twee Australiërs en vier Britten."
                                            },
                                            {
                                                "example_id": "dde73c26-3acd-46b2-a264-25a47aab309a",
                                                "sense_id": "f6cfb303-58b2-36a1-8bac-75bcc149de4d",
                                                "text": "Het succes wordt overschaduwd door de dood van een Nederlands lid van het team. Martijn Seuren maakte op 22 juli een val tijdens een beklimming in het Mont Blanc-gebied. Hulpverleners vonden zijn lichaam 300 meter lager in een gletsjerspleet. Seuren had zich ten doel gesteld als eerste Nederlander alle 82 'vierduizenders' in de Alpen te beklimmen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a0ab901-3e9b-4f4c-9480-3b5475cddbb5",
                        "source_entry_id": "46709798-5537-363c-8af4-616bbbf9f489",
                        "source_sense_id": "5ccadb56-f675-3d10-be64-594eb88dc245",
