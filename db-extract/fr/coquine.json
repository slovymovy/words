                        "sense_id": "145b1a7e-fd08-31ac-bb42-286955a467bd",
                        "entry_id": "77fbebca-7c63-3b5a-8b5c-3fa99f1ab2b1",
                        "glosses": [
                            "Féminin singulier de coquin."
