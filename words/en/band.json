                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strip_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers <w>band</w> the birds' legs to track their migration patterns.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>кольцуют</w> лапы птиц, чтобы отслеживать пути их миграции.",
                                "zh": "研究人员给鸟类的腿<w>套环</w>以追踪它们的迁徙模式。"
                            }
                        },
                        {
                            "text": "The old wooden chest was <w>banded</w> with iron straps for durability.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный сундук был <w>окован</w> железными полосами для прочности.",
                                "zh": "为了耐用，这个旧木箱被铁条<w>箍</w>了起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tag",
                        "mark",
                        "ring",
                        "strap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикреплять полоску или кольцо к чему-либо, часто для идентификации или укрепления.",
                        "zh": "在某物上附加条状物或环，通常用于识别或加固。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кольцева́ть",
                                "target_lang_sense_clarification": "птиц"
                            },
                            {
                                "target_lang_word": "оковы́вать",
                                "target_lang_sense_clarification": "металлом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "套环",
                                "target_lang_sense_clarification": "给动物戴上环"
                            },
                            {
                                "target_lang_word": "箍",
                                "target_lang_sense_clarification": "用金属条加固"
                            }
                        ]
                    }
                }
            ]
        },
