                        "examples": [
                            {
                                "example_id": "7db98ecf-7bd7-4477-a6b7-ca09c1feb7c3",
                                "sense_id": "1a8f8159-b28a-3ee3-8386-c9f05db5f27f",
                                "text": "Die Schubspannungen sind - wie bei laminaren Wasserströmungen - die auf die Flächeneinheit bezogenen Reibungskräfte."
                            },
                            {
                                "example_id": "d8acfa9b-3f7e-458b-a244-ccd1a32b12e9",
                                "sense_id": "1a8f8159-b28a-3ee3-8386-c9f05db5f27f",
                                "text": "Die Schubspannung ist eine Funktion der Windgeschwindigkeit in größerer Höhe und der Rauhigkeit der Bodenoberfläche."
                            }
                        ],
