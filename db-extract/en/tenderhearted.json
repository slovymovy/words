                        "glosses": [
                            "Compassionate for another's distress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36fe3ae8-5dae-49f0-b2e2-b746e402c481",
                                "sense_id": "40b8d885-6b0a-3038-9e2e-efb54f2c070c",
                                "text": "I am tender-hearted by nature, and have found my eyes moist many a time over the scream of a wounded hare."
                            },
                            {
                                "example_id": "1be3904d-9cf1-4f05-9006-768af3408a7c",
                                "sense_id": "40b8d885-6b0a-3038-9e2e-efb54f2c070c",
                                "text": "The other patients in the ward, all but the Texan, shrank from him with a tenderhearted aversion from the moment they set eyes on him the morning after the night he had been sneaked in."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e2a04f2-a1dd-3100-a06e-718d2c4a500e",
