                "senses": [
                    {
                        "sense_id": "5026045d-ad9c-3cdd-aa01-b3c72443de37",
                        "entry_id": "cd27aaeb-c7df-3146-adb7-24449e478b76",
                        "glosses": [
                            "(gut- oder bösgläubiger) unmittelbarer oder mittelbarer Besitz an einer Sache mit dem natürlichen Willen, sie als Eigentümer zu besitzen, wobei es auf die tatsächliche Eigentumslage nicht ankommt"
                        ],
                        "tags": [
                            "deutsches Sachenrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "1668be28-e207-4036-88d2-a5d420eff878",
                                "sense_id": "5026045d-ad9c-3cdd-aa01-b3c72443de37",
                                "text": "Der Wagen befand sich im Eigenbesitz von Herrn Tschetzke, obwohl er ihn von jemandem gekauft hatte, der ihm kein Eigentum verschaffen konnte."
                            },
                            {
                                "example_id": "e621f5e8-5326-4317-bd8d-df2fc264b26d",
                                "sense_id": "5026045d-ad9c-3cdd-aa01-b3c72443de37",
                                "text": "„Eigenbesitz und Fremdbesitz werden besitzrechtlich gleichbehandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
