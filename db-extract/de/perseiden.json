                "senses": [
                    {
                        "sense_id": "9bf92d69-8e94-33be-a069-cdd7adbbf196",
                        "entry_id": "60ff0acb-0c37-3e8c-bcb4-1480822924ab",
                        "glosses": [
                            "jährlich im Juli und August zu beobachtender Meteorschauer, dessen scheinbarer Ursprung (Radiant) im Sternbild Perseus liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9fa7ae-081f-4d3b-a5b7-2cc3a8425c11",
                                "sense_id": "9bf92d69-8e94-33be-a069-cdd7adbbf196",
                                "text": "„Die erste nachgewiesene Beobachtung der Perseiden gelang in China vor rund 2000 Jahren.“"
                            },
                            {
                                "example_id": "2827cc4d-6f6a-4584-b276-a97ca8d1fe28",
                                "sense_id": "9bf92d69-8e94-33be-a069-cdd7adbbf196",
                                "text": "Dieses Datum sollten Sternschnuppen-Jäger immer im Kalender vermerkt haben: die Nacht vom 12. auf den 13. August. In dieser Nacht flitzen hunderte Perseiden über den Himmel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
