                    "sense_id": "69388511-26b6-3385-94dc-56698e2fe900",
                    "sense_definition": "A family name or <w>surname</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous judge, Learned <w>Hand</w>, was known for his influential legal opinions.",
                            "target_lang_translations": {
                                "ru": "Знаменитый судья Лернед <w>Хэнд</w> был известен своими влиятельными юридическими заключениями."
                            }
                        },
                        {
                            "text": "We are visiting the <w>Hands</w> family this weekend for a barbecue.",
                            "target_lang_translations": {
                                "ru": "В эти выходные мы идем в гости к семье <w>Хэнд</w> на барбекю."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хэнд",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
