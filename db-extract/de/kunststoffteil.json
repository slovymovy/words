                ],
                "senses": [
                    {
                        "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                        "entry_id": "09d91bcb-8801-31f0-8f76-d025808708fd",
                        "glosses": [
                            "nicht näher beschriebener Gegenstand aus dem Material Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f207439-56e7-445e-8639-480ac9c00c19",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Dann wird die Druckform über dem Kunststoffteil in Druckposition gebracht, ohne dass zwischen dem Drucksieb und dem Kunststoffteil ein direkter Kontakt entsteht (Absprung, Druckformdistanz).“"
                            },
                            {
                                "example_id": "a15de6f6-1b52-4a54-93ee-e2eca6a1431c",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Hierbei wird anstelle von Druckfarbe eine dünne Prägefolie bestehend aus einer Trägerfolie aus Kunststoff und einer Prägefarbschicht mittels Druck und Wärme auf den auf das Kunststoffteil aufgebracht.“"
                            },
                            {
                                "example_id": "5d8c22ea-f55a-4513-948d-66171d2417a6",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Wir entwerfen und fertigen für Sie qualitativ hochwertige technische Kunststoffteile und Kunststoffspritzgußteile.“"
                            },
                            {
                                "example_id": "6b237b08-b92f-44ea-a0e2-2b8e470d3577",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Auf neusten Spritzgussmaschinen der Firma Arburg fertigen wir Kunststoffteile aller Art bis zu einem Schussgewicht von 200 Gramm.“"
                            },
                            {
                                "example_id": "5a40e507-2d6c-4dd8-9d78-a33bb9c70ef1",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Die Formen aus medizinischem Kunststoffspritzguss sind oft filigran und leicht – die Herstellung solcher Miniatur Kunststoffteile wird nur durch den Einsatz moderner Maschinen und natürlich mit einem eingespielten Team möglich.“"
                            },
                            {
                                "example_id": "d04a2019-8b16-4786-922d-59953376fe55",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Wenn die richtigen Reparaturlackprodukte korrekt angewendet werden, ist es möglich Kunststoffteile erfolgreich zu lackieren.“"
                            },
                            {
                                "example_id": "c95d07dc-0dca-42aa-9350-c316bdbf233d",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Zur Herstellung eines Kunststoffteils im Spritzgussverfahren wird eine Spritzgussform benötigt.“"
                            },
                            {
                                "example_id": "04dfad1a-5e9f-4040-b399-de6880d3ef1c",
                                "sense_id": "8438b7b8-ad01-30c6-98a4-27cbc3b7a1df",
                                "text": "„Nutzen Sie unsere Erfahrungen bei der Auslegung von galvanisierbaren Kunststoffteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
