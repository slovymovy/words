                ],
                "senses": [
                    {
                        "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                        "entry_id": "665d1af3-74a3-3734-b2b2-f444e01a17f6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4094c0a9-a531-4a14-96e4-f94c84e59492",
                                "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                                "text": "Frau Staehle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4cd620d4-38db-4884-b2cb-742df2d1c66b",
                                "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                                "text": "Herr Staehle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e0c8e183-815c-488a-9c17-0f5330362bb7",
                                "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                                "text": "Die Staehles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2adbf82e-1e64-4a8a-bec4-8cbcdc950a77",
                                "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                                "text": "Der Staehle trägt nie die Schals, die die Staehle ihm strickt."
                            },
                            {
                                "example_id": "1764dede-465a-4b9c-94ab-d512b6f2d149",
                                "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Staehle kommt, geht der Herr Staehle.“"
                            },
                            {
                                "example_id": "4350fc77-397d-41b1-bba8-5a9d5a940b96",
                                "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                                "text": "Staehle kommt und geht."
                            },
                            {
                                "example_id": "ac8aafc4-b34b-4c4f-b688-d77649653a84",
                                "sense_id": "4339ea3e-4458-3cf7-b799-88e565889265",
                                "text": "Staehles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
