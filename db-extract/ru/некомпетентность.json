                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f141d81-e409-3fe0-add5-8f0f5695b591",
                        "entry_id": "c935dde5-3fa1-3fa3-b389-a0adea6659e3",
                        "glosses": [
                            "свойство или состояние по значению прилагательного некомпетентный; отсутствие должных знаний, навыков, умений и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40b2084-d7bb-4655-9cb3-7be4b323bbf1",
                                "sense_id": "6f141d81-e409-3fe0-add5-8f0f5695b591",
                                "text": "Очевидная некомпетентность автора в деталях и пренебрежение правилами дискуссии, что научной, что теологической ставит под сомнение общую компетентность автора."
                            },
                            {
                                "example_id": "1746aaf5-5ada-490b-8a4a-ec53950a11ff",
                                "sense_id": "6f141d81-e409-3fe0-add5-8f0f5695b591",
                                "text": "Красин критиковал коммунистических и советских чиновников за некомпетентность."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e50b1c51-6b94-4d09-a479-d27313269c31",
                        "source_entry_id": "c935dde5-3fa1-3fa3-b389-a0adea6659e3",
                        "source_sense_id": "6f141d81-e409-3fe0-add5-8f0f5695b591",
                        "target_lang_word": "incompetence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incompetence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                        "entry_id": "a1c4bc9b-77ec-3e7a-8c7f-4015bb17ed40",
                                        "glosses": [
                                            "Inability to perform; lack of competence; ineptitude."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7f77d79-a925-484e-8f07-f0ff5bc90ffa",
                                                "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                                "text": "... at the head of a crew, too, chiefly made up of mongrel renegades, and castaways, and cannibals--morally enfeebled also, by the incompetence of mere unaided virtue or right-mindedness in Starbuck"
                                            },
                                            {
                                                "example_id": "385e0352-ebbf-4b20-9739-c967ac365621",
                                                "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                                "text": "Winston did not know why Withers had been disgraced. Perhaps it was for corruption or incompetence. Perhaps Big Brother was merely getting rid of a too-popular subordinate."
                                            },
                                            {
                                                "example_id": "1b0bb71f-3ee4-46fc-81ec-2b24a3e7e719",
                                                "sense_id": "5e2e5c53-0f32-34dc-a307-c85312c06b5a",
                                                "text": "The factory where she worked was a poisonous mass of incompetence, favoritism, and sabotage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3495a24-1aaf-4d13-b723-38bcce87a765",
                        "source_entry_id": "c935dde5-3fa1-3fa3-b389-a0adea6659e3",
                        "source_sense_id": "6f141d81-e409-3fe0-add5-8f0f5695b591",
                        "target_lang_word": "Inkompetenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inkompetenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb1bdafb-9fde-31eb-9c34-2cabf8df1691",
                                        "entry_id": "d2e8b1ca-245b-3c6a-8060-3067dbb3059b",
                                        "glosses": [
                                            "mangelnde Fähigkeiten und Kenntnisse oder Befugnisse, fehlende Kompetenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3358b288-3ed8-44d0-9376-8489933ee7df",
                                                "sense_id": "fb1bdafb-9fde-31eb-9c34-2cabf8df1691",
                                                "text": "Der neue Kollege ist die Inkompetenz in Person. Der kann fast gar nichts."
                                            },
                                            {
                                                "example_id": "a2541bbc-947c-4eee-8f7f-2af473eedff0",
                                                "sense_id": "fb1bdafb-9fde-31eb-9c34-2cabf8df1691",
                                                "text": "„Eigentlich war Hamid für die Navigation zuständig, aber ich bemerkte, dass der Kartograf in Jacques seine offensichtliche Inkompetenz nicht länger mitansehen konnte.“"
                                            },
                                            {
                                                "example_id": "8f806b6b-b6b2-4dcb-bb48-b88e4901f590",
                                                "sense_id": "fb1bdafb-9fde-31eb-9c34-2cabf8df1691",
                                                "text": "„Die tief verwurzelte Hassliebe zu Berlin wechselt sich mit Wut und Verzweiflung ab, wenn im Bürgeramt die Blüten des Verwaltungschaos spriessen: Inkompetenz und Unzuständigkeit, wohin man blickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
