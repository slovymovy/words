                                            {
                                                "example_id": "cfaf793f-c0b5-48ea-b12b-90402f422f8e",
                                                "sense_id": "f4f15caa-bca9-3858-a341-a85ea107fee6",
                                                "text": "Ik had maar een paar kleine hartentjes voor je, partner; daarom heb ik gepast."
                                            }
