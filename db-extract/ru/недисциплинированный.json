                                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                                        "glosses": [
                                            "Not in order; marked by disorder or disarray."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96760ebc-e047-4f01-a02d-96203709849b",
                                                "sense_id": "bbdbb6cc-b0aa-3dbe-94ea-40b5747bb52e",
                                                "text": "The books and papers are in a disorderly state."
                                            },
                                            {
                                                "example_id": "a008a4ed-0144-4222-96fc-2e9ef6367374",
                                                "sense_id": "bbdbb6cc-b0aa-3dbe-94ea-40b5747bb52e",
                                                "text": "This one is surmounted by a clock-tower with a bent weather-vane - the latter being the only disorderly object in sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c3c06ea-e469-37c7-b3c1-a2432cac9d1a",
                                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                                        "glosses": [
                                            "Not acting in an orderly way, as the functions of the body or mind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                                        "glosses": [
                                            "Not complying with the restraints of order and law; unruly; lawless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d56320a0-ce71-43ea-a222-3e3810775f6c",
                                                "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                                                "text": "disorderly people; disorderly assemblies"
                                            },
                                            {
                                                "example_id": "a2e57888-6e37-4fa3-abda-209d5b70e348",
                                                "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                                                "text": "The teacher sat at one end of the bench, with a meek little fellow by his side. When the others were disorderly, this young martyr received a rap; intended, probably, as a sample of what the rest might expect, if they didn't amend."
                                            },
                                            {
                                                "example_id": "a4486a46-1319-4ee6-831a-ab804246f81e",
                                                "sense_id": "41ed1fda-2870-33cf-9915-bae2664fe269",
                                                "text": "The Uganda Police Force described the planned protests as “potentially anarchic” in a statement on Monday, warning it “shall not tolerate disorderly conduct.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "539c14b3-e2f8-363a-ba4b-1a7b1d82937c",
                                        "entry_id": "55f19efb-2682-3d77-abbd-df3cf50e0639",
                                        "glosses": [
                                            "Offensive to good morals and public decency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b25779a2-7e02-4f71-baf7-28d23268d54e",
                                                "sense_id": "539c14b3-e2f8-363a-ba4b-1a7b1d82937c",
                                                "text": "a disorderly house"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disorderly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ef7da4-0c5f-3b30-a933-984efbc1c0bc",
                                        "entry_id": "1d84ac3a-5463-3dac-8a66-7a98a8066fcc",
                                        "glosses": [
                                            "A person who acts in a disorderly manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733d2b70-cc20-4ed6-9e7f-d4bb9d44c8ab",
                                                "sense_id": "f9ef7da4-0c5f-3b30-a933-984efbc1c0bc",
                                                "text": "The police are allowed one shilling a-head upon all disorderlies who are discharged by the magistrates upon payment of expenses. The number so discharged are about a third of the number in custody."
                                            }
                                        ]
                                    }
                                ]
                            },
