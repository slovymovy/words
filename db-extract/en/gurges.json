                    {
                        "sense_id": "46e348e5-2a52-3453-85c2-4adb19d4aebb",
                        "entry_id": "20741245-2490-3a52-9af8-2d9ea969e4d6",
                        "glosses": [
                            "A whirlpool."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ab59973b-02f3-4544-9db7-806e65c8794b",
                                "sense_id": "46e348e5-2a52-3453-85c2-4adb19d4aebb",
                                "text": "It was early—only ten p.m.—but already gurgeses of light and gales of sound frothed in unison to a familiar relentless heartbeat."
                            }
                        ]
                    },
                    {
                        "sense_id": "a822081a-b029-3bed-bf00-7a3795f9372c",
                        "entry_id": "20741245-2490-3a52-9af8-2d9ea969e4d6",
                        "glosses": [
                            "A series of typically four to six concentric annulets (in early heraldry, from at least the 1200s), or a spiralling line from the centre to the edge of the shield (in late heraldry); a stylized whirlpool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95bd1695-622b-40cc-abb9-a87be7d180f6",
                                "sense_id": "a822081a-b029-3bed-bf00-7a3795f9372c",
                                "text": "Argent, a gurges azure, is borne by GORGES, of Langford, Wilts., created a Baronet 1612. As the gurges (like the fountain) represents water, argent and azure are its proper tinctures."
                            },
                            {
                                "example_id": "050fc4fe-2a01-4c9c-a1d1-a00253a53a0c",
                                "sense_id": "a822081a-b029-3bed-bf00-7a3795f9372c",
                                "text": "A shield of arms of early shape : three gurgeses (or roundles charged with a central pellet and two annulets concentric), two and one."
                            }
                        ]
                    }
