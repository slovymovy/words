                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5d125470-4db1-3e7f-80d9-4788cd35637a",
                        "entry_id": "a1561743-a31e-3f5f-aff9-712559d29d29",
                        "glosses": [
                            "A sailor."
