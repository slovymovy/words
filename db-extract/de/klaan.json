                "senses": [
                    {
                        "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                        "entry_id": "27d9a64d-df6c-3443-b075-25773a1884bf",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35084065-55bd-4d9f-b10b-a519268e51e2",
                                "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                                "text": "Frau Klaan ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5d73a960-0a25-4823-9224-643e5175a3ec",
                                "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                                "text": "Herr Klaan wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "abec4e7b-0ad3-4115-a7fa-076fd32f58e7",
                                "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                                "text": "Die Klaans fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "affc2656-9a03-49db-a5dd-5a29f8b75ab3",
                                "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                                "text": "Der Klaan trägt nie die Pullover, die die Klaan ihm strickt."
                            },
                            {
                                "example_id": "6dbdde73-fc6f-4132-a30a-d5429499d3b4",
                                "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Klaan kommt, geht der Herr Klaan.“"
                            },
                            {
                                "example_id": "a66da36d-5bd6-42c3-8da7-5be7d74a5c7f",
                                "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                                "text": "Klaan kommt und geht."
                            },
                            {
                                "example_id": "2ea5e6e1-d506-473d-afd7-fcb9c40e5688",
                                "sense_id": "38d9e285-f6c2-3c08-9cc5-a170563f0d1f",
                                "text": "Klaans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
