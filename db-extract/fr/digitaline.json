                "senses": [
                    {
                        "sense_id": "32d4bdcb-b9a6-3b88-aee3-abdf7803781d",
                        "entry_id": "b4a2ffb9-96cf-39f1-b1ce-ce5942b77bb7",
                        "glosses": [
                            "Hétéroside cardiotonique extrait de la digitale pourprée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ce3e908-3dc4-4b60-9788-1f98c7e19203",
                                "sense_id": "32d4bdcb-b9a6-3b88-aee3-abdf7803781d",
                                "text": "Le lupulin fut prescrit, concurremment avec la digitaline et quelques autres moyens appropriés aux circonstances."
                            },
                            {
                                "example_id": "7689ad93-0ca8-4316-b650-65cc8f81ff8d",
                                "sense_id": "32d4bdcb-b9a6-3b88-aee3-abdf7803781d",
                                "text": "Darquey, le pharmacien, lui avait montré deux de ses ordonnances falsifiées : à la première une main criminelle avait ajouté : Liqueur de Fowler ; sur l’autre figuraient d’assez fortes doses de chloroforme, de digitaline, d’aconitine."
                            },
                            {
                                "example_id": "f8d12d41-382f-4498-9cc2-b91339af1049",
                                "sense_id": "32d4bdcb-b9a6-3b88-aee3-abdf7803781d",
                                "text": "J’apprends que la digitaline est un hétéroside très toxique qui produit un accroissement de l’amplitude des battements du cœur, un ralentissement du rythme cardiaque, une diminution de l’excitabilité du myocarde et de la conductibilité auriculo-ventriculaire."
                            }
                        ]
                    }
                ],
