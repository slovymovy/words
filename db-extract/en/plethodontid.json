                                "example_id": "a9120c7c-1351-42b0-9570-af6ca3eb21c6",
                                "sense_id": "ddcc342b-a666-3548-b895-8ffbec6e0cc9",
                                "text": "The family of salamanders known as plethodontids are unusual in many ways."
                            },
                            {
                                "example_id": "aa8ba5a4-bbef-4c2d-b0f0-0602c165a422",
                                "sense_id": "ddcc342b-a666-3548-b895-8ffbec6e0cc9",
                                "text": "In Mark Twain National Forest in Missouri, for example, they are—if you count them by weight—the dominant form of life, with 1400 tonnes of plethodontids lurking in the leaf litter and wetlands of its 600,000 hectares."
                            }
                        ]
