                    },
                    {
                        "translation_id": "7f550214-7c91-4b72-bf25-547d3fa66a7e",
                        "source_entry_id": "82280809-1fb5-309d-b58d-a8acb7583354",
                        "source_sense_id": "5408e53d-6e71-33bf-87dd-0dc24a9f7ec2",
                        "target_lang_word": "buée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc6c1c0-7a6e-3f2c-9f44-ae6828da3c69",
                                        "entry_id": "f3efc726-cd8d-3225-adad-374a80875380",
                                        "glosses": [
                                            "Lessive."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b57aaf6-b875-4121-8454-c3f513d503bd",
                                                "sense_id": "cbc6c1c0-7a6e-3f2c-9f44-ae6828da3c69",
                                                "text": "Et affin de vous descouvrir l’industrie de ce bon Escossois, il trouva fasson d’apprendre a blanchir les draps linges,(…). Il demouroit bien souvent, a cause de faire la buee, ung jour et deux jours, es maisons dessus dictes ; et le faisoit on coucher avecques la chambriere et aucunes foiz avecques sa fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71791330-b60a-3b18-9097-df36a1ac5a7e",
                                        "entry_id": "f3efc726-cd8d-3225-adad-374a80875380",
                                        "glosses": [
                                            "Vapeur de la pâte du pain."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4625c5e8-56af-383b-9160-cccbaaaa23ec",
                                        "entry_id": "f3efc726-cd8d-3225-adad-374a80875380",
                                        "glosses": [
                                            "Vapeur d’eau condensée en gouttelettes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc64589-1b56-4274-b3a2-f849aeefd613",
                                                "sense_id": "4625c5e8-56af-383b-9160-cccbaaaa23ec",
                                                "text": "Cinq ou six grabats se touchant, dans l'unique pièce où les buées d'une lessive répandaient leur tiédeur acide […]."
                                            },
                                            {
                                                "example_id": "26d470ee-b582-4dd5-be47-4d14726f1a80",
                                                "sense_id": "4625c5e8-56af-383b-9160-cccbaaaa23ec",
                                                "text": "Lino est apparu par la porte d'entrée, en se frottant les mains l'une contre l'autre pour les réchauffer. De la buée sortait de sa bouche à chacune de ses respirations."
                                            },
                                            {
                                                "example_id": "f5c66e01-c405-4c5e-b102-892772cc098f",
                                                "sense_id": "4625c5e8-56af-383b-9160-cccbaaaa23ec",
                                                "text": "— […] et le Démon profite de cette accalmie pour entrer en scène.\nIl lui apparaît sous des formes belliqueuses de monstres, casse tout, fuit, en s’effumant dans des buées puantes ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c8eac0-fb8e-3e9d-932f-4f68c984485c",
                                        "entry_id": "f3efc726-cd8d-3225-adad-374a80875380",
                                        "glosses": [
                                            "Type de grandes cruches ou vases à anses, en terre cuite ou en laiton, entre le XVIIe et le milieu du XVIIIe siècle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d897f33-4aca-3558-b93f-d2c758b4a683",
                                        "entry_id": "f3efc726-cd8d-3225-adad-374a80875380",
                                        "glosses": [
                                            "Chose légère, évanescente."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4daadf3a-e2b7-4ec3-bd9e-d912478a3261",
                                                "sense_id": "8d897f33-4aca-3558-b93f-d2c758b4a683",
                                                "text": "Marylène déballa ses deux grosses valises en maugréant. Elle en sortit ses petites robes diaphanes et autres buées vestimentaires, les déplia devant Pomme, et puis les jeta sur le lit dans un geste de répudiation malheureuse : « Je ne pourrai jamais mettre ça !… ça non plus… tiens ! et ça, tu me vois avec ça, ici ? »"
                                            }
                                        ]
                                    }
                                ]
                            },
