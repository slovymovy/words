                            },
                            {
                                "target_lang_word": "profiter de",
                                "target_lang_sense_clarification": "tirer un avantage de"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3dd169b-deb1-31ab-919c-b0eced072227",
                    "sense_definition": "Kunnen verdragen of accepteren (meestal met 'kunnen').",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolerance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan zijn arrogante gedrag echt niet <hebben>.",
                            "target_lang_translations": {
                                "en": "I really cannot <stand> his arrogant behavior.",
                                "ru": "Я действительно не могу <терпеть> его высокомерное поведение.",
                                "fr": "Je ne peux vraiment pas <w>supporter</w> son comportement arrogant."
                            }
                        },
                        {
                            "text": "Die extra vertraging kunnen we er nu niet bij <hebben>.",
                            "target_lang_translations": {
                                "en": "We cannot <have> that extra delay right now.",
                                "ru": "Мы сейчас не можем <позволить> себе эту дополнительную задержку.",
                                "fr": "Nous ne pouvons pas nous <w>permettre</w> ce retard supplémentaire en ce moment."
                            }
