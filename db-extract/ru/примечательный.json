                    }
                ],
                "translations": [
                    {
                        "translation_id": "31d17491-4982-4b50-a1f1-4996fa6d4a53",
                        "source_entry_id": "816ce73d-77a2-328a-8740-fc6911ba33a2",
                        "target_lang_word": "notable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "856cf2f3-f0cf-3476-84f0-4413d6dc0d44",
                                        "entry_id": "c62ead1c-2bea-39f4-97f9-a168dc52dc07",
                                        "glosses": [
                                            "Worthy of note; remarkable; memorable; noted or distinguished."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6eb5f15-26e9-4f4b-9ccf-c400b15e1f87",
                                                "sense_id": "856cf2f3-f0cf-3476-84f0-4413d6dc0d44",
                                                "text": "[...] how sayest thou, that my master is become a notable lover?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "484ebf8f-6a14-3042-a0ac-0f575b540e4e",
                                        "entry_id": "c62ead1c-2bea-39f4-97f9-a168dc52dc07",
                                        "glosses": [
                                            "Easily noted (without connotations of value); clearly noticeable, conspicuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e032fd7-c49d-4201-b9bd-04941efe454f",
                                                "sense_id": "484ebf8f-6a14-3042-a0ac-0f575b540e4e",
                                                "text": "A notable lubber, as thou reportest him to be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d58ac6a3-866f-36da-bc3e-55295962cdff",
                                        "entry_id": "c62ead1c-2bea-39f4-97f9-a168dc52dc07",
                                        "glosses": [
                                            "That can be observed; perceptible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45fd5d56-8056-4cfa-8b28-638463d3f578",
                                                "sense_id": "d58ac6a3-866f-36da-bc3e-55295962cdff",
                                                "text": "Dyslexia is most notable in children who are unable to focus on their assignments."
                                            },
                                            {
                                                "example_id": "6d6c0c53-2d82-42e9-9d25-37f7e0481253",
                                                "sense_id": "d58ac6a3-866f-36da-bc3e-55295962cdff",
                                                "text": "Another most notable change concerns rolling stock liveries. Back then, corporate Rail Blue was omnipresent, whereas now there is a kaleidoscope of colours and styles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70445796-6f81-32ef-acdc-82aca69d47aa",
                                        "entry_id": "c62ead1c-2bea-39f4-97f9-a168dc52dc07",
                                        "glosses": [
                                            "Industrious, energetic; (specifically) (usually of a woman) capable, efficient in household management."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "660ca839-df0a-47b4-9548-939230c28e47",
                                                "sense_id": "70445796-6f81-32ef-acdc-82aca69d47aa",
                                                "text": "During his residence abroad, his concerns at home were managed by his mother Hester, an active and notable woman."
                                            },
                                            {
                                                "example_id": "293e4c00-ec90-4a67-b025-35d0160c4f84",
                                                "sense_id": "70445796-6f81-32ef-acdc-82aca69d47aa",
                                                "text": "Hester looked busy and notable with her gown pinned up behind her, and her hair all tucked away under a clean linen cap; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf93c995-0cd6-308f-8e0e-f462e236d058",
                                        "entry_id": "c62ead1c-2bea-39f4-97f9-a168dc52dc07",
                                        "glosses": [
                                            "Useful; profitable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c3967f-9e97-40f0-88d2-f1f9bfd513c5",
                                                "sense_id": "bf93c995-0cd6-308f-8e0e-f462e236d058",
                                                "text": "Your honourable Uncle Sir Robert Manſell, who is now in the Mediterranean, hath been very notable to me, and I ſhall ever acknowledge a good part of my education from him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "notable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82ad2a3d-bee7-3c46-aea3-200b05f6661d",
                                        "entry_id": "44588445-949a-3e44-9a85-fef96425b572",
                                        "glosses": [
                                            "A person or thing of distinction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a0cf2a6-5543-446b-9545-d213c120b365",
                                                "sense_id": "82ad2a3d-bee7-3c46-aea3-200b05f6661d",
                                                "text": "July 16 1875, Carl Schurz, letter to W. M. Grosvenor\nWhat we ought to have, in my opinion, is a meeting of notables—men whose names will be of weight with the country and who can be depended upon to agree to an independent course."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1180f1d-5c08-4992-ad8c-9409b7c02299",
                        "source_entry_id": "816ce73d-77a2-328a-8740-fc6911ba33a2",
                        "target_lang_word": "noteworthy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noteworthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc414d89-d8d5-36f0-a087-8c8b42265cc3",
                                        "entry_id": "0e9fdd8e-0c88-3ffd-8046-2020e61729b7",
                                        "glosses": [
                                            "Deserving attention; notable; worthy of notice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443b03d3-cf93-44a1-93bd-680c43db34e2",
                                                "sense_id": "dc414d89-d8d5-36f0-a087-8c8b42265cc3",
                                                "text": "Zukertort represent the other most noteworthy tournaments."
                                            },
                                            {
                                                "example_id": "8164198c-c918-41f5-b242-5fbebd72d163",
                                                "sense_id": "dc414d89-d8d5-36f0-a087-8c8b42265cc3",
                                                "text": "Yet Hodgson’s men played with wonderful control. Their young full-backs, Luke Shaw and Nathaniel Clyne, epitomised their composure and Fraser Forster had to make only one noteworthy save before Andy Robertson’s goal, seven minutes from the end of time, temporarily threatened a winning position."
                                            },
                                            {
                                                "example_id": "eac88966-be5f-4cb2-a6c3-016dec5307ce",
                                                "sense_id": "dc414d89-d8d5-36f0-a087-8c8b42265cc3",
                                                "text": "But instead, the distinctive ironwork and glass platform awnings have been carefully refurbished, while making them compatible with the overhead wiring. Kettering's island Platform 2/3 is especially noteworthy. Although it dates from 1879, when the station was enlarged to four platforms, the same original (1857) patterns for the delicate cast-ironwork seem to have been used - […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "noteworthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a6915c0-7e56-3648-b25b-df2db0b223fa",
                                        "entry_id": "b52a3316-8a05-3e3a-8879-2f590ecaba61",
                                        "glosses": [
                                            "A noteworthy person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ef9de8-5cbe-4bfd-953f-c2346e1627bc",
                                                "sense_id": "4a6915c0-7e56-3648-b25b-df2db0b223fa",
                                                "text": "One of the French Riviera’s most reliable characters is Charles Finch, a month-of-May migrant worker who jets in for the Cannes Film Festival, bunking up at the stately Hôtel du Cap with the show folk and other noteworthies who come primed to toast their outrageous fortune here with $40 Bellinis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
