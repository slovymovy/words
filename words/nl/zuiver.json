                    "synonyms": [
                        "puur",
                        "onbezoedeld",
                        "onvermengd",
                        "schoon"
                    ],
                    "antonyms": [
                        "onzuiver"
                    ],
                    "common_phrases": [
                        "zuiver water",
                        "zuiver goud",
                        "zuivere lucht"
                    ],
                    "target_lang_definitions": {
                        "en": "free from foreign substances or contamination",
                        "ru": "свободный от посторонних примесей или загрязнений"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pure",
