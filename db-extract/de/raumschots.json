                "senses": [
                    {
                        "sense_id": "2cabde98-51d4-325c-9a9a-93ea14abb3be",
                        "entry_id": "1d269aa1-8bee-3082-9ef2-cb2172642fc8",
                        "glosses": [
                            "von schräg achtern"
                        ],
                        "tags": [
                            "Segeln",
                            "Richtungsangabe über den Wind"
                        ],
                        "examples": [
                            {
                                "example_id": "e2f4f25e-06f3-46b9-828c-2e596db0c382",
                                "sense_id": "2cabde98-51d4-325c-9a9a-93ea14abb3be",
                                "text": "Bei Wind von achtern – raumschots – werden die Gaffelsegel mit abgefiertem Baum und die Raasegel gesetzt."
                            },
                            {
                                "example_id": "ff2cf97e-efec-4c5b-9be9-5c6ccba993fa",
                                "sense_id": "2cabde98-51d4-325c-9a9a-93ea14abb3be",
                                "text": "Auf einem Raumschots- oder Raumwindkurs fällt der scheinbare Wind „schräg von hinten kommend“, seemännisch ausgedrückt: achterlicher als querab, ein."
                            },
                            {
                                "example_id": "0ccbfc56-8544-4b2d-b0d9-8960390b6cc9",
                                "sense_id": "2cabde98-51d4-325c-9a9a-93ea14abb3be",
                                "text": "Bei raumschots sind die Schoten gefiert und der Wind kann \"voll\" in die Segel wehen."
                            },
                            {
                                "example_id": "73b377a2-5866-4438-9634-7bf207f6011c",
                                "sense_id": "2cabde98-51d4-325c-9a9a-93ea14abb3be",
                                "text": "Bei einem kräftigen Nordwest rauschen wir weiter raumschots mit weit aufgefierten Segeln durch die Ägäis."
                            },
                            {
                                "example_id": "ea502b73-74d3-4942-8dd6-9edbc7383b62",
                                "sense_id": "2cabde98-51d4-325c-9a9a-93ea14abb3be",
                                "text": "Nach dem Seestraßenrecht hat auszuweichen: von zwei Seglern: der vor Wind segelnde den raumschots und am Winde segelnden."
                            },
                            {
                                "example_id": "52df4b82-c2bc-4337-9b2f-dc7caec39c1c",
                                "sense_id": "2cabde98-51d4-325c-9a9a-93ea14abb3be",
                                "text": "Wollte der Caliban nach Luv, so ging die Miranda nach Lee herum, und fiel der Caliban ab vom Winde, so drehte die Miranda durch den Wind, bis sie ihn raumschots hatte, so daß sich die Schiffe umeinander im Kreise bewegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
