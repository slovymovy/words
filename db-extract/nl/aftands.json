                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "57c29f97-6bb1-3da5-96da-d2a433436b4f",
                        "entry_id": "f5dc978f-213c-3ddf-b70e-fe69bd230657",
                        "glosses": [
                            "versleten, smerig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8344cfb7-1727-47e5-a92c-37ea4c1b5cbe",
                                "sense_id": "57c29f97-6bb1-3da5-96da-d2a433436b4f",
                                "text": "Het aftandse huis werd vorig jaar gesloopt."
                            },
                            {
                                "example_id": "8f6f7442-efd7-47f0-88fd-dc4e7b49c918",
                                "sense_id": "57c29f97-6bb1-3da5-96da-d2a433436b4f",
                                "text": "Het andere deel diende als bar: een niet al te wanstaltige kruising tussen een ouderwets bordeel en een aftands drankhol langs een of andere snelweg, waar het interieur zonder enig plan een jarenlang vergaren is van doorleefd meubilair en portretten van de uitbundige feestjes aan de muur."
                            }
                        ]
                    }
