                "senses": [
                    {
                        "sense_id": "3f6572ae-5afb-3707-af39-e74b933386f9",
                        "entry_id": "2d189972-e099-31a2-a306-90c9c9908661",
                        "glosses": [
                            "Répartir les matelots sept par sept pour manger au même plat."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "76bf4fb2-c19b-356f-94d6-3522661b1515",
                        "entry_id": "2d189972-e099-31a2-a306-90c9c9908661",
                        "glosses": [
                            "Boire (en particulier des verres de vin)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd7508b-2aac-4e02-9f61-7daa63bea275",
                                "sense_id": "76bf4fb2-c19b-356f-94d6-3522661b1515",
                                "text": "Le vin venu de la vallée du Rhône coula gaiement et Prosper ne fut pas le dernier à « aplater des canons »."
                            },
                            {
                                "example_id": "1064ec7b-6073-4b6d-ae60-376cdb94513e",
                                "sense_id": "76bf4fb2-c19b-356f-94d6-3522661b1515",
                                "text": "Elle avait les manches troussées, hiver comme bon temps, la voix forte et la gueule aussi; et elle savait aplater un canon comme un homme."
                            }
                        ]
                    }
