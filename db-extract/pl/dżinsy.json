                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6cc32eb-d666-3648-a395-76d86965839b",
                                        "entry_id": "41513a9f-52fa-386a-a1fd-1035cd4bdf07",
                                        "glosses": [
                                            "Freizeithose aus blauem Baumwollstoff mit Nieten, saloppe Hose; Bluejeans"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a9b0a92-99ae-4110-8210-b64218bac74d",
                                                "sense_id": "b6cc32eb-d666-3648-a395-76d86965839b",
                                                "text": "Wieso hast du meine Jeans gebügelt?"
                                            },
                                            {
                                                "example_id": "035d3651-c26c-4ad8-8266-b193fae60b9a",
                                                "sense_id": "b6cc32eb-d666-3648-a395-76d86965839b",
                                                "text": "„Wenn es doch kalt wird, können Leggings unter einer Jeans getragen werden.“"
                                            },
                                            {
                                                "example_id": "2a7ce593-b48f-49f7-af2d-14ab1d92f445",
                                                "sense_id": "b6cc32eb-d666-3648-a395-76d86965839b",
                                                "text": "„James Dean trug in seinen Filmen Jeans.“"
                                            },
                                            {
                                                "example_id": "a396db43-d308-4e5b-bba9-7ce60c62e1be",
                                                "sense_id": "b6cc32eb-d666-3648-a395-76d86965839b",
                                                "text": "„Auch der frühere Tod einer Jeans, das Loch, wird aufwendig und so authentisch wie möglich in niet- und nagelneue Jeans geschnippelt.“"
                                            },
                                            {
                                                "example_id": "de49ae35-dce5-4708-bd73-9631cfa07dfc",
                                                "sense_id": "b6cc32eb-d666-3648-a395-76d86965839b",
                                                "text": "„Die zweiundvierzigjährige Nonne aus dem Dominikanerinnenorden ist Erziehungsleiterin in einem Bethanien-Kinderdorf und begrüßt mich ganz locker in Jeans und T-Shirt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c14d17c-3166-32fe-9677-b44a5fcaa26f",
                                        "entry_id": "41513a9f-52fa-386a-a1fd-1035cd4bdf07",
                                        "glosses": [
                                            "strapazierfähiges und haltbares Gewebe aus Baumwolle in Köperbindung, das zu Jeansbekleidung verarbeitet wird"
                                        ],
