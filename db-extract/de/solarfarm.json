                        "examples": [
                            {
                                "example_id": "2b77a02b-3eb5-47d5-8cab-57bd8a4d3418",
                                "sense_id": "6238241e-0f92-300c-bda1-94846aa27eea",
                                "text": "„Apple will sein neues US-Rechenzentrum mit einer riesigen Solarfarm mit Strom versorgen.“"
                            },
                            {
                                "example_id": "119c2987-166f-4ee4-bb4e-cbd3a3648ff5",
                                "sense_id": "6238241e-0f92-300c-bda1-94846aa27eea",
                                "text": "„In Chile haben wir dazu beigetragen, dass die erste industrielle Solarfarm gebaut wird.“"
                            },
                            {
                                "example_id": "3c9bab90-860f-4035-a574-c9faed703a4a",
                                "sense_id": "6238241e-0f92-300c-bda1-94846aa27eea",
                                "text": "„Er redet von Prepaid-Stromzählern und zwei Sätze später von einer Solarfarm, die nicht nur dem Camp nützen soll: In der ganzen Region sollen die Stromrechnungen sinken!“"
                            }
                        ],
