{
    "word_family": [
        "coordination",
        "coordinateur",
        "coordinatrice",
        "coordonnable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e69828d1-bc30-3263-b277-4ad8477af3b2",
                    "sense_definition": "Organiser et agencer différentes actions ou activités de manière cohérente pour atteindre un résultat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur doit <w>coordonner</w> les efforts de tous les services pour réussir le lancement."
                        },
                        {
                            "text": "Elle a réussi à <w>coordonner</w> les différentes étapes des travaux sans aucun retard."
                        }
                    ],
                    "synonyms": [
                        "organiser",
                        "harmoniser",
                        "synchroniser"
                    ],
                    "antonyms": [
                        "désorganiser"
                    ],
                    "common_phrases": [
                        "coordonner les efforts",
                        "coordonner un projet"
                    ]
                },
                {
                    "sense_id": "e9be31bd-d055-3d2f-826d-bd12c1c8633e",
                    "sense_definition": "S'organiser et agir ensemble de manière concertée et synchronisée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux équipes doivent se <w>coordonner</w> pour préparer la réunion de demain."
                        },
                        {
                            "text": "Nous nous <w>coordonnons</w> régulièrement afin d'éviter les doublons dans notre travail quotidien."
                        }
                    ],
                    "synonyms": [
                        "se concerter",
                        "s'entendre",
                        "s'accorder"
                    ],
                    "common_phrases": [
                        "se coordonner pour"
                    ]
                },
                {
                    "sense_id": "69a90703-30ea-373a-9de9-d5e8bdbf08f7",
                    "sense_definition": "Assortir des vêtements, des couleurs ou des éléments décoratifs pour créer un ensemble harmonieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esthétique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a choisi de <w>coordonner</w> les couleurs de sa chemise avec celles de son manteau."
                        },
                        {
                            "text": "Cette décoratrice sait parfaitement <w>coordonner</w> les motifs des rideaux avec ceux des coussins."
                        }
                    ],
                    "synonyms": [
                        "assortir",
                        "harmoniser"
                    ],
                    "antonyms": [
                        "dépareiller"
                    ],
                    "common_phrases": [
                        "coordonner les couleurs"
                    ]
                },
                {
                    "sense_id": "b4c51e9e-3838-38c5-818b-f218b2f9ea1e",
                    "sense_definition": "Relier des mots ou des propositions de même fonction grammaticale à l'aide d'une conjonction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette conjonction sert à <w>coordonner</w> deux propositions indépendantes dans une même phrase."
                        },
                        {
                            "text": "L'écrivain préfère souvent <w>coordonner</w> plusieurs adjectifs pour enrichir le rythme du récit."
                        }
                    ],
                    "synonyms": [
                        "lier",
                        "joindre"
                    ],
                    "antonyms": [
                        "subordonner"
                    ],
                    "common_phrases": [
                        "coordonner deux propositions"
                    ]
                }
            ]
        }
    ]
}