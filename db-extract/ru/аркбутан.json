                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arc-boutant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d88a43-8f9b-3401-ae45-eae9db5c4092",
                                        "entry_id": "47570667-afdf-365d-80cc-f71140f2a86b",
                                        "glosses": [
                                            "Pilier ou construction de maçonnerie qui finit en demi-arc et qui sert à soutenir par-dehors une voûte, un mur, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01372ac5-03de-45fd-bff1-a76d531a2617",
                                                "sense_id": "e8d88a43-8f9b-3401-ae45-eae9db5c4092",
                                                "text": "[…] si l’essence du Roman est surtout la voûte substituée aux lambris des toits, l’origine et le caractère distinct du Gothique est l’arc-boutant et non l’ogive."
                                            },
                                            {
                                                "example_id": "d1612375-13ca-4aec-a788-d9ca90894167",
                                                "sense_id": "e8d88a43-8f9b-3401-ae45-eae9db5c4092",
                                                "text": "Les murs ont une épaisseur prodigieuse ; six gros arcs-boutants extérieurs saillent du pourtour et montent contre les côtés de la tour comme pour la fortifier ou lui servir d’appui."
                                            },
                                            {
                                                "example_id": "6f728f86-4282-4475-a8a5-ad877e1e5680",
                                                "sense_id": "e8d88a43-8f9b-3401-ae45-eae9db5c4092",
                                                "text": "De style ogival flamboyant, à ornementation très fouillée, surtout dans la façade et les tours, ses arcs-boutants, ses clochetons, ses pinacles gothiques sont remarquables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae857a6-d678-3500-a1af-fa3120693260",
                                        "entry_id": "47570667-afdf-365d-80cc-f71140f2a86b",
                                        "glosses": [
                                            "Pièce de soutien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da30a5a-dd18-40be-bed3-76ed9cfdaf7b",
                                                "sense_id": "fae857a6-d678-3500-a1af-fa3120693260",
                                                "text": "La maison, dont les fermes furent renforcées par des jambettes et des arcs-boutants, put dès lors supporter des poids considérables."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arc-boutant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84d8d6aa-b75b-3229-9e52-561fe4c86257",
                                        "entry_id": "54bff9bc-1954-32be-ba86-d5bfcc67455b",
                                        "glosses": [
                                            "Participe présent du verbe arc-bouter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f651d0f2-f1b3-4b85-a550-03813b1b56e4",
                                                "sense_id": "84d8d6aa-b75b-3229-9e52-561fe4c86257",
                                                "text": "Michel rangea son téléphone, et s’arc-boutant de toutes ses forces sur le kick remit les gaz, démarrant dans une pétarade des années twist."
                                            }
