                "senses": [
                    {
                        "sense_id": "9d2dbe2b-7971-392d-8be4-fa057ab3ad64",
                        "entry_id": "43a942c1-316d-31f5-a176-905feb96630b",
                        "glosses": [
                            "Gonfler moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c74ffbce-6a3b-478b-9f69-10ee79914b5d",
                                "sense_id": "9d2dbe2b-7971-392d-8be4-fa057ab3ad64",
                                "text": "Sous-gonfler ne sert à rien d'autre qu'à augmenter la résistance au roulement et favoriser les crevaisons."
                            },
                            {
                                "example_id": "96d88e20-f2a7-482e-8e52-d8321afd1853",
                                "sense_id": "9d2dbe2b-7971-392d-8be4-fa057ab3ad64",
                                "text": "Vérifier la pression des pneus (adopter toujours la pression \"normale\" préconisée sur le véhicule : ne pas sur-gonfler, ne pas sous-gonfler)."
                            }
                        ]
                    }
