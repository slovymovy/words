                "senses": [
                    {
                        "sense_id": "2dbd2b59-eb72-35ae-906c-f7acd27b21bc",
                        "entry_id": "61ab6edd-f932-32ef-937a-ebecd0d4f361",
                        "glosses": [
                            "geosfera obejmująca ogół wód na ziemskim globie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "493ab09c-a368-43b2-a235-8b0ecca88bee",
                                "sense_id": "2dbd2b59-eb72-35ae-906c-f7acd27b21bc",
                                "text": "Również człowiek wpływa na zmiany ilości wody w hydrosferze, m.in. w procesach chemicznych i technologicznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e106c5b-18e9-41e0-921c-dd30b9bf977d",
                        "source_entry_id": "61ab6edd-f932-32ef-937a-ebecd0d4f361",
                        "source_sense_id": "2dbd2b59-eb72-35ae-906c-f7acd27b21bc",
                        "target_lang_word": "hydrosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cab5960-4816-3670-9c5f-3c965df0413a",
                                        "entry_id": "e8772afc-379b-3ec6-8e67-3b14e4eb5fec",
                                        "glosses": [
                                            "All the liquid waters of the Earth or another astronomical body, as distinguished from the land and the gases of the atmosphere."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ce79327-5913-48ea-9d8a-d3e945e27537",
                        "source_entry_id": "61ab6edd-f932-32ef-937a-ebecd0d4f361",
                        "source_sense_id": "2dbd2b59-eb72-35ae-906c-f7acd27b21bc",
                        "target_lang_word": "hydrosphère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrosphère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf0eea88-ceb5-38e7-b132-fb175e31ab34",
                                        "entry_id": "8539bb9c-4557-3750-adc8-0ef5fed2aab7",
                                        "glosses": [
                                            "Ensemble de l'eau présente sur un corps céleste, quel que soit son état (solide, liquide et gaz)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf6f7f5-3852-42a3-994a-8a13e2d562f2",
                                                "sense_id": "cf0eea88-ceb5-38e7-b132-fb175e31ab34",
                                                "text": "L’étude des hydrates de gaz, tels que les clathrates de méthane plébiscités par le cas de Titan, ont démontré la stabilité particulière de ces phases aux conditions attendues dans les hydrosphères des grands satellites et, en conséquence, leur rôle déterminant dans l’activité géologique de ces mondes."
                                            },
                                            {
                                                "example_id": "fe4f6af1-26f1-4e8e-9382-955c1c009995",
                                                "sense_id": "cf0eea88-ceb5-38e7-b132-fb175e31ab34",
                                                "text": "La Terre se singularise par rapport aux autres planètes du système solaire par la présence d’une hydrosphère sous ses trois formes: solide, liquide et gazeuse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f439990-991d-37e3-bace-fb76a534a359",
                                        "entry_id": "8539bb9c-4557-3750-adc8-0ef5fed2aab7",
                                        "glosses": [
                                            "Ensemble des eaux terrestres (océans, lacs, rivières, nappes souterraines)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc5d6a6e-29b6-4f1f-9005-f72cfca7bb4a",
                                                "sense_id": "3f439990-991d-37e3-bace-fb76a534a359",
                                                "text": "Un premier découpage de l’espace terrestre s’est imposé en fonction de l’état de la matière : lithosphère, hydrosphère, atmosphère, biosphère."
                                            },
                                            {
                                                "example_id": "a7464875-a462-4ccb-9122-95243ffcb93f",
                                                "sense_id": "3f439990-991d-37e3-bace-fb76a534a359",
                                                "text": "Au niveau de l’hydrosphère, les courants océaniques jouent un rôle déterminant dans les régulations climatiques, puisqu’ils redistribuent la chaleur autour de notre planète, compensant de la sorte partiellement les différences de rayonnement entre zones géographiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b68b038-e546-44fc-887e-e07d2945a159",
                        "source_entry_id": "61ab6edd-f932-32ef-937a-ebecd0d4f361",
                        "source_sense_id": "2dbd2b59-eb72-35ae-906c-f7acd27b21bc",
