                "senses": [
                    {
                        "sense_id": "6bc3bd83-50db-3d51-bea5-1b2cf85f0048",
                        "entry_id": "0b997194-0b3a-32f9-806c-d405d63e4dd6",
                        "glosses": [
                            "Relatif à l’allostasie, au processus ramenant un système à l’équilibre, à la stabilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b568db3-51dd-46c7-8bc8-6266db3697d4",
                                "sense_id": "6bc3bd83-50db-3d51-bea5-1b2cf85f0048",
                                "text": "Koob et coll. émettent l’hypothèse que les modifications des systèmes de récompense et de stress, supposées maintenir une stabilité hédonique au travers d’un état allostatique, entraîneraient progressivement une vulnérabilité à développer une dépendance et des phénomènes de rechute."
                            },
                            {
                                "example_id": "405d5b2d-2a40-4498-8513-eef1050e6bb8",
                                "sense_id": "6bc3bd83-50db-3d51-bea5-1b2cf85f0048",
                                "text": "L’utilisation d’un indice de charge allostatique ouvre aux chercheurs et aux cliniciens une fenêtre sur la façon dont le stress chronique épuise la personne."
                            }
                        ]
                    }
                ],
