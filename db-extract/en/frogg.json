                        ],
                        "examples": [
                            {
                                "example_id": "9c35aa94-35c2-4c18-979d-62f2f3d73609",
                                "sense_id": "23bc0e78-e0ef-3503-b8d0-2ab0a4711d16",
                                "text": "BTW, don't try to frogg me any more and stop using my .sig, OK? ¶ [Damn froggers, can't do anything right...]"
                            },
                            {
                                "example_id": "6ccdb3ed-bdae-40ba-9929-d7cf066c2f92",
                                "sense_id": "23bc0e78-e0ef-3503-b8d0-2ab0a4711d16",
                                "text": "But just using someone's name is never forgery. It's a common thing to frogg someone's name to get him to squeal on endlessly about it, but only the most clueless ever fall for that gambit."
                            }
                        ]
                    }
