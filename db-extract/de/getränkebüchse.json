                "senses": [
                    {
                        "sense_id": "8c26a930-3c0d-3275-b69d-7917e5fd752e",
                        "entry_id": "82ce37fb-1fc7-3f9d-a45e-7996289ba9d5",
                        "glosses": [
                            "runder, recyclebarer Behälter aus Metall, der als Verpackung für Getränke dient und für den einmaligen Gebrauch bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17fb4c2-39e3-4898-99bc-27f65197b265",
                                "sense_id": "8c26a930-3c0d-3275-b69d-7917e5fd752e",
                                "text": "Ebenfalls im Angebot: Die Sprengfalle gegen Maulwürfe und die Getränkebüchse mit zwei Kammern."
                            },
                            {
                                "example_id": "90b06aa5-4309-4578-b6ba-029cb87c6fc2",
                                "sense_id": "8c26a930-3c0d-3275-b69d-7917e5fd752e",
                                "text": "Aus der Puppe mit eigener Persönlichkeit werde schließlich ein bloßer Gegenstand, den man zerstören könne, wie eine Getränkebüchse."
                            },
                            {
                                "example_id": "25b25c89-3b4a-4321-9f39-873db9bd2031",
                                "sense_id": "8c26a930-3c0d-3275-b69d-7917e5fd752e",
                                "text": "Dieser „östrogenartige“ Stoff kommt in Plastikbehältern und -bechern vor und wird als Beschichtung von Getränkebüchsen und Gemüsedosen verwendet."
                            },
                            {
                                "example_id": "8af8c68b-05d5-4ab9-b307-9d2215ad0ebc",
                                "sense_id": "8c26a930-3c0d-3275-b69d-7917e5fd752e",
                                "text": "Er holte eine Getränkebüchse hervor und riß sie auf."
                            },
                            {
                                "example_id": "7a8c03e9-7a9b-438c-8605-a910ef040c22",
                                "sense_id": "8c26a930-3c0d-3275-b69d-7917e5fd752e",
                                "text": "Ein Jugendlicher wollte seine leere Getränkebüchse auf den Weg werfen. Ein kurzer Wink meines Schutzengels und die Büchse blieb am Finger des Jungen hängen."
                            },
                            {
                                "example_id": "2fad8307-5bdb-4bcf-b5d4-c4c8d79a87f0",
                                "sense_id": "8c26a930-3c0d-3275-b69d-7917e5fd752e",
                                "text": "Nachdem durch eine Umkonstruktion der Aufreißlasche diese fest an der Getränkebüchse verbleibt, ist eine komplette Rücknahme gewährleistet. Die Streuverluste werden stark reduziert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
