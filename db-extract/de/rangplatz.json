                ],
                "senses": [
                    {
                        "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                        "entry_id": "f76bc95f-fbe5-30c6-ae7a-f2b955a2f6d9",
                        "glosses": [
                            "Platz oder Position in einer Reihenfolge oder Hierarchie; Rangplatz kann sich beispielsweise auf das Ergebnis in einem Wettbewerb beziehen oder auf die Stellung einer Person/Personengruppe/Organisation in einem Ranking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54af442f-9206-4bb9-a087-eed970728874",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "Nur mit einem ausreichend hohen Rangplatz kann man sich in Deutschland für Numerus-Clausus-Fächer, wie Medizin, Zahnmedizin oder Pharmazie, immatrikulieren und diese studieren."
                            },
                            {
                                "example_id": "30251894-e62b-4fa1-be6f-530537a3a0b7",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "„Ab dem SoSe22 gilt für Pharmazie in Hessen: (Der Rangplatz wird anhand von Punkten gebildet. Es können max. 100 Punkte erreicht werden.)“"
                            },
                            {
                                "example_id": "7c9749d6-b8d4-4fce-ac0d-1c05b6020114",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "„Er erreichte 7287 Zweitstimmen und blieb damit sechs Rangplätze von einem Listenmandat entfernt.“"
                            },
                            {
                                "example_id": "5efe7293-154e-4864-96e4-17028e86dafd",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "[Hochschulranking:] „Einige Rankings stellen Ranglisten mit einzelnen Rangplätzen auf, andere teilen Hochschulen in verschiedene Ranggruppen ein.“"
                            },
                            {
                                "example_id": "6720312c-c3b8-491b-8dd1-c4619b91dad4",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "„Die Spitzenplätze im «Women in Work Index» belegen weiterhin Luxemburg, Neuseeland und Slowenien. Die Schweiz fiel hingegen um sechs Rangplätze zurück.“"
                            },
                            {
                                "example_id": "8c7a5437-92ec-4e77-a4f1-d23750425846",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "„Im internationalen Vergleich hält Deutschlands Sozialpolitik einen Rangplatz in der Oberschicht der Wohlfahrtsstaaten (Masuch et al. 2014; Schmidt 2012a; ILO 2017).“"
                            },
                            {
                                "example_id": "83a0c9a3-07c9-4575-87e3-181ea1545881",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "Im Global Competitiveness Index des Weltwirtschaftsforums erreicht Deutschland durchgehend hohe Rangplätze."
                            },
                            {
                                "example_id": "98f26ce3-1dd8-44bc-885d-db196670b16b",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "[Standortrankimg von Ländern:] „Seit dem ersten Länderindex 2006 lag Deutschland noch nie in der Spitzengruppe, aber anfänglich zumindest noch im Mittelfeld. Die Analyse erscheint alle zwei Jahre. Seit 2006 ist Deutschland um sechs Rangplätze abgerutscht.“"
                            },
                            {
                                "example_id": "8a7ae7f2-51c3-4c02-8c0a-7fd0c0e30e09",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "[Mietenvergleich deutscher Städte:] „Die überraschende Nachricht: »München erstmals seit 1998 durch den kleinen Nachbarn Karlsfeld von Rangplatz 1 verdrängt.«“"
                            },
                            {
                                "example_id": "faa4ecef-91ec-480c-8664-acf452745a88",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "[Informationsquellen für Erstwähler in den neuen Bundesländern: …] „Rang 5 wurde von Nachrichtensendungen im Radio belegt, erst auf dem sechsten Platz folgten Gespräche mit dem Vater über politische Themen. Kommunikation in Familie, Schule und Freundeskreis belegte die Rangplätze 6 bis 11.“"
                            },
                            {
                                "example_id": "8876cdb7-b80e-4edd-bcaa-ce8d2a860a39",
                                "sense_id": "3efa2d54-2554-35c1-b957-7f3eddb3d6cb",
                                "text": "„Die mäßigen Ergebnisse, die die deutschen Schülerinnen und Schüler bei der ersten Untersuchung im Jahr 2000 erzielten, lösten den bereits angesprochenen ‚PISA-Schock‘ aus: In allen drei Leistungsbereichen lagen die deutschen Schülerinnen und Schüler jeweils unterhalb des OECD-Durchschnitts; sie landeten auf dem 20. oder 21. Rangplatz und waren damit weit entfernt von Spitzenländern wie Finnland, Japan oder Kanada.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
