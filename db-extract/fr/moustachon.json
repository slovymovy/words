                            {
                                "example_id": "d23f097f-b226-4660-ab48-63da394d2ef1",
                                "sense_id": "0ee588ad-4bd0-39aa-83d4-8f11924481f3",
                                "text": "Prétextant de la chaleur, il se fit couper les cheveux, raser son moustachon et coiffer à l’aviateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "26ee127c-de3b-37f9-b378-9a1e1895cc30",
                        "entry_id": "95dc3316-9543-3843-be54-3231817e7d28",
                        "glosses": [
                            "Homme de science, érudit."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "09fbfd25-5201-477f-b153-ab69ed1d565c",
                                "sense_id": "26ee127c-de3b-37f9-b378-9a1e1895cc30",
                                "text": "Monsieur Péri, veuillez traduire ! Le pédagogue, le moustachon s’imaginait qu’il n’y avait qu’à."
                            }
                        ]
                    },
                    {
                        "sense_id": "363195df-dd9e-3544-a010-91662fede07d",
                        "entry_id": "95dc3316-9543-3843-be54-3231817e7d28",
                        "glosses": [
                            "Coup de poing au visage."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cc650058-3a5b-4e04-964e-17cba714de82",
                                "sense_id": "363195df-dd9e-3544-a010-91662fede07d",
                                "text": "Dites-lui que d’un moustachon je l’allonge par terre. Je me fous qu’elle soit une femme."
                            }
                        ]
