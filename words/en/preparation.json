{
    "word_family": [
        "prepare",
        "preparatory",
        "preparedness",
        "preparer",
        "unprepared"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d884da01-ff72-3be2-beae-aae3aa46693d",
                    "sense_definition": "The act of preparing or getting ready for a future event or purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went over my notes in <w>preparation</w> for the exam.",
                            "target_lang_translations": {
                                "ru": "Я просмотрел свои записи в рамках <w>подготовки</w> к экзамену.",
                                "zh": "我复习了笔记，为考试做<w>准备</w>。"
                            }
                        },
                        {
                            "text": "The team began their <w>preparation</w> for the championship months in advance.",
                            "target_lang_translations": {
                                "ru": "Команда начала <w>подготовку</w> к чемпионату за несколько месяцев.",
                                "zh": "团队提前几个月就开始了锦标赛的<w>筹备</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "planning",
                        "arrangement",
                        "groundwork"
                    ],
                    "common_phrases": [
                        "in preparation for",
                        "make preparations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по подготовке или приведению в готовность к будущему событию или цели.",
                        "zh": "为未来事件或目的所做的准备工作或筹备过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подготовка",
                                "target_lang_sense_clarification": "процесс обучения или организации"
                            },
                            {
                                "target_lang_word": "приготовление",
                                "target_lang_sense_clarification": "создание чего-либо или сборы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准备",
                                "target_lang_sense_clarification": "为应付某种情况而做的预先安排"
                            },
                            {
                                "target_lang_word": "筹备",
                                "target_lang_sense_clarification": "为进行某项工作而做的准备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cff8a7e3-81a9-3c46-9144-39571b82e68c",
                    "sense_definition": "The state of being prepared or ready for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His lack of <w>preparation</w> was evident when he forgot his lines during the speech.",
                            "target_lang_translations": {
                                "ru": "Его недостаточная <w>подготовка</w> стала очевидной, когда он забыл слова во время речи.",
                                "zh": "当他在演讲中忘词时，他<w>准备</w>不足显而易见。"
                            }
                        },
                        {
                            "text": "Complete <w>preparation</w> is essential for a safe journey through the mountains.",
                            "target_lang_translations": {
                                "ru": "Тщательная <w>подготовка</w> необходима для безопасного путешествия по горам.",
                                "zh": "充分的<w>准备</w>对于安全穿越山区至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "readiness",
                        "preparedness"
                    ],
                    "antonyms": [
                        "unpreparedness"
                    ],
                    "common_phrases": [
                        "state of preparation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние готовности к чему-либо.",
                        "zh": "处于准备就绪的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подготовленность",
                                "target_lang_sense_clarification": "наличие необходимых навыков или знаний"
                            },
                            {
                                "target_lang_word": "готовность",
                                "target_lang_sense_clarification": "состояние, когда всё готово"
                            },
                            {
                                "target_lang_word": "подготовка",
                                "target_lang_sense_clarification": "уровень знаний или навыков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准备",
                                "target_lang_sense_clarification": "预先安排好的状态"
                            },
                            {
                                "target_lang_word": "就绪",
                                "target_lang_sense_clarification": "准备完毕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "980312ce-f9fc-32cd-918d-dfea512cf9de",
                    "sense_definition": "A substance, such as a medicine, food, or cosmetic, that has been manufactured or compounded.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional remedy is a bitter <w>preparation</w> made from steamed herbs.",
                            "target_lang_translations": {
                                "ru": "Традиционное средство — это горький <w>препарат</w>, сделанный из распаренных трав.",
                                "zh": "这种传统疗法是一种由蒸草药制成的苦味<w>制剂</w>。"
                            }
                        },
                        {
                            "text": "The pharmacist mixed a special <w>preparation</w> to treat the skin condition.",
                            "target_lang_translations": {
                                "ru": "Фармацевт смешал специальный <w>препарат</w> для лечения кожного заболевания.",
                                "zh": "药剂师混合了一种特殊的<w>配制品</w>来治疗皮肤病。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mixture",
                        "concoction",
                        "formulation",
                        "compound"
                    ],
                    "common_phrases": [
                        "herbal preparation",
                        "pharmaceutical preparation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, такое как лекарство, пища или косметическое средство, которое было изготовлено или составлено.",
                        "zh": "经过加工或配制的物质，如药物、食品或化妆品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препарат",
                                "target_lang_sense_clarification": "лекарственное или химическое вещество"
                            },
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "лекарство или смесь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制剂",
                                "target_lang_sense_clarification": "经过加工配制的药物"
                            },
                            {
                                "target_lang_word": "配制品",
                                "target_lang_sense_clarification": "经过混合或加工的物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d9ac6d7-bee0-3c60-801d-97f1016bf373",
                    "sense_definition": "A part of an animal body preserved as a specimen for study.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "specimen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a <w>preparation</w> of the human nervous system.",
                            "target_lang_translations": {
                                "ru": "В музее был выставлен <w>препарат</w> нервной системы человека.",
                                "zh": "博物馆展示了一个人体神经系统的<w>标本</w>。"
                            }
                        },
                        {
                            "text": "Students examined the microscopic <w>preparation</w> on the glass slide.",
                            "target_lang_translations": {
                                "ru": "Студенты изучали микроскопический <w>препарат</w> на предметном стекле.",
                                "zh": "学生们检查了载玻片上的显微<w>切片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "specimen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела животного, сохраненная как образец для изучения.",
                        "zh": "为研究目的而保存的动物身体部分或标本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препарат",
                                "target_lang_sense_clarification": "анатомический или микроскопический образец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标本",
                                "target_lang_sense_clarification": "经处理后可供研究的生物体或其部分"
                            },
                            {
                                "target_lang_word": "切片",
                                "target_lang_sense_clarification": "用于显微镜观察的薄片标本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2f6291f-07b4-3bc2-8a83-44c02ce2b917",
                    "sense_definition": "The day before the Sabbath or other religious feast-day.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All meals were cooked in advance on the day of <w>preparation</w>.",
                            "target_lang_translations": {
                                "ru": "Вся еда была приготовлена заранее в день <w>приготовления</w>.",
                                "zh": "所有的饭菜都在<w>预备日</w>提前做好了。"
                            }
                        },
                        {
                            "text": "The scriptures mention the day of <w>preparation</w> before the Passover.",
                            "target_lang_translations": {
                                "ru": "Писание упоминает день <w>приготовления</w> перед Пасхой.",
                                "zh": "经文中提到了逾越节前的<w>预备日</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "day of preparation"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "religion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "День перед субботой или другим религиозным праздником.",
                        "zh": "安息日或其他宗教节日的前一天。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приготовление",
                                "target_lang_sense_clarification": "библейский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预备日",
                                "target_lang_sense_clarification": "宗教节日前的准备日子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "644f8ca4-8b17-3f3c-aef8-08c26d99be43",
                    "sense_definition": "The previous introduction of a note in a chord that continues into a succeeding dissonance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proper <w>preparation</w> of the dissonance makes the resolution more satisfying.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>приготовление</w> диссонанса делает разрешение более удовлетворяющим.",
                                "zh": "对不协和音进行适当的<w>预备</w>，会使解决音更令人满意。"
                            }
                        },
                        {
                            "text": "In strict counterpoint, the <w>preparation</w> must be a consonance.",
                            "target_lang_translations": {
                                "ru": "В строгом контрапункте <w>приготовление</w> должно быть консонансом.",
                                "zh": "在严格对位法中，<w>预备</w>必须是一个协和音。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предварительное введение ноты в аккорде, которая продолжается в последующем диссонансе.",
                        "zh": "在和弦中引入一个音符，使其在随后的不协和音中持续存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приготовление",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预备",
                                "target_lang_sense_clarification": "音乐理论中不协和音的引入方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84e10cc2-bb79-3e13-921c-d7e6a0cd8e09",
                    "sense_definition": "Devotional exercises performed before a religious service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest finished his <w>preparation</w> in the vestry before the service began.",
                            "target_lang_translations": {
                                "ru": "Священник закончил <w>приготовление</w> в ризнице перед началом службы.",
                                "zh": "牧师在仪式开始前在圣衣室完成了他的<w>预备</w>。"
                            }
                        },
                        {
                            "text": "Silent <w>preparation</w> helps the congregation focus before mass.",
                            "target_lang_translations": {
                                "ru": "Тихое <w>приготовление</w> помогает прихожанам сосредоточиться перед мессой.",
                                "zh": "安静的<w>预备</w>有助于会众在弥撒前集中注意力。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "religion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Религиозные упражнения, совершаемые перед богослужением.",
                        "zh": "宗教仪式前进行的虔诚练习或准备活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приготовление",
                                "target_lang_sense_clarification": "духовная подготовка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预备",
                                "target_lang_sense_clarification": "仪式前的精神准备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b4f9e66-31da-3c5c-8c50-ca30717762f5",
                    "sense_definition": "Any of the objects placed between the strings of a prepared piano to alter the sound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer specified a rubber <w>preparation</w> on the middle C string.",
                            "target_lang_translations": {
                                "ru": "Композитор указал резиновую <w>препарацию</w> на струне \"до\" первой октавы.",
                                "zh": "作曲家指定在中央C弦上使用橡胶<w>附加物</w>。"
                            }
                        },
                        {
                            "text": "Removing every <w>preparation</w> from the piano took nearly an hour.",
                            "target_lang_translations": {
                                "ru": "Удаление каждой <w>препарации</w> из фортепиано заняло почти час.",
                                "zh": "从钢琴上拆除每一个<w>附加物</w>花了近一个小时。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из предметов, помещенных между струнами подготовленного фортепиано для изменения звука.",
                        "zh": "放置在预置钢琴琴弦之间以改变音色的物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "препарация",
                                "target_lang_sense_clarification": "технический прием или объект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附加物",
                                "target_lang_sense_clarification": "改变钢琴音色的装置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}