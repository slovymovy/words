{
    "word_family": [
        "contestant",
        "contestable",
        "incontestable",
        "contestation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1b982b7-15ff-3d23-b55a-1fadc0684757",
                    "sense_definition": "An organized event in which people try to win a prize by being the best at something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "competition_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She won first prize in the singing <w>contest</w>.",
                            "target_lang_translations": {
                                "ru": "Она выиграла первый приз в песенном <w>конкурсе</w>.",
                                "de": "Sie gewann den ersten Preis beim Gesangs<w>wettbewerb</w>.",
                                "zh": "她在歌唱<w>比赛</w>中赢得了头奖。"
                            }
                        },
                        {
                            "text": "The school held a spelling <w>contest</w> for all the students.",
                            "target_lang_translations": {
                                "ru": "Школа провела <w>конкурс</w> правописания для всех учеников.",
                                "de": "Die Schule veranstaltete einen Buchstabier<w>wettbewerb</w> für alle Schüler.",
                                "zh": "学校为所有学生举办了一场拼写<w>竞赛</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "competition",
                        "match"
                    ],
                    "common_phrases": [
                        "beauty contest",
                        "talent contest",
                        "spelling contest",
                        "enter a contest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованное мероприятие, в котором участники стараются победить, чтобы получить приз или звание лучшего.",
                        "de": "Eine organisierte Veranstaltung, bei der Menschen versuchen, einen Preis zu gewinnen, indem sie in etwas die Besten sind.",
                        "zh": "一种有组织的活动，人们通过在某方面表现最出色来争取赢得奖项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкурс",
                                "target_lang_sense_clarification": "творческое или интеллектуальное состязание"
                            },
                            {
                                "target_lang_word": "соревнование",
                                "target_lang_sense_clarification": "спортивное или общее состязание"
                            },
                            {
                                "target_lang_word": "состязание",
                                "target_lang_sense_clarification": "официальное название борьбы за первенство"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wettbewerb",
                                "target_lang_sense_clarification": "allgemeiner Leistungsvergleich"
                            },
                            {
                                "target_lang_word": "Wettkampf",
                                "target_lang_sense_clarification": "sportliches oder direktes Kräftemessen"
                            },
                            {
                                "target_lang_word": "Wettstreit",
                                "target_lang_sense_clarification": "gehobener Begriff für ein gegenseitiges Übertreffen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "比赛",
                                "target_lang_sense_clarification": "通用的竞技或竞赛活动"
                            },
                            {
                                "target_lang_word": "竞赛",
                                "target_lang_sense_clarification": "侧重于技能或知识的较量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d438528-db3c-3b50-a41b-e39f74beba16",
                    "sense_definition": "A struggle for power or control between two or more people or groups.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "struggle_conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The election became a bitter <w>contest</w> between the two parties.",
                            "target_lang_translations": {
                                "ru": "Выборы превратились в ожесточенную <w>борьбу</w> между двумя партиями.",
                                "de": "Die Wahl entwickelte sich zu einem erbitterten <w>Machtkampf</w> zwischen den beiden Parteien.",
                                "zh": "这次选举演变成了两党之间一场激烈的<w>争夺</w>。"
                            }
                        },
                        {
                            "text": "It was an unfair <w>contest</w> from the very beginning.",
                            "target_lang_translations": {
                                "ru": "Это было нечестное <w>состязание</w> с самого начала.",
                                "de": "Es war von Anfang an ein ungleicher <w>Kampf</w>.",
                                "zh": "从一开始这就是一场不公平的<w>较量</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "battle",
                        "combat",
                        "fight"
                    ],
                    "common_phrases": [
                        "close contest",
                        "bitter contest",
                        "leadership contest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Борьба за власть или контроль между двумя или более людьми или группами.",
                        "de": "Ein Kampf um Macht oder Kontrolle zwischen zwei oder mehr Personen oder Gruppen.",
                        "zh": "两个或多个个人或团体之间为权力或控制权而进行的斗争。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борьба",
                                "target_lang_sense_clarification": "активное противодействие"
                            },
                            {
                                "target_lang_word": "противостояние",
                                "target_lang_sense_clarification": "сопротивление, конфликт интересов"
                            },
                            {
                                "target_lang_word": "соперничество",
                                "target_lang_sense_clarification": "конкуренция за первенство"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kampf",
                                "target_lang_sense_clarification": "Auseinandersetzung um Macht oder Positionen"
                            },
                            {
                                "target_lang_word": "Machtkampf",
                                "target_lang_sense_clarification": "spezifischer Kampf um die politische oder organisatorische Führung"
                            },
                            {
                                "target_lang_word": "Auseinandersetzung",
                                "target_lang_sense_clarification": "kontroverser Konflikt"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争夺",
                                "target_lang_sense_clarification": "为获取某物而进行的激烈竞争"
                            },
                            {
                                "target_lang_word": "较量",
                                "target_lang_sense_clarification": "双方实力的对抗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2f491e8-2e31-3863-9965-34f87a9fc787",
                    "sense_definition": "A formal dispute or debate, often used in legal contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dispute_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant decided to enter a plea of no <w>contest</w>.",
                            "target_lang_translations": {
                                "ru": "Подсудимый решил не <w>оспаривать</w> обвинение.",
                                "de": "Der Angeklagte beschloss, auf <w>keinen Einspruch</w> zu plädieren.",
                                "zh": "被告决定对指控不提出<w>异议</w>。"
                            }
                        },
                        {
                            "text": "The facts of the case are beyond <w>contest</w>.",
                            "target_lang_translations": {
                                "ru": "Факты этого дела не подлежат <w>оспариванию</w>.",
                                "de": "Die Fakten des Falls stehen außer <w>Streit</w>.",
                                "zh": "案件的事实无可<w>争议</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "controversy",
                        "debate",
                        "discussion"
                    ],
                    "common_phrases": [
                        "no contest",
                        "plea of no contest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный спор или дебаты, часто используемые в юридическом контексте.",
                        "de": "Ein formeller Streit oder eine Debatte, oft im rechtlichen Kontext verwendet.",
                        "zh": "正式的争议或辩论，常用于法律语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "юридическое или формальное разногласие"
                            },
                            {
                                "target_lang_word": "оспаривание",
                                "target_lang_sense_clarification": "процесс выражения несогласия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Streit",
                                "target_lang_sense_clarification": "formelle oder rechtliche Uneinigkeit"
                            },
                            {
                                "target_lang_word": "Debatte",
                                "target_lang_sense_clarification": "formelle Diskussion oder Auseinandersetzung"
                            },
                            {
                                "target_lang_word": "Anfechtung",
                                "target_lang_sense_clarification": "rechtlicher Widerspruch"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争议",
                                "target_lang_sense_clarification": "对某事存在分歧"
                            },
                            {
                                "target_lang_word": "异议",
                                "target_lang_sense_clarification": "法律或正式场合下的反对意见"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "971c1a2d-5866-3b23-abe3-f7c29523fda3",
                    "sense_definition": "To formally oppose a decision, statement, or claim because one believes it is wrong or illegal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "oppose_formally",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family plans to <w>contest</w> the will in court.",
                            "target_lang_translations": {
                                "ru": "Семья планирует <w>оспорить</w> завещание в суде.",
                                "de": "Die Familie plant, das Testament vor Gericht <w>anzufechten</w>.",
                                "zh": "这家人计划在法庭上<w>质疑</w>这份遗嘱。"
                            }
                        },
                        {
                            "text": "He decided to <w>contest</w> the parking ticket because the sign was unclear.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>опротестовать</w> штраф за парковку, так как знак был неясным.",
                                "de": "Er beschloss, den Strafzettel <w>anzufechten</w>, da das Schild unklar war.",
                                "zh": "他决定<w>抗辩</w>那张停车罚单，因为标志不清楚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call into question",
                        "oppose",
                        "controvert"
                    ],
                    "antonyms": [
                        "support"
                    ],
                    "common_phrases": [
                        "contest a will",
                        "contest a decision",
                        "contest the validity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально выступать против решения, заявления или требования, считая его неправильным или незаконным.",
                        "de": "Sich einer Entscheidung, Aussage oder Forderung formell widersetzen, weil man sie für falsch oder illegal hält.",
                        "zh": "因认为某项决定、声明或主张错误或非法而正式提出反对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "выражать несогласие с решением"
                            },
                            {
                                "target_lang_word": "опротестовывать",
                                "target_lang_sense_clarification": "подавать официальный протест"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "anfechten",
                                "target_lang_sense_clarification": "eine Entscheidung rechtlich oder formell bestreiten"
                            },
                            {
                                "target_lang_word": "bestreiten",
                                "target_lang_sense_clarification": "die Richtigkeit einer Aussage oder Forderung leugnen"
                            },
                            {
                                "target_lang_word": "infrage stellen",
                                "target_lang_sense_clarification": "Zweifel an der Gültigkeit äußern"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "质疑",
                                "target_lang_sense_clarification": "对某事的真实性或正确性提出疑问"
                            },
                            {
                                "target_lang_word": "抗辩",
                                "target_lang_sense_clarification": "在法律程序中正式提出反对"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e0beca5-c7d8-3b9f-955d-5ca3c9206030",
                    "sense_definition": "To take part in a competition or election and try to win it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compete_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three candidates will <w>contest</w> for the leadership of the party.",
                            "target_lang_translations": {
                                "ru": "Три кандидата будут <w>бороться</w> за лидерство в партии.",
                                "de": "Drei Kandidaten werden um die Führung der Partei <w>kämpfen</w>.",
                                "zh": "三名候选人将<w>角逐</w>党的领导权。"
                            }
                        },
                        {
                            "text": "The team is ready to <w>contest</w> the championship final.",
                            "target_lang_translations": {
                                "ru": "Команда готова <w>сразиться</w> в финале чемпионата.",
                                "de": "Das Team ist bereit, das Meisterschaftsfinale zu <w>bestreiten</w>.",
                                "zh": "该队已准备好<w>参加</w>冠军决赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compete",
                        "contend"
                    ],
                    "common_phrases": [
                        "contest an election",
                        "contest a seat",
                        "contest the championship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать участие в соревновании или выборах с целью победить.",
                        "de": "An einem Wettbewerb oder einer Wahl teilnehmen und versuchen, diese zu gewinnen.",
                        "zh": "参加比赛或选举并试图获胜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "сражаться за победу или место"
                            },
                            {
                                "target_lang_word": "состязаться",
                                "target_lang_sense_clarification": "участвовать в соревновании"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "antreten bei",
                                "target_lang_sense_clarification": "an einem Wettbewerb oder einer Wahl teilnehmen"
                            },
                            {
                                "target_lang_word": "kämpfen um",
                                "target_lang_sense_clarification": "sich bemühen, einen Sieg oder ein Amt zu erringen"
                            },
                            {
                                "target_lang_word": "bestreiten",
                                "target_lang_sense_clarification": "ein Spiel oder einen Wettkampf austragen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "角逐",
                                "target_lang_sense_clarification": "竞争职位或奖项"
                            },
                            {
                                "target_lang_word": "参加",
                                "target_lang_sense_clarification": "参与某项竞技活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827adb95-113e-3a74-881c-ac2a091ff4df",
                    "sense_definition": "To struggle violently to keep or gain control of a place or position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "struggle_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers <w>contested</w> every inch of the territory.",
                            "target_lang_translations": {
                                "ru": "Солдаты <w>сражались</w> за каждый дюйм территории.",
                                "de": "Die Soldaten <w>verteidigten</w> jeden Zentimeter des Territoriums erbittert.",
                                "zh": "士兵们为每一寸土地进行了<w>争夺</w>。"
                            }
                        },
                        {
                            "text": "Both armies fiercely <w>contested</w> the bridge for several hours.",
                            "target_lang_translations": {
                                "ru": "Обе армии ожесточенно <w>оспаривали</w> мост в течение нескольких часов.",
                                "de": "Beide Armeen <w>umkämpften</w> die Brücke mehrere Stunden lang heftig.",
                                "zh": "两军为这座桥梁进行了数小时的激烈<w>拼抢</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "contest every inch",
                        "hotly contested"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яростно бороться за сохранение или получение контроля над местом или позицией.",
                        "de": "Heftig darum kämpfen, die Kontrolle über einen Ort oder eine Position zu behalten oder zu erlangen.",
                        "zh": "为保持或获得对某地或某职位的控制权而进行的激烈斗争。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сражаться",
                                "target_lang_sense_clarification": "вести бой за территорию"
                            },
                            {
                                "target_lang_word": "отстаивать",
                                "target_lang_sense_clarification": "защищать позицию в бою"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "umkämpfen",
                                "target_lang_sense_clarification": "heftig um den Besitz einer Position oder eines Ortes streiten"
                            },
                            {
                                "target_lang_word": "verteidigen",
                                "target_lang_sense_clarification": "eine Position mit allen Mitteln halten"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "争夺",
                                "target_lang_sense_clarification": "为占有某地而进行的战斗"
                            },
                            {
                                "target_lang_word": "拼抢",
                                "target_lang_sense_clarification": "在对抗中极力争取"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}