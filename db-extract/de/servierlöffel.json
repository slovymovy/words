                "senses": [
                    {
                        "sense_id": "ac3a0a3f-970b-3034-9770-83db97d65910",
                        "entry_id": "21d5f951-f1e3-3c45-84f7-a68f706eed93",
                        "glosses": [
                            "Löffel, der zum Auftun von Speisen verwendet wird"
                        ],
                        "tags": [
                            "Haushalt"
                        ],
                        "examples": [
                            {
                                "example_id": "1af4c6f8-dec9-4457-a3d5-1e6b2af987e7",
                                "sense_id": "ac3a0a3f-970b-3034-9770-83db97d65910",
                                "text": "„Rührei ist vom Servierlöffel auf den Tisch gefallen, und Cristina versucht, es mit der Hand aufzunehmen.“"
                            },
                            {
                                "example_id": "740d6960-5f23-4fc5-9424-be1293026136",
                                "sense_id": "ac3a0a3f-970b-3034-9770-83db97d65910",
                                "text": "„Einige Besteckhersteller bieten Sets, Vorlegegarnituren genannt, an. Diese bestehen aus den gebräuchlichsten Vorlegegeräten: Fleischgabel, Gemüselöffel, Saucenlöffel, Servierlöffel, Tortenheber, Sahnelöffel, Zuckerlöffel und/oder Salatbesteck. “"
                            },
                            {
                                "example_id": "ae7afb0a-53ba-4726-835a-33f5217fe121",
                                "sense_id": "ac3a0a3f-970b-3034-9770-83db97d65910",
                                "text": "„Für die Prüfung der Beladekapazität von Haushaltsgeschirrspülern werden neben der angegebenen Anzahl von Maßgedecken zusätzlich noch folgende Servier- und Besteckteile verwendet:",
                                "translation": "bei Geschirrspülern mit einem Fassungsvermögen von sieben oder mehr Maßgedecken: 1 Servierschüssel 19 cm“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
