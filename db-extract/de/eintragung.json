                "senses": [
                    {
                        "sense_id": "adcf6fe5-b5c5-32a6-86fa-4587baa8ac38",
                        "entry_id": "f33d9130-74b7-3851-acbe-1378f62014c1",
                        "glosses": [
                            "die Handlung, die darin besteht, etwas in eine geeignete Stelle zu schreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec49143-aa6d-4d3e-a2f9-c2395e62e138",
                                "sense_id": "adcf6fe5-b5c5-32a6-86fa-4587baa8ac38",
                                "text": "Die abendliche Eintragung der Verkaufszahlen gehörte zu ihren Lieblingstätigkeiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af8734c6-3ba3-3f99-8699-d10cdfbee2ef",
                        "entry_id": "f33d9130-74b7-3851-acbe-1378f62014c1",
                        "glosses": [
                            "das Ergebnis, das darin besteht, dass etwas in eine geeignete Stelle geschrieben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a910ccf8-23ed-4706-88a3-be6e80c459a9",
                                "sense_id": "af8734c6-3ba3-3f99-8699-d10cdfbee2ef",
                                "text": "„Seine Eintragungen im Logbuch entsprachen, was Rechtschreibung und die Zeichensetzung betraf, nicht den Regeln, doch das gilt für viele schriftliche Zeugnisse der damaligen Zeit.“"
                            },
                            {
                                "example_id": "2fcddf99-ee7f-435e-983e-4ed981c9fcee",
                                "sense_id": "af8734c6-3ba3-3f99-8699-d10cdfbee2ef",
                                "text": "„Viele Eintragungen machen keinen Sinn.“"
                            },
                            {
                                "example_id": "bfade11e-9169-4548-a9c4-19698ff4b095",
                                "sense_id": "af8734c6-3ba3-3f99-8699-d10cdfbee2ef",
                                "text": "Sowohl Martin als auch Marianne bekamen eine Eintragung im Klassenbuch."
                            },
                            {
                                "example_id": "f723daaa-3b85-4bf2-9384-32d090bade48",
                                "sense_id": "af8734c6-3ba3-3f99-8699-d10cdfbee2ef",
                                "text": "„Unwillkürlich legte er seine Hände auf den Band unbeschriebenen Papiers, der noch seiner Eintragungen harrte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
