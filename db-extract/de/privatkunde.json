                "senses": [
                    {
                        "sense_id": "c3ec702b-686c-3261-8d1e-70d19ee28bc9",
                        "entry_id": "a478b11d-4804-3a15-a88a-a3c739853cbf",
                        "glosses": [
                            "einzelne Person(en) (Privatpersonen) - im Gegensatz zu Firmen oder Institutionen - als Kunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f803ec80-210f-47e5-8723-2deb1e7343e5",
                                "sense_id": "c3ec702b-686c-3261-8d1e-70d19ee28bc9",
                                "text": "„Grace musste Firmen und Privatkunden davon überzeugen, dass sie ihr Vermögen bei der Investment-Bank UBS anlegen wollten.“"
                            },
                            {
                                "example_id": "f783847d-2f8b-4a8e-8ac7-f880d9451862",
                                "sense_id": "c3ec702b-686c-3261-8d1e-70d19ee28bc9",
                                "text": "„Gerade in der Kapitalanlage noch unerfahrene Privatkunden sollten eher nach Immobilien Ausschau halten, die vom eigenen Wohnort höchstens 100 km entfernt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59595e6b-e33b-4239-894e-65eeeb8b391b",
