                        "entry_id": "70e3851b-ec09-37f5-a3cd-bed6a8faed03",
                        "glosses": [
                            "het gedeelte van een gebouw dat het eigen gewicht van het gebouw plus de krachten die op het gebouw werken naar de draagkrachtige ondergrond overbrengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc601949-c2f6-404b-8170-51861bb134ab",
                                "sense_id": "ce599aec-4f89-32e1-9b74-1e5264a99e2c",
                                "text": "De fundering van het gebouw bestaat uit betonnen heipalen."
                            },
                            {
                                "example_id": "1df9b8e1-3ccd-4c6b-a502-d84c28092ef8",
                                "sense_id": "ce599aec-4f89-32e1-9b74-1e5264a99e2c",
                                "text": "In het Zeeuwse Oost-Souburg is de bouw van een nieuwe school stilgelegd, nadat was ontdekt dat de fundering en het skelet van het gebouw 180 graden zijn gedraaid ten opzichte van de tekeningen. Dat maakt de basisschool, de Tweemaster-Kameleon, bekend in een brief aan de ouders."
                            }
                        ]
                    },
