                                        "glosses": [
                                            "drążek albo listwa nad drzwiami lub oknem służące do zawieszania portier, firanek, zasłon itp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa61d20-dad0-4f45-9e7e-3b2b46f2899f",
                                                "sense_id": "97c4d244-93a3-3510-b90c-8d45f4f34e35",
