                        "entry_id": "f5d4c885-2148-36aa-a34b-e27b23d70a51",
                        "glosses": [
                            "geschmückter Platz vornehmer römischer Häuser von der Straße bis zur Haustür"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f087d14c-788e-4a1d-b614-cae4e5c65906",
                                "sense_id": "cd5a784b-0327-3ad3-8bc7-597bf328caa8",
                                "text": "Nicht immer gibt es das Vestibulum, den äußeren Hausflur, nur wo die Haustür nicht unmittelbar an der Straße liegt, heißt so der unverschlossene Raum zwischen ihr und der Straße."
                            }
                        ],
