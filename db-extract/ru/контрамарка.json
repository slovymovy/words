                                        "glosses": [
                                            "Seconde marque apposée à un ballot de marchandises ou à des ouvrages d’or et d’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0d8cc8-5e42-472e-a338-939e7815e9bc",
                                                "sense_id": "5bc7cdef-b3d2-3217-b60d-6bae6206611d",
                                                "text": "Mettre une contremarque à un ballot. - Faire une contremarque à de la vaisselle d’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e1513bc-f69f-3cac-b4d7-ca5d5437a737",
                                        "entry_id": "31bee02a-21bb-3116-96ba-46f915033c84",
                                        "glosses": [
                                            "Marque secondaire de distributeur créée pour séparer les produits d'une marque principale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec110a61-35dc-33f5-bcf4-202363e808fc",
                                        "entry_id": "31bee02a-21bb-3116-96ba-46f915033c84",
                                        "glosses": [
                                            "Second billet que délivrent les contrôleurs d’un théâtre à ceux qui sortent pendant le spectacle, afin qu’ils aient la faculté de rentrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44952253-ea6b-4f3e-8a1b-bdfa6de0de68",
                                                "sense_id": "ec110a61-35dc-33f5-bcf4-202363e808fc",
                                                "text": "Prenez une contremarque en sortant."
                                            },
                                            {
                                                "example_id": "c7fc499c-c7f0-4ee6-bbed-a79a19e61f2c",
                                                "sense_id": "ec110a61-35dc-33f5-bcf4-202363e808fc",
                                                "text": "Il n’y a pas de contrôleur à la porte pour prendre vos billets, mais un petit garçon vient vous les demander avant la fin du spectacle ; on ne vous prend à la première porte qu’une contremarque d’entrée générale."
                                            },
                                            {
                                                "example_id": "d629cd1b-6ad9-428b-a287-d2a6f6df6968",
                                                "sense_id": "ec110a61-35dc-33f5-bcf4-202363e808fc",
                                                "text": "On lui montra la place où elle avait stationné en face d’un bistrot fréquenté par des vendeurs de contremarques."
                                            }
                                        ]
                                    }
                                ]
                            },
