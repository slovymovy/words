                                            {
                                                "example_id": "f9d98170-03f4-415f-96a5-bb42090f81e3",
                                                "sense_id": "96c7aeb1-95cb-3110-b25e-44fbdc63ec12",
                                                "text": "Viele Populärwissenschaftler prognostizieren eine weltweite Klimakatastrophe."
