                ],
                "senses": [
                    {
                        "sense_id": "016e9513-7ba8-39f1-b3fe-3df43556d0c6",
                        "entry_id": "4c235cdb-661a-35d7-89ef-455755a397d9",
                        "glosses": [
                            "plötzlicher Tod von vielen Lebewesen in einem kurzen Zeitraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41bb0d75-7504-429c-b71c-93a3384150b2",
                                "sense_id": "016e9513-7ba8-39f1-b3fe-3df43556d0c6",
                                "text": "Für das Massensterben der Dinosaurier waren vermutlich ein Meteoriteneinschläge und Vulkanausbrüche verantwortlich."
                            },
                            {
                                "example_id": "25c65813-1cbc-4d13-a2f8-4541a76de65d",
                                "sense_id": "016e9513-7ba8-39f1-b3fe-3df43556d0c6",
                                "text": "Bei Menschen entsteht Massensterben zum Beispiel durch Seuchen wie der Pest."
                            },
                            {
                                "example_id": "3f7780a7-f98c-43c9-b149-03f2a34f65d4",
                                "sense_id": "016e9513-7ba8-39f1-b3fe-3df43556d0c6",
                                "text": "Wenn Öltanker sinken (und Öl austritt), gibt es meist ein Massensterben von Fischen."
                            },
                            {
                                "example_id": "3bf79521-56f0-4a7d-9149-283fbb01fb07",
                                "sense_id": "016e9513-7ba8-39f1-b3fe-3df43556d0c6",
                                "text": "„Das Massensterben förderte die Verbreitung von Verschwörungstheorien.“"
                            },
                            {
                                "example_id": "9a72e0d2-cb0c-40f0-8ea9-d584a9ac87eb",
                                "sense_id": "016e9513-7ba8-39f1-b3fe-3df43556d0c6",
                                "text": "„Schritt um Schritt kamen die Forscher dem vermutlich größten Massensterben der Menschheitsgeschichte auf die Spur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
