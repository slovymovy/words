                "senses": [
                    {
                        "sense_id": "629378bf-8b52-33c8-b84a-27e574cb43f9",
                        "entry_id": "a77139f7-6f94-341f-9243-a6114c4629e9",
                        "glosses": [
                            "Faire perdre son caractère chouan à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2eab8af-68e7-4158-a985-eb0a09b4ee3b",
                                "sense_id": "629378bf-8b52-33c8-b84a-27e574cb43f9",
                                "text": "Le gouvernement républicain qui, en vertu du concordat, détient les nominations épiscopales, compte bien se servir de cette arme pour « déchouanner » le pays et y asseoir plus solidement le régime républicain dans l’opinion."
                            },
                            {
                                "example_id": "ffcbe495-a050-4183-9777-e0f0f96d5aa3",
                                "sense_id": "629378bf-8b52-33c8-b84a-27e574cb43f9",
                                "text": "Paraît que v’z’êtes venu pour nous déchouanner, mais un vieux chouan comme ma vous n’le déchouannerez pas !"
                            }
                        ]
                    }
                ],
