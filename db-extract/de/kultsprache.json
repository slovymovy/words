                "senses": [
                    {
                        "sense_id": "1ae8ae46-940f-33ae-b923-27a15ce5324d",
                        "entry_id": "52520a06-aa14-3bd3-a5c6-8d38276874d9",
                        "glosses": [
                            "Sprache, die für kultische Zwecke verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46508e1d-1984-4f48-a25c-e0484ff318ec",
                                "sense_id": "1ae8ae46-940f-33ae-b923-27a15ce5324d",
                                "text": "„Danach fungierte es nur mehr als Sprache der Heiligen Schrift, als priesterliche Kultsprache und als Bildungssprache der jüdischen Elite. “"
                            },
                            {
                                "example_id": "ad785288-76e2-4f1f-b40e-d48290c17045",
                                "sense_id": "1ae8ae46-940f-33ae-b923-27a15ce5324d",
                                "text": "„Mit der Kultsprache verbunden ist eine besondere Funktion zum Schutz des Heiligen.“"
                            },
                            {
                                "example_id": "dbbfc870-4fd9-4830-aa44-cadc739cc2e9",
                                "sense_id": "1ae8ae46-940f-33ae-b923-27a15ce5324d",
                                "text": "„Gerade der Unterschied zwischen den hebräischen Namen in den Graffiti aus der Synagoge und den mehrheitlich deutschen Namen auf den Namenslisten der Archäologischen Zone zeigt, dass Hebräisch als Kultur- und Kultsprache verwendet wurde, parallel zur Verwendung von Latein in der christlichen Gesellschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
