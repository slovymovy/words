                                        "entry_id": "b2fbab09-ae56-3d03-a84d-194c94bff3ad",
                                        "glosses": [
                                            "das Datum für die Rückgabe der Schulden in die Zukunft verschieben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd3fdc3-9be6-4ffb-9e79-ca19ba3c12bd",
                                                "sense_id": "a3f301ad-19c6-302d-bc48-703a85f1c1e8",
                                                "text": "Ich bitte Sie, mir die Zahlung der Rechnung bis Ende des nächsten Monats zu stunden."
                                            },
                                            {
                                                "example_id": "3ace902f-7a07-4fb8-b5bb-45c5ec14c36e",
                                                "sense_id": "a3f301ad-19c6-302d-bc48-703a85f1c1e8",
                                                "text": "Kannst du mir den Deckel stunden, bis ich wieder Geld habe?"
                                            }
                                        ],
