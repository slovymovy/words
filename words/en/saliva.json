{
    "word_family": [
        "salivary",
        "salivate",
        "salivation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac8343e2-81e3-3db3-95db-ebd7e401e902",
                    "sense_definition": "A clear, slightly alkaline liquid secreted into the mouth by the salivary glands, which moistens the mouth and begins the digestion of food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bodily_fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>saliva</w> in the mouth helps to break down food during the process of chewing.",
                            "target_lang_translations": {
                                "zh": "口腔中的<w>唾液</w>有助于在咀嚼过程中分解食物。"
                            }
                        },
                        {
                            "text": "Excessive <w>saliva</w> production can sometimes be a sign of a medical condition.",
                            "target_lang_translations": {
                                "zh": "分泌过多的<w>唾液</w>有时可能是某种疾病的征兆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spit",
                        "spittle",
                        "slobber"
                    ],
                    "common_phrases": [
                        "excessive saliva",
                        "produce saliva"
                    ],
                    "target_lang_definitions": {
                        "zh": "由唾液腺分泌到口腔中的一种透明、微碱性的液体，用于湿润口腔并开始食物的消化。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唾液",
                                "target_lang_sense_clarification": "医学或正式用语，指口腔分泌的液体。"
                            },
                            {
                                "target_lang_word": "口水",
                                "target_lang_sense_clarification": "日常口语，指口腔分泌的液体。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a1a2e34d-7050-3bb4-ae3b-1020ccc9cbfe",
                    "sense_definition": "An alternative form of the <w>Saliba</w> language.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "languages",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Some linguists refer to the indigenous language of the region as <w>Saliva</w>.",
                            "target_lang_translations": {
                                "zh": "一些语言学家将该地区的土著语言称为<w>萨利瓦语</w>。"
                            }
                        },
                        {
                            "text": "Documentation of the <w>Saliva</w> language is limited to a few academic studies.",
                            "target_lang_translations": {
                                "zh": "关于<w>萨利瓦语</w>的文献记录仅限于少数几项学术研究。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "萨利瓦语，一种原住民语言的名称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "萨利瓦语",
                                "target_lang_sense_clarification": "指代该特定语言的名称。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}