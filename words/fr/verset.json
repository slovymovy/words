    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50d9b8e0-e61e-3c95-97b4-1611e65701b8",
                    "sense_definition": "Petite division numérotée d'un texte religieux, en particulier de la Bible ou du Coran.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre a lu un court <w>verset</w> de l'Évangile avant de commencer son sermon."
                        },
                        {
                            "text": "Elle connaît chaque <w>verset</w> de ce psaume par cœur depuis son enfance."
                        }
                    ],
                    "common_phrases": [
                        "verset biblique",
                        "citer un verset"
                    ]
                },
                {
                    "sense_id": "a1c6370a-00ad-38eb-a76e-7fb81cd79fe6",
                    "sense_definition": "Paroles ou formule liturgique tirée de l'Écriture, récitée ou chantée pendant un office religieux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liturgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chorale a entonné le premier <w>verset</w> avant que l'assemblée ne réponde."
                        },
                        {
                            "text": "Le célébrant alterne les <w>versets</w> avec les répons de l'assemblée des fidèles."
                        }
                    ],
                    "common_phrases": [
                        "verset et répons"
                    ]
                },
                {
                    "sense_id": "febc478d-4ff6-357e-a8f6-c37821145d96",
                    "sense_definition": "Division ou court paragraphe dans un texte littéraire ou poétique, analogue au verset des écrits sacrés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce poème en prose est composé de longs <w>versets</w> au rythme particulièrement ample."
                        },
                        {
                            "text": "L'écrivain découpe son texte en <w>versets</w> pour lui donner une dimension solennelle."
                        }
                    ],
                    "common_phrases": [
                        "verset poétique"
                    ]
                },
                {
                    "sense_id": "3c887451-91d8-336b-bde0-e7e005a1cee5",
                    "sense_definition": "Diminutif de <w>vers</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète a glissé un humble <w>verset</w> dans sa lettre d'amitié."
                        },
                        {
                            "text": "Elle composait de jolis petits <w>versets</w> pour amuser ses enfants le soir."
                        }
                    ]
                },
                {
                    "sense_id": "86d3cf17-4987-3022-bef7-7be46eeddde0",
                    "sense_definition": "Signe typographique en forme de V barré (℣) servant à indiquer le début d'un verset dans les livres liturgiques.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce missel ancien, chaque prière est précédée d'un <w>verset</w> soigneusement gravé."
                        },
                        {
                            "text": "L'imprimeur a inséré le caractère spécial du <w>verset</w> au début de la strophe."
                        }
                    ]
                }
            ]
        }
    ]
