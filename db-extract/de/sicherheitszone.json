                "senses": [
                    {
                        "sense_id": "2d2e8211-7dcb-3e06-a760-37184c835b6d",
                        "entry_id": "cb80af52-7f6d-3a92-980e-c2ee40e8c608",
                        "glosses": [
                            "besonders geschützte, stark abgesicherte Zone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e07ac69d-f6b2-4800-b1cb-14cff1e08d7e",
                                "sense_id": "2d2e8211-7dcb-3e06-a760-37184c835b6d",
                                "text": "„Sie hatten Befehl, sich am Ostrand des Städtchens irgendwo gut geschützt einzunisten, hoch genug, um das letzte Dorf an der Überlandstraße überschauen zu können, wo die gesäuberte Sicherheitszone endete.“"
                            },
                            {
                                "example_id": "24e3a970-c578-4303-a280-b07f8f0a0ede",
                                "sense_id": "2d2e8211-7dcb-3e06-a760-37184c835b6d",
                                "text": "„Und hier war man mittendrin in einer blühenden, reglementierten Sicherheitszone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
