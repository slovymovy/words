                    {
                        "sense_id": "4ada393b-f51a-3b33-bff8-f409acba8599",
                        "entry_id": "97d97e25-90eb-3eb9-b9d7-e393223a60dd",
                        "glosses": [
                            "To install a boardwalk over."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab38f31-c1e2-4c39-af0a-752d7a58f280",
                                "sense_id": "4ada393b-f51a-3b33-bff8-f409acba8599",
                                "text": "A footpath would be boardwalked across the east meadow and would minimize compaction."
                            },
                            {
                                "example_id": "01a06b30-8458-464d-b2cb-f1038f5c0f0b",
                                "sense_id": "4ada393b-f51a-3b33-bff8-f409acba8599",
                                "text": "The state Forestry Division is boardwalking the Alaka‘i Swamp Trail to prevent damage to its fragile ecosystem, and, as of this writing, they had completed all but a mile."
                            },
                            {
                                "example_id": "8e449e5a-2ac1-401d-bd82-59ef6bc9455e",
                                "sense_id": "4ada393b-f51a-3b33-bff8-f409acba8599",
                                "text": "An 18-km trail, 65 fences now stiled, electric wires at the cross-points sheaved with PVC, the swamp boardwalked, the drainage canals bridged, the signage in place."
                            }
                        ]
                    }
