                                        "entry_id": "a06e055e-f3b0-3645-bfa5-b822a3c9cc93",
                                        "glosses": [
                                            "A trial held for appearance's sake, but whose verdict is predetermined, especially a \\\"guilty\\\" verdict with the purpose of making an example of the accused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ffc57b4-82e5-42d3-8cf2-b6e7c676ce3b",
                                                "sense_id": "3758b8da-918d-3bcd-91f9-2dbf02cc938f",
                                                "text": "We demand an end to these \"Revere\" showtrials. The indictments were drawn through forced testimony of gay youth and coerced testimony of gay men. The indictments were inspired by those seeking to use homophobia for political purposes. The trial is now being used by those who would exploit hatred of homsexuals."
                                            }
                                        ]
                                    }
                                ]
