                    {
                        "sense_id": "72b8292e-1dfc-3d15-9023-4863d7884bcb",
                        "entry_id": "8e7e9bca-ee19-3baf-bc13-6925e7b02824",
                        "glosses": [
                            "Oiseau paléognathe apparenté à l’autruche, incapable de voler, et appartenant à l’ordre des rhéiformes et au genre Rhea, dont il existe deux espèces distribuées en Amérique du Sud au sud de l’Équateur : le nandou d’Amérique et le nandou de Darwin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3391061-d0c8-4a07-b49b-4be16f012df4",
                                "sense_id": "72b8292e-1dfc-3d15-9023-4863d7884bcb",
                                "text": "La chair du nandou est très-estimée, et Thalcave tenait à fournir son plat au repas commun."
                            },
                            {
                                "example_id": "773d3e58-1d71-426f-b8c2-1a6b097e1714",
                                "sense_id": "72b8292e-1dfc-3d15-9023-4863d7884bcb",
                                "text": "Le nandou, n’est pas recommandé à titre d’oiseau de boucherie."
                            }
                        ]
                    }
                ],
                "translations": [
