                {
                    "sense_id": "9b2e4765-4b47-3f2c-8e10-fe780f0d3a62",
                    "sense_definition": "W sposób wyraźny, widoczny i łatwy do zauważenia lub zrozumienia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wniosek ten wynika <w>oczywiście</w> z przedstawionych wcześniej danych.",
                            "target_lang_translations": {
                                "ru": "Этот вывод <w>очевидно</w> следует из представленных ранее данных.",
                                "en": "This conclusion <w>obviously</w> follows from the data presented earlier.",
                                "nl": "Deze conclusie volgt <w>duidelijk</w> uit de eerder gepresenteerde gegevens.",
                                "de": "Diese Schlussfolgerung ergibt sich <w>offensichtlich</w> aus den zuvor präsentierten Daten.",
                                "fr": "Cette conclusion découle <w>évidemment</w> des données présentées précédemment.",
                                "it": "Questa conclusione deriva <w>evidentemente</w> dai dati presentati in precedenza.",
                                "cs": "Tento závěr <w>očividně</w> vyplývá z dříve předložených údajů.",
                                "tr": "Bu sonuç <w>açıkça</w> daha önce sunulan verilerden kaynaklanmaktadır.",
                                "es": "Esta conclusión se deriva <w>evidentemente</w> de los datos presentados anteriormente.",
                                "zh": "这一结论<w>明显</w>是从之前提供的数据中得出的。"
                            }
                        },
                        {
                            "text": "Problem nie przedstawia się tak <w>oczywiście</w>, jak mogłoby się wydawać na pierwszy rzut oka.",
                            "target_lang_translations": {
                                "ru": "Проблема представляется не так <w>очевидно</w>, как могло бы показаться на первый взгляд.",
                                "en": "The problem is not as <w>obvious</w> as it might seem at first glance.",
                                "nl": "Het probleem is niet zo <w>duidelijk</w> als het op het eerste gezicht lijkt.",
                                "de": "Das Problem stellt sich nicht so <w>offensichtlich</w> dar, wie es auf den ersten Blick scheinen mag.",
                                "fr": "Le problème ne se présente pas aussi <w>clairement</w> qu'il pourrait y paraître au premier abord.",
                                "it": "Il problema non si presenta in modo così <w>evidente</w> come potrebbe sembrare a prima vista.",
                                "cs": "Problém se nejeví tak <w>očividně</w>, jak by se mohlo na první pohled zdát.",
                                "tr": "Sorun ilk bakışta göründüğü kadar <w>açık</w> değil.",
                                "es": "El problema no se presenta tan <w>claramente</w> como podría parecer a primera vista.",
                                "zh": "这个问题并不像乍看之下那么<w>显而易见</w>。"
                            }
