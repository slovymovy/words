                        "examples": [
                            {
                                "example_id": "c794dba8-15f9-46df-9de1-3b8c94136e55",
                                "sense_id": "8e3e631b-5f8f-3b60-8a16-2fdbf77cb1ae",
                                "text": "When Washtucna Coulee could not contain the great surge, floodwaters rose to make one of the most significant records on the entire plateau. In two places, they topped the divide between the nearly parallel preglacial Palouse and Snake valleys, crossing it to enter the Snake Canyon. They swept away a loessial cover more than 100 feet thick from 80 square miles of summit area and scored the basalt thus exposed into a congeries of canyons, cataracts, and rock basin."
                            }
