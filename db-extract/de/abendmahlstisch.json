                "senses": [
                    {
                        "sense_id": "56f216d5-b5fd-3d54-83ab-fdaaede27c76",
                        "entry_id": "32bfc08a-5e2e-3eb2-bb27-e9e21e305ca5",
                        "glosses": [
                            "Tisch, an dem evangelischer Gottesdienst (Abendmahl) gefeiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70621488-b1ac-44c9-ab09-3e01869abd79",
                                "sense_id": "56f216d5-b5fd-3d54-83ab-fdaaede27c76",
                                "text": "„Vom Abendmahlstisch aus hielt Billy Graham vor nahezu leeren Bänken eine Ansprache, während sich in der Stadt die Leute um Eintrittskarten für seine ersten Massenversammlungen in der Glasgower »Kelvin-Halle« schlugen.“"
                            },
                            {
                                "example_id": "ee9f8ece-4c5f-40c8-bfb7-4901f053a6f4",
                                "sense_id": "56f216d5-b5fd-3d54-83ab-fdaaede27c76",
                                "text": "„Um den Tischcharakter des Abendmahlstisches zu betonen, haben viele Kirchen reformierter und kongregationalistischer Prägung hinter dem Tisch Sitzgelegenheiten aufgestellt.“"
                            }
                        ],
