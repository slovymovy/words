                "senses": [
                    {
                        "sense_id": "0c71d34a-b922-3d5d-b234-93fbd74bc15b",
                        "entry_id": "05d83800-9f6c-362b-8285-45cecf7e8307",
                        "glosses": [
                            "женск. к лгун"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6915afb-3945-49de-9343-d6539b98fff6",
                                "sense_id": "0c71d34a-b922-3d5d-b234-93fbd74bc15b",
                                "text": "Я абсолютная лгунья, которой ничего не стоит переступить через любую правду."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b511a181-1491-45c2-8ee0-72dccba410c6",
                        "source_entry_id": "05d83800-9f6c-362b-8285-45cecf7e8307",
                        "source_sense_id": "0c71d34a-b922-3d5d-b234-93fbd74bc15b",
                        "target_lang_word": "menteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "534a25b3-ee81-3aa6-beb5-2466e111ce22",
                                        "entry_id": "3141b26f-233c-34fe-a966-d7b4e231c3b4",
                                        "glosses": [
                                            "Personne qui ment, qui a l’habitude de mentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eed07d2-c389-4935-8239-a482ca07063c",
                                                "sense_id": "534a25b3-ee81-3aa6-beb5-2466e111ce22",
                                                "text": "Pour ne pas te faire de peine, je ne suis pas une menteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b3b19b7-74ff-3a70-bff7-308d90e8dde8",
                                        "entry_id": "3141b26f-233c-34fe-a966-d7b4e231c3b4",
                                        "glosses": [
                                            "Langue (organe de la parole et donc du mensonge)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ce1e40-5ec3-487f-85f5-c701c0509a92",
                                                "sense_id": "4b3b19b7-74ff-3a70-bff7-308d90e8dde8",
                                                "text": "Quelquefois de l’esprit de vaudeville : … la menteuse (la langue) ; et puis partout, à chaque instant, des mots bizarres, mystérieux, laids et sordides, venus on ne sait d’où …."
                                            },
                                            {
                                                "example_id": "b30cf0c9-e83c-40f8-bd24-34fa0a5dc991",
                                                "sense_id": "4b3b19b7-74ff-3a70-bff7-308d90e8dde8",
                                                "text": "— D’autant plus que...\nElle se fait un nœud à la menteuse. Ce qui reste à bonnir passe mal …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a6889cb-e8e1-337f-8cc9-b5b8697e9b79",
                                        "entry_id": "04f61a9c-b4b8-3e6a-87fc-be5c1a89e71c",
                                        "glosses": [
                                            "Féminin singulier de menteur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e562d327-ad01-4e89-8220-10536f65e10d",
                                                "sense_id": "9a6889cb-e8e1-337f-8cc9-b5b8697e9b79",
                                                "text": "À lire absolument pour l’apologie des grands-parents maternels polytoxicos solidement rétablis et pour l’hymne d’amour à la mère indigne alcoolo, voleuse, menteuse, violente, abusive, droguée, irrécupérable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
