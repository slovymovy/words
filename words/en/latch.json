                            },
                            {
                                "target_lang_word": "门扣",
                                "target_lang_sense_clarification": "泛指可扣住门的机械装置"
                            },
                            {
                                "target_lang_word": "插销",
                                "target_lang_sense_clarification": "自动卡住的扣合装置"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "petlice",
                                "target_lang_sense_clarification": "kovový uzávěr dveří"
                            },
                            {
                                "target_lang_word": "západka",
                                "target_lang_sense_clarification": "pohyblivá součástka k zajištění dveří"
                            },
                            {
                                "target_lang_word": "závora",
                                "target_lang_sense_clarification": "tyč sloužící k uzamčení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f19373b-176a-335c-83eb-8a265d925a8b",
                    "sense_definition": "The manner in which a baby identifies and attaches to the breast for breastfeeding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breastfeeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good <w>latch</w> is essential for comfortable and successful breastfeeding.",
                            "target_lang_translations": {
                                "ru": "Правильный <w>захват</w> необходим для комфортного и успешного грудного вскармливания.",
                                "zh": "良好的<w>含乳</w>对舒适而成功的母乳喂养至关重要。",
                                "cs": "Správné <w>přisátí</w> je nezbytné pro pohodlné a úspěšné kojení."
                            }
                        },
                        {
                            "text": "The lactation consultant checked the infant's <w>latch</w> to ensure proper feeding.",
                            "target_lang_translations": {
                                "ru": "Консультант по лактации проверила <w>прикладывание</w> младенца, чтобы обеспечить правильное кормление.",
                                "zh": "泌乳顾问检查了婴儿的<w>含乳</w>情况，以确保喂养方式正确。",
                                "cs": "Laktační poradkyně zkontrolovala <w>přisátí</w> dítěte, aby zajistila správné krmení."
                            }
                        }
                    ],
                    "common_phrases": [
