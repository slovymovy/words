            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d91eb7d-3e44-342d-a3de-aa791e2e45ba",
                    "sense_definition": "Changement ou altération de la forme ou des dimensions d'un objet sous l'effet d'une contrainte physique ou thermique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "forme_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chaleur intense a provoqué une <w>déformation</w> visible du cadre en plastique."
                        },
                        {
                            "text": "Ce nouveau matériau est capable d'absorber les chocs sans subir de <w>déformation</w> permanente."
                        }
                    ],
                    "synonyms": [
                        "altération",
                        "distorsion"
                    ],
                    "common_phrases": [
                        "déformation plastique",
                        "déformation élastique"
                    ]
                },
                {
                    "sense_id": "065036c4-fe98-37ea-9451-3777520d8ec8",
                    "sense_definition": "Altération ou modification abusive du sens, de la vérité ou de la réalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet article présente une fâcheuse <w>déformation</w> de la réalité pour attirer l'attention des lecteurs."
                        },
                        {
                            "text": "Le témoin a dénoncé une <w>déformation</w> grossière de ses propos dans la presse."
                        }
                    ],
                    "synonyms": [
                        "dénaturation",
                        "travestissement",
                        "altération"
                    ],
                    "antonyms": [
                        "fidélité"
                    ],
                    "common_phrases": [
                        "déformation professionnelle",
                        "déformation de la réalité",
                        "déformation des faits"
                    ]
                },
                {
                    "sense_id": "e03161f2-08bc-3b1e-bbfe-ee7d5a55039e",
                    "sense_definition": "Anomalie ou altération de la structure et de la forme d'un organe ou d'une partie du corps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une mauvaise posture prolongée devant l'ordinateur peut causer une <w>déformation</w> du dos."
                        },
                        {
                            "text": "Le spécialiste lui a recommandé le port de semelles adaptées pour corriger cette <w>déformation</w> du pied."
                        }
                    ],
                    "synonyms": [
                        "malformation",
                        "difformité"
                    ],
                    "common_phrases": [
                        "déformation de la colonne vertébrale"
                    ]
                }
            ]
        }
    ]
