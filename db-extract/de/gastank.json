                        "glosses": [
                            "Behälter zur Lagerung von Gas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88d3758c-e4da-4656-aad6-344fcc0f4204",
                                "sense_id": "1da3ca15-b4de-332c-93f3-1f163cf631b1",
                                "text": "Der Gastank wurde wegen einer defekten Dichtung außer Betrieb genommen."
                            },
                            {
                                "example_id": "1c824fe9-8e52-4129-9b8b-9feb111791ed",
                                "sense_id": "1da3ca15-b4de-332c-93f3-1f163cf631b1",
                                "text": "„Vor allem Aussagen von Feuerwehrleuten nährten den Verdacht, dass es sich lediglich um einen Unfall mit einem Gastank in einem nahen Gebäude gehandelt haben könnte.“"
                            }
                        ],
