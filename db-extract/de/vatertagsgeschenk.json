                "senses": [
                    {
                        "sense_id": "63828a0d-a167-3333-b18d-98968a073ee3",
                        "entry_id": "4d556b34-b7dd-391e-a33c-e64f18102084",
                        "glosses": [
                            "Geschenk zum Vatertag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f8f3a5b-29b0-4aa9-8ab7-4add54a131c7",
                                "sense_id": "63828a0d-a167-3333-b18d-98968a073ee3",
                                "text": "„Sie suchen in der weiten Welt ein Vatertagsgeschenk für Bush senior.“"
                            },
                            {
                                "example_id": "42510d61-2eef-4220-99ff-bde835e02822",
                                "sense_id": "63828a0d-a167-3333-b18d-98968a073ee3",
                                "text": "»Es war einfach. Carolyn, Edward und ich haben uns hingesetzt, um über dein Vatertagsgeschenk zu sprechen, und jeder hat einen Vorschlag auf einen Zettel geschrieben, und auf allen dreien stand das Gleiche: ›Segelboot‹.«"
                            },
                            {
                                "example_id": "40ef455d-fdf8-44e2-8626-0591dd6ee08b",
                                "sense_id": "63828a0d-a167-3333-b18d-98968a073ee3",
                                "text": "„Das Vatertagsgeschenk mit der noch unsicher gekritzelten Aufschrift «Danke, Papi», das Babyfoto des Sohnes auf dem Schreibtisch, der selbstgetöpferte Aschenbecher von der damals siebenjährigen Tochter.“"
                            },
                            {
                                "example_id": "939696af-b60f-4bad-94f5-88025af28278",
                                "sense_id": "63828a0d-a167-3333-b18d-98968a073ee3",
                                "text": "„Du könntest das beste Vatertagsgeschenk sein, dass er jemals von mir bekommen wird.“"
                            },
                            {
                                "example_id": "24f1e6f8-f6c9-4ccb-baf6-20a3efd1d7ea",
                                "sense_id": "63828a0d-a167-3333-b18d-98968a073ee3",
                                "text": "„Ein spezielles, wenn auch kostspieliges Vatertagsgeschenk: Eine Reise zum Grand Prix von Österreich mit dem Kaiserzug kostet 790 € (Inklusive Essen, Getränke).“"
                            },
                            {
                                "example_id": "057b875b-dc3d-4e8f-901b-f86c61ba7b9c",
                                "sense_id": "63828a0d-a167-3333-b18d-98968a073ee3",
                                "text": "„Außerdem und [sic!] ist [die Rasierseife] ein originelles Vatertagsgeschenk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
