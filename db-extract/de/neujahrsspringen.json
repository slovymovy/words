                "senses": [
                    {
                        "sense_id": "4dc60c89-3d26-3d19-8913-408741022d22",
                        "entry_id": "cb403c88-851e-3fe5-889a-e78bb29fd481",
                        "glosses": [
                            "Veranstaltung, die am Neujahrstag in Garmisch-Partenkirchen als Teil der Vierschanzentournee ausgetragen wird"
                        ],
                        "tags": [
                            "Skispringen"
                        ],
                        "examples": [
                            {
                                "example_id": "8565297a-27da-429f-8392-008f502fb2c9",
                                "sense_id": "4dc60c89-3d26-3d19-8913-408741022d22",
                                "text": "„Der Österreicher Thomas Diethart hat das Neujahrsspringen in Garmisch-Partenkirchen gewonnen und damit auch die Führung in der Gesamtwertung übernommen.“"
                            },
                            {
                                "example_id": "0c7dd8ee-60fb-4ace-8172-5c7f0f7808c9",
                                "sense_id": "4dc60c89-3d26-3d19-8913-408741022d22",
                                "text": "„Die deutschen Skispringer haben den erhofften Befreiungsschlag beim Neujahrsspringen der Vierschanzentournee verpasst und spielten erneut nur eine Nebenrolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
