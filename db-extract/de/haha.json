                ],
                "translations": [
                    {
                        "translation_id": "c5556fbf-c85f-4b3e-b364-a192a20db038",
                        "source_entry_id": "9375365e-d220-3fc3-9968-1f30dce46825",
                        "source_sense_id": "7c8380c3-8aa8-3dbf-b564-f3b5a3d0c1ad",
                        "source_sense_description": "Ausruf, der Lachen imitiert",
                        "target_lang_word": "haha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haha",
