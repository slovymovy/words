                        "form": "die Metallschicht"
                    },
                    {
                        "form_id": "03ec38e3-630d-4a81-9311-c601c3400644",
                        "entry_id": "4ac539af-f69f-3102-accd-dc11b619737e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Metallschichten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07e81a63-21cf-3e96-aa84-a380e728a66e",
                        "entry_id": "4ac539af-f69f-3102-accd-dc11b619737e",
                        "glosses": [
                            "Schicht aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d5a91e-bcba-4959-9466-9e4dfb019814",
                                "sense_id": "07e81a63-21cf-3e96-aa84-a380e728a66e",
                                "text": "„Der US-Hardwarekonzern IBM will einen CMOS-Chip entwickeln, der sich auf ein bestimmtes Signal hin auflöst. Als Trägermaterial soll Glas dienen, das mit einer reaktiven Metallschicht oder einer Art Zündschnur ausgestattet ist.“"
                            },
                            {
                                "example_id": "a3852566-03ea-40c4-a067-1a7dc4890408",
                                "sense_id": "07e81a63-21cf-3e96-aa84-a380e728a66e",
                                "text": "„Der Anti-Drone Scarf etwa, an den muslimischen Schleier erinnernd, hat eine Metallschicht, die gegen Wärmebildtechnik abschirmt, damit einen zum Beispiel Drohnen nicht erkennen.“"
                            },
                            {
                                "example_id": "fb671b3e-28f1-4c16-a0fa-eca9e07d7f18",
                                "sense_id": "07e81a63-21cf-3e96-aa84-a380e728a66e",
                                "text": "„Betastrahler senden Elektronen (oder deren positiv geladene Gegenstücke) aus – leichte Teilchen, die weniger stark abgebremst werden als Alphapartikel. Dünne Metallschichten schirmen sie effizient ab.“"
                            },
                            {
                                "example_id": "5e32c980-0c12-4eb3-b3e9-0e475a1a808d",
                                "sense_id": "07e81a63-21cf-3e96-aa84-a380e728a66e",
                                "text": "„LiFePO4 besitzt von Natur aus wünschenswerte Eigenschaften, wie etwa thermische Stabilität, jedoch keine besonders gute elektrische Leitfähigkeit – sowohl für Elektronen als auch für Lithiumionen. Inzwischen wurden zahlreiche Methoden entwickelt, um deren Transport innerhalb des Materials und an dessen Oberfläche zu verbessern. Beispielsweise mittels eines Überzugs aus Kohlenstoff oder einer Metallschicht, aber auch durch eine Dotierung mit Fremdatomen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
