                ],
                "senses": [
                    {
                        "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                        "entry_id": "414abc86-c801-3051-a9f4-c32583357b51",
                        "glosses": [
                            "Person oder Sache, die maßgeblich an einem Schaden/einem Problem beteiligt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd47400-5964-4248-a4a5-6af993bc0595",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Die Teerstoffe im Tabakrauch […] gelten als die Hauptverursacher des Lungenkrebses.“"
                            },
                            {
                                "example_id": "a36e8fc6-85fb-4dd4-bf81-ceb42f6fea45",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Husten, Schnupfen und Halsweh – Hauptverursacher sind die Rhinoviren.“"
                            },
                            {
                                "example_id": "131a9a63-9e9a-46b7-b064-49d9db50fd8f",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "[Campylobacter:] „Der Erreger ist inzwischen der Hauptverursacher von bakteriellen Magen-Darm-Infektionen in Deutschland und Europa.“"
                            },
                            {
                                "example_id": "8cee6491-9aba-419e-b916-c1e302652985",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„[Die Firma] Purdue gilt als Hauptverursacher der US-Opioidkrise mit Hunderttausenden Toten.“"
                            },
                            {
                                "example_id": "666bcda8-981e-4b80-b87e-a8e5c47bb5c2",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„CO₂ ist eines der wichtigsten Treibhausgase und Hauptverursacher der menschgemachten globalen Erwärmung.“"
                            },
                            {
                                "example_id": "9c0ad373-8881-4e9f-8962-b1ec4897ebda",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Der Verkehrssektor zählt zu den Hauptverursachern für Treibhausgasemissionen.“"
                            },
                            {
                                "example_id": "d1917fb0-6f89-47b2-8f59-8cfd45058168",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Beim Verkehr – dem Hauptverursacher von CO₂-Emissionen – stiegen die Treibhausgasemissionen im Jahr 2018 an, da der Diesel- und Benzinverbrauch um 0,8 % bzw. 0,2 Millionen Tonnen zugenommen hat.“"
                            },
                            {
                                "example_id": "ed48d8a1-68bb-4453-b14f-eb297000770d",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Hauptverursacher der NO₂-Belastung sind die Emissionen des Kraftfahrzeugverkehrs.“"
                            },
                            {
                                "example_id": "9872ccc4-de67-4342-89fe-cff89fa8b1a7",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Ärmere Länder, die historisch weniger für den Klimawandel verantwortlich sind, sind stärker betroffen als die Hauptverursacher.“"
                            },
                            {
                                "example_id": "0f34ec86-066e-477a-8896-d79adab46cb0",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Darüber hinaus verlangt das Verursacherprinzip auch, dass die Länder des Globalen Nordens als Hauptverursacher des Klimawandels für die Kosten von Anpassungsmaßnahmen und klimawandelbedingte Schäden in Ländern des Globalen Südens aufkommen müssen.“"
                            },
                            {
                                "example_id": "34a0214e-8d30-4892-9e93-744f217ed5b5",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Nicht nur wegen der CO2 Bilanz, auch als Hauptverursacher des weltweiten Artensterbens steht die industrielle Landwirtschaft inzwischen zunehmend in der Kritik.“"
                            },
                            {
                                "example_id": "b13a233c-406a-4524-9da0-0857bb5f69fd",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„»Die industrielle Fleischerzeugung zählt zu den Hauptverursachern von Nitrat im Grundwasser«, erklärt Reinhild Benning von der Deutschen Umwelthilfe […].“"
                            },
                            {
                                "example_id": "fbaed0d3-cb94-44a2-b041-642054f291e2",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„NABU und BUND sehen in chemisch-synthetischen Pflanzenschutzmitteln einen der Hauptverursacher für den Verlust der Biodiversität.“"
                            },
                            {
                                "example_id": "d62bed6c-e6d7-4e4f-a4cc-2241cdeb6134",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„»Denn der Hauptverursacher der Biodiversitätskrise ist, dass wir Arten verlieren, weil die ihren Lebensraum verlieren.«“"
                            },
                            {
                                "example_id": "bfb5d8f3-1a53-4cc8-b526-643d78c785ea",
                                "sense_id": "733edc97-94e0-3933-a302-c9ea93df6639",
                                "text": "„Hauptverursacher für die Geräuschbelastung ist der Flugplatz von Avignon-Caumont, besonders durch seinen Kunstflugbetrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
