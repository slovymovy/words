                "senses": [
                    {
                        "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                        "entry_id": "2a021645-4392-30b0-950c-efe7e24d2898",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d54926-03a5-4d98-892d-a450d9f757e8",
                                "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                                "text": "Frau Schweinle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "418f0945-8aed-439d-8abd-0a76c7a2916b",
                                "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                                "text": "Herr Schweinle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8366a3b8-a41e-4e55-84b8-d25b56514910",
                                "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                                "text": "Die Schweinles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "dd9d4ffb-a133-4380-b813-93a447840073",
                                "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                                "text": "Der Schweinle trägt nie die Pullover, die die Schweinle ihm strickt."
                            },
                            {
                                "example_id": "59863122-103b-4925-b390-8cc0ce34efab",
                                "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schweinle kommt, geht der Herr Schweinle.“"
                            },
                            {
                                "example_id": "ac1f4d94-d9ee-4695-88d1-d6eceb9ace57",
                                "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                                "text": "Schweinle kommt und geht."
                            },
                            {
                                "example_id": "33d9d1a8-c3d6-4dc4-ae7d-ea22e3e7eef7",
                                "sense_id": "381b2ff0-dace-368e-bfa8-395f97ad436d",
                                "text": "Schweinles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
