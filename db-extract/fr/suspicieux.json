                "forms": [
                    {
                        "form_id": "d29e7540-45c0-4778-aa5f-fdf6008c0c42",
                        "entry_id": "aad4e7e9-d5ca-33ad-96fb-89fe3d9c4a5a",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "suspicieuse"
                    },
                    {
                        "form_id": "89f6bc31-4387-4458-bfb9-99834167b5d7",
                        "entry_id": "aad4e7e9-d5ca-33ad-96fb-89fe3d9c4a5a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "suspicieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9de3a403-8ec8-34d4-8046-876ca0dcb22e",
                        "entry_id": "aad4e7e9-d5ca-33ad-96fb-89fe3d9c4a5a",
                        "glosses": [
                            "Qui comporte, révèle de la suspicion, de la méfiance."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "01cedb36-373f-42c8-9ffc-3a86f515b718",
                                "sense_id": "9de3a403-8ec8-34d4-8046-876ca0dcb22e",
                                "text": "Mes démêlés avec la police et l’attitude suspicieuse de mon voisinage m’avaient rendu craintif, avide de sympathies et sociable jusqu'à l’obséquiosité."
                            },
                            {
                                "example_id": "9871ac9f-b7d1-4974-a09d-3f37d05fe913",
                                "sense_id": "9de3a403-8ec8-34d4-8046-876ca0dcb22e",
                                "text": "[…] : moins fermée que la première, la boum de MJC en partageait la musique exclusivement jeune, mais restait beaucoup plus accessible pour les moins âgés ou ceux dont les familles étaient suspicieuses. Elle était, en effet, surveillée par un directeur et se déroulait dans un lieu connu, souvent l'après-midi."
                            },
                            {
                                "example_id": "ea58e698-db81-4bf7-9e1a-948faacc90e5",
                                "sense_id": "9de3a403-8ec8-34d4-8046-876ca0dcb22e",
                                "text": "Alice le regarde, un peu intimidée par le jeune professionnel, et charmée par la politesse de ce visiteur si différent en effet des policiers à la voix rogue, au regard suspicieux, qui l’avaient abrutie de questions jusqu’à dix heures du soir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07194408-9e2b-45fa-a67e-826a3e566dc7",
                        "source_entry_id": "aad4e7e9-d5ca-33ad-96fb-89fe3d9c4a5a",
                        "source_sense_id": "9de3a403-8ec8-34d4-8046-876ca0dcb22e",
                        "target_lang_word": "misstrauisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misstrauisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                        "entry_id": "79cff8a9-c2d0-3e13-b129-8729d0f13b76",
                                        "glosses": [
                                            "jemandem oder etwas nicht trauend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c27475-2e9e-4e28-8e16-c8305c272c5a",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "Er ist ein misstrauischer Mensch."
                                            },
                                            {
                                                "example_id": "f102dd7e-fa18-4c0d-9363-66b824b86f5c",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "Misstrauisch beäugte der Vogel das angebotene Futter."
                                            },
                                            {
                                                "example_id": "0ea64603-9504-4395-8507-f6a2902b167c",
                                                "sense_id": "86d25ef3-84e1-3cc9-8d4e-298fe3c8e31b",
                                                "text": "„Anna war vor misstrauischen Nachbarn und der Gestapo weiter nur durch die dünne Hülle ihrer Tarnung als Muslimin geschützt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d69baf17-b312-46d2-a890-007a1559674a",
                        "source_entry_id": "aad4e7e9-d5ca-33ad-96fb-89fe3d9c4a5a",
                        "source_sense_id": "9de3a403-8ec8-34d4-8046-876ca0dcb22e",
                        "target_lang_word": "argwöhnisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
