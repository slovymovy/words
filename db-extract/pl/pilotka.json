                                    {
                                        "sense_id": "310f01b1-f88e-38ca-abf0-72be64a629b9",
                                        "entry_id": "c98def61-3fcb-3d66-91bc-74c5ac8790c3",
                                        "glosses": [
                                            "weibliche Person, die eine Reisegesellschaft betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191e8e5e-c92e-4df8-a753-01d324dc4486",
                                                "sense_id": "310f01b1-f88e-38ca-abf0-72be64a629b9",
                                                "text": "Die Reiseleiterin zeigte uns alle Sehenswürdigkeiten."
                                            },
                                            {
                                                "example_id": "85b72e76-fe02-48bb-bcf0-d52e188e494e",
                                                "sense_id": "310f01b1-f88e-38ca-abf0-72be64a629b9",
                                                "text": "„Eine Reiseleiterin hält ihren gelben Schirm in die Luft, die Touristen rücken aneinander und lauschen gebannt den Worten der Frau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
