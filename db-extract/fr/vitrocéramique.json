                "senses": [
                    {
                        "sense_id": "ac91c481-24c2-329f-87e7-15b14febfc9d",
                        "entry_id": "0d1d8c13-b955-32eb-a850-140c78a70c2e",
                        "glosses": [
                            "Constitué de microcristaux dispersés dans une phase vitreuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35eef898-5422-471e-b5ae-d8237ea317df",
                                "sense_id": "ac91c481-24c2-329f-87e7-15b14febfc9d",
                                "text": "Ils sont entièrement équipés avec salle de bains et baignoire et une kitchenette ultra moderne avec plaques en vitrocéramique, micro-ondes, cafetière à dosettes, réfrigérateur et mini-lave-vaisselle."
                            },
                            {
                                "example_id": "7aaf9fba-8fbf-40ea-a1b0-2465fd99dd8f",
                                "sense_id": "ac91c481-24c2-329f-87e7-15b14febfc9d",
                                "text": "Sur une plaque vitrocéramique, tout ce qui déborde attache et brûle, il faut le gratter avec une spatule et un nettoyant spécial vitrocéramique."
                            }
                        ]
                    }
                ],
