{
    "word_family": [
        "content",
        "discontent",
        "contentment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a54cdb7e-f9f0-3661-9183-01e213031264",
                    "sense_definition": "Dissatisfied with current conditions or rebellious against authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dissatisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>malcontent</w> workers organized a strike to protest the new management policies.",
                            "target_lang_translations": {
                                "pl": "<w>Niezadowoleni</w> pracownicy zorganizowali strajk, aby zaprotestować przeciwko nowej polityce zarządzania."
                            }
                        },
                        {
                            "text": "He remained <w>malcontent</w> with the government despite the recent economic improvements.",
                            "target_lang_translations": {
                                "pl": "Pozostał <w>niezadowolony</w> z rządu pomimo niedawnej poprawy sytuacji gospodarczej."
                            }
                        }
                    ],
                    "synonyms": [
                        "discontented",
                        "dissatisfied",
                        "disaffected"
                    ],
                    "antonyms": [
                        "content",
                        "satisfied"
                    ],
                    "common_phrases": [
                        "malcontent worker",
                        "malcontent general"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niezadowolony z obecnych warunków lub buntujący się przeciwko władzy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niezadowolony",
                                "target_lang_sense_clarification": "ogólne określenie osoby odczuwającej brak satysfakcji"
                            },
                            {
                                "target_lang_word": "zbuntowany",
                                "target_lang_sense_clarification": "osoba sprzeciwiająca się autorytetom lub zasadom"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "577cdd3c-32eb-3e74-bd7f-351b731bab72",
                    "sense_definition": "A person who is unhappy with the current situation and often rebels against it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dissatisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group of <w>malcontents</w> gathered outside the parliament to voice their anger.",
                            "target_lang_translations": {
                                "pl": "Grupa <w>niezadowolonych</w> zebrała się przed parlamentem, aby wyrazić swój gniew."
                            }
                        },
                        {
                            "text": "Every political movement has its share of <w>malcontents</w> who refuse to compromise.",
                            "target_lang_translations": {
                                "pl": "Każdy ruch polityczny ma swoją grupę <w>niezadowolonych</w>, którzy odmawiają kompromisu."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebel",
                        "dissident",
                        "agitator"
                    ],
                    "common_phrases": [
                        "group of malcontents"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba niezadowolona z obecnej sytuacji, często buntująca się przeciwko niej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niezadowolony",
                                "target_lang_sense_clarification": "osoba wyrażająca swoje niezadowolenie"
                            },
                            {
                                "target_lang_word": "buntownik",
                                "target_lang_sense_clarification": "osoba aktywnie sprzeciwiająca się systemowi"
                            },
                            {
                                "target_lang_word": "dysydent",
                                "target_lang_sense_clarification": "osoba o poglądach sprzecznych z oficjalną linią władzy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0195f95f-5078-329f-9345-a888940ee8a7",
                    "sense_definition": "A state of unhappiness or dissatisfaction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dissatisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The widespread <w>malcontent</w> among the population eventually led to a change in leadership.",
                            "target_lang_translations": {
                                "pl": "Powszechne <w>niezadowolenie</w> wśród ludności doprowadziło ostatecznie do zmiany przywództwa."
                            }
                        },
                        {
                            "text": "Economic hardship was the primary source of <w>malcontent</w> in the rural provinces.",
                            "target_lang_translations": {
                                "pl": "Trudności ekonomiczne były głównym źródłem <w>niezadowolenia</w> na prowincji."
                            }
                        }
                    ],
                    "synonyms": [
                        "discontent",
                        "dissatisfaction"
                    ],
                    "antonyms": [
                        "contentment",
                        "satisfaction"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun usage is increasingly rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan nieszczęścia lub niezadowolenia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niezadowolenie",
                                "target_lang_sense_clarification": "poczucie braku satysfakcji"
                            },
                            {
                                "target_lang_word": "frustracja",
                                "target_lang_sense_clarification": "stan napięcia wynikający z niezaspokojonych potrzeb"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edb381d1-8793-320a-9d74-3dcc8c1b5768",
                    "sense_definition": "To cause someone to feel unhappy or dissatisfied.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dissatisfied",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant changes to the schedule served only to <w>malcontent</w> the staff.",
                            "target_lang_translations": {
                                "pl": "Ciągłe zmiany w harmonogramie służyły jedynie temu, by <w>niezadowolić</w> personel."
                            }
                        },
                        {
                            "text": "His harsh words were intended to <w>malcontent</w> the audience and incite a protest.",
                            "target_lang_translations": {
                                "pl": "Jego ostre słowa miały na celu <w>niezadowolenie</w> publiczności i wywołanie protestu."
                            }
                        }
                    ],
                    "synonyms": [
                        "displease",
                        "dissatisfy"
                    ],
                    "antonyms": [
                        "satisfy",
                        "please"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is rarely encountered in contemporary English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Powodować, że ktoś czuje się nieszczęśliwy lub niezadowolony."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niezadowalać",
                                "target_lang_sense_clarification": "sprawiać, że ktoś nie jest z czegoś zadowolony"
                            },
                            {
                                "target_lang_word": "frustrować",
                                "target_lang_sense_clarification": "wywoływać u kogoś poczucie frustracji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}