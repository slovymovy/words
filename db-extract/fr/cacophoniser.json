                "senses": [
                    {
                        "sense_id": "ff1d52bf-ca81-39c6-83e9-1d2e7df06ca9",
                        "entry_id": "646fb2c4-23c1-3bd9-b033-a8bac8d4e804",
                        "glosses": [
                            "Donner un caractère cacophonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bad33f7-81d3-45e1-bfd7-80833e0b234f",
                                "sense_id": "ff1d52bf-ca81-39c6-83e9-1d2e7df06ca9",
                                "text": "Est-ce par goût du changement, par ennui, par paresse ou encore par despotisme inné qu’il nous faut bouleverser sans cesse ce qui nous entoure, ternir ce qui est couleur, tasser ce qui est aérien, abîmer ce qui est beauté, empuantir ce qui est parfum et cacophoniser ce qui est murmure?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b762646-0b4b-30eb-a3bd-c113f2e89267",
                        "entry_id": "646fb2c4-23c1-3bd9-b033-a8bac8d4e804",
                        "glosses": [
                            "Émettre des sons cacophoniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07cda8b5-f936-4e84-9f7e-ca8096709972",
                                "sense_id": "9b762646-0b4b-30eb-a3bd-c113f2e89267",
                                "text": "Et il continua à cacophoniser sur son alto."
                            },
                            {
                                "example_id": "02b786bc-7c7a-4b59-b800-2cb39c1cb14b",
                                "sense_id": "9b762646-0b4b-30eb-a3bd-c113f2e89267",
                                "text": "Qu’est il besoin de tant cacophoniser par des repetitions qui ne sont autres que vuidanges tragiques, faire vn theatre de la mort de Iesus Christ."
                            }
                        ]
                    }
                ],
