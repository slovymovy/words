                        "entry_id": "63d8fd3c-669c-3807-b0a8-f495b366cfcc",
                        "glosses": [
                            "houtige vrouwelijke vrucht met schubben van dennenbomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa5d69a-35bf-45a5-8a58-3b004bce0a78",
                                "sense_id": "fe2870df-2cd0-3aff-b831-c4d33a72ce0c",
                                "text": "Een dennenappel kan dienst doen als primitieve hygrometer. Bij vochtig weer sluiten de schubben. Bij droog weer openen ze, zodat de zaden zich kunnen verplaatsen (door middel van de wind)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77b9e3e5-5a6b-4637-8220-fa8e5205448d",
                        "source_entry_id": "63d8fd3c-669c-3807-b0a8-f495b366cfcc",
                        "source_sense_id": "fe2870df-2cd0-3aff-b831-c4d33a72ce0c",
                        "target_lang_word": "Kiefernzapfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiefernzapfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "325e2421-e3c3-3e1b-92be-0f33cd53a4cf",
                                        "entry_id": "c4f92c0a-d1fe-3eaa-9488-f090bc415c92",
                                        "glosses": [
                                            "verholzte Frucht der Kiefer, bei der die Samen schuppenartig um eine Achse zu einem Zapfen angeordnet sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d63ad907-199d-4580-8e34-8de6e753cf9b",
                                                "sense_id": "325e2421-e3c3-3e1b-92be-0f33cd53a4cf",
                                                "text": "Beim letzten Herbstspaziergang sammelten wir viele Kiefernzapfen."
                                            },
                                            {
                                                "example_id": "036b0c8a-bdff-4ab2-87bc-2797a62c4082",
                                                "sense_id": "325e2421-e3c3-3e1b-92be-0f33cd53a4cf",
                                                "text": "„Ersatz boten die im Irak entwickelten Kohletuschen, Tinten in fester Form, deren Grundsubstanzen Piniensamen, Kiefernzapfen, Dattelkerne, Palmrispen, Granatapfelschalen und Kichererbsen waren, die unter Luftabschluß verkohlt und nach ihrer Pulverisierung mit Gummi arabicum verarbeitet wurden.“"
                                            },
                                            {
                                                "example_id": "75a20eee-4434-46ac-bca3-51159d9599cb",
                                                "sense_id": "325e2421-e3c3-3e1b-92be-0f33cd53a4cf",
                                                "text": "„Die Kiefernzapfen fallen. […] Wir sammeln die Kiefernzapfen in unsere Schürzen.“"
                                            },
                                            {
                                                "example_id": "6f43e85e-564f-40b8-835b-c53251a7e35b",
                                                "sense_id": "325e2421-e3c3-3e1b-92be-0f33cd53a4cf",
                                                "text": "„Wie wird das Wetter? Diese Frage lässt sich mit Hilfe eines Kiefernzapfens schnell und sicher beantworten. Der Zapfen schließt nämlich seine Schuppen, wenn Regen kommt. Denn unter den Schuppen sitzen die Samen, die so vor schlechtem Wetter geschützt werden. Bei Sonne öffnen sich die Schuppen, damit die Samen reifen können. Zusammen mit Pappe, Buntstiften und einem Holzstäbchen kann der Kiefernzapfen zu einer richtigen Wetterstation ausgebaut werden. Kiefernzapfen findet man im Wald.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
