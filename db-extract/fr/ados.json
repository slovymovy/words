        "fr-extract.jsonl": [
            {
                "entry_id": "d3157f09-9e54-31a8-bf7b-3ea17836715a",
                "word": "ados",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "21d831f0-1fb7-39c6-8c01-3671928f3e57",
                        "entry_id": "d3157f09-9e54-31a8-bf7b-3ea17836715a",
                        "glosses": [
                            "Terre qu’on élève en talus, ordinairement le long d’un mur bien exposé, pour y semer quelque chose qu’on veut faire venir plus tôt qu’on ne le pourrait en pleine terre."
                        ],
                        "tags": [
                            "Agriculture et horticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "88abfac1-a0b4-4218-9b8d-14f4ca759c06",
                                "sense_id": "21d831f0-1fb7-39c6-8c01-3671928f3e57",
                                "text": "Nous cultivons de même les carottes sur ados, mais pour le semis on s’y prend d’une autre façon que pour la betterave."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9645842-3ac5-3104-aeb6-59f7825f5d7c",
                        "entry_id": "d3157f09-9e54-31a8-bf7b-3ea17836715a",
                        "glosses": [
                            "Bande de terre élevée par une charrue de part et d’autre du sillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a7f8ba-c481-45cb-bac7-f65607b5db66",
                                "sense_id": "e9645842-3ac5-3104-aeb6-59f7825f5d7c",
                                "text": "Dès le début du XXe siècle, avant l’ère des machines, on avait déjà les charrues à brabant, avec deux jeux superposés de socs qu’on renversait en bout de champ, pour éviter aux hommes & autres animaux de trait des allers-retours inutiles & qu'ados & sillon fussent toujours du même côté sur la parcelle ; le bon vieux boustrophédon. ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5de2a489-a124-3f3b-9222-03bc20d7aa6d",
                        "entry_id": "d3157f09-9e54-31a8-bf7b-3ea17836715a",
                        "glosses": [
                            "Profil de la planche de labour, dans le labour en planche."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1abe20f3-0f04-3821-8d08-608b82ef5716",
                        "entry_id": "d3157f09-9e54-31a8-bf7b-3ea17836715a",
                        "glosses": [
                            "Terrain en pente."
                        ],
                        "tags": [
                            "Régionalisme",
                            "Sud de la France"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7f9ba85c-7b59-349b-b6bb-7638aa1080e0",
                        "entry_id": "d3157f09-9e54-31a8-bf7b-3ea17836715a",
                        "glosses": [
                            "Pente d'un fossé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73abd2a3-613c-445c-8314-95d696434a84",
                                "sense_id": "7f9ba85c-7b59-349b-b6bb-7638aa1080e0",
                                "text": "Le braconner s'assit sur l'ados du fossé."
                            }
                        ]
                    }
                ],
