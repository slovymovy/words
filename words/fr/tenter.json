                {
                    "sense_id": "aaf77de2-015c-391e-a3a7-2b4a862e2268",
                    "sense_definition": "Inciter quelqu'un à commettre une faute morale ou un péché en exerçant une séduction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le récit biblique, le serpent <w>tenta</w> la femme dans le jardin.",
                            "target_lang_translations": {
                                "en": "In the biblical account, the serpent <w>tempted</w> the woman in the garden.",
                                "ru": "В библейском повествовании змей <w>искусил</w> женщину в саду.",
                                "nl": "In het bijbelverhaal <w>verleidde</w> de slang de vrouw in de tuin.",
                                "de": "In der biblischen Erzählung <w>verführte</w> die Schlange die Frau im Garten.",
                                "pl": "W biblijnej opowieści wąż <w>kusił</w> kobietę w ogrodzie.",
                                "it": "Nel racconto biblico il serpente <w>tentò</w> la donna nel giardino.",
