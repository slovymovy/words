                ],
                "senses": [
                    {
                        "sense_id": "13f62677-45c1-35b6-a1dd-9c1ba8cc3db3",
                        "entry_id": "afa6d55f-9509-3c1e-8a68-e8ad1b0916a1",
                        "glosses": [
                            "Disposer du droit appartenant aux seigneurs des grands Fiefs, de doubler les rentes que leurs vassaux leur doivent dans quatre cas : pour le voyage d’outre-mer, pour une nouvelle chevalerie, pour la rançon du seigneur, pour le mariage d'une fille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a59a55-7790-42a3-b79d-de9569aa7f26",
                                "sense_id": "13f62677-45c1-35b6-a1dd-9c1ba8cc3db3",
                                "text": "Droit d’indire aux quatre cas."
                            },
                            {
                                "example_id": "079508ea-96e2-423a-876f-1a1e51543585",
                                "sense_id": "13f62677-45c1-35b6-a1dd-9c1ba8cc3db3",
                                "text": "D'où vient que vous êtes si révolté contre moi, lui dis-je [à un fermier], et que vous ne voulez pas payer le droit d’indire ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "421837a2-992f-35c3-a2eb-2255081eb2d3",
                        "entry_id": "afa6d55f-9509-3c1e-8a68-e8ad1b0916a1",
                        "glosses": [
                            "Fixer la date d'une convocation."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "542209be-6da1-4170-9d65-7cfed28fad12",
                                "sense_id": "421837a2-992f-35c3-a2eb-2255081eb2d3",
                                "text": "Le roi commanda à M. le chancelier de l’indire [une assemblée du clergé] à Montargis, et de l’éloigner de Paris, pour éviter toutes les ligues et factions des esprits remuants."
                            }
                        ]
                    }
                ],
