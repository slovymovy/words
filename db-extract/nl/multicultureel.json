                "senses": [
                    {
                        "sense_id": "d23514b7-d435-3bad-ac41-bb4ece645fd1",
                        "entry_id": "2c9223b9-7b4c-348d-9572-b9f447743668",
                        "glosses": [
                            "bestaande uit meerdere culturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573f18b5-e084-484b-b5af-e009273aee8d",
                                "sense_id": "d23514b7-d435-3bad-ac41-bb4ece645fd1",
                                "text": "Of we het willen of niet Nederland wordt steeds meer een multiculturele samenleving."
                            }
                        ]
                    },
                    {
                        "sense_id": "84bcd6bb-498b-359b-b92f-6dc4d4af029e",
                        "entry_id": "2c9223b9-7b4c-348d-9572-b9f447743668",
                        "glosses": [
                            "hebbende affiniteit met, belangstelling voor meerdere culturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "473a06cf-8c99-444e-8b5a-893f7ad638d4",
                                "sense_id": "84bcd6bb-498b-359b-b92f-6dc4d4af029e",
                                "text": "De renpaarden onder de vogels! Dat ze bovendien op een weerzinwekkende manier werden vervoerd en geslacht. En dat alleen maar omdat de multiculturele Nederlander het zo enig vindt om eens iets anders op zijn bord te krijgen dan een biefstuk van de koe."
                            }
                        ]
                    }
