                "entry_id": "6677c68b-908a-37f5-b249-12a851f18f78",
                "word": "nonconformity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "549ec453-b05e-4d8c-b0e0-477dafd4c177",
                        "entry_id": "6677c68b-908a-37f5-b249-12a851f18f78",
