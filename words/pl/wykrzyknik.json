    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "143b6056-941b-3183-913b-4df1ac441c62",
                    "sense_definition": "znak interpunkcyjny służący do wzmacniania ekspresji wypowiedzi, zapisywany za pomocą kropki i umieszczonej nad nią pionowej kreski: !",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "punctuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na końcu tego zdania musisz postawić <w>wykrzyknik</w>.",
                            "target_lang_translations": {
                                "ru": "В конце этого предложения вы должны поставить <w>восклицательный знак</w>."
                            }
                        },
                        {
                            "text": "W wiadomościach do przyjaciół często stawiam kilka <w>wykrzykników</w> naraz.",
                            "target_lang_translations": {
                                "ru": "В сообщениях друзьям я часто ставлю сразу несколько <w>восклицательных знаков</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "postawić wykrzyknik"
                    ],
                    "target_lang_definitions": {
                        "ru": "знак препинания, используемый для усиления экспрессии высказывания, записываемый в виде вертикальной черты с точкой под ней: !"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восклицательный знак",
                                "target_lang_sense_clarification": "лингвистический знак препинания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60f0c796-ad97-3704-90d6-6dae4bd1a447",
                    "sense_definition": "nieodmienna część mowy służąca do wyrażania emocji, nakazu lub imitacji odgłosów",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "„A niech to!”, „Pst!” i „Chrum!” to przykłady <w>wykrzykników</w>.",
                            "target_lang_translations": {
                                "ru": "«Черт возьми!», «Тсс!» и «Хрю!» — это примеры <w>междометий</w>."
                            }
                        },
                        {
                            "text": "W języku polskim <w>wykrzyknik</w> jest samodzielną częścią mowy.",
                            "target_lang_translations": {
                                "ru": "В польском языке <w>междометие</w> является самостоятельной частью речи."
                            }
                        }
                    ],
                    "synonyms": [
                        "interiekcja"
                    ],
                    "target_lang_definitions": {
                        "ru": "неизменяемая часть речи, служащая для выражения эмоций, побуждения или имитации звуков"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "междометие",
                                "target_lang_sense_clarification": "часть речи, выражающая чувства или побуждения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}