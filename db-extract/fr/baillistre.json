                        "entry_id": "b68611e2-bd6d-3991-91fa-5db3ccf45d5a",
                        "glosses": [
                            "Tuteur et gestionnaire d’un enfant mineur, dans le droit de l’Ancien Régime."
                        ],
                        "tags": [
                            "Droit d’Ancien Régime"
                        ],
                        "examples": [
                            {
                                "example_id": "9a58df8f-82db-4eb7-b161-84a01379327d",
                                "sense_id": "e5faf7b7-4609-3e3a-a95d-c6331c5bf781",
                                "text": "Garde féodale : Coutume selon laquelle le fief échu à un mineur est confié à un de ses proches parents, dit baillistre, qui a, jusqu'à la majorité du vassal, les droits et obligations de ce dernier."
                            },
                            {
                                "example_id": "3a94ba02-425c-4c04-8881-6c4d592ac8e5",
                                "sense_id": "e5faf7b7-4609-3e3a-a95d-c6331c5bf781",
                                "text": "Le baillistre, aussi bien que le gardien, n’administre pas pour le compte du mineur, mais pour son propre compte : il a la jouissance du fief dont il fait les fruits siens, civils ou naturels."
                            }
                        ]
                    }
