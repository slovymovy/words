                        "sense_id": "86a928b6-884c-3c3e-9d58-95791e22386c",
                        "entry_id": "56571953-f7ac-3e12-ab0d-53dfeddceca5",
                        "glosses": [
                            "In an everlasting manner; without end; forever."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d07a8ed9-79a6-4f70-b2d7-f5b843998696",
                                "sense_id": "86a928b6-884c-3c3e-9d58-95791e22386c",
                                "text": "`Curse her, may she be everlastingly accursed.' The arms fell and the flame sank."
                            },
                            {
                                "example_id": "208a75aa-228d-4302-b192-65b655a75451",
                                "sense_id": "86a928b6-884c-3c3e-9d58-95791e22386c",
                                "text": "Their lives are dedicated to world conquest, but they also know that it is necessary that the war should continue everlastingly and without victory."
                            }
                        ]
                    },
                    {
                        "sense_id": "8eb5cc42-036f-3898-b92c-4f48089b44bb",
                        "entry_id": "56571953-f7ac-3e12-ab0d-53dfeddceca5",
                        "glosses": [
                            "Perpetually; constantly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672d9317-7530-433e-91fa-3923b411fa7e",
                                "sense_id": "8eb5cc42-036f-3898-b92c-4f48089b44bb",
                                "text": "They talk about education, everlastingly, as if it were a cure-all instead of a process for making unfit nations unfitter […]"
                            }
                        ]
                    }
                ],
