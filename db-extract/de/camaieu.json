                    {
                        "translation_id": "ef34c430-8053-41e0-a286-a9cd7f645efd",
                        "source_entry_id": "f1d2b1c1-c61e-3ee3-b6b5-a1652e0a6d6b",
                        "source_sense_id": "ce948dd9-1bed-3b20-a608-f5ffdc6d5b71",
                        "source_sense_description": "aus einem schichtenförmig-mehrfarbigen Stein herausgearbeitetes Bild",
                        "target_lang_word": "camaïeu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camaïeu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca46b74-5acf-3fc1-bbdf-092b27dc84c4",
                                        "entry_id": "0ceb2c1f-c6f2-3c09-bc98-a4f7eefb330e",
                                        "glosses": [
                                            "Camée, pierre fine qui présente deux nuances différentes de la même couleur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25a38831-7535-3c8b-a09f-69e1c12a366e",
                                        "entry_id": "0ceb2c1f-c6f2-3c09-bc98-a4f7eefb330e",
                                        "glosses": [
                                            "Peinture ou coloration où l’on n’emploie qu’une couleur avec des nuances différentes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2d03890-f057-41b8-8dc3-3c539a8d034a",
                                                "sense_id": "25a38831-7535-3c8b-a09f-69e1c12a366e",
                                                "text": "Peindre en camaïeu. Un tableau peint en camaïeu."
                                            },
                                            {
                                                "example_id": "2b5dacf6-4717-45c9-80c2-3e2ad9c2d6fe",
                                                "sense_id": "25a38831-7535-3c8b-a09f-69e1c12a366e",
                                                "text": "Je me levai enfin, courant au parterre du château, où se trouvaient des lauriers, plantés dans de grands vases de faïence peints en camaïeu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c8c1518-c66f-3500-9ec5-62e85bb2b5d1",
                                        "entry_id": "0ceb2c1f-c6f2-3c09-bc98-a4f7eefb330e",
                                        "glosses": [
                                            "Objet peint dans une seule nuance de coloris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d68e5d6-3ff9-4036-bfff-ac1cb81c359f",
                                                "sense_id": "6c8c1518-c66f-3500-9ec5-62e85bb2b5d1",
                                                "text": "Un beau camaïeu."
                                            },
                                            {
                                                "example_id": "32fb604d-6645-4fec-b3fd-f503d2e9c069",
                                                "sense_id": "6c8c1518-c66f-3500-9ec5-62e85bb2b5d1",
                                                "text": "Je me souviens de ce professeur de dessin, à Douai, qui nous avait fait choisir une couleur et créer avec elle un camaïeu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019c83c6-3161-32ed-ba9e-b6857dee7a25",
                                        "entry_id": "0ceb2c1f-c6f2-3c09-bc98-a4f7eefb330e",
                                        "glosses": [
                                            "Scène avec des nuances d'un seul coloris."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c707d0d0-f15a-4a31-8cb7-f5a8bed24f29",
                                                "sense_id": "019c83c6-3161-32ed-ba9e-b6857dee7a25",
                                                "text": "Oui, un tas de quelque chose qui se dissout dans un camaïeu d’ombres de plus en plus profondes, jusqu’à cette obscurité vibrante d’où jaillit la blanche vision de l’enfant immolé."
                                            },
                                            {
                                                "example_id": "f45f0cdf-8da5-4170-a161-081b2f932cb6",
                                                "sense_id": "019c83c6-3161-32ed-ba9e-b6857dee7a25",
                                                "text": "“Il va l’emporter haut la main”, prédit ce chauffeur-livreur de 22 ans, en montrant du regard une foule qui attend patiemment un meeting de l’ex-président à Salem, dans l’est des États-Unis, au cœur de montagnes teintées de camaïeux automnaux de rouge et orange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b2d7f9f-5de9-4b96-91fb-19da03b5c2eb",
                        "source_entry_id": "f1d2b1c1-c61e-3ee3-b6b5-a1652e0a6d6b",
                        "source_sense_id": "ce948dd9-1bed-3b20-a608-f5ffdc6d5b71",
                        "source_sense_description": "aus einem schichtenförmig-mehrfarbigen Stein herausgearbeitetes Bild",
                        "target_lang_word": "камея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "камея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17097972-7d2f-3ac9-b935-5b270c8c847b",
                                        "entry_id": "4fa88199-48c2-3c81-8123-b5c52d06a5aa",
                                        "glosses": [
                                            "камень или раковина с художественной резьбой; украшение в виде броши из такого камня или раковины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954604c0-1e60-48c9-8d8f-40afcc3584ff",
                                                "sense_id": "17097972-7d2f-3ac9-b935-5b270c8c847b",
                                                "text": "«Да, Леонтий прав: это — камея; какой профиль, какая строгая, чистая линия затылка, шеи!…»"
                                            },
                                            {
                                                "example_id": "fb8e28c8-dc86-4b07-a32e-f95ba29ce0ee",
                                                "sense_id": "17097972-7d2f-3ac9-b935-5b270c8c847b",
                                                "text": "В самом деле, не говоря уже о важнейших произведениях древнего резца, — камея, барельеф, медаль, посуда в форме человеческой или львиной головы, каждая безделка в этом роде есть художественное произведение и в тысячу раз выше лучшей статуи даже Кановы."
                                            },
                                            {
                                                "example_id": "01fff3ab-b205-42f0-977c-567f51dc1c99",
                                                "sense_id": "17097972-7d2f-3ac9-b935-5b270c8c847b",
                                                "text": "Дочь его пожалована была во фрейлины в 1826 году, и когда явилась, во время коронации Николая Павловича в Москве, на бал, обратила на себя общее внимание медалионом, в котором вделана была редкая и известная по истории искусства камея, исчезнувшая из придворной коллекции в сороковых годах XVIII века: она досталась ей от покойного дяди."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2a4b007-3106-3165-9112-43f43e22c14a",
                                        "entry_id": "4fa88199-48c2-3c81-8123-b5c52d06a5aa",
                                        "glosses": [
                                            "техника резьбы по камню с выпуклым (позитивным) рельефом"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56e74ae6-dd57-4f75-9920-5e3d5667f158",
                        "source_entry_id": "f1d2b1c1-c61e-3ee3-b6b5-a1652e0a6d6b",
                        "source_sense_id": "ce948dd9-1bed-3b20-a608-f5ffdc6d5b71",
                        "source_sense_description": "aus einem schichtenförmig-mehrfarbigen Stein herausgearbeitetes Bild",
                        "target_lang_word": "camafeo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camafeo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "990a19d3-e45a-386c-8404-8aab71898e8c",
                                        "entry_id": "1604dc17-1a23-3d41-a7b1-dc3df8a93119",
                                        "glosses": [
                                            "Ónice u otra piedra preciosa, con una figura tallada en relieve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c35493-feac-4326-b961-d35b970762f1",
                                                "sense_id": "990a19d3-e45a-386c-8404-8aab71898e8c",
                                                "text": "¡Oh, célebre museo y plausible teatro de toda esta antigua griega y romana cultura, así en estatuas como en piedras, ya en sellos anulares, ya en monedas, vasos, urnas, láminas y camafeos, el de nuestro mayor amigo, el culto y erudito don Vincencio Juan de Lastanosa, honor de los romanos por su memoria, gloria de los aragoneses por su ingenio!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
