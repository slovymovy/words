                "senses": [
                    {
                        "sense_id": "b1a0580f-e2af-33dc-9af4-5a6eb6b4e398",
                        "entry_id": "b440a0dc-8427-318b-bd10-3f8a6f802336",
                        "glosses": [
                            "in Südasien beheimatetes Raubtier mit langem Fell und beweglichen Lippen, die ausgefahren werden können, um Insekten zu fressen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d562c96-2f64-4f0b-9e56-54c2f4fd648b",
                                "sense_id": "b1a0580f-e2af-33dc-9af4-5a6eb6b4e398",
                                "text": "„Ein indischer Lippenbär beschützt seinen Nachwuchs vor einem deutlich größeren Bengalischen Tiger – und gewinnt gegen die Raubkatze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "505bdaa3-22ff-4526-aca1-41c032ab35b9",
                        "source_entry_id": "b440a0dc-8427-318b-bd10-3f8a6f802336",
                        "source_sense_id": "b1a0580f-e2af-33dc-9af4-5a6eb6b4e398",
                        "target_lang_word": "sloth bear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sloth bear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                        "entry_id": "0939d868-8688-3c42-b13b-804f654dbb84",
                                        "glosses": [
                                            "A nocturnal bear, Melursus ursinus, native to South Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc96fa4c-d96e-4cdd-a53e-e760ee8e812c",
                                                "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                                "text": "More people in India are killed by sloth bears than by tigers."
                                            },
                                            {
                                                "example_id": "63ed3428-19d6-40d6-9f3f-586a52423882",
                                                "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                                "text": "As in other species of wild bears, sloth bears are most likely to die young, especially during the first few months after they have left their mothers."
                                            },
                                            {
                                                "example_id": "260bf7f3-2a69-4c65-950d-33b7143a44f0",
                                                "sense_id": "fffda000-0bd4-3167-bf30-4aa53bfe9237",
                                                "text": "Sloth bear attacks are in no way a thing of the past. In recent years, Sri Lankan wildlife expert Shyamala Ratnayeke has surveyed close to three hundred of her countrymen who have encountered and, in some cases, been injured by sloth bears."
                                            }
                                        ]
                                    }
                                ]
                            }
