                "senses": [
                    {
                        "sense_id": "1c313d70-59a5-3060-8ce1-de5774500dce",
                        "entry_id": "3dbe9958-e31e-3876-aefc-9b84b32b8583",
                        "glosses": [
                            "stark von Rost befallenes Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e84b4f89-a00b-4be5-b486-054e1578946b",
                                "sense_id": "1c313d70-59a5-3060-8ce1-de5774500dce",
                                "text": "Rostlauben erkennt man daran, dass sie an allen möglichen Stellen Rost angesetzt haben."
                            },
                            {
                                "example_id": "8e9a9aa1-9350-437f-b626-6880a9f0f41f",
                                "sense_id": "1c313d70-59a5-3060-8ce1-de5774500dce",
                                "text": "„Die Rostlaube kriegst du doch nie mehr durch den TÜV!“"
                            },
                            {
                                "example_id": "72e1014d-1249-4369-ad77-796ce568849c",
                                "sense_id": "1c313d70-59a5-3060-8ce1-de5774500dce",
                                "text": "„A: „Was fährst Du denn da für eine Rostlaube.“ B: Diese \"Rostlaube\" ist ein 2 Wochen alter Porsche. Das kannst du dir gar nicht leisten!“"
                            },
                            {
                                "example_id": "bd1c4fbf-edd4-4ff3-b5b7-9fa7ea469ee9",
                                "sense_id": "1c313d70-59a5-3060-8ce1-de5774500dce",
                                "text": "„Den Sanitätern bleibt nur, die Rostlauben auszuweiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
