                "senses": [
                    {
                        "sense_id": "7b9814d9-0b02-39f1-9e67-78dc5994d063",
                        "entry_id": "6243f4a4-7ff2-3ef3-9768-5795c1bfc677",
                        "glosses": [
                            "großer, grau-weißer Vogel aus der Gattung der Pelikane"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e4004a-a238-4954-b49a-d31f06057051",
                                "sense_id": "7b9814d9-0b02-39f1-9e67-78dc5994d063",
                                "text": "Der Krauskopfpelikan kommt auch in Europa, etwa am Schwarzen Meer, vor."
                            },
                            {
                                "example_id": "7d0e2612-a8e2-4de8-91a6-271ad434fa69",
                                "sense_id": "7b9814d9-0b02-39f1-9e67-78dc5994d063",
                                "text": "Der Krauskopfpelikan ist die seltenste Pelikanart weltweit."
                            },
                            {
                                "example_id": "725ff83c-ba9c-47a1-b45b-3dfa2b970534",
                                "sense_id": "7b9814d9-0b02-39f1-9e67-78dc5994d063",
                                "text": "Krauskopfpelikane sind sehr scheu und gerade zur Brutzeit reagieren sie besonders empfindlich auf Eindringlinge."
                            },
                            {
                                "example_id": "b75dee75-4ae5-4aa1-863d-4dafc62b4623",
                                "sense_id": "7b9814d9-0b02-39f1-9e67-78dc5994d063",
                                "text": "Zudem profitiert der Krauskopfpelikan vom üppigen Fischangebot des Sees: Über 50 Fischarten tummeln sich in dem durch zahlreiche unterirdische Quellen und Zuflüsse gespeisten Gewässer. Dennoch stagnieren die Bestandszahlen der Krauskopfpelikane am Skutari-See seit Jahren auf vergleichsweise geringem Niveau."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
