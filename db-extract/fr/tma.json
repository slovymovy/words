            {
                "entry_id": "98b4ddad-0ccf-3b56-88c6-07d245a7ae33",
                "word": "TMA",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a3c22666-853c-3643-838a-1e64d7e70a88",
                        "entry_id": "98b4ddad-0ccf-3b56-88c6-07d245a7ae33",
                        "glosses": [
                            "De l’anglais transmisogyny affected ; relatif aux personnes qui subissent la transmisogynie."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "6c8511f0-2f57-4086-88e6-c8768f4bce1a",
                                "sense_id": "a3c22666-853c-3643-838a-1e64d7e70a88",
                                "text": "Au bout de ma démarche on trouve, je crois, une proposition humble et sincère pour ouvrir un dialogue féministe sur certains des enjeux les plus préoccupants pour les femmes trans et les personnes TMA."
                            },
                            {
                                "example_id": "dcd74eeb-ab41-47af-ac19-80901c5a3f49",
                                "sense_id": "a3c22666-853c-3643-838a-1e64d7e70a88",
                                "text": "Nous acceptons textes, arts and conseil pour et avec les personnes TMA sur l’île de la Tortue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e344297-e9ca-4124-8e91-0706f66b7b7f",
                        "source_entry_id": "98b4ddad-0ccf-3b56-88c6-07d245a7ae33",
                        "source_sense_id": "a3c22666-853c-3643-838a-1e64d7e70a88",
