                    }
                ],
                "translations": [
                    {
                        "translation_id": "0421a855-2c40-4dcc-8dc4-ea4483795048",
                        "source_entry_id": "6c349820-0606-3751-bec7-d8f69e4f3940",
                        "source_sense_id": "c86b704a-c6b1-32b1-a405-b6cc0d66d976",
                        "source_sense_description": "regional (Algerien), Nahrung: Brot",
                        "target_lang_word": "Brot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e91b75-4475-3224-8fa3-9eb294e8295b",
                                        "entry_id": "1cafb69a-dd9d-3307-9cc0-b31947e37554",
                                        "glosses": [
                                            "aus hauptsächlich Mehl, Wasser und Salz gebackenes Nahrungsmittel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbe10d67-d466-4455-a7d2-6cfbe2a2c929",
                                                "sense_id": "e0e91b75-4475-3224-8fa3-9eb294e8295b",
                                                "text": "Er sitzt nur bei Wasser und Brot."
                                            },
                                            {
                                                "example_id": "ec5ae9be-4019-43ad-801d-1481f8b61d1e",
                                                "sense_id": "e0e91b75-4475-3224-8fa3-9eb294e8295b",
                                                "text": "Heute habe ich ein ungesäuertes Brot gebacken."
                                            },
                                            {
                                                "example_id": "82f2f076-c37a-4613-a206-b68fcd96a0ce",
                                                "sense_id": "e0e91b75-4475-3224-8fa3-9eb294e8295b",
                                                "text": "„Immer muß darum unser Brot mit zermahlener Birkenrinde gestreckt werden, und immer behält es – mit der Brennerei-Hefe gebacken – seine fatale Neigung bei, umgehend zu verschimmeln.“"
                                            },
                                            {
                                                "example_id": "29c3a0d1-d450-4d0e-8912-4c10eda57e30",
                                                "sense_id": "e0e91b75-4475-3224-8fa3-9eb294e8295b",
                                                "text": "„Das Brot war schlecht und das Schweinefleisch nicht viel besser.“"
                                            },
                                            {
                                                "example_id": "4692c4fc-c2cd-40c0-92f3-5940ca97c746",
                                                "sense_id": "e0e91b75-4475-3224-8fa3-9eb294e8295b",
                                                "text": "„Die Husaren und Kosaken hatten sich um die Gefangenen geschart und boten ihnen geschäftig Kleidungsstücke oder Stiefel oder Brot an.“"
                                            },
                                            {
                                                "example_id": "b40cea77-0a18-4fcf-ae30-b5258e005872",
                                                "sense_id": "e0e91b75-4475-3224-8fa3-9eb294e8295b",
                                                "text": "„Manchmal hatte sie mir Brot mitgebracht von einem Vetter, der in einer Brotfabrik arbeitete; Veronika hatte darauf bestanden, mich zu füttern, und jedesmal, wenn sie mir ein Stück Brot gab, hatte ich diese Hände nah vor meinen Augen gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f367aa11-3112-325f-a2f2-6705715e3bd9",
                                        "entry_id": "1cafb69a-dd9d-3307-9cc0-b31947e37554",
                                        "glosses": [
                                            "einzelner Brotlaib"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a4fcfcc-a2ab-4f28-afaf-f3e9a9547931",
                                                "sense_id": "f367aa11-3112-325f-a2f2-6705715e3bd9",
                                                "text": "Zunächst brechen wir das Brot, danken und sprechen das Vaterunser."
                                            },
                                            {
                                                "example_id": "67eb9e12-efe6-4a74-b760-e90b44fa2a1d",
                                                "sense_id": "f367aa11-3112-325f-a2f2-6705715e3bd9",
                                                "text": "„In einer Bäckerei hatte er sich ein Brot erbettelt und sorgfältig eingeteilt, auf Obstwiesen stahl er Äpfel und Birnen, und er übernachtete im Freien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d063d6f-5e60-3473-ba2a-27f435ed0142",
                                        "entry_id": "1cafb69a-dd9d-3307-9cc0-b31947e37554",
                                        "glosses": [
                                            "abgeschnittene Scheibe eines Brotlaibes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bf9c760-f393-4078-bb48-f01bd4640d20",
                                                "sense_id": "1d063d6f-5e60-3473-ba2a-27f435ed0142",
                                                "text": "Möchtest Du ein oder zwei Brote essen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3df43745-dead-3f6c-9ed5-25b5a628e02b",
                                        "entry_id": "1cafb69a-dd9d-3307-9cc0-b31947e37554",
                                        "glosses": [
                                            "Lebensunterhalt, Lohn, Ertrag"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8369a920-f8b1-4fc8-840e-64e981d66b13",
                                                "sense_id": "3df43745-dead-3f6c-9ed5-25b5a628e02b",
                                                "text": "Er verdient sich sein Brot in der Fabrik."
                                            },
                                            {
                                                "example_id": "6cbe50d5-7d3d-4abb-99ba-abc8ac347454",
                                                "sense_id": "3df43745-dead-3f6c-9ed5-25b5a628e02b",
                                                "text": "„Auch wenn er den Beruf des Wundarztes gelernt hatte, wollte er doch sein Brot künftig als Botaniker verdienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "38352ac7-7c0d-391f-ac57-be84f0d0c847",
                                        "entry_id": "1cafb69a-dd9d-3307-9cc0-b31947e37554",
                                        "glosses": [
                                            "Nahrung, ein Essen, eine Speise, Kost"
                                        ],
                                        "tags": [
                                            "metaphoric",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c5572f1-9422-48ea-8a43-fc509dc05320",
                                                "sense_id": "38352ac7-7c0d-391f-ac57-be84f0d0c847",
                                                "text": "Sie denken nur an Brot und Spiele."
                                            },
                                            {
                                                "example_id": "ddb060e2-c81d-447a-a386-5f6c82b86f21",
                                                "sense_id": "38352ac7-7c0d-391f-ac57-be84f0d0c847",
                                                "text": "Unser täglich Brot gib uns heute. (Vaterunser)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
