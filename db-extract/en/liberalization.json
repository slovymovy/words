                                            {
                                                "example_id": "1a60b39e-42c4-42d6-a3e8-cdc6c5903e9b",
                                                "sense_id": "e40e2f2f-ef41-34cc-a013-60db1fe728f9",
                                                "text": "Uit het onderzoek blijkt dat de inkomenskloof in de onderzochte steden snel groeit. Dat hangt volgens de onderzoekers samen met globalisering en liberalisering."
                                            }
                                        ]
