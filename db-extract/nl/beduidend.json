        "nl-extract.jsonl": [
            {
                "entry_id": "7c6723c6-a3f5-3b32-aa0d-170ed5a6c8c5",
                "word": "beduidend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "baadd754-73f9-3e3d-8000-a535a98abd54",
                        "entry_id": "7c6723c6-a3f5-3b32-aa0d-170ed5a6c8c5",
                        "glosses": [
                            "aanzienlijk, veel, aanmerkelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0112d54-d3cb-4a34-9c17-691f6a5facf6",
                                "sense_id": "baadd754-73f9-3e3d-8000-a535a98abd54",
                                "text": "Hij kreeg een beduidende erfenis van zijn tante."
                            },
                            {
                                "example_id": "8979936c-8b4d-4196-9a26-ffa0e2f85c5c",
                                "sense_id": "baadd754-73f9-3e3d-8000-a535a98abd54",
                                "text": "Ja, ik ben van Téléchance. Een eerlijk bedrijf. Wij zijn betrouwbaar en onze winstcijfers zijn het afgelopen jaar beduidend toegenomen. We gaan de beurs op. En ik heb het druk, druk.'"
                            },
                            {
                                "example_id": "0e2a72c3-dfa9-436b-89cd-2e3972eb03e1",
                                "sense_id": "baadd754-73f9-3e3d-8000-a535a98abd54",
                                "text": "Kort nadat de dictator Zine el Abidine Ben Ali het land ontvluchtte, maar toch beduidend later dan in de rest van het land, werd in het Paleis van Justitie na ellenlange beraadslagingen besloten tot het verwijderen van diens tientallen portretten die door het hele gebouw verspreid hingen."
                            },
                            {
                                "example_id": "d30277bc-23c8-4b8b-a22c-ba24c61a45ca",
                                "sense_id": "baadd754-73f9-3e3d-8000-a535a98abd54",
                                "text": "Ik keek ervan op dat volgens dit onderzoek mensen die elke dag minstens 30 minuten lopen een beduidend lagere kans op hart- en vaatziekte, darmkanker, borstkanker en dementie hebben."
                            }
                        ]
                    }
                ],
