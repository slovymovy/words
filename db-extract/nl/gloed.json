                    }
                ],
                "senses": [
                    {
                        "sense_id": "52760c8c-0578-3095-8251-0392bf80bd4d",
                        "entry_id": "b86f566c-b7f3-3e92-ba91-4ab9a4a90310",
                        "glosses": [
                            "de -al of niet zichtbare- straling die uitgaat van een heet voorwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21908eee-f460-4f89-98ba-72f503915a82",
                                "sense_id": "52760c8c-0578-3095-8251-0392bf80bd4d",
                                "text": "Hij warmde zich aan de gloed van het kampvuur."
                            },
                            {
                                "example_id": "ffafb6ff-e8d2-4826-ba8a-12cdb8964e37",
                                "sense_id": "52760c8c-0578-3095-8251-0392bf80bd4d",
                                "text": "Als de deur opengaat, biedt de gele gloed zo'n warm welkom dat Nella bijna begint te huilen."
                            },
                            {
                                "example_id": "5e5e45ea-9ad5-4eed-8547-cd1313e64a89",
                                "sense_id": "52760c8c-0578-3095-8251-0392bf80bd4d",
                                "text": "En ineens stonden ze voor een hol en zagen achterin de gloed van een vuur. Er was een lelijk oud wijf dat, zachtjes mompelend, in een pot boven het vuur stond te roeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18814f8b-7268-4f79-8e86-df38a752ebea",
                        "source_entry_id": "b86f566c-b7f3-3e92-ba91-4ab9a4a90310",
                        "source_sense_id": "52760c8c-0578-3095-8251-0392bf80bd4d",
                        "target_lang_word": "Glut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6ef531-2810-3a31-9f35-50b612913fa4",
                                        "entry_id": "e1e2be62-74ff-3c54-8dd4-f2c80ac3eac0",
                                        "glosses": [
                                            "glühendes Material, Verbrennung ohne Flammenbildung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f4e4ae4-4ba4-4129-abc3-864276e4c2d7",
                                                "sense_id": "ae6ef531-2810-3a31-9f35-50b612913fa4",
                                                "text": "„Die Glut machte die Umgebung schwarz.“"
                                            },
                                            {
                                                "example_id": "88f0983f-9dae-429e-892f-439a4df8b511",
                                                "sense_id": "ae6ef531-2810-3a31-9f35-50b612913fa4",
                                                "text": "„Die Glut der Zigaretten warf kleine, zärtliche Lichter von unten gegen ihre Gesichter.“"
                                            },
                                            {
                                                "example_id": "b3612a7d-bd70-40fa-8b65-aebc05c7764c",
                                                "sense_id": "ae6ef531-2810-3a31-9f35-50b612913fa4",
                                                "text": "Die Glut im Ofen reicht, um nicht nachlegen zu müssen."
                                            },
                                            {
                                                "example_id": "f985fe80-b64a-4326-921c-5d3d14eb0430",
                                                "sense_id": "ae6ef531-2810-3a31-9f35-50b612913fa4",
                                                "text": "„Er lacht schallend und zieht dann zwei Mal hastig an seiner Zigarette, bis die Glut so lang ist wie der Filter.“"
                                            },
                                            {
                                                "example_id": "021c8791-eef7-4bc4-9931-f7129cc4be6b",
                                                "sense_id": "ae6ef531-2810-3a31-9f35-50b612913fa4",
                                                "text": "„Ich spuckte den brennenden Zigarettenstummel auf den Teppich, sah, wie die Glut sich verteilte, kleine, schwarze Löcher brannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c4ffa5a-2799-3de2-8bd7-2048717bd3f8",
                                        "entry_id": "e1e2be62-74ff-3c54-8dd4-f2c80ac3eac0",
                                        "glosses": [
                                            "glühende Leidenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7401376-840c-4e7c-a72b-669dd9bf299f",
                                                "sense_id": "3c4ffa5a-2799-3de2-8bd7-2048717bd3f8",
                                                "text": "Die Glut in seinen Augen lässt seine Begeisterung erkennen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b7698f1-9667-4095-b5e6-b149dde560d4",
                        "source_entry_id": "b86f566c-b7f3-3e92-ba91-4ab9a4a90310",
                        "source_sense_id": "52760c8c-0578-3095-8251-0392bf80bd4d",
                        "target_lang_word": "glow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88e25c1b-bd0a-39ba-849d-01ef5f92bbbf",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To emit light as if heated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9083a69a-bc5b-48f2-b08a-f0c0a6a74d63",
                                                "sense_id": "88e25c1b-bd0a-39ba-849d-01ef5f92bbbf",
                                                "text": "The fire was still glowing after ten hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "becf9471-0f66-3ec0-a7be-96fbb0286f56",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To radiate thermal heat."
                                        ],
                                        "tags": [
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6060fb2b-1efb-417c-ab69-ea16e5f51c67",
                                                "sense_id": "becf9471-0f66-3ec0-a7be-96fbb0286f56",
                                                "text": "Iron glows red hot when heated to near its melting point."
                                            },
                                            {
                                                "example_id": "3b4cd424-b773-4a21-ab04-d9f1c2050560",
                                                "sense_id": "becf9471-0f66-3ec0-a7be-96fbb0286f56",
                                                "text": "After their workout, the gymnasts' faces were glowing red."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To display intense emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ede77ed-ade0-4061-87cc-a600989a15b8",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "The zealots glowed with religious fervor."
                                            },
                                            {
                                                "example_id": "52319447-453f-4a38-a2fc-00ef356d76e8",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "You are glowing from happiness!"
                                            },
                                            {
                                                "example_id": "9302c6b5-8c67-4390-971e-b432b8b3253c",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "A fire which every windy paſſion blows; / With pride it mounts, and with revenge it glows."
                                            },
                                            {
                                                "example_id": "a1d889a6-959c-43fd-a239-f6cd813344e7",
                                                "sense_id": "512ef536-d429-31ce-9037-361d7cc97726",
                                                "text": "Burns with one love, with one resentment glows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7490f5bb-1c28-35fd-a1a1-ff3a19c6e1d6",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To gaze especially passionately at something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "deea9335-4280-3e8a-aca8-fba1c6c6c54a",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To shine brightly and steadily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bc877d-ddf5-4e3c-a80a-4597b18a1197",
                                                "sense_id": "deea9335-4280-3e8a-aca8-fba1c6c6c54a",
                                                "text": "The new baby's room glows with bright, loving colors."
                                            },
                                            {
                                                "example_id": "c29f901f-3990-4143-ac9d-0a94f1f4d735",
                                                "sense_id": "deea9335-4280-3e8a-aca8-fba1c6c6c54a",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1046295a-4c05-301f-bef2-de7a8c8c5d92",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To make hot; to flush."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9324d7b-efca-42e2-a675-e4b9779631b2",
                                                "sense_id": "1046295a-4c05-301f-bef2-de7a8c8c5d92",
                                                "text": "Fans, whose wind did seem / To glow the delicate cheeks which they did cool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "618841c6-24e3-3ceb-b11f-cc3bdfb61c50",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To feel hot; to have a burning sensation, as of the skin, from friction, exercise, etc.; to burn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e136bf5c-3e37-435b-baef-6b321768e5f3",
                                                "sense_id": "618841c6-24e3-3ceb-b11f-cc3bdfb61c50",
                                                "text": "Did not his temples glow / In the same sultry winds and scorching heats?"
                                            },
                                            {
                                                "example_id": "79e74b46-7d35-48a6-a4ea-0cca4a7092fa",
                                                "sense_id": "618841c6-24e3-3ceb-b11f-cc3bdfb61c50",
                                                "text": "The cord slides swiftly through his glowing hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7843b11-23e1-3f80-be3a-3a0d105a09e5",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "To be related to or part of an (chiefly online) undercover sting operation, especially by American federal agencies."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0676cf6-aee4-4ccf-8bfb-5799feb36041",
                                                "sense_id": "e7843b11-23e1-3f80-be3a-3a0d105a09e5",
                                                "text": "If this post glows any brighter I'm going to need sunglasses. 😄🕶👌"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9435c29-95eb-348f-8292-23761fbfdee2",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "to expose someone to the authorities."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83891cdc-a6af-3993-b83b-04f9d9610cae",
                                        "entry_id": "8c5696f3-1587-3ba8-8c37-47a7cef4989d",
                                        "glosses": [
                                            "to create a threatening online post that may involve violence, and look suspicious enough to attract a police investigation."
                                        ],
                                        "tags": [
