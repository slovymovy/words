                        "examples": [
                            {
                                "example_id": "372c0732-b68b-401a-a517-de94a1b7a224",
                                "sense_id": "8f13a534-df76-36b4-9133-57ff29d08e1a",
                                "text": "Die Wucherpfennigs vermieten Ferienwohnungen."
                            },
                            {
                                "example_id": "c6f1046b-5284-4138-bf52-260fbfb25f62",
                                "sense_id": "8f13a534-df76-36b4-9133-57ff29d08e1a",
                                "text": "Frau Wucherpfennigs Unternehmen schreibt schwarze Zahlen."
                            },
                            {
                                "example_id": "0d60fbe6-b428-460e-86fe-a6b3d33aac0c",
                                "sense_id": "8f13a534-df76-36b4-9133-57ff29d08e1a",
                                "text": "Die Ansichten des Herrn Wucherpfennig teile ich ganz und gar nicht."
                            },
                            {
                                "example_id": "a6016fe7-86ac-479b-8f8c-5e9a0a7eaf9b",
                                "sense_id": "8f13a534-df76-36b4-9133-57ff29d08e1a",
                                "text": "Die junge Wucherpfennig liegt im Krankenhaus."
                            },
                            {
                                "example_id": "a5dc688d-9574-4ec0-9d5b-02b53b5704e5",
                                "sense_id": "8f13a534-df76-36b4-9133-57ff29d08e1a",
                                "text": "Kollege Wucherpfennig genießt seinen Urlaub."
                            }
                        ],
