                        "entry_id": "695ffdc7-cf85-322a-bc16-044ed6214dd4",
                        "glosses": [
                            "zgodnie z początkiem, odwołując się do najwcześniejszych chwil od powstania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936752ce-0242-498f-9c3c-b822ad4bd986",
                                "sense_id": "2cfdafb9-2f3f-38cf-a3eb-4498fb07b8da",
                                "text": "W tej piwnicy pierwotnie leżakowały wina, zaś teraz tylko jakieś graty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "41e79121-6c53-381c-84a7-fc27af168c06",
                        "entry_id": "695ffdc7-cf85-322a-bc16-044ed6214dd4",
                        "glosses": [
                            "w sposób nietknięty cywilizacją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17e0cfb1-4c5a-44a8-911d-da063a578387",
                                "sense_id": "41e79121-6c53-381c-84a7-fc27af168c06",
                                "text": "Pierwotnie te tereny porośnięte były puszczą."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c596196b-388f-4ce3-bb77-2400d83efec6",
                        "source_entry_id": "695ffdc7-cf85-322a-bc16-044ed6214dd4",
                        "source_sense_id": "2cfdafb9-2f3f-38cf-a3eb-4498fb07b8da",
                        "target_lang_word": "initially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "initially",
