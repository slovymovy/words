                        "glosses": [
                            "Person, die ein Unternehmen leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6b828b8-dd1c-45a7-b8b8-07b4b1eee23f",
                                "sense_id": "48e4c904-5a77-3404-bfab-9850cdcd4f89",
                                "text": "„Der visionäre Unternehmensleiter versammelt herausragende Experten um sich, die bereit sind, rund um die Uhr zu arbeiten, um die Vorgaben und Ziele des CEOs zu erfüllen.“"
                            },
                            {
                                "example_id": "45df9c24-8ed6-49ae-96f5-186816cec7b9",
                                "sense_id": "48e4c904-5a77-3404-bfab-9850cdcd4f89",
                                "text": "„Mit fast jeder Entscheidung beeinflusst der Unternehmensleiter den Gewinn und die Liquidität des Unternehmens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
