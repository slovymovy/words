                    {
                        "translation_id": "3f5188d8-e655-4cc5-9bba-87d49574cb89",
                        "source_entry_id": "e8349e8f-3ce6-3ac7-a6e6-aad6c1279fac",
                        "source_sense_id": "af042999-8f04-3dcd-8dfe-0cae4d60e3c2",
                        "source_sense_description": "auch abwertend, Wirtschaft: Vorgang, bei dem etwas zur Ware wird; Kommodifizierung",
                        "target_lang_word": "commodification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commodification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e059a793-e22a-31d7-ade9-2cda40564f20",
                                        "entry_id": "33690c8d-ee0a-3230-8222-ad95d7c693ad",
                                        "glosses": [
                                            "The assignment of a commercial value to something previously without such value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a8cae55-283b-44de-986f-f526a4ae61e5",
                                                "sense_id": "e059a793-e22a-31d7-ade9-2cda40564f20",
                                                "text": "Near-synonyms: commercialization, monetization"
                                            },
                                            {
                                                "example_id": "d18a0309-fc2f-4002-b4f1-47620d9ba93f",
                                                "sense_id": "e059a793-e22a-31d7-ade9-2cda40564f20",
                                                "text": "Subcultures tend to go through continual cycles of commodification and resistance to that commodification."
                                            },
                                            {
                                                "example_id": "dc594719-1448-4168-8f57-ba9feec73efc",
                                                "sense_id": "e059a793-e22a-31d7-ade9-2cda40564f20",
                                                "text": "One drizzly morning, I joined a political walking tour to hear former combatants of the Troubles show off Belfast landmarks and tell their stories. Almost everything about this notion piqued my curiosity: the commodification of violence into a tourist product; the idea that “politics” was actually history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fc9a64c-56ca-38e3-8b40-77ea7eb43c7c",
                                        "entry_id": "33690c8d-ee0a-3230-8222-ad95d7c693ad",
                                        "glosses": [
                                            "The transformation from being commercialized on a nonfungible basis into becoming a commodity that is fungible."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60bf5fc1-16ff-4c66-ac1c-a1efaf18d6c0",
                                                "sense_id": "5fc9a64c-56ca-38e3-8b40-77ea7eb43c7c",
                                                "text": "A company that innovates to achieve the commercialization of a technology often must shift strategy some decades later in response to the advent of that technology's commodification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
