                        "glosses": [
                            "Being or relating to an anagram."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63dc83b-3cd6-475c-9243-8cac9e96e217",
                                "sense_id": "d1f074c8-a72b-30a9-9c26-88a1d83fc62c",
                                "text": "Who Was That Masked Woman? is about the life of Tretona Getroek, Noretta Koertge [the author]'s anagrammatic alter ego."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9caeb8d-f3f7-45d4-93c8-8acf69d2feef",
                        "source_entry_id": "1c7df813-0e89-396a-a4f6-b2619100c791",
                        "source_sense_id": "d1f074c8-a72b-30a9-9c26-88a1d83fc62c",
                        "source_sense_description": "being or relating to an anagram",
                        "target_lang_word": "anagrammatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anagrammatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d19d85ff-0209-38ec-b22b-928c1be30244",
                                        "entry_id": "230f3879-1882-35fc-93cf-f04ba4019f4a",
                                        "glosses": [
                                            "Qui a le caractère de l’anagramme ; qui est une anagramme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1702b0bb-45e3-441b-9078-e2ae483f58b9",
                                                "sense_id": "d19d85ff-0209-38ec-b22b-928c1be30244",
                                                "text": "J’avais pris possession d'un lot que je venais de gagner à une loterie ouverte par un horloger de Blois nommé Blau, qui vit encore, et dont le fils, aujourd'hui à Paris, a été baptisé du sobriquet anagrammatique de Baül par Théophile Gautier."
                                            },
                                            {
                                                "example_id": "019e8293-d6ba-4a08-9acb-b035545f1108",
                                                "sense_id": "d19d85ff-0209-38ec-b22b-928c1be30244",
                                                "text": "Certains rois français de la renaissance étaient tellement persuadés de leur pouvoir magique qu’ils engageaient des spécialistes chargés d’analyser les possibilités anagrammatiques de certains documents pour les aider à prendre leurs décisions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a9d677b-106e-355c-a2ad-89da5dbecb95",
                                        "entry_id": "230f3879-1882-35fc-93cf-f04ba4019f4a",
                                        "glosses": [
                                            "Relatif à l’anagramme, aux anagrammes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb2dccd-7207-4810-9d69-8eb57e71837b",
                                                "sense_id": "4a9d677b-106e-355c-a2ad-89da5dbecb95",
                                                "text": "En particulier, elle n’engage pas le versant de la lecture kabbalistique du Shir ha Shirim qui, avec ses pratiques anagrammatiques, ses jeux de chiffrage et de déchiffrage du signifiant, introduit dans une logique textuelle spécifique dont la prise en compte imposerait certainement un remaniement de l’analyse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anagrammatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5563be66-bbfe-3b83-ac25-c2227e1173b3",
                                        "entry_id": "0c9e4b6b-5975-3d9f-b10d-ea56f1612d07",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "Extrêmement rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44cd42f-7700-42db-870b-72c5fe2529e8",
                                                "sense_id": "5563be66-bbfe-3b83-ac25-c2227e1173b3",
                                                "text": "Est-il possible d’envisager une anagrammatique fondée à la fois sur la couplaison et le monophone ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
