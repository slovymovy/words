                ],
                "senses": [
                    {
                        "sense_id": "17cb5f28-11c7-3ee7-a398-b24828a5581e",
                        "entry_id": "a876f56c-4925-3156-855e-3f081ae5ef7b",
                        "glosses": [
                            "Jargon, Person, die Krawall verursacht, um Maßnahmen gegen die Klimakrise zu erzwingen oder die bei solchen Krawallen mitmacht"
                        ],
                        "tags": [
                            "derogatory",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "488b929d-1309-463c-8505-ca2658d97315",
                                "sense_id": "17cb5f28-11c7-3ee7-a398-b24828a5581e",
                                "text": "„Klima-Krawallos gehen auf Polizisten in Lützerath los – jetzt kommt Verstärkung.“"
                            },
                            {
                                "example_id": "20f24b48-9f0c-4c4f-9ccf-4e73f535c1b6",
                                "sense_id": "17cb5f28-11c7-3ee7-a398-b24828a5581e",
                                "text": "„Es ist politische Selbstjustiz, was die Klima-Krawallos zu praktizieren versuchen. Sie wollen entscheiden, was in diesem Land geschehen kann und darf.“"
                            },
                            {
                                "example_id": "8fb95c61-0480-4596-9867-5e32be2b375e",
                                "sense_id": "17cb5f28-11c7-3ee7-a398-b24828a5581e",
                                "text": "„Es ist friedlich, auch wenn die Polizei immer wieder Protestierende wegträgt. Von den ‚Klima-Krawallos‘, wie eine Boulevardzeitung schrieb, war bislang nicht viel zu sehen.“"
                            },
                            {
                                "example_id": "1ea9fa13-3f32-4e1c-a5a3-12a7a4136616",
                                "sense_id": "17cb5f28-11c7-3ee7-a398-b24828a5581e",
                                "text": "„Sie nennen sich ‚Extinction Rebellion‘, zelten vor dem Kanzleramt – und machen Übungen für ihre massiven Stör-Aktionen. Und Sie haben sogar Promis als Unterstützer. Wer sind diese Klima-Krawallos?“"
                            },
                            {
                                "example_id": "ed3c969d-db01-4197-b0fd-4643ef952c83",
                                "sense_id": "17cb5f28-11c7-3ee7-a398-b24828a5581e",
                                "text": "„[SPIEGEL:] Der alte Alexander Dobrindt hätte die Schüler vielleicht ‚Klima-Krawallos‘ genannt. Ihr neues Ich ist geradezu unheimlich verständnisvoll. [Dobrindt:] Letztlich fordern die Schüler ein, was wir im Pariser Klimaabkommen vereinbart haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
