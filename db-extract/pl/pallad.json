                                            {
                                                "example_id": "6c74ee66-3f79-4192-ae59-cbb0e94b2d4a",
                                                "sense_id": "0b05fd77-c822-3176-b3ec-cbc34e78337d",
                                                "text": "Feinverteilt ist Palladium ein exzellenter Katalysator."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87976e31-93b0-39b3-ac58-78b43822a216",
                                        "entry_id": "725f6991-15ff-3bf4-a122-f3d0415140a8",
                                        "glosses": [
                                            "etwas Heiligzuhaltendes; ein unantastbares Gut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d279ed5-1bc4-441e-80a2-7086f61e4457",
                                                "sense_id": "87976e31-93b0-39b3-ac58-78b43822a216",
                                                "text": "Die Palladien des Heeres waren ihre Fahnen und Standarten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c2e3dc-cac1-477b-baba-46c6003f40ce",
                        "source_entry_id": "09e28c17-11e2-3243-b6d9-8715cae83ede",
                        "source_sense_id": "2fa54d2c-bb7e-3dab-890f-46f9638f5e30",
                        "target_lang_word": "палладий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "палладий",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e70b015e-7e08-3097-a36b-93f2c6c20621",
                                        "entry_id": "09908f5f-13f0-37c4-8d5d-f5e34f4f34b4",
                                        "glosses": [
                                            "хим. химический элемент с атомным номером 46, обозначается химическим символом Pd, благородный металл"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b014f96e-c9b1-4b0b-8d58-e86c0364d4ee",
                                                "sense_id": "e70b015e-7e08-3097-a36b-93f2c6c20621",
                                                "text": "Есть важные указания на присутствие платины и сопутствующих ей драгоценных металлов: иридия, палладия и осмия."
                                            },
                                            {
                                                "example_id": "9f2d8422-832b-49b3-98e2-4eba92d63d40",
                                                "sense_id": "e70b015e-7e08-3097-a36b-93f2c6c20621",
                                                "text": "Наконец, чрезвычайно химически стойкие сплавы, содержащие драгоценные металлы — золото, платину, иридий, палладий, — тоже однофазные твёрдые растворы."
                                            },
                                            {
                                                "example_id": "50c7b89d-fb1b-4f06-93ad-6fced196d66e",
                                                "sense_id": "e70b015e-7e08-3097-a36b-93f2c6c20621",
                                                "text": ".. палладий и его соединения в гораздо большей степени биосовместимы с организмом человека, чем никелевые соединения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
