                                        "glosses": [
                                            "Cire destinée à cacheter les lettres ou tout autres choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b36f21-ccd7-4736-bd61-96d789c41640",
                                                "sense_id": "e48c12f9-5739-3636-92af-308d4c364dee",
                                                "text": "L’un emporte chez lui un encrier, l’autre fait ouvertement commerce de poudre à sécher, de sandaraque, de cire à cacheter… sans parler des garçons de bureau qui enlèvent les cendres des cheminées pour les vendre aux blanchisseurs !"
                                            },
                                            {
                                                "example_id": "92782034-581e-4beb-a679-d6e1e9b124cc",
                                                "sense_id": "e48c12f9-5739-3636-92af-308d4c364dee",
                                                "text": "En 1788, M. Graffe présenta à l’Académie des sciences, des cires à cacheter de couleur bleue de roi, de couleur bleue pâle, et de couleur violette de bonne qualité, ce qu’on n’avait pu obtenir jusqu’alors."
                                            },
                                            {
                                                "example_id": "bda1e5f8-50f5-4537-8511-06ac82eebff1",
                                                "sense_id": "e48c12f9-5739-3636-92af-308d4c364dee",
                                                "text": "Coffret de 6 cires à cacheter naturelles, composé d'un bâton de cire rouge, un orange, un jaune, un vert olive, un bleu ciel et un lavande."
                                            }
                                        ]
                                    }
