                            {
                                "example_id": "368c43ae-ba02-4bb6-9e58-dd47e5a5a211",
                                "sense_id": "eaee3aeb-6f9d-32e4-a1d3-a9186516880e",
                                "text": "De in 1955 in Strijen geboren Anton Corbijn begon zijn carrière als fotograaf bij het Nederlandse muziektijdschrift Oor. In de jaren zeventig fotografeerde hij concerten en portretteerde hij muzikanten als Herman Brood en Elvis Costello."
                            },
                            {
                                "example_id": "ad171152-c162-4cc5-92df-3addc6164a85",
                                "sense_id": "eaee3aeb-6f9d-32e4-a1d3-a9186516880e",
                                "text": "Het orkest heeft internationaal een grote naam opgebouwd. In 2008 werd het orkest door het gerenommeerde muziektijdschrift Gramophone uitgeroepen tot 'World's Greatest Orchestra'. Bij het eeuwfeest in 1988 werd het predicaat 'Koninklijk' aan het orkest toegekend."
                            }
                        ]
