                        "form": "orisons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98327ad8-5e28-39bf-9987-9c547b5cfd88",
                        "entry_id": "e6607d6e-b405-3d27-be52-98071cad3a27",
                        "glosses": [
                            "A prayer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a569e12e-673b-4184-b605-4964ba5da18e",
                                "sense_id": "98327ad8-5e28-39bf-9987-9c547b5cfd88",
                                "text": "The faire Ophelia! Nymph, in thy Orizons / Be all my ſinnes remembred."
                            },
                            {
                                "example_id": "10895059-0a0c-4397-b238-24a572e2186d",
                                "sense_id": "98327ad8-5e28-39bf-9987-9c547b5cfd88",
                                "text": "\"I hope,\" said a voice by her side, \"your absent brother will not engross all your orisons.\""
                            },
                            {
                                "example_id": "14aed738-e8d7-4c89-ac31-4bd6958e8bdb",
                                "sense_id": "98327ad8-5e28-39bf-9987-9c547b5cfd88",
                                "text": "1917, Wilfred Owen, Anthem for Doomed Youth\nOnly the stuttering rifles' rapid rattle\nCan patter out their hasty orisons."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e634818-820d-377e-ba13-9775934f6757",
                        "entry_id": "e6607d6e-b405-3d27-be52-98071cad3a27",
                        "glosses": [
                            "Mystical contemplation or communion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c937219-052e-4860-a6ab-bb4673ed1300",
                                "sense_id": "8e634818-820d-377e-ba13-9775934f6757",
                                "text": "We shall see later that the absence of definite sensible images is positively insisted on by the mystical authorities in all religions as the sine qua non of a successful orison, or contemplation of the higher divine truths."
                            },
                            {
                                "example_id": "2b5134ac-4b61-42aa-9f28-9f96c9e0c598",
                                "sense_id": "8e634818-820d-377e-ba13-9775934f6757",
                                "text": "Only in certain occult and mystic states: in orison, contemplation, ecstasy and their allied conditions; does the self contrive to turn out the usual tenants, shut the \"gateways of the flesh,\" and let those submerged powers which are capable of picking up messages from another plane of being have their turn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99166072-05be-4986-8a3a-f0d9800e3244",
                        "source_entry_id": "e6607d6e-b405-3d27-be52-98071cad3a27",
                        "source_sense_description": "A prayer",
                        "target_lang_word": "gebed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gebed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2381b174-a1b9-3ff3-8979-5275b5a19e67",
                                        "entry_id": "ff7d0d95-e46a-390d-8267-8026fdac27b8",
                                        "glosses": [
                                            "het bidden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02694ed0-2940-4fda-9ed6-0aa714726ab2",
                                                "sense_id": "2381b174-a1b9-3ff3-8979-5275b5a19e67",
                                                "text": "De tweede werd geboren in de zesde eeuw. Eigenlijk was hij een zeer eenvoudige monnik, die later abt werd van het klooster in Myra. Een bijzonder vrome man, die door zijn gebed de mensen kon genezen. Hij overleed op 10 december van het jaar 564."
                                            },
                                            {
                                                "example_id": "631d2060-1707-4a98-be5e-22203c5d744d",
                                                "sense_id": "2381b174-a1b9-3ff3-8979-5275b5a19e67",
                                                "text": "Gebed: Moeder Maria, bevrijd ons van Poetin (Pussy Riot)"
                                            },
                                            {
                                                "example_id": "5d530899-192c-4c5b-bc08-814889bcfafe",
                                                "sense_id": "2381b174-a1b9-3ff3-8979-5275b5a19e67",
                                                "text": "Alles draait in dienst in Baptistenkerk om het thema dankbaarheid. Of het nu het gebed, de preek, een klein toneelspel of de tekst van psalmen, gezangen en liederen, is, alles daat erom dat mensen in het leven dankbaar moeten zijn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gebed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1e6cfcf7-5798-3742-9ef9-5bee4b78af8a",
                                        "entry_id": "43f3d17c-71c2-32e4-9114-2692b957d953",
                                        "glosses": [
                                            "voltooid deelwoord van bedden"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67f3c3de-35a4-4698-8be5-8c66678fe2da",
                        "source_entry_id": "e6607d6e-b405-3d27-be52-98071cad3a27",
                        "source_sense_description": "A prayer",
                        "target_lang_word": "oraison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oraison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38fbde0b-2442-3f85-976b-e55dfe6664c8",
                                        "entry_id": "0e467606-f12a-3e51-9948-3f6a4eca4537",
                                        "glosses": [
                                            "Assemblage de mots qui forment un sens complet et qui sont construits suivant les règles grammaticales."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2ac81a-5785-4465-a034-8b86d1ced392",
                                                "sense_id": "38fbde0b-2442-3f85-976b-e55dfe6664c8",
                                                "text": "Les parties d’oraison ou de l’oraison sont les différentes espèces de mots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136d0009-d320-3b75-8ee0-d9fada0ec43a",
                                        "entry_id": "0e467606-f12a-3e51-9948-3f6a4eca4537",
                                        "glosses": [
                                            "Ouvrage d’éloquence composé pour être prononcé en public."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea3fc5f2-5668-457f-a6a9-ffaed10ba15c",
                                                "sense_id": "136d0009-d320-3b75-8ee0-d9fada0ec43a",
                                                "text": "L’exorde est une des parties de l’oraison."
                                            },
                                            {
                                                "example_id": "34f1e25c-fb64-4222-9978-3373ebda8ec9",
                                                "sense_id": "136d0009-d320-3b75-8ee0-d9fada0ec43a",
                                                "text": "Je lui apprendrai, dit le docteur, les huit parties d’oraison, la dialectique, l’astrologie, la démonomanie, ce que c’est que la substance et l’accident, l’abstrait et le concret, les monades et l’harmonie préétablie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2003e0ce-2213-3cfb-8495-4e7adbb69d2e",
                                        "entry_id": "0e467606-f12a-3e51-9948-3f6a4eca4537",
                                        "glosses": [
                                            "Discours prononcé à la louange des morts, surtout en chaire."
                                        ],
                                        "tags": [
                                            "Aujourd’hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "942cd498-4ff1-431c-84c1-dd816c726e8b",
                                                "sense_id": "2003e0ce-2213-3cfb-8495-4e7adbb69d2e",
                                                "text": "Elle s’égaie en mille endroits sur les évêques : « L’évêque d’Autun prononça l’oraison funèbre de madame de Lougueville avec toute la capacité, toute la grâce et toute l’habileté dont un homme puisse être capable : ce n’était point Tartufe, ce n’était point un patelin, c’était un prélat de conséquence. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7704adfe-bf26-31fb-aa18-1b7d5056d682",
                                        "entry_id": "0e467606-f12a-3e51-9948-3f6a4eca4537",
                                        "glosses": [
                                            "Prière adressée à Dieu ou aux saints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b76ca1dd-b534-482b-990e-d7047cfeb83f",
                                                "sense_id": "7704adfe-bf26-31fb-aa18-1b7d5056d682",
                                                "text": "Il marmotta des oraisons tant que dura la nuit, sans décroiser un moment ses bras de son camail de soie violette […]"
                                            },
                                            {
                                                "example_id": "59f661fb-f378-4a56-8c1c-ef35c8891f0e",
                                                "sense_id": "7704adfe-bf26-31fb-aa18-1b7d5056d682",
                                                "text": "Dans sa folie, elle […] pria le ciel, en donnant aux paroles habituelles de son oraison un accent intime, une signification nouvelle qui eussent déchiré le cœur de son mari, s’il l’eût entendue."
                                            },
                                            {
                                                "example_id": "c3ad45ec-8720-4677-b5fe-4f10181c1a54",
                                                "sense_id": "7704adfe-bf26-31fb-aa18-1b7d5056d682",
                                                "text": "[…] à travers les persiennes fermées, je regardais des pauvresses s’accroupir sur la pelouse, un cierge à la main, et marmotter des oraisons […]"
                                            },
                                            {
                                                "example_id": "d16cc2e5-9720-4410-89c6-fdb2e31ed324",
                                                "sense_id": "7704adfe-bf26-31fb-aa18-1b7d5056d682",
                                                "text": "[…], elle implorait le Saint-Esprit, et contracta l’habitude idolâtre de dire ses oraisons, agenouillée devant le perroquet. Quelquefois, le soleil entrant par la lucarne frappait son œil de verre, et en faisait jaillir un grand rayon lumineux qui la mettait en extase."
                                            },
                                            {
                                                "example_id": "f5e895a2-cb43-4299-b7e3-fa3c2851411c",
                                                "sense_id": "7704adfe-bf26-31fb-aa18-1b7d5056d682",
                                                "text": "[…] et les grand-mères au tricot ou au rouet d’ajouter de ferventes oraisons à leurs prières habituelles : « Seigneur, seigneur, mon Dieu ne nous enlevez pas nos tenderies, par J.-C. notre Sauveur. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6bf642a-4d48-3f61-8620-e26f27a41a5e",
                                        "entry_id": "0e467606-f12a-3e51-9948-3f6a4eca4537",
                                        "glosses": [
                                            "Communication de l’âme avec Dieu, sans entremise d’une formule de prières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc52bcb-d79c-4e1e-b862-b5f3a8e8c8c7",
                                                "sense_id": "e6bf642a-4d48-3f61-8620-e26f27a41a5e",
                                                "text": "Les états d’oraison. Faire oraison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b79f74c2-255a-4ecb-a528-1aacb4ac0bb1",
                        "source_entry_id": "e6607d6e-b405-3d27-be52-98071cad3a27",
                        "source_sense_description": "A prayer",
                        "target_lang_word": "Gebet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                        "entry_id": "d1bb51c8-4933-31de-8103-be8fae841650",
                                        "glosses": [
                                            "an einen Gott gerichtete Bitte, Gespräch mit einem Gott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a115103-0009-43f2-a543-ad8bb95e7896",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Ich werde euch in mein Gebet mit einschließen."
                                            },
                                            {
                                                "example_id": "7ef4e064-f9ac-4c86-a96b-d45c9a5250e6",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Der Mensch, der sich vielen Glückes und seiner Schwäche bewußt ist, wird abergläubisch, flüchtet zum Gebete. (Georg Christoph Lichtenberg)"
                                            },
                                            {
                                                "example_id": "aad5a573-a6d5-4cd9-b613-f6ad84d171bc",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Als sie das Zimmer betrat, war ihr Vater noch ganz im Gebet versunken."
                                            },
                                            {
                                                "example_id": "5817d55e-cf17-4b56-af00-23944a6704e4",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Ich hoffe, dass eure Gebete erhört werden."
                                            },
                                            {
                                                "example_id": "3fe58803-fa0b-46d0-9228-27e11b232956",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Meine Gebete lagen mir tot auf der Zunge.“"
                                            },
                                            {
                                                "example_id": "b2bf0ebb-7130-47b5-93d8-e39cc1725f05",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Nach dem Gebet aßen sie schweigend.“"
                                            },
                                            {
                                                "example_id": "ecb49c59-786a-4c94-861e-55159cda0bfd",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Beim Gebet für die Krieger dachte sie an ihren Bruder und an Denissow.“"
                                            },
                                            {
                                                "example_id": "2e83118e-7e0c-46a0-82be-4d806203daee",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Es war die Bischöfin, die mit gottesfürchtiger Stimme, gebeugten Hauptes, die Augen geschlossen und die Hände gefaltet, diese Worte in das Gebet einschob.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                        "entry_id": "d1bb51c8-4933-31de-8103-be8fae841650",
                                        "glosses": [
                                            "meist festgelegte Worte, die an eine Gottheit gerichtet sind, um sie zu bitten, ihr zu danken oder sie zu verehren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff698ea-1208-4315-ba2b-b9c72d46a568",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Die Gemeinde sprach ein Gebet."
                                            },
                                            {
                                                "example_id": "3064a099-8003-4d5e-9aeb-75c52a536b77",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Sie kniete vor dem Altar nieder und murmelte ein Gebet."
                                            },
                                            {
                                                "example_id": "82ecbd3e-9280-4126-8959-c6ab67351d25",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Seine Mutter ermahnte ihn, dass er das Gebet nicht bloß herunterleiern solle."
                                            },
                                            {
                                                "example_id": "86b7764b-513d-4cb8-a325-acca876b0bc6",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Er übersetzt jüdische Gebete aus dem Hebräischen ins Deutsche."
                                            },
                                            {
                                                "example_id": "185f541c-e005-4401-9830-7ffacc608512",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "„Er sagte auch nichts, als Sloan das Gebet beendet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd532d0a-db47-4bce-bab2-c6dc1acc82e8",
