                "senses": [
                    {
                        "sense_id": "e9b19a94-b1c9-311e-b653-f975ddc57a47",
                        "entry_id": "21ffb181-8ba4-3f78-ae01-db70bd7a1178",
                        "glosses": [
                            "Séquence d’instructions de rendu visuel, auditif ou tactile d’une ressource HTML ou XML."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6f074e-b06c-4dd3-8b55-649ab132357a",
                                "sense_id": "e9b19a94-b1c9-311e-b653-f975ddc57a47",
                                "text": "Dans certains cas extrêmes de recherche de performance, il est même conseillé de mettre le CSS directement en embarqué dans la page (ou du moins la partie critique pour accélérer la sensation de vitesse d’affichage de la page), c’est dire à quel point cette partie est critique."
                            },
                            {
                                "example_id": "0776072b-d356-4807-b85e-1ae7bb09196c",
                                "sense_id": "e9b19a94-b1c9-311e-b653-f975ddc57a47",
                                "text": "Par exemple, une web font embarquée dans la CSS va alourdir de manière conséquente cette dernière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fde286a-a5e5-4c32-8230-ed9863647099",
                        "source_entry_id": "21ffb181-8ba4-3f78-ae01-db70bd7a1178",
