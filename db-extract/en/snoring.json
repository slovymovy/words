                    {
                        "translation_id": "3f01bc10-dd5f-4327-83a7-4b086943cf2e",
                        "source_entry_id": "297e6e17-90cc-33aa-ad78-b070077e118f",
                        "source_sense_id": "ee508ad2-6a0b-3763-b1eb-23273df307b4",
