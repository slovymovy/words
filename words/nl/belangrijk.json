                        {
                            "text": "Het is <w>belangrijk</w> dat je goed naar de leraar luistert.",
                            "target_lang_translations": {
                                "en": "It is <w>important</w> that you listen closely to the teacher.",
                                "ru": "<w>Важно</w>, чтобы ты внимательно слушал учителя.",
                                "pl": "To <w>ważne</w>, abyś uważnie słuchał nauczyciela.",
                                "de": "Es ist <w>wichtig</w>, dass du dem Lehrer gut zuhörst.",
                                "fr": "Il est <w>important</w> que tu écoutes attentivement le professeur.",
                                "it": "È <w>importante</w> che tu ascolti attentamente l'insegnante.",
