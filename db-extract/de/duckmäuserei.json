                "senses": [
                    {
                        "sense_id": "0bf29d20-6345-3de2-a7ca-f531d25439b2",
                        "entry_id": "f4d88891-7274-3c4f-a344-79b699f4e33f",
                        "glosses": [
                            "Verhalten von jemand, der es nicht wagt, offen für etwas einzutreten, was er für richtig hält"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "7def26de-d13e-46fa-ae4c-621f99fa434d",
                                "sense_id": "0bf29d20-6345-3de2-a7ca-f531d25439b2",
                                "text": "„Der zu Schweigen und Duckmäuserei gezwungene Staatsfunktionär konnte erst aufatmen, als im September 96 Kaiser Nerva auf den Thron kam.“"
                            },
                            {
                                "example_id": "5d29bf18-508d-46b7-bfcc-d1596920eab3",
                                "sense_id": "0bf29d20-6345-3de2-a7ca-f531d25439b2",
                                "text": "„Das Landratsamt Coburg weist eindringlich darauf hin, dass alle Handlungen, die die Funktion von Weidezäunen (insbes. von mobilen Elektrozäunen um Schafkoppeln) beeinträchtigen (z.B. öffnen, umlegen, zerschneiden, umwickeln oder auch nur von der Stromversorgung abtrennen) keineswegs als harmlose Späße und Duckmäusereien anzusehen sind, sondern dass daraus eine ernste Gefahr für die öffentliche Sicherheit erwächst!“"
                            },
                            {
                                "example_id": "8e84d9c5-b53e-4b13-be7f-1c138bf27e19",
                                "sense_id": "0bf29d20-6345-3de2-a7ca-f531d25439b2",
                                "text": "„Ich hätte der Natur die feigste Duckmäuserei vorgeworfen, hätte sie ohne meine Zustimmung den Platz zu räumen gewagt, in dessen Besitz ich mich fühlte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
