{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82794395-5616-3881-8381-afd06a29c804",
                    "sense_definition": "A reduction in the recognized value of an asset, or the cancellation of an unpaid debt or expense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_cancellation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a substantial <w>write-off</w> of bad debts after several major clients collapsed.",
                            "target_lang_translations": {
                                "pl": "Firma odnotowała znaczny <w>odpis</w> nieściągalnych długów po upadku kilku kluczowych klientów."
                            }
                        },
                        {
                            "text": "You might be able to claim the home office costs as a tax <w>write-off</w>.",
                            "target_lang_translations": {
                                "pl": "Być może uda ci się zgłosić koszty domowego biura jako <w>odliczenie od podatku</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax write-off"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zmniejszenie wartości księgowej aktywa, umorzenie niespłacalnego długu lub wydatek podlegający odliczeniu od podatku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odpis",
                                "target_lang_sense_clarification": "w księgowości, np. aktualizujący lub amortyzacyjny"
                            },
                            {
                                "target_lang_word": "odpisanie długu",
                                "target_lang_sense_clarification": "umorzenie niespłacalnego zadłużenia"
                            },
                            {
                                "target_lang_word": "odliczenie od podatku",
                                "target_lang_sense_clarification": "koszt zmniejszający podstawę opodatkowania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbc8d75f-960b-351a-b778-b939be94d879",
                    "sense_definition": "A vehicle or other object damaged beyond economical repair, or a venture deemed a total failure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worthless_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although the driver escaped unharmed, the car was declared a complete <w>write-off</w>.",
                            "target_lang_translations": {
                                "pl": "Chociaż kierowca wyszedł bez szwanku, w przypadku samochodu orzeczono <w>szkodę całkowitą</w>."
                            }
                        },
                        {
                            "text": "The entire weekend turned into a <w>write-off</w> because of the relentless rain.",
                            "target_lang_translations": {
                                "pl": "Cały weekend okazał się <w>stracony</w> przez nieustanny deszcz."
                            }
                        }
                    ],
                    "synonyms": [
                        "total loss"
                    ],
                    "common_phrases": [
                        "complete write-off"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pojazd lub przedmiot nienadający się do ekonomicznie uzasadnionej naprawy, bądź przedsięwzięcie lub czas uznane za całkowitą stratę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szkoda całkowita",
                                "target_lang_sense_clarification": "o zniszczonym pojeździe lub mieniu"
                            },
                            {
                                "target_lang_word": "wrak",
                                "target_lang_sense_clarification": "o zniszczonym samochodzie"
                            },
                            {
                                "target_lang_word": "niewypał",
                                "target_lang_sense_clarification": "o nieudanym planie lub przedsięwzięciu"
                            },
                            {
                                "target_lang_word": "strata",
                                "target_lang_sense_clarification": "o zmarnowanym czasie lub nieudanym przedsięwzięciu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bce2ace3-d458-38b2-98fe-fe19421e68e1",
                    "sense_definition": "Alternative form of <w>write off</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank made the controversial decision to <w>write-off</w> millions in bad loans.",
                            "target_lang_translations": {
                                "pl": "Bank podjął kontrowersyjną decyzję, aby <w>spisać na straty</w> miliony w złych kredytach."
                            }
                        },
                        {
                            "text": "Management had to <w>write-off</w> the damaged equipment over its remaining physical life.",
                            "target_lang_translations": {
                                "pl": "Kierownictwo musiało <w>odpisać</w> uszkodzony sprzęt w trakcie pozostałego okresu jego zdatności."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nonstandard"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wariant zapisu czasownika 'write off': spisać na straty, umorzyć dług lub uznać coś za bezwartościowe."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "spisać na straty",
                                "target_lang_sense_clarification": "dokonać odpisu księgowego lub pogodzić się ze stratą"
                            },
                            {
                                "target_lang_word": "umorzyć",
                                "target_lang_sense_clarification": "np. dług lub pożyczkę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}