                "senses": [
                    {
                        "sense_id": "185dc974-2133-33c8-b679-baf90fb5e477",
                        "entry_id": "75dad43c-946e-353b-9424-041fad2b7841",
                        "glosses": [
                            "женск. к абхаз, абхазец; представительница народа абхазо-адыгской этноязыковой группы, населяющего Абхазию, выходец из Абхазии или потомок таких выходцев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46190451-cc8d-4244-8103-f6d137a919b4",
                                "sense_id": "185dc974-2133-33c8-b679-baf90fb5e477",
                                "text": "Абхазки умеют делать и хлопковую ткань, необработанное сырьё для которой привозят из Турции."
                            }
                        ]
                    },
                    {
                        "sense_id": "3baeabd4-de1a-3394-b3f8-b021a02906fc",
                        "entry_id": "75dad43c-946e-353b-9424-041fad2b7841",
                        "glosses": [
                            "национальный абхазский танец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce20b1da-be8f-434e-8c2f-b43048b61ffd",
                                "sense_id": "3baeabd4-de1a-3394-b3f8-b021a02906fc",
                                "text": "На балу, следовавшем за обедом, его высочество заинтересовали национальные танцы, лезгинка и абхазка, исполненные молодыми людьми знатнейших семей Грузии."
                            }
                        ]
                    }
                ],
