                "senses": [
                    {
                        "sense_id": "c0bb1bf1-bb56-3fa9-916c-efc5e741479d",
                        "entry_id": "4900842e-d3d9-353f-b03b-f18ee46e10ca",
                        "glosses": [
                            "Schlacht, Kampf"
                        ],
