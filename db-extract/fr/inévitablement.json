                                        "sense_id": "535d15ea-311e-3742-ba4c-14a8afdda38d",
                                        "entry_id": "8fcb44c3-00b9-3717-b9a9-336fd24f907e",
                                        "glosses": [
                                            "que não se pode evitar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02086c17-9885-4676-86c0-92a35cdce4b0",
                                                "sense_id": "535d15ea-311e-3742-ba4c-14a8afdda38d",
                                                "text": "«O outono chega todos os anos e, inevitavelmente, as folhas das árvores começam a cair.»"
