                    {
                        "translation_id": "26c67be3-0f1c-4af0-9987-0d304dde66a8",
                        "source_entry_id": "6e812738-1058-3597-8924-3e149bf7f65a",
                        "source_sense_id": "d809dd98-24d1-332b-95bf-68676ff7e3a8",
