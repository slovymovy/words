{
    "word_family": [
        "arraigner",
        "arraignment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffb3d194-23a0-3d84-98ef-3fc89d5a6b73",
                    "sense_definition": "To call a defendant before a court to answer a formal criminal charge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "charge_or_accuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect will be <w>arraigned</w> in federal court tomorrow morning.",
                            "target_lang_translations": {
                                "zh": "该嫌疑人将于明天上午在联邦法院接受<w>传讯</w>。"
                            }
                        },
                        {
                            "text": "Authorities plan to <w>arraign</w> him on multiple charges of fraud and theft.",
                            "target_lang_translations": {
                                "zh": "有关部门计划就多项欺诈和盗窃指控对他进行<w>提讯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indict",
                        "charge"
                    ],
                    "common_phrases": [
                        "arraign on charges"
                    ],
                    "target_lang_definitions": {
                        "zh": "（法庭上）传讯，提讯（被告到庭听取控告并答辩）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "传讯",
                                "target_lang_sense_clarification": "传唤被告到庭听取正式指控"
                            },
                            {
                                "target_lang_word": "提审",
                                "target_lang_sense_clarification": "提请到庭审问或确认罪名"
                            },
                            {
                                "target_lang_word": "提讯",
                                "target_lang_sense_clarification": "提解到庭进行正式审讯或答辩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59248a30-8ab7-3a0f-9554-31787566c708",
                    "sense_definition": "To call into question or publicly accuse someone of a fault or wrongdoing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "charge_or_accuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editorial proceeded to <w>arraign</w> the government for failing to act swiftly.",
                            "target_lang_translations": {
                                "zh": "这篇社论接着<w>谴责</w>政府未能迅速采取行动。"
                            }
                        },
                        {
                            "text": "Critics often <w>arraign</w> the modern education system for prioritizing tests over critical thinking.",
                            "target_lang_translations": {
                                "zh": "批评人士经常<w>指责</w>现代教育体系将考试置于批判性思维之上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "censure",
                        "denounce"
                    ],
                    "target_lang_definitions": {
                        "zh": "公开指责，谴责，抨击（错误或不当行为）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "谴责",
                                "target_lang_sense_clarification": "公开批评或斥责"
                            },
                            {
                                "target_lang_word": "指责",
                                "target_lang_sense_clarification": "指出过错并加以责备"
                            },
                            {
                                "target_lang_word": "抨击",
                                "target_lang_sense_clarification": "用言论严厉攻击或批判"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f9431cf-2767-3b1c-b434-f8bb3010d00a",
                    "sense_definition": "An arraignment or call to answer criminal charges in a court.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk of the <w>arraigns</w> read out the formal charges against the prisoner.",
                            "target_lang_translations": {
                                "zh": "<w>提讯</w>书记官宣读了针对该犯人的正式指控。"
                            }
                        },
                        {
                            "text": "He waited in the holding cell until the morning <w>arraigns</w> commenced.",
                            "target_lang_translations": {
                                "zh": "他一直待在拘留室里，直到早间的<w>传讯</w>程序开始。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arraignment"
                    ],
                    "common_phrases": [
                        "clerk of the arraigns"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used rarely in modern legal contexts except in traditional titles."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧）提讯程序，传讯提审"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "提讯",
                                "target_lang_sense_clarification": "指到庭受审的程序或审理过程"
                            },
                            {
                                "target_lang_word": "传讯",
                                "target_lang_sense_clarification": "传唤到庭答辩的程序"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}