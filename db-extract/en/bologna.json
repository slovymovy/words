                    {
                        "translation_id": "9acdc2b2-19ef-4d3a-b017-09520f6b8f4a",
                        "source_entry_id": "d74a5083-8be4-3dad-a403-9dc7a48e2b55",
                        "source_sense_description": "province",
                        "target_lang_word": "Bologna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bologna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c48d5139-8128-3ab3-97ba-b662747f74cb",
                                        "entry_id": "7b98f9c9-19eb-34e1-94e3-85f7d7548082",
                                        "glosses": [
                                            "Stadt, Hauptstadt der italienischen Region Emilia-Romagna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7513cf48-3f1d-4028-9bd5-d75cb95cae2e",
                                                "sense_id": "c48d5139-8128-3ab3-97ba-b662747f74cb",
                                                "text": "Nach Bologna führen viele Wege."
                                            },
                                            {
                                                "example_id": "673f2fd3-0de7-470f-9e70-24c805941be9",
                                                "sense_id": "c48d5139-8128-3ab3-97ba-b662747f74cb",
                                                "text": "Wir fahren nach Bologna!"
                                            },
                                            {
                                                "example_id": "feb6c0e8-8c65-4791-8562-4cb26d57890c",
                                                "sense_id": "c48d5139-8128-3ab3-97ba-b662747f74cb",
                                                "text": "Das mittelalterliche Bologna spielte in der Geschichte eine bedeutende Rolle."
                                            },
                                            {
                                                "example_id": "d5a61131-43db-4ca4-8797-3482ca67a8d8",
                                                "sense_id": "c48d5139-8128-3ab3-97ba-b662747f74cb",
                                                "text": "Ich bin in Bologna geboren."
                                            },
                                            {
                                                "example_id": "b76b9770-0cb2-4fd5-9b7e-4e486ae73b1f",
                                                "sense_id": "c48d5139-8128-3ab3-97ba-b662747f74cb",
                                                "text": "Ich habe in Bologna meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "ae059fb8-a5bd-4b5c-9e63-05419afca7d3",
                                                "sense_id": "c48d5139-8128-3ab3-97ba-b662747f74cb",
                                                "text": "„Ich hielte mich nur einen Tag in Ancona auf, um dem Bankier meinen Kreditbrief zu präsentieren und mir einen neuen für Bologna ausstellen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
