                "senses": [
                    {
                        "sense_id": "04ed5ba6-8833-3dde-897c-028ddb833d85",
                        "entry_id": "0e73ad48-2f45-3470-ab3d-ba52769f8364",
                        "glosses": [
                            "Regiment der Ulanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2001b5-312c-4efb-b28d-892980b82a62",
                                "sense_id": "04ed5ba6-8833-3dde-897c-028ddb833d85",
                                "text": "„Ein Offizier des polnischen Ulanenregiments erschien bei den Kanonieren und nahm das Pferd ohne ein Wort des Dankes an sich.“"
                            },
                            {
                                "example_id": "aea35015-765f-4f16-8730-0850fafd051b",
                                "sense_id": "04ed5ba6-8833-3dde-897c-028ddb833d85",
                                "text": "„[…], er diente nach Besuch der Wiener Neustädter Militärakademie beim Ulanenregiment Nummer eins (Beförderung bis zum Major), war 1885-1887 Kommandant des Militär-Fecht- und Turnlehrerkurses in Wiener Neustadt und kam 1892 ins Reitlehrinstitut nach Wien (3, Ungargasse 69), dessen Kommandant er wurde.“"
                            },
                            {
                                "example_id": "be8bad0b-d255-443d-953b-c4459c6427b3",
                                "sense_id": "04ed5ba6-8833-3dde-897c-028ddb833d85",
                                "text": "„In Galizien war Michael Rosenfeld Unteroffizier in einem Ulanenregiment gewesen.“"
                            },
                            {
                                "example_id": "6c7fedc7-d17a-462d-96cf-82f3662c0c70",
                                "sense_id": "04ed5ba6-8833-3dde-897c-028ddb833d85",
                                "text": "„An der breiten Wilija angelangt, parierte er sein Pferd unmittelbar vor einem am Ufer haltenden polnischen Ulanenregiment.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
