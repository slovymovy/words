                        "form_id": "75f24ebb-bb21-44b3-8a1d-1598580f0b67",
                        "entry_id": "47831ba8-b528-3f37-a4a1-6cef6387bda6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Afrikanerin"
                    },
                    {
                        "form_id": "079d1af2-e5da-4a53-960c-ed8a1087cc25",
                        "entry_id": "47831ba8-b528-3f37-a4a1-6cef6387bda6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Afrikanerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59b3db2f-b951-34a9-9e91-795117249aa8",
                        "entry_id": "47831ba8-b528-3f37-a4a1-6cef6387bda6",
                        "glosses": [
                            "Bewohnerin des afrikanischen Kontinents"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aec4c9e-c64a-497c-b07d-e18b5f4bd2c5",
                                "sense_id": "59b3db2f-b951-34a9-9e91-795117249aa8",
                                "text": "„1515 verkündete König Manuel I., dass sämtliche Afrikanerinnen, die man den portugiesischen Siedlern als Ehefrauen oder Konkubinen übergeben hatte, und ebenso ihre Kinder frei seien.“"
                            },
                            {
                                "example_id": "9185fed9-3243-4b58-9825-c7789101e3af",
                                "sense_id": "59b3db2f-b951-34a9-9e91-795117249aa8",
                                "text": "„Sie hatten sich kaum einen anderen Platz gesucht, als eine korpulente Afrikanerin mit einem Korb voller Stoffe auf dem Kopf erschien.“"
                            },
                            {
                                "example_id": "1470d51e-dc37-4596-a7e2-c76c733ace18",
                                "sense_id": "59b3db2f-b951-34a9-9e91-795117249aa8",
                                "text": "„Die Afrikanerinnen wiegten die Köpfe im Takt.“"
                            },
                            {
                                "example_id": "db8b7be6-589a-4ed9-813f-197dc4d7d7a0",
                                "sense_id": "59b3db2f-b951-34a9-9e91-795117249aa8",
                                "text": "„Eine Afrikanerin sagte mir einst, wir Weißen würden stinken.“"
                            },
                            {
                                "example_id": "dbdc915c-afa1-40ad-8e30-7fcfbfb594b9",
                                "sense_id": "59b3db2f-b951-34a9-9e91-795117249aa8",
                                "text": "„Insbesondere schwarze Frauen sollten auf dem Land gehalten werden, das Gesetz hatte Razzien und polizeiliche Schikanen gegen Afrikanerinnen zur Folge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a842757e-9425-4272-8ec4-70dd7a120728",
                        "source_entry_id": "47831ba8-b528-3f37-a4a1-6cef6387bda6",
                        "source_sense_id": "59b3db2f-b951-34a9-9e91-795117249aa8",
                        "source_sense_description": "Bewohnerin des afrikanischen Kontinents",
                        "target_lang_word": "African",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "African",
