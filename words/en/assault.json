{
    "word_family": [
        "assail",
        "assailant",
        "assaulter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d3966cf2-8916-32ea-9982-cbf05cf3c512",
                    "sense_definition": "To attack someone or something physically or with great force",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attack_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man was arrested after he tried to <w>assault</w> a police officer during the protest.",
                            "target_lang_translations": {
                                "ru": "Мужчина был арестован после того, как попытался <w>напасть</w> на полицейского во время протеста.",
                                "zh": "那名男子在抗议期间试图<w>袭击</w>一名警官后被捕。"
                            }
                        },
                        {
                            "text": "The smell of smoke began to <w>assault</w> the senses as they got closer to the fire.",
                            "target_lang_translations": {
                                "ru": "Запах дыма начал <w>атаковать</w> органы чувств, когда они приблизились к огню.",
                                "zh": "当他们靠近火源时，烟味开始<w>冲击</w>着他们的感官。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "strike",
                        "assailment"
                    ],
                    "antonyms": [
                        "defense",
                        "defence"
                    ],
                    "common_phrases": [
                        "assault the senses",
                        "physically assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически нападать на кого-либо или что-либо с большой силой",
                        "zh": "指以暴力或强力对某人或某物进行身体攻击"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападать",
                                "target_lang_sense_clarification": "совершать физическое насилие"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "применять силу или воздействовать на органы чувств"
                            },
                            {
                                "target_lang_word": "совершить нападение",
                                "target_lang_sense_clarification": "физический акт агрессии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "袭击",
                                "target_lang_sense_clarification": "指突然的暴力攻击"
                            },
                            {
                                "target_lang_word": "攻击",
                                "target_lang_sense_clarification": "指施加暴力或强力影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf097dad-e6a5-3006-a5fa-a5bf9bfb8d6b",
                    "sense_definition": "To threaten or harass someone",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "harassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters continued to <w>assault</w> the politician with constant verbal threats.",
                            "target_lang_translations": {
                                "ru": "Протестующие продолжали <w>изводить</w> политика постоянными словесными угрозами.",
                                "zh": "抗议者不断用言语威胁来<w>攻击</w>那位政客。"
                            }
                        },
                        {
                            "text": "He felt that the aggressive marketing tactics were designed to <w>assault</w> and pressure customers.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что агрессивная маркетинговая тактика была направлена на то, чтобы <w>атаковать</w> покупателей и оказывать на них давление.",
                                "zh": "他觉得这种激进的营销策略旨在<w>骚扰</w>并向顾客施压。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aggression"
                    ],
                    "common_phrases": [
                        "verbally assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угрожать кому-либо или подвергать нападкам",
                        "zh": "指威胁、骚扰或言语攻击某人"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападать",
                                "target_lang_sense_clarification": "обрушиваться с критикой или угрозами"
                            },
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "систематически преследовать или изводить"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "предпринимать агрессивные действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "言语攻击",
                                "target_lang_sense_clarification": "指通过言语进行骚扰或威胁"
                            },
                            {
                                "target_lang_word": "骚扰",
                                "target_lang_sense_clarification": "指持续的言语或行为干扰"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f608eed-3e48-33e0-b1ce-740d702a0cec",
                    "sense_definition": "A violent physical attack using weapons or bodily force",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attack_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers prepared for a final <w>assault</w> on the enemy fortress at dawn.",
                            "target_lang_translations": {
                                "ru": "Солдаты готовились к финальному <w>штурму</w> вражеской крепости на рассвете.",
                                "zh": "士兵们准备在黎明时分对敌方堡垒发起最后一次<w>强攻</w>。"
                            }
                        },
                        {
                            "text": "The victim suffered serious injuries during the brutal <w>assault</w> in the park.",
                            "target_lang_translations": {
                                "ru": "Потерпевший получил серьезные травмы во время жестокого <w>нападения</w> в парке.",
                                "zh": "受害者在公园那场残暴的<w>袭击</w>中受了重伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "onslaught",
                        "offensive",
                        "strike"
                    ],
                    "antonyms": [
                        "defense",
                        "defence"
                    ],
                    "common_phrases": [
                        "armed assault",
                        "launch an assault",
                        "brutal assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насильственное физическое нападение с применением оружия или силы",
                        "zh": "指使用武器或身体力量进行的暴力身体攻击"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "физический акт насилия"
                            },
                            {
                                "target_lang_word": "штурм",
                                "target_lang_sense_clarification": "решительная атака укрепления"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "стремительное наступление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "袭击",
                                "target_lang_sense_clarification": "指暴力攻击事件"
                            },
                            {
                                "target_lang_word": "强攻",
                                "target_lang_sense_clarification": "指军事上的猛烈进攻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f2a3d0-b6ea-3f52-93c9-f17589d7eff2",
                    "sense_definition": "A strong verbal or written attack involving heavy criticism or insults",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper published a scathing <w>assault</w> on the government's new economic policy.",
                            "target_lang_translations": {
                                "ru": "Газета опубликовала едкий <w>выпад</w> против новой экономической политики правительства.",
                                "zh": "报纸发表了一篇对政府新经济政策的严厉<w>抨击</w>。"
                            }
                        },
                        {
                            "text": "Her speech was a direct <w>assault</w> on her opponent's character and integrity.",
                            "target_lang_translations": {
                                "ru": "Ее речь была прямой <w>атакой</w> на репутацию и честность оппонента.",
                                "zh": "她的演讲是对对手人品和诚信的直接<w>攻击</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aggression",
                        "offense"
                    ],
                    "common_phrases": [
                        "verbal assault",
                        "written assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная словесная или письменная атака, включающая резкую критику",
                        "zh": "指包含严厉批评或侮辱的强烈言语或书面攻击"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпад",
                                "target_lang_sense_clarification": "враждебное выступление против кого-либо"
                            },
                            {
                                "target_lang_word": "нападки",
                                "target_lang_sense_clarification": "словесная агрессия или критика"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "решительное выступление в прессе или речи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抨击",
                                "target_lang_sense_clarification": "指严厉的批评或指责"
                            },
                            {
                                "target_lang_word": "攻击",
                                "target_lang_sense_clarification": "指言语上的敌对行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e8e3dd2-677a-394c-ae63-29f9f0e329a1",
                    "sense_definition": "The legal crime of threatening someone with physical harm or attempting to strike them",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant was charged with <w>assault</w> and battery after the fight.",
                            "target_lang_translations": {
                                "ru": "Подсудимому было предъявлено обвинение в <w>нападении</w> и нанесении побоев после драки.",
                                "zh": "打架后，被告被控以<w>袭击罪</w>和殴打罪。"
                            }
                        },
                        {
                            "text": "In many jurisdictions, simply raising a fist can be enough to constitute <w>assault</w>.",
                            "target_lang_translations": {
                                "ru": "Во многих юрисдикциях простого поднятия кулака может быть достаточно, чтобы это квалифицировалось как <w>угроза насилием</w>.",
                                "zh": "在许多司法管辖区，仅仅挥舞拳头就足以构成<w>袭击罪</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attempt"
                    ],
                    "common_phrases": [
                        "aggravated assault",
                        "charged with assault",
                        "assault and battery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическое преступление, заключающееся в угрозе физическим насилием",
                        "zh": "指威胁他人身体安全或试图进行身体伤害的法律罪名"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "в юридическом контексте"
                            },
                            {
                                "target_lang_word": "угроза физическим насилием",
                                "target_lang_sense_clarification": "состав преступления"
                            },
                            {
                                "target_lang_word": "посягательство",
                                "target_lang_sense_clarification": "попытка причинения вреда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "袭击罪",
                                "target_lang_sense_clarification": "法律术语，指威胁或试图伤害他人"
                            },
                            {
                                "target_lang_word": "人身攻击",
                                "target_lang_sense_clarification": "指对他人身体安全的非法威胁"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}