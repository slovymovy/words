                "senses": [
                    {
                        "sense_id": "bdeca574-0c64-3f66-b4eb-df0b282a3f05",
                        "entry_id": "e07fd00c-4775-36f4-8241-a63cbcd00c6f",
                        "glosses": [
                            "a large political party which is supported by people from various economic, regional and religious backgrounds, and which regularly has a chance of winning enough parliamentary seats to lead a coalition"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "ed4e6494-556c-4843-88dc-f3f96fc8eb10",
                                "sense_id": "bdeca574-0c64-3f66-b4eb-df0b282a3f05",
                                "text": "Die traditionellen Volksparteien in Deutschland sind SPD und Union.",
                                "translation": "The traditional “people’s parties” in Germany are Social Democrats and Christian Democrats.",
                                "english": "The traditional “people’s parties” in Germany are Social Democrats and Christian Democrats."
                            },
                            {
                                "example_id": "a6cc571e-5c3e-45c2-b207-f008c781c611",
                                "sense_id": "bdeca574-0c64-3f66-b4eb-df0b282a3f05",
                                "text": "Von einer kleinen rechtsradikalen Splitterpartei sei die NSDAP während der Weimarer Republik zu einer modernen Volkspartei geworden, sagt Andreas Nachama."
                            }
                        ]
                    }
                ],
