                        ],
                        "examples": [
                            {
                                "example_id": "27616708-c35b-4951-8afe-6e958fd089fd",
                                "sense_id": "e8fde2dd-2411-325d-a461-c42037c305b4",
                                "text": "Ce style manque de coloris."
                            },
                            {
                                "example_id": "824d7a8f-971e-437c-bba8-fa08454f242b",
                                "sense_id": "e8fde2dd-2411-325d-a461-c42037c305b4",
                                "text": "Beethoven, César Franck, ont l’un et l’autre un coloris passionné."
                            }
                        ]
