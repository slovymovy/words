{
    "word_family": [
        "flag",
        "flagstone"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ce92c64a-1134-3ebe-baed-24d204a17eb6",
                    "sense_definition": "Marked with a flag",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flagged</w> path showed the way to the entrance.",
                            "target_lang_translations": {
                                "zh": "那条<w>插旗</w>的小路指引着通往入口的方向。"
                            }
                        },
                        {
                            "text": "Every <w>flagged</w> item in the report needs further review.",
                            "target_lang_translations": {
                                "zh": "报告中每一项被<w>标记的</w>内容都需要进一步审查。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unflagged"
                    ],
                    "common_phrases": [
                        "flagged item"
                    ],
                    "target_lang_definitions": {
                        "zh": "被标记的，用旗帜标出的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "标记的",
                                "target_lang_sense_clarification": "指被做了记号或特别标注的"
                            },
                            {
                                "target_lang_word": "插旗的",
                                "target_lang_sense_clarification": "指用旗帜作为标识的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6dc9b02-a072-37d6-92e6-61478eeba83f",
                    "sense_definition": "Registered with a particular country and thus flying its flag",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship is <w>flagged</w> in Panama for tax reasons.",
                            "target_lang_translations": {
                                "zh": "出于税务原因，这艘船<w>悬挂</w>的是巴拿马国旗。"
                            }
                        },
                        {
                            "text": "Many vessels are <w>flagged</w> under foreign jurisdictions.",
                            "target_lang_translations": {
                                "zh": "许多船只<w>注册</w>在外国司法管辖区。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unflagged"
                    ],
                    "common_phrases": [
                        "flagged in"
                    ],
                    "target_lang_definitions": {
                        "zh": "（船只）注册在某国并悬挂该国国旗的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "悬挂……旗的",
                                "target_lang_sense_clarification": "指船只注册地及其悬挂的国旗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b162d94-09fd-388e-b7ad-22c694b084dc",
                    "sense_definition": "Paved with flagstones",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked across the <w>flagged</w> courtyard to reach the garden.",
                            "target_lang_translations": {
                                "zh": "他们穿过<w>石板铺</w>的庭院到达花园。"
                            }
                        },
                        {
                            "text": "The old kitchen had a cold <w>flagged</w> floor that was hard to clean.",
                            "target_lang_translations": {
                                "zh": "老厨房里铺着冰冷的<w>石板</w>地面，很难打扫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flagged floor"
                    ],
                    "target_lang_definitions": {
                        "zh": "用石板铺设的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "石板铺的",
                                "target_lang_sense_clarification": "指地面由石板铺成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "566c3908-50b1-3a20-97d7-5baee292af44",
                    "sense_definition": "Having split, bushy ends of bristles",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brush has <w>flagged</w> bristles to hold more paint.",
                            "target_lang_translations": {
                                "zh": "这把刷子有<w>分叉</w>的刷毛，可以蘸取更多油漆。"
                            }
                        },
                        {
                            "text": "High-quality brushes often feature <w>flagged</w> ends for a smoother finish.",
                            "target_lang_translations": {
                                "zh": "高质量的刷子通常采用<w>分叉</w>的末端，以获得更平滑的涂刷效果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flocked"
                    ],
                    "antonyms": [
                        "unflagged",
                        "unflocked"
                    ],
                    "target_lang_definitions": {
                        "zh": "（刷毛）末端分叉的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "分叉的",
                                "target_lang_sense_clarification": "指刷毛末端呈细碎分叉状"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "519f505e-2fd3-3ef4-ad87-b986d17fa486",
                    "sense_definition": "Simple past and past participle of <w>flag</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee <w>flagged</w> the player for a foul.",
                            "target_lang_translations": {
                                "zh": "裁判<w>示意</w>该球员犯规。"
                            }
                        },
                        {
                            "text": "She <w>flagged</w> down a taxi in the rain.",
                            "target_lang_translations": {
                                "zh": "她在雨中<w>招手</w>拦了一辆出租车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flagged down"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "“flag”的过去式和过去分词，意为示意、标记或招手"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "指通过动作或旗帜发出信号"
                            },
                            {
                                "target_lang_word": "招手",
                                "target_lang_sense_clarification": "指招手拦车"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}