                "senses": [
                    {
                        "sense_id": "eede15df-1b81-3d78-9561-fbd8fa8f1b06",
                        "entry_id": "acf8ccc2-8dc3-3638-8ce3-d860fd0fad45",
                        "glosses": [
                            "Milch von Säugetieren, die streng nach den Vorschriften für biologische Haltung gehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49015380-c995-41a5-913b-e3fd3ee28960",
                                "sense_id": "eede15df-1b81-3d78-9561-fbd8fa8f1b06",
                                "text": "Ich trinke nur Biomilch, und die kaufe ich immer direkt beim Bauern."
                            },
                            {
                                "example_id": "b8268212-352c-4ac0-adae-053d20132333",
                                "sense_id": "eede15df-1b81-3d78-9561-fbd8fa8f1b06",
                                "text": "„Biomilch ist für Erwachsene gesünder, weil die Milch weniger Mikro-RNA enthält.“"
                            },
                            {
                                "example_id": "55f6bdad-f0a7-4c27-8244-21dd11cee8b0",
                                "sense_id": "eede15df-1b81-3d78-9561-fbd8fa8f1b06",
                                "text": "„Gleichzeitig ist die Molkerei, im Zeichen der Biomilch, auch wirtschaftlich wieder im Aufwind.“"
                            },
                            {
                                "example_id": "923740d1-88ce-4a0d-9350-7a0b73ef1d66",
                                "sense_id": "eede15df-1b81-3d78-9561-fbd8fa8f1b06",
                                "text": "„Falls Sie Mich trinken möchten, sollte dies vorzugsweise nicht pasteurisierte und nicht homogenisierte Biomilch sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
