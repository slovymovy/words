{
    "word_family": [
        "collect",
        "collector",
        "collective",
        "collectively",
        "collectible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ba8fd29-9d45-3eda-8b48-5d4972b39e5f",
                    "sense_definition": "A group of objects or items that have been gathered together, often because they are similar or interesting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed me his impressive <w>collection</w> of rare stamps.",
                            "target_lang_translations": {
                                "ru": "Он показал мне свою впечатляющую <w>коллекцию</w> редких марок.",
                                "zh": "他向我展示了他那令人印象深刻的稀有邮票<w>收藏</w>。"
                            }
                        },
                        {
                            "text": "The museum houses a vast <w>collection</w> of modern art.",
                            "target_lang_translations": {
                                "ru": "В музее хранится обширная <w>коллекция</w> современного искусства.",
                                "zh": "这家博物馆馆藏了大量的现代艺术<w>收藏品</w>。"
                            }
                        },
                        {
                            "text": "This year's summer <w>collection</w> features bright colors and light fabrics.",
                            "target_lang_translations": {
                                "ru": "Летняя <w>коллекция</w> этого года отличается яркими цветами и легкими тканями.",
                                "zh": "今年的夏季<w>系列</w>以鲜艳的色彩和轻盈的面料为特色。"
                            }
                        }
                    ],
                    "synonyms": [
                        "set",
                        "assortment",
                        "array",
                        "accumulation",
                        "group"
                    ],
                    "common_phrases": [
                        "art collection",
                        "private collection",
                        "stamp collection",
                        "summer collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа предметов, собранных вместе, часто из-за их сходства или интереса",
                        "zh": "一组被收集在一起的物品，通常因为它们相似或具有某种趣味性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колле́кция",
                                "target_lang_sense_clarification": "систематизированное собрание предметов"
                            },
                            {
                                "target_lang_word": "собра́ние",
                                "target_lang_sense_clarification": "совокупность произведений искусства или книг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收藏",
                                "target_lang_sense_clarification": "指个人或机构收集的物品"
                            },
                            {
                                "target_lang_word": "系列",
                                "target_lang_sense_clarification": "指成套的商品或作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56b3902c-83c3-32d5-9d11-4c2c44470467",
                    "sense_definition": "The act or process of gathering things together from different places.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>collection</w> of household waste occurs every Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "<w>Сбор</w> бытовых отходов происходит каждое утро вторника.",
                                "zh": "每周二早上都会进行家庭垃圾的<w>收集</w>工作。"
                            }
                        },
                        {
                            "text": "Accurate data <w>collection</w> is essential for the success of this research project.",
                            "target_lang_translations": {
                                "ru": "Точный <w>сбор</w> данных необходим для успеха этого исследовательского проекта.",
                                "zh": "准确的<w>数据采集</w>对于该研究项目的成功至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "accumulation",
                        "pick-up"
                    ],
                    "antonyms": [
                        "distribution",
                        "dispersal"
                    ],
                    "common_phrases": [
                        "data collection",
                        "waste collection",
                        "garbage collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс сбора вещей из разных мест",
                        "zh": "从不同地方将事物聚集在一起的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "действие по сбору данных, мусора и т.д."
                            },
                            {
                                "target_lang_word": "собира́ние",
                                "target_lang_sense_clarification": "процесс накапливания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收集",
                                "target_lang_sense_clarification": "指获取或汇集信息、物品的过程"
                            },
                            {
                                "target_lang_word": "采集",
                                "target_lang_sense_clarification": "指从源头获取数据或样本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af838664-db9b-3426-bcd9-84337a178840",
                    "sense_definition": "An act of asking for and receiving money for a charity or a specific cause.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We organized a <w>collection</w> to buy a retirement gift for our teacher.",
                            "target_lang_translations": {
                                "ru": "Мы организовали <w>сбор</w> денег, чтобы купить прощальный подарок нашему учителю.",
                                "zh": "我们组织了一次<w>募捐</w>，为我们的老师购买退休礼物。"
                            }
                        },
                        {
                            "text": "They took up a <w>collection</w> for the victims of the recent flood.",
                            "target_lang_translations": {
                                "ru": "Они организовали <w>сбор</w> пожертвований для жертв недавнего наводнения.",
                                "zh": "他们为最近洪灾的受害者发起了<w>筹款</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "donation",
                        "contribution",
                        "fundraising"
                    ],
                    "common_phrases": [
                        "take up a collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбор денег на благотворительность или конкретную цель",
                        "zh": "为慈善事业或特定目的请求并接收金钱的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "сбор денежных средств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "募捐",
                                "target_lang_sense_clarification": "指为公益或慈善目的筹集资金"
                            },
                            {
                                "target_lang_word": "筹款",
                                "target_lang_sense_clarification": "指为特定目标筹集资金"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78b4f17e-d057-32c0-b72c-ca886dbda4a1",
                    "sense_definition": "The process of recovering money that is owed by people or businesses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired an agency to handle the <w>collection</w> of unpaid debts.",
                            "target_lang_translations": {
                                "ru": "Компания наняла агентство для <w>взыскания</w> неоплаченных долгов.",
                                "zh": "公司聘请了一家代理机构来处理未偿债务的<w>追讨</w>事宜。"
                            }
                        },
                        {
                            "text": "He received a final notice regarding the <w>collection</w> of his overdue taxes.",
                            "target_lang_translations": {
                                "ru": "Он получил последнее уведомление касательно <w>взимания</w> его просроченных налогов.",
                                "zh": "他收到了一份关于<w>征收</w>逾期税款的最后通知。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery"
                    ],
                    "common_phrases": [
                        "debt collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс взыскания денег, которые задолжали люди или компании",
                        "zh": "追回个人或企业所欠债务的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взыска́ние",
                                "target_lang_sense_clarification": "принудительный сбор долгов"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "взимание налогов или пошлин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追讨",
                                "target_lang_sense_clarification": "指催收欠款"
                            },
                            {
                                "target_lang_word": "征收",
                                "target_lang_sense_clarification": "指政府或机构依法收取税款或费用"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}