                                        "entry_id": "6fc8012b-1d23-30aa-9fdc-585579d5686f",
                                        "glosses": [
                                            "A medium-sized rodent belonging to the genus Rattus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b54f801-fdf3-4884-b3c6-2677820fc4ab",
                                                "sense_id": "5cb49ab4-6a86-3ea2-a3d1-528db24c16a7",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea58d92-0627-394e-a9ed-fc5d84dd45de",
                                        "entry_id": "6fc8012b-1d23-30aa-9fdc-585579d5686f",
                                        "glosses": [
                                            "Any of the numerous members of several rodent families (e.g. voles and mice) that resemble true rats in appearance, usually having short limbs, a pointy snout, a long, hairless tail, and a body length greater than about 12 cm, or 5 inches."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "917923e7-c75c-3429-bf35-646c0a5351c1",
                                        "entry_id": "6fc8012b-1d23-30aa-9fdc-585579d5686f",
                                        "glosses": [
                                            "A person who is known for betrayal."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94a9436-64e2-42c6-936f-b472ed04931f",
                                                "sense_id": "917923e7-c75c-3429-bf35-646c0a5351c1",
                                                "text": "Near-synonyms: betrayer, scoundrel, snake, snake in the grass, quisling, traitor"
                                            },
                                            {
                                                "example_id": "cbe21fe2-283c-4cbf-ba7d-c31530eca8d1",
                                                "sense_id": "917923e7-c75c-3429-bf35-646c0a5351c1",
                                                "text": "rat bastard"
                                            },
                                            {
                                                "example_id": "9108397f-0248-477d-9537-e8160a904bad",
                                                "sense_id": "917923e7-c75c-3429-bf35-646c0a5351c1",
                                                "text": "He’s more a man than any pair of rats of you in this here house."
                                            },
                                            {
                                                "example_id": "5aab367f-6ff2-4c54-8b7c-6f8085f064b8",
                                                "sense_id": "917923e7-c75c-3429-bf35-646c0a5351c1",
                                                "text": "What a rat, leaving us stranded here!"
                                            },
                                            {
                                                "example_id": "aa9d48fb-4f9c-45b2-89a0-d4693453ffb9",
                                                "sense_id": "917923e7-c75c-3429-bf35-646c0a5351c1",
                                                "text": "\"Ah, so you damn rat, this is a put-up job eh?\""
                                            }
                                        ]
                                    },
