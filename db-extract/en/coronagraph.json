                        "glosses": [
                            "A telescope that has an attachment which blocks out the direct light from the sun or other star, allowing examination of the corona and the detection of exoplanets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb18ac68-8716-41ce-9522-50ae2593333d",
                                "sense_id": "64eed9f4-bd5a-331c-b572-f01b161be872",
                                "text": "The crosscalibration between LASCO C2 and the STEREO coronagraphs allows, for the first time, the potential use of multi-spacecraft coronagraph data for tomography and for CME analysis.."
                            }
                        ]
                    }
                ],
