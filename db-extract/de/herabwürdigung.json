                ],
                "senses": [
                    {
                        "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                        "entry_id": "b40eeef4-9e87-37bb-a8ee-c98fe1bd6a6e",
                        "glosses": [
                            "Geringschätzung der Leistung einer Person; Abwertung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b54fd63-7fe6-40fc-a9e4-e2a26ecf99a5",
                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                "text": "„Er empfindet diese Behauptung als eine Herabwürdigung seiner Person.“"
                            },
                            {
                                "example_id": "9295b303-8339-4384-8dc1-8325bc672054",
                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                "text": "„Die Herabwürdigung kommt dadurch ohne externe Verweise auf persönliche Merkmale, wie beispielsweise schlechte Kleidung, oder andere Verhaltensweisen des zahlungssäumigen Mitglieds aus.“"
                            },
                            {
                                "example_id": "63d2654a-0f2c-44f0-bb01-8ec948a792d6",
                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                "text": "„Nichts ist besser oder schlechter als das andere, und Herabwürdigungen mit Ausdrücken wie ‚banal‘ oder ‚stupide‘ sind selbstverständlich verboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f4217eb-8576-47d1-9564-51834283138b",
                        "source_entry_id": "b40eeef4-9e87-37bb-a8ee-c98fe1bd6a6e",
                        "source_sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                        "source_sense_description": "Geringschätzung der Leistung einer Person; Abwertung",
                        "target_lang_word": "degradation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "degradation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e83143b-72ab-3d4c-820b-bb26dd97e0bb",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "The act of reducing in rank, character, or reputation, or of abasing; a lowering from one's standing or rank in office or society"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd115710-1ff8-4f38-b396-93b385ceba82",
                                                "sense_id": "2e83143b-72ab-3d4c-820b-bb26dd97e0bb",
                                                "text": "This feature of good organization, the conferring of definite local superior rank, and the protection of the incumbent from unnecessary degradation, was discovered centuries ago by another effective institution, the Catholic church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37c2658-b966-3985-be0c-b263b9597908",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "The state of being reduced in rank, character, or reputation; baseness; moral, physical, or intellectual degeneracy; disgrace; abasement; debasement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa1bc810-3a6b-413a-a654-2b9530a551c5",
                                                "sense_id": "b37c2658-b966-3985-be0c-b263b9597908",
                                                "text": "There will be no poverty. All work will be done by living machines. Everybody will be free from worry and liberated from the degradation of labor. Everybody will live only to perfect himself."
                                            },
                                            {
                                                "example_id": "658b05c5-1ea0-4780-a32b-6025aba84868",
                                                "sense_id": "b37c2658-b966-3985-be0c-b263b9597908",
                                                "text": "Money is the great breaker-up of love and friendship; and this is, I believe, the reason of the common saying, that \"large families get on best in the world,\" because they can receive from each other assistance without degradation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2314db2a-b65a-3b2b-b211-8868c9b6943a",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "Diminution or reduction of strength, efficacy, or value; degeneration; deterioration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e85a14-f498-46a1-9682-757350db2a3d",
                                                "sense_id": "2314db2a-b65a-3b2b-b211-8868c9b6943a",
                                                "text": "The extent of the damage to the military is still unclear and disputed, but the repeated bombings of the army and revolutionary guard bases and installations suggests substantial degradation of Iran's military power. Militarisation had long consumed a vast amount of the nation's resources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c167cc4e-8511-3d3a-9ce8-ac9f3f07ce29",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "A gradual wearing down or wasting, as of rocks and banks, by the action of water, frost etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55893d4d-0f8b-49ed-9e89-8fcdf2d583ad",
                                                "sense_id": "c167cc4e-8511-3d3a-9ce8-ac9f3f07ce29",
                                                "text": "Overexploitation of land for fuelwood is a further cause of soil degradation in Africa, Asia and South America"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c9fdc9-ca76-3612-a854-ef51c3fd343a",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "A deleterious change in the chemical structure, physical properties or appearance of a material from natural or artificial exposure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
