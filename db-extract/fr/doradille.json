                        "glosses": [
                            "Fougère du genre Asplenium, de la famille des Aspleniaceae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8252eae-c6fb-49bc-9674-abf8dae89bb0",
                                "sense_id": "10183a51-4c20-3cf5-b841-b1fc0011c2aa",
                                "text": "Chemin faisant, on aperçoit furtivement les traces de l’ancien sentier muletier creusé dans la roche. Les fougères sont partout, notamment la doradille élégante, une espèce rare dont les frondes frisées ressemblent à du persil."
                            },
                            {
                                "example_id": "b0bec3ba-f772-4be3-a162-75431eae467c",
                                "sense_id": "10183a51-4c20-3cf5-b841-b1fc0011c2aa",
                                "text": "doradille des ânes (Asplenium onopteris L.),\ndoradille des murailles, rue des murailles, capillaire blanc (Asplenium ruta-muraria),\ndoradille du nord (Asplenium septentrionale), etc."
                            }
