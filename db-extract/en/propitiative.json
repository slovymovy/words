                        "glosses": [
                            "Serving to, or intended to, propitiate; propitiatory, reconciliatory"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd16dbca-7202-468d-8bf0-7951e61acfbd",
                                "sense_id": "ce8295b7-4ae8-3312-9cd6-9b4f3bbfbc76",
                                "text": "The missive from Arthur was a short but complete and propitiative acknowledgment of his error and fraility."
                            },
                            {
                                "example_id": "6e4c92ca-4ad5-44f3-9cd5-0a2a46056ac3",
                                "sense_id": "ce8295b7-4ae8-3312-9cd6-9b4f3bbfbc76",
                                "text": "A friendly word will bring him to my hand; but his behavior is never effusive, as it would be if he had found his rightful owner, but mildly propitiative and with a touch of sadness."
                            },
                            {
                                "example_id": "175b1904-2930-4e4d-b6bb-75b272a17b0e",
                                "sense_id": "ce8295b7-4ae8-3312-9cd6-9b4f3bbfbc76",
                                "text": "The old commodore's eyes flashed to retort, but the senator forced a propitiative smile, adding: \"However, let that pass just now, here's something else.\""
                            }
                        ]
                    }
