                                                "example_id": "6e607e3d-30b6-46ef-81fd-f7fcf95fa291",
                                                "sense_id": "b9f4f348-1bbd-337b-9ca6-b91e0fbf9d24",
                                                "text": "Un poco abbacinata, la ragazza disse all'amica: \"Quel professore di educazione fisica è fico\""
                                            }
