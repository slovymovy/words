                "senses": [
                    {
                        "sense_id": "3e129892-dd04-3675-b229-6b649142deef",
                        "entry_id": "5d7ed256-7f00-36fb-9cca-499ec1dfd9f1",
                        "glosses": [
                            "Redonner au cœur un rythme sinusal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b04d7e62-a0eb-48c1-bed8-8de96d4118b4",
                                "sense_id": "3e129892-dd04-3675-b229-6b649142deef",
                                "text": "Une prévention efficace de l’AVC est l’anticoagulation (but: INR 2-3) dans les cas de fibrillation auriculaire (sauf dans la forme \"isolée\"), même lorsqu’elle est intermittente ou a été resinusalisée."
                            },
                            {
                                "example_id": "9f93185d-a380-41b8-b33b-5184eb03d20d",
                                "sense_id": "3e129892-dd04-3675-b229-6b649142deef",
                                "text": "Traitement • Resinusaliser le rythme : par amiodarone, ou par les antiarythmiques de classe 1, ou par cardioversion électrique."
                            },
                            {
                                "example_id": "da784861-0cf5-434e-9fa2-beaf4612530d",
                                "sense_id": "3e129892-dd04-3675-b229-6b649142deef",
                                "text": "La mort subite n'était pas un incident rare quand on utilisait jadis des doses élevées de quinidine pour resinusaliser une fibrillation auriculaire (\"syncope quinidinique\")."
                            },
                            {
                                "example_id": "e70d50f8-f4e6-4382-8041-459b50efd7e2",
                                "sense_id": "3e129892-dd04-3675-b229-6b649142deef",
                                "text": "Fibrillation auriculaire : → demander si le patient ressentait des palpitations et depuis combien de temps. - si moins de 48h on peut tenter de le resinusaliser."
                            }
                        ]
                    }
                ],
