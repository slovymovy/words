                        "source_sense_id": "a7ddd0cc-16b2-3046-9eb7-5e284ae8bd04",
                        "source_sense_description": "Zoologie: südamerikanischer Vogel aus der Familie Ramphastidae mit verhältnismäßig großem Schnabel",
                        "target_lang_word": "toucan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
