                },
                {
                    "sense_id": "7f1dd3a8-a7fc-324d-8d3c-249fdd647d8a",
                    "sense_definition": "A student at a college or university who is the child or relative of a former student.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university faces criticism for its <w>legacy</w> admissions policy that favors children of alumni.",
                            "target_lang_translations": {
                                "ru": "Университет подвергается критике за политику приема <w>детей выпускников</w>, которая дает преимущество родственникам бывших студентов."
                            }
                        },
                        {
                            "text": "Because she was a <w>legacy</w>, she felt extra pressure to succeed at her father's alma mater.",
                            "target_lang_translations": {
                                "ru": "Поскольку она была <w>потомком выпускника</w>, она чувствовала дополнительное давление, стремясь добиться успеха в альма-матер своего отца."
                            }
                        }
                    ],
                    "common_phrases": [
