                "senses": [
                    {
                        "sense_id": "15e73790-b55c-31d1-bba5-d0c097174c62",
                        "entry_id": "759bcc7b-c448-35e8-9d0a-71a02ae323f2",
                        "glosses": [
                            "aus Bronze gefertigter Griff eines Gegenstandes (zum Beispiel einer Tür, eines Werkzeugs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c65890-9d05-42aa-ae35-361f5fe86b6f",
                                "sense_id": "15e73790-b55c-31d1-bba5-d0c097174c62",
                                "text": "„Als sich Mutter und Sohn gerade an einen alten Diener, der sich bei ihrem Eintritt erhoben hatte, mit einer Frage nach dem Fürsten wenden wollten, drehte sich der Bronzegriff der einen Tür, und Fürst Wassilij erschien in einem mit Samt bezogenen Pelz, mit nur einem Ordensstern, also im Hauskostüm, in der Tür und begleitete einen schönen, schwarzhaarigen Mann hinaus.“"
                            },
                            {
                                "example_id": "c6a965eb-f8df-4f90-9996-c6d8b8f64145",
                                "sense_id": "15e73790-b55c-31d1-bba5-d0c097174c62",
                                "text": "„Nein – dieser schwarze, polierte Kasten mit den Bronzegriffen enthielt kein Leben mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
