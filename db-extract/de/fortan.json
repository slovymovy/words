                                    {
                                        "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                        "entry_id": "cd435c67-fc19-380e-9437-ef9860d4124c",
                                        "glosses": [
                                            "From now on; from this time on."
                                        ],
                                        "tags": [
                                            "formal",
                                            "not-comparable",
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d466c282-8947-4e33-a80f-68de012eb400",
                                                "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                                "text": "I will try to do a better job, henceforth, now that I know the proper technique!"
                                            },
                                            {
                                                "example_id": "076230ea-4b0f-4ee9-898d-c02478ddaf5e",
                                                "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                                "text": "My thanes and kinsmen,/Henceforth be earls, the first that ever Scotland /In such an honour named"
                                            },
                                            {
                                                "example_id": "d23453d5-b1af-484b-aaae-4183313a2f55",
                                                "sense_id": "6e3c2786-77b7-3d98-8632-d6201a0ca7f6",
                                                "text": "Henceforth, you shall be known as Darth...Vader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51f6c79b-546f-397c-b74e-7835e836ffac",
                                        "entry_id": "cd435c67-fc19-380e-9437-ef9860d4124c",
                                        "glosses": [
                                            "Further within this document."
                                        ],
                                        "tags": [
