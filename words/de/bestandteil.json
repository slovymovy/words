                    "sense_id": "ea74bc96-e084-3eb4-bacc-254f27044605",
                    "sense_definition": "einzelnes Element oder Teil, das zusammen mit anderen ein größeres Ganzes oder System bildet",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "element_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sport ist ein fester <w>Bestandteil</w> meines täglichen Lebens geworden.",
                            "target_lang_translations": {
                                "en": "Sports has become an <w>integral part</w> of my daily life."
                            }
                        },
                        {
                            "text": "Die Bestätigung der Grenzen ist ein wesentlicher <w>Bestandteil</w> des neuen Vertrags.",
                            "target_lang_translations": {
                                "en": "The confirmation of the borders is an essential <w>component</w> of the new treaty."
                            }
                        }
                    ],
                    "synonyms": [
