{
    "word_family": [
        "wisdom",
        "wisely",
        "unwise"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f821a1f7-6184-37bb-a7a7-32aaed1cec82",
                    "sense_definition": "Showing good judgement or the benefit of experience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "judgement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Storing extra food for the winter was a <w>wise</w> decision.",
                            "target_lang_translations": {
                                "ru": "Заготовка еды на зиму была <w>мудрым</w> решением.",
                                "zh": "冬天来临前储存额外的食物是个<w>明智的</w>决定。"
                            }
                        },
                        {
                            "text": "The <w>wise</w> old man gave us excellent advice about our future.",
                            "target_lang_translations": {
                                "ru": "<w>Мудрый</w> старик дал нам отличный совет по поводу нашего будущего.",
                                "zh": "那位<w>睿智的</w>老人就我们的未来给了我们极好的建议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensible",
                        "prudent",
                        "judicious",
                        "astute",
                        "sagacious",
                        "sage",
                        "smart",
                        "clever"
                    ],
                    "antonyms": [
                        "foolish",
                        "unwise",
                        "improvident"
                    ],
                    "common_phrases": [
                        "wise decision",
                        "wise choice",
                        "wise words",
                        "wise man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий мудростью, большим опытом и способностью принимать правильные решения.",
                        "zh": "表现出良好判断力，或体现出经验带来的智慧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "му́дрый",
                                "target_lang_sense_clarification": "обладающий большим умом и опытом"
                            },
                            {
                                "target_lang_word": "разу́мный",
                                "target_lang_sense_clarification": "логичный, целесообразный"
                            },
                            {
                                "target_lang_word": "благоразу́мный",
                                "target_lang_sense_clarification": "рассудительный, осторожный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明智的",
                                "target_lang_sense_clarification": "强调判断正确、选择恰当"
                            },
                            {
                                "target_lang_word": "睿智的",
                                "target_lang_sense_clarification": "强调有智慧和人生经验"
                            },
                            {
                                "target_lang_word": "贤明的",
                                "target_lang_sense_clarification": "强调谨慎而有分寸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9f1865c-6fb8-3336-96eb-49f7fd8a4f58",
                    "sense_definition": "Aware of or informed about a secret or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful because the boss is <w>wise</w> to your plan.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, потому что начальник <w>в курсе</w> твоего плана.",
                                "zh": "小心点，因为老板对你的计划已经<w>心里有数</w>了。"
                            }
                        },
                        {
                            "text": "The police are <w>wise</w> to the tricks used by the thieves.",
                            "target_lang_translations": {
                                "ru": "Полиция <w>знает о</w> уловках, используемых ворами.",
                                "zh": "警方对小偷使用的那些伎俩已经<w>很清楚</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wise to"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осведомлённый о чём-либо, особенно о чём-то скрытом или секретном; разгадавший замысел.",
                        "zh": "知道某个秘密或情况的；已经察觉到某事的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осведомлённый",
                                "target_lang_sense_clarification": "знающий о ситуации"
                            },
                            {
                                "target_lang_word": "зна́ющий",
                                "target_lang_sense_clarification": "обладающий информацией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知情的",
                                "target_lang_sense_clarification": "已经知道内情或情况"
                            },
                            {
                                "target_lang_word": "心里有数",
                                "target_lang_sense_clarification": "对某事已有了解，不会被蒙骗"
                            },
                            {
                                "target_lang_word": "察觉到的",
                                "target_lang_sense_clarification": "已察觉到隐情或诡计"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e8e51d9-0fd9-3ef3-bd57-7698b580765d",
                    "sense_definition": "Disrespectful or cheeky.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't get <w>wise</w> with me or you will be in trouble.",
                            "target_lang_translations": {
                                "ru": "Не <w>умничай</w> со мной, иначе у тебя будут неприятности.",
                                "zh": "别对我这么<w>放肆</w>，不然你会有麻烦。"
                            }
                        },
                        {
                            "text": "He made a <w>wise</w> remark that annoyed the teacher.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>дерзкое</w> замечание, которое разозлило учителя.",
                                "zh": "他说了一句很<w>放肆的</w>话，把老师惹恼了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get wise"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'get wise'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий неуважение, дерзость или наглость.",
                        "zh": "无礼的，耍贫嘴的，带有冒犯或顶撞意味的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "де́рзкий",
                                "target_lang_sense_clarification": "непочтительный, грубый"
                            },
                            {
                                "target_lang_word": "на́глый",
                                "target_lang_sense_clarification": "бесцеремонный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放肆的",
                                "target_lang_sense_clarification": "不尊重人、态度过分"
                            },
                            {
                                "target_lang_word": "无礼的",
                                "target_lang_sense_clarification": "语气或举动轻慢无礼"
                            },
                            {
                                "target_lang_word": "嚣张的",
                                "target_lang_sense_clarification": "带有冒犯和顶撞意味"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "259f1e6a-202e-334d-a829-d1ab83907826",
                    "sense_definition": "To inform someone or to learn about something, usually used with 'up'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_inform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>wise</w> up about how the world really works.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>поумнеть</w> и понять, как на самом деле устроен мир.",
                                "zh": "你得赶快<w>认清</w>这个世界究竟是怎么运转的。"
                            }
                        },
                        {
                            "text": "She <w>wised</w> him up about the new office policies.",
                            "target_lang_translations": {
                                "ru": "Она <w>просветила</w> его насчёт новых правил офиса.",
                                "zh": "她把新的办公室规定给他<w>讲明白了</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wise up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mostly used as the phrasal verb 'wise up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узнать правду о чём-либо или сообщить кому-либо информацию (обычно используется с 'up').",
                        "zh": "使人明白某事，或自己看清情况；通常用于 wise up。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просвети́ть",
                                "target_lang_sense_clarification": "сообщить информацию (кого-то)"
                            },
                            {
                                "target_lang_word": "поумне́ть",
                                "target_lang_sense_clarification": "стать умнее, понять суть (самому)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认清",
                                "target_lang_sense_clarification": "自己看清真相、明白过来"
                            },
                            {
                                "target_lang_word": "点醒",
                                "target_lang_sense_clarification": "让某人明白情况"
                            },
                            {
                                "target_lang_word": "讲明白",
                                "target_lang_sense_clarification": "把情况告诉某人，使其明白"
                            }
                        ]
                    }
                }
            ]
        },
        {
