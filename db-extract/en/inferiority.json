                                    {
                                        "sense_id": "83b9e150-6858-3a53-9f17-22965b47fde2",
                                        "entry_id": "99dcbf6f-2833-34ac-b1cb-31eab900fba5",
                                        "glosses": [
                                            "het gevoel minder waard te zijn of het gevoel dat iets minder waard is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59df951-7cc0-4a12-b68c-9245fb6b76cd",
                                                "sense_id": "83b9e150-6858-3a53-9f17-22965b47fde2",
                                                "text": "Maar bewijsvoering ging over iets anders dan over retorische minderwaardigheid."
