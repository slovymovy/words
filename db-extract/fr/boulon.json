                "senses": [
                    {
                        "sense_id": "7fa93b16-98b7-3442-a441-3a21da502e21",
                        "entry_id": "0884d1a3-ed95-3d8f-822e-a1f8cf6010f8",
                        "glosses": [
                            "Cheville avec tête ronde, bout percé et clavette, pour arrêter une poutre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3451fc6c-67a3-4ed5-9a2f-ea80e79dd06b",
                                "sense_id": "7fa93b16-98b7-3442-a441-3a21da502e21",
                                "text": "Estacas o estaquillas de hierro, ce sont de grosses chevilles ou broches de fer pour joindre des pièces de bois, des boulons"
                            },
                            {
                                "example_id": "89a454c0-3b38-46ad-b539-74afcaa7cde7",
                                "sense_id": "7fa93b16-98b7-3442-a441-3a21da502e21",
                                "text": "Trois Boulons, pour river l'Affût; deux à tête plate, & l'autre à tête ronde"
                            }
                        ]
                    },
                    {
                        "sense_id": "a00df629-c85e-3786-8d3c-f8f012e2f9a4",
                        "entry_id": "0884d1a3-ed95-3d8f-822e-a1f8cf6010f8",
                        "glosses": [
                            "Outil pour aplatir le bout des chevilles en dedans des bottes fortes."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b8a6f525-8c7f-33e5-87d6-086f662d328a",
                        "entry_id": "0884d1a3-ed95-3d8f-822e-a1f8cf6010f8",
                        "glosses": [
                            "Vis allant avec un écrou."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b8af99af-2b20-483e-b3c3-68fd4aa01000",
                                "sense_id": "b8a6f525-8c7f-33e5-87d6-086f662d328a",
                                "text": "Cette première Figure est une Pompe, qu'une seule personne peut aisément faire agir, par le moyen d'un Levier, dont le point d'apui P. est fixé sur une Plate-forme, & arrêté par trois Boulons & Ecrous de Cuivre , EE."
                            }
                        ]
                    },
                    {
                        "sense_id": "73e4b4a9-8a20-3f06-bc12-ccdfa043998b",
                        "entry_id": "0884d1a3-ed95-3d8f-822e-a1f8cf6010f8",
                        "glosses": [
                            "Organe d’assemblage constitué d’une tige filetée dont une des extrémités est libre, l'autre étant constituée d'une partie permettant l’entraînement de l'ensemble pour le serrage ou le blocage de la tige et d'un écrou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4663858e-0d1b-48a3-b34e-a17b6e782b59",
                                "sense_id": "73e4b4a9-8a20-3f06-bc12-ccdfa043998b",
                                "text": "Boulon hexagonal, boulon à collet carré, boulon poêlier, etc."
                            },
                            {
                                "example_id": "4b807cf8-f464-4230-9ebb-78bff07f23a0",
                                "sense_id": "73e4b4a9-8a20-3f06-bc12-ccdfa043998b",
                                "text": "Le couple de serrage du boulon doit être vérifié périodiquement."
                            },
                            {
                                "example_id": "483c474b-1202-4ea6-a23c-58fffac5710e",
                                "sense_id": "73e4b4a9-8a20-3f06-bc12-ccdfa043998b",
                                "text": "Je vous propose de dessiner un boulon, cette pièce de mécanique se prêtant idéalement à l’outil Polygone."
                            },
                            {
                                "example_id": "47510803-2a21-4d36-b7b2-17ab793531f4",
                                "sense_id": "73e4b4a9-8a20-3f06-bc12-ccdfa043998b",
                                "text": "Note : Parfois utilisé pour désigner un écrou."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b75c018-465e-3e62-ac80-83801e7e34fa",
                        "entry_id": "0884d1a3-ed95-3d8f-822e-a1f8cf6010f8",
