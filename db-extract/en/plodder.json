                                        "sense_id": "bb44a798-0c72-34f4-a0bf-d553dbfefa86",
                                        "entry_id": "63d9a691-49ab-3d08-863c-88d4c5b1b47b",
                                        "glosses": [
                                            "разг. тот, кто копается, делает всё медленно, неторопливо"
                                        ],
