                "senses": [
                    {
                        "sense_id": "603eb84c-6d62-3c98-a390-d616d6fd0a13",
                        "entry_id": "a36dbbfa-79f9-35b5-880b-5c8401d81b12",
                        "glosses": [
                            "Sprache, deren Texte mit Hieroglyphen geschrieben sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e47e913-0969-4593-808d-b00c43a73e80",
                                "sense_id": "603eb84c-6d62-3c98-a390-d616d6fd0a13",
                                "text": "„Noch vor ungefähr fünfzig Jahren interessierten sich nur ein paar Gelehrte, die als eher sonderbar galten, für die tote Hieroglyphensprache der alten Ägypter.“"
                            },
                            {
                                "example_id": "a2720699-deba-47d1-a969-5974aeedf773",
                                "sense_id": "603eb84c-6d62-3c98-a390-d616d6fd0a13",
                                "text": "„Es wurde entdeckt, dass die Schrift in 31 Zeilen der demotischen Sprache, 14 Zeilen der Hieroglyphensprache und 54 Zeilen der griechischen Sprache unterteilt ist.“"
                            },
                            {
                                "example_id": "2f8a0773-ce93-4749-9915-45dac424eefa",
                                "sense_id": "603eb84c-6d62-3c98-a390-d616d6fd0a13",
                                "text": "„Die angebotenen Kurse (darunter auch Kurse in der Hieroglyphensprache anhand einer didaktischen Methode) stehen allen Studierenden offen, ob Historiker oder nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
