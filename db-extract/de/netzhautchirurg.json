                "senses": [
                    {
                        "sense_id": "62e3c01d-8a96-3a6b-af38-1422e1c70bfa",
                        "entry_id": "a2155391-6bc2-3ec7-aa99-ffaff3dc7be2",
                        "glosses": [
                            "Arzt, der auf operative Eingriffe an der Netzhaut spezialisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c36f6d4f-84b2-4a86-a1e6-ebb555eb6deb",
                                "sense_id": "62e3c01d-8a96-3a6b-af38-1422e1c70bfa",
                                "text": "„Der Netzhautchirurg war etwas jünger als ich, doch in seinem chirurgischen Auftreten fühlte ich mich an mich selbst erinnert […].“"
                            },
                            {
                                "example_id": "d3aa5f6b-ac2b-4630-a545-3300fdc2d956",
                                "sense_id": "62e3c01d-8a96-3a6b-af38-1422e1c70bfa",
                                "text": "„Der Netzhautchirurg wird täglich vor diese anspruchsvolle Aufgabe gestellt, die Netzhautdegenerationen einerseits, die Gefahr der Prophylaxe andererseits gegeneinander abzuwägen.“"
                            },
                            {
                                "example_id": "7478caa7-4cca-43e0-9f9d-527a3ab8bd37",
                                "sense_id": "62e3c01d-8a96-3a6b-af38-1422e1c70bfa",
                                "text": "„Für den Netzhautchirurgen, der ein bimanuelles Arbeiten bevorzugt, wurden spezielle Pinzetten und Mikroscheren entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
