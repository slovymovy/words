                        "sense_id": "15de7ad4-95e4-31b7-a4e0-f0ddb1dc1a90",
                        "entry_id": "9852d17d-8bd4-35d3-b581-9daa7eb2e67b",
                        "glosses": [
                            "уменьш.-ласк. к глоток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7c59f1-c4af-4eb8-8cc0-740199cc3d44",
                                "sense_id": "15de7ad4-95e4-31b7-a4e0-f0ddb1dc1a90",
                                "text": "Помню, как на лекции о коварстве иностранных разведок лектор сказал: «Западный агент, к примеру, в ресторане выпивает по глоточку и не закусывает»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af56e7f2-eb3d-4100-81e6-f2e1375d8437",
                        "source_entry_id": "9852d17d-8bd4-35d3-b581-9daa7eb2e67b",
                        "source_sense_id": "15de7ad4-95e4-31b7-a4e0-f0ddb1dc1a90",
                        "target_lang_word": "Schlückchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlückchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b798b34d-95b8-3146-b09b-f25688839328",
                                        "entry_id": "6bebac90-9a44-3245-9cfd-cf0f66a92902",
                                        "glosses": [
                                            "kleiner Schluck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c061c4c6-ceb8-43fd-9aeb-9952b55a48d0",
                                                "sense_id": "b798b34d-95b8-3146-b09b-f25688839328",
                                                "text": "„Er nippte daran, nahm kleine Schlückchen und beobachtete Mr. Mullins über den Tassenrand hinweg.“"
                                            },
                                            {
                                                "example_id": "3b1d8151-eddd-44ed-b147-86892b208654",
                                                "sense_id": "b798b34d-95b8-3146-b09b-f25688839328",
                                                "text": "„Dann tranken sie beide ein Schlückchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
