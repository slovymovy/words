                                "ru": "Сегодня днём меня очень <w>манит</w> прогулка у моря.",
                                "nl": "Ik heb vanmiddag erg <w>zin in</w> een wandeling langs de zee.",
                                "de": "Ein Spaziergang am Meer <w>reizt</w> mich heute Nachmittag sehr.",
                                "pl": "Dziś po południu bardzo mnie <w>kusi</w> spacer nad morzem.",
                                "it": "Questo pomeriggio una passeggiata lungo il mare mi <w>alletta</w> molto.",
                                "cs": "Dnes odpoledne mě procházka u moře velmi <w>láká</w>.",
                                "tr": "Bu öğleden sonra deniz kenarında bir yürüyüş yapmak beni çok <w>cezbediyor</w>.",
                                "es": "Esta tarde me <w>apetece</w> mucho pasear por la orilla del mar.",
                                "zh": "今天下午，海边散步很<w>吸引</w>我。"
                            }
                        },
                        {
                            "text": "Est-ce qu'un voyage en Italie vous <w>tenterait</w> pour les prochaines vacances ?",
                            "target_lang_translations": {
                                "en": "Would a trip to Italy <w>tempt</w> you for your next holiday?",
                                "ru": "Не <w>соблазнила бы</w> вас поездка в Италию на ближайших каникулах?",
                                "nl": "Zou een reis naar Italië u voor de komende vakantie <w>verlokken</w>?",
                                "de": "Würde Sie eine Reise nach Italien für den nächsten Urlaub <w>locken</w>?",
                                "pl": "Czy wyjazd do Włoch <w>kusiłby</w> Pana na najbliższe wakacje?",
                                "it": "Un viaggio in Italia La <w>alletterebbe</w> per le prossime vacanze?",
                                "cs": "<w>Nelákala by</w> vás cesta do Itálie na příští dovolenou?",
                                "tr": "Önümüzdeki tatil için İtalya'ya yapılacak bir gezi sizi <w>cezbeder</w> mi?",
                                "es": "¿Le <w>apetecería</w> un viaje a Italia para las próximas vacaciones?",
                                "zh": "下个假期去意大利旅行，会<w>吸引</w>您吗？"
                            }
                        }
