                            },
                            {
                                "target_word": "emerald",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3409dd6d-4271-39c0-994f-d3aeeb6d7aa6",
                                        "entry_id": "dd1d932a-5375-39d9-8264-902e8c65d23e",
                                        "glosses": [
                                            "Of a rich green colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5887554-e352-4d0c-b8d9-7fe7c72d1acc",
                                                "sense_id": "3409dd6d-4271-39c0-994f-d3aeeb6d7aa6",
                                                "text": "The insect-queen of eastern spring, / O'er emerald meadows of Kashmeer / Invites the young pursuer near, / And leads him on from flower to flower / A weary chase and wasted hour."
                                            }
