                        "glosses": [
                            "Qui concerne les bénéfices ecclésiastiques."
                        ],
                        "tags": [],
                        "note": "Il n’est guère usité que dans la locution matière bénéficiale",
                        "examples": [
                            {
                                "example_id": "75023d22-8825-4e21-aba5-b5bd159507f7",
                                "sense_id": "edf2e093-6d92-3dc1-973d-f005266917c1",
                                "text": "Quant aux terres bénéficiales, leurs noms, leurs confronts, leur étendue, leur capacité en semence et en nombre de journaux , leur rendement en charges, panals, setiers et autres mesures, sont minutieusement décrits."
                            },
                            {
                                "example_id": "c2f713ae-4b1f-4580-844d-c5ac08215cf8",
                                "sense_id": "edf2e093-6d92-3dc1-973d-f005266917c1",
                                "text": "Le Grand Conseil était dans son origine le conseil d’État et privé du roi ; il connut ensuite de plusieurs matières, tant civiles que bénéficiales et criminelles."
                            }
                        ]
                    }
