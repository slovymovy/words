                "senses": [
                    {
                        "sense_id": "9414dbb2-5cb9-3367-9d1e-d39fd50904f1",
                        "entry_id": "116d1b92-3e0f-3b9f-b014-6a12afbdd040",
                        "glosses": [
                            "Ware, welche für den privaten Verbrauch und Gebrauch, den Konsum hergestellt und gehandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785acd26-68ee-47aa-a537-cdf8e706a764",
                                "sense_id": "9414dbb2-5cb9-3367-9d1e-d39fd50904f1",
                                "text": "„Mit der zweiten Gerätegeneration, die 1977 auf den Markt kam,war die Reifung des Selbstbau-Computers zum Konsumprodukt Heimcomputer dann abgeschlossen.“"
                            },
                            {
                                "example_id": "5ca46b5f-9af1-4afc-9a13-c5260540855c",
                                "sense_id": "9414dbb2-5cb9-3367-9d1e-d39fd50904f1",
                                "text": "„Es ist immer faszinierend, wenn ein Konsumprodukt breite kulturelle Bedeutung erlangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
