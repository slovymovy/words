                        "entry_id": "366ef733-0210-3f8f-82c2-7048d2532430",
                        "glosses": [
                            "The state or condition of being an idiot; the quality of having an intelligence level far below average; mental retardation; intellectual disability."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "derogatory",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "76c8b0ed-097a-3780-95cf-83ac38660cca",
                        "entry_id": "366ef733-0210-3f8f-82c2-7048d2532430",
                        "glosses": [
                            "Lack of intelligence or sense; extremely foolish behaviour."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "212869ba-84ff-406a-89fe-9aaf0dd129d2",
                                "sense_id": "76c8b0ed-097a-3780-95cf-83ac38660cca",
                                "text": "The administrators, growing tired of such idiocy, put a new policy in place."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7ad3674-a4cb-36a8-b294-0754645568be",
                        "entry_id": "366ef733-0210-3f8f-82c2-7048d2532430",
                        "glosses": [
                            "An idiotic act or utterance."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "2ad413c5-a9ff-4190-b965-b0bfff09b2b8",
                                "sense_id": "b7ad3674-a4cb-36a8-b294-0754645568be",
                                "text": "The list of his idiocies is seemingly interminable."
                            }
                        ]
                    }
