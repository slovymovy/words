                    {
                        "translation_id": "a4b9b7b6-1674-4efe-8295-99c2aa62b7ed",
                        "source_entry_id": "e11826b9-844a-3eba-bc6e-818e2e2bf2f7",
                        "source_sense_id": "c4a693a0-9d0d-3df3-99c9-9139f3718dff",
