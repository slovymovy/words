                    },
                    {
                        "form_id": "9c999d82-2e78-41aa-8d22-3493172507cb",
                        "entry_id": "acf91ab3-a195-3484-8341-ab6c4361d297",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ruminative"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea2f087d-b6b7-3315-bd40-181d14d244a6",
                        "entry_id": "acf91ab3-a195-3484-8341-ab6c4361d297",
                        "glosses": [
                            "Causing rumination or prone to it; thoughtful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53505098-1563-48ac-9240-8937de0022d6",
                                "sense_id": "ea2f087d-b6b7-3315-bd40-181d14d244a6",
                                "text": "They waited expectantly while he directed a ruminative yawn toward the white smiling moon."
                            },
                            {
                                "example_id": "7449871e-4f2e-46c4-9a9c-c5b8d4a70866",
                                "sense_id": "ea2f087d-b6b7-3315-bd40-181d14d244a6",
                                "text": "‘It happened,’ returned the man, with a ruminative air, as he drew his right hand across his chin, and dipped the other in the pocket of his rough outer coat, ‘it happened somewhere about here as I reckon. I don’t think it can have been a mile from here.’"
                            },
                            {
                                "example_id": "a83d7abc-89d0-4f02-8859-face966cd35c",
                                "sense_id": "ea2f087d-b6b7-3315-bd40-181d14d244a6",
                                "text": "The ruminative 'cello uttered two phrases of its own and then began a dialogue with the viola."
                            },
                            {
                                "example_id": "54d71553-fbcb-441c-ae5a-8ccb62c4b0b7",
                                "sense_id": "ea2f087d-b6b7-3315-bd40-181d14d244a6",
                                "text": "I found that the chore of reorganizing the artifacts of my professional life was pleasantly ruminative. It had a tonic effect, because it allowed me to reflect on the changes in my views over the years."
                            }
                        ]
                    },
                    {
                        "sense_id": "a324ec37-dce2-3ccb-8f46-76b95b2d2f85",
                        "entry_id": "acf91ab3-a195-3484-8341-ab6c4361d297",
                        "glosses": [
                            "Relating to or characteristic of ruminants; chewing the cud."
                        ],
                        "tags": [
                            "of an animal"
                        ],
                        "examples": []
                    }
