                        "entry_id": "303c092c-37c4-317a-830d-47b9d0003724",
                        "glosses": [
                            "Une des races de chien de garde et de défense à la tête et au corps massifs, au museau court, aux babines longues et épaisses et aux oreilles courtes et tombantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a35467a-23da-422f-bbdb-9fa77a9d94d1",
                                "sense_id": "262e943f-92af-3b68-af0f-cc3166aefc7c",
                                "text": "Les molossoïdes font partie du groupe 2 de la société centrale canine ou SCC."
                            },
                            {
                                "example_id": "db2c3649-b54d-4612-8d35-89463a00ce7b",
                                "sense_id": "262e943f-92af-3b68-af0f-cc3166aefc7c",
                                "text": "Les chiens de combat des Romains étaient des molossoïdes."
                            },
                            {
                                "example_id": "c1546ce2-5aae-4c83-aaf2-cf924d22f597",
                                "sense_id": "262e943f-92af-3b68-af0f-cc3166aefc7c",
                                "text": "Certains chiens de berger sont des molossoïdes ."
                            },
                            {
                                "example_id": "ca7d9258-8d8c-497a-9fee-42222c521841",
                                "sense_id": "262e943f-92af-3b68-af0f-cc3166aefc7c",
                                "text": "Le Boxer est un molossoïde de taille moyenne, au corps robuste, tout en profitant de courbes harmonieuses et élégantes."
                            }
                        ]
                    }
