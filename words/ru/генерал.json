                {
                    "sense_id": "22051cf1-02a2-307b-9f59-abef2ed6be33",
                    "sense_definition": "Воинское звание высшего офицерского состава.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгих лет службы он наконец получил звание <w>генерала</w>."
                        },
                        {
                            "text": "В армии существует строгая иерархия, начиная от рядового и заканчивая чином <w>генерала</w>."
                        }
                    ],
                    "common_phrases": [
                        "звание генерала"
                    ]
                },
                {
                    "sense_id": "7ff09e25-746c-3ba9-86e7-803f846c7476",
                    "sense_definition": "Лицо, имеющее высшее воинское звание.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Генерал</w> отдал приказ немедленно начать подготовку к учениям."
                        },
                        {
                            "text": "Молодой офицер с уважением приветствовал проходящего мимо <w>генерала</w>."
                        }
                    ],
                    "common_phrases": [
