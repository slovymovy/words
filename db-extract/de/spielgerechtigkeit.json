                "senses": [
                    {
                        "sense_id": "710f25da-238a-3ada-a835-b590385967c6",
                        "entry_id": "961c2040-f558-3d1e-b955-6f9980dbb1f8",
                        "glosses": [
                            "faires, mit gleichen Rechten für alle Beteiligten, nach objektiven Kriterien ausgetragenes Spielgeschehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf4d7d1-7591-4f10-88f3-3e363b4eb8ae",
                                "sense_id": "710f25da-238a-3ada-a835-b590385967c6",
                                "text": "„Für kontinuierliche Spielgerechtigkeit sorgte erstmalig Mustafa Yannik.“"
                            },
                            {
                                "example_id": "febfc099-c683-4b73-a4fc-2ba9abd3268d",
                                "sense_id": "710f25da-238a-3ada-a835-b590385967c6",
                                "text": "„Damit diese unter Kontrolle bleibt, und die Spielgerechtigkeit und Fairness auch bei höchstem Leistungseinsatz und Siegeswillen zu gewährleisten sind, wird bei größeren Wettspielen ein Unparteiischer, ein Schiedsrichter oder ein Spielleiter, unverzichtbar.“"
                            },
                            {
                                "example_id": "8d846e47-5b85-48ab-96d6-a6aad09045ee",
                                "sense_id": "710f25da-238a-3ada-a835-b590385967c6",
                                "text": "„Es gibt, mit anderen Worten, eine Spielgerechtigkeit, auf die man sich im Fußball nie verlassen kann, und eine Turniergerechtigkeit.“"
                            },
                            {
                                "example_id": "e8bf467d-9cf5-49a4-b6fa-41a97143d71b",
                                "sense_id": "710f25da-238a-3ada-a835-b590385967c6",
                                "text": "„Trotz dieses zusätzlichen Vertrauensvorschusses wird empfohlen, die Lizenz für das Glücksspiel auf der entsprechenden Website genau zu prüfen. Ebenso die Richtlinien für verantwortungsbewusstes Spielen sowie die externe Zertifizierung der Spielgerechtigkeit und -sicherheit.“"
                            },
                            {
                                "example_id": "562a39b5-7f2b-478b-a2c2-2209a1c57e5a",
                                "sense_id": "710f25da-238a-3ada-a835-b590385967c6",
                                "text": "„Damit möchten wir für noch mehr Chancengleichheit und Spielgerechtigkeit auf dem Tenniscourt sorgen, erläutert der begeisterte Tennisspieler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
