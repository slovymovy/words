                ],
                "senses": [
                    {
                        "sense_id": "0ea94759-77a5-3faf-978b-2d9c5e994590",
                        "entry_id": "0b22597e-0973-30a3-83f5-b939f2f217eb",
                        "glosses": [
                            "Ouvrir un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb553525-8e3a-466d-b683-01427f46096f",
                                "sense_id": "0ea94759-77a5-3faf-978b-2d9c5e994590",
                                "text": "L’organiste, en appuyant sur une pédale placée à sa droite, peut entrebailler plus ou moins ces lames, de manière à permettre au son des tuyaux renfermés dans la boîte d’expression de se répandre au dehors avec plus ou moins d’intensité."
                            },
                            {
                                "example_id": "8a3afccb-ba77-4154-8e8b-264f748260bc",
                                "sense_id": "0ea94759-77a5-3faf-978b-2d9c5e994590",
                                "text": "Au loin, on aperçoit la figure d’un soldat chanceler sur l’étendue brûlante et le cadre d’une porte au milieu de nulle part, entrebâillée sur l’infini."
                            }
                        ]
                    }
                ],
