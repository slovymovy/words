                "senses": [
                    {
                        "sense_id": "fdab7496-ee57-3fa7-abf2-431116c3d16d",
                        "entry_id": "7166ea2b-4aca-31a8-a196-5233390de6c8",
                        "glosses": [
                            "elite regiment van de landmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7accdb48-8cb5-4dfb-bf5a-42e0793b2d80",
                                "sense_id": "fdab7496-ee57-3fa7-abf2-431116c3d16d",
                                "text": "Onder aanvoering van de commandant landstrijdkrachten luitenant-generaal Mart de Kruif rijdt het peloton op tweede paasdag van Waterloo naar het Monument Vredesoperaties in Roermond. Daar wordt een krans gelegd. Dinsdag stoppen de fietsers bij het monument voor het regiment Stoottroepen in Beneden-Leeuwen en daarna bij het Militaire Ereveld op de Grebbeberg in Rhenen. Daar heeft een korte plechtigheid plaats. De tocht eindigt op de thuisbasis, de Kromhout Kazerne in Utrecht."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e8629f3-bc84-3880-8eba-684a9578e21d",
                        "entry_id": "7166ea2b-4aca-31a8-a196-5233390de6c8",
                        "glosses": [
                            "groep speciaal getrainde personen die het zwaarste en moeilijkste werk aankunnen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "07b6f564-c988-44c9-b1c5-5482099687f0",
                                "sense_id": "8e8629f3-bc84-3880-8eba-684a9578e21d",
                                "text": "Op afstand is dan ook niet te zien dat het om een bus gaat, waar de stoottroepen van het blauw op straat in verborgen zitten. Chauffeur Jan den Boer lacht. ,,Ja, dat is verrassend hè, het lijkt van de buitenkant op een gewone politiewagen, maar daar houdt de vergelijking dan ook onmiddellijk op.”"
                            }
                        ]
                    }
