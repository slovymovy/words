{
    "word_family": [
        "quarrelsome",
        "quarrelsomeness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43298735-bcd1-3634-8c4d-6e120111159a",
                    "sense_definition": "A dispute or heated argument, especially one that is verbal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We got into a silly <w>quarrel</w> about what food to order.",
                            "target_lang_translations": {
                                "de": "Wir hatten einen albernen <w>Streit</w> darüber, welches Essen wir bestellen sollten."
                            }
                        },
                        {
                            "text": "The neighbors had a loud <w>quarrel</w> in the street last night.",
                            "target_lang_translations": {
                                "de": "Die Nachbarn hatten gestern Abend einen lauten <w>Streit</w> auf der Straße."
                            }
                        }
                    ],
                    "synonyms": [
                        "argument",
                        "dispute",
                        "row",
                        "squabble"
                    ],
                    "common_phrases": [
                        "start a quarrel",
                        "end a quarrel"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Streit oder eine hitzige Auseinandersetzung, insbesondere verbaler Art."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Streit",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für eine Auseinandersetzung oder einen Konflikt."
                            },
                            {
                                "target_lang_word": "Zank",
                                "target_lang_sense_clarification": "Bezeichnet oft einen eher kleinlichen oder kindischen Streit."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                    "sense_definition": "A reason or ground for a complaint or objection.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have no <w>quarrel</w> with your decision, but I think we could have done better.",
                            "target_lang_translations": {
                                "de": "Ich habe keinen <w>Einwand</w> gegen deine Entscheidung, aber ich denke, wir hätten es besser machen können."
                            }
                        },
                        {
                            "text": "She has a <w>quarrel</w> with the way the company handles its employees.",
                            "target_lang_translations": {
                                "de": "Sie hat einen <w>Beschwerdegrund</w> bezüglich der Art und Weise, wie das Unternehmen mit seinen Mitarbeitern umgeht."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaint",
                        "objection",
                        "grievance"
                    ],
                    "common_phrases": [
                        "have a quarrel with"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Grund oder Anlass für eine Beschwerde oder einen Einwand."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Einwand",
                                "target_lang_sense_clarification": "Ein Argument, das gegen etwas vorgebracht wird."
                            },
                            {
                                "target_lang_word": "Beschwerdegrund",
                                "target_lang_sense_clarification": "Ein konkreter Anlass, um sich über etwas zu beklagen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0add9a47-42a1-3cd6-b706-ab73bcfc7806",
                    "sense_definition": "A tendency to argue or be quarrelsome.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was full of <w>quarrel</w> and always looking for a fight.",
                            "target_lang_translations": {
                                "de": "Er war voller <w>Streitsucht</w> und immer auf einen Kampf aus."
                            }
                        },
                        {
                            "text": "The dog showed a strange <w>quarrel</w> whenever strangers approached the gate.",
                            "target_lang_translations": {
                                "de": "Der Hund zeigte eine seltsame <w>Streitsucht</w>, wann immer Fremde sich dem Tor näherten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Neigung, zu streiten oder streitsüchtig zu sein."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Streitsucht",
                                "target_lang_sense_clarification": "Die Eigenschaft, ständig nach Streit zu suchen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52cf085f-910c-38d2-8d69-ee456da68a7b",
                    "sense_definition": "To argue fiercely or stop being on friendly terms.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They often <w>quarrel</w> about money matters.",
                            "target_lang_translations": {
                                "de": "Sie <w>streiten</w> sich oft über Geldangelegenheiten."
                            }
                        },
                        {
                            "text": "It is sad to see two best friends <w>quarrel</w> over such a small thing.",
                            "target_lang_translations": {
                                "de": "Es ist traurig zu sehen, wie zwei beste Freunde sich wegen einer so kleinen Sache <w>streiten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "argue",
                        "fight",
                        "squabble"
                    ],
                    "antonyms": [
                        "agree"
                    ],
                    "common_phrases": [
                        "quarrel with"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich heftig auseinandersetzen oder die freundschaftlichen Beziehungen beenden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich streiten",
                                "target_lang_sense_clarification": "Sich in einer verbalen Auseinandersetzung befinden."
                            },
                            {
                                "target_lang_word": "sich zanken",
                                "target_lang_sense_clarification": "Sich wegen Kleinigkeiten streiten."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "915510eb-f36e-3ec3-85a2-8c2380d58441",
                    "sense_definition": "To find fault or complain about something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is useless to <w>quarrel</w> with your fate.",
                            "target_lang_translations": {
                                "de": "Es ist nutzlos, mit seinem Schicksal zu <w>hadern</w>."
                            }
                        },
                        {
                            "text": "He likes to <w>quarrel</w> with every minor detail in the report.",
                            "target_lang_translations": {
                                "de": "Er <w>nörgelt</w> gerne an jedem kleinen Detail im Bericht herum."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain",
                        "cavil"
                    ],
                    "common_phrases": [
                        "quarrel with"
                    ],
                    "target_lang_definitions": {
                        "de": "An etwas herumnörgeln oder sich über etwas beschweren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nörgeln",
                                "target_lang_sense_clarification": "Sich ständig über Kleinigkeiten beschweren."
                            },
                            {
                                "target_lang_word": "sich beschweren",
                                "target_lang_sense_clarification": "Offiziell oder persönlich Unmut äußern."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d39c41d-3494-3fb6-9c8e-d46a45355611",
                    "sense_definition": "A square-headed arrow or bolt used for a crossbow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier loaded his crossbow with a heavy <w>quarrel</w>.",
                            "target_lang_translations": {
                                "de": "Der Soldat lud seine Armbrust mit einem schweren <w>Bolzen</w>."
                            }
                        },
                        {
                            "text": "The <w>quarrel</w> flew through the air and hit the target.",
                            "target_lang_translations": {
                                "de": "Der <w>Bolzen</w> flog durch die Luft und traf das Ziel."
                            }
                        }
                    ],
                    "synonyms": [
                        "bolt"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical context."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein quadratischer Pfeil oder Bolzen für eine Armbrust."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bolzen",
                                "target_lang_sense_clarification": "Das spezifische Geschoss einer Armbrust."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}