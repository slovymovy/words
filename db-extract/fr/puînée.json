                        "glosses": [
                            "Femme qui est née immédiatement après l’un de ses adelphes."
                        ],
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "examples": [
                            {
                                "example_id": "8e2003fe-d68a-4f7e-8223-73c661730009",
                                "sense_id": "3d71b21b-868b-391f-9aa4-c38c786208e7",
                                "text": "La première fille à laquelle je fis des attouchements, en conséquence de mon goût pour une jolie chaussure, fut ma première puînée, qui s’appelait Jenovefette."
                            },
                            {
                                "example_id": "50bccbab-7594-464d-bd5b-43e6f06cb9a5",
                                "sense_id": "3d71b21b-868b-391f-9aa4-c38c786208e7",
                                "text": "Bizoute, la puînée, mariée par égarement, tournait des films documentaires, légèrement romancés, du côté des îles Marquises."
                            }
                        ]
                    }
