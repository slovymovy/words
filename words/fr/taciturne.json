                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis l'annonce des résultats, Paul est devenu particulièrement <w>taciturne</w> et évite ses collègues."
                        },
                        {
                            "text": "Malgré son air <w>taciturne</w>, cet artisan est toujours prêt à rendre service avec bienveillance."
                        }
                    ],
