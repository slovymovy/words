                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0322d677-2423-4f81-b573-bc6a1e376ce7",
                                                "sense_id": "4d5e03aa-6a4d-3cd6-b81f-039d46c2e9e9",
                                                "text": "Lass uns den Senegal hinunterfahren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Senegal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                        "entry_id": "46f3d150-6db6-3cb6-9f50-34715348a520",
                                        "glosses": [
                                            "Staat an der westafrikanischen Atlantikküste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0def0a-4a73-4c4a-8aad-9c4ff00796f0",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "Dakar ist die Hauptstadt von Senegal."
                                            },
                                            {
                                                "example_id": "88e76d3b-a2c5-4259-a622-787952d646ee",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Der Senegal liegt im äußersten Westen Afrikas im Übergang der Sahelzone zu den Tropen.“"
                                            },
                                            {
                                                "example_id": "6a6bcbba-5d1f-4363-9cf0-3cc909ea80c7",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Grundsätzlich hat der Senegal den Status eines Entwicklungslandes, ist jedoch im Vergleich zu anderen westafrikanischen Ländern weiter entwickelt, was aber seine Produkte im Regionalvergleich überteuert wirken lässt.“"
                                            },
                                            {
                                                "example_id": "87fa3a4f-b239-4881-923a-f11609f24f9c",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Senegal liegt im Bereich wechselfeuchten Tropenklimas im Süden und tropischen Trockenklimas im Norden.“"
                                            },
                                            {
                                                "example_id": "5d2be3a2-83fd-4130-be79-7db2849a6f6b",
                                                "sense_id": "1f0a8ff6-e25e-357e-bf48-295f72d1d10d",
                                                "text": "„Laye floh mit seiner Frau und vier Kindern nach Senegal und kehrte nicht mehr nach Guinea zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
