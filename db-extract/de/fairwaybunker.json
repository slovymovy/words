                        "sense_id": "c21df4f3-ed95-3758-a079-b95fb36a238f",
                        "entry_id": "467bbd56-7188-3d72-9b9b-353036170bbc",
                        "glosses": [
                            "flache, mit Sand gefüllte Vertiefung als Hindernis auf einer Spielbahn im Bereich der Landzone der Golfbälle bei langen Schlägen (Abschlag, Fairwayschlag)"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "974af0c9-c2e4-49dc-acd9-368640dfc5ee",
                                "sense_id": "c21df4f3-ed95-3758-a079-b95fb36a238f",
                                "text": "„Aus dem Fairwaybunker soll der Ball nicht hoch und kurz, sondern flach und weit herausgeschlagen werden. Sehr wichtig ist daher die richtige Schlägerwahl, die entscheidend von der Höhe der Bunkerkante abhängt.“"
                            }
                        ],
