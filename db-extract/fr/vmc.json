                "word": "VMC",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "df5b62a6-b772-30b6-9d4a-4c80416bade5",
                        "entry_id": "8316d1ca-0a9f-3b8f-bbb0-45907cf814e3",
                        "glosses": [
                            "Dispositif destiné à assurer le renouvellement de l’air frais à l’intérieur des pièces d’un bâtiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff491300-4f00-4c2e-af79-9c7a393028e2",
                                "sense_id": "df5b62a6-b772-30b6-9d4a-4c80416bade5",
                                "text": "Cette surventilation peut être mécanique, certaines VMC peuvent surventiler automatiquement la nuit, ou manuelle, fenêtres laissées ouvertes la nuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f73efe3-6b3c-3e40-b7cb-5cf6607b2488",
                        "entry_id": "8316d1ca-0a9f-3b8f-bbb0-45907cf814e3",
                        "glosses": [
                            "Abréviation de valeur de marché créée."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92638793-7922-4e39-8626-9c94ef829b29",
                        "source_entry_id": "8316d1ca-0a9f-3b8f-bbb0-45907cf814e3",
                        "source_sense_id": "df5b62a6-b772-30b6-9d4a-4c80416bade5",
                        "target_lang_word": "Lüftungsgewerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lüftungsgewerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f14b5154-9b2c-3a6b-bba3-84a64da2b239",
                                        "entry_id": "89f90684-b071-3a7e-9299-454f021832ed",
                                        "glosses": [
                                            "Berufsstand des Lüftungsbaus"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "331f7579-7ccb-4ee2-80e8-77acc12be119",
                                                "sense_id": "f14b5154-9b2c-3a6b-bba3-84a64da2b239",
                                                "text": "„Die Installation der Elektro-, Heizungs-, Sanitär- und Lüftungsgewerke im ersten Bauabschnitt – das ist der Bereich Hochstraße und Klostergasse – seien in vollem Gange.“"
                                            },
                                            {
                                                "example_id": "b5b6af1b-667c-4dd4-9902-bc53393a1540",
                                                "sense_id": "f14b5154-9b2c-3a6b-bba3-84a64da2b239",
                                                "text": "„Bei den gesamten Planungen des Lüftungsgewerkes sollte aus brandtechnischen Gründen natürlich auf eine Verwendung nicht brennbarer Baustoffe der Klasse Al geachtet werden.“"
                                            },
                                            {
                                                "example_id": "ab7e9008-17a1-47ca-bb25-25bc1d9f4caa",
                                                "sense_id": "f14b5154-9b2c-3a6b-bba3-84a64da2b239",
                                                "text": "„Die quadratische Form und das klare Design revolutionieren das Lüftungsgewerk und bieten vielfältige Gestaltungsmöglichkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08ca3e8a-9a61-385b-9397-7a9d2557a558",
                                        "entry_id": "89f90684-b071-3a7e-9299-454f021832ed",
                                        "glosses": [
                                            "komplexes System, das der Lüftung in Gebäuden dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ad6325-dfe0-4648-961b-e442f6f79fb6",
                                                "sense_id": "08ca3e8a-9a61-385b-9397-7a9d2557a558",
                                                "text": "„Die quadratische Form und das klare Design revolutionieren das Lüftungsgewerk und bieten vielfältige Gestaltungsmöglichkeiten.“"
                                            },
                                            {
                                                "example_id": "77978ed7-20e6-4daf-b94b-eaf84a66d923",
                                                "sense_id": "08ca3e8a-9a61-385b-9397-7a9d2557a558",
                                                "text": "„Wir planen und konstruieren mit Unterstützung modernster CAD-Anlagen ihr Lüftungsgewerk mit Kanälen und Rohren.“"
                                            },
                                            {
                                                "example_id": "b9020bfc-217b-4d35-94e3-288f8f87c70a",
                                                "sense_id": "08ca3e8a-9a61-385b-9397-7a9d2557a558",
                                                "text": "„In den 1960er bis 1980er Jahren sei die Verwendung von Asbest in Lüftungsgewerken üblich gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
