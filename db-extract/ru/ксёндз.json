                "senses": [
                    {
                        "sense_id": "348dc05f-3ca6-3220-b112-b7a0da674d52",
                        "entry_id": "01892b61-8236-366c-9500-192e80b3679a",
                        "glosses": [
                            "Polish Catholic priest"
                        ],
                        "tags": [
                            "animate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "72032ac8-28fd-4350-ab54-8a6c3edff970",
                                "sense_id": "348dc05f-3ca6-3220-b112-b7a0da674d52",
                                "text": "К като́ликам приходи́л чё́рной те́нью ксёндз, всегда́ у само́й сте́нки появля́ясь и исчеза́я незаме́тно, так что́ за все го́ды я так и не улови́л его́ бри́того лица́.",
                                "translation": "Towards the Catholics the Polish priest came like a black shadow, always appearing right against the wall and disappearing so inconspicuously that throughout all my years there I could never get a look at his shaven face.",
                                "english": "Towards the Catholics the Polish priest came like a black shadow, always appearing right against the wall and disappearing so inconspicuously that throughout all my years there I could never get a look at his shaven face."
                            }
                        ]
                    }
                ],
