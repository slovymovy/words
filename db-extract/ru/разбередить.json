                                    },
                                    {
                                        "sense_id": "74b1d476-9ff5-3ad6-9a55-6c51e8e78162",
                                        "entry_id": "878107f2-6e3f-3c37-b8fc-a6ec59b7f409",
                                        "glosses": [
                                            "Vexation; irritation of mind; rage."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62573777-7710-4218-96e7-12b97a66c531",
                                                "sense_id": "74b1d476-9ff5-3ad6-9a55-6c51e8e78162",
                                                "text": "Like a wylde Bull, that, being at a bay, / Is bayted of a mastiffe and a hound / […] That in his chauffe he digs the trampled ground / And threats his horns […]"
                                            },
                                            {
                                                "example_id": "5a9dae87-d8e7-49a8-8701-8d1465e320fc",
                                                "sense_id": "74b1d476-9ff5-3ad6-9a55-6c51e8e78162",
                                                "text": "When we returned we found the poor prisoner in a terrible chafe with the sentinel for detaining him, for the guard had been true to his trust."
                                            }
                                        ]
                                    }
                                ]
                            },
