                "senses": [
                    {
                        "sense_id": "3ddfac35-4d16-392a-b1f2-6bb2bc44c0be",
                        "entry_id": "a3024985-eba2-32f7-aba1-51df5e6674ae",
                        "glosses": [
                            "eine Person, die in Deutschland bis in die 1960er Jahre in Städten und Gemeinden nach dem Motto: „Bekanntmachung! …“ öffentliche Ankündigungen verlesen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c37c3d59-e5ed-4b9a-b9fe-59cefe88763c",
                                "sense_id": "3ddfac35-4d16-392a-b1f2-6bb2bc44c0be",
                                "text": "Der Amtsbote hat die Verlesung der öffentlichen Angelegenheiten mit den Worten „Bekanntmachung! …“ und dem Läuten einer Glocke eingeleitet."
                            },
                            {
                                "example_id": "4b6534e6-c99c-4c36-a5ad-223c244d3919",
                                "sense_id": "3ddfac35-4d16-392a-b1f2-6bb2bc44c0be",
                                "text": "„Han Dau-go dankte tausendmal, verließ das Haus und begab sich mit dem Amtsboten in die Rindledergasse, um seine Angelegenheit zu erledigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "56235b1d-de29-36fb-be03-facb74873e0f",
                        "entry_id": "a3024985-eba2-32f7-aba1-51df5e6674ae",
                        "glosses": [
                            "ein Informationsheft oder eine Informationsschrift der Gemeinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b5821ad-781f-4515-b359-6e3b8fee5e95",
                                "sense_id": "56235b1d-de29-36fb-be03-facb74873e0f",
                                "text": "Im Amtsboten von letzter Woche standen einige interessante Dinge."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
