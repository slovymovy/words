            "senses": [
                {
                    "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                    "sense_definition": "A level or floor of a building or structure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They live in an apartment on the third <w>storey</w> of the building.",
                            "target_lang_translations": {
                                "tr": "Binanın üçüncü <w>katındaki</w> bir dairede yaşıyorlar."
                            }
                        },
                        {
                            "text": "The old town has many beautiful two <w>storey</w> houses lining the quiet streets.",
                            "target_lang_translations": {
                                "tr": "Eski şehirde, sakin sokaklar boyunca sıralanmış birçok güzel iki <w>katlı</w> ev var."
                            }
                        }
                    ],
                    "synonyms": [
                        "floor",
                        "level"
                    ],
                    "common_phrases": [
                        "two storey",
                        "top storey",
                        "upper storey"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir binanın veya yapının katı ya da seviyesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kat",
                                "target_lang_sense_clarification": "binanın her bir seviyesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6000e753-bea6-3108-85fb-ec9463360012",
                    "sense_definition": "A vertical level or distinct horizontal part in typography, such as in certain letters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher pointed out the single <w>storey</w> form of the lowercase letter g in the typography book.",
                            "target_lang_translations": {
                                "tr": "Öğretmen, tipografi kitabındaki küçük g harfinin tek <w>katlı</w> biçimine dikkat çekti."
                            }
                        },
                        {
                            "text": "A single <w>storey</w> letter can look quite different from its double version in printed texts.",
                            "target_lang_translations": {
                                "tr": "Tek <w>katlı</w> bir harf, basılı metinlerde çift katlı versiyonundan oldukça farklı görünebilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "single storey",
                        "double storey"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical typographic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tipografide bazı harflerde bulunan dikey seviye veya belirgin yatay bölüm."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "seviye",
                                "target_lang_sense_clarification": "tipografide harf katmanı veya bölümü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc7e1573-7895-3702-9e71-4cccf8f64045",
                    "sense_definition": "An entire building or edifice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old grand <w>storey</w> stood silently at the edge of the abandoned estate.",
                            "target_lang_translations": {
                                "tr": "Eski görkemli <w>bina</w>, terk edilmiş mülkün kenarında sessizce duruyordu."
                            }
                        },
                        {
                            "text": "They surveyed the crumbling <w>storey</w> before deciding how to proceed with the restoration.",
                            "target_lang_translations": {
                                "tr": "Restorasyona nasıl devam edeceklerine karar vermeden önce yıkılmakta olan <w>binayı</w> incelediler."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage for a building"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir binanın veya yapının tamamı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bina",
                                "target_lang_sense_clarification": "yapının tamamı"
                            }
                        ]
                    }
                }
            ]
        },
