                                "sense_id": "0cbd264d-3b05-3614-9b39-2d902a72c8bb",
                                "text": "The perennial saltgrass nipa (Distichlis palmeri, Poaceae) is endemic to northern Gulf of California tidal marshes flooded with hypersaline seawater."
                            },
                            {
                                "example_id": "b5df8ae7-54e5-495a-b3eb-ce7061de0f97",
                                "sense_id": "0cbd264d-3b05-3614-9b39-2d902a72c8bb",
                                "text": "Once a staple of the Cocopa people, wild populations of nipa have been greatly reduced due to dams and other watershed disruptions."
                            }
                        ]
                    }
