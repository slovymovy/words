                        "source_entry_id": "09dad022-f430-3dc2-b13e-43a1cad801f5",
                        "source_sense_id": "4e26cba0-e3f0-3672-bef3-ed6edcb90941",
                        "source_sense_description": "дисциплины, изучающие историю, культуру, языки, экономику, социальные и политические проблемы Индии",
