                        "glosses": [
                            "Phoenix L., drzewo z rodziny arekowatych, o pierzastych liściach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0dc70ed-ec39-4af8-bebd-7512e2dbf133",
                                "sense_id": "dece3035-8ac1-3dfe-952e-a18ad12d6009",
