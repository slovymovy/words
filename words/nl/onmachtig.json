{
    "word_family": [
        "onmacht",
        "macht",
        "machtig",
        "bemachtigen",
        "overmacht"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02634135-6e62-3cd2-b1ef-7147ed2b3351",
                    "sense_definition": "zonder de kracht of macht om iets te doen of te veranderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "machteloosheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>onmachtige</w> bestuurder kreeg niets voor elkaar bij de vergadering.",
                            "target_lang_translations": {
                                "en": "The <w>powerless</w> director achieved nothing at the meeting."
                            }
                        },
                        {
                            "text": "Ik voelde me totaal <w>onmachtig</w> toen ik zag wat er gebeurde.",
                            "target_lang_translations": {
                                "en": "I felt totally <w>helpless</w> when I saw what was happening."
                            }
                        }
                    ],
                    "synonyms": [
                        "machteloos",
                        "krachteloos"
                    ],
                    "antonyms": [
                        "machtig",
                        "krachtig"
                    ],
                    "common_phrases": [
                        "totaal onmachtig",
                        "onmachtig voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "without the power or strength to do or change something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "powerless",
                                "target_lang_sense_clarification": "lacking the ability to act or influence"
                            },
                            {
                                "target_lang_word": "helpless",
                                "target_lang_sense_clarification": "unable to defend oneself or act without help"
                            },
                            {
                                "target_lang_word": "impotent",
                                "target_lang_sense_clarification": "lacking power or effectiveness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b774af03-fabf-303c-97e5-082aa79bf56e",
                    "sense_definition": "niet in staat om iets te doen door een gebrek aan kennis of vaardigheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbekwaamheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bleek <w>onmachtig</w> om de complexe machine correct te bedienen.",
                            "target_lang_translations": {
                                "en": "He proved <w>incapable</w> of operating the complex machine correctly."
                            }
                        },
                        {
                            "text": "Zij was <w>onmachtig</w> om een goed antwoord op de vraag te geven.",
                            "target_lang_translations": {
                                "en": "She was <w>unable</w> to give a good answer to the question."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbekwaam",
                        "onkundig"
                    ],
                    "antonyms": [
                        "bekwaam",
                        "kundig"
                    ],
                    "common_phrases": [
                        "onmachtig om te handelen"
                    ],
                    "target_lang_definitions": {
                        "en": "unable to do something due to a lack of knowledge or skill"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incapable",
                                "target_lang_sense_clarification": "lacking the necessary ability or capacity"
                            },
                            {
                                "target_lang_word": "unable",
                                "target_lang_sense_clarification": "not having the skill or means to do something"
                            },
                            {
                                "target_lang_word": "incompetent",
                                "target_lang_sense_clarification": "not having the necessary skills to do something successfully"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6aec86e-378d-32b5-be42-12374620c2fd",
                    "sense_definition": "niet bij bewustzijn zijn",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewustzijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>onmachtige</w> meisje is met wat reukwater weer bij haar positieven gebracht.",
                            "target_lang_translations": {
                                "en": "The <w>unconscious</w> girl was brought back to her senses with some smelling salts."
                            }
                        },
                        {
                            "text": "Na de val bleef het slachtoffer enkele minuten <w>onmachtig</w> op de grond liggen.",
                            "target_lang_translations": {
                                "en": "After the fall, the victim remained lying <w>unconscious</w> on the ground for several minutes."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewusteloos",
                        "buiten bewustzijn",
                        "buiten kennis"
                    ],
                    "antonyms": [
                        "bij bewustzijn"
                    ],
                    "common_phrases": [
                        "onmachtig neerzinken"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "vaker gebruikt in oudere teksten voor bewusteloosheid"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "not being conscious; in a state of fainting or unconsciousness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unconscious",
                                "target_lang_sense_clarification": "not awake or aware of surroundings"
                            },
                            {
                                "target_lang_word": "insensible",
                                "target_lang_sense_clarification": "without awareness or feeling (dated)"
                            },
                            {
                                "target_lang_word": "fainted",
                                "target_lang_sense_clarification": "having lost consciousness temporarily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}