                ],
                "senses": [
                    {
                        "sense_id": "6f645532-e60b-339b-a6e6-ed252f89a209",
                        "entry_id": "6d326c78-412c-326c-b60c-17dd489ac46e",
                        "glosses": [
                            "Tromper, duper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d06f9ff-87bf-48a9-a544-b61d030acdb9",
                                "sense_id": "6f645532-e60b-339b-a6e6-ed252f89a209",
                                "text": "Ah tiens,ça me rappelle que je me suis fait pintader pas plus tard que là maintenant."
                            },
                            {
                                "example_id": "1d8d9e13-e7c2-4569-9764-a554977874c9",
                                "sense_id": "6f645532-e60b-339b-a6e6-ed252f89a209",
                                "text": "Ok, encore aujourd'hui je me fais pintader mais au moins je me fais pintader par des gens à qui je n'avoue pas mes sentiments."
                            },
                            {
                                "example_id": "6c6ae830-06b0-4452-b122-c4e365b52b78",
                                "sense_id": "6f645532-e60b-339b-a6e6-ed252f89a209",
                                "text": "De l'art de se faire pintader sur un site de rencontres."
                            },
                            {
                                "example_id": "e736a976-f054-4b99-afc1-6665cec4941a",
                                "sense_id": "6f645532-e60b-339b-a6e6-ed252f89a209",
                                "text": "Que Sonia soit plus glossy que jamais et ne se laisse plus pintader, que Vinsh reste ce qu’il est mais se mette à la vrai musique, que Pau trouve du temps pour sa vie d’overbookée permanente, que Petite Cervoise continue à aller partout au gré de ses humeurs et qu’elle enlève l’ordi de sa bannière, qu’Océane continue à m’émotionner avec ses textes, que Dalyna continue à s’occuper de ma conscience politique (mais si ça veut dire quelque chose!), que Bean et Eamimi restent aussi plaisantes à lire que déroutantes tant elles sont où je ne les attends pas, que Bébert continue à se taper les blogs mode à ma place (ça préservera mes quelques neurones), que Kil’ et Ines viennent plus souvent et que Nigivir revienne."
                            },
                            {
                                "example_id": "7d3d95f4-23f5-436d-938a-5b89b25ad115",
                                "sense_id": "6f645532-e60b-339b-a6e6-ed252f89a209",
                                "text": "Et pis c'est rien que des vilains ceux qui nous pintadent"
                            }
                        ]
                    },
                    {
                        "sense_id": "0ded90a4-13eb-39e9-8241-a1f45f71c8e7",
                        "entry_id": "6d326c78-412c-326c-b60c-17dd489ac46e",
                        "glosses": [
                            "Faire des activités entre filles."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cb2fb249-0603-430f-85db-d53de9786eb9",
                                "sense_id": "0ded90a4-13eb-39e9-8241-a1f45f71c8e7",
                                "text": "D'humeur à joyeusement pintader ?"
                            },
                            {
                                "example_id": "3383d75b-a1f9-47cc-a8e4-c1905cf42a72",
                                "sense_id": "0ded90a4-13eb-39e9-8241-a1f45f71c8e7",
                                "text": "Samedi dernier, nous étions quelques filles à pintader."
                            },
                            {
                                "example_id": "2bc7011a-cb06-4eb6-825b-bfd9083563ef",
                                "sense_id": "0ded90a4-13eb-39e9-8241-a1f45f71c8e7",
                                "text": "Bon, les filles c'est pas que vous gênez mais nous on bosse, donc allez pintader ailleurs."
                            },
                            {
                                "example_id": "00c2b67c-4a01-40e1-9c85-d72b1cc2fdf9",
                                "sense_id": "0ded90a4-13eb-39e9-8241-a1f45f71c8e7",
                                "text": "Nous terminions la soirée à pintader sur nous et la nouvelle technologie qui a bien évolué depuis et nos premiers achats du style...."
                            },
                            {
                                "example_id": "05849b10-296a-4b33-91ad-aeb5802325d5",
                                "sense_id": "0ded90a4-13eb-39e9-8241-a1f45f71c8e7",
                                "text": "Nous pintadons toutes, même au bureau"
                            }
                        ]
                    }
