                "senses": [
                    {
                        "sense_id": "6b98075f-8fd9-353a-9baa-14eb2934ad31",
                        "entry_id": "b600cc5f-2ad0-337e-b5b0-40be573e3d76",
                        "glosses": [
                            "exploitation; denial of the fruits of labor from the laborers; wage slavery"
                        ],
                        "tags": [
                            "derogatory",
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "c701f90a-f72c-4351-8426-bd5c5b409249",
                                "sense_id": "6b98075f-8fd9-353a-9baa-14eb2934ad31",
                                "text": "W gruncie rzeczy Pentuer nie powiedział nic nowego: wszyscy narzekali na ubytek ziemi i ludności w Egipcie, na nędzę chłopów, nadużycia pisarzów i wyzysk Fenicjan.",
                                "translation": "In essence, Pentuer didn't say anything new: everyone complained about the loss of land and decline in the population of Egypt, the peasants' suffering, abuse at the hand of scribes, and the exploitation committed by the Phoenicians.",
                                "english": "In essence, Pentuer didn't say anything new: everyone complained about the loss of land and decline in the population of Egypt, the peasants' suffering, abuse at the hand of scribes, and the exploitation committed by the Phoenicians."
                            },
                            {
                                "example_id": "96f5f5db-c8b2-4ccb-a575-898c3cb1e8f5",
                                "sense_id": "6b98075f-8fd9-353a-9baa-14eb2934ad31",
                                "text": "— Rety! Rety! Co za wyzysk!",
                                "translation": "Oh, Lord! Oh, Lord! This is exploitation!",
                                "english": "Oh, Lord! Oh, Lord! This is exploitation!"
                            },
                            {
                                "example_id": "dce70d5e-a016-4191-b358-7a4d78b9b5e1",
                                "sense_id": "6b98075f-8fd9-353a-9baa-14eb2934ad31",
                                "text": "Podobnie jak kłamstwo jest chorobą mowy, tak wyzysk jest chorobą pracy.",
                                "translation": "Just as lying is a disease of speech, exploitation is a disease of labor.",
                                "english": "Just as lying is a disease of speech, exploitation is a disease of labor."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb0e5a84-bf2d-335c-ae05-18604ea12e01",
                        "entry_id": "b600cc5f-2ad0-337e-b5b0-40be573e3d76",
                        "glosses": [
                            "economic duress; exploitation of someone's poor financial situation to force them into a disadvantageous contract"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "e1ae776b-a698-49d6-8089-2b1994cf3306",
                                "sense_id": "eb0e5a84-bf2d-335c-ae05-18604ea12e01",
                                "text": "Trzeba nazywać po imieniu niesprawiedliwość, wyzysk człowieka przez człowieka albo wyzysk człowieka ze strony państwa, instytucji, mechanizmów systemów ekonomicznych i reżimów działających niekiedy bez wyczucia.",
                                "translation": "We should call injustice by its name, the exploitation of a person by another or exploitation of a person by the state, institution, or economic mechanism of the system and regimes operate sometimes without sense.",
                                "english": "We should call injustice by its name, the exploitation of a person by another or exploitation of a person by the state, institution, or economic mechanism of the system and regimes operate sometimes without sense."
                            },
                            {
                                "example_id": "3f119820-d35a-47ad-83ae-c61aaad16abc",
                                "sense_id": "eb0e5a84-bf2d-335c-ae05-18604ea12e01",
                                "text": "Tytułem przykładu można wskazać możliwość unieważnienia przez sąd umowy połączonej z wyzyskiem (art. 388 k.c.).",
                                "translation": "As an example we can point to the repealability of an agreement associated with exploitation (article 388 of the Civil Code).",
                                "english": "As an example we can point to the repealability of an agreement associated with exploitation (article 388 of the Civil Code)."
                            },
                            {
                                "example_id": "caa7cb83-9abf-41e7-b529-eb79a880a630",
                                "sense_id": "eb0e5a84-bf2d-335c-ae05-18604ea12e01",
                                "text": "Pewne wątpliwości budzi charakter prawny wyzysku; […]",
                                "translation": "The legal nature of exploitation raises certain doubts: […]",
                                "english": "The legal nature of exploitation raises certain doubts: […]"
                            }
                        ]
                    }
