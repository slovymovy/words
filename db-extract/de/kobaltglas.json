                        "cross_references": []
                    },
                    {
                        "translation_id": "5fbfa731-a65f-4e1f-8108-5ee00b3c988b",
                        "source_entry_id": "2285fc32-4149-3011-941f-717616fd2f01",
                        "source_sense_id": "b4979af4-56a4-3409-a732-3b2d72f90864",
                        "source_sense_description": "Technik: Glas, das mit Kobaltoxid blau gefärbt wurde",
                        "target_lang_word": "azur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2fb37bb-8567-39de-9311-fd0e34ec0ff1",
                                        "entry_id": "6e40f501-71d5-34aa-8052-85f2da4ab939",
                                        "glosses": [
                                            "Verre coloré en bleu par l’oxyde de cobalt et réduit en poudre extrêmement fine pour servir de colorant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b96f35f0-97aa-4be7-8e91-1cdbbd91980e",
                                                "sense_id": "a2fb37bb-8567-39de-9311-fd0e34ec0ff1",
                                                "text": "De l’azur de première qualité, bleu d’azur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba7c0e94-1fac-3d9b-b0ac-d3beef377fd1",
                                        "entry_id": "6e40f501-71d5-34aa-8052-85f2da4ab939",
                                        "glosses": [
                                            "Cette couleur bleue, qui est celle du ciel pur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cfedf50-706a-48ab-82ee-98be8b757cf0",
                                                "sense_id": "ba7c0e94-1fac-3d9b-b0ac-d3beef377fd1",
                                                "text": "Et cet azur épandu sur des costumes dont les plis sont à peine accusés par des blancs est d’une sérénité extraordinaire, d’une candeur inouïe."
                                            },
                                            {
                                                "example_id": "33ca43de-b066-46c8-a78e-2c7837aa37e8",
                                                "sense_id": "ba7c0e94-1fac-3d9b-b0ac-d3beef377fd1",
                                                "text": "Dieu n'a pas fait d'aliments bleus. Il a voulu réserver l’azur pour le firmament et les yeux de certaines femmes."
                                            },
                                            {
                                                "example_id": "bece5eb7-3703-4f53-a40f-044499d0013f",
                                                "sense_id": "ba7c0e94-1fac-3d9b-b0ac-d3beef377fd1",
                                                "text": "Calme et douce comme ces petits lacs purs que les pluies laissent au printemps pour un instant dans les éphémères prairies africaines, et où rien ne se reflète, sauf l’azur infini du ciel sans nuages."
                                            },
                                            {
                                                "example_id": "d7c2350f-7d8e-409b-b3a0-37606e04bea6",
                                                "sense_id": "ba7c0e94-1fac-3d9b-b0ac-d3beef377fd1",
                                                "text": "[…] l’aspect automnal, de beaucoup le mieux marqué, est surtout déterminé par la floraison de Galeopsis Ladanum qui étend ses nappes roses lilacées sur le fond jauni des chaumes parmi le rouge des Coquelicots, le jaune soufre des Linaires et l’azur des Bleuets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76a251fa-164e-385e-997a-a06e0e687e26",
                                        "entry_id": "6e40f501-71d5-34aa-8052-85f2da4ab939",
                                        "glosses": [
                                            "Le ciel bleu et pur, lui-même."
                                        ],
                                        "tags": [
                                            "literary",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3634895d-b2f2-4551-9ae0-27f0592f66f2",
                                                "sense_id": "76a251fa-164e-385e-997a-a06e0e687e26",
                                                "text": "A peine les ont-ils déposés sur les planches,\nQue ces rois de l’azur, maladroits et honteux,\nLaissent piteusement leurs grandes ailes blanches\nComme des avirons traîner à côté d'eux."
                                            },
                                            {
                                                "example_id": "f6a834b8-9462-4508-b935-afc47260ef75",
                                                "sense_id": "76a251fa-164e-385e-997a-a06e0e687e26",
                                                "text": "Dans l’azur à peine noirci du couchant, l’étoile du berger brillait d’un feu paisible ."
                                            },
                                            {
                                                "example_id": "2cbbc1b6-fa67-4c6c-8f8a-6a911a0bd2e8",
                                                "sense_id": "76a251fa-164e-385e-997a-a06e0e687e26",
                                                "text": "Ce fut un grand Vaisseau taillé dans l’or massif :\nSes mâts touchaient l’azur, sur des mers inconnues ;\nLa Cyprine d’amour, cheveux épars, chairs nues\nS’étalait à sa proue, au soleil excessif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3516fc21-5f3f-3401-9bbd-0404e874d7e0",
                                        "entry_id": "6e40f501-71d5-34aa-8052-85f2da4ab939",
                                        "glosses": [
                                            "Émail servant à décrire la couleur bleue d’un élément des armoiries : écu, partition, pièce, meuble, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffb35fa5-af3c-43f0-a46b-5f2c1cc5ab5e",
                                                "sense_id": "3516fc21-5f3f-3401-9bbd-0404e874d7e0",
                                                "text": "D’azur à trois fleurs de lys d’or, qui est la France moderne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee49207-ad79-3ac6-9fe0-d06bcb9c265a",
                                        "entry_id": "6e40f501-71d5-34aa-8052-85f2da4ab939",
                                        "glosses": [
                                            "Petite cannelure angulaire que l'on refouille dans un montant de chambranle à la hauteur et en place de l'astragale"
                                        ],
                                        "tags": [
                                            "Marbrerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a3b4f89-46a9-3010-94f7-b10d6df7aac3",
                                        "entry_id": "6e40f501-71d5-34aa-8052-85f2da4ab939",
                                        "glosses": [
                                            "Nom donné à l'un des trois codon-stop. Parfois aussi nommé opale. C'est le codon UGA."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97fd1c33-77d8-4d48-9c4b-cc702d1b397b",
                                                "sense_id": "1a3b4f89-46a9-3010-94f7-b10d6df7aac3",
                                                "text": "On s’attendait à trouver 20 codons. Or il y en a 61 et 3 non-sens : Ocre, Ambre et Azur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "azur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3250c60-fe4e-372f-9acc-569384c39bab",
                                        "entry_id": "95122b22-4695-396e-b2f5-7689a936342a",
                                        "glosses": [
                                            "De la couleur bleu clair intense, de la couleur du ciel pur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7194d096-c6e5-49c6-8423-f36073e1d72e",
                                                "sense_id": "d3250c60-fe4e-372f-9acc-569384c39bab",
                                                "text": "Au pressing, j’avais dû affronter le courroux de la dame des lieux.\n– Des taches pareilles sur une robe de cette qualité, avait-elle maugréé en me remettant un ticket bleu azur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df2ceb5-d953-329e-a08c-c47f32bc6c39",
                                        "entry_id": "95122b22-4695-396e-b2f5-7689a936342a",
                                        "glosses": [
                                            "Voir d’azur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
