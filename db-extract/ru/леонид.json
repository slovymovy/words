                "senses": [
                    {
                        "sense_id": "cc496821-c4d3-3239-810e-8629416a5d7d",
                        "entry_id": "fd9d372b-ccc3-37e5-a671-f65e7acab231",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca8c8413-e4a2-412a-bc6c-bf36d9221125",
                                "sense_id": "cc496821-c4d3-3239-810e-8629416a5d7d",
                                "text": "Меня зовут Леонид."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24e2c179-e6ba-4ae4-b672-a56471da1832",
                        "source_entry_id": "fd9d372b-ccc3-37e5-a671-f65e7acab231",
                        "source_sense_id": "cc496821-c4d3-3239-810e-8629416a5d7d",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Leonid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leonid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "530f56cd-38dd-31d5-9eaa-db8075d5e965",
                                        "entry_id": "d2ac4e52-931d-3c1d-aae4-1205ddd3c9a1",
                                        "glosses": [
                                            "Any meteor of a meteor shower that appears to radiate from the constellation Leo in November."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a790fd9-e1e9-436a-96d2-987dfa8f0019",
                                                "sense_id": "530f56cd-38dd-31d5-9eaa-db8075d5e965",
                                                "text": "I wrote my first story about the ghost of a horse leaping from a cascade of flame just after the leonids had been more torrential than men had remembered them for centuries."
                                            },
                                            {
                                                "example_id": "4985f51a-6a4e-49da-a2eb-d7fd3fb215a9",
                                                "sense_id": "530f56cd-38dd-31d5-9eaa-db8075d5e965",
                                                "text": "Night of your birth. Thirty-three. The Leonids they were called. God how the stars did fall. I looked for blackness, holes in the heavens. The Dipper stove."
                                            },
                                            {
                                                "example_id": "2a07c0e1-eb82-49c0-bf0e-657ba529b151",
                                                "sense_id": "530f56cd-38dd-31d5-9eaa-db8075d5e965",
                                                "text": "I was surprised by […] the unusually tall windows, […] through which long telescopes were once turned on eclipses of the sun and the moon, on the intersections of the orbits of the stars with the line of the meridian, on the Leonid meteorite showers and the long-tailed comets flying through space."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Leonid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9667c02-6c6c-312a-9f6a-8e8d40d2e0a3",
                                        "entry_id": "b6833134-fdee-3f70-b433-9835461f77ca",
                                        "glosses": [
                                            "A male given name, a transliteration of a common East Slavic name (notably that of the first two Ukrainian presidents, Leonid Kravchuk and Leonid Kuchma, as well as Soviet leader Leonid Brezhnev)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
