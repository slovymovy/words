                "senses": [
                    {
                        "sense_id": "683b769a-1c26-38c1-91ab-6f0e44da1434",
                        "entry_id": "2267be19-b0ec-39af-a265-c784fd7d3012",
                        "glosses": [
                            "To remove hair from (something), especially from hide."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bf8493aa-c27f-4f36-8fd7-7962aaab4725",
                                "sense_id": "683b769a-1c26-38c1-91ab-6f0e44da1434",
                                "text": "The sides, after being unhaired, are put in clean water over night, then green-shaved and put in a bate of hen manure four or five days."
                            },
                            {
                                "example_id": "6aff0831-f29c-4804-8d98-e0e0e846a6d0",
                                "sense_id": "683b769a-1c26-38c1-91ab-6f0e44da1434",
                                "text": "They found that such a practice produced what was termed a \"mellow\" lime; the mellower the lime the more rapidly it unhaired the skin."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a6d5376-8703-32df-8cd5-d7645997ffa4",
                        "entry_id": "2267be19-b0ec-39af-a265-c784fd7d3012",
                        "glosses": [
                            "To become free from hair."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7fcecbf2-74c5-4041-84a1-8ba618524848",
                                "sense_id": "8a6d5376-8703-32df-8cd5-d7645997ffa4",
                                "text": "If the skin is soaked in an amine solution before being placed in the lime it unhairs at a faster rate, however, than if soaked in plain water, as shown in Table VII."
                            }
                        ]
                    }
