                                    {
                                        "sense_id": "8305d2fa-d8a3-31fa-96cf-2c476f314293",
                                        "entry_id": "d813b3b4-e3ec-3e7c-b637-0700b315bf4b",
                                        "glosses": [
                                            "A small container for illicit drugs made from a condom or the finger of a latex glove, etc."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86322952-26cb-483f-a1fd-1bcc463b8db7",
                                                "sense_id": "8305d2fa-d8a3-31fa-96cf-2c476f314293",
                                                "text": "And all I had to do in return was take a drive up to Ricardo's place on the way home and then a pretty edgy one back to Rondebosch with a balloon of coke sandwiched between two pairs of underpants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2dfbea-2050-304a-b48f-8f7fdba8cf21",
                                        "entry_id": "d813b3b4-e3ec-3e7c-b637-0700b315bf4b",
                                        "glosses": [
                                            "Synonym of balloon payment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a3a032-c464-414f-b444-2044efd271b0",
                                                "sense_id": "8a2dfbea-2050-304a-b48f-8f7fdba8cf21",
                                                "text": "The purpose of the balloon is to reduce the periodic payment required during the life of the financing period."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "balloon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edce02fd-d4d5-3549-94b5-f4edd59197c4",
                                        "entry_id": "9bbdf26f-26e5-3df2-b2c9-5df199396aa4",
                                        "glosses": [
                                            "To increase or expand rapidly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea8f756d-f9c6-4a2e-891f-0ae6f7ed5a28",
                                                "sense_id": "edce02fd-d4d5-3549-94b5-f4edd59197c4",
                                                "text": "His stomach ballooned from eating such a large meal."
                                            },
                                            {
                                                "example_id": "c9f6ee26-09e3-4193-b6c7-52c137f3f571",
                                                "sense_id": "edce02fd-d4d5-3549-94b5-f4edd59197c4",
                                                "text": "Prices will balloon if we don't act quickly."
                                            },
                                            {
                                                "example_id": "593dd60d-c556-4d69-bf1e-1696a9146057",
                                                "sense_id": "edce02fd-d4d5-3549-94b5-f4edd59197c4",
                                                "text": "For the franchise’s ballooning, unmanageable cast of mutants, picking sides now seems to have less to do with choosing between cooperation (which the recent movies implicitly distrust) and resistance, and more with whichever flashback-prone white dude’s overbearing savior complex works for you."
                                            },
                                            {
                                                "example_id": "11db9ca4-9e17-4e46-ab79-0a43634f622e",
                                                "sense_id": "edce02fd-d4d5-3549-94b5-f4edd59197c4",
                                                "text": "ScotRail has long been run at a significant subsidy, with only the Edinburgh-Glasgow express line making a profit from fares, but government support has ballooned since the start of the pandemic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e0799af-94e8-3138-ab12-4bae9dc641d3",
                                        "entry_id": "9bbdf26f-26e5-3df2-b2c9-5df199396aa4",
                                        "glosses": [
                                            "To go up or voyage in a balloon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81b9e66d-ebcd-3ef0-adb8-56b92b00e5d0",
                                        "entry_id": "9bbdf26f-26e5-3df2-b2c9-5df199396aa4",
                                        "glosses": [
                                            "To take up in, or as if in, a balloon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81e20150-b802-339e-aa3b-bf86398f0816",
                                        "entry_id": "9bbdf26f-26e5-3df2-b2c9-5df199396aa4",
                                        "glosses": [
                                            "To inflate like a balloon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0256360c-670d-4a8e-b3e4-852cbbaa6714",
                                                "sense_id": "81e20150-b802-339e-aa3b-bf86398f0816",
                                                "text": "A puff of wind from the open door caught and ballooned the scanties; off they sailed, out the window billowing into freedom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "365b3cdb-5300-34f2-9e97-a9fe023cba2f",
                                        "entry_id": "9bbdf26f-26e5-3df2-b2c9-5df199396aa4",
                                        "glosses": [
                                            "To strike (a ball) so that it flies high in the air."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00e6a7da-c997-4e6e-acc3-2ed9d55af0e8",
                                                "sense_id": "365b3cdb-5300-34f2-9e97-a9fe023cba2f",
                                                "text": "After four minutes, leading goalscorer Haworth slid in but ballooned the ball over from six yards, and Hume then outran the defence to get to the by-line, but he could only hit his cross straight out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21163b17-eeda-3461-be71-2a80ebe2d628",
                                        "entry_id": "9bbdf26f-26e5-3df2-b2c9-5df199396aa4",
                                        "glosses": [
                                            "Of an aircraft: to plunge alternately up and down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c000cc0f-8c1e-4d07-9e8d-f2f87d57bcdd",
                                                "sense_id": "21163b17-eeda-3461-be71-2a80ebe2d628",
                                                "text": "The plane ballooned into the air about 20 feet, banging down again for another good-sized hop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
