                "senses": [
                    {
                        "sense_id": "2de88d80-efc6-33b7-8870-da45fab540c3",
                        "entry_id": "9b9c89cc-933a-3abf-825a-eb051c717e59",
                        "glosses": [
                            "offenes Behältnis, in dem sich brennende Kohlen zum Heizen eines Raumes befinden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26e49118-cd68-469a-9380-07c645fb8353",
                                "sense_id": "2de88d80-efc6-33b7-8870-da45fab540c3",
                                "text": "„Anfänglich wurde der Raum mit einem kleinen Kohlenbecken geheizt, das auf dem Boden stand; da man jedoch in Tibet keine Schornsteine kannte, füllte sich der Raum, wenn das Feuer brannte, bald mit Rauch, der Csoma in den Augen stach, so daß er nicht mehr lesen konnte.“"
                            },
                            {
                                "example_id": "eaa62120-527a-4e49-95ee-c49c87ac369c",
                                "sense_id": "2de88d80-efc6-33b7-8870-da45fab540c3",
                                "text": "„Augenblicklich stellte man ringsum Kohlenbecken hin und schüttete Holzkohle auf.“"
                            },
                            {
                                "example_id": "c8866486-3bf2-4331-9a52-1a9b968b7118",
                                "sense_id": "2de88d80-efc6-33b7-8870-da45fab540c3",
                                "text": "„Am Tag des heiligen Michael erschien Lorenzo in aller Frühe mit einem großen Kessel, in dem die Makkaroni kochten; ich stellte sogleich Butter auf ein Kohlenbecken, um sie zu schmelzen, und bereitete meine zwei Platten vor, die ich mit Parmesan bestreute, den er mir fertig gerieben gebracht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f68fe377-6c37-3f3d-9da4-a1f92badabc3",
                        "entry_id": "9b9c89cc-933a-3abf-825a-eb051c717e59",
                        "glosses": [
                            "Bergbaugebiet mit Kohlevorkommen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4e09692-c476-40a3-a50a-038a219244c6",
                        "source_entry_id": "9b9c89cc-933a-3abf-825a-eb051c717e59",
                        "source_sense_id": "2de88d80-efc6-33b7-8870-da45fab540c3",
                        "source_sense_description": "offenes Behältnis, in dem sich brennende Kohlen zum Heizen eines Raumes befinden können",
                        "target_lang_word": "brasero",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brasero",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13afa3f3-c8af-3c59-aef1-84a8ca146429",
                                        "entry_id": "adf2b8f2-2d67-34f4-b4e7-890eb37fb1cf",
                                        "glosses": [
                                            "Variante de braséro."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5a21fa4-f7d5-4132-9839-feccc13a77b7",
                                                "sense_id": "13afa3f3-c8af-3c59-aef1-84a8ca146429",
                                                "text": "Le brasero est une grande bassine de cuivre jaune posée sur un trépied et remplie de braise ou de petits noyaux allumés et recouverts de cendre fine, qui font un feu doux. Le brasero remplace en Espagne les cheminées, qui sont fort rares."
                                            },
                                            {
                                                "example_id": "c3c8c67d-e927-41e6-8dc3-71bd03571efb",
                                                "sense_id": "13afa3f3-c8af-3c59-aef1-84a8ca146429",
                                                "text": "[…] ; car l’averse continue, torrentielle, et la nuit est si froide et si noire… D’ailleurs les environs ne sont plus qu’un vaste bourbier, et, grâce au thé et au brasero, je me sens si bien à l’aise dans la tente du chîkh que je consens volontiers à y rester."
                                            },
                                            {
                                                "example_id": "d22fbb85-5220-453f-b56f-aff410700f29",
                                                "sense_id": "13afa3f3-c8af-3c59-aef1-84a8ca146429",
                                                "text": "Et le feu d’un petit brasero avec trois grelotteux autour qui louchaient dans la fumée puante. On n’était pas très bien."
                                            },
                                            {
                                                "example_id": "713de914-cba1-4643-ba42-2e500021c2d2",
                                                "sense_id": "13afa3f3-c8af-3c59-aef1-84a8ca146429",
                                                "text": "À ses pieds, sur un brasero incandescent, fumait un chaudron ventru."
                                            },
                                            {
                                                "example_id": "06c00e62-35b6-42de-8813-b361bf098e0b",
                                                "sense_id": "13afa3f3-c8af-3c59-aef1-84a8ca146429",
                                                "text": "Quelques ordres fusèrent […]. Aboyés avec la rudesse gutturale d’un gosier poméranien, ils eurent pour effet immédiat de déloger un groupe de feldgraus agglutinés devant la flamme dansante d’un brasero."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
