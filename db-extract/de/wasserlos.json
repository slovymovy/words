                                        "entry_id": "c718409b-b806-3b8f-8531-a4f245050db9",
                                        "glosses": [
                                            "Dry, arid, lacking water."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb1b899-6eb9-4e0c-920a-37cf96c34528",
                                                "sense_id": "7644e4aa-f36b-3955-bc0d-43aae24872f7",
                                                "text": "The waterless desert can kill in many ways but dehydration is often fastest."
                                            },
                                            {
                                                "example_id": "b302f15d-2122-4b06-bebd-72bca89b97b0",
                                                "sense_id": "7644e4aa-f36b-3955-bc0d-43aae24872f7",
                                                "text": "Also the Russian lines over which these locomotives run pass through long stretches of waterless country, where the only alternative to hauling additional water-tank wagons is to conserve the water supply by condensing."
                                            },
                                            {
                                                "example_id": "29eabec6-2fa9-4fa4-8467-d31e13a03ec6",
                                                "sense_id": "7644e4aa-f36b-3955-bc0d-43aae24872f7",
                                                "text": "Contrasting the luxurious life of the foreigners with the overcrowded, fetid, waterless existence of the Arabs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1930ebc-f0fb-3593-9d80-00175e8b76f5",
                                        "entry_id": "c718409b-b806-3b8f-8531-a4f245050db9",
                                        "glosses": [
                                            "Not requiring water."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4987b599-67fb-4248-8c7a-f0882bdb05b7",
                                                "sense_id": "c1930ebc-f0fb-3593-9d80-00175e8b76f5",
                                                "text": "How does a waterless urinal have a drain trap?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
