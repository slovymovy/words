                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5ac29ef-70ad-4201-b7ff-4fab5bab556d",
                                                "sense_id": "967b4ea4-20b1-3bfe-bcd7-f401ebfdd793",
