                        "entry_id": "26dea53b-58a0-3e96-b3d7-32e6f364c117",
                        "glosses": [
                            "Relatif à Lancaster."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a55f224c-f679-3cc9-9a26-86ac0f20c2cb",
                        "entry_id": "26dea53b-58a0-3e96-b3d7-32e6f364c117",
                        "glosses": [
                            "Relatif au système éducatif mutuel créé par Joseph Lancaster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e38cfae8-ec95-4681-9b21-b281a12108dd",
                                "sense_id": "a55f224c-f679-3cc9-9a26-86ac0f20c2cb",
                                "text": "Dans plusieurs articles , nous avons démontré l'avantage des écoles lancastriennes sur les vieilles méthodes."
                            },
                            {
                                "example_id": "3fda08c1-b265-47b7-b232-dd9a93c6971e",
                                "sense_id": "a55f224c-f679-3cc9-9a26-86ac0f20c2cb",
                                "text": "Méthode lancastérienne, ou système d'éducation britannique."
                            }
                        ]
                    },
                    {
                        "sense_id": "2688fd3b-0c4f-3ef2-9073-4655f527f835",
                        "entry_id": "26dea53b-58a0-3e96-b3d7-32e6f364c117",
                        "glosses": [
                            "Relatif à la maison de Lancastre."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "cc009bed-e478-4587-886e-87bd307289af",
                                "sense_id": "2688fd3b-0c4f-3ef2-9073-4655f527f835",
                                "text": "La guerre civile, dite guerre des Deux Roses, éclate en 1455 ; Marguerite prend la tête du parti lancastrien qui, en 1460, est battu par Warwick à Northampton."
                            },
                            {
                                "example_id": "95b6bdff-57a8-44a1-8daa-94e9688e3ca7",
                                "sense_id": "2688fd3b-0c4f-3ef2-9073-4655f527f835",
                                "text": "Les lords lancastriens qui restaient fidèles à sa cause, l'engagèrent à quitter cet asile, la conduisirent à Bath, et levèrent un corps de troupes considérable pour combattre sous sa bannière."
                            }
                        ]
                    }
