    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "774e33c3-b115-3dbf-909d-7345edfa8bdc",
                    "sense_definition": "Se moquer gentiment de quelqu'un, le taquiner ou lui lancer des piques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moquerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses camarades aiment le <w>vanner</w> sur son nouveau chapeau mais il le prend toujours très bien."
                        },
                        {
                            "text": "Arrête de me <w>vanner</w> devant tout le monde, ce n'est vraiment plus drôle."
                        }
                    ],
                    "synonyms": [
                        "chambrer"
                    ],
                    "common_phrases": [
                        "se faire vanner"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "0b9003a5-6c07-3e80-9d9c-08006f394df8",
                    "sense_definition": "Épuiser physiquement, fatiguer de manière excessive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fatigue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette longue randonnée en montagne finit par me <w>vanner</w> complètement."
                        },
                        {
                            "text": "Le travail intensif de cette semaine va le <w>vanner</w> s'il ne prend pas de repos."
                        }
                    ],
                    "common_phrases": [
                        "être vanné"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier, souvent employé au participe passé"
                        }
                    ]
                },
                {
                    "sense_id": "494bcbf1-1344-3c5f-8919-4c097a482850",
                    "sense_definition": "Nettoyer les céréales en les secouant dans un van ou en les lançant en l'air pour séparer le grain de la paille et des impuretés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les agriculteurs passaient des heures à <w>vanner</w> le blé dans la cour de la ferme."
                        },
                        {
                            "text": "Il faut d'abord <w>vanner</w> la récolte avant de pouvoir moudre les céréales."
                        }
                    ],
                    "common_phrases": [
                        "vanner le blé"
                    ]
                },
                {
                    "sense_id": "fb4d65f4-ff15-39ee-9cbc-2aca93361b75",
                    "sense_definition": "Remuer une sauce ou une préparation liquide pendant son refroidissement pour empêcher la formation d'une peau à la surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier doit <w>vanner</w> la sauce délicatement jusqu'à son complet refroidissement."
                        },
                        {
                            "text": "Après la cuisson de la crème, n'oublie pas de la <w>vanner</w> pour éviter qu'une croûte apparaisse."
                        }
                    ],
                    "common_phrases": [
                        "vanner une sauce"
                    ]
                }
            ]
        }
    ]
