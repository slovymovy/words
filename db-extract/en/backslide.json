                                    },
                                    {
                                        "sense_id": "12bbe1a8-1d46-323b-97f4-6b99f80a9829",
                                        "entry_id": "c40b3e53-ac1c-3cd4-9966-5423d889c724",
                                        "glosses": [
                                            "Évoluer vers des formes plus primitives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fa4a309-cecb-4eb0-a9a5-a5ff1bef4648",
                                                "sense_id": "12bbe1a8-1d46-323b-97f4-6b99f80a9829",
                                                "text": "Qui n’avance pas régresse. (dicton)"
                                            }
                                        ]
                                    },
