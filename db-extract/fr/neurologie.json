        "fr-extract.jsonl": [
            {
                "entry_id": "c3cb6d59-a559-3832-851c-7ef791ec0b5d",
                "word": "neurologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "36adf7e7-7f99-4b0a-ab52-edc3d45ad980",
                        "entry_id": "c3cb6d59-a559-3832-851c-7ef791ec0b5d",
                        "tags": [
                            "plural"
                        ],
                        "form": "neurologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44de7f14-c871-3c6b-a2c7-2e3de13756d2",
                        "entry_id": "c3cb6d59-a559-3832-851c-7ef791ec0b5d",
                        "glosses": [
                            "Étude de l’anatomie, de la physiologie ou de la pathologie du système nerveux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd4ec3b-d361-46ee-8fbb-55bfef1d4472",
                                "sense_id": "44de7f14-c871-3c6b-a2c7-2e3de13756d2",
                                "text": "Le délire interroge les frontières des champs de la neurologie et de la psychiatrie dans la mesure où il constitue un phénomène clinique très largement transnosographique, transversal à des contextes pathologiques très divers."
                            }
                        ]
                    },
                    {
                        "sense_id": "345c4d4a-42fc-3f2a-9971-197eed79fd89",
                        "entry_id": "c3cb6d59-a559-3832-851c-7ef791ec0b5d",
                        "glosses": [
                            "Service de neurologie dans un hôpital ou une clinique."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "0d8348e0-1394-4fd5-86c3-09da70b1b937",
                                "sense_id": "345c4d4a-42fc-3f2a-9971-197eed79fd89",
                                "text": "Mais ça pourrait être pire, fait valoir le Dr Égal : dans certains services de médecine aiguë, il n’y a aucun rééducateur. Certes, mais ma mère ne devrait pas se trouver ici, elle devrait être en neurologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "136bf020-c871-42ca-ae4b-af2ad6784705",
                        "source_entry_id": "c3cb6d59-a559-3832-851c-7ef791ec0b5d",
                        "target_lang_word": "Neurologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neurologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "adeee562-bbbe-3f65-a4ac-f1a06c2c46d7",
                                        "entry_id": "b9025e12-a645-3948-b044-907813d013f2",
                                        "glosses": [
                                            "Teilgebiet der Medizin, das sich mit dem Aufbau, Physiologie und den Erkrankungen des Nervensystems beschäftigt und diese behandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc2dcf0-a1cf-4e9d-9206-b7cabbac22c0",
                                                "sense_id": "adeee562-bbbe-3f65-a4ac-f1a06c2c46d7",
                                                "text": "Die Suche nach diesem Konnektom - analog zum Genom als der Gesamtheit aller Gene eines Organismus - ist ein neuer Trend der Neurologie."
                                            },
                                            {
                                                "example_id": "f2a3c679-0b7d-44e2-bbd0-e8a65d2654bf",
                                                "sense_id": "adeee562-bbbe-3f65-a4ac-f1a06c2c46d7",
                                                "text": "„Die Neurologie entstand wie alle medizinischen Fachgebiete aus der inneren Medizin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51bd4a57-512e-3812-8bce-173c5705870c",
                                        "entry_id": "b9025e12-a645-3948-b044-907813d013f2",
                                        "glosses": [
                                            "Abteilung eines Krankenhauses/einer Klinik mit Arbeitsgebiet [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e34d8ea-5c87-46f6-a9d7-5afc54016c36",
                                                "sense_id": "51bd4a57-512e-3812-8bce-173c5705870c",
                                                "text": "„Kaum waren wir zurück in der Neurologie, kam mir die Ärztin entgegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
