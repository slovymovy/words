{
    "word_family": [
        "готовый",
        "готовить",
        "готовность",
        "подготовка",
        "приготовить",
        "заготовка",
        "изготовление"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "378215a7-fe31-362d-8ab9-2be26495ebd3",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>готовый</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всё <w>готово</w> к нашему отъезду, чемоданы уже собраны.",
                            "target_lang_translations": {
                                "en": "Everything is <w>ready</w> for our departure, the suitcases are already packed.",
                                "de": "Alles ist <w>bereit</w> für unsere Abreise, die Koffer sind schon gepackt."
                            }
                        },
                        {
                            "text": "Это блюдо почти <w>готово</w>, осталось добавить специи.",
                            "target_lang_translations": {
                                "en": "This dish is almost <w>ready</w>, just need to add spices.",
                                "de": "Dieses Gericht ist fast <w>fertig</w>, es müssen nur noch Gewürze hinzugefügt werden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "всё готово",
                        "уже готово"
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective 'ready' (neuter singular), indicating a state of preparedness.",
                        "de": "Kurzform des Adjektivs 'bereit' (Neutrum Singular), die einen Zustand der Vorbereitung anzeigt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ready",
                                "target_lang_sense_clarification": "prepared for use or action"
                            },
                            {
                                "target_lang_word": "prepared",
                                "target_lang_sense_clarification": "made ready beforehand"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bereit",
                                "target_lang_sense_clarification": "vorbereitet für eine Aktion oder Nutzung"
                            },
                            {
                                "target_lang_word": "fertig",
                                "target_lang_sense_clarification": "vollständig zubereitet oder abgeschlossen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88516019-a5f7-3686-8b45-3300bbaf4ca6",
                    "sense_definition": "О ситуации, когда дело сделано, завершено или доведено до нужного состояния.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я отправил письмо, и дело <w>готово</w>.",
                            "target_lang_translations": {
                                "en": "I sent the letter, and the deed is <w>done</w>.",
                                "de": "Ich habe den Brief abgeschickt, und die Sache ist <w>erledigt</w>."
                            }
                        },
                        {
                            "text": "Ну вот и <w>готово</w>, теперь мы можем отдыхать.",
                            "target_lang_translations": {
                                "en": "Well, that's <w>done</w>, now we can rest.",
                                "de": "Na also, <w>fertig</w>, jetzt können wir uns ausruhen."
                            }
                        }
                    ],
                    "synonyms": [
                        "сделано",
                        "завершено"
                    ],
                    "antonyms": [
                        "начато"
                    ],
                    "common_phrases": [
                        "и готово",
                        "раз и готово"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates that a task, action, or situation is completed or finished.",
                        "de": "Zeigt an, dass eine Aufgabe, Handlung oder Situation abgeschlossen oder beendet ist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "done",
                                "target_lang_sense_clarification": "completed or finished"
                            },
                            {
                                "target_lang_word": "finished",
                                "target_lang_sense_clarification": "brought to an end"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fertig",
                                "target_lang_sense_clarification": "abgeschlossen, erledigt"
                            },
                            {
                                "target_lang_word": "erledigt",
                                "target_lang_sense_clarification": "getan, vollbracht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c99ec551-9531-3f4a-ad73-551b4c09aca8",
                    "sense_definition": "Разговорное выражение, означающее внезапный конец, гибель или провал кого-либо или чего-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Один неверный шаг на скале — и всё <w>готово</w>.",
                            "target_lang_translations": {
                                "en": "One wrong step on the cliff — and it's all <w>over</w>.",
                                "de": "Ein falscher Schritt auf dem Felsen – und alles ist <w>vorbei</w>."
                            }
                        },
                        {
                            "text": "Сердце внезапно прихватило, и через минуту уже было <w>готово</w>.",
                            "target_lang_translations": {
                                "en": "The heart suddenly seized up, and in a minute it was all <w>over</w>.",
                                "de": "Das Herz setzte plötzlich aus, und nach einer Minute war es schon <w>aus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "кончено",
                        "пропало"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial expression indicating a sudden end, failure, ruin, or death.",
                        "de": "Umgangssprachlicher Ausdruck, der ein plötzliches Ende, Scheitern, Ruin oder Tod anzeigt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "all over",
                                "target_lang_sense_clarification": "completely finished or ended, often disastrously"
                            },
                            {
                                "target_lang_word": "done for",
                                "target_lang_sense_clarification": "ruined, defeated, or dying"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "vorbei",
                                "target_lang_sense_clarification": "zu Ende, gelaufen"
                            },
                            {
                                "target_lang_word": "aus",
                                "target_lang_sense_clarification": "vorbei, keine Hoffnung mehr"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}