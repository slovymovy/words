                ],
                "senses": [
                    {
                        "sense_id": "0aa16d40-917a-3116-bf7a-cb0a1fe7c2e8",
                        "entry_id": "74829bf8-7c11-3da8-873a-31d6a427f4ef",
                        "glosses": [
                            "лишать кого-либо головы, отсекая, отделяя её от туловища"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86078f6f-f222-411e-90cf-40b1b33ea5ac",
                                "sense_id": "0aa16d40-917a-3116-bf7a-cb0a1fe7c2e8",
                                "text": "Всю сельдь, выловленную в весенние и летние месяцы, с переполненными пищей желудками при уловах до 7 т в сутки перед посолом обязательно зябрить, обезглавливать или надрезать калтычки с удалением кишечника."
                            }
                        ]
                    },
                    {
                        "sense_id": "e21ddb1c-46df-38d0-a15e-93c6a5402331",
                        "entry_id": "74829bf8-7c11-3da8-873a-31d6a427f4ef",
                        "glosses": [
                            "перен. лишать главы, руководства (организацию, движение и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d6fb225-5892-46e6-96f6-5c5fd48c4252",
                        "source_entry_id": "74829bf8-7c11-3da8-873a-31d6a427f4ef",
                        "target_lang_word": "behead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "behead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87cede92-0498-3758-9906-80827accc50e",
                                        "entry_id": "eb70bb38-5e74-3a35-937d-7c87c199bbaa",
                                        "glosses": [
                                            "To deliberately remove the head of; to cut off (someone's) head."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eb94287-4347-4a7d-9ff2-87125e7a9aba",
                                                "sense_id": "87cede92-0498-3758-9906-80827accc50e",
                                                "text": "“For a while it was hand-to-hand between us,\nthen blood went curling along the currents\nand I beheaded Grendel's mother in the hall\nwith a mighty sword.”]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31d05e2b-8c67-4f12-8e1e-1085078271ba",
                        "source_entry_id": "74829bf8-7c11-3da8-873a-31d6a427f4ef",
                        "target_lang_word": "decapitate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decapitate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac1491b-fda4-3867-941f-c797391eee56",
                                        "entry_id": "33320673-46ba-353b-9a2e-5378f966c0e1",
                                        "glosses": [
                                            "To remove the head of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8b5edf-e96f-45b0-9c11-0b38257487e9",
                                                "sense_id": "6ac1491b-fda4-3867-941f-c797391eee56",
                                                "text": "One machine in which Mr. Taylor takes special pride is a salmon canner, which engulfs a whole salmon, decapitates and decaudates it, skins it, blows out its viscera, cuts it into pieces, deposits them in the can, sterilizes them […]"
                                            },
                                            {
                                                "example_id": "046f3493-0165-404c-87e4-b33cfe091f9c",
                                                "sense_id": "6ac1491b-fda4-3867-941f-c797391eee56",
                                                "text": "The hippie wasn't wearing any shoes. January in Boston and he's in sandals, standing there screaming, “Look what she did! Look what the crazy fucking bitch did!” --like it was my pleasure to risk decapitating myself by slamming through the hippiemobile."
                                            },
                                            {
                                                "example_id": "9f5eacc3-b4e6-42f7-9a4f-56e0d2543373",
                                                "sense_id": "6ac1491b-fda4-3867-941f-c797391eee56",
                                                "text": "Employee #1 was in the center of the runway, working alone approximately 300 feet from the end that led to the plane loading area and hangars. A pilot flying an airplane, Schweizer Aircraft Corporation Model G-164 B, approached the airstrip from the opposite end and landed. As the pilot taxied the plane toward the hangar, the plane's propeller struck Employee #1 in the head and decapitated him."
                                            }
                                        ]
