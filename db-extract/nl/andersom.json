                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b91a577-bd91-4bbb-bb00-52035973b5a9",
                                "sense_id": "65786295-acd1-3c86-a154-68610084a720",
                                "text": "Ze probeerde de stekker in het stopcontact te steken, maar het paste niet. Toen deed ze het andersom en lukte het wel.",
                                "translation": "She tried to plug in the plug, but it didn't fit. Then she did it the other way around and it worked.",
                                "english": "She tried to plug in the plug, but it didn't fit. Then she did it the other way around and it worked."
                            },
                            {
                                "example_id": "b1136e65-2637-46c4-8df1-a6bdd5b59981",
                                "sense_id": "65786295-acd1-3c86-a154-68610084a720",
                                "text": "Normaal gesproken loop ik eerst door het park en dan door de winkelstraat, maar vandaag deed ik het andersom om wat tijd te besparen.",
                                "translation": "Normally, I walk through the park first and then through the shopping street, but today I did it the other way around to save some time.",
                                "english": "Normally, I walk through the park first and then through the shopping street, but today I did it the other way around to save some time."
                            },
                            {
                                "example_id": "4f2f27e0-d4dc-4c82-bbe2-b0df651fa4b0",
                                "sense_id": "65786295-acd1-3c86-a154-68610084a720",
                                "text": "Hij draaide de sleutel in het slot, maar het werkte niet. Toen probeerde hij het andersom en de deur ging open.",
                                "translation": "He turned the key in the lock, but it didn't work. Then he tried it the other way around and the door opened.",
                                "english": "He turned the key in the lock, but it didn't work. Then he tried it the other way around and the door opened."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
