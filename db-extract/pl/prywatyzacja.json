                    {
                        "translation_id": "ddf848b8-2d92-4b0b-91e0-3a5cb29003b3",
                        "source_entry_id": "fe0b6fb8-b191-3738-b7e5-67b61d60ef66",
                        "source_sense_id": "501d2bfc-2733-37c2-8282-ba54b9f782fd",
                        "target_lang_word": "Privatisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Privatisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                        "entry_id": "08cd0835-e723-33e6-b532-3235b348430b",
                                        "glosses": [
                                            "Verkauf oder Übergabe der Leitung bzw. Verwaltung staatlicher Unternehmen oder Liegenschaften an Private"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa865f5e-29fd-4db1-98ad-54448ddc1202",
                                                "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                                "text": "Die Privatisierung seiner Stromwirtschaft brachte dem russischen Staat zwischen 2006 und 2008 Einnahmen von fast einer Billion Rubel."
                                            },
                                            {
                                                "example_id": "d8ab23f5-d6d3-4e8c-b24a-03b241a00b0d",
                                                "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                                "text": "„Durch die zunehmende Privatisierung wird der Einflussbereich für demokratisches Regieren kleiner, die staatliche Macht konzentriert sich auf wenige Kernaufgaben.“"
                                            },
                                            {
                                                "example_id": "3f17d211-e58f-46c6-8a32-d4a169da2def",
                                                "sense_id": "fd601090-f04a-3c97-8c63-e51decfc3d02",
                                                "text": "„Sie hat auch die Privatisierung von Flughäfen und Häfen vorangetrieben, doch statt der erwarteten 50 Milliarden Euro werden vermutlich weniger als 15 Milliarden Euro eingenommen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
