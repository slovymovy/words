                ],
                "senses": [
                    {
                        "sense_id": "16c52d37-34fd-3048-91cb-81eff6aa7758",
                        "entry_id": "490d16ac-a695-3ed2-90e1-7963398a5398",
                        "glosses": [
                            "der inhaltliche Wert einer Aussage hinsichtlich ihrer Wirkung und hinsichtlich ihrer Geltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99ff52fb-86d3-4f58-a897-37d2ca76135a",
                                "sense_id": "16c52d37-34fd-3048-91cb-81eff6aa7758",
                                "text": "„Der Außenwert einer Währung hat im Gegensatz zum Binnenwert nur eine geringe Aussagekraft über die Stabilität des Geldes.“"
                            },
                            {
                                "example_id": "760ff05d-ffef-4e76-8af2-b073cc893000",
                                "sense_id": "16c52d37-34fd-3048-91cb-81eff6aa7758",
                                "text": "„Das mächtige Kreuz vor der Kirche, von Steinmetzen aus heimischem Basalt gehauen, imponiert durch seine monumentale Größe ebenso wie durch seine Aussagekraft als Mahnmal für die Toten der beiden Weltkriege des 20. Jahrhunderts […]“"
                            },
                            {
                                "example_id": "760fb1d8-f265-460c-be28-31d24d3d9039",
                                "sense_id": "16c52d37-34fd-3048-91cb-81eff6aa7758",
                                "text": "Bei der Auswahl [zum deutschen „Wort des Jahres“] geht es nach Angaben der Gesellschaft [für deutsche Sprache] nicht um Häufigkeit, sondern um Aussagekraft."
                            },
                            {
                                "example_id": "c0c3daeb-f0b8-4e6b-b3cf-9b6979daf99e",
                                "sense_id": "16c52d37-34fd-3048-91cb-81eff6aa7758",
                                "text": "Er [Mo Shaoping] fügt hinzu, als Verteidiger müsse er selbstverständlich die Anklagepunkte gegen seine Mandantin unter die Lupe nehmen. „Auf die Stichhaltigkeit und Aussagekraft der Beweise werde ich genauestens schauen.“"
                            },
                            {
                                "example_id": "c03a6aca-bc61-47b4-b97b-63ff8e93c78e",
                                "sense_id": "16c52d37-34fd-3048-91cb-81eff6aa7758",
                                "text": "Doch für Gewerkschaften und Sozialverbände ist klar: Die hohe Zahl von arbeitenden Ruheständlern zeigt, dass die Rente für viele Menschen nicht mehr zum Leben reicht […] Die Meinungen über die Aussagekraft solcher Zahlen gehen allerdings auseinander."
                            },
                            {
                                "example_id": "6851048b-85b8-410a-a0f1-c08a76d0acf7",
                                "sense_id": "16c52d37-34fd-3048-91cb-81eff6aa7758",
                                "text": "„Die in der regionalen Geographie verwendete Grenzgürtelmethode hat bei formaler Handhabung jedoch meist wenig Aussagekraft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
