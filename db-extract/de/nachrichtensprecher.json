                                        "entry_id": "30b4a3d6-7b51-33e5-a185-cb53abf21f22",
                                        "glosses": [
                                            "Celui qui présente les invités d’une émission de télévision ou de radio et plus largement qui l’anime."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
