                        "entry_id": "af0242a9-fa16-3614-99bd-54090c0ae328",
                        "glosses": [
                            "Person, die bereits eine Erkrankung hatte, von der man erwarten kann, dass sie bei einer weiteren Erkrankung einen Risikofaktor darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668cdad1-0e5f-440c-b138-e0dc3950520c",
                                "sense_id": "a98e15e7-0c39-3985-8d58-a5d54ef19157",
                                "text": "Ältere, Vorerkrankte und Krankenhausmitarbeiter haben Vorrang bei der Impfung gegen das Coronavirus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "89e9a8fb-71d4-3cdf-9d69-6e2c8f882570",
                        "entry_id": "af0242a9-fa16-3614-99bd-54090c0ae328",
                        "glosses": [
                            "Person, die bereits eine Erkrankung hatte und deshalb gegebenenfalls ein höheres Versicherungsrisiko darstellt"
                        ],
                        "tags": [
                            "Versicherungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "88a55f88-1b38-4430-8a05-418802a01266",
