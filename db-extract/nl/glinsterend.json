                "senses": [
                    {
                        "sense_id": "c94123bb-6c96-3f27-a660-af5a081f69d6",
                        "entry_id": "05470fc6-7232-30af-a8dc-c547deeeb1ac",
                        "glosses": [
                            "van een voorwerp dat het licht helder weerkaatst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "579ccc90-c362-4b74-a637-1ae19c8fce02",
                                "sense_id": "c94123bb-6c96-3f27-a660-af5a081f69d6",
                                "text": "Van eerdere verkiezingen heb ik de gewoonte overgehouden het tv-geluid uit te zetten. Je hoort niets, maar doorziet des te meer. Het glinsterend oogwit van een satanisch-verongelijkte Krol. De doffe machteloosheid in de mondhoeken van Rutte tegenover de Groningers. Het kiespijnlachje van een gekrenkte Roos bij Jinek. Grondstof voor memes en gifjes."
                            },
                            {
                                "example_id": "cde36379-9077-4741-aa0e-f3768c050c44",
                                "sense_id": "c94123bb-6c96-3f27-a660-af5a081f69d6",
                                "text": "Hij was op zijn best als hij de oorlog zelf beschreef, met zoeklichten die als vuurvliegjes door de nacht gleden, een vliegtuig dat danste als een mooie vlinder of een glinsterende libel."
                            }
                        ]
                    }
