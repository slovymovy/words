                    {
                        "form_id": "19c9449b-0acf-4e69-8731-2338fa79387e",
                        "entry_id": "b644b5b3-c58d-3bae-b9ff-e86b69c5a6db",
                        "tags": [
                            "canonical"
                        ],
                        "form": "[A] dóórzeven"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb95fbfb-c6bc-3517-9b9a-031408b607b6",
                        "entry_id": "b644b5b3-c58d-3bae-b9ff-e86b69c5a6db",
                        "glosses": [
                            "door een zeef doen passeren"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7838c3ac-76f8-4c52-bff7-c16a6812fd6d",
                                "sense_id": "fb95fbfb-c6bc-3517-9b9a-031408b607b6",
                                "text": "Dit zijn op zijn Engels gaargekookte aardappelen, afgegoten, doorgezeefd en terug op de stoof geplaatst."
                            },
                            {
                                "example_id": "f2f563af-ffc8-4840-b460-fb47b62ac12a",
                                "sense_id": "fb95fbfb-c6bc-3517-9b9a-031408b607b6",
                                "text": "Maar we hebben 3 miljoen pond uitgetrokken voor archeologisch onderzoek en ze gaan alles goed doorzeven."
                            }
                        ]
                    },
                    {
                        "sense_id": "1db1a124-5f49-396e-875e-3382e159e322",
                        "entry_id": "b644b5b3-c58d-3bae-b9ff-e86b69c5a6db",
                        "glosses": [
                            "doorgaan met zeven"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "65dc260b-f928-41ab-919f-60498c3f4691",
                                "sense_id": "1db1a124-5f49-396e-875e-3382e159e322",
                                "text": "Zij hadden flink doorgezeefd en het karwei was bijna klaar."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
