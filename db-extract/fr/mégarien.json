                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981e3e8a-c794-4e6e-942f-370659a17eea",
                                "sense_id": "120e32e2-f9a3-3776-b1fe-d777a8269af5",
                                "text": "Avant de se soulever, les Mégariens s’étaient assuré l’appui de Corinthe, de Sikyon et d’Épidaure."
                            },
                            {
                                "example_id": "57753dd3-a976-49c0-8491-2c1ea774a5bf",
                                "sense_id": "120e32e2-f9a3-3776-b1fe-d777a8269af5",
                                "text": "Pausanias mentionne un sanctuaire des Ilithyes à Mégare ; or, Chalcédoine, d’où provient notre bas-relief, est une colonie des Mégariens, qui fondèrent cette ville vers 680 avant J.-C."
                            }
                        ]
