                    {
                        "sense_id": "241b4da2-2e2f-3cac-aee3-c356c38036c8",
                        "entry_id": "c138f0a9-2fe7-37d4-b6f6-e992c6d5e12d",
                        "glosses": [
                            "Of or pertaining to classism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cdfc17f-4c5c-4c57-b93f-de1661ea8f23",
                                "sense_id": "241b4da2-2e2f-3cac-aee3-c356c38036c8",
                                "text": "Please and thank you were not in her vocabulary, and she would sometimes say things that were “Not racist,” Neff said, “but classist.” (“What are you bitches, broke?” Anna asked her and another hotel employee.)"
                            }
                        ]
                    }
                ],
