                                "target_senses": [
                                    {
                                        "sense_id": "1b6741b3-ccff-352e-9880-f001c42ab528",
                                        "entry_id": "a8c92b12-978b-3384-be2b-1a2b401139b4",
                                        "glosses": [
                                            "A large cylindrical holdall."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3aab9eb-b37c-41a4-ab7e-f03322c49160",
                                                "sense_id": "1b6741b3-ccff-352e-9880-f001c42ab528",
                                                "text": "Besides, whilst he had been in hospital, practically the whole of his equipment had disappeared from his kitbag – including Sylvia's two pair of sheets! – and he had no money with which to get more."
                                            },
                                            {
                                                "example_id": "999b323d-2d35-4626-af81-d9efe1e16d63",
                                                "sense_id": "1b6741b3-ccff-352e-9880-f001c42ab528",
                                                "text": "Others have abandoned their vehicles and have set off back towards the Russian border on foot, lugging their weapons and kitbags, videos suggest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
