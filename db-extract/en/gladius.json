                ],
                "senses": [
                    {
                        "sense_id": "c8e3d297-21dc-38af-a8f0-61ef76b6d3f2",
                        "entry_id": "677d68cb-a2e0-3651-892c-8910ba6b9d51",
                        "glosses": [
                            "A Roman sword roughly two feet long."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c714ee27-e516-489e-babe-669f8abaaf36",
                                "sense_id": "c8e3d297-21dc-38af-a8f0-61ef76b6d3f2",
                                "text": "Finally, the Romans made the gladius—sharp, of highly-tempered steel, and strongly piercing—the first real sword (Figs. 17, 18, 19), of which only five specimens are now known to exist."
                            },
                            {
                                "example_id": "4967dc4c-44b2-4655-b571-1115a13fa82e",
                                "sense_id": "c8e3d297-21dc-38af-a8f0-61ef76b6d3f2",
                                "text": "The gladius was effective either for cutting or for thrusting and was used by legionaries and auxiliaries."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc17c261-5fe1-3a07-b05d-ef8fca7dee53",
                        "entry_id": "677d68cb-a2e0-3651-892c-8910ba6b9d51",
                        "glosses": [
                            "A pen, a hard internal bodypart of certain cephalopods, made of chitin-like material."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d0bef2-223c-4873-8bc8-0572ed5d9e84",
                                "sense_id": "cc17c261-5fe1-3a07-b05d-ef8fca7dee53",
                                "text": "From the Cretaceous of North America fossilised gladii in the enigmatic genus Tusoteuthis have been estimated to give a mantle length (body size) of 1.8m, just less than that of the giant squid’s."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e84d703a-d5e5-44ed-9a86-cbf723168640",
                        "source_entry_id": "677d68cb-a2e0-3651-892c-8910ba6b9d51",
                        "source_sense_description": "Roman sword",
                        "target_lang_word": "gladius",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gladius",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "18158a79-2060-3bf3-a2c9-a6351ddd2b57",
                                        "entry_id": "9e0cbe10-f33a-311b-9574-54d2639e5611",
                                        "glosses": [
                                            "kort tweesnijdend zwaard, zoals Romeinse voetsoldaten gebruikten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f03d532c-6099-4936-9c30-e87fb732567f",
                                                "sense_id": "18158a79-2060-3bf3-a2c9-a6351ddd2b57",
                                                "text": "De Romeinse infanterie droeg een tamelijk korte gladius, zien we."
                                            },
                                            {
                                                "example_id": "674d0927-6597-4317-8d50-710ac5d857a4",
                                                "sense_id": "18158a79-2060-3bf3-a2c9-a6351ddd2b57",
                                                "text": "Hij trok zijn gladius en richtte de punt op mijn keel."
                                            },
                                            {
                                                "example_id": "6a54e7e0-cf33-4e01-909c-8f58cad19bcb",
                                                "sense_id": "18158a79-2060-3bf3-a2c9-a6351ddd2b57",
                                                "text": "De vondsten van zowel aanvals- als verdedigingswapens (gladius, dolk, pilum aan de ene en helm, pantser en schild aan de andere kant) bewijzen de aanwezigheid van zwaarbewapend voetvolk, dus van Romeinse legioensoldaten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be4e02a7-6034-35ea-b621-5ea150cfdeb1",
                                        "entry_id": "9e0cbe10-f33a-311b-9574-54d2639e5611",
                                        "glosses": [
                                            "veervormige inwendige schelp van inktvissen, opgebouwd uit chitine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e195da1-c4be-4288-b097-0b2923b2fe2b",
                                                "sense_id": "be4e02a7-6034-35ea-b621-5ea150cfdeb1",
                                                "text": "Ik geloof mijn ogen niet ais, 100 m verderop, de bijna intacte gladius van 32 cm daar zo maar op het strand ligt. Ter verduidelijking : de gladius van een pijlinktvis ziet er uit ais een langwerpige plastiekachtige veer, is hoomachtig, kleurloos en doorzichtig, heeft een versterkende diepe nerf (met 3 ribben) die geleidelijk wat verbreedt naar de kopzijde toe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
