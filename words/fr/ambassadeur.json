    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "010cb610-49b3-3308-9cd6-f6a4ed344cf2",
                    "sense_definition": "Diplomate du plus haut rang représentant son pays auprès d'un État étranger ou d'une organisation internationale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouvel <w>ambassadeur</w> a présenté ses lettres de créance lors d'une cérémonie officielle."
                        },
                        {
                            "text": "L'<w>ambassadeur</w> de France a organisé une grande réception pour célébrer la fête nationale."
                        }
                    ],
                    "synonyms": [
                        "haut-commissaire",
                        "plénipotentiaire"
                    ],
                    "common_phrases": [
                        "ambassadeur extraordinaire",
                        "ambassadeur plénipotentiaire"
                    ]
                },
                {
                    "sense_id": "9e52a07b-8580-3143-bbdf-9ea4e93ef7a2",
                    "sense_definition": "Personne chargée de transmettre un message ou de promouvoir et représenter une cause, une marque ou une région.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette célèbre athlète a été choisie comme <w>ambassadrice</w> par une grande marque de sport."
                        },
                        {
                            "text": "Il se considère comme un véritable <w>ambassadeur</w> de la gastronomie et des produits de son terroir."
                        }
                    ],
                    "common_phrases": [
                        "ambassadeur de bonne volonté",
                        "ambassadeur de marque"
                    ]
                },
                {
                    "sense_id": "308f00b3-82d5-3af2-b7fa-bc800a5589a4",
                    "sense_definition": "Émissaire ou membre envoyé dans le cadre d'une mission diplomatique temporaire auprès d'un souverain étranger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "diplomatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi envoya plusieurs <w>ambassadeurs</w> pour négocier un traité de paix avec le pays voisin."
                        },
                        {
                            "text": "Ces <w>ambassadeurs</w> revinrent à la cour sans avoir obtenu les concessions qu'ils espéraient."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Sens historique d'envoyé temporaire"
                        }
                    ]
                },
                {
                    "sense_id": "ef69330f-2490-3a48-8a39-f2f1f9ea86ba",
                    "sense_definition": "Pâtisserie d'origine lyonnaise traditionnellement composée de génoise et garnie de crème.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "patisserie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pâtissier réputé prépare chaque dimanche un délicieux <w>ambassadeur</w> garni de crème fraîche."
                        },
                        {
                            "text": "À la fin du repas traditionnel nous avons partagé un <w>ambassadeur</w> bien moelleux."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Spécialité lyonnaise"
                        }
                    ]
                }
            ]
        }
