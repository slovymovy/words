                    }
                ],
                "senses": [
                    {
                        "sense_id": "c20c1b1d-632f-38d4-affa-a5815755413d",
                        "entry_id": "94c4de3f-9f20-3b58-98b4-5f78ebced593",
                        "glosses": [
                            "буддийское или индуистское сооружение культового характера в виде многоярусной островерхой башни или павильона"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b952d978-dbb3-4f4b-bc09-f61c42874190",
                                "sense_id": "c20c1b1d-632f-38d4-affa-a5815755413d",
                                "text": "Во времена Махмуда при этой пагоде состояло 2000 жрецов, 500 танцовщиц (научей), 300 священных свирельщиков и 300 брадобреев."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6be1dfd-172d-4e4a-8401-258439f0ed3b",
                        "source_entry_id": "94c4de3f-9f20-3b58-98b4-5f78ebced593",
                        "source_sense_id": "c20c1b1d-632f-38d4-affa-a5815755413d",
                        "target_lang_word": "pagoda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pagoda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3cb0a33-5c51-393f-8190-872a3452c016",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "A religious building in South and Southeast Asia, especially a multi-storey tower erected as a Hindu or Buddhist temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d28cb7-90cf-46cf-a61d-154f5dc2d4d1",
                                                "sense_id": "d3cb0a33-5c51-393f-8190-872a3452c016",
                                                "text": "On the journey southwards over the flat, fertile plains, paddy fields stretched away on each side of the line, and the landscape was broken only by wooden villages and stately pagodas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c15222d-5579-3c1f-87a8-873973f2629d",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "An image or carving of a god in South and Southeast Asia; an idol."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f6588e5-4d53-39d8-a7b8-e67b68c30dae",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "A unit of currency, a coin made of gold or half gold, issued by various dynasties and colonial powers in southern India."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d48c9ba-a7ca-44ae-839f-1a6341298bca",
                                                "sense_id": "9f6588e5-4d53-39d8-a7b8-e67b68c30dae",
                                                "text": "[T]he Mahrattas having offered Alimerdy Khan his liberty for a lak of Pagodas; he does in the Nabob's name desire that the Governor of Madras would receive jewels and money to that amount into his custody, […]"
                                            },
                                            {
                                                "example_id": "88979989-6fbf-49fd-8823-405d0a1246bc",
                                                "sense_id": "9f6588e5-4d53-39d8-a7b8-e67b68c30dae",
                                                "text": "I, in about two hours, notwithstanding the utmost caution, found myself minus upwards of six hundred pagodas […] ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f130cc5d-5c41-3686-9daa-5d3f4a284097",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "An ornamental structure imitating the design of the religious building, erected in a park or garden."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b5a4eb7-e459-3150-9d7a-f5917ebc32e8",
                                        "entry_id": "f5ac3937-444a-37d8-9aab-0e757c41822f",
                                        "glosses": [
                                            "A pagoda sleeve."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f676bbd-95b9-4eec-934b-ca716b455882",
                        "source_entry_id": "94c4de3f-9f20-3b58-98b4-5f78ebced593",
                        "source_sense_id": "c20c1b1d-632f-38d4-affa-a5815755413d",
                        "target_lang_word": "寶塔",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d39e2bdb-8a71-4a42-b8ff-b55bbb4f3f82",
                        "source_entry_id": "94c4de3f-9f20-3b58-98b4-5f78ebced593",
                        "source_sense_id": "c20c1b1d-632f-38d4-affa-a5815755413d",
                        "target_lang_word": "Pagode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pagode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e323dacd-0387-3c6d-8cbd-10e4af66f7c0",
                                        "entry_id": "efee04b8-0893-3f85-b652-5dbb5bb67a05",
                                        "glosses": [
                                            "buddhistisches Bauwerk, Tempel-Anlage"
                                        ],
                                        "tags": [
                                            "Ostasien",
                                            "Vietnam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccbefad0-48a6-4bdb-a41d-03fd30f2b55d",
                                                "sense_id": "e323dacd-0387-3c6d-8cbd-10e4af66f7c0",
                                                "text": "Die meisten Pagoden findet man in China und Japan."
                                            },
                                            {
                                                "example_id": "3d43618a-6e20-4903-998f-649493779d84",
                                                "sense_id": "e323dacd-0387-3c6d-8cbd-10e4af66f7c0",
                                                "text": "„Die Linde hatte es bisher nicht zur Geltung kommen lassen; jetzt wurde es durch die Pagode begünstigt, denn diese stand genau gegenüber der Scheune, deren Giebel über den Laubengang hinwegragte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b15cc879-c875-40fb-8158-634ee2ca13bd",
                        "source_entry_id": "94c4de3f-9f20-3b58-98b4-5f78ebced593",
                        "source_sense_id": "c20c1b1d-632f-38d4-affa-a5815755413d",
                        "target_lang_word": "pagode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pagode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b193a12b-deef-39d6-91cd-2ea4e53dba7c",
                                        "entry_id": "4e8cb696-8d76-35b0-a038-2aa29f48b7fa",
                                        "glosses": [
                                            "Temple en forme de pavillon, consacré au culte des dieux en Asie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9b4354-117e-4da8-a0a7-6f15348fffb8",
                                                "sense_id": "b193a12b-deef-39d6-91cd-2ea4e53dba7c",
                                                "text": "Ce que je fais là, je me propose de le refaire à Pékin dans une quinzaine de jours. Mais, en attendant les pagodes et les yamens du Céleste-Empire, voici ce que Tiflis offre à mes regards : […]."
                                            },
                                            {
                                                "example_id": "b805e9d5-c18f-49f6-8f21-7dbe04eb7503",
                                                "sense_id": "b193a12b-deef-39d6-91cd-2ea4e53dba7c",
                                                "text": "Sur ce papier, il y a le signe qui vous permettra d'entrer en contact… demain soir… à la pagode du tigre, colonel Lychee."
                                            },
                                            {
                                                "example_id": "21826dc9-ad2d-4761-9ed2-5cffeac2c222",
                                                "sense_id": "b193a12b-deef-39d6-91cd-2ea4e53dba7c",
                                                "text": "A Chanteloup, nous avons fait l’ascension de la ravissante pagode qui est une grande aiguille ajourée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ac34c00-b007-388c-bf03-f6fbbd50bd96",
                                        "entry_id": "4e8cb696-8d76-35b0-a038-2aa29f48b7fa",
                                        "glosses": [
                                            "Le dieu qu’on adore dans un temple de ce genre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ffa0aac-78b0-4f37-918b-31403da01fbc",
                                                "sense_id": "2ac34c00-b007-388c-bf03-f6fbbd50bd96",
                                                "text": "Une pagode d’or. Une petite pagode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77be300c-df97-3279-941b-b2d25146eccd",
                                        "entry_id": "4e8cb696-8d76-35b0-a038-2aa29f48b7fa",
                                        "glosses": [
                                            "Petites figures, ordinairement de porcelaine, et qui souvent ont la tête mobile, synonyme : magot."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162956d8-c26a-4c95-a93a-18f25f8cfbed",
                                                "sense_id": "77be300c-df97-3279-941b-b2d25146eccd",
                                                "text": "Il a des pagodes sur sa cheminée. Il remue la tête comme une pagode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92e2178-7b38-3f0f-a8f2-1fa8aec6e441",
                                        "entry_id": "4e8cb696-8d76-35b0-a038-2aa29f48b7fa",
                                        "glosses": [
                                            "Monnaie d’or frappée en Inde par diverses autorités indiennes ou européennes jusqu’au xixᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf0ecaed-c75a-4ec9-a267-f4e4124b80e9",
                                                "sense_id": "a92e2178-7b38-3f0f-a8f2-1fa8aec6e441",
                                                "text": "Les pagodes, monnaie^([sic]) d’or qui se fabriquent à Pondichéri, sont au titre de huit tocques et demie, selon le style malabare qui correspond à 85 tocques de la Chine, …"
                                            },
                                            {
                                                "example_id": "1c09b18c-49c7-4391-b10d-a5bf0bd189b2",
                                                "sense_id": "a92e2178-7b38-3f0f-a8f2-1fa8aec6e441",
                                                "text": "Les monnaies réelles d’or sont la pagode star ou courante ; celles d’argent la roupie arcot."
                                            }
                                        ]
