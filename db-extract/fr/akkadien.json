            {
                "entry_id": "a36e605f-03a7-374e-8d96-016cb3c56e65",
                "word": "akkadien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "284f69f7-2a78-4a00-9bd9-48f7e36ead1a",
                        "entry_id": "a36e605f-03a7-374e-8d96-016cb3c56e65",
                        "tags": [],
                        "form": "accadien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d0733e3-293e-3351-9bb9-ad544a9a6dea",
                        "entry_id": "a36e605f-03a7-374e-8d96-016cb3c56e65",
                        "glosses": [
                            "Langue anciennement parlée en Akkad."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa10b69d-920f-42f1-b732-1f4ee6f5e512",
                                "sense_id": "3d0733e3-293e-3351-9bb9-ad544a9a6dea",
                                "text": "L’inscription est ici rédigée en akkadien, langue qui utilise des caractères cunéiformes syllabiques."
                            },
                            {
                                "example_id": "07e1478c-fc3f-47fc-bd72-3198556e7a44",
                                "sense_id": "3d0733e3-293e-3351-9bb9-ad544a9a6dea",
                                "text": "Certains donnent l’idéogramme sumérien, sa transcription phonétique en akkadien, sa traduction akkadienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85f0dc1d-20d0-4be0-a497-df2eecb15048",
                        "source_entry_id": "a36e605f-03a7-374e-8d96-016cb3c56e65",
                        "source_sense_id": "3d0733e3-293e-3351-9bb9-ad544a9a6dea",
                        "target_lang_word": "Akkadisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkadisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee711c7-c8d1-30fd-974f-5463daed97a5",
                                        "entry_id": "be5e655a-a163-34a2-925b-9930d9a8bdfa",
                                        "glosses": [
                                            "eine semitische Sprache, die aus der Zeit von etwa 2700 v.Chr. bis etwa 250 n.Chr. in zahlreichen Texten schriftlich überliefert ist; hat die Dialekte Assyrisch, Babylonisch, Eblaitisch"
                                        ],
                                        "tags": [
                                            "Sprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0312354b-f433-4a39-abbb-5704f1f92d4e",
                                                "sense_id": "2ee711c7-c8d1-30fd-974f-5463daed97a5",
                                                "text": "Akkadisch war in seiner Blütezeit die Lingua franca im ganzen Alten Orient."
                                            },
                                            {
                                                "example_id": "6138ddbc-570b-4619-a1de-20eb9864b9fb",
                                                "sense_id": "2ee711c7-c8d1-30fd-974f-5463daed97a5",
                                                "text": "Das Akkadisch des 25. Jahrhunderts unterschied sich deutlich von den späteren Sprachstufen."
                                            },
                                            {
                                                "example_id": "505090a8-74f6-49c9-8de8-266692f7bdbb",
                                                "sense_id": "2ee711c7-c8d1-30fd-974f-5463daed97a5",
                                                "text": "Das Akkadische verfügt über eine sehr komplexe Verbmorphologie."
                                            },
                                            {
                                                "example_id": "d88cb702-fd9a-402a-b64f-e7ccec865c28",
                                                "sense_id": "2ee711c7-c8d1-30fd-974f-5463daed97a5",
                                                "text": "„Außerdem hat ein aufgeweckter Schreiber in Nippur eine Art von Vokabular hinterlassen, in welchem kassitische Götter- und Menschennamen sowie einige ausgewählte Wörter ins Akkadische übersetzt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
