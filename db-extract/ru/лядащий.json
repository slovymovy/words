                ],
                "senses": [
                    {
                        "sense_id": "f4c618a8-314a-3183-9b75-4643053fd21d",
                        "entry_id": "0d0b1cca-cc41-38c2-a61d-ecb84dba571b",
                        "glosses": [
                            "прост., пренебр. слабосильный, исхудалый, тощий, тщедушный, невзрачный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99143aa5-53b6-4a61-8826-580cb242a9d3",
                                "sense_id": "f4c618a8-314a-3183-9b75-4643053fd21d",
                                "text": "От него отказались, как от человека ни на какую работу не годного ― «лядащего», как говорится у нас в Орле."
                            },
                            {
                                "example_id": "3a6ae660-7331-444f-b8a0-dad24d7e9f9a",
                                "sense_id": "f4c618a8-314a-3183-9b75-4643053fd21d",
                                "text": "Кругом в толпе тоже смеются, да и впрямь, как не смеяться: этака лядащая кобылёнка да таку тягость вскачь везти будет!"
                            }
                        ]
                    }
                ],
