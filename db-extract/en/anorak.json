    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                "word": "anorak",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fc99682f-f4b3-4e0e-8609-d48f7f5feaeb",
                        "entry_id": "241cf256-c8fe-3c49-87b6-bbc6831c24a4",
                        "tags": [
