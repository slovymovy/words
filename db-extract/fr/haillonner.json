                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "26411a86-870b-3fe1-9bbb-e2b87cf66a03",
                        "entry_id": "bc635d7c-ebfd-3728-ac31-160342ee1bcc",
                        "glosses": [
                            "Réduire en haillons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06232c44-1661-4984-b7ab-f3e5bdfef891",
                                "sense_id": "26411a86-870b-3fe1-9bbb-e2b87cf66a03",
                                "text": "Je regarde venir ! répond l’Écureuil en achevant de haillonner son bloudjine au tronc rugueux de l’arbre."
                            },
                            {
                                "example_id": "b3192dd4-ed5e-4c3e-8f65-bbc5dcc642ef",
                                "sense_id": "26411a86-870b-3fe1-9bbb-e2b87cf66a03",
                                "text": "Avant cette date, engageons-nous de clochardiser et de haillonner sur le continent le drapeau français, le Franc CFA, les produits français (T…., B……, C…..et autres)."
                            }
                        ]
                    },
                    {
                        "sense_id": "57576123-efa2-31f7-bdb7-564edad56556",
                        "entry_id": "bc635d7c-ebfd-3728-ac31-160342ee1bcc",
                        "glosses": [
                            "Avoir une apparence de haillons."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "628c1cae-c6e6-4221-b31b-90e337066606",
                                "sense_id": "57576123-efa2-31f7-bdb7-564edad56556",
                                "text": "D’autres vols de corneilles et de corbeaux s’étaient de ce temps levés des endroits où ils s’acagnardaient, et s’approchaient en haillonnant."
                            }
                        ]
                    },
                    {
                        "sense_id": "25282e58-9659-3403-8b2e-0a7f2087ded4",
                        "entry_id": "bc635d7c-ebfd-3728-ac31-160342ee1bcc",
                        "glosses": [
                            "Posséder sexuellement, à la va-vite."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f378d930-d38a-435e-bd6a-a19f9090f8ad",
                                "sense_id": "25282e58-9659-3403-8b2e-0a7f2087ded4",
                                "text": "Comment se dit « relation sexuelle précipitée » en argot ? Biscoter, baiser sur le pouce, baiser en lapin, artiller, haillonner…"
                            }
                        ]
                    }
