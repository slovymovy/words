                "senses": [
                    {
                        "sense_id": "9a331795-8fb3-3562-9c28-09eed87d208d",
                        "entry_id": "3c360e72-3afe-3443-927a-03b2b673cbb7",
                        "glosses": [
                            "Text (Blatt), der einen bestimmten Standard, eine bestimmte Spezifikation (Norm) beschreibt"
                        ],
                        "tags": [
                            "Deutschen Institut für Normung (DIN)"
                        ],
                        "examples": [
                            {
                                "example_id": "077acbaa-e92b-41fb-8d54-51dcc3ce6ab0",
                                "sense_id": "9a331795-8fb3-3562-9c28-09eed87d208d",
                                "text": "„Die Bedingungen, die zur Messung der Farbvalenz erfüllt werden müssen, sind auf Grund internationaler Vereinbarung im Normblatt DIN 5033: „Farbmessung“ zusammengestellt.“"
                            },
                            {
                                "example_id": "0a1b58ee-a333-46c6-81ce-b118bb9cfbeb",
                                "sense_id": "9a331795-8fb3-3562-9c28-09eed87d208d",
                                "text": "„Die Normblätter enthalten die Leistungsangaben für offene Gleichstromgeneratoren, und zwar das Normblatt 2050 für Drehzahlen, welche sich aus den für die Motoren festgelegten Ausführungen ergeben und als Normblatt 2051 für Drehzahlen, wie sie […].“"
                            }
                        ],
