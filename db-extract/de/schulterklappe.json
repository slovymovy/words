                "senses": [
                    {
                        "sense_id": "8e91f717-2b45-34ca-8a18-0b96d761b014",
                        "entry_id": "63ae0d02-02b3-3e92-88f1-0e8c5b04b70e",
                        "glosses": [
                            "eine auf den Schultern von Uniformen angebrachte Tuchlasche zur Kennzeichnung von Dienstgrad, Truppengattung/Waffengattung, Truppenteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c15947a-6c71-4dc2-8031-d78d26c9231c",
                                "sense_id": "8e91f717-2b45-34ca-8a18-0b96d761b014",
                                "text": "„An den Uniformen trugen die Musiker der NVA auf den Schulterklappen zusätzlich zu den Dientsgraden als Kennzeichen eine Lyra.“"
                            },
                            {
                                "example_id": "31939938-722b-4729-9b8f-5d22e2f89f8c",
                                "sense_id": "8e91f717-2b45-34ca-8a18-0b96d761b014",
                                "text": "„Auf Bildern ist er immer in Uniform, mit Orden, Schulterklappen und Schärpe zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
