                        "sense_id": "c34f42e9-1b87-37af-b4c3-cf67ca823274",
                        "entry_id": "6dd80a7a-567b-3406-b43a-66fdf9612722",
                        "glosses": [
                            "окончательно, совершенно (в контексте «разбить врага»)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e48954-6269-4af8-a92b-f2f0485aacab",
                                "sense_id": "c34f42e9-1b87-37af-b4c3-cf67ca823274",
                                "text": "В решающей битве при Лас-Навас-де-Толоса в 1212 году арабы и союзные им полчища берберов и негров были наголову разбиты испанцами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5254bf6-c2b8-4b98-9b59-e3fccd5e8e5f",
                        "source_entry_id": "6dd80a7a-567b-3406-b43a-66fdf9612722",
                        "source_sense_id": "c34f42e9-1b87-37af-b4c3-cf67ca823274",
                        "target_lang_word": "completely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "completely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "In a complete manner; thoroughly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef0e07a-86f1-4c4b-b8ea-dd67121cec32",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Please completely fill in the box for your answer, using a number 2 pencil."
                                            },
                                            {
                                                "example_id": "bc5853fb-b049-4275-b1c1-b1490997c41b",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "I will have completely finished my degree by next July, when my thesis has been properly edited."
                                            },
                                            {
                                                "example_id": "d43b1f8e-e132-46b0-8d56-f64952f8e530",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "It should not have been omitted that previous to completely stripping the body of the leviathan, he was beheaded."
                                            },
                                            {
                                                "example_id": "c3c37d13-9a2d-47c4-a772-ceb61c44a5bd",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "She completely abandoned her Tuesdays at home, and did not return the visits of those who had called upon her."
                                            },
                                            {
                                                "example_id": "fa3892a0-d491-4f94-a747-371556908c5e",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Lieutenant (junior grade) KERRY immediately maneuvered his craft through several strafing runs which completely silenced the enemy."
                                            },
                                            {
                                                "example_id": "17a3b433-3441-46b0-84e9-784d726ef42a",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "To the fullest extent or degree; totally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59585da3-49e8-4d49-8f1c-d93feb4eb04b",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "He is completely mad."
                                            },
                                            {
                                                "example_id": "3b0f2f43-1c7d-47fa-8130-7d1202d6bddd",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town. I was completely mystified at such an unusual proceeding."
                                            },
                                            {
                                                "example_id": "42630122-febf-46fe-af3e-0d94e0c8b1d7",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "Our future may lie beyond our vision, but it is not completely beyond our control."
                                            },
                                            {
                                                "example_id": "f9ba36d2-d4c2-47e3-a0f1-dd6ae8191e76",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "1975, Helen Schucman, A Course in Miracles/Workbook for Students, Lesson 75: The light has come,\nKeep a completely open mind, washed of all past ideas and clean of every concept you have made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3d1c392-0447-4f6b-9797-675852bba937",
                        "source_entry_id": "6dd80a7a-567b-3406-b43a-66fdf9612722",
                        "source_sense_id": "c34f42e9-1b87-37af-b4c3-cf67ca823274",
                        "target_lang_word": "utterly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utterly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                        "entry_id": "7ecf6a8f-bd7a-30f3-adb2-6cfd72e17686",
                                        "glosses": [
                                            "Completely; entirely; to the fullest extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f6137b-8541-4050-a535-f0463471a9ca",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "Well, now we are utterly lost."
                                            },
                                            {
                                                "example_id": "00e43d21-bdff-44c8-8dfe-080f73555d69",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "I have failed you utterly."
                                            },
                                            {
                                                "example_id": "2a847c47-db00-4c97-ad67-b0d9f2d1def9",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "An utterly emphatic 5-0 victory was ultimately capped by two wonder strikes in the last two minutes from Aston Villa midfielder Gary Gardner. Before that, England had utterly dominated to take another purposeful stride towards the 2013 European Championship in Israel. They have already established a five-point buffer at the top of Group Eight."
                                            },
                                            {
                                                "example_id": "609a0305-08a3-4f1c-aaaa-3990cbb9f24d",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "Scott, somewhat stunned and now worried that everybody might have opened fire at the U.S. destroyers (he presumably missed Laffey and Farenholt merrily blazing away with their own guns into the darkness), ordered all firing to cease after a couple of minutes. Helena, along with Boise, was already several hundred shells lighter, and both Boise and San Francisco herself actually kept firing, as their captains were utterly sure about their targets; San Francisco's captain was very apologetic as he overruled Admiral Scott."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86f6297-7881-477d-8a77-67e4b572d167",
                        "source_entry_id": "6dd80a7a-567b-3406-b43a-66fdf9612722",
                        "source_sense_id": "c34f42e9-1b87-37af-b4c3-cf67ca823274",
