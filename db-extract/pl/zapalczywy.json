                ],
                "senses": [
                    {
                        "sense_id": "afe6b583-b8fe-313e-8c36-f40e1af4c3e9",
                        "entry_id": "b1e38eca-1ac9-319a-b3b2-43384c3e0b6f",
                        "glosses": [
                            "łatwo unoszący się gniewem"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "417aa444-a93d-4212-8270-1c5d782dcce3",
                                "sense_id": "afe6b583-b8fe-313e-8c36-f40e1af4c3e9",
                                "text": "Po zapalczywym świegocie ptactwa na drzewach nastąpiło tłumliwe ćwierkanie świerszczy w trawach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e42e66b9-8284-41af-9a2b-17b82c16f0ab",
                        "source_entry_id": "b1e38eca-1ac9-319a-b3b2-43384c3e0b6f",
                        "source_sense_id": "afe6b583-b8fe-313e-8c36-f40e1af4c3e9",
                        "target_lang_word": "запальчивый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "запальчивый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "74d12007-6cac-35cf-a940-0f6a90ac6938",
                                        "entry_id": "ca87676e-e6aa-3a48-8ed4-c46ec13d0d59",
                                        "glosses": [
                                            "легко, сразу приходящий в гнев, раздражение; вспыльчивый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1fdbde-e6cf-411a-a909-7f20e877cd56",
                                                "sense_id": "74d12007-6cac-35cf-a940-0f6a90ac6938",
                                                "text": "Я знаю, что у вас говорят, будто я злой и запальчивый человек; правда, я гневлив и зол, не хвалю себя за это."
                                            },
                                            {
                                                "example_id": "68cb8936-199d-4ee3-804e-fe85e82d6e55",
                                                "sense_id": "74d12007-6cac-35cf-a940-0f6a90ac6938",
                                                "text": "Святые так запальчивы, они так горячатся… но в этой горячности ― их поэтичность, и если б не было этого негодования, то не было бы и самой поэтической струи в «Рае»…"
                                            },
                                            {
                                                "example_id": "24b5b747-d5f5-4d74-9f3d-8da56489390c",
                                                "sense_id": "74d12007-6cac-35cf-a940-0f6a90ac6938",
                                                "text": "Наша дипломатия стала нервной, мнительной, запальчивой и судорожной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fefaff6-152f-3cac-a306-5c0650c1e080",
                                        "entry_id": "ca87676e-e6aa-3a48-8ed4-c46ec13d0d59",
                                        "glosses": [
                                            "свидетельствующий об излишней горячности, выражающий гнев, раздражение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0479f3-564b-4355-8c56-a792dbb3f778",
                                                "sense_id": "1fefaff6-152f-3cac-a306-5c0650c1e080",
                                                "text": "До сих пор слышу его хриплый крик, его беспрестанную и запальчивую фразу: — Но неужели ты, дядя, серьезно думаешь, что я способен на такую подлость?!"
                                            },
                                            {
                                                "example_id": "d1d74822-5144-48fa-bee9-54fd944d76d2",
                                                "sense_id": "1fefaff6-152f-3cac-a306-5c0650c1e080",
                                                "text": "Голос его резкий, запальчивый и неприятный — кроет всю площадь."
                                            },
                                            {
                                                "example_id": "6dfe2549-4283-413a-8bbd-418675235c12",
                                                "sense_id": "1fefaff6-152f-3cac-a306-5c0650c1e080",
                                                "text": "― Но вы же обязаны выкормить их! ― возмутился я, чувствуя, как кровь стучит у меня в висках. Рейс улыбнулась мне, как несмышлёнышу. Видно было, что мой запальчивый тон её нисколько не задел."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5adb4deb-2634-3bf2-9113-f406f0ac5336",
                                        "entry_id": "ca87676e-e6aa-3a48-8ed4-c46ec13d0d59",
                                        "glosses": [
                                            "страстный, пылкий, горячий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051aef15-407c-471b-b8af-c5db239ea892",
                                                "sense_id": "5adb4deb-2634-3bf2-9113-f406f0ac5336",
                                                "text": "Рассудок говорил о безрассудной его дерзости, советовал повыждать для более верного успеха; но известен закон, что самые запальчивые и безрассудные люди в любви ― это старики и молодые юноши."
                                            },
                                            {
                                                "example_id": "788fde24-de3c-4676-9672-fd54a875e9e4",
                                                "sense_id": "5adb4deb-2634-3bf2-9113-f406f0ac5336",
                                                "text": "Никогда впоследствии не говорил он так убедительно и зло о любимом предмете; многие классические страницы его последующих книг отлились именно тогда, в разбеге его запальчивого вдохновенья."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c95c2f12-8ea1-4366-a998-181fb999450a",
                        "source_entry_id": "b1e38eca-1ac9-319a-b3b2-43384c3e0b6f",
