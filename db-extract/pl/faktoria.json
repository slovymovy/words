                    },
                    {
                        "sense_id": "932fb1df-55e1-38da-8a2b-d2c5f08946d7",
                        "entry_id": "d1a7788d-1fb4-3c50-b78c-3db141657c5e",
                        "glosses": [
                            "placówka handlowa położona w słabo zaludnionym terenie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
