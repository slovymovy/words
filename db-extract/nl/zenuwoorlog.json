                "senses": [
                    {
                        "sense_id": "b944aa8d-a122-379e-9f87-76f8aa0e913e",
                        "entry_id": "9954d0bf-479b-37c8-bccc-6305cd39f21c",
                        "glosses": [
                            "strijd die — zonder fysiek geweld — gevoerd wordt met als doel om de moraal van de vijand aan te tasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d819e9df-48fd-49ca-8f53-ffff5fdb8683",
                                "sense_id": "b944aa8d-a122-379e-9f87-76f8aa0e913e",
                                "text": "Stalin vreesde voor een zenuwoorlog toen de Verenigde Staten over de atoombom beschikten; hij veronderstelde dat Amerika de bom zou gebruiken om de Sovjet-Unie te intimideren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16fe2ae1-7c4a-41a5-8363-bad9eb2edd6a",
                        "source_entry_id": "9954d0bf-479b-37c8-bccc-6305cd39f21c",
                        "source_sense_id": "b944aa8d-a122-379e-9f87-76f8aa0e913e",
                        "target_lang_word": "war of nerves",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "war of nerves",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b7c3c64-0739-3eb3-872f-0fcc40cf0412",
                                        "entry_id": "4b6a401c-f4aa-316c-b725-8d4a092cb4e1",
                                        "glosses": [
                                            "Warfare characterized by psychological manipulation, involving tactics intended to demoralize, frighten, and unnerve opponents in order to prompt surrender."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa3d1caf-fdf8-4008-83d0-f81cb6adec67",
                                                "sense_id": "8b7c3c64-0739-3eb3-872f-0fcc40cf0412",
                                                "text": "Our brave Ottoman soldiers are not easily frightened by noise, owing to their splendid nerves—and this is a war of nerves, a war in which strong nerves mean victory."
                                            },
                                            {
                                                "example_id": "e4284c62-2062-44ec-b95b-271c211e3940",
                                                "sense_id": "8b7c3c64-0739-3eb3-872f-0fcc40cf0412",
                                                "text": "In the future, war will not merely be one of men and machines, it will be a war of wills and a war of nerves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57627ac0-7b3c-39f4-9723-cfb38c229f23",
                                        "entry_id": "4b6a401c-f4aa-316c-b725-8d4a092cb4e1",
                                        "glosses": [
                                            "A situation in which opposed parties refrain from direct conflict but maintain a tense, contentious relationship in which each uses annoyances or intimidating psychological tactics to attempt to dishearten and unnerve the other."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f121f479-c4f0-43cd-9262-3d4d36d3dafe",
                                                "sense_id": "57627ac0-7b3c-39f4-9723-cfb38c229f23",
                                                "text": "A united steel industry appeared to have emerged the victor today in a war of nerves to raise prices on some of its products in the face of White House pressure to hold the price line."
                                            },
                                            {
                                                "example_id": "9d806120-f696-4227-bc4c-0315de73964b",
                                                "sense_id": "57627ac0-7b3c-39f4-9723-cfb38c229f23",
                                                "text": "14 of America's best chess players are wielding kings, queens and their chessboard servants in a silent but brutal war. . . . \"It's a mental war, it's a war of nerves, of logic, or reasoning, of being a good fighter,\" said Walter Browne."
                                            },
                                            {
                                                "example_id": "b2de0ff6-b755-4bd1-bd65-8bd352666e8c",
                                                "sense_id": "57627ac0-7b3c-39f4-9723-cfb38c229f23",
                                                "text": "\"We assume that a dangerous brinkmanship, a war of nerves, is under way, but it will not grow into a hot war,\" the official told Tass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
