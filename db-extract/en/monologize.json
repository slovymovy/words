                "senses": [
                    {
                        "sense_id": "b730c35a-e7b1-3ce6-a39a-a87a614dca16",
                        "entry_id": "a9523744-3268-3f44-9823-a45b39f8c410",
                        "glosses": [
                            "ein Selbstgespräch führen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4af84f8f-7d3e-403b-973f-8c07211e42f2",
                        "source_entry_id": "a9523744-3268-3f44-9823-a45b39f8c410",
                        "source_sense_id": "b730c35a-e7b1-3ce6-a39a-a87a614dca16",
                        "source_sense_description": "ein Selbstgespräch führen",
                        "target_lang_word": "Selbstgespräch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstgespräch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                        "entry_id": "9d25c926-bca7-34d2-a3e8-53b5fe2fedda",
                                        "glosses": [
                                            "ein Gespräch mit sich selbst; Gespräch, das sich an keinen anderen Gesprächspartner richtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06284d4-bdfb-42d2-975b-1135dd8b26b4",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "Er führte ein Selbstgespräch."
                                            },
                                            {
                                                "example_id": "36ddb1d2-fcdd-40fc-8973-701425b585f5",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Selbstgespräche können natürlich auch still geführt werden, so daß Sie keinen Laut äußern und ein Kassettenrekorder entsprechend auch nichts aufzeichnen kann.“"
                                            },
                                            {
                                                "example_id": "cf18a6f5-7f4d-464f-974b-fc987952210f",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Unter solchem Selbstgespräche trat er vom Fenster zurück und ließ alles, was der Tag gebracht, noch einmal an seiner Seele vorüberziehen.“"
                                            },
                                            {
                                                "example_id": "84cc47d2-993b-4d1a-a633-d2851be55c82",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Aber sie schien keine Antwort zu erwarten, sie sank teilnahmslos zurück und bewegte die Lippen in lautlosem Selbstgespräch.“"
                                            },
                                            {
                                                "example_id": "bc026b33-35f8-468f-86a1-aaaa90906753",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Dem Selbstgespräche machte die eintretende Indianerin ein Ende.“"
                                            },
                                            {
                                                "example_id": "167492da-1c06-4e3d-bd22-06ae7255af91",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Sabine hatte schon begonnen, im Geiste Selbstgespräche mit diesen beiden Schattengestalten zu führen.“"
                                            },
                                            {
                                                "example_id": "b106eb32-d127-415f-9ad6-6d1a877ca0cd",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Sabine führt wieder einmal Selbstgespräche, während sie im Wohnzimmer aufgeregt zwischen ihrer Arbeitsecke und der Terrassentür hin und her rennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f757a1c-d360-4c8c-bbc7-876edc15c8f2",
                        "source_entry_id": "a9523744-3268-3f44-9823-a45b39f8c410",
                        "source_sense_id": "b730c35a-e7b1-3ce6-a39a-a87a614dca16",
                        "source_sense_description": "ein Selbstgespräch führen",
                        "target_lang_word": "führen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "führen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5af4a7cf-35c6-3d22-9a8e-ac1bb510e7ba",
                                        "entry_id": "869e9843-955f-306c-aa61-878daae678ce",
                                        "glosses": [
                                            "in eine Richtung geleiten, zum Beispiel, indem man nahe neben jemandem geht oder ihn sogar dabei berührt und ihm hilft einen Weg zu finden, den er sonst schwer hätte zu finden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7242184-8dc7-46f9-a34f-5b90e6ca9683",
                                                "sense_id": "5af4a7cf-35c6-3d22-9a8e-ac1bb510e7ba",
                                                "text": "Der Knappe führt das Pferd in den Stall."
                                            },
                                            {
                                                "example_id": "1ee8adb6-a9bd-4e53-84c8-21398fec05be",
                                                "sense_id": "5af4a7cf-35c6-3d22-9a8e-ac1bb510e7ba",
                                                "text": "Komm, ich führ dich in den Backstagebereich."
                                            },
                                            {
                                                "example_id": "6e616a31-2a8a-44f4-93eb-f64508b436f0",
                                                "sense_id": "5af4a7cf-35c6-3d22-9a8e-ac1bb510e7ba",
                                                "text": "Wenn ich ihn durch den Irrgarten führe, was bekomme ich dafür?"
                                            },
                                            {
                                                "example_id": "66521276-bb15-4ec6-bc79-6ce4c28531f7",
                                                "sense_id": "5af4a7cf-35c6-3d22-9a8e-ac1bb510e7ba",
                                                "text": "„Seine erste Reise führte Olaf Scholz nach Senegal, Niger und Südafrika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                        "entry_id": "869e9843-955f-306c-aa61-878daae678ce",
                                        "glosses": [
                                            "das Handeln von jemandem oder etwas bestimmen, indem eine Führungsrolle übernommen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5f90157-c66f-4544-97ea-4ac9b49bdd8b",
                                                "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                                "text": "Sie kann gut Fachgespräche führen."
                                            },
                                            {
                                                "example_id": "7598e111-6e7f-4e73-8549-051b5c6ab427",
                                                "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                                "text": "Klar hat er Ahnung von der Sache, aber führen kann er eben trotzdem nicht."
                                            },
                                            {
                                                "example_id": "25d18345-a47b-4bf2-b98a-8270538207e5",
                                                "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                                "text": "Der Manager führt das Unternehmen zum Erfolg."
                                            },
                                            {
                                                "example_id": "f419aca4-1233-4a0b-b3e5-2c510df8f1fe",
                                                "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                                "text": "„Es ist das Wesen einer Pauschale, dass sie verallgemeinert und somit einzelne Betreuungen nicht mehr kostendeckend geführt werden können.“"
                                            },
                                            {
                                                "example_id": "c41d637f-4f61-4eee-a02e-d4dd490eb8b0",
                                                "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                                "text": "„März 2022: Putin führt Krieg und droht unverhohlen mit dem Einsatz von Atomwaffen.“"
                                            },
                                            {
                                                "example_id": "1afaf45c-f527-43cd-9784-86d362b60c7f",
                                                "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                                "text": "[Steven Spielberg:] „Jahrzehnte später verarbeitete er sein Jugendtrauma und führte Regie beim Holocaust-Film \"Schindlers Liste\", für den er seinen ersten Oscar als bester Regisseur erhielt.“"
                                            },
                                            {
                                                "example_id": "7a77bad7-369c-47ad-968c-b97a9bef71bf",
                                                "sense_id": "dc98c46a-dd66-3588-80b9-dcee6d2a1c46",
                                                "text": "„Der Eishockey-Weltverband führt Gespräche mit anderen möglichen Ausrichter-Ländern, so Präsident René Fasel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8d3b8008-a14d-30e9-8520-3f1bbea358ae",
                                        "entry_id": "869e9843-955f-306c-aa61-878daae678ce",
                                        "glosses": [
                                            "etwas bei sich haben, es handhaben oder lediglich mit sich tragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc28ec5b-62b7-4d8c-a855-e44493490f45",
                                                "sense_id": "8d3b8008-a14d-30e9-8520-3f1bbea358ae",
                                                "text": "Der Fechter führt den Degen mit großem Geschick."
                                            },
                                            {
                                                "example_id": "fdcb33bf-bd60-4ca3-8a07-a4c864617a9f",
                                                "sense_id": "8d3b8008-a14d-30e9-8520-3f1bbea358ae",
                                                "text": "„Der Schiläufer, der ein steiles Gelände sicher hinabfahren will, muss Schutzreflexe abbauen. […] Er muss das Schutzstreben in die Rücklage aufgeben und mutig die Vorlage suchen, um seine Schier sicher führen zu können.“"
                                            },
                                            {
                                                "example_id": "ee8ffb65-5f1f-4b25-b2ff-7ff9768a998b",
                                                "sense_id": "8d3b8008-a14d-30e9-8520-3f1bbea358ae",
                                                "text": "Der Soldat führt seine Waffe häufig mit der linken Hand."
                                            },
                                            {
                                                "example_id": "4fba26d8-0c41-401f-b873-8ca9799e34be",
                                                "sense_id": "8d3b8008-a14d-30e9-8520-3f1bbea358ae",
                                                "text": "Als Mitglied der Sicherheitsmannschaft darf sie Waffen führen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "73aa481a-914c-3581-aa0a-d671b99ad7cc",
                                        "entry_id": "869e9843-955f-306c-aa61-878daae678ce",
                                        "glosses": [
                                            "die Konsequenz haben; etwas entstehen lassen"
                                        ],
                                        "tags": [
                                            "zu etwas führen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e494e0-4566-432d-9d5d-ec93db58eb21",
                                                "sense_id": "73aa481a-914c-3581-aa0a-d671b99ad7cc",
                                                "text": "Der Unterton in der Stimme seiner Frau führte zwangsläufig zum Streit."
                                            },
                                            {
                                                "example_id": "e9ede1a1-2056-400c-8b5e-5620e2f4a87e",
                                                "sense_id": "73aa481a-914c-3581-aa0a-d671b99ad7cc",
                                                "text": "Das ganze Gespräch hier führt doch zu nichts."
                                            },
                                            {
                                                "example_id": "97e96071-1851-47d4-9123-9a4c3884fcdb",
                                                "sense_id": "73aa481a-914c-3581-aa0a-d671b99ad7cc",
                                                "text": "Das führte uns zu der Frage, wie man denn damals mit den Außenseitern umgegangen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ffb9d5e6-1cbb-39be-abf7-0fffdbdb2009",
                                        "entry_id": "869e9843-955f-306c-aa61-878daae678ce",
                                        "glosses": [
                                            "im Sortiment haben"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "573c3818-1b28-47c0-962d-7066df883b2f",
                                                "sense_id": "ffb9d5e6-1cbb-39be-abf7-0fffdbdb2009",
                                                "text": "Unser Geschäft führt keine Scherzartikel."
                                            },
                                            {
                                                "example_id": "d8297b18-2e13-4f59-92ae-14dfcc01c766",
                                                "sense_id": "ffb9d5e6-1cbb-39be-abf7-0fffdbdb2009",
                                                "text": "Führen Sie Damenmode?"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "49856c93-ef5d-348f-ab91-35a9c8141d25",
                                        "entry_id": "869e9843-955f-306c-aa61-878daae678ce",
                                        "glosses": [
                                            "bei einem Wettkampf in Führung liegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968b5d7e-2fb9-4964-9828-c80429d3e515",
                                                "sense_id": "49856c93-ef5d-348f-ab91-35a9c8141d25",
                                                "text": "Nach der ersten Halbzeit führt die Gastmannschaft zwei zu null."
                                            },
                                            {
                                                "example_id": "fb704083-ac66-459a-ae63-8059d1af1804",
                                                "sense_id": "49856c93-ef5d-348f-ab91-35a9c8141d25",
                                                "text": "Klar ist es einfach, wenn man führt, aber hier führt ihr nicht, ihr müsst um so mehr kämpfen!"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
