                        "form_id": "f49704d1-dc87-4b51-986d-14df264f4012",
                        "entry_id": "6d2c0ad3-384b-37d5-a6d8-51ca8dfc04ce",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "insatiables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd6ffce4-9c9b-3e05-949e-1b4e05f327a8",
                        "entry_id": "6d2c0ad3-384b-37d5-a6d8-51ca8dfc04ce",
                        "glosses": [
                            "Qui ne peut se rassasier ou être rassasié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b023df59-a6e6-4afd-81be-b5d014c79457",
                                "sense_id": "cd6ffce4-9c9b-3e05-949e-1b4e05f327a8",
                                "text": "Ne rougissez-vous point, de déshonorer votre condition, par les commerces que vous faites ? de sacrifier gloire et réputation, au désir insatiable d’entasser écu sur écu ?"
                            },
                            {
                                "example_id": "70d4982a-780b-4fd5-bf67-c5b425080772",
                                "sense_id": "cd6ffce4-9c9b-3e05-949e-1b4e05f327a8",
                                "text": "Moi aussi, j’ai vécu, j’ai follement joui de l’existence. J’ai possédé tout ce que peut embrasser le désir insatiable de l’homme, et j’en ai reconnu le néant."
                            },
                            {
                                "example_id": "cb29424d-bc99-47b8-9e0c-7986c9a9dc99",
                                "sense_id": "cd6ffce4-9c9b-3e05-949e-1b4e05f327a8",
                                "text": "Où es-tu quand mon seul bras nu, contre mon visage, fait tourner en mon sang une insatiable folie ?"
                            },
                            {
                                "example_id": "e1288a0a-d52f-4050-a7a7-94a1810db128",
                                "sense_id": "cd6ffce4-9c9b-3e05-949e-1b4e05f327a8",
                                "text": "Des êtres qui dépendent de souffles, de perceptions, de rythmes accélérés, insatiables, machiniques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9415630a-06ae-49e5-beb7-af502503e6bc",
                        "source_entry_id": "6d2c0ad3-384b-37d5-a6d8-51ca8dfc04ce",
                        "source_sense_id": "cd6ffce4-9c9b-3e05-949e-1b4e05f327a8",
