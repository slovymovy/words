                "senses": [
                    {
                        "sense_id": "f95d5902-d4b2-3835-8c5c-73f33021e251",
                        "entry_id": "76a6fa24-014b-371e-a41e-49d552907d25",
                        "glosses": [
                            "русская фамилия тюркского происхождения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54dcf57e-6556-4655-a514-f823f60cb0bb",
                                "sense_id": "f95d5902-d4b2-3835-8c5c-73f33021e251",
                                "text": "Смотрителем маяка был старый боцман парусного флота Майданов."
                            },
                            {
                                "example_id": "f8bcbb96-8a69-452c-b1e2-9f65a4ad4e58",
                                "sense_id": "f95d5902-d4b2-3835-8c5c-73f33021e251",
                                "text": "Привели парня, которому лицо начисто осколком снесло, нижней челюсти нет, глаз как на ниточке висит… Челюстно-лицевой хирург профессор Майданов 11 часов не выходил из операционной, лепя ему лицо заново."
                            }
                        ]
                    }
