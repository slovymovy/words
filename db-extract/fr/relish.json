                "forms": [
                    {
                        "form_id": "93150368-0ab2-4925-84cb-b1f28dca672b",
                        "entry_id": "afba0117-40be-3308-8cef-08b2bc86aee4",
                        "tags": [
                            "plural"
                        ],
                        "form": "relishs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f6b39c1-42b3-3259-a6af-afba2c5630cc",
                        "entry_id": "afba0117-40be-3308-8cef-08b2bc86aee4",
                        "glosses": [
                            "Condiment américain, confit de cornichons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20116224-3956-4eb9-bb5a-61ee4148ae2c",
                                "sense_id": "0f6b39c1-42b3-3259-a6af-afba2c5630cc",
                                "text": "Ma mère dit toujours que je mets trop de relish dans ma nourriture, mais moi, j’adore la relish."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a18e42ce-84df-46f7-a99d-6bf3da722ef0",
                        "source_entry_id": "afba0117-40be-3308-8cef-08b2bc86aee4",
                        "source_sense_id": "0f6b39c1-42b3-3259-a6af-afba2c5630cc",
                        "source_sense_description": "Confit de cornichons.",
                        "target_lang_word": "relish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "754c2ab7-b593-3d73-a2b4-311cb4c4e54e",
                                        "entry_id": "e46864e1-a008-387a-9de2-d3381fbc857b",
                                        "glosses": [
                                            "A pleasant taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5f0f436-3db2-4556-aaae-c51a0eebee9f",
                                                "sense_id": "754c2ab7-b593-3d73-a2b4-311cb4c4e54e",
                                                "text": "Much pleasure we have lost while we abstained / From this delightful fruit, nor known till now / True relish, tasting."
                                            },
                                            {
                                                "example_id": "43d049bc-ae2c-4182-a5c2-092de78f4063",
                                                "sense_id": "754c2ab7-b593-3d73-a2b4-311cb4c4e54e",
                                                "text": "The Caſe is the ſame if the Object, proper for exciting any Senſation, has never been apply'd to the Organ. A Laplander or Negro has no Notion of the reliſh of VVine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9649c111-ba86-3af5-8856-e39315bd619e",
                                        "entry_id": "e46864e1-a008-387a-9de2-d3381fbc857b",
                                        "glosses": [
                                            "Enjoyment; pleasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe25057-205b-4e10-9187-f8272a005ee1",
                                                "sense_id": "9649c111-ba86-3af5-8856-e39315bd619e",
                                                "text": "When liberty is gone, / Life grows insipid, and has lost its relish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5756eda8-e2a5-3f6c-871d-1f98587b6531",
                                        "entry_id": "e46864e1-a008-387a-9de2-d3381fbc857b",
                                        "glosses": [
                                            "A quality or characteristic tinge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91924aa5-5999-4a48-be44-3ad5b2ea191d",
                                                "sense_id": "5756eda8-e2a5-3f6c-871d-1f98587b6531",
                                                "text": "[T]hat Air of piety to the Gods ſhould ſhine thro' the Poem, vvhich ſo viſibly appears in all the vvorks of antiquity: And it ought to preſerve ſome reliſh of the old vvay of vvriting; the connections ſhould be looeſ, the narrations and decſriptions ſhort, and the periods conciſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb67da8f-24d6-34c3-a257-8aecb0154033",
                                        "entry_id": "e46864e1-a008-387a-9de2-d3381fbc857b",
                                        "glosses": [
                                            "A taste (for); liking (of); fondness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce314af0-62e6-405c-af3d-b2442d04ac2f",
                                                "sense_id": "bb67da8f-24d6-34c3-a257-8aecb0154033",
                                                "text": "I have a relish for moderate praise, because it bids fair to be judicious."
                                            },
                                            {
                                                "example_id": "52750945-897a-41f4-a0a2-e4730c313ae4",
                                                "sense_id": "bb67da8f-24d6-34c3-a257-8aecb0154033",
                                                "text": "One of the first acts which he was under the necessity of performing must have been painful to a man of so generous a nature, and of so keen a relish for whatever was excellent in arts and letters."
                                            },
                                            {
                                                "example_id": "80fb0040-8677-4222-9b87-78a12c96614c",
                                                "sense_id": "bb67da8f-24d6-34c3-a257-8aecb0154033",
                                                "text": "Jews and Israel are not synonymous; nor is support for Palestine synonymous with anti-Semitism; nor is questioning the orthodoxy of the Republican party, which the majority of us do with relish, an insult to Jewry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf6ab11-30e0-3f3d-b03e-e61661b4173a",
                                        "entry_id": "e46864e1-a008-387a-9de2-d3381fbc857b",
                                        "glosses": [
                                            "A cooked or pickled sauce, usually made with vegetables or fruits, generally used as a condiment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "806d753b-1932-42e8-9305-a05333d57b45",
                                                "sense_id": "9bf6ab11-30e0-3f3d-b03e-e61661b4173a",
                                                "text": "Congressmen gleefully wolfed down every imaginable version of the hot dog – smoked kielbasas, jumbo grillers, Big & Juicy's, kosher dogs and spiced dogs – topped with every imaginable condiment – hot mustard, sweet mustard, jalapenos, spaghetti sauce, regular relish, corn relish, maple syrup salsa and the secret sauce of Rep. Jack Kingston (R-Ga.). (\"If I told you the recipe,\" an aide explained, \"I'd have to shoot you.\")"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d716b252-a863-34d2-80ec-eaec10bfa007",
                                        "entry_id": "e46864e1-a008-387a-9de2-d3381fbc857b",
                                        "glosses": [
                                            "In a wooden frame, the projection or shoulder at the side of, or around, a tenon, on a tenoned piece."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40840ab4-3c78-34cc-ae50-50784a5b239a",
                                        "entry_id": "e46864e1-a008-387a-9de2-d3381fbc857b",
                                        "glosses": [
                                            "Something that is greatly liked or savoured."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "relish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc9d9929-8b59-350c-9024-a2d1acc6e868",
                                        "entry_id": "6f55b4fb-49ec-353e-bf71-acb62d88531b",
                                        "glosses": [
                                            "To taste or eat with pleasure, to like the flavor of"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                                        "entry_id": "6f55b4fb-49ec-353e-bf71-acb62d88531b",
                                        "glosses": [
                                            "To take great pleasure in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "175568f8-8c6a-436a-af0f-9d99f86098e5",
                                                "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                                                "text": "He relishes their time together."
                                            },
                                            {
                                                "example_id": "7a882d74-1400-4191-9b11-d0dd5f7e4bf4",
                                                "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                                                "text": "I don't relish the idea of going out tonight."
                                            },
                                            {
                                                "example_id": "9483673e-ddd1-4f16-b381-dcfc889de2bc",
                                                "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                                                "text": "Now Vlysses, I begin to relliſh thy aduice, / And I wil giue a taste of it forthwith / To Agamemnon, go we to him ſtraight:"
                                            },
                                            {
                                                "example_id": "4eeeed16-c965-4817-b034-e6de5d9386fe",
                                                "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                                                "text": "He knows how to prize his advantages, and to relish the honours which he enjoys."
                                            },
                                            {
                                                "example_id": "54d1b33b-b2aa-4d83-a736-111adb367b19",
                                                "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                                                "text": "“Nurses are not relishing this,” she said. “We are acting with a very heavy heart. It has been a difficult decision taken by hundreds of thousands who begin to remove their labour from tomorrow in a bid to be heard, recognised and valued. […]"
                                            },
                                            {
                                                "example_id": "011052dc-8e29-4f5e-a987-3a9103903cea",
                                                "sense_id": "aafc713a-efe3-3750-9b71-63387ef2e213",
                                                "text": "Few political careers start when people are in their 70s, but Hendy is actually relishing it, although he is incensed sometimes by the pointlessness of the posturing by the opposition, which keeps him up late. \"The bit I don't like is getting home at 0100 or 0200 in the morning because the opposition have been fruitlessly arguing for a long time.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0acc581c-4a08-3271-93cf-01cc2304d95f",
                                        "entry_id": "6f55b4fb-49ec-353e-bf71-acb62d88531b",
                                        "glosses": [
                                            "To taste; to have a specified taste or flavour."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c781868a-3db6-4163-ba93-1fb791139422",
                                                "sense_id": "0acc581c-4a08-3271-93cf-01cc2304d95f",
                                                "text": "honourable enterprises are accompanied with dangers and damages, as experience evinceth; they will make the rest of thy life relish the better."
                                            },
                                            {
                                                "example_id": "2b320dd8-8bc8-4fea-ad85-5fc0900bf8d4",
                                                "sense_id": "0acc581c-4a08-3271-93cf-01cc2304d95f",
                                                "text": "Had I been the finder-out of this secret, it would not have relish'd among my other discredits."
                                            },
                                            {
                                                "example_id": "03fc9cc7-b8b9-4e32-9524-aaad51e78808",
                                                "sense_id": "0acc581c-4a08-3271-93cf-01cc2304d95f",
                                                "text": "A theory, which, how much soever it may relish of wit and invention, hath no foundation in nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf81244-8c94-38a6-bacc-b9d7699ccfe5",
                                        "entry_id": "6f55b4fb-49ec-353e-bf71-acb62d88531b",
                                        "glosses": [
                                            "To give a taste to; to cause to taste nice, to make appetizing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bff1d22-2156-4e29-b039-ce277fd67173",
                                                "sense_id": "5cf81244-8c94-38a6-bacc-b9d7699ccfe5",
                                                "text": "By this the boiling Kettle had prepar'd, / And to the Table ſent, the ſmoaking Lard; / On which the eager Appetite they dine, / A ſav'ry Bit, that ſerv'd to relliſh Wine: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d10890a-a136-397a-b4ef-e0ab6e00958a",
                                        "entry_id": "6f55b4fb-49ec-353e-bf71-acb62d88531b",
                                        "glosses": [
                                            "To give pleasure."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
