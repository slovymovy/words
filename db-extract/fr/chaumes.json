                "senses": [
                    {
                        "sense_id": "0bce6acd-8a62-383a-b6b4-732c6327db42",
                        "entry_id": "a4c40326-9d48-3f22-bb70-42648b0a0d9d",
                        "glosses": [
                            "Pâturages d’altitude."
                        ],
                        "tags": [
                            "Vosges"
                        ],
                        "examples": [
                            {
                                "example_id": "a2b5308a-7900-4615-9e18-38f181368e3a",
                                "sense_id": "0bce6acd-8a62-383a-b6b4-732c6327db42",
                                "text": "Les chaumes des Vosges sont recouvertes par un gazon composé du gaillet du Hartz, du serpolet, d’euphraises, de joncées et de graminées à feuillage menu, surtout des espèces des genres Luzule, Agrostide, Flouve, Fétuque et Nardus"
                            },
                            {
                                "example_id": "fb1d3526-5a81-4c08-ab89-cd8f8143ba03",
                                "sense_id": "0bce6acd-8a62-383a-b6b4-732c6327db42",
                                "text": "Sur le flanc occidental, des sentiers commodes mais interminables conduisent au contraire, sans fatigue, à la limite des chaumes."
                            },
                            {
                                "example_id": "17682d00-c444-4e2e-b0eb-39a021a2acc3",
                                "sense_id": "0bce6acd-8a62-383a-b6b4-732c6327db42",
                                "text": "D’autant plus que les peuplements de crête sur 500 ha étaient constitués par une pessière artificielle implantée, sur des chaumes anthropiques, dans la deuxième moitié du 19^(ème) siècle."
                            }
                        ]
                    }
                ],
