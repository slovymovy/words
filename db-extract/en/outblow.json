                        "glosses": [
                            "To exceed in blowing; blow more or better than (all senses)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d46ff1db-8c04-40e0-b3b1-eff597e49957",
                                "sense_id": "57017087-e499-31d3-aa9a-28c44d89fbad",
                                "text": "“I never let a man outblow me,” he says, “if he'll tell his story first, I'll beat it.”"
                            },
                            {
                                "example_id": "3022b849-306e-4181-90c8-74a0e8428281",
                                "sense_id": "57017087-e499-31d3-aa9a-28c44d89fbad",
                                "text": "Both black bands bopped and jived and outblew our own more traditional unit, which, instead of playing swinging music, specialized in precision drills and marching down the field six regimented steps from one yard line to the next, as described in my poem entitled \"Cadences.\""
                            }
                        ]
