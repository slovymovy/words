                    {
                        "sense_id": "8add94ec-7581-330e-8bac-552bccc0570d",
                        "entry_id": "6faa9cac-6013-3e91-ab09-0a46b49f726a",
                        "glosses": [
                            "Stein, der zur Konstruktion von lichtdurchlässigen, feuersicheren und tragfähigen Wänden verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a0b6929-3039-4366-80b4-f66c41ae6920",
                                "sense_id": "8add94ec-7581-330e-8bac-552bccc0570d",
                                "text": "Glasbausteine wurden in Deutschland in den 1960-er und 1970-er Jahren sehr häufig eingesetzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab740b64-5a1c-3e5f-84a6-b133d99157fd",
                        "entry_id": "6faa9cac-6013-3e91-ab09-0a46b49f726a",
                        "glosses": [
                            "sehr dickes Brillenglas"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "3d95c3d3-dadb-440c-b27a-5f9ce6137687",
                                "sense_id": "ab740b64-5a1c-3e5f-84a6-b133d99157fd",
                                "text": "Er ist sehr kurzsichtig und trägt deshalb Glasbausteine."
                            },
                            {
                                "example_id": "d8773257-5d35-4897-8fbb-403113356cd3",
                                "sense_id": "ab740b64-5a1c-3e5f-84a6-b133d99157fd",
                                "text": "„Der Junge war pummelig und trug eine Brille aus Glasbausteinen.“"
                            },
                            {
                                "example_id": "e1793ea0-4f8e-4361-858c-df5be0991124",
                                "sense_id": "ab740b64-5a1c-3e5f-84a6-b133d99157fd",
                                "text": "„Ich musste an den alten Film mit Dustin Hoffman denken, in dem er diese riesigen Glasbausteine als Brille getragen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
