                "senses": [
                    {
                        "sense_id": "be31a86d-5c6c-3106-b85b-35ed8abfb989",
                        "entry_id": "6493a72b-a82b-308e-b7b5-d7fe1ee2a9cb",
                        "glosses": [
                            "Person, die mal als Hörer, mal als Leser handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75942461-ef84-4c7d-acd4-a361f0000245",
                                "sense_id": "be31a86d-5c6c-3106-b85b-35ed8abfb989",
                                "text": "„In beiden Texten wird der Hörerleser ohne Umschweife sofort mit den Akteuren bekannt gemacht, erfährt von deren Aktivitäten, dem Ort und Zeitpunkt des Geschehens, dem Handlungsziel und empfängt schließlich eine appellartige Botschaft.“"
                            },
                            {
                                "example_id": "2060a511-3ead-4d5c-88e7-0792c1c9b882",
                                "sense_id": "be31a86d-5c6c-3106-b85b-35ed8abfb989",
                                "text": "„Meist ist ein des Deutschen mächtiger Hörerleser in der Lage, Komposita in sinnvolle Einheiten segmentieren, das heißt zu zerlegen, zu zergliedern.“"
                            },
                            {
                                "example_id": "4f542224-8c39-4199-b3be-5fa0d925dcad",
                                "sense_id": "be31a86d-5c6c-3106-b85b-35ed8abfb989",
                                "text": "„Die Hörerleser fragen und der Leserschreiber antwortet.“"
                            },
                            {
                                "example_id": "f1b92f8a-d8b9-4949-bbd8-da39058fd58d",
                                "sense_id": "be31a86d-5c6c-3106-b85b-35ed8abfb989",
                                "text": "„Aber der „Plot“ ist unwichtig bei dieser Ode an die Liebe; was zählt, ist der Eindruck, den das sprachliche Feuerwerk beim Hörerleser hinterlässt: Verwirrung, Vergnügen, Faszination und den Wunsch: Mehr davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
