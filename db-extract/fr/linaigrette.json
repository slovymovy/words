                "senses": [
                    {
                        "sense_id": "15c1762e-4a5f-3c4a-9efa-abdf899dea0a",
                        "entry_id": "1a887910-0244-37b7-b91d-7d8024c53a77",
                        "glosses": [
                            "Nom usuel de plantes de la famille des Cyperaceae (Cypéracées), du genre Eriophorum, qui poussent dans les marais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65657fd-6681-42e5-b467-5c6850e25f11",
                                "sense_id": "15c1762e-4a5f-3c4a-9efa-abdf899dea0a",
                                "text": "Au bord des petits lacs des Alpes, plus ou moins comblés, se forment des tourbières appelées fagnes ; pour le touriste elles se signalent par les élégantes houppes blanches des Linaigrettes."
                            },
                            {
                                "example_id": "a4275ddd-d07c-4e77-9552-50484eb38416",
                                "sense_id": "15c1762e-4a5f-3c4a-9efa-abdf899dea0a",
                                "text": "L’herbe à coton, l’élégante linaigrette, semait ses houppes soyeuses, les bourgeons précoces de l’airelle bleue des marais pointaient ça et là. Les prêles dressaient leurs épis bruns au cœur même du tapis de sphaignes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b36f34f-6aca-3b10-a24d-847c5cbdd446",
                        "entry_id": "1a887910-0244-37b7-b91d-7d8024c53a77",
                        "glosses": [
                            "Son inflorescence à maturité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "fe51db00-0159-4485-8cd4-d8eb6908e0de",
                                "sense_id": "0b36f34f-6aca-3b10-a24d-847c5cbdd446",
                                "text": "Il saisit Héloïse, l’enlève entre ses bras comme une balle de fougère, une sachée de linaigrettes floconneuses, et la transporte doucement, parmi les couvertures qu’il rabat sur elle."
                            }
                        ]
                    },
                    {
