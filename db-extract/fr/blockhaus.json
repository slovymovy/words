        "fr-extract.jsonl": [
            {
                "entry_id": "6bbcf2f2-4e84-3a31-9e57-f2e13cb7c80a",
                "word": "blockhaus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d7a1e06d-10e7-3fca-8a51-460d3f2171a6",
                        "entry_id": "6bbcf2f2-4e84-3a31-9e57-f2e13cb7c80a",
                        "glosses": [
                            "Maison construite en troncs d'arbres."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "40095644-ab29-44ce-8d42-052691c8d2fb",
                                "sense_id": "d7a1e06d-10e7-3fca-8a51-460d3f2171a6",
                                "text": "Ce n'est pas à dire pourtant que cette grande famille [d'Amérique] républicaine ne manifeste plus par aucun signe sa diversité d'origine. Le descendant allemand, par exemple, […] préfère encore son blockhaus, simple et rustique comme lui, à l'élégante framehouse de ses voisins."
                            }
                        ]
                    },
                    {
                        "sense_id": "917b4ef3-d31b-32ef-831f-f835103f1992",
                        "entry_id": "6bbcf2f2-4e84-3a31-9e57-f2e13cb7c80a",
                        "glosses": [
                            "Redoute, casemate, abri blindé à l’épreuve des tirs ennemis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970937fd-9d29-453c-9ca9-48a26ad0d549",
                                "sense_id": "917b4ef3-d31b-32ef-831f-f835103f1992",
                                "text": "Entre les quatre murs du blockhaus démantelé, un âne errant, ou une chèvre au piquet, broute le gazon d'Espagne et le chardon bleu."
                            },
                            {
                                "example_id": "841a5294-a085-4b2e-9bb8-99418540f975",
                                "sense_id": "917b4ef3-d31b-32ef-831f-f835103f1992",
                                "text": "Avec une vigueur remarquable, ils se mirent à improviser un blockhaus autour du canon à pivot et à longue portée qu’on avait placé là."
                            },
                            {
                                "example_id": "635f8983-4893-47b8-96ce-c489cf7b4c2e",
                                "sense_id": "917b4ef3-d31b-32ef-831f-f835103f1992",
                                "text": "Dans le grand blockhaus de trois pièces du QG, on pouvait voir, sur une carte, notre front: une ligne noire, le front au 1ᵉʳ septembre 1941, une ligne rouge, au 1ᵉʳ janvier 1942."
                            },
                            {
                                "example_id": "dfc78cf9-b128-4e41-9ac9-98b687ea5f0d",
                                "sense_id": "917b4ef3-d31b-32ef-831f-f835103f1992",
                                "text": "Ça et là, ce sont des magasins, des entrepôts, des chais, ou bien le cube de béton d'une cave coopérative, sévère comme un blockhaus."
                            }
                        ]
                    },
                    {
                        "sense_id": "73ad7618-fff5-36fc-a486-77421377efe9",
                        "entry_id": "6bbcf2f2-4e84-3a31-9e57-f2e13cb7c80a",
                        "glosses": [
                            "Abri blindé destiné à protéger, pendant une attaque, la commande du gouvernail et les ordres de transmission."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4908455b-b8c2-486d-8f69-4238d0586f9c",
                                "sense_id": "73ad7618-fff5-36fc-a486-77421377efe9",
                                "text": "Il est comme le commandant d'un bateau de guerre qui a pris son poste dans le blockhaus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a436924-a0e4-4193-a763-c8824d2ff731",
                        "source_entry_id": "6bbcf2f2-4e84-3a31-9e57-f2e13cb7c80a",
                        "source_sense_id": "917b4ef3-d31b-32ef-831f-f835103f1992",
                        "source_sense_description": "(Militaire) Redoute, casemate, abri blindé à l’épreuve des tirs ennemis.",
                        "target_lang_word": "Kommandoturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommandoturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "467f42d1-b7ef-31d6-a2c5-dda2da8b175e",
                                        "entry_id": "357cd193-b034-35d6-a40d-b2ad8d1afb53",
                                        "glosses": [
                                            "Turm, in dem sich eine Kommandozentrale befindet, von dem aus kommandiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcdb29a5-d313-4c91-92fd-b7191c24cd6f",
                                                "sense_id": "467f42d1-b7ef-31d6-a2c5-dda2da8b175e",
                                                "text": "„Wir müssen einen seltsamen Anblick geboten haben: er groß und bärtig, ich mit einer zierlichen Porzellantasse in der Hand; beide in ernsthafter Klausur im Kommandoturm eines grauen Traktors in einer riesigen Scheune inmitten des regnerischen Hochlands von Surrey.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81253e7e-410d-494b-b1e6-87573509bfa2",
                        "source_entry_id": "6bbcf2f2-4e84-3a31-9e57-f2e13cb7c80a",
                        "source_sense_id": "917b4ef3-d31b-32ef-831f-f835103f1992",
                        "source_sense_description": "(Militaire) Redoute, casemate, abri blindé à l’épreuve des tirs ennemis.",
                        "target_lang_word": "Bunker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bunker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "bombensicherer/volltreffersicherer Unterstand für Menschen und Kriegsgerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2367ae81-9db6-4713-bc81-61fb9b09ac3a",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Neben mir sehe ich ein dunkles Loch, eine hinabführende Treppe mit anschließendem Bunker. Schwarz, feucht und jedenfalls verlaust Platz für drei Mann nur. Die Sanitäter, die darin liegen, wollen mich nicht hineinlassen.“"
                                            },
                                            {
                                                "example_id": "c0f5aeca-6a08-4319-bcea-bbb1da26dcf4",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Im Bunker lauerten wir meistens an der Tür herum.“"
                                            },
                                            {
                                                "example_id": "f3fd5fca-3809-4e63-9afa-9aa0f755a9c8",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Er hatte im Bunker schon ganz anders schreien gehört.“"
                                            },
                                            {
                                                "example_id": "9e26e34d-c66f-4b5f-903c-f530fa5583a6",
                                                "sense_id": "47e58d91-1ddb-380a-9d79-8d6bbf0cc76c",
                                                "text": "„Vor allem wohl, weil für den langen Weg hin und zurück zuviel Arbeitszeit verloren ging, hatte die Werksleitung begonnen, auf dem Fabrikgelände einen eigenen Bunker zu bauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51ce3784-95aa-3e71-bc3f-5fc518d64a0a",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "Gefängnis"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950c98c4-d6e5-4077-a4bb-eff68dc55d36",
                                                "sense_id": "51ce3784-95aa-3e71-bc3f-5fc518d64a0a",
                                                "text": "Oh, shit, sitzt er jetzt im Bunker?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "684a4743-fa5c-3514-b423-9b403dbe6393",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "Behälter oder Lagerraum, meist als längerfristiges Zwischenlager gedacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ead6ae-d910-4c63-871a-2a9194690d04",
                                                "sense_id": "684a4743-fa5c-3514-b423-9b403dbe6393",
                                                "text": "Bunker ist in verschiedensten Zusammenhängen ein Typ von Lager, zum Beispiel in der Schifffahrt und im Bergbau."
                                            },
                                            {
                                                "example_id": "c6ed8d4f-9fda-41eb-b131-0f7812b6f716",
                                                "sense_id": "684a4743-fa5c-3514-b423-9b403dbe6393",
                                                "text": "Oh, in meinem privaten Bunker gibt es so einiges, Obstkonserven, Spaghetti und die eine oder andere Flasche Whiskey."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8bd72dc1-be3e-3584-9f76-242d22c7a8ad",
                                        "entry_id": "2ebb4eff-3571-3a70-b411-575b4617fd8b",
                                        "glosses": [
                                            "mit Sand gefüllte Vertiefung auf einer Spielbahn, absichtlich platziertes Hindernis"
                                        ],
                                        "tags": [
                                            "Golfsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78f426ae-de1c-4fba-81e6-624662cf6bdf",
                                                "sense_id": "8bd72dc1-be3e-3584-9f76-242d22c7a8ad",
                                                "text": "Mit einem präzisen Schlag aus dem Bunker, der direkt neben der Fahne landete, konnte er das Par retten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65281d0e-bb50-4311-a3f0-c80fef3ebff9",
                        "source_entry_id": "6bbcf2f2-4e84-3a31-9e57-f2e13cb7c80a",
