                        ]
                    },
                    {
                        "translation_id": "a73401c5-846c-4629-8fb2-96db037f16b9",
                        "source_entry_id": "1db5f8af-fd1b-3337-b5aa-1a4bfc1c5a72",
                        "source_sense_id": "b40f34d8-eda9-3e84-bf23-f1a495269970",
