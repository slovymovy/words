                {
                    "sense_id": "b6398712-3690-3e2c-bd19-fdac77002f20",
                    "sense_definition": "Further advanced in position, progress, or skill; superior to others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "status_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finished the race two laps <w>ahead</w> of me.",
                            "target_lang_translations": {
                                "ru": "Он финишировал на два круга <w>впереди</w> меня.",
                                "pl": "Ukończył wyścig dwa okrążenia <w>przede</w> mną.",
                                "tr": "Yarışı benim iki tur <w>önümde</w> bitirdi.",
                                "zh": "他比我<w>领先</w>两圈完成了比赛。"
                            }
                        },
                        {
                            "text": "She worked hard to get <w>ahead</w> in her career.",
                            "target_lang_translations": {
                                "ru": "Она усердно работала, чтобы вырваться <w>вперёд</w> в своей карьере.",
                                "pl": "Ciężko pracowała, aby posunąć się <w>do przodu</w> w swojej karierze.",
                                "tr": "Kariyerinde <w>ilerlemek</w> için çok çalıştı.",
                                "zh": "她努力工作以在事业上<w>超前</w>。"
                            }
