                        ],
                        "examples": [
                            {
                                "example_id": "dda9988c-dcb6-481c-922c-d8d412d4e288",
                                "sense_id": "59100bf5-f623-309b-923f-b0e439049e8a",
                                "text": "Richard [I of England] was well ſtored with men, the bones; and quickly got money, the ſinews of warre; by a thouſand Princely skills gathering ſo much coin as if he meant not to return, becauſe looking back would unbowe his reſolution"
                            },
                            {
                                "example_id": "2c4becc7-03b4-458d-824e-5793f9f7a827",
                                "sense_id": "59100bf5-f623-309b-923f-b0e439049e8a",
                                "text": "As in little pieces of wood naturally bow'd like a Man's Elbow, the Carver doth not unbow it, but carves an hand at the one end of it, and shapes it into the compleat figure of a Mans Arm."
                            }
                        ]
                    }
