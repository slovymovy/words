                    {
                        "translation_id": "6a994393-5ee0-41cf-bf8c-907a1b785b94",
                        "source_entry_id": "c12f5bac-299c-3d2d-abe4-8722733202e5",
                        "source_sense_id": "794dc99c-5560-3cff-8614-ff2969b544c0",
