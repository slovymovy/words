                "senses": [
                    {
                        "sense_id": "b0639f80-9339-39c2-8a8e-8af059d859de",
                        "entry_id": "ed48293f-8103-3ad0-95c9-fe3f6145d154",
                        "glosses": [
                            "Rendre non conforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9f9d74c-98d1-441e-8a7e-92881bba1e09",
                                "sense_id": "b0639f80-9339-39c2-8a8e-8af059d859de",
                                "text": "Tout au long du film on assiste à la colorisation de ce monde suite à divers événements qui vont déconformiser tout ça, mais je ne vous en dit pas plus!"
                            },
                            {
                                "example_id": "bac5ecfd-33aa-4bae-9f88-b7c7a28bfd0f",
                                "sense_id": "b0639f80-9339-39c2-8a8e-8af059d859de",
                                "text": "Je crois que les Israéliens vont déconformiser tout ça et faire comme bon leur semble."
                            },
                            {
                                "example_id": "3502de37-bf31-4b69-b1cc-6830fc7ab4c8",
                                "sense_id": "b0639f80-9339-39c2-8a8e-8af059d859de",
                                "text": "La quête de sens et de beauté ne va pas naturellement de soi. Il faut se \"déconformiser\"."
                            },
                            {
                                "example_id": "43f0cfea-8fd0-4ee7-a305-fb11245e62a0",
                                "sense_id": "b0639f80-9339-39c2-8a8e-8af059d859de",
                                "text": "Il est temps de vous déconformiser."
                            }
                        ]
                    }
                ],
