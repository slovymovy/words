                "senses": [
                    {
                        "sense_id": "5810e4df-c7bc-3ecc-9cbd-40e9e497c255",
                        "entry_id": "fbc8df51-a777-3e4f-8a17-22687791417f",
                        "glosses": [
                            "A remote tract of land in the interior; hence (in plural) sparsely populated country far from major cities and lacking conveniences common in urban areas."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "edc17731-584f-4818-9eab-b3ef955a6e8a",
                                "sense_id": "5810e4df-c7bc-3ecc-9cbd-40e9e497c255",
                                "text": "I speak solely for the backblock roads, and I contend that the time has arrived when the Government should turn its attention to the metalling of these roads."
                            },
                            {
                                "example_id": "444e1d1f-5054-4371-bb26-23c5d56079f9",
                                "sense_id": "5810e4df-c7bc-3ecc-9cbd-40e9e497c255",
                                "text": "It has happened in other districts that new settlement has turned the old centres into isolated backblocks."
                            },
                            {
                                "example_id": "1c683637-396d-475a-8a8c-b4d501fcb620",
                                "sense_id": "5810e4df-c7bc-3ecc-9cbd-40e9e497c255",
                                "text": "Backblocks hardship is a very real thing, but Mary Scott expresses it somewhat too much in the Victorian ‘There′s a tear on your eye’ mode, little graves on the hillside and old servants, horses and dogs, faithful to the last."
                            },
                            {
                                "example_id": "f724ca6f-86f7-4fe8-88d1-7f85da203a01",
                                "sense_id": "5810e4df-c7bc-3ecc-9cbd-40e9e497c255",
                                "text": "The weeping man was an emancipist who had a backblock in the next valley & sometimes came over to see his cobber the shepherd, both being Roscommon men."
                            }
                        ]
                    },
                    {
                        "sense_id": "47abf4ea-8908-3c88-916f-a88e64846c19",
                        "entry_id": "fbc8df51-a777-3e4f-8a17-22687791417f",
                        "glosses": [
                            "Land behind that which fronts on water; land without a permanent watercourse."
                        ],
