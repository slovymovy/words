                "senses": [
                    {
                        "sense_id": "cfc86e5a-d761-39c1-958a-80678707519f",
                        "entry_id": "8584595c-ba65-3dc8-9e8b-abd912334538",
                        "glosses": [
                            "Zange, die zum Wenden von Grillgut verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7fd6e57-36ea-495d-9def-3ce8c28e85fc",
                                "sense_id": "cfc86e5a-d761-39c1-958a-80678707519f",
                                "text": "„Grillen ist ein kulinarisches Anti-Stress-Programm, doch dafür benötigt man das richtige Zubehör: Zur Ausrüstung gehört neben dem Grill unbedingt eine Grillzange zum Platzieren und Wenden, Handschuhe, einen robusten Pinsel und eventuell Stäbchen zum Aufspießen.“"
                            },
                            {
                                "example_id": "60fd46ff-57dc-4f8c-a10d-c9d6dff412d8",
                                "sense_id": "cfc86e5a-d761-39c1-958a-80678707519f",
                                "text": "„Männer klammern sich an ihre Grillzange, weil Frauen in so vielen anderen Lebensbereichen bereits das Zepter an sich gerissen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
