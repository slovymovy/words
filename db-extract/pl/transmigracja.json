                        "examples": [
                            {
                                "example_id": "07887e53-609b-45ed-922d-7551f8d30d4f",
                                "sense_id": "46672f75-3fd1-38f4-99b0-f966de4b241f",
                                "text": "W kabalistycznej Sefer habahir pada stwierdzenie, że transmigracja może ciągnąć się nawet przez tysiąc pokoleń, jednak dominuje pogląd, że dusza wciela się w inne ciała tylko trzykrotnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
