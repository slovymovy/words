                        "entry_id": "1aac5013-31aa-3c81-878b-80b8490354ea",
                        "glosses": [
                            "To perspire; to sweat."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0c787798-1a42-4329-a9d3-4a15727fbc75",
                                "sense_id": "a59e5945-81a2-30e4-9315-33123db9fe60",
                                "text": "The sun bursts out in furious blaze, / I perspirate from head to heel ; / I'd like to hire a one-horse chaise — / How can I, without cash at Lille ?"
                            },
                            {
                                "example_id": "c81c7e97-44b5-4011-a6cd-31b61fa6bde2",
                                "sense_id": "a59e5945-81a2-30e4-9315-33123db9fe60",
                                "text": "1886, Edgar Wilson \"Bill\" Nye, Remarks,\n\"So we stood Brown up agin a tree and poured hot ashes down his back till he begun to fit his cloze pretty quick, and then we laid him down in the tent and covered him up with everything we had in our humble cot. Everything worked well till he begun to perspirate, and then there was music, and don't you forget it. That kind of soaked the ashes, don't you see, and made a lye that would take the peelin' off a telegraph pole."
                            }
                        ]
                    }
