                "senses": [
                    {
                        "sense_id": "3617bf1b-fe6f-3024-bdf3-f218669b18fd",
                        "entry_id": "66a72a0c-4709-3f1b-9593-49dd3e53ea11",
                        "glosses": [
                            "женск. к пленник; женщина, находящаяся в плену"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "27d7f67e-dca5-30cb-9ecd-3012cfe98006",
                        "entry_id": "66a72a0c-4709-3f1b-9593-49dd3e53ea11",
                        "glosses": [
                            "перен. женщина, находящаяся под непреодолимой властью, влиянием кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19cd1f04-dfad-46de-b1b7-3b7f6f24f90a",
                        "source_entry_id": "66a72a0c-4709-3f1b-9593-49dd3e53ea11",
                        "target_lang_word": "prisoner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prisoner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person incarcerated in a prison, while on trial or serving a sentence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f9c94c-e1e7-45d9-9bda-a7d925cc66c2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "Two other prisoners were staying in the same cell as him."
                                            },
                                            {
                                                "example_id": "ecff8481-0a8a-4356-b99c-a0587a2c82a2",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "The evidence disclosed that the three prisoners were in a public-house together with the prosecutor, Abraham Rhodes, and that in concert with the other two prisoners, the prisoner John Dewhirst placed a pencase on the table in the room where they were assembled, and left the room to get writing-paper."
                                            },
                                            {
                                                "example_id": "8a897d78-9989-460d-b0ce-d4b047eff474",
                                                "sense_id": "7341d926-2e89-3a36-acb9-7316b94f38cb",
                                                "text": "American journalist Evan Gershkovich and former US Marine Paul Whelan were among the 24 detainees released as part of a complex prisoner swap between Russia, the US and other Western nations. […] Krasikov, a former high-ranking FSB colonel serving a life sentence in a German prison, was on the top of Moscow’s list of Russian prisoners it wanted to exchange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "Any person held against their will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed10d49-3a6d-461c-93e6-211ea5090a5f",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "And gainſt the General we will lift our ſwords / And either lanch his greedie thirſting throat, / Or take him priſoner, and his chaine ſhall ſerue / For Manackles, till he be ranſom’d home."
                                            },
                                            {
                                                "example_id": "27825753-244a-408d-8e27-06acaa6eed23",
                                                "sense_id": "45feebf1-469c-36bb-bb3f-e35dd0cde2dc",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile ; he could not tell what this prisoner might do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                        "entry_id": "8f96aade-77bc-3b07-88f0-f1fd0fdf570f",
                                        "glosses": [
                                            "A person who is or feels confined or trapped by a situation or a set of circumstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6eabbee-6245-4ea3-b0b6-07ce02fdda7d",
                                                "sense_id": "757e2260-9716-315b-a96a-763935d6170d",
                                                "text": "I am no longer a prisoner to fear, for I am a child of God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e9f8e3d-18f9-4972-b4a6-858109c77405",
                        "source_entry_id": "66a72a0c-4709-3f1b-9593-49dd3e53ea11",
                        "target_lang_word": "captive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "captive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80f0c521-bd97-3b46-ab50-99176d97f4ec",
                                        "entry_id": "9d4b3376-68ae-3870-bcec-8ebfca8e24a2",
                                        "glosses": [
                                            "One who has been captured or is otherwise confined."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e4b265-1393-4dd9-920a-88b26b4e4341",
                                                "sense_id": "80f0c521-bd97-3b46-ab50-99176d97f4ec",
                                                "text": "I envy not in any moods\n⁠The captive void of noble rage,\n⁠The linnet born within the cage,\nThat never knew the summer woods: […]"
                                            },
                                            {
                                                "example_id": "02c2f0b3-521e-45d4-ab99-ba772fc259d3",
                                                "sense_id": "80f0c521-bd97-3b46-ab50-99176d97f4ec",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him. The captive made no resistance[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a5eb59-fa11-3f2f-8590-9b1e3bf50a07",
                                        "entry_id": "9d4b3376-68ae-3870-bcec-8ebfca8e24a2",
                                        "glosses": [
                                            "One held prisoner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8522bab-76a5-32b4-b879-3e2c5f7e9535",
                                        "entry_id": "9d4b3376-68ae-3870-bcec-8ebfca8e24a2",
                                        "glosses": [
                                            "One charmed or subdued by beauty, excellence, or affection; one who is captivated."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f412c27-e92e-3704-8a54-c86c4761b2aa",
                                        "entry_id": "9d4b3376-68ae-3870-bcec-8ebfca8e24a2",
                                        "glosses": [
                                            "A captive insurance company, a subsidiary of a company used as its internal insurer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "captive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8928be08-0d28-38da-ba0f-94358b45f26d",
                                        "entry_id": "6b4ea9dc-5c19-32f7-a55b-a78036fa1b54",
                                        "glosses": [
                                            "Held prisoner; not free; confined."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62707de7-23d2-40cd-bdea-a945a713565b",
                                                "sense_id": "8928be08-0d28-38da-ba0f-94358b45f26d",
                                                "text": "A poor, miserable, captive thrall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33cd3888-da93-30bd-8ef7-5efad26f1108",
                                        "entry_id": "6b4ea9dc-5c19-32f7-a55b-a78036fa1b54",
                                        "glosses": [
                                            "Subdued by love; charmed; captivated."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f260d3-91ab-47e8-b8f3-83008b055326",
                                                "sense_id": "33cd3888-da93-30bd-8ef7-5efad26f1108",
                                                "text": "Even in so short a space, my woman's heart / Grossly grew captive to his honey words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03cb4ef5-73a4-3ae5-8fe6-344edffef20b",
                                        "entry_id": "6b4ea9dc-5c19-32f7-a55b-a78036fa1b54",
                                        "glosses": [
                                            "Of or relating to bondage or confinement; serving to confine."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "937d5a21-6209-424a-bfae-e2640790fedd",
                                                "sense_id": "03cb4ef5-73a4-3ae5-8fe6-344edffef20b",
                                                "text": "captive chains; captive hours"
                                            }
                                        ]
                                    }
                                ]
                            },
