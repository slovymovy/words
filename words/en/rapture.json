        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9405fef4-3675-321f-90a1-c6b55b455429",
                    "sense_definition": "An eschatological event in certain Christian beliefs wherein living and resurrected believers are bodily taken up to heaven.",
