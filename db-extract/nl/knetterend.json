        "nl-extract.jsonl": [
            {
                "entry_id": "2ceea715-5019-39df-9f34-fa54f3e1c559",
                "word": "knetterend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c811b70a-df0a-3f2c-ad4c-98f66c500f6f",
                        "entry_id": "2ceea715-5019-39df-9f34-fa54f3e1c559",
                        "glosses": [
                            "het scherpe, knappende, ploffende geluid dat lijkt op dat van brandend hout dat nog veel vocht bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "333b0a02-075f-4f44-a215-f17b078ffc59",
                                "sense_id": "c811b70a-df0a-3f2c-ad4c-98f66c500f6f",
                                "text": "Persoonlijke ongelukken deden zich niet voor. Schoorsteenbrand is mogelijk de oorzaak. De vrouw des huizes hoorde rond kwart over elf een knetterend geluid en op dat moment kwamen de vlammen al uit het dak rond de schoorsteen."
                            },
                            {
                                "example_id": "297be9eb-0d1b-4cdf-88d4-5cc357e447e4",
                                "sense_id": "c811b70a-df0a-3f2c-ad4c-98f66c500f6f",
                                "text": "De beelden van het vuurwerkfestival laten een ongecoördineerde bende zien. Grond- en luchtvuurwerk ontploffen tegelijk, knetterend geraas klinkt."
                            },
                            {
                                "example_id": "db9711e0-79ba-4391-8147-66019258748d",
                                "sense_id": "c811b70a-df0a-3f2c-ad4c-98f66c500f6f",
                                "text": "De man liep tussen het publiek op de Willemstraat in Hengelo. Politieagenten zagen enkele lichtflitsen en hoorden een knetterend geluid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8048c7d1-eb7d-4189-bd00-23f158741085",
                        "source_entry_id": "2ceea715-5019-39df-9f34-fa54f3e1c559",
                        "source_sense_id": "c811b70a-df0a-3f2c-ad4c-98f66c500f6f",
