                "senses": [
                    {
                        "sense_id": "1e25e0e0-411e-3079-9fbb-dbdcbb36ca2f",
                        "entry_id": "d0d477fc-d644-394c-ac5e-6b95a37fd8be",
                        "glosses": [
                            "allmähliche mineralische Ablagerung, insbesondere von Kalk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3bdadd0-5f1c-4351-ba65-0a8d2f816078",
                                "sense_id": "1e25e0e0-411e-3079-9fbb-dbdcbb36ca2f",
                                "text": "Unter Versinterungen verstehen wir gemeinhin die Bildung von Ablagerungen bei der Ausscheidung von Mineralien aus fließendem Wasser."
                            },
                            {
                                "example_id": "d483c54b-e225-448f-9bf9-0356fb663874",
                                "sense_id": "1e25e0e0-411e-3079-9fbb-dbdcbb36ca2f",
                                "text": "Nun könnte klar sein, weshalb wir in einigen Regionen Europas viel mehr Probleme mit Versinterungen haben als in anderen."
                            },
                            {
                                "example_id": "1082cd49-8b84-4ca1-ab45-207f6ff62fac",
                                "sense_id": "1e25e0e0-411e-3079-9fbb-dbdcbb36ca2f",
                                "text": "Ein häufig auftretendes Problem bei dieser Art der Entwässerung von Tunnelbauwerken stellt die Versinterung dar, wobei Ablagerungen die Wasserdurchlässigkeit beeinträchtigen."
                            },
                            {
                                "example_id": "da5e1fc9-62f4-4864-b90c-a7d4adae7d6a",
                                "sense_id": "1e25e0e0-411e-3079-9fbb-dbdcbb36ca2f",
                                "text": "Durch die starke Versinterung nehmen sie weniger Wasser auf, sind frost- und insgesamt wetterbeständiger."
                            },
                            {
                                "example_id": "6cf9490b-a40f-4380-a683-1607264d9870",
                                "sense_id": "1e25e0e0-411e-3079-9fbb-dbdcbb36ca2f",
                                "text": "Dass heute in Delphi keine großen Ethylenkonzentrationen mehr erreicht werden, erklärt er damit, dass sich die Austrittswege durch Erdverschiebung oder Versinterung geschlossen hätten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
