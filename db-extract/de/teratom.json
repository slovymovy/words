                                        "examples": [
                                            {
                                                "example_id": "07719637-cc28-46a1-a328-3b2b6692d6e1",
                                                "sense_id": "cee681d2-219b-3170-aff5-5e0db1a46e26",
                                                "text": "‘What is a teratoma?’ asked Jack, holding the object in his hand. ‘A kind of grenado?’ ‘It is an inward wen, a tumour: we find them, occasionally, in the abdominal cavity. Sometimes they contain long black hair, sometimes a set of teeth: this has both hair and teeth.’"
                                            }
                                        ]
