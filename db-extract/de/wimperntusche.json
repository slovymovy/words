                    },
                    {
                        "form_id": "fcd461cc-0551-4ba8-81b9-8a8b52774830",
                        "entry_id": "112f41c7-b5a1-33b4-87fc-b665aa737563",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wimperntuschen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ecc4e08-5f10-3c64-9778-d01eed16826b",
                        "entry_id": "112f41c7-b5a1-33b4-87fc-b665aa737563",
                        "glosses": [
                            "deckende Farbe, die speziell dazu hergestellt wird, um in Augennähe Haare (Wimpern, Augenbrauen) vorübergehend zu färben"
                        ],
                        "tags": [
                            "Kosmetik"
                        ],
                        "examples": [
                            {
                                "example_id": "26658b0f-47ab-4902-a907-850948dca27b",
                                "sense_id": "6ecc4e08-5f10-3c64-9778-d01eed16826b",
                                "text": "„Ihre Wimpern waren vor lauter Wimperntusche verklebt.“"
                            },
                            {
                                "example_id": "b7f07ee1-188e-4105-9a0f-fc0597491292",
                                "sense_id": "6ecc4e08-5f10-3c64-9778-d01eed16826b",
                                "text": "Wasserfeste Wimperntusche zu entfernen, kann sehr schwierig sein."
                            },
                            {
                                "example_id": "b164a2cf-7d56-4dbc-a8b9-0a2e2189b475",
                                "sense_id": "6ecc4e08-5f10-3c64-9778-d01eed16826b",
                                "text": "„Ihre Augen waren gerötet, und um die Augen herum hatte sich die Wimperntusche in schwarzen ungeordneten Flecken ausgebreitet.“"
                            },
                            {
                                "example_id": "98062e8d-0c06-4c60-b139-8916e20fb735",
                                "sense_id": "6ecc4e08-5f10-3c64-9778-d01eed16826b",
                                "text": "„Ganz oben lagen ein gestrickter Schal, ein schwarzer Kinderhandschuh und Wimperntusche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96c170bf-315d-421b-94a4-6a3e96f44610",
                        "source_entry_id": "112f41c7-b5a1-33b4-87fc-b665aa737563",
                        "source_sense_id": "6ecc4e08-5f10-3c64-9778-d01eed16826b",
