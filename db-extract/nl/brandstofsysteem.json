                        "examples": [
                            {
                                "example_id": "e6e9c3ea-63f5-4eca-8bd5-f8f631af1f4a",
                                "sense_id": "08ece1cd-cf00-352e-bde4-999c3d292f88",
                                "text": "De Italiaanse fabrikant van sportwagens Lamborghini roept wereldwijd duizenden auto's terug vanwege brandgevaar. Er zijn problemen met het brandstofsysteem, waardoor er benzine in de uitlaat kan komen. De benzinedampen kunnen ontbranden als ze in contact komen met de hete uitlaatgassen."
                            },
                            {
                                "example_id": "8bd85477-8700-4551-a31f-5f1d1a2f355f",
                                "sense_id": "08ece1cd-cf00-352e-bde4-999c3d292f88",
                                "text": "Al vrij snel na de lancering ging het mis. Progress 59 (ook bekend onder de Russische naam Progress M-27M) stuurt geen gegevens terug naar de aarde waardoor het niet duidelijk is of de antennes zijn uitgeklapt en of het brandstofsysteem onder druk is gebracht. Dat laatste is nodig om de capsule naar het ISS te brengen."
                            }
                        ]
