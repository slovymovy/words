                                        "examples": [
                                            {
                                                "example_id": "e8997b1e-3834-46f0-8873-49af586dc3b7",
                                                "sense_id": "41701c70-67ea-3c7f-908e-ba667ae17445",
                                                "text": "„Mit zwei kraftvollen Parts in zwei stimmungsvollen Einaktern nimmt Fritz Muliar derzeit Abschied von seinem Publikum in den Kammerspielen.“"
                                            },
                                            {
                                                "example_id": "43f4b280-c1bf-46f3-adc3-83ec205e0069",
                                                "sense_id": "41701c70-67ea-3c7f-908e-ba667ae17445",
                                                "text": "„Theodor Gottlieb von Hippel hat in einem Einakter »Der Mann nach der Uhr« Green und seine penetrante Pünktlichkeit gemeint, aber auch an Kant gedacht.“"
                                            }
                                        ],
