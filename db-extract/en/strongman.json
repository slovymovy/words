{
    "word": "strongman",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                "word": "strongman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "528ace1c-2a6a-47ce-a8f7-18e92da7544b",
                        "entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                        "tags": [
                            "plural"
                        ],
                        "form": "strongmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1a6ff3c-cced-394d-9603-ac3ceecf9376",
                        "entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                        "glosses": [
                            "A man who performs feats of strength, as in competitions or as an attraction in a circus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a8095d4-7854-44a6-865c-3a5caae14f2e",
                                "sense_id": "d1a6ff3c-cced-394d-9603-ac3ceecf9376",
                                "text": "Giovanni Battista Belzoni, the famous Egyptian archeologist, who was a man of gigantic stature, began his public career as a strongman at the Bartholomew Fair, under the management of Gyngell, the conjuror, who dubbed him The Young Hercules."
                            },
                            {
                                "example_id": "f69313b4-1e3e-46be-99b9-63c9a5489b47",
                                "sense_id": "d1a6ff3c-cced-394d-9603-ac3ceecf9376",
                                "text": "Opposite him was the Fat Lady, red-faced and laughing. Beside her, the India-rubber Man wound spaghetti on to a fork with an expression of deepest melancholy. Further down the table, the Strong Man, an overcoat covering his leopard-skin, talked garrulously."
                            }
                        ]
                    },
                    {
                        "sense_id": "254392e0-4666-3085-adb5-33c470a67d92",
                        "entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                        "glosses": [
                            "A forceful or brutal person, usually a ruler or tyrant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "539bab71-df90-474a-867d-738f51a31970",
                                "sense_id": "254392e0-4666-3085-adb5-33c470a67d92",
                                "text": "Since the Cold War’s end, a staggering 70 percent of governments headed by strongmen collapsed after the ruler departed, according to one data set."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "377578d6-d9a6-4a68-a539-349155882815",
                        "source_entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                        "source_sense_description": "one who performs feats of strength",
                        "target_lang_word": "Muskelmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskelmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                        "entry_id": "1ac32c8e-d73f-39f8-a5a6-c704f8b67c81",
                                        "glosses": [
                                            "Mann mit besonders ausgeprägten, trainierten Muskeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72007dce-3f73-453e-b85d-69bb8a4472f7",
                                                "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                                "text": "„Ein chromblitzender Geländewagen mit einer auffälligen Werbeaufschrift wurde von einem braungebrannten Muskelmann aus einer Ausfahrt gesteuert.“"
                                            },
                                            {
                                                "example_id": "a7c4cb28-b483-4642-ab43-6a9f447ece5c",
                                                "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                                "text": "„Ohne auch nur einen Augenblick zu zögern, ließ ihn der Muskelmann herein.“"
                                            },
                                            {
                                                "example_id": "e978450f-adb8-4201-8fcc-205c9298104d",
                                                "sense_id": "deaa70e2-650e-3504-851d-0539dc6e0f4a",
                                                "text": "„Zwei Muskelmänner, die sonst wahrscheinlich beim Bestattungsinstitut Pietät-Meyer arbeiten, tragen die Torte rein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
