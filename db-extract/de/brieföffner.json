                        "sense_id": "a1f7e8b4-82a8-3900-b480-a9478e5e8560",
                        "entry_id": "2ac44b55-de6a-344b-8170-28575a0223ed",
                        "glosses": [
                            "messerartiger Gegenstand zum Öffnen von Briefumschlägen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3833fc4c-94b3-412a-b366-f6dc1ef10a7e",
                                "sense_id": "a1f7e8b4-82a8-3900-b480-a9478e5e8560",
                                "text": "Ich öffne alle Umschläge mit einem Brieföffner, den ich in meiner Schreibtischschublade aufbewahre."
                            },
                            {
                                "example_id": "a496f0a9-269a-4f45-95b7-f9ad5a348dbf",
                                "sense_id": "a1f7e8b4-82a8-3900-b480-a9478e5e8560",
                                "text": "Die Mordwaffe war ein antiker Brieföffner."
                            },
                            {
                                "example_id": "7ebcc796-23ac-46cb-bad3-9bff61c051b2",
                                "sense_id": "a1f7e8b4-82a8-3900-b480-a9478e5e8560",
                                "text": "„Als Fürst Andrej ins Zimmer kam, legte er einen Brieföffner als Zeichen hinein und klappte es zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
