                                    {
                                        "sense_id": "694fcd0e-bb88-3aa5-a0eb-bc6093666a67",
                                        "entry_id": "025e697c-484a-382f-87c7-ef3d0f0947a0",
                                        "glosses": [
                                            "Celui qui exerce l’art de teindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac7e38b-db6d-44a5-a0b6-5a2aa72617f2",
                                                "sense_id": "694fcd0e-bb88-3aa5-a0eb-bc6093666a67",
                                                "text": "Envoyer du drap au teinturier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90cd0e3-18dd-3db5-a60b-0344b95c29a4",
                                        "entry_id": "025e697c-484a-382f-87c7-ef3d0f0947a0",
                                        "glosses": [
                                            "Personne qui exerce dans un pressing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaadaebc-dd87-4094-8363-b9e825e42a0b",
                                                "sense_id": "d90cd0e3-18dd-3db5-a60b-0344b95c29a4",
                                                "text": "Je vous enverrai la note du teinturier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f98d5dc-a570-30f1-9666-cd9ab8a09d5c",
                                        "entry_id": "025e697c-484a-382f-87c7-ef3d0f0947a0",
                                        "glosses": [
                                            "Personne anonyme qui rédige, ou modifie substantiellement, un livre qui sera publié au nom d’une autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39167182-82e3-4397-8dff-8ae7b37eb3a0",
                                                "sense_id": "5f98d5dc-a570-30f1-9666-cd9ab8a09d5c",
                                                "text": "Chacun a contre nous sa chanson, ses bons mots ;\nL’un, ignorant et sot, vient, avec ironie,\nNous citer de Molière un vers qu’il estropie ;\nL’autre, vain par système et jaloux par métier,\nDit d’un air dédaigneux : Elle a son teinturier."
                                            },
                                            {
                                                "example_id": "ad80d424-9a9c-4d5f-8c30-f1ab7c75479a",
                                                "sense_id": "5f98d5dc-a570-30f1-9666-cd9ab8a09d5c",
                                                "text": "Peu importe que ce soient des « teinturiers » — des « nègres » dirait-on aujourd’hui — qui aient tenu la plume."
                                            }
                                        ]
                                    }
                                ]
                            },
