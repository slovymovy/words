                "senses": [
                    {
                        "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                        "entry_id": "b832ccf2-9d29-3bfc-883b-c309da6b8ea5",
                        "glosses": [
                            "Hilfsmittel zur Bestimmung des Schriftgrads"
                        ],
                        "tags": [
                            "Typografie"
                        ],
                        "examples": [
                            {
                                "example_id": "ee8b8adf-e7e5-4c55-8f08-22d5ccc03afa",
                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                "text": "„Der Diensthabende musste mit einem Blatt Papier, einem Typometer und einem Bleistift als Hilfsmitteln auskommen.“"
                            },
                            {
                                "example_id": "1546f15d-4d56-4ec5-8e63-d4ff33b1a44d",
                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                "text": "„Wenn Sie gerade kein Typometer zur Hand haben, aber für dieses Buch Schriften messen sollen, können Sie diese Skala verwenden.“"
                            },
                            {
                                "example_id": "326fc4cd-88a3-4032-b9fa-dc528d942699",
                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                "text": "„Zum möglichst genauen Justieren ist ein eigenes Instrument, der Typometer, erfunden worden.“"
                            },
                            {
                                "example_id": "831cd0f0-1a26-49e8-a90f-8a3d71d39ae0",
                                "sense_id": "9c79364a-2194-3358-ba1c-65b438b879d7",
                                "text": "„Speziell für DTP-Setzer wurde ein Typometer entwickelt, das auf die Besonderheiten des DTP-Maßsystems eingeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
