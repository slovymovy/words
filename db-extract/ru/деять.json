                "senses": [
                    {
                        "sense_id": "b0ecda6f-8b3e-3a9d-94d9-454fc6c8a566",
                        "entry_id": "fca6b865-018e-3dbe-9997-ee6c160d3a05",
                        "glosses": [
                            "старин., поэт. делать, совершать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b77d8b91-b0fc-4586-b67c-e1aa6c1da877",
                                "sense_id": "b0ecda6f-8b3e-3a9d-94d9-454fc6c8a566",
                                "text": "Не терпел он ловы деять, потому что на ловах туры, олени и лоси рогами бодают, медведи кости ломают, вепри живота не щадят."
                            },
                            {
                                "example_id": "467ee93f-e08d-4e05-837d-78cd610b3d6a",
                                "sense_id": "b0ecda6f-8b3e-3a9d-94d9-454fc6c8a566",
                                "text": "Так! Все мы помнили — но волил он, и деял. // Как зодчий тайн, Хирам, он таинство посеял, // И Море Медное отлил среди двора."
                            }
                        ]
                    }
                ],
