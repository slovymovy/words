                        "entry_id": "43a8eea3-de07-3b39-a242-303b3463c634",
                        "glosses": [
                            "Not adoptable; unadoptable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1947f5-12f6-4523-a71b-b740b6a1d49c",
                                "sense_id": "c9a25df9-8a61-37c6-aa2b-19b57b489751",
                                "text": "There are some case situations, relatively few in number, where the child is known to be nonadoptable, but it would be exceedingly burdensome for the natural parent to have the relationship continued."
                            },
                            {
                                "example_id": "0bb7f41b-5845-4933-944a-955df62e2ef7",
                                "sense_id": "c9a25df9-8a61-37c6-aa2b-19b57b489751",
                                "text": "In the case of the nonadoptable child, there are no adoptive benefits against which the court can weigh the benefits flowing from the parental relationships."
                            },
                            {
                                "example_id": "9b3f1d48-275b-4321-a96d-24083a28304b",
                                "sense_id": "c9a25df9-8a61-37c6-aa2b-19b57b489751",
                                "text": "While never exact, “nonadoptability” fused the racial, the social, and the moral to render certain kinds, and colours, of children permanently nonadoptable."
                            }
                        ]
                    }
