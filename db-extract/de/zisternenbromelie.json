                "senses": [
                    {
                        "sense_id": "2f00e32a-f1a2-3df4-8fe8-738834620a43",
                        "entry_id": "78c8b263-159a-34f5-9cb0-bf7a7aea155c",
                        "glosses": [
                            "Vertreter von epiphytischen Bromelien, deren Blätter an der Blattbasis dicht aneinander schließen und so Zisternen bilden, in denen sich Regenwasser und Staub sammelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9505488-f798-4e48-bf60-2e2377460b39",
                                "sense_id": "2f00e32a-f1a2-3df4-8fe8-738834620a43",
                                "text": "„Es handelt sich um eine Trichterbromelie, auch Zisternenbromelie genannt, die Blätter stehen dicht gedrängt an einer gestauchten Sprossachse und bilden einen relativ wasserdichten, schmalen Trichter (die Zisterne), in denen sie aus Niederschlägen Wasser sammeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
