        "fr-extract.jsonl": [
            {
                "entry_id": "ae0fade7-5818-3259-943b-5a941f92aba3",
                "word": "vaillamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70389705-9227-3cbf-8d75-e04157a0653b",
                        "entry_id": "ae0fade7-5818-3259-943b-5a941f92aba3",
                        "glosses": [
                            "D’une manière vaillante ; avec vaillance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34526ae-11ca-44e7-8833-31a379be9dda",
                                "sense_id": "70389705-9227-3cbf-8d75-e04157a0653b",
                                "text": "Les Abydéniens n'avaient qu’un de ces deux partis à prendre, ou de se rendre à discrétion, ou de continuer à se défendre vaillamment,"
                            },
                            {
                                "example_id": "8fce703a-63d0-4e5c-a25d-4d67e3a743a9",
                                "sense_id": "70389705-9227-3cbf-8d75-e04157a0653b",
                                "text": "Je sais par vos blessures et par les miennes, leur dit Charles XII, que nous avons vaillamment combattu ensemble ; vous avez fait votre devoir jusqu'à présent, faites-le encore aujourd'hui,"
                            },
                            {
                                "example_id": "f9021234-ee9a-4b18-81f4-875fb600695c",
                                "sense_id": "70389705-9227-3cbf-8d75-e04157a0653b",
                                "text": "Nous te chargeons, mon frère, […], de te battre vaillamment, et nous ne doutons pas que la bonne cause ne triomphe."
                            },
                            {
                                "example_id": "7dd04a12-6723-4427-87d0-10948dfc68f7",
                                "sense_id": "70389705-9227-3cbf-8d75-e04157a0653b",
                                "text": "Si les Spinaliens soutinrent vaillamment un siège contre Charles le Téméraire, il n'en fut pas de même, deux siècles plus tard, quand Louis XIV déploya contre eux ses forces […]."
                            },
                            {
                                "example_id": "9f89adaf-f476-4193-98fb-12d1bab720af",
                                "sense_id": "70389705-9227-3cbf-8d75-e04157a0653b",
                                "text": "L'accident n'avait en rien entamé la bonne humeur des convives qui attaquaient vaillamment le plateau de fromages bourguignons : clacbitou, chaource, époisses, trou du cru, soumaintrain... Quoique grand amateur de fromages, Adrien n'y toucha pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71a32188-30c6-4bc9-b6ba-62e996e972a4",
                        "source_entry_id": "ae0fade7-5818-3259-943b-5a941f92aba3",
                        "source_sense_id": "70389705-9227-3cbf-8d75-e04157a0653b",
                        "target_lang_word": "valiantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valiantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6731b9a-3137-3ce0-8399-300b6de3b0f9",
                                        "entry_id": "bd97f98b-1693-3c44-9235-6f848d3d412a",
                                        "glosses": [
                                            "In a valiant manner; showing bravery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ad1bcd-8b3a-4e29-a46b-04f98f10ff63",
                                                "sense_id": "e6731b9a-3137-3ce0-8399-300b6de3b0f9",
                                                "text": "I valiantly resolve not to go to bed at all, but to walk up and down the pier till morning."
                                            },
                                            {
                                                "example_id": "952b67cd-8468-4af0-8985-af310ba375ff",
                                                "sense_id": "e6731b9a-3137-3ce0-8399-300b6de3b0f9",
                                                "text": "We may think of the young people who valiantly stood for the cause of human rights and resisted their infringement, in spite of the violent crackdown by the Chinese regime at T’ien-an-men Square in June 1989."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c4b2eb2-4b06-4d49-ab41-a36cdd1afe02",
                        "source_entry_id": "ae0fade7-5818-3259-943b-5a941f92aba3",
