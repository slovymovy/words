                    }
                ],
                "translations": [
                    {
                        "translation_id": "14beac9e-3d55-4064-a23a-598d0251ef09",
                        "source_entry_id": "8ddcadf3-8702-3763-b5b9-40095028cd1e",
                        "target_lang_word": "Fuge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fuge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01fbf440-ec19-35de-93b2-a0ceb0477cb6",
                                        "entry_id": "90447791-51aa-3953-a66f-a8765b8f0fe9",
                                        "glosses": [
                                            "trennende, längliche, unter Umständen auch aufgefüllte Lücke, Spalt zwischen zwei Teilen, zum Beispiel Backsteinen oder Kacheln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d80e7efa-7a47-4fb6-986e-bf2c43c21d9a",
                                                "sense_id": "01fbf440-ec19-35de-93b2-a0ceb0477cb6",
                                                "text": "Die Kakerlaken haben sich in der Fuge versteckt."
                                            },
                                            {
                                                "example_id": "e037c136-f1cd-437b-8c6d-efd5656e8200",
                                                "sense_id": "01fbf440-ec19-35de-93b2-a0ceb0477cb6",
                                                "text": "„Die Fugen wurden mit getrocknetem Seetang verstopft, den Pechanstrich lieferten Kiefern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4269ecaf-f072-326b-b156-3e86df347442",
                                        "entry_id": "90447791-51aa-3953-a66f-a8765b8f0fe9",
                                        "glosses": [
                                            "kurz für Kompositionsfuge, Zusammensetzungsfuge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa997f57-c47f-4b4d-a60d-cc7b4a2117bc",
                                                "sense_id": "4269ecaf-f072-326b-b156-3e86df347442",
                                                "text": "Das „-s“ in dem Wort „Arbeit-s-amt“ ist eine Fuge."
                                            },
                                            {
                                                "example_id": "9fb7f445-4215-4962-b957-56aef142b39c",
                                                "sense_id": "4269ecaf-f072-326b-b156-3e86df347442",
                                                "text": "In der Linguistik ist umstritten, ob die Fuge lediglich eine lautliche Erscheinung ist, die der Ausspracheerleichterung dient, oder ob sie eine Bedeutung trägt und damit als Morphem (bedeutungstragender Wortteil) zu betrachten ist."
                                            },
                                            {
                                                "example_id": "77ea3579-481f-4035-bbd5-a3772ea73021",
                                                "sense_id": "4269ecaf-f072-326b-b156-3e86df347442",
                                                "text": "Zu Fällen wie „Aschbecher“, „Ascheimer“: „Hier wird wegen des fehlenden Buchstabens e von einer subtraktiven Fuge gesprochen.“ Eisenberg nennt diese Art von Fugen ganz ähnlich Subtraktionsfuge."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15e4de73-88e0-397c-891b-6c9921eb9eeb",
                                        "entry_id": "90447791-51aa-3953-a66f-a8765b8f0fe9",
                                        "glosses": [
                                            "mehrstimmiges Musikstück, bei dem ein oder mehrere Themen hintereinander in allen Stimmen vorkommen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d75a69e5-1f44-49e8-969a-ad2d72cb5141",
                                                "sense_id": "15e4de73-88e0-397c-891b-6c9921eb9eeb",
                                                "text": "Johann Sebastian Bach schrieb wunderbare Fugen."
                                            },
                                            {
                                                "example_id": "d34a8774-8a40-4c94-89d3-cb6577fb0f64",
                                                "sense_id": "15e4de73-88e0-397c-891b-6c9921eb9eeb",
                                                "text": "„Der Kanon ist eng mit der sich durch freiere Imitation auszeichnenden Fuge verwandt und kann auch als Sonderfall der Fuge angesehen werden.“"
                                            },
                                            {
                                                "example_id": "4c96cb0b-c13c-4ffd-9cb3-5affe6418593",
                                                "sense_id": "15e4de73-88e0-397c-891b-6c9921eb9eeb",
                                                "text": "„Es war das, was man als Fuge bezeichnet – freilich hatte Petja keine Ahnung davon, was eine Fuge ist.“"
                                            },
                                            {
                                                "example_id": "e96ebf95-8129-4af5-9ee1-ab15a439f62f",
                                                "sense_id": "15e4de73-88e0-397c-891b-6c9921eb9eeb",
                                                "text": "„Ich habe die Präludien und Fugen in C-Dur, C-moll, D-Dur und D-moll gespielt, da aber ist Papa in den kleinen Saal gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
