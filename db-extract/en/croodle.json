                        "examples": [
                            {
                                "example_id": "031d8c1d-bd28-45ad-b921-b7f02a13e387",
                                "sense_id": "bcd19f18-393f-3d68-b98a-99b74b7c8582",
                                "text": "Too dark to see well, but judge from movements of old bird's head and croodling noise."
                            },
