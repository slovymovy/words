                        "target_lang_word": "basilecte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basilecte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c32d6da-5dbf-32f8-a1fd-eded937b2633",
                                        "entry_id": "ae9b384f-c032-36c0-be1d-0c29cb947ced",
                                        "glosses": [
                                            "Langue considérée, au regard de la langue standard (l'acrolecte), comme étant populaire, vulgaire, de base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a4678f-6d20-4cbd-9e3d-fde607258b0e",
                                                "sense_id": "7c32d6da-5dbf-32f8-a1fd-eded937b2633",
                                                "text": "Prudent introduit donc la notion d’interlecte qu’il propose pour décrire les variétés intermédiaires entre l’acrolecte et le basilecte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dd55d94-ae53-4e6f-9434-c8f1bb6cfa79",
                        "source_entry_id": "2ecfd4fa-761f-35f2-b827-e45966940e7b",
                        "source_sense_id": "3a04c678-2fe2-3ba8-86c6-b37f864618b9",
                        "source_sense_description": "variety of a language that has diverged greatly from the standard form",
                        "target_lang_word": "Basilekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basilekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c873033c-e1fb-3720-bf93-0a2620e038da",
                                        "entry_id": "63f0690b-ab49-3f6c-b0cc-5e8a29ec0b03",
                                        "glosses": [
                                            "Sprachvarietät, die nur ein sehr geringes kommunikatives Niveau bietet, am weitesten von dem Niveau einer Standardsprache entfernt ist und das geringste Prestige hat"
                                        ],
                                        "tags": [
                                            "Soziolinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b74025d-7c46-4953-bf8b-9fef7e150d1b",
                                                "sense_id": "c873033c-e1fb-3720-bf93-0a2620e038da",
                                                "text": "„Dabei wird das Französische von einem Großteil der Bevölkerung als Basilekt gebraucht und kann starke Interferenzen mit der Muttersprache aufweisen.“"
                                            },
                                            {
                                                "example_id": "61b596c1-23c4-41fd-b8c4-a71869eeaedc",
                                                "sense_id": "c873033c-e1fb-3720-bf93-0a2620e038da",
                                                "text": "„Dies ist zuerst im Rahmen der Kreolistik gesagt worden, wo zahlreiche Übergangsformen und keine eigentlichen Einschnitte zwischen den verschiedenen Sprachniveaus (Basilekt - Mesolekt(e) - Akrolekt) feststellbar sind.“"
                                            },
                                            {
                                                "example_id": "544270d6-e863-4316-b93a-85c458fe8ea9",
                                                "sense_id": "c873033c-e1fb-3720-bf93-0a2620e038da",
                                                "text": "„Das Kreol wird als Basilekt, die Prestigevarietät als ‚Akrolekt‘ bezeichnet, die Zwischenstufen sind in der Bezeichnung ‚Mesolekt‘ zusammengefasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
