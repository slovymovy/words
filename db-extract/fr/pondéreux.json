                    }
                ],
                "senses": [
                    {
                        "sense_id": "737dc84c-f410-3989-a7a7-d0bea5c880e0",
                        "entry_id": "5899202f-58e3-32b4-86ca-8fd377de6f4c",
                        "glosses": [
                            "Très lourd."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da6f0dfe-c1a1-434a-9bae-d009dbc696e8",
                                "sense_id": "737dc84c-f410-3989-a7a7-d0bea5c880e0",
                                "text": "Le compliment était de taille et trop pondéreux à supporter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a17b74d-ac4e-40ea-abc6-a60da06357c9",
                        "source_entry_id": "5899202f-58e3-32b4-86ca-8fd377de6f4c",
                        "source_sense_id": "737dc84c-f410-3989-a7a7-d0bea5c880e0",
                        "target_lang_word": "ponderous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponderous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a598c189-8580-3dc6-8e0c-c34b3a54e52b",
                                        "entry_id": "446b1a83-12c7-3ade-8b6e-8fb8f40f4108",
                                        "glosses": [
                                            "Heavy, massive, weighty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5104980c-98e5-480a-abcf-69efef3a31c2",
                                                "sense_id": "a598c189-8580-3dc6-8e0c-c34b3a54e52b",
                                                "text": "[H]e saw, at the end of a shallow embrasure, a ponderous door of dark wood, braced with iron."
                                            },
                                            {
                                                "example_id": "cb64b0d3-2edc-477d-9eb1-5c0ace25d562",
                                                "sense_id": "a598c189-8580-3dc6-8e0c-c34b3a54e52b",
                                                "text": "The great elephant, when the cage was being placed, would, at a signal from its keeper, place its ponderous head against one side of the cage and push."
                                            },
                                            {
                                                "example_id": "0ea711a5-91de-4933-8ec9-f3c6d7de84cc",
                                                "sense_id": "a598c189-8580-3dc6-8e0c-c34b3a54e52b",
                                                "text": "Set against the background of the American civil war, with Keaton a cunning but unskilled driver, unaided, of the ponderous giant of a locomotive, it remains not only probably the funniest film about railways ever made, but one of the funniest silent films to retain its comic power over today's more sophisticated audiences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c7e5c57-2e43-3722-b631-3d3a19ce8280",
                                        "entry_id": "446b1a83-12c7-3ade-8b6e-8fb8f40f4108",
                                        "glosses": [
                                            "Serious, onerous, oppressive."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0011eb0-d560-406c-a5f3-f4f98f18205a",
                                                "sense_id": "6c7e5c57-2e43-3722-b631-3d3a19ce8280",
                                                "text": "It was Dryden's opinion . . . that the drama required an alternation of comick and tragick scenes; and that it is necessary to mitigate, by alleviations of merriment, the pressure of ponderous events, and the fatigue of toilsome passions."
                                            },
                                            {
                                                "example_id": "b5d2c2bb-c84d-4dcf-a844-8518301ea421",
                                                "sense_id": "6c7e5c57-2e43-3722-b631-3d3a19ce8280",
                                                "text": "In its court-yard—worthy of the Castle of Otranto in its ponderous gloom—is a massive staircase."
                                            },
                                            {
                                                "example_id": "a86483bf-38cd-429e-b6d4-03348daab582",
                                                "sense_id": "6c7e5c57-2e43-3722-b631-3d3a19ce8280",
                                                "text": "For the time, her own body was the source of all the life in the world, which tried to burst forth here—there—and was repressed now by Mr. Bax, now by Evelyn, now by the imposition of ponderous stupidity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea7a9a6-a646-3311-b7d3-2b9dfcb6ab2e",
                                        "entry_id": "446b1a83-12c7-3ade-8b6e-8fb8f40f4108",
                                        "glosses": [
                                            "Clumsy, unwieldy, or slow, especially due to weight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b91b257-de19-42b3-9d92-49db0e82bac0",
                                                "sense_id": "5ea7a9a6-a646-3311-b7d3-2b9dfcb6ab2e",
                                                "text": "[T]he inmates of the coach, by numerous hard, painful joltings, and ponderous, dragging trundlings, are suddenly made sensible of some great change in the character of the road."
                                            },
                                            {
                                                "example_id": "fd1b98ba-77aa-4631-8dcb-f0b7a96bd17b",
                                                "sense_id": "5ea7a9a6-a646-3311-b7d3-2b9dfcb6ab2e",
                                                "text": "Slowly, through an increasing glow that lighted land and water alike, the leviathan of the deep made her ponderous progress to the hill-encircled harbor."
                                            },
                                            {
                                                "example_id": "50bc070e-2538-4dbd-9ad9-6ca042fb060f",
                                                "sense_id": "5ea7a9a6-a646-3311-b7d3-2b9dfcb6ab2e",
                                                "text": "Following his steps . . . came two elderly women of the lower middle class, one stout and ponderous, the other rosy cheeked and nimble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c58e106-1d18-306b-878c-379a397edaa5",
                                        "entry_id": "446b1a83-12c7-3ade-8b6e-8fb8f40f4108",
                                        "glosses": [
                                            "Dull, boring, tedious; long-winded in expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c47716-ae3c-40d0-a88f-46a0cd1a62b3",
                                                "sense_id": "0c58e106-1d18-306b-878c-379a397edaa5",
                                                "text": "Over supper the minister did unbend a little into one or two ponderous jokes."
                                            },
                                            {
                                                "example_id": "b68b7ae8-36c4-440f-8871-79907059c2b0",
                                                "sense_id": "0c58e106-1d18-306b-878c-379a397edaa5",
                                                "text": "[A]s certainly as any one said anything in her presence that she had occasion to repeat, she changed the wording to six-syllabled mouthfuls, delivered with ponderous circumlocution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3c81900-df31-3ad0-87af-b56492884698",
                                        "entry_id": "446b1a83-12c7-3ade-8b6e-8fb8f40f4108",
                                        "glosses": [
                                            "Characterized by or associated with pondering."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4824898f-6899-4605-bfe1-a6e255102aa4",
                                                "sense_id": "c3c81900-df31-3ad0-87af-b56492884698",
                                                "text": "Ponderous thoughts take hold of the heart; musing maketh the fire to burn, and steady sight hath the greatest influence upon us."
                                            },
                                            {
                                                "example_id": "02dd2df1-125a-4a70-a028-3dcc68c2a240",
                                                "sense_id": "c3c81900-df31-3ad0-87af-b56492884698",
                                                "text": "The acute and ponderous mind of Dr. Johnson was not always right in its decisions."
                                            },
                                            {
                                                "example_id": "a9b28f81-48bf-4afb-b3f0-91eba6352320",
                                                "sense_id": "c3c81900-df31-3ad0-87af-b56492884698",
                                                "text": "They are the pleasantest of all companions, and perhaps the most affluent in correct opinions of men and things generally, although little addicted to ponderous consideration or deep research."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f3bf285-679b-3549-adbc-fcf12a9dfdd8",
                                        "entry_id": "446b1a83-12c7-3ade-8b6e-8fb8f40f4108",
                                        "glosses": [
                                            "Dense."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "f98f9250-5d40-328c-bc63-2777a8050322",
                "word": "pondéreux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "92a5e7d1-9636-324d-a1bd-d7f3481983ac",
                        "entry_id": "f98f9250-5d40-328c-bc63-2777a8050322",
                        "glosses": [
                            "Matériaux ou produits dont la densité est importante, en général dépassant les mille kilogrammes par mètre cube, soit d’une densité supérieure à un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70adc65b-5a56-40e2-95f2-ee5e9240febc",
                                "sense_id": "92a5e7d1-9636-324d-a1bd-d7f3481983ac",
                                "text": "Aux États-Unis d’Amérique, le chemin de fer sert surtout au transport des pondéreux."
                            },
                            {
                                "example_id": "ff2f78d3-1cb3-4229-bd7f-8b5b4963b421",
                                "sense_id": "92a5e7d1-9636-324d-a1bd-d7f3481983ac",
                                "text": "Les pondéreux sont donc astreints à n’employer que des moyens de transport très économiques, surtout s’ils franchissent de longues distances."
                            }
                        ]
                    }
                ],
