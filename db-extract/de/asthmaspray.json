                "senses": [
                    {
                        "sense_id": "5fc73c94-3f00-3900-841f-99d37e285a5a",
                        "entry_id": "26111741-4ac6-348e-a6d7-b9d09521c245",
                        "glosses": [
                            "eine Flüssigkeit oder ein Pulver, das mit einem Gerät in feinste Tröpfchen/Teilchen zerstäubt und durch den Mund tief in die Lunge eingeatmet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef4f6db-cfb2-4158-9903-424d92b922a5",
                                "sense_id": "5fc73c94-3f00-3900-841f-99d37e285a5a",
                                "text": "„Ich benötige Asthmaspray um überhaupt Sport machen zu können.“"
                            },
                            {
                                "example_id": "26958b51-dabe-4bc4-8c7f-a71df390e8e0",
                                "sense_id": "5fc73c94-3f00-3900-841f-99d37e285a5a",
                                "text": "Asthmasprays weiten die Bronchien und erhöhen damit die Sauerstoffaufnahme. Deswegen sind sie auch ein Dopingmittel."
                            },
                            {
                                "example_id": "120b6790-96fe-4c96-8ff3-1113a219bf5c",
                                "sense_id": "5fc73c94-3f00-3900-841f-99d37e285a5a",
                                "text": "Für Asthmatiker bietet die Pharmaindustrie Medikamente an, die in Tascheninhalatoren abgefüllt sind - sogenannte „Asthmasprays“. Durch einen Pumpmechanismus wird das Medikament vernebelt und kann bei einem akuten Asthmaanfall ambulant angewendet werden."
                            },
                            {
                                "example_id": "183200d1-7033-43cf-a837-56d7faef9606",
                                "sense_id": "5fc73c94-3f00-3900-841f-99d37e285a5a",
                                "text": "Alkoholkontrollen können für Asthmatiker böse enden: Die Einnahme von Asthmaspray erhöht den Atemalkoholwert und kann damit zu falschen Messwerten führen, wie eine Untersuchung der Universität Magdeburg ergab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
