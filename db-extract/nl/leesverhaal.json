                        "entry_id": "c08faf7c-b19a-3e7c-9333-469db58e3d06",
                        "glosses": [
                            "een opgeschreven geschiedenis die geschikt is om door een kind zelf gelezen te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
