                        "glosses": [
                            "A person or thing found by the wayside."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b22deb-6c54-4ebe-a38f-2ccc38a382a1",
                                "sense_id": "c0bbfec6-5aba-32b3-abce-e8f1e498882a",
                                "text": "Erysimum cheiranthoides and Sinapis nigra grow in cornfields here as everywhere else; although some writer in the 'Phytologist' says it, S. nigra, is not a field plant but a waysider."
                            },
                            {
                                "example_id": "c12eedf0-267e-49f7-94b0-a8ebb6e5b058",
                                "sense_id": "c0bbfec6-5aba-32b3-abce-e8f1e498882a",
                                "text": "The charioteer says to a waysider: \"How far is it to Elisha's house?\""
                            },
                            {
                                "example_id": "fccdcfe3-0192-4061-a6af-2c0a533dbb50",
                                "sense_id": "c0bbfec6-5aba-32b3-abce-e8f1e498882a",
                                "text": "At the other end of the hall was what I took for the dining room. A waysider had recently spent the night."
                            }
                        ]
