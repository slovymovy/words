                                        "examples": [
                                            {
                                                "example_id": "3f703911-8407-4b2f-b7a7-a46773ac7110",
                                                "sense_id": "50ab89cf-b664-39d8-9a33-c2e3776482a6",
                                                "text": "Ich vergesse oft die Filtertüte mit dem Kaffeesatz in der Kaffeemaschine."
                                            },
                                            {
                                                "example_id": "73b5f9f9-5717-40e5-8fc9-4c287e545568",
                                                "sense_id": "50ab89cf-b664-39d8-9a33-c2e3776482a6",
                                                "text": "Mein Mann trinkt seinen Kaffee auf türkische Art und stellt seinen Kaffeebecher danach immer mitsamt dem Kaffeesatz in die Spüle."
                                            },
                                            {
                                                "example_id": "e3cba293-eb9e-43f7-bad4-2d30e67d0d6d",
                                                "sense_id": "50ab89cf-b664-39d8-9a33-c2e3776482a6",
                                                "text": "„Sie trank den letzten Schluck Kaffee und hielt die Tasse schräg, damit der Kaffeesatz kurz an der Seitenwand trocknen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
