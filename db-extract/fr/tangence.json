                    },
                    {
                        "sense_id": "abb80e7f-2b79-3495-8f78-49a09dc5491f",
                        "entry_id": "a2952a16-bfb8-3c33-b950-21df141b5bfb",
                        "glosses": [
                            "Correspondance limite entre deux pensées."
