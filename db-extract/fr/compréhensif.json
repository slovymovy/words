                    {
                        "translation_id": "431241cb-55a7-468d-a5ca-b4d0c843b852",
                        "source_entry_id": "57e9f3a6-a7c6-3ce2-85fd-b7e9b58eb701",
                        "source_sense_id": "d2102db1-2b0b-3232-8b23-e35ca0b1f7ce",
                        "source_sense_description": "Capable de comprendre les sentiments d’autrui.",
                        "target_lang_word": "understanding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "understanding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3556a11b-0072-34d6-8cf2-6e4d4872e478",
                                        "entry_id": "fe134c15-bdd2-3797-a9be-cf736e01f62d",
                                        "glosses": [
                                            "The act of one that understands or comprehends; the mental process of discernment of meaning."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5521e14-7eaa-4ce9-a634-5f40f4542760",
                                                "sense_id": "3556a11b-0072-34d6-8cf2-6e4d4872e478",
                                                "text": "There are certain things that defy human understanding."
                                            },
                                            {
                                                "example_id": "e19e561d-8eb7-4ec6-a08a-834aeb76e055",
                                                "sense_id": "3556a11b-0072-34d6-8cf2-6e4d4872e478",
                                                "text": "The Ways of Heav’n are dark and intricate,\nPuzzled in Mazes, and perplext with Errors;\nOur Underſtanding traces ’em in vain,\nLoſt and bewilder’d in the fruitleſs Search; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a060ec6-9fd4-3a3c-be8c-80791fef63e5",
                                        "entry_id": "fe134c15-bdd2-3797-a9be-cf736e01f62d",
                                        "glosses": [
                                            "Reason or intelligence; ability to grasp the full meaning of knowledge; ability to infer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e895f89-74e3-4f01-a6db-eb149a586ef2",
                                                "sense_id": "1a060ec6-9fd4-3a3c-be8c-80791fef63e5",
                                                "text": "She has a solid understanding of particle physics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c856e9cf-00ba-326c-8ddb-180cc2827151",
                                        "entry_id": "fe134c15-bdd2-3797-a9be-cf736e01f62d",
                                        "glosses": [
                                            "Opinion, judgement, or outlook."
                                        ],
                                        "tags": [
                                            "countable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80ff3184-4a8f-48c6-8c57-95618ba4ab16",
                                                "sense_id": "c856e9cf-00ba-326c-8ddb-180cc2827151",
                                                "text": "There is a multitude of theisms, many understandings of God, even within the same religious tradition."
                                            },
                                            {
                                                "example_id": "f73feb36-3c96-4625-a6c1-ffc9930a73d8",
                                                "sense_id": "c856e9cf-00ba-326c-8ddb-180cc2827151",
                                                "text": "It is the goneness of the Holocaust that produces the simultaneous profusion of discourses and understandings; the goneness is what opens up, what spurs, what unleashes the perpetual desire to do, to make, to rethink the Holocaust."
                                            },
                                            {
                                                "example_id": "ab992790-26d8-4a03-8033-5b1ffd056079",
                                                "sense_id": "c856e9cf-00ba-326c-8ddb-180cc2827151",
                                                "text": "The yawning gap in neuroscientists’ understanding of their topic is in the intermediate scale of the brain’s anatomy. Science has a passable knowledge of how individual nerve cells, known as neurons, work. It also knows which visible lobes and ganglia of the brain do what. But how the neurons are organised in these lobes and ganglia remains obscure."
                                            },
                                            {
                                                "example_id": "248b7651-c348-446a-8924-097ad3e32faf",
                                                "sense_id": "c856e9cf-00ba-326c-8ddb-180cc2827151",
                                                "text": "According to my understanding, the situation is quite perilous. I wonder if you see it this way, too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ff19143-57a7-3be3-8e36-d414cd357dca",
                                        "entry_id": "fe134c15-bdd2-3797-a9be-cf736e01f62d",
                                        "glosses": [
                                            "An agreement of minds; harmony; something mutually understood or agreed upon.",
                                            "An informal contract; a mutual agreement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed90800-7ae8-491c-afc0-cdd19e76bd97",
                                                "sense_id": "9ff19143-57a7-3be3-8e36-d414cd357dca",
                                                "text": "I thought we had an understanding - you do the dishes, and I throw the trash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8cf13d0-d2d8-3bd7-bc2e-1304cff5ef5f",
                                        "entry_id": "fe134c15-bdd2-3797-a9be-cf736e01f62d",
                                        "glosses": [
                                            "An agreement of minds; harmony; something mutually understood or agreed upon.",
                                            "A reconciliation of differences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33af5b50-d101-4571-8aca-64deb296874f",
                                                "sense_id": "b8cf13d0-d2d8-3bd7-bc2e-1304cff5ef5f",
                                                "text": "The parties of the negotiation have managed to come to an understanding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21507efb-5dd7-37b9-84b3-97ec1e4b1ba3",
                                        "entry_id": "fe134c15-bdd2-3797-a9be-cf736e01f62d",
                                        "glosses": [
                                            "Sympathy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe0962c1-3cea-4efe-8d48-7ab3a5ea4631",
                                                "sense_id": "21507efb-5dd7-37b9-84b3-97ec1e4b1ba3",
                                                "text": "He showed much understanding for my problems when he heard about my past."
                                            }
                                        ]
