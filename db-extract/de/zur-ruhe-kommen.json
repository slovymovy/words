                "senses": [
                    {
                        "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                        "entry_id": "9290b888-7926-3c9d-b466-01518f13bd96",
                        "glosses": [
                            "Prozess des Erreichens eines ruhigen Zustands; Prozess der Beruhigung von etwas (Geist, Gedanken, Körper)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7362542b-9acd-4a03-8d2a-4ca17c7a5204",
                                "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                                "text": "„Yoga ist das Zur-Ruhe-Kommen der dauernd sich verändernden mentalen Muster.“"
                            },
                            {
                                "example_id": "f6e346a5-23c9-429d-99c2-09162c92c59e",
                                "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                                "text": "„Es ist an der Zeit das WIR zu spüren, ein Zur-Ruhe-Kommen nach Monaten der Planung, Aufregung und Vorfreude.“"
                            },
                            {
                                "example_id": "4959f011-a3db-4dd2-bb6b-323f9642a7d9",
                                "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                                "text": "„Joggen kannst du in der Freizeit, hier würde dich die Anstrengung nur beim zur-Ruhe-kommen und Denken stören.“"
                            },
                            {
                                "example_id": "70017959-5acd-41db-8f45-4c841301a2a8",
                                "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                                "text": "„In jeder Religion finden sich Verse, Gebete oder Sätze, die eine kraftvolle Wirkung auf Geist und Körper entfalten und uns bei der Fokussierung, der Meditation und dem Zur-Ruhe-kommen hilfreich sein können.“"
                            },
                            {
                                "example_id": "b0080f34-9f35-4f50-86f7-94ee12111641",
                                "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                                "text": "„Der eigentliche Sinn des 4. Gebots, nämlich das einmal wöchentliche Zur-Ruhe-kommen ist auch dann noch gewährleistet, wenn der 7-Tage-Zyklus sich um einen Tag verschiebt.“"
                            },
                            {
                                "example_id": "a1fa9336-18be-424c-a62b-0424ce7ba522",
                                "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                                "text": "„Dass dieses Grundverständnis von Polstern als Oasen der Entschleunigung und des Zur-Ruhe-Kommens von Anbeginn mit einem kompromisslosen Anspruch an höchste Qualitätsstandards verbunden war, erklärt die weltweite Reputation der Marke.“"
                            },
                            {
                                "example_id": "454e4181-f86a-4bbd-95b1-c45c076f9d08",
                                "sense_id": "9f6648c0-8dbb-36a8-979b-7c60aa8e9c39",
                                "text": "„Wenn Yoga laut Patanjali das Zur-Ruhe-Kommen der Gedanken im Geist ist, dann hat der Yogi einen natürlichen Feind: Den Computer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
