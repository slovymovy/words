{
    "word_family": [
        "jiggly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1a9f315-9d84-3902-b719-038eb9b5d49a",
                    "sense_definition": "To shake, vibrate, or move with small, quick, jerky movements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shake_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gelatin dessert started to <w>jiggle</w> when she set the tray on the table.",
                            "target_lang_translations": {
                                "es": "El postre de gelatina empezó a <w>temblar</w> cuando ella puso la bandeja sobre la mesa."
                            }
                        },
                        {
                            "text": "His leg began to <w>jiggle</w> nervously during the long interview.",
                            "target_lang_translations": {
                                "es": "Su pierna empezó a <w>moverse</w> nerviosamente durante la larga entrevista."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiggle",
                        "wobble"
                    ],
                    "target_lang_definitions": {
                        "es": "Temblar, vibrar o moverse con movimientos pequeños, rápidos y espasmódicos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "temblar",
                                "target_lang_sense_clarification": "vibrar o agitarse ligeramente"
                            },
                            {
                                "target_lang_word": "moverse",
                                "target_lang_sense_clarification": "agitarse con movimientos cortos o inquietos"
                            },
                            {
                                "target_lang_word": "bailar",
                                "target_lang_sense_clarification": "moverse de un lado a otro repetidamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7b1bc1c-9886-3bf5-9882-5299b94e9af9",
                    "sense_definition": "To cause something to shake gently or move with quick, light jerks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shake_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the lock gets stuck, gently <w>jiggle</w> the key.",
                            "target_lang_translations": {
                                "es": "Si la cerradura se atasca, <w>menea</w> suavemente la llave."
                            }
                        },
                        {
                            "text": "You need to <w>jiggle</w> the handle to make the toilet stop running.",
                            "target_lang_translations": {
                                "es": "Tienes que <w>mover</w> la palanca para que el inodoro deje de perder agua."
                            }
                        }
                    ],
                    "synonyms": [
                        "shake",
                        "wiggle"
                    ],
                    "common_phrases": [
                        "jiggle the key",
                        "jiggle the handle"
                    ],
                    "target_lang_definitions": {
                        "es": "Hacer que algo se sacuda suavemente o moverlo con tirones rápidos y ligeros."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "menear",
                                "target_lang_sense_clarification": "mover algo de un lado a otro con rapidez y suavidad"
                            },
                            {
                                "target_lang_word": "sacudir",
                                "target_lang_sense_clarification": "agitar suavemente"
                            },
                            {
                                "target_lang_word": "mover",
                                "target_lang_sense_clarification": "hacer oscilar o mover con pequeños toques"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5328cb3-bff1-3dfa-addf-72e9a13e0404",
                    "sense_definition": "A light, quick, shaking or wiggling movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shake_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give the door handle a quick <w>jiggle</w> to ensure it is locked.",
                            "target_lang_translations": {
                                "es": "Dale un rápido <w>meneíto</w> al picaporte de la puerta para asegurarte de que esté cerrada con llave."
                            }
                        },
                        {
                            "text": "With a slight <w>jiggle</w> of the cord, the loose connection failed completely.",
                            "target_lang_translations": {
                                "es": "Con una ligera <w>sacudida</w> del cable, la conexión floja falló por completo."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiggle",
                        "wobble"
                    ],
                    "common_phrases": [
                        "give a jiggle"
                    ],
                    "target_lang_definitions": {
                        "es": "Movimiento ligero y rápido de vaivén, sacudida o temblor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "meneíto",
                                "target_lang_sense_clarification": "pequeño movimiento de vaivén"
                            },
                            {
                                "target_lang_word": "sacudida",
                                "target_lang_sense_clarification": "movimiento rápido y breve"
                            },
                            {
                                "target_lang_word": "temblor",
                                "target_lang_sense_clarification": "vibración o agitación ligera"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}