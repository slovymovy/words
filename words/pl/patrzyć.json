    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fbee3387-bc3d-32ee-ba59-c1e3def0f41f",
                    "sense_definition": "używać zmysłu wzroku, kierować wzrok na coś lub kogoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "widzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko <w>patrzy</w> na kolorowe zabawki w sklepie.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>смотрит</w> на цветные игрушки в магазине."
                            }
                        },
                        {
                            "text": "Nie <w>patrz</w> tak długo w słońce, bo to szkodzi oczom.",
                            "target_lang_translations": {
                                "ru": "Не <w>смотри</w> так долго на солнце, потому что это вредит глазам."
                            }
                        }
                    ],
                    "synonyms": [
                        "widzieć"
                    ],
                    "common_phrases": [
                        "patrzeć na zegarek",
                        "patrzeć w okno"
                    ],
                    "target_lang_definitions": {
                        "ru": "использовать зрение, направлять взгляд на кого-либо или что-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смотреть",
                                "target_lang_sense_clarification": "направлять взгляд на объект"
                            },
                            {
                                "target_lang_word": "глядеть",
                                "target_lang_sense_clarification": "направлять взгляд, часто с оттенком внимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79614f8-7642-3eeb-9710-9531986d1092",
                    "sense_definition": "być świadkiem jakiegoś zdarzenia",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "widzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy <w>patrzyli</w> z niedowierzaniem, jak wygrywa wyścig.",
                            "target_lang_translations": {
                                "ru": "Все с недоверием <w>смотрели</w>, как он выигрывает гонку."
                            }
                        },
                        {
                            "text": "Nie mogłem <w>patrzeć</w> na jego cierpienie.",
                            "target_lang_translations": {
                                "ru": "Я не мог <w>смотреть</w> на его страдания."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "быть свидетелем какого-либо события"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смотреть",
                                "target_lang_sense_clarification": "наблюдать за происходящим"
                            },
                            {
                                "target_lang_word": "наблюдать",
                                "target_lang_sense_clarification": "следить за развитием событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39af5544-ed5c-38d6-9a09-cc969b69f60b",
                    "sense_definition": "oczekiwać na kogoś lub coś, wypatrywać",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oczekiwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cały dzień <w>patrzył</w> na listonosza, czekając na ważną wiadomość.",
                            "target_lang_translations": {
                                "ru": "Он весь день <w>высматривал</w> почтальона, ожидая важное сообщение."
                            }
                        },
                        {
                            "text": "Dzieci <w>patrzą</w> na powrót rodziców z dalekiej podróży.",
                            "target_lang_translations": {
                                "ru": "Дети <w>ждут</w> возвращения родителей из далекого путешествия."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ожидать кого-либо или чего-либо, высматривать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высматривать",
                                "target_lang_sense_clarification": "искать глазами в ожидании"
                            },
                            {
                                "target_lang_word": "ждать",
                                "target_lang_sense_clarification": "ожидать появления кого-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fb5a8ff-b527-34cc-9d27-5121cff18ea5",
                    "sense_definition": "zastanawiać się nad czymś, rozważać",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "myślenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy <w>patrzeć</w> na ten problem z szerszej perspektywy.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>смотреть</w> на эту проблему с более широкой перспективы."
                            }
                        },
                        {
                            "text": "On zawsze <w>patrzy</w> na życie bardzo optymistycznie.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>смотрит</w> на жизнь очень оптимистично."
                            }
                        }
                    ],
                    "common_phrases": [
                        "patrzeć optymistycznie"
                    ],
                    "target_lang_definitions": {
                        "ru": "размышлять о чем-либо, рассматривать с определенной точки зрения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смотреть",
                                "target_lang_sense_clarification": "иметь определенное отношение или мнение"
                            },
                            {
                                "target_lang_word": "рассматривать",
                                "target_lang_sense_clarification": "анализировать ситуацию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
