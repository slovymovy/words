                ],
                "senses": [
                    {
                        "sense_id": "278f42af-d355-3d35-801a-9c4da550b491",
                        "entry_id": "912a3b76-e6f8-32a3-a5da-ce9c7ed3edd1",
                        "glosses": [
                            "Einst besondere Kolonie-Art (besonders in Nordamerika); eine Kolonie, bei welcher das Rechtsverhältnis zwischen dem König und der Kolonie durch eine, einer Verfassung ähnelnden, Urkunde (Charta, engl. charter) geregelt war."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8106c6-c269-4273-8d28-0431ea825a44",
                                "sense_id": "278f42af-d355-3d35-801a-9c4da550b491",
                                "text": "Es ist in England niemandem eingefallen, zu verlangen, daß dieser Kolonialbesitz durch eine Charterkolonie übernommen, beziehungsweise, daß die dafür aufzuwendenden Kosten von Privaten aufgebracht werden."
                            },
                            {
                                "example_id": "311ca8c6-b55f-4732-a33c-db83c93eb8ed",
                                "sense_id": "278f42af-d355-3d35-801a-9c4da550b491",
                                "text": "Verwaltet wurde eine Charterkolonie durch einen von der Kompanie bestimmten Gouverneur und eine Art \"Zwei-Kammer-Parlament\"."
                            },
                            {
                                "example_id": "d13147e9-d3aa-4d2c-a54e-f69e1dce639c",
                                "sense_id": "278f42af-d355-3d35-801a-9c4da550b491",
                                "text": "Die Königin von England verlieh der »British North Borneo Company« am 7. November 1881 einen Freibrief, und seitdem ist dieses Gebiet eine Charterkolonie geblieben, eine der wenigen, die sich bis auf unsere Tage erhalten haben."
                            },
                            {
                                "example_id": "a0f60497-de0d-4c15-a564-2d8d83d38617",
                                "sense_id": "278f42af-d355-3d35-801a-9c4da550b491",
                                "text": "Diejenigen Kolonien, die England, seitdem Deutschland in die Kolonialpolitik eingetreten ist, erworben hat, seien sämtlich Kronkolonien, während Deutschland im Westen und Zentrum Neu-Guineas eine eigentliche Charterkolonie errichtet habe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
