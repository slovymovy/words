                "senses": [
                    {
                        "sense_id": "5b99742c-e8e9-39bc-b85d-d42f2ea546e6",
                        "entry_id": "5cf001e3-4e3a-3b2a-bed3-ff768a868806",
                        "glosses": [
                            "(leicht) zerzauster, dicht und stark gelockter Haarschopf"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d1f2d31f-69e8-4e30-99be-b8cd5382d2a6",
                                "sense_id": "5b99742c-e8e9-39bc-b85d-d42f2ea546e6",
                                "text": "„Jedenfalls flüsterte mir das junge quecksilbrige Ding mit dem hennaroten Wuschelkopf, das mich zum Herrn ihrer Wahl auserkor, tabakheiser und kaugummibreit ‚Jimmy the Tiger‘ ins Ohr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d589f45e-7bb7-35ce-a701-72bc11ab3738",
                        "entry_id": "5cf001e3-4e3a-3b2a-bed3-ff768a868806",
                        "glosses": [
                            "jemand, der solch einen unter [1] beschriebenen Haarschopf trägt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "735ba58e-7f83-4682-b9bb-f70ec3d2225a",
                                "sense_id": "d589f45e-7bb7-35ce-a701-72bc11ab3738",
                                "text": "„Der Jüngste, ein flachsgelber Wuschelkopf, spielte auf einer Mundharmonika.“"
                            },
                            {
                                "example_id": "a8cda536-cbff-405c-a4fe-8e1b87995d65",
                                "sense_id": "d589f45e-7bb7-35ce-a701-72bc11ab3738",
                                "text": "„Und erst der Gerichtsdiener, der zwischen Senat und Oberstaatsanwältin Platz nahm, der war noch keine dreißig. Ein fröhlicher rheinischer Wuschelkopf war das.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44976c37-1bfe-4d89-bac2-a091bab6962a",
                        "source_entry_id": "5cf001e3-4e3a-3b2a-bed3-ff768a868806",
                        "source_sense_id": "5b99742c-e8e9-39bc-b85d-d42f2ea546e6",
