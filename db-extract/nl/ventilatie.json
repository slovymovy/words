                                        "sense_id": "17330843-e76d-3ee8-bcd1-1c11ee3d4bc7",
                                        "entry_id": "75ca4602-3d62-3730-a002-470054901e26",
                                        "glosses": [
                                            "The replacement of stale or noxious air with fresh."
                                        ],
                                        "tags": [
