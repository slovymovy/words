{
    "word_family": [
        "growl",
        "growler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03e61d3f-9ea1-3e26-a145-098da0600341",
                    "sense_definition": "Making a low, guttural sound, typically in anger or warning",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry, <w>growling</w> dog made everyone step back slowly. ",
                            "target_lang_translations": {
                                "tr": "Öfkeli, <w>hırıldayan</w> köpek herkesin yavaşça gerilemesine neden oldu."
                            }
                        },
                        {
                            "text": "He heard a <w>growling</w> noise coming from the dark bushes.",
                            "target_lang_translations": {
                                "tr": "Karanlık çalıların arasından gelen <w>hırıltılı</w> bir ses duydu."
                            }
                        }
                    ],
                    "synonyms": [
                        "snarling",
                        "rumbling"
                    ],
                    "common_phrases": [
                        "growling dog",
                        "growling stomach"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle öfke veya uyarı amacıyla hırıldayan, alçak ve gırtlaktan ses çıkaran"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hırıldayan",
                                "target_lang_sense_clarification": "hayvan veya ses için"
                            },
                            {
                                "target_lang_word": "gürleyen",
                                "target_lang_sense_clarification": "mide veya ses için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1ea857c-ff52-3ef1-b8f9-939803b60185",
                    "sense_definition": "A sustained low sound, such as from an animal or a hungry stomach",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>growling</w> from his stomach embarrassed him during the meeting.",
                            "target_lang_translations": {
                                "tr": "Midesinden gelen yüksek <w>gurultu</w> toplantı sırasında onu utandırdı."
                            }
                        },
                        {
                            "text": "We could hear the sudden <w>growling</w> of a bear in the forest.",
                            "target_lang_translations": {
                                "tr": "Ormanda bir ayının aniden <w>hırlamasını</w> duyabiliyorduk."
                            }
                        }
                    ],
                    "synonyms": [
                        "rumble",
                        "snarl"
                    ],
                    "common_phrases": [
                        "stomach growling"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir hayvandan veya aç bir mideden gelen sürekli, alçak ses; hırlama veya gurultu"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hırlama",
                                "target_lang_sense_clarification": "hayvan sesi"
                            },
                            {
                                "target_lang_word": "gurultu",
                                "target_lang_sense_clarification": "mide sesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26d4fe64-8e48-3515-b4b9-f37ae226e4c1",
                    "sense_definition": "A musical technique used on wind instruments to produce a low-pitched, rumbling tone",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saxophone player used <w>growling</w> to give the jazz solo a rougher sound.",
                            "target_lang_translations": {
                                "tr": "Saksafoncu, caz solosuna daha sert bir ses katmak için <w>growling</w> tekniğini kullandı."
                            }
                        },
                        {
                            "text": "Mastering <w>growling</w> on the trumpet requires precise throat control.",
                            "target_lang_translations": {
                                "tr": "Trompette <w>growling</w> tekniğinde uzmanlaşmak, hassas bir boğaz kontrolü gerektirir."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "musical technique"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Üflemeli çalgılarda pürüzlü ve hırıltılı bir ton üretmek için kullanılan bir müzik tekniği"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "growling",
                                "target_lang_sense_clarification": "müzik tekniği/hırlatma efekti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e0e9ef1-dc17-38d6-be8d-705120bfaa84",
                    "sense_definition": "present participle and gerund of <w>growl</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild dog is <w>growling</w> at the intruder.",
                            "target_lang_translations": {
                                "tr": "Vahşi köpek davetsiz misafire <w>hırlıyor</w>."
                            }
                        },
                        {
                            "text": "His stomach started <w>growling</w> because he missed lunch.",
                            "target_lang_translations": {
                                "tr": "Öğle yemeğini kaçırdığı için midesi <w>guruldamaya</w> başladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "start growling"
                    ],
                    "target_lang_definitions": {
                        "tr": "\"growl\" fiilinin şimdiki zaman ve ulaç biçimi; hırlama, guruldama"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hırlama",
                                "target_lang_sense_clarification": "hırlamak eylemi"
                            },
                            {
                                "target_lang_word": "guruldama",
                                "target_lang_sense_clarification": "mide için hırlamak eylemi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}