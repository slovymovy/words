{
    "word_family": [
        "zwodzenie",
        "zwodniczy",
        "zwodniczość",
        "zwodzenie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4047379-3613-3803-9d6d-cb30dcc4cdb7",
                    "sense_definition": "celowo wprowadzać kogoś w błąd, kłamać lub obiecywać coś, czego się nie spełni",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie pozwól, aby sprzedawca <w>zwodził</w> cię obietnicami o niskiej cenie.",
                            "target_lang_translations": {
                                "ru": "Не позволяй продавцу <w>обманывать</w> тебя обещаниями низкой цены."
                            }
                        },
                        {
                            "text": "Politycy często <w>zwodzą</w> wyborców, obiecując zmiany, których nie zamierzają wprowadzić.",
                            "target_lang_translations": {
                                "ru": "Политики часто <w>водят за нос</w> избирателей, обещая перемены, которые не собираются проводить."
                            }
                        }
                    ],
                    "synonyms": [
                        "oszukiwać",
                        "okłamywać",
                        "mamić",
                        "bałamucić"
                    ],
                    "common_phrases": [
                        "zwodzić obietnicami",
                        "zwodzić nadzieją"
                    ],
                    "target_lang_definitions": {
                        "ru": "намеренно вводить кого-либо в заблуждение, лгать или давать обещания, которые не будут выполнены"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение, лгать"
                            },
                            {
                                "target_lang_word": "водить за нос",
                                "target_lang_sense_clarification": "идиома, означающая намеренное введение в заблуждение"
                            },
                            {
                                "target_lang_word": "морочить голову",
                                "target_lang_sense_clarification": "разговорный вариант, означающий сбивать с толку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e99e2640-3662-3a2f-b1c5-4c7f1b6728e4",
                    "sense_definition": "sprowadzać kogoś lub coś w dół, często z wyższego miejsca",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przewodnik musiał <w>zwodzić</w> turystów ze szczytu góry przed nadchodzącą burzą.",
                            "target_lang_translations": {
                                "ru": "Гид должен был <w>свести</w> туристов с вершины горы перед надвигающейся бурей."
                            }
                        },
                        {
                            "text": "Robotnicy zaczęli <w>zwodzić</w> ciężki ładunek na dół za pomocą lin.",
                            "target_lang_translations": {
                                "ru": "Рабочие начали <w>спускать</w> тяжелый груз вниз с помощью канатов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "спускать кого-либо или что-либо вниз, часто с возвышенности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускать",
                                "target_lang_sense_clarification": "перемещать вниз"
                            },
                            {
                                "target_lang_word": "сводить",
                                "target_lang_sense_clarification": "сопровождать при спуске вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "665ffd5d-36a1-38d9-8589-fca5bbf3873b",
                    "sense_definition": "wzajemnie wprowadzać się w błąd",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Obaj partnerzy w biznesie <w>zwodzili</w> się nawzajem od samego początku współpracy.",
                            "target_lang_translations": {
                                "ru": "Оба бизнес-партнера <w>обманывали</w> друг друга с самого начала сотрудничества."
                            }
                        },
                        {
                            "text": "Długo <w>zwodzili</w> się co do swoich prawdziwych intencji w tej sprawie.",
                            "target_lang_translations": {
                                "ru": "Они долго <w>водили друг друга за нос</w> относительно своих истинных намерений в этом деле."
                            }
                        }
                    ],
                    "synonyms": [
                        "oszukiwać się",
                        "okłamywać się",
                        "mamić się"
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно вводить друг друга в заблуждение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обманывать друг друга",
                                "target_lang_sense_clarification": "взаимный обман"
                            },
                            {
                                "target_lang_word": "водить друг друга за нос",
                                "target_lang_sense_clarification": "взаимное введение в заблуждение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}