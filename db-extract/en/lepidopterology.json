                    },
                    {
                        "translation_id": "e9ef1149-fe65-40a9-9137-df971abc4939",
                        "source_entry_id": "deeb0857-d6d5-336f-8123-ac8d5b426d4c",
                        "source_sense_description": "scientific study of butterflies and moths",
                        "target_lang_word": "Lepidopterologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lepidopterologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2be886f4-9e36-339b-a3c3-a69e278ae2f3",
                                        "entry_id": "948b8fc6-927d-3a12-ae57-afe0a280dd2f",
                                        "glosses": [
                                            "Teilgebiet der Zoologie, das sich mit der Erforschung der Schmetterlinge beschäftigt"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da64a36-8abc-4dbf-b1a5-42a39bf89062",
                                                "sense_id": "2be886f4-9e36-339b-a3c3-a69e278ae2f3",
                                                "text": "„In seinem Fall stach natürlich dessen Leidenschaft für die Lepidopterologie hervor, denn er war Vereinsvorsitzender der Wiener Lepidopterologischen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "e5a47d5f-a683-4211-9eaf-638bb756f779",
                                                "sense_id": "2be886f4-9e36-339b-a3c3-a69e278ae2f3",
                                                "text": "„Ich erkannte dies 1866, und seit dieser Zeit beschäftige ich mich neben Ornithologie mit Entomologie, speciell mit Lepidopterologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2a329d5-705f-4515-ba0b-8cd6ffa93e45",
                        "source_entry_id": "deeb0857-d6d5-336f-8123-ac8d5b426d4c",
