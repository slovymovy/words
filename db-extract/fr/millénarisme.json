                "senses": [
                    {
                        "sense_id": "54fa681d-994d-3e9e-ac8c-e60ff8cb3570",
                        "entry_id": "89515695-a218-3374-80a5-738daee683cd",
                        "glosses": [
                            "Doctrine qui soutient l’idée d’un règne terrestre du Messie, après que celui-ci aura chassé l’Antéchrist et préalablement au jugement dernier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d174716-7b29-4b23-9020-c1658d24e06b",
                                "sense_id": "54fa681d-994d-3e9e-ac8c-e60ff8cb3570",
                                "text": "Le millénarisme a été l’objet d’une multitude d’études: théologiens, historiens et sociologues considèrent volontiers qu’il s’agit d'un courant de pensée digne d’intérêt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7223777f-29fd-4713-b439-73df4fbff2d5",
                        "source_entry_id": "89515695-a218-3374-80a5-738daee683cd",
                        "source_sense_id": "54fa681d-994d-3e9e-ac8c-e60ff8cb3570",
                        "source_sense_description": "(Religion) Doctrine qui soutient l’idée d’un règne terrestre du Messie",
                        "target_lang_word": "millenarianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millenarianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc0000b-9ff6-376b-8f33-72ede0a7a194",
                                        "entry_id": "5d06a16e-6467-3658-96a0-add650235066",
                                        "glosses": [
                                            "A belief in a coming religious millennium, especially (Christianity) the belief in a coming thousand-year reign of peace heralded by the Second Coming of Christ; utopianism, belief in a coming era of peace and prosperity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdb06531-7993-4b79-858e-c1f828eb45e3",
                                                "sense_id": "dfc0000b-9ff6-376b-8f33-72ede0a7a194",
                                                "text": "It is hard to say for certain just why this brief but notable shift from passive to active millenarianism should have occurred during the Interregnum."
                                            },
                                            {
                                                "example_id": "b6be87f9-fee6-4c07-9206-19ad671b67d9",
                                                "sense_id": "dfc0000b-9ff6-376b-8f33-72ede0a7a194",
                                                "text": "When Herman Melvilled visited , he was fascinated yet repulsed by the 'contagion' of American Christian millenarianism – 'this preposterous Jewmania', he called it, 'half-melancholy, half-farcical'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
