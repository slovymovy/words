                    ]
                },
                {
                    "sense_id": "ba933661-419f-330a-b21e-27c0145ce0ce",
                    "sense_definition": "D'une manière heureuse, avec joie et satisfaction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bonheur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le couple a vécu <w>heureusement</w> dans cette petite maison de campagne pendant quarante ans."
                        },
                        {
                            "text": "Les enfants grandissaient <w>heureusement</w> au milieu de la nature et de leurs animaux."
                        }
