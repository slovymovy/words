                    },
                    {
                        "sense_id": "1cd5c04a-6d96-318d-ae96-31fdab5e1c58",
                        "entry_id": "2088d443-87cf-3347-bcf2-c738b11c8f82",
                        "glosses": [
                            "Qualifie un objet endommagé au niveau de ses parties anguleuses."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4c9289f8-182f-4248-a468-f698e60ffb28",
                                "sense_id": "1cd5c04a-6d96-318d-ae96-31fdab5e1c58",
                                "text": "Une soupe aux herbes et à l’eau de haricots, un morceau de veau aux pommes de terre, inondé d’eau rousse en guise de jus, un plat de haricots et des cerises d’une qualité inférieure, le tout servi et mangé dans des assiettes et des plats écornés avec l’argenterie peu sonore et triste du maillechort, était-ce un menu digne de cette jolie femme ?"
                            },
                            {
                                "example_id": "671bdc9f-71df-4426-b60b-1ccf59a5c0a6",
                                "sense_id": "1cd5c04a-6d96-318d-ae96-31fdab5e1c58",
                                "text": "Julien fouilla dans son portefeuille et donna une photo au conseiller qui la glissa entre les pages d’un petit carnet tout écorné."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dd8f92c-349e-35b2-b93f-77b668807f5e",
