                "senses": [
                    {
                        "sense_id": "fa9100f4-6316-384f-b362-a72e1e474e4d",
                        "entry_id": "543423b1-db1b-3f52-a1eb-4e6722abd072",
                        "glosses": [
                            "Multiplier (une matrice A) par une autre en mettant A en premier dans la multiplication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6188411b-b5b6-4d95-9ebf-972dd3a72633",
                                "sense_id": "fa9100f4-6316-384f-b362-a72e1e474e4d",
                                "text": "Par exemple, multiplier une colonne par un réel x revient à postmultiplier la matrice par la matrice diag(1,1,...,1,x,1,...,1,1)."
                            },
                            {
                                "example_id": "1fb06083-cd1a-433a-beee-d0f61209b594",
                                "sense_id": "fa9100f4-6316-384f-b362-a72e1e474e4d",
                                "text": "Le fait qu'il soit possible de prémultiplier la matrice B par la matrice A n'implique pas qu'il soit possible de postmultiplier la matrice B par la matrice A."
                            }
                        ]
                    }
