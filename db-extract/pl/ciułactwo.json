                "translations": [
                    {
                        "translation_id": "d2c0357f-53de-42f2-a162-5d4e67140a28",
                        "source_entry_id": "08b2a22b-8a4e-36f3-959a-c6d47c291f47",
                        "source_sense_id": "04499f17-6dc6-3ef2-8e49-7915401b31ea",
                        "target_lang_word": "parsimony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parsimony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                        "entry_id": "58a2919e-5a68-3716-bdc9-3aac2a9424da",
                                        "glosses": [
                                            "Great reluctance to spend money unnecessarily."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1a774e-4cca-4bd6-a8a3-1c15b41a7291",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "Near-synonyms: (usually admirable) frugality, economy, thrift, thriftiness; (excessive degree) tightness, stinginess; (extreme degree) miserliness; see also Thesaurus:frugal, Thesaurus:stingy"
                                            },
                                            {
                                                "example_id": "da82ed68-b976-49e7-badb-d7e1c20bda7b",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "Parsimony, and not industry, is the immediate cause of the increase of capital. Industry, indeed, provides the subject which parsimony accumulates. But whatever industry might acquire, if parsimony did not save and store up, the capital would never be the greater."
                                            },
                                            {
                                                "example_id": "5a84cc3f-bc9e-4c2a-9506-ac8faf6107a1",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "If mere parsimony could have made a man rich, Sir Pitt Crawley might have become very wealthy […]"
                                            },
                                            {
                                                "example_id": "23db4349-0fdc-479b-969f-585bf780a9b4",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "THE WATERFORD & TRAMORE RAILWAY. By H. Fayle and A. T. Newham. David & Charles. 12s 6d. [...] Parsimony was responsible for low wages: at the turn of the century the Secretary & Manager was receiving £175 a year and the Locomotive Superintendent slightly less."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef429eef-929c-3a36-bcd2-b749bf8bda79",
                                        "entry_id": "58a2919e-5a68-3716-bdc9-3aac2a9424da",
                                        "glosses": [
                                            "The quality or characteristic of using the fewest resources or explanations to solve a problem."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08bd873-1e8e-4a01-876a-f311414a9627",
                                                "sense_id": "ef429eef-929c-3a36-bcd2-b749bf8bda79",
                                                "text": "We used three search heuristics, Bayesian inference, maximum likelihood, and maximum parsimony, to construct phylogenies from unique COI haplotypes and used default parameters for analyses unless otherwise noted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7c61cab-fd95-41ce-9f1b-4dc06b2ef3b8",
                        "source_entry_id": "08b2a22b-8a4e-36f3-959a-c6d47c291f47",
