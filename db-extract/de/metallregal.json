                "senses": [
                    {
                        "sense_id": "5ae06e33-5cf9-30eb-b417-98f9347d83b6",
                        "entry_id": "4a76c4ba-82ce-31f5-8eb0-2ed25d15aa99",
                        "glosses": [
                            "Regal aus Metall"
