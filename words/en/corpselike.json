                            },
                            {
                                "target_lang_word": "трупоподобный",
                                "target_lang_sense_clarification": "напоминающий труп по виду или состоянию"
                            },
                            {
                                "target_lang_word": "трупный",
                                "target_lang_sense_clarification": "свойственный мертвому телу"
                            }
                        ]
                    }
