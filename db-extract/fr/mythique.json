                                            {
                                                "example_id": "04dac990-f36f-4a9b-bfc6-9757dba4dc24",
                                                "sense_id": "e584a2a2-b095-307b-83fa-95172af0f6f7",
                                                "text": "mythical creature"
                                            },
                                            {
                                                "example_id": "fd818694-4909-4165-a039-609bbc1265fb",
                                                "sense_id": "e584a2a2-b095-307b-83fa-95172af0f6f7",
