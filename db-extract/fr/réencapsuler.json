                "senses": [
                    {
                        "sense_id": "34743ec7-527c-36ed-92a2-c3cf02d5e693",
                        "entry_id": "4adb5136-eae9-3831-a54f-c947be5e4420",
                        "glosses": [
                            "Encapsuler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e51891f-ab05-429b-a4e2-f091af577976",
                                "sense_id": "34743ec7-527c-36ed-92a2-c3cf02d5e693",
                                "text": "Avec les processeurs d'aujourd'hui, il ne faut que quelques minutes pour réencapsuler un fichier de 3 Go."
                            },
                            {
                                "example_id": "add09721-a34a-4309-bcf8-7244eb7118c9",
                                "sense_id": "34743ec7-527c-36ed-92a2-c3cf02d5e693",
                                "text": "D'autre part, certaines formes larvaires ont le pouvoir de se réencapsuler dans des hôtes différents des hôtes intermédiaires habituels."
                            },
                            {
                                "example_id": "1d8018fa-d985-4d71-9814-9c83fe3915ff",
                                "sense_id": "34743ec7-527c-36ed-92a2-c3cf02d5e693",
                                "text": "Ces larves jouissent de la curieuse propriété de se réencapsuler lorsque les circonstances les amènent dans l'intestin d'autres animaux."
                            }
                        ]
                    }
