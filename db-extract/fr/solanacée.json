                        "entry_id": "752a4df0-87bd-3807-b43b-09af4d5e2e9f",
                        "glosses": [
                            "Plante appartenant à l’ordre taxinomique des Solanales aux fleurs hermaphrodites, actinomorphes, dont les pétales, soudés entre eux à des hauteurs variables, donnent une étoile ou une trompette à la fleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ad1573-28e0-451f-8da5-64d85ed33a92",
                                "sense_id": "acf8b296-aa51-341e-9839-785f454fd771",
                                "text": "Toutes les solanacées contiennent de la solanine, un alcaloïde stéroïde toxique."
                            },
                            {
                                "example_id": "9f0e24f4-2b64-4156-a31e-7d0604b78039",
                                "sense_id": "acf8b296-aa51-341e-9839-785f454fd771",
                                "text": "Marcel, qui n’avait jamais fait de botanique qu’en amateur, crut pourtant reconnaître dans cet arbuste la physionomie caractéristique de la famille des solanacées."
                            }
                        ]
                    }
