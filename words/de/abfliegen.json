                },
                {
                    "sense_id": "deb4b21f-8ab7-33e1-bfda-658cb402a383",
                    "sense_definition": "Ein bestimmtes Gebiet oder eine Strecke aus der Luft prüfend oder suchend überfliegen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abfliegen_ueberfliegen",
                    "name_type": "no",
                    "examples": [
