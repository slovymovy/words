                        "sense_id": "ac107ac0-f8a8-3f0c-bc81-4c005d0bdb27",
                        "entry_id": "c6cd25d9-a7d3-30d2-9c15-e0624770b022",
                        "glosses": [
                            "televisie waarop alleen maar programma's van bedroevend slechte kwaliteit te zien zijn"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5f473e29-b8e9-4324-ad04-b8835891b9c6",
                                "sense_id": "ac107ac0-f8a8-3f0c-bc81-4c005d0bdb27",
                                "text": "Voor de VPRO verzorgde hij een show over televisie in Nederland. In zijn televisiekritieken kwam hij met het woord 'treurbuis' om de treurnis op de Nederlandse televisie aan te duiden."
                            },
                            {
                                "example_id": "21d1e85b-8b82-45ed-8bd3-b317d706bc47",
                                "sense_id": "ac107ac0-f8a8-3f0c-bc81-4c005d0bdb27",
                                "text": "Is het dan allemaal kommer en kwel op de treurbuis? Nee, er zijn ook lichtpuntjes, zo laten deelnemers weten. „Kwaliteit en originaliteit bij de commerciëlen kan ook”, zo tipt iemand: Zie The Amsterdam Project met Beau van Erven Dorens.” Ook Spoorloos, Erica op Reis en Ik Vertrek worden herhaaldelijk genoemd."
                            }
                        ]
                    }
