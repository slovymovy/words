                "senses": [
                    {
                        "sense_id": "a342fc86-3b1b-3c1b-8c18-1fb0fb83b086",
                        "entry_id": "031960be-0ada-35cb-b2fc-9958f82e12f7",
                        "glosses": [
                            "разг. гнусавить"
                        ],
                        "tags": [],
