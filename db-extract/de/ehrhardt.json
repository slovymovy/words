                ],
                "senses": [
                    {
                        "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                        "entry_id": "323a7cdc-1a4b-393c-ac45-c30b8a59834a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5811e65-d330-45ca-b801-0e5010187c22",
                                "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                                "text": "Frau Ehrhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7bf1c3e9-befd-4f3c-a857-24d525176ddb",
                                "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                                "text": "Herr Ehrhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0461fe4e-9fb6-4cb7-8c32-ca04a7d02b02",
                                "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                                "text": "Die Ehrhardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cd41f34a-ba02-496d-96f1-f7a10968edb9",
                                "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                                "text": "Der Ehrhardt trägt nie die Schals, die die Ehrhardt ihm strickt."
                            },
                            {
                                "example_id": "b0950d06-6f89-4f23-bb8b-68fe597c5894",
                                "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ehrhardt kommt, geht der Herr Ehrhardt.“"
                            },
                            {
                                "example_id": "0ad3ef52-c287-4fb0-8102-6823cdeef8ed",
                                "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                                "text": "Ehrhardt kommt und geht."
                            },
                            {
                                "example_id": "a3fa0198-964d-49e4-badc-b83268e37fa2",
                                "sense_id": "d10e9590-5e49-39c1-8ea5-f15e1de5574c",
                                "text": "Ehrhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
