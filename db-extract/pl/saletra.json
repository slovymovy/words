                ],
                "senses": [
                    {
                        "sense_id": "de1beb92-33a2-3914-9834-8fd6dfc5a82a",
                        "entry_id": "acb4568b-7483-38f7-9b8f-433b2aef7513",
                        "glosses": [
                            "nawóz zawierający azot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc2159a0-96fc-40f9-a3b1-26f1322c5449",
                                "sense_id": "de1beb92-33a2-3914-9834-8fd6dfc5a82a",
                                "text": "Na jednym kamieniu kładli ciasno związany nitką kłębuszek ze szmatki zawierający kalichlorek, czyli specjalną mieszankę siarki, węgla drzewnego i saletry nawozowej. Uderzony drugim kamieniem, kłębuszek ów wybuchał"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8a0b23be-eed8-3f2d-a802-abc75f90a9cf",
                        "entry_id": "acb4568b-7483-38f7-9b8f-433b2aef7513",
                        "glosses": [
                            "substancja chemiczna, składnik zaprawy peklowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cfe8529-a817-4312-9262-e28d5abd93f3",
                                "sense_id": "8a0b23be-eed8-3f2d-a802-abc75f90a9cf",
                                "text": "Pekluję mięsiwa w solance z saletrą i przyprawami."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "dd6c44db-37b7-3825-a457-c53fb3c9e5d1",
                        "entry_id": "acb4568b-7483-38f7-9b8f-433b2aef7513",
                        "glosses": [
                            "azotan mający znaczenie techniczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d138c266-6013-40d5-b8e0-167f424af9bd",
                                "sense_id": "dd6c44db-37b7-3825-a457-c53fb3c9e5d1",
                                "text": "W górnictwie używa się mieszaniny saletry z trotylem."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
