                                "sense_id": "78a22c77-8165-38cc-b641-fc4395af1625",
                                "text": "The UK is preparing for a Brexit without an agreement with the European Union.",
                                "translation": "Het Verenigd Koninkrijk bereidt zich voor op een brexit zonder overeenkomst met de Europese Unie."
                            }
                        ]
