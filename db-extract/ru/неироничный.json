                "senses": [
                    {
                        "sense_id": "6b531c21-b2aa-3332-bbb6-5145cde790ef",
                        "entry_id": "14db363f-9601-3c5d-bc9c-cc03f95e4f61",
                        "glosses": [
                            "не являющийся ироничным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa941329-4989-4552-b0d1-8743263f0938",
                                "sense_id": "6b531c21-b2aa-3332-bbb6-5145cde790ef",
                                "text": "Ироничный пафос потому лишь, что неироничный сегодня не в кайф, со временем-то надо считаться."
                            },
                            {
                                "example_id": "b9804e5d-dcbb-462f-8a5f-a4823cfbee1e",
                                "sense_id": "6b531c21-b2aa-3332-bbb6-5145cde790ef",
                                "text": "Совершенно другой пример, неромантизированный и неироничный, на ту же тему смещения и замещения реальностей — фильм Даррена Аронофски «Реквием по мечте», который можно перевести и как «Реквием по сновидению»."
                            }
                        ]
                    }
