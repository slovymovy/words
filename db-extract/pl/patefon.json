                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d80ae411-f05c-4cff-978a-3d9120ebf7a5",
                                "sense_id": "eebf2662-799e-385d-bb6d-b800a9dd9109",
                                "text": "Odtwarzanie w patefonie odbywało się od środka płyty przy użyciu niewymiennej kulki"
                            },
                            {
                                "example_id": "952f8063-1818-48c7-aa19-ea17ca077a0c",
                                "sense_id": "eebf2662-799e-385d-bb6d-b800a9dd9109",
                                "text": "Wcześniej ruchomym obrazkom towarzyszyła muzyka grana na żywo lub z patefonu"
                            },
                            {
                                "example_id": "ed81a3f5-fc05-40ff-ab2a-00fa0eb418f2",
                                "sense_id": "eebf2662-799e-385d-bb6d-b800a9dd9109",
                                "text": "Na patefonie zdarta płyta do obrzydzenia gra mazurki…"
                            }
                        ],
