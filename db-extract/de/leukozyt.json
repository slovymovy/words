                    {
                        "sense_id": "16063f66-d2cd-3296-880a-8ffa0687a33f",
                        "entry_id": "3e08a771-9001-3ce0-bd87-2490fd28aeb2",
                        "glosses": [
                            "Leucocyte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96d8886e-15bf-486b-a6ae-e81021ccd949",
                                "sense_id": "16063f66-d2cd-3296-880a-8ffa0687a33f",
                                "text": "Leukozyten erfüllen spezielle Aufgaben in der Abwehr von Krankheitserregern und körperfremden Strukturen.",
                                "translation": "Les leucocytes accomplissent des tâches particulières dans l’immunité contre les agents pathogènes et les corps étrangers."
                            },
                            {
                                "example_id": "b1ca9e11-b8f1-4628-a2af-25a4c1664b1c",
                                "sense_id": "16063f66-d2cd-3296-880a-8ffa0687a33f",
                                "text": "Bei den Leukämien verändern sich einzelne Untergruppen der Leukozyten zu Tumorzellen.",
                                "translation": "Lors d’une leucémie, des sous-groupes de leucocytes se transforment un à un en cellules tumorales."
                            }
                        ]
                    }
                ],
