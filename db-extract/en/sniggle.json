                        "entry_id": "73b789af-5749-3ccb-acda-1fc3c06387f6",
                        "glosses": [
                            "To fish for eels by thrusting a baited needle or hook into their dens."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4885a5fc-2415-4912-abc1-b595732c7a48",
                                "sense_id": "2d80488f-2d71-3226-bcbd-f884117e83be",
                                "text": "But rampant poaching (the correct term for catching a grown-up eel with bait is to “sniggle”, though elvers are caught with something more like a giant sieve) is now prompting authorities to crack down well in advance of next year’s season."
                            }
                        ]
                    },
