                "senses": [
                    {
                        "sense_id": "f12719b2-f222-350e-a2ca-8dc6c98cfc5d",
                        "entry_id": "0c412796-2d9c-3991-afa8-49d2adaefa6b",
                        "glosses": [
                            "Donner une réponse préalable, en attendant la réponse définitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea0d85a-73e7-4f89-89c1-4d7c02b6f6d2",
                                "sense_id": "f12719b2-f222-350e-a2ca-8dc6c98cfc5d",
                                "text": "Pré-répondre aux demandes des clients: (…)"
                            },
                            {
                                "example_id": "8f59bbb6-4361-4ebb-a806-60ba6bbfc95a",
                                "sense_id": "f12719b2-f222-350e-a2ca-8dc6c98cfc5d",
                                "text": "Lors de cette étude nous nous sommes également intéressés aux résultats proposés par Google Allo. Vous savez cette application révolutionnaire qui se substitue à votre Maman bienveillante, en répondant à toutes vos demandes, vous rappelant vos prochains rendez-vous ou encore en s’occupant de pré-répondre à vos conversations avec ses messages suggérés."
                            },
                            {
                                "example_id": "22793060-4527-4229-895e-4be5d96eb551",
                                "sense_id": "f12719b2-f222-350e-a2ca-8dc6c98cfc5d",
                                "text": "L'objectif est de permettre de \"pré-répondre\" aux questions que tout le monde se pose, pour éviter de ressasser toujours les mêmes sujets lorsque l'on en discute."
                            }
                        ]
                    }
