{
    "word_family": [
        "clinical",
        "clinician",
        "clinically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83c154ba-09df-31f0-a21a-941d93693bbf",
                    "sense_definition": "A medical facility where patients receive treatment or advice, usually without staying overnight.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She went to the <w>clinic</w> to get a flu shot before winter started.",
                            "target_lang_translations": {
                                "ru": "Она пошла в <w>поликлинику</w>, чтобы сделать прививку от гриппа до наступления зимы.",
                                "zh": "冬天开始前，她去<w>诊所</w>打了流感疫苗。"
                            }
                        },
                        {
                            "text": "The doctor works at a private <w>clinic</w> in the city center.",
                            "target_lang_translations": {
                                "ru": "Врач работает в частной <w>клинике</w> в центре города.",
                                "zh": "这位医生在市中心的一家私人<w>诊所</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "medical center",
                        "health center",
                        "medical office",
                        "surgery"
                    ],
                    "common_phrases": [
                        "health clinic",
                        "dental clinic",
                        "outpatient clinic",
                        "private clinic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинское учреждение, где пациенты получают лечение или консультации, обычно без госпитализации.",
                        "zh": "提供医疗服务或咨询的场所，通常无需住院。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиника",
                                "target_lang_sense_clarification": "частная или специализированная"
                            },
                            {
                                "target_lang_word": "поликлиника",
                                "target_lang_sense_clarification": "государственная или амбулаторная"
                            },
                            {
                                "target_lang_word": "медицинский центр",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诊所",
                                "target_lang_sense_clarification": "小型医疗机构"
                            },
                            {
                                "target_lang_word": "门诊部",
                                "target_lang_sense_clarification": "医院内设的门诊部门"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc70aa1-d7e5-3435-bdba-322c00ff7a61",
                    "sense_definition": "A meeting, class, or session designed to teach specific skills or provide advice on a particular subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "training_session",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous guitarist is holding a music <w>clinic</w> for advanced students this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные известный гитарист проводит музыкальный <w>мастер-класс</w> для продвинутых студентов.",
                                "zh": "那位著名吉他手这个周末要为高水平学生举办一场音乐<w>讲习班</w>。"
                            }
                        },
                        {
                            "text": "Local lawyers organized a legal <w>clinic</w> to help residents understand their rights.",
                            "target_lang_translations": {
                                "ru": "Местные юристы организовали юридическую <w>консультацию</w>, чтобы помочь жителям понять свои права.",
                                "zh": "当地律师组织了一场法律<w>咨询会</w>，帮助居民了解自己的权利。"
                            }
                        }
                    ],
                    "synonyms": [
                        "workshop",
                        "seminar",
                        "masterclass"
                    ],
                    "common_phrases": [
                        "sports clinic",
                        "legal clinic",
                        "music clinic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Встреча, занятие или семинар, предназначенные для обучения конкретным навыкам или предоставления консультаций.",
                        "zh": "旨在教授特定技能或提供专业建议的培训课程或研讨会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастер-класс",
                                "target_lang_sense_clarification": "обучение навыкам, напр. в музыке или спорте"
                            },
                            {
                                "target_lang_word": "семинар",
                                "target_lang_sense_clarification": "учебное или консультационное занятие"
                            },
                            {
                                "target_lang_word": "консультация",
                                "target_lang_sense_clarification": "предоставление советов, напр. юридическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "研讨班",
                                "target_lang_sense_clarification": "针对特定技能的培训"
                            },
                            {
                                "target_lang_word": "讲习班",
                                "target_lang_sense_clarification": "侧重实践的教学活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64bcec64-056b-38d9-9caf-57c4233715bf",
                    "sense_definition": "A specialized class in a medical school where students learn by observing the examination and treatment of actual patients.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor conducted a <w>clinic</w> to demonstrate the diagnosis of rare skin conditions.",
                            "target_lang_translations": {
                                "ru": "Профессор провел <w>клинический разбор</w>, чтобы продемонстрировать диагностику редких кожных заболеваний.",
                                "zh": "教授进行了一次<w>临床教学</w>，演示了罕见皮肤病的诊断过程。"
                            }
                        },
                        {
                            "text": "Medical students are required to attend every <w>clinic</w> during their final year.",
                            "target_lang_translations": {
                                "ru": "Студенты-медики обязаны посещать каждое <w>клиническое занятие</w> на последнем курсе.",
                                "zh": "医学生在最后一年必须参加所有的<w>临床实习</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Практическое занятие в медицинском вузе, на котором студенты обучаются, наблюдая за обследованием и лечением реальных пациентов.",
                        "zh": "医学院中通过观察实际病例的诊断和治疗来进行教学的临床实践课。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиническое занятие",
                                "target_lang_sense_clarification": "учебная практика"
                            },
                            {
                                "target_lang_word": "клинический разбор",
                                "target_lang_sense_clarification": "анализ случая заболевания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "临床实习",
                                "target_lang_sense_clarification": "医学生的临床教学活动"
                            },
                            {
                                "target_lang_word": "临床教学",
                                "target_lang_sense_clarification": "以病例为基础的教学"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}