                ],
                "senses": [
                    {
                        "sense_id": "e66ce08e-d61c-3a46-83dd-8f473ec121ef",
                        "entry_id": "b19c07da-a8f1-3edb-be80-84de5cdcdb2c",
                        "glosses": [
                            "Eigenschaft/Haltung/Umstand, in deutlichem Maße wenig entwickeltes, wenig verfeinertes, wenig zivilisiertes (primitives) Verhalten/Merkmale zu zeigen, etwas, das auf einfachstem Niveau stattfindet"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "5b775fac-97fb-436f-abd9-cf19d5d0d224",
                                "sense_id": "e66ce08e-d61c-3a46-83dd-8f473ec121ef",
                                "text": "„Die aus der männlichen Innenperspektive Komjagas beschriebene Welt hat einen ziemlich vulgären Touch, wodurch die nach außen gekehrte Sakralität, Vergeistigtheit als ‚hohle Form‘ sichtbar wird, die von Primitivität und Brutalität gefüllt ist.“"
                            },
                            {
                                "example_id": "0e2698f0-e887-4542-9df8-0baeca525b7c",
                                "sense_id": "e66ce08e-d61c-3a46-83dd-8f473ec121ef",
                                "text": "„Eines wird man ohne weiteres zugeben müssen: In primitiven Künsten steckt oft eine überraschende Schönheit; aber doch nur trotz, nicht wegen ihrer Primitivität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
