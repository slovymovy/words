                                        "glosses": [
                                            "the distance between the front and the back, as the depth of a drawer or closet"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e2f16b8-eef1-3ba3-ac51-2ba49a2f76bd",
                                        "entry_id": "13d8785a-20e9-3639-a091-d5064ab46856",
                                        "glosses": [
                                            "the intensity, complexity, strength, seriousness or importance of an emotion, situation, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b782a3e2-1203-4c29-9c50-5c4a31ce1fe3",
                                                "sense_id": "3e2f16b8-eef1-3ba3-ac51-2ba49a2f76bd",
                                                "text": "The depth of her misery was apparent to everyone."
                                            },
                                            {
                                                "example_id": "f0cc87ad-d1e8-4e97-8d02-85b56ca93f5c",
                                                "sense_id": "3e2f16b8-eef1-3ba3-ac51-2ba49a2f76bd",
                                                "text": "The depth of the crisis had been exaggerated."
                                            },
                                            {
                                                "example_id": "ef1a4677-81e2-4c4c-9ef3-22430f964599",
                                                "sense_id": "3e2f16b8-eef1-3ba3-ac51-2ba49a2f76bd",
                                                "text": "We were impressed by the depth of her knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ea11e5-630b-3a44-a17e-bb0ddbf39415",
