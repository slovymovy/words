        "nl-extract.jsonl": [
            {
                "entry_id": "b6a5ca69-d6c5-38fa-bfe9-6bc0387e1fd7",
                "word": "gecastreerd",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f05513d9-706c-3375-af3c-cc5c8a6dc71d",
                        "entry_id": "b6a5ca69-d6c5-38fa-bfe9-6bc0387e1fd7",
                        "glosses": [
                            "door het verwijderen van de testes (de ballen) niet meer in staat zijn zich voort te planten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cbc986c-1a12-4b0c-a391-13703379da5b",
                                "sense_id": "f05513d9-706c-3375-af3c-cc5c8a6dc71d",
                                "text": "Mijn gecastreerde jack russel van 8 jaar oud wil regelmatig andere honden aanvallen. Kan ik hier nog iets aan verbeteren?"
                            },
                            {
                                "example_id": "d7075cb0-7931-48ff-bce1-1909142e629a",
                                "sense_id": "f05513d9-706c-3375-af3c-cc5c8a6dc71d",
                                "text": "Waarschijnlijk heeft de arme Rudi een weekje opgesloten gezeten. De niet gecastreerde kater, die volgens de opvang ’heel lief’ is, werd direct op Facebook gezet. Uiteindelijk meldde een tot tranen geroerde Eva uit Hongarije zich bij de opvang."
                            },
                            {
                                "example_id": "f1817800-8dee-4347-8718-0735b386594f",
                                "sense_id": "f05513d9-706c-3375-af3c-cc5c8a6dc71d",
                                "text": "De ’je-weet-wel-kater’ haalde zelfs de Van Dale, als eufemisme voor een gecastreerde kater."
                            }
                        ]
                    },
                    {
                        "sense_id": "89d67e1a-d42a-3fd6-8f45-d26b5ba969f0",
                        "entry_id": "b6a5ca69-d6c5-38fa-bfe9-6bc0387e1fd7",
                        "glosses": [
                            "van iets dat er alle pit en levendigheid uit verwijderd is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1178c961-ca55-484f-a170-2475b86ca8f2",
                                "sense_id": "89d67e1a-d42a-3fd6-8f45-d26b5ba969f0",
                                "text": "De nieuwe Vitara laat de prut de prut voor de gebaande paden van de mode. De Hema heeft ontdekt dat je vandaag de dag een beetje Bijenkorf moet zijn. Het budget-Jeepje onderging een makeover tot suv, tot gecastreerde terreinwagen; de AllGrip geheten vierwielaandrijving kost voortaan extra."
                            }
                        ]
                    }
