                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f731d887-f1df-40aa-86eb-0b94810525f8",
                                "sense_id": "4137bfad-8232-381d-a455-bc6a06e491d4",
                                "text": "„Als sie die schwache Tür aufgebrochen hatten, fanden sie nur dies: zwei sauber abgenagte menschliche Gerippe auf dem Lehmfußboden und eine Reihe eigenartiger Käfer, die in den schattigen Winkeln krochen.“"
                            },
                            {
                                "example_id": "e71b4efb-2b8e-41f7-a90c-192ff20ed333",
                                "sense_id": "4137bfad-8232-381d-a455-bc6a06e491d4",
                                "text": "„Die Hütte war überraschend geräumig und konnte problemlos uns sechs aufnehmen. Abgesehen von einigen Strohmatten, die auf dem Lehmfußboden verteilt lagen, war sie unmöbliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
