                "senses": [
                    {
                        "sense_id": "b433e13c-7310-327b-8eb3-f37919b00078",
                        "entry_id": "64b21a16-27b1-36ac-8a88-00965c7247d7",
                        "glosses": [
                            "Zeit der breiten Industrialisierung des Deutschen Reiches und Österreich-Ungarns bis 1873 (kein Plural)"
                        ],
                        "tags": [
                            "Wirtschaftsgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "2faa0e2e-d560-4b9c-b6be-4f424c671b46",
                                "sense_id": "b433e13c-7310-327b-8eb3-f37919b00078",
                                "text": "In der Gründerzeit kam es zu großem wirtschaftlichem Aufschwung."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "d481af06-7d93-354d-8c08-e55bbb235bca",
                        "entry_id": "64b21a16-27b1-36ac-8a88-00965c7247d7",
                        "glosses": [
                            "Erste Jahre des Deutschen Reichs 1871 bis 1873 (kein Plural)"
                        ],
                        "tags": [
                            "Deutsche Geschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "b0597ca4-e4e1-4097-b23e-92f09ded657f",
                                "sense_id": "d481af06-7d93-354d-8c08-e55bbb235bca",
                                "text": "Das Deutsche Reich gelangte vor allem aufgrund französischer Reparationen in die Gründerzeit."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "fb599c04-17c7-3284-8fc2-2ecd311521dc",
                        "entry_id": "64b21a16-27b1-36ac-8a88-00965c7247d7",
                        "glosses": [
                            "Stilepoche und Stil der Jahrhundertwende zum 20. Jahrhundert (kein Plural)"
                        ],
                        "tags": [
                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "e3db373a-5278-46cd-a507-8cc4692e4957",
                                "sense_id": "fb599c04-17c7-3284-8fc2-2ecd311521dc",
                                "text": "Es ist ein Haus der Gründerzeit."
                            },
                            {
                                "example_id": "731eb9e5-78be-481c-8133-2e3266693746",
                                "sense_id": "fb599c04-17c7-3284-8fc2-2ecd311521dc",
                                "text": "„Sein Modell muß in der Gründerzeit fertiggeworden sein, nach 1870, als Bismarck und die Preußen, als die zackigen Unternehmer und Exporteure ihren Nachbarn mit ihrer forschen Aktivität Schrecken einjagten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "00e94623-6afd-3eff-9f64-80f1f695a072",
                        "entry_id": "64b21a16-27b1-36ac-8a88-00965c7247d7",
                        "glosses": [
                            "Zeit, in der etwas begründet wird oder die Bedingungen dafür geschaffen werden"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b72a4b11-ae9f-453d-8e9a-3c3348887d84",
                                "sense_id": "00e94623-6afd-3eff-9f64-80f1f695a072",
                                "text": "„FDP-Fraktionsvize Stamp kündigte eine ‚neue Gründerzeit‘ für NRW an.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
