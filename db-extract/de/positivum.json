                        "examples": [
                            {
                                "example_id": "844f0b01-88cd-43de-b99d-7ddbec65fe0b",
                                "sense_id": "51f3d148-aeab-3a21-9d42-0eb843e61b47",
                                "text": "Die Negation des Negativum, ist ein Positivum; das Prinzip \"Hoffnung\" und \"Glaube\" gilt!"
                            },
                            {
                                "example_id": "05b0d8b4-0c13-4391-a750-4b8ea22541fe",
                                "sense_id": "51f3d148-aeab-3a21-9d42-0eb843e61b47",
                                "text": "Die Einstellung: \"Das Glas ist niemals halbleer, sondern immer halbvoll!\" ist ein persönliches Positivum."
                            },
                            {
                                "example_id": "3168511e-5905-4814-aacf-1d5ff5f23315",
                                "sense_id": "51f3d148-aeab-3a21-9d42-0eb843e61b47",
                                "text": "„Just dieses Positivum deckt einen Makel auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
