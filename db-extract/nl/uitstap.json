                "translations": [
                    {
                        "translation_id": "2f8750ec-90c5-4a5f-8510-6db802647777",
                        "source_entry_id": "059bcd0a-d3be-3a32-b0b1-c3446d92b02c",
                        "source_sense_id": "3b95531b-0020-39c2-a9ae-0be205eaa174",
                        "source_sense_description": "een (meestal korte) reis",
                        "target_lang_word": "Tour",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tour",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11106cc7-00e4-39d6-bd6d-217ff73146cf",
                                        "entry_id": "1846039b-8427-3f44-a154-38f3bc144742",
                                        "glosses": [
                                            "Reise, Weg oder Bewegungen, deren Ausgangs- und Zielort in der Regel identisch sind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad63ca9-13f4-4e0d-ad5f-ec900e71f982",
                                                "sense_id": "11106cc7-00e4-39d6-bd6d-217ff73146cf",
                                                "text": "Nach der eintägigen Tour kamen die Touristen abends wieder im Hotel an."
                                            },
                                            {
                                                "example_id": "bfaba424-7f06-45dd-8f2a-bcd53efe6cef",
                                                "sense_id": "11106cc7-00e4-39d6-bd6d-217ff73146cf",
                                                "text": "„Auf einer solchen Tour verweilt man an den einzelnen Stationen nicht lange, sondern bleibt immerzu unterwegs.“"
                                            },
                                            {
                                                "example_id": "7d4c2a34-99de-4477-9085-e5a3a3329f2e",
                                                "sense_id": "11106cc7-00e4-39d6-bd6d-217ff73146cf",
                                                "text": "„Studiosus bietet solche Touren an.“"
                                            },
                                            {
                                                "example_id": "8b2845dc-a754-4790-90a3-44e0cfd87ff1",
                                                "sense_id": "11106cc7-00e4-39d6-bd6d-217ff73146cf",
                                                "text": "„Ins Basislager am Fuß des Bergs begleiteten ihn sein Bruder Vincent und sein Vater Alfred, der als junger Mann Touren im Himalaja unternommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74d5f3c3-3861-335e-b629-f8aa850db7ed",
                                        "entry_id": "1846039b-8427-3f44-a154-38f3bc144742",
                                        "glosses": [
                                            "Drehzahl, Umdrehungen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "175c6686-802e-4fa6-94d0-f27169e04e5a",
                                                "sense_id": "74d5f3c3-3861-335e-b629-f8aa850db7ed",
                                                "text": "„Der Motor des Schleppflugzeugs wird auf Touren gebracht, ein Helfer hebt den Flügel des Segelflugzeuges an, und nun zieht der Motorflieger an.“"
                                            },
                                            {
                                                "example_id": "6fa8c3cd-1b47-48cf-af05-ba0c858c0b4f",
                                                "sense_id": "74d5f3c3-3861-335e-b629-f8aa850db7ed",
                                                "text": "Der Motor kam auf Touren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b0db6a2d-8b1c-30fc-9b46-05bec32e484b",
                                        "entry_id": "1846039b-8427-3f44-a154-38f3bc144742",
                                        "glosses": [
                                            "Tanzfigur im Ballett"
                                        ],
                                        "tags": [
                                            "Ballett"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ccf082d-b358-49d3-83d5-73f0a349fa3d",
                                                "sense_id": "b0db6a2d-8b1c-30fc-9b46-05bec32e484b",
                                                "text": "Jede Pose kann auch als Tour getanzt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
