                                            {
                                                "example_id": "b2e59e80-9847-4067-a64e-82bc3376e6ea",
                                                "sense_id": "f9230ae0-c332-3aad-bbea-8c1cc92d7071",
                                                "text": "L’énorme hydravion Do X avec lequel les Allemands se proposent de transporter un nombre important de passagers et du fret d’Allemagne aux États-Unis, apparaîtra comme trop grand pour son utilisation dans un but pratique."
                                            },
                                            {
                                                "example_id": "a765b676-bdfb-4040-a9ae-305ebf664e4e",
                                                "sense_id": "f9230ae0-c332-3aad-bbea-8c1cc92d7071",
                                                "text": "Maintenant, l’avion avait fait place à un hydravion, car on survolait le Nil qui offrait de magnifiques plans d’eau."
                                            },
                                            {
                                                "example_id": "694211d1-b13a-4764-89cb-ea995ec2ef73",
                                                "sense_id": "f9230ae0-c332-3aad-bbea-8c1cc92d7071",
                                                "text": "L’épave d’un hydravion qui a coulé dans un lac situé à 50 kilomètres au nord de Sept-Îles, il y près de 100 ans, a été découverte au cours des dernières semaines."
                                            }
                                        ]
                                    }
                                ]
