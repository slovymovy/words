                "senses": [
                    {
                        "sense_id": "808b7a10-8f19-31ab-9e9c-aa06cedb12a7",
                        "entry_id": "944671ac-b4f4-388a-9779-a45eb8a2c8c8",
                        "glosses": [
                            "pokarmy poświęcone w Wielką Sobotę i spożywane podczas Wielkanocy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db61b5c-10bf-4f0c-aabe-8d099eb40963",
                                "sense_id": "808b7a10-8f19-31ab-9e9c-aa06cedb12a7",
                                "text": "Obok, przed kościołem katolickim ludzie nieśli święconkę. Ksiądz w komży czekał na ostatnich parafian przed wejściem"
                            },
                            {
                                "example_id": "c7e5d801-2e8c-4376-9aed-5425663b6dc6",
                                "sense_id": "808b7a10-8f19-31ab-9e9c-aa06cedb12a7",
                                "text": "W sobotę w domach katolickich święcono pokarmy. Kto miał się lepiej, przygotowywał święconkę u siebie, biedniejsi umawiali się między sobą, przynosili ją do jednego z mieszkańców i razem święcili"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "380627d0-484d-3466-b605-112cb5e2cabc",
                        "entry_id": "944671ac-b4f4-388a-9779-a45eb8a2c8c8",
                        "glosses": [
                            "wielkanocny zwyczaj święcenia pokarmów w Wielką Sobotę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c37c6be-bacc-4e3f-859f-b0001bee228c",
                                "sense_id": "380627d0-484d-3466-b605-112cb5e2cabc",
                                "text": "W środowisku polskich emigrantów w Hamburgu aż 89,5% respondentów nadal pielęgnuje święconkę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
