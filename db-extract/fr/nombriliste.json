                "senses": [
                    {
                        "sense_id": "eafb1564-6bd1-3be5-acc7-5054bbae9698",
                        "entry_id": "ea587a95-d405-3a43-9a83-b627ec2afec4",
                        "glosses": [
                            "Qualifie le fait qu’une personne, une collectivité, une société ne s’intéresse qu’à elle-même, ne tienne compte des réalités extérieures que dans la mesure où elles concernent ses intérêts. → voir égocentrique, narcissique"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f77da48a-c430-4df1-8c1b-3d39ca7e2b48",
                                "sense_id": "eafb1564-6bd1-3be5-acc7-5054bbae9698",
                                "text": "Il faut concevoir une société moins masculine, moins nombriliste, plus altruiste, plus attentive…"
                            },
                            {
                                "example_id": "05ca2167-f3b9-4cc7-96f3-8611ff9f2783",
                                "sense_id": "eafb1564-6bd1-3be5-acc7-5054bbae9698",
                                "text": "Je me dépêche de traverser la rue pour éviter la vitrine du club de gym où des sportives nombrilistes me dévisageraient bêtement."
                            },
                            {
                                "example_id": "029babac-65a8-4532-9763-f72474189c5c",
                                "sense_id": "eafb1564-6bd1-3be5-acc7-5054bbae9698",
                                "text": "Nous sommes tellement gâtés, tellement nombrilistes que le rappel de ces évidences en fâche beaucoup."
                            }
                        ]
                    }
                ],
