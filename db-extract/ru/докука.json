                "senses": [
                    {
                        "sense_id": "8c734379-4af8-3565-b085-a41b5e0defa4",
                        "entry_id": "45ac91aa-695c-3d21-9556-125cc89a24f4",
                        "glosses": [
                            "bore"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "681f9348-b8cf-41e5-af01-c9ea2def643d",
                                "sense_id": "8c734379-4af8-3565-b085-a41b5e0defa4",
                                "text": "А вот тепе́рь прихо́дится понево́ле, — ду́мал он, — идти́ и объясня́ться. Кака́я тя́гость! Кака́я доку́ка! И ещё е́сли бы мо́жно бы́ло напа́костить там, куда́ он идёт, а то нет ему́ и э́того утеше́ния.",
                                "translation": "\" And now I must go against my will,\" he thought, \" and explain matters.\" What a burden ! What a bore ! If he had an opportunity at least of besmirching the place he was about to visit—but even this consolation was denied to him.",
                                "english": "\" And now I must go against my will,\" he thought, \" and explain matters.\" What a burden ! What a bore ! If he had an opportunity at least of besmirching the place he was about to visit—but even this consolation was denied to him."
                            }
                        ]
                    }
                ],
