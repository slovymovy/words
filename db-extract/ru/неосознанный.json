                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2773c6d-721b-46f0-b2cb-57649e0a2c30",
                        "source_entry_id": "408dca9a-74d8-3ccc-8a7e-6233b1fca351",
                        "source_sense_id": "01e8f581-05aa-3ae1-a79a-25744ec74694",
                        "target_lang_word": "unconscious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unconscious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea5fe5ce-e0ae-3fed-88b2-3ed5836b8558",
                                        "entry_id": "2002eb96-4d54-30ac-b29b-63518976998a",
                                        "glosses": [
                                            "Not awake; having no awareness (usually as the result of a head injury)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a446a1f-fd37-4b37-a8f3-f4cf935f3810",
                                                "sense_id": "ea5fe5ce-e0ae-3fed-88b2-3ed5836b8558",
                                                "text": "After the anesthetist administered the general anesthetic the patient was unconscious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9857a6-d98f-3d49-999f-4f3bf3d8547b",
                                        "entry_id": "2002eb96-4d54-30ac-b29b-63518976998a",
                                        "glosses": [
                                            "Without directed thought or awareness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa0aa3d-c946-4e04-962c-e2954ffc6abc",
                                                "sense_id": "ff9857a6-d98f-3d49-999f-4f3bf3d8547b",
                                                "text": "My sudden fright was an unconscious response."
                                            },
                                            {
                                                "example_id": "3a2107ba-ec7b-4fc3-94e8-3839ee93e338",
                                                "sense_id": "ff9857a6-d98f-3d49-999f-4f3bf3d8547b",
                                                "text": "It was intolerable, he felt, to sit and eat in presence of that silent figure partly turned away from him, jotting down the different amounts on a bit of paper, and absorbed in that occupation as if unconscious of his presence."
                                            },
                                            {
                                                "example_id": "3ec031d7-af74-4d47-a549-3b3241544572",
                                                "sense_id": "ff9857a6-d98f-3d49-999f-4f3bf3d8547b",
                                                "text": "Reshaping [of British Railways] was far from perfect. It was tainted by statistical overreach, the unconscious biases of its author, and by the political demands being placed upon the BRB by government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b78a3c-f1b0-30b9-a58b-f214ac114148",
                                        "entry_id": "2002eb96-4d54-30ac-b29b-63518976998a",
                                        "glosses": [
                                            "engaged in skilled performance without conscious control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b224e7-da7d-4d97-90e7-7ac09d2efafa",
                                                "sense_id": "95b78a3c-f1b0-30b9-a58b-f214ac114148",
                                                "text": "Sam is unconscious, filling it, drilling it from every conceivable angle. Lem is awful and Cooper seems confused. Josh shoots too often."
                                            },
                                            {
                                                "example_id": "87a89e28-2391-43a8-9ae7-54e19b6f1ed6",
                                                "sense_id": "95b78a3c-f1b0-30b9-a58b-f214ac114148",
                                                "text": "\"I was unconscious,\" the basketball player gushes. \"It seemed like everything I threw up toward the basket went straight in.\""
                                            },
                                            {
                                                "example_id": "114f15a5-44bd-42c5-9c12-edd23f522fa0",
                                                "sense_id": "95b78a3c-f1b0-30b9-a58b-f214ac114148",
                                                "text": "Someone who has reeled off a string of baskets will say, \"I was unconscious,\" as if he were following the Zen injunction to be mindful while suspending thought."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unconscious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2167ba72-6e95-3cb6-a011-726f9d93ace1",
                                        "entry_id": "26f8e1fd-2966-3b06-8a1a-7d91399cf4f9",
                                        "glosses": [
                                            "That part of mind that is not consciously perceived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "720d05b2-260c-408b-84d8-a3f40b8b05c3",
                                                "sense_id": "2167ba72-6e95-3cb6-a011-726f9d93ace1",
                                                "text": "Because the unconscious is outside time, it can perceive transformations beyond the limits of the ego."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ed0313f-3018-48f0-a482-2b6d3b0f788c",
                        "source_entry_id": "408dca9a-74d8-3ccc-8a7e-6233b1fca351",
                        "source_sense_id": "01e8f581-05aa-3ae1-a79a-25744ec74694",
                        "target_lang_word": "subconscious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subconscious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc35fd5-14e5-3605-a336-90626e2056df",
                                        "entry_id": "49204e62-c893-3d6f-81ef-3e885d6035bf",
                                        "glosses": [
                                            "Occuring in the part of our mind that we are not normally aware of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed301965-2bb4-402e-a843-4753d6fb82c9",
                                                "sense_id": "7dc35fd5-14e5-3605-a336-90626e2056df",
                                                "text": "The sense of smell can be a subconscious influence on our actions."
                                            },
                                            {
                                                "example_id": "2d7c6772-59e9-40e0-8f29-ecdac350b99e",
                                                "sense_id": "7dc35fd5-14e5-3605-a336-90626e2056df",
                                                "text": "The “name-letter effect” refers to the subconscious bias that people have for the letters in their own name, and for their own initials in particular. They are more likely to choose careers, partners and brands that start with their initials (Joe becomes a joiner, marries Judy and loves Jaffa cakes)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be9129a-521f-3c00-9892-4500867462bc",
                                        "entry_id": "49204e62-c893-3d6f-81ef-3e885d6035bf",
                                        "glosses": [
                                            "Partially conscious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8427ae38-20c3-4163-8e32-fe5c56097357",
                                                "sense_id": "3be9129a-521f-3c00-9892-4500867462bc",
                                                "text": "What other neurological examination techniques are useful for assessing central nervous system (CNS) damage in a subconscious patient?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subconscious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e344cedc-26e5-3c9e-8826-7f0b16b9d9a7",
                                        "entry_id": "c5df2dc2-7378-3432-927b-6f61c25a01c0",
                                        "glosses": [
                                            "The part of the mind that we are not normally aware of."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49411431-bd9a-4cd1-9a2e-57adc830fbc4",
                                                "sense_id": "e344cedc-26e5-3c9e-8826-7f0b16b9d9a7",
                                                "text": "A person can sometimes wake up knowing the solution to a problem that their subconscious has been working on."
                                            },
                                            {
                                                "example_id": "5bdab599-f6c4-4053-a3de-d850d9f06713",
                                                "sense_id": "e344cedc-26e5-3c9e-8826-7f0b16b9d9a7",
                                                "text": "At a recent meeting of the Organisation for Human Brain Mapping, held in Brighton, England, they explained how brain-scanning has revealed differences in the ways that traumatised and healthy brains respond to the world. This enables researchers to peer into the subconscious of traumatised patients."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
