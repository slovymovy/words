                "senses": [
                    {
                        "sense_id": "17073cc0-d0c6-335e-81a6-1b360f12b693",
                        "entry_id": "8f1c7ad4-9eec-3520-98f1-18c5c9b2d0f9",
                        "glosses": [
                            "van personen dat ze op het televisiescherm een goede uitstraling hebben, soms zelfs beter dan in het echt"
                        ],
                        "tags": [
                            "media"
                        ],
                        "examples": [
                            {
                                "example_id": "3dccb987-7fbb-4ba7-8409-148c1efead3a",
                                "sense_id": "17073cc0-d0c6-335e-81a6-1b360f12b693",
                                "text": "Met haar mediagenieke optreden wist Witt vooral de fotoredacteurs te verleiden. Wat ze precies met haar actie wilde aanklagen, kwam minder goed uit de verf. Haar boodschap dat de ECB een ondemocratische instelling is, werd maar door weinig media opgepikt. Het is nochtans een pertinente vaststelling."
                            },
                            {
                                "example_id": "3af33ca0-338a-4fff-b609-28198f6e362e",
                                "sense_id": "17073cc0-d0c6-335e-81a6-1b360f12b693",
                                "text": "Volgens wethouder Van Rees bracht Sijbom liefst 26.738 nieuwtjes op Twitter. \"Dat is gemiddeld 13 stuks per dag.\" Burgemeester Sander Schelberg van Hengelo nam het ‘mediagenieke optreden’ van zijn collega op de hak. Gemeenteraadslid Ellen Visschedijk verzuchtte ‘dat het nu rustig wordt op Twitter en Facebook’."
                            }
                        ]
                    }
