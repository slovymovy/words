                        "cross_references": [
                            {
                                "target_word": "залог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5818fd03-faf0-37b1-88f9-e683b6be27da",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
                                            "отдача денег или других ценностей в обеспечение обязательств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502eb7e6-f9ea-4d92-9fed-926226db88b9",
                                                "sense_id": "5818fd03-faf0-37b1-88f9-e683b6be27da",
                                                "text": "Залог имущества, переданного залогодателем на время во владение или пользование третьему лицу, считается залогом с оставлением его у залогодателя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20638d88-d24d-3157-a87f-92604f18de92",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
                                            "перен. деньги или другие ценности, отдаваемые таким образом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8bc32c-0963-4a6d-a0a6-bf4fc2a113e3",
                                                "sense_id": "20638d88-d24d-3157-a87f-92604f18de92",
                                                "text": "Во время подписания предварительного соглашения покупатель оставляет залог, который, как правило, не превышает 10 %."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d416d714-eced-300b-a13a-b9d152f13d19",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
                                            "перен. гарантия, нечто, служащее подтверждением чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab457a05-c577-4b58-96dd-101a750a5c78",
                                                "sense_id": "d416d714-eced-300b-a13a-b9d152f13d19",
                                                "text": "Мисс Жаксон, удостоверясь, что Лиза не думала поднять её на смех, успокоилась, поцеловала Лизу и в залог примирения подарила ей баночку английских белил, которую Лиза приняла с изъявлением искренней благодарности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c564ea6-4af6-3f7a-b4c5-5aae0d0886a7",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
