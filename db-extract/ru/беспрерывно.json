        "ru-extract.jsonl": [
            {
                "entry_id": "0a43e0c9-9e02-3d61-9614-42d263c8edbe",
                "word": "беспрерывно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2720ecfa-2f16-3d51-bb33-0fe91d0c3221",
                        "entry_id": "0a43e0c9-9e02-3d61-9614-42d263c8edbe",
                        "glosses": [
                            "соотносится по значению с прил. беспрерывный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5faf485c-3544-48d7-9ac2-f56dc8ad7523",
                                "sense_id": "2720ecfa-2f16-3d51-bb33-0fe91d0c3221",
                                "text": "Ведя меня по бесконечным коридорам и распахнув передо мной дверь своего небольшого кабинета, где на столе стояли две вазочки ― одна с несколькими розово-белыми гвоздиками, а другая с самыми разнообразными конфетами ― и с просто «Мишками», и «Мишками на севере», и грильяжем, и ирисками, и карамелью с черносмородиновой и малиновой начинкой, она щебетала беспрерывно〈…〉"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eed78be5-ef8a-4e9d-a571-bf71ab2c0897",
                        "source_entry_id": "0a43e0c9-9e02-3d61-9614-42d263c8edbe",
                        "source_sense_id": "2720ecfa-2f16-3d51-bb33-0fe91d0c3221",
                        "target_lang_word": "incessantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incessantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                        "entry_id": "1c0b5e0c-ce41-3dbd-9e12-4edd7241bf72",
                                        "glosses": [
                                            "In a manner without pause or stop, especially to the point of annoyance; not ceasing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8942fe8-0ec5-4c4c-994d-570e2a765d3f",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "He jabbered incessantly and annoyed everyone."
                                            },
                                            {
                                                "example_id": "536a0ccc-3282-4737-88a6-732bbbeeeadf",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "We see the eye subdued, the practised smile, / The word well weighed before it pass the lip, / And know not of the misery within: / Yet there it works incessantly, and fears / The time to come; for time is terrible, / Avenging, and betraying."
                                            },
                                            {
                                                "example_id": "2e14b3c7-51e7-4df8-aa70-a7cd7fc6aace",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "There were the tawny rocks, like lions couchant, defying the ocean, whose waves incessantly dashed against and scoured them with vast quantities of gravel."
                                            },
                                            {
                                                "example_id": "f9c7e3be-79a0-4415-a38f-d8f664b958e3",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "\"You are old, Father William,\" the young man said, / \"And your hair has become very white; / And yet you incessantly stand on your head— / Do you think, at your age, it is right?\""
                                            },
                                            {
                                                "example_id": "c9c5f751-e862-4067-8772-2e8d94d1463f",
                                                "sense_id": "609e7f3d-9a0a-3a8c-b720-4ebe9a4fa969",
                                                "text": "But just there a small hairy terrier exploded out at the gate, like a floor-mop impelled by some sort of internal combustion, which sent him off into a frenzy of yapping, incessantly jerked backwards by the explosive force of his own detonations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fabb34e-2301-3f1c-94da-4807df624300",
                                        "entry_id": "1c0b5e0c-ce41-3dbd-9e12-4edd7241bf72",
                                        "glosses": [
                                            "Immediately."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8b3e487-86e8-422b-bfbc-0796f41bb2c2",
                        "source_entry_id": "0a43e0c9-9e02-3d61-9614-42d263c8edbe",
