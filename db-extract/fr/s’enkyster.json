                "senses": [
                    {
                        "sense_id": "53477cec-6e85-3e6c-bb24-cee394a80e25",
                        "entry_id": "440ea80d-348c-390e-a83b-a7c2b3726221",
                        "glosses": [
                            "Se diriger vers un état chronique ou pathologique."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "449606d6-3545-4dad-90a4-40c5a1c6d089",
                                "sense_id": "53477cec-6e85-3e6c-bb24-cee394a80e25",
                                "text": "Un délire plus ancien est capable de s'enkyster."
                            },
                            {
                                "example_id": "24f0fd49-74cf-4cb6-9276-c8306e34766a",
                                "sense_id": "53477cec-6e85-3e6c-bb24-cee394a80e25",
                                "text": "Une paranoïa (c’est plus évident avec des drogues) peut s’enkyster sous forme de noyaux interprétatifs, persécutés ou mégalomaniaques, au milieu de plages de psychisme sain."
                            }
                        ]
                    },
