                    }
                ],
                "senses": [
                    {
                        "sense_id": "95aa04cd-21f3-3e09-a3f4-6d20304567dc",
                        "entry_id": "e9758144-002c-3fe9-9a29-450ec0e378c5",
                        "glosses": [
                            "Adresser à quelqu’un des reproches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ca86dde-d1f4-4eaf-9b09-f4f26d57c462",
                                "sense_id": "95aa04cd-21f3-3e09-a3f4-6d20304567dc",
                                "text": "Il les objurguait de haut en bas comme l’eût fait un prophète. « Ce sont des chiens, disait-il, qui ont tous un collier au cou."
                            }
                        ]
                    },
                    {
                        "sense_id": "82def29c-d0ae-3c25-8761-df06a13def41",
                        "entry_id": "e9758144-002c-3fe9-9a29-450ec0e378c5",
                        "glosses": [
                            "Presser instamment quelqu’un d’agir différemment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c39fdbb-f035-432d-ac40-2df3f1868d10",
                                "sense_id": "82def29c-d0ae-3c25-8761-df06a13def41",
                                "text": "En vain notre archiprêtre objurgua ces mauvais chrétiens de nous laisser faire carême."
                            },
                            {
                                "example_id": "7766349b-ac4e-42e3-876a-3a8c7af718dc",
                                "sense_id": "82def29c-d0ae-3c25-8761-df06a13def41",
                                "text": "Périodiquement, choisissant le moment qu’ils croyaient propice, des parlementaires, qui se fussent résignés à supporter le fardeau écrasant du pouvoir, objurguaient les députés de tenir les promesses qu’ils avaient facilement distribuées aux électeurs."
                            },
                            {
                                "example_id": "d53797a0-81a1-4664-994f-5531b3516ed9",
                                "sense_id": "82def29c-d0ae-3c25-8761-df06a13def41",
                                "text": "Tout au plus, il lisait quelques pages du De cultu feminarum où Tertullien objurgue les femmes de ne pas se parer de bijoux et d’étoffes précieuses, et leur défend l’usage des cosmétiques parce qu’ils essayent de corriger la nature et de l'embellir."
                            },
                            {
                                "example_id": "17878e47-5a6b-4f4c-bb25-57efc439294f",
                                "sense_id": "82def29c-d0ae-3c25-8761-df06a13def41",
                                "text": "La triste suite est connue : les banques américaines financèrent le réarmement allemand dans les années trente, et Washington objurgua Paris de ne pas bouger quand Hitler remilitarisa la Rhénanie en mars 1936, en violation flagrante du traité de Versailles."
                            }
                        ]
                    },
                    {
                        "sense_id": "fab28757-c465-3528-82c2-a8a5432b1a16",
                        "entry_id": "e9758144-002c-3fe9-9a29-450ec0e378c5",
                        "glosses": [
                            "S’efforcer continuellement d’agir autrement."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "74634db4-1cbf-4e76-a4f3-7bdd7c01b841",
                                "sense_id": "fab28757-c465-3528-82c2-a8a5432b1a16",
                                "text": "Son cœur commençait à battre plus fort, et elle s’objurguait de rester naturelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "011a9bf2-ba28-4946-9637-47e37e56408e",
                        "source_entry_id": "e9758144-002c-3fe9-9a29-450ec0e378c5",
                        "target_lang_word": "objurgate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objurgate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aad3d23-d07f-3afd-9c74-fced078b6662",
                                        "entry_id": "3ad8a8ef-48ab-31af-a880-daa7bedb8942",
                                        "glosses": [
                                            "To rebuke or scold strongly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39997bc-9839-4ed0-bcee-4cfa41f8b6a3",
                                                "sense_id": "2aad3d23-d07f-3afd-9c74-fced078b6662",
                                                "text": "He waited and waited, in the faith that Schinkel was dealing with them in his slow, categorical Teutonic way, and only objurgated the cabinetmaker for having in the first place paltered with his sacred trust.[…]"
                                            },
                                            {
                                                "example_id": "0d9c5020-c1c1-4f00-a0c2-5b3f9f659229",
                                                "sense_id": "2aad3d23-d07f-3afd-9c74-fced078b6662",
                                                "text": "When he saw his servant he rushed forward, and pressing the paper on him objurgated him, in tones which induced Ali to think that something awful had happened, to hurry up and get the whale-boat ready to go immediately—at once, at once—after Captain Lingard."
                                            },
                                            {
                                                "example_id": "c2aecc66-31e6-4eca-a32b-09152b7ff1ba",
                                                "sense_id": "2aad3d23-d07f-3afd-9c74-fced078b6662",
                                                "text": "Mulcachy was disgusted. “Listen to reason, won’t you?” he objurgated, as, this time, the reason he referred to was the introduction of the ring clear through both nostrils, higher up, and through the central dividing wall of cartilage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
