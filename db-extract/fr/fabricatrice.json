                "senses": [
                    {
                        "sense_id": "b79c5b54-5d2d-3848-a7fa-86ce7cdd3b83",
                        "entry_id": "342edff4-dbeb-3ca9-9187-8d890ec5d88c",
                        "glosses": [
                            "Celle qui confectionne quelque chose."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3783d03a-51d4-490a-b295-7d1a9f331d28",
                                "sense_id": "b79c5b54-5d2d-3848-a7fa-86ce7cdd3b83",
                                "text": "La fabricatrice de philtres d’amour et de médecines, la guérisseuse et devineresse, devient empoisonneuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4287e5c-d4b8-3856-898c-ba95da677686",
                        "entry_id": "342edff4-dbeb-3ca9-9187-8d890ec5d88c",
                        "glosses": [
                            "Celle qui produit une œuvre intellectuelle ou artistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e710b71b-ba07-48a5-b46a-55c61a504817",
                                "sense_id": "c4287e5c-d4b8-3856-898c-ba95da677686",
                                "text": "On constate une opposition claire entre la nomenclature qui est une fabricatrice de systèmes et la recherche des propriétés."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f5e6787-ca90-395d-a15f-2e0651ddc400",
                        "entry_id": "342edff4-dbeb-3ca9-9187-8d890ec5d88c",
                        "glosses": [
                            "Celle qui produit un objet de mauvaise qualité, une pensée trompeuse (à la différence de fabricante, terme neutre)."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b16c085a-966e-4063-ad7e-bb80f552120d",
                                "sense_id": "9f5e6787-ca90-395d-a15f-2e0651ddc400",
                                "text": "La rhétorique, ouvrière-démiurge de persuasion dans les assemblées politiques, peut se dégrader en ouvrière de simulation par la technique de la flatterie, en fabricatrice de mensonge et de contrefaçon de la justice."
                            }
                        ]
                    }
                ],
