                                                "sense_id": "4ac0af73-f927-3535-a347-7635017e049d",
                                                "text": "And all the sparks that may bring unto flame / Hate betwixt man and wife, or breed defame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e09eb1-a48f-3020-897b-b151fa7337c2",
                                        "entry_id": "da8c3519-9d41-3518-9b0e-35bdff4f7a9f",
