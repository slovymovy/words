    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18b7371f-4c98-3474-a6b8-2d22c2f8129f",
                    "sense_definition": "iets formeel afwijzen of niet accepteren omdat het niet voldoet aan de eisen of verwachtingen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "afwijzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het rapport werd meteen <w>verworpen</w> omdat het vol met taalfouten stond.",
                            "target_lang_translations": {
                                "en": "The report was immediately <w>rejected</w> because it was full of linguistic errors."
                            }
                        },
                        {
                            "text": "De commissie besloot het voorstel te <w>verwerpen</w> na een lange discussie.",
                            "target_lang_translations": {
                                "en": "The committee decided to <w>reject</w> the proposal after a long discussion."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwijzen",
                        "afkeuren",
                        "weigeren"
                    ],
                    "antonyms": [
                        "aanvaarden",
                        "accepteren",
                        "goedkeuren"
                    ],
                    "common_phrases": [
                        "een voorstel verwerpen",
                        "een amendement verwerpen",
                        "een eis verwerpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To formally reject or not accept something because it does not meet requirements or expectations."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reject",
                                "target_lang_sense_clarification": "to refuse to accept a proposal or report"
                            },
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to treat as unworthy of consideration"
                            },
                            {
                                "target_lang_word": "turn down",
                                "target_lang_sense_clarification": "to refuse an offer or request"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe690b72-ee1b-37a7-a5d3-8d2aaea19f52",
                    "sense_definition": "iemand uit een gemeenschap of familie verdrijven of niet langer als lid erkennen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verstoten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het schandaal werd hij door zijn hele familie <w>verworpen</w>.",
                            "target_lang_translations": {
                                "en": "After the scandal, he was <w>disowned</w> by his entire family."
                            }
                        },
                        {
                            "text": "Zij voelde zich <w>verworpen</w> door de maatschappij waarin ze leefde.",
                            "target_lang_translations": {
                                "en": "She felt <w>rejected</w> by the society she lived in."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstoten",
                        "verbannen",
                        "uitsluiten"
                    ],
                    "antonyms": [
                        "opnemen",
                        "omarmen"
                    ],
                    "common_phrases": [
                        "iemand verstoten en verwerpen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in passieve vorm gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cast someone out of a community or family or no longer recognize them as a member."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reject",
                                "target_lang_sense_clarification": "to refuse to acknowledge or accept a person"
                            },
                            {
                                "target_lang_word": "disown",
                                "target_lang_sense_clarification": "to refuse to acknowledge as one's own, especially family"
                            },
                            {
                                "target_lang_word": "cast out",
                                "target_lang_sense_clarification": "to expel from a group"
                            },
                            {
                                "target_lang_word": "repudiate",
                                "target_lang_sense_clarification": "to reject or renounce a person or relationship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "096e666f-3d00-3db7-9839-691fc60798e2",
                    "sense_definition": "een rechter of getuige formeel afwijzen wegens vermeende partijdigheid",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat probeerde de rechter te <w>verwerpen</w> vanwege een mogelijk belangenconflict.",
                            "target_lang_translations": {
                                "en": "The lawyer tried to <w>challenge</w> the judge because of a possible conflict of interest."
                            }
                        },
                        {
                            "text": "Het verzoek om de getuige te <w>verwerpen</w> werd door het hof afgewezen.",
                            "target_lang_translations": {
                                "en": "The request to <w>reject</w> the witness was denied by the court."
                            }
                        }
                    ],
                    "synonyms": [
                        "wraken"
                    ],
                    "common_phrases": [
                        "een rechter verwerpen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To formally challenge or reject a judge or witness due to alleged bias."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "challenge",
                                "target_lang_sense_clarification": "to object to a juror or judge"
                            },
                            {
                                "target_lang_word": "recuse",
                                "target_lang_sense_clarification": "to disqualify a judge or witness for bias"
                            },
                            {
                                "target_lang_word": "reject",
                                "target_lang_sense_clarification": "to formally dismiss a witness or judge"
                            }
                        ]
                    }
                },
                {
