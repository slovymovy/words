                        "entry_id": "eec3e670-5d12-3d24-a8e4-5f791e54401e",
                        "glosses": [
                            "godmother (female godparent)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8030389f-60e9-49d3-b308-07f8e579f6f4",
                                "sense_id": "41cca29c-8915-38dc-b065-2045af8553ab",
                                "text": "Ze vroeg haar beste vriendin om de peetmoeder van haar kind te zijn.",
                                "translation": "She asked her best friend to be the godmother of her child.",
                                "english": "She asked her best friend to be the godmother of her child."
                            },
                            {
                                "example_id": "b842c839-743b-41a4-93ae-48d6d4a7a8d4",
                                "sense_id": "41cca29c-8915-38dc-b065-2045af8553ab",
                                "text": "Elk kind in de familie heeft zowel een peetvader als een peetmoeder.",
                                "translation": "Every child in the family has both a godfather and a godmother.",
                                "english": "Every child in the family has both a godfather and a godmother."
                            },
                            {
                                "example_id": "ba81bbb5-fbc9-4b4e-a64d-f921e4ae11da",
                                "sense_id": "41cca29c-8915-38dc-b065-2045af8553ab",
                                "text": "Het peetmoedertje gaf een speciaal cadeau tijdens de doop.",
                                "translation": "The little godmother gave a special gift during the baptism.",
                                "english": "The little godmother gave a special gift during the baptism."
                            }
                        ]
                    }
