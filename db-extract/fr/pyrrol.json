                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "049d9986-c2f5-45db-8ec8-92f0ed36b1ac",
                                "sense_id": "f49920e2-45bb-3435-8869-0bb5e3857a21",
                                "text": "Ce glucoside donne la réaction de Millon aussi bien que la réaction xanthoprotéique ; dans ses vapeurs, on décèle du pyrrol."
                            },
                            {
                                "example_id": "24fb77bc-9d52-4ed3-924c-b91cdaadc5e2",
                                "sense_id": "f49920e2-45bb-3435-8869-0bb5e3857a21",
                                "text": "Le pyrrol forme un liquide incolore, d’une odeur agréable, rappelant le chloroforme, d’une saveur brûlante ; il bout à 133° et possède une densité de 1,077."
                            }
                        ]
                    }
                ],
