                "senses": [
                    {
                        "sense_id": "b2b982d0-e6c4-326a-b6f3-1b9b4f246f46",
                        "entry_id": "f9517ef0-96b3-3aa5-9e80-f795bc234b96",
                        "glosses": [
                            "Of, or relating to, Adolf Hitler, German politician and founder of the Nazi party, or his regimes or policies."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd5641a-455e-4b3b-96c0-76ff086f11f9",
                                "sense_id": "b2b982d0-e6c4-326a-b6f3-1b9b4f246f46",
                                "text": "Austria is reminded, however that she has a responsibility, which she cannot evade, for participation in the war on the side of Hitlerite Germany, and that in the final settlement account will inevitably be taken of her own contribution to her liberation."
                            }
                        ]
                    }
                ],
