                ],
                "senses": [
                    {
                        "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                        "entry_id": "afd8278d-46d5-3d10-8f61-f7bc37c3a7fe",
                        "glosses": [
                            "Produktion von Zement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b369a22-62e2-480d-9197-4acb7f382a3d",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Zementproduktion ist ein energie- und abgasintensives Geschäft.“"
                            },
                            {
                                "example_id": "6eae82e8-a428-4b51-9197-3f839c2f0d85",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Als problematisch gilt mittlerweile der Einfluss der Zementproduktion auf das Klima.“"
                            },
                            {
                                "example_id": "590c1176-f148-4d27-855d-77b6497e394e",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Die Zementproduktion ist ein Klimakiller.“"
                            },
                            {
                                "example_id": "4178540a-60db-451a-86d6-b5a65422df88",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Für mindestens sieben Prozent des menschengemachten CO₂-Ausstoßes ist die Zementproduktion verantwortlich.“"
                            },
                            {
                                "example_id": "2d795e80-0c5a-4d0a-af57-c93bff1834a1",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Die Zementproduktion ist eine CO2-Schleuder.“"
                            },
                            {
                                "example_id": "11e22154-977b-48cf-b9bd-cc884c5fc712",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Durch seine Zementproduktion hat der Konzern zwischen 1950 und 2021 mehr als sieben Milliarden Tonnen CO₂ ausgestoßen, was mehr als doppelt so viel ist wie die gesamte Schweiz verursacht hat.“"
                            },
                            {
                                "example_id": "6ca0ecc3-cc1d-479f-a192-423b91e9b15f",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Aufgrund der äußerst treibhausgasintensiven Zementproduktion gehört HeidelbergCement zu den weltweit großen Verursachern von CO₂-Emissionen und ist deswegen entsprechender Kritik ausgesetzt.“"
                            },
                            {
                                "example_id": "d0363524-e73b-46bc-9aff-831b192b3b20",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„CO₂ ist das bedeutendste langlebige Treibhausgas: Die Verbrennung von Kohle, Öl und Gas, die Zementproduktion und andere Industrieprozesse verursachen etwa 70 Prozent aller Treibhausgasemissionen.“"
                            },
                            {
                                "example_id": "dcb645e5-adcd-4824-8975-73529a562866",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Zementindustrie muss grüner werden – Auf der Liste der Klimakiller steht ganz weit oben die Zementproduktion.“"
                            },
                            {
                                "example_id": "bc04dad3-489c-460b-acf6-fe8aad4809fd",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "„Wasserstoff kann Windkraft und Solarstrom speichern, die Stahl-, Chemie oder Zementproduktion grüner machen, Flugzeuge, Schiffe und Autos antreiben.“"
                            },
                            {
                                "example_id": "b27342cb-7e45-4c7a-a015-b749cfb0881a",
                                "sense_id": "fd7605a2-fa80-35b8-9076-72a062717e7c",
                                "text": "[Hemmoor:] „Der Kreidesee im Stadtteil Warstade ist die Hinterlassenschaft von 117 Jahren Zementproduktion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
