{
    "word_family": [
        "thusly"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9e64824d-9475-37c1-b9b5-4c3a9ef81a2e",
                    "sense_definition": "As a result or consequence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have all the tools I need; <w>thus</w>, I will be able to fix the car without having to call a mechanic.",
                            "target_lang_translations": {
                                "ru": "У меня есть все необходимые инструменты; <w>таки́м о́бразом</w>, я смогу починить машину, не вызывая механика.",
                                "tr": "İhtiyacım olan tüm araçlara sahibim; <w>böylece</w> bir tamirci aramak zorunda kalmadan arabayı tamir edebileceğim.",
                                "es": "Tengo todas las herramientas que necesito; <w>por lo tanto</w>, podré arreglar el coche sin tener que llamar a un mecánico.",
                                "zh": "我拥有所有需要的工具，<w>因此</w>我不需要找修理工就能修好车。"
                            }
                        },
                        {
                            "text": "The company failed to meet its sales targets and <w>thus</w> had to reduce its workforce.",
                            "target_lang_translations": {
                                "ru": "Компания не выполнила план продаж и <w>поэ́тому</w> была вынуждена сократить штат.",
                                "tr": "Şirket satış hedeflerine ulaşamadı ve <w>bu nedenle</w> iş gücünü azaltmak zorunda kaldı.",
                                "es": "La empresa no cumplió sus objetivos de ventas y <w>por ello</w> tuvo que reducir su plantilla.",
                                "zh": "该公司未能达到销售目标，<w>从而</w>不得不裁员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "therefore",
                        "consequently",
                        "hence",
                        "so"
                    ],
                    "common_phrases": [
                        "and thus"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В результате, вследствие этого; используется для введения логического вывода.",
                        "tr": "Bir sonucun veya çıkarımın ifadesi olarak; bu nedenle, dolayısıyla.",
                        "es": "Como resultado o consecuencia; se utiliza para introducir una conclusión lógica.",
                        "zh": "表示结果或推论，意为因此、从而。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таки́м о́бразом",
                                "target_lang_sense_clarification": "вводное слово, выражающее итог или следствие"
                            },
                            {
                                "target_lang_word": "сле́довательно",
                                "target_lang_sense_clarification": "логический вывод"
                            },
                            {
                                "target_lang_word": "поэ́тому",
                                "target_lang_sense_clarification": "по этой причине"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "böylece",
                                "target_lang_sense_clarification": "sonuç ve etki bildirmek için"
                            },
                            {
                                "target_lang_word": "bu nedenle",
                                "target_lang_sense_clarification": "neden-sonuç ilişkisi kurmak için"
                            },
                            {
                                "target_lang_word": "dolayısıyla",
                                "target_lang_sense_clarification": "mantıksal sonuç çıkarmak için"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "por lo tanto",
                                "target_lang_sense_clarification": "conector formal para indicar una consecuencia lógica"
                            },
                            {
                                "target_lang_word": "por ello",
                                "target_lang_sense_clarification": "indica que algo sucede a causa de lo mencionado anteriormente"
                            },
                            {
                                "target_lang_word": "así",
                                "target_lang_sense_clarification": "uso coloquial para introducir una conclusión obvia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "因此",
                                "target_lang_sense_clarification": "表示因果关系，用于连接两个分句"
                            },
                            {
                                "target_lang_word": "从而",
                                "target_lang_sense_clarification": "表示通过前述情况导致的结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eb5bb97-1f83-338c-a7f1-3c18ded2efb1",
                    "sense_definition": "In this way or manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you hold the pen <w>thus</w>, as I am showing you, your handwriting will improve.",
                            "target_lang_translations": {
                                "ru": "Если вы будете держать ручку <w>так</w>, как я вам показываю, ваш почерк улучшится.",
                                "tr": "Kalemi size gösterdiğim gibi <w>bu şekilde</w> tutarsanız el yazınız gelişecektir.",
                                "es": "Si sostienes el bolígrafo <w>así</w>, como te estoy mostrando, tu caligrafía mejorará.",
                                "zh": "如果你像我演示的那样<w>这样</w>握笔，你的字迹会有所改善。"
                            }
                        },
                        {
                            "text": "The contract was structured <w>thus</w>: first the payment terms, and then the delivery schedule.",
                            "target_lang_translations": {
                                "ru": "Договор был составлен <w>сле́дующим о́бразом</w>: сначала условия оплаты, а затем график поставок.",
                                "tr": "Sözleşme <w>şöyle</w> yapılandırılmıştı: önce ödeme koşulları, ardından teslimat takvimi.",
                                "es": "El contrato se estructuró <w>así</w>: primero las condiciones de pago y luego el calendario de entregas.",
                                "zh": "合同的结构是<w>这样</w>的：先是付款条款，然后是交付时间表。"
                            }
                        }
                    ],
                    "synonyms": [
                        "like this",
                        "like so",
                        "this way",
                        "so"
                    ],
                    "common_phrases": [
                        "thus far"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Этим способом, подобным образом.",
                        "tr": "Bu şekilde, bu biçimde, şu şekilde.",
                        "es": "De esta manera o forma; indica el modo en que se realiza una acción.",
                        "zh": "表示方式或方法，意为这样、以此方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "так",
                                "target_lang_sense_clarification": "указание на способ действия"
                            },
                            {
                                "target_lang_word": "таки́м о́бразом",
                                "target_lang_sense_clarification": "образ действия"
                            },
                            {
                                "target_lang_word": "сле́дующим о́бразом",
                                "target_lang_sense_clarification": "при перечислении или пояснении (обычно перед двоеточием)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bu şekilde",
                                "target_lang_sense_clarification": "tarz veya yöntem bildirmek için"
                            },
                            {
                                "target_lang_word": "böyle",
                                "target_lang_sense_clarification": "tarz ve yöntem bildirmek için"
                            },
                            {
                                "target_lang_word": "şöyle",
                                "target_lang_sense_clarification": "açıklama yapmadan önce (genellikle iki nokta öncesinde)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "así",
                                "target_lang_sense_clarification": "indica el modo o la forma en que se hace algo"
                            },
                            {
                                "target_lang_word": "de esta manera",
                                "target_lang_sense_clarification": "expresión equivalente para describir un método o forma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这样",
                                "target_lang_sense_clarification": "指代某种方式或状态"
                            },
                            {
                                "target_lang_word": "以此方式",
                                "target_lang_sense_clarification": "正式表达，强调动作的执行方法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f4d6ea22-2a71-36d8-8e79-431832762753",
                    "sense_definition": "Plural of <w>Thu</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited the <w>Thus</w> to the dinner party, hoping to meet the whole family.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Тху</w> на званый ужин, надеясь познакомиться со всеми.",
                                "tr": "Tüm aileyle tanışmayı umarak <w>Thu'ları</w> akşam yemeğine davet ettik.",
                                "es": "Invitamos a <w>los Thu</w> a la cena, esperando conocer a toda la familia.",
                                "zh": "我们邀请了 <w>Thu 一家</w>参加晚宴，希望能见到他们全家。"
                            }
                        },
                        {
                            "text": "There are three <w>Thus</w> listed in the local telephone directory.",
                            "target_lang_translations": {
                                "ru": "В местном телефонном справочнике значатся трое <w>Тху</w>.",
                                "tr": "Yerel telefon rehberinde üç <w>Thu</w> kayıtlı.",
                                "es": "Hay tres <w>Thu</w> registrados en la guía telefónica local.",
                                "zh": "当地电话簿上列出了三位姓 <w>Thu</w> 的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
