                                    {
                                        "sense_id": "e53e0fec-4c48-3da6-8a66-a5059014ddad",
                                        "entry_id": "1595310d-28fa-300c-9e49-274164df878d",
                                        "glosses": [
                                            "rodzaj długiego, wierzchniego arabskiego okrycia wełnianego, rodzaj rozszerzonej peleryny z kapturem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dadc2e-d979-4e37-8782-d5c02121a56a",
                                                "sense_id": "e53e0fec-4c48-3da6-8a66-a5059014ddad",
                                                "text": "Okryty był sfatygowanym dziurawym burnusem, który ledwie osłaniał przed słońcem jego zbrązowiałe ciało."
                                            },
                                            {
                                                "example_id": "9cf57096-9fb9-42b2-a1c5-55a31e66a5fb",
                                                "sense_id": "e53e0fec-4c48-3da6-8a66-a5059014ddad",
                                                "text": "W środku na czele lecieli dwaj Beduini machając jak opętańcy rękoma i burnusami"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b67a4ca5-1d69-3358-8caf-9e696ffc4c53",
                                        "entry_id": "1595310d-28fa-300c-9e49-274164df878d",
                                        "glosses": [
                                            "płaszcz o kroju przypominającym burnus (1.1)"
                                        ],
