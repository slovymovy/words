                                "target_lang_sense_clarification": "dikkate almadan"
                            },
                            {
                                "target_lang_word": "-e bakmadan",
                                "target_lang_sense_clarification": "günlük konuşma dili"
                            }
                        ]
                    }
                }
            ]
        },
