                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1cf84ecc-9612-36bb-b725-0f159321e163",
                        "entry_id": "fe8b0f49-322e-3057-9c0e-a98dbcd329c1",
                        "glosses": [
                            "To revive."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b3320e78-f5bc-41e2-8bb7-817e7e4180cc",
                                "sense_id": "1cf84ecc-9612-36bb-b725-0f159321e163",
                                "text": "After being abroad for a decade, when he came back he rekindled his obsession with cricket."
                            },
                            {
                                "example_id": "d64aaa87-6bf6-4d3b-a224-ee1e5cc94d05",
                                "sense_id": "1cf84ecc-9612-36bb-b725-0f159321e163",
                                "text": "It was rekindled this summer when going through the all-time football scores for St. Mary’s of Stockton and Oakdale (two of the top programs in the CIF Sac-Joaquin Section) and I discovered that both of them can still count their worst losses as being to Stockton High at 78-0 and 90-0, respectively."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ade8ac3-792d-4e75-85d6-c2752b8a89eb",
                        "source_entry_id": "fe8b0f49-322e-3057-9c0e-a98dbcd329c1",
