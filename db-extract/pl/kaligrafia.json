                    {
                        "translation_id": "2d0823f4-4277-4222-a384-ea01c6cc874d",
                        "source_entry_id": "80ba5af9-8a30-3357-b421-229ed10fce48",
                        "source_sense_id": "b24293f0-6802-381c-8478-2a749178013d",
                        "target_lang_word": "calligraphie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calligraphie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2a8ffbb-2a10-3126-97ca-237a162193cf",
                                        "entry_id": "3a531956-a534-3950-a421-8eedc24fb287",
                                        "glosses": [
                                            "Art de bien former les caractères d’écriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385ce4fc-c018-4d51-81bc-d0b9ef70b50a",
                                                "sense_id": "a2a8ffbb-2a10-3126-97ca-237a162193cf",
                                                "text": "Le bushman prit la lettre que lui présentait son compagnon. Il la tourna et la retourna en homme peu familiarisé avec les mystères de la calligraphie."
                                            },
                                            {
                                                "example_id": "8a733834-af0f-43ab-b92a-f90e204d85bf",
                                                "sense_id": "a2a8ffbb-2a10-3126-97ca-237a162193cf",
                                                "text": "En Sibérie, le lieutenant-colonel apprit, pour tuer le temps, le calcul et la calligraphie au Breton, …."
                                            },
                                            {
                                                "example_id": "5c043981-8f92-4b80-8411-359529a87d10",
                                                "sense_id": "a2a8ffbb-2a10-3126-97ca-237a162193cf",
                                                "text": "Chaque matin, il travaillait à son grand roman dans sa belle calligraphie, répondait à des centaines de questions que lui adressaient depuis sa patrie de jeunes écrivains et travailleurs ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4abb53f2-0108-334e-aecc-30a3e2e95fc4",
                                        "entry_id": "3a531956-a534-3950-a421-8eedc24fb287",
                                        "glosses": [
                                            "Écriture formée de ces beaux caractères."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eabb0e0c-8cea-43c9-b6ef-f37c2947ada8",
                                                "sense_id": "4abb53f2-0108-334e-aecc-30a3e2e95fc4",
                                                "text": "Ce document signé de la main d'un général au paraphe autoritaire prouvait, avec le charme que procurent ces belles calligraphies, qui majusculent jusqu'au nom des imbéciles, que dès l'âge de trente-neuf ans, le Caporal Lendemain, promu adjudant, passait de l'active à la réserve […]."
                                            }
                                        ]
                                    }
                                ]
                            },
