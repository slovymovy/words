                        ],
                        "form": "die Grogs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                        "entry_id": "2cec4138-e960-3f3b-a0aa-df2ab2d813d9",
                        "glosses": [
                            "heißes Getränk aus Rum (auch Weinbrand oder Arrak) mit Wasser und Zucker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054d2767-d370-4eb2-b317-1dae97b44275",
                                "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                                "text": "„Aus der Leutnantskabine kam der Duft von Grog.“"
                            },
                            {
                                "example_id": "3de935ef-0372-4879-836f-0fdf2de3d041",
                                "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                                "text": "„Ich war vollauf damit beschäftigt, Ben mit einem steifen Grog wieder auf die Beine zu bringen und Mrs. Hawkins ein Beruhigungsmittel zu verabfolgen.“"
                            },
                            {
                                "example_id": "f2f26e3d-6f96-419b-96f8-47a12b88bdad",
                                "sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                                "text": "„Eine Weile hatte ich sehr ernste und abgeklärte Gedanken, doch meine neuen Schiffskameraden, von denen einige tatsächlich alte Kameraden von anderen Seglern waren, konnten mich mit Grog aufmuntern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "256e2362-7169-4b89-b8dd-d10fe13b5b7c",
                        "source_entry_id": "2cec4138-e960-3f3b-a0aa-df2ab2d813d9",
                        "source_sense_id": "8351e63f-cfbb-3af6-b525-e110d060d31b",
                        "source_sense_description": "heißes Getränk aus Rum (auch Weinbrand oder Arrak) mit Wasser und Zucker",
                        "target_lang_word": "grog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "190c5607-0c80-3025-84e5-c80ab2377cbe",
                                        "entry_id": "d7eb30f5-3e58-3e89-82ce-29614785e328",
                                        "glosses": [
                                            "An alcoholic beverage made with rum and water, especially that once issued to sailors of the Royal Navy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e11470-7937-4655-bac6-cb3cb6548b2f",
                                                "sense_id": "190c5607-0c80-3025-84e5-c80ab2377cbe",
                                                "text": "[…] giving him a calebash, and the best part of a bottle of my rum, I desired him to run to the creek, and make me some grog, and this he did; but the poor fellow, never having made grog before, poured in all the spirits and but very little water, doubtless thinking, that the stronger it was the better; which beverage I swallowed to the bottom, without taking time to taste it, and I became instantly so much intoxicated that I could hardly keep my feet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3084af69-feef-3d2a-a597-4292e21c4353",
                                        "entry_id": "d7eb30f5-3e58-3e89-82ce-29614785e328",
                                        "glosses": [
                                            "An alcoholic beverage made with rum and water, especially that once issued to sailors of the Royal Navy.",
                                            "An alcoholic beverage made with hot water or tea, sugar and rum, sometimes also with lemon or lime juice and spices, particularly cinnamon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e27362aa-ebd4-3a8b-9515-3439e6548698",
                                        "entry_id": "d7eb30f5-3e58-3e89-82ce-29614785e328",
                                        "glosses": [
                                            "Any alcoholic beverage."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db6b729a-aff0-426f-a0f1-745c6a920058",
                                                "sense_id": "e27362aa-ebd4-3a8b-9515-3439e6548698",
                                                "text": "I quite understood their drift, and after a stiff glass of grog, or rather more of the same, and with each a sovereign in hand, they made light of the attack, and swore they would encounter a worse madman any day for the pleasure of meeting so 'bloomin' good a bloke' as your correspondent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecf2ed66-258c-37cb-b803-bd02d24df175",
                                        "entry_id": "d7eb30f5-3e58-3e89-82ce-29614785e328",
                                        "glosses": [
                                            "A glass or serving of an alcoholic beverage."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a547d93c-2f19-46c5-87e3-21e6dbc73fba",
                                                "sense_id": "ecf2ed66-258c-37cb-b803-bd02d24df175",
                                                "text": "1950, Nevil Shute, A Town Like Alice [The Legacy], New York: William Morrow, Chapter 5, p. 138,\nJoe […] told them how he had been nailed up to be beaten, and they shouted another grog for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1f43e38-14df-369b-8c9e-4a208d80346b",
                                        "entry_id": "d7eb30f5-3e58-3e89-82ce-29614785e328",
                                        "glosses": [
                                            "A type of pre-fired clay that has been ground and screened to a specific particle size."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
