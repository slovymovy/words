                ],
                "senses": [
                    {
                        "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                        "entry_id": "513e0915-846a-3d86-b08d-0178fe1a3d6d",
                        "glosses": [
                            "Bild beim Durchblicken durch eine Kamera (durch den Sucher)"
                        ],
                        "tags": [
                            "Photographie",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "21a70b70-08b1-475d-854f-41b13f1c3eec",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "[…] „Das Sucherbild der D3500 ist heller und wirkt zumindest etwas größer.“"
                            },
                            {
                                "example_id": "043cabf1-aba3-45dd-90c2-3a322ad6b87c",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Der spezielle VR-Modus Sport sorgt für ein ruhigeres Sucherbild, wenn man die Kamera bei bewegten Motiven mitzieht.“"
                            },
                            {
                                "example_id": "07c128da-dbdf-47ce-b231-071a56726a72",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Der integrierte Bildstabilisator verhindert Verwacklungen und sorgt für ein ruhiges Sucherbild.“"
                            },
                            {
                                "example_id": "58a3bd8c-f6f6-401f-ae7d-4c93c5eee1fc",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Die Belichtungsmessung im Sucherbild wird durch eine zusätzliche LED erleichtert.“"
                            },
                            {
                                "example_id": "cc14683b-2137-49db-b252-5c48112d014c",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Bei einer Vergrößerung von 0,9-fach und einem Augenabstand von 25 mm ist das Sucherbild auch für Brillenträger gut zu überblicken.“"
                            },
                            {
                                "example_id": "bf162ccb-9c83-4b13-8237-8e26783a040a",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Für Videoaufnahmen mit 60 Bildern pro Sekunde oder ein elektronisches Sucherbild mit gleicher Bildfrequenz hat der Prozessor 1/60 s Zeit, die Pixel zu verarbeiten.“"
                            },
                            {
                                "example_id": "6e612c0e-e8fe-4a06-aaa1-98dc33567eb4",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Nicht zuletzt hatte mit dem vergrößerten Sensor auch das Sucherbild wieder die von Kleinbildkameras gewohnte Größe und Helligkeit.“"
                            },
                            {
                                "example_id": "941b3e50-098f-4a14-b4ff-be99697b4d61",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Die Taschenlampe, die für ein helleres Sucherbild eingesetzt wurde, sollte - wenn sie zusätzlich zur Belichtung verwendet werden soll - weiter vom Motiv entfernt werden. Andernfalls kommt es sehr leicht zu überstrahlten Bildpartien.“"
                            },
                            {
                                "example_id": "5e619563-1600-4dc7-943e-80b34c1c5188",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Diese Art des Suchers revolutionierte die Fotografie. Konnte das Sucherbild bisher nur seitenverkehrt und auf dem Kopf stehend in einem Lichtschacht betrachtet werden, brauchten die Fotografen nun nicht mehr umzudenken, sondern sahen plötzlich ein „Real Life Sucherbild“.“"
                            },
                            {
                                "example_id": "8b813a5a-9bf6-49e0-aff8-68f0a3319351",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "[Klapphandy:] „Klappt man das Gerät auf, wird das große Display zum Sucherbild, die Kamera wird von der Selfie- zur Hauptkamera.“"
                            },
                            {
                                "example_id": "9b6e0d8e-a907-4e89-8eb8-558ba19898f5",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Wenn das Smartphone bei den Kameraaufnahmen im Hochformat gehalten wird, werden die geschossenen Bilder direkt neben dem Sucherbild angezeigt. Damit sollen Nutzer schneller sehen, ob ein Schnappschuss etwas geworden ist.“"
                            },
                            {
                                "example_id": "f844e3ce-193d-4905-893d-6ea9f322b24c",
                                "sense_id": "905bc1e4-5b9e-3200-a822-db97fa32eb7c",
                                "text": "„Weißabgleich, ISO-Wert, Belichtungskorrektur und Messmethode sowie Blende und Verschlusszeit kann der Anwender verstellen – und zwar ohne das Motiv aus den Augen zu verlieren. Die Bedienelemente zum Einstellen der Parameter werden über das Sucherbild gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
