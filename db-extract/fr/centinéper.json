                        "glosses": [
                            "Unité de mesure de grandeurs logarithmiques en usage avec le Système international mais n’en faisant pas partie, valant 10⁻² néper, et dont le symbole est cNp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d3fb92-10d9-4a78-b492-912889040cd7",
                                "sense_id": "92de0ded-2113-3eea-8266-6a87c2c51857",
                                "text": "Le centinéper exprime les rapports entre grandeurs de même espèce : 100 centinépers signifient un rapport dont le logarithme naturel est l’unité (10² cNp → e:1 ≈ 2,718:1) ; un centinéper signifie un rapport dont le logarithme naturel vaut 10⁻² (1 cNp → e^(0,01):1 ≈ 1,010:1)."
                            }
                        ]
                    }
