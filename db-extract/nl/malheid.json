                                                "example_id": "bfc2ec8c-60e3-4b45-912b-3670d7d92c8c",
                                                "sense_id": "91b16eb8-09a7-3caa-b764-baf1f3a0f6ef",
                                                "text": "The first time Tuvy confided his dream to his mates […] they’d howled with cruel laughter at the outrageousness of it, the silliness of it, the impossibility of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6649e53-5149-3f06-8af1-71a56e81832e",
