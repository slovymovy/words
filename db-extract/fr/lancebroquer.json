                "senses": [
                    {
                        "sense_id": "129f0aaf-e85d-39e6-983c-89fa54ceba9a",
                        "entry_id": "f7c20671-4478-375b-b5ad-b789261798e7",
                        "glosses": [
                            "Pisser."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "26e8065e-b62d-49c2-a2af-ad5a8ad69b2e",
                                "sense_id": "129f0aaf-e85d-39e6-983c-89fa54ceba9a",
                                "text": "Quand il finissait de lancebroquer t’aurais cru qu’il secouait la cendre d’un mégot."
                            },
                            {
                                "example_id": "e216e65f-a8c0-47fb-bb80-41c59b21217a",
                                "sense_id": "129f0aaf-e85d-39e6-983c-89fa54ceba9a",
                                "text": "Pour le reste, vous avez tout le week-end pour réfléchir : les banques sont d’ores et déjà fermées jusqu’à lundi, même et surtout en Suisse. Sur ce, je vais lancebroquer…"
                            }
                        ]
                    }
