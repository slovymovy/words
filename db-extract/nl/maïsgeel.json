                        ],
                        "examples": [
                            {
                                "example_id": "fb8ecf2b-5ca4-4b54-8f4c-5b828d8e36d2",
                                "sense_id": "3413b556-1ad3-3aee-b121-cd8df92557f4",
                                "text": "De zijkant was een egaal maïsgeel vlak."
                            },
                            {
                                "example_id": "7e1a04e8-6094-4eeb-9a77-de7d47be4fcb",
                                "sense_id": "3413b556-1ad3-3aee-b121-cd8df92557f4",
                                "text": "Hij rijdt in een maïsgele auto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaf74507-901f-4da4-a5dd-503c1182da13",
