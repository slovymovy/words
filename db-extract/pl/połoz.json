                    {
                        "translation_id": "3a7e995b-ef83-41ee-97f5-6fd5fc31833e",
                        "source_entry_id": "bc39a270-216b-3518-9709-4fa60d845415",
                        "source_sense_id": "366e3a4a-0e91-3427-a231-60064a4022a6",
                        "target_lang_word": "Natter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Natter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f92aa04-6bfe-398f-8820-c8aa9205334b",
                                        "entry_id": "d892cf5b-986c-3bd4-aac2-1a053deef790",
                                        "glosses": [
                                            "Schlange aus der Familie der Colubridae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6397355-cb3e-4bdf-a41c-79eeb2ad539c",
                                                "sense_id": "7f92aa04-6bfe-398f-8820-c8aa9205334b",
                                                "text": "Nattern sind meist ungiftige Schlangen."
                                            },
                                            {
                                                "example_id": "ed4d3f47-fea3-457b-a292-321d7dcab11b",
                                                "sense_id": "7f92aa04-6bfe-398f-8820-c8aa9205334b",
                                                "text": "„Dann hatte die Natter plötzlich seinen Kopf in dem weitaufgerissenen Rachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                        "entry_id": "d892cf5b-986c-3bd4-aac2-1a053deef790",
                                        "glosses": [
                                            "hinterhältige Person"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc0bdf8-91ea-4581-b370-78bcae33a283",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "Meine Banknachbarin ist eine richtige Natter. Sie ist immer freundlich zu mir, um dann in meiner Abwesenheit über mich zu lästern."
                                            },
                                            {
                                                "example_id": "091a3311-fce7-446d-9df9-c82044b0838e",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„Entweder war Loretta dumm wie Brot oder eine hinterhältige Natter.“"
                                            },
                                            {
                                                "example_id": "23120bc1-3b0f-4293-94b5-6fcc5f2c8798",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„»Halt den Mund, du miese Natter«, sagte Josua.“"
                                            },
                                            {
                                                "example_id": "11538219-1824-4ffc-9425-a91872e86bb4",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„Die miese Natter hatte sich auf den Boden gelegt und stellte sich tot, dabei war sie nicht mal verwundet, ihre Gestalt leuchtete hell wie eh und je!“"
                                            },
                                            {
                                                "example_id": "1f9ae1b5-552d-4dab-9784-011876d46d82",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„Oh, was war er doch für eine hinterlistige, grausame Natter!“"
                                            },
                                            {
                                                "example_id": "4bd857e2-acab-4e70-97d2-3059c24502ea",
                                                "sense_id": "09ef1a11-d8cf-3628-a7cb-c4050ea4940c",
                                                "text": "„»Schweig, du Natter! Unsere Zelte wolltet ihr überfallen, hinterlistig, ohne dass das Kriegsbeil ausgegraben war! Ist das die Art von Kriegern?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
