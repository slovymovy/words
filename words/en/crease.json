{
    "word_family": [
        "creasy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5abf42d9-db06-3ba6-8a31-b1b50de8ba4c",
                    "sense_definition": "A line or mark made by folding or doubling a material.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His trousers had a sharp <w>crease</w> down the front.",
                            "target_lang_translations": {
                                "cs": "Jeho kalhoty měly vpředu ostrý <w>puk</w>.",
                                "ru": "Спереди на его брюках была наглажена острая <w>стрелка</w>.",
                                "zh": "他的裤子前面有一道笔挺的<w>裤线</w>。"
                            }
                        },
                        {
                            "text": "The paper had many <w>creases</w> after being kept in his pocket.",
                            "target_lang_translations": {
                                "cs": "Papír byl po nošení v kapse samý <w>záhyb</w>.",
                                "ru": "Бумага покрылась множеством <w>складок</w> после того, как полежала у него в кармане.",
                                "zh": "那张纸放在他口袋里后留下了很多<w>折痕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rumple",
                        "fold",
                        "wrinkle"
                    ],
                    "common_phrases": [
                        "sharp crease"
                    ],
                    "target_lang_definitions": {
                        "cs": "Čára nebo značka vzniklá přeložením nebo ohnutím materiálu.",
                        "ru": "Линия или след, образовавшийся в результате сгибания или складывания материала.",
                        "zh": "（通过折叠或压折在布料、纸张等上形成的）褶痕，折痕。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "puk",
                                "target_lang_sense_clarification": "zejména na kalhotách"
                            },
                            {
                                "target_lang_word": "záhyb",
                                "target_lang_sense_clarification": "obecný výraz pro ohyb materiálu"
                            },
                            {
                                "target_lang_word": "rýha",
                                "target_lang_sense_clarification": "výraznější stopa po ohnutí"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "складка",
                                "target_lang_sense_clarification": "общее обозначение сгиба на ткани или бумаге"
                            },
                            {
                                "target_lang_word": "стрелка",
                                "target_lang_sense_clarification": "заутюженная линия на брюках"
                            },
                            {
                                "target_lang_word": "загиб",
                                "target_lang_sense_clarification": "след от перегиба бумаги или материала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "褶痕",
                                "target_lang_sense_clarification": "衣物或纸张上的折痕、压痕"
                            },
                            {
                                "target_lang_word": "折痕",
                                "target_lang_sense_clarification": "折叠后留下的痕迹"
                            },
                            {
                                "target_lang_word": "裤线",
                                "target_lang_sense_clarification": "裤子前面熨烫出的中缝线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54576896-665b-323f-a233-10ac3ebad855",
                    "sense_definition": "The marked area around a goal in sports like hockey or lacrosse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player was penalized for standing inside the <w>crease</w>.",
                            "target_lang_translations": {
                                "cs": "Hráč byl potrestán za to, že stál v <w>brankovišti</w>.",
                                "ru": "Игрока оштрафовали за нахождение во <w>вратарской площадке</w>.",
                                "zh": "该球员因停留在<w>球门区</w>内而受到处罚。"
                            }
                        },
                        {
                            "text": "The goalie protected the <w>crease</w> from the opposing team.",
                            "target_lang_translations": {
                                "cs": "Brankář chránil <w>brankoviště</w> před soupeřovým týmem.",
                                "ru": "Вратарь защищал <w>площадь ворот</w> от команды соперника.",
                                "zh": "守门员全力守卫着<w>球门区</w>，抵御对方球队的进攻。"
                            }
