                        "examples": [
                            {
                                "example_id": "1c0b6579-4470-486c-893a-6f8fb096500d",
                                "sense_id": "e7bfd6d4-a294-3cf0-bfe2-62acbea61550",
                                "text": "Mijn mulo-diploma (A en B) heb ik destijds gehaald met bijna uitsluitend achten op mijn eindlijst. Nog steeds ben ik blij met alle vakken die ik destijds geleerd heb. Maar hoe is het, met de huidige pretpakketten, mogelijk dat je al kunt slagen met een 4.1 voor Frans? Zelfs de ‘zesjescultuur’ ligt blijkbaar al ver achter ons."
                            },
                            {
                                "example_id": "74441c1e-668e-41ce-a6d5-f7be754d778a",
                                "sense_id": "e7bfd6d4-a294-3cf0-bfe2-62acbea61550",
                                "text": "De scholiere, die anoniem wil blijven, zakte op het nippertje. Voor haar vwo-examen Frans behaalde ze 0.05 punt te weinig. Ze eindigde daardoor met een vijf te veel op haar eindlijst en zakte."
                            }
                        ]
