                    {
                        "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                        "entry_id": "2b797864-6109-3f3f-a4e8-9a34e0e62cd0",
                        "glosses": [
                            "The conduct of a lawsuit."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aa683af4-8f03-4b9e-81d6-95caf64cfa03",
                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                "text": "There is ongoing litigation in this matter."
                            },
                            {
                                "example_id": "27a0b19a-c247-45b6-a160-55c88ce1dfa0",
                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                "text": "This law firm is known for its litigation practice."
                            },
                            {
                                "example_id": "eaee35b6-ac3f-4017-862f-16324f5272b9",
                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                "text": "That attorney has been chastised for his litigation behavior."
                            },
                            {
                                "example_id": "8f654274-bd96-4f3e-ac5a-859b7dcb1444",
                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                "text": "“Google admitted that — for litigations spanning the past five years — it has never preserved all chats for relevant individuals by turning chat history on,” the DOJ filing said."
                            },
                            {
                                "example_id": "d96401f4-85f0-413b-9ede-4a7963c9472a",
                                "sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                                "text": "The willingness to bring more marginal legal cases reflects how the amount of money being put toward election litigation has increased significantly, said Derek Muller, an election law professor at the University of Notre Dame who noted that the trend also applies to Democrats and outside groups across the ideological spectrum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13220e11-8ada-4305-a965-1e2ab93d9155",
                        "source_entry_id": "2b797864-6109-3f3f-a4e8-9a34e0e62cd0",
                        "source_sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                        "source_sense_description": "conduct of a lawsuit",
                        "target_lang_word": "procesvoering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procesvoering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0d06eb5a-08b3-389e-81ea-f3ca5fcd473e",
                                        "entry_id": "a90a269e-c84f-339d-86a0-17f4d4624a67",
                                        "glosses": [
                                            "de manier waarop men een fabricageproces uitvoert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74c6b4f-09c9-43b6-a58f-b8a3a4f3316a",
                                                "sense_id": "0d06eb5a-08b3-389e-81ea-f3ca5fcd473e",
                                                "text": "Aanvankelijk richtten bedrijven hun aandacht met name op verbeteringen in de eigen procesvoering via afval- en emissiepreventie."
                                            },
                                            {
                                                "example_id": "f856872b-1d19-4794-97c9-388548383a63",
                                                "sense_id": "0d06eb5a-08b3-389e-81ea-f3ca5fcd473e",
                                                "text": "Shell erkent dat de ontploffing en het lek voorkomen hadden moeten worden. \"De incidenten hadden we moeten voorkomen, dat is ons helaas niet gelukt. Daar hebben we lering uitgetrokken\", zegt een woordvoerder op NPO Radio 1. \"We hebben gezien dat een aantal dingen in onze procesvoering onvoldoende waren en die hebben we meteen aangescherpt.\" Shell weet nog niet of het in hoger beroep gaat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde7db8d-000f-3988-8140-9f45fefb036b",
                                        "entry_id": "a90a269e-c84f-339d-86a0-17f4d4624a67",
                                        "glosses": [
                                            "het voeren van een rechtszaak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51f741d-9d62-4823-a811-53a7e9afdc85",
                                                "sense_id": "fde7db8d-000f-3988-8140-9f45fefb036b",
                                                "text": "De piloot is voor zijn procesvoering afhankelijk van giften en liefdadigheidsinstellingen. Hij kan voor toekomstige kosten van zijn advocaat nog steeds een vergoeding aanvragen. Knoops heeft laten weten die vergoeding aan te vragen. Ook gaat hij in hoger beroep tegen de uitspraak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80ee8f43-30d0-4cc7-a579-dedfed2445c7",
                        "source_entry_id": "2b797864-6109-3f3f-a4e8-9a34e0e62cd0",
                        "source_sense_id": "a1faa548-cac8-31f6-8784-6ef5d699994a",
                        "source_sense_description": "conduct of a lawsuit",
                        "target_lang_word": "proces",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proces",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "47e251d6-a44a-3b93-9c96-4f71f8554426",
                                        "entry_id": "b1fefe93-ce01-3621-9a06-566a6b6c3301",
                                        "glosses": [
                                            "een geschil dat twee of meer partijen hebben over hun rechten en dat zij aan de uitspraak van een rechter onderwerpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6f2688-4f7b-40ad-b970-66565b9f439f",
                                                "sense_id": "47e251d6-a44a-3b93-9c96-4f71f8554426",
                                                "text": "Een proces heropenen."
                                            },
                                            {
                                                "example_id": "d0fdab52-9bcc-47a5-83a7-3eff56ba3737",
                                                "sense_id": "47e251d6-a44a-3b93-9c96-4f71f8554426",
                                                "text": "De waarheidscommissie die nu was begonnen zou niet alleen onschuldige slachtoffers van de politieke processen van een kwade tijd vrijspreken. Ze zou ook schurken brandmerken en niet alleen Tsjecho-Slowaakse schurken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89af20a7-5d54-3c98-9876-a62489bf9777",
                                        "entry_id": "b1fefe93-ce01-3621-9a06-566a6b6c3301",
                                        "glosses": [
                                            "de stroom van gelijksoortige gebeurtenissen of handelingen die van de ene toestand naar de andere leidt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf5090e-55d9-4484-af1b-0458737e2c87",
                                                "sense_id": "89af20a7-5d54-3c98-9876-a62489bf9777",
                                                "text": "Het verloop van het proces vertoont telkens weer grote gelijkenis."
                                            },
                                            {
                                                "example_id": "e0f5114a-cc4c-4307-b7e2-bcc4c4d428ca",
                                                "sense_id": "89af20a7-5d54-3c98-9876-a62489bf9777",
                                                "text": "Hoewel ik als vader niet veel had kunnen doen, aangezien ze dit proces vooral met haar vriendinnen verwerkte, voelde ik me toch schuldig dat ik er niet voor haar was op dit indrukwekkende moment in haar jonge leven."
                                            },
                                            {
                                                "example_id": "c5ade37d-0c20-47aa-877e-88917b776b4f",
                                                "sense_id": "89af20a7-5d54-3c98-9876-a62489bf9777",
                                                "text": "Koraalriffen zijn van levensbelang voor het leven in de oceanen en daardoor ook voor de mensheid. 25 procent van het zeeleven leeft in en rond koraalriffen. Ze zijn van belang voor de visserij, toerisme en bescherming van kustlijnen tegen erosie en stormen. Het is nog onduidelijk of en wanneer het huidige proces van verbleking stopt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
