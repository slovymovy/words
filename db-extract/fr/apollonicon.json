                        "entry_id": "188c4654-dd6d-30c0-a77f-f785191478f3",
                        "glosses": [
                            "Orgue à vapeur sur chariot utilisé en 1849 par la cavalcade du Spalding & Roger’s North American Circus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3200c9ce-0436-4f70-bfab-da6e925cf114",
                                "sense_id": "341d7554-457d-310f-9a96-3981bf25a088",
                                "text": "En 1857, le Howes & Cushing Circus vint à Londres avec un apollonicon tiré par 40 chevaux."
                            }
                        ]
                    }
