                    {
                        "sense_id": "79a9c8fd-d6c4-39ea-8467-c58b83cadc16",
                        "entry_id": "509306c1-222b-375d-ad99-f1f1c6eb7107",
                        "glosses": [
                            "A ration."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8aa3856a-01de-3924-921a-900b0c7652cd",
                        "entry_id": "509306c1-222b-375d-ad99-f1f1c6eb7107",
                        "glosses": [
                            "Controlled distribution of scarce resources such as food or fuel; used typically in wartime."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3daf4dc6-b0b4-44e9-a4c6-e2e7dee68629",
                                "sense_id": "8aa3856a-01de-3924-921a-900b0c7652cd",
                                "text": "The drastic rationing of paper enforced by the paper control, has made it necessary for us to adapt ourselves to the altered conditions."
                            },
                            {
                                "example_id": "bca30640-f6fc-4c06-9f4c-a3bb662282de",
                                "sense_id": "8aa3856a-01de-3924-921a-900b0c7652cd",
                                "text": "After petrol rationing ended in 1952, the BTC was aware that more swingeing cuts had to be made, and a sinister message was conveyed by the loss of the meandering 38-mile route from Blisworth to Stratford-upon-Avon in April 1952, and the 25-mile Abergavenny-Merthyr Heads of the Valleys line in January 1958."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58a8046d-b298-4dee-8975-fc7f81e81c90",
                        "source_entry_id": "509306c1-222b-375d-ad99-f1f1c6eb7107",
                        "source_sense_description": "controlled distribution of scarce resources",
                        "target_lang_word": "rantsoenering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rantsoenering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca9f904-3e15-3eb0-bca4-278e400e819a",
                                        "entry_id": "e1b058f1-6c59-3647-b706-ebd16c53a4ff",
                                        "glosses": [
                                            "het beperken van de hoeveelheid goederen die men afgeeft om zo een schaarste eerlijk te verdelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f401540d-0bca-4bbe-bb5c-46ee62a186bd",
                                                "sense_id": "8ca9f904-3e15-3eb0-bca4-278e400e819a",
                                                "text": "Omdat er weer water uit het meer mag worden geleverd, heeft het Romeinse waterbedrijf laten weten voorlopig toch geen rantsoenering in te voeren. De burgemeester van Rome had al gezegd zoiets onacceptabel te vinden. Het zou schadelijk zijn voor de economie en het aanzien van de stad."
                                            },
                                            {
                                                "example_id": "51e22f98-f2e8-4268-ab0a-77890eded268",
                                                "sense_id": "8ca9f904-3e15-3eb0-bca4-278e400e819a",
                                                "text": "De Graafschapsbode van 8 november schrijft onder de kop \"Melkmisére\" dat er een nijpend gebrek is aan melk. Het rantsoen bedraagt een tiende liter en die rantsoenering zal door het kabinet streng worden doorgevoerd, schrijft de krant. Gemeenten die toch meer melk aan de bevolking uitdelen (via extra bonkaarten) worden gewaarschuwd. \"Die krijgen geen bijslag (rijksbijdrage) op de melk en lopen het risico dat de gebruikers nog meer moeten betalen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4314209-3fc9-4136-bd4c-45c6806ab5d0",
                        "source_entry_id": "509306c1-222b-375d-ad99-f1f1c6eb7107",
                        "source_sense_description": "controlled distribution of scarce resources",
                        "target_lang_word": "rationnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rationnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab3312a1-3489-389d-a245-eccdfbdc85a3",
                                        "entry_id": "8369715b-a01b-3918-aa76-985ffb1acb9a",
                                        "glosses": [
                                            "Action de rationner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "665d72b7-ecef-4ba3-abf4-86528ef4097a",
                                                "sense_id": "ab3312a1-3489-389d-a245-eccdfbdc85a3",
                                                "text": "Le rationnement forcé des habitants pendant un siège."
                                            },
                                            {
                                                "example_id": "0a6939db-f539-4245-b599-552baf34b6e5",
                                                "sense_id": "ab3312a1-3489-389d-a245-eccdfbdc85a3",
                                                "text": "Le rationnement consiste à établir des liaisons quantitatives entre les besoins de l’animal calculés à partir des recommandations et les valeurs nutritives des aliments données dans les tables. Le but est d’obtenir une ration équilibrée qui satisfait les besoins nutritionnels de la vache laitière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52cf626f-90be-44a8-9d44-d2b5b9b082ce",
                        "source_entry_id": "509306c1-222b-375d-ad99-f1f1c6eb7107",
                        "source_sense_description": "controlled distribution of scarce resources",
                        "target_lang_word": "Rationierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rationierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9fd3c7-c552-3828-a987-7bcd35855289",
                                        "entry_id": "1e8c2bcc-a610-3d44-9aab-25b98ec8ee8f",
                                        "glosses": [
                                            "Maßnahme, die Verfügung über eine bestimmte Sache einzuschränken und Ergebnis dieser Maßnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d863569-b2ff-4a28-a523-aca105878984",
                                                "sense_id": "bb9fd3c7-c552-3828-a987-7bcd35855289",
                                                "text": "„Bei der Rationierung von Mehl und Brot blieb es nicht - das folgte aus der Logik des einmal reglementierten Marktes.“"
                                            },
                                            {
                                                "example_id": "3059d54d-ed7f-49c1-9a55-e123bd5aec24",
                                                "sense_id": "bb9fd3c7-c552-3828-a987-7bcd35855289",
                                                "text": "„Trotz strenger Rationierung mussten Inselbewohner und Besatzer mehrere Monate lang hungern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
