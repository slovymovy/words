                ],
                "senses": [
                    {
                        "sense_id": "2977ec1e-7b6d-34f0-8f92-0561c2af3b2d",
                        "entry_id": "9a450ebf-84fb-38ba-8c5d-2cab3b5f7dc4",
                        "glosses": [
                            "Propriété d’un circuit magnétique analogue à la résistance d’un circuit électrique. La réluctance est l’opposition présentée par le circuit magnétique à l’établissement d’un flux magnétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55c5d2c-454e-47f8-adc8-b136aff57dec",
                                "sense_id": "2977ec1e-7b6d-34f0-8f92-0561c2af3b2d",
                                "text": "La réluctance se mesure en ampère-tours par weber."
                            },
                            {
                                "example_id": "1fc518d6-751d-4571-be79-2bffab94c400",
                                "sense_id": "2977ec1e-7b6d-34f0-8f92-0561c2af3b2d",
                                "text": "Le moteur à réluctance variable à commutation électronique utilise la même structure de base que le moteur pas-à-pas à réluctance variable, mais il est utilisé différemment : l’objectif principal est pour le premier de réaliser une conversion d’énergie et pour le second d’assurer un positionnement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6d4ad06-bad4-49f3-b935-17cac375172e",
                        "source_entry_id": "9a450ebf-84fb-38ba-8c5d-2cab3b5f7dc4",
