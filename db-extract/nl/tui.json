                                        "sense_id": "8eb270b6-0d7f-3d34-858c-edf5a88bf890",
                                        "entry_id": "7997f1db-f87f-3698-9056-c12ad9214c31",
                                        "glosses": [
                                            "Armor for the arm; vambrace."
