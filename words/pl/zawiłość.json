                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zawiłość_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prawnik cierpliwie wyjaśniał klientowi wszystkie <w>zawiłości</w> nowej umowy handlowej.",
                            "target_lang_translations": {
                                "ru": "Юрист терпеливо разъяснял клиенту все <w>тонкости</w> нового торгового соглашения."
                            }
                        },
                        {
                            "text": "Trudno było pojąć wszelkie <w>zawiłości</w> politycznych sojuszy w tym regionie.",
                            "target_lang_translations": {
                                "ru": "Было трудно уразуметь все <w>хитросплетения</w> политических союзов в этом регионе."
                            }
                        }
