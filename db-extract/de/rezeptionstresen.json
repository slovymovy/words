                        "examples": [
                            {
                                "example_id": "97161836-68c7-4bf3-9f78-de72bc32dd8d",
                                "sense_id": "12b19f6b-370c-3041-af83-276d8d5ef053",
                                "text": "„Der Rezeptionstresen ist auf rustikal getürkt; alle Angestellten tragen Cowboyhüte und fünfzackige Sterne, in die ihre Namen eingraviert sind.“"
                            },
                            {
                                "example_id": "e8573ae1-e6be-45c5-a9a3-082355a9c567",
                                "sense_id": "12b19f6b-370c-3041-af83-276d8d5ef053",
                                "text": "„Er hatte allerdings keinen heimlichen Blick auf die Gästeliste am Rezeptionstresen geworfen, um ihren Namen zu erfahren.“"
                            }
                        ],
