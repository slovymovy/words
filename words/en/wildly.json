    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4d402629-f270-349a-960a-f1606320bc0c",
                    "sense_definition": "In a wild, uncontrolled, or disorderly manner.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He swung <w>wildly</w> at the ball but missed it completely.",
                            "target_lang_translations": {
                                "ru": "Он <w>дико</w> размахнулся, пытаясь ударить по мячу, но совершенно промахнулся.",
                                "tr": "Topa <w>çılgınca</w> savurdu ama tamamen ıskaladı."
                            }
                        },
                        {
                            "text": "The fans cheered <w>wildly</w> as their team scored the winning goal.",
                            "target_lang_translations": {
                                "ru": "Болельщики <w>неистово</w> ликовали, когда их команда забила победный гол.",
                                "tr": "Takımları galibiyet golünü atınca taraftarlar <w>çılgınca</w> tezahürat yaptı."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncontrollably",
                        "frantically",
                        "chaotically",
                        "madly"
                    ],
                    "antonyms": [
                        "calmly"
                    ],
                    "common_phrases": [
                        "swing wildly",
                        "cheer wildly",
                        "gesture wildly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Диким, неконтролируемым или беспорядочным образом",
                        "tr": "Vahşi, kontrolsüz veya düzensiz bir şekilde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дико",
                                "target_lang_sense_clarification": "об общем характере действий"
                            },
                            {
                                "target_lang_word": "неистово",
                                "target_lang_sense_clarification": "о сильных эмоциях или резких движениях"
                            },
                            {
                                "target_lang_word": "бурно",
                                "target_lang_sense_clarification": "о проявлении чувств, реакции"
