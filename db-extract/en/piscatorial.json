                "senses": [
                    {
                        "sense_id": "2edd6746-8f95-356d-a5b7-e0aa7b6144cb",
                        "entry_id": "103f6fed-8585-3d47-aad4-c83f9511a424",
                        "glosses": [
                            "Of or pertaining to fishermen or fishing."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4599d0d2-b084-4526-b71a-d7e60e58f03a",
                                "sense_id": "2edd6746-8f95-356d-a5b7-e0aa7b6144cb",
                                "text": "Jane lined up the girls and called out, \"Dive!\" The girls dived - mermaids for a piscatorial pageant."
                            },
                            {
                                "example_id": "dbb89b0f-c1dd-4a55-89d3-f962f56e0779",
                                "sense_id": "2edd6746-8f95-356d-a5b7-e0aa7b6144cb",
                                "text": "There should be no plea put in by him in his absences, that he had only gone to catch a few fish, when his intentions had been other than piscatorial."
                            },
                            {
                                "example_id": "8925d4a0-24f8-4e52-bb98-db56e4142c7e",
                                "sense_id": "2edd6746-8f95-356d-a5b7-e0aa7b6144cb",
                                "text": "That a lucy or luce is the mature pike, every piscatorial schoolboy knows."
                            },
                            {
                                "example_id": "92b83ec2-6ae8-4f88-9599-25f3a2f624cc",
                                "sense_id": "2edd6746-8f95-356d-a5b7-e0aa7b6144cb",
                                "text": "The theme is unashamedly piscatorial – there are models of trout, pictures of trout, books about trout, a cabinet full of fly-tying gear. The veranda, cluttered with waders, boots, rods and tackle, is where the fishing day begins."
                            }
                        ]
                    },
                    {
                        "sense_id": "fffce082-9896-32e1-b688-d03c6b875062",
                        "entry_id": "103f6fed-8585-3d47-aad4-c83f9511a424",
                        "glosses": [
                            "Of or pertaining to fish; piscine."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e11c6654-6fcc-4aa2-bf79-63b72e7f8843",
                                "sense_id": "fffce082-9896-32e1-b688-d03c6b875062",
                                "text": "The tropical boxfish may not look the sleekest or sexiest of piscatorial creatures, but the Mercedes team knew better."
                            },
                            {
                                "example_id": "a6aae61f-f57f-4a3f-83f3-4012d2b06465",
                                "sense_id": "fffce082-9896-32e1-b688-d03c6b875062",
                                "text": "There are dozens of photographs, but it is not the piscatorial pornography that makes this book so exciting so much as the stories Mr Buller has unearthed."
                            }
                        ]
                    }
