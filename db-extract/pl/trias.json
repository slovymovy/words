                                "target_senses": [
                                    {
                                        "sense_id": "37359a6e-dfd8-3711-b751-c0f330c477cb",
                                        "entry_id": "f4b2aaaa-ebfa-3887-a8f4-260f3129d82e",
                                        "glosses": [
                                            "Of or from the geologic strata above the Permian and below the Jurassic; of or belonging to the period 250 to 200 million years ago when these strata were laid down."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7428e899-698e-403e-b7a7-8eef7768d1d1",
                                                "sense_id": "37359a6e-dfd8-3711-b751-c0f330c477cb",
                                                "text": "“Well,” Ellie said. “We know animals have survived. Crocodiles are basically Triassic animals living in the present. Sharks are Triassic. So we know it has happened before.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Triassic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5635b14-56f2-36dd-9a71-9c79502bfb72",
                                        "entry_id": "378b5f3e-6ac2-312e-ae0a-c98e0fe0a783",
                                        "glosses": [
                                            "A geologic period within the Mesozoic era, comprising lower, middle and upper epochs from about 250 to 200 million years ago."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b462feaf-c1ff-409f-b58a-09e997f7623c",
                                                "sense_id": "b5635b14-56f2-36dd-9a71-9c79502bfb72",
                                                "text": "Fossils are particularly well described from the Carboniferous, Triassic, Jurassic and Cretaceous periods and have been found in the USA, England, Russia, Lebanon and Germany. Sites such as Lyme Regis in Dorset have particularly yielded number of Jurassic “squid” ink sacs and nodules (Doguzhaeva et al. 2004)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
