                                    },
                                    {
                                        "sense_id": "e56b7ca5-b071-3b0a-b9e2-0bc519af8622",
                                        "entry_id": "50699d60-3da1-3ee0-bd4e-c2cdf3dc4eef",
                                        "glosses": [
                                            "The degree to which things may be seen."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
