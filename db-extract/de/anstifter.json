                    {
                        "sense_id": "c8e75cfb-47ed-3bb7-9cce-75f3ffcbed35",
                        "entry_id": "b16700d2-eabf-369e-884f-448c1ca6134f",
                        "glosses": [
                            "Person, die jemand dazu veranlasst, etwas Falsches/Unrechtmäßiges zu tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de9ab1b-2891-4074-ae27-039a167db39c",
                                "sense_id": "c8e75cfb-47ed-3bb7-9cce-75f3ffcbed35",
                                "text": "„Einen oder zwei Tage später sagte mir Pater Giorgi, das Tagesgespräch in Rom sei die mißlungene Entführung der Tochter des Advokaten Dalacqua; man halte mich für den Anstifter der ganzen Sache, und das mißbillige er sehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
