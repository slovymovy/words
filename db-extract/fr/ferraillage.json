                                            {
                                                "example_id": "bc67a31a-2d89-410a-8d75-fe605db5810e",
                                                "sense_id": "3709ef13-0895-3e14-be69-ebd52c3f9cc3",
                                                "text": "Heeft het bedrijf van Erik Smit geconstateerd dat een brug dringend onderhoud nodig heeft, verdwijnt het rapport van Batec Betonrenovatie in een la. ,,Dat een wapening roest, is niet interessant. Totdat het mis gaat, natuurlijk. In het algemeen wordt onderhoud niet zo belangrijk gevonden."
                                            },
