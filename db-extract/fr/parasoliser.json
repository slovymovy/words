                "senses": [
                    {
                        "sense_id": "1b121dbb-cbcb-3a01-8be3-35de95f98fc7",
                        "entry_id": "6decfa06-505a-3f53-845c-752fdd0ca56f",
                        "glosses": [
                            "Doter de parasols."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9fbedc-1427-47b9-b283-5d2c858e67aa",
                                "sense_id": "1b121dbb-cbcb-3a01-8be3-35de95f98fc7",
                                "text": "Petit passage au hall pour prendre le dossard numéro 194 et en route vers le point de rendez-vous parasolisé du forum."
                            },
                            {
                                "example_id": "2275abcf-d2c4-46af-89ce-a229d0892659",
                                "sense_id": "1b121dbb-cbcb-3a01-8be3-35de95f98fc7",
                                "text": "Paris ont résolu de parasoliser Paris. Et de le palmiériser. Et de le boulodromiser. Et de le transatiser. Et de le littoraliser. Sur trois kilomètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "11eb1bbb-8b19-3e94-b37c-2bac6385b9a2",
                        "entry_id": "6decfa06-505a-3f53-845c-752fdd0ca56f",
                        "glosses": [
                            "S’abriter du soleil."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0dbb2da1-08ae-465c-846d-c88a0ecb6d54",
                                "sense_id": "11eb1bbb-8b19-3e94-b37c-2bac6385b9a2",
                                "text": "Ah ! comme on comprend cela lorsque, les pieds dans le sable, la tête dans le feu, on parcourt ces mornes espaces pelés, tondus, teigneux, brûlés, fuyant sous vous, en plein midi, avec le soleil en suspension sur votre vertex, et d’aplomb à ne pouvoir même se parasoliser de l’ombre d'un voisin ;"
                            }
                        ]
                    }
