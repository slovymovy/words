                                        "entry_id": "44c2c941-90af-3153-87da-faa08885f3df",
                                        "glosses": [
                                            "Participe présent de vigiler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
