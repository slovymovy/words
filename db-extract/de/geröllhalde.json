                "senses": [
                    {
                        "sense_id": "4aea49a1-2389-39ba-bd5e-63745b798081",
                        "entry_id": "08cba5fb-63a5-3eb4-b032-1f963d253729",
                        "glosses": [
                            "Aufhäufung von Gesteinsbrocken (zum Beispiel an der abfallenden Seite eines Berges)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de58ae6f-5eba-4bb7-866c-6326aeafb088",
                                "sense_id": "4aea49a1-2389-39ba-bd5e-63745b798081",
                                "text": "Während unserer Wanderung löste sich plötzlich eine Geröllhalde."
                            },
                            {
                                "example_id": "f1b430e7-4f95-4c87-968b-b9b855f617a1",
                                "sense_id": "4aea49a1-2389-39ba-bd5e-63745b798081",
                                "text": "„Vielleicht stehen sie der Adler wegen so unbeweglich da und täuschen eine Geröllhalde vor.“"
                            },
                            {
                                "example_id": "11abdba4-1c54-450c-b2bc-481aef36a3ba",
                                "sense_id": "4aea49a1-2389-39ba-bd5e-63745b798081",
                                "text": "„Wenn sich eine der Staubwolken verzog, ließ sich zuweilen in einem Ausschnitt das breite Flußbett erkennen, das unterhalb der Geröllhalde die Grenze der steinernen Landschaft bildete.“"
                            },
                            {
                                "example_id": "52fe2941-bbef-4a75-afdb-3e28ab276ee3",
                                "sense_id": "4aea49a1-2389-39ba-bd5e-63745b798081",
                                "text": "„Alle Augenblicke mußte ich Trümmerbergen ausweichen, manchmal über sie hinwegklettern wie über Geröllhalden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
