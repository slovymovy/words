                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e02f5a9-8678-4e98-b517-abc2578aa070",
                        "source_entry_id": "a8e499af-ea42-30e9-90bb-751273b6c71e",
                        "source_sense_description": "craft of making statues",
                        "target_lang_word": "скульпту́ра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "скульпту́ра",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "154fdc75-ba37-3763-a17f-1f3fb1ab6b9f",
                                        "entry_id": "710080d4-9e13-3c60-a072-f817849432db",
                                        "glosses": [
                                            "искусство изготовления объёмных или плоскостных выпуклых изображений (ста́туй, бюстов, барельефов и т. п.) путём лепки, резьбы или отливки из различных материалов (глины, воска, металлов, дерева, камня и т. п.)"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af2de53a-f9df-4c05-9978-10e902a56fd8",
                                                "sense_id": "154fdc75-ba37-3763-a17f-1f3fb1ab6b9f",
                                                "text": "Произведения скульптуры."
                                            },
                                            {
                                                "example_id": "254054ad-1c63-4917-a2f2-5b96797b98f9",
                                                "sense_id": "154fdc75-ba37-3763-a17f-1f3fb1ab6b9f",
                                                "text": "История скульптуры."
                                            },
                                            {
                                                "example_id": "c62a0e1c-3daa-45fe-99b8-991797a4fc91",
                                                "sense_id": "154fdc75-ba37-3763-a17f-1f3fb1ab6b9f",
                                                "text": "Статую эту, долженствовавшую представить молящегося ангела, он выписал из Москвы; но отрекомендованный ему комиссионер, сообразив, что в провинции знатоки скульптуры встречаются редко, вместо ангела прислал ему богиню Флору, много лет украшавшую один из заброшенных подмосковных садов екатерининского времени."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e5fe9c-f9fe-3ff8-8477-58b7e5072878",
                                        "entry_id": "710080d4-9e13-3c60-a072-f817849432db",
                                        "glosses": [
                                            "собир. совокупность произведений этого искусства"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759d6d48-6006-4572-980e-92b3cab5dbba",
                                                "sense_id": "b5e5fe9c-f9fe-3ff8-8477-58b7e5072878",
                                                "text": "Зал скульптуры в музее."
                                            },
                                            {
                                                "example_id": "4414a45d-c3e9-4546-8626-3ed6d92d8b9f",
                                                "sense_id": "b5e5fe9c-f9fe-3ff8-8477-58b7e5072878",
                                                "text": "Скульптура Антокольского."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3ed7df2-dfc1-3bfa-95c8-a22cc790399a",
                                        "entry_id": "710080d4-9e13-3c60-a072-f817849432db",
                                        "glosses": [
                                            "скульптурное произведение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4321671-94bd-4d9b-a091-9e46603f6b7e",
                                                "sense_id": "b3ed7df2-dfc1-3bfa-95c8-a22cc790399a",
                                                "text": "На выставке, кроме картин, имеется несколько скульптур."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
