                        "entry_id": "022b0711-94db-33ad-9b36-50dcd51bf3d1",
                        "glosses": [
                            "die Gesamtheit aller Teile eines Landfahrzeugs, die der Verbindung des Fahrgestells über die Räder zur Fahrbahn dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5698e8-d051-434d-96cc-1d7f503cc6e0",
                                "sense_id": "906d6c50-104f-3f16-be55-37f83d6bcd73",
                                "text": "„Und obendrein ein runderneuertes Fahrwerk mit drei unterschiedlichen Konfigurationen und mit der Option auf Allradantrieb und Hinterrad-Lenkung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11230b64-b78a-3062-8618-0348cbcdca68",
                        "entry_id": "022b0711-94db-33ad-9b36-50dcd51bf3d1",
                        "glosses": [
                            "die Gesamtheit der Räder des Flugzeugs mit Flugzeugreifen, Felgen und meist darin eingebauten Bremsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca1d178-d72b-4304-8fe5-9b78ccc892dd",
                                "sense_id": "11230b64-b78a-3062-8618-0348cbcdca68",
                                "text": "„Das Fahrwerk sei offenbar zu spät ausgefahren gewesen.“"
                            }
