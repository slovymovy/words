                                "sense_id": "139b4e93-9f72-32e0-89cd-b4f922aa122a",
                                "text": "Quhile he cryed barlafummil, I am slane."
                            },
                            {
                                "example_id": "4ea7706b-35da-47b4-b2fa-45f69c6e2412",
                                "sense_id": "139b4e93-9f72-32e0-89cd-b4f922aa122a",
                                "text": "To fight, lest ye, when canons rumble, / With shame for fear, cry barlafumble."
                            },
                            {
                                "example_id": "b6855df7-16ef-42e2-8045-af094724539a",
                                "sense_id": "139b4e93-9f72-32e0-89cd-b4f922aa122a",
                                "text": "Greittans, lookansque grivatè, Barlafumle clamat[…]"
                            }
                        ]
