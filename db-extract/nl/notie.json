                "senses": [
                    {
                        "sense_id": "08208ebf-f693-36e8-8bab-f93b82392d77",
                        "entry_id": "f4db5c1a-4c33-3e42-8224-cc0ae3ba2678",
                        "glosses": [
                            "benul, bewustzijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbb81159-a15f-4346-bace-26a821882822",
                                "sense_id": "08208ebf-f693-36e8-8bab-f93b82392d77",
                                "text": "Hij heeft er geen notie van welk leed dat hij zijn buren aandoet door midden in de nacht zo hard te snurken."
                            },
                            {
                                "example_id": "a6c00f3f-d127-4945-856d-d747d3f5078f",
                                "sense_id": "08208ebf-f693-36e8-8bab-f93b82392d77",
                                "text": "De dagen smolten in elkaar, zonder enige notie welke dag van de week het was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46fcd5d9-0870-4dd6-bd14-3c0e19e6115e",
                        "source_entry_id": "f4db5c1a-4c33-3e42-8224-cc0ae3ba2678",
                        "source_sense_id": "08208ebf-f693-36e8-8bab-f93b82392d77",
                        "source_sense_description": "benul, bewustzijn",
                        "target_lang_word": "Idee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed43edb5-2294-3abd-90e0-1267dadb7ae5",
                                        "entry_id": "5784d9b6-fc1d-3ce2-96cf-fe4165bc823e",
                                        "glosses": [
                                            "Urbild einer Erscheinung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f948550-0166-3e47-a3c6-4a202e07c0bc",
                                        "entry_id": "5784d9b6-fc1d-3ce2-96cf-fe4165bc823e",
                                        "glosses": [
                                            "meist plötzlich auftretender Gedanke, der Erfolg verspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e33c51-bbbe-4914-815d-6eeb4a9b7fa9",
                                                "sense_id": "3f948550-0166-3e47-a3c6-4a202e07c0bc",
                                                "text": "Ich hatte eine sehr gute Idee, die die Arbeit an unserem Projekt erleichterte."
                                            },
                                            {
                                                "example_id": "3cb184b5-ad12-4b58-9bce-0c878b12b3af",
                                                "sense_id": "3f948550-0166-3e47-a3c6-4a202e07c0bc",
                                                "text": "Mein Bruder hat die fixe Idee, einmal um die Welt zu segeln."
                                            },
                                            {
                                                "example_id": "baed53fa-ff5b-444a-ab0d-4bafc53a955e",
                                                "sense_id": "3f948550-0166-3e47-a3c6-4a202e07c0bc",
                                                "text": "Ideen verändern die Welt."
                                            },
                                            {
                                                "example_id": "73039768-0782-4caa-bc5a-67c52b04d13d",
                                                "sense_id": "3f948550-0166-3e47-a3c6-4a202e07c0bc",
                                                "text": "Gute Ideen hat man nicht zwei Mal."
                                            },
                                            {
                                                "example_id": "a9fb84cb-fede-4ac7-89af-ab7795c8a563",
                                                "sense_id": "3f948550-0166-3e47-a3c6-4a202e07c0bc",
                                                "text": "„Seine Idee hatte viele Gegner, vor allem unter den Kongressabgeordneten aus dem landwirtschaftlich geprägten Süden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d9e2d88f-0ab9-355b-bab4-082efb71b6f3",
                                        "entry_id": "5784d9b6-fc1d-3ce2-96cf-fe4165bc823e",
                                        "glosses": [
                                            "Leitbild"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b746d172-bb67-36e7-bd79-663cc0b3d71d",
                                        "entry_id": "5784d9b6-fc1d-3ce2-96cf-fe4165bc823e",
                                        "glosses": [
                                            "sehr kleine Menge von etwas; kaum messbar aber real"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "081eaa63-02f0-4277-a3ce-0c9112973850",
                                                "sense_id": "b746d172-bb67-36e7-bd79-663cc0b3d71d",
                                                "text": "Da wurde eine Idee zu viel Muskat verwendet!"
                                            },
                                            {
                                                "example_id": "b93de497-8730-4f47-a4ba-2d18b8e69e96",
                                                "sense_id": "b746d172-bb67-36e7-bd79-663cc0b3d71d",
                                                "text": "Du warst eine Idee zu schnell mit dem Auto!"
                                            },
                                            {
                                                "example_id": "62bdd7bf-5ba5-4402-914b-4f7a8f29287d",
                                                "sense_id": "b746d172-bb67-36e7-bd79-663cc0b3d71d",
                                                "text": "Bei Deiner Kaufentscheidung warst Du eine Idee zu spät!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddd0e803-d7d9-41ee-9174-deb093c51a26",
                        "source_entry_id": "f4db5c1a-4c33-3e42-8224-cc0ae3ba2678",
                        "source_sense_id": "08208ebf-f693-36e8-8bab-f93b82392d77",
                        "source_sense_description": "benul, bewustzijn",
                        "target_lang_word": "Ahnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ahnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d258335-407a-3fb2-9c1d-3b00ab1014db",
                                        "entry_id": "f9ef810e-a7a5-357a-9648-0b676a309f21",
                                        "glosses": [
                                            "unbestimmtes, undeutliches Vorgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba5c98e-169e-4f35-9903-ff8a6b7391c3",
                                                "sense_id": "4d258335-407a-3fb2-9c1d-3b00ab1014db",
                                                "text": "Ich habe so eine Ahnung, wer Weltmeister wird."
                                            },
                                            {
                                                "example_id": "f170118b-4875-4b33-8a32-dddee69f7de8",
                                                "sense_id": "4d258335-407a-3fb2-9c1d-3b00ab1014db",
                                                "text": "„Der Forschungserfolg gibt eine Ahnung davon, was später einmal möglich sein wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19d3e5ab-94b7-3d64-b9b5-3afe28fcab88",
                                        "entry_id": "f9ef810e-a7a5-357a-9648-0b676a309f21",
                                        "glosses": [
                                            "Wissen oder Vorstellung von etwas"
                                        ],
                                        "tags": [
                                            "umgangssprachlich,",
                                            "ohne Artikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "118d89dd-4205-4c3f-9224-7c2b2f526791",
                                                "sense_id": "19d3e5ab-94b7-3d64-b9b5-3afe28fcab88",
                                                "text": "Von Biologie hat er keine Ahnung."
                                            },
                                            {
                                                "example_id": "2ef83bca-6f65-4824-bcea-652750ea9757",
                                                "sense_id": "19d3e5ab-94b7-3d64-b9b5-3afe28fcab88",
                                                "text": "Da musst du Balduin fragen, der hat Ahnung von so was."
                                            },
                                            {
                                                "example_id": "3cd6ba5d-33e0-414c-b1f1-e47d81861c1d",
                                                "sense_id": "19d3e5ab-94b7-3d64-b9b5-3afe28fcab88",
                                                "text": "„[…] Sei doch einfach ruhig, wenn Du keine Ahnung von dem Thema hast.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
