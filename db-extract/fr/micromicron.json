                "senses": [
                    {
                        "sense_id": "74afceeb-25a2-379e-9667-3a253b5266f9",
                        "entry_id": "94f4f067-75f7-3a7f-bd40-09067862bbfe",
                        "glosses": [
                            "Unité de mesure de longueur valant 0,001 micron, soit 1 nanomètre. Le symbole : μμ."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "note": "Ce n’est pas un « micro- » d’un micron",
                        "examples": [
                            {
                                "example_id": "943f79ac-af0a-4532-878c-c221f55ee90b",
                                "sense_id": "74afceeb-25a2-379e-9667-3a253b5266f9",
                                "text": "Le trajet parcouru dans l’air pendant une ondulation ou longueur d’onde varie donc de façon inverse, de 396 millionièmes de millimètres ou μμ (micromicrons) (1) pour la raie H, à 680 millionièmes de millimètres pour la raie B."
                            },
                            {
                                "example_id": "4ef91cfb-b298-43e1-9a61-bb2d50c76666",
                                "sense_id": "74afceeb-25a2-379e-9667-3a253b5266f9",
                                "text": "Chaque particule peut comprendre plusieurs molécules, mais le diamètre des plus grandes de ces particules ne dépasse pas 100-200 micromicrons (un micromicron = 1/1000000 de millimètre)."
                            }
                        ]
                    }
                ],
