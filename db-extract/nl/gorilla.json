                                        "entry_id": "701fbdf4-1c3b-3591-a966-393ffd8c0ba5",
                                        "glosses": [
                                            "Vertreter der gleichnamigen Gattung der Menschenaffen aus der Ordnung der Primaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db4daca7-c936-4596-b73a-1a1b60340e52",
                                                "sense_id": "b3f09138-5adf-333d-ab7d-82e15a57144d",
                                                "text": "Gorillas sind in freier Wildbahn vor allem durch den Verlust ihres Lebensraums bedroht."
                                            },
                                            {
                                                "example_id": "6ac1e5f9-a371-4822-86d8-b06a2ad62f27",
                                                "sense_id": "b3f09138-5adf-333d-ab7d-82e15a57144d",
                                                "text": "Zur Gattung Gorilla gehören die Arten Gorilla gorilla und Gorilla beringei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99f4db88-0ea6-327a-bad3-a88743de30c1",
                                        "entry_id": "701fbdf4-1c3b-3591-a966-393ffd8c0ba5",
                                        "glosses": [
                                            "die Gattung, der alle Gorillas^([1]) angehören"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27be891e-1323-4c20-b37c-4d216e76b08b",
                                                "sense_id": "99f4db88-0ea6-327a-bad3-a88743de30c1",
                                                "text": "Gorillas sind enger mit dem Menschen verwandt als Orang-Utans."
                                            },
                                            {
                                                "example_id": "c4701015-d5cf-46bf-a7ee-9a918ff3278f",
                                                "sense_id": "99f4db88-0ea6-327a-bad3-a88743de30c1",
                                                "text": "Zur Gattung Gorilla gehören die Arten Gorilla gorilla und Gorilla beringei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0bc1fe40-978a-34a2-9e65-70bf63dd3e43",
                                        "entry_id": "701fbdf4-1c3b-3591-a966-393ffd8c0ba5",
                                        "glosses": [
                                            "Mann, der für Personenschutz zuständig ist"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bdf97d-4cc1-46f5-8993-5f7bac9ed54a",
                                                "sense_id": "0bc1fe40-978a-34a2-9e65-70bf63dd3e43",
                                                "text": "„Zwei Gorillas warfen sich auf ihn, und dem armen Mädchen ist nichts passiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
