                "senses": [
                    {
                        "sense_id": "4e65567e-3955-3c7c-af52-f7622aab95f5",
                        "entry_id": "39d2852b-8c82-31cb-bc97-6d6babab1a70",
                        "glosses": [
                            "Association française qui se consacre au problème de la phobie scolaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4984aea5-9052-4de4-87ac-3fdf161c70db",
                                "sense_id": "4e65567e-3955-3c7c-af52-f7622aab95f5",
                                "text": "Mieux vaut reconnaître les difficultés rencontrées par son enfant, ne pas hésiter à en parler à son médecin traitant ou à contacter des associations, comme l’APS, qui sauront aider les familles à trouver des structures adaptées ou des interlocuteurs privilégiés."
                            },
                            {
                                "example_id": "387f97ce-9997-427e-9081-13b4ae7611a1",
                                "sense_id": "4e65567e-3955-3c7c-af52-f7622aab95f5",
                                "text": "Samedi 30 septembre : dans le cadre des rencontres nationales de l’APS, les familles rémoises et alentours pourront se retrouver pour une matinée-balade en famille sur le site des Faux de Verzy, à partir de 9h30."
                            },
                            {
                                "example_id": "d7fff950-f7f3-47fa-836d-90a4688939af",
                                "sense_id": "4e65567e-3955-3c7c-af52-f7622aab95f5",
                                "text": "L’Association phobie scolaire (APS) a vu le nombre de ses adhérents grimper de façon alarmante depuis 2019."
                            }
                        ]
                    }
                ],
