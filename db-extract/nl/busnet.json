                        "examples": [
                            {
                                "example_id": "cf94984b-2ecd-4c8e-87f7-d6c9826c73b8",
                                "sense_id": "efd9c700-750c-3191-a246-4803583eaa81",
                                "text": "Verwacht wordt dat tijdens de Olympische Spelen een miljoen passagiers extra van het busnet gebruik zullen maken. Op een normale dag zijn dat er 1,6 miljoen. Ultieme gesprekken om de staking af te wenden, brachten donderdag niets op."
                            },
                            {
                                "example_id": "edf060e9-9eae-4c61-9a58-259c4af3da11",
                                "sense_id": "efd9c700-750c-3191-a246-4803583eaa81",
                                "text": "Stadsvervoerbedrijf GVB bevestigt dat er tram- en buslijnen in de richting noord-zuid verdwijnen, maar zegt dat er in oost-westrichting ritten bij komen. Bovendien wordt 400 miljoen geïnvesteerd in het tram- en busnet, aldus het bedrijf."
                            }
                        ]
