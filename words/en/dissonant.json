{
    "word_family": [
        "dissonance",
        "dissonantly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9fc9e68f-a342-3ddc-bef5-840bacddc7d3",
                    "sense_definition": "Characterized by harsh, clashing, or unharmonious sounds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "auditory_dissonance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra startled the audience with a sudden burst of <w>dissonant</w> chords.",
                            "target_lang_translations": {
                                "de": "Das Orchester erschreckte das Publikum mit einem plötzlichen Ausbruch <w>dissonanter</w> Akkorde."
                            }
                        },
                        {
                            "text": "The broken piano produced harsh, <w>dissonant</w> notes that were unpleasant to hear.",
                            "target_lang_translations": {
                                "de": "Das kaputte Klavier erzeugte schrille, <w>dissonante</w> Töne, die unangenehm anzuhören waren."
                            }
                        }
                    ],
                    "synonyms": [
                        "discordant",
                        "cacophonous",
                        "disharmonious",
                        "inharmonious"
                    ],
                    "antonyms": [
                        "harmonious",
                        "melodious",
                        "consonant"
                    ],
                    "common_phrases": [
                        "dissonant chords",
                        "dissonant notes",
                        "dissonant sound"
                    ],
                    "target_lang_definitions": {
                        "de": "Durch unangenehme, unharmonische oder schrille Klänge gekennzeichnet; nicht zusammenklingend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dissonant",
                                "target_lang_sense_clarification": "akustisch unharmonisch oder misstönend"
                            },
                            {
                                "target_lang_word": "unharmonisch",
                                "target_lang_sense_clarification": "nicht harmonisch klingend"
                            },
                            {
                                "target_lang_word": "misstönend",
                                "target_lang_sense_clarification": "schrill oder schief klingend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e145850e-a01d-3713-a5a6-1e05186492f2",
                    "sense_definition": "Disagreeing, incongruous, or clashing with something else.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "incongruous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His aggressive behavior seemed entirely <w>dissonant</w> with his gentle reputation.",
                            "target_lang_translations": {
                                "de": "Sein aggressives Verhalten schien völlig <w>im Widerspruch</w> zu seinem sanften Ruf zu stehen."
                            }
                        },
                        {
                            "text": "The politician struggled to explain views that were <w>dissonant</w> with party policy.",
                            "target_lang_translations": {
                                "de": "Der Politiker hatte Mühe, Ansichten zu erklären, die mit der Parteilinie <w>nicht übereinstimmten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "discordant",
                        "inharmonious"
                    ],
                    "antonyms": [
                        "concordant",
                        "harmonious",
                        "accordant"
                    ],
                    "common_phrases": [
                        "dissonant with"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht übereinstimmend, widersprüchlich oder im Widerspruch zu etwas stehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "dissonant",
                                "target_lang_sense_clarification": "gehoben für unstimmig oder widersprüchlich"
                            },
                            {
                                "target_lang_word": "widersprüchlich",
                                "target_lang_sense_clarification": "nicht zusammenpassend oder im Gegensatz stehend"
                            },
                            {
                                "target_lang_word": "unstimmig",
                                "target_lang_sense_clarification": "nicht harmonierend oder unpassend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}