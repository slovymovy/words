                "senses": [
                    {
                        "sense_id": "8430a3df-6aa2-3743-82e0-47a529f55605",
                        "entry_id": "497b03ae-377f-3f5e-9dac-ac68a1cdeafe",
                        "glosses": [
                            "Appauvrir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4b56b1-adc7-4843-a487-3203783d960e",
                                "sense_id": "8430a3df-6aa2-3743-82e0-47a529f55605",
                                "text": "Un honnête homme, que l'héritage d'une énorme fortune brusquement survenue a étourdi, extasié, et fait sortir de ses mœurs simples et distinguées, n'a pas besoin de se réappauvrir pour redevenir ce qu'il fut."
                            },
                            {
                                "example_id": "f8b95682-7804-4a2b-8e27-249bb319615d",
                                "sense_id": "8430a3df-6aa2-3743-82e0-47a529f55605",
                                "text": "Il faudrait réappauvrir les futaies et cela pose un problème de choix économique vraiment très difficile à traiter et à ma connaissance on n'a pas encore les éléments suffisants pour prendre une option décisive dans ce sens là."
                            }
                        ]
                    }
