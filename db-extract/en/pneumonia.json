        "de-extract.jsonl": [
            {
                "entry_id": "50f80ae7-a323-39c0-856a-cbc7545fe431",
                "word": "pneumonia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d37ad20b-1c18-308e-ab30-45141104a55f",
                        "entry_id": "50f80ae7-a323-39c0-856a-cbc7545fe431",
                        "glosses": [
                            "Lungenentzündung, Pneumonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bb4b2e1-da5d-4a78-b5f8-aa2767e05fd4",
                                "sense_id": "d37ad20b-1c18-308e-ab30-45141104a55f",
                                "text": "Jim died of pneumonia.",
                                "translation": "Jim starb an einer Lungenentzündung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "070d9ef9-1ddb-4304-a33d-36db72226b6b",
                        "source_entry_id": "50f80ae7-a323-39c0-856a-cbc7545fe431",
                        "source_sense_id": "d37ad20b-1c18-308e-ab30-45141104a55f",
                        "source_sense_description": "Medizin: Lungenentzündung, Pneumonie",
                        "target_lang_word": "Lungenentzündung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lungenentzündung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                        "entry_id": "fcd848c8-ab8e-3d77-a258-e03848e6f380",
                                        "glosses": [
                                            "akute oder chronische Entzündung des Gewebes der Lunge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6cca0ad-a428-4d36-9b37-5a80140f2d43",
                                                "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                                "text": "Lungenentzündungen werden fast immer durch Infektionen verursacht."
                                            },
                                            {
                                                "example_id": "5277472d-7e6d-48b7-92b6-fd4aee9ef10c",
                                                "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                                "text": "Peter hat eine schwere Lungenentzündung, hohes Fieber und Schüttelfrost."
                                            },
                                            {
                                                "example_id": "cbc979a6-e8a1-4bce-98c9-64cd1d586a1c",
                                                "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                                "text": "Meine Großtante ist an einer Lungenentzündung gestorben."
                                            },
                                            {
                                                "example_id": "69b4414c-ee3b-4895-b1f5-3a4b2bd6516a",
                                                "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                                "text": "„Man teilt ihr mit, dass ihr Vater im Sanatorium Saint-Paul in Dallas an einer Lungenentzündung gestorben ist.“"
                                            },
                                            {
                                                "example_id": "fe0c9940-c718-4698-a633-f26da42509df",
                                                "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                                "text": "„Wir hatten schon befürchtet, dass es bei ihr eine Lungenentzündung werden könnte.“"
                                            },
                                            {
                                                "example_id": "2a0a3524-25d1-48d1-b719-a553c24cb1ba",
                                                "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                                "text": "„Vielmehr dachte ich darüber nach, was es wohl für die gute Phoebe bedeutet, wenn ich eine Lungenentzündung kriege und sterbe.“"
                                            },
                                            {
                                                "example_id": "513e67d3-7440-464a-8e01-2e42643b95e6",
                                                "sense_id": "3293cf1b-55ff-38ed-9efc-479cc7d03809",
                                                "text": "„Er kann sich nicht mehr durchgängig mitteilen, er isst immer weniger und bekommt eine Lungenentzündung, dann verweigert er die Nahrungsaufnahme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e36a4bd-6133-4255-8545-6cde8214eccb",
                        "source_entry_id": "50f80ae7-a323-39c0-856a-cbc7545fe431",
                        "source_sense_id": "d37ad20b-1c18-308e-ab30-45141104a55f",
                        "source_sense_description": "Medizin: Lungenentzündung, Pneumonie",
                        "target_lang_word": "Pneumonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pneumonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0462099-048b-368e-af6f-3a1d19797902",
                                        "entry_id": "a4e4790f-2b1b-3d89-9096-36382dbc1a38",
                                        "glosses": [
                                            "akute oder chronische Entzündung des Gewebes der Lunge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d6e0b7-1b81-4637-85b4-477de31830c3",
                                                "sense_id": "e0462099-048b-368e-af6f-3a1d19797902",
                                                "text": "„Pneumonien stellen unter den Infektionskrankheiten in den industrialisierten Ländern die häufigste Todesursache dar.“"
                                            },
                                            {
                                                "example_id": "2b899c22-622c-41e1-9c11-0c3adb4af5a5",
                                                "sense_id": "e0462099-048b-368e-af6f-3a1d19797902",
                                                "text": "Der Patient ist aufgrund einer Pneumonie sehr geschwächt."
                                            },
                                            {
                                                "example_id": "4b27c83b-56cc-4e18-b899-6e5a604db349",
                                                "sense_id": "e0462099-048b-368e-af6f-3a1d19797902",
                                                "text": "Auch bei vermeintlich harmlosen Kinderkrankheiten wie den Masern können schwere Komplikationen, wie eine Pneumonie, auftreten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
