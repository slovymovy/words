                    },
                    {
                        "translation_id": "6f396c0e-530d-4e65-9b2c-d440965e06b0",
                        "source_entry_id": "44ef21c6-8651-35a9-9446-0732201e2fd7",
                        "source_sense_id": "3c2de937-67f5-3717-a382-16c6fc653f74",
