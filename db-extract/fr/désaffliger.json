                "senses": [
                    {
                        "sense_id": "5c245558-36f6-3a28-9c67-1e5abd352489",
                        "entry_id": "52fc5797-527f-3d66-8910-a770b7f7d907",
                        "glosses": [
                            "Faire perdre son caractère affligé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04de26d5-9caa-4e43-b29d-e81d6297df4a",
                                "sense_id": "5c245558-36f6-3a28-9c67-1e5abd352489",
                                "text": "Après tant de troubles, d’agitations et de calamités de toute espèce, on a peine à croire à autant d’éclat et de luxe ; cela désafflige ; cela réjouit l’âme… c’est de la magie."
                            },
                            {
                                "example_id": "109883d4-9158-4856-8733-e5468893e54b",
                                "sense_id": "5c245558-36f6-3a28-9c67-1e5abd352489",
                                "text": "Elle éprouva à ce moment un remord de s’être trop longtemps occupée de son malheur personnel, d’avoir soigné son propre cas et essayé d’abord de se désaffliger elle-même."
                            }
                        ]
                    }
                ],
