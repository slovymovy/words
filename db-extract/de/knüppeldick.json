                ],
                "senses": [
                    {
                        "sense_id": "a6e696f5-99ff-3ea0-ba62-041364cc5f5c",
                        "entry_id": "e7413307-a2e9-3db6-8e50-b781aa3a3cca",
                        "glosses": [
                            "mehrere Schwierigkeiten / Mängel auf einmal sich ereignend, sehr schlimm; in dieser Bedeutung heute fast nur noch in der Wortverbindung knüppeldick kommen verwendet"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7a4aedfa-1ddc-4863-8d48-a24c522fc1cf",
                                "sense_id": "a6e696f5-99ff-3ea0-ba62-041364cc5f5c",
                                "text": "„Stellenabbau, Filialschließungen und drohende massive finanzielle Einschnitte: Für die Beschäftigten des kriselnden Warenhauskonzerns Karstadt kommt es derzeit knüppeldick.“"
                            },
                            {
                                "example_id": "46d7268d-1b7c-4994-9ca8-6dc8ac99bdbb",
                                "sense_id": "a6e696f5-99ff-3ea0-ba62-041364cc5f5c",
                                "text": "„Es kommt derzeit knüppeldick für den Volkswagen-Konzern: Nach der Abgasaffäre gibt es nun die nächste Hiobsbotschaft aus Wolfsburg. Weltweit müssen 177.000 Passat der Baujahre 2014 und 2015 wegen Problemen an der Zentralelektrik zurück in die Werkstatt.“"
                            },
                            {
                                "example_id": "dbaa09f9-f9bd-4772-907b-fcfe9701da6b",
                                "sense_id": "a6e696f5-99ff-3ea0-ba62-041364cc5f5c",
                                "text": "Deutschlands Eishockey-Herren können gegen Turnierfavorit Schweden über zwei Drittel mithalten. Dann kommt es im zweiten Vorrundenspiel der WM in Köln und Paris knüppeldick für das DEB-Team. [Endstand 2:7]"
                            },
                            {
                                "example_id": "26f602af-7a1c-459a-a97a-24131c29fa1a",
                                "sense_id": "a6e696f5-99ff-3ea0-ba62-041364cc5f5c",
                                "text": "„Für Bayer 04 Leverkusen kommt es dagegen im Moment knüppeldick: Einen Tag nach Verkündung der Viermonatssperre gegen Hakan Calhanoglu folgte die zweite Bundesliga-Niederlage in Serie.“"
                            },
                            {
                                "example_id": "0fffa176-f976-4568-be6a-fcd26bfa95e9",
                                "sense_id": "a6e696f5-99ff-3ea0-ba62-041364cc5f5c",
                                "text": "„Für die katholische Kirche kommt es in diesen Tagen knüppeldick: Erst bringt sie eine von ihr in Auftrag gegebene Studie zur Aufarbeitung sexueller Gewalt zum Scheitern, dann muss sie bei der Auswertung eines inzwischen gestoppten Telefonnotdienstes einräumen, dass es Hinweise gibt auf regelrechte pädophile Netzwerke unter den Geistlichen, und jetzt auch noch der Vorwurf, katholische Krankenhäuser im Erzbistum Köln hätten einer vergewaltigten Frau die Hilfe verweigert.“"
                            },
                            {
                                "example_id": "edf1a814-05a0-4062-bbd2-7f490237ab74",
                                "sense_id": "a6e696f5-99ff-3ea0-ba62-041364cc5f5c",
                                "text": "„Es kommt knüppeldick für Angela Merkel und ihre Regierung in diesen Tagen: Kritik von Altkanzler Kohl, Kritik von Altkanzler Schmidt, Kritik von Bundespräsident Wulff, und dazu das deutlich vernehmbare Murren in den Koalitionsfraktionen im Bundestag.“"
                            }
                        ],
