                            {
                                "example_id": "18c82b55-d9c3-4812-8872-8a88e97aad78",
                                "sense_id": "3211f7cb-3abe-3d51-86f6-cfdd8887e864",
                                "text": "Hij was een tijdgenoot van Picasso en maakte deel uit van dezelfde kunstbeweging.",
                                "translation": "He was a contemporary of Picasso and was part of the same art movement.",
                                "english": "He was a contemporary of Picasso and was part of the same art movement."
