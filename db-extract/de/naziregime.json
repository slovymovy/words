                "senses": [
                    {
                        "sense_id": "52e6f55d-51fa-3d14-8d74-261e6f8df8c0",
                        "entry_id": "0458bc99-99f4-310c-b55c-46751756aa53",
                        "glosses": [
                            "Herrschaft/Regime der Nationalsozialisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43777a7c-3888-4c48-b8ce-4229c7142677",
                                "sense_id": "52e6f55d-51fa-3d14-8d74-261e6f8df8c0",
                                "text": "„Lassen Sie mich also folgendes sagen: Ich, Itzig Finkelstein, setzte mich mit den amerikanisch-jüdischen Hilfsorganisationen für die überlebenden Juden des Naziregimes in Verbindung.“"
                            },
                            {
                                "example_id": "4b6ae3ad-808c-4b56-b1a3-ae71fb3d04a0",
                                "sense_id": "52e6f55d-51fa-3d14-8d74-261e6f8df8c0",
                                "text": "„In Deutschland verfolgte das Naziregime eine offen aggressive judenfeindliche Politik.“"
                            },
                            {
                                "example_id": "5e2bc74e-f329-41df-8a9e-a78dd5cd59c8",
                                "sense_id": "52e6f55d-51fa-3d14-8d74-261e6f8df8c0",
                                "text": "„Ihre Aufgabe war es, all jene Kunstwerke aufzustöbern und sicherzustellen, die unter dem Naziregime in den besetzten Gebieten, aber auch in Deutschland den Besitzer gewechselt hatten durch Beschlagnahme, Verlagerung oder Raub.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
