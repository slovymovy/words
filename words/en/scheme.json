    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0607760-a43f-3f3e-82d3-d28d46e42fe3",
                    "sense_definition": "A systematic plan of future action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plan_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced a new <w>scheme</w> to help young people find jobs.",
                            "target_lang_translations": {
                                "ru": "Правительство представило новую <w>программу</w>, чтобы помочь молодежи найти работу.",
                                "zh": "政府推出了一项新的<w>计划</w>，帮助年轻人找到工作。"
                            }
                        },
                        {
                            "text": "She decided to join the company's pension <w>scheme</w> immediately.",
                            "target_lang_translations": {
                                "ru": "Она решила немедленно присоединиться к пенсионной <w>программе</w> компании.",
                                "zh": "她决定立刻加入公司的养老金<w>计划</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plan",
                        "project",
                        "proposal",
                        "blueprint",
                        "design",
                        "programme",
                        "strategy"
                    ],
                    "common_phrases": [
                        "pension scheme",
                        "pilot scheme",
                        "training scheme",
                        "insurance scheme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематический план будущих действий.",
                        "zh": "对未来行动的系统性安排。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программа",
                                "target_lang_sense_clarification": "план деятельности или работ"
                            },
                            {
                                "target_lang_word": "план",
                                "target_lang_sense_clarification": "порядок действий"
                            },
                            {
                                "target_lang_word": "система",
                                "target_lang_sense_clarification": "форма организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "计划",
                                "target_lang_sense_clarification": "为实现某个目标而制定的行动安排"
                            },
                            {
                                "target_lang_word": "方案",
                                "target_lang_sense_clarification": "较具体、可执行的安排"
                            },
                            {
                                "target_lang_word": "项目",
                                "target_lang_sense_clarification": "正式项目或制度安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "818414d0-3810-3da5-b645-10d73c2357ed",
                    "sense_definition": "A plot or secret, devious plan.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "plan_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police uncovered a <w>scheme</w> to defraud elderly people of their savings.",
                            "target_lang_translations": {
                                "ru": "Полиция раскрыла <w>схему</w> обмана пожилых людей на их сбережения.",
                                "zh": "警方揭露了一个骗取老年人积蓄的<w>骗局</w>。"
                            }
                        },
                        {
                            "text": "He came up with a crazy <w>scheme</w> to get rich quickly.",
                            "target_lang_translations": {
                                "ru": "Он придумал безумную <w>схему</w>, как быстро разбогатеть.",
                                "zh": "他想出了一个快速致富的疯狂<w>盘算</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "conspiracy",
                        "intrigue",
                        "machination"
                    ],
                    "common_phrases": [
                        "pyramid scheme",
                        "Ponzi scheme",
                        "get-rich-quick scheme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заговор или тайный, коварный план.",
                        "zh": "阴险秘密的计划，尤指带有欺骗或伤害目的的安排。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схема",
                                "target_lang_sense_clarification": "мошеннический или хитрый план"
                            },
                            {
                                "target_lang_word": "афера",
                                "target_lang_sense_clarification": "мошенничество"
                            },
                            {
                                "target_lang_word": "махинация",
                                "target_lang_sense_clarification": "нечестная уловка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴谋",
                                "target_lang_sense_clarification": "秘密而有害的计划"
                            },
                            {
                                "target_lang_word": "骗局",
                                "target_lang_sense_clarification": "欺骗性的安排或计划"
                            },
                            {
                                "target_lang_word": "盘算",
                                "target_lang_sense_clarification": "心里盘算的诡计或不正当计划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "797bd4c3-9d4d-357c-9dee-28b12393570d",
                    "sense_definition": "An orderly combination of related parts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "system_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to choose a color <w>scheme</w> for the new living room.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выбрать цветовую <w>гамму</w> для новой гостиной.",
                                "zh": "我们得为新客厅选择一种<w>配色方案</w>。"
                            }
                        },
                        {
                            "text": "In the grand <w>scheme</w> of things, this mistake does not really matter.",
                            "target_lang_translations": {
                                "ru": "В общей <w>картине</w> вещей эта ошибка на самом деле не имеет значения.",
                                "zh": "从整体<w>格局</w>来看，这个错误其实并不重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "color scheme",
                        "grand scheme of things",
                        "rhyme scheme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упорядоченное сочетание связанных частей.",
                        "zh": "相关部分按一定次序构成的整体组合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гамма",
                                "target_lang_sense_clarification": "цветовая"
                            },
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "комбинация элементов"
                            },
                            {
                                "target_lang_word": "система",
                                "target_lang_sense_clarification": "устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配色方案",
                                "target_lang_sense_clarification": "颜色等元素的整体安排"
                            },
                            {
                                "target_lang_word": "搭配",
                                "target_lang_sense_clarification": "各部分之间有条理的组合"
                            },
                            {
                                "target_lang_word": "格局",
                                "target_lang_sense_clarification": "事物整体的组织方式或全貌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43a2762f-f82b-34e4-b1d9-759dacb18d99",
                    "sense_definition": "A chart or diagram of a system or object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "system_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The textbook provided a detailed <w>scheme</w> of the internal combustion engine.",
                            "target_lang_translations": {
                                "ru": "Учебник содержал подробную <w>схему</w> двигателя внутреннего сгорания.",
                                "zh": "课本提供了内燃机的详细<w>示意图</w>。"
                            }
                        },
                        {
                            "text": "He drew a quick <w>scheme</w> to explain how the network connects.",
                            "target_lang_translations": {
                                "ru": "Он набросал быструю <w>схему</w>, чтобы объяснить, как соединяется сеть.",
                                "zh": "他快速画了一张<w>示意图</w>，说明网络是如何连接的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chart",
                        "diagram",
                        "schematic",
                        "graph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чертёж или диаграмма системы или объекта.",
                        "zh": "表示某个系统或物体结构的图表或图示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схема",
                                "target_lang_sense_clarification": "чертёж или изображение"
                            },
                            {
                                "target_lang_word": "чертёж",
                                "target_lang_sense_clarification": "детальное изображение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "示意图",
