                ],
                "senses": [
                    {
                        "sense_id": "806062e3-345d-353e-853d-c7374ee6f998",
                        "entry_id": "e2d66850-7d5d-346d-859a-920928708312",
                        "glosses": [
                            "предназначенный для уничтожения бактерий; подавляющий размножение различных бактерий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440a94c6-0e78-4f4e-bde9-a66cf1683ed5",
                                "sense_id": "806062e3-345d-353e-853d-c7374ee6f998",
                                "text": "Однако основное преимущество комбинированного применения антибактериальных препаратов состоит в том, что оно задерживает образование устойчивых форм микробов."
                            },
                            {
                                "example_id": "54fadf4c-9057-467f-aad5-01dfde7aeffb",
                                "sense_id": "806062e3-345d-353e-853d-c7374ee6f998",
                                "text": "Мускатный орех и мускатный цвет содержат вещества, которые стимулируют пищеварение и оказывают антибактериальное, противовоспалительное, противоотёчное, спазмолитическое и болеутоляющее действие."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8eb1f19a-1d24-473f-9601-cfb39d0395b4",
                        "source_entry_id": "e2d66850-7d5d-346d-859a-920928708312",
                        "source_sense_id": "806062e3-345d-353e-853d-c7374ee6f998",
                        "target_lang_word": "antibacterial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antibacterial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d885d19-709e-32f7-8f41-b6f7b3a2d8ab",
                                        "entry_id": "fe72d396-6e45-30ab-8e83-e9f69c571fe2",
                                        "glosses": [
                                            "A drug having the effect of killing or inhibiting bacteria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2ba5c3-82e9-4d39-9fce-ab47bdddfea0",
                                                "sense_id": "4d885d19-709e-32f7-8f41-b6f7b3a2d8ab",
                                                "text": "Many household products contain antibacterials."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antibacterial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e13b14b-e405-3f35-ac47-21fe47e60343",
                                        "entry_id": "dfe61aa6-633a-35c1-b95c-c68298c84530",
                                        "glosses": [
                                            "Killing or inhibiting bacteria."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37fd3909-51a2-4fbd-a5f5-7df7f7685c5a",
                                                "sense_id": "4e13b14b-e405-3f35-ac47-21fe47e60343",
                                                "text": "This drug has an antibacterial effect."
                                            },
                                            {
                                                "example_id": "92815561-e842-46b7-bf07-51145df44f43",
                                                "sense_id": "4e13b14b-e405-3f35-ac47-21fe47e60343",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a27d5c4-0585-3070-8cf6-1325277377f5",
                                        "entry_id": "dfe61aa6-633a-35c1-b95c-c68298c84530",
                                        "glosses": [
                                            "Opposing the theory that diseases are caused by bacteria."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
