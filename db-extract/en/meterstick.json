                                "sense_id": "288c5718-fe84-35c2-b860-ba0649b4ded4",
                                "text": "He must use his unit of length taken from his meterstick."
                            },
                            {
                                "example_id": "59d1afa3-8d60-49bd-9f22-6323cea68bc2",
                                "sense_id": "288c5718-fe84-35c2-b860-ba0649b4ded4",
                                "text": "Stand the meterstick upright on the table (or floor) so that the 0-centimeter end is against the tabletop (or floor)."
                            },
                            {
                                "example_id": "7b221d60-53b3-4600-91c6-34336549f8d3",
                                "sense_id": "288c5718-fe84-35c2-b860-ba0649b4ded4",
                                "text": "Check whether the meterstick edge intersects with the toe-end curve of the footprint at the furthest point, T, away from the heel point."
