{
    "word_family": [
        "duivel",
        "verduivelen"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "423648f7-29f9-30f5-b3cc-cf030e4752b1",
                    "sense_definition": "Duidt een hoge mate aan, vergelijkbaar met heel erg.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is een <w>verduiveld</w> sterke man.",
                            "target_lang_translations": {
                                "fr": "C'est un homme <w>sacrément</w> fort."
                            }
                        },
                        {
                            "text": "Zij is een <w>verduiveld</w> mooie meid.",
                            "target_lang_translations": {
                                "fr": "C'est une fille <w>diablement</w> jolie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Wordt vaak gebruikt in informele contexten om nadruk te leggen."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Indique un haut degré, similaire à très ou sacrément."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sacrément",
                                "target_lang_sense_clarification": "Adverbe intensif familier pour souligner une qualité."
                            },
                            {
                                "target_lang_word": "diablement",
                                "target_lang_sense_clarification": "Adverbe intensif utilisé pour accentuer un adjectif."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "6704fbc3-510f-33f6-8bf6-213cae285c97",
                    "sense_definition": "Een uitroep die verbazing, teleurstelling of woede uitdrukt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verduiveld</w> wat doe je nou weer.",
                            "target_lang_translations": {
                                "fr": "<w>Diable</w>, qu'est-ce que tu fais encore ?"
                            }
                        },
                        {
                            "text": "<w>Verduiveld</w> ik ben mijn sleutels alweer vergeten.",
                            "target_lang_translations": {
                                "fr": "<w>Bon sang</w>, j'ai encore oublié mes clés."
                            }
                        }
                    ],
                    "synonyms": [
                        "verduveld",
                        "bliksems",
                        "deksels",
                        "donders",
                        "drommels",
                        "verdraaid",
                        "verdomd"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une exclamation exprimant la surprise, la déception ou la colère."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "diable",
                                "target_lang_sense_clarification": "Exclamation courante pour exprimer l'agacement ou la surprise."
                            },
                            {
                                "target_lang_word": "zut",
                                "target_lang_sense_clarification": "Exclamation légère pour exprimer la contrariété."
                            },
                            {
                                "target_lang_word": "bon sang",
                                "target_lang_sense_clarification": "Exclamation plus forte pour exprimer l'énervement."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bf9af9fa-7e00-3ecd-be38-37cc6422848e",
                    "sense_definition": "Bezeten door de duivel of met een woest of boosaardig karakter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek met een <w>verduiveld</w> gezicht naar zijn tegenstander.",
                            "target_lang_translations": {
                                "fr": "Il regardait son adversaire avec un visage <w>diabolique</w>."
                            }
                        },
                        {
                            "text": "De man gedroeg zich als een <w>verduiveld</w> wezen in de nacht.",
                            "target_lang_translations": {
                                "fr": "L'homme se comportait comme une créature <w>démoniaque</w> dans la nuit."
                            }
                        }
                    ],
                    "synonyms": [
                        "verduveld"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Wordt tegenwoordig minder vaak gebruikt in deze letterlijke betekenis."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Possédé par le diable ou ayant un caractère féroce ou malveillant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "diabolique",
                                "target_lang_sense_clarification": "Qui a un caractère méchant ou malveillant."
                            },
                            {
                                "target_lang_word": "démoniaque",
                                "target_lang_sense_clarification": "Qui semble possédé ou d'une nature maléfique."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f4ba56e-beea-329f-b619-fe93c2c270fd",
                    "sense_definition": "Het voltooid deelwoord van <w>verduivelen</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft de hele situatie volledig <w>verduiveld</w> door zijn acties.",
                            "target_lang_translations": {
                                "fr": "Il a complètement <w>gâché</w> toute la situation par ses actions."
                            }
                        },
                        {
                            "text": "Alles is door die fout helemaal <w>verduiveld</w> geraakt.",
                            "target_lang_translations": {
                                "fr": "Tout a été complètement <w>gâché</w> à cause de cette erreur."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammaticale vorm van het werkwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Le participe passé du verbe signifiant rendre diabolique ou gâcher."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gâché",
                                "target_lang_sense_clarification": "Sens figuré de ruiner ou rendre une situation mauvaise."
                            },
                            {
                                "target_lang_word": "diabolisé",
                                "target_lang_sense_clarification": "Sens littéral de rendre diabolique."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}