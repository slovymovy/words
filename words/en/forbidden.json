                    "sense_id": "48af50ee-597c-30e7-bf3b-b4273dfeb08f",
                    "sense_definition": "Not allowed; specifically disallowed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoking is strictly <w>forbidden</w> inside the hospital building.",
                            "target_lang_translations": {
                                "ru": "Курение внутри здания больницы строго <w>запрещено</w>.",
                                "nl": "Roken is binnen het ziekenhuisgebouw ten strengste <w>verboden</w>.",
                                "pl": "Palenie wewnątrz budynku szpitala jest surowo <w>zabronione</w>.",
                                "de": "Rauchen ist im Krankenhausgebäude strengstens <w>verboten</w>.",
                                "fr": "Il est strictement <w>interdit</w> de fumer à l'intérieur du bâtiment de l'hôpital.",
                                "it": "Fumare è severamente <w>vietato</w> all'interno dell'edificio dell'ospedale.",
                                "cs": "Kouření uvnitř budovy nemocnice je přísně <w>zakázáno</w>.",
                                "tr": "Hastane binasının içinde sigara içmek kesinlikle <w>yasaktır</w>.",
                                "es": "Fumar está estrictamente <w>prohibido</w> dentro del edificio del hospital."
                            }
                        },
                        {
                            "text": "They knew that entering the old forest was <w>forbidden</w> by the village elders.",
                            "target_lang_translations": {
                                "ru": "Они знали, что вход в старый лес был <w>запрещён</w> старейшинами деревни.",
                                "nl": "Ze wisten dat het betreden van het oude bos door de dorpsoudsten <w>verboden</w> was.",
                                "pl": "Wiedzieli, że wchodzenie do starego lasu było <w>zakazane</w> przez starszyznę wioski.",
                                "de": "Sie wussten, dass das Betreten des alten Waldes von den Dorfältesten <w>verboten</w> war.",
                                "fr": "Ils savaient que pénétrer dans la vieille forêt était <w>interdit</w> par les anciens du village.",
                                "it": "Sapevano che entrare nella vecchia foresta era <w>proibito</w> dagli anziani del villaggio.",
                                "cs": "Věděli, že vstup do starého lesa jim byl staršími vesnice <w>zakázán</w>.",
                                "tr": "Eski ormana girmenin köy büyükleri tarafından <w>yasaklandığını</w> biliyorlardı.",
                                "es": "Sabían que entrar al viejo bosque estaba <w>prohibido</w> por los ancianos de la aldea."
                            }
                        }
