{
    "word_family": [
        "désencombrement",
        "désencombrer",
        "encombrant",
        "encombre",
        "encombrement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dd080308-6101-3ce3-a2c4-469c179d2a57",
                    "sense_definition": "Occuper un lieu ou un espace de manière à gêner la circulation, le passage ou le mouvement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces vieux cartons abandonnés dans le couloir vont rapidement <w>encombrer</w> le passage."
                        },
                        {
                            "text": "Plusieurs camions en panne <w>encombrent</w> la route depuis ce matin, provoquant de gros ralentissements."
                        }
                    ],
                    "synonyms": [
                        "obstruer",
                        "bloquer",
                        "boucher"
                    ],
                    "antonyms": [
                        "dégager",
                        "libérer",
                        "désencombrer"
                    ],
                    "common_phrases": [
                        "encombrer le passage",
                        "encombrer les rues"
                    ]
                },
                {
                    "sense_id": "60cf8ba1-cc42-3e3b-81d8-19aa58e429b5",
                    "sense_definition": "Gêner ou surcharger quelqu'un ou l'esprit avec des contraintes ou des pensées inutiles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "charge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas t'<w>encombrer</w> l'esprit avec des soucis qui ne dépendent pas de toi."
                        },
                        {
                            "text": "Toutes ces formalités administratives inutiles ne font qu'<w>encombrer</w> le travail quotidien des employés."
                        }
                    ],
                    "synonyms": [
                        "embarrasser",
                        "surcharger"
                    ],
                    "antonyms": [
                        "soulager",
                        "alléger"
                    ],
                    "common_phrases": [
                        "encombrer l'esprit",
                        "encombrer la mémoire"
                    ]
                },
                {
                    "sense_id": "e6f98abc-dea6-320f-9345-9b66b46c5def",
                    "sense_definition": "Saturer une ligne de communication ou un réseau par un excès d'appels ou de données.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "saturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des milliers d'appels simultanés sont venus <w>encombrer</w> le standard téléphonique de l'hôpital."
                        },
                        {
                            "text": "Les téléchargements volumineux risquent d'<w>encombrer</w> la bande passante de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "saturer",
                        "engorger"
                    ],
                    "antonyms": [
                        "fluidifier"
                    ],
                    "common_phrases": [
                        "encombrer le réseau",
                        "encombrer les lignes"
                    ]
                }
            ]
        }
    ]
}