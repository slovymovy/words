                ],
                "senses": [
                    {
                        "sense_id": "128768b6-6d3b-3741-ab2e-338f3c0c5f30",
                        "entry_id": "90a6c9f0-9565-3b1d-b4ea-79d6d6c41a8b",
                        "glosses": [
                            "Eigenschaft, die in deutlichem Maße abweichendes (anomales) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad62eb4b-0165-4781-9177-5e354760d050",
                                "sense_id": "128768b6-6d3b-3741-ab2e-338f3c0c5f30",
                                "text": "„Also kommt die genetische Anomalität – wenn es denn eine ist – einzig in den betroffenen Individuen einer Generation vor. Sie ist ihnen nicht von ihren Vorgängern weitergegeben worden, noch geben sie sie an ihre Nachfahren weiter.“"
                            },
                            {
                                "example_id": "e14cb8c5-7e60-4c21-af76-da8ceb3bf54b",
                                "sense_id": "128768b6-6d3b-3741-ab2e-338f3c0c5f30",
                                "text": "„Das »Abrutschen« in die Anomalität bedeutet einen tiefen biografischen Einschnitt, den es nach Möglichkeit zu vermeiden gilt.“"
                            },
                            {
                                "example_id": "8d791cd3-1695-45a8-9047-230f2188fbfc",
                                "sense_id": "128768b6-6d3b-3741-ab2e-338f3c0c5f30",
                                "text": "„Nur wenn die ‚normale Wissenschaft‘ es mehrmalig nicht schafft, die Differenzen aufzulösen oder Ungewöhnlichkeiten zu erklären, wird ein Problem als Anomalität anerkannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
