                                        "examples": [
                                            {
                                                "example_id": "dd53f746-4874-49b2-8b8d-07d1f33e6f1e",
                                                "sense_id": "b0c44edc-6673-37d5-9271-73de4f50ca75",
                                                "text": "Avec un taille-thé, machine originaire du Japon, le duo tranche les cimes des tiges vert bouteille, propulsées dans un grand sac traînant derrière eux."
                                            },
                                            {
                                                "example_id": "fe6e7b2c-3917-49b2-9610-991ccb64201e",
                                                "sense_id": "b0c44edc-6673-37d5-9271-73de4f50ca75",
                                                "text": "Nous devions former un drôle de duo, tous les deux."
                                            },
