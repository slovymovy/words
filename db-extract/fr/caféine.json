        "fr-extract.jsonl": [
            {
                "entry_id": "e02e0b4d-4b49-36e8-a8bd-d656906d1623",
                "word": "caféine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ed6990a-a421-4f41-9d46-6b484884afdc",
                        "entry_id": "e02e0b4d-4b49-36e8-a8bd-d656906d1623",
                        "tags": [
                            "plural"
                        ],
                        "form": "caféines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28d31511-34f2-3959-9837-1fadaf2a6b07",
                        "entry_id": "e02e0b4d-4b49-36e8-a8bd-d656906d1623",
                        "glosses": [
                            "Composé chimique dérivé triméthylé de la xanthine et principe actif du café aux effets stimulants sur le système nerveux central."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb3ca6c7-1b3f-4f99-8bd7-4bb679b51ee3",
                                "sense_id": "28d31511-34f2-3959-9837-1fadaf2a6b07",
                                "text": "Caféine. — Existe dans beaucoup de plantes, café, thé, cola, maté, guarana."
                            },
                            {
                                "example_id": "53af16c3-c9f9-4c20-83c7-7f47804cdb4e",
                                "sense_id": "28d31511-34f2-3959-9837-1fadaf2a6b07",
                                "text": "Les industriels se sont acharnés, à coups de tests sur des cohortes de rats, à démontrer que les boissons énergisantes enrichies en substances excitantes comme la caféine, la taurine ou le glucuronolactone étaient inoffensives. — (« Sodas : Sugarland, baby », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 74)"
                            },
                            {
                                "example_id": "956c4f3e-f6e6-4fb3-8dea-35d4c2b8701b",
                                "sense_id": "28d31511-34f2-3959-9837-1fadaf2a6b07",
                                "text": "La caféine favorise l’utilisation des acides gras, ce qui permet, en cas d’effort musculaire, d’économiser les réserves musculaires de glycogène et, donc, de ralentir l’apparition de la fatigue."
                            },
                            {
                                "example_id": "518681d9-eb63-42c5-964f-665348f88c25",
                                "sense_id": "28d31511-34f2-3959-9837-1fadaf2a6b07",
                                "text": "Il est certain que la décoction koicha contient un taux de caféine élevé et qu’il n’est pas recommandé d’en boire trop tard dans la journée si on veut passer une nuit paisible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de539b7c-9996-4e8e-8bbf-4995f67030aa",
                        "source_entry_id": "e02e0b4d-4b49-36e8-a8bd-d656906d1623",
                        "source_sense_id": "28d31511-34f2-3959-9837-1fadaf2a6b07",
                        "target_lang_word": "Koffein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koffein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                        "entry_id": "1d794dbc-2d4c-322c-a873-99bd82dde2bb",
                                        "glosses": [
                                            "ein farbloser, bitter schmeckender organischer Stoff, der als Aufputschmittel verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8e1bd8-055a-4894-9ce0-ca41a8b03795",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "Morgens brauche ich meine Dosis Koffein, um gut in den Tag zu starten."
                                            },
                                            {
                                                "example_id": "024c40fd-2638-4ba2-8f0c-bd694c352c10",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Koffein ist ein schweres Gift, sicher beinahe so schwer wie Morphium.“"
                                            },
                                            {
                                                "example_id": "79a08273-29d7-4dbc-b4d7-f36be47fe49b",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Mein innerer Schweinehund beschwerte sich immer stärker, und das fehlende Koffein machte sich in Form von Missmut breit.“"
                                            },
                                            {
                                                "example_id": "41b3bfba-cf9b-40da-8144-0448dd4b73f9",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Das Koffein pumpte im ganzen Körper, die vielen Eindrücke durchfluteten das Mädchen vom Land, spülten über sie hinweg wie tagsüber die Wellen der Ägäis.“"
                                            },
                                            {
                                                "example_id": "0ad7e5ac-85c4-4387-b909-4d4d51675833",
                                                "sense_id": "fe3aa44b-7401-3854-aac5-f8f652caa1aa",
                                                "text": "„Es war früh am Freitagmorgen, die Vögel sangen leise, und ich stand auf dem Bürgersteig vor meinem Haus in der Sonne und fragte mich, ob ich die richtige Entscheidung getroffen hatte und ob ich das ohne Koffein überhaupt beurteilen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac39be31-96d6-4995-bd1b-da940f289921",
                        "source_entry_id": "e02e0b4d-4b49-36e8-a8bd-d656906d1623",
                        "source_sense_id": "28d31511-34f2-3959-9837-1fadaf2a6b07",
                        "target_lang_word": "caffeine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caffeine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9f25342-7fbd-3c3f-b228-752fa32012aa",
                                        "entry_id": "52c34a77-5caf-36fc-b499-dcee9702e76a",
                                        "glosses": [
                                            "An alkaloid, C₈H₁₀N₄O₂, found naturally in tea and coffee plants, which acts as a mild stimulant on the central nervous system."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "794eb9f9-dd07-45eb-b1d8-245848397f9f",
                                                "sense_id": "b9f25342-7fbd-3c3f-b228-752fa32012aa",
                                                "text": "For example, 0.100 grams of caffeine yield by combustion, by weight, 0.180 grammes of carbonic acid."
                                            },
                                            {
                                                "example_id": "c6fd7f33-c292-4272-9556-ae5f95435d93",
                                                "sense_id": "b9f25342-7fbd-3c3f-b228-752fa32012aa",
                                                "text": "Hitherto, in consequence of its slight solubility, caffeine has been administered hypodermically only in very small doses ; in fact, at the ordinary temperature, it requires 93 parts of water to dissolve, so that a cubic centimeter would contain scarcely more than a centigram."
                                            },
                                            {
                                                "example_id": "9c8ea110-e70d-4545-991b-93dc58c50c0e",
                                                "sense_id": "b9f25342-7fbd-3c3f-b228-752fa32012aa",
                                                "text": "The US Food and Drug Administration defines this limit as anything more than 400 milligrams of caffeine daily for healthy adults. This is equivalent to four or five cups of coffee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
