                "senses": [
                    {
                        "sense_id": "dc04d70a-5cb9-3268-b23a-f88fdca8715b",
                        "entry_id": "243c8971-1ef1-314b-a652-96351b81b9bf",
                        "glosses": [
                            "Flugzeug, das dafür verwendet wird, Bomben zu einem Zielort zu bringen; ein Ziel mit Bomben anzugreifen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f559cc5-88ad-43e6-884d-da4942d28ccf",
                                "sense_id": "dc04d70a-5cb9-3268-b23a-f88fdca8715b",
                                "text": "„Fechteler möchte schnelle Bombenflugzeuge von Flugzeugträgern aus einsetzen.“"
                            },
                            {
                                "example_id": "2cf90df2-4cbe-4388-ac93-8b4f2847104c",
                                "sense_id": "dc04d70a-5cb9-3268-b23a-f88fdca8715b",
                                "text": "„Zum 75. Jahrestag des deutschen Luftangriffs auf Rotterdam im Mai 1940 restaurierte das Militärhistorische Museum der Bundeswehr ein Bombenflugzeug, dessen Vorläufer daran beteiligt waren.“"
                            }
                        ],
