                    ]
                },
                {
                    "sense_id": "ebdc4230-7104-3685-a5d6-2f888e6da703",
                    "sense_definition": "Bienveillance excessive qui pousse à une trop grande naïveté ou crédulité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa trop grande <w>bonté</w> l'a souvent conduit à se faire abuser."
                        },
                        {
                            "text": "Certains ont profité de sa <w>bonté</w> pour lui soutirer de l'argent."
