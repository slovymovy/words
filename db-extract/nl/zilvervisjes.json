                            {
                                "example_id": "64507f77-2341-4f9d-b19e-2795e4b2c284",
                                "sense_id": "6834ad51-49b7-32e2-ad94-5c2761a9bc36",
                                "text": "Ovenvisjes en zilvervisjes zijn familie van elkaar; het zijn grijze of bruingrijze beestjes van ongeveer 10 mm lang. Zilvervisjes wonen op vochtige plaatsen (keuken, badkamer, achter plinten) en zijn nauwelijks schadelijk. Ovenvisjes zijn wel schadelijk, ze knabbelen aan je behang, kleding en boeken. Goed ventileren en vochtproblemen aanpakken helpt. Je kunt ze vangen met een lijmval."
                            }
                        ]
                    },
                    {
                        "sense_id": "50227bd5-31b4-3ca4-a63b-2f9475cc92aa",
                        "entry_id": "d76f5a08-7fef-3235-8b95-a15fa15fc01a",
                        "glosses": [
                            "orde Zygentoma"
                        ],
                        "tags": [
