                        "entry_id": "698b9e4a-6b5f-30a7-aed9-6b5a9d725ff0",
                        "glosses": [
                            "Fasciste."
                        ],
                        "tags": [
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "92269b94-e7ef-47ca-9161-81e42da54cec",
                                "sense_id": "3c24c5f5-f015-3de3-ab6f-6f63ba95d5aa",
                                "text": "la Phalange espagnole, un parti fascisant et nationaliste."
                            },
                            {
                                "example_id": "cdac7c63-f793-490f-bfc8-df996f6ce998",
                                "sense_id": "3c24c5f5-f015-3de3-ab6f-6f63ba95d5aa",
                                "text": "le Front national, un parti politique suisse fascisant de l'entre-deux guerres glorifiait l'idéologie nazie et reçut des fonds du service de la propagande allemande."
                            },
                            {
                                "example_id": "33ed1a71-20fd-4d60-8a5b-3d8151af3bdd",
                                "sense_id": "3c24c5f5-f015-3de3-ab6f-6f63ba95d5aa",
                                "text": "Dans ce film ultraviolent de Paul Verhoeven, une organisation franchement fascisante et militaire de la société répond à la menace d’une invasion de la Terre par une race d’extraterrestres insectoïdes appelés les « Parasites »."
                            }
                        ]
                    }
