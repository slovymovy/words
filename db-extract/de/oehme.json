                ],
                "senses": [
                    {
                        "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                        "entry_id": "9ceb0b96-b21e-3646-ae72-f10a8dd3a12b",
                        "glosses": [
                            "niederdeutscher Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3cd3075-4316-4d06-9347-a3900f053fc2",
                                "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                                "text": "Frau Oehme ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2a67febd-d673-4ee8-8122-57e285cf8f7a",
                                "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                                "text": "Herr Oehme wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "caaf71b9-4d5c-4a0d-9feb-67c241dc69bb",
                                "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                                "text": "Die Oehmes kommen heute aus dem Zittauer Gebirge."
                            },
                            {
                                "example_id": "b08026e8-3d4a-453a-8c5d-bbbc6edca3b9",
                                "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                                "text": "Der Oehme trägt nie die Schals, die die Oehme ihm strickt."
                            },
                            {
                                "example_id": "fc1f81b7-cbcf-4cf6-9849-dec3f8c6286d",
                                "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Oehme kommt, geht der Herr Oehme.“"
                            },
                            {
                                "example_id": "481fa40b-390c-40a8-a2b4-7167bad04bb2",
                                "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                                "text": "Oehme kommt und geht."
                            },
                            {
                                "example_id": "dc46ff41-0a86-458a-8c24-d15106559e34",
                                "sense_id": "e4f7bc73-63f7-3a18-aea5-d1dc9e68af1e",
                                "text": "Oehmes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
