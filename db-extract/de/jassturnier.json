                "senses": [
                    {
                        "sense_id": "77e043b1-badb-3bc1-810c-8061a2756342",
                        "entry_id": "7af837da-766c-3e8a-991c-c5c8e2dc8244",
                        "glosses": [
                            "Turnier, bei dem Jass gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b5f3f8-1cdd-4356-91fd-d6af65b85fe6",
                                "sense_id": "77e043b1-badb-3bc1-810c-8061a2756342",
                                "text": "„Am vierten Jassturnier des Gemeinderats hat die SP am Samstag fast die Hälfte der 36 Teilnehmenden gestellt – und den Sprung aufs Podest trotzdem verpasst.“"
                            },
                            {
                                "example_id": "a906dd2f-d6b9-4628-b5ac-9148a67fb15b",
                                "sense_id": "77e043b1-badb-3bc1-810c-8061a2756342",
                                "text": "„Zum 30. Mal wird unter dem Motto «Mitmache isch Trumpf» das grösste Jassturnier in der Region ausgetragen.“"
                            },
                            {
                                "example_id": "d9ccfa8a-7ae1-44c9-9713-2fbaf7700877",
                                "sense_id": "77e043b1-badb-3bc1-810c-8061a2756342",
                                "text": "„Zum ersten Mal findet unser grosses Jassturnier grenzüberschreitend statt: Ab dem 8. September wird an sechs Standorten in den Kantonen Aargau, Solothurn, Basel-Stadt und Basel-Land der Jasskönig Nordwestschweiz 2022 erkoren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
