                                                "example_id": "c5ff36ba-fad4-4744-b1a7-cbe7c32c3a97",
                                                "sense_id": "3442e2ee-c8a6-3c6b-b3cc-b9315e237e6d",
                                                "text": "What a nuisance to have to go now!"
                                            },
