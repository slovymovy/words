                "senses": [
                    {
                        "sense_id": "1176db6d-c562-3e7b-85c1-d85cd9e44b2a",
                        "entry_id": "c39a2eb4-9511-354d-9b57-03061677cd98",
                        "glosses": [
                            "vrouw die ongehoorzaam is aan Gods geboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8ec8b5-180f-4ffa-b8ae-8ccb5dbb5416",
                                "sense_id": "1176db6d-c562-3e7b-85c1-d85cd9e44b2a",
                                "text": "De anonieme zondares die Jezus’ voeten zalfde uit Lucas 7 is niet Maria Magdalena, zoals vaak gesteld wordt (gelukkig niet in deze film). Het volgende hoofdstuk vermeldt immers haar naam. Bovendien is last hebben van demonen niet hetzelfde als een zondares zijn."
                            },
                            {
                                "example_id": "cdbfef78-fc8b-46de-9a55-f6a6e1813668",
                                "sense_id": "1176db6d-c562-3e7b-85c1-d85cd9e44b2a",
                                "text": "Edith Piaf was ten slotte zo’n icoon van het Franse chanson geworden, dat zelfs de katholieke kerk haar niet durfde te negeren. Toen ze stierf, was de aartsbisschop van Parijs niet bereid deze zondares een mis te bezorgen. Niet voor niets had de Vaticaankrant l’Osservatore Romano bij haar dood geschreven dat ze ‘een openbaar leven in zonde’ had geleid."
                            }
                        ]
                    }
