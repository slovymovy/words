                "senses": [
                    {
                        "sense_id": "e99dd752-1bdc-3779-88b7-32780d270bf9",
                        "entry_id": "f03e1d02-a373-314d-ad83-abb91433e837",
                        "glosses": [
                            "Programme qui interprète un code source, par opposition au compilateur."
                        ],
                        "tags": [],
