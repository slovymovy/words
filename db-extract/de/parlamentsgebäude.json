                "senses": [
                    {
                        "sense_id": "1755e61e-d1fc-319d-987d-c5c3f521ded1",
                        "entry_id": "ddcb1941-7f18-3a74-aeb3-aa8ae160ab05",
                        "glosses": [
                            "Gebäude, in dem ein Parlament tagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ab6ae29-54f9-45a8-8620-bea56d1e29c1",
                                "sense_id": "1755e61e-d1fc-319d-987d-c5c3f521ded1",
                                "text": "Das Dach des Parlamentsgebäudes wurde erneuert."
                            },
                            {
                                "example_id": "93dd856e-d9f5-4eaf-ad50-55f007834dee",
                                "sense_id": "1755e61e-d1fc-319d-987d-c5c3f521ded1",
                                "text": "„Im Parlamentsgebäude berieten gerade Friedrich Ebert, Philipp Scheidemann und andere Sozialdemokraten das weitere Vorgehen nach dem Thronverzicht des Kaisers.“"
                            },
                            {
                                "example_id": "7198e144-5d7f-4f4e-a959-16d2ebbb752a",
                                "sense_id": "1755e61e-d1fc-319d-987d-c5c3f521ded1",
                                "text": "„Von ihrem Eckbüro im achten Stock des Parlamentsgebäudes blickt sie den Interessenverbänden fast in die Büros.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
