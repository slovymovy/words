                    {
                        "translation_id": "e83ea945-57ca-4ad6-8ea1-66f81df65ace",
                        "source_entry_id": "a56f169f-efaf-31f5-8d36-726caeec702b",
                        "source_sense_description": "ointment that one rubs on the skin",
