                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c60778-c471-49e5-b44b-036513e175a3",
                                "sense_id": "561212a9-67c6-331b-9b02-3fe7c436e05b",
                                "text": "\"We all of us like the caressable, but we most of us in the long run prefer the woman to the statue… That is the trouble with the caressable in art. The caressable is always a substitutue.\""
                            },
                            {
                                "example_id": "9effa54c-0f25-45b7-ba2e-c98f82fd8b1b",
                                "sense_id": "561212a9-67c6-331b-9b02-3fe7c436e05b",
                                "text": "\"In painting he does not rely upon the likeness to a beloved grandmother or to a caressable mistress.\""
                            },
                            {
                                "example_id": "46fbe7dd-b6eb-4fb2-afac-a07ce34e54a7",
                                "sense_id": "561212a9-67c6-331b-9b02-3fe7c436e05b",
                                "text": "\"The little dog could always be caught there, in a caressable state of exhaustion or meditation, for, sooner or later, he returned to the spot from every bit of work or play.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
