                    {
                        "translation_id": "1227f823-27d3-46f2-bb2e-4e0361b70696",
                        "source_entry_id": "cabb26ee-00bb-3c20-af2a-9707aa590e43",
                        "source_sense_id": "c14cdbaf-021b-3095-b22e-0f0b168d17af",
