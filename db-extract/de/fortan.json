                                        "examples": [
                                            {
                                                "example_id": "7917534c-ed0c-4eb7-9076-9c53ca6659c3",
                                                "sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                                                "text": "Wie tussen Nederland en de Verenigde Staten vliegt, kan voortaan in beide landen automatisch door de paspoortcontrole."
                                            },
                                            {
                                                "example_id": "8400ed12-64d3-45a4-b28d-518cc2b8fbeb",
                                                "sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                                                "text": "Het is veelzeggend dat Vincenzo Nibali, zonder twijfel behorend tot de laatste categorie, pas hierna bepaalt of hij vol voor het geel in Parijs gaat of dat hij voortaan mikt op ritwinst."
                                            },
                                            {
                                                "example_id": "37fd8399-c929-4f79-ae10-2c266802052d",
                                                "sense_id": "c0ab0bc4-efba-3dec-864b-a39ca1ab7615",
                                                "text": "Met mijn kleine Swiss Army schaartje knipte ik het zo kort als ik kon, in de hoop dat ik het voortaan minder heet zou hebben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55f025d8-23ef-4679-9ff8-c7421e19185c",
                        "source_entry_id": "a6a873ab-9e8f-3b30-b1b5-371948d8d468",
                        "source_sense_id": "aa61b82a-07e9-3cf6-b8c1-d5705400a670",
                        "source_sense_description": "gehoben: ab jetzt, von jetzt an, ab sofort, in Zukunft",
                        "target_lang_word": "отныне",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отныне",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                        "entry_id": "4034c8e5-de5c-34a7-9ece-2f2cae5a45cf",
                                        "glosses": [
                                            "с этого времени, начиная с этого момента"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93184875-a598-4f00-b28c-ed2cfcdea924",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "И сказал Симону Иисус: не бойся; отныне будешь ловить человеков."
                                            },
                                            {
                                                "example_id": "7ce1c24e-ed47-4874-9060-987567a7dff1",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Все чувствовали, что тяжесть спала с сердец и что отныне ничего другого не остается, как благоденствовать."
                                            },
                                            {
                                                "example_id": "c4340037-8d3a-4d68-93af-2741ecc3a712",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Между прочим, она объявила, что готова основать свой журнал и посвятить ему отныне всю свою жизнь."
                                            },
                                            {
                                                "example_id": "8a440679-455c-4530-940f-3993877bb0ea",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Собери всех своих самых лучших людей, у которых ты знаешь самую крепкую веру, и явитесь там рано утром отныне на третий день."
                                            },
                                            {
                                                "example_id": "a4273400-65eb-404d-959f-c4f000f91d8d",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Главная перемена состоит в том, что высшее образование отныне доступно в сущности всем и каждому, способному его вместить."
                                            },
                                            {
                                                "example_id": "3368ca81-aa49-44a5-bce5-772c1dc84d3b",
                                                "sense_id": "289ff144-407e-3378-aa81-137f2c846432",
                                                "text": "Отныне загадочная функция гипофиза — мозгового придатка — разъяснена."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83748b0f-4956-49d7-9ff4-693116a364c8",
                        "source_entry_id": "a6a873ab-9e8f-3b30-b1b5-371948d8d468",
                        "source_sense_id": "aa61b82a-07e9-3cf6-b8c1-d5705400a670",
