                                        "sense_id": "56f1232e-5249-3cdf-85c9-355099a8fb2f",
                                        "entry_id": "7e4449b6-299d-3aa0-a473-02e11ea5cfef",
                                        "glosses": [
                                            "Going from one place or position to another and back again."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2cf612-9fa8-410e-a287-b1894a8330f4",
                                                "sense_id": "56f1232e-5249-3cdf-85c9-355099a8fb2f",
                                                "text": "The back and forth movement of the tide causes erosion of the coastline."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "back and forth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a834949-985d-355f-9f43-3e5154e066bb",
                                        "entry_id": "c89d1c96-c106-3295-8a31-f97fcb7c3c2a",
                                        "glosses": [
                                            "The movement (of someone or something) forward followed by a return to the same position. May refer to a concept such as an emotional state or a relationship as well as a physical thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a8af44c-0fea-452f-8c90-00dfa35804c7",
                                                "sense_id": "8a834949-985d-355f-9f43-3e5154e066bb",
                                                "text": "Roll the ball to your child, who then rolls it back to you. After a few back-and-forths, roll the ball to a nearby corner of the room or other hiding place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bae746b-ef9c-3127-bbca-dba752da7790",
                                        "entry_id": "c89d1c96-c106-3295-8a31-f97fcb7c3c2a",
                                        "glosses": [
                                            "Negotiations or discussions (not necessarily fruitful) between two or more parties; a dialog."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a9a1e2a-ef57-4e49-b118-1f2a262a336f",
                                                "sense_id": "5bae746b-ef9c-3127-bbca-dba752da7790",
                                                "text": "There's some back and forth between Simpson and his CIA counterparts and, in essence, the CIA says that you must ship all of the quantities requested."
                                            },
                                            {
                                                "example_id": "16ffbbda-d1d2-44c6-a198-e1775a90e3ab",
                                                "sense_id": "5bae746b-ef9c-3127-bbca-dba752da7790",
                                                "text": "It was months and months of back and forth, ah-ah, ah-ah\nYou're still all over me like a wine-stained dress I can't wear anymore"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96f76030-4c61-474b-80b5-80d2e0776b7a",
                        "source_entry_id": "fa2d5872-5f95-3820-a225-49cfbbe8625f",
                        "target_lang_word": "hin und her",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hin und her",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acc9d62d-e80d-30b8-b7d4-0926a4481343",
                                        "entry_id": "eda2a7d5-8f73-37a6-97aa-d92a4bf73750",
                                        "glosses": [
                                            "ständig ungezielt die Richtung wechselnd, dorthin und hierher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c52b5e9f-71ba-4b60-9d2d-5313825aa050",
                                                "sense_id": "acc9d62d-e80d-30b8-b7d4-0926a4481343",
                                                "text": "„Er winkelte die Arme an, streckte die Hände aus, als hielte er eine Docke Strickwolle darauf, und begann, seinen Oberkörper hin und her zu wiegen.“"
                                            },
                                            {
                                                "example_id": "43472164-7033-4996-a380-5f5751e8968b",
                                                "sense_id": "acc9d62d-e80d-30b8-b7d4-0926a4481343",
                                                "text": "„Meine Mutter, ein vierzehnjähriges Kind, stand in ihrem knöchellangen weißen Hemd auf den Dielen und wand sich ihr Haar ums Handgelenk und sah hin und her zwischen Papenbrock, ihrer Schwester Hilde und den Arbeitern, die sie auf Platt ausfragten.“"
                                            },
                                            {
                                                "example_id": "2de6912d-61dd-4009-9424-afd4391fcfbb",
                                                "sense_id": "acc9d62d-e80d-30b8-b7d4-0926a4481343",
                                                "text": "„Wir Kinder wieseln zwischen den Fronten hin und her, schnappen dort ein Wort Sorbisch und dort ein Wort Amerikanisch auf und weben es in unser Bossdomer Kauderwelsch und sprechen eine Sprache, die es nur einmal auf der Welt gibt.“"
                                            },
                                            {
                                                "example_id": "f14d4648-bb21-4449-b164-3a92847104e5",
                                                "sense_id": "acc9d62d-e80d-30b8-b7d4-0926a4481343",
                                                "text": "„Kerstins Beschreibung, wo die Party sein sollte, war wie immer sehr konfus, und sie liefen planlos hin und her, eine picknickende und tanzende Menschengruppe suchend.“"
                                            },
                                            {
                                                "example_id": "d30425db-ef21-47e9-8049-fb9bc232c2d8",
                                                "sense_id": "acc9d62d-e80d-30b8-b7d4-0926a4481343",
                                                "text": "„Er tigerte auf der frisch asphaltierten Straße hin und her, während das Insektensummen des Waldes lauter wurde.“"
                                            },
                                            {
                                                "example_id": "056ab30e-e56c-4520-b5b7-0f0fca2a12ab",
                                                "sense_id": "acc9d62d-e80d-30b8-b7d4-0926a4481343",
                                                "text": "„Die Tide ist anfangs gnädig mit uns. Der Hub beträgt zuerst keine drei Meter. Die Tide geht bekanntlich nach dem Mond. Im Laufe unseres Aufenthaltes wächst der Hub auf über 6 Meter, so dass halbtäglich schon eine Menge Wasser hin und her fließt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e188db8-8989-3397-a4d6-222f6912b32f",
                                        "entry_id": "eda2a7d5-8f73-37a6-97aa-d92a4bf73750",
                                        "glosses": [
                                            "alle Eventualitäten, Möglichkeiten berücksichtigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e23ab86-78c2-4b09-a675-a951bf7db57c",
                                                "sense_id": "3e188db8-8989-3397-a4d6-222f6912b32f",
                                                "text": "„Sie überlegten hin und her, wägten jeden Vorschlag, erkundeten in Gedanken eine Möglichkeit nach der anderen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
