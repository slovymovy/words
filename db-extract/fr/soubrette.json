        "fr-extract.jsonl": [
            {
                "entry_id": "beb4b91d-3c26-33d6-a4f7-56d3a42fcbcf",
                "word": "soubrette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9133ac89-7458-4df5-99a3-8e34b9650f9c",
                        "entry_id": "beb4b91d-3c26-33d6-a4f7-56d3a42fcbcf",
                        "tags": [
                            "plural"
                        ],
                        "form": "soubrettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e63b85f8-6184-3c23-b323-0fc1153fd27c",
                        "entry_id": "beb4b91d-3c26-33d6-a4f7-56d3a42fcbcf",
                        "glosses": [
                            "Nom que l’on donne, au théâtre, aux servantes ou suivantes de comédie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab21532a-87a1-426b-8491-6b8bf3292434",
                                "sense_id": "e63b85f8-6184-3c23-b323-0fc1153fd27c",
                                "text": "Rôle, emploi de soubrette, jouer les soubrettes, une soubrette de Molière."
                            },
                            {
                                "example_id": "803f0c9b-e26f-42c4-b14f-c933302928bb",
                                "sense_id": "e63b85f8-6184-3c23-b323-0fc1153fd27c",
                                "text": "D’escale en escale, le pont se peuplait : il y montait des mères de famille allemandes, suivies de deux ou trois fillettes et d’une Gretchen naïve, n’ayant pas l’air dame de la femme de chambre anglaise, encore moins l’air soubrette de la femme de chambre française, mais rappelant le type de Marguerite dans les illustrations de Reschz."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e5536d6-d988-3a30-aef2-5b74b7fb271a",
                        "entry_id": "beb4b91d-3c26-33d6-a4f7-56d3a42fcbcf",
                        "glosses": [
                            "ou Servante ou jeune femme de chambre accorte ou avenante et délurée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "03cb501d-d565-4ff1-bf50-963fdba948af",
                                "sense_id": "8e5536d6-d988-3a30-aef2-5b74b7fb271a",
                                "text": "Absorbé par le désir de plaire à la grande dame, il avait dédaigné la soubrette : qui chasse l'aigle ne s'inquiète pas du passereau."
                            },
                            {
                                "example_id": "c5674fa2-c373-4d67-95e6-e6d796f3ef47",
                                "sense_id": "8e5536d6-d988-3a30-aef2-5b74b7fb271a",
                                "text": "Elle sonne. Une servante ouvre. Bien jolie et délurée, la soubrette !"
                            },
                            {
                                "example_id": "9782898b-3882-4da2-b83a-fdb0e94b1be0",
                                "sense_id": "8e5536d6-d988-3a30-aef2-5b74b7fb271a",
                                "text": "Il suivit les deux filles à qui une soubrette venait d'ouvrir."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4c2cd27-a25c-3d80-b728-d53a69b141d6",
                        "entry_id": "beb4b91d-3c26-33d6-a4f7-56d3a42fcbcf",
                        "glosses": [
                            "Personne (sans distinction de genre) à la tenue de servante volontairement affriolante dans les milieux BDSM et fétichistes."
                        ],
                        "tags": [
                            "BDSM"
                        ],
                        "examples": [
                            {
                                "example_id": "19f95baa-2d06-4aef-979a-e9e7ef027a45",
                                "sense_id": "d4c2cd27-a25c-3d80-b728-d53a69b141d6",
                                "text": "Une jeune soubrette dont l'image aguichante s'associa perversement, dans mon esprit, à celle d'une aimable fille d’amour, emplit les verres, déposa sur le guéridon deux cendriers, […]."
                            },
                            {
                                "example_id": "10d058cc-e262-4d85-8142-3ddc3e94c98f",
                                "sense_id": "d4c2cd27-a25c-3d80-b728-d53a69b141d6",
                                "text": "— Oui, et en tenue ! Nue avec un charment tablier blanc de soubrette !!! Des talons aiguille et une petite coiffe brodée sur ta chevelure !\n— Ça ne me fait pas rire !\n— Mais ce n'est pas une plaisanterie ! Je suis sérieuse ! … Seulement j'imagine la tête de mes amis quand ils viendront ici boire un pot avec toi en soubrette sexuelle pour apporter les verres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aae0bc0f-b569-42f2-914a-42c4e2c6f705",
                        "source_entry_id": "beb4b91d-3c26-33d6-a4f7-56d3a42fcbcf",
                        "source_sense_id": "e63b85f8-6184-3c23-b323-0fc1153fd27c",
                        "source_sense_description": "Au théâtre, servante ou suivante de comédie",
                        "target_lang_word": "Zofe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zofe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                        "entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                                        "glosses": [
                                            "Bedienstete einer vornehmen, höhergestellten Dame, Herrin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7343627a-6b15-4c18-b2f1-3f92c45a206e",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Eine Zofe, ebenfalls im historischen Kostüm, bringt frisch geräucherte Forellen.“"
                                            },
                                            {
                                                "example_id": "7c958ba5-1cfb-4940-85a2-ffc4981b10fb",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Natürlich hatte die Gräfin außer dem Butler noch anderes Personal: Zimmermädchen, Koch, Köchin, Gärtner, Zofe, Chauffeur.“"
                                            },
                                            {
                                                "example_id": "c058ca1e-aaab-4ead-b105-544be056e8f4",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Bald darauf bemerkte er, wie die kleine Zofe Lenzfreude in der Dunkelheit die Mauer erkletterte und scheinbar die Katze rief.“"
                                            },
                                            {
                                                "example_id": "5827404a-edd4-42fe-b9f8-70ebbee8a41a",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Die kleine Fürstin erhob sich aus ihrem Lehnstuhl, läutete nach der Zofe und begann flink und vergnügt einen Plan für die Toilette der Prinzessin Marja zu entwerfen und auszuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78ecf2f2-e26a-4d07-9e17-36913506d778",
                        "source_entry_id": "beb4b91d-3c26-33d6-a4f7-56d3a42fcbcf",
                        "source_sense_id": "e63b85f8-6184-3c23-b323-0fc1153fd27c",
