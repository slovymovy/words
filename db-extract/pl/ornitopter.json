                                "target_senses": [
                                    {
                                        "sense_id": "9e90ef11-c70b-36fa-ad8f-b508574ed2c8",
                                        "entry_id": "a20436de-38ea-3a33-a265-3503a62a1aab",
                                        "glosses": [
                                            "Aéroplane dont la sustentation est assurée par des battements d’ailes suivant le principe du vol des oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a31f272-4ef9-4433-b897-866f6d96ffa9",
                                                "sense_id": "9e90ef11-c70b-36fa-ad8f-b508574ed2c8",
                                                "text": "Deuxièmement, les inventeurs croient que l’ornithoptère permettra l’essor sur place."
                                            },
                                            {
                                                "example_id": "58f2e456-03d8-4dc7-9a9e-872dfbd4817e",
                                                "sense_id": "9e90ef11-c70b-36fa-ad8f-b508574ed2c8",
                                                "text": "Et lorsque d’autre part, il poursuivait avec autant de persévérance que d’ingéniosité ses études sur le vol des oiseaux, c’était dans le but d’en appliquer le délicat mécanisme à un ornithoptère qui le reproduirait aussi exactement que possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ead760b-023b-3dd7-babd-8bd468dd075c",
                                        "entry_id": "a20436de-38ea-3a33-a265-3503a62a1aab",
                                        "glosses": [
                                            "Genre de grand papillon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
