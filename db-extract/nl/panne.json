                "translations": [
                    {
                        "translation_id": "ad442598-2a0e-468a-8cb5-b3f7bb95d2d4",
                        "source_entry_id": "4b5f71b3-6ed3-312d-85f4-9db64dff1d81",
                        "source_sense_id": "467191b3-9051-3e63-ac15-92d42fbc8e16",
                        "target_lang_word": "breakdown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breakdown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00af0104-7fbc-336c-ae1c-304c7cc3642a",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "A failure, particularly one which is mechanical in nature."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1957406-357f-44e8-a9f5-0f0f13b779c7",
                                                "sense_id": "00af0104-7fbc-336c-ae1c-304c7cc3642a",
                                                "text": "Whenever he was behind the wheel, he would panic at the first sign of a breakdown."
                                            },
                                            {
                                                "example_id": "16a551eb-f838-454e-9e31-01e680f67bab",
                                                "sense_id": "00af0104-7fbc-336c-ae1c-304c7cc3642a",
                                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a693c8-ac5a-39ea-adbb-908c9bb51442",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "A failure, particularly one which is mechanical in nature.",
                                            "The sudden (and usually damaging) transition of an electrical insulator to a conductor when subjected to a sufficiently strong voltage, caused by the partial or complete ionization of the insulator; (countable) an instance of this; also, the minimum voltage at which this occurs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1de6fb1-92b4-397b-93b6-f9c56a62f1bf",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "Something, such as a vehicle, that has experienced a mechanical failure."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9518f477-c0b6-4709-96d7-cf7d96b21a89",
                                                "sense_id": "a1de6fb1-92b4-397b-93b6-f9c56a62f1bf",
                                                "text": "We saw a breakdown by the side of the road."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fbbc250-1732-30de-8302-c1af9700fb2c",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "Separation of a thing into components; decomposition, fragmentation; (countable) an instance of this.",
                                            "Detailed categorization, or itemization or listing, of the components of a thing; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97988ac9-4d6c-4be1-a969-529fac9641a2",
                                                "sense_id": "7fbbc250-1732-30de-8302-c1af9700fb2c",
                                                "text": "Looking at the breakdown of the budget, I see a few items we could cut."
                                            },
                                            {
                                                "example_id": "7e4db8b9-6d59-41a0-aacb-8e673ddc63c8",
                                                "sense_id": "7fbbc250-1732-30de-8302-c1af9700fb2c",
                                                "text": "The railways' monopoly had meant that accountancy and record-keeping had been limited to global accounts. In other words, there were only really headline numbers, with little useful breakdown by routes or traffic type."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db399bc-f3a5-37f9-8de8-2246bcee39fe",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "Separation of a thing into components; decomposition, fragmentation; (countable) an instance of this.",
                                            "Breaking of chemical bonds within a compound to produce simpler compounds or elements; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0558c802-fadf-354b-bb27-4a8607e895b1",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "Separation of a thing into components; decomposition, fragmentation; (countable) an instance of this.",
                                            "A detailed description of a forthcoming project or screenplay which identifies all the required elements, such as the cast, costumes, equipment, props, and special effects."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "717cd497-a8e8-35a6-a5b7-9fed9684ddab",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "A failure in a relationship; a failure or loss of organization in a system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759593f1-7ecf-45e2-a92c-9543e0a4a1b4",
                                                "sense_id": "717cd497-a8e8-35a6-a5b7-9fed9684ddab",
                                                "text": "I am quite competent to answer all / Demands, in any such capacity— / But of the break-down of my general aims: […]"
                                            },
                                            {
                                                "example_id": "e3cb83f1-9453-4269-adcf-bec30a90cdd1",
                                                "sense_id": "717cd497-a8e8-35a6-a5b7-9fed9684ddab",
                                                "text": "What else than Feudalism could have followed upon the breakdown of that great centralized governmental machine known as the Roman Empire?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dce9cefe-0145-3030-addc-fb65cbe666f0",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "(Sudden) worsening of physical health or (more commonly) mental stability, resulting in an inability to carry on normal activities; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30106a2-4190-4dcc-92d4-0b7ca6a9ade6",
                                                "sense_id": "dce9cefe-0145-3030-addc-fb65cbe666f0",
                                                "text": "After so much stress, he suffered a breakdown and simply gave up."
                                            },
                                            {
                                                "example_id": "4034e7b8-f069-415b-8db9-efc44375977e",
                                                "sense_id": "dce9cefe-0145-3030-addc-fb65cbe666f0",
                                                "text": "[H]e was led away to a private sanitarium for mental disease, while in the newspapers appeared pathetic accounts of his mental breakdown and of the saintliness of his character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "642fcdfd-38b2-3501-8328-aaaabcda0106",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "Injury to a horse's leg causing lameness; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "537cace4-66d1-35f7-9f75-2ec4e78ad1b3",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "The short period of open play immediately after a tackle and before and during the ensuing ruck."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2c80c82-d9d6-4344-954b-6f835c489b2b",
                                                "sense_id": "537cace4-66d1-35f7-9f75-2ec4e78ad1b3",
                                                "text": "England beat Georgia in their Pool B World Cup match in Dunedin but the stuttering nature of the performance will be of concern to manager Martin Johnson. Georgia, ranked 16th in the world, dominated the breakdown before half-time and forced England into a host of infringements, but fly-half Merab Kvirikashvili missed three penalties."
                                            },
                                            {
                                                "example_id": "ba8d0179-8189-44eb-aabb-5111c1feb1a0",
                                                "sense_id": "537cace4-66d1-35f7-9f75-2ec4e78ad1b3",
                                                "text": "When players appeal to the referee, as they so often do, for penalties at breakdowns when the supposed offender is being deliberately pinned down by their own teammates, they should understand they do their sport a small but significant disservice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e158c50-902e-37d1-9a93-a325a93212d5",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "An act of splitting logs of wood using a large saw in a sawmill; also, the saw used; or (rare) the building in which the process is carried out."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4ee3989-3f4a-3278-afc0-85c884ccfc60",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "A part of a piece of music or a song which differs from the other parts in that it features improvisation or is stripped down (for example, played by fewer instruments or a solo performer)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e26ce7-708c-4fe5-afe7-5de5e09934a2",
                                                "sense_id": "e4ee3989-3f4a-3278-afc0-85c884ccfc60",
                                                "text": "And now it's time for a breakdown."
                                            },
                                            {
                                                "example_id": "72d46d94-6445-4af3-a12f-bd75625e08f3",
                                                "sense_id": "e4ee3989-3f4a-3278-afc0-85c884ccfc60",
                                                "text": "Izzy [Stradlin] lays down some big chords while Slash plays the song's banjo breakdown of a theme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6bde67f-c9ad-3938-89fb-c7d2e4b857c5",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "Synonym of percussion break (“a percussion-focused segment of a song, chosen by a hip-hop DJ to manipulate through cutting, mixing, and other techniques in order to create rhythmic music”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "667d7e61-60de-3620-ae27-eb835b259b94",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "A section of a song, typical in hardcore music and related styles (such as metalcore, grindcore, and deathcore), characterized by a lower tempo and greater heaviness and intensity of sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e4cbc6-eb0f-4777-b92e-44fa8d444078",
                                                "sense_id": "667d7e61-60de-3620-ae27-eb835b259b94",
                                                "text": "The fired-up foursome [Trial] takes itself very seriously, singing politically charged lyrics, which, in the tradition of Strife and Damnation AD, are strategically placed in the middle of slamming, moshable breakdowns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f529179-7f27-38cd-bb3f-e2e6e3087c2b",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "A noisy, rapid, shuffling dance engaged in competitively by a number of individuals or pairs in succession, common among African-Americans from the Southern United States; also, a lively event, chiefly in a rural setting, at which such dancing is done; a hoedown, a shindig."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac063c97-3952-4ba5-b71f-786a398f76b8",
                                                "sense_id": "3f529179-7f27-38cd-bb3f-e2e6e3087c2b",
                                                "text": "Come, hold on, boys, do n't clear out when the quadrilles are over, for we are going to have a break down to wind up with."
                                            },
                                            {
                                                "example_id": "6c83e42d-5ae2-468c-8195-033237167869",
                                                "sense_id": "3f529179-7f27-38cd-bb3f-e2e6e3087c2b",
                                                "text": "Towards nine the three miners said that as they had brought their instruments they might as well tune up, for the boys and girls would soon be arriving now, and hungry for a good old fashioned break[-]down. A fiddle, a banjo, and a clarinet—these were the instruments. The trio took their places side by side, and began to play some rattling dance-music, and beat time with their big boots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556ca247-a913-37e4-a6e8-c50f9cf1a295",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "A piece of music played for such a dance, especially a rapid bluegrass tune featuring a five-string banjo."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d7038de-50e6-47d3-8cac-c3aebdb8d235",
                                                "sense_id": "556ca247-a913-37e4-a6e8-c50f9cf1a295",
                                                "text": "Without a change of countenance, as if he were deaf to her entreaties and threats, he tuned up the banjo, and played a breakdown."
                                            },
                                            {
                                                "example_id": "70ce47eb-3e49-463c-9531-605e16872c32",
                                                "sense_id": "556ca247-a913-37e4-a6e8-c50f9cf1a295",
                                                "text": "The banjo built up to breakdown speed and then took a sidestep into another register, an oddly complex net of notes which stretched out for a time and finally stopped on a full rest."
                                            },
                                            {
                                                "example_id": "1a44d0f2-65ed-4351-97c5-f1f1d96cc3fd",
                                                "sense_id": "556ca247-a913-37e4-a6e8-c50f9cf1a295",
                                                "text": "Her mother had not only gotten knocked up and lost her man when Sunset was thirteen, she soon took up with a traveling shoe salesman who played the banjo, wandered away with him and his shoes, probably to the sound of a banjo breakdown, leaving a note that read: \"Sorry, Sunset, I got to go. Mama loves you. I left you a good pair of shoes in there on the kitchen table. They shine up easy.\""
                                            },
                                            {
                                                "example_id": "46bd0e00-6a1d-43b2-b735-558a0ef61114",
                                                "sense_id": "556ca247-a913-37e4-a6e8-c50f9cf1a295",
                                                "text": "The grown-ups were lolling around on the porch and in the yard, finger snapping and foot tapping while Samuel played \"Foggy Mountain Breakdown\" on his five-string banjo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdff1103-ad3c-301a-8e91-ed7b02494840",
                                        "entry_id": "72421e81-b4a5-3bf5-8048-bd96e1d7ac24",
                                        "glosses": [
                                            "An act of a structure or other thing breaking and collapsing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
