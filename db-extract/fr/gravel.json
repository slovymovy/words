                                        "sense_id": "b0f65d24-d65c-3bf0-898c-68f88c7ec627",
                                        "entry_id": "98d4f132-fb9e-3478-acc7-60be2807b55e",
                                        "glosses": [
                                            "A type of road bike similar to those used in cyclocross but geared toward gravel roads."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d376cd-3bd3-427e-b737-55e48394266e",
                                                "sense_id": "b0f65d24-d65c-3bf0-898c-68f88c7ec627",
                                                "text": "This is a very new category, and honestly, if you walk into a bike shop and ask for a gravel bike, you risk bewildered stares or maybe even laughter, because not everyone agrees that a gravel-specific bike is necessary."
                                            },
                                            {
                                                "example_id": "9c6d5d8d-0234-41c3-b0b2-4f4e02e7c84f",
                                                "sense_id": "b0f65d24-d65c-3bf0-898c-68f88c7ec627",
                                                "text": "It's called a gravel bike, and seems to combine the advantages of both road and mountain bikes – with a similar ability to lap up the miles on tarmac as a road bike, while still being very capable off-road."
                                            }
                                        ]
                                    }
                                ]
                            }
