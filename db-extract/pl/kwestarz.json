                "senses": [
                    {
                        "sense_id": "a4dd3806-91aa-3d68-86fb-596986ccfc12",
                        "entry_id": "5b3fad5a-5c1c-3dc4-bfec-740dd401c99c",
                        "glosses": [
                            "zakonnik prowadzący osobiście zbiórkę darów dla klasztoru"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "480f75b2-34c5-4e50-9c88-1b449e3b35d9",
                                "sense_id": "a4dd3806-91aa-3d68-86fb-596986ccfc12",
                                "text": "Przy nim stał kwestarz, sędzia tuż przy bernardynie"
                            },
                            {
                                "example_id": "3bd53470-8113-4d8d-946a-e4c5ead159c1",
                                "sense_id": "a4dd3806-91aa-3d68-86fb-596986ccfc12",
                                "text": "Brat kwestarz wrócił wieczorem z żukiem wypełnionym dyniami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "17e3266a-60a4-397a-877c-80dbe57dd022",
                        "entry_id": "5b3fad5a-5c1c-3dc4-bfec-740dd401c99c",
                        "glosses": [
                            "osoba kwestująca"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1768468a-eaff-43b1-97f3-253aacbf4be2",
                                "sense_id": "17e3266a-60a4-397a-877c-80dbe57dd022",
                                "text": "Proboszcz nic nie mógł zrobić, teren przed wejściem do kościoła opanowali kwestarze WOŚP."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
