{
    "word_family": [
        "désarmement",
        "désarmant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "caf77d72-2506-3781-843e-5436002fb79d",
                    "sense_definition": "Enlever les armes à quelqu'un ou le contraindre à s'en défaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "armes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont réussi à <w>désarmer</w> le suspect sans faire de blessés."
                        },
                        {
                            "text": "Il a fallu <w>désarmer</w> l'ennemi avant de sécuriser l'ensemble du périmètre."
                        }
                    ],
                    "antonyms": [
                        "armer"
                    ],
                    "common_phrases": [
                        "désarmer un suspect",
                        "désarmer l'ennemi"
                    ]
                },
                {
                    "sense_id": "ad42c7e5-4de0-33d7-a612-17c0d2ae42bf",
                    "sense_definition": "Apaiser l'hostilité, la colère ou la rigueur de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apaisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son sourire sincère a suffi pour <w>désarmer</w> la colère de son interlocuteur."
                        },
                        {
                            "text": "Sa grande honnêteté a totalement <w>désarmé</w> les critiques les plus sévères."
                        }
                    ],
                    "common_phrases": [
                        "désarmer la colère",
                        "désarmer la critique"
                    ]
                },
                {
                    "sense_id": "4ca8941f-21ae-3830-bd22-6de22ac72fe0",
                    "sense_definition": "Réduire ou supprimer les troupes et l'équipement militaire d'un État.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la signature du traité, le pays a accepté de <w>désarmer</w> ses troupes."
                        },
                        {
                            "text": "Les observateurs internationaux surveillent le processus pour <w>désarmer</w> les factions rebelles."
                        }
                    ],
                    "common_phrases": [
                        "désarmer une nation",
                        "accepter de désarmer"
                    ]
                },
                {
                    "sense_id": "f214060f-6d6f-3a8a-a7d3-3d4559d92240",
                    "sense_definition": "Cesser une lutte, renoncer à une hostilité ou à une revendication.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apaisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré l'absence de réponse de la direction, les manifestants ne <w>désarment</w> pas."
                        },
                        {
                            "text": "Après plusieurs mois de négociations difficiles, l'opposition a refusé de <w>désarmer</w>."
                        }
                    ],
                    "common_phrases": [
                        "ne pas désarmer"
                    ]
                },
                {
                    "sense_id": "21c0386c-abc3-35b7-8239-d8640c0aa663",
                    "sense_definition": "Dépouiller un navire de son équipement, de ses agrès ou de son équipage en prévision de son immobilisation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipage a dû <w>désarmer</w> le navire avant le début des grands froids."
                        },
                        {
                            "text": "La compagnie maritime a décidé de <w>désarmer</w> plusieurs bateaux devenus trop coûteux."
                        }
                    ],
                    "synonyms": [
                        "dégréer"
                    ],
                    "common_phrases": [
                        "désarmer un navire",
                        "désarmer un bateau"
                    ]
                },
                {
                    "sense_id": "c76a3a32-ffa7-3ab9-8ed3-1129d0d0aa8e",
                    "sense_definition": "Débarrasser quelqu'un de son armure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'écuyer s'empressa de <w>désarmer</w> le chevalier épuisé à la fin du tournoi."
                        },
                        {
                            "text": "Le guerrier refusa de se <w>désarmer</w> avant d'avoir rencontré le commandant."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Contexte historique ou médiéval"
                        }
                    ]
                }
            ]
        }
    ]
