    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78a6fd6b-a886-3be3-b884-93e2934024f1",
                    "sense_definition": "Chou blanc coupé finement et fermenté, généralement consommé cuit et accompagné de viandes ou de charcuterie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gastronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'hiver en Alsace, nous commandons souvent une <w>choucroute</w> garnie dans une brasserie traditionnelle."
                        },
                        {
                            "text": "Il prépare la <w>choucroute</w> maison avec des saucisses fumées et du vin blanc sec."
                        }
                    ],
                    "common_phrases": [
                        "choucroute garnie",
                        "choucroute alsacienne"
                    ]
                },
                {
                    "sense_id": "497900a5-db19-3e56-bf2b-5c5191cbbfc9",
                    "sense_definition": "Élément hors de propos ou incohérent, utilisé dans des expressions imagées pour souligner la confusion ou l'absence de lien logique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant était mal préparé et a commencé à pédaler dans la <w>choucroute</w> devant les examinateurs."
                        },
                        {
                            "text": "Son intervention soudaine n'avait aucun rapport avec la <w>choucroute</w> lors de cette réunion de travail."
                        }
                    ],
                    "common_phrases": [
                        "pédaler dans la choucroute",
                        "aucun rapport avec la choucroute"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "2040bea3-221d-3afa-94bc-020d9d09f7b8",
                    "sense_definition": "Coiffure volumineuse et haute constituée de cheveux abondamment crêpés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coiffure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette célèbre actrice des années soixante arborait une <w>choucroute</w> spectaculaire sur la tête."
                        },
                        {
                            "text": "Elle a passé une heure entière chez le coiffeur pour faire monter sa <w>choucroute</w> volumineuse."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "4f62d272-8085-3d5f-b8e4-9d359b274a14",
                    "sense_definition": "Mastic renforcé de fibres de verre servant à reboucher les trous ou combler les creux en carrosserie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien a rebouché la carrosserie perforée avec de la <w>choucroute</w> avant de poncer."
                        },
                        {
                            "text": "Il a étalé une épaisse couche de <w>choucroute</w> pour réparer l'aile endommagée du véhicule."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
