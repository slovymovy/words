                "senses": [
                    {
                        "sense_id": "2b911a2c-da0e-3de3-b44e-108980ce9552",
                        "entry_id": "be2b7557-d7b1-345c-85f1-806d59998081",
                        "glosses": [
                            "der Umfang materieller Bedürfnisse und des Wohlstandes einer Person oder sozialen Gruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d09c9e76-3ef9-45b4-a8c3-a37e403d8329",
                                "sense_id": "2b911a2c-da0e-3de3-b44e-108980ce9552",
                                "text": "Der Lebensstandard der Arbeitnehmer hat sich von der Wirtschaftsentwicklung weitgehend abgekoppelt."
                            },
                            {
                                "example_id": "7a48ad62-52b2-4ed5-b5f9-e96ee48e8a4f",
                                "sense_id": "2b911a2c-da0e-3de3-b44e-108980ce9552",
                                "text": "„Offenbar hilft einem ein hoher Lebensstandard nicht automatisch beim Blick über den Tellerrand.“"
                            },
                            {
                                "example_id": "dbf2e099-007f-406e-b921-43ab569ad1a6",
                                "sense_id": "2b911a2c-da0e-3de3-b44e-108980ce9552",
                                "text": "„Der Lebensstandard nimmt zu, in keiner anderen Kolonie auf dem Kontinent ist die medizinische Versorgung besser, gehen mehr Kinder in die Schule.“"
                            },
                            {
                                "example_id": "c78d228b-1637-4016-b262-f8802e66a994",
                                "sense_id": "2b911a2c-da0e-3de3-b44e-108980ce9552",
                                "text": "„Doch das Wichtigste ist meiner Meinung nach der hohe Lebensstandard der westlichen Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
