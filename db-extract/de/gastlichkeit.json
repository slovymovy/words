                                            {
                                                "example_id": "028145f9-a456-461f-94a7-c4f35b3f4d70",
                                                "sense_id": "b22622d1-819d-3c0d-ab01-94e9e1ab51dc",
                                                "text": "Kousseila participe aux marches nocturnes pour leur convivialité."
                                            },
                                            {
                                                "example_id": "35bb7266-5dea-4f44-99a2-d8d63ff659f3",
                                                "sense_id": "b22622d1-819d-3c0d-ab01-94e9e1ab51dc",
                                                "text": "Le football étant une pratique sportive qui mêle à la fois technicité et convivialité, le but d’Adidas est de jouer sur les deux tableaux, afin de promouvoir sa nouvelle offre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c14196-5a86-3f94-a93d-0020a19af233",
