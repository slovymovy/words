                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4336cb2a-018b-4d88-a590-db9b01007d71",
                                "sense_id": "a5539db3-3b0a-3ce9-ac26-cba17cae15cb",
                                "text": "Elles ne subissent pas d'altération pendant l'observation, sauf sur leur bord qui peut s'alvéoliser faiblement."
                            },
                            {
                                "example_id": "54106948-8907-4d09-87b5-6cff38353a73",
                                "sense_id": "a5539db3-3b0a-3ce9-ac26-cba17cae15cb",
                                "text": "On voit que ces masses peuvent prendre des formes allongées, massives, ou au contraire s'alvéoliser (C)."
