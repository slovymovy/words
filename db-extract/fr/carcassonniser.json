                "senses": [
                    {
                        "sense_id": "803f4b47-e597-3278-bb10-180f09c8ecd1",
                        "entry_id": "b80ab3de-1e16-32aa-bfd3-662151e66e12",
                        "glosses": [
                            "Donner un caractère carcassonnais"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11aa6ea-b5ca-47ba-8f2f-1e07b1c45986",
                                "sense_id": "803f4b47-e597-3278-bb10-180f09c8ecd1",
                                "text": "Il doit y avoir beaucoup à gagner pour que des honorables, ayant toutes les raisons de se taire irritent ainsi les électeurs qui se sont retirés d’eux, le tout pour arriver à faire présider les bureaux électoraux par des gaillards capables capables de carcassonniser le scrutin."
                            },
                            {
                                "example_id": "3d093698-58eb-470d-8a7b-9283be76c44a",
                                "sense_id": "803f4b47-e597-3278-bb10-180f09c8ecd1",
                                "text": "Abbaye toujours aussi formidable... Mais le reste infernal, touristisé, commercialisé, poulardisé, pollué, carcassonnisé, arnaqueur et de mauvais goût..."
                            }
                        ]
                    }
