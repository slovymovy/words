                            {
                                "example_id": "87dfc5e3-8b3c-4140-8ed1-2fe48eabacac",
                                "sense_id": "39535cf0-1838-3ac1-8762-4ffa1e3a2458",
                                "text": "Bei Anzeichen von Erkältungen trinke ich einen Aufguss aus Spitzwegerich."
                            },
                            {
                                "example_id": "101a75ca-ea07-4e4d-bbce-eb6a861b5c08",
                                "sense_id": "39535cf0-1838-3ac1-8762-4ffa1e3a2458",
                                "text": "Beim Aufguss von grünen Tee darf das Wasser nicht zu heiß sein."
                            }
                        ],
