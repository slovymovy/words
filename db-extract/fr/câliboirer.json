                "senses": [
                    {
                        "sense_id": "af19426b-f09d-3b5a-a4fd-042a2b0873a4",
                        "entry_id": "227735b1-19fd-3b0f-a3cd-73c6b6e55960",
                        "glosses": [
                            "Au vu des exemples, mettre, foutre avec nuance péjorative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6335295a-bbde-4d28-8e23-ac8bad3bdcbc",
                                "sense_id": "af19426b-f09d-3b5a-a4fd-042a2b0873a4",
                                "text": "Je ne sacre plus, sauf si je me câliboire un coup de marteau sur le pouce, je surveille mon langage parce qu’un agent de sécurité qui invoquerait les ustensiles d’église, ça fait grossier, m’a dit Jean-Charles dès les premiers jours."
                            },
                            {
                                "example_id": "3d11f827-c6a7-4123-8088-2d2a0a259380",
                                "sense_id": "af19426b-f09d-3b5a-a4fd-042a2b0873a4",
                                "text": "Qui c’est est venu câliboirer de l’asphate pis du béton partout?"
                            },
                            {
                                "example_id": "69ae91b9-ed90-4c61-b463-4919ca5ab0ec",
                                "sense_id": "af19426b-f09d-3b5a-a4fd-042a2b0873a4",
                                "text": "“Ah, tâ…!!!” a dit notre gars, avant de prendre ce qui restait du hayon et le câliboirer au bout de ses bras."
                            }
                        ]
                    }
