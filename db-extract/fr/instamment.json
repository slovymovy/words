        "fr-extract.jsonl": [
            {
                "entry_id": "8ce52479-c53c-32d1-a378-b2995552a500",
                "word": "instamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                        "entry_id": "8ce52479-c53c-32d1-a378-b2995552a500",
                        "glosses": [
                            "D’une manière instante ou pressante ; avec instance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9681ac54-269f-46bb-a1e3-dd785399cff7",
                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                "text": "Je demande si instamment à Dieu qu’il ne t’arrive aucun mal."
                            },
                            {
                                "example_id": "2bf18b04-5619-47e3-a79a-a021b5f9058f",
                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                "text": "Oh ! Madame, si vous êtes si instamment attendue, permettez-moi de m’éloigner, car il me serait impossible de vous parler en ce moment."
                            },
                            {
                                "example_id": "69f85a99-ddfe-45a0-aa99-e186bafb7864",
                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                "text": "Cette constatation faite, nous n'en avons pas moins à compter avec la nombreuse cohorte des névropathes vraiment insomniaques, qui souffrent de ne pas dormir, et qui prient instamment que le sommeil leur soit rendu."
                            },
                            {
                                "example_id": "487c109a-7b94-45a7-8772-21d437cd6e19",
                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                "text": "— Édith vous prie de bien vouloir descendre un instant dans sa chambre. Rien qu’un instant. Elle vous en prie instamment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98296f70-a3c8-4207-bbb4-93de70f87042",
                        "source_entry_id": "8ce52479-c53c-32d1-a378-b2995552a500",
                        "source_sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                        "target_lang_word": "eindringlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindringlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                        "entry_id": "245c86e5-8000-3e6a-aa58-0ca2d79d6ca6",
                                        "glosses": [
                                            "mit großem Ernst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322209d8-365b-4920-9a66-b9846e875e40",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "Mit eindringlichen Worten erzählte die alte Dame von der Flucht aus dem Krisengebiet."
                                            },
                                            {
                                                "example_id": "20bef733-12e3-47a7-bd65-8eef44a76589",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "Die Behörden warnen eindringlich davor Drogen unbekannter Herkunft zu konsumieren, da die Gefahr einer Vergiftung besteht."
                                            },
                                            {
                                                "example_id": "1f5f00be-ad1c-4264-891b-cebcd0741cf6",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„Im Jahr 168 v.Chr. erlosch die makedonische Monarchie. Den Schlussakt aber setzte die Zerstörung Korinths im Jahr 146 v.Chr., die parallel zur Zerstörung Karthagos stattfand und den ungehemmten Anspruch Roms auf die Weltherrschaft in Ost und West eindringlich dokumentierte.“"
                                            },
                                            {
                                                "example_id": "cf75af93-f82c-4d60-831c-5acfb5c47061",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„\"Ein Jahr voller Klimakatastrophen und eindringlichen Warnungen der besten Wissenschaftler weltweit hätten zu viel mehr führen sollen\", so Greenpeace-Chefin Jennifer Morgan.“"
                                            },
                                            {
                                                "example_id": "1b01376c-8cd7-42ff-a604-0e31de6f6a16",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„Eindringlich wies Lennart Meri auf die Gefahr der russischen Großmachtfantasien hin – und verurteilte die vorherrschende westliche Appeasement-Politik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddca5bbf-73f4-4862-9b2e-68d7af5d59ea",
                        "source_entry_id": "8ce52479-c53c-32d1-a378-b2995552a500",
                        "source_sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                        "target_lang_word": "instantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "At once; without delay."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dbbe4fe-c6f4-4d73-bb8d-203e0763abac",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "When the neighbours' dog barked, ours instantly replied with a howl."
                                            },
                                            {
                                                "example_id": "4ae2c204-4ac7-453b-a208-b8fa6f357cb0",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            },
                                            {
                                                "example_id": "9349c36a-fb4f-4761-9ef7-1856fe301210",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland. His ability to run at defences is instantly striking, but it is his clever use of possession that has persuaded some shrewd judges that he is an even better prospect than Theo Walcott."
                                            },
                                            {
                                                "example_id": "4611fc62-9406-4408-b923-401316f3da8d",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "But signalman Bridges was never to answer driver Gimbert's desperate question. A deafening, massive blast blew the wagon to shreds, the 44 high-explosive bombs exploding like simultaneous hits from the aircraft they should have been dropped from. The station was instantly reduced to bits of debris, and the line to a huge crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "Urgently; with insistence."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900f91af-61dd-45bd-9c78-ad26729c6bf4",
                                                "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                                "text": "Sir, my lord would instantly speak with you."
                                            },
                                            {
                                                "example_id": "9574b77c-f7a4-40d3-ba32-d95b887e5c23",
                                                "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                                "text": "Theoxena although she were instantly urged thereunto, could never be induced to marry againe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b35bb64-8168-3d4a-a57e-3a89f0152efe",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "At the same time."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c1356c6-5e50-4411-96be-d5838ecd66a6",
                                                "sense_id": "2b35bb64-8168-3d4a-a57e-3a89f0152efe",
                                                "text": "As if he mastred there a double spirit\nOf teaching, and of learning instantly"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "882aa7d3-72cd-3f12-b068-859e7bea983a",
                                        "entry_id": "1d3ee2f0-128a-33c6-9729-7a16cb2c5e81",
                                        "glosses": [
                                            "As soon as, directly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16a3c95-e0b6-4b96-a123-22ee09f61f59",
                                                "sense_id": "882aa7d3-72cd-3f12-b068-859e7bea983a",
                                                "text": "I phoned instantly I heard you were back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
