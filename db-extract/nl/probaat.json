                "senses": [
                    {
                        "sense_id": "0c6eda76-1fde-3026-850a-ec85dbe5b3fa",
                        "entry_id": "70bcbc7b-f6ba-3e45-999c-872ef90794f4",
                        "glosses": [
                            "probaat middel: iets waarvan proefondervindelijk is bewezen dat het goed werkt tegen een ziekte of ander probleem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4541775d-edfe-4f7d-9c64-c0d7dd539aaa",
                                "sense_id": "0c6eda76-1fde-3026-850a-ec85dbe5b3fa",
                                "text": "Geometrie speelt een belangrijke rol in het werk van de architecten Van Belle & Medina. Een balk of een kubus geeft structuur en uitstraling. Bovendien is het een probaat middel om orde te scheppen en complexe programma’s in een overzichtelijk gebouw te gieten."
                            },
                            {
                                "example_id": "40d5d3e4-a5c3-42e1-9054-976a10461475",
                                "sense_id": "0c6eda76-1fde-3026-850a-ec85dbe5b3fa",
                                "text": "Bijna de helft van de nu al 700 Enschedeërs die de vragenlijst van deze krant over de wateroverlast invulden en opstuurden hebben in hun kruipruimte of kelder een dompelpomp geïnstalleerd. Een probaat middel om te hoge waterstanden onder het huis te voorkomen."
                            }
                        ]
                    }
