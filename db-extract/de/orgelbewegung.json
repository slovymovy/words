                "senses": [
                    {
                        "sense_id": "3c25ca37-4e9c-3260-81f1-c1ce593f0b9b",
                        "entry_id": "3925c58c-f796-3c84-8422-8ca44cc199c2",
                        "glosses": [
                            "Zeitströmung von etwa 1920 bis 1980, in der eine bewusste Abkehr von der romantischen Orgel hin auf eine Wiederbelebung der norddeutschen Orgel der Barockzeit erfolgte"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "e0fc73e7-9a34-4ba0-93af-fd9bcbf3631c",
                                "sense_id": "3c25ca37-4e9c-3260-81f1-c1ce593f0b9b",
                                "text": "„Der von Wilibald Gurlitt initiierte Bau der Praetorius-Orgel in Freiburg (Walcker, 1921) war die Initialzündung der Orgelbewegung.“"
                            },
                            {
                                "example_id": "9d63d09b-861e-4a44-86f0-7a74aba86a55",
                                "sense_id": "3c25ca37-4e9c-3260-81f1-c1ce593f0b9b",
                                "text": "„Im Jahr 1968 ist die Stumm-Orgel im Zuge der sogenannten neobarocken Orgelbewegung von der renommierten Bonner Orgelbaufirma Klais restauriert worden.“"
                            },
                            {
                                "example_id": "b7e92dc6-be2f-49d3-9bb9-adfa1938f2d7",
                                "sense_id": "3c25ca37-4e9c-3260-81f1-c1ce593f0b9b",
                                "text": "\"Ihren Vorläufer hatte die Orgelbewegung in der elsässisch-neudeutschen Orgelreform des frühen 20. Jahrhunderts. Diese kritisierte die Orgelneubauten im Mitteleuropa der Gründerzeit als unkünstlerisch in der Klanggestaltung, der Konzeption und Herstellung („Fabrikorgel“), dazu mit Spielhilfen überladen.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
