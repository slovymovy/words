                                "target_senses": [
                                    {
                                        "sense_id": "59cd3e7c-b970-3fe0-8400-eafd405f9bc2",
                                        "entry_id": "87c0a19d-b028-3b2f-8b00-466a23fae07e",
                                        "glosses": [
                                            "A surgical instrument with a cylindrical blade used to remove a circular section of tissue, such as bone or cornea; a trepan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92fc463e-a665-4e95-a611-604753da0f6f",
                                                "sense_id": "59cd3e7c-b970-3fe0-8400-eafd405f9bc2",
                                                "text": "They removed a core of bone as well as took a bone marrow aspirate from my right hip using a trephine to exclude me having a blood cancer, causing a blood- and serum-stained shirt, a whopping hematoma and a great deal of mental anguish and physical pain in the process!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trephine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d151a3-c5c4-32ef-9d49-598a364c9eb6",
                                        "entry_id": "52a3415d-6b9e-3aa5-ba2f-c264f051ca3a",
                                        "glosses": [
                                            "To use a trephine during surgery."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01052db8-f2e1-49ad-8fd8-f8721ba4c80a",
                                                "sense_id": "a0d151a3-c5c4-32ef-9d49-598a364c9eb6",
                                                "text": "\"We shall wait,\" said Van Helsing, \"just long enough to fix the best spot for trephining, so that we may most quickly and perfectly remove the blood clot, for it is evident that the haemorrhage is increasing.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff09792c-9777-33bb-ad64-c07524ef9d72",
                                        "entry_id": "52a3415d-6b9e-3aa5-ba2f-c264f051ca3a",
                                        "glosses": [
                                            "To perforate with a trephine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19f0cab5-7a79-4e0d-8186-277b51093035",
                                                "sense_id": "ff09792c-9777-33bb-ad64-c07524ef9d72",
                                                "text": "The pony was cast, and trephined, a middle-sized trephine (or bone saw) being used, which removed a circular piece of bone about the size of a two shilling piece, from the face immediately over the air cavity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
