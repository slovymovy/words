                    },
                    {
                        "sense_id": "60b9d474-469f-39a0-aec9-3db6da84b380",
                        "entry_id": "0bd8d38e-19f8-31ff-8247-ac2db7644d43",
                        "glosses": [
                            "ritme vertonend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce7f356b-0abd-4dec-b6f7-05791dbaa589",
                                "sense_id": "60b9d474-469f-39a0-aec9-3db6da84b380",
                                "text": "In De andere naam van Jon Fosse is de stijl zeker eigen. De Noorse meester van het langzame proza daalt in repetitieve, ritmische zinnen af in het hoofd van een piekerende schilder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdda24ad-4a09-462b-ad3a-48ab5df44946",
                        "source_entry_id": "0bd8d38e-19f8-31ff-8247-ac2db7644d43",
                        "target_lang_word": "rhythmic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhythmic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae689ae-c192-386d-a4df-1c1e8c3307fa",
                                        "entry_id": "e01d5061-a4b4-3333-88f4-588c9a14e467",
                                        "glosses": [
                                            "Of or relating to rhythm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1767c4e8-321a-400e-b4b6-9025b9e34794",
                                                "sense_id": "2ae689ae-c192-386d-a4df-1c1e8c3307fa",
                                                "text": "The Beshtian School, faithful to this concept of song, was characterized primarily by happy-sounding and rhythmic melodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f9ea6b-afe6-3e94-96fe-33e72ef4b1e2",
                                        "entry_id": "e01d5061-a4b4-3333-88f4-588c9a14e467",
                                        "glosses": [
                                            "Characterized by rhythm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cee8824-7b82-3930-888d-367baa543fff",
                                        "entry_id": "e01d5061-a4b4-3333-88f4-588c9a14e467",
                                        "glosses": [
                                            "Written in verse, especially rhyming verse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "149ca69e-cf43-3c2e-93a4-0516864cee6f",
                                        "entry_id": "e01d5061-a4b4-3333-88f4-588c9a14e467",
                                        "glosses": [
                                            "With regular, repetitive motion or sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b92bd185-3cef-4a67-9b51-9b048a5577db",
                        "source_entry_id": "0bd8d38e-19f8-31ff-8247-ac2db7644d43",
                        "target_lang_word": "rythmique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rythmique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                                        "entry_id": "d6849cdc-8887-3356-9792-f6977397a820",
                                        "glosses": [
                                            "Relatif au rythme ; qui observe le rythme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fb3bab1-d80e-4e7b-b47c-dd4fb01c036b",
                                                "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                                                "text": "Depuis deux heures Rabalan travaillait avec acharnement. Son casse-pierres se levait et s’abaissait en un mouvement rythmique, sur les cailloux."
                                            },
                                            {
                                                "example_id": "9a5bbba7-db5c-4ef3-9eb3-fa43cfc14757",
                                                "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                                                "text": "S’accompagnant de son gimbri, il nous chante, d’une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                                            },
                                            {
                                                "example_id": "10979c92-d289-43ed-8c02-1c2f510bf46c",
                                                "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                                                "text": "Des clappements, des crissements et d’étranges grincements rythmiques s’éveillaient, aussitôt que l’intrépide pédaleur avait fait quelques tours de roue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rythmique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "170e4edc-a4ae-372d-aaff-97bd2da42add",
                                        "entry_id": "972cfff1-cf33-3740-a0bd-2f23a1689ffb",
                                        "glosses": [
                                            "Partie de la musique qui concerne les lois du rythme, de la mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba3280e-f93f-4213-98f5-b8c404dd0eb7",
                                                "sense_id": "170e4edc-a4ae-372d-aaff-97bd2da42add",
                                                "text": "Notions sur la rythmique grégorienne."
                                            },
                                            {
                                                "example_id": "8369841d-eb1e-4351-a864-93c7e1bd87c3",
                                                "sense_id": "170e4edc-a4ae-372d-aaff-97bd2da42add",
                                                "text": "Il y a donc tout lieu de croire, comme aux États-Unis, que la danse à l’école québécoise prit alors les formes du folklore et de la rythmique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9f91dd-8c36-3aa8-8cd5-3fab1e7697ae",
                                        "entry_id": "972cfff1-cf33-3740-a0bd-2f23a1689ffb",
                                        "glosses": [
                                            "Loi du rythme, de la mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ee3b1b-0a91-49db-96cd-bcdd611998b0",
                                                "sense_id": "5e9f91dd-8c36-3aa8-8cd5-3fab1e7697ae",
                                                "text": "On peut travailler la rythmique de la langue à l’aide d’une chanson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
