                    {
                        "translation_id": "142dcb4e-8783-4f5c-9012-0fc2ef2a9a5f",
                        "source_entry_id": "8dac168c-2508-3147-aafe-73b6d14d19ad",
                        "source_sense_id": "0e2062dc-7c20-36af-996c-6d6d68f5459c",
                        "target_lang_word": "oxide",
