                        "examples": [
                            {
                                "example_id": "cda15347-0530-4225-a44f-4d83c9db6d22",
                                "sense_id": "cfbf0a5d-7019-39ad-ae1a-282b0b3c5272",
                                "text": "Hij voer met zijn prauw over de rivier."
                            }
                        ]
