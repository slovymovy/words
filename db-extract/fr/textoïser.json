                                "example_id": "d27c420d-49fc-44b0-b189-b0fe960c9413",
                                "sense_id": "a6c40f7e-d166-39bc-81d0-d643db8af81f",
                                "text": "Initialement prévu pour téléphoner…. puis textoïser, photographier, tchater…"
                            }
                        ]
