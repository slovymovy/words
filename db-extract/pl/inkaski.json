                "senses": [
                    {
                        "sense_id": "90216c13-9b2a-3fee-a0ab-5870cdca9972",
                        "entry_id": "9d01b8af-6e32-3ab6-a256-2208b4b73e8b",
                        "glosses": [
                            "związany z Inkami, dotyczący Inków, ich kultury, sztuki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e983456-2250-409e-9a57-bef78f8b2d50",
                                "sense_id": "90216c13-9b2a-3fee-a0ab-5870cdca9972",
                                "text": "W tym właśnie czasie Hiszpanie ostatecznie rozgromili powstańców inkaskich, których przywódcy postanowili uciec do Europy przed prześladowaniami okupantów"
                            },
                            {
                                "example_id": "3b15a2bf-0013-402a-a9c5-1b1f0a66d3ef",
                                "sense_id": "90216c13-9b2a-3fee-a0ab-5870cdca9972",
                                "text": "Część pochodzi jeszcze z czasów inkaskich, kiedy to powierzchnia uprawna w Peru była o czterdzieści procent większa niż obecnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b5df92e-4bd1-4274-a824-82d3028d8f5a",
                        "source_entry_id": "9d01b8af-6e32-3ab6-a256-2208b4b73e8b",
                        "source_sense_id": "90216c13-9b2a-3fee-a0ab-5870cdca9972",
                        "target_lang_word": "Incan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Incan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6bcee6b-5955-3af1-bcd9-b17349e34ba3",
                                        "entry_id": "c170f7fe-8b5b-35c8-8135-614a8e7484f9",
                                        "glosses": [
                                            "Of or pertaining to the Inca people and culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e80b472b-ab51-45f8-ac58-37579cd4fd39",
                                                "sense_id": "f6bcee6b-5955-3af1-bcd9-b17349e34ba3",
                                                "text": "Gene Savoy, an amateur archaeologist whose success in finding some 40 Incan and pre-Incan ruins in Peru was matched by a flair for self-promotion that drew on his tales of peril in the jungle, his bandito mustache and Stetson hat, and a retinue of would-be explorers who paid to accompany him, died on Sept. 11 at his home in Reno, Nev. He was 80."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34e05a68-8925-45be-b3a6-7efe279cbd4b",
                        "source_entry_id": "9d01b8af-6e32-3ab6-a256-2208b4b73e8b",
                        "source_sense_id": "90216c13-9b2a-3fee-a0ab-5870cdca9972",
                        "target_lang_word": "incký",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fe282d24-3f32-4145-bef3-1f0a4f6d8595",
                        "source_entry_id": "9d01b8af-6e32-3ab6-a256-2208b4b73e8b",
                        "source_sense_id": "90216c13-9b2a-3fee-a0ab-5870cdca9972",
                        "target_lang_word": "inca",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inca",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                                        "entry_id": "4d28e1c2-1b9f-39c6-b5be-8d298e6012a5",
                                        "glosses": [
                                            "Relatif à l’histoire et à la civilisation précolombienne des Incas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad04980-5b70-4111-90d8-60826447614d",
                                                "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                                                "text": "Machupichu est une ville inca."
                                            },
                                            {
                                                "example_id": "d81b04aa-6111-4032-88b6-45b237edbefc",
                                                "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                                                "text": "La liste des empereurs incas s’appelle la capaccuna (en quechua « les plus puissants parmi les êtres humains »)."
                                            },
                                            {
                                                "example_id": "79812d64-d54b-4a6b-8b72-86cb38afe9ca",
                                                "sense_id": "d13a23a2-2a3e-3282-95bd-4561fd596f2c",
                                                "text": "La fête du Soleil, qui comme tant de fêtes incas fut interdite par les conquérants, a retrouvé de sa vigueur à partir de 1944."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab26230-8c64-3346-9946-b4568ba5dd45",
                                        "entry_id": "4d28e1c2-1b9f-39c6-b5be-8d298e6012a5",
                                        "glosses": [
                                            "Qui concerne un os surnuméraire du crâne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c86c38-112f-4627-95c0-76458b5e5d16",
                                                "sense_id": "fab26230-8c64-3346-9946-b4568ba5dd45",
                                                "text": "L'os inca ou interpariétal occupe une position analogue sur le lambda."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inca",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6be96c3-be5b-3f88-8297-bcb726ac0048",
                                        "entry_id": "f7b760c0-3fbd-307a-b8dc-f0a7f9fd1178",
                                        "glosses": [
                                            "Genre d'oiseaux-mouches comprenant entre 11 et 13 espèces de la sous-famille des trochilinés (e.g. colibris, etc.), caractérisés par leur bec droit et long, leurs patrons d'iridescence multicolores et complexes comportant parfois des plages d'un blanc immaculé, leur territorialité agressive, et la pariade du mâle qui vole en oscillant tel un pendule au vol au-dessus de la femelle, propres aux sous-bois des forêts de nuage et des forêts naines des Andes (genre Coeligena)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
