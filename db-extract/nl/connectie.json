                                        "sense_id": "f5864bfe-e95b-361f-b403-43df0d717fc0",
                                        "entry_id": "7349420f-054f-3dfa-b8d9-127f511ea655",
                                        "glosses": [
                                            "A drug dealer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e3eafd-9c4e-4667-a38a-4385c12ec183",
                                                "sense_id": "f5864bfe-e95b-361f-b403-43df0d717fc0",
                                                "text": "Now the final study was the drug habit. He was now in New Orleans, slipping along the streets with shady characters and haunting connection bars."
                                            }
                                        ]
                                    }
                                ]
