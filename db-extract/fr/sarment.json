        "fr-extract.jsonl": [
            {
                "entry_id": "ed69e500-6cd7-3a1d-a064-c438d8f0d16e",
                "word": "sarment",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "06154d05-a855-49b3-81bf-602d96ca8431",
                        "entry_id": "ed69e500-6cd7-3a1d-a064-c438d8f0d16e",
                        "tags": [
                            "plural"
                        ],
                        "form": "sarments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f2f2aa1-382d-3a03-b068-fd52d23788d5",
                        "entry_id": "ed69e500-6cd7-3a1d-a064-c438d8f0d16e",
                        "glosses": [
                            "Nouveau bois que la vigne développe chaque année."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "44681bf6-fe8c-4c26-a343-47ca5e1de4b7",
                                "sense_id": "8f2f2aa1-382d-3a03-b068-fd52d23788d5",
                                "text": "Dans le mois de février de la deuxième année, on coupe rez souche les sarments les plus faibles et l'on taille à un ou deux yeux le sarment le plus fort."
                            },
                            {
                                "example_id": "1a260a01-eded-4182-8dca-3871c381d31f",
                                "sense_id": "8f2f2aa1-382d-3a03-b068-fd52d23788d5",
                                "text": "[…] elle alla jeter un sarment dans le feu qui s’éteignait."
                            },
                            {
                                "example_id": "240fc6ca-789f-4832-9b00-4e4a03be5fa7",
                                "sense_id": "8f2f2aa1-382d-3a03-b068-fd52d23788d5",
                                "text": "À la tribune, Mège commença avec une modération affectée, précisant, posant la question. Grand, maigre, noueux et tordu comme un sarment de vigne, il y soutenait des deux mains sa taille un peu courbée, interrompu souvent par la petite toux de la lente tuberculose dont il brûlait."
                            },
                            {
                                "example_id": "31ab8644-d86e-458c-9e39-cf6fe0158ad3",
                                "sense_id": "8f2f2aa1-382d-3a03-b068-fd52d23788d5",
                                "text": "Je sors et vais m’asseoir près de leur feu […]. Nous l’entretenons parcimonieusement, allumant chaque nouveau sarment au sarment qui s’éteint, pour que le fagot suffise jusqu’au matin."
                            },
                            {
                                "example_id": "4e623c10-92ba-4f29-886b-6f29b06b4144",
                                "sense_id": "8f2f2aa1-382d-3a03-b068-fd52d23788d5",
                                "text": "Dans l’auberge de Baozich, il y a toujours les flambées de sarments devant lesquelles on se chauffe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2514297-83c2-4f41-84b1-77bae6fca26d",
                        "source_entry_id": "ed69e500-6cd7-3a1d-a064-c438d8f0d16e",
                        "source_sense_id": "8f2f2aa1-382d-3a03-b068-fd52d23788d5",
                        "source_sense_description": "Bois de vigne",
                        "target_lang_word": "sarmiento",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarmiento",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a135d098-d777-3ce4-b3a1-5ae973cfd0ec",
                                        "entry_id": "f561bdb5-4fd5-394e-95c1-fe42240a9d1e",
                                        "glosses": [
                                            "Tallo de la vid."
                                        ],
                                        "tags": [
                                            "viticultura"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df157b12-b8a7-47e8-8652-acfc76feaccf",
                                                "sense_id": "a135d098-d777-3ce4-b3a1-5ae973cfd0ec",
                                                "text": "quando vinieren a los çimientos de los muros, sacavan muy grand parte del muro & ponenlo en la madera & con grand ruido detardan la caida del muro & ponen ençima sarmientos & otra lenna, para quemar."
                                            },
                                            {
                                                "example_id": "91c65611-c28d-4411-88fa-a59a9c85b131",
                                                "sense_id": "a135d098-d777-3ce4-b3a1-5ae973cfd0ec",
                                                "text": "Se balancea la mies dorada mecida suavemente por el viento; penden del tronco viejo y retorcido del sarmiento los apretados racimos de la vid."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
