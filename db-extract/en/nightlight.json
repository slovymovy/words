                                                "sense_id": "a9399912-b783-31ab-96c4-2ea2cf25c9c6",
                                                "text": "Dieses Nachtlicht ist mit einem Bewegungsmelder ausgestattet."
                                            },
                                            {
                                                "example_id": "b4645dea-801b-4262-aba9-df95d2f1a5c5",
                                                "sense_id": "a9399912-b783-31ab-96c4-2ea2cf25c9c6",
                                                "text": "„Sophie folgte mir auf den Korridor, wo vor einem von Tante Praskovias Heiligenbildern ein harmloses Nachtlicht ruhig weiterbrannte.“"
                                            },
                                            {
                                                "example_id": "3cf6ce9f-2bcf-4939-a204-d49017a65655",
                                                "sense_id": "a9399912-b783-31ab-96c4-2ea2cf25c9c6",
                                                "text": "„Als Mutter und Sohn den Fußstapfen ihres Vaters im bleichen glänzenden Nachtlichte eine lange Weile gefolgt waren, hörten sie das Todesröcheln des verwundeten Häuptlings.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
