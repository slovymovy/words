                "senses": [
                    {
                        "sense_id": "9a3fd4b1-7d76-3c3e-a686-663f822a2e1e",
                        "entry_id": "51bc7722-d412-3d58-9022-ba34fb2f46f8",
                        "glosses": [
                            "etwas, das sich positiv abhebt, als besonders, hervorragend gilt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c812d8d2-8d68-48a3-80fe-a14bd57c6d51",
                                "sense_id": "9a3fd4b1-7d76-3c3e-a686-663f822a2e1e",
                                "text": "„Im Museum Frieder Burda in Baden-Baden sind Sahnestücke deutscher Sammlergeschichte ausgestellt: Werke Gerhard Richters aus privaten Kollektionen.“"
                            },
                            {
                                "example_id": "30c946d3-0bee-4d07-a368-db665fbd4f60",
                                "sense_id": "9a3fd4b1-7d76-3c3e-a686-663f822a2e1e",
                                "text": "„Was die Gemüter erhitzt wie der Kaffeeautomat den Cappuccino, ist der drohende Abriss des Cafés Kustermann. […] Würde sie aus dem Ortsbild verschwinden, wäre fraglos der Verlust eines Sahnestücks der Stadtteilidentität zu beklagen.“"
                            },
                            {
                                "example_id": "3eaac786-ae4c-41f3-8f33-eb3221c057af",
                                "sense_id": "9a3fd4b1-7d76-3c3e-a686-663f822a2e1e",
                                "text": "„Es war ein echtes Sahnestück, aufgemotzt wie eine Zuhälterkarre mit angeklemmten Trittbrettern, Angel-Eye-Scheinwerfern und protzigem Auspuffrohr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a698f671-e630-3c07-85c4-df34231ca5d4",
                        "entry_id": "51bc7722-d412-3d58-9022-ba34fb2f46f8",
                        "glosses": [
                            "Stück von einer mit Sahne befüllter oder bestrichenen Torte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44e8eb0a-1da3-4e6c-bc60-01681e29c9f2",
                                "sense_id": "a698f671-e630-3c07-85c4-df34231ca5d4",
                                "text": "„Während ich das Sahnestück bis auf einige Krümel vertilgte, lenkte mich die Beschäftigung mit diesem unerwarteten Gedanken noch einige Minuten ab […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
