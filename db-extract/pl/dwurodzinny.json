                        "examples": [
                            {
                                "example_id": "54de3363-b86b-4442-9fcc-abd1c8bcfa47",
                                "sense_id": "7ca08a5b-4b8a-37cd-a295-b5babbb79026",
                                "text": "W wykarczowanym środku lasu, osiem kilometrów od Katowic, postawiono parterowe dwurodzinne domki z cegły dla 600 górniczych rodzin"
                            },
                            {
                                "example_id": "bcea2da0-b2e4-457f-9fa3-dce3915c517a",
                                "sense_id": "7ca08a5b-4b8a-37cd-a295-b5babbb79026",
                                "text": "Ostatnio zakład wykończył cztery dwurodzinne domki z garażami"
                            }
                        ],
