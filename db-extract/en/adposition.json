                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "71b94bca-57f7-3b51-a5fa-b8b6b34da224",
                                        "entry_id": "1019694d-5be9-3f91-a198-14c8db724d9d",
                                        "glosses": [
                                            "o urządzeniu: odpowiednie ustawienie działania, tryb działania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bf7447-a296-4376-bc7b-392ac36c929f",
                                                "sense_id": "71b94bca-57f7-3b51-a5fa-b8b6b34da224",
                                                "text": "To urządzenie musi pracować w pozycji poziomej lub pod kątem maksymalnie 5° (= pięć stopni) do poziomu."
                                            },
                                            {
                                                "example_id": "b66a331c-3b69-4775-a448-594571aa5296",
                                                "sense_id": "71b94bca-57f7-3b51-a5fa-b8b6b34da224",
                                                "text": "Przed włączeniem urządzenia należy sprawdzić, czy włącznik jest w pozycji „0” (= zero)."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "46fcb22c-705e-3074-80c2-5814188fe540",
                                        "entry_id": "1019694d-5be9-3f91-a198-14c8db724d9d",
                                        "glosses": [
                                            "miejsce w jakimś spisie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dea4151-d0ee-4263-9d05-9f69b91642a6",
                                                "sense_id": "46fcb22c-705e-3074-80c2-5814188fe540",
                                                "text": "Twoje nazwisko jest na pierwszej pozycji."
                                            },
                                            {
                                                "example_id": "11205c0b-7095-42b7-b5e1-088aab238520",
                                                "sense_id": "46fcb22c-705e-3074-80c2-5814188fe540",
                                                "text": "Niektóre pozycje w tym wykazie są błędne."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "ce1df24f-f699-3c45-b68e-4311b13e215f",
                                        "entry_id": "1019694d-5be9-3f91-a198-14c8db724d9d",
                                        "glosses": [
                                            "miejsce zawodnika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61895c7c-01fd-4ada-a0e0-e3d16b1b7c9a",
                                                "sense_id": "ce1df24f-f699-3c45-b68e-4311b13e215f",
                                                "text": "Ten piłkarz gra na pozycji obrońcy."
                                            },
                                            {
                                                "example_id": "f7cd7af7-5cfe-4b3d-a220-b0df1c376eff",
                                                "sense_id": "ce1df24f-f699-3c45-b68e-4311b13e215f",
                                                "text": "Jeden z zawodników grający na pozycji skrzydłowego ma ponad 210 cm (= centymetrów) wzrostu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "a3b862c4-4c5d-3c49-accd-1d7ea273e879",
                                        "entry_id": "1019694d-5be9-3f91-a198-14c8db724d9d",
                                        "glosses": [
                                            "ranga kogoś w stosunku do innych osób w grupie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef6ac57-0d0a-4e71-9729-ac418a298806",
                                                "sense_id": "a3b862c4-4c5d-3c49-accd-1d7ea273e879",
                                                "text": "Umacniamy na rynku naszą pozycję lidera."
                                            },
                                            {
                                                "example_id": "b6b322aa-42f9-44ea-82c3-b0e47e75fef6",
                                                "sense_id": "a3b862c4-4c5d-3c49-accd-1d7ea273e879",
                                                "text": "Tomek zastąpi Krzysztofa na pozycji kierownika naszej firmy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "49a3c774-cb82-3ebc-a171-2e2729b84c29",
                                        "entry_id": "1019694d-5be9-3f91-a198-14c8db724d9d",
                                        "glosses": [
                                            "film, książka"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62874c58-e090-4052-9e31-b8d8940534f0",
                                                "sense_id": "49a3c774-cb82-3ebc-a171-2e2729b84c29",
                                                "text": "Internetowy katalog naszej biblioteki zawiera ponad 10 000 pozycji."
                                            }
                                        ],
                                        "sense_index_json": "\"1.7\""
                                    },
                                    {
                                        "sense_id": "c0edaad0-e63a-31c1-b3b4-d64a9d05e725",
                                        "entry_id": "1019694d-5be9-3f91-a198-14c8db724d9d",
                                        "glosses": [
                                            "stanowisko kupującego/sprzedającego wobec przewidywanego przez niego przyszłego kursu instrumentu pochodnego wyrażone przez kupno bądź sprzedaż nieposiadanych kontraktów terminowych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c39b1f7-bd3c-4bc7-8655-b8dfe8eda1ef",
                                                "sense_id": "c0edaad0-e63a-31c1-b3b4-d64a9d05e725",
                                                "text": "Inwestor przeczuwając spadki na jutrzejszej sesji zajął krótką pozycję."
                                            }
                                        ],
                                        "sense_index_json": "\"1.8\""
                                    },
                                    {
                                        "sense_id": "299c13ac-a528-323e-8543-b0241cd654ac",
                                        "entry_id": "1019694d-5be9-3f91-a198-14c8db724d9d",
                                        "glosses": [
