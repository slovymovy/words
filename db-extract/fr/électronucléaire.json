                "senses": [
                    {
                        "sense_id": "c0d018dc-e5e3-31f3-9d65-c3c1799c5ba9",
                        "entry_id": "bad75816-1714-39eb-becd-bb3270ac28a8",
                        "glosses": [
                            "Relatif à la production d’électricité à l’aide de la technologie nucléaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b18957-946c-483e-8e8c-30b354c3abd9",
                                "sense_id": "c0d018dc-e5e3-31f3-9d65-c3c1799c5ba9",
                                "text": "Ils sont aussi produits par la recherche (26 %), la défense (11 %), l’industrie non électronucléaire (3 %) et enfin le monde médical (1 %)."
                            },
                            {
                                "example_id": "9bd6b4c6-27b8-4e9b-914b-6ae4ea1c7da2",
                                "sense_id": "c0d018dc-e5e3-31f3-9d65-c3c1799c5ba9",
                                "text": "Une lueur pointe néanmoins dans ce brouillard généralisé : la parution début 2012 d’un nouveau rapport de la Cour des comptes qui sera un audit de la filière électronucléaire et de ses coûts réels."
                            },
                            {
                                "example_id": "91f568f7-2544-4183-acad-b67d3e45ec0e",
                                "sense_id": "c0d018dc-e5e3-31f3-9d65-c3c1799c5ba9",
                                "text": "Dans la ligne du discours prononcé à Belfort par Emmanuel Macron, le 10 février 2022, cette formation conserve un choix clair pour l’électricité en général, et la production électronucléaire en particulier, contrairement au Nouveau Front populaire qui, manifestement faute de consensus en interne, fait l’impasse sur ce sujet pourtant inévitable."
                            }
                        ]
                    },
                    {
                        "sense_id": "34ac9a85-9050-3533-ada6-10db1cb802db",
                        "entry_id": "bad75816-1714-39eb-becd-bb3270ac28a8",
                        "glosses": [
                            "Qualifie l’interaction résultant de l’unification théorique de l’interaction électrofaible et de l’interaction forte."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "23d319fc-0e19-4f51-b01a-b360a95ebb4e",
                                "sense_id": "34ac9a85-9050-3533-ada6-10db1cb802db",
                                "text": "Deux forces se partagent le contrôle de l’univers : d’une part, la force électronucléaire, qui résulte de l’union de la force électromagnétique et des forces nucléaires forte et faible, et, d’autre part, la force gravitationnelle encore réfractaire à toute union."
                            }
                        ]
                    }
                ],
