                        "examples": [
                            {
                                "example_id": "b71cb953-3257-416b-9f62-0def10a7e24c",
                                "sense_id": "a4486b10-b2d5-355d-a40d-96b45181de54",
                                "text": "Amerikaanse diplomaten noemen Rusland \"praktisch een maffiastaat\", die draait rond het leiderschap van premier Vladimir Poetin"
                            },
                            {
                                "example_id": "6aa7c45b-1f4b-4648-955f-4c096f44fa57",
                                "sense_id": "a4486b10-b2d5-355d-a40d-96b45181de54",
                                "text": "Sinds de ‘criminele revolutie’ in jaren negentig is Rusland een maffiastaat. Het is in het belang van Oekraïne én van Rusland dat die maffiastaat wordt vernietigd, zegt Aleksandr Skorobogatov"
                            },
                            {
                                "example_id": "49133550-7b55-4419-b7ec-c2707cd85100",
                                "sense_id": "a4486b10-b2d5-355d-a40d-96b45181de54",
                                "text": "Amerika is een maffiastaat geworden, die universiteiten, media en rechtbanken knecht en afperst."
                            }
                        ]
