                        "entry_id": "330a260f-a19b-3d1f-91c1-66e5fc413d66",
                        "glosses": [
                            "A member of the Ansar Allah armed revolutionary group in Yemen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f04cbf-ef3b-4763-9121-21b120f2bca1",
                                "sense_id": "c1a3088b-43ea-32b7-9517-466783747c0c",
                                "text": "Late on Tuesday, the Houthis claimed responsibility for a missile attack on a container ship in the Red Sea, and for an attempt to attack Israel with drones."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9718f094-f798-4cde-86c4-3cc4e6c28423",
