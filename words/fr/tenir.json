                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous ces livres ne peuvent pas <w>tenir</w> dans un si petit carton."
                        },
                        {
                            "text": "Cinq personnes peuvent facilement <w>tenir</w> à l'arrière de ce grand véhicule."
