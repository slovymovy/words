                "senses": [
                    {
                        "sense_id": "53e313a3-7c97-3dec-addb-468d3baba69b",
                        "entry_id": "4c7f7c66-0b61-367d-9ab9-f8a33ba53aa3",
                        "glosses": [
                            "scheuring in de wand van een bloedvat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e76a99b-54d7-4e11-96a7-31b7e28f778d",
                                "sense_id": "53e313a3-7c97-3dec-addb-468d3baba69b",
                                "text": "Een dissectie kan alleen in een slagader ontstaan en niet in een ader."
                            }
                        ]
                    },
                    {
                        "sense_id": "4daf30f2-3bee-346d-900f-a156142f2e41",
                        "entry_id": "4c7f7c66-0b61-367d-9ab9-f8a33ba53aa3",
                        "glosses": [
                            "ontleding van een lichaam, open snijden van een lijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762e4838-14c7-4910-b473-5f07529667d2",
                                "sense_id": "4daf30f2-3bee-346d-900f-a156142f2e41",
                                "text": "In tegenstelling tot Noord-Europa werd er in de zestiende eeuw in Italië reeds volop klinisch onderwijs gegeven en leerden de studenten anatomie door dissectie van menselijke lichamen, iets wat elders nog nauwelijks werd gedaan onder meer omdat de kerk zich ertegen verzette."
                            }
                        ]
                    },
                    {
                        "sense_id": "89d1664a-6d46-372b-9686-5469e966c5d9",
                        "entry_id": "4c7f7c66-0b61-367d-9ab9-f8a33ba53aa3",
                        "glosses": [
                            "iets onderzoeken door het helemaal in onderdelen uiteen te rafelen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "afc3fca5-961a-4a00-bcd5-9958b1986843",
                                "sense_id": "89d1664a-6d46-372b-9686-5469e966c5d9",
                                "text": "Haar ogen voerden een ongenadige dissectie op de naakte Aloysius uit. Ze pelden laag na laag van zijn lijf af."
                            }
                        ]
                    }
                ],
