                                    {
                                        "sense_id": "5cc53fae-c6e9-36be-b5ae-2db82bfc5730",
                                        "entry_id": "cf493872-182b-325c-8258-f33f1c6a322f",
                                        "glosses": [
                                            "desenho de uma pessoa, de um animal, de uma coisa ou de um fato, que exagera alguns aspectos com intenção cômica ou crítica"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c4e666-9eb3-4a1d-9e67-f34f377e744e",
                                                "sense_id": "5cc53fae-c6e9-36be-b5ae-2db82bfc5730",
                                                "text": "Afinal, toda caricatura, para funcionar, depende do conhecimento prévio do material caricaturado."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
