                "senses": [
                    {
                        "sense_id": "49e2d568-2f9c-3a92-a4ef-1d0d6ee01656",
                        "entry_id": "f13f9e50-13f6-39a6-88e2-07e1c0b54a26",
                        "glosses": [
                            "To make tart or bitter"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fa987d43-6be4-4d98-8708-9c2eff21c272",
                                "sense_id": "49e2d568-2f9c-3a92-a4ef-1d0d6ee01656",
                                "text": "These faults in a scholar tend to tarten the writing, to enliven the reader."
                            },
                            {
                                "example_id": "477d5cf4-d80f-4d09-ba40-d39fb5f2f572",
                                "sense_id": "49e2d568-2f9c-3a92-a4ef-1d0d6ee01656",
                                "text": "I loved their shouts of welcome as I trudged across the fields carrying the heavy jug. Mama mixed the old time drink from cold well water, a pinch of ginger, molasses and some vinegar to tarten it."
                            },
                            {
                                "example_id": "bf669d06-44d8-4fbf-af9a-1b3fa9f217bd",
                                "sense_id": "49e2d568-2f9c-3a92-a4ef-1d0d6ee01656",
                                "text": "He knew precisely when to spice the orchestration with percussive pepper, when to add a pinch more of sugar, when to tarten the mixture with a squeeze or two of lime."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f02721a-16bb-3015-9fa3-da857326055b",
                        "entry_id": "f13f9e50-13f6-39a6-88e2-07e1c0b54a26",
                        "glosses": [
                            "To become tart or bitter"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "472dfbe2-8ec3-4c7d-b74f-2ef47c732b56",
                                "sense_id": "2f02721a-16bb-3015-9fa3-da857326055b",
                                "text": "[…] her sweetness tartened as one side of her clutched loyalty, the other love."
                            }
                        ]
                    }
