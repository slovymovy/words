                                    {
                                        "sense_id": "e8e99ac5-a497-3542-800a-340f861846e2",
                                        "entry_id": "a37de6cc-64fe-36a5-b2d4-b859762313f2",
                                        "glosses": [
                                            "aspekt dokonany od: odrzucać"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48bc5c27-11b8-4953-b487-f2e2d2dab2a2",
                                                "sense_id": "e8e99ac5-a497-3542-800a-340f861846e2",
                                                "text": "Przecież to znakomite gimnazjum, które zapewnia wspaniałe perspektywy! Tyle innych dziewcząt musiałyśmy odrzucić, choć rodzice nas na kolanach błagali.."
                                            }
