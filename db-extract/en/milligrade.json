                "senses": [
                    {
                        "sense_id": "ccbb0321-e9c1-3e60-a073-f25df549b2f9",
                        "entry_id": "aeac405e-3fcb-3c3b-99b9-fc1184be11ed",
                        "glosses": [
                            "Based on a division into 1000 degrees."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8639dd48-54d1-4f60-bba2-5fc26eaa5c24",
                                "sense_id": "ccbb0321-e9c1-3e60-a073-f25df549b2f9",
                                "text": "A new and ingenious thermometric scale has been constructed by Mr. John Williams, by dividing the interval between the freezing and boiling points of mercury into 1000 degrees. The freezing point of water would thus be 100°, and its boiling point 350°, and five milligrade degrees would be equal to two degrees C."
                            },
                            {
                                "example_id": "303805a8-e09a-4ee7-bd68-4e1a39b6969d",
                                "sense_id": "ccbb0321-e9c1-3e60-a073-f25df549b2f9",
                                "text": "In the Heat department we cannot allow ourselves to linger at the fine collection of thermometric and other instruments. Among them is a milligrade thermometer, in which the interval between the freezing and boiling points of water is divided into one thousand degrees; it obviates the use of fractions."
                            },
                            {
                                "example_id": "4ddf1b5a-8c9c-4b3c-a6c3-e0d50c69e378",
                                "sense_id": "ccbb0321-e9c1-3e60-a073-f25df549b2f9",
                                "text": "A. Betts has devised a milligrade thermometer on a scale in which the freezing point of mercury is the zero and its boiling point is 1000."
                            }
                        ]
                    }
                ],
