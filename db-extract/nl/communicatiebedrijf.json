                        "examples": [
                            {
                                "example_id": "24ed85e3-cc79-4698-a622-590070823b4a",
                                "sense_id": "44b15ecb-5b7c-3331-873f-8d39db134a26",
                                "text": "Ook de Spanjaard Alejandro Valverde staat op het punt bij te tekenen bij de Spaanse ploeg. Het communicatiebedrijf Telefónica, moederbedrijf van Movistar, blijft ook de komende drie jaar sponsor bij de ploeg."
                            },
                            {
                                "example_id": "0f5ff729-1d77-4548-9bb2-10a92565e4d0",
                                "sense_id": "44b15ecb-5b7c-3331-873f-8d39db134a26",
                                "text": "De raket die vandaag werd gelanceerd vanaf een basis in Californië heeft tien satellieten aan boord. Die satellieten wil communicatiebedrijf Iridium gebruiken om een wereldwijd telefoonnetwerk op te zetten."
                            },
                            {
                                "example_id": "c5f542ea-a022-448f-a40d-cebf8de5df5d",
                                "sense_id": "44b15ecb-5b7c-3331-873f-8d39db134a26",
                                "text": "De stijging in het budget zit 'm voornamelijk in de toename van sponsorgelden. De twee voornaamste geldschieters (telecommunicatiebedrijf Sky UK Limited en communicatiebedrijf 21st Century Fox) maakten in 2016 ruim 7,5 miljoen euro meer over dan in 2015."
                            }
