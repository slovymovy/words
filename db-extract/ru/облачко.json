                    {
                        "form_id": "6f58eddd-c8d0-48da-9382-73b8d76d5150",
                        "entry_id": "aa1aa17b-bf3c-37d4-a7fc-223ccf9bc8cf",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "облачка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                        "entry_id": "aa1aa17b-bf3c-37d4-a7fc-223ccf9bc8cf",
                        "glosses": [
                            "уменьш.-ласк. к облако; маленькое облако"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0956559d-d4c6-4481-9fcf-c90ae081dadd",
                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                "text": "Ни ветра, ни бодрого, свежего звука, ни облачка."
                            },
                            {
                                "example_id": "4ad918df-566e-4980-ab2c-27f81b2584fb",
                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                "text": "Порой на луну, должно быть, набегали облачка, и в комнате становилось темней."
                            },
                            {
                                "example_id": "db5aa688-f17e-4cdd-9312-6b064a00a026",
                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                "text": "Небо потемнело, облачка из розовых превратились в серовато-лиловые."
                            },
                            {
                                "example_id": "b4850cc8-0992-447e-bb7c-ef166a5721da",
                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                "text": "Погода прежняя ― довольно тихая, ясная, если не считать тонко-тонкоперистых облачков, видимых лишь при солнце."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb4084e0-039f-4ef8-afa3-cb3ad17100b1",
                        "source_entry_id": "aa1aa17b-bf3c-37d4-a7fc-223ccf9bc8cf",
                        "source_sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                        "target_lang_word": "Wölkchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wölkchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a586415-93f6-33d8-8bd8-774ad3affbe1",
                                        "entry_id": "4330e6ce-1d3c-3582-bfcc-27b5b2c6f67d",
                                        "glosses": [
                                            "kleine Wolke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09146696-c06d-4f4d-a005-2b451af811e0",
                                                "sense_id": "0a586415-93f6-33d8-8bd8-774ad3affbe1",
                                                "text": "Es war nur ein Wölkchen am Himmel zu sehen."
                                            },
                                            {
                                                "example_id": "ac93b9e9-5e08-46db-9a4f-478ed7fc5d3b",
                                                "sense_id": "0a586415-93f6-33d8-8bd8-774ad3affbe1",
                                                "text": "„Unmittelbar nachdem das Wölkchen aufgestiegen war, ertönte ein ferner Schuss, und man sah, wie unsere über die Bücke marschierenden Truppen ihr Tempo verstärkten.“"
                                            },
                                            {
                                                "example_id": "6dca0451-4306-424a-9ba8-abca89fd8304",
                                                "sense_id": "0a586415-93f6-33d8-8bd8-774ad3affbe1",
                                                "text": "„Ihren Haarknoten hielt ein Haarnetz zusammen, aber er war spärlich wie ein Wölkchen in den Bergen von Tschu.“"
                                            },
                                            {
                                                "example_id": "06327fbd-22a8-46ff-a509-43e0c4867531",
                                                "sense_id": "0a586415-93f6-33d8-8bd8-774ad3affbe1",
                                                "text": "„Am Himmel standen einzelne Wölkchen, die aber keinen Regen verhießen.“"
                                            },
                                            {
                                                "example_id": "2cf62dbd-1e55-46da-a5d8-3e0479512fa6",
                                                "sense_id": "0a586415-93f6-33d8-8bd8-774ad3affbe1",
                                                "text": "„Die Teekanne blies noch Wölkchen aus der Tülle, und Sonnenlicht strömte durch die offenen Fenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18ea4a50-a6df-4e69-92f8-f2f2157b3ef9",
                        "source_entry_id": "aa1aa17b-bf3c-37d4-a7fc-223ccf9bc8cf",
                        "source_sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                        "target_lang_word": "wolkje",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wolkje",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dc63db58-fb54-340d-a13d-3ebcd354d29f",
                                        "entry_id": "283c1347-0cf6-374d-9df3-6e2e3ac51383",
                                        "glosses": [
                                            "verkleinwoord enkelvoud van het zelfstandig naamwoord wolk"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40af63b4-688d-447b-9e12-f39b533ab0e6",
                                                "sense_id": "dc63db58-fb54-340d-a13d-3ebcd354d29f",
                                                "text": "We hadden enorm veel geluk omdat er die avond een volle maan scheen en er geen wolkje aan de lucht was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
