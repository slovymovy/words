                        "cross_references": [
                            {
                                "target_word": "Livadia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27c4fc5c-e8c3-3c47-8297-3c8a840f302f",
                                        "entry_id": "21756e2b-5761-3c02-8e85-f04e5c697fb5",
                                        "glosses": [
                                            "Capitale du nome de Béotie, en Grèce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44cd820-9488-4f5e-86df-2143a1c062b3",
                                                "sense_id": "27c4fc5c-e8c3-3c47-8297-3c8a840f302f",
                                                "text": "LIVADIA, (Geog.) ville de la Turquie Européenne, en Livadie. Les anciens l’ont connue sous le nom de Lebadia, Lebadea, & il y subsiste encore des inscriptions dans lesquelles on lit πόλις λεϐαδεῶν. Elle est partagée par une riviere que Wheeler nomme Hercyna, qui sort par quelques passages de l’Hélicon, & qui se rend dans le lac de Livadie. Cette ville est habitée par des Turcs, qui y ont des mosquées, & des Grecs qui y ont des églises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4b02446-0038-34a0-ab17-9a6ba0d585be",
                                        "entry_id": "21756e2b-5761-3c02-8e85-f04e5c697fb5",
                                        "glosses": [
                                            "Commune de Crimée, intégrée à la municipalité de Yalta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88c9b718-4859-4152-a40c-87b7c821d679",
                                                "sense_id": "d4b02446-0038-34a0-ab17-9a6ba0d585be",
                                                "text": "Lorsque le Tsar et sa famille durant leur séjour à Livadia dînaient sur leur yacht « Standart », amarré dans la rade de Yalta, se produisaient les balalaïkistes ou le chœur des matelots de l’équipage."
                                            },
                                            {
                                                "example_id": "2d319315-44d5-4ad0-8c02-a48f829858b5",
                                                "sense_id": "d4b02446-0038-34a0-ab17-9a6ba0d585be",
                                                "text": "C'est dans le palais de Livadia, l'une des résidences du dernier empereur de Russie, qu'eut lieu en février 1945 la Conférence de Yalta, réunissant Staline, Roosevelt et Churchill."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
