                ],
                "senses": [
                    {
                        "sense_id": "f54e6742-56a2-361e-bdb9-be4f52d6bc06",
                        "entry_id": "f8174bc4-1133-3b8c-8d4f-d167df9aea8f",
                        "glosses": [
                            "vorüberlegte und schriftlich fixierte Steuermatrix, wie Mensch und Technik in einem Brandfall reagieren sollen"
                        ],
                        "tags": [
                            "Stochastik",
                            "Logik"
                        ],
                        "examples": [
                            {
                                "example_id": "2d4108d6-93e7-4c4b-b1de-7f00c7fe2b43",
                                "sense_id": "f54e6742-56a2-361e-bdb9-be4f52d6bc06",
                                "text": "„Es liegt auf der Hand, dass die Erstellung einer solchen Brandfallmatrix möglichst früh im Planungsprozess berücksichtigt werden muss.“"
                            },
                            {
                                "example_id": "4da45a1f-938f-4ba5-9aa8-8c9b423c189d",
                                "sense_id": "f54e6742-56a2-361e-bdb9-be4f52d6bc06",
                                "text": "„Die Erfordernis der Aufstellung von konzeptionellen Überlegungen zur Brandfallmatrix geht aus den übergreifenden Ansteuerungen hervor.“"
                            },
                            {
                                "example_id": "6cd8c66e-3e4b-4972-a36d-d38c82a5ad15",
                                "sense_id": "f54e6742-56a2-361e-bdb9-be4f52d6bc06",
                                "text": "„Die Erstellung einer Brandfallmatrix ist zum Beispiel eine Nebenleistung.“"
                            },
                            {
                                "example_id": "3262c383-436f-4c0a-b5d4-7bcf160f7557",
                                "sense_id": "f54e6742-56a2-361e-bdb9-be4f52d6bc06",
                                "text": "„Markus Wincher erläutert weiter, dass die Schnelllauftore außerdem in die Brandfallmatrix der Arena integriert sind.“"
                            },
                            {
                                "example_id": "2803d063-b2e7-40d3-9cb6-8da48917fadd",
                                "sense_id": "f54e6742-56a2-361e-bdb9-be4f52d6bc06",
                                "text": "„Die Brandfallmatrix (auch Brandfallsteuermatrix genannt) koordiniert und steuert alle brandschutztechnischen Sicherheitsanlagen verschiedener Gewerke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
