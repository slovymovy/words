                "senses": [
                    {
                        "sense_id": "9984269f-f081-3b07-8f03-358f816a9455",
                        "entry_id": "4d28bc7c-fd56-3849-b420-9fa5f90c3e46",
                        "glosses": [
                            "Étoffe de laine, sorte de gros drap de laine non croisée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a562045a-8886-417e-9b06-9ce552ad2cc0",
                                "sense_id": "9984269f-f081-3b07-8f03-358f816a9455",
                                "text": "Un riche métayer qui dédaigne aujourd'hui de porter un pinchinat commun en un jour solemnel, se fût contenté alors d’un habit de grosse toile. Un simple ouvrier rougiroit d’être couvert en un jour de Fête, des mêmes habits qu’un laboureur aisé portoit dans sa campagne le jour de ses noces il y a 200 ans."
                            },
                            {
                                "example_id": "ed27456e-213d-47a1-a5a3-98a0bfe05864",
                                "sense_id": "9984269f-f081-3b07-8f03-358f816a9455",
                                "text": "On y fabriquait aussi des baracans et des frocs du dernier genre d’étoffe qui n’existe plus depuis un siècle, ainsi que le pinchinat abandonné vers le milieu du siècle présent."
                            },
                            {
                                "example_id": "ab657423-7446-4f59-a891-13825a4291b6",
                                "sense_id": "9984269f-f081-3b07-8f03-358f816a9455",
                                "text": "Les laines du pays de Caux s’emploient pour la fabrique des pinchinats, des serges-cordelières, des draps d’Usseau, des serges de Fécamp et des frocs de Bolbec."
                            },
                            {
                                "example_id": "c0cc57e4-9fae-46a9-aae1-1d3c75663ba0",
                                "sense_id": "9984269f-f081-3b07-8f03-358f816a9455",
                                "text": "A Lodève, les pinchinats se font à trame sèche, tandis que les vingtains et les vingt-quatrains se sont toujours tissés à trame mouillée."
                            },
                            {
                                "example_id": "5b618f80-293f-49c5-b07f-d4b4ff704c5b",
                                "sense_id": "9984269f-f081-3b07-8f03-358f816a9455",
                                "text": "Sont cités : le baptiste, le brin, le brocard, la dauphine (3 cas), la ferrasse, le fleuret, la grisette, le gros brin, l’incarnat, le moire, le nylon, le pinchinat (3 cas), le St Quentin, le velours (4 cas ), le voile."
                            }
                        ]
                    }
