                    }
                ],
                "translations": [
                    {
                        "translation_id": "b08e2d4c-9a94-4247-b69e-fd0b3895dad3",
                        "source_entry_id": "b395e414-34c2-3882-97ea-be35c04253a6",
                        "target_lang_word": "ahead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ahead",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21148365-f2d9-3c7b-83c8-c8ebe12fe61e",
                                        "entry_id": "450e8b8b-db1f-3387-a298-88925bbaf016",
                                        "glosses": [
                                            "At or towards the front; in the direction one is facing or moving."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbefa1ab-ba66-471e-8697-eb14797234b3",
                                                "sense_id": "21148365-f2d9-3c7b-83c8-c8ebe12fe61e",
                                                "text": "The island was directly ahead."
                                            },
                                            {
                                                "example_id": "5eac4c64-5397-43eb-bd8e-bf2bdec754cb",
                                                "sense_id": "21148365-f2d9-3c7b-83c8-c8ebe12fe61e",
                                                "text": "Just ahead you can see the cliffs."
                                            },
                                            {
                                                "example_id": "baeadfe1-75b0-4534-aeff-16d017ec18a1",
                                                "sense_id": "21148365-f2d9-3c7b-83c8-c8ebe12fe61e",
                                                "text": "Keep going straight ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6398712-3690-3e2c-bd19-fdac77002f20",
                                        "entry_id": "450e8b8b-db1f-3387-a298-88925bbaf016",
                                        "glosses": [
                                            "So as to be further advanced, either spatially or in an abstract sense; to be superior."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed8f13f-7585-4d6b-863d-619ada5a0866",
                                                "sense_id": "b6398712-3690-3e2c-bd19-fdac77002f20",
                                                "text": "He finished two laps ahead of me."
                                            },
                                            {
                                                "example_id": "0897fc61-5c15-47d5-b87e-b3290812b4e0",
                                                "sense_id": "b6398712-3690-3e2c-bd19-fdac77002f20",
                                                "text": "In all of his classes Jack was ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4edbb497-f69e-3c3a-a595-a7daa8a2fb7d",
                                        "entry_id": "450e8b8b-db1f-3387-a298-88925bbaf016",
                                        "glosses": [
                                            "In or for the future."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa77e439-6ecd-4724-b232-d30f7be80416",
                                                "sense_id": "4edbb497-f69e-3c3a-a595-a7daa8a2fb7d",
                                                "text": "There may be tough times ahead."
                                            },
                                            {
                                                "example_id": "234a81b3-df01-4791-879e-1556e5bc6f3e",
                                                "sense_id": "4edbb497-f69e-3c3a-a595-a7daa8a2fb7d",
                                                "text": "You've got to think ahead so as not to be unprepared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e3acb30-7d3f-327f-a033-37d0feb8f40b",
                                        "entry_id": "450e8b8b-db1f-3387-a298-88925bbaf016",
                                        "glosses": [
                                            "To a later time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0487941c-a30e-4249-b819-71322f588e49",
                                                "sense_id": "0e3acb30-7d3f-327f-a033-37d0feb8f40b",
                                                "text": "Set the clock ahead an hour."
                                            },
                                            {
                                                "example_id": "dcff2d26-b7ba-4fb3-a2f0-2716804a680d",
                                                "sense_id": "0e3acb30-7d3f-327f-a033-37d0feb8f40b",
                                                "text": "Push the deadline ahead a day, from the 20th to the 21st."
                                            },
                                            {
                                                "example_id": "03080ec2-99d6-4ba3-a7d6-1a0da15eb871",
                                                "sense_id": "0e3acb30-7d3f-327f-a033-37d0feb8f40b",
                                                "text": "Then the customer would set a rebidding deadline ahead a month - for example from September 1 to October 1 - and give everybody four weeks to submit […]"
                                            },
                                            {
                                                "example_id": "f2f90d35-1a38-4d5c-8218-f081266011d8",
                                                "sense_id": "0e3acb30-7d3f-327f-a033-37d0feb8f40b",
                                                "text": "When we saw that wasn't working in 1976, we moved the deadline ahead to 1978."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc51b604-1ede-3960-8246-855aeb87fc2f",
                                        "entry_id": "450e8b8b-db1f-3387-a298-88925bbaf016",
                                        "glosses": [
                                            "At an earlier time; beforehand; in advance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "346d6607-1c03-483e-8abf-ed7e4b68eaa9",
                                                "sense_id": "cc51b604-1ede-3960-8246-855aeb87fc2f",
                                                "text": "He paid his rent ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c019fd-f5e1-3c33-aaab-d1e0de0e4891",
                                        "entry_id": "450e8b8b-db1f-3387-a298-88925bbaf016",
                                        "glosses": [
                                            "To an earlier time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6586e9a4-8ed2-45a4-ad65-7068ff8d2a40",
                                                "sense_id": "08c019fd-f5e1-3c33-aaab-d1e0de0e4891",
                                                "text": "Push the deadline ahead a day, from the 21st to the 20th."
                                            },
                                            {
                                                "example_id": "7b5380b1-7e67-4306-8b7d-d5fb11010678",
                                                "sense_id": "08c019fd-f5e1-3c33-aaab-d1e0de0e4891",
                                                "text": "[…] committees in Congress hae a March 15 deadline for reporting their \"views and estimates\" to the budget committees. The Senate Republican leadership, eager to get a jump on the annual budget process, moved the deadline ahead to March 1 for Senate committees."
                                            },
                                            {
                                                "example_id": "e8ec8d2a-ecfb-4c3b-9d3d-1a1ce4dcfbfb",
                                                "sense_id": "08c019fd-f5e1-3c33-aaab-d1e0de0e4891",
                                                "text": "[…] the Department is responding to the statutory requirement in the USA Patriot Act that moved the deadline ahead to 2003 from 2007."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "964d6817-3a89-41e3-b48f-f0793e53d01a",
                        "source_entry_id": "b395e414-34c2-3882-97ea-be35c04253a6",
                        "target_lang_word": "baldheaded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baldheaded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f68434d-8819-3db5-9c07-f01411a0e797",
                                        "entry_id": "208f5ac7-6abd-3fc4-a118-805c4ab9a106",
                                        "glosses": [
                                            "Alternative spelling of bald-headed."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f25830-bf33-4f63-8da0-2c7f20aaf4a4",
                                                "sense_id": "3f68434d-8819-3db5-9c07-f01411a0e797",
                                                "text": "\"If you go to many classical performances, you see that a lot of them are senior citizens, baldheaded and white,\" said Mr. Robinson[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22efe699-925a-4e7e-baed-c50269253d5f",
                        "source_entry_id": "b395e414-34c2-3882-97ea-be35c04253a6",
                        "target_lang_word": "tout droit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout droit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2e917a1-5fba-37e1-9261-1482d7ca7e8d",
                                        "entry_id": "245760ad-5b6c-342e-ad5b-11014521132b",
                                        "glosses": [
                                            "En avant et sans dévier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38a632c-55b3-4b8c-9613-151e93f5b8fc",
                                                "sense_id": "d2e917a1-5fba-37e1-9261-1482d7ca7e8d",
                                                "text": "Allez tout droit au bout de la rue et là-bas vous trouverez le magasin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c07a935c-d131-3b40-87b3-af2b9039511b",
                                        "entry_id": "245760ad-5b6c-342e-ad5b-11014521132b",
                                        "glosses": [
                                            "Directement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc27256-7213-4736-9b2b-bec2350ec195",
                                                "sense_id": "c07a935c-d131-3b40-87b3-af2b9039511b",
                                                "text": "Kruger et le président Steyn, celui de l’État Libre, se sont rencontrés à ce qu’on dit, et on va tout droit vers une nouvelle guerre. C’est pour ça que je suis rentré."
                                            },
                                            {
                                                "example_id": "ad7f6da4-5305-491b-b170-f4d482e46b7b",
                                                "sense_id": "c07a935c-d131-3b40-87b3-af2b9039511b",
                                                "text": "– Je sais, dit Tarrou sans préambule, que je puis parler tout droit avec vous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3c9ced2-9529-4e6c-964f-a0b12ed1d500",
                        "source_entry_id": "b395e414-34c2-3882-97ea-be35c04253a6",
                        "target_lang_word": "tête baissée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête baissée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd289ff2-39dd-33b3-83de-90ed22ad86bc",
                                        "entry_id": "df7f7512-0c09-361f-a831-a940509061bc",
                                        "glosses": [
                                            "Avec ardeur, précipitamment, sans rien examiner, sans rien craindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c514c837-2454-49bb-b416-84225e226ad4",
                                                "sense_id": "cd289ff2-39dd-33b3-83de-90ed22ad86bc",
                                                "text": "Jamais il n’avait éprouvé cette folie, et il s’y livrait tête baissée."
                                            },
                                            {
                                                "example_id": "99123a71-0142-4b3c-bcfa-c25ff9797d8e",
                                                "sense_id": "cd289ff2-39dd-33b3-83de-90ed22ad86bc",
                                                "text": "– Ne pleure pas, petit. Ce sont là des coups auxquels il faut s’attendre, quand on se jette dans la bataille, tête baissée comme tu l’as fait."
                                            },
                                            {
                                                "example_id": "5285f2c0-744c-4783-b7b3-8b2f2db9e398",
                                                "sense_id": "cd289ff2-39dd-33b3-83de-90ed22ad86bc",
                                                "text": "Je sais où se logent les conservatismes, je ne vais pas les affronter tête baissée, ce n’est pas ma méthode."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fbf4a94-3f94-4361-8148-6343b9c7753e",
                        "source_entry_id": "b395e414-34c2-3882-97ea-be35c04253a6",
                        "target_lang_word": "à corps perdu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à corps perdu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                        "entry_id": "15e4b05b-e608-30bd-9c12-fd6b8331104d",
                                        "glosses": [
                                            "Avec impétuosité, sans songer à se ménager."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02585d40-2002-4ceb-b347-96ab27ac0f82",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "Contraint mais pas forcé, l'ancien champion se lance à corps perdu dans le projet, joue de la sympathie dont il jouit partout, notamment au CIO, pour faire passer les messages parisiens, transforme la maire Anne Hidalgo, longtemps réticente, en passionaria du dossier."
                                            },
                                            {
                                                "example_id": "ce5d125c-3567-49e8-9995-955aaebb156f",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "On se lance à corps perdu dans l’aventure; on veut traverser l’épreuve et devenir enseignant."
                                            },
                                            {
                                                "example_id": "f47aad1b-bbf5-4d04-bc5b-1a408f41172a",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "Abraham se lança donc à corps perdu dans toutes les batailles, tous les coups de force qui se présentèrent. Le plus souvent, il s’agissait de prêter la main à des tribus amies, pour régler quelques conflits de voisinage ou ferrailler contre les Boers qui empiétaient sur leurs terres ou convoitaient leur bétail. De brèves escarmouches qui lui permettaient d’expulser cette boule de haine qui l’empêchait de respirer."
                                            },
                                            {
                                                "example_id": "774aa039-d6c3-49f9-add6-32eba9e07beb",
                                                "sense_id": "34d04725-7c93-3e45-8c72-9204d7a4e955",
                                                "text": "Nos académiciens se donnent et se livrent à corps perdu pour vous révéler leurs Onze de légende. Aujourd’hui un tour dans le Pas-de-Calais avec Luisette, détaillant à volonté les grandes heures des Sang-et-Or. C’est beau mais chut, place à la plume et à l’encrier de Luisette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
