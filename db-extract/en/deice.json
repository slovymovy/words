                "senses": [
                    {
                        "sense_id": "f5e4746c-2f8c-37fe-84ff-878bc2756a3d",
                        "entry_id": "37413289-22d3-3bd7-9e36-36f57e567b07",
                        "glosses": [
                            "To remove the ice from something."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dcbde2d8-fdd2-4e61-b370-5cfdb7ada785",
                                "sense_id": "f5e4746c-2f8c-37fe-84ff-878bc2756a3d",
                                "text": "They had to move the plane back from the runway to de-ice the wings before takeoff."
                            },
                            {
                                "example_id": "13b417f2-95f8-409a-a10d-3ae0a550fca7",
                                "sense_id": "f5e4746c-2f8c-37fe-84ff-878bc2756a3d",
                                "text": "The second strategy is to develop specific care and maintenance rules that will need to be strictly followed by the system operator - including the use of specialised machines to clear the permanent way of snowfall, to de-ice the rail grooves and the running of non-revenue services at night to prevent ice formation on the OCL [overhead contact lines]."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c28d073-e41a-386b-918a-eb9ad4df6040",
                        "entry_id": "37413289-22d3-3bd7-9e36-36f57e567b07",
                        "glosses": [
                            "To lose its ice; to thaw."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e35fde90-5a53-4fdd-bef6-eabc6ef1b563",
                                "sense_id": "5c28d073-e41a-386b-918a-eb9ad4df6040",
                                "text": "Our streets are full of a general sloshiness that lingers and won't go away, as if a glacier is deicing to the north."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e188bc5-c46d-4378-9e36-42f4861824e2",
                        "source_entry_id": "37413289-22d3-3bd7-9e36-36f57e567b07",
                        "source_sense_description": "remove ice",
                        "target_lang_word": "déglacer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déglacer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "583e42b4-3d1c-3d87-baab-3307dbdec1c4",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Ôter la glace, fondre la glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159c0d34-18b4-4e39-91f7-af1ac52c66f3",
                                                "sense_id": "583e42b4-3d1c-3d87-baab-3307dbdec1c4",
                                                "text": "Lorsque vous déglacez les vitres de la voiture, prenez garde à vos épaules et à votre dos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fed3bcd-ff85-3525-9f28-46385db73b0f",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Mouiller avec un liquide (vin, bouillon…) un récipient ayant servi à une cuisson, pour dissoudre les substances et les sucs restant attachés au fond, afin de constituer un jus qui sera souvent filtré dans un chinois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c5d6dd-24a4-4020-b45f-6c5afb9a2842",
                                                "sense_id": "7fed3bcd-ff85-3525-9f28-46385db73b0f",
                                                "text": "Au bout de 5 min, déglacez au vinaigre de cidre, puis mouillez votre bouillon en ajoutant un L d’eau (idéalement 1 L de bouillon végétal, réalisé au préalable avec les épluchures des légumes pour avoir un goût plus profond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bd7117-3b08-37ba-b0f1-9819440db836",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Filtrer une marinade pour en ôter les morceaux de fruits, légumes, condiments, herbes et épices, afin d’en garder seulement le jus servant à la préparation d’une sauce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5bd9dc5-199b-47b5-b5df-d834177ea93f",
                                                "sense_id": "51bd7117-3b08-37ba-b0f1-9819440db836",
                                                "text": "Pour préparer le lièvre au porto, il vaut mieux déglacer la marinade préparée la veille et l’utiliser pour cuire les morceaux et conserver les parfums."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41de4591-42d2-3217-bf94-d3bdd7c91584",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Briser la glace afin de permettre le passage d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bf0f1d8-c966-33e6-8052-8f88768d3f59",
