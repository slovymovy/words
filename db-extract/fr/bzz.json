        "fr-extract.jsonl": [
            {
                "entry_id": "dd60dbc4-7eeb-3490-955a-28e13463f145",
                "word": "bzz",
                "pos": "onomatopoeia",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2fffcdd6-ac83-3cd9-819d-44d997be2f0f",
                        "entry_id": "dd60dbc4-7eeb-3490-955a-28e13463f145",
                        "glosses": [
                            "Onomatopée du bourdonnement des insectes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c3f605-5273-403f-9a68-51058016bb1f",
                                "sense_id": "2fffcdd6-ac83-3cd9-819d-44d997be2f0f",
                                "text": "Le faux bourdon\nVous savez ce que c'est ?\nEh bien non,\nVous vous trompez !\nCe n'est pas le bzz bzz entêté\nD'un blues à la con\nMais bien un mal zébré,\nLe mâle de l'abeille."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eccf8c38-56fb-4a91-acad-3245bb0d6723",
                        "source_entry_id": "dd60dbc4-7eeb-3490-955a-28e13463f145",
                        "source_sense_id": "2fffcdd6-ac83-3cd9-819d-44d997be2f0f",
                        "target_lang_word": "Gesumm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8118a9d5-5250-4742-be17-4522aae19db6",
                        "source_entry_id": "dd60dbc4-7eeb-3490-955a-28e13463f145",
                        "source_sense_id": "2fffcdd6-ac83-3cd9-819d-44d997be2f0f",
                        "target_lang_word": "buzz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buzz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "521a27ef-748a-3b59-94fa-fa90a2c580da",
                                        "entry_id": "f1712c0c-40da-3227-b7d2-601e74d00195",
                                        "glosses": [
                                            "A continuous humming noise, as of bees; a confused murmur, as of general conversation in low tones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81cfa06-ab1b-4d3b-bbb0-c61e5b3daaac",
                                                "sense_id": "521a27ef-748a-3b59-94fa-fa90a2c580da",
                                                "text": "In the steady buzz of flies the homeward-bound agent was lying flushed and insensible[.]"
                                            },
                                            {
                                                "example_id": "df725077-25bf-4c4f-8629-01622f54c31d",
                                                "sense_id": "521a27ef-748a-3b59-94fa-fa90a2c580da",
                                                "text": "This probably explains the interest in UVB-76, or “The Buzzer,” a mysterious shortwave radio station that has been operating since 1982 and whose output consists of a monotonous buzz repeated 24 hours a day, occasionally interrupted by a Russian voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e34326-2c29-39fe-b5a2-4a6bb3376a2d",
                                        "entry_id": "f1712c0c-40da-3227-b7d2-601e74d00195",
                                        "glosses": [
                                            "A whisper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "000eefb9-12ce-3678-91d9-ccc9025eabd3",
                                        "entry_id": "f1712c0c-40da-3227-b7d2-601e74d00195",
                                        "glosses": [
                                            "The audible friction of voiced consonants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bdf9ca8-87fc-310f-89c8-a94d53bda9a4",
                                        "entry_id": "f1712c0c-40da-3227-b7d2-601e74d00195",
                                        "glosses": [
                                            "A rush or feeling of energy or excitement; a feeling of slight intoxication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8b026b-ed3d-449f-ac02-e93e1da49004",
                                                "sense_id": "7bdf9ca8-87fc-310f-89c8-a94d53bda9a4",
                                                "text": "Still feeling the buzz from the coffee, he pushed through the last of the homework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d37d11c8-f84e-3b3a-81a9-b1664c3e283c",
                                        "entry_id": "f1712c0c-40da-3227-b7d2-601e74d00195",
                                        "glosses": [
                                            "A telephone call or e-mail."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b1941db-0b48-418e-b82b-71df7283a446",
                                                "sense_id": "d37d11c8-f84e-3b3a-81a9-b1664c3e283c",
                                                "text": "Now, don't waste time, give us a buzz -- quick! 825-4703 or 265-7881."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "557a69ce-e6b5-32ca-b995-d4a5091c7759",
                                        "entry_id": "f1712c0c-40da-3227-b7d2-601e74d00195",
                                        "glosses": [
                                            "Major topic of conversation; widespread rumor; information spread behind the scenes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2984747e-ebc2-4229-86d3-901012fa317e",
                                                "sense_id": "557a69ce-e6b5-32ca-b995-d4a5091c7759",
                                                "text": "Mr. Hall? The buzz on Christian is that his parents have joint custody, so he'll be spending one semester in Chicago and one semester here."
                                            },
                                            {
                                                "example_id": "c6a369fd-9827-434d-ac92-8b2753df333d",
                                                "sense_id": "557a69ce-e6b5-32ca-b995-d4a5091c7759",
                                                "text": "I wasn't performing with Pimp and Smoove that much no more, but I had a solo deal with Ruthless Rap and a brand new mixtape that was creating a big buzz."
                                            },
                                            {
                                                "example_id": "9c13bf5b-3d5d-405a-8bd5-4cb12a4e5e6f",
                                                "sense_id": "557a69ce-e6b5-32ca-b995-d4a5091c7759",
                                                "text": "In Detroit, the buzz is that he's too nice a guy, unwilling to impose draconian job cuts at the risk of angering the UAW."
                                            },
                                            {
                                                "example_id": "1618a5ee-3025-40b5-9d2a-ed21f1752b94",
                                                "sense_id": "557a69ce-e6b5-32ca-b995-d4a5091c7759",
                                                "text": "Allen Gregory DeLongpre: Who's he?\nPatrick: He's only the most popular kid in school.\nAllen Gregory: Ah, the two heavyweights finally meet. Sure you're tired of all the buzz. Allen Gregory DeLongpre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5041af99-3880-36e3-825c-33db93c5af1a",
                                        "entry_id": "f1712c0c-40da-3227-b7d2-601e74d00195",
                                        "glosses": [
                                            "Synonym of fizz-buzz (“counting game”)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "buzz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c7f016-0618-363b-b536-ab81cdd9e74c",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To make a low, continuous, humming or sibilant sound, like that made by bees with their wings."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28914d69-eaba-4220-b5ff-5185ebf33ea0",
                                                "sense_id": "b2c7f016-0618-363b-b536-ab81cdd9e74c",
                                                "text": "Ah! the singing, fatal arrow, / Like a wasp it buzzed, and stung him [a roebuck]!"
                                            },
                                            {
                                                "example_id": "46c61684-d70b-4bfa-868f-67ceafc1fbc7",
                                                "sense_id": "b2c7f016-0618-363b-b536-ab81cdd9e74c",
                                                "text": "So that now the universe has escaped from the pin which was pushed through it, like an impaled fly vainly buzzing: now that the multiple universe flies its own complicated course quite free, and hasn't got any hub, we can hope also to escape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66c1d10-b1e7-35a3-9938-9788d95ce1f7",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To make a low, continuous, humming or sibilant sound, like that made by bees with their wings.",
                                            "To utter a murmuring sound; to speak with a low, humming voice."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb8f085-3dbf-4c0c-851f-9a693e633ad1",
                                                "sense_id": "f66c1d10-b1e7-35a3-9938-9788d95ce1f7",
                                                "text": "However these disturbers of our peace / Buzz in the people's ears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd62d5de-7508-36c8-a5d4-f4bab9b12a7b",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To make a low, continuous, humming or sibilant sound, like that made by bees with their wings.",
                                            "Of a group of people, to talk about some interesting topic excitedly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86d362a0-07c7-4440-bfd3-0adbe2c8626a",
                                                "sense_id": "bd62d5de-7508-36c8-a5d4-f4bab9b12a7b",
                                                "text": "But I tell you this has set all London buzzing. The old man is where he likes to be, with a pin-point limelight right on his hairy old head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26d72c9d-0a8c-3a6a-a379-85fc2e0d82ef",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To make a low, continuous, humming or sibilant sound, like that made by bees with their wings.",
                                            "To fly while making such a sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4768ec3-e65a-43c2-a436-b46113b42d87",
                                                "sense_id": "26d72c9d-0a8c-3a6a-a379-85fc2e0d82ef",
                                                "text": "The flies, lethargic with the autumn, were beginning to buzz into the room."
                                            },
                                            {
                                                "example_id": "9b43d4a8-f206-4144-9039-e8b1561aef4c",
                                                "sense_id": "26d72c9d-0a8c-3a6a-a379-85fc2e0d82ef",
                                                "text": "A fly was buzzing past me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc153e11-a3d2-342a-b990-51fedde8858e",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To show a high level of activity and haste, energization or excitement, to be busy as a bee in one’s actions but perhaps mentally charged."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54b06bf3-11a4-3064-8fda-d8fabe4b3a19",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To whisper; to communicate, as tales, in an undertone; to spread, as a report, by whispers or secretly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d3dc0d1-7355-4ab6-9ee0-79f903df7d3c",
                                                "sense_id": "54b06bf3-11a4-3064-8fda-d8fabe4b3a19",
                                                "text": "I will buzz abroad such prophecies / That Edward shall be fearful of his life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a83363c1-e95a-36c3-bf3c-ba77b9a46b5d",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To talk to incessantly or confidentially in a low humming voice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cf984f8-65e5-3fa2-a816-c1123faa49c9",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To fly at high speed and at a very low altitude over a specified area, as to make a surprise pass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045f5e06-28c4-4f51-8ad7-b18ec1be8ba6",
                                                "sense_id": "2cf984f8-65e5-3fa2-a816-c1123faa49c9",
                                                "text": "[…] an asteroid a mere 15-20 metres across exploded with the force of a medium-sized atom bomb over Chelyabinsk, in Russia, and another, much larger one buzzed Earth a few hours later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b300cb-5167-374c-aa96-25f2934bcc44",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To cut (the hair) in a close-cropped military style, or buzzcut."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0ad4b05-5c8d-4e22-98bb-54863701c1e1",
                                                "sense_id": "59b300cb-5167-374c-aa96-25f2934bcc44",
                                                "text": "Deacon said, “You used to beg me to let you buzz your hair when you were little.” “And then I grew up and realized how awful you looked when you buzzed yours.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af12043-6da7-39a3-8b82-2e1ba6d830f6",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To throw swiftly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd10284a-6bc9-4e6f-b562-31ce71e76a5a",
                                                "sense_id": "1af12043-6da7-39a3-8b82-2e1ba6d830f6",
                                                "text": "I have mentioned her deft hand with a stone — well, as soon as our backs were turned she buzzed a stone to clip Joe's ear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91ff924b-a34c-3e30-ae55-0c6b9d3ddfde",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To drink to the bottom."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2202b55-6fd3-4314-be0b-ee2d8fa71199",
                                                "sense_id": "91ff924b-a34c-3e30-ae55-0c6b9d3ddfde",
                                                "text": "He buzzed the bottle with such a hearty good will as settled the fate of another, which Soapey rang for as a matter of course. There was but the rejected one, which however Spigot put into a different decanter and brought in […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4787477-5e9c-3a41-aab6-2e5416ebf298",
                                        "entry_id": "63bebb35-da91-3abd-9d7f-d919d1d87cab",
                                        "glosses": [
                                            "To communicate with (a person) by means of a buzzer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34af6786-efbe-4250-8d50-0d075f11d2c7",
                                                "sense_id": "c4787477-5e9c-3a41-aab6-2e5416ebf298",
                                                "text": "Then one day my secretary buzzed me and said Frank Sinatra was on the phone. When I picked up the phone it was the Chief who played dumb and would not admit that he said he was Frank Sinatra."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
