                "senses": [
                    {
                        "sense_id": "0abb4ab3-09b9-3a8c-8ff6-ecf007932017",
                        "entry_id": "42fbb992-62e1-3eb0-bf58-42e48ea4dc60",
                        "glosses": [
                            "Activer sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "015012b9-bc7d-4ab2-a394-c0605d1fdf5e",
                                "sense_id": "0abb4ab3-09b9-3a8c-8ff6-ecf007932017",
                                "text": "L'hétérodimère fos-jun, appelé «facteur AP1 » est le plus actif, mais jun peut s'associer à lui-même en homodimère jun-jun qui a la propriété d'autoactiver sa propre transcription."
                            },
                            {
                                "example_id": "d9a62f84-c1ee-4c28-bcb0-cbc16c659fd5",
                                "sense_id": "0abb4ab3-09b9-3a8c-8ff6-ecf007932017",
                                "text": "Il est constitué d'une vingtaine de protéines enzymatiques, souvent des protéases, présentes à l'état inactif dans le sérum, mais capables de s'autoactiver en cascade après une stimulation exogène."
                            }
                        ]
                    }
