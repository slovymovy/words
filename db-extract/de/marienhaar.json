                    },
                    {
                        "sense_id": "10cc177d-0f15-33a1-88eb-1c063ca7388d",
                        "entry_id": "d2c5c5bd-9b7d-364b-aa0b-ad9a545cde5f",
                        "glosses": [
                            "Volksname für mehrere Pflanzen",
                            "Frauenhaarfarn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a98b045-5175-41c6-9190-46041b5cdc33",
                                "sense_id": "10cc177d-0f15-33a1-88eb-1c063ca7388d",
                                "text": "„So heiszt eine Art Farnkraut Marienhaar, Frauenhaar, im Isländischen Freyahar, dänisch Fruehaar und Venusgräs, norwegisch aber Marigräs.“"
                            }
                        ],
                        "sense_index_json": "\"3d\""
