                        "examples": [
                            {
                                "example_id": "1ad10d6e-a9df-4250-be86-f12760ebb04d",
                                "sense_id": "5c348281-94a0-3ece-b1af-dc79cd8bce6f",
                                "text": "Мы все, и девушка ― председательница сельсовета, и женщина с фонарем, стояли, молчали, следили за действиями обыскивающего."
                            },
                            {
                                "example_id": "ba08e176-bbba-468f-a351-e1a27c759aea",
                                "sense_id": "5c348281-94a0-3ece-b1af-dc79cd8bce6f",
                                "text": "Потом ― мадемуазель Фурро, ее все знают. Она ― председательница Общества бывших француженок."
                            }
                        ]
                    }
