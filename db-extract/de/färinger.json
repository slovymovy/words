                ],
                "senses": [
                    {
                        "sense_id": "cb397552-7a67-3ddb-af29-c8069d90d1cd",
                        "entry_id": "8804dea5-c752-352b-b523-477824237d50",
                        "glosses": [
                            "einheimischer Bewohner der Färöer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ae73c3-e8c5-47fc-bb7b-4102edb54eae",
                                "sense_id": "cb397552-7a67-3ddb-af29-c8069d90d1cd",
                                "text": "„In dem Haus wohne noch ein Isländer, und die anderen Mieter seien Färinger.“"
                            },
                            {
                                "example_id": "dd54c6cf-f0cf-4bb2-b1a4-77b9b43bbd9f",
                                "sense_id": "cb397552-7a67-3ddb-af29-c8069d90d1cd",
                                "text": "„Jákup Nolsøe war der Ansicht, die Färinger müssten sich auf die neue Zeit vorbereiten, und dass er große Pläne mit seinem Sohn hatte, bewies allein der Name Napoleon.“"
                            },
                            {
                                "example_id": "a17e0812-d7cb-4b4a-be10-a761718263ad",
                                "sense_id": "cb397552-7a67-3ddb-af29-c8069d90d1cd",
                                "text": "„Die Färinger konnten den Forderungen der Piraten aber nicht innerhalb der gesetzten Frist nachkommen, worauf diese das Fort zerstörten und den Ort plünderten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
