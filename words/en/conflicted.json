{
    "word_family": [
        "conflict"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33cb6db5-cf91-3d44-beb0-5b191651279f",
                    "sense_definition": "In a state of personal or emotional conflict.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt <w>conflicted</w> about whether he liked me or not.",
                            "target_lang_translations": {
                                "pl": "Czułam się <w>rozdarta</w>, zastanawiając się, czy mnie lubi, czy nie."
                            }
                        },
                        {
                            "text": "She has always been <w>conflicted</w> about her relationship with my family.",
                            "target_lang_translations": {
                                "pl": "Zawsze miała <w>mieszane uczucia</w> co do swoich relacji z moją rodziną."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambivalent"
                    ],
                    "common_phrases": [
                        "feel conflicted"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan wewnętrznego rozdarcia lub sprzecznych uczuć dotyczących jakiejś sprawy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozdarty",
                                "target_lang_sense_clarification": "odczuwający wewnętrzny konflikt emocjonalny"
                            },
                            {
                                "target_lang_word": "mieć mieszane uczucia",
                                "target_lang_sense_clarification": "odczuwać sprzeczne emocje wobec czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4548ac8-624f-3101-9af3-1e9e4e4392e7",
                    "sense_definition": "Having a conflict of interest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "professional_ethics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge felt <w>conflicted</w> because he knew the defendant personally.",
                            "target_lang_translations": {
                                "pl": "Sędzia czuł, że jest <w>w konflikcie interesów</w>, ponieważ znał oskarżonego osobiście."
                            }
                        },
                        {
                            "text": "The lawyer was <w>conflicted</w> and had to withdraw from the case.",
                            "target_lang_translations": {
                                "pl": "Prawnik był <w>w konflikcie interesów</w> i musiał wycofać się ze sprawy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Znajdujący się w sytuacji konfliktu interesów, uniemożliwiającej bezstronne działanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "w konflikcie interesów",
                                "target_lang_sense_clarification": "sytuacja zawodowa lub prawna"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1ecd581-e19e-3246-a2c7-e28e5baf3d27",
                    "sense_definition": "simple past and past participle of <w>conflict</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two witnesses <w>conflicted</w> in their accounts of the accident.",
                            "target_lang_translations": {
                                "pl": "Zeznania dwóch świadków <w>były sprzeczne</w> w opisie wypadku."
                            }
                        },
                        {
                            "text": "Their schedules <w>conflicted</w> so they could not meet.",
                            "target_lang_translations": {
                                "pl": "Ich harmonogramy <w>kolidowały</w>, więc nie mogli się spotkać."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of conflict"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma czasu przeszłego czasownika 'conflict', oznaczająca bycie sprzecznym lub pozostawanie w sprzeczności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "być sprzecznym",
                                "target_lang_sense_clarification": "o informacjach lub zeznaniach"
                            },
                            {
                                "target_lang_word": "kolidować",
                                "target_lang_sense_clarification": "o terminach lub planach"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}