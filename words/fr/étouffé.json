                                "target_lang_sense_clarification": "笑声或情感被忍住"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1eb2610e-04bf-373f-bf91-497f3471f894",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>étouffer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fumée dans la cuisine a presque <w>étouffé</w> le cuisinier ce matin.",
                            "target_lang_translations": {
                                "en": "The smoke in the kitchen nearly <w>suffocated</w> the cook this morning.",
                                "ru": "Дым на кухне этим утром чуть не <w>задушил</w> повара.",
                                "de": "Der Rauch in der Küche hat den Koch heute Morgen fast <w>erstickt</w>.",
                                "es": "El humo de la cocina ha estado a punto de <w>sofocar</w> al cocinero esta mañana.",
                                "zh": "今天早上，厨房里的烟差点让厨师<w>窒息</w>。"
                            }
                        },
                        {
                            "text": "Le gouvernement a rapidement <w>étouffé</w> ce scandale pour éviter les critiques.",
                            "target_lang_translations": {
                                "en": "The government quickly <w>hushed</w> this scandal <w>up</w> to avoid criticism.",
                                "ru": "Правительство быстро <w>замяло</w> этот скандал, чтобы избежать критики.",
                                "de": "Die Regierung hat diesen Skandal rasch <w>vertuscht</w>, um Kritik zu vermeiden.",
                                "es": "El gobierno ha <w>acallado</w> rápidamente este escándalo para evitar las críticas.",
                                "zh": "政府迅速<w>掩盖</w>了这桩丑闻，以免遭到批评。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of «étouffer».",
                        "ru": "Причастие прошедшего времени от глагола «étouffer», означающего глушить, душить или подавлять.",
                        "de": "Maskulines Partizip Perfekt Singular des Verbs étouffer, das ersticken, unterdrücken oder vertuschen bedeutet.",
                        "es": "Participio pasado masculino singular del verbo étouffer, que significa sofocar, acallar o encubrir.",
                        "zh": "“étouffer”的过去分词，意为压制、掩盖或使人窒息。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stifle",
                                "target_lang_sense_clarification": "suppress a sound or laugh"
                            },
