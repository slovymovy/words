                                        "sense_id": "e17a9b18-56d1-39b1-9423-c2b9f48bb178",
                                        "entry_id": "f59e2971-93b7-3a48-8762-9d8edc18845e",
                                        "glosses": [
                                            "Any of several North American fish of the family Lepisosteidae that have long, narrow jaws."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb195c48-cc89-4cff-9cf1-ef6a513da67d",
                                                "sense_id": "e17a9b18-56d1-39b1-9423-c2b9f48bb178",
                                                "text": "Gars are long, slender, predatory fishes of quiet waters east of the Rockies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09ac7144-380f-3880-938a-7da5d0e02d3b",
