                        "glosses": [
                            "Wekenfeest op 6 en 7 sivan, genoemd naar de zeven weken die worden geteld vanaf Pesach (Lev. 23:15-16)"
                        ],
                        "tags": [
                            "Jiddisch-Hebreeuws"
