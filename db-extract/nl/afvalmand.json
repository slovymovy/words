                        "sense_id": "ab77f1df-64e3-3638-8c79-e5c672477a88",
                        "entry_id": "e3be7c84-2dea-32c8-9514-a6a9bffe86ee",
                        "glosses": [
                            "een mand waarin men droge, onbruikbare resten verzamelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bceb7eb-cae6-421a-a755-31156c23a2ae",
                                "sense_id": "ab77f1df-64e3-3638-8c79-e5c672477a88",
                                "text": "De boodschappen zijn achter de rug. De challengeweek -die in dit geval loopt van zaterdag tot zaterdag- kan beginnen. Mijn afvalmand ziet er leeg en uitnodigend uit. Al het droge afval zal ik deze week in die mand verzamelen, om het aan het eind uit te zoeken: welke dingen kunnen gerecycled worden en welke dingen niet?"
                            },
                            {
                                "example_id": "fcfa93f5-0d0c-413b-b5f4-0aa36f00f4c0",
                                "sense_id": "ab77f1df-64e3-3638-8c79-e5c672477a88",
                                "text": "Maar o, wat zou ik Erben graag zien lopen, vanmiddag, in een of ander bedrijfsgebouw met centrale verwarming, visgraattapijt en afvalmanden vol koffiebekertjes"
                            }
                        ]
                    }
