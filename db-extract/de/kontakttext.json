                "senses": [
                    {
                        "sense_id": "70d3b1c3-44e3-30fb-aff4-36a6bec1c62b",
                        "entry_id": "cece31fc-102a-314a-96a0-368d769f2ec4",
                        "glosses": [
                            "Text, dessen hauptsächliche Textfunktion darin besteht, dass der Sprecher/ Schreiber den Kontakt zu dem von ihm Angesprochenen aufnimmt oder fortführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d5fe24-7b04-4343-a75a-5065d8043510",
                                "sense_id": "70d3b1c3-44e3-30fb-aff4-36a6bec1c62b",
                                "text": "Grußpostkarten sind oft nicht viel mehr als reine Kontakttexte, da ihre Hauptfunktion darin besteht, den Kontakt zum Adressaten aufrecht zu erhalten."
                            },
                            {
                                "example_id": "9e41c498-107b-40f4-9cff-8814da4329f4",
                                "sense_id": "70d3b1c3-44e3-30fb-aff4-36a6bec1c62b",
                                "text": "„Seine Anwendung führt zur Unterscheidung der folgenden fünf Textklassen: …- Kontakttexte (Danksagung, Kondolenzschreiben, Ansichtskarte)…“"
                            },
                            {
                                "example_id": "1cade6d8-9562-42e6-a307-621bc3619eb3",
                                "sense_id": "70d3b1c3-44e3-30fb-aff4-36a6bec1c62b",
                                "text": "„Aus einem bloßen Kontakttext (…) kann sich unter Umständen schnell ein Informationskontakt entwickeln, wenn es einem der Interagierenden einfällt, beiläufig noch bestimmte Informationen zu vermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
