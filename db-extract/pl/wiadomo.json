                                                "example_id": "ef6e5a92-c9dc-434d-aadd-ad34b3414fe3",
                                                "sense_id": "e709a419-c214-33f8-a18b-94722178dd6f",
                                                "text": "Об этом происшествии стало известно из газет."
                                            },
