                    "frequency": "Middle",
                    "semantic_group_id": "recueillement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un silence <w>religieux</w> régnait dans la salle pendant toute la durée du concert."
                        },
                        {
                            "text": "Les visiteurs écoutaient le guide avec un respect <w>religieux</w> et une grande attention."
