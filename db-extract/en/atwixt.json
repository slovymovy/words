                "senses": [
                    {
                        "sense_id": "bd84298f-9443-3541-88a9-6c33a8074f7c",
                        "entry_id": "a8abac6d-90ed-3283-82f9-a8566476af02",
                        "glosses": [
                            "Between."
                        ],
                        "tags": [
                            "dialectal",
