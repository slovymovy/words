                                "sense_id": "8df8deca-0181-3f6b-a6ac-24ea242fca9c",
                                "text": "Remember to traditionate your children in the nurture and admonition of the Lord."
                            },
                            {
                                "example_id": "0a341bfb-33cc-4204-acb2-cd46dc243ce7",
                                "sense_id": "8df8deca-0181-3f6b-a6ac-24ea242fca9c",
                                "text": "My parents belonged to the Methodist Episcopal Church, and I was traditionated in their doctrines and reareed in their faith, until I was twenty-one years of age, when I first heard the fullness of the Gospel of Jesus Christ as revealed through the Prophet Joseph Smith."
                            },
                            {
                                "example_id": "d48e9395-3fd8-4632-8126-e5e39e44a7ff",
                                "sense_id": "8df8deca-0181-3f6b-a6ac-24ea242fca9c",
                                "text": "Name some of the desires in which parents should traditionate their children."
                            }
                        ]
