                "forms": [],
                "senses": [
                    {
                        "sense_id": "aedc6c5c-f337-3bc8-bf16-24c842f85485",
                        "entry_id": "714b4ad4-701c-3b37-a8ed-baa4cba956ad",
                        "glosses": [
                            "Kakodämon, böser Geist, Dämon, Teufel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41361ef0-ba2d-4655-a5e5-b3fafadfd3b7",
                        "source_entry_id": "714b4ad4-701c-3b37-a8ed-baa4cba956ad",
                        "source_sense_id": "aedc6c5c-f337-3bc8-bf16-24c842f85485",
                        "source_sense_description": "Kakodämon, böser Geist, Dämon, Teufel",
                        "target_lang_word": "Dämon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dämon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                        "entry_id": "acdf56fd-97e7-3c31-a1f6-291a9d91d035",
                                        "glosses": [
                                            "Angst machende Macht, böser Geist mit übermenschlichen Kräften"
                                        ],
                                        "tags": [
                                            "Glaube"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75961348-1495-4b7e-8568-1cec54c2c520",
                                                "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                                "text": "Damals glaubte man wirklich, das Kind sei von einem Dämon besessen."
                                            },
                                            {
                                                "example_id": "dc5cd9d9-9b21-48ed-9ad9-33fd95459782",
                                                "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                                "text": "Der Dämon verkörpert alles Böse, das wir uns nur vorstellen können."
                                            },
                                            {
                                                "example_id": "91f907ef-b694-4198-9c42-ba7217a0673d",
                                                "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                                "text": "„Er hatte befürchtet, den Abend allein verbringen zu müssen, doch irgendein Dämon behütete ihn.“"
                                            },
                                            {
                                                "example_id": "1e0f6b95-187d-4da8-84b6-abe7a8e4376e",
                                                "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                                "text": "„Dieser Dämon hielt in der einen Hand ein Buch und in der anderen eine große Gabel.“"
                                            },
                                            {
                                                "example_id": "691223d2-4218-490e-8bdd-ed567970b783",
                                                "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                                "text": "„In einem Gespräch, das der uralte Mentor einmal mit Robert führte, redete er von den erdbewegenden Kräften der Dämonen.“"
                                            },
                                            {
                                                "example_id": "4f27cdd2-30c0-4865-9e9a-e7c7f06f38bd",
                                                "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                                "text": "„Um nämlich morgens am östlichen Horizont zu erscheinen, musste die Sonne in ihrer nächtlichen Fahrt durch die Unterwelt den Gefahren der Finsternis widerstehen und die feindlichen Dämonen der Nacht besiegen.“"
                                            },
                                            {
                                                "example_id": "7925bb02-c3ed-4f3a-a62f-ac88b1440144",
                                                "sense_id": "246b7f71-37e4-341a-ae13-405230068e64",
                                                "text": "Man hat viele Jahrzehnte, wenn nicht Jahrhunderte hindurch versucht, Dämonen mittels Exorzismus zu vertreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4f9f080-eda8-30dd-963a-48c7b7878bb4",
                                        "entry_id": "acdf56fd-97e7-3c31-a1f6-291a9d91d035",
                                        "glosses": [
                                            "innere Triebkraft, die eine Person negativ beeinflusst, kann beispielsweise dazu führen, dass die Person impulsiv oder destruktiv handelt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf6de8f1-e1f9-3c82-b582-1569d5632b61",
                                        "entry_id": "acdf56fd-97e7-3c31-a1f6-291a9d91d035",
                                        "glosses": [
                                            "Programm, das im Hintergrund abläuft und bestimmte Dienste zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b1a1a3-932f-4996-8d4d-22e6d48de026",
                                                "sense_id": "cf6de8f1-e1f9-3c82-b582-1569d5632b61",
                                                "text": "Das NTP (Network Time Protocol) ist in UNIX-artigen Betriebssystemen in Form des Hintergrundprozesses (daemon) ntpd (ntp-Dämon) implementiert, der sowohl das lokale System justieren als auch als Server die Uhrzeit für andere Systeme bereitstellen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72fe9e92-6741-493a-9855-232c6c21270f",
                        "source_entry_id": "714b4ad4-701c-3b37-a8ed-baa4cba956ad",
                        "source_sense_id": "aedc6c5c-f337-3bc8-bf16-24c842f85485",
                        "source_sense_description": "Kakodämon, böser Geist, Dämon, Teufel",
                        "target_lang_word": "Teufel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teufel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b69fcfd-8292-3ba3-a58b-20412995f128",
                                        "entry_id": "ee551030-3836-32af-8913-c59a94668173",
                                        "glosses": [
                                            "böses Geisterwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607fd772-de08-401d-a9a5-d9de1a8a13bd",
                                                "sense_id": "4b69fcfd-8292-3ba3-a58b-20412995f128",
                                                "text": "Er ist von einem Teufel besessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                        "entry_id": "ee551030-3836-32af-8913-c59a94668173",
                                        "glosses": [
                                            "Gegenspieler Gottes"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afd08f97-282e-4568-9214-d710dd618a5a",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Der Teufel kann eine Seele nicht mit Gewalt an sich reißen, er muss sie verführen, sagte Mustafa.“"
                                            },
                                            {
                                                "example_id": "7ddd9587-d090-421f-ac16-6247b7bcb1fb",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "Der Teufel soll dich holen!"
                                            },
                                            {
                                                "example_id": "8a98b0dc-8ca6-4ed6-a1d8-87789bdc9a62",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Ich stieg in die Turmkammer empor, in der Jesus vierzig Tage lang der Versuchung des Teufels widerstanden haben soll, und trat auf den schmalen Streifen eines Balkons hinaus, von dem ich auf Jericho hinabblicken konnte.“"
                                            },
                                            {
                                                "example_id": "bd64b4a1-92a5-475e-99d8-0324f61a783b",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Schaut man sich um, dann sind die Teufel die Sieger, nicht etwa Gott, daran ist nicht zu rütteln.“"
                                            },
                                            {
                                                "example_id": "a087d83d-243e-4846-8213-a40423393f19",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Selbst der Teufel kann nicht so schnell schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19f95180-70f1-33e6-bb2c-0d6b32a98df8",
                                        "entry_id": "ee551030-3836-32af-8913-c59a94668173",
                                        "glosses": [
                                            "böser Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14a4f0e-999e-4335-993b-70f80c98c322",
                                                "sense_id": "19f95180-70f1-33e6-bb2c-0d6b32a98df8",
                                                "text": "Er war für seine Grausamkeiten bekannt, ein verabscheuungswürdiger Teufel, eben ein Teufel in Menschengestalt."
                                            },
                                            {
                                                "example_id": "d311168f-2cd1-4eb1-805e-6007874539ac",
                                                "sense_id": "19f95180-70f1-33e6-bb2c-0d6b32a98df8",
                                                "text": "„Die beiden beschimpften sich wechselseitig als Teufel und waren doch untereinander so einig über das Teufelszeug der aufkommenden Geldwirtschaft wie mit vielen anderen Zeitgenossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Teufel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                        "entry_id": "79e13279-b6f7-3e7e-b2a7-e22e03d60d7d",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a152b11d-0df0-45b4-8908-4c82fafd97f7",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Frau Teufel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "27b4e604-3bdf-4c3d-a6e5-87968e1ca746",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Herr Teufel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d19c414e-4078-4136-b166-0c9df0d0333e",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Die Teufels fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "bb5cb55b-44e0-4289-80d5-d47dc4d66034",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Der Teufel trägt nie die Pullover, die die Teufel ihm strickt."
                                            },
                                            {
                                                "example_id": "9994d703-cb40-4056-9458-10fd2611a5c9",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Teufel kommt, geht der Herr Teufel.“"
                                            },
                                            {
                                                "example_id": "d94a1d96-4ba5-4199-93ee-24282f6eb273",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Teufel kommt und geht."
                                            },
                                            {
                                                "example_id": "279b3526-636f-418a-bf13-f4a1a68dddde",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Teufels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
