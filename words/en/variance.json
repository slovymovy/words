{
    "word_family": [
        "vary",
        "variable",
        "variation",
        "variant",
        "variability",
        "varied",
        "invariable",
        "unvarying"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dc9e456-6e9a-358d-9969-65cbfaef1764",
                    "sense_definition": "A difference between what is expected and what is observed; a deviation or discrepancy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers noted a significant <w>variance</w> between the predicted results and the actual data collected.",
                            "target_lang_translations": {
                                "ru": "Исследователи отметили значительное <w>расхождение</w> между прогнозируемыми результатами и фактически собранными данными."
                            }
                        },
                        {
                            "text": "There was a slight <w>variance</w> from expected figures in the final quarterly report.",
                            "target_lang_translations": {
                                "ru": "В итоговом квартальном отчете наблюдалось небольшое <w>отклонение</w> от ожидаемых показателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "discrepancy",
                        "deviation",
                        "divergence"
                    ],
                    "antonyms": [
                        "consistency",
                        "uniformity"
                    ],
                    "common_phrases": [
                        "variance from expected figures",
                        "significant variance",
                        "slight variance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разница между ожидаемым и наблюдаемым значением; отклонение или несоответствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расхождение",
                                "target_lang_sense_clarification": "несовпадение или противоречие в данных"
                            },
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "разница по сравнению с нормой или ориентиром"
                            },
                            {
                                "target_lang_word": "несоответствие",
                                "target_lang_sense_clarification": "отсутствие согласованности между фактами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5b41648-d93d-3a11-9974-461866a8ae2a",
                    "sense_definition": "An official permit to do something that is ordinarily forbidden by regulations, especially in zoning.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_permit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The homeowner had to apply for a zoning <w>variance</w> to build a taller fence than allowed.",
                            "target_lang_translations": {
                                "ru": "Домовладельцу пришлось подать заявку на <w>разрешение на отклонение</w> от норм зонирования, чтобы построить забор выше разрешенного."
                            }
                        },
                        {
                            "text": "The city council granted a <w>variance</w> for the new commercial development project.",
                            "target_lang_translations": {
                                "ru": "Городской совет предоставил <w>разрешение на исключение</w> из правил для нового проекта коммерческой застройки."
                            }
                        }
                    ],
                    "synonyms": [
                        "exception",
                        "exemption",
                        "waiver"
                    ],
                    "common_phrases": [
                        "zoning variance",
                        "grant a variance",
                        "apply for a variance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal and administrative context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение на действие, которое обычно запрещено правилами, особенно в градостроительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрешение на отклонение",
                                "target_lang_sense_clarification": "от градостроительных норм"
                            },
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "из общих правил или регламентов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6efce0d-9c59-3672-a843-acc8aa1b53fb",
                    "sense_definition": "The square of the standard deviation; a measure of how far a set of numbers is spread out from their average value.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In statistics, <w>variance</w> measures how far each number in the set is from the mean.",
                            "target_lang_translations": {
                                "ru": "В статистике <w>дисперсия</w> измеряет, насколько далеко каждое число в наборе находится от среднего значения."
                            }
                        },
                        {
                            "text": "A low <w>variance</w> indicates that the data points tend to be very close to the mean.",
                            "target_lang_translations": {
                                "ru": "Низкая <w>дисперсия</w> указывает на то, что точки данных, как правило, находятся очень близко к среднему значению."
                            }
                        }
                    ],
                    "common_phrases": [
                        "low variance",
                        "high variance",
                        "analysis of variance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical/mathematical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Квадрат стандартного отклонения; мера разброса набора чисел относительно их среднего значения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисперсия",
                                "target_lang_sense_clarification": "статистический показатель разброса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "814ab826-8cb8-3b1e-a607-5e859e3aca93",
                    "sense_definition": "The state of differing or being in conflict; a state of disagreement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His actions were at <w>variance</w> with his stated intentions.",
                            "target_lang_translations": {
                                "ru": "Его действия шли <w>вразрез</w> с его заявленными намерениями."
                            }
                        },
                        {
                            "text": "The two witnesses gave accounts that were in complete <w>variance</w> with each other.",
                            "target_lang_translations": {
                                "ru": "Двое свидетелей дали показания, которые находились в полном <w>противоречии</w> друг с другом."
                            }
                        }
                    ],
                    "synonyms": [
                        "discord",
                        "dissension",
                        "disagreement"
                    ],
                    "antonyms": [
                        "harmony",
                        "agreement",
                        "accord"
                    ],
                    "common_phrases": [
                        "at variance with",
                        "in variance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние расхождения или конфликта; несогласие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разногласие",
                                "target_lang_sense_clarification": "отсутствие единства во мнениях или интересах"
                            },
                            {
                                "target_lang_word": "противоречие",
                                "target_lang_sense_clarification": "несовместимость фактов или утверждений"
                            },
                            {
                                "target_lang_word": "расхождение",
                                "target_lang_sense_clarification": "несогласие с кем-либо или чем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}