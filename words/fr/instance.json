                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le programmeur a créé une nouvelle <w>instance</w> pour gérer les données de chaque utilisateur."
                        },
                        {
                            "text": "Il faut redémarrer l'<w>instance</w> du serveur web pour appliquer les récentes modifications."
                        }
                    ],
                    "common_phrases": [
                        "créer une instance",
                        "nouvelle instance",
                        "instance de classe"
                    ]
                },
                {
