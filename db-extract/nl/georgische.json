                                    },
                                    {
                                        "sense_id": "e8c56346-b85f-3450-bd71-f4cb229be166",
                                        "entry_id": "3b87e28c-9cf6-32e5-a4a9-07bc308b7acb",
                                        "glosses": [
                                            "A native or resident of the state of Georgia in the United States of America."
                                        ],
