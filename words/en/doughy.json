{
    "word_family": [
        "dough"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de4671e0-fc3f-3a30-a5c9-47066366c8bc",
                    "sense_definition": "Having the consistency or appearance of raw dough",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bread was still <w>doughy</w> in the middle because it was not baked long enough.",
                            "target_lang_translations": {
                                "zh": "面包中间还是<w>未烤熟的</w>，因为烤的时间不够长。",
                                "ru": "Хлеб остался внутри <w>непропечённым</w>, потому что его недостаточно долго держали в печи."
                            }
                        },
                        {
                            "text": "She touched the <w>doughy</w> mixture to see if it was ready to be shaped.",
                            "target_lang_translations": {
                                "zh": "她摸了摸那团<w>软塌塌的</w>混合物，看看是否可以塑形了。",
                                "ru": "Она потрогала эту <w>тестообразную</w> смесь, чтобы проверить, готова ли она к формовке."
                            }
                        }
                    ],
                    "synonyms": [
                        "soft",
                        "unbaked"
                    ],
                    "antonyms": [
                        "crisp",
                        "firm"
                    ],
                    "common_phrases": [
                        "doughy texture"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有生面团的质地或外观",
                        "ru": "Имеющий консистенцию или вид сырого теста; непропечённый"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "未烤熟的",
                                "target_lang_sense_clarification": "指食物内部因未烤透而呈现生面团状"
                            },
                            {
                                "target_lang_word": "软塌塌的",
                                "target_lang_sense_clarification": "形容质地像面团一样柔软且缺乏弹性"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "непропечённый",
                                "target_lang_sense_clarification": "о хлебе или выпечке, оставшейся сырой внутри"
                            },
                            {
                                "target_lang_word": "тестообразный",
                                "target_lang_sense_clarification": "имеющий мягкую консистенцию сырого теста"
                            },
                            {
                                "target_lang_word": "сырой",
                                "target_lang_sense_clarification": "недопечённый внутри"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd14d3ac-35c8-3b92-8521-3c3d5e3f905f",
                    "sense_definition": "Pale and flabby in appearance",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked <w>doughy</w> and tired after spending all winter indoors without any exercise.",
                            "target_lang_translations": {
                                "zh": "整个冬天他都待在室内不运动，看起来<w>苍白松弛</w>且疲惫不堪。",
                                "ru": "Проведя всю зиму дома без физических нагрузок, он выглядел <w>рыхлым</w> и усталым."
                            }
                        },
                        {
                            "text": "The actor had a <w>doughy</w> complexion that made him look much older than he was.",
                            "target_lang_translations": {
                                "zh": "这位演员肤色<w>苍白松弛</w>，让他看起来比实际年龄老得多。",
                                "ru": "У актёра был <w>пастозный</w> цвет лица, из-за чего он казался значительно старше своего возраста."
                            }
                        }
                    ],
                    "synonyms": [
                        "pasty",
                        "flabby"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容人面色苍白且身体松弛",
                        "ru": "Бледный, рыхлый или одутловатый на вид"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "苍白松弛的",
                                "target_lang_sense_clarification": "形容人缺乏锻炼，肤色苍白且肌肉松软"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рыхлый",
                                "target_lang_sense_clarification": "о теле или внешности, лишённой тонуса"
                            },
                            {
                                "target_lang_word": "пастозный",
                                "target_lang_sense_clarification": "о бледной и слегка отекшей коже или лице"
                            },
                            {
                                "target_lang_word": "одутловатый",
                                "target_lang_sense_clarification": "о лице или внешности"
                            },
                            {
                                "target_lang_word": "дряблый",
                                "target_lang_sense_clarification": "о мягких, дряблых мышцах или теле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "935d173d-a8f9-3bb5-9d20-096cdbf89e53",
                    "sense_definition": "A person who bakes bread or pastries",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>doughies</w> gathered early in the morning to prepare the daily supply of fresh bread.",
                            "target_lang_translations": {
                                "zh": "当地的<w>面包师</w>们清晨就聚在一起，准备当天供应的新鲜面包。",
                                "ru": "Местные <w>пекари</w> собрались рано утром, чтобы приготовить дневной запас свежего хлеба."
                            }
                        },
                        {
                            "text": "Many skilled <w>doughies</w> take great pride in their traditional sourdough recipes.",
                            "target_lang_translations": {
                                "zh": "许多技艺精湛的<w>面包师</w>对他们传统的酸种面包配方引以为傲。",
                                "ru": "Многие искусные <w>булочники</w> очень гордятся своими традиционными рецептами на закваске."
                            }
                        }
                    ],
                    "synonyms": [
                        "baker"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal or dated term for a baker"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指制作面包或糕点的人",
                        "ru": "Пекарь, человек, выпекающий хлеб или кондитерские изделия (разг., устар.)"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "面包师",
                                "target_lang_sense_clarification": "指专业制作面包的人"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пекарь",
                                "target_lang_sense_clarification": "мастер по выпечке хлебобулочных изделий"
                            },
                            {
                                "target_lang_word": "булочник",
                                "target_lang_sense_clarification": "человек, выпекающий хлеб"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}