                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "materiau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le toit du hangar a été entièrement reconstruit avec de la <w>tôle</w> ondulée.",
                            "target_lang_translations": {
                                "en": "The roof of the shed has been completely rebuilt with corrugated <w>sheet metal</w>.",
                                "ru": "Крыша ангара полностью перестроена с использованием волнистой <w>жести</w>.",
                                "de": "Das Dach des Schuppens wurde komplett mit <w>Wellblech</w> neu gedeckt.",
                                "es": "El techo del cobertizo se ha reconstruido por completo con <w>chapa</w> ondulada.",
                                "zh": "棚屋的屋顶已经全部用波纹<w>铁皮</w>重新搭建。"
                            }
                        },
                        {
                            "text": "L'artisan découpe une plaque de <w>tôle</w> pour consolider la structure du véhicule.",
                            "target_lang_translations": {
                                "en": "The craftsman cuts a panel of <w>sheet metal</w> to strengthen the structure of the vehicle.",
                                "ru": "Мастер вырезает пластину из <w>листового металла</w>, чтобы укрепить конструкцию автомобиля.",
                                "de": "Der Handwerker schneidet ein Stück <w>Blech</w> zu, um die Struktur des Fahrzeugs zu verstärken.",
                                "es": "El artesano corta una plancha de <w>chapa</w> para reforzar la estructura del vehículo.",
                                "zh": "工匠剪下一块<w>铁皮</w>，用来加固车辆的结构。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tôle ondulée",
                        "toit en tôle",
                        "cabane en tôle"
                    ],
                    "target_lang_definitions": {
