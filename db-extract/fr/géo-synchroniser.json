                    {
                        "sense_id": "7b1a30b9-e3b7-31eb-a3c4-8cdd4fc97df3",
                        "entry_id": "ceab5330-cb0b-31e7-a542-2b60c57f1154",
                        "glosses": [
                            "Réconcilier des repères géographiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2feecc20-8f76-40f9-b231-0fb55d2b30f8",
                                "sense_id": "7b1a30b9-e3b7-31eb-a3c4-8cdd4fc97df3",
                                "text": "Le visualiseur cartographique est un outil dont la fonction première est d’appeler un ou plusieurs services web de diffusion cartographique selon une vue utilisateur, d’en récupérer des données cartographiques sous forme d’images et de géo-synchroniser (superposer en faisant coïncider des coordonnées repères)."
                            },
                            {
                                "example_id": "e72feab3-c436-463a-861c-46b23802d3ed",
                                "sense_id": "7b1a30b9-e3b7-31eb-a3c4-8cdd4fc97df3",
                                "text": "Le visualiseur, responsable de la superposition des couches cartographiques, géo-synchronise les images."
                            }
                        ]
                    },
                    {
                        "sense_id": "e645f993-8d78-3708-b60d-e06f94b055ef",
                        "entry_id": "ceab5330-cb0b-31e7-a542-2b60c57f1154",
                        "glosses": [
                            "Pointer une antenne vers un satellite géosynchrone."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8c381bec-ecc3-4705-b72b-0150cb0897ec",
                                "sense_id": "e645f993-8d78-3708-b60d-e06f94b055ef",
                                "text": "Mais là, j’ai une station à géo-synchroniser."
                            }
                        ]
                    }
