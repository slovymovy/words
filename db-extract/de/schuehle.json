                "senses": [
                    {
                        "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                        "entry_id": "adbe1db3-f7ed-3925-aabe-ce46a1dd25d3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65174c6-d91f-4ad3-a750-06ffc40e042f",
                                "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                                "text": "Frau Schuehle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c055dbdd-3b1e-464c-b4eb-67eb1e8cbe1c",
                                "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                                "text": "Herr Schuehle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "67e259b2-8b07-4ffc-b89b-6bbc18801845",
                                "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                                "text": "Die Schuehles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "21baf451-37bf-40f1-9956-42f7cda278c3",
                                "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                                "text": "Der Schuehle trägt nie die Schals, die die Schuehle ihm strickt."
                            },
                            {
                                "example_id": "25a23ac8-b660-488b-9a62-bcf5b64e5293",
                                "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schuehle kommt, geht der Herr Schuehle.“"
                            },
                            {
                                "example_id": "e1e2f9c8-f509-4c6d-8511-dee7e29eec8b",
                                "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                                "text": "Schuehle kommt und geht."
                            },
                            {
                                "example_id": "cd0d599d-0520-44b3-9b09-31be2eab20f8",
                                "sense_id": "9a1b4e62-3970-34a3-a782-6594086cb876",
                                "text": "Schuehles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
