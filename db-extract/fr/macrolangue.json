                        "source_entry_id": "5b30aca3-3ad6-3572-9920-3209cb7cfdbe",
                        "source_sense_id": "38b974f5-6cac-304e-b7e9-14491313ffbe",
                        "target_lang_word": "macrotaal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macrotaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8e9ebe3a-65f8-32d8-b8be-d646b344a86c",
                                        "entry_id": "0972546d-09fe-361a-8141-2ac54c6b2aeb",
                                        "glosses": [
                                            "eenvoudige programmeertaal binnen een toepassingsprogramma"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad96cf3b-69a5-43ef-a0b3-c7ac9b7b846c",
                                                "sense_id": "8e9ebe3a-65f8-32d8-b8be-d646b344a86c",
                                                "text": "Naast procedures kunt u in de macrotaal ook zelf een functie schrijven."
                                            },
                                            {
                                                "example_id": "ae416d37-b8ce-424d-8f9e-29121bfb3f93",
                                                "sense_id": "8e9ebe3a-65f8-32d8-b8be-d646b344a86c",
                                                "text": "De Advocaat-Generaal bij het Hof van Justitie heeft in een conclusie van 29 november 2011 geconcludeerd dat een macrotaal en een bestandsformaat niet auteursrechtelijk beschermd zijn en dat een concurrent mag decompileren ten behoeve van interoperabiliteit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b8b3cd5-fb7d-3bc9-95b4-26872ef6746f",
                                        "entry_id": "0972546d-09fe-361a-8141-2ac54c6b2aeb",
                                        "glosses": [
                                            "groep talen die ook wel gezamenlijk als één taal worden beschouwd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b68f35d-cf71-4712-9363-216ae24d9bea",
                                                "sense_id": "5b8b3cd5-fb7d-3bc9-95b4-26872ef6746f",
                                                "text": "Volgens Lewis (2009) is het Chinees niet een taal maar een macrotaal of overkoepelende taal voor een groep talige variëteiten. Als macrotaal heeft het Chinees dertien member languages: Gan, Hakka, Huizhou, Jinyu, Mandarijn, Min Bei, Min Dong, Min Nan, Min Zhong, Pu-Xian, Wu, Xiang en Yue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf248219-ab9e-30e9-b3be-ec7fd298d75b",
                                        "entry_id": "0972546d-09fe-361a-8141-2ac54c6b2aeb",
                                        "glosses": [
                                            "abstract woordgebruik dat vooral geschikt is om grootschalige kwesties te beschrijven en niet goed aansluit bij de belevingswereld van veel mensen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b80e7231-d070-4975-9dcd-ab9eed2cfc56",
                                                "sense_id": "cf248219-ab9e-30e9-b3be-ec7fd298d75b",
                                                "text": "Nee, volgens hoogwaardigheidsbekleders moet het hulpbedrag nog verder omhoog, want dat zou Afrika verder ontwikkelen en zo Afrikanen weerhouden om als economische vluchteling naar Europa te komen. Cynisch. Tegelijk weten we dat de noordelijke handelsbelemmeringen Afrika naar schatting vijf keer meer kosten dan het continent aan hulp ontvangt. Nog cynischer.\nGoed, van macrotaal naar een kleinere schaal. Een gezin, een dorp, een kind, een jongere, een schooltje, een kliniekje, ergens op het onmetelijke platteland van Afrika. Ik heb er zo veel bezocht. Ik zie geen statistieken. Nee, ik zit in een hut en krijg een maaltijd voorgeschoteld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
