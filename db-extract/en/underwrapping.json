                "senses": [
                    {
                        "sense_id": "88f76c4e-989d-34bb-a9a1-12764b7c2633",
                        "entry_id": "e151322c-658a-3ebc-ae9c-2d378b371caa",
                        "glosses": [
                            "The act of underwrapping something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3adb8a8-dc44-4f70-9da5-16aa69913913",
                                "sense_id": "88f76c4e-989d-34bb-a9a1-12764b7c2633",
                                "text": "Mechanised underwrapping and the rapid, efficient, automatic cross-tying of newspaper bundles are forging the final link of complete automation in the mailing rooms not only of many of the United Kingdom's major newspaper houses but also leading publishing houses in overseas countries."
                            },
                            {
                                "example_id": "5f114a95-3ad0-4ba6-9e12-7614083d33f3",
                                "sense_id": "88f76c4e-989d-34bb-a9a1-12764b7c2633",
                                "text": "In the Power Strap Inc. booth, a demonstration of bundle underwrapping and overwrapping draws rapt attention."
                            },
                            {
                                "example_id": "882c2c02-7e83-42c5-9bf0-85dee9f16e8b",
                                "sense_id": "88f76c4e-989d-34bb-a9a1-12764b7c2633",
                                "text": "A threaded screw assembly inside the knob prevents either the overwrapping or underwrapping of the IABP."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5fd176e-1b99-32c8-a191-b7c40dc3d8d2",
                        "entry_id": "e151322c-658a-3ebc-ae9c-2d378b371caa",
                        "glosses": [
                            "A material that forms an underwrapped layer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "114ca70f-6cd1-47a7-aa70-f4bce53c6e0e",
                                "sense_id": "a5fd176e-1b99-32c8-a191-b7c40dc3d8d2",
                                "text": "How carefully done up — tissue-paper underwrapping as well !"
                            },
                            {
                                "example_id": "5628d829-2798-4a7c-826b-90be0c3712e0",
                                "sense_id": "a5fd176e-1b99-32c8-a191-b7c40dc3d8d2",
                                "text": "An underwrapping of thin polyester urethane foam may be applied next."
                            },
                            {
                                "example_id": "d2b9ed12-3288-4199-a18f-c8683483d74a",
                                "sense_id": "a5fd176e-1b99-32c8-a191-b7c40dc3d8d2",
                                "text": "Petey loosened the underwrapping of thin paper carefully, and Sally craned her neck for a first glimpse of the flowers."
                            }
                        ]
                    },
                    {
                        "sense_id": "e49b20e4-7635-3e77-9096-2a8c7ec54d21",
                        "entry_id": "e151322c-658a-3ebc-ae9c-2d378b371caa",
                        "glosses": [
                            "A state of being insufficiently desolvated, so that the main chain of hydrogen bonds in a protein are too accessible, rendering the protein unstable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e52e1cc7-204f-4a2c-981b-e218f6b5b30f",
                                "sense_id": "e49b20e4-7635-3e77-9096-2a8c7ec54d21",
                                "text": "Crystal structures from PDB were analyzed totest whether duplicability of a geneis affected by its underwrapping (Liang et al., 2008)."
                            },
                            {
                                "example_id": "1bdb92e7-9877-42fb-ae8a-18a9c73cc390",
                                "sense_id": "e49b20e4-7635-3e77-9096-2a8c7ec54d21",
                                "text": "However, protein underwrapping is only one cause of dosage effects."
                            },
                            {
                                "example_id": "acf1aa33-f374-48db-a34e-9eec9d2125dd",
                                "sense_id": "e49b20e4-7635-3e77-9096-2a8c7ec54d21",
                                "text": "Cross-examination of genetic and structural information revealed that the underwrapping or packing deficiency of a protein, ν, is a molecular quantifier of dosage sensitivity [5] precisely because it constitutes a measure of the reliance of the protein on binding partnerships to maintain the integrity of the native fold."
                            }
                        ]
                    }
