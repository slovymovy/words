                                "target_lang_sense_clarification": "having a financial share"
                            },
                            {
                                "target_lang_word": "participant",
                                "target_lang_sense_clarification": "in an activity or project"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ebcc708-b837-3b5c-84cd-1a4e885bb565",
                    "sense_definition": "Iemand met wie men gevoelens, geheimen of ervaringen deelt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "partner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij besloot haar beste vriendin <w>deelgenoot</w> te maken van haar diepste geheimen.",
                            "target_lang_translations": {
                                "en": "She decided to make her best friend a <w>confidante</w> of her deepest secrets."
                            }
                        },
                        {
                            "text": "Het is fijn om een <w>deelgenoot</w> te hebben in tijden van verdriet.",
                            "target_lang_translations": {
