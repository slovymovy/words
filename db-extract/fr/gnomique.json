                        "form": "gnomiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55e7124c-7f5f-389b-877e-53a7bd5475da",
                        "entry_id": "8962f594-a9f6-3bea-b4d4-31403bf2a1af",
                        "glosses": [
                            "Qui contient des sentences."
                        ],
                        "tags": [
                            "Littérature ancienne"
                        ],
                        "examples": [
                            {
                                "example_id": "3d3d965f-58d2-4825-97d4-93fd5c1c3ad3",
                                "sense_id": "55e7124c-7f5f-389b-877e-53a7bd5475da",
                                "text": "Un langage métaphorique, tel celui de la littérature populaire, avec un caractère gnomique : des sentences apparaissent."
                            },
                            {
                                "example_id": "5e7b6f34-42dc-426b-8f17-f9a2dfc7ba93",
                                "sense_id": "55e7124c-7f5f-389b-877e-53a7bd5475da",
                                "text": "Des moralistes chrétiens adaptaient aussi à leur foi le legs de la littérature gnomique d'Alexandrie, celui des maximes.",
                                "translation": "Après Jésus. L'invention du christianisme, sous la dir. de Roselyne Dupont-Roc et Antoine Guggenheim, Albin Michel, 2020, p. 509."
                            },
                            {
                                "example_id": "68af7068-5a75-4192-9b6a-bf1d02f24e41",
                                "sense_id": "55e7124c-7f5f-389b-877e-53a7bd5475da",
                                "text": "L'aoriste gnomique."
                            }
                        ]
                    },
                    {
                        "sense_id": "40874364-594d-3da3-a84c-0a73e7ef4977",
                        "entry_id": "8962f594-a9f6-3bea-b4d4-31403bf2a1af",
                        "glosses": [
                            "Qui compose des poèmes en forme de sentences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c561cd-4295-4966-8001-8345eccf4d1c",
                                "sense_id": "40874364-594d-3da3-a84c-0a73e7ef4977",
                                "text": "Les poètes gnomiques."
                            },
                            {
                                "example_id": "676ee016-4e88-455d-927c-424f30effae2",
                                "sense_id": "40874364-594d-3da3-a84c-0a73e7ef4977",
                                "text": "Il existe aussi dans la littérature gauloise des poèmes appelés gnomiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb129321-f8f4-32cc-a7e4-5eaafdf5a4ab",
                        "entry_id": "8962f594-a9f6-3bea-b4d4-31403bf2a1af",
                        "glosses": [
                            "Qui tient du gnomisme, qui énonce des vérités présentées comme générales, valables à toutes les époques et à caractère universel."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "df73ea24-a1b7-362f-b239-d1ab8ef6ec3a",
                        "entry_id": "8962f594-a9f6-3bea-b4d4-31403bf2a1af",
                        "glosses": [
                            "Se dit d’un temps verbal ou d’un mode qui sert à exprimer une idée générale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cfe8f1e-8e7e-4825-9252-1ac81973612a",
                                "sense_id": "df73ea24-a1b7-362f-b239-d1ab8ef6ec3a",
                                "text": "Le présent gnomique est intemporel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a15b645-56d1-4d3f-87b4-1a79e6fa259c",
                        "source_entry_id": "8962f594-a9f6-3bea-b4d4-31403bf2a1af",
                        "target_lang_word": "gnomic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnomic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96ebd4d7-512b-366f-9ae5-e7e0395034c6",
                                        "entry_id": "8e4b6655-74f4-3a1c-b168-5a59187f1ac9",
                                        "glosses": [
                                            "Of, or relating to gnomes (sententious sayings)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "636987fb-a38f-4684-9bef-68dd93e51e73",
                                                "sense_id": "96ebd4d7-512b-366f-9ae5-e7e0395034c6",
                                                "text": "His birth-place was Colophon, an Ionian city of Asia-Minor; a city long famous as the seat of elegiac and gnomic poetry, and ranking the poet Minmermus amongst its celebrated men."
                                            },
                                            {
                                                "example_id": "88f1f3c3-0930-4632-b3bd-72c78f345413",
                                                "sense_id": "96ebd4d7-512b-366f-9ae5-e7e0395034c6",
                                                "text": "Old English culture was threaded through with riddles, cryptograms, gnomic verses, charms and riddling modes of speech such as litotes, just as Modern English culture is (if you will forgive me) riddled with jokes and catch-phrases, crosswords and quizzes, irony and sarcasm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                        "entry_id": "8e4b6655-74f4-3a1c-b168-5a59187f1ac9",
                                        "glosses": [
                                            "Mysterious and often incomprehensible yet seemingly wise."
                                        ],
                                        "tags": [
                                            "of a saying or aphorism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a66e0f7-c419-4ad5-a7a9-5725e40589ce",
                                                "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                                "text": "He always makes gnomic utterances."
                                            },
                                            {
                                                "example_id": "e5d28387-1f0b-4566-ba1f-9a80ecdc61ff",
                                                "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                                "text": "The gnomic belief that the world is conditioned by love is no idle apothegm."
                                            },
                                            {
                                                "example_id": "88d0ea70-62d3-459f-ae15-7de3c1e5680a",
                                                "sense_id": "ea09063d-6bbc-3d91-bd11-082e0d86eab6",
                                                "text": "In his part gnomic, part mechanic’s style, Mr. Pirsig’s narrator declares that the real world is a seamless continuum of the material and metaphysical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a20595b-a5ae-3aaf-92f3-343346899d83",
                                        "entry_id": "8e4b6655-74f4-3a1c-b168-5a59187f1ac9",
                                        "glosses": [
                                            "Expressing general truths or aphorisms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a150d78-1e72-4910-a326-16957bff9ce9",
                                                "sense_id": "5a20595b-a5ae-3aaf-92f3-343346899d83",
                                                "text": "gnomic aspect"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
