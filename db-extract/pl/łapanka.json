                        "source_sense_id": "cff4fd9b-81b8-3637-ad1a-040286723406",
                        "target_lang_word": "rafle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rafle",
