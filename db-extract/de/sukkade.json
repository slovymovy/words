                "senses": [
                    {
                        "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                        "entry_id": "2ab64b64-1e19-3c83-86dc-247814737ad0",
                        "glosses": [
                            "in Zucker gelegte/kandierte, gewürfelte Schale einer Zitrusfrucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ebaee99-7861-438b-bddc-929b70f702e2",
                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                "text": "„Stinknormaler Rosinenkuchen wäre genießbar gewesen, aber mit Sukkade darin mochte ich ihn noch nie.“"
                            },
                            {
                                "example_id": "46c8b260-d18b-460c-837d-70ec8bef3113",
                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                "text": "„Alois trabte mit einem riesigen Napfkuchen herbei, der gespickt war mit Rosinen, Mandeln und grüner Sukkade.“"
                            },
                            {
                                "example_id": "b0a57ac2-7a02-48b4-bd31-1de42b8f5896",
                                "sense_id": "d46c0b3f-d558-393b-bd07-8e5dea08f2f2",
                                "text": "„Bekanntlich ist in einer Reihe von Ländern die Herstellung von Sukkaden (kandierte Zitrusfrüchte) gut organisiert. In unserer Industrie fand dies zunächst nicht die erforderliche Entwicklung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
