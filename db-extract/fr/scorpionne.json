                "senses": [
                    {
                        "sense_id": "2fb7064e-dad4-3810-b63d-1e095bf428fe",
                        "entry_id": "e16dce4e-f969-317d-84cc-be20b15f23b5",
                        "glosses": [
                            "Scorpion femelle."
                        ],
                        "tags": [
                            "Arthropodologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5a4664b6-6b35-4d7a-9124-3ce95d2ad5b9",
                                "sense_id": "2fb7064e-dad4-3810-b63d-1e095bf428fe",
                                "text": "Et pourtant, que de soins la Scorpionne n’a-t-elle pas apportés à sa progéniture !"
                            },
                            {
                                "example_id": "6dbfec25-1872-436f-9f30-73a6f12a49f5",
                                "sense_id": "2fb7064e-dad4-3810-b63d-1e095bf428fe",
                                "text": "Scorpionne avec ses bébés sur le dos"
                            }
                        ]
                    },
                    {
                        "sense_id": "3200a276-9537-30b5-8a99-19e215a74568",
                        "entry_id": "e16dce4e-f969-317d-84cc-be20b15f23b5",
                        "glosses": [
                            "Femme perfide capable de frapper dans le dos."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "84899e1d-224d-4e78-b859-b5e27c56b22e",
                                "sense_id": "3200a276-9537-30b5-8a99-19e215a74568",
                                "text": "À peu près à chaque crime… Que tu aies été l’ange vengeur ou la scorpionne, c'est fait"
                            }
                        ]
                    },
                    {
                        "sense_id": "d2021a2a-73d7-3734-8cba-26246d029de3",
                        "entry_id": "e16dce4e-f969-317d-84cc-be20b15f23b5",
                        "glosses": [
                            "Femme née sous le signe du Scorpion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a8b3d6-b931-4b08-a036-4db4a72adc5f",
                                "sense_id": "d2021a2a-73d7-3734-8cba-26246d029de3",
                                "text": "La scorpionne serait suicidaire et la vierge folle, pourtant rien de ceci n’est vraiment un signe."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f14ffc3-4b5b-365c-b5f9-4b0546ca72b6",
                        "entry_id": "e16dce4e-f969-317d-84cc-be20b15f23b5",
                        "glosses": [
                            "Autre nom de la queue-de-scorpion, plante fourragère, genre Scorpiurus L."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa61548-63bd-43c7-8d1a-0d30d66ceeab",
                                "sense_id": "0f14ffc3-4b5b-365c-b5f9-4b0546ca72b6",
                                "text": "Chenillette (Scorpiurus), Queue de scorpion, Vermiculaire, Chenille muriquée, Scorpionne. Petites plantes annuelles, herbacées, voisines des Luzernes (Medicago), que l’on sème sur place terreautée, et que l’on cultive pour la bizarrerie de leurs fruits, qui sont hérissés, écailleux, sillonnés, et imitent parfaitement une chenille, quelquefois un limaçon ou un ver. On les met dans la salade pour surprendre les personnes qui ne connaissent pas ces singulières plantes. Les graines sont très difficiles à extraire des gousses ; il faut déchirer celles-ci pour parvenir à extraire celles-là."
                            }
                        ]
                    }
                ],
