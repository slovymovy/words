            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db47246b-fa38-301a-b8a9-cdeab5cc0f32",
                    "sense_definition": "The point or moment where something begins or arises.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The custom has its <w>origin</w> in ancient Greece.",
                            "target_lang_translations": {
                                "ru": "Этот обычай берет свое <w>начало</w> в Древней Греции.",
                                "zh": "这种习俗<w>起源</w>于古希腊。"
                            }
                        },
                        {
                            "text": "Scientists are still studying the <w>origin</w> of the universe.",
                            "target_lang_translations": {
                                "ru": "Ученые до сих пор изучают <w>происхождение</w> Вселенной.",
                                "zh": "科学家们仍在研究宇宙的<w>起源</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beginning"
                    ],
                    "antonyms": [
                        "end"
                    ],
                    "common_phrases": [
                        "place of origin",
                        "point of origin",
                        "unknown origin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точка или момент, когда что-то начинается или возникает.",
                        "zh": "事物开始或产生的时刻或地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происхожде́ние",
