                                                "example_id": "a6af0855-3c66-43ae-b090-642bbc1d4f32",
                                                "sense_id": "584263b6-c721-35e8-916d-711749ff07ec",
                                                "text": "The manifold meanings of the English word set are infamous among lexicographers."
                                            },
                                            {
                                                "example_id": "eb6df558-f69f-4e93-9960-cc8ee6240ed3",
                                                "sense_id": "584263b6-c721-35e8-916d-711749ff07ec",
                                                "text": "[E]ch man as he receyuede grace, mynistringe ‘it in to ech other, as goode dispenderes of the manyfolde grace of God.",
                                                "translation": "Each man as he hath received grace, ministering it unto each other, as good dispensers of the manyfold grace of God.",
                                                "english": "Each man as he hath received grace, ministering it unto each other, as good dispensers of the manyfold grace of God."
                                            },
                                            {
                                                "example_id": "108d89e6-3de9-4d81-86c8-63dd378bc78e",
                                                "sense_id": "584263b6-c721-35e8-916d-711749ff07ec",
                                                "text": "To the intent that now vnto the principalities and powers in heauenly places, might be knowen by the church, the manifold wisedome of God, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "540d1f8a-88b6-3991-86fa-abad73f58c65",
                                        "entry_id": "290e4caa-70c9-3300-b002-1a4db9aa9426",
                                        "glosses": [
                                            "Many in number; numerous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c938eebd-63dc-442f-95c2-06592ec7ef31",
                                                "sense_id": "540d1f8a-88b6-3991-86fa-abad73f58c65",
                                                "text": "And although we be vnworthy (through our manyfolde ſynnes) to offre vnto thee any Sacryfice: Yet we beſeche thee to accepte thys our bounden duetie and ſeruice: and commande theſe our prayers and ſupplicacions, by the Miniſtery of thy holy Angels, to be brought vp into thy holy Tabernacle before the ſyght of thy dyuine maieſtie: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e714531-c192-3524-a61f-40ff74ba1c29",
                                        "entry_id": "290e4caa-70c9-3300-b002-1a4db9aa9426",
                                        "glosses": [
                                            "Complicated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
