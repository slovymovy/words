                "senses": [
                    {
                        "sense_id": "8000c320-a06e-31d4-a8d8-9ca3e8896b90",
                        "entry_id": "e7fca33d-363b-38de-94d1-59817c018073",
                        "glosses": [
                            "To revoke or deny the citizenship of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9cd3a2f3-69bb-46ab-b398-68cb31040ac8",
                                "sense_id": "8000c320-a06e-31d4-a8d8-9ca3e8896b90",
                                "text": "After the regime fell, the leader was executed and the principal party members were denaturalized and deported."
                            },
                            {
                                "example_id": "640342da-00b5-420f-b4de-0348a3b155e3",
                                "sense_id": "8000c320-a06e-31d4-a8d8-9ca3e8896b90",
                                "text": "For decades, the US Department of Justice has used a tool to sniff out former Nazis who lied their way into becoming American citizens: a law that allowed the department to denaturalize, or strip, citizenship from criminals who falsified their records or hid their illicit pasts."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae0edf88-4884-30bc-86a1-fd79263145e5",
                        "entry_id": "e7fca33d-363b-38de-94d1-59817c018073",
                        "glosses": [
                            "To make less natural; to cause to deviate from its nature."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "84722c4f-f713-4291-a46e-72837d00d73f",
                                "sense_id": "ae0edf88-4884-30bc-86a1-fd79263145e5",
                                "text": "Henchard was, by original make, the last man to act stealthily, for good or for evil. But the solicitus timor of his love — the dependence upon Elizabeth's love into which he had declined (or, in another sense, to which he had advanced) — denaturalized him."
                            }
                        ]
                    },
                    {
                        "sense_id": "afa51233-a331-316a-94fa-89e75b36b2cb",
                        "entry_id": "e7fca33d-363b-38de-94d1-59817c018073",
                        "glosses": [
                            "To cease to treat as natural."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c6fe6df3-9ba2-4f13-b185-6c25e9d1ec32",
                                "sense_id": "afa51233-a331-316a-94fa-89e75b36b2cb",
                                "text": "One question these scenes pose for cultural theory is whether such depictions denaturalize rape and denormalize masculinist pleasure in viewing sexual violence."
                            }
                        ]
                    }
