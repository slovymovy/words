                        "translation_id": "3d9b3eb6-10a6-4fbf-8784-59255989d94d",
                        "source_entry_id": "00ea0cce-cfe7-3d1c-b7d5-b449a9af8019",
                        "source_sense_id": "97d1cd8b-571d-385f-98d5-d7ec6f42fe41",
                        "target_lang_word": "dupe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dupe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff19d1c4-001a-36e3-b5ec-4727534ea14e",
                                        "entry_id": "57acf07f-2608-320e-b4ae-cdd237f6a004",
                                        "glosses": [
                                            "A person who has been deceived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9302a42c-6b81-41ae-841e-b7e02c3f1c79",
                                                "sense_id": "ff19d1c4-001a-36e3-b5ec-4727534ea14e",
                                                "text": "It would vex me, indeed, to see you again the dupe of Miss Bingley's pretended regard."
                                            },
                                            {
                                                "example_id": "3ef4e9ca-6bbe-4a8b-9590-2a7d640eb372",
                                                "sense_id": "ff19d1c4-001a-36e3-b5ec-4727534ea14e",
                                                "text": "I am responding to Allen Young's letter to the editor concerning two articles I wrote for GCN about my experiences in Cuba. The gist of Mr. Young's letter is that I am a commie dupe and the Cubans who shared there opinions and experiences with me were simply lying."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dupe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e39695d-abb5-3731-851c-1dd1efb7655c",
                                        "entry_id": "8d7c5cd6-d841-3daf-be80-cc3ddb70676f",
                                        "glosses": [
                                            "To swindle, deceive, or trick."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dupe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af997dd4-b172-3ad7-b011-d5dc895ebc10",
                                        "entry_id": "e31d3d01-0aaf-3d00-9e9c-7b6203aad456",
                                        "glosses": [
                                            "A duplicate. Often:",
                                            "A duplicate of a photographic image."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8b4e5a2-3429-31b7-b14c-8e5a79678240",
                                        "entry_id": "e31d3d01-0aaf-3d00-9e9c-7b6203aad456",
                                        "glosses": [
                                            "A duplicate. Often:",
                                            "An in-game item that has been duplicated."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9caa1ea5-04a4-3188-942f-829d467b519f",
                                        "entry_id": "e31d3d01-0aaf-3d00-9e9c-7b6203aad456",
                                        "glosses": [
                                            "A duplicate. Often:",
                                            "A duplicate of an order receipt printed for kitchen staff."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "495c30c9-cf03-3e49-886a-6259b364beea",
                                        "entry_id": "e31d3d01-0aaf-3d00-9e9c-7b6203aad456",
                                        "glosses": [
                                            "A duplicate. Often:",
                                            "A counterfeit; a fake."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa895d99-01e8-42ba-9449-bc594db0df46",
                                                "sense_id": "495c30c9-cf03-3e49-886a-6259b364beea",
                                                "text": "TikTok could potentially be liable if lots of users are directing other users to the sales of dupes, she said, and she said if users have an affiliate relationship with the sellers of counterfeit goods, they could also potentially be liable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fcd41c8-af45-3738-8600-a4f7b516be75",
                                        "entry_id": "e31d3d01-0aaf-3d00-9e9c-7b6203aad456",
                                        "glosses": [
                                            "A duplicate. Often:",
                                            "A cheap consumer product intended to imitate a more expensive product."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c962ddb5-8d70-4104-b731-f2db07b1b0a8",
                                                "sense_id": "3fcd41c8-af45-3738-8600-a4f7b516be75",
                                                "text": "The dupe lived up to expectation in our head-to-head review, where we concluded that Revolution’s affordable formula is a “perfectly worthy alternative that won’t see you digging too deep into your pocket.”"
                                            },
                                            {
                                                "example_id": "e4035db9-1c08-456e-8d15-4ee78c9dfba9",
                                                "sense_id": "3fcd41c8-af45-3738-8600-a4f7b516be75",
                                                "text": "And many shoppers go to Aldi for its so-called dupes of more expensive, big-brand foods and beverages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7e175a-d7ae-3658-9dbf-5c7ddf4285f5",
                                        "entry_id": "e31d3d01-0aaf-3d00-9e9c-7b6203aad456",
                                        "glosses": [
                                            "A duplicate. Often:",
                                            "A word which appears more than once in a crossword puzzle."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dupe",
