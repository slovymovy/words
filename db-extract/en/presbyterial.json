                "senses": [
                    {
                        "sense_id": "8f57cc6f-7666-3142-82ab-2a59489b898e",
                        "entry_id": "557f07a9-a4f6-32f2-866c-42a655c6f956",
                        "glosses": [
                            "Relating to Presbyterianism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a527f46-f397-4626-94da-5138b991a22d",
                                "sense_id": "8f57cc6f-7666-3142-82ab-2a59489b898e",
                                "text": "We feel very happy also that our contribution for the new Presbyterial building at Barium Springs Orphanage has reached $200."
                            },
                            {
                                "example_id": "23cb7f7b-bbfa-47c3-802a-18bfe2592f5d",
                                "sense_id": "8f57cc6f-7666-3142-82ab-2a59489b898e",
                                "text": "It also emphasized the spiritual as over against the intellectual qualities of the older Presbyterial faith as essential to the preaching of the Gospel."
                            },
                            {
                                "example_id": "974a7ff5-6a25-46a9-8392-7bbc3535d6d0",
                                "sense_id": "8f57cc6f-7666-3142-82ab-2a59489b898e",
                                "text": "What was more, Mr. Pym drove a bargain with the Scots, who agreed to come to his aid and clear the coalfields of his enemies—though only on condition that Parliament should pay them well, and should adopt the Presbyterial faith on behalf of all England and force the Covenant upon every person in authority."
                            }
                        ]
                    }
