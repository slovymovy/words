                                "target_senses": [
                                    {
                                        "sense_id": "3566b7e5-d526-31aa-98e1-948bf45c1246",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Action de confirmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191bb73d-1a45-402e-9e73-19636b156990",
                                                "sense_id": "3566b7e5-d526-31aa-98e1-948bf45c1246",
                                                "text": "La sécheresse prolongée au Sahel, entre 1968 et 1973, et la famine meurtrière qui s'ensuit semblent apporter une confirmation brutale des thèses néomalthusiennes sur l'effondrement de la production agricole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8e6e8b-e93b-3a7a-9ea6-ac6d8cc522e0",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Ce qui rend une chose ferme et stable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813673fe-6415-4a95-95d4-44c320babdaf",
                                                "sense_id": "5f8e6e8b-e93b-3a7a-9ea6-ac6d8cc522e0",
                                                "text": "La confirmation d’un jugement, d’un arrêt. Obtenir des lettres de confirmation. Confirmation de privilèges, de droits, de prérogatives, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a10128-03ed-301b-b8ec-2ff3b80b1946",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Certitude qu’on acquiert d’une chose qui avait déjà été donnée pour vraie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b76d254-84f6-4acf-a6df-77a2ad5ce676",
                                                "sense_id": "29a10128-03ed-301b-b8ec-2ff3b80b1946",
                                                "text": "La confirmation d’une nouvelle. La confirmation d’une promesse."
                                            },
                                            {
                                                "example_id": "1d6c96c4-6ecc-4a39-a858-686f837f4f17",
                                                "sense_id": "29a10128-03ed-301b-b8ec-2ff3b80b1946",
                                                "text": "On m’a dit telle chose, j’en ai reçu la confirmation de tel endroit. Cela a besoin de confirmation, mérite confirmation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d148188-299d-35f6-8491-9b436cf99ab5",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Partie du discours oratoire qui suit la narration et par laquelle on prouve ce qu’on vient d’avancer."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7c49563-fa5f-3300-b6e7-e606ba6caf6d",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Sacrement par lequel les chrétiens, en recevant le Saint-Esprit avec l’abondance de ses dons, sont confirmés dans la grâce reçue au baptême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d16d0e4b-8c2c-4316-8ab7-8567a27152b7",
                                                "sense_id": "a7c49563-fa5f-3300-b6e7-e606ba6caf6d",
                                                "text": "Le sacrement de confirmation. L’évêque seul peut donner la confirmation. Recevoir la confirmation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97fc863b-4637-3484-b3d0-5f7b0ed99743",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Dans des confessions protestantes pratiquant le baptême des enfants, cérémonie de réaffirmation de la foi qui a lieu à l’adolescence ou plus tard, et qui ne constitue pas un sacrement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
