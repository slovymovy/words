                        "cross_references": [
                            {
                                "target_word": "exorciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f21bb95-c8e9-3dad-acf8-fe50195f1010",
                                        "entry_id": "368b6427-7bcb-34c2-a5ff-3637f71de34a",
                                        "glosses": [
                                            "Prêtre à qui l’Église donne le droit d’exorciser."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfd884e2-d4d2-46cc-93de-0145c72888c5",
                                                "sense_id": "6f21bb95-c8e9-3dad-acf8-fe50195f1010",
                                                "text": "Il lui reste un dernier recours. Croyant sincère, il appelle Dieu et l’église à l’aide. Un exorciste est donc consulté. Le spécialiste en diablerie reste dubitatif; ses formules vagues sont recueillies pieusement (c’est bien le moins) par la presse."
                                            },
                                            {
                                                "example_id": "df7d24d0-6434-4816-9ea3-e270589ae186",
                                                "sense_id": "6f21bb95-c8e9-3dad-acf8-fe50195f1010",
                                                "text": "[Don Vincenzo] L’an dernier, un archevêque du Vatican m’a appelé à la rescousse : il n’y a pas d’exorciste à la basilique Saint-Pierre, et il y avait une personne très dérangée. En réalité, tout évêque ou cardinal peut être exorciste, mais peu sont habitués."
                                            },
                                            {
                                                "example_id": "b115ce0e-a795-4622-8780-1cf86ace2034",
                                                "sense_id": "6f21bb95-c8e9-3dad-acf8-fe50195f1010",
                                                "text": "On appelle « exorciste » le prêtre délégué par l'ordinaire du diocèse (l'évêque) chargé d'exercer un ministère de délivrance à l'aide d'un rituel, au nom de l'Église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a858464-60ee-3793-b116-5272d15de527",
                                        "entry_id": "368b6427-7bcb-34c2-a5ff-3637f71de34a",
                                        "glosses": [
                                            "Celui ou celle, prêtre ou charlatan, qui remplit le même office."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5c72f9c-3f1e-4140-b785-36808bd8ebbe",
                        "source_entry_id": "561425cf-ae3f-353c-8860-22851b5fd1fb",
                        "source_sense_id": "e2c19d8c-4d32-3222-9664-f37a7c581dee",
                        "source_sense_description": "a person who practices exorcism",
                        "target_lang_word": "Exorzist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exorzist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                        "entry_id": "0d077e4b-4734-3202-a30a-e7c0c1ecf5fa",
                                        "glosses": [
                                            "eine (männliche) Person, die Exorzismus durchführt, d. h. Dämonen aus Gegenständen oder Personen austreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33a36ad-7503-4a7a-961e-daa4f57580c3",
                                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                                "text": "„Der Exorzist tritt in eine direkte Kommunikation mit dem unerwünschten Geist oder Dämon und sucht durch dessen Beseitigung eine Reintegration des ‚Besessenen‘ herbeizuführen.“"
                                            },
                                            {
                                                "example_id": "f698db67-b81c-46bb-8c62-e46e8154b12e",
                                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                                "text": "„Beim Fortgehen sagte Pater Prospero zum Doktor, das Mädchen sei ohne Zweifel besessen, aber man müsse einen andern Exorzisten holen, da Gott offenbar nicht ihm die Gnade zuteil werden lasse, sie zu erlösen.“"
                                            },
                                            {
                                                "example_id": "6186d73b-9b7f-4d45-a767-81d7a711e684",
                                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                                "text": "„Die populären Exorzisten verstanden sich letztlich eher als Heiler denn als Kirchenmänner.“"
                                            },
                                            {
                                                "example_id": "da43a698-427f-457a-9f57-ce4a2053284a",
                                                "sense_id": "6d479768-11a6-31c9-a274-51524109594d",
                                                "text": "„Ben war wie ein Exorzist gewesen, der die Geister der Vergangenheit in Schach hielt mit seinen Fragen, seiner Neugier, seinem Wunsch, eine alte Karte ausfindig zu machen und ein Abenteuer mit mir zu bestreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6d232b3-1c2b-3745-9a17-f11d020b0068",
                                        "entry_id": "0d077e4b-4734-3202-a30a-e7c0c1ecf5fa",
                                        "glosses": [
                                            "niedere Weihe, die die Ausführung von Exorzismen erlaubte"
                                        ],
                                        "tags": [
                                            "historical",
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
