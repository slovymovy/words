                        "form": "décousues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                        "entry_id": "024274ec-08ea-3cb3-b2ae-cc282ba5880d",
                        "glosses": [
                            "Caractérise des propos sans suite, un style qui n’a pas de liaison, des événements non reliés entre eux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9f4c0b-bfd8-4fad-9b75-cbc68af23c1a",
                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                "text": "Phrases décousues."
                            },
                            {
                                "example_id": "3676bd6a-f558-4467-89dc-f0ed85b240b8",
                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                "text": "Conversation décousue."
                            },
                            {
                                "example_id": "75237ab7-a59f-4ece-af1b-ffd4bc349c0d",
                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                "text": "Des idées décousues."
                            },
                            {
                                "example_id": "921b2cf0-d3ac-4f7a-a6c2-3ca3eff547e9",
                                "sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                                "text": "En temps de paix, la vie est harmonieuse et composée. On rencontre les mêmes gens, on les retrouve, on les perd de vue, on les retrouve encore. Les histoires se nouent et se dénouent harmonieusement, comme dans les tragédies classiques. Mais à la guerre, tout est décousu, sans lien, sans suite, sans cohérence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "074e7d4c-c7fe-4606-a16e-e9410c18332b",
                        "source_entry_id": "024274ec-08ea-3cb3-b2ae-cc282ba5880d",
                        "source_sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                        "target_lang_word": "zusammenhanglos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zusammenhanglos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2afc8354-4ed3-3980-9fe1-a3f7a702a476",
                                        "entry_id": "077ec1eb-c7ca-3119-ba43-05e2a6e57e00",
                                        "glosses": [
                                            "in keiner logisch erkennbaren Beziehung zueinander/zu etwas stehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c03815-018d-4a3d-8fd4-52e360e57dcf",
                                                "sense_id": "2afc8354-4ed3-3980-9fe1-a3f7a702a476",
                                                "text": "„Sie wollte sprechen, konnte sich dann aber nur in zusammenhanglosen, abgehackten Sätzen artikulieren.“"
                                            },
                                            {
                                                "example_id": "7dd85711-ccbe-4f0c-a0f4-e31547c9b1a3",
                                                "sense_id": "2afc8354-4ed3-3980-9fe1-a3f7a702a476",
                                                "text": "„Ist nicht das Gemeinschaftsleben der Völker und der Menschheit das schwankendste, unberechenbarste, zusammenhangloseste von allem, was wir unter die Erscheinungen des Weltalls zählen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fadaf9f6-fa7b-45f4-a6be-ba0f24d375d6",
                        "source_entry_id": "024274ec-08ea-3cb3-b2ae-cc282ba5880d",
                        "source_sense_id": "6fd33849-c818-37d9-a91a-818453cd4dca",
                        "target_lang_word": "wirr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wirr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                        "entry_id": "f9e28542-6fdb-3901-99c1-5ef8fab34081",
                                        "glosses": [
                                            "von Verwirrtheit oder Verworrenheit geprägt; ohne (erkennbare) Ordnung; so, dass etwas durcheinander beziehungsweise nicht durchschaubar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a6762b-bdb2-49c9-a3bd-eaad8336fdd1",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "„Im Anfang schuf Gott Himmel und Erde; die Erde aber war wüst und wirr, Finsternis lag über der Urflut und Gottes Geist schwebte über dem Wasser.“"
                                            },
                                            {
                                                "example_id": "db8174e0-c958-41fd-a80d-4e1574543016",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "Mir wird ganz wirr im Kopf."
                                            },
                                            {
                                                "example_id": "ffbfefbb-5ed3-4482-8f04-dad0c13408a4",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "Da er seit zwei Tagen nicht mehr geschlafen hatte, redete er nur noch wirres Zeug."
                                            },
                                            {
                                                "example_id": "761d2de4-a5cd-4948-9ab9-4cc4cd633c4c",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "Was ist denn das für eine wirre Geschichte? Die glaubt dir niemand."
                                            },
                                            {
                                                "example_id": "1b70d62e-7fa3-4b87-bcce-5c53450748ef",
                                                "sense_id": "6227142a-ff5d-3274-b992-fbe399c432de",
                                                "text": "„Seine dunklen Haare hingen wirr in sein Gesicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6f136fc-27b0-4932-a81f-c59a94637319",
                        "source_entry_id": "024274ec-08ea-3cb3-b2ae-cc282ba5880d",
