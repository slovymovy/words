{
    "word_family": [
        "lang",
        "zolangzamerhand"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "e6d409fb-f8a1-3e8a-9d18-c0b645d22698",
                    "sense_definition": "gedurende de tijd dat een bepaalde situatie voortduurt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tijdsduur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je mag hier blijven wonen <w>zolang</w> je de huur op tijd betaalt.",
                            "target_lang_translations": {
                                "en": "You may continue to live here <w>as long as</w> you pay the rent on time.",
                                "ru": "Ты можешь продолжать жить здесь, <w>пока</w> вовремя платишь за аренду."
                            }
                        },
                        {
                            "text": "De kinderen mogen buiten spelen <w>zolang</w> het licht is en het niet regent.",
                            "target_lang_translations": {
                                "en": "The children may play outside <w>as long as it is light</w> and it is not raining.",
                                "ru": "Детям можно играть на улице, <w>пока</w> светло и нет дождя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zolang het licht is",
                        "zolang het duurt",
                        "zolang mogelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "during the time that a certain situation continues; provided that",
                        "ru": "в течение того времени, пока продолжается определенная ситуация; при условии, что"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as long as",
                                "target_lang_sense_clarification": "indicating a condition or duration"
                            },
                            {
                                "target_lang_word": "so long as",
                                "target_lang_sense_clarification": "indicating a condition"
                            },
                            {
                                "target_lang_word": "while",
                                "target_lang_sense_clarification": "during the time that"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пока",
                                "target_lang_sense_clarification": "в течение времени"
                            },
                            {
                                "target_lang_word": "пока что",
                                "target_lang_sense_clarification": "в течение определенного периода"
                            },
                            {
                                "target_lang_word": "до тех пор пока",
                                "target_lang_sense_clarification": "указывает на условие или длительность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "83379332-f219-3852-9d7c-8e986a2c805a",
                    "sense_definition": "gedurende die tijd of in de tussentijd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tijdsduur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga even naar de winkel, blijf jij <w>zolang</w> hier op de baby passen?",
                            "target_lang_translations": {
                                "en": "I'm just going to the shop, will you stay here and watch the baby <w>in the meantime</w>?",
                                "ru": "Я схожу в магазин, а ты <w>тем временем</w> посидишь здесь с ребенком?"
                            }
                        },
                        {
                            "text": "Het eten is bijna klaar, ga <w>zolang</w> maar vast aan tafel zitten.",
                            "target_lang_translations": {
                                "en": "Dinner is almost ready, go ahead and sit at the table <w>for now</w>.",
                                "ru": "Еда почти готова, а ты <w>пока</w> садись за стол."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondertussen",
                        "intussen",
                        "in de tussentijd"
                    ],
                    "common_phrases": [
                        "blijf zolang hier",
                        "wacht zolang even"
                    ],
                    "target_lang_definitions": {
                        "en": "during that time or in the meantime",
                        "ru": "в течение этого времени или в промежутке между событиями"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "in the meantime",
                                "target_lang_sense_clarification": "while something else is happening"
                            },
                            {
                                "target_lang_word": "meanwhile",
                                "target_lang_sense_clarification": "at the same time"
                            },
                            {
                                "target_lang_word": "for the time being",
                                "target_lang_sense_clarification": "temporarily"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тем временем",
                                "target_lang_sense_clarification": "пока происходит что-то другое"
                            },
                            {
                                "target_lang_word": "пока",
                                "target_lang_sense_clarification": "в это время, временно"
                            },
                            {
                                "target_lang_word": "между тем",
                                "target_lang_sense_clarification": "в то же самое время"
                            },
                            {
                                "target_lang_word": "пока что",
                                "target_lang_sense_clarification": "на данный момент"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}