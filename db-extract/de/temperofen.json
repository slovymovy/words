                "senses": [
                    {
                        "sense_id": "2a64839a-03b2-3d83-9f55-43e8f7cf4c58",
                        "entry_id": "5068b181-9da2-3301-b084-4be052858045",
                        "glosses": [
                            "das Tempern; technisches Gerät, in dem etwas über längere Zeit gezielt erhitzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af96e057-bfc2-4289-898d-64bac1af0fa4",
                                "sense_id": "2a64839a-03b2-3d83-9f55-43e8f7cf4c58",
                                "text": "„Temperöfen sind von einfachen Temperieraufgaben bis hin zur umfassenden Programmregelung geeignet.“"
                            },
                            {
                                "example_id": "6c2a3cdd-9e43-4b51-9fe4-f468492c85ef",
                                "sense_id": "2a64839a-03b2-3d83-9f55-43e8f7cf4c58",
                                "text": "„Temperöfen sorgen mit Hilfe einer gleichförmigen Temperatur für die Verteilung mechanischer Spannungen.“"
                            },
                            {
                                "example_id": "e0e11b63-1a86-4e5f-ad04-8bde3714566c",
                                "sense_id": "2a64839a-03b2-3d83-9f55-43e8f7cf4c58",
                                "text": "„Nach der Erhitzung im Temperofen bleiben gezielt Eigenschaften des Materials erhalten.“"
                            },
                            {
                                "example_id": "af345a15-d6a6-4b4d-a525-4061826e5dcd",
                                "sense_id": "2a64839a-03b2-3d83-9f55-43e8f7cf4c58",
                                "text": "„Der Temperofen dient zum Tempern von Schaumstoffen und Verbundwerkstoffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
