                "senses": [
                    {
                        "sense_id": "5c725c66-c1c9-341a-b264-71c30ac2527b",
                        "entry_id": "0a2fc566-ec99-3a2a-9652-7c13545f1616",
                        "glosses": [
                            "Qui hydrate."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "3cdcffc9-2fca-4853-ac52-35c5fa7052af",
                                "sense_id": "5c725c66-c1c9-341a-b264-71c30ac2527b",
                                "text": "Il est bien admis à l’heure actuelle, que tout catalyseur hydrogénant est aussi un catalyseur déshydrogénant, que tout catalyseur hydratant est lui-même un catalyseur déshydratant, etc."
                            },
                            {
                                "example_id": "ed673ba1-3862-48e7-9393-e578afd845f1",
                                "sense_id": "5c725c66-c1c9-341a-b264-71c30ac2527b",
                                "text": "Qu’une boisson puisse être désignée comme peu hydratante a quelque chose de paradoxal. Étant fatalement composée d’eau, une boisson ne peut-elle pas faire autre chose qu’hydrater l’organisme ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "861f3f85-c33c-3885-b437-e892e1447765",
                        "entry_id": "0a2fc566-ec99-3a2a-9652-7c13545f1616",
                        "glosses": [
                            "Qualifie un produit qui hydrate la peau."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3e44c1f9-a015-4e38-b835-e19c3dec1881",
                                "sense_id": "861f3f85-c33c-3885-b437-e892e1447765",
                                "text": "Si on a tendance à avoir des boutons de rasage, on applique une crème hydratante ou un après-rasage adapté, quelle que soit la technique de rasage utilisée."
                            },
                            {
                                "example_id": "f8a9b456-eaa2-4fa4-a250-06ea7b764de1",
                                "sense_id": "861f3f85-c33c-3885-b437-e892e1447765",
                                "text": "J’ai laissé mes yeux traîner sur les étagères. Crèmes de jour, de nuit, masques hydratants, purifiants, gommages, sérums antifatigue."
                            },
                            {
                                "example_id": "d36381cb-4052-49b3-81c3-b304999de67e",
                                "sense_id": "861f3f85-c33c-3885-b437-e892e1447765",
                                "text": "Très riche en vitamines A, B3, B8, D, K, et E, c’est une huile antioxydante, restructurante et hydratante bien adaptée aux peaux matures."
                            }
                        ]
                    }
                ],
