                                            {
                                                "example_id": "bfba9d9b-6c39-4f2e-b3f2-c96e7f8a5d6f",
                                                "sense_id": "9cf178f0-3f51-32fe-834e-60cebfe8641f",
                                                "text": "Mit einer Lehre kann man die Dicke einer Holzplatte messen."
                                            }
