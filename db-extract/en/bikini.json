                        "cross_references": [
                            {
                                "target_word": "bikini",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                                        "entry_id": "e1ed3d3e-a094-30e1-a68b-0005ae37734e",
                                        "glosses": [
                                            "tweedelige zwemkleding voor de vrouw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f945899-ef46-48cc-afd3-391c468c1487",
                                                "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                                                "text": "Ze trok alle aandacht in haar bikinietje."
                                            },
                                            {
                                                "example_id": "f15666b5-4a3b-4944-9fdb-c51add7b6306",
                                                "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                                                "text": "Ze droegen bikini's met tijgermotieven en glimlachten verleidelijk."
                                            },
                                            {
                                                "example_id": "897e09df-fa04-460e-b267-c28b25d71823",
                                                "sense_id": "a94d5d4e-67c6-37e5-a95b-4ace80d4efe7",
                                                "text": "Mijn moeder en vader stonden in badkleding bij de steiger en glimlachten naar de camera, zij in een tweedelig badpak, dus geen bikini, hij in zo'n strakke zwembroek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34496903-8ed4-486b-aeee-898f9a03b18c",
                        "source_entry_id": "cbce6b09-e853-3735-a206-fb24abd1673a",
                        "source_sense_description": "bathing suit",
                        "target_lang_word": "bikini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bikini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf736b5-96b9-34e8-9b1b-0d55abdde227",
                                        "entry_id": "f6bd6da1-f49f-32f4-ba39-58ab36fa5523",
                                        "glosses": [
                                            "Maillot de bain deux-pièces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df34a81-587f-46b6-b56b-8d75b2c9760f",
                                                "sense_id": "ebf736b5-96b9-34e8-9b1b-0d55abdde227",
                                                "text": "Les jeunes femmes ont un sens aigu de ce qu’il convient de faire et de ne pas faire quand on a cessé d’être jeune. « Je ne comprends pas, disent-elles, que passé quarante ans on se teigne en blond ; qu’on s’exhibe en bikini ; qu’on coquette avec les hommes. Moi, quand j’aurai cet âge-là... »"
                                            },
                                            {
                                                "example_id": "6259dc5d-b58d-4deb-bd8c-e39b844a1dac",
                                                "sense_id": "ebf736b5-96b9-34e8-9b1b-0d55abdde227",
                                                "text": "Le quartier où tous les dix mètres un grand noir patibulaire vous tendait un paquet de mouchoirs frappé de l’image d'une fille en cuir ou en bikini avec, au dos, le plan d'accès vers un bar à hôtesses."
                                            },
                                            {
                                                "example_id": "ba9dcc80-9d93-4593-920e-c99cc9f63740",
                                                "sense_id": "ebf736b5-96b9-34e8-9b1b-0d55abdde227",
                                                "text": "Nous travaillions toute la semaine, et le week-end, je rentrais à la maison auprès de Billie et de ma famille. Tyler restait à South Beach, où les skateuses en bikini l’inspiraient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0f85763-e96b-467b-9d9b-bf378ab6da5d",
                        "source_entry_id": "cbce6b09-e853-3735-a206-fb24abd1673a",
                        "source_sense_description": "bathing suit",
                        "target_lang_word": "Bikini",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bikini",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                        "entry_id": "25adb8c6-2760-3f77-817f-f435baea6693",
                                        "glosses": [
                                            "zweiteilige Badebekleidung für Damen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5235bdc2-cb04-47b3-bc7d-de9870a1d4fb",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Sie kramte ihren Bikini aus einem Koffer und seine Badehose – es war so warm.“"
                                            },
                                            {
                                                "example_id": "9d51aa75-31cf-4904-927d-288df1ef14e2",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Sie zog Renate mit sich fort: ‚Kommst du mit baden?‘ ‚Hab’ keinen Bikini mit.‘“"
                                            },
                                            {
                                                "example_id": "5fcc5940-6cd9-485d-bfee-408b243b92f7",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Im Bad hing gelb Susannes Bikini.“"
                                            },
                                            {
                                                "example_id": "b8efaa33-4a0a-4c55-903c-4b371a17c7b7",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Der Bikini ist ein ‚Nichts aus Stoff, das immer noch Frauen auf der ganzen Welt begeistert, wie etwa die Französin Brigitte: ‚Für mich gehört der Bikini am Strand dazu. Ein Synonym für Ferien, Freiheit. Und es gibt so wunderschöne Bikinis – das ist auch ein Synonym für Jugend für mich!‘“"
                                            },
                                            {
                                                "example_id": "0c686644-ded9-4e04-9d96-9903d8233d82",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Ach, hätte ich doch nur das Bikini dabei – ein kühles Bad an diesem wildromantischen Ort wäre traumhaft, denke ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
