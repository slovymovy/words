                    {
                        "form_id": "1906a5de-9e2d-4bc2-99eb-0b20f93621ef",
                        "entry_id": "b4b36daa-9e7c-3cfd-b08e-e975824953ac",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Anfangsbuchstaben"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                        "entry_id": "b4b36daa-9e7c-3cfd-b08e-e975824953ac",
                        "glosses": [
                            "erster Buchstabe eines Wortes, Textabschnitts oder Textes"
                        ],
                        "tags": [
                            "Schriftlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "41646665-24b0-4083-872b-33cca2d2a83a",
                                "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                                "text": "Die Anfangsbuchstaben von Substantiven werden ebenso wie die von Sätzen im Deutschen immer großgeschrieben."
                            },
                            {
                                "example_id": "e3594c1b-fdca-4972-a68a-c055154b35e8",
                                "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                                "text": "Viele Abkürzungen und Kurzwörter werden aus den Anfangsbuchstaben der gekürzten Spracheinheiten gebildet: z.B. „LKW“ aus „Lastkraftwagen“."
                            },
                            {
                                "example_id": "e5344b01-e2b8-460e-8da1-5e1f8b334a59",
                                "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                                "text": "„So wird der Lexembestand aufgeschlüsselt nach den Wortarten und grammatischen Kategorien, nach den ersten drei Anfangs- beziehungsweise Endbuchstaben, …“"
                            },
                            {
                                "example_id": "22bd6c13-8354-40ed-96b5-d22a021435b2",
                                "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                                "text": "„Dieser passt aufgrund der gleichen vier Anfangsbuchstaben gut zum Familiennamen.“"
                            },
                            {
                                "example_id": "958b57ca-ebdc-456a-a12f-1393594959b5",
                                "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                                "text": "„Für das Deutsche ist zu konstatieren, daß die meisten substantivischen Anglizismen entsprechend den deutschen Regeln mit großen Anfangsbuchstaben versehen wurden.“"
                            },
                            {
                                "example_id": "752a0983-865a-4e46-985f-17922d2285f2",
                                "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                                "text": "„Aber wir dürfen nicht zu lange draußen bleiben, auch wenn da noch mehr über die Außenansicht der Mühle zu sagen wäre - beispielsweise über ihr Spiegelbild im Mühlenteich und über die eingekerbten Anfangsbuchstaben und Pfeile und Herzen in der Tür…“"
                            },
                            {
                                "example_id": "9f85e637-882d-4e7d-8c5d-83d9484b69ff",
                                "sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                                "text": "„Man kann aber auch - dies ist allerdings bei den rasch denkenden und schreibenden Juden auch außerhalb der Kabbala durchaus gebräuchlich - für ein Wort einfach den Anfangsbuchstaben setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fb48a68-f593-4fb1-8868-41fc74cfa79a",
                        "source_entry_id": "b4b36daa-9e7c-3cfd-b08e-e975824953ac",
                        "source_sense_id": "ce2ac1c1-8cbb-38e2-a73d-2fad6f8e4a16",
                        "source_sense_description": "erster Buchstabe eines Wortes, Textabschnitts oder Textes",
                        "target_lang_word": "initial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "initial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaaf476d-82eb-367f-b33e-e69627748752",
                                        "entry_id": "673b154b-df47-31fe-99fc-c89d4030e137",
                                        "glosses": [
                                            "Chronologically first, early; of or pertaining to the beginning, cause or origin."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19848342-affe-4943-a00b-cbde881bb690",
                                                "sense_id": "eaaf476d-82eb-367f-b33e-e69627748752",
                                                "text": "Our initial admiration for their efficiency gave way to disgust about their methods."
                                            },
                                            {
                                                "example_id": "81a781bd-ba8e-4e70-a601-132e904a4dbf",
                                                "sense_id": "eaaf476d-82eb-367f-b33e-e69627748752",
                                                "text": "The initial stages of a syndrome may differ vastly from the final symptoms."
                                            },
                                            {
                                                "example_id": "158446d3-056a-4cde-9c9a-cdd6f4c56cc9",
                                                "sense_id": "eaaf476d-82eb-367f-b33e-e69627748752",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            },
                                            {
                                                "example_id": "3943b011-c6b1-47e8-8e73-99854fad4e8b",
                                                "sense_id": "eaaf476d-82eb-367f-b33e-e69627748752",
                                                "text": "While the first part to Manchester is level after the initial climb out of Liverpool, the section over the Pennines between Manchester and Leeds is very difficult, with steep gradients as well as many slowings over junctions and curves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f7eba16-7ee4-38d5-968a-e12d09537861",
                                        "entry_id": "673b154b-df47-31fe-99fc-c89d4030e137",
                                        "glosses": [
                                            "Spatially first, placed at the beginning, in the first position; especially said of the first letter of a word."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b68192-babc-440e-90c8-42cf7b16404d",
                                                "sense_id": "3f7eba16-7ee4-38d5-968a-e12d09537861",
                                                "text": "The initial letter of names is usually printed with a capital letter."
                                            },
                                            {
                                                "example_id": "462e2ad7-a3ca-4e66-91fe-7a08f9efd44c",
                                                "sense_id": "3f7eba16-7ee4-38d5-968a-e12d09537861",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between; his clerks, however, understood him very well."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "initial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a91fcae9-a710-3750-af35-7f4f312f3b3e",
                                        "entry_id": "b4899121-8fa7-3e3e-97a7-d355df1a18bb",
                                        "glosses": [
                                            "The first letter of a word or a name, especially of a person's full name (their initials)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c70316db-e482-4987-85ba-3e6d5b9dbb2a",
                                                "sense_id": "a91fcae9-a710-3750-af35-7f4f312f3b3e",
                                                "text": "The point of interest about this particular specimen was that it must have remained intact for at least a quarter of a century, as it had embossed in the frosted glass the initials of the old Great North of Scotland Railway in the form of a scroll, the sort of relic of pre-grouping days that can still be found here and there if one is observant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc08f29d-b5bb-3b6b-b7d8-a26b8d141708",
                                        "entry_id": "b4899121-8fa7-3e3e-97a7-d355df1a18bb",
                                        "glosses": [
                                            "A distinguished initial letter of a chapter or section of a document."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4f0959b-e63b-3382-99ce-0ba04aae55ff",
                                        "entry_id": "b4899121-8fa7-3e3e-97a7-d355df1a18bb",
                                        "glosses": [
                                            "onset, part of a syllable that precedes the syllable nucleus in phonetics and phonology."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "initial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1a22794-5fa9-3ea9-9108-be9b59030e72",
                                        "entry_id": "a001a3a1-43b8-3639-8514-f01e76a0f509",
                                        "glosses": [
                                            "To sign one's initial(s), as an abbreviated signature."
                                        ],
                                        "tags": [
