{
    "word_family": [
        "waar",
        "heen"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "fc11bc14-aa7d-3ccd-91b2-1e043a5d8112",
                    "sense_definition": "Vragend voornaamwoordelijk bijwoord: in welke richting?",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waarheen</w> leidt deze smalle weg in het bos?",
                            "target_lang_translations": {
                                "ru": "<w>Куда</w> ведет эта узкая лесная дорога?"
                            }
                        },
                        {
                            "text": "Weet jij <w>waarheen</w> de trein vertrekt?",
                            "target_lang_translations": {
                                "ru": "Ты знаешь, <w>куда</w> отправляется поезд?"
                            }
                        }
                    ],
                    "synonyms": [
                        "waar"
                    ],
                    "common_phrases": [
                        "waarheen gaan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное наречие: в каком направлении?"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куда",
                                "target_lang_sense_clarification": "указывает на направление движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d961b718-5031-38ee-99a8-8bf07edb977a",
                    "sense_definition": "Betrekkelijk voornaamwoordelijk bijwoord: in welke richting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertelde niet <w>waarheen</w> de reis zou gaan.",
                            "target_lang_translations": {
                                "ru": "Он не сказал, <w>куда</w> направляется путешествие."
                            }
                        },
                        {
                            "text": "De plek <w>waarheen</w> wij verhuizen is erg rustig.",
                            "target_lang_translations": {
                                "ru": "Место, <w>куда</w> мы переезжаем, очень тихое."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относительное наречие: в каком направлении (в придаточных предложениях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куда",
                                "target_lang_sense_clarification": "используется для связи частей предложения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd547ed9-611b-386e-8ad5-fdbc27be54b9",
                    "sense_definition": "Vragend voornaamwoordelijk bijwoord in gescheiden vorm: naar welke plaats.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Waar</w> gaat zij <w>heen</w> met die zware koffer?",
                            "target_lang_translations": {
                                "ru": "<w>Куда</w> она идет с этим тяжелым чемоданом?"
                            }
                        },
                        {
                            "text": "<w>Waar</w> ben jij <w>heen</w> gegaan tijdens de vakantie?",
                            "target_lang_translations": {
                                "ru": "<w>Куда</w> ты ездил во время отпуска?"
                            }
                        }
                    ],
                    "synonyms": [
                        "waarheen"
                    ],
                    "common_phrases": [
                        "waar heen gaan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное наречие в раздельной форме: в какое место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куда",
                                "target_lang_sense_clarification": "раздельное написание подчеркивает направление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}