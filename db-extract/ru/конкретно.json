        "ru-extract.jsonl": [
            {
                "entry_id": "45b424d2-0c94-3310-8286-e40687712e3a",
                "word": "конкретно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b049f35f-6eef-36dd-87da-16d91cb8f9c3",
                        "entry_id": "45b424d2-0c94-3310-8286-e40687712e3a",
                        "glosses": [
                            "наречие к конкретный; вполне определённо, предметно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "ea9ed21e-25fb-49a4-948c-dd857e3aa3af",
                                "sense_id": "b049f35f-6eef-36dd-87da-16d91cb8f9c3",
                                "text": "— Кого имеете в виду? — быстро спросил Алексей. — Только укажите конкретно."
                            }
                        ]
                    },
                    {
                        "sense_id": "c18cba50-b591-3bd8-8f29-3578ebe4c5a0",
                        "entry_id": "45b424d2-0c94-3310-8286-e40687712e3a",
                        "glosses": [
                            "жарг. хорошо, как полагается, полноценно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3252d2a3-8365-49ba-a54c-41758a971b75",
                                "sense_id": "c18cba50-b591-3bd8-8f29-3578ebe4c5a0",
                                "text": "Мужик конкретно работает (о спортсмене)."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a41521d-fead-3720-9906-3c56f83cc483",
                        "entry_id": "45b424d2-0c94-3310-8286-e40687712e3a",
                        "glosses": [
                            "жарг. очень сильно, в высшей степени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b723e03-b700-4715-bda8-e6d95be0b604",
                                "sense_id": "8a41521d-fead-3720-9906-3c56f83cc483",
                                "text": "Журавль конкретно обиделся, чисто по жизни, застегнулся до ушей и отвалил."
                            },
                            {
                                "example_id": "1441ff80-f59f-4576-9942-ac79d9a64ab4",
                                "sense_id": "8a41521d-fead-3720-9906-3c56f83cc483",
                                "text": "Министр иностранных дел ухмыльнулся: — Гаврилыч, ну, пролетел ты тогда конкретно! Большой кусок мимо прошёл."
                            },
                            {
                                "example_id": "42eb9e94-10db-4187-8749-b97943a07927",
                                "sense_id": "8a41521d-fead-3720-9906-3c56f83cc483",
                                "text": "Разве что унитаз в поезде нам пришлось надраивать конкретно: не хухры-мухры, родного кота на него сажать!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9bbddea-57e7-4583-93cd-2148be25b3b4",
                        "source_entry_id": "45b424d2-0c94-3310-8286-e40687712e3a",
                        "source_sense_description": "наречие к конкретный; вполне определённо, предметно",
