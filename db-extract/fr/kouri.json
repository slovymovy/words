                "senses": [
                    {
                        "sense_id": "a4e4586c-a28d-3d3c-9e6d-8921c4c30655",
                        "entry_id": "2ec7b6a3-e67d-3bb6-8233-2cebe30762d8",
                        "glosses": [
                            "Race mixte de taurins croisés avec des zébus originaires d’Afrique de l’Ouest (autour du lac Tchad), sans bosse, à très grandes cornes et à robe souvent blanche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1b2beb-bdb9-498b-b978-90662622b3da",
                                "sense_id": "a4e4586c-a28d-3d3c-9e6d-8921c4c30655",
                                "text": "Et dans un enclos de très beaux bovidés blancs : la race des vaches Kouris du lac Tchad en voie d’extinction ; elles sont dotées d’énormes cornes creuses leur servant de flotteurs."
                            },
                            {
                                "example_id": "af630c17-ea9a-4ef4-8e26-5527d93f91da",
                                "sense_id": "a4e4586c-a28d-3d3c-9e6d-8921c4c30655",
                                "text": "Cette dernière remarque n’a pas rassuré la vache Kouri. Je me suis reculé. Étant donné la longueur de ses cornes, un simple hochement de sa tête brasse au moins deux mètres cubes d’air torride."
                            }
                        ]
                    }
                ],
