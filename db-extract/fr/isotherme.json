                    {
                        "sense_id": "c42f23c8-c98f-38ab-8af8-fb4569390d9c",
                        "entry_id": "b1af5a49-61e2-317e-95c6-7ffcc61c40e0",
                        "glosses": [
                            "Se dit de récipients conçus pour conserver le plus longtemps possible la température de leur contenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10039fbe-0c1c-4790-8661-a67e5d19f650",
                                "sense_id": "c42f23c8-c98f-38ab-8af8-fb4569390d9c",
                                "text": "Le record du choix appartient à la banque danoise Cryos, qui offre « 700 donneurs et plus de 100 litres de sperme congelé ». Les paillettes sont livrées par DHL dans une boîte isotherme façon surgelés Picard."
                            },
                            {
                                "example_id": "9d9e414a-f791-48d9-bfac-2e98375bc669",
                                "sense_id": "c42f23c8-c98f-38ab-8af8-fb4569390d9c",
                                "text": "Cette bouteille isotherme en acier inoxydable est la solution la plus saine pour transporter vos boissons. Elle est 100% étanche."
                            }
                        ]
                    }
                ],
