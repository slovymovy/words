                ],
                "senses": [
                    {
                        "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                        "entry_id": "8eeb680d-57fe-3127-a944-213db9da935e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8fea2f3-a386-4b92-be17-bbc5b1a304ae",
                                "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                                "text": "Frau Künast ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5fc961bb-afe9-483e-abec-890612f7dea5",
                                "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                                "text": "Herr Künast wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "12b973c9-bf69-41d2-a788-ab4ee8446ec7",
                                "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                                "text": "Die Künasts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "cdd2fee8-423b-474d-ab4c-1ca7df275e4c",
                                "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                                "text": "Der Künast trägt nie die Pullover, die die Künast ihm strickt."
                            },
                            {
                                "example_id": "20a56592-d210-41fb-b00a-43df6dfa1262",
                                "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Künast kommt, geht der Herr Künast.“"
                            },
                            {
                                "example_id": "0c2f862f-e944-499b-a679-a79a186387c0",
                                "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                                "text": "Künast kommt und geht."
                            },
                            {
                                "example_id": "b3f9cca0-f67a-489e-be23-6392d36586d2",
                                "sense_id": "1c125d3d-d495-34fc-8ff9-8f89a6a9b57c",
                                "text": "Künasts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
