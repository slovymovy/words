                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5fe8ed6-5f70-3890-9782-929c1cc6c0bc",
                                        "entry_id": "ced04f30-05f5-39e7-8ae3-e10636d7129a",
                                        "glosses": [
                                            "Accords dont la basse n’est pas la fondamentale."
