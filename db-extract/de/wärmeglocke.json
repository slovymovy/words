                "senses": [
                    {
                        "sense_id": "49bab2ad-808c-3995-9ec6-a325a79c3058",
                        "entry_id": "04f71e3a-4bb6-3030-bfc5-41cfd5bc964c",
                        "glosses": [
                            "Abdeckhaube, die dazu dient, Speisen auf Tellern oder Platten warmzuhalten und sie gleichzeitig vor Verunreinigungen durch Partikel oder Insekten zu schützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca241f38-2140-461b-98f9-dee2b9f96346",
                                "sense_id": "49bab2ad-808c-3995-9ec6-a325a79c3058",
                                "text": "„Er nahm die Wärmeglocke vom Teller und legte sie zur Seite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
