                        "entry_id": "f7b39d3a-7bc3-3b99-b718-bd694d623a57",
                        "glosses": [
                            "groźna dla ludzi zakaźna choroba świń wywoływana przez Erysipelothrix rhusopathiae, włoskowca różycy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebbdd73a-4335-4a17-a4ab-0e6376c804c9",
                                "sense_id": "9bd08748-4e56-38e1-a9de-0c7253a30ba3",
                                "text": "Ustaliliśmy, że wiele świń było chorych na różycę i mykoplazmozę, które się leczy lub stosuje szczepienia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
