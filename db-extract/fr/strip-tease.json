                "senses": [
                    {
                        "sense_id": "aa654b5b-f582-3f89-8a63-af657298d50d",
                        "entry_id": "71b57c70-99c9-3be7-8325-349208dc8095",
                        "glosses": [
                            "Spectacle, généralement une danse, dans lequel l’individu se déshabille doucement et sensuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c56fd2-7346-4eaf-b8fb-7f42f4bca700",
                                "sense_id": "aa654b5b-f582-3f89-8a63-af657298d50d",
                                "text": "La facétieuse déesse Ame no Uzume no Mikoto imagine alors un stratagème pour contraindre Amaterasu à sortir de sa cachette et se lance dans un véritable strip-tease : […]."
                            },
                            {
                                "example_id": "51bad41a-3c39-4e52-9a30-49e7c5be7b63",
                                "sense_id": "aa654b5b-f582-3f89-8a63-af657298d50d",
                                "text": "Tatiana n'avait pas mis longtemps à trouver le chemin de l'escalier du 100. Une de ses anciennes colocatrices du foyer étudiant de Tomsk officiait à la barre de strip-tease depuis l'hiver d'avant et lui avait proposé de rencontrer son patron."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9913d60-1d5c-40b6-91d8-ef4bc16a218b",
                        "source_entry_id": "71b57c70-99c9-3be7-8325-349208dc8095",
                        "source_sense_id": "aa654b5b-f582-3f89-8a63-af657298d50d",
                        "target_lang_word": "Striptease",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Striptease",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58a74181-2f56-3cd1-b2f9-fb2c991a2f0c",
                                        "entry_id": "ffba22c4-ebba-3e55-ab59-8fb5f62709ea",
                                        "glosses": [
                                            "in Nachtlokalen, Varietés und vergleichbaren Etablissements dargebotene Vorführung von erotischen Tänzen oder kleineren Szenen, in deren Verlauf die Akteure nach und nach ihre Kleidungsstücke ablegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d78614e-2844-4f2c-af49-14371d06a326",
                                                "sense_id": "58a74181-2f56-3cd1-b2f9-fb2c991a2f0c",
                                                "text": "Ansgar und Leonid besuchen heute einen Nachtclub, um sich dort Stripteases anzusehen."
                                            },
                                            {
                                                "example_id": "ff1eaa25-f3f0-4925-8351-5478a68fb159",
                                                "sense_id": "58a74181-2f56-3cd1-b2f9-fb2c991a2f0c",
                                                "text": "In dieser Bar kannst du heute Abend Helen beim Striptease sehen."
                                            },
                                            {
                                                "example_id": "616a9d33-59c8-416a-afe8-c3528175629f",
                                                "sense_id": "58a74181-2f56-3cd1-b2f9-fb2c991a2f0c",
                                                "text": "Du musst noch einiges dazulernen, bis du einen guten Striptease machen kannst."
                                            },
                                            {
                                                "example_id": "66935924-0b94-4e4c-b121-4304d284f18a",
                                                "sense_id": "58a74181-2f56-3cd1-b2f9-fb2c991a2f0c",
                                                "text": "Ich war früher Mitglied in einer Männergruppe, die von Stadt zu Stadt zog und in Clubs Abend für Abend zu zehnt einen Striptease tanzte."
                                            },
                                            {
                                                "example_id": "849e806e-d8c1-4dcc-87c0-8a47a47abb75",
                                                "sense_id": "58a74181-2f56-3cd1-b2f9-fb2c991a2f0c",
                                                "text": "„Für uns ist das Grund genug, euch unsere 7 heißesten Stripteases der Filmgeschichte zu präsentieren. “"
                                            },
                                            {
                                                "example_id": "c1198bc9-abb1-47eb-b2aa-3f3da6047ae0",
                                                "sense_id": "58a74181-2f56-3cd1-b2f9-fb2c991a2f0c",
                                                "text": "„Ich erinnere mich an den Striptease im Hinterzimmer des einzigen Hotels in einer Provinzstadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "537075d2-8f78-39d6-8ecf-cd297570c352",
                                        "entry_id": "ffba22c4-ebba-3e55-ab59-8fb5f62709ea",
                                        "glosses": [
                                            "Entblößung"
                                        ],
                                        "tags": [
                                            "jocular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "347a81ab-36b0-4ec9-a84a-bed8eb60fc87",
                                                "sense_id": "537075d2-8f78-39d6-8ecf-cd297570c352",
                                                "text": "Beim Urologen musste Ferdinand einen kleinen Striptease machen."
                                            },
                                            {
                                                "example_id": "49906065-5025-4e9a-b44c-e258b5c0a239",
                                                "sense_id": "537075d2-8f78-39d6-8ecf-cd297570c352",
                                                "text": "Im Schwimmbad sorgte Wencke für einen Striptease von Sandro, als sie ihm die Badehose herunterriss."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
