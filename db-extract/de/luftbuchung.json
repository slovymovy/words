                ],
                "senses": [
                    {
                        "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                        "entry_id": "cd27cf9d-32b9-3fa5-a12e-e9defe56f905",
                        "glosses": [
                            "Buchung, der kein tatsächlicher Geschäftsvorfall zugrunde liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900b9c97-5061-444f-a734-1da0cbd2516a",
                                "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                                "text": "„Dass sich die Gelder auf den asiatischen Treuhandkonten befinden, könnte sich jedoch als Luftbuchung herausstellen.“"
                            },
                            {
                                "example_id": "0ff6ad6f-0621-4283-b66d-3565187e6c0f",
                                "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                                "text": "„Ein Auftrag, der nicht finanziell untersetzt ist, wäre eine Luftbuchung.“"
                            },
                            {
                                "example_id": "d5f1520a-e1ab-44a7-8aab-a3306f0f45f6",
                                "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                                "text": "„Fehlt die Warenbuchung, könnte dies einen Hinweis auf eine Luftbuchung darstellen.“"
                            },
                            {
                                "example_id": "d615bef0-cb8a-43e6-bfa6-8d4209d181bf",
                                "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                                "text": "„Dass der Vertrag über 68 Millionen DM mit einer «australischen Tochter» von Schneider gefälscht war und es sich um eine reine Luftbuchung handelte, bemerkte der Banker nicht.“"
                            },
                            {
                                "example_id": "95775c53-5b54-4064-96d7-57b354f6c736",
                                "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                                "text": "„Es ging unter anderem um viele Millionen Euro, die angeblich auf Treuhandkonten in Asien lagen und die sich später als Luftbuchung erweisen sollten.“"
                            },
                            {
                                "example_id": "0bb773b5-d5cd-4608-9edb-60aee623a9ff",
                                "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                                "text": "„Die entsprechende ‚Luftbuchung‘ stellt eine Manipulation der Rechnungslegung und einen Verstoß gegen das rechtlich Zulässige dar.“"
                            },
                            {
                                "example_id": "8e851dcb-bad8-4b8f-8052-16654acdde94",
                                "sense_id": "187882c7-0f93-3df0-afe3-04f6a7665e8e",
                                "text": "„Der Termin damals kam wirklich nie zustande: Diese Apologeten der Antriebshemmung hatten versucht, mich durch eine Luftbuchung von weiteren Versuchen abzuhalten, die nötigen Gelder für uns freizusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
