                ],
                "senses": [
                    {
                        "sense_id": "d99a51cf-591d-3824-955b-029f26ccd49b",
                        "entry_id": "4236982c-bcc1-3a4b-863b-ba83fafa6945",
                        "glosses": [
                            "opstandigheid tegen het wettig gezag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99ed9dc6-4375-4e01-974a-75f01279a8af",
                                "sense_id": "d99a51cf-591d-3824-955b-029f26ccd49b",
                                "text": "Willem de Zwijger was de leider van de rebellie tegen de Spanjaarden."
                            }
                        ]
                    },
                    {
                        "sense_id": "537e1e61-b220-3e93-b50b-5c8db4b7a0c4",
                        "entry_id": "4236982c-bcc1-3a4b-863b-ba83fafa6945",
                        "glosses": [
                            "opstandigheid in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "489d8dfe-01b2-403d-88ad-46c859be2a9f",
                                "sense_id": "537e1e61-b220-3e93-b50b-5c8db4b7a0c4",
                                "text": "Buurland Senegal, al jarenlang de grootste tegenstander van Jammeh in de regio, heeft zijn eigen appeltje te schillen met Gambia. „Ik vermoed dat de Senegalezen proberen de rebellen uit Cassamance uit te schakelen”, zegt een westerse diplomaat in Banjul. De trouwste en wreedste soldaten van Jammeh kwamen uit de Zuid-Senegalese regio Cassamance, waar al enkele decennia een rebellie suddert van separatisten. Jammeh steunde die rebellie en rekruteerde onder de opstandelingen voor zijn gevreesde paramilitaire eenheid de Junggulars."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d3f0606-9704-44bd-ab80-1be8907e5b81",
                        "source_entry_id": "4236982c-bcc1-3a4b-863b-ba83fafa6945",
                        "target_lang_word": "Rebellion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rebellion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3d690c6-1898-307b-90b8-b38554b230ec",
                                        "entry_id": "83d66a68-9305-39f3-b648-686b93a7d3f9",
                                        "glosses": [
                                            "entschiedener Widerstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef7d2d08-38b4-4a49-926c-e659c5edeb49",
                                                "sense_id": "b3d690c6-1898-307b-90b8-b38554b230ec",
                                                "text": "„Im besetzten Syrien war es diesem kurz zuvor gelungen, eine Rebellion in Palästina innerhalb eines halben Jahres niederzuschlagen.“"
                                            },
                                            {
                                                "example_id": "b6cd5469-e0ac-4f40-98cf-ee9a3bf2bc7c",
                                                "sense_id": "b3d690c6-1898-307b-90b8-b38554b230ec",
                                                "text": "„Das hat dann nichts mehr mit Rebellion in der Pubertät zu tun.“"
                                            },
                                            {
                                                "example_id": "8b6749ca-2725-4c61-a243-95b48de9d531",
                                                "sense_id": "b3d690c6-1898-307b-90b8-b38554b230ec",
                                                "text": "„Eine Rebellion der freien Mulatten schlug zwar fehl, aber im August 1791 begann im Norden der Kolonie ein Sklavenaufstand.“"
                                            },
                                            {
                                                "example_id": "20066557-df7d-4441-a538-c4eb7660ac7e",
                                                "sense_id": "b3d690c6-1898-307b-90b8-b38554b230ec",
                                                "text": "„Schließlich erheben sich mehrere Gruppen zur offenen Rebellion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
