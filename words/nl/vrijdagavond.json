                    "sense_id": "228bcfdb-208d-38c5-8462-9beaef49c98b",
                    "sense_definition": "De uren van de vrijdag die tussen de middag en de nacht vallen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_periods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben die hele <w>vrijdagavond</w> in het ziekenhuis doorgebracht.",
                            "target_lang_translations": {
                                "en": "We spent that whole <w>Friday evening</w> in the hospital.",
                                "ru": "Мы провели весь <w>вечер пятницы</w> в больнице.",
                                "pl": "Spędziliśmy cały <w>piątkowy wieczór</w> w szpitalu.",
                                "de": "Wir haben den ganzen <w>Freitagabend</w> im Krankenhaus verbracht.",
                                "fr": "Nous avons passé tout ce <w>vendredi soir</w> à l'hôpital.",
                                "it": "Abbiamo passato tutto il <w>venerdì sera</w> in ospedale.",
                                "cs": "Celý ten <w>páteční večer</w> jsme strávili v nemocnici.",
                                "tr": "O <w>Cuma akşamının</w> tamamını hastanede geçirdik.",
                                "es": "Pasamos todo el <w>viernes por la noche</w> en el hospital.",
                                "zh": "我们整个<w>周五晚上</w>都是在医院度过的。"
                            }
                        },
                        {
                            "text": "De <w>vrijdagavond</w> is mijn favoriete moment van de week.",
                            "target_lang_translations": {
                                "en": "<w>Friday evening</w> is my favorite moment of the week.",
                                "ru": "<w>Вечер пятницы</w> — моё любимое время недели.",
                                "pl": "<w>Piątkowy wieczór</w> to mój ulubiony moment tygodnia.",
                                "de": "Der <w>Freitagabend</w> ist mein liebster Moment der Woche.",
                                "fr": "Le <w>vendredi soir</w> est mon moment préféré de la semaine.",
                                "it": "Il <w>venerdì sera</w> è il mio momento preferito della settimana.",
                                "cs": "<w>Páteční večer</w> je můj nejoblíbenější moment v týdnu.",
                                "tr": "<w>Cuma akşamı</w> haftanın en sevdiğim anıdır.",
                                "es": "El <w>viernes por la noche</w> es mi momento favorito de la semana.",
                                "zh": "<w>周五晚上</w>是我一周中最喜欢的时刻。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "een fijne vrijdagavond",
                        "op vrijdagavond"
                    ],
                    "target_lang_definitions": {
                        "en": "The hours of Friday between the afternoon and the night.",
                        "ru": "Время суток в пятницу, наступающее после дня и длящееся до ночи.",
                        "pl": "Godziny piątku przypadające między popołudniem a nocą.",
                        "de": "Die Stunden des Freitags, die zwischen dem Nachmittag und der Nacht liegen.",
                        "fr": "Les heures du vendredi situées entre l'après-midi et la nuit.",
                        "it": "Le ore del venerdì che intercorrono tra il pomeriggio e la notte.",
                        "cs": "Část pátku mezi odpolednem a nocí.",
