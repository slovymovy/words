                ],
                "translations": [
                    {
                        "translation_id": "f0b4dd52-7d1d-4208-b0e1-4963ad600d60",
                        "source_entry_id": "429e543c-1dde-3045-b163-07df9afac4be",
                        "source_sense_id": "33f28d22-16b8-3838-9ddc-db50a4a27847",
                        "target_lang_word": "palynological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palynological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4fc6e62-e269-3478-b603-efb4e5d1d4e6",
                                        "entry_id": "e2b1423b-3faf-3aa8-b500-084cd4f18958",
                                        "glosses": [
                                            "Of or pertaining to palynology."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "263d19da-43b2-4faf-ac7f-030ba38e9aa0",
                                                "sense_id": "b4fc6e62-e269-3478-b603-efb4e5d1d4e6",
                                                "text": "Palynological fossils comprising algal and fungal bodies, bryophytic and pteridophytic spores, gymnospermic and angiospermic pollen grains and a host of other organisms are more reliable and precise in determining age and reconstructing palaeoenvironment for the abundance almost in all the varied conditions of deposition."
                                            },
                                            {
                                                "example_id": "2dea36fe-32e0-40e1-9348-ac44753a3c29",
                                                "sense_id": "b4fc6e62-e269-3478-b603-efb4e5d1d4e6",
                                                "text": "It also demonstrated that pollen prepared using standard palynological methods still retained a good UAC signal, meaning that thousands of previously studied pollen preparations, stored in museums and institutions worldwide, may be repurposed to tell us more about sunshine in the past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26ebf913-dbbe-4381-9e14-33c29fa51c85",
                        "source_entry_id": "429e543c-1dde-3045-b163-07df9afac4be",
                        "source_sense_id": "33f28d22-16b8-3838-9ddc-db50a4a27847",
                        "target_lang_word": "palynologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palynologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3237a5-60a6-379f-8948-cbfbaeadb6cd",
                                        "entry_id": "186a06b8-029f-37c8-a3a0-3a70214989e8",
                                        "glosses": [
                                            "Relatif à la palynologie, l'étude des pollens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36790284-edb8-4099-ab19-f91c8bb240c5",
                                                "sense_id": "5a3237a5-60a6-379f-8948-cbfbaeadb6cd",
                                                "text": "L'examen palynologique systématique des sols, des fossés de clôture, des fosses de ces sanctuaires contribuent à la reconstruction de l'environnement végétal, qu'il soit naturel (forêt, buissons, rivières, etc.) ou artificiel (cultures, haies, aménagement botanique)."
                                            },
                                            {
                                                "example_id": "4b4b66b3-cd5b-45d8-a103-a061eea2d758",
                                                "sense_id": "5a3237a5-60a6-379f-8948-cbfbaeadb6cd",
                                                "text": "L’étude palynologique donne l’image d’un paysage alors significativement boisé, mais en cours d’ouverture, voire de défrichement, puisque apparaissent des cultures (notamment de céréales) et des pâturages."
                                            },
                                            {
                                                "example_id": "fe909b83-40fc-4dce-95f1-8ffe8c7571c6",
                                                "sense_id": "5a3237a5-60a6-379f-8948-cbfbaeadb6cd",
                                                "text": "Une datation palynologique."
                                            },
                                            {
                                                "example_id": "e0b9316f-f7a2-4a43-b40c-c86a31232b28",
                                                "sense_id": "5a3237a5-60a6-379f-8948-cbfbaeadb6cd",
                                                "text": "Un diagramme palynologique."
                                            },
                                            {
                                                "example_id": "4304fc00-cb56-48dc-b472-5169865d06df",
                                                "sense_id": "5a3237a5-60a6-379f-8948-cbfbaeadb6cd",
                                                "text": "Le potentiel palynologique d'un lieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
