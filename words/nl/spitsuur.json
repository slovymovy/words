    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7030c0cf-0bea-3b62-b2d8-51611561cfc1",
                    "sense_definition": "De periode van de dag waarop het verkeer het drukst is, meestal aan het begin en einde van de werkdag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verkeersdrukte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het <w>spitsuur</w> staan er altijd lange files op de snelweg naar Utrecht.",
                            "target_lang_translations": {
                                "en": "During <w>rush hour</w> there are always long traffic jams on the highway to Utrecht."
                            }
                        },
                        {
                            "text": "Als je de drukte in het <w>spitsuur</w> wilt vermijden, kun je beter wat later vertrekken.",
                            "target_lang_translations": {
                                "en": "If you want to avoid the busyness during <w>rush hour</w>, you had better leave a bit later."
                            }
                        }
                    ],
                    "synonyms": [
                        "spits"
                    ],
                    "antonyms": [
                        "daluur"
                    ],
                    "common_phrases": [
                        "het spitsuur vermijden",
                        "tijdens het spitsuur"
                    ],
                    "target_lang_definitions": {
                        "en": "The period of the day when traffic is heaviest, usually at the start and end of the workday."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rush hour",
                                "target_lang_sense_clarification": "traffic"
                            },
                            {
                                "target_lang_word": "peak hour",
                                "target_lang_sense_clarification": "traffic"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aee10a9-87ed-3152-a05c-d7ede2974339",
                    "sense_definition": "Een periode van grote drukte of hectiek, niet noodzakelijk in het verkeer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "algemene_drukte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is momenteel echt een <w>spitsuur</w> in de winkel vanwege de kerstinkopen.",
                            "target_lang_translations": {
                                "en": "It is currently a real <w>rush hour</w> in the shop due to Christmas shopping."
                            }
                        },
                        {
                            "text": "Met drie jonge kinderen is de ochtend thuis altijd een klein <w>spitsuur</w>.",
                            "target_lang_translations": {
                                "en": "With three young children, the morning at home is always a bit of a <w>rush hour</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een echt spitsuur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Figuratively used to describe busy times in non-traffic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A period of great busyness or hectic activity, not necessarily in traffic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rush hour",
                                "target_lang_sense_clarification": "figurative, busy time"
                            },
                            {
                                "target_lang_word": "peak time",
                                "target_lang_sense_clarification": "busy period"
                            }
                        ]
                    }
                }
            ]
        }
    ]
