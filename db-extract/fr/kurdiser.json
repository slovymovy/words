                "senses": [
                    {
                        "sense_id": "9cccbe8c-9d75-3d67-8801-60003947f982",
                        "entry_id": "9d2f3a54-cb76-34fb-a5f1-6452abdb2165",
                        "glosses": [
                            "Donner un caractère kurde à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "becee9a8-c861-4aea-b199-504ca6194516",
                                "sense_id": "9cccbe8c-9d75-3d67-8801-60003947f982",
                                "text": "Mais où le ministre trouvera-t-il les fonds nécessaires (un demi-milliard de dinars irakiens) pour réparer, moderniser et kurdiser ses établissements ?"
                            },
                            {
                                "example_id": "fb955754-99dd-4bc4-8e63-e0c6959fb945",
                                "sense_id": "9cccbe8c-9d75-3d67-8801-60003947f982",
                                "text": "Il a fallu beaucoup de courage et de persévérance à ces jeunes intellectuels, exilés dans une contrée aussi éloignée de leur patrie, pour \"kurdiser\" leur écriture alors qu’ils écrivaient jusqu’ici en turc, seule langue enseignée en Turquie."
                            }
                        ]
                    }
