                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d341033-6b1c-32ec-b5e3-67d843cf1464",
                                        "entry_id": "502bad9a-5bf0-326b-af8e-6db442fa92bc",
                                        "glosses": [
                                            "To put to the proof; to prove the truth, genuineness, or quality of by experiment, or by some principle or standard; to try."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2797d96-07d8-42bb-b105-eab2ce972e09",
                                                "sense_id": "1d341033-6b1c-32ec-b5e3-67d843cf1464",
                                                "text": "to test the soundness of a principle"
                                            },
                                            {
                                                "example_id": "38c0e273-677a-4c9f-84af-31bf30591f45",
                                                "sense_id": "1d341033-6b1c-32ec-b5e3-67d843cf1464",
                                                "text": "to test the validity of an argument"
                                            },
                                            {
                                                "example_id": "4077d43a-1013-4c18-9c7f-4f931df09c62",
                                                "sense_id": "1d341033-6b1c-32ec-b5e3-67d843cf1464",
                                                "text": "September 17, 1796, George Washington, Farewell Address\nExperience is the surest standard by which to test the real tendency of the existing constitution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a172a3-2c41-3cc0-a9ae-c26e727dfac9",
                                        "entry_id": "502bad9a-5bf0-326b-af8e-6db442fa92bc",
                                        "glosses": [
                                            "To administer or assign an examination, often given during the academic term, to (somebody)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5691845a-d347-3233-9cc9-916bfbb67131",
                                        "entry_id": "502bad9a-5bf0-326b-af8e-6db442fa92bc",
                                        "glosses": [
                                            "To place a product or piece of equipment under everyday and/or extreme conditions and examine it for its durability, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d827d030-ad21-42ca-a2f0-e5a74364065f",
                                                "sense_id": "5691845a-d347-3233-9cc9-916bfbb67131",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems–[…]. Such a slow-release device containing angiogenic factors could be placed on the pia mater covering the cerebral cortex and tested in persons with senile dementia in long term studies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8522eb0e-c9c4-33af-acec-461e8935d061",
                                        "entry_id": "502bad9a-5bf0-326b-af8e-6db442fa92bc",
                                        "glosses": [
                                            "To be shown to be by test."
                                        ],
                                        "tags": [
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f6487e5-8c96-49fd-8a18-4741c50b33b8",
                                                "sense_id": "8522eb0e-c9c4-33af-acec-461e8935d061",
                                                "text": "He tested positive for cancer."
                                            },
                                            {
                                                "example_id": "3bf69633-26a4-4227-ba08-71ccbc4feb87",
                                                "sense_id": "8522eb0e-c9c4-33af-acec-461e8935d061",
                                                "text": "It is probable that children who test above 180 IQ are actually present in our juvenile population in greater frequency than at the rate of one in a million."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43edf180-879e-3f8f-ad04-2e5d05863594",
                                        "entry_id": "502bad9a-5bf0-326b-af8e-6db442fa92bc",
                                        "glosses": [
                                            "To examine or try, as by the use of some reagent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
