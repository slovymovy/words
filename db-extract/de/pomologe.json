                                "target_senses": [
                                    {
                                        "sense_id": "3c616ddf-08c7-3788-babc-987a0f5500da",
                                        "entry_id": "a54887f3-3d7c-368d-9797-208de679e449",
                                        "glosses": [
                                            "A person involved in pomology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c698a6-f534-4eb0-836f-ab4ced2c1966",
                                                "sense_id": "3c616ddf-08c7-3788-babc-987a0f5500da",
                                                "text": "David Wight and Benjamin Jarvis organized the Pomologist Club, inviting the town to Tree-Plantings."
                                            },
                                            {
                                                "example_id": "0d68e854-5f47-47e1-8d10-d96efb75f054",
                                                "sense_id": "3c616ddf-08c7-3788-babc-987a0f5500da",
                                                "text": "According to Terry Freed, a pomologist and an owner of Garden of Eden Orchards, a commercial grower in Salisbury, Md., most citrus trees can be grown in Florida and in the Southwest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "270678a8-a3e3-4fea-9e37-b14d2fc8b0d9",
                        "source_entry_id": "1c458db1-8134-3ff4-83cc-dd799c373cd3",
                        "source_sense_id": "fe9fca8b-ba8b-339b-b264-0cb9cfaee762",
