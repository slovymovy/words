                        "examples": [
                            {
                                "example_id": "947e4737-51b8-4caf-890e-3e69d9b4b231",
                                "sense_id": "a13802d6-0126-3c66-ae26-53cd9e295e5d",
                                "text": "“My advice, or, leastways, I should say, my orders, is,” said the fattest man of the party, “that we 'mediately go home again.”"
                            },
                            {
                                "example_id": "d538a933-8b05-42d0-a081-1ed7e1d5d69b",
                                "sense_id": "a13802d6-0126-3c66-ae26-53cd9e295e5d",
                                "text": "[…]so that I couldn't help telling her, sir, that in our country, leastways in Virginia (they say the Yankees are very pert), young people don't speak of their elders so."
                            },
                            {
                                "example_id": "8e9dc100-9a2a-40c8-acfa-fe900db724c3",
                                "sense_id": "a13802d6-0126-3c66-ae26-53cd9e295e5d",
                                "text": "‘Cook-housekeeper jobs don’t grow on trees,’ went on the woman, ‘leastways not where you can keep a youngster with you.’"
                            },
                            {
                                "example_id": "023cadd9-58fa-48f3-baab-e9d19a8264f2",
                                "sense_id": "a13802d6-0126-3c66-ae26-53cd9e295e5d",
                                "text": "“I was lucky, just an arm (lost in combat), and the hope of a life, a normal man’s life, leastways”"
                            }
                        ]
                    }
                ],
