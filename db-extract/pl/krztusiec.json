                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keuchhusten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                        "entry_id": "4af69faf-a46d-3393-a057-9613976dc480",
                                        "glosses": [
                                            "bakterielle Infektionskrankheit, die starke Hustenanfälle verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df193182-9a4f-43ad-9953-996aebb3be52",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "Für Säuglinge kann Keuchhusten lebensbedrohlich sein."
                                            },
                                            {
                                                "example_id": "aad753e2-b4a7-4a87-b609-fc61acd82e04",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "„Nur, mit ihrem eigenen Glauben daran schien es nicht gar so weit her zu sein, denn sie bekamen Masern, Keuchhusten und Windpocken.“"
                                            },
                                            {
                                                "example_id": "aee11c85-ece7-43d1-b15e-42a45b5c1fe9",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "„Die drei Kinder hatten Keuchhusten und konnten ihn nicht loswerden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
