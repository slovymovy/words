                                            {
                                                "example_id": "384ec271-3d91-41c8-9f09-5044b70e0066",
                                                "sense_id": "dae27e34-3334-3c92-94ae-1ec2f479a1fe",
                                                "text": "These grey and dun colors may be also produced by mixing whites and blacks."
                                            },
                                            {
                                                "example_id": "ba245bb2-4628-4dbe-a0ca-570fdd4a6dba",
                                                "sense_id": "dae27e34-3334-3c92-94ae-1ec2f479a1fe",
                                                "text": "This is itself a cheerless spot, particularly on a rainy day, when, overshadowed by the great massif of rock that towers in the background, and surrounded by the grey and cheerless quarries, it has a depressing character much in contrast with the green verdure encountered on the northern end of this interesting branch line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f7954bf-f0e0-359f-832f-84f797919636",
                                        "entry_id": "026f5f1a-56b8-3642-b3a5-6be38a502e24",
                                        "glosses": [
                                            "Synonym of coloured (pertaining to the mixed race of black and white)."
                                        ],
                                        "tags": [
                                            "South-Africa",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb6d33ce-1bd4-3ffb-b9d4-2f4dba792d2a",
                                        "entry_id": "78d0d234-7f7b-3d8c-a3e6-eec8791a1dd1",
                                        "glosses": [
                                            "Commonwealth standard spelling of gray."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b101e160-c6d8-4097-9444-5d9fa2f0c92a",
                                                "sense_id": "fb6d33ce-1bd4-3ffb-b9d4-2f4dba792d2a",
                                                "text": "Now only a few hand-hewn cedar planks and roof beams remained, moss-grown and sagging—a few totem poles, greyed and split."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da093b87-cca1-3024-9064-ff3779fed1fb",
                                        "entry_id": "dfa8905c-401f-3b56-9714-412b5fca70f1",
                                        "glosses": [
                                            "Commonwealth standard spelling of gray."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f99aba-7128-4fa7-8fea-a3cd8c29f2fb",
                                                "sense_id": "da093b87-cca1-3024-9064-ff3779fed1fb",
                                                "text": "Woe worth the chase, woe worth the day, / That costs thy life, my gallant grey."
                                            },
                                            {
                                                "example_id": "25a885ce-1a1f-4310-8658-97ecc8663770",
                                                "sense_id": "da093b87-cca1-3024-9064-ff3779fed1fb",
                                                "text": "Pioneer seemed now to have the game in his own hands; but the Captain, by taking two desperate leaps, cut off a corner, by which he regained the ground he had lost by the fall, and was up with the grey the remainder of the chase."
                                            }
                                        ]
                                    }
                                ]
                            }
