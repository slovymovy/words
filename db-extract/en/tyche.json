                "senses": [
                    {
                        "sense_id": "11fce862-a591-3e9c-8a4a-dd7ca6a41da1",
                        "entry_id": "0da86869-5009-3d3e-b1a7-ff688981453d",
                        "glosses": [
                            "The goddess of luck/fortune; counterpart of the Roman Fortuna."
                        ],
                        "tags": [
                            "Greek",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "57b5076d-8a8b-4999-b62d-f116c919e29d",
                                "sense_id": "11fce862-a591-3e9c-8a4a-dd7ca6a41da1",
                                "text": "The goddess Tyche was a very important deity in the Hellenistic world.¹⁵ \"She was not blind chance, but some order of affairs that men could not comprehend.\"¹⁹ Tyche played her part in great events and in small ones[…]."
                            },
                            {
                                "example_id": "edddd618-5c5a-4261-883e-19d7105d5829",
                                "sense_id": "11fce862-a591-3e9c-8a4a-dd7ca6a41da1",
                                "text": "2000, Terence L. Donaldson (editor), Religious Rivalries and the Struggle for Success in Caesarea Maritima, Canadian Corporation for Studies in Religion, Wilfrid Laurier University Press, page 113,\nAt Caesarea, several gems depicting a Tyche, as well as a possible statue of Tyche found at Caesarea, show attributes of Isis."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a772d70-e20f-3194-924b-fd3dd69144ff",
                        "entry_id": "0da86869-5009-3d3e-b1a7-ff688981453d",
                        "glosses": [
                            "Any of several city goddesses, typically regarded as aspects of the goddess of fortune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f344a56-2286-4f03-852c-d4e9ece9ac16",
                                "sense_id": "1a772d70-e20f-3194-924b-fd3dd69144ff",
                                "text": "Tyche of Antioch"
                            },
                            {
                                "example_id": "6f7a8b1c-9352-4d64-b6df-7021e3dac3ac",
                                "sense_id": "1a772d70-e20f-3194-924b-fd3dd69144ff",
                                "text": "Tyche of Constantinople"
                            },
                            {
                                "example_id": "2c1d2973-9b28-43e4-9ed1-b507c7eb33e7",
                                "sense_id": "1a772d70-e20f-3194-924b-fd3dd69144ff",
                                "text": "Following the dedicatory page is the illustrated section II, comprising the representations of the city goddesses or divine Fortunes (Tyches) of four major cities of the late Roman empire."
                            },
                            {
                                "example_id": "87559d2f-7cc0-4559-99ee-0e7b5324b4af",
                                "sense_id": "1a772d70-e20f-3194-924b-fd3dd69144ff",
                                "text": "The Tyches of individual cities featured prominently in late ancient art and coinage."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e185f28-abd2-3dac-a459-feec1078a90e",
                        "entry_id": "0da86869-5009-3d3e-b1a7-ff688981453d",
                        "glosses": [
                            "The main belt asteroid 258 Tyche."
                        ],
                        "tags": [],
                        "examples": []
