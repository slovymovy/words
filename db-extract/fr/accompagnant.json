                        "glosses": [
                            "Qui accompagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d9d674-0c56-4f6e-8a9e-5edceaf9d26e",
                                "sense_id": "c1596b7e-253a-3113-9907-f7c66521bb69",
                                "text": "La famille accompagnante peut être admise dans les mêmes conditions que le travailleur sélectionné ou le demandeur principal : autrement dit, les accompagnants bénéficient de l’accès immédiat au marché du travail et d’une série de prestations sociales."
                            }
                        ]
                    }
