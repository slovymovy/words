                                    {
                                        "sense_id": "bd2975aa-e5b4-317d-ade7-f8b435cbf335",
                                        "entry_id": "9fd79321-3fb4-34e7-8fea-fbd8d8c77bbb",
                                        "glosses": [
                                            "blaue Augen habend"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5585b26f-1e26-478d-8be7-4eef258976d4",
                                                "sense_id": "bd2975aa-e5b4-317d-ade7-f8b435cbf335",
                                                "text": "Der vermisste Mann wird als braunhaarig und blauäugig beschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                        "entry_id": "9fd79321-3fb4-34e7-8fea-fbd8d8c77bbb",
                                        "glosses": [
                                            "naiv, arglos, weltfremd oder äußerst optimistisch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "497ed5bf-406f-47f1-aeff-53f585471e85",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "Es ist blauäugig, allen Versprechen der Politiker zu glauben."
                                            },
                                            {
                                                "example_id": "031c0219-8eac-4de9-af19-f7c1ad997534",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "Gunda war viel zu blauäugig, als sie ihr Geld in Zertifikaten anlegte."
                                            },
                                            {
                                                "example_id": "2eb4f32c-3ecf-4143-a91c-3f9bd21a7cac",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "Die Argumentation des Redners war sehr blauäugig."
                                            },
                                            {
                                                "example_id": "16d4f4a7-9f53-4372-8a74-6ed25b731145",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "„Wir Reeder waren blauäugig – dachten, der Boom der hört nicht mehr auf, und haben entsprechend Schiffe bestellt, ohne konkreten Bedarf.“"
                                            },
                                            {
                                                "example_id": "5d146fa6-26b5-49ad-9115-da6352bdab84",
                                                "sense_id": "b6378cb3-f9a1-38ec-83ef-06a5216921da",
                                                "text": "„Waren die Redaktionen wirklich so blauäugig oder die Tarnung der kommerziellen Botschaften so gut?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe014b8a-9ba5-4cf6-b2f0-b5166e4f0e5e",
                        "source_entry_id": "356e1729-67d7-3630-9403-37af9279a8f6",
                        "source_sense_id": "98914e96-2056-38ff-9d77-c71cd1e2e2ca",
                        "target_lang_word": "blue-eyed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blue-eyed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a31e0a0a-eed4-325c-8e86-7d1c36e1432e",
                                        "entry_id": "b8f0b2ce-d1ca-31f7-9c2c-abe5b25253be",
                                        "glosses": [
                                            "Someone's favorite."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b864aa-7fb3-43c5-a27e-0adffbaa50e2",
                                                "sense_id": "a31e0a0a-eed4-325c-8e86-7d1c36e1432e",
                                                "text": "blue-eyed boy"
                                            },
                                            {
                                                "example_id": "ec49b9f3-9aaa-4924-abb2-7d94abd9e475",
                                                "sense_id": "a31e0a0a-eed4-325c-8e86-7d1c36e1432e",
                                                "text": "“I wouldn't marry anyone else if they came to me bringing apes, ivory and peacocks. Tell me what he was like as a boy.” “Oh, much the same as the rest of us.” “Nonsense!” “Except, of course, for rescuing people from burning buildings and saving blue-eyed children from getting squashed by runaway horses.” “He did that a lot?” “Almost daily.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59df9295-4101-30da-88e6-22ea381bb1d1",
                                        "entry_id": "b8f0b2ce-d1ca-31f7-9c2c-abe5b25253be",
                                        "glosses": [
                                            "Naive; innocent; ingenuous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bb7ee56-2fa9-32fe-afcb-e240ab5823e7",
                                        "entry_id": "b8f0b2ce-d1ca-31f7-9c2c-abe5b25253be",
                                        "glosses": [
                                            "Characteristic of or pertaining to white people; Caucasian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e522e80b-0dff-4b9d-8eb7-cb2b234e359b",
                                                "sense_id": "6bb7ee56-2fa9-32fe-afcb-e240ab5823e7",
                                                "text": "blue-eyed performer"
                                            },
                                            {
                                                "example_id": "04b0c7a1-17a5-4a17-8190-cbfc1d2bb0f9",
                                                "sense_id": "6bb7ee56-2fa9-32fe-afcb-e240ab5823e7",
                                                "text": "Elijah Muhammad spoke of how in this wilderness of North America, for centuries the “blue-eyed devil white man” had brainwashed the “so-called Negro.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6caa1f01-9ee8-3381-adb9-9e72673dd03c",
                                        "entry_id": "b8f0b2ce-d1ca-31f7-9c2c-abe5b25253be",
                                        "glosses": [
                                            "Characteristic of or pertaining to white people; Caucasian.",
                                            "Written or performed by white people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ad57829-fb32-4124-aed8-b752e7e0c599",
                                                "sense_id": "6caa1f01-9ee8-3381-adb9-9e72673dd03c",
                                                "text": "blue-eyed soul; blue-eyed jazz"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1371e23c-dcb7-30a7-82e2-77ce59161f11",
                                        "entry_id": "b8f0b2ce-d1ca-31f7-9c2c-abe5b25253be",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see blue, eyed (or eye, -ed)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0d3fed-eb80-46a6-813f-187f1915bd52",
                                                "sense_id": "1371e23c-dcb7-30a7-82e2-77ce59161f11",
                                                "text": "Well then—if I must neither stir out of the gate nor look out at window, I will at least see what the inside of the house contains that may help to pass away one’s time—peradventure, I may light on that blue-eyed laugher in some corner or other."
                                            },
                                            {
                                                "example_id": "db8db28a-3011-4928-9503-6f9f2fcbd5e3",
                                                "sense_id": "1371e23c-dcb7-30a7-82e2-77ce59161f11",
                                                "text": "They were all of the same type. Rosy, blooming, fair-haired girls, with small straight features, and the mother’s bright blue eyes, but Bonny was the rosiest and the bluest-eyed of them all."
                                            },
                                            {
                                                "example_id": "0d7fb821-99ca-4e74-b2e4-2668e6eae954",
                                                "sense_id": "1371e23c-dcb7-30a7-82e2-77ce59161f11",
                                                "text": "Then, the voice of the oldest of the Lay brothers, the leader of the pack, the tallest, the blackest-haired, the bluest-eyed."
                                            },
                                            {
                                                "example_id": "ff65875e-5fbf-41b4-98d3-77d31bfbd262",
                                                "sense_id": "1371e23c-dcb7-30a7-82e2-77ce59161f11",
                                                "text": "Iconic Barbie may be blonder, bluer-eyed, richer, thinner, leggier and bustier than everyone else, but she's also “not special” and “disposable.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
