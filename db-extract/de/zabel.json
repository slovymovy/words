                    },
                    {
                        "form_id": "93176984-a252-460f-9269-ab6a11ff1f0c",
                        "entry_id": "ec122483-c134-334f-955a-0a76da067252",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zabel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                        "entry_id": "ec122483-c134-334f-955a-0a76da067252",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1eb5fb9-8049-425d-83a5-0132caac394b",
                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                "text": "Frau Zabel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3398dc48-7a9c-4358-a4de-5605ebf789f1",
                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                "text": "Herr Zabel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0057e18f-cab9-48fc-a4fd-e68c3f7ffb9e",
                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                "text": "Die Zabels fliegen heute nach Düsseldorf."
                            },
                            {
                                "example_id": "2ae69575-5260-49f6-b72a-47ae29d5b36c",
                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                "text": "Der Zabel trägt nie die Pullover, die die Zabel ihm strickt."
                            },
                            {
                                "example_id": "589d8b5c-d2dd-474f-a4a1-8a3f9fee0370",
                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zabel kommt, geht der Herr Zabel.“"
                            },
                            {
                                "example_id": "9360c567-f180-4b3b-9793-27e6fea84ebe",
                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                "text": "Zabel kommt und geht."
                            },
                            {
                                "example_id": "dabdcec4-f5c1-4522-8a58-96b28c8d400f",
                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                "text": "Zabels kamen, sahen und siegten."
