                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb9b1a90-1388-4149-8a0a-34c83d18ea72",
                                "sense_id": "bb4e9f9b-665d-3772-b033-8cd1519baedf",
                                "text": "[...], but if he didn't, he says, the job would be too boresome. Boresome, too boresome, is a good way to describe that ten- hour round-trip ride. I am one of the few making it alone."
                            },
                            {
                                "example_id": "fe3ae1e2-e164-4e46-83cd-28653a33e5af",
                                "sense_id": "bb4e9f9b-665d-3772-b033-8cd1519baedf",
                                "text": "“[...] You got to hang on to the melody and never let it get boresome.” That desire never to be “boresome” underscored the ebullience and joy in most of his songs."
                            },
                            {
                                "example_id": "0b987e11-ca17-4cff-8979-cc96e396d2e7",
                                "sense_id": "bb4e9f9b-665d-3772-b033-8cd1519baedf",
                                "text": "Boresome time descended. The kind of time that droops over your knuckles and impedes your fingers' function."
                            }
                        ]
                    }
