                "senses": [
                    {
                        "sense_id": "eea71518-3f9f-3cda-8bb7-c7035540e1de",
                        "entry_id": "1558c33a-f505-3adf-8f24-a73a107c7a94",
                        "glosses": [
                            "посыпать солью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac55ca0-4382-432e-a345-139968992894",
                                "sense_id": "eea71518-3f9f-3cda-8bb7-c7035540e1de",
                                "text": "Подлиповцы расположились есть хлеб, посолив его круто солью, до того, что есть вовсе нельзя было."
                            }
                        ]
                    },
                    {
                        "sense_id": "784c0ea3-390a-3380-9d4a-39f657635cec",
                        "entry_id": "1558c33a-f505-3adf-8f24-a73a107c7a94",
                        "glosses": [
                            "совершить действие, выраженное гл. солить; провести некоторое время, совершая такое действие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3ee834-fb27-4e66-820e-855684260e0d",
                                "sense_id": "784c0ea3-390a-3380-9d4a-39f657635cec",
                                "text": "Коли не посолить хорошенько масло, сударыня, совсем пропадёт."
                            }
                        ]
                    }
