                                "sense_id": "0dd6b3cd-5f21-3b83-b27c-3ac4f7b873cf",
                                "text": "Het communisme van het Sovjetblok verloor de Koude Oorlog tegen het Westers kapitalisme bij de val van de Muur.",
                                "translation": "The Soviet block's Communism lost the Cold War against Western capitalism when the Wall came down.",
                                "english": "The Soviet block's Communism lost the Cold War against Western capitalism when the Wall came down."
                            }
                        ]
                    },
                    {
                        "sense_id": "20e8e1ef-e511-313a-b44d-e2501f8740e0",
                        "entry_id": "c462879c-903e-3685-86be-c938f7e78e4e",
                        "glosses": [
                            "communism (classless and stateless international socialist order)"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "6ff0dbbd-ff60-4e33-a0aa-47296d4a4b7d",
                                "sense_id": "20e8e1ef-e511-313a-b44d-e2501f8740e0",
                                "text": "Marx voorspelde dat het communisme het eindstadium van de ontwikkeling der wereldorde zou zijn.",
                                "translation": "Marx predicted that communism would be the final stage of the development of the world order.",
                                "english": "Marx predicted that communism would be the final stage of the development of the world order."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f76470d-689d-3f2f-9155-14d9a2f7d685",
                        "entry_id": "c462879c-903e-3685-86be-c938f7e78e4e",
