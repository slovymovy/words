                        "glosses": [
                            "cenny, czerwony barwnik zaprawowy stosowany w analizie chemicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d77125-1c37-4623-9bba-8ef90bff4c6a",
                                "sense_id": "db579b56-600d-315e-b4cd-03458531a4a6",
                                "text": "Jeżeli przyjrzymy się uważniej wzorowi alizaryny, zauważymy z łatwością, że zbudowany jest na podobieństwo chinonu i zawiera w swoim składzie chromofor złożony"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e9d4c8c-6a8e-4225-90f0-22c0d9340b55",
                        "source_entry_id": "df9536da-1fcd-3cb6-928b-d9153790ee68",
