{
    "word_family": [
        "disturb",
        "disturbed",
        "disturbing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f70d1fac-cd6b-3a17-ac12-6a9983e766bd",
                    "sense_definition": "The act of bothering or interrupting someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>disturbance</w> caused by the loud music made it impossible to study.",
                            "target_lang_translations": {
                                "ru": "<w>Беспокойство</w>, вызванное громкой музыкой, сделало невозможным учебу."
                            }
                        },
                        {
                            "text": "Please try to work without any <w>disturbance</w> to your colleagues.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, постарайтесь работать, не создавая <w>помех</w> своим коллегам."
                            }
                        }
                    ],
                    "synonyms": [
                        "interruption",
                        "bother"
                    ],
                    "antonyms": [
                        "calmness"
                    ],
                    "common_phrases": [
                        "cause a disturbance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в беспокойстве или прерывании кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помеха",
                                "target_lang_sense_clarification": "препятствие или фактор, мешающий нормальной деятельности"
                            },
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "состояние или действие, нарушающее покой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d7c0b19-8c6f-3015-9a57-84576f233667",
                    "sense_definition": "A noisy commotion or public disorder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police were called to the scene to stop the public <w>disturbance</w>.",
                            "target_lang_translations": {
                                "ru": "На место была вызвана полиция, чтобы прекратить общественные <w>беспорядки</w>."
                            }
                        },
                        {
                            "text": "The crowd created a major <w>disturbance</w> outside the stadium after the game.",
                            "target_lang_translations": {
                                "ru": "Толпа устроила серьезные <w>волнения</w> возле стадиона после игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "commotion",
                        "uproar"
                    ],
                    "antonyms": [
                        "calmness"
                    ],
                    "common_phrases": [
                        "public disturbance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шумное проявление недовольства или нарушение общественного порядка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядки",
                                "target_lang_sense_clarification": "массовые нарушения общественного порядка"
                            },
                            {
                                "target_lang_word": "волнения",
                                "target_lang_sense_clarification": "состояние возбуждения или протеста в обществе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b426847-e37f-36e7-b986-3bd154a74d7f",
                    "sense_definition": "A change that interrupts the normal or regular state of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden storm caused a significant <w>disturbance</w> in the local ecosystem.",
                            "target_lang_translations": {
                                "ru": "Внезапный шторм вызвал значительное <w>нарушение</w> в местной экосистеме."
                            }
                        },
                        {
                            "text": "Doctors are investigating the patient's sleep <w>disturbance</w> to find the cause.",
                            "target_lang_translations": {
                                "ru": "Врачи исследуют <w>расстройство</w> сна у пациента, чтобы найти причину."
                            }
                        }
                    ],
                    "synonyms": [
                        "disruption",
                        "alteration"
                    ],
                    "common_phrases": [
                        "sleep disturbance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение, которое прерывает нормальное или регулярное состояние чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "сбой в работе или отклонение от нормы"
                            },
                            {
                                "target_lang_word": "расстройство",
                                "target_lang_sense_clarification": "нарушение нормального функционирования организма или системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5029557-c987-362c-b4ee-fa02454142c1",
                    "sense_definition": "A person or thing that causes trouble or annoyance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noisy student was a constant <w>disturbance</w> to the rest of the class.",
                            "target_lang_translations": {
                                "ru": "Шумный ученик был постоянной <w>помехой</w> для остального класса."
                            }
                        },
                        {
                            "text": "He is such a <w>disturbance</w> that nobody wants to work with him.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>нарушитель</w> спокойствия, что никто не хочет с ним работать."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuisance",
                        "troublemaker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые доставляют неприятности или раздражают."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушитель",
                                "target_lang_sense_clarification": "тот, кто мешает или создает проблемы"
                            },
                            {
                                "target_lang_word": "помеха",
                                "target_lang_sense_clarification": "человек или объект, создающий неудобства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa36e183-0b30-386e-aa80-fdbad9fc48bb",
                    "sense_definition": "A serious mental or emotional health condition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was diagnosed with a severe emotional <w>disturbance</w>.",
                            "target_lang_translations": {
                                "ru": "У пациента было диагностировано тяжелое эмоциональное <w>расстройство</w>."
                            }
                        },
                        {
                            "text": "Early treatment can help manage a psychological <w>disturbance</w> effectively.",
                            "target_lang_translations": {
                                "ru": "Раннее лечение может помочь эффективно справиться с психологическим <w>расстройством</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorder",
                        "imbalance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезное психическое или эмоциональное заболевание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстройство",
                                "target_lang_sense_clarification": "медицинский термин для обозначения психического или эмоционального нарушения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}