                "senses": [
                    {
                        "sense_id": "107ccfeb-1de4-3ed1-a0e1-47ebfde3d706",
                        "entry_id": "532f26e8-55be-3e95-a92e-80e172068747",
                        "glosses": [
                            "Rassembler en hadrons, dans le cadre d’un processus de rupture des tubes de flux."
                        ],
                        "tags": [
                            "Physique des particules"
                        ],
                        "examples": [
                            {
                                "example_id": "a30e5846-b8d4-464f-a903-c55dd7275890",
                                "sense_id": "107ccfeb-1de4-3ed1-a0e1-47ebfde3d706",
                                "text": "Les quarks n'ont jamais été observés isolés puisqu'ils hadronisent dans de temps très courts…"
                            }
                        ]
                    },
                    {
                        "sense_id": "10753ab5-eee6-3504-a168-1cca68a50eda",
                        "entry_id": "532f26e8-55be-3e95-a92e-80e172068747",
                        "glosses": [
                            "Se rassembler en hadrons, dans le cadre d’un processus de rupture des tubes de flux."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "48af154a-ec71-497c-bd1e-1e085081dd17",
                                "sense_id": "10753ab5-eee6-3504-a168-1cca68a50eda",
                                "text": "Découvert en 1995 par les deux expériences du Tevatron, il possède des caractéristiques atypiques telles qu'un temps de vie le plus court jamais observé qui le fait se désintégrer avant de pouvoir s'hadroniser et donne ainsi accès à sa masse dont sa mesure est alors d'une très grande précision."
                            },
                            {
                                "example_id": "70f9a41d-2da9-491c-acbc-02eb7eb7b185",
                                "sense_id": "10753ab5-eee6-3504-a168-1cca68a50eda",
                                "text": "En une dizaine de femtosecondes, l'éphémère QGP va alors « s'hadroniser », les quarks et gluons ﬁnissant à nouveau conﬁnés au sein des hadrons."
                            },
                            {
                                "example_id": "47c59902-bdf5-40f3-8c87-c43d8c667a84",
                                "sense_id": "10753ab5-eee6-3504-a168-1cca68a50eda",
                                "text": "La durée de vie du top est très courte: il se désintègre avant de s'hadroniser."
                            }
                        ]
                    }
                ],
