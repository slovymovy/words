                    },
                    {
                        "translation_id": "9efab13f-41b5-4d36-8480-d27cac683330",
                        "source_entry_id": "f9ff21f7-5a44-351a-9d89-aefa89352b95",
                        "source_sense_id": "eca3eb73-4e29-3d3b-9b52-fa8a843b79a2",
                        "target_lang_word": "démettre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démettre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25d9c6fa-5f7a-3527-a83d-33c6954d2e72",
                                        "entry_id": "ec81d61d-95b8-3b41-84ca-3226fbbbd157",
                                        "glosses": [
                                            "Retirer d’un emploi, d’une charge, d’une dignité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad085cee-728c-4f5b-9173-1e62eb130b5c",
                                                "sense_id": "25d9c6fa-5f7a-3527-a83d-33c6954d2e72",
                                                "text": "Puis, à partir de mars 1974, appliquant « la tactique du salami » il commença à se débarrasser l’un après l’autre de la plupart de ses ministres parchamis, soit en les réaffectant à des postes de moindre importance, soit en les démettant carrément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "196dec46-634c-34e8-ac1f-c428ebb6baab",
                                        "entry_id": "ec81d61d-95b8-3b41-84ca-3226fbbbd157",
                                        "glosses": [
                                            "Renoncer à quelque chose."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11bc574-458b-4aff-a2f7-4e2361b266e2",
                                                "sense_id": "196dec46-634c-34e8-ac1f-c428ebb6baab",
                                                "text": "Il s’est démis de sa charge en faveur d’untel. - Dioclétien se démit de l’Empire."
                                            },
                                            {
                                                "example_id": "47398cb2-73ca-4f21-abd2-d05046919da9",
                                                "sense_id": "196dec46-634c-34e8-ac1f-c428ebb6baab",
                                                "text": "Quand la France aura fait entendre sa voix souveraine, croyez-le bien, Messieurs, il faudra se soumettre ou se démettre."
                                            },
                                            {
                                                "example_id": "708af7be-da9e-4253-bfd4-1779b0a78e5e",
                                                "sense_id": "196dec46-634c-34e8-ac1f-c428ebb6baab",
                                                "text": "Zaza ne soupçonnait pas combien je la vénérais, ni que je m’étais démise en sa faveur de tout orgueil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd9b8db-5c5c-32b0-814a-fda92faab9fb",
                                        "entry_id": "ec81d61d-95b8-3b41-84ca-3226fbbbd157",
                                        "glosses": [
                                            "Débouter."
                                        ],
                                        "tags": [
                                            "Justice",
                                            "À la voix active"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a79b30b0-9acd-361b-808a-f8b12e90d860",
                                        "entry_id": "ec81d61d-95b8-3b41-84ca-3226fbbbd157",
                                        "glosses": [
                                            "Déplacer un os, disloquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "581bc9c2-2e4f-48f1-9095-df78fed28583",
                                                "sense_id": "a79b30b0-9acd-361b-808a-f8b12e90d860",
                                                "text": "Se démettre le pied. - On lui a démis le poignet en jouant. - Son poignet se démit."
                                            },
                                            {
                                                "example_id": "e4a17cfe-aa77-4845-97c4-d880220b2cc2",
                                                "sense_id": "a79b30b0-9acd-361b-808a-f8b12e90d860",
                                                "text": "Elle prétendait avoir la jambe cassée mais, en réalité, ce n'était que la rotule démise."
                                            },
                                            {
                                                "example_id": "d9938e41-308b-4125-8524-95fb1c9c840b",
                                                "sense_id": "a79b30b0-9acd-361b-808a-f8b12e90d860",
                                                "text": "Michel s’en tire avec un pied démis et une longue plaie peu profonde au mollet, qui a donné contre une pierre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
