                                "target_senses": [
                                    {
                                        "sense_id": "322a576c-c64e-3c17-8e13-5df67551670d",
                                        "entry_id": "4d9e48ec-4d1a-3a83-994d-975a88252c5a",
                                        "glosses": [
                                            "Gaz ayant une très faible réactivité chimique et pouvant être utilisé comme agent d’extinction ou comme gaz protecteur."
                                        ],
                                        "tags": [
                                            "Sécurité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb71139-feab-4513-a772-d1d6a91df468",
                                                "sense_id": "322a576c-c64e-3c17-8e13-5df67551670d",
                                                "text": "L’azote est un gaz inerte, incolore, inodore, insipide et ininflammable. Il a un effet étouffant, est peu soluble dans l'eau et légèrement plus léger que l'air."
                                            },
                                            {
                                                "example_id": "caefbd9e-7f3a-4c53-af30-d15612966572",
                                                "sense_id": "322a576c-c64e-3c17-8e13-5df67551670d",
                                                "text": "Un gaz inerte est un gaz qui n’a pas de réactions chimiques avec son environnement dans des conditions normales de pression et température. Dans l’industrie pharmaceutique et dans la chimie, ces gaz sont principalement l'azote (N₂) et l’argon (Ar), qui sont des composants de l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02d1d931-aecf-3267-8529-be16685be2bc",
