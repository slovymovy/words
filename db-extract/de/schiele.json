                ],
                "senses": [
                    {
                        "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                        "entry_id": "e9da853c-5093-3642-8347-60f832eea8bb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "571291f8-8cf9-434b-8fd7-6d4ed12eeb76",
                                "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                                "text": "Frau Schiele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "25cedb03-9c6d-4914-b1b6-7b1bddc1ada9",
                                "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                                "text": "Herr Schiele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "05ecc459-3534-4de0-aff9-76b7e5933c9d",
                                "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                                "text": "Die Schieles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c4509994-660b-44ea-9943-d7e1e5329099",
                                "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                                "text": "Der Schiele trägt nie die Schals, die die Schiele ihm strickt."
                            },
                            {
                                "example_id": "eea96eb9-12ee-4530-a7f5-199969a245dc",
                                "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schiele kommt, geht der Herr Schiele.“"
                            },
                            {
                                "example_id": "c4a169a5-d9c8-4341-8bbc-c5c39bb60a1f",
                                "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                                "text": "Schiele kommt und geht."
                            },
                            {
                                "example_id": "25861196-d81d-4677-8499-535877773604",
                                "sense_id": "d2681e77-e838-3761-a9e2-7c61f98ceee5",
                                "text": "Schieles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
