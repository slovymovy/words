                        "examples": [
                            {
                                "example_id": "19302466-7d24-4331-b80f-da650e871d64",
                                "sense_id": "87011f2d-aefd-3584-856d-b5578df916a2",
                                "text": "„Gemeinsam ist den Schriftentwicklungen in Alteuropa, Mesopotamien, Ägypten, im Industal, in China und in Mittelamerika, daß der jeweilige Bestand an Schriftzeichen entweder ausschließlich oder doch zum überwiegenden Teil in bildhaften Darstellungen seinen Ursprung findet, wobei die Auswahl der Motive sowie die Art und Weise ihrer Abbildung für den konventionellen Gebrauch als Schriftsymbole in den einzelnen Kulturkreisen sehr unterschiedlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d733125-5ef0-36fe-8836-3e35be87a79a",
