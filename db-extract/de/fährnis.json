                                        "entry_id": "08cb6c01-6f76-3a18-ad09-83adc695f274",
                                        "glosses": [
                                            "probabilità del verificarsi di un danno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb0600f-d394-4a9e-b76f-a82893299c0b",
                                                "sense_id": "d8ee5b2c-0f6a-3f28-8d70-4c1a4c589a96",
                                                "text": "Attento, sei in pericolo!"
                                            }
