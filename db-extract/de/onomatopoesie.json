                    }
                ],
                "senses": [
                    {
                        "sense_id": "81eeace1-2150-3483-a7ed-c3a659298b8b",
                        "entry_id": "fc7a1e9f-153a-3033-926b-77e98a9f1353",
                        "glosses": [
                            "Wortbildung durch sprachliche Nachahmung von Geräuschen und Lauten, zum Beispiel Kuckuck, Gong"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a0e97b9-8861-4625-a297-6fde9ed9d3a6",
                                "sense_id": "81eeace1-2150-3483-a7ed-c3a659298b8b",
                                "text": "„Lautmalerei (Onomatopöie, Onomatopoiie, Onomatopoesie) als ein wichtiger Teilbereich, ist ein beliebtes Stilmittel, um Varianten zu lexikalisierten Einheiten zu schaffen.“"
                            },
                            {
                                "example_id": "f851242f-81d6-422c-a6d9-d1f5f4dea81a",
                                "sense_id": "81eeace1-2150-3483-a7ed-c3a659298b8b",
                                "text": "In Gedichten spielt Onomatopoesie oft eine große Rolle."
                            },
                            {
                                "example_id": "e8109a27-17c5-459c-9176-92a2eecb4370",
                                "sense_id": "81eeace1-2150-3483-a7ed-c3a659298b8b",
                                "text": "„Ein Laut zum Beispiel vermag aufgrund seiner Ähnlichkeit Geräuschen eine Bedeutung tragen, was wir heute unter dem Begriff der Onomatopoesie fassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5d42e14-306c-4811-9407-3133358883ca",
                        "source_entry_id": "fc7a1e9f-153a-3033-926b-77e98a9f1353",
                        "source_sense_id": "81eeace1-2150-3483-a7ed-c3a659298b8b",
                        "source_sense_description": "Wortbildung durch sprachliche Nachahmung von Geräuschen und Lauten, zum Beispiel Kuckuck, Gong",
                        "target_lang_word": "onomatopoeia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onomatopoeia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "515b36ff-20b7-3289-8403-8a3e4c7d02ef",
                                        "entry_id": "5e8a13b0-1227-318d-b4dc-a12965f34cab",
                                        "glosses": [
                                            "The property of a word that sounds like what it represents."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079d5504-3203-4e05-92f3-f24d1e8539ad",
                                                "sense_id": "515b36ff-20b7-3289-8403-8a3e4c7d02ef",
                                                "text": "A woorde making called of the Grecians Onomatapoia, is when wee make wordes of our owne minde, such as bee derived from the nature of things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79a6a60d-445f-315d-af0f-5d3b528c0fcc",
                                        "entry_id": "5e8a13b0-1227-318d-b4dc-a12965f34cab",
                                        "glosses": [
                                            "A word that sounds like what it represents, such as \\\"gurgle\\\", \\\"stutter\\\", or \\\"hiss\\\"."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d72a9d76-c3e4-31d0-bdf9-45fb9e740bcc",
                                        "entry_id": "5e8a13b0-1227-318d-b4dc-a12965f34cab",
                                        "glosses": [
                                            "A word that sounds like what it represents, such as \\\"gurgle\\\", \\\"stutter\\\", or \\\"hiss\\\".",
                                            "A word that appropriates a sound for another sensation or a perceived nature, such as \\\"thud\\\", \\\"beep\\\", or \\\"meow\\\"; an ideophone, phenomime."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b6d33d4-0e1b-3710-9079-70b66f50d4fd",
                                        "entry_id": "5e8a13b0-1227-318d-b4dc-a12965f34cab",
                                        "glosses": [
                                            "The use of language whose sound imitates that which it names."
                                        ],
                                        "tags": [
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62845f1c-63c1-4033-a50d-cf42d25882e4",
                        "source_entry_id": "fc7a1e9f-153a-3033-926b-77e98a9f1353",
                        "source_sense_id": "81eeace1-2150-3483-a7ed-c3a659298b8b",
                        "source_sense_description": "Wortbildung durch sprachliche Nachahmung von Geräuschen und Lauten, zum Beispiel Kuckuck, Gong",
                        "target_lang_word": "onomatopée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onomatopée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d986b96-0b67-3652-ab6f-33281175bb82",
                                        "entry_id": "e324406b-3a30-3086-a478-adc98fc4a79b",
                                        "glosses": [
                                            "Formation d’un mot dont la prononciation imite un son."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "749c3fec-4c6c-4066-b6b6-1ffba77d4525",
                                                "sense_id": "0d986b96-0b67-3652-ab6f-33281175bb82",
                                                "text": "Nous ne nous sommes pas contentés de classer les mots par grandes familles : afin qu'on s'assurât mieux de l'étendue & de la vérité de nos principes sur les mots formés par onomatopée, sur ceux qui se sont chargés d'initiales, sur les aspirations que remplacent les consonnes, nous avons mis à la tête de chaque lettre & par grandes masses :\n1°. Les mots formés par l'imitation des sons. […]."
                                            },
                                            {
                                                "example_id": "01099475-ca42-4a2f-a42f-e270fd3b8a1e",
                                                "sense_id": "0d986b96-0b67-3652-ab6f-33281175bb82",
                                                "text": "Max Müller s'élève contre cette théorie, attendu, dit-il, « que dans les langues connues jusqu'ici l’onomatopée n'a jamais donné de racines ». Il existe des mots formés par onomatopée ; or, ces mots sont incapables de devenir des radicaux, d'engendrer des mots nouveaux, ils sont stériles."
                                            },
                                            {
                                                "example_id": "78b962dd-f4a0-41f3-9f29-4f49a2242c67",
                                                "sense_id": "0d986b96-0b67-3652-ab6f-33281175bb82",
                                                "text": "Connaissant ma curiosité des choses du ciel, Moravagine a établi, à mon usage, un dictionnaire des deux cent mille principales significations de l'unique mot de la langue martienne, ce mot étant une onomatopée : le crissement d'un bouchon de cristal émerisé …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c120462-a7ab-3169-9ced-5809c95b7023",
                                        "entry_id": "e324406b-3a30-3086-a478-adc98fc4a79b",
                                        "glosses": [
                                            "Mot imitatif lui-même, formé grâce à ce procédé, ou tournure expressive à base de syllabes dépourvues de sens. — Voir interjection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b0e43c1-6fa3-404f-a16c-6fa1ad8d79cd",
                                                "sense_id": "0c120462-a7ab-3169-9ced-5809c95b7023",
                                                "text": "Même Ella Fitzgerald et Sarah Vaughan ne sont pas exemptes de ces vulgarités . Il n 'y a pas un seul « choubidou » dans toute l’œuvre de Billie Holiday. Bien chantée, l’onomatopée jazzistique peut être un langage d'une force et d'une étrangeté extraordinaire."
                                            },
                                            {
                                                "example_id": "fbe6acda-76aa-4316-9f63-1332c66e69a4",
                                                "sense_id": "0c120462-a7ab-3169-9ced-5809c95b7023",
                                                "text": "Créant par elles même un impact visuel, les onomatopées sont omniprésentes dans les mangas qui offrent une « bande son » très riche."
                                            },
                                            {
                                                "example_id": "fb22126a-b2b5-4c12-9386-c806adaf1118",
                                                "sense_id": "0c120462-a7ab-3169-9ced-5809c95b7023",
                                                "text": "C’est en particulier le cas dans les comic strips, auxquelles Serge Gainsbourg rend hommage en 1968 en chantant Comic Strip, que Brigitte Bardot ponctue d’onomatopées."
                                            },
                                            {
                                                "example_id": "7ae97ebf-1e8b-4b75-8ee7-254eeddbba56",
                                                "sense_id": "0c120462-a7ab-3169-9ced-5809c95b7023",
                                                "text": "Le chanteur utilise de nombreuses onomatopées et syllabes sans significations lexicales, les textes ne comportant souvent que peu de mots véritables (parfois il s’agit de réciter des poèmes alambiqués et ésotériques), et par ailleurs il sollicite une débauche de bruits de bouche, de cris, voire parfois d’une sorte de « yodl » indien (cri se terminant par de rapides vibratos), sur fond de rythme lancinant et répétitif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6794fdbc-c558-4404-accb-e94bdbfd64c1",
