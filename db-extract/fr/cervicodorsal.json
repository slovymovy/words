                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99232a29-585a-4c27-991d-fe1c1a0c0070",
                                "sense_id": "727949f8-6387-323b-81e1-8a6d7e0b3fe0",
                                "text": "La jonction cervicodorsale est à normaliser chez presque la totalité de nos patients."
                            },
                            {
                                "example_id": "036f95da-fed0-4c4d-98cb-a799e754888d",
                                "sense_id": "727949f8-6387-323b-81e1-8a6d7e0b3fe0",
                                "text": "Elles sont orientées principalement sur les régions abdominales, au niveau du plexus solaire, puis cervicodorsales, scapulaires et lombaires."
                            },
                            {
                                "example_id": "5f99cb18-d6cb-45df-808e-baf389e4b7ce",
                                "sense_id": "727949f8-6387-323b-81e1-8a6d7e0b3fe0",
                                "text": "La coloration de Mallory et surtout la coloration de Holzer montrent en particulier aux niveaux cervicodorsaux que la gliose fibrillaire est en général modérée et isomorphe."
                            }
                        ]
                    }
