{
    "word_family": [
        "onverbiddelijkheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0bf9051b-61f6-3259-a8fc-31ad2f356a1c",
                    "sense_definition": "niet geneigd om zich door smeekbeden of verzoeken tot een andere handelwijze te laten bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbuigzaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter bleef <w>onverbiddelijk</w> en weigerde de straf van de verdachte te verminderen.",
                            "target_lang_translations": {
                                "en": "The judge remained <w>inexorable</w> and refused to reduce the defendant's sentence."
                            }
                        },
                        {
                            "text": "Zijn <w>onverbiddelijke</w> houding zorgde ervoor dat niemand meer durfde te protesteren tegen zijn besluit.",
                            "target_lang_translations": {
                                "en": "His <w>unyielding</w> attitude ensured that no one dared to protest against his decision anymore."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbuigzaam",
                        "meedogenloos",
                        "onvermurwbaar"
                    ],
                    "antonyms": [
                        "meegaand",
                        "vermurwbaar"
                    ],
                    "common_phrases": [
                        "onverbiddelijke houding",
                        "onverbiddelijke rechter",
                        "onverbiddelijke logica"
                    ],
                    "target_lang_definitions": {
                        "en": "not inclined to be moved by pleas or requests to change one's course of action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inexorable",
                                "target_lang_sense_clarification": "impossible to persuade or stop"
                            },
                            {
                                "target_lang_word": "relentless",
                                "target_lang_sense_clarification": "not easing in severity or determination"
                            },
                            {
                                "target_lang_word": "unyielding",
                                "target_lang_sense_clarification": "not giving way to pressure"
                            },
                            {
                                "target_lang_word": "adamant",
                                "target_lang_sense_clarification": "refusing to be persuaded or to change one's mind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c906174-034d-35d9-a159-197806b02e91",
                    "sense_definition": "beslist en zonder de mogelijkheid om tegen te spreken of te weigeren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbuigzaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De generaal gaf een <w>onverbiddelijk</w> bevel dat onmiddellijk moest worden uitgevoerd door de soldaten.",
                            "target_lang_translations": {
                                "en": "The general gave a <w>peremptory</w> order that had to be carried out immediately by the soldiers."
                            }
                        },
                        {
                            "text": "Met een <w>onverbiddelijke</w> stem maakte zij duidelijk dat er geen ruimte was voor discussie.",
                            "target_lang_translations": {
                                "en": "With an <w>inflexible</w> voice, she made it clear that there was no room for discussion."
                            }
                        }
                    ],
                    "synonyms": [
                        "categorisch",
                        "stellig"
                    ],
                    "antonyms": [
                        "aarzelend"
                    ],
                    "common_phrases": [
                        "onverbiddelijk bevel",
                        "onverbiddelijke stem"
                    ],
                    "target_lang_definitions": {
                        "en": "decisive and without the possibility of contradiction or refusal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "categorical",
                                "target_lang_sense_clarification": "unambiguously explicit and direct"
                            },
                            {
                                "target_lang_word": "peremptory",
                                "target_lang_sense_clarification": "insisting on immediate attention or obedience"
                            },
                            {
                                "target_lang_word": "inflexible",
                                "target_lang_sense_clarification": "unwilling to change or compromise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}