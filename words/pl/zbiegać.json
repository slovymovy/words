                    "sense_id": "3988b8b6-9610-35a2-93c5-b1d899bc271b",
                    "sense_definition": "przemieszczać się biegiem w dół",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
