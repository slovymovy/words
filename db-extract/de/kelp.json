                "senses": [
                    {
                        "sense_id": "c36d4f87-4bec-3bc4-beb9-192a00333fef",
                        "entry_id": "9adedc6a-7c14-3740-8ef9-54d2bfcb89fe",
                        "glosses": [
                            "Asche von Seetang beziehungsweise großen Braunalgen, die früher zur Gewinnung von Jod und Dünger verwendet wurde"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "b1ba3c9c-0232-4951-925a-8a5658c71a8b",
                                "sense_id": "c36d4f87-4bec-3bc4-beb9-192a00333fef",
                                "text": "„Nechst diesem dienet auch noch allhier zu wissen/ daß die Bauren dieses Meer- Gras/ aus welchen der Kelp bereitet wird/ in denen Theilen des Engellands/ so gegen Abend gelegen/ zu der Bedüngung der Aecker gebrauchen; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6d62c623-6089-3b76-ab67-6850f229c3dd",
                        "entry_id": "9adedc6a-7c14-3740-8ef9-54d2bfcb89fe",
                        "glosses": [
                            "Bewuchs des Meeresbodens mit sehr großen Tangpflanzen"
                        ],
                        "tags": [
                            "später übertragen auf die Tangpflanzen"
                        ],
                        "examples": [
                            {
                                "example_id": "cbcf0d7a-1085-458f-aae0-d8398ce0d4cf",
                                "sense_id": "6d62c623-6089-3b76-ab67-6850f229c3dd",
                                "text": "„Die Karkasse war an ihrer Unterseite aufgerissen, die Eingeweide waren hervorgequollen, schlängelten sich auf und dümpelten im Wasser zwischen den Algen und dem Kelp."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
