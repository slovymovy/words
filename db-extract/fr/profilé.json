                                                "sense_id": "08a78b0c-ca67-37c0-9c73-4cdf73949817",
                                                "text": "The brooch showed the profile of a Victorian woman."
                                            },
                                            {
                                                "example_id": "d3ccc9b8-72a7-4867-9dcf-67453a47ee0d",
                                                "sense_id": "08a78b0c-ca67-37c0-9c73-4cdf73949817",
                                                "text": "Driver's licenses have a photograph of the person on them, which is in full face if the person is above legal drinking age, or in profile if not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9e626e-1721-3439-a785-3e2cba6279bd",
