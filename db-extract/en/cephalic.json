                        "sense_id": "6d6c9918-d04d-39fa-a3b6-bdafa5b9214c",
                        "entry_id": "74ba411d-39c0-3caf-91a2-82cefcbe2431",
                        "glosses": [
                            "A remedy that benefits the head or brain."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b02a0ba5-15f4-4dc7-9cff-98488232d269",
                                "sense_id": "6d6c9918-d04d-39fa-a3b6-bdafa5b9214c",
                                "text": "[…] recover their Sight […] by the use of Bleeding, Purging, Blistering and Cephalics."
                            },
                            {
                                "example_id": "d9f1a015-f723-42bd-87a3-1dc500fca07c",
                                "sense_id": "6d6c9918-d04d-39fa-a3b6-bdafa5b9214c",
                                "text": "All that of this Form could be titled Stomachics, we have subjoin'd to this Division, because they are all of the Aromatic kind, and thereby claim equally to be Cephalics. The latter we have given, extend their Influences to the Head and whole nervous System, at the same time that they warm, comfort, and strengthen the Fibres of the Stomach, and dissipate Flatulencies, corrugate the Membranes, and promote Digestion: […]"
                            }
                        ]
                    }
