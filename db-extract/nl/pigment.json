                                        "entry_id": "31adc4a7-5a53-3ba8-8e73-68e2dfed40bd",
                                        "glosses": [
                                            "Any color in plant or animal cells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec44ca2-2b02-4262-84a2-71fa3eee37d2",
                                                "sense_id": "e4122803-88d3-3a13-8080-21fdca13d94b",
                                                "text": "Chlorophyll is the pigment responsible for most plants' green colouring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7eb72f7-f46d-34ae-92d7-dd187e5c8ee4",
                                        "entry_id": "31adc4a7-5a53-3ba8-8e73-68e2dfed40bd",
                                        "glosses": [
                                            "A dry colorant, usually an insoluble powder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9f5190-b98c-4529-842e-3f7657631a27",
                                                "sense_id": "b7eb72f7-f46d-34ae-92d7-dd187e5c8ee4",
                                                "text": "Umber is a pigment made from clay containing iron and manganese oxide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e8fa862-6cbb-3d45-82ff-aa07f43f7998",
                                        "entry_id": "31adc4a7-5a53-3ba8-8e73-68e2dfed40bd",
                                        "glosses": [
                                            "Wine flavoured with spices and honey."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f397990-cfb1-46e9-a855-aa0421febe2d",
                                                "sense_id": "4e8fa862-6cbb-3d45-82ff-aa07f43f7998",
                                                "text": "Oswald, broach the oldest wine-cask; place the best mead, the richest morat, the most sparkling cyder, the most odoriferous pigment, upon the board; […]"
                                            }
                                        ]
                                    }
                                ]
