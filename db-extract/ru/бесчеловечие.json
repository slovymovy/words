                "senses": [
                    {
                        "sense_id": "a1b1eefa-4d98-39ff-a7e7-d67b5026d67a",
                        "entry_id": "eb337358-c8f7-3c6b-9f41-a3298cf171a0",
                        "glosses": [
                            "устар. то же, что бесчеловечность; крайняя жестокость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e25f0add-44c6-4570-b7c3-d8215ab87b92",
                                "sense_id": "a1b1eefa-4d98-39ff-a7e7-d67b5026d67a",
                                "text": "Леонад имел бесчеловечие немилосердо мучить сего почтенного мужа и вкинуть потом в ужасную тюрьму."
                            },
                            {
                                "example_id": "821a0e9a-c372-4c5a-89d4-158d6391fabe",
                                "sense_id": "a1b1eefa-4d98-39ff-a7e7-d67b5026d67a",
                                "text": "Оставить его на произвол случая казалось мне последнею степенью подлости и бесчеловечия; я не могла этого сделать!"
                            }
                        ]
                    }
                ],
