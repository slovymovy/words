                                        "entry_id": "623ccf96-1587-3b1a-b17b-c02b3ff9f1c2",
                                        "glosses": [
                                            "zu einem bestimmten Zeitpunkt in der Vergangenheit vorhanden oder stattgefunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6023dc76-8edb-4675-bbe6-7cf5832fd4dc",
                                                "sense_id": "a2813dfd-32fa-3902-bba6-69c3144c3110",
                                                "text": "Er hat mit seiner damaligen Frau nicht viel unternommen."
                                            },
                                            {
                                                "example_id": "6bb4fa89-96d6-469d-a6dc-c2796faa0875",
                                                "sense_id": "a2813dfd-32fa-3902-bba6-69c3144c3110",
                                                "text": "„Sie projizierten Bilder der damaligen Demonstrationen auf Hauswände, dazu liefen die Geräusche des Aufbruchs vom Band.“"
                                            },
                                            {
                                                "example_id": "f9559047-ba64-4812-abca-7eb1dca6cdcb",
                                                "sense_id": "a2813dfd-32fa-3902-bba6-69c3144c3110",
                                                "text": "„Um die norddeutsche Tiefebene aber machten die schönen Dinge der damaligen Zeit einen großen Bogen.“"
                                            }
                                        ],
