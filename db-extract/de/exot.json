                "senses": [
                    {
                        "sense_id": "08e2a96e-2f3c-32bf-9f50-09df8fa57348",
                        "entry_id": "654916df-6974-3019-946d-2087e251d63c",
                        "glosses": [
                            "Lebewesen (Mensch, Pflanze, Tier), das aus einem weit entfernten Gebiet stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f0ada4-7546-4f2f-90df-719d3aae502f",
                                "sense_id": "08e2a96e-2f3c-32bf-9f50-09df8fa57348",
                                "text": "„Unter zärtlichen Beschwichtigungen brachte sie den aufgebrachten Papagei in ihre Wohnung, verschloß sorgfältig alle Fenster und ließ den Exoten aus dem Bauer schlüpfen.“"
                            },
                            {
                                "example_id": "ed9740b7-ace0-40eb-8d96-4a72a1f06678",
                                "sense_id": "08e2a96e-2f3c-32bf-9f50-09df8fa57348",
                                "text": "„Schlegel fühlte sich als ein Exot.“"
                            },
                            {
                                "example_id": "a2aea13a-e56f-4096-a52d-55461f3371e9",
                                "sense_id": "08e2a96e-2f3c-32bf-9f50-09df8fa57348",
                                "text": "„Aber in diesem Jahr waren sie sicher und hatten es sich vom Lotsenfisch bestätigen lassen, der ebenfalls auftauchte, damit wir nicht das Gefühl hatten, sie seien Exoten, und ich keine Probleme machen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f5ef1b6-c541-4fee-acfb-6779080d8f39",
                        "source_entry_id": "654916df-6974-3019-946d-2087e251d63c",
                        "source_sense_id": "08e2a96e-2f3c-32bf-9f50-09df8fa57348",
                        "source_sense_description": "Lebewesen (Mensch, Pflanze, Tier), das aus einem weit entfernten Gebiet stammt",
                        "target_lang_word": "exotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Foreign, especially in an exciting way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb871f5-6eba-4c2d-a112-8027650e2022",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "an exotic appearance"
                                            },
                                            {
                                                "example_id": "9cb3cf7f-2606-4ff5-9c56-f399ed242965",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "Nothing was so splendid and exotic as the ambassador."
                                            },
                                            {
                                                "example_id": "9a146834-bb53-48b6-9476-7c8b79828606",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "“Two or three months more went by ; the public were eagerly awaiting the arrival of this semi-exotic claimant to an English peerage, and sensations, surpassing those of the Tichbourne case, were looked forward to with palpitating interest.[…]”"
                                            },
                                            {
                                                "example_id": "eaed9e8a-0888-4676-b1e5-a0032d6341e4",
                                                "sense_id": "2fe04c07-0184-385b-92f0-9bb152bdab7f",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b7424d-a726-30b8-853d-416c615c6c44",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Foreign, especially in an exciting way.",
                                            "Non-native to the ecosystem."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e868bbb2-c503-3b7a-8019-a2ba1cbe4866",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Foreign, especially in an exciting way.",
                                            "extraterrestial, alien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8189d9a-4c8f-43e5-89c2-6825af4282be",
                                                "sense_id": "e868bbb2-c503-3b7a-8019-a2ba1cbe4866",
                                                "text": "exotic materials"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578b5f5c-f7d9-3379-95c3-b85ed395b662",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Being or relating to an option with features that make it more complex than commonly traded options."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "debdebb5-2b99-33da-a917-6264a017d03b",
                                        "entry_id": "23269951-45bb-3f0b-9012-10508332bdba",
                                        "glosses": [
                                            "Being or relating to various wagers, such as the trifecta, that involve betting on the finishing positions of multiple competitors across one or more races."
                                        ],
                                        "tags": [],
