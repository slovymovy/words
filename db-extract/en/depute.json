                        "examples": []
                    },
                    {
                        "sense_id": "ddb7173b-40fa-38cb-9fbc-77600a018470",
                        "entry_id": "04883f0b-3ecc-35c0-bf5a-ea0538490f3a",
                        "glosses": [
                            "To delegate (a task, etc.) to a subordinate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40c8c6e-32be-486c-8a5d-9a2c1bbe54a5",
                                "sense_id": "ddb7173b-40fa-38cb-9fbc-77600a018470",
                                "text": "Will Wyatt having moved up a notch, the project was deputed to a second team of producers whose judgement I didn't trust."
                            }
                        ]
                    },
                    {
                        "sense_id": "b576c950-b233-3f43-a566-716b3345ec52",
                        "entry_id": "04883f0b-3ecc-35c0-bf5a-ea0538490f3a",
                        "glosses": [
                            "To deputize (someone), to appoint as deputy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3007e36-954f-4d09-95ac-f7e010680a77",
                                "sense_id": "b576c950-b233-3f43-a566-716b3345ec52",
                                "text": "There is no man deputed of the king to hear thee."
                            },
                            {
                                "example_id": "c83a36bd-d529-45f7-8275-a6044708b0af",
                                "sense_id": "b576c950-b233-3f43-a566-716b3345ec52",
                                "text": "Some persons, deputed by a meeting."
                            },
                            {
                                "example_id": "d9d51367-5e19-44b2-877a-1abc7d3df81b",
                                "sense_id": "b576c950-b233-3f43-a566-716b3345ec52",
                                "text": "Viewing the forces arrayed against him at the G20, President Vladimir Putin deputed Lavrov to attend the two-day event in his stead, and for a brief moment it appeared to have been too much."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0a0913d-9baf-3745-bbaf-a4fe1b6f514a",
                        "entry_id": "04883f0b-3ecc-35c0-bf5a-ea0538490f3a",
                        "glosses": [
                            "To appoint; to assign; to choose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf2b5bc-120a-4b47-b9fb-cbecb8b47639",
                                "sense_id": "d0a0913d-9baf-3745-bbaf-a4fe1b6f514a",
                                "text": "The most conspicuous places in cities are usually deputed for the erection of statues."
                            }
                        ]
                    }
