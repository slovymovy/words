{
    "word_family": [
        "remedial",
        "remediation",
        "remediable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a53685a5-6692-3276-b72a-de433c276902",
                    "sense_definition": "A medicine, application, or treatment that relieves or cures a disease.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hot tea with honey is a popular home <w>remedy</w> for a sore throat.",
                            "target_lang_translations": {
                                "ru": "Горячий чай с медом — популярное домашнее <w>средство</w> от боли в горле.",
                                "de": "Heißer Tee mit Honig ist ein beliebtes Haus<w>mittel</w> gegen Halsschmerzen."
                            }
                        },
                        {
                            "text": "Doctors are working hard to find a <w>remedy</w> for the new virus.",
                            "target_lang_translations": {
                                "ru": "Врачи усердно работают над поиском <w>лекарства</w> от нового вируса.",
                                "de": "Ärzte arbeiten hart daran, ein Heil<w>mittel</w> gegen das neue Virus zu finden."
                            }
                        }
                    ],
                    "synonyms": [
                        "cure",
                        "help"
                    ],
                    "common_phrases": [
                        "home remedy",
                        "herbal remedy",
                        "effective remedy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лекарство, препарат или метод лечения, облегчающий или излечивающий болезнь.",
                        "de": "Ein medizinisches Mittel, eine Anwendung oder eine Behandlung, die eine Krankheit lindert oder heilt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лекарство",
                                "target_lang_sense_clarification": "медицинский препарат"
                            },
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "лечебный препарат или метод"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Heilmittel",
                                "target_lang_sense_clarification": "Substanz oder Verfahren zur Heilung"
                            },
                            {
                                "target_lang_word": "Hausmittel",
                                "target_lang_sense_clarification": "traditionelles Mittel zur Linderung von Beschwerden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3e423c3-2a6f-3301-810d-6260f294e932",
                    "sense_definition": "Something that corrects a problem or counteracts a negative situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "correction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education is often seen as the best <w>remedy</w> for poverty.",
                            "target_lang_translations": {
                                "ru": "Образование часто рассматривается как лучшее <w>средство</w> против бедности.",
                                "de": "Bildung wird oft als das beste Gegen<w>mittel</w> gegen Armut angesehen."
                            }
                        },
                        {
                            "text": "We need to find a quick <w>remedy</w> for this misunderstanding.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти быстрый <w>способ разрешить</w> это недоразумение.",
                                "de": "Wir müssen eine schnelle Lösung finden, um dieses Missverständnis zu <w>beheben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "help"
                    ],
                    "common_phrases": [
                        "remedy for",
                        "seek a remedy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо, что исправляет проблему или нейтрализует негативную ситуацию.",
                        "de": "Etwas, das ein Problem korrigiert oder einer negativen Situation entgegenwirkt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "способ решения проблемы"
                            },
                            {
                                "target_lang_word": "выход",
                                "target_lang_sense_clarification": "способ устранения затруднения"
                            },
                            {
                                "target_lang_word": "лекарство",
                                "target_lang_sense_clarification": "переносное значение: то, что помогает устранить беду"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gegenmittel",
                                "target_lang_sense_clarification": "Mittel, das einer negativen Sache entgegenwirkt"
                            },
                            {
                                "target_lang_word": "Lösung",
                                "target_lang_sense_clarification": "Weg zur Beseitigung eines Problems"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5bc4f30-47bc-31f2-83d2-cdf6d1304ccb",
                    "sense_definition": "The legal means to recover a right or to prevent or obtain redress for a wrong.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_means",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract specifies the <w>remedy</w> available if one party fails to deliver the goods.",
                            "target_lang_translations": {
                                "ru": "В контракте указаны <w>средства правовой защиты</w>, доступные в случае, если одна из сторон не поставит товар.",
                                "de": "Der Vertrag legt den <w>Rechtsbehelf</w> fest, der zur Verfügung steht, falls eine Partei die Ware nicht liefert."
                            }
                        },
                        {
                            "text": "She decided to seek a legal <w>remedy</w> for the damages caused to her property.",
                            "target_lang_translations": {
                                "ru": "Она решила искать <w>судебную защиту</w> в связи с ущербом, нанесенным ее имуществу.",
                                "de": "Sie entschied sich, rechtliche Schritte einzuleiten, um den Schaden an ihrem Eigentum zu <w>beheben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "redress"
                    ],
                    "common_phrases": [
                        "legal remedy",
                        "seek remedy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическое средство защиты права, предотвращения нарушения или получения возмещения за ущерб.",
                        "de": "Rechtliches Mittel zur Durchsetzung eines Anspruchs oder zur Wiedergutmachung eines Unrechts."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средство правовой защиты",
                                "target_lang_sense_clarification": "юридический механизм"
                            },
                            {
                                "target_lang_word": "мера",
                                "target_lang_sense_clarification": "юридическое действие для достижения цели"
                            },
                            {
                                "target_lang_word": "возмещение",
                                "target_lang_sense_clarification": "способ компенсации вреда"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Rechtsbehelf",
                                "target_lang_sense_clarification": "formelles juristisches Mittel"
                            },
                            {
                                "target_lang_word": "Rechtsmittel",
                                "target_lang_sense_clarification": "Mittel zur Anfechtung gerichtlicher Entscheidungen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15a65045-c8ec-3de9-896a-732864dbe51d",
                    "sense_definition": "To provide or serve as a remedy for; to correct or cure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_correct",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company took immediate steps to <w>remedy</w> the safety issues in the factory.",
                            "target_lang_translations": {
                                "ru": "Компания предприняла немедленные шаги, чтобы <w>исправить</w> проблемы с безопасностью на заводе.",
                                "de": "Das Unternehmen ergriff sofort Maßnahmen, um die Sicherheitsprobleme in der Fabrik zu <w>beheben</w>."
                            }
                        },
                        {
                            "text": "It will take a lot of time and effort to <w>remedy</w> the damage done to the environment.",
                            "target_lang_translations": {
                                "ru": "Потребуется много времени и усилий, чтобы <w>устранить</w> ущерб, нанесенный окружающей среде.",
                                "de": "Es wird viel Zeit und Mühe kosten, den Umweltschaden zu <w>beheben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "correct",
                        "cure",
                        "redress",
                        "help"
                    ],
                    "common_phrases": [
                        "remedy the situation",
                        "remedy a defect",
                        "remedy the problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исправлять, устранять проблему или излечивать.",
                        "de": "Ein Problem korrigieren, beseitigen oder eine Krankheit heilen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "устранять недостатки или ошибки"
                            },
                            {
                                "target_lang_word": "устранять",
                                "target_lang_sense_clarification": "ликвидировать проблему"
                            },
                            {
                                "target_lang_word": "излечивать",
                                "target_lang_sense_clarification": "помогать справиться с недугом"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "beheben",
                                "target_lang_sense_clarification": "einen Fehler oder Schaden beseitigen"
                            },
                            {
                                "target_lang_word": "korrigieren",
                                "target_lang_sense_clarification": "einen Fehler verbessern"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}