                    },
                    {
                        "sense_id": "d80eb39e-7594-3a4c-bf5e-a751b4a59157",
                        "entry_id": "7662179f-5952-36fa-8677-59111371c283",
                        "glosses": [
                            "Qui a rapport à l’arthrite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2157006-b949-4a31-a02e-c055e95941dc",
                                "sense_id": "d80eb39e-7594-3a4c-bf5e-a751b4a59157",
                                "text": "Tempérament arthritique."
                            },
                            {
                                "example_id": "76cfaf2b-8b7a-46de-ad14-53b94f55dbe3",
                                "sense_id": "d80eb39e-7594-3a4c-bf5e-a751b4a59157",
                                "text": "— C’est au profit des pauvres !\n— Ce serait au profit des charcutiers divorcés ou des généraux arthritiques que ce serait absolument la même chose… Du moment que c’est vous qui offrez, je ne puis qu’accepter…"
                            },
                            {
                                "example_id": "2869f673-8abd-498e-99d0-8bbe1078408e",
                                "sense_id": "d80eb39e-7594-3a4c-bf5e-a751b4a59157",
                                "text": "Fructus belli, fructus belli, s’écriait-il d’une voix peu harmonieuse, pendant les redoublements de cette crise arthritique."
                            }
                        ]
                    },
                    {
                        "sense_id": "091ab799-e2f9-3da2-aee6-5cd70ca8b93f",
                        "entry_id": "7662179f-5952-36fa-8677-59111371c283",
                        "glosses": [
                            "Qui a rapport à l’arthritisme."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2b2ef1c8-f9ff-4d33-8343-02de3cae1613",
                                "sense_id": "091ab799-e2f9-3da2-aee6-5cd70ca8b93f",
                                "text": "Tempérament arthritique."
                            },
                            {
                                "example_id": "5ef8654e-f25c-4356-88ff-ddaa2b76578e",
                                "sense_id": "091ab799-e2f9-3da2-aee6-5cd70ca8b93f",
                                "text": "Le tempérament arthritique, et l’arthritisme rhumatismal, et surtout goutteux, sont de ce nombre et au premier rang."
                            }
                        ]
                    }
