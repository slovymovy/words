                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d1b065-e25f-4dc6-b7ac-00ac391842fb",
                                "sense_id": "858172e6-ea0f-38c6-9b88-0f40c8c4c3bb",
                                "text": "„Damit ist die Gasspeicherung die Energiespeicherung mit der mit großem Abstand höchsten Speicherkapazität.“"
                            },
                            {
                                "example_id": "1eb60168-2145-46c6-a964-b7f402ae18e2",
                                "sense_id": "858172e6-ea0f-38c6-9b88-0f40c8c4c3bb",
                                "text": "„Auch die Anwendung für die Gasspeicherung von CO2 kommt für eine Modifizierung mit preiswert herstellbaren, basischen Metalloxiden in Betracht (Ca, Mg).“"
                            },
                            {
                                "example_id": "0f33af10-479b-4212-9f51-00e8c090c7a9",
                                "sense_id": "858172e6-ea0f-38c6-9b88-0f40c8c4c3bb",
                                "text": "„Für die Gasspeicherung werden oberirdische Speicherbehälter sowie LNG-Tanks verwendet, die relativ geringe Speicherkapazitäten besitzen und daher lediglich bei kurzfristigen Nachfrageschwankungen dienlich sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
