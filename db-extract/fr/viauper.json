                "senses": [
                    {
                        "sense_id": "6f1a793b-2f14-33cf-8083-46e45e0808ca",
                        "entry_id": "85cf3775-5267-34a8-8a79-7284afab8fef",
                        "glosses": [
                            "Gueuler comme un veau ; sembler pleurer comme un veau."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eec3da53-40b9-4c33-827d-a08efc7071ab",
                                "sense_id": "6f1a793b-2f14-33cf-8083-46e45e0808ca",
                                "text": "Coupeau, soûl comme une grive, recommençait à viauper et disait que c’était le chagrin."
                            },
                            {
                                "example_id": "a3adc8fd-445c-4a02-a973-16b9cd3b8730",
                                "sense_id": "6f1a793b-2f14-33cf-8083-46e45e0808ca",
                                "text": "Même une agence de pompes funèbres déclina :\n« D'accord, dans ce métier, on pleure et viaupe à longueur de temps, mais il y a une limite à tout. »"
                            }
                        ]
                    }
