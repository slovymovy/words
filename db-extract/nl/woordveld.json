                                        "entry_id": "527852e4-cb6f-3698-9381-fb967ebcc79c",
                                        "glosses": [
                                            "andere Bezeichnung für Wortfeld; Menge bedeutungsähnlicher Wörter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da4de59a-b1c6-4026-a2d1-d8de0e1222c9",
                                                "sense_id": "1a14f2a8-7e60-3d75-9a33-fc9ab0c65492",
                                                "text": "Zum lexikalischen Feld von \"Bauwerk\" gehören Wörter wie \"Bahnhof\", \"Brücke\", \"Festung\", \"Haus\", \"Kirche\", \"Landebahn\", \"Unterführung\", \"Villa\" usw."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "822f0598-7b44-4b97-aabf-dcbe4f6506f2",
                        "source_entry_id": "e60e2815-b31f-39eb-ab6a-7618c1685f0a",
