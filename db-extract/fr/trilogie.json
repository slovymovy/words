                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f8daede3-9620-4965-901b-6081b6d050c2",
                        "entry_id": "64db8569-b754-3c94-907a-1524cde61034",
                        "tags": [
                            "plural"
                        ],
                        "form": "trilogies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c82ed6b-b1dc-32c7-a0de-9a02584e3f7f",
                        "entry_id": "64db8569-b754-3c94-907a-1524cde61034",
                        "glosses": [
                            "Nom donné à l’ensemble des trois tragédies que présentaient les poètes dramatiques lorsqu’ils concouraient pour obtenir la couronne."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "759d8e05-3f84-4276-8ee2-79de21c72461",
                                "sense_id": "2c82ed6b-b1dc-32c7-a0de-9a02584e3f7f",
                                "text": "Le « Prométhée porte feu », dernier terme de la trilogie eschylienne, annonçait le règne du révolté pardonné."
                            }
                        ]
                    },
                    {
                        "sense_id": "3197e55f-8607-3bcc-995a-2df40eb2b8f4",
                        "entry_id": "64db8569-b754-3c94-907a-1524cde61034",
                        "glosses": [
                            "Groupe de trois pièces de théâtre, de trois œuvres dont les sujets se font suite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf317c65-e660-4662-b085-a330bc2177a3",
                                "sense_id": "3197e55f-8607-3bcc-995a-2df40eb2b8f4",
                                "text": "Trilogie, prélogie ou postlogie, à chaque génération sa série de films « Star Wars » préférée."
                            },
                            {
                                "example_id": "78f0801b-69a5-4beb-a5b0-6d55b5adbbee",
                                "sense_id": "3197e55f-8607-3bcc-995a-2df40eb2b8f4",
                                "text": "Tels George Lucas sur la première trilogie Star War, ses producteurs se sont permis un lifting à coups d'effets spéciaux de synthèse pas très réussis, glissant des vaisseaux à rayons laser fluos ici, des kaméhaméhas translucides là, n'ajoutant qu'une couche de nanardise supplémentaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "80c502dd-b3f7-3468-a112-d9900ae18956",
                        "entry_id": "64db8569-b754-3c94-907a-1524cde61034",
                        "glosses": [
                            "Ensemble de trois choses, de trois éléments inséparables ou qui vont ensemble."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5640fa1-4744-404e-ae9a-6b7c48a0d9b9",
                        "source_entry_id": "64db8569-b754-3c94-907a-1524cde61034",
                        "target_lang_word": "Trilogie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trilogie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68a2ed93-7d55-39cb-96ab-b2e745967513",
                                        "entry_id": "f96f1149-427c-3123-ba32-a3e72be4ba31",
                                        "glosses": [
                                            "künstlerisches Werk, welches aus drei selbstständigen Teilen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a26d7a6-a4a8-4d88-894b-9dd74d25c7cc",
                                                "sense_id": "68a2ed93-7d55-39cb-96ab-b2e745967513",
                                                "text": "Der Autor hat den letzten Band seiner Trilogie fertiggestellt."
                                            },
                                            {
                                                "example_id": "83ef2c7d-8e50-43c3-a5c4-341baa4ea973",
                                                "sense_id": "68a2ed93-7d55-39cb-96ab-b2e745967513",
                                                "text": "„Die drei Bildergeschichten dieser Trilogie sind ganz anders geartet als alles, was vorher von Wilhelm Busch erschienen war.“"
                                            },
                                            {
                                                "example_id": "f09a8f7e-e79a-4613-a823-6742e9db6cf5",
                                                "sense_id": "68a2ed93-7d55-39cb-96ab-b2e745967513",
                                                "text": "„Seit die Trilogie und der Epilog abgeschlossen waren, hatte Roth den Drang verspürt, seine »Zähne in etwas Neues und GROSSES zu schlagen«, doch es vergingen Monate, in denen er wenig anderes tat, als seine Selectric anzustarren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39504a48-f8d5-4947-ae8c-8165ed8e62d8",
                        "source_entry_id": "64db8569-b754-3c94-907a-1524cde61034",
