                                "example_id": "cb7b9cce-2bd5-46b0-837f-6a7c3efa2d93",
                                "sense_id": "89669d05-2ee2-39a8-a7d6-8cc61d79b8c6",
                                "text": "Vorst Vasili, die om zijn voordrachtskunst bekend stond, zou hem voorlezen (ook voor de tsarina droeg hij nu en dan voor)."
                            },
                            {
                                "example_id": "76b856a7-43a1-411e-ac54-380f65c356a7",
                                "sense_id": "89669d05-2ee2-39a8-a7d6-8cc61d79b8c6",
                                "text": "Eigenlijk richtte de rederijkerskamers zich op drie terreinen: de verbetering van het nationale toneel, verspreiding van de kennis over de nationale letterkunde en beoefening van de voordrachtskunst."
                            }
