                            },
                            {
                                "target_word": "alligator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71c851b7-4568-38d4-bd13-9ef04afe77ad",
                                        "entry_id": "2018f6d4-7d56-3210-8950-6ab7cb3c3bdf",
                                        "glosses": [
                                            "To crack in a pattern resembling an alligator's skin."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc66644-3d53-4265-b90d-f1251c177986",
                                                "sense_id": "71c851b7-4568-38d4-bd13-9ef04afe77ad",
                                                "text": "Alligatoring is a result of the sun making the top surface of the asphalt brittle."
                                            },
                                            {
                                                "example_id": "b31a01b3-b8b4-4f70-83b6-1d688e12cdb9",
                                                "sense_id": "71c851b7-4568-38d4-bd13-9ef04afe77ad",
                                                "text": "Sealing an area that is alligatoring is a temporary solution that may delay having to replace the asphalt for several years. A more permanent repair would be to replace the alligatored section."
                                            },
                                            {
                                                "example_id": "f474c80e-e036-49cc-8748-e9f58a8a1169",
                                                "sense_id": "71c851b7-4568-38d4-bd13-9ef04afe77ad",
                                                "text": "Common burn indicators include alligatoring, crazing, the depth of char, lines of demarcation, sagged furniture springs and spalling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alligator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdcce0d0-60af-3c8f-8356-a63e06bbe4b6",
                                        "entry_id": "741c8a0e-c286-3e6d-9333-6e9232e973d2",
                                        "glosses": [
                                            "Used in a common chronometric counting scheme, in which the speaker counts out loud, saying the word \\\"alligator\\\" between the numbers so that each number is spoken approximately one second after the last one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aae8e240-5391-4de9-a049-e9996715ad80",
                                                "sense_id": "cdcce0d0-60af-3c8f-8356-a63e06bbe4b6",
                                                "text": "The same way people will count the seconds between lightning and thunder, I counted the seconds between coughs. One-alligator, two-alligator, three-alligator."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
