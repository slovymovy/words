    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeeb1ac3-8154-32b3-a563-fd43d4cab148",
                    "sense_definition": "Former ou organiser à nouveau un ensemble, un groupe ou une structure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après leur séparation, ils ont réussi à <w>recomposer</w> une famille harmonieuse."
                        },
                        {
                            "text": "Le Premier ministre cherche à <w>recomposer</w> sa majorité avant le vote de la loi."
                        }
                    ],
                    "synonyms": [
                        "réagencer"
                    ],
                    "common_phrases": [
                        "recomposer une famille",
                        "recomposer un gouvernement"
                    ]
                },
                {
                    "sense_id": "26f9fe1b-ef78-3185-af52-02b3205eba6e",
                    "sense_definition": "Réunir les parties ou les morceaux séparés d'une chose pour la reconstituer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "assemblage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'archéologue a passé des semaines à <w>recomposer</w> le vase antique brisé en morceaux."
                        },
                        {
                            "text": "Les experts tentent de <w>recomposer</w> le document déchiré à partir des fragments retrouvés."
                        }
                    ],
                    "common_phrases": [
                        "recomposer le puzzle"
                    ]
                },
                {
                    "sense_id": "d70f3bfa-ca9b-3273-b6bf-920ff2f7b9e9",
                    "sense_definition": "Reprendre une contenance calme ou neutre après une émotion visible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle prit une grande inspiration pour se <w>recomposer</w> un visage avant d'entrer dans la salle."
                        },
                        {
                            "text": "Malgré l'annonce brutale, il tenta aussitôt de <w>recomposer</w> son attitude devant ses collègues."
                        }
                    ],
                    "common_phrases": [
                        "recomposer son visage",
                        "se recomposer une contenance"
                    ]
                },
                {
                    "sense_id": "4d1329a2-adf3-36cf-b376-ba732a28dafd",
                    "sense_definition": "Disposer ou agencer à nouveau les caractères ou les éléments d'un texte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'imprimeur a été contraint de <w>recomposer</w> l'article à la suite de nombreuses corrections."
                        },
                        {
                            "text": "Une erreur de mise en page a obligé l'éditeur à <w>recomposer</w> le chapitre entier."
                        }
                    ],
                    "common_phrases": [
                        "recomposer un texte",
                        "recomposer une page"
                    ]
                }
            ]
        }
    ]
