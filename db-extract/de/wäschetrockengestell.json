                "senses": [
                    {
                        "sense_id": "d8e79d6c-e1f3-3b7f-aa45-f6ce7bc033a7",
                        "entry_id": "dc37f8cf-1939-37a0-a200-cef1ec741cfb",
                        "glosses": [
                            "Gestell, auf dem man Wäsche zum Trocknen aufhängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc3f7c55-bc52-4801-9f5e-309243d3d539",
                                "sense_id": "d8e79d6c-e1f3-3b7f-aa45-f6ce7bc033a7",
                                "text": "„Nachdem niemand unser ausgedientes Babyabsturzgitter benötigt, nutzen wir es aufgebockt als Wäschetrockengestell - wieder Geld gespart!“"
                            },
                            {
                                "example_id": "36da20e9-932d-416e-958a-6329cb9e8edc",
                                "sense_id": "d8e79d6c-e1f3-3b7f-aa45-f6ce7bc033a7",
                                "text": "„Aus dem Baubudget erhielten die Mieter Blumentröge, Sichtschutzplanen und Wäschetrockengestelle zur Gestaltung und funktionalen Aufwertung ihrer Freiräume.“"
                            },
                            {
                                "example_id": "d8d1f5fa-7639-4261-8a19-e28cd4f3fc2c",
                                "sense_id": "d8e79d6c-e1f3-3b7f-aa45-f6ce7bc033a7",
                                "text": "„Die Wäscheklammern waren ihr schon längst ausgegangen, als sie die Unterwäsche auf ein Wäschetrockengestell verteilt hatte.“"
                            },
                            {
                                "example_id": "34253265-409b-4bc7-a2b2-9779cf59198d",
                                "sense_id": "d8e79d6c-e1f3-3b7f-aa45-f6ce7bc033a7",
                                "text": "„Dann werden sie in den Trockenraum auf ein großes Papier auf dem Wäschetrockengestell gelegt, wo sie in Ruhe trocknen können.“"
                            },
                            {
                                "example_id": "10ad9ae2-0724-4a37-a69e-c4df903bdecb",
                                "sense_id": "d8e79d6c-e1f3-3b7f-aa45-f6ce7bc033a7",
                                "text": "„Ein kurzer Blick durch die offene Tür in ein helles Schlafzimmer, dann außen die Treppe hinunter in den schrägen Garten mit einem Wäschetrockengestell.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
