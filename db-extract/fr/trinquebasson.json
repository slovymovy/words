                "senses": [
                    {
                        "sense_id": "547aeb1c-c5a8-3569-a20d-e2149c589b84",
                        "entry_id": "ac930665-47e8-3ecd-b894-b3e0cd9fd5cf",
                        "glosses": [
                            "Sorte de serpe à long manche servant à ébrancher les arbres ou à tailler les haies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1842c5df-423f-4b09-84c3-29c75b4798c5",
                                "sense_id": "547aeb1c-c5a8-3569-a20d-e2149c589b84",
                                "text": "Le jardinier, qui taillait les haies d’ifs au fond du jardin réservé aux boutures, lâcha son trinquebasson et trotta de son vieux pas de rhumatisant, marmonnant, furieux : — Bond'la de bond'la ! avait-il besoin de la toucher !"
                            },
                            {
                                "example_id": "9d7fbc57-4d79-42a4-a014-de120f93db7c",
                                "sense_id": "547aeb1c-c5a8-3569-a20d-e2149c589b84",
                                "text": "Les vignerons sont souvent représentés au Moyen âge non avec un couteau, mais avec le trinquebasson, sorte de serpe qui leur sert à tailler la vigne."
                            },
                            {
                                "example_id": "75b5b133-2fd1-4602-b376-6179f7ce1cce",
                                "sense_id": "547aeb1c-c5a8-3569-a20d-e2149c589b84",
                                "text": "Et derrière ce retranchement allaient et venaient des hommes armés de faux, de fourches, de bédoils et de trinquebassons. Certains maniaient des serpes emmanchées à des gaules longues de vingt pieds, d’autres brandissaient des merlins, des hoyaux et des cognées."
                            }
                        ]
                    }
