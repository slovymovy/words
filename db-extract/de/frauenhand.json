                "senses": [
                    {
                        "sense_id": "fbba7034-f4ce-30ae-98d2-91bec9059157",
                        "entry_id": "d496a79f-6432-3f2e-a095-4e0c53cb8685",
                        "glosses": [
                            "Hand einer Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd36eeff-c26f-4713-ae1d-51fbfb5b2571",
                                "sense_id": "fbba7034-f4ce-30ae-98d2-91bec9059157",
                                "text": "„Frauenhände sind schon fast keine Hände mehr; ob sie Butter aufs Brot oder Haare aus der Stirn streichen.“"
                            },
                            {
                                "example_id": "b5e0113d-2e55-4992-9573-03fd62071ba2",
                                "sense_id": "fbba7034-f4ce-30ae-98d2-91bec9059157",
                                "text": "„Der freigelegte Tempel besaß in seinen Innenwänden zahlreiche Nischen, in denen man eine Darstellung von gekreuzten Frauenhänden aus Ton fand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
