                                        "glosses": [
                                            "aussenden"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a6e384-9b91-4b1d-9cca-2b0f290b407f",
                                                "sense_id": "a1eabaab-58c8-37aa-ba2b-8259ba6d85fe",
                                                "text": "ein Laser emittiert Licht"
                                            },
                                            {
                                                "example_id": "bd521df4-684d-49ae-aae8-9dec4a368e66",
                                                "sense_id": "a1eabaab-58c8-37aa-ba2b-8259ba6d85fe",
                                                "text": "„Weil sie besonders viel klimaschädliches Kohlendioxid emittieren, träfe die neue Grenze alte Braunkohlekraftwerke am härtesten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8c4bceb6-631b-31c9-8994-7ed32c2136fa",
                                        "entry_id": "e08c98f8-3d0f-34bc-bb49-720cf393f10e",
                                        "glosses": [
                                            "in die Luft abgeben"
                                        ],
                                        "tags": [
                                            "Umwelt",
                                            "Klima"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "084f0863-700a-4a64-866c-097d7388494f",
                                                "sense_id": "8c4bceb6-631b-31c9-8994-7ed32c2136fa",
                                                "text": "Autos mit Brennstoffzellen sollen weniger Schadstoffe emittieren als herkömmliche PKW."
                                            },
                                            {
                                                "example_id": "563cef74-e54b-400a-a139-7cf18b755b9b",
                                                "sense_id": "8c4bceb6-631b-31c9-8994-7ed32c2136fa",
                                                "text": "„»Wir dürfen nicht mehr als 30 Milliarden Tonnen CO₂ emittieren ab 2013«, erklärt Wicke.“"
