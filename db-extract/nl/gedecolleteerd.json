                "senses": [
                    {
                        "sense_id": "05b123f1-db58-30ee-95f1-2c37fe11147e",
                        "entry_id": "2a18cb1c-f955-39cd-9af5-12d833a3946d",
                        "glosses": [
                            "met een laag uitgesneden halslijn bij vrouwenkleding, zodat de boezem van de vrouw deels zichtbaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef5a1b0-91b8-40da-8113-c68621ef5691",
                                "sense_id": "05b123f1-db58-30ee-95f1-2c37fe11147e",
                                "text": "Anna was niet in het lila, zoals Kitty zo beslist gewild had; zij droeg een laag gedecolleteerde, zwartfluwelen japon, die haar ronde, ivoorkleurige schouders en buste en haar mooi gevormde armen met de fijne, smalle polsen vrij liet."
                            },
                            {
                                "example_id": "101d468d-dd09-46c6-9cad-7be89bee2ce2",
                                "sense_id": "05b123f1-db58-30ee-95f1-2c37fe11147e",
                                "text": "Een vrouw die mee wilde tellen aan het hof had een grote klerenkast nodig, zo blijkt uit de Haagse tentoonstelling. Op uitnodigingen konden vijf verschillende kledingaanduidingen staan: toilette de promenade (wandelkostuum), toilette de visite (met hoed en handschoenen), toilette montante (hoog gesloten), toilette demi-montante (halfhoog gesloten) en toilette decolleté (gedecolleteerd). Een beetje bemiddelde vrouw kon het niet maken meerdere keren in hetzelfde toilet op hoffeesten te verschijnen."
                            }
                        ]
                    }
                ],
