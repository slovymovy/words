                        "glosses": [
                            "S’additionner à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ffe8cd6-36ac-4107-8640-e7b52fde479f",
                                "sense_id": "875abe00-6f28-3ec0-b084-2e3431767110",
                                "text": "Toutefois, si les facteurs se complètent, \"la croissance s'auto-additionne dans la mesure où l'augmentation des extrants provenant de la croissance des intrants est supérieure à la somme des augmentations des extrants imputables à l'augmentation des intrants..."
                            },
                            {
                                "example_id": "cf7ed206-c22a-463d-ae6f-1fd821867b9a",
                                "sense_id": "875abe00-6f28-3ec0-b084-2e3431767110",
                                "text": "Je vois que la bêtise peut s'auto-additionner."
                            },
                            {
                                "example_id": "39b57690-f16e-4c5e-89a1-eb1927c3f3c0",
                                "sense_id": "875abe00-6f28-3ec0-b084-2e3431767110",
                                "text": "Il vous dit que vous avez créé une formule et qu'elle tourne en rond, elle « s'auto-additionne » ou « s'auto-multiplie » etc…"
                            }
                        ]
