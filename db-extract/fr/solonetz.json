                    {
                        "sense_id": "659104d7-e0d8-3dcc-b209-9a2dcaff3874",
                        "entry_id": "2bddcf43-ae96-3d06-9a2e-70562e509376",
                        "glosses": [
                            "Type de sol dans lequel le sodium est présent en quantité importante, avec accumulation d’argile en subsurface, et non en surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d701a26-a917-40f1-ab1b-c819e16cbb6a",
                                "sense_id": "659104d7-e0d8-3dcc-b209-9a2dcaff3874",
                                "text": "Lorsque le plan d’eau s’abaisse à plus de 4 mètres, les sols solontchaqueux évoluent vers les solonetz."
                            },
                            {
                                "example_id": "a846117a-0669-4926-b6e4-56cdcf0d2535",
                                "sense_id": "659104d7-e0d8-3dcc-b209-9a2dcaff3874",
                                "text": "Les solonetz solodisés à horizon bien marqué se trouvent sur le glacis de dénudation."
                            },
                            {
                                "example_id": "2c236c73-c32e-4645-b174-27a7231f9ee4",
                                "sense_id": "659104d7-e0d8-3dcc-b209-9a2dcaff3874",
                                "text": "Solonetz et Solods sont rarement cultivables et souvent abandonnés au pâturage extensif."
                            }
                        ]
                    }
                ],
