                },
                {
                    "sense_id": "8c99b127-e7ea-39cc-ad0f-c7f4a0e508bf",
                    "sense_definition": "Unreliable, unstable, or likely to break or fail.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unreliability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dodgy</w> old machine kept breaking down every time we tried to start it.",
                            "target_lang_translations": {
                                "ru": "Эта <w>барахлящая</w> старая машина ломалась каждый раз, когда мы пытались её завести."
                            }
                        },
                        {
                            "text": "You should never listen to <w>dodgy</w> advice from people who do not have any experience.",
                            "target_lang_translations": {
                                "ru": "Никогда не стоит слушать <w>сомнительные</w> советы от людей, у которых нет никакого опыта."
                            }
                        }
                    ],
                    "synonyms": [
                        "shaky",
                        "flaky",
                        "unreliable",
                        "untrustworthy"
                    ],
                    "antonyms": [
                        "reliable",
                        "stable",
                        "solid"
                    ],
                    "common_phrases": [
                        "dodgy connection",
                        "dodgy engine"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal way to describe physical objects or information that cannot be trusted."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ненадежный, нестабильный или имеющий высокую вероятность поломки или сбоя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненадежный",
