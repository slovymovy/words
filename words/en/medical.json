    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dec56a33-0a6a-3248-b916-e3d3abd89e38",
                    "sense_definition": "Of or pertaining to the practice of medicine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_practice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>medical</w> student at the local university.",
                            "target_lang_translations": {
                                "ru": "Она студентка <w>медицинского</w> факультета местного университета.",
                                "zh": "她是当地大学的一名<w>医学</w>生。"
                            }
                        },
                        {
                            "text": "The hospital provides excellent <w>medical</w> care to all patients.",
                            "target_lang_translations": {
                                "ru": "Больница предоставляет отличное <w>медицинское</w> обслуживание всем пациентам.",
                                "zh": "这家医院为所有病人提供优质的<w>医疗</w>服务。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical care",
                        "medical school",
                        "medical doctor",
                        "medical advice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к медицине или врачебной практике.",
                        "zh": "与医学或医生职业相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медицинский",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "врачебный",
                                "target_lang_sense_clarification": "относящийся к деятельности врача"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "医学",
                                "target_lang_sense_clarification": "指学科或领域"
                            },
                            {
                                "target_lang_word": "医疗",
                                "target_lang_sense_clarification": "指服务或实践"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80bda572-b18a-3d20-8e3a-f1797db8c3e3",
                    "sense_definition": "Pertaining to the state of one's health.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked detailed questions about my <w>medical</w> history.",
                            "target_lang_translations": {
                                "ru": "Врач задал подробные вопросы о моей <w>истории болезни</w>.",
                                "zh": "医生详细询问了我的<w>病史</w>。"
                            }
                        },
                        {
                            "text": "You must provide a <w>medical</w> certificate to explain your absence.",
                            "target_lang_translations": {
                                "ru": "Вы должны предоставить <w>медицинскую</w> справку, чтобы объяснить свое отсутствие.",
                                "zh": "你必须提供一份<w>医疗</w>证明来解释你的缺勤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical history",
                        "medical record",
                        "medical examination",
                        "medical report"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к состоянию здоровья человека или истории его болезней.",
                        "zh": "与个人健康状况或病史相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медицинский",
                                "target_lang_sense_clarification": "связанный с документами или историей здоровья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "医疗",
                                "target_lang_sense_clarification": "用于记录或证明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32e1ba4a-71fa-325d-96cd-a5ac9d35a731",
                    "sense_definition": "Requiring medical treatment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "health_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suffers from a serious <w>medical</w> condition that affects his breathing.",
                            "target_lang_translations": {
                                "ru": "Он страдает от серьезного <w>заболевания</w>, которое влияет на его дыхание.",
                                "zh": "他患有一种影响呼吸的严重<w>疾病</w>。"
                            }
                        },
                        {
                            "text": "Please call an ambulance immediately; this is a <w>medical</w> emergency.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, немедленно вызовите скорую; это случай, требующий неотложной <w>медицинской</w> помощи.",
                                "zh": "请立刻叫救护车，这是<w>医疗</w>紧急情况。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "medical condition",
                        "medical emergency",
                        "medical problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий врачебного вмешательства или лечения.",
                        "zh": "需要医生介入或治疗的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медицинский",
                                "target_lang_sense_clarification": "требующий помощи врача"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "医疗",
                                "target_lang_sense_clarification": "指需要专业救助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0bc6cd5-4b90-3253-9ae0-990119288cd9",
                    "sense_definition": "Intended to have a therapeutic effect; medicinal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "therapeutic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a specific <w>medical</w> treatment for the infection.",
                            "target_lang_translations": {
                                "ru": "Врач назначил специальное <w>медикаментозное</w> лечение от инфекции.",
                                "zh": "医生针对这种感染开出了特定的<w>治疗</w>方案。"
                            }
                        },
                        {
                            "text": "Some plants are grown specifically for their <w>medical</w> properties.",
                            "target_lang_translations": {
                                "ru": "Некоторые растения выращивают специально ради их <w>лечебных</w> свойств.",
                                "zh": "有些植物专门因其<w>药用</w>价值而被种植。"
                            }
                        }
                    ],
                    "synonyms": [
                        "curative",
                        "therapeutic"
                    ],
                    "common_phrases": [
                        "medical treatment",
                        "medical marijuana",
                        "medical use"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для лечения; обладающий целебными свойствами.",
                        "zh": "具有治疗效果的；药用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лечебный",
                                "target_lang_sense_clarification": "терапевтический, целебный"
                            },
                            {
                                "target_lang_word": "медицинский",
                                "target_lang_sense_clarification": "используемый в медицине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治疗",
                                "target_lang_sense_clarification": "指疗法"
                            },
                            {
                                "target_lang_word": "药用",
                                "target_lang_sense_clarification": "指物质属性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c662c62d-6071-3a89-9f21-950f365bb0cb",
                    "sense_definition": "Pertaining to or requiring treatment by other than surgical means.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "non_surgical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was admitted to the <w>medical</w> ward rather than the surgical unit.",
                            "target_lang_translations": {
                                "ru": "Пациента положили в <w>терапевтическое</w> отделение, а не в хирургическое.",
                                "zh": "病人被收治在<w>内科</w>病房，而不是外科。"
                            }
                        },
                        {
                            "text": "Doctors decided that <w>medical</w> management was safer than operating on the heart.",
                            "target_lang_translations": {
                                "ru": "Врачи решили, что <w>медикаментозное</w> лечение безопаснее операции на сердце.",
                                "zh": "医生认为<w>药物</w>治疗比心脏手术更安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsurgical",
                        "nonoperative"
                    ],
                    "antonyms": [
                        "surgical",
                        "operative"
                    ],
                    "common_phrases": [
                        "medical ward",
                        "medical management",
                        "medical oncology"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical distinction from surgical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к нехирургическим методам лечения (терапии).",
                        "zh": "指非手术的内科治疗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терапевтический",
                                "target_lang_sense_clarification": "нехирургический"
                            },
                            {
                                "target_lang_word": "медикаментозный",
                                "target_lang_sense_clarification": "лекарственный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内科",
                                "target_lang_sense_clarification": "与外科相对"
                            },
                            {
                                "target_lang_word": "药物",
                                "target_lang_sense_clarification": "指治疗手段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa47ba1a-be54-38f0-b14c-6cd0ccee08da",
                    "sense_definition": "A medical examination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_exam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will have to pass a <w>medical</w> before you can start the new job.",
                            "target_lang_translations": {
                                "ru": "Тебе придется пройти <w>медосмотр</w>, прежде чем ты сможешь приступить к новой работе.",
                                "zh": "在开始新工作之前，你必须通过<w>体检</w>。"
                            }
                        },
                        {
                            "text": "The athlete failed his <w>medical</w> and could not sign the contract.",
                            "target_lang_translations": {
                                "ru": "Спортсмен не прошел <w>медицинское обследование</w> и не смог подписать контракт.",
                                "zh": "这名运动员没能通过<w>体检</w>，因此无法签署合同。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pass a medical",
                        "fail a medical",
                        "undergo a medical"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский осмотр для проверки состояния здоровья.",
                        "zh": "为了检查健康状况而进行的身体检查。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медосмотр",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            },
                            {
                                "target_lang_word": "медицинское обследование",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体检",
                                "target_lang_sense_clarification": "常用缩写"
                            },
                            {
                                "target_lang_word": "身体检查",
                                "target_lang_sense_clarification": "正式说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96a88a7f-36e5-38b3-9cdd-5d5ac4ed2961",
                    "sense_definition": "A medical practitioner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>medicals</w> at the conference discussed the new virus.",
                            "target_lang_translations": {
                                "ru": "<w>Медики</w> на конференции обсуждали новый вирус.",
                                "zh": "参加会议的<w>医务人员</w>讨论了这种新病毒。"
                            }
                        },
                        {
                            "text": "We <w>medicals</w> often have a different perspective on health issues.",
                            "target_lang_translations": {
                                "ru": "Мы, <w>медики</w>, часто смотрим на проблемы здравоохранения иначе.",
                                "zh": "我们<w>医务人员</w>对健康问题往往有不同的看法。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинский работник; врач или студент-медик.",
                        "zh": "医疗从业者，如医生或医学生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медик",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "医务人员",
                                "target_lang_sense_clarification": "正式称呼"
                            },
                            {
                                "target_lang_word": "医生",
                                "target_lang_sense_clarification": "指代职业"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}