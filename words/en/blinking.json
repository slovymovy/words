{
    "word_family": [
        "blink",
        "blinkered"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3a622c3c-d80d-391e-8969-ea9e2bb584d5",
                    "sense_definition": "That blinks or flashes on and off.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "light_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blinking</w> light on the router indicates that the internet is connected.",
                            "target_lang_translations": {
                                "ru": "<w>Мигающий</w> индикатор на роутере показывает, что интернет подключен.",
                                "tr": "Yönlendiricideki <w>yanıp sönen</w> ışık internetin bağlı olduğunu gösterir."
                            }
                        },
                        {
                            "text": "We saw the <w>blinking</w> lights of a plane in the night sky.",
                            "target_lang_translations": {
                                "ru": "Мы увидели <w>мигающие</w> огни самолёта в ночном небе.",
                                "tr": "Gece gökyüzünde bir uçağın <w>yanıp sönen</w> ışıklarını gördük."
                            }
                        }
                    ],
                    "synonyms": [
                        "winking",
                        "flashing"
                    ],
                    "common_phrases": [
                        "blinking light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мигающий или вспыхивающий с определенной периодичностью.",
                        "tr": "Düzenli aralıklarla yanıp sönen veya parıldayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигающий",
                                "target_lang_sense_clarification": "о свете или индикаторе"
                            },
                            {
                                "target_lang_word": "мерцающий",
                                "target_lang_sense_clarification": "о слабом или нестабильном свете"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yanıp sönen",
                                "target_lang_sense_clarification": "ışık veya gösterge için"
                            },
                            {
                                "target_lang_word": "çakar",
                                "target_lang_sense_clarification": "aralıklı yanan uyarı ışığı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1a6a795-e90c-3d94-a6c6-0ab6282c4971",
                    "sense_definition": "Used as a mild intensifier to express annoyance or emphasis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blinking</w> car will not start this morning.",
                            "target_lang_translations": {
                                "ru": "Эта <w>чертова</w> машина не заводится сегодня утром.",
                                "tr": "<w>Lanet</w> araba bu sabah çalışmıyor."
                            }
                        },
                        {
                            "text": "I have to finish this <w>blinking</w> report before I can go home.",
                            "target_lang_translations": {
                                "ru": "Я должен закончить этот <w>проклятый</w> отчет, прежде чем смогу пойти домой.",
                                "tr": "Eve gitmeden önce bu <w>kahrolası</w> raporu bitirmem gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "blasted",
                        "blimming",
                        "blooming"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a mild euphemism for stronger language."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как мягкое ругательство для выражения раздражения или усиления акцента.",
                        "tr": "Öfke veya vurgu bildirmek için hafif bir pekiştirici olarak kullanılan ifade."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертов",
                                "target_lang_sense_clarification": "разговорный усилитель раздражения"
                            },
                            {
                                "target_lang_word": "проклятый",
                                "target_lang_sense_clarification": "выражение сильного недовольства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "lanet",
                                "target_lang_sense_clarification": "bıkkınlık veya kızgınlık belirten argo/ünlem sıfatı"
                            },
                            {
                                "target_lang_word": "kahrolası",
                                "target_lang_sense_clarification": "rahatsızlık veya kızgınlık bildiren ifade"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ddc20e3-b77a-313d-b2d7-1046660d767a",
                    "sense_definition": "The act of something that blinks.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "light_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steady <w>blinking</w> of the warning lights caught everyone's attention.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>мигание</w> предупреждающих огней привлекло всеобщее внимание.",
                                "tr": "Uyarı ışıklarının düzenli <w>yanıp sönmesi</w> herkesin dikkatini çekti."
                            }
                        },
                        {
                            "text": "He watched the rhythmic <w>blinking</w> of the lighthouse from the shore.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал с берега за ритмичным <w>миганием</w> маяка.",
                                "tr": "Kıyıdan deniz fenerinin ritmik <w>yanıp sönmesini</w> izledi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или действие чего-либо, что мигает.",
                        "tr": "Bir ışığın ya da gözün yanıp sönmesi veya kırpılması eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигание",
                                "target_lang_sense_clarification": "процесс периодического включения и выключения света"
                            },
                            {
                                "target_lang_word": "мерцание",
                                "target_lang_sense_clarification": "процесс слабого или прерывистого свечения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yanıp sönme",
                                "target_lang_sense_clarification": "ışığın aralıklı yanması"
                            },
                            {
                                "target_lang_word": "kırpma",
                                "target_lang_sense_clarification": "göz kırpma hareketi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd720d70-cca0-3a1f-9a46-1ac6ddca53c0",
                    "sense_definition": "Present participle and gerund of <w>blink</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "light_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>blinking</w> rapidly because of the bright sunlight.",
                            "target_lang_translations": {
                                "ru": "Она часто <w>моргала</w> из-за яркого солнечного света.",
                                "tr": "Parlak güneş ışığı yüzünden gözlerini hızla <w>kırpıyordu</w>."
                            }
                        },
                        {
                            "text": "The computer screen is <w>blinking</w> while it loads the program.",
                            "target_lang_translations": {
                                "ru": "Экран компьютера <w>мигает</w> во время загрузки программы.",
                                "tr": "Program yüklenirken bilgisayar ekranı <w>yanıp sönüyor</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «моргать» или «мигать».",
                        "tr": "'Blink' (göz kırpmak veya yanıp sönmek) fiilinin şimdiki zaman ortacı ya da ulaç hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моргающий",
                                "target_lang_sense_clarification": "о глазах"
                            },
                            {
                                "target_lang_word": "мигающий",
                                "target_lang_sense_clarification": "о свете или технике"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "göz kırpan",
                                "target_lang_sense_clarification": "gözünü açıp kapayan"
                            },
                            {
                                "target_lang_word": "yanıp sönen",
                                "target_lang_sense_clarification": "ışık saçan nesneler için"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}