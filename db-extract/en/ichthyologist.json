                    {
                        "translation_id": "4f68342c-a445-4090-88ea-218faf3ba061",
                        "source_entry_id": "2aa9c183-1a74-3070-9161-342afa10062a",
                        "source_sense_id": "848d9bb0-8be6-39c6-82f4-6ad6ca8ddc28",
                        "source_sense_description": "expert in ichthyology",
                        "target_lang_word": "ichtyologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ichtyologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                        "entry_id": "38d97e85-03a8-3631-b158-870ce1432086",
                                        "glosses": [
                                            "Spécialiste de l’étude des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa3d805-5193-4d15-a43f-3282c9662b1e",
                                                "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                                "text": "Il se plonge dans la lecture du manuscrit et découvre alors que ce Risso fut ce qu’on appelle maintenant un ichtyologue, expert en poissons de la Méditerranée."
                                            },
                                            {
                                                "example_id": "a527a77c-f6e8-4411-aae2-3919d91dcb1c",
                                                "sense_id": "1048f488-0125-38c0-86ed-9089f2608da0",
                                                "text": "Sur 200 mètres d’un ruisseau guyanais, des ichtyologues ont recensé 70 espèces de poissons, à comparer aux 81 espèces de l’Hexagone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e08e9013-5a86-4113-81bc-ed184ca188a5",
                        "source_entry_id": "2aa9c183-1a74-3070-9161-342afa10062a",
                        "source_sense_id": "848d9bb0-8be6-39c6-82f4-6ad6ca8ddc28",
                        "source_sense_description": "expert in ichthyology",
                        "target_lang_word": "Ichthyologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ichthyologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec3daa14-00c4-31c4-8024-2eed81f22435",
                                        "entry_id": "75ea5643-82f1-3a54-b690-95c81a1e5428",
                                        "glosses": [
                                            "Wissenschaftler/Experte auf dem Gebiet der Fischkunde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e705752-7a07-4204-8790-9f79e0c5cf86",
                                                "sense_id": "ec3daa14-00c4-31c4-8024-2eed81f22435",
                                                "text": "„Der Ichthyologe Pouchet, Freund von Gustave Flaubert, ist einer der ersten Franzosen, die in den dreißiger Jahren in Berlin studiert haben.“"
                                            },
                                            {
                                                "example_id": "dd73dca3-8603-4a9e-b36e-18f4adf3ec92",
                                                "sense_id": "ec3daa14-00c4-31c4-8024-2eed81f22435",
                                                "text": "„Prosanta Chakrabarty ist Ichthyologe und Evolutionsbiologe an der Louisiana State University.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39e658de-6ac1-4827-b0a5-191382a6044e",
                        "source_entry_id": "2aa9c183-1a74-3070-9161-342afa10062a",
                        "source_sense_id": "848d9bb0-8be6-39c6-82f4-6ad6ca8ddc28",
                        "source_sense_description": "expert in ichthyology",
                        "target_lang_word": "Ichthyologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ichthyologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce15084-adc8-35ac-8c4d-497c258fcb3e",
                                        "entry_id": "04c1c028-b8d5-37e3-8e91-a3709984f6ba",
                                        "glosses": [
                                            "Wissenschaftlerin/Expertin auf dem Gebiet der Fischkunde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d501017-57f0-44bd-a7ec-05f2fcab2bf3",
                                                "sense_id": "5ce15084-adc8-35ac-8c4d-497c258fcb3e",
                                                "text": "„Die Gattung ist bisher monotypisch, das heißt, sie besteht nur aus einer einzigen Art, die im Jahre 1935 von der englischen Ichthyologin Trewavas beschrieben wurde und den Namen A. christyi erhielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "101548b6-8bbf-4695-8e49-cae954a8bb0a",
                        "source_entry_id": "2aa9c183-1a74-3070-9161-342afa10062a",
                        "source_sense_id": "848d9bb0-8be6-39c6-82f4-6ad6ca8ddc28",
                        "source_sense_description": "expert in ichthyology",
                        "target_lang_word": "Fischkundler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischkundler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                                        "entry_id": "9f57f1c0-8164-36e9-89bd-1ba138b94b7b",
                                        "glosses": [
                                            "Wissenschaftler/Experte auf dem Gebiet der Fischkunde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be11a0c1-769d-4a42-819e-12179b810eac",
                                                "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                                                "text": "„Bekannt ist er vor allem wegen seiner bahnbrechenden Eiszeitstudien sowie seiner Leistungen als Ichthyologe (Fischkundler) und Hochschullehrer.“"
                                            },
                                            {
                                                "example_id": "5417f3a1-a278-421c-9baa-77e9eb586b25",
                                                "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                                                "text": "„Eddington vergleicht einen Naturwissenschaftler mit einem Ichthyologen, einem Fischkundler, der seine Welt erforschen will.“"
                                            },
                                            {
                                                "example_id": "ac8dcb0e-0982-4aad-8ecf-624932f60a65",
                                                "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                                                "text": "„So wie die Entwicklungen in der nordamerikanischen Fischkunde normalerweise vornehmlich für nordamerikanische Fischkundler von Interesse sind, interessieren sich für die Kunst Südafrikas vornehmlich südafrikanische Künstler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28909b31-ef65-444d-90c3-cdecd83964b8",
