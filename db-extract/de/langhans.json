                "senses": [
                    {
                        "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                        "entry_id": "31437386-4565-31e7-b5aa-c417f157b47b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2a26e63-d99a-4e85-a67a-ca359bbe73e5",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Auch Alt-Kommunarde Rainer Langhans war beim Piratenparteitag."
                            },
                            {
                                "example_id": "874b2517-e8ab-4790-a206-4432ce8588ed",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Der Spieleragent Dieter Langhans, 53, zum Beispiel betreut seine 15 Fußballer mit drei Angestellten."
                            },
                            {
                                "example_id": "606018bc-2649-4fe3-89c4-3f0fbd6291a6",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Frau Langhans ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3f697002-fea6-4a56-8fba-f4dfd44c7884",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Herr Langhans wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7799fc49-f6b9-4799-8357-5ebdd7a496d4",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Die Langhans fliegen heute nach Stockholm."
                            },
                            {
                                "example_id": "cf471cc5-5ef8-47f2-860c-02726d9ba500",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Der Langhans trägt nie die Schals, die die Langhans ihm strickt."
                            },
                            {
                                "example_id": "76021490-a85d-433d-922c-188e340e9cfd",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Langhans kommt, geht der Herr Langhans.“"
                            },
                            {
                                "example_id": "4ca7238b-742c-467c-900f-99de6f3721e7",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Langhans kommt und geht."
                            },
                            {
                                "example_id": "c4eb7cff-7f21-40bd-895e-4dfefa430ffa",
                                "sense_id": "214db3d5-d89e-3aaf-aaad-66f5dfad3f09",
                                "text": "Langhansens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
