                                                "example_id": "9a7fe8de-630c-4687-a078-73a80fbe3482",
                                                "sense_id": "dec56a33-0a6a-3248-b916-e3d3abd89e38",
                                                "text": "medical doctor; medical student"
                                            },
                                            {
                                                "example_id": "6eb1482f-50f1-4618-b567-6f365702de17",
                                                "sense_id": "dec56a33-0a6a-3248-b916-e3d3abd89e38",
                                                "text": "Do you have any medical experience?"
                                            },
                                            {
                                                "example_id": "ee08277b-ad13-4135-b051-9336b9e6529c",
                                                "sense_id": "dec56a33-0a6a-3248-b916-e3d3abd89e38",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0bc6cd5-4b90-3253-9ae0-990119288cd9",
                                        "entry_id": "25e2fc61-8567-3742-90d5-36c0f1180026",
                                        "glosses": [
                                            "Intended to have a therapeutic effect; medicinal."
                                        ],
                                        "tags": [
