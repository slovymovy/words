                        "entry_id": "4063306d-e2b5-3901-a193-5ac06e2948f1",
                        "glosses": [
                            "net-contributor (one who pays more than receiving back) (especially used of countries, commonly used in populist discourse)"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "6eaf9234-ea94-4444-9554-77d9d94db34a",
                                "sense_id": "9b9920ab-0405-38ce-b400-f2720d4079f7",
                                "text": "Dit land is de grootste nettobetaler aan de Europese Unie.",
                                "translation": "This country is the largest net-contributor to the European Union.",
                                "english": "This country is the largest net-contributor to the European Union."
                            },
                            {
                                "example_id": "44ee9b14-58ce-47e3-8c2a-ee6aec5141a9",
                                "sense_id": "9b9920ab-0405-38ce-b400-f2720d4079f7",
                                "text": "Ondanks hun welvaart zijn ze geen nettobetaler aan het systeem.",
                                "translation": "Despite their wealth, they are not a net-contributor to the system.",
                                "english": "Despite their wealth, they are not a net-contributor to the system."
                            },
                            {
                                "example_id": "f71afbcc-9f6d-4e1f-9d3c-e095f3e1a6e9",
                                "sense_id": "9b9920ab-0405-38ce-b400-f2720d4079f7",
                                "text": "Als nettobetaler draagt het land meer bij dan het terugkrijgt.",
                                "translation": "As a net-contributor, the country contributes more than it gets back.",
                                "english": "As a net-contributor, the country contributes more than it gets back."
                            }
                        ]
                    }
