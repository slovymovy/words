                                "target_senses": [
                                    {
                                        "sense_id": "2e5b3463-2048-3139-8584-d9ca4e4fd28a",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To operate or serve on a submarine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba3eb7a5-9356-37bb-8f76-f72791cf5c11",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To torpedo; to destroy with a sudden sneak attack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07b73b9-7ca4-410a-81e1-946b81394760",
                                                "sense_id": "ba3eb7a5-9356-37bb-8f76-f72791cf5c11",
                                                "text": "“We’re really at the point of chicken, where the Fed is trying to ward off inflation without submarining the economy.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1560748-0e3f-377c-90ab-0158898816cf",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To sink or submerge oneself."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54bfec7c-95b7-4f0e-8189-82acff0c7f1a",
                                                "sense_id": "f1560748-0e3f-377c-90ab-0158898816cf",
                                                "text": "The second their center snapped the ball, I submarined between the big guy's legs and tackled the halfback."
                                            },
                                            {
                                                "example_id": "c714a24f-24d3-4a71-a02f-00c05a266776",
                                                "sense_id": "f1560748-0e3f-377c-90ab-0158898816cf",
                                                "text": "Ten days later, the full force of what happened crushed me. I submarined into the depths of disillusionment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e459f758-82eb-3065-9102-50354a2f950e",
                                        "entry_id": "b6f2a201-7614-35cb-81bb-a9f8407b5c12",
                                        "glosses": [
                                            "To slide forwards underneath one's seat belt (during a crash or sudden stop)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f56fec-1fa6-4619-be3c-9d6431613df3",
                                                "sense_id": "e459f758-82eb-3065-9102-50354a2f950e",
                                                "text": "The seatback should always be up while driving so that the occupant doesn't submarine and potentially suffer severe internal injury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d712cb4-b7ef-496a-8579-31a78a93b86f",
                        "source_entry_id": "3880abb8-ece7-3cb0-962d-2ff168d4fa7d",
                        "source_sense_id": "ce1a81a9-cd86-31d7-bd82-cc405df22e0b",
                        "target_lang_word": "sous-marin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sous-marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89c56ffa-7919-3afe-a51d-8088c44a5850",
                                        "entry_id": "8ad88874-b3eb-323b-80b5-0afea2fbd937",
                                        "glosses": [
                                            "Qui est au fond de la mer ; qui est sous les flots de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6526be4b-a2e7-4514-99c7-454d93cb4f2d",
                                                "sense_id": "89c56ffa-7919-3afe-a51d-8088c44a5850",
                                                "text": "Ce bouillonnement provenait d’une source sous-marine de naphte, et il a suffi de ce fragment de cigare pour l’enflammer."
                                            },
                                            {
                                                "example_id": "18faae40-c8e9-4b8e-a9c6-1b401e0c54ce",
                                                "sense_id": "89c56ffa-7919-3afe-a51d-8088c44a5850",
                                                "text": "Les îles Féroë sont entièrement d’origine volcanique : elles ont surgi de toutes pièces du sein d’Amphitrite et sont, comme l’Islande, constituées de trapp de formation sous-marine."
                                            },
                                            {
                                                "example_id": "2ecd8684-e770-46ac-a7c2-90134dcce546",
                                                "sense_id": "89c56ffa-7919-3afe-a51d-8088c44a5850",
                                                "text": "La répartition géographique des planctons, dont la connaissance est si utile aux pêcheries, conditionne la présence des dépôts sous-marins comme ces boues à Diatomées origine du tripoli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7966c60-e308-3b6a-9e74-d92fb1387bde",
                                        "entry_id": "8ad88874-b3eb-323b-80b5-0afea2fbd937",
                                        "glosses": [
                                            "Qualifie la navigation au-dessous de la surface de la mer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sous-marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e477f01-5c7d-302c-9d5e-e65d93396a81",
                                        "entry_id": "6c752f16-a637-39c7-b72b-af8a2078cb86",
                                        "glosses": [
                                            "Navire, vaisseau de guerre qui peut naviguer au-dessous de la surface de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59b7de69-b13e-4eac-8404-ee7a657cdd01",
                                                "sense_id": "3e477f01-5c7d-302c-9d5e-e65d93396a81",
                                                "text": "Malgré tous les stimulants, mon imagination, je dois l’avouer, refuse de concevoir des sous-marins qui fassent autre chose qu’étouffer leur équipage ou de s’échouer au fond de la mer."
                                            },
                                            {
                                                "example_id": "2855154b-53bf-43d8-b2dd-1a242c85798c",
                                                "sense_id": "3e477f01-5c7d-302c-9d5e-e65d93396a81",
                                                "text": "Par navires de guerre autres que les petits bâtiments défensifs, il faut entendre : […] b. les sous-marins."
                                            },
                                            {
                                                "example_id": "4946491f-2ba7-454f-ba67-2b6775994c38",
                                                "sense_id": "3e477f01-5c7d-302c-9d5e-e65d93396a81",
                                                "text": "La prochaine guerre sera gagnée au bout du compte par les sous-marins et les avions, et nous devrions dépenser plus d’argent à les développer qu’à gaspiller nos ressources en construisant des dreadnoughts dont la seule fonction est de torpiller les cuirassés allemands et de se faire torpiller leur tour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2baed5b-bebf-3950-8758-7aed64d33def",
                                        "entry_id": "6c752f16-a637-39c7-b72b-af8a2078cb86",
                                        "glosses": [
                                            "Véhicule banalisé aux vitres teintées permettant aux policiers de surveiller un endroit sans être vus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3308b69-3550-4b71-937b-d5bdf10a7815",
                                                "sense_id": "d2baed5b-bebf-3950-8758-7aed64d33def",
                                                "text": "Les inspecteurs s’apprêtaient pour le rendez-vous, la fourgonnette était déjà placée à l’endroit indiqué, les vitres étaient teintées, elle servait de sous-marin aux policiers, elle était équipée d’écrans, de micros et d’enregistreurs, c’était le policier Villerot qui y était de faction, il restait en contact permanent avec la brigade et les inspecteurs par radio."
                                            },
                                            {
                                                "example_id": "ae8c4cfb-864a-42cc-8d33-c569c5b8e7a5",
                                                "sense_id": "d2baed5b-bebf-3950-8758-7aed64d33def",
                                                "text": "Simoné se savait surveillé, puisqu’il pousse la provocation jusqu’à taper au carreau de la camionnette banalisée, le « sous-marin », dans laquelle un inspecteur de la BRI observe ses déplacements."
                                            },
                                            {
                                                "example_id": "e63e39cd-070b-47c5-a135-19aea88c6c31",
                                                "sense_id": "d2baed5b-bebf-3950-8758-7aed64d33def",
                                                "text": "Pourtant rompus à ce genre d’obligation hélas souvent indispensable, les deux policiers qui planquent dans une camionnette banalisée de la police — un « sous-marin », comme on dit dans leur jargon — trouvent le temps long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23dfe32f-177c-3f3c-9373-606a5deedf9e",
                                        "entry_id": "6c752f16-a637-39c7-b72b-af8a2078cb86",
                                        "glosses": [
                                            "Participant qui joue volontairement en début de tournoi en-dessous de sa valeur, avant de remonter au classement pour bénéficier d’un choix favorable en cas d’égalité. — (Thierry Wendling, Ethnologie des joueurs d'échecs, Presses Universitaires de France, 2018)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c4b16f-bba9-4e6e-873f-53f25b461581",
                                                "sense_id": "23dfe32f-177c-3f3c-9373-606a5deedf9e",
                                                "text": "Le sous-marin remporte alors des victoires faciles et termine alors dans les premières places du classement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3442795-4d72-3cc2-8e0a-23e408a53cb5",
                                        "entry_id": "6c752f16-a637-39c7-b72b-af8a2078cb86",
                                        "glosses": [
                                            "Sandwich long."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb86ae9-4a4e-483d-bcbb-cd78525b044e",
                                                "sense_id": "e3442795-4d72-3cc2-8e0a-23e408a53cb5",
                                                "text": "Au Québec, on appelle un sandwich-baguette un sous-marin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
