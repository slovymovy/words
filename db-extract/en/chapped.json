                        "sense_id": "db4344c9-9e23-397b-90ce-e6a7b53ad16d",
                        "entry_id": "b3352849-c9f0-3869-ad00-906a30002262",
                        "glosses": [
                            "Dry and flaky due to excessive evaporation of water from its surface."
                        ],
                        "tags": [
                            "of skin"
                        ],
                        "examples": [
                            {
                                "example_id": "72363abe-3e6b-4465-9565-8637b56d0076",
                                "sense_id": "db4344c9-9e23-397b-90ce-e6a7b53ad16d",
                                "text": "For chapped lips, or chapped nipples, the tincture of catechu, or benjamin, […] / For severely chapped hands or face, the oxide of zinc ointment or camphor […]"
                            },
                            {
                                "example_id": "ad412fc4-6f2c-4a7f-9d52-6f173f1b92a0",
                                "sense_id": "db4344c9-9e23-397b-90ce-e6a7b53ad16d",
                                "text": "[…] his nose and his chubby cheeks were chapped and red with cold."
                            },
                            {
                                "example_id": "28697847-cac6-4911-8695-bf3ee28db8cf",
                                "sense_id": "db4344c9-9e23-397b-90ce-e6a7b53ad16d",
                                "text": "His lips were chapped and lined with a ghostly purple fringe."
                            }
                        ]
                    },
