                        "examples": [
                            {
                                "example_id": "14d9c2cc-c908-423d-adbb-d1065cbce54a",
                                "sense_id": "a00ac7f0-f1b8-3f88-85cd-f3dc91be4949",
                                "text": "Ik klauter over de rotsblokken, tot ik op het hoogste punt kom, waar de halve maan zijn blauwe schijnsel over het volgende dal legt."
                            },
                            {
                                "example_id": "e71b22dc-97ca-4fe7-a7cd-6929be4688fd",
                                "sense_id": "a00ac7f0-f1b8-3f88-85cd-f3dc91be4949",
                                "text": "Hij draagt een verwassen blauwe kiel die tot zijn kin is dichtgeknoopt."
                            },
                            {
                                "example_id": "6530b2f6-2f70-4362-9b1b-7c3c6f71e67c",
                                "sense_id": "a00ac7f0-f1b8-3f88-85cd-f3dc91be4949",
                                "text": "Haar blik is nog steeds gericht op het blauwe oppervlak."
                            }
                        ]
                    }
                ],
