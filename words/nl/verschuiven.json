{
    "word_family": [
        "schuiven",
        "verschuiving",
        "uitschuiven",
        "opschuiven",
        "afschuiven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8dc14223-bc1e-3ab9-bd25-5852cbab572c",
                    "sense_definition": "iets over een oppervlak naar een andere plek verplaatsen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>verschoof</w> de zware tafel naar de andere kant van de kamer.",
                            "target_lang_translations": {
                                "en": "He <w>moved</w> the heavy table to the other side of the room."
                            }
                        },
                        {
                            "text": "Kun je die stoel een klein stukje <w>verschuiven</w> zodat ik erlangs kan?",
                            "target_lang_translations": {
                                "en": "Can you <w>shift</w> that chair a little bit so I can get past?"
                            }
                        }
                    ],
                    "synonyms": [
                        "verplaatsen",
                        "verzetten"
                    ],
                    "common_phrases": [
                        "een meubelstuk verschuiven",
                        "een beetje verschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "to move something across a surface to another location"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to change the position of an object"
                            },
                            {
                                "target_lang_word": "slide",
                                "target_lang_sense_clarification": "to move something along a surface"
                            },
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "to move something slightly or redistribute"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c247dc89-8cf0-3855-89a1-4a1b570e63d0",
                    "sense_definition": "een afspraak of gebeurtenis naar een later tijdstip verplaatsen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moesten de vergadering naar volgende week <w>verschuiven</w> vanwege de vakantie.",
                            "target_lang_translations": {
                                "en": "We had to <w>postpone</w> the meeting until next week because of the holidays."
                            }
                        },
                        {
                            "text": "De deadline voor het project is helaas een paar dagen <w>verschoven</w>.",
                            "target_lang_translations": {
                                "en": "The deadline for the project has unfortunately been <w>pushed back</w> a few days."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstellen",
                        "verzetten",
                        "verplaatsen"
                    ],
                    "antonyms": [
                        "vervroegen"
                    ],
                    "common_phrases": [
                        "een afspraak verschuiven",
                        "de deadline verschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "to move an appointment or event to a later time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "postpone",
                                "target_lang_sense_clarification": "to delay an event to a later time"
                            },
                            {
                                "target_lang_word": "reschedule",
                                "target_lang_sense_clarification": "to change the time of an appointment"
                            },
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "to move a time slot or deadline"
                            },
                            {
                                "target_lang_word": "push back",
                                "target_lang_sense_clarification": "to delay a deadline or meeting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5acbc61e-007d-323c-8e14-39d54b7407b8",
                    "sense_definition": "het proces waarbij iets langzaam van positie verandert",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegener merkte al op dat in de geologische tijdvakken van de aarde de continenten <w>verschoven</w> zijn.",
                            "target_lang_translations": {
                                "en": "Wegener already noted that the continents have <w>shifted</w> during the earth's geological eras."
                            }
                        },
                        {
                            "text": "Door de aardbeving is de grond onder het huis een paar centimeter <w>verschoven</w>.",
                            "target_lang_translations": {
                                "en": "Due to the earthquake, the ground under the house has <w>shifted</w> a few centimeters."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschuiven"
                    ],
                    "common_phrases": [
                        "langzaam verschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "the process where something slowly changes position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "a gradual change in position or state"
                            },
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "to change place or posture"
                            },
                            {
                                "target_lang_word": "drift",
                                "target_lang_sense_clarification": "to move slowly and gradually"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}