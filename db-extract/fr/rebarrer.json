                ],
                "senses": [
                    {
                        "sense_id": "4ad83fcc-3c9f-360a-bc75-b685e5dcba27",
                        "entry_id": "2f2588ba-fb65-38b8-87dc-85c07339b47c",
                        "glosses": [
                            "Retourner, repartir à un endroit."
                        ],
                        "tags": [
                            "Nouvelle-Calédonie"
                        ],
                        "examples": [
                            {
                                "example_id": "cea1aa23-3f8d-4a66-a802-8c3afbb624cf",
                                "sense_id": "4ad83fcc-3c9f-360a-bc75-b685e5dcba27",
                                "text": "Eh ! Quand tu vas rebarrer en Frônce, les mecs vont être fin étonnés …"
                            }
                        ]
                    },
                    {
                        "sense_id": "245f3af6-6752-3981-ab28-11975b98636a",
                        "entry_id": "2f2588ba-fb65-38b8-87dc-85c07339b47c",
                        "glosses": [
                            "Remettre une barre à un objet pour le consolider."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9e634fa6-48a9-490e-b579-550553678a81",
                                "sense_id": "245f3af6-6752-3981-ab28-11975b98636a",
                                "text": "Il faudra changer les serrures et rebarrer les fenêtres."
                            }
                        ]
                    },
                    {
                        "sense_id": "226e720a-e3b9-31a2-9a58-4c9a79181527",
                        "entry_id": "2f2588ba-fb65-38b8-87dc-85c07339b47c",
                        "glosses": [
                            "Fermer à clé de nouveau."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "98716ddc-e1d0-4818-a17c-42e0664b26f4",
                                "sense_id": "226e720a-e3b9-31a2-9a58-4c9a79181527",
                                "text": "Grand Jack remet la vieille là [dans le coffre], puis il rebarre [le cadenas]."
                            },
                            {
                                "example_id": "10996a39-555c-4a9a-a2e2-a0890674ceeb",
                                "sense_id": "226e720a-e3b9-31a2-9a58-4c9a79181527",
                                "text": "Pendant que Sean rebarrait la porte, Maureen les serra contre elle, puis elle les repoussa doucement, ouvrit son corsage et tendit les bras à Mary pour qu'elle lui donne le bébé."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a9d2c8e-79fb-3131-a71f-245766ce1c91",
                        "entry_id": "2f2588ba-fb65-38b8-87dc-85c07339b47c",
                        "glosses": [
                            "Changer les barres d’un instrument à vent."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3baa8c4f-2693-4ed2-9e7d-4851d9d4a326",
                                "sense_id": "6a9d2c8e-79fb-3131-a71f-245766ce1c91",
                                "text": "Quand la barre faiblit, les basses perdent timbre et volume ; quand l'altération devient sensible, il faut rebarrer."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9b9c544-d47b-3a3d-be76-cbb4d5f57746",
                        "entry_id": "2f2588ba-fb65-38b8-87dc-85c07339b47c",
                        "glosses": [
                            "S’en retourner d’où l’on vient."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a4d74146-7d6e-3804-9ced-b5e16e46e3ce",
                        "entry_id": "2f2588ba-fb65-38b8-87dc-85c07339b47c",
                        "glosses": [
                            "Repartir, s’en aller de nouveau."
                        ],
                        "tags": [
                            "pronominal",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "01c8caab-08d9-4e6e-954c-745ed8299e7b",
                                "sense_id": "a4d74146-7d6e-3804-9ced-b5e16e46e3ce",
                                "text": "Fais gaffe que ton lapin, y se rebarre pas !"
                            }
                        ]
                    }
