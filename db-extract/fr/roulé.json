                    }
                ],
                "senses": [
                    {
                        "sense_id": "02652a2a-7e87-3e8c-a361-ea1ec102589d",
                        "entry_id": "22b5d428-8354-3824-bc4f-8676b1ea0745",
                        "glosses": [
                            "Gâteau consistant en une abaisse et une garniture enroulées sur elles-mêmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8f8b65-f805-48aa-856f-9844b790c4c7",
                                "sense_id": "02652a2a-7e87-3e8c-a361-ea1ec102589d",
                                "text": "Qui connaît mieux le hockey, selon vous ?\n Votre beau-frère qui collectionne les cartes et qui fait des mini coupes Stanley avec des emballages de roulés suisses, ou Guy Lafleur ?"
                            },
                            {
                                "example_id": "46e42f63-ffd9-4299-9c6b-f200d49e66c2",
                                "sense_id": "02652a2a-7e87-3e8c-a361-ea1ec102589d",
                                "text": "Enrouler la pâte et la farce de manière à former un roulé."
                            },
                            {
                                "example_id": "7f95d2d3-7768-443e-9b51-b2aa6142b6f4",
                                "sense_id": "02652a2a-7e87-3e8c-a361-ea1ec102589d",
                                "text": "Les cellules de Schawnn s’incurvent dans un premier temps pour recevoir l’axone, puis elles s’enroulent autour de lui à la façon d’un roulé à la confiture."
                            },
                            {
                                "example_id": "2ffd202c-ec59-4d70-8d64-656070a93738",
                                "sense_id": "02652a2a-7e87-3e8c-a361-ea1ec102589d",
                                "text": "Répandu dans toute l’Europe centrale, le Strudel désigne un roulé à base de pommes, de noix ou de graines de pavot dans une pâte feuilletée."
                            }
                        ]
                    },
                    {
                        "sense_id": "59565bd2-893b-36f6-b7fa-15d0b3b4ab53",
                        "entry_id": "22b5d428-8354-3824-bc4f-8676b1ea0745",
                        "glosses": [
                            "Doigté de tambour, utilisé en percussions, consistant à alterner deux coups à la main droite puis à la main gauche (ou réciproquement)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9fff78f-a62e-4188-820d-a90278cb1360",
                        "source_entry_id": "22b5d428-8354-3824-bc4f-8676b1ea0745",
                        "target_lang_word": "Strudel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                        "entry_id": "183c24c9-2a05-397e-9e77-2c47dfbf6776",
                                        "glosses": [
                                            "(kleiner) Wasserwirbel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dfe762d-19b3-445d-b047-60e0e78f27e0",
                                                "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                                "text": "Durch den Strudel wurde das Boot in die Tiefe gezogen."
                                            },
                                            {
                                                "example_id": "0143b94f-f78f-4165-9ba7-f390fcbf0b04",
                                                "sense_id": "c95075e3-cbd3-3505-beff-6bb47bd8506a",
                                                "text": "„Wie benommen waren die Deutschen aus den kataklysmischen Strudeln des Krieges aufgetaucht, taub noch von den Explosionsgeräuschen der Fliegerbomben und Artilleriegranaten, abgestumpft durch die Tristesse der Umstände, erschöpft von der schieren Mühsal des Überlebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                        "entry_id": "183c24c9-2a05-397e-9e77-2c47dfbf6776",
                                        "glosses": [
                                            "gefüllte Teigspeise"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6be6c02-c6e2-43c8-9beb-53a3b6f070c6",
                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "Omas Strudel schmeckt einfach am besten."
                                            },
                                            {
                                                "example_id": "44d2a95c-d2d6-47b7-a377-9eb0590af3b7",
                                                "sense_id": "18bb7e06-ac75-3326-b1fb-19f4586be0dc",
                                                "text": "„Sie backte die besten Strudel der Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
