                        "sense_id": "59cf6510-601f-34db-be4c-644de0f10ea8",
                        "entry_id": "de6855d3-0561-3ce4-bcf4-94e4743e0862",
                        "glosses": [
                            "alkoholfreies, meist kohlensäurehaltiges, süß-sauer aromatisiertes Kaltgetränk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9b3a01-998f-44da-85af-76087979c892",
                                "sense_id": "59cf6510-601f-34db-be4c-644de0f10ea8",
                                "text": "Cola ist ein koffeinhaltiges Erfrischungsgetränk."
                            },
                            {
                                "example_id": "f1a4851d-c8ed-40d8-9bd1-e4a491023f33",
                                "sense_id": "59cf6510-601f-34db-be4c-644de0f10ea8",
                                "text": "„Wenn die Vögel auf einer Flasche mit einem Erfrischungsgetränk abgedruckt sind, verkauft sich das besser als Cola oder Pepsi.“"
                            },
                            {
                                "example_id": "53dff107-2267-47c5-9a49-df4cfb8a7c20",
                                "sense_id": "59cf6510-601f-34db-be4c-644de0f10ea8",
                                "text": "„Ich dachte kurz zurück an den klimatisierten Besprechungsraum meines früheren Arbeitsgebers, mit Schnittchen, frischem Obst und Erfrischungsgetränken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
