                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>neglect</w> your garden for too long, it will be full of weeds.",
                            "target_lang_translations": {
                                "ru": "Если вы слишком надолго <w>забросите</w> свой сад, он зарастет сорняками.",
                                "tr": "Bahçenizi çok uzun süre <w>ihmal ederseniz</w>, yabani otlarla dolacaktır."
                            }
