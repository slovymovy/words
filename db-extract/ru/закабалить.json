                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc0b85a-af7e-41cb-9603-cd92899d04b2",
                                "sense_id": "fa3bb513-a19e-378a-ad98-3ea6036dc33b",
                                "text": "А у кого деньги, сударь, тот старается бедного закабалить, чтоб на его труды даровые ещё больше денег наживать."
                            },
                            {
                                "example_id": "173a61d6-87f3-4a9e-9c2b-9d0adfc8e569",
                                "sense_id": "fa3bb513-a19e-378a-ad98-3ea6036dc33b",
                                "text": "Чем он закабалил её?"
                            }
                        ]
                    }
