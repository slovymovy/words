                        "glosses": [
                            "klasa okrętów, których podstawową cechą jest przystosowanie do bazowania na nich śmigłowców; określenie to nie obejmuje okrętów przenoszących 1-2 śmigłowce, jako uzupełnienie innego uzbrojenia"
                        ],
