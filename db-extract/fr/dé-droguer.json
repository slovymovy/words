                "senses": [
                    {
                        "sense_id": "5ddcec52-5eed-3cfd-808f-585dc68f572d",
                        "entry_id": "f1d80344-caa6-30b1-a8fd-d675d1e2899f",
                        "glosses": [
                            "Faire sortir de la drogue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2f3893a-2a87-4d09-9dba-30375f29fdde",
                                "sense_id": "5ddcec52-5eed-3cfd-808f-585dc68f572d",
                                "text": "Il s’agit de dé-droguer les accros du travail en leur proposant de passer à mi-temps, et d’utiliser l’autre mi-temps – rémunéré au même tarif pour tous – pour créer une activité choisie, hors entreprise et hors famille."
                            },
                            {
                                "example_id": "b1e83156-57f4-40e0-bd3c-3f607e32e073",
                                "sense_id": "5ddcec52-5eed-3cfd-808f-585dc68f572d",
                                "text": "Comment se dé-droguer de l’informatique."
                            },
                            {
                                "example_id": "3ecaf0d0-e89f-4440-a7a0-5b913b9cfe76",
                                "sense_id": "5ddcec52-5eed-3cfd-808f-585dc68f572d",
                                "text": "Je trouve qu’il faut se dé-droguer du besoin de certitude."
                            },
                            {
                                "example_id": "2bbf81ef-bcb6-48bd-b1a8-0cc2c8d202c6",
                                "sense_id": "5ddcec52-5eed-3cfd-808f-585dc68f572d",
                                "text": "En se bougeant, en se musclant et en se dé-droguant (le blé est la drogue psychotrope fondatrice de la civilisation), en embrassant la réalité, en s’y confrontant même quand ça pique émotionnellement, l’humanité développe sa maîtrise, son ressenti, se libère et laisse couler la force de vie et l’amour universel."
                            }
                        ]
                    }
