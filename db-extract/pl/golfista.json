                "senses": [
                    {
                        "sense_id": "4201b8f4-70c6-3beb-aa92-9e630ff33e86",
                        "entry_id": "4b0f63f8-e809-36d4-9199-25198b0cd586",
                        "glosses": [
                            "ktoś, kto uprawia golf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b120aa3-3f19-4309-beea-f1c9eb7cb5c0",
                                "sense_id": "4201b8f4-70c6-3beb-aa92-9e630ff33e86",
                                "text": "Mój brat jest świetnym golfistą, bo trenuje trzy razy w tygodniu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddb4d396-4df8-44fd-80c6-da44090c10ff",
                        "source_entry_id": "4b0f63f8-e809-36d4-9199-25198b0cd586",
                        "source_sense_id": "4201b8f4-70c6-3beb-aa92-9e630ff33e86",
                        "target_lang_word": "golfer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golfer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b4be2fe-b7c9-3c7f-9ed4-f69cd717ae33",
                                        "entry_id": "18ee7ab7-fb52-3fc6-b5a0-c9fc8808fd20",
                                        "glosses": [
                                            "Someone who plays golf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7927a2d2-f36a-450b-9f56-7bd974c72abd",
                                                "sense_id": "8b4be2fe-b7c9-3c7f-9ed4-f69cd717ae33",
                                                "text": "It had been 2,836 days since Chris Kirk last won on the PGA Tour. Yet after securing his first victory in over seven years on Sunday, that was not the first milestone the American golfer had on his mind."
                                            },
                                            {
                                                "example_id": "7358d394-179b-40f5-960d-f706316afc99",
                                                "sense_id": "8b4be2fe-b7c9-3c7f-9ed4-f69cd717ae33",
                                                "text": "“The player should usually be able to play more quickly than that and is encouraged to do so,” the guidelines state, with golfers that exceed 40 seconds – AKA “bad time” – “informed as soon as practicable” by a tournament official."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a349cd-27f4-3329-88a9-f8f803bb336e",
                                        "entry_id": "18ee7ab7-fb52-3fc6-b5a0-c9fc8808fd20",
                                        "glosses": [
                                            "One who takes part in code golf or regex golf."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a1848f1-a86f-46d3-b19b-ff9821a8791c",
                        "source_entry_id": "4b0f63f8-e809-36d4-9199-25198b0cd586",
                        "source_sense_id": "4201b8f4-70c6-3beb-aa92-9e630ff33e86",
                        "target_lang_word": "golfeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golfeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c627816-f538-363b-bd17-089b32632b1a",
                                        "entry_id": "c1d8b58c-16b0-34fb-b65a-0df9ea425e07",
                                        "glosses": [
                                            "Personne qui pratique le golf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74581cfc-c6eb-4aaf-aa27-20844c43ef8f",
                                                "sense_id": "4c627816-f538-363b-bd17-089b32632b1a",
                                                "text": "Hélas, ils avaient omis un principe fondamental : un golfeur, c’est avant tout un paquet de nerfs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40c93e57-86d0-48c6-8513-3a9dd7b021ab",
                        "source_entry_id": "4b0f63f8-e809-36d4-9199-25198b0cd586",
                        "source_sense_id": "4201b8f4-70c6-3beb-aa92-9e630ff33e86",
                        "target_lang_word": "golfista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8c2ea20e-9dcc-4887-88e9-fba7b175f467",
                        "source_entry_id": "4b0f63f8-e809-36d4-9199-25198b0cd586",
                        "source_sense_id": "4201b8f4-70c6-3beb-aa92-9e630ff33e86",
                        "target_lang_word": "Golfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Golfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "271adc5e-2dab-3a3e-b7b1-582a3043e694",
                                        "entry_id": "2d19e700-0201-3795-b726-33af90592d68",
                                        "glosses": [
                                            "Sportler, der das Golfspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c4d9d7-d02d-4fbc-8415-afc86ff7faff",
                                                "sense_id": "271adc5e-2dab-3a3e-b7b1-582a3043e694",
                                                "text": "Mein Nachbar ist ein begeisterter Golfer."
                                            },
                                            {
                                                "example_id": "fab2344c-5de2-4ea7-a635-b004a8e2e5bf",
                                                "sense_id": "271adc5e-2dab-3a3e-b7b1-582a3043e694",
                                                "text": "„Die Los Angeles Times und ESPN hatten berichtet, der 15-malige Major-Sieger und beste Golfer seiner Generation habe Frakturen an beiden Beinen sowie einen Knöchelbruch davongetragen.“"
                                            },
                                            {
                                                "example_id": "83308b72-e4d4-4c05-bb1b-4ee7c37a5e16",
                                                "sense_id": "271adc5e-2dab-3a3e-b7b1-582a3043e694",
                                                "text": "„Ich unterteilte die Strecke in drei Abschnitte, kannte inzwischen jeden Stamm genau, und wie ein Golfer vor dem entscheidenden Putt das Grün, studierte ich die Besonderheiten des Holzes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
