                                "sense_id": "bc7b535c-54f1-3681-b113-33c51575512c",
                                "text": "Each one who crosses over to those already counted is to give a half shekel, according to the sanctuary shekel, which weighs twenty gerahs."
                            },
                            {
                                "example_id": "87993ed5-a82e-486b-b1eb-0d4a84b9701f",
                                "sense_id": "bc7b535c-54f1-3681-b113-33c51575512c",
                                "text": "Every value is to be set according to the sanctuary shekel, twenty gerahs to the shekel."
                            }
                        ]
