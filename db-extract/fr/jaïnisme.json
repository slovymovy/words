                        "entry_id": "16e63e26-8e70-3600-af42-3cd6f392a958",
                        "glosses": [
                            "Religion qui insiste sur les concepts d’ahimsa (non-violence) et de karma, et met l’accent sur l’ascétisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9968e0d-ec94-4562-9607-331c5420c75e",
                                "sense_id": "325c0e9d-a81c-3d25-bbe7-a9c9300e1214",
                                "text": "Le caractère peu missionnaire du jaïnisme est frappant et sa doctrine est fondamentalement aristocratique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef2a9567-d5d8-48ea-9320-973084c5fa7a",
                        "source_entry_id": "16e63e26-8e70-3600-af42-3cd6f392a958",
