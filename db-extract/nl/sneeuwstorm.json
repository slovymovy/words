                            {
                                "example_id": "510df64e-ceac-4abb-9216-5ce1f81da656",
                                "sense_id": "01dd62f9-f336-3a4b-a69d-3f58fc160d89",
                                "text": "De sneeuwstorm bedekte de stad in een dikke laag sneeuw.",
                                "translation": "The snowstorm covered the city in a thick blanket of snow.",
                                "english": "The snowstorm covered the city in a thick blanket of snow."
                            },
                            {
                                "example_id": "98d393ca-a758-48a5-afaa-bcb4280c8a29",
                                "sense_id": "01dd62f9-f336-3a4b-a69d-3f58fc160d89",
                                "text": "Reizen tijdens een sneeuwstorm kan gevaarlijk zijn.",
                                "translation": "Traveling during a snowstorm can be dangerous.",
                                "english": "Traveling during a snowstorm can be dangerous."
                            },
                            {
                                "example_id": "f8be15cc-42ea-4494-b347-397bc25c958f",
                                "sense_id": "01dd62f9-f336-3a4b-a69d-3f58fc160d89",
                                "text": "Het sneeuwstormpje was onverwacht voor deze tijd van het jaar.",
                                "translation": "The brief snowstorm was unexpected for this time of the year.",
                                "english": "The brief snowstorm was unexpected for this time of the year."
                            }
                        ]
