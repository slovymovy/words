                "senses": [
                    {
                        "sense_id": "3a484e67-1446-3ce9-8831-b486ab3cd02d",
                        "entry_id": "4116ea30-8405-39d9-8c95-b270a84bf471",
                        "glosses": [
                            "Zweig der Philosophie, der sich mit Moral/Ethik befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8acb6239-5200-4f8d-aec1-f7ab6bed60b2",
                                "sense_id": "3a484e67-1446-3ce9-8831-b486ab3cd02d",
                                "text": "„Auf dem Heimweg sprach der Herzog allein und stellte eine Fülle von Überlegungen über das an, was man in der Moralphilosophie Vorurteil nennen kann.“"
                            },
                            {
                                "example_id": "aec909bd-ae33-467d-896b-241a9e15e760",
                                "sense_id": "3a484e67-1446-3ce9-8831-b486ab3cd02d",
                                "text": "„Moralphilosophie wird zum Gespräch, und dieses zeigt die Unabschließbarkeit solchen Räsonnements.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd24ae08-e648-4713-a483-7980ed5a70b8",
                        "source_entry_id": "4116ea30-8405-39d9-8c95-b270a84bf471",
                        "source_sense_id": "3a484e67-1446-3ce9-8831-b486ab3cd02d",
