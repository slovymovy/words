                            {
                                "example_id": "d8e74375-6008-497c-b547-59c2db50ef90",
                                "sense_id": "5a765fac-5e39-3a25-b0b1-f9cfef710821",
                                "text": "In de supermarkt is een breed assortiment van voedingsproducten verkrijgbaar."
