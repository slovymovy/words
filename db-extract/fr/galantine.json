                                        "entry_id": "e37c2bfa-3b06-3c5b-96c4-7ab6f154c576",
                                        "glosses": [
                                            "A spiced, thickened sauce served with fish or poultry."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3ed466a-34d8-489a-9673-73e9a929b00a",
                                                "sense_id": "bcf3220a-bd2c-3b6f-87fc-e1b6742e0120",
                                                "text": "‘Have some galantine. I'm going to. Your sole's cold.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ec8a9b-0b8f-3d01-87fe-1fcc3ade662a",
                                        "entry_id": "e37c2bfa-3b06-3c5b-96c4-7ab6f154c576",
                                        "glosses": [
                                            "A dish of boned, often stuffed meat (or fish) that has been boiled, and is served cold with its jelly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7451fd04-ad60-4dc5-bed2-cdacd5ccbb79",
                                                "sense_id": "c6ec8a9b-0b8f-3d01-87fe-1fcc3ade662a",
                                                "text": "Of how many creams, jellies, salads, peaches, white soups, grapes, pates, galantines, cups of tea, champagne, and so forth, Lady Clavering partook, it does not become us to say."
                                            },
                                            {
                                                "example_id": "1f24d9f6-f5cb-4bd5-8986-3d5e393fbc46",
                                                "sense_id": "c6ec8a9b-0b8f-3d01-87fe-1fcc3ade662a",
                                                "text": "Canapes of many kinds, galantines to be scooped or carved, cheese and onions, no Worcestershire sauce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
