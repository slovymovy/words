                                "target_senses": [
                                    {
                                        "sense_id": "c222574c-ad68-3098-beaa-43c9b4644fa3",
                                        "entry_id": "9c0849c4-881e-36a7-a8ca-5c7197054508",
                                        "glosses": [
                                            "A machine that tabulates the amount of sales transactions, makes a permanent and cumulative record of them, and has a drawer in which cash can be kept."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9793f628-a616-39e2-9d83-f60ae507a2e1",
                                        "entry_id": "9c0849c4-881e-36a7-a8ca-5c7197054508",
                                        "glosses": [
                                            "A point of sale."
                                        ],
                                        "tags": [],
