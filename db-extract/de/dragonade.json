                "senses": [
                    {
                        "sense_id": "886b77a6-5a53-3edc-b62a-d50042210794",
                        "entry_id": "2511f07f-29e1-3792-830d-ca000f7002b2",
                        "glosses": [
                            "Strafmaßnahme König Ludwigs XIV. von Frankreich gegen protestantische Kamisarden und andere Hugenotten"
                        ],
                        "tags": [
                            "historical",
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "12d51439-1289-4ae0-baac-e4e8473edd02",
                                "sense_id": "886b77a6-5a53-3edc-b62a-d50042210794",
                                "text": "„Es sind hier ganz andere schlimmere Dinge vorgekommen, als bei den mit Recht so verschrieenen Dragonaden Ludwig 's XlV. in Frankreich, anderthalb Jahrhunderte später.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e8c71fcc-98fa-3dbd-8671-312a68514b3e",
                        "entry_id": "2511f07f-29e1-3792-830d-ca000f7002b2",
                        "glosses": [
                            "drastische, brutale Strafmaßnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "261f8e7b-9a30-4b56-ae09-6fe35813d4ed",
                                "sense_id": "e8c71fcc-98fa-3dbd-8671-312a68514b3e",
                                "text": "„Mit Recht erinnert Dodel-Port an die schrecklichen Verfolgungen, denen die österreichischen Protestanten noch im achtzehnten Jahrhundert durch die geistlichen Machthaber unterworfen wurden. Und hier liegt eine Dragonade vor: brutale Gewalt gegen unwillkommene Überzeugung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
