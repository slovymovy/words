                "senses": [
                    {
                        "sense_id": "4125b7d8-9b1f-3028-85c2-fcaa5286ed1e",
                        "entry_id": "39078524-ed08-36dc-92ad-cdffc2c5e349",
                        "glosses": [
                            "Donner un caractère dioula à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3ce1ef-97f1-44a4-913a-551304fd5e01",
                                "sense_id": "4125b7d8-9b1f-3028-85c2-fcaa5286ed1e",
                                "text": "Sitôt le scrutin présidentiel remporté en 1995 par Henri Konan Bédié, Alpha Blondy critiquait déjà la tribalisation de la vie politique ivoirienne, en jouant des origines communautaires des principaux protagonistes (dioula, bété, baoulé) pour chanter: «Ils ont dioulaïsé le débat, ils ont bétéïsé le débat, ils ont baoulisé le débat»."
                            },
                            {
                                "example_id": "67b5012b-0faf-4413-86ae-11a31bf909c1",
                                "sense_id": "4125b7d8-9b1f-3028-85c2-fcaa5286ed1e",
                                "text": "On pourrait faire de même en Afrique, dioulaïser, bétéiser certains mots français."
                            }
                        ]
                    }
