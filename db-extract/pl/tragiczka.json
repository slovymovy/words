                                "example_id": "e0146ecd-89bc-409b-98d7-5dc690e7adc6",
                                "sense_id": "17a0d6b1-16ac-3c4f-88cb-f7aa1e7f3f1f",
                                "text": "Ta wielka aktorka komediowa zdobyła się na najgłębszy wyraz dramatyczny i przejmującą wymowę ludzkiego serca, godną prawdziwej tragiczki"
                            },
                            {
                                "example_id": "40b5c697-70d3-464f-bca3-147341e5c6ce",
                                "sense_id": "17a0d6b1-16ac-3c4f-88cb-f7aa1e7f3f1f",
                                "text": "Nazywano ją największą tragiczką ekranu, choć oprócz ról melodramatycznych grała i w komediach, i w filmach sensacyjnych"
                            }
                        ],
