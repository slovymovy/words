                    {
                        "sense_id": "ffde3198-26b7-317c-8948-e7f7bba26814",
                        "entry_id": "a9848df2-415e-3eea-bb63-1318c575595b",
                        "glosses": [
                            "Staatsbürgerin von Ägypten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7146a363-f314-4188-9356-9744b3de7cc5",
                                "sense_id": "ffde3198-26b7-317c-8948-e7f7bba26814",
                                "text": "Die Ägypterin wurde 1910 geboren und verstarb 1999."
                            },
                            {
                                "example_id": "ee0b499a-4de3-4c3c-95f1-5269370a4213",
                                "sense_id": "ffde3198-26b7-317c-8948-e7f7bba26814",
                                "text": "„Die Familie der in einem Dresdner Gerichtssaal ermordeten Ägypterin Marwa El-Sherbini will erreichen, dass die Ermittlungen in dem Fall weitergehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
