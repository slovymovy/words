                    {
                        "translation_id": "bfe989ba-129e-4955-b084-30b08f110041",
                        "source_entry_id": "dcd1925a-6e05-3a95-91d0-f50bcb1f6d1a",
                        "source_sense_id": "e929c02e-9c87-3a3d-bf28-ac4ebd9b24e4",
                        "target_lang_word": "Einheitlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einheitlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea347fff-372b-3a8c-ae22-cafa95fe1c38",
                                        "entry_id": "4a6ab7b2-6884-39cc-ba2b-30218715e33c",
                                        "glosses": [
                                            "Eigenschaft/Zustand, ohne Unterschiede zu sein, einförmig, gleichartig gestaltet zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc14807-f93e-4444-8af8-00bdfc532966",
                                                "sense_id": "ea347fff-372b-3a8c-ae22-cafa95fe1c38",
                                                "text": "„Diese Einheitlichkeit der Vorschriften stellt eine der großen Errungenschaften des Weltpostvereins dar.“"
                                            },
                                            {
                                                "example_id": "f9969bf3-c96f-4220-bf0d-20e99238cfce",
                                                "sense_id": "ea347fff-372b-3a8c-ae22-cafa95fe1c38",
                                                "text": "„Bundesgesundheitsminister Jens Spahn (CDU) plädiert angesichts der unterschiedlichen Quarantäne-Vorschriften der Länder nach Corona-Fällen in den Schulen für mehr Einheitlichkeit.“"
                                            },
                                            {
                                                "example_id": "62b0c300-c831-45a1-a4bb-00e7d16d17f4",
                                                "sense_id": "ea347fff-372b-3a8c-ae22-cafa95fe1c38",
                                                "text": "„Geteilter Meinung sind die Deutschen bei der Frage, ob die Schulen mehr Freiheiten etwa bei der Gestaltung der Lehrpläne bekommen sollten oder ob es doch besser wäre, wegen der Einheitlichkeit der Bedingungen möglichst viel zentral zu regeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
