                                            {
                                                "example_id": "3d15c46c-586f-4559-82bd-6dfb591843f7",
                                                "sense_id": "1a665078-d3ab-3a87-92e7-1a9ff6998a81",
                                                "text": "Het doet denken aan een groot schaakbord waarop huizen verdeeld staan als witte pionnen."
                                            },
                                            {
                                                "example_id": "9d3a2bca-93d9-478b-87bf-ecbf160f9da4",
                                                "sense_id": "1a665078-d3ab-3a87-92e7-1a9ff6998a81",
                                                "text": "Omdat Korea sinds 1945 is verdeeld in Noord- en Zuid Korea, is die trail al lang niet meer in zijn geheel gelopen."
                                            }
                                        ]
                                    }
