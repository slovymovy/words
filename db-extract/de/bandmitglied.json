                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5daff0-bc67-4c89-aadc-be831b238189",
                                "sense_id": "da8566a7-c9a7-3cb1-98b5-21bd10e3df6e",
                                "text": "„Die Scorpions trauern um ihr langjähriges Bandmitglied: James Kottak, der zwischen 1996 und 2016 am Schlagzeug der deutschen Rockband saß, ist tot.“"
                            },
                            {
                                "example_id": "e4110f46-4ca6-4c82-981b-26210a396a4c",
                                "sense_id": "da8566a7-c9a7-3cb1-98b5-21bd10e3df6e",
                                "text": "„Seit 2003 übernimmt Robert Trujillo den E-Bass. Die anderen Bandmitglieder von Metallica sind seit 1983 unverändert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
