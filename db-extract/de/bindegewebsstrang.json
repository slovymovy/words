                ],
                "senses": [
                    {
                        "sense_id": "20d7dee7-991a-3ecd-a13a-f3579a0c5cc9",
                        "entry_id": "12b7f8c8-3912-3dfc-b3bc-c100747602b3",
                        "glosses": [
                            "Strang aus Bindegewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5160492-b975-4009-9372-efb3b9efe03d",
                                "sense_id": "20d7dee7-991a-3ecd-a13a-f3579a0c5cc9",
                                "text": "In manchen Fällen setzt sich der Dermalsinus als fibröser Bindegewebsstrang bis in das Rückenmark fort und ist in solchen Fällen mit einer Spina bifida occulta kombiniert."
                            },
                            {
                                "example_id": "1dffb538-1e15-432c-960d-e4e155f51d4e",
                                "sense_id": "20d7dee7-991a-3ecd-a13a-f3579a0c5cc9",
                                "text": "Der Ductus arteriosus verschließt sich (obliteriert) normalerweise in den ersten Lebenstagen bis -wochen nach der Geburt (postnatal) und bildet das Ligamentum arteriosum, welches als Bindegewebsstrang den Truncus pulmonalis mit dem Aortenbogen verbindet."
                            },
                            {
                                "example_id": "194b3a28-fa3f-4ecf-afa5-358a65e01f64",
                                "sense_id": "20d7dee7-991a-3ecd-a13a-f3579a0c5cc9",
                                "text": "Durch Bindegewebsstränge entsteht eine lobuläre (gelappte) Gewebsarchitektur."
                            },
                            {
                                "example_id": "fd47925e-4a8f-4094-ac2c-bff8b98a06af",
                                "sense_id": "20d7dee7-991a-3ecd-a13a-f3579a0c5cc9",
                                "text": "Ein wenigstens in den ersten Lebensjahren regelmäßig anzutreffender und meist in ganzer Ausdehnung noch gefäßhaltiger Bindegewebsstrang ist die der Knorpelfuge vor dem ovalen Fenster entsprechende Fissura ante fenestram (SIEBENMANN)."
                            },
                            {
                                "example_id": "d9d65751-a85b-4c6c-a26b-8d1f07637901",
                                "sense_id": "20d7dee7-991a-3ecd-a13a-f3579a0c5cc9",
                                "text": "Dieser vereinigte Bindegewebsstrang zieht noch weiter abwärts und erreicht den Basisteil des vorderen Papillarmuskels."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
