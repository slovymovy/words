                            {
                                "example_id": "3e2f76e8-178b-4734-9084-e797b0367a5e",
                                "sense_id": "3d3685f2-a42f-32dd-8409-466d60fc71cb",
                                "text": "Le terrain glaciaire qui couvre l'Écosse, les deux tiers septentrionaux de l'Angleterre et l'Irlande tout entière, ils [les géologues anglais] le désignent sous le nom de drift."
                            }
