                                "example_id": "dd033963-2692-4d02-b362-67d74e23f462",
                                "sense_id": "0f28c8ca-52c3-37c6-b2f6-d616aa10d2f3",
                                "text": "Die Existenz des Gravitons wurde bislang noch nicht experimentell bestätigt."
                            },
                            {
                                "example_id": "54f240ac-39ee-4bc4-babf-5c179466c85c",
                                "sense_id": "0f28c8ca-52c3-37c6-b2f6-d616aa10d2f3",
                                "text": "Der Spin eines Gravitons wird aufgrund von Überlegungen aus der Quantenfeldtheorie zu S=2 postuliert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
