                "senses": [
                    {
                        "sense_id": "52f85ff1-3c71-3cf9-9b39-2b4493c62d51",
                        "entry_id": "6c821e80-2f15-3c74-8aca-ff0fae039e66",
                        "glosses": [
                            "That which one is bidden to do; a command."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de83d2a1-5a45-4c02-8b7f-244c3add3a7f",
                                "sense_id": "52f85ff1-3c71-3cf9-9b39-2b4493c62d51",
                                "text": "I still have lots of paperwork to do at the boss's bidding."
                            },
                            {
                                "example_id": "f39f9f9e-a0a1-4381-afe1-cb886fe9c13d",
                                "sense_id": "52f85ff1-3c71-3cf9-9b39-2b4493c62d51",
                                "text": "Do their biddings, and they will lead you to \"whatsoever things are true, whatsoever things are honest, whatsoever things are just, whatsoever things are pure, whatsoever things are lovely, whatsoever things are of good report.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "6f1c0346-3940-35c7-9bf9-e30a24f28895",
                        "entry_id": "6c821e80-2f15-3c74-8aca-ff0fae039e66",
                        "glosses": [
                            "The act of placing a bid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01448d99-4ee6-4e84-b10f-36bf4e28ffde",
                                "sense_id": "6f1c0346-3940-35c7-9bf9-e30a24f28895",
                                "text": "Their biddings forced existing owners into ruinous competition; they mortgaged their ancestral acres to buy up outlying properties or round off their boundaries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6449a5fc-e52e-45a0-8f60-7d4017c645a4",
