                                                "example_id": "cb1c6e5a-6229-41a9-8f64-2d098feb4f5b",
                                                "sense_id": "7e448167-9e17-314e-95e2-03f76358e3a8",
                                                "text": "But in the half light of dawn, at about half past four, a destroyer came towards them from the west, throwing a deep, feathery bow wave of white foam aside as she cut through the water, bearing down on them."
                                            },
                                            {
                                                "example_id": "45875bd3-892e-4051-8e82-67d66c86fbda",
