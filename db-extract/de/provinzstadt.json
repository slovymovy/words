                "senses": [
                    {
                        "sense_id": "ddc04da4-1387-3b63-8c7b-006382a0ace7",
                        "entry_id": "dd7fe036-0ebf-3bdc-a5e7-14f6a5d7ae49",
                        "glosses": [
                            "kleine/mittelgroße Stadt außerhalb der kulturellen, politischen oder wirtschaftlichen Zentren eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "395c111e-143e-497e-a957-d45903049257",
                                "sense_id": "ddc04da4-1387-3b63-8c7b-006382a0ace7",
                                "text": "„Nicht weniger überraschend wird es für uns heute sein, daß die enthusiastisch gelobte Sammlung keine glänzende Metropole ziert, sondern das wohlgehütete Schatzhaus einer kleinen Provinzstadt ist.“"
                            },
                            {
                                "example_id": "af148c5d-e554-4d0e-bc98-7360b34bb1bc",
                                "sense_id": "ddc04da4-1387-3b63-8c7b-006382a0ace7",
                                "text": "„Offenburg ist heute eine mittelgroße Provinzstadt, die für sich genommen ein ruhiges Dasein führt und nicht allzu häufig Erwähnung findet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
