                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1d7ad80-3b81-4619-bae9-147ab5dfc29b",
                        "source_entry_id": "10e2b445-4eaf-34ac-908c-0409405bc015",
                        "source_sense_id": "05be42a0-1db4-3a97-bfb1-d7433e94c221",
                        "source_sense_description": "scientific study of poisons and poisoning",
                        "target_lang_word": "toxicologie",
