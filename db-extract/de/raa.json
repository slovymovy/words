                "senses": [
                    {
                        "sense_id": "949fa6a5-cce5-38d3-9d61-b6e43cf39a1c",
                        "entry_id": "b78facd7-4a7d-3ec4-8f1d-a7f34ad02c87",
                        "glosses": [
                            "Querstange am Mast eines Segelschiffs für die Anbringung des rechteckigen oder trapezförmigen Rahsegels"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "64ab8db2-2d1e-4120-bafb-18098ccba8ae",
                                "sense_id": "949fa6a5-cce5-38d3-9d61-b6e43cf39a1c",
                                "text": "Was er denn auch tat, und so bediente sich Europa am Sonntag, dem 25. November 1492, zum ersten Mal nennenswert aus den überseeischen Ressourcen: Die Karavelle Niña bekam einen neuen Besanmast und eine neue Raa für ihr Lateinersegel."
                            },
                            {
                                "example_id": "5920deda-b8e0-4a9e-8260-4c99a2280e87",
                                "sense_id": "949fa6a5-cce5-38d3-9d61-b6e43cf39a1c",
                                "text": "Auf meine Anordnung, sagte ich, sei das Schiff wieder erobert und liege jetzt auf der Rhede; sie würden demnächst ihren neuen Kapitän an der großen Raa baumeln sehen, auf daß er den gerechten Lohn seiner Schurkerei empfange."
                            },
                            {
                                "example_id": "1fb2aa44-31e2-4317-98ee-8c735583afe9",
                                "sense_id": "949fa6a5-cce5-38d3-9d61-b6e43cf39a1c",
                                "text": "Ein aus zwei mit Schalen verstärkten Stäben verfertigter Mast, eine aus einem dritten gebildete Raa, ein unseren Decken entliehenes Segel - dies war das Takelwerk des Flosses."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
