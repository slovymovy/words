                ],
                "senses": [
                    {
                        "sense_id": "1d7d2c20-67b0-35cb-a33b-3b9cc7407730",
                        "entry_id": "27fa623b-54f5-355d-b85f-b0d81cab9cb1",
                        "glosses": [
                            "linguistische Disziplin, die sich mit den typologischen Besonderheiten von Sprachen in bestimmten, abgegrenzten Gebieten befasst. Ihr Gegenstand sind die sogenannten Sprachbünde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "433dee94-c56d-4743-b481-d775ac0235ef",
                                "sense_id": "1d7d2c20-67b0-35cb-a33b-3b9cc7407730",
                                "text": "Die Arealtypologie befasst sich mit den typologischen Eigenschaften, die Sprachen aufgrund ihrer geographischen Nähe gemeinsam ausgebildet haben."
                            },
                            {
                                "example_id": "6d78e2c0-d201-4dde-9758-b1dff7ff755b",
                                "sense_id": "1d7d2c20-67b0-35cb-a33b-3b9cc7407730",
                                "text": "Die Areallinguistik ist mehr auf Dialekte ausgerichtet, die Arealtypologie mehr auf (benachbarte) Sprachen."
                            },
                            {
                                "example_id": "3c52de3a-66de-4672-89ff-bfc2b01c57f9",
                                "sense_id": "1d7d2c20-67b0-35cb-a33b-3b9cc7407730",
                                "text": "„Auch die Arealtypologie ist damit befaßt, Übereinstimmungen auszumachen, die in strukturell verschiedenen Sprachsystemen unter vergleichbaren Gesichtspunkten von Fall zu Fall bestehen.“"
                            },
                            {
                                "example_id": "c6a6af4c-9972-422b-adc9-ed88b1650519",
                                "sense_id": "1d7d2c20-67b0-35cb-a33b-3b9cc7407730",
                                "text": "„Der identifizierte Sprachtyp entspricht in der Arealtypologie einem arealen Individualtyp (Isoglossenbündelung als Kombination paralleler sprachlicher Eigenschaften).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
