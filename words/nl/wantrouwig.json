{
    "word_family": [
        "wantrouwen",
        "wantrouwigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0abe17c-b213-3925-8d66-25f9d7b0263f",
                    "sense_definition": "geen vertrouwen hebbend in iemand of iets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man keek de vreemdeling <w>wantrouwig</w> aan toen hij zijn erf opkwam.",
                            "target_lang_translations": {
                                "en": "The old man looked at the stranger <w>distrustfully</w> when he entered his yard.",
                                "ru": "Старик <w>недоверчиво</w> посмотрел на незнакомца, когда тот вошел в его двор."
                            }
                        },
                        {
                            "text": "Zij is van nature een <w>wantrouwig</w> persoon en gelooft niet zomaar wat anderen zeggen.",
                            "target_lang_translations": {
                                "en": "She is a <w>suspicious</w> person by nature and doesn't just believe what others say.",
                                "ru": "Она по натуре <w>недоверчивый</w> человек и не верит просто так всему, что говорят другие."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterdochtig",
                        "argwanend"
                    ],
                    "antonyms": [
                        "goedgelovig",
                        "vertrouwend"
                    ],
                    "common_phrases": [
                        "iemand wantrouwig aankijken",
                        "een wantrouwig gevoel"
                    ],
                    "target_lang_definitions": {
                        "en": "having or showing a lack of trust in someone or something",
                        "ru": "не имеющий доверия к кому-либо или чему-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "distrustful",
                                "target_lang_sense_clarification": "lacking trust in others"
                            },
                            {
                                "target_lang_word": "suspicious",
                                "target_lang_sense_clarification": "inclined to suspect evil or untrustworthiness"
                            },
                            {
                                "target_lang_word": "mistrustful",
                                "target_lang_sense_clarification": "having a lack of confidence or trust"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "недоверчивый",
                                "target_lang_sense_clarification": "склонный не доверять людям"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "выражающий сомнение или недоверие"
                            },
                            {
                                "target_lang_word": "мнительный",
                                "target_lang_sense_clarification": "склонный видеть во всем опасность или обман"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3de79e65-47ee-35aa-a771-3637599af7bf",
                    "sense_definition": "met een kritische of sceptische houding voortkomend uit een gevoel van misleiding",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel burgers staan <w>wantrouwig</w> tegenover de nieuwe beloftes van de overheid.",
                            "target_lang_translations": {
                                "en": "Many citizens are <w>skeptical</w> of the government's new promises.",
                                "ru": "Многие граждане <w>скептически</w> относятся к новым обещаниям правительства."
                            }
                        },
                        {
                            "text": "Punk verwijst naar een stroming die zeer <w>wantrouwig</w> tegen de grote ideologieën aankijkt.",
                            "target_lang_translations": {
                                "en": "Punk refers to a movement that looks very <w>suspiciously</w> at major ideologies.",
                                "ru": "Панк относится к течению, которое крайне <w>настороженно</w> смотрит на великие идеологии."
                            }
                        }
                    ],
                    "synonyms": [
                        "sceptisch",
                        "kritisch"
                    ],
                    "common_phrases": [
                        "wantrouwig tegenover staan",
                        "wantrouwig aankijken tegen"
                    ],
                    "target_lang_definitions": {
                        "en": "having a critical or skeptical attitude arising from a feeling of being misled",
                        "ru": "с критическим или скептическим отношением, вызванным чувством возможного обмана"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suspicious",
                                "target_lang_sense_clarification": "distrustful or tending to suspect motives"
                            },
                            {
                                "target_lang_word": "skeptical",
                                "target_lang_sense_clarification": "not easily convinced; having doubts"
                            },
                            {
                                "target_lang_word": "wary",
                                "target_lang_sense_clarification": "feeling or showing caution about possible dangers or problems"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "скептический",
                                "target_lang_sense_clarification": "полный сомнения, критически настроенный"
                            },
                            {
                                "target_lang_word": "настороженный",
                                "target_lang_sense_clarification": "проявляющий осторожность и недоверие"
                            },
                            {
                                "target_lang_word": "недоверчивый",
                                "target_lang_sense_clarification": "относящийся к чему-либо с сомнением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}