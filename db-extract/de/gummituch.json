                "senses": [
                    {
                        "sense_id": "5c4d0e65-249c-3983-a607-8dca4a381b10",
                        "entry_id": "1249b791-f4b1-317d-a9af-e331241198a9",
                        "glosses": [
                            "als Unterlage dienendes Tuch aus Gummi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "381825ab-b115-4239-bf42-a72fab8d0ffa",
                                "sense_id": "5c4d0e65-249c-3983-a607-8dca4a381b10",
                                "text": "Das Bettlaken ist elastisch wie ein Gummituch."
                            },
                            {
                                "example_id": "59984ce4-3434-403f-9064-a2494cff288b",
                                "sense_id": "5c4d0e65-249c-3983-a607-8dca4a381b10",
                                "text": "„Klassifizieren heißt nicht, alle möglichen Ornamente aufzuzählen, sondern sie in Gruppen von äquivalenten Mustern einzuteilen. Stellen wir uns vor, ein Muster werde auf ein Gummituch gezeichnet. Dann sind alle anderen Muster zu diesem äquivalent, die sich (theoretisch) durch Ziehen und Stauchen des Gummis aus dem ersten Muster erzeugen lassen und zudem noch dieselben Symmetrien besitzen.“"
                            },
                            {
                                "example_id": "18777d0d-c686-460f-bb02-831a9fd0e34a",
                                "sense_id": "5c4d0e65-249c-3983-a607-8dca4a381b10",
                                "text": "„Massen verändern die Krümmung der Raumzeit, so ähnlich wie eine Kugel ein Gummituch verformt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
