                ],
                "senses": [
                    {
                        "sense_id": "2d286c32-be0e-357d-ae3f-c4bce033114a",
                        "entry_id": "cc176d07-b559-3008-84ae-681384445c8f",
                        "glosses": [
                            "Herausforderung im Bereich des Laufens, meist mit dem Ziel, die Läufer zu motivieren, sich (intensiver) sportlich zu engagieren oder ihre Leistungen zu verbessern"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8f1b38ab-bcfc-4cae-9db3-a953733f202e",
                                "sense_id": "2d286c32-be0e-357d-ae3f-c4bce033114a",
                                "text": "„Der Start zu Deiner neuen Laufherausforderung ist eine gute Gelegenheit, um Deine Laufausrüstung zu überprüfen und sicherzustellen, dass alles optimal passt.“"
                            },
                            {
                                "example_id": "c6ac030c-1984-4f98-883e-fd873d017337",
                                "sense_id": "2d286c32-be0e-357d-ae3f-c4bce033114a",
                                "text": "„An etlichen Marathons nahm er schon teil und bewältige ebenso spezielle Laufherausforderungen in der Szene.“"
                            },
                            {
                                "example_id": "6bda1710-10b9-4145-98ff-0c7c6e734c19",
                                "sense_id": "2d286c32-be0e-357d-ae3f-c4bce033114a",
                                "text": "„Das muss natürlich – genauso wie die Teilnehmerinnen und Teilnehmer, die sich aktiv der Laufherausforderung stellen – gebührend gefeiert werden!“"
                            },
                            {
                                "example_id": "d5639bdd-4da5-41f1-864a-f5504ba160a9",
                                "sense_id": "2d286c32-be0e-357d-ae3f-c4bce033114a",
                                "text": "„So werden nach jedem Lauf die besonderen Leistungen der Teamläufer ausgezeichnet: die der Besten im Team sowie auch die der Neulinge, die sich zum ersten Mal der sportlichen Laufherausforderung gestellt haben.“"
                            },
                            {
                                "example_id": "5339ee86-f607-4052-b184-441e7d76f3d9",
                                "sense_id": "2d286c32-be0e-357d-ae3f-c4bce033114a",
                                "text": "„Also, eigentlich war die Post natürlich für die Mama Moni, die ja momentan bei einer Laufherausforderung mitmacht, die Planeten-Challenge heißt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
