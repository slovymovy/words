                                "target_senses": [
                                    {
                                        "sense_id": "5b14d1d9-c529-34f3-b9d3-e89dae0e271e",
                                        "entry_id": "264067da-8da8-3492-9d30-d5735969c7a9",
                                        "glosses": [
                                            "Petit animal vermiforme au corps cylindrique, non segmenté, au proboscis rétractable portant des épines courbées en arrière, endoparasite d’arthropodes à l’état juvénile, et d’intestins de vertébrés, à l’état adulte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b3031f-7583-413c-af9d-6d23436f1934",
                                                "sense_id": "5b14d1d9-c529-34f3-b9d3-e89dae0e271e",
                                                "text": "Les acanthocéphales mesurent quelques millimètres, néanmoins une espèce, Macracanthorhynchus hirudinaceus, parasite du cochon, atteint près d’un mètre."
                                            },
                                            {
                                                "example_id": "32b0b45d-d9b5-4651-b1fe-38c5969be4da",
                                                "sense_id": "5b14d1d9-c529-34f3-b9d3-e89dae0e271e",
                                                "text": "Une seule espèce de vers à trompe épineuse (acanthocéphales ou macracanthocéphales) présente un intérêt vétérinaire : Macracanthorhynchus hirudinaceus, un parasite de l’intestin grêle du porc. L’espèce est de grande taille, puisque les femelles atteignent 65 cm de longueur."
                                            }
                                        ]
