                "translations": [
                    {
                        "translation_id": "d47e240e-813c-43cf-8cc5-28929dd3b196",
                        "source_entry_id": "24570592-3dec-354b-adc3-bd4f5aae9691",
                        "source_sense_id": "d92d8af4-86d0-3ad6-a117-33b66e2a4f2f",
                        "target_lang_word": "telegraphist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telegraphist",
