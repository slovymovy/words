                "senses": [
                    {
                        "sense_id": "9cc865a3-04b3-3290-b6ff-1da510c4a9ec",
                        "entry_id": "7b4e67e4-c121-34c4-b623-b355e47780c0",
                        "glosses": [
                            "Rivière du nord-est du Botswana."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a1275e-2ec7-4cbe-93c0-faeee5fb671f",
                                "sense_id": "9cc865a3-04b3-3290-b6ff-1da510c4a9ec",
                                "text": "Pour ne citer qu’un exemple, les San vivant aujourd’hui au bord des rivières Boteti (au sud du delta de l’Okavango) et Nata (au nord-est du Botswana) gardent des troupeaux, fabriquent des poteries et cultivent la terre."
                            }
                        ]
                    },
                    {
