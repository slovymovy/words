                        "entry_id": "88d2b647-92b7-374e-a7e2-6b9f122354a4",
                        "glosses": [
                            "geleidelijke verwijdering van het binnenste deel, zodat er een lege buitenkant overblijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c28a22-d007-4f9e-9ffd-9b8e46e18eb0",
                                "sense_id": "0061e2a6-9426-334d-80ca-b0469535935f",
                                "text": "De vaartuigjes, korjalen, worden vervaardigd door uitholling van daarvoor geschikte boomstammen; (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "ffba58eb-5a31-3c81-9c02-2a476403f1ce",
                        "entry_id": "88d2b647-92b7-374e-a7e2-6b9f122354a4",
                        "glosses": [
                            "vervaardiging van een holte in een oppervlak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c563d7-1cd6-4c3e-b0e1-a4e5889d0a93",
                                "sense_id": "ffba58eb-5a31-3c81-9c02-2a476403f1ce",
                                "text": "De ruimte voor de slinger is in dit geval gevonden door uitholling respectievelijk verdikking van de achterplank."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b613ac2-7dd8-3025-98f0-32227c0e854e",
                        "entry_id": "88d2b647-92b7-374e-a7e2-6b9f122354a4",
                        "glosses": [
                            "gemaakte uitsparing, ontstane holte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be425729-f45b-4c05-81dc-ece36466a4fa",
                                "sense_id": "9b613ac2-7dd8-3025-98f0-32227c0e854e",
                                "text": "De hooistapel kwam dan tot vlak voor de voergoot van de stal, zonder dat daarin een voergang werd uitgespaard. Die ruimte liet men de koeien gedurende de eerste staldagen zelf leegeten. Ze werden dan niet gevoederd, alleen gedrenkt en aten zich door de eerste laag hooi heen, zover als ze erbij konden. Vervolgens werd deze uitholling door de boer verder vergroot tot een gang was ontstaan tussen koeien en hooi."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2b0cb0f-45b3-3d66-b28f-9aeb1ca46f3d",
                        "entry_id": "88d2b647-92b7-374e-a7e2-6b9f122354a4",
                        "glosses": [
                            "verlies van wezenlijke eigenschappen terwijl de uiterlijke vorm behouden blijft"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "62eab893-c647-4934-952b-950083f25ade",
                                "sense_id": "f2b0cb0f-45b3-3d66-b28f-9aeb1ca46f3d",
                                "text": "Het kabinet moet bodemtarieven invoeren voor zzp'ers om uitholling van het sociale stelsel te voorkomen."
                            }
                        ]
                    }
