        "fr-extract.jsonl": [
            {
                "entry_id": "349b2a6d-d2bd-3c4b-9888-7b145461a4b7",
                "word": "olisbos",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71824a20-0836-3d76-965c-87fb928f3334",
                        "entry_id": "349b2a6d-d2bd-3c4b-9888-7b145461a4b7",
                        "glosses": [
                            "Phallus artificiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711086c7-1b9d-4374-8623-6d45b89fe250",
                                "sense_id": "71824a20-0836-3d76-965c-87fb928f3334",
                                "text": "Notons qu’à cette même période, les Japonais voyageant confirmaient le haut degré de leur civilisation en préférant confier un olisbos aux épouses esseulées."
                            },
                            {
                                "example_id": "bdff6843-e31b-4157-bb1a-bfb4ef889ba5",
                                "sense_id": "71824a20-0836-3d76-965c-87fb928f3334",
                                "text": "Quelques jouets sont à l’abandon, un cerceau de bois peint un olisbos rouge et bleu un ballon blanc un fusil de plomb"
                            },
                            {
                                "example_id": "40878f00-98e2-43b3-8344-0cf8985af4b9",
                                "sense_id": "71824a20-0836-3d76-965c-87fb928f3334",
                                "text": "On vend de tout sur les marchés d’Asie, des produits d’entretien, des cotonnades, des chaussettes, des jouets, des cassettes vidéo, des épices étranges et toutes les denrées possibles et imaginables. On y vend même des olisbos sagement rangés debout sur l’éventaire, comme un couvent de petits moines. C’est bien curieux à voir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2096a25d-75ed-408b-b7fc-6d940f5ad398",
                        "source_entry_id": "349b2a6d-d2bd-3c4b-9888-7b145461a4b7",
                        "source_sense_id": "71824a20-0836-3d76-965c-87fb928f3334",
                        "target_lang_word": "olisbos",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olisbos",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5bb239b-bef9-33a9-8306-b6cdad3db718",
                                        "entry_id": "c5cc2d50-05ca-3cbd-b168-7bd2fac5d2d3",
                                        "glosses": [
                                            "A dildo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599abea6-10f8-453d-9405-cb9980c90c99",
                                                "sense_id": "e5bb239b-bef9-33a9-8306-b6cdad3db718",
                                                "text": "I had blazed in her face an olisbos-like flashlight."
                                            },
                                            {
                                                "example_id": "e042cd05-7c33-428b-990a-511f533aee1b",
                                                "sense_id": "e5bb239b-bef9-33a9-8306-b6cdad3db718",
                                                "text": "At quiet hour in the afternoon they were adepts of the olisbos, baubon, and finger."
                                            },
                                            {
                                                "example_id": "b26706d6-4a98-4cdb-bc6d-66cf67a2896d",
                                                "sense_id": "e5bb239b-bef9-33a9-8306-b6cdad3db718",
                                                "text": "A bowl of Pamphaeus in the British Museum shows a naked hetaira who has two olisboi in her hand; apparently there is a similar representation on a bowl of Euphronius."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
