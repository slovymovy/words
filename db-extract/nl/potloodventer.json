                "senses": [
                    {
                        "sense_id": "eb10198b-84b9-3291-a8f9-97be1b70bc8f",
                        "entry_id": "3c7c8905-14f9-3703-9580-12724fbffd56",
                        "glosses": [
                            "a male flasher, an exhibitionist who suddenly exposes his phallus"
                        ],
                        "tags": [
                            "humorous",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "32b3bcd1-4811-42e7-9834-8ca483af4b90",
                                "sense_id": "eb10198b-84b9-3291-a8f9-97be1b70bc8f",
                                "text": "1976 August 5, \"Knipsel. Potloodventer\", Het vrije volk, vol. 32, mp. 8868, page 3.\nDe Hermandad wist de potloodventer, zoals een exhibitionist bij de politie genoemd wordt, spoedig te achterhalen.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "945b9826-c9c1-42f1-a14f-2bc1cf8f0851",
                                "sense_id": "eb10198b-84b9-3291-a8f9-97be1b70bc8f",
                                "text": "Wie aan een potloodventer denkt, ziet misschien gelijk een man in een lange regenjas voor zich."
                            },
                            {
                                "example_id": "80579d97-73ff-416d-8f9e-dc2954856434",
                                "sense_id": "eb10198b-84b9-3291-a8f9-97be1b70bc8f",
                                "text": "Eerst dachten we dat de man in de lange zwarte regenjas iemand uit de Matrix nabootste, maar hij maakte nonverbaal duidelijk dat hij een potloodventer was.",
                                "translation": "At first we thought that the man in the long black raincoat imitated a character from the Matrix, but he made it clear in a nonverbal manner that he was a flasher.",
                                "english": "At first we thought that the man in the long black raincoat imitated a character from the Matrix, but he made it clear in a nonverbal manner that he was a flasher."
                            }
                        ]
                    },
                    {
                        "sense_id": "992701d1-32e0-3026-a90c-848c158c5e1f",
                        "entry_id": "3c7c8905-14f9-3703-9580-12724fbffd56",
                        "glosses": [
                            "a pencil vendor"
                        ],
                        "tags": [
                            "dated",
                            "humorous",
                            "literally",
                            "masculine",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "412976e6-f140-4038-b43b-44e5633e9b7c",
                                "sense_id": "992701d1-32e0-3026-a90c-848c158c5e1f",
                                "text": "Onder de slachtoffers van de laatste warme dagen te Parijs bevindt zich ook de potloodventer Libeau, die bij het Palais Royal, tengevolge van een zonnesteek in elkaar zakte en naar het ziekenhuis moest gebracht worden, waar hij reeds overleden aankwam."
                            },
                            {
                                "example_id": "8b268170-f2c7-47de-abc9-984b1672ac83",
                                "sense_id": "992701d1-32e0-3026-a90c-848c158c5e1f",
                                "text": "Zoo gebeurde het te Adorp, in de buurt van Groningen, dat de veldwachter Haarlemsche Frans in een potloodventer meende te herkennen."
                            },
                            {
                                "example_id": "b76643b1-a006-4577-9d99-1b7419346c54",
                                "sense_id": "992701d1-32e0-3026-a90c-848c158c5e1f",
                                "text": "Voederbakjes voor de vogels, aan een boom opgehangen, voetenbankjes of parapluies zijn voor de heeren potloodventers of wie er verder dorpsrust komen verstoren, aangename en welkome voorwerpen van gezelschap."
                            },
                            {
                                "example_id": "83ee4b0c-6b77-4fd7-b542-95b0147b396c",
                                "sense_id": "992701d1-32e0-3026-a90c-848c158c5e1f",
                                "text": "1977 August 23, Wanny Vleeming, quoted in Joop Udo, \"Wanny rukt uit na melding op politieradio. „Meerijden” met patrouillewagens soort tijdverdrijf\", De Telegraaf, page 5.\nIk had twee echte potloden in de hand en probeerde die uit te venten. Letterlijk een potloodventer.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
