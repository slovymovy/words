                                        "entry_id": "c88ecf6e-0d2a-373a-b08f-85d6a7d83d25",
                                        "glosses": [
                                            "Levier spécial destiné à enlever un pneu de la jante d’un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a8550f5-247d-4d1e-b12f-0234cb390a48",
                                                "sense_id": "cd65d3c6-df53-376b-b193-ef0a58ddcafc",
                                                "text": "Ils emportaient aussi dans une sacoche fixée au cadre tout un attirail de réparation : clefs anglaises, pinces, démonte-pneus, chatterton, colle, rustines, petite râpe…"
                                            },
                                            {
                                                "example_id": "2793f71e-e618-4539-9516-5d9b9294302b",
                                                "sense_id": "cd65d3c6-df53-376b-b193-ef0a58ddcafc",
                                                "text": "Si elle avait manifesté son désaccord au rongeur, le garagiste et son démonte-pneu n’auraient fait d’elle qu’une bouchée."
                                            },
                                            {
                                                "example_id": "22b3253c-4276-4f34-af13-34901ef9f2fd",
                                                "sense_id": "cd65d3c6-df53-376b-b193-ef0a58ddcafc",
                                                "text": "Il dut s’y reprendre à trois fois, s’aider d’un fusil démonte-pneu comme levier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
