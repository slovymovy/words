        "fr-extract.jsonl": [
            {
                "entry_id": "53db8f84-6b35-3d42-802a-0a799a31db4b",
                "word": "багроветь",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ece1ac3-2dbf-3d1b-b222-a7db0a323464",
                        "entry_id": "53db8f84-6b35-3d42-802a-0a799a31db4b",
                        "glosses": [
                            "Rougeoyer, devenir tout rouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "699ad171-683e-4857-9b38-8f0291263d63",
                                "sense_id": "5ece1ac3-2dbf-3d1b-b222-a7db0a323464",
                                "text": "Смотри, как багровеет лес. : Regarde comme la forêt rougeoie."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2a31e3c-6cbb-3e8b-88e2-0a96ef420881",
                        "entry_id": "53db8f84-6b35-3d42-802a-0a799a31db4b",
                        "glosses": [
                            "Rougir, s’empourprer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0faa0ad9-945d-4cea-8f38-92e4b4efa420",
                                "sense_id": "e2a31e3c-6cbb-3e8b-88e2-0a96ef420881",
                                "text": "Небо постепенно багровело. : Le ciel rougissait petit à petit."
                            }
                        ]
                    },
