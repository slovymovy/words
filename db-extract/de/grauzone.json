                    {
                        "form_id": "923134b4-9665-4b71-87b3-ad6d7c06d5df",
                        "entry_id": "9cb802c6-ba92-328e-a00e-7c452800b1ab",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Grauzonen"
