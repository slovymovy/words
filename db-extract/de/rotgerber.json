                "senses": [
                    {
                        "sense_id": "157ff1e0-8e56-365b-b5fe-e8d0c0f185ba",
                        "entry_id": "452a9fe7-1d42-319e-a322-9597c26656c6",
                        "glosses": [
                            "Handwerker, der mittels fein gemahlener Eichenrinde Tierhäute zu Leder verarbeitete"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1e97c56-f9c7-4108-b1e4-19a7a05189cb",
                                "sense_id": "157ff1e0-8e56-365b-b5fe-e8d0c0f185ba",
                                "text": "„So siedelten sich Schmiede, Lederer und Rotgerber in dem Gebiet der heutigen Lederergasse und der Löwengrube an.“"
                            },
                            {
                                "example_id": "ec7a8fdd-bd32-4ab2-91d6-2e3289074262",
                                "sense_id": "157ff1e0-8e56-365b-b5fe-e8d0c0f185ba",
                                "text": "„Da nimmt es nicht wunder, dass die Rotgerber zu den reichsten Handwerkern gehörten.“"
                            },
                            {
                                "example_id": "4f6cf160-56fd-4d68-9707-bba109e155d0",
                                "sense_id": "157ff1e0-8e56-365b-b5fe-e8d0c0f185ba",
                                "text": "„Hier arbeiteten und lebten über fünfhundert Jahre lang die Rotgerber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
