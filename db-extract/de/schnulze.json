                        "examples": [
                            {
                                "example_id": "49c19844-2a47-411f-95f3-64377c4a09fa",
                                "sense_id": "c16062ec-6a05-3a9f-83b2-d8c929826f60",
                                "text": "Als Zugabe spielte die Band die Schnulze „Dying In Your Arms“."
