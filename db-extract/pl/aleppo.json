            {
                "entry_id": "678fbca9-a648-3e52-a2c0-2f07fc89e364",
                "word": "Aleppo",
                "pos": "name",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5dd089df-be02-3783-bb1f-b0a8b63e1219",
                        "entry_id": "678fbca9-a648-3e52-a2c0-2f07fc89e364",
                        "glosses": [
                            "największe miasto Syrii, położone w północno-zachodniej części kraju, około 50 km na południe od granicy z Turcją, w połowie drogi między Eufratem a wybrzeżem Morza Śródziemnego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "557e418a-0452-41ff-923f-c16971d84890",
                                "sense_id": "5dd089df-be02-3783-bb1f-b0a8b63e1219",
                                "text": "W odpowiedzi na te działania terroryści zrzucają pociski na Aleppo, Hamę oraz inne miasta"
                            },
                            {
                                "example_id": "09d84b71-0d94-488e-b425-948fa55f93fe",
                                "sense_id": "5dd089df-be02-3783-bb1f-b0a8b63e1219",
                                "text": "W Aleppo rusza chrześcijańsko-muzułmański program pomocy dla „dzieci-duchów”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b504dab5-3caa-37ac-9748-a97bab6701af",
                        "entry_id": "678fbca9-a648-3e52-a2c0-2f07fc89e364",
                        "glosses": [
                            "muhafaza ze stolicą w Aleppo (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
