                                "example_id": "8d0a4cfc-91da-4b18-916b-22cf9ad59b92",
                                "sense_id": "b481c9b5-29d2-3518-aff9-d06f6bafc34c",
                                "text": "'Kunnen we niet nog een laatste drankje nemen en eerst wat praten?' vroeg ze en ze spreidde vertwijfeld haar armen."
                            }
                        ]
