                                            {
                                                "example_id": "b0fdff1f-c74b-46ae-a1ef-10e78e6b5d84",
                                                "sense_id": "2164846e-d1dd-377c-8595-f97cfa518050",
                                                "text": "Ты знаешь мою несчастную способность преувеличенно трагически смотреть на подобные казусы."
                                            },
                                            {
                                                "example_id": "84060145-f22a-45f2-9ee5-bd92ef7af31a",
                                                "sense_id": "2164846e-d1dd-377c-8595-f97cfa518050",
                                                "text": "Дома она ходила в просторной блузе или в кофточке с преувеличенно пышными складками на груди, а уходя куда-нибудь, затягивалась в корсет так сильно, что два раза во время прогулок с ней случались обмороки."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "преувеличенно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ed4b42d2-65f5-3bd7-ab21-5242a19e37c5",
