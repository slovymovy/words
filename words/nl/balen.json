{
    "word_family": [
        "baal",
        "baaldag"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c95b304-5c1b-3ddf-98a0-a178b20a3611",
                    "sense_definition": "Zich ergeren of teleurgesteld zijn omdat een situatie tegenzit of niet leuk is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_negative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>baal</w> ervan dat het regent op mijn vrije dag.",
                            "target_lang_translations": {
                                "en": "I <w>am bummed</w> that it's raining on my day off.",
                                "ru": "Я <w>расстроен</w> тем, что в мой выходной идет дождь.",
                                "de": "Ich <w>ärgere mich</w> darüber, dass es an meinem freien Tag regnet."
                            }
                        },
                        {
                            "text": "Hij <w>baalde</w> enorm toen hij hoorde dat hij de trein had gemist.",
                            "target_lang_translations": {
                                "en": "He was really <w>bummed</w> when he heard that he had missed the train.",
                                "ru": "Он ужасно <w>расстроился</w>, когда услышал, что опоздал на поезд.",
                                "de": "Er <w>hat sich riesig geärgert</w>, als er hörte, dass er den Zug verpasst hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich ergeren",
                        "teleurgesteld zijn"
                    ],
                    "antonyms": [
                        "genieten",
                        "zich verheugen"
                    ],
                    "common_phrases": [
                        "ergens van balen",
                        "flink balen",
                        "zitten te balen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be annoyed or disappointed because a situation is adverse or unpleasant.",
                        "ru": "Раздражаться или быть разочарованным из-за того, что ситуация складывается неудачно или неприятно.",
                        "de": "Sich ärgern oder enttäuscht sein, weil eine Situation ungünstig oder unangenehm ist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be bummed",
                                "target_lang_sense_clarification": "informal, to feel disappointed"
                            },
                            {
                                "target_lang_word": "be fed up",
                                "target_lang_sense_clarification": "to be annoyed or tired of something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "расстраиваться",
                                "target_lang_sense_clarification": "быть огорченным чем-либо"
                            },
                            {
                                "target_lang_word": "досадовать",
                                "target_lang_sense_clarification": "испытывать раздражение из-за неудачи"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich ärgern",
                                "target_lang_sense_clarification": "sich über etwas aufregen oder unzufrieden sein"
                            },
                            {
                                "target_lang_word": "enttäuscht sein",
                                "target_lang_sense_clarification": "ein Gefühl der Enttäuschung empfinden"
                            },
                            {
                                "target_lang_word": "sich aufregen",
                                "target_lang_sense_clarification": "umgangssprachlich für sich über eine Situation ärgern"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fd1e1c8f-ee9b-3c2e-8b5b-45dd31c2bb3c",
                    "sense_definition": "Uitroep om aan te geven dat men iets heel vervelend of jammer vindt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exclamation_disappointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat <w>balen</w> dat je niet naar het feest kunt komen!",
                            "target_lang_translations": {
                                "en": "What a <w>bummer</w> that you can't come to the party!",
                                "ru": "Как <w>жаль</w>, что ты не сможешь прийти на вечеринку!",
                                "de": "<w>Wie ärgerlich</w>, dass du nicht zur Party kommen kannst!"
                            }
                        },
                        {
                            "text": "De wedstrijd is afgelast door het slechte weer, echt <w>balen</w>.",
                            "target_lang_translations": {
                                "en": "The match has been cancelled due to bad weather, [it] really <w>sucks</w>.",
                                "ru": "Матч отменили из-за плохой погоды, полный <w>облом</w>.",
                                "de": "Das Spiel wurde wegen des schlechten Wetters abgesagt, echt <w>Mist</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jammer",
                        "helaas",
                        "verdorie"
                    ],
                    "common_phrases": [
                        "wat balen",
                        "echt balen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Exclamation to indicate that one finds something very annoying or unfortunate.",
                        "ru": "Восклицание, выражающее сильную досаду, разочарование или сожаление.",
                        "de": "Ausruf, um auszudrücken, dass man etwas sehr ärgerlich oder schade findet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bummer",
                                "target_lang_sense_clarification": "disappointing situation"
                            },
                            {
                                "target_lang_word": "sucks",
                                "target_lang_sense_clarification": "informal, very annoying"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "облом",
                                "target_lang_sense_clarification": "разговорное выражение неудачи или разочарования"
                            },
                            {
                                "target_lang_word": "досада",
                                "target_lang_sense_clarification": "чувство неудовольствия"
                            },
                            {
                                "target_lang_word": "жаль",
                                "target_lang_sense_clarification": "выражение сожаления"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wie ärgerlich",
                                "target_lang_sense_clarification": "Ausdruck von Missfallen über eine Situation"
                            },
                            {
                                "target_lang_word": "echt schade",
                                "target_lang_sense_clarification": "Ausdruck von Bedauern"
                            },
                            {
                                "target_lang_word": "Mist",
                                "target_lang_sense_clarification": "umgangssprachlicher Ausruf bei Ärger oder Misserfolg"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "644b035c-a073-3cfb-a4b7-217a30c620a5",
                    "sense_definition": "Meervoud van <w>baal</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer stapelde de zware <w>balen</w> hooi op in de schuur.",
                            "target_lang_translations": {
                                "en": "The farmer stacked the heavy <w>bales</w> of hay in the barn.",
                                "ru": "Фермер складывал тяжелые <w>тюки</w> сена в сарае.",
                                "de": "Der Bauer stapelte die schweren <w>Ballen</w> Heu in der Scheune."
                            }
                        },
                        {
                            "text": "In de haven werden grote <w>balen</w> katoen van het schip geladen.",
                            "target_lang_translations": {
                                "en": "In the port, large <w>bales</w> of cotton were unloaded from the ship.",
                                "ru": "В порту с корабля выгружали большие <w>кипы</w> хлопка.",
                                "de": "Im Hafen wurden große <w>Ballen</w> Baumwolle vom Schiff geladen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "balen hooi",
                        "balen stro"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'baal' (bale).",
                        "ru": "Множественное число от слова 'baal' (тюк, кипа).",
                        "de": "Plural von 'Baal' (Ballen)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bales",
                                "target_lang_sense_clarification": "bundles of material"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тюки",
                                "target_lang_sense_clarification": "упакованные связки сена, соломы и т.п."
                            },
                            {
                                "target_lang_word": "кипы",
                                "target_lang_sense_clarification": "большие связки хлопка, бумаги или ткани"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ballen",
                                "target_lang_sense_clarification": "fest zusammengepresste Bündel von Waren wie Heu oder Stoff"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}