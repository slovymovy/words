                "senses": [
                    {
                        "sense_id": "f9cd88d1-0c82-3f62-9711-f68c8ab5e737",
                        "entry_id": "e96322fd-f93c-3b81-b310-9ceb0cd9e3c5",
                        "glosses": [
                            "To reanimate, bring back to life."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e7c427d6-e703-43ca-bcbd-c1d4700ce043",
                                "sense_id": "f9cd88d1-0c82-3f62-9711-f68c8ab5e737",
                                "text": "His pure tight skin was an excellent fit; and closely wrapped up in it, and embalmed with inner health and strength, like a revivified Egyptian, this Starbuck seemed prepared to endure for long ages to come, and to endure always, as now; […]"
                            },
                            {
                                "example_id": "eb5b77a9-306d-47f7-8fe3-d35fc294c55a",
                                "sense_id": "f9cd88d1-0c82-3f62-9711-f68c8ab5e737",
                                "text": "In cautiously revivifying dead queens—and Time's appearance suggests that this recuperation is dependent on the hiatus—the play opens up a space, if an uncertain space, within which to begin a critique of current gender politics."
                            }
                        ]
                    },
                    {
                        "sense_id": "751bf548-6d0d-3688-a268-245556895f6d",
                        "entry_id": "e96322fd-f93c-3b81-b310-9ceb0cd9e3c5",
                        "glosses": [
                            "To reinvigorate or revitalize."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "43d83729-b997-4da5-a272-2b43062c5f8e",
                                "sense_id": "751bf548-6d0d-3688-a268-245556895f6d",
                                "text": "Near-synonym: rejuvenate"
                            },
                            {
                                "example_id": "7fc550c9-7f45-449d-a62a-b4aa70472362",
                                "sense_id": "751bf548-6d0d-3688-a268-245556895f6d",
                                "text": "Despite the patrician allure of much that Choiseul attempted, a renovating, technocratic spirit was abroad during his tenure of office which sought to rationalize and revivify government service [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "2022fcc2-72d5-3727-93fd-54cdfbf0f4c8",
                        "entry_id": "e96322fd-f93c-3b81-b310-9ceb0cd9e3c5",
                        "glosses": [
                            "To reactivate (a catalyst, reagent etc.)."
