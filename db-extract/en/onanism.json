                        ],
                        "examples": [
                            {
                                "example_id": "9212b4d9-f428-48e1-91d1-51b03554cb8c",
                                "sense_id": "95e1a6ee-d393-3aef-834e-e20ecf7c79f4",
                                "text": "Hypochondriasis, hysteria, chorea, epilepsy, apoplexy, and palsy, constitute part of the list of dire maladies induced or immediately excited, by onanism and immoderate or ill-timed coition. The memory and intellectual faculties, in general, are enfeebled, and there are instances of complete idiocy, brought on by early and continued onanism, and of insanity from similar excesses later in life."
                            },
                            {
                                "example_id": "0a6ebd3c-9229-4028-bee9-d40b6d2c60cf",
                                "sense_id": "95e1a6ee-d393-3aef-834e-e20ecf7c79f4",
                                "text": "This photograph was far superior. A nude woman was sitting on the edge of a desk next to a globe of the world. The suggested onanism with the piece of chalk intrigued Ignatius."
                            }
                        ]
                    },
                    {
                        "sense_id": "0dc7545a-3340-3fd7-8fcd-0f87607d827f",
