                ],
                "senses": [
                    {
                        "sense_id": "8c5f070b-471b-3d47-80e4-d16f362ff7b2",
                        "entry_id": "3841f23c-dc91-3a69-8901-19e4a16b79cd",
                        "glosses": [
                            "состояние по значению прил. заброшенный"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c805963-ad17-4c58-a5dd-c19dd4a7ab4d",
                        "source_entry_id": "3841f23c-dc91-3a69-8901-19e4a16b79cd",
                        "source_sense_id": "8c5f070b-471b-3d47-80e4-d16f362ff7b2",
                        "target_lang_word": "abandon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abandon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "320f6343-2621-3f8d-8325-6a1661ceae6d",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "État d’une personne, d’une chose abandonnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5e7a200-93ae-4d97-afee-5ac251024549",
                                                "sense_id": "320f6343-2621-3f8d-8325-6a1661ceae6d",
                                                "text": "Ce vieillard est dans le plus affreux abandon."
                                            },
                                            {
                                                "example_id": "38b238a2-5ed1-460a-9883-15f5e03e6046",
                                                "sense_id": "320f6343-2621-3f8d-8325-6a1661ceae6d",
                                                "text": "Il mourut dans l’abandon."
                                            },
                                            {
                                                "example_id": "5536ee7f-5ad7-4ab6-a8ab-01e6f4fa96db",
                                                "sense_id": "320f6343-2621-3f8d-8325-6a1661ceae6d",
                                                "text": "Il laisse sa maison dans un abandon, dans un état d’abandon qui en augmente tous les jours la dégradation."
                                            },
                                            {
                                                "example_id": "87b911d1-6745-45c9-a871-700e387e6fc4",
                                                "sense_id": "320f6343-2621-3f8d-8325-6a1661ceae6d",
                                                "text": "L’abandon de ses amis l’a consterné."
                                            },
                                            {
                                                "example_id": "a2fb1957-329d-49ef-aaec-ff230a227194",
                                                "sense_id": "320f6343-2621-3f8d-8325-6a1661ceae6d",
                                                "text": "C’est ton propre corps, toi, qui a lâché. Ton si beau corps. Confié maintenant aux accueils ultimes de la terre. Et par delà l’épouvante de mes chairs, et de l’amour, il me semble parfois que cette noce te convient, cet abandon, ce silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35726f08-fdce-306f-9b66-86cf9bf23d37",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Action d’abandonner, de délaisser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc617d7-fe10-43a7-8bf1-6ccbb488636f",
                                                "sense_id": "35726f08-fdce-306f-9b66-86cf9bf23d37",
                                                "text": "L’abandon de ses amis l’a consterné."
                                            },
                                            {
                                                "example_id": "19e7a361-a84d-41f2-bc50-c8c34430eeec",
                                                "sense_id": "35726f08-fdce-306f-9b66-86cf9bf23d37",
                                                "text": "Presque partout dans le département, l'abandon des campagnes a causé un recul de l'olivier et parfois même de la vigne, submergés par la croissance spontanée des pins."
                                            },
                                            {
                                                "example_id": "5551a1f3-0024-47dd-88dc-5becf08db599",
                                                "sense_id": "35726f08-fdce-306f-9b66-86cf9bf23d37",
                                                "text": "De nombreux abandons d’animaux de compagnie ont lieu chaque année."
                                            },
                                            {
                                                "example_id": "29dbc731-549f-4981-b1e3-2ec959593396",
                                                "sense_id": "35726f08-fdce-306f-9b66-86cf9bf23d37",
                                                "text": "Son absence et l’abandon de sa maison, de sa terre, ont achevé de le ruiner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5b616f8-1dcd-356c-9e67-bf6b63436446",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Acte de renoncer à une qualité, un emploi ou un poste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa23d86-6ef0-41d9-8f38-6ec3b073dbdc",
                                                "sense_id": "e5b616f8-1dcd-356c-9e67-bf6b63436446",
                                                "text": "Un abandon de poste permet à un employeur de mettre fin à un contrat de travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd0c91c3-17e7-3ed1-846d-9bc6725d3bec",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Fait de renoncer à une cause, une croyance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c073175b-b4a2-47a9-948e-01e2fe4761ef",
                                                "sense_id": "fd0c91c3-17e7-3ed1-846d-9bc6725d3bec",
                                                "text": "L'abandon de la foi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22250d8b-c015-33fe-9d00-19888c8665ff",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Fait de renoncer à un parti, un engagement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af7eb6c-ee53-4779-9e6b-de36e77dce98",
                                                "sense_id": "22250d8b-c015-33fe-9d00-19888c8665ff",
                                                "text": "La crise d’un parti politique s’est traduite par une série d'abandons des militants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a76c631-b71b-30ff-8e6a-74d42693d64b",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Renonciation à la possession, à la jouissance d’une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e4f9e7c-c821-427f-8329-650d4f574425",
                                                "sense_id": "4a76c631-b71b-30ff-8e6a-74d42693d64b",
                                                "text": "Il a fait sans hésiter l’abandon de sa fortune et même de sa vie."
                                            },
                                            {
                                                "example_id": "a373a311-0742-49f9-82f6-3d43d31a9ca6",
                                                "sense_id": "4a76c631-b71b-30ff-8e6a-74d42693d64b",
                                                "text": "Il consent à l’abandon de ses droits."
                                            },
                                            {
                                                "example_id": "9dade007-af66-4053-8f22-bb73e112e251",
                                                "sense_id": "4a76c631-b71b-30ff-8e6a-74d42693d64b",
                                                "text": "Le chrétien vit dans un parfait abandon à la Providence, à la volonté de Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9316d56a-06cd-3f1f-b734-527874893f20",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Fait de renoncer à une candidature dans une élection ou un concours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "838cea4f-fa17-4e89-ac67-a9db1f505837",
                                                "sense_id": "9316d56a-06cd-3f1f-b734-527874893f20",
                                                "text": "Les élections ont été marquées par l'abandon d’un des candidats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8887963-dfee-3b33-b9de-b872f2cdc793",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Don, renonciation à un droit, abandon de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df55beb-84c2-4f9e-96d5-bf811866619b",
                                                "sense_id": "a8887963-dfee-3b33-b9de-b872f2cdc793",
                                                "text": "Il a souhaité l'abandon de ses biens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68bb11e2-a0f9-346a-bcbf-dd469a21261e",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Acte par lequel un débiteur abandonne tous ses biens à ses créanciers, pour se mettre à l’abri de leurs poursuites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cc104c7-7bc6-42d0-b6a0-3463aac9ffaf",
                                                "sense_id": "68bb11e2-a0f9-346a-bcbf-dd469a21261e",
                                                "text": "Il a fait abandon de biens."
                                            },
                                            {
                                                "example_id": "7b94d54b-7662-41ed-9ef5-5df0953bf64d",
                                                "sense_id": "68bb11e2-a0f9-346a-bcbf-dd469a21261e",
                                                "text": "Commissaire à l’abandon de biens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5229ecd-feee-3db0-80a6-0185ecde974b",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Sans contrainte. En toute confiance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6fb8758-5727-40cb-991a-5c8f414d77ff",
                                                "sense_id": "c5229ecd-feee-3db0-80a6-0185ecde974b",
                                                "text": "Elle et sa meilleure amie se sont parlé avec abandon."
                                            },
                                            {
                                                "example_id": "04315817-db55-4315-9e0e-374b37969047",
                                                "sense_id": "c5229ecd-feee-3db0-80a6-0185ecde974b",
                                                "text": "Il m’a parlé avec abandon, avec un entier abandon."
                                            },
                                            {
                                                "example_id": "ef71328a-dc6f-48ea-82b0-92d3609e0812",
                                                "sense_id": "c5229ecd-feee-3db0-80a6-0185ecde974b",
                                                "text": "Il m’a touché par l’abandon qu’il a mis dans ses discours, dans ses confidences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca73a64-411a-34d9-8295-0d4325dc1148",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Confidence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e49dd52a-4515-42d4-9ffc-fa530f82e33e",
                                                "sense_id": "3ca73a64-411a-34d9-8295-0d4325dc1148",
                                                "text": "Je l'avais déjà trouvé mieux disposé ces derniers temps, et c'est finalement devant un plat de viande de boeuf, met emblématique de la gastronomie française, qu'il se sera laissé aller à quelques abandons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76961c37-f094-340a-b4b8-7a1946c32695",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "En parlant des manières, des discours, des ouvrages d’esprit et des productions des arts, pour exprimer une sorte de facilité, de négligence heureuse qui exclut toute recherche, toute affectation, et ne laisse jamais sentir l’effort, ni le travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de512084-d590-4f90-9c31-9cbe18b57d9b",
                                                "sense_id": "76961c37-f094-340a-b4b8-7a1946c32695",
                                                "text": "Cette femme a de l’abandon dans ses manières, un gracieux abandon."
                                            },
                                            {
                                                "example_id": "5faaf734-52c3-407b-87d8-00cba37e3cc8",
                                                "sense_id": "76961c37-f094-340a-b4b8-7a1946c32695",
                                                "text": "Il a dans la conversation le plus aimable abandon."
                                            },
                                            {
                                                "example_id": "231063ad-8e33-45fc-91ae-49bfe164f70d",
                                                "sense_id": "76961c37-f094-340a-b4b8-7a1946c32695",
                                                "text": "On remarque dans le style de cet auteur une sorte d’abandon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "248b69ff-963a-3f13-90fc-3abfd6545673",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Acte par lequel l’acheteur renonce a un marché conclu en consentant à payer la prime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee1ff2a8-299f-365b-ad78-395c521202f7",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Rupture des liens affectifs et matériels qui attachent un individu à son entourage plus ou moins proche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4638efdc-873c-4438-9dca-5a7527eb89a9",
                                                "sense_id": "ee1ff2a8-299f-365b-ad78-395c521202f7",
                                                "text": "Mais une attente l’énervait : celle du courrier. Il avait télégraphié à Paris et écrit à Fontainebleau pour qu’on lui renvoyât ses lettres. Il ne recevait rien, et la sensation d’un grand abandon commençait à l’oppresser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f4224e-b9e6-302a-ab5a-5f7441266432",
                                        "entry_id": "6bec5eae-c391-3998-ac2a-147401ffd295",
                                        "glosses": [
                                            "Terrain en jachère."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "information à préciser ou à vérifier"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "675ba6ba-64c6-4fa3-815c-26e5b1a257a5",
                        "source_entry_id": "3841f23c-dc91-3a69-8901-19e4a16b79cd",
                        "source_sense_id": "8c5f070b-471b-3d47-80e4-d16f362ff7b2",
                        "target_lang_word": "délaissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délaissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                        "entry_id": "0a4943ab-31f0-37c9-b4ca-7943a1e1a892",
                                        "glosses": [
                                            "Action de délaisser ou, plus souvent, résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ed6f92-b869-437d-aa74-3aaf7a8a3192",
                                                "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                                "text": "Ses parents et ses amis l’ont abandonné, il est dans un grand délaissement, dans un entier délaissement."
                                            },
                                            {
                                                "example_id": "c5f27e1f-3855-4f44-9ca5-e1f25e112590",
                                                "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                                "text": "Une atmosphère de délaissement presque accablante se glissait dans ces couloirs vides où le salpêtre mettait de longues coulures."
                                            },
                                            {
                                                "example_id": "f5bf1335-5aca-4f78-be07-1a7d48458302",
                                                "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                                "text": "C’est alors que j’appris ce qu’avait été son enfance, et ce grand délaissement dont je n’avais rien pressenti."
                                            },
                                            {
                                                "example_id": "4b3e66e7-6d70-4660-92b7-27ae7a90dae5",
                                                "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                                "text": "À mon délaissement je ne pense jamais ; d’abord il n’y a pas de mot pour le nommer ; et puis je ne le vois pas : on ne cesse pas de m’entourer."
                                            },
                                            {
                                                "example_id": "149cca0e-7f7c-4f31-b2c1-244d948edfc6",
                                                "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                                "text": "J’avais gardé le sentiment qu’on naît superflu à moins d’être mis au monde spécialement pour combler une attente. Mon orgueil et mon délaissement étaient tels, à l’époque, que je souhaitais être mort ou requis par toute la terre."
                                            },
                                            {
                                                "example_id": "bab0538c-c460-4fba-b03f-8094fdc46fe6",
                                                "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                                "text": "Le délaissement d’un mineur de 15 ans en un lieu quelconque est puni de sept ans d’emprisonnement et de 100 000 euros d’amende, sauf si les circonstances du délaissement ont permis d’assurer la santé et la sécurité de celui-ci (article 227-1 du code pénal)."
                                            },
                                            {
                                                "example_id": "51c3c9be-0a77-44e3-a545-a65a409d92f2",
                                                "sense_id": "6becbd0e-4a63-3269-a5be-2631788c64ee",
                                                "text": "Les stations-service abandonnées sont les plus spectaculaires. Dans leur délaissement irréparable – aucun commerce ne les remplacera –, elles soulignent le démeublement insidieux de cette France en crise, à l’opposé de la France des villages fleuris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "634ad3f2-9d71-37cb-becc-17033394b5ce",
                                        "entry_id": "0a4943ab-31f0-37c9-b4ca-7943a1e1a892",
                                        "glosses": [
                                            "État de l’âme qui se croit abandonnée de la grâce."
                                        ],
                                        "tags": [
                                            "Mysticité"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "918e2df6-d91f-3451-a0ac-f2045b8b6763",
                                        "entry_id": "0a4943ab-31f0-37c9-b4ca-7943a1e1a892",
                                        "glosses": [
                                            "Action d’abandonner une chose à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c12669e5-26b3-44ff-8520-ad9e36d299af",
                                                "sense_id": "918e2df6-d91f-3451-a0ac-f2045b8b6763",
                                                "text": "Le délaissement d’un héritage. - Délaissement par hypothèque. - Faire aux assureurs d’une cargaison le délaissement des objets assurés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
