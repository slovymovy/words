                "senses": [
                    {
                        "sense_id": "d4ff9e8c-fe63-3567-baf8-da04b7625bcd",
                        "entry_id": "7064e258-47a2-3d5d-b5ec-136da0776dc3",
                        "glosses": [
                            "Sekret der Scheide"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01d01c46-5198-4821-84cf-ea8ab914f7b9",
                                "sense_id": "d4ff9e8c-fe63-3567-baf8-da04b7625bcd",
                                "text": "„Die Frau sonderte stark Scheidenflüssigkeit ab und erst, als sie dadurch ganz schlüpfrig geworden war, drang er mit der Kuppe völlig ein.“"
                            },
                            {
                                "example_id": "38d46e9c-1f0b-4a99-93a4-2cdf0d519d47",
                                "sense_id": "d4ff9e8c-fe63-3567-baf8-da04b7625bcd",
                                "text": "„Als Barriere kann ein Lecktuch die Aufnahme von Krankheitskeimen in der Scheidenflüssigkeit oder den Menstruationssekreten verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
