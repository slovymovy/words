                ],
                "senses": [
                    {
                        "sense_id": "138e1e97-5ba0-3c97-9d04-d99c8b692dda",
                        "entry_id": "e4fd3e39-9f95-38c5-9700-d7ee9325253c",
                        "glosses": [
                            "Qui blouse, légèrement bouffant au niveau de la taille (en parlant par exemple d’un corsage, d’une robe) ou au niveau du poignet (en parlant d’une manche)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a857139-62b7-4125-b81e-a6186dc32255",
                                "sense_id": "138e1e97-5ba0-3c97-9d04-d99c8b692dda",
                                "text": "La question des corsages collants, les seuls à la mode aujourd’hui, préoccupe beaucoup un certain nombre de femmes qui avaient fait provision de jolies blouses ou corsages « blousants ». Il faut qu’elles se résignent à les abandonner ou à les faire transformer, car on ne voit plus du tout, mais du tout, de ces corsages."
                            },
                            {
                                "example_id": "89add8cc-3dec-44a8-8351-de4b92720595",
                                "sense_id": "138e1e97-5ba0-3c97-9d04-d99c8b692dda",
                                "text": "La mariée, petit bouquet à la main, porte une robe longue de satin blanc, taille basse et corsage blousant comme le veut la mode."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
