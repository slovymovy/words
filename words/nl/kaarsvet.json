{
    "word_family": [
        "kaars",
        "vet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9ba7c70-1c07-3b31-87f1-077bb96b4540",
                    "sense_definition": "de was of het vet waarvan kaarsen gemaakt zijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kaarsvet_materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kaars is gemaakt van zuiver <w>kaarsvet</w> dat langzaam opbrandt.",
                            "target_lang_translations": {
                                "pl": "Świeca jest zrobiona z czystego <w>wosku</w>, który wolno się wypala."
                            }
                        },
                        {
                            "text": "Hij koopt een groot blok <w>kaarsvet</w> om zelf kaarsen te gieten.",
                            "target_lang_translations": {
                                "pl": "Kupuje duży blok <w>parafiny</w>, aby samodzielnie odlewać świece."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gesmolten kaarsvet"
                    ],
                    "target_lang_definitions": {
                        "pl": "wosk, parafina lub tłuszcz, z którego wytwarza się świece"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wosk",
                                "target_lang_sense_clarification": "materiał do produkcji świec"
                            },
                            {
                                "target_lang_word": "parafina",
                                "target_lang_sense_clarification": "substancja do wyrobu świec"
                            },
                            {
                                "target_lang_word": "wosk do świec",
                                "target_lang_sense_clarification": "surowiec świecowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e941094-92ec-3055-b3f1-53668fb0ca64",
                    "sense_definition": "vet of was dat van een brandende kaars is afgedropen of gestold",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kaarsvet_materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er liggen druppels gestold <w>kaarsvet</w> op het houten tafelblad.",
                            "target_lang_translations": {
                                "pl": "Na drewnianym blacie stołu leżą krople zastygłego <w>wosku</w>."
                            }
                        },
                        {
                            "text": "Hoe haal je hard geworden <w>kaarsvet</w> uit een stoffen tafelkleed?",
                            "target_lang_translations": {
                                "pl": "Jak usunąć stwardniały <w>wosk</w> z materiałowego obrusu?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "vlekken van kaarsvet"
                    ],
                    "target_lang_definitions": {
                        "pl": "stopiony lub zastygły wosk kapiący ze świecy"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wosk",
                                "target_lang_sense_clarification": "stopiony lub zastygły ze świecy"
                            },
                            {
                                "target_lang_word": "stearyna",
                                "target_lang_sense_clarification": "zastygły materiał ze świecy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}