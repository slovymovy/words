                "senses": [
                    {
                        "sense_id": "d7838579-9af8-3cfc-9858-746ef9f7fcf9",
                        "entry_id": "0133bae6-3cc3-3523-8a13-998f53b9ac9f",
                        "glosses": [
                            "Landeskrankenhaus in Rankweil im österreichischen Bundesland Vorarlberg, welches früher „Landesirrenanstalt Valduna“ hieß"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ea73a5ae-5e5f-4ef7-9d54-8a474247dec7",
                                "sense_id": "d7838579-9af8-3cfc-9858-746ef9f7fcf9",
                                "text": "„Von den 1941 durchgeführten Deportationen von Patienten aus Valduna nach Hall (Tirol) und Hartheim (OÖ), Letztere zur Tötung psychisch Kranker und Behinderter im Zug des nationalsozialistischen ‚Euthanasie‘-Programms, waren auch Personen aus Liechtenstein betroffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02695fcb-f4a4-3cca-943a-6121b0177011",
                        "entry_id": "0133bae6-3cc3-3523-8a13-998f53b9ac9f",
                        "glosses": [
                            "Name eines Klosters im Südosten von Rankweil, welches 1399 gegründet wurde und bis 1782 Bestand hatte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c160d9ba-0e36-4bc5-bff4-dd1433b126a1",
                                "sense_id": "02695fcb-f4a4-3cca-943a-6121b0177011",
                                "text": "„Heute gehört das LKH Rankweil ganz der Medizin. Lange zuvor aber – besser gesagt rund 600 Jahre früher – war die Valduna bereits jener Ort, an dem das Kloster der Klarissinnen stand. 1782 wurde das Kloster aufgehoben und die Gebäude abgerissen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "89b88f24-1e0a-3760-85bb-bacfd526e893",
                        "entry_id": "0133bae6-3cc3-3523-8a13-998f53b9ac9f",
                        "glosses": [
                            "als Teil von Schimpf- und Spottwendungen in Vorarlberg verwendetes Schimpfwort aufgrund von Bedeutung [1]"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "38abd843-853f-463e-909a-bba7bf509229",
                                "sense_id": "89b88f24-1e0a-3760-85bb-bacfd526e893",
                                "text": "„Dii hond’s wohl us dr Valduna uusloo!“",
                                "translation": "„Dich haben sie wohl aus der Valduna entlassen!“"
                            },
                            {
                                "example_id": "bbdaa040-fc35-41e3-9a99-426621584495",
                                "sense_id": "89b88f24-1e0a-3760-85bb-bacfd526e893",
                                "text": "„Der Beklagten warf er vor, sie gehe nur huren anstatt zu arbeiten und erklärte, sie sei ‚nersch‘ und gehöre in die Valduna.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
