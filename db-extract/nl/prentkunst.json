                        "glosses": [
                            "verzamelterm voor afbeeldingen, al of niet met bijschrift, die als zelfstandige uiting met een drukpers zijn vermenigvuldigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf0b988e-2497-40fe-9ed4-efd2d2d33dc8",
                                "sense_id": "f350fe9f-8f9a-30d1-8fcf-166ef9e5764b",
                                "text": "Omdat die prentenseries zo populair waren, werden er veel roofdrukken van gemaakt, en pleitte Hogarth voor bescherming van prentkunst."
                            },
                            {
                                "example_id": "e6cf6a0a-3685-41c3-aa1e-cda9cbcb1f0e",
                                "sense_id": "f350fe9f-8f9a-30d1-8fcf-166ef9e5764b",
                                "text": "De groeiende middenklasse – ambtenaren en middenstanders – begon vanaf de achttiende eeuw belangstelling voor beeldende kunst te tonen en prentkunst te verzamelen."
                            }
                        ]
                    },
                    {
