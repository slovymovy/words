                "senses": [
                    {
                        "sense_id": "3a6267d9-8b41-30ff-95c5-42fd1bd39f75",
                        "entry_id": "8d78a9dc-c3ce-323d-b8b9-e226c6ccdd14",
                        "glosses": [
