{
    "word_family": [
        "tik",
        "tikken",
        "tikkertje"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d23561f-99e9-3c53-bbc9-57c4dbac9975",
                    "sense_definition": "Een online betalingsverzoek dat via een app of link wordt verstuurd om geld terug te vragen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "betaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik stuur je zo een <w>tikkie</w> voor de drankjes van gisteravond.",
                            "target_lang_translations": {
                                "en": "I'll send you a <w>payment request</w> in a bit for last night's drinks."
                            }
                        },
                        {
                            "text": "Heb je mijn <w>tikkie</w> al betaald?",
                            "target_lang_translations": {
                                "en": "Have you paid my <w>payment request</w> yet?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "een tikkie sturen",
                        "een tikkie betalen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Zeer gebruikelijk in informeel Nederlands"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An online payment request sent via an app or link to ask for money back."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "payment request",
                                "target_lang_sense_clarification": "general term for requesting money digitally"
                            },
                            {
                                "target_lang_word": "Tikkie",
                                "target_lang_sense_clarification": "the specific Dutch payment app/request"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dae3f94-c1c4-3d76-8909-78a66b896b14",
                    "sense_definition": "Een heel kleine hoeveelheid of een zeer geringe mate van iets.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soep is lekker, maar hij is wel een <w>tikkie</w> te zout.",
                            "target_lang_translations": {
                                "en": "The soup is tasty, but it is a <w>tad</w> too salty."
                            }
                        },
                        {
                            "text": "Zij was gisteren een <w>tikkie</w> nerveus voor haar presentatie.",
                            "target_lang_translations": {
                                "en": "She was a <w>bit</w> nervous for her presentation yesterday."
                            }
                        }
                    ],
                    "synonyms": [
                        "tikje",
                        "beetje"
                    ],
                    "common_phrases": [
                        "een tikkie te"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in plaats van 'een beetje'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very small amount or a very slight degree of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tad",
                                "target_lang_sense_clarification": "slightly, a little bit"
                            },
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "a very small amount or degree"
                            },
                            {
                                "target_lang_word": "bit",
                                "target_lang_sense_clarification": "slightly, a small amount"
                            },
                            {
                                "target_lang_word": "smidgen",
                                "target_lang_sense_clarification": "a tiny amount"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ef096c6-97f0-3679-b432-346d298f44a0",
                    "sense_definition": "Een snelle, lichte stoot of een zacht balcontact in de sport.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aanraking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een klein <w>tikkie</w> speelde hij de bal naar zijn medespeler.",
                            "target_lang_translations": {
                                "en": "With a small <w>tap</w>, he played the ball to his teammate."
                            }
                        },
                        {
                            "text": "Hij gaf de bal een <w>tikkie</w> naar rechts.",
                            "target_lang_translations": {
                                "en": "He gave the ball a light <w>nudge</w> to the right."
                            }
                        }
                    ],
                    "synonyms": [
                        "tikje"
                    ],
                    "common_phrases": [
                        "tikkie terug"
                    ],
                    "target_lang_definitions": {
                        "en": "A quick, light tap or a soft touch of the ball in sports."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tap",
                                "target_lang_sense_clarification": "a light blow or touch"
                            },
                            {
                                "target_lang_word": "nudge",
                                "target_lang_sense_clarification": "a gentle push or touch"
                            },
                            {
                                "target_lang_word": "flick",
                                "target_lang_sense_clarification": "a quick, light movement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "57316e70-6eb0-33e6-b762-7592de963ba5",
                    "sense_definition": "Uitroep bij het kinderspel tikkertje wanneer men iemand tikt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind rende weg en riep luidkeels: \"<w>Tikkie</w>, jij bent hem!\"",
                            "target_lang_translations": {
                                "en": "The child ran away and shouted loudly: \"<w>Tag</w>, you're it!\""
                            }
                        },
                        {
                            "text": "Met een tik op zijn schouder riep ze lachend <w>tikkie</w>.",
                            "target_lang_translations": {
                                "en": "With a tap on his shoulder, she laughingly shouted \"<w>tag</w>\"."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tikkie jij bent hem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Gebruikt door kinderen tijdens het spelen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Exclamation used in the children's game of tag when touching someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tag",
                                "target_lang_sense_clarification": "said when touching someone in the game of tag"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}