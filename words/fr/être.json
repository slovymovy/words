{
    "word_family": [
        "bien-être",
        "mal-être",
        "non-être"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66076525-914e-3aec-8f35-9f216d7b7445",
                    "sense_definition": "Attribuer une qualité, une caractéristique ou un état au sujet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "copule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère <w>est</w> très grand et particulièrement calme."
                        },
                        {
                            "text": "Cette maison <w>est</w> magnifique avec son grand jardin fleuri."
                        }
                    ],
                    "common_phrases": [
                        "être d'accord",
                        "être en retard",
                        "être en avance",
                        "être fatigué"
                    ]
                },
                {
                    "sense_id": "2d7d52c3-e415-3421-b38c-f9170bddc0cc",
                    "sense_definition": "Se situer ou se trouver dans un lieu ou une situation précise.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "localisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>sommes</w> actuellement à la gare pour prendre notre train."
                        },
                        {
                            "text": "Les clés <w>sont</w> sur la table près de l'entrée."
                        }
                    ],
                    "synonyms": [
                        "se trouver",
                        "se situer"
                    ],
                    "common_phrases": [
                        "être à la maison",
                        "être en ville"
                    ]
                },
                {
                    "sense_id": "8e860c7a-4977-34e9-a71a-fb3b76e8ef48",
                    "sense_definition": "Indiquer l'heure ou un moment précis de la journée dans une tournure impersonnelle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>est</w> huit heures et le cours commence bientôt."
                        },
                        {
                            "text": "Regarde l'horloge car il <w>est</w> déjà très tard."
                        }
                    ],
                    "common_phrases": [
                        "il est tard",
                        "il est tôt",
                        "il est l'heure"
                    ]
                },
                {
                    "sense_id": "7433371c-9c3c-308a-bb60-c6eb74b06280",
                    "sense_definition": "Indiquer le jour de la semaine ou la date courante.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aujourd'hui nous <w>sommes</w> lundi et le musée reste fermé."
                        },
                        {
                            "text": "Nous <w>sommes</w> le premier mai et presque personne ne travaille."
                        }
                    ],
                    "common_phrases": [
                        "nous sommes lundi",
                        "nous sommes le premier"
                    ]
                },
                {
                    "sense_id": "fe133d3f-3783-3751-9fc6-21f02c6cc7ec",
                    "sense_definition": "Auxiliaire employé pour conjuguer les temps composés de certains verbes intransitifs et de tous les verbes pronominaux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "auxiliaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>est</w> partie ce matin sans laisser de message."
                        },
                        {
                            "text": "Les touristes se <w>sont</w> levés tôt pour admirer le lever du soleil."
                        }
                    ],
                    "common_phrases": [
                        "être parti",
                        "être arrivé",
                        "être venu"
                    ]
                },
                {
                    "sense_id": "c4caf746-a0d6-3575-ae2b-6816d59dd7f3",
                    "sense_definition": "Aller ou s'être rendu quelque part, principalement employé aux temps composés.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>été</w> au marché ce matin pour acheter des fruits frais."
                        },
                        {
                            "text": "Nous avons <w>été</w> voir une exposition passionnante le week-end dernier."
                        }
                    ],
                    "synonyms": [
                        "aller"
                    ],
                    "common_phrases": [
                        "avoir été voir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent préféré au verbe aller dans le registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "106704ab-ab10-34af-a5fe-2a39f3f7d856",
                    "sense_definition": "Auxiliaire servant à former la voix passive avec un participe passé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "auxiliaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux château a <w>été</w> restauré par une équipe de spécialistes."
                        },
                        {
                            "text": "La lettre <w>sera</w> remise en main propre au destinataire."
                        }
                    ],
                    "common_phrases": [
                        "être aimé",
                        "être construit"
                    ]
                },
                {
                    "sense_id": "f5f20683-6ac4-3518-a34b-159d27c3e762",
                    "sense_definition": "Avoir une réalité objective ; exister.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je pense, donc je <w>suis</w>, affirmait le philosophe."
                        },
                        {
                            "text": "Cette ancienne forteresse n'<w>est</w> plus depuis les guerres médiévales."
                        }
                    ],
                    "synonyms": [
                        "exister",
                        "subsister"
                    ],
                    "common_phrases": [
                        "être ou ne pas être"
                    ]
                },
                {
                    "sense_id": "9c715d4f-d9b9-352b-bb41-43023b3bb849",
                    "sense_definition": "Dans la tournure impersonnelle « il en est de », servir à établir un parallèle ou une comparaison.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tournure_impersonnelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il en <w>est</w> de cette situation comme de toutes les autres crises."
                        },
                        {
                            "text": "Il en <w>est</w> des amitiés comme des plantes qui demandent du soin."
                        }
                    ],
                    "common_phrases": [
                        "il en est de même",
                        "il en est ainsi"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eca27c38-438b-3f01-abec-ebde6830eb3d",
