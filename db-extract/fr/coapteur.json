                    {
                        "sense_id": "bf85582b-4f13-3d98-81bf-f97d4ce20d66",
                        "entry_id": "658c8935-69c5-3486-b9c0-18495baa3aef",
                        "glosses": [
                            "Qualifie un accessoire - lien, bande, vis... - utilisé pour coapter (maintenir assemblés) les segments d’un os fracturés."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e460f97d-b27a-4f0c-8096-68690c50bb78",
                                "sense_id": "bf85582b-4f13-3d98-81bf-f97d4ce20d66",
                                "text": "Nous plaçons ensuite les liens coapteurs au niveau de la fracture du péroné, et nous maintenons la jambe dans une bonne direction en venant la fixer dans les trous de la paroi latérale interne."
                            },
                            {
                                "example_id": "a1ab7900-abc9-45cc-ac29-52e40d4a6fdf",
                                "sense_id": "bf85582b-4f13-3d98-81bf-f97d4ce20d66",
                                "text": "Le coapteur est d'abord solidarisé avec un des fragments au moyen de deux vis, puis une vis dite coaptrice est enfoncée dans l’autre fragment, au travers de l’extrémité distale de la coulisse que présente le coapteur."
                            }
                        ]
                    }
