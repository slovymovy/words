                    {
                        "translation_id": "060e7675-e60a-40eb-8c44-eaaec5d39662",
                        "source_entry_id": "d10fa92f-863f-354c-9f44-06a96cf148e6",
                        "source_sense_id": "244b8d59-4c87-3a20-b527-2650cc342a3f",
                        "source_sense_description": "volcano in Italy",
                        "target_lang_word": "Vésuve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vésuve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                        "entry_id": "c67b7e06-f618-3032-a113-803809310504",
                                        "glosses": [
                                            "Volcan d’Italie qui domine la baie de Naples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "408f6d9b-ee74-447a-865a-3bf7e29c5237",
                                                "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                                "text": "L’inscription retrouvée dans une maison prouve que la ville n’a pas été détruite par le Vésuve le 24 août 79, mais deux mois plus tard."
                                            },
                                            {
                                                "example_id": "aecbd138-12ab-496a-af72-b13ab3eb4e67",
                                                "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                                "text": "Je voyageois en Italie : arrivé à Naples, je m’empressai de visiter ce fameux Vésuve, dont la première éruption éclata, selon quelques auteurs, sous l’empereur Titus, l’an soixante-dix-neuf de notre ère, et coûta la vie au célèbre Pline."
                                            },
                                            {
                                                "example_id": "4179d535-8c74-4f4c-96c4-86ae2bc353e0",
                                                "sense_id": "0f3356ba-87ac-37b7-b60c-a6e677478583",
                                                "text": "Faut-il étudier l’homme assagi, endormi sous la cendre, — ou, comme fit Pline l’Ancien pour le Vésuve, s’approcher de lui dans son jeune temps, alors qu’il jette sa lave et son feu ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76533514-e463-356f-b817-6c9245d61fc9",
                                        "entry_id": "c67b7e06-f618-3032-a113-803809310504",
                                        "glosses": [
                                            "Chose qui explose, qui déborde."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "360723a0-6dc2-4f8b-b7e6-a98fcb53656f",
                                                "sense_id": "76533514-e463-356f-b817-6c9245d61fc9",
                                                "text": "Coupe Balzac, deux boules chocolat, une boule framboise, arrosé de notre chocolat et un Vésuve de crème Chantilly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78fb23f2-750b-37b1-be0d-19a6012da275",
                                        "entry_id": "c67b7e06-f618-3032-a113-803809310504",
                                        "glosses": [
                                            "Ville en révolution."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1e49f36-b621-4ea3-9710-e41d0f9bd57e",
                                                "sense_id": "78fb23f2-750b-37b1-be0d-19a6012da275",
                                                "text": "Et de quel air les rois, à l’instant où nous sommes,\nRegardent bouillonner dans ce Vésuve d’hommes\nLa lave des événements !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31cc5824-e797-42a6-a037-3333c6d10494",
                        "source_entry_id": "d10fa92f-863f-354c-9f44-06a96cf148e6",
                        "source_sense_id": "244b8d59-4c87-3a20-b527-2650cc342a3f",
                        "source_sense_description": "volcano in Italy",
                        "target_lang_word": "Vesuv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vesuv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                                        "entry_id": "e373ada9-5a4b-3106-931d-06e166deb7d0",
                                        "glosses": [
                                            "ein 1.281 Meter hoher, aktiver Schichtvulkan in der Nähe der Stadt Neapel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94283670-6c39-4a34-b15c-3ece236bd30b",
                                                "sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                                                "text": "Lange bevor der Vesuv Pompeji begraben hat, verschüttete er die Bauern von Nola. Jetzt werden die Siedlungen aus der Bronzezeit freigelegt."
                                            },
                                            {
                                                "example_id": "62435870-9a5f-40af-8ceb-65814de8e59d",
                                                "sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                                                "text": "Nach dem Ausbruch von 79 n. Chr. blieb der Vesuv noch über einige Jahrhunderte aktiv."
                                            },
                                            {
                                                "example_id": "68e6db2e-d0ee-4809-b115-4f6f46352a37",
                                                "sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                                                "text": "Seit seinem letzten Ausbruch 1944 befindet sich der Vesuv in einer Ruhephase und zeigt derzeit nur Aktivitäten in Form aufsteigender Rauchschwaden (\"Fumarolen\")."
                                            },
                                            {
                                                "example_id": "9b03045f-70cf-4dbd-a60b-f8ae31eab19b",
                                                "sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                                                "text": "Jederzeit kann der Vesuv erwachen."
                                            },
                                            {
                                                "example_id": "90c10869-3dd1-4d3d-8381-e9720942411a",
                                                "sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                                                "text": "Beim großen Vesuv-Ausbruch 3800 vor Christus legte sich eine vier Meter dicke Ascheschicht auf Neapel."
                                            },
                                            {
                                                "example_id": "247f0176-e730-4633-a035-b40d24ddef3e",
                                                "sense_id": "f7b19e68-f9ee-3e81-aa4d-6f806e338560",
                                                "text": "Östlich von Neapel liegt der Vesuv, aber westlich der Stadt liegt die Hölle: Der größte Vulkan Europas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
