                        "examples": [
                            {
                                "example_id": "a2911525-0b58-4ffb-b3a8-f72d122aaaa3",
                                "sense_id": "e80cc193-ceab-38f9-894d-eaa9cd1bcf5b",
                                "text": "The substance of most of these chapters has been given in my college lectures, our present intercollegiate scheme of lecturing (now in operation for about twelve years) offering great facilities for the prosecution of any special studies which happen to suit the taste and capacity of some particular lecturer and a selection of the students."
                            },
                            {
                                "example_id": "b4bc2460-88d5-4b41-bb80-a92156d80cad",
                                "sense_id": "e80cc193-ceab-38f9-894d-eaa9cd1bcf5b",
                                "text": "A certain Phyllis Styles, an intercollegiate prom-trotter, had failed to get her yearly invitation to the Harvard-Princeton game."
                            },
                            {
                                "example_id": "ea137e67-2bab-4dac-89fb-b040891684aa",
                                "sense_id": "e80cc193-ceab-38f9-894d-eaa9cd1bcf5b",
                                "text": "He was given no food. For he had not won an exhibition, Vidiadhar who had brought home clean question papers with ticks beside the questions he had done and a neat list of correct answers to the arithmetic sums, who had begun to learn Latin and French, who had gone to the intercollegiate football match and uttered partisan cries."
                            }
                        ]
                    }
