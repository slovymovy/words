                "senses": [
                    {
                        "sense_id": "0a0c2a8b-3ed8-3688-a8c4-53fde3daea9b",
                        "entry_id": "5697125f-9430-35b0-b53a-88116b59800c",
                        "glosses": [
                            "Person, die auf Wanderschaft geht und dabei mit Musik ihren Lebensunterhalt verdient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279594a3-95c9-4c4d-a9a6-7ee0b88ba32e",
                                "sense_id": "0a0c2a8b-3ed8-3688-a8c4-53fde3daea9b",
                                "text": "„Viele versuchten als Händler, Landarbeiter oder Wandermusikanten woanders den nötigsten Lebensunterhalt für ihre vielköpfigen Familien zu sichern.“"
                            },
                            {
                                "example_id": "2a09318b-7cd9-4631-9914-b41ac7489f02",
                                "sense_id": "0a0c2a8b-3ed8-3688-a8c4-53fde3daea9b",
                                "text": "„Die Tarnung früherer krimineller Vaganten als ambulante Gewerbetreibende, z.B. Wandermusikanten, Hausierer, Korbmacher, Kesselflicker, verweist zugleich auf weitere Sprachteilhaber des Rotwelschen, das im alltäglichen Kontakt mit dem Jiddischen (Handelsjuden), Zigeunerischen und der jeweiligen Regionalsprache zahlreiche Differenzierungen erfahren hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
