                "senses": [
                    {
                        "sense_id": "ec029936-1e6f-3bab-82d4-2677b017a8ba",
                        "entry_id": "d6daaee3-1967-3fd9-9b5b-348846887812",
                        "glosses": [
                            "Person, die sich sinnlichen Genüssen verweigert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f184414-0e85-4b64-a91d-9e919e77b805",
                                "sense_id": "ec029936-1e6f-3bab-82d4-2677b017a8ba",
                                "text": "„Es waren genussfreudige Zeiten, in denen die Liebhaber von Stinkbolzen noch nicht fürchten mussten, bei ihrem Laster ertappt und von einem aufgebrachten Mob gesundheitsbewusster Kostverächter um die Häuser gejagt und an der nächsten Laterne aufgeknüpft zu werden.“"
                            },
                            {
                                "example_id": "727e9dfe-49c3-473e-b8ab-097aefbe326a",
                                "sense_id": "ec029936-1e6f-3bab-82d4-2677b017a8ba",
                                "text": "„Da, in Zornhof, bei der Inge kam es in Anbetracht unserer Lage und der Zeitläufte nicht in Frage, daß ich den Kostverächter spielte…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
