                        "sense_id": "0e93e1bf-db8c-36f7-8396-63db99833f23",
                        "entry_id": "49b99c17-a146-3a8a-8c7f-c58fdc35f4c7",
                        "glosses": [
                            "unbegründete, übersteigerte – eventuell sogar krankhafte – Angst vor, beziehungsweise Aversion und/oder Feindseligkeit gegenüber Homosexualität und Homosexuellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b118de1-9d9d-4caa-8dc4-ed079f29ec2c",
                                "sense_id": "0e93e1bf-db8c-36f7-8396-63db99833f23",
                                "text": "Es ist ein Vorurteil, dass Homophobie vor allem auf dem Lande verbreitet ist."
                            },
                            {
                                "example_id": "9d96221d-1e86-45ef-a82a-64f7e7110a78",
                                "sense_id": "0e93e1bf-db8c-36f7-8396-63db99833f23",
                                "text": "„Es ist aber falsch zu glauben, es gäbe keine Homophobie mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
