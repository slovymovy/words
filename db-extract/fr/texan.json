                        "glosses": [
                            "Race de gros pigeons de chair originaires des États-Unis (Texas), à queue courte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60cd4f7f-c863-4a96-83c1-2fa374186e09",
                                "sense_id": "cec60b97-530c-3cca-b06d-9b7debd5755d",
                                "text": "Les jeunes texans sont autosexables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56a103f7-1cbb-447a-9506-28ede7bf21ed",
