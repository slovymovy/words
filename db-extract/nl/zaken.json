                        ],
                        "examples": [
                            {
                                "example_id": "827faba0-365c-4c2a-8fe4-f00529068f6a",
                                "sense_id": "054c75ff-7451-3bb1-8b7b-c30e222b9c1d",
                                "text": "Constant was ik met mezelf in gesprek over praktische zaken, zoals hoeveel water mee te nemen en wat te doen als ik zou verdwalen, tot mezelf afvragen of ik niet te ver was gegaan door mijn gezin zo lang te verlaten."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9ec8881-b06f-32b1-922b-13cecb858860",
                        "entry_id": "db662eb5-59d1-339d-a0b2-1289736e795d",
                        "glosses": [
