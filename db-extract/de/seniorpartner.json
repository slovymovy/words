                "senses": [
                    {
                        "sense_id": "13e4a8ce-3e48-3a9c-9e11-3bc15d55beb2",
                        "entry_id": "7ae9b322-086d-3cea-9be5-d3e4929a0275",
                        "glosses": [
                            "langjährige, leitende Führungskraft mit strategischer Verantwortung und Teilhaberschaft an einem Unternehmen, besonders in Anwaltskanzleien, Unternehmensberatungen, Wirtschaftsprüfungsgesellschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f9b4c9-cb93-4d8c-a518-20d8783ee03a",
                                "sense_id": "13e4a8ce-3e48-3a9c-9e11-3bc15d55beb2",
                                "text": "„Also wurde Ancel Easter, der sogar damals der klügste Mann in Washington war, vierzehn Seniorpartnern vor die Nase gesetzt und damit faktisch zum zweiten Seniorpartner der Kanzlei, die in Gilmore, Easter, Timothy and Stern oder GETS umbenannt wurde, wie man sie in Washington, einer Stadt, die einen Narren an Akronymen gefressen hat, nannte.“"
                            },
                            {
                                "example_id": "3c75d6c9-c8f5-44b9-957a-8908097bcefd",
                                "sense_id": "13e4a8ce-3e48-3a9c-9e11-3bc15d55beb2",
                                "text": "„Während Levys Zeit als Senior-Partner reinvestierten die meisten Partner große Teile ihrer Gewinne in das Unternehmen, so dass der Fokus stets auf der Zukunft lag.“"
                            },
                            {
                                "example_id": "2b2e4ec6-1b3f-4b69-8578-cc57af20895e",
                                "sense_id": "13e4a8ce-3e48-3a9c-9e11-3bc15d55beb2",
                                "text": "„Senior-Partner sind zentrale Entscheider und Mitglieder der Leitungsebene der Unternehmensberatung. … Sie haben Erfahrung in der Leitung von großen Beratungsaufträgen mit hoher Komplexität und strategischer Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "afb329a0-45bb-3ced-ae54-d15cc5a41e41",
