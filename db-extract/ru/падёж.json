                                        "examples": [
                                            {
                                                "example_id": "25192b91-28d4-49d8-b055-811cb4433c87",
                                                "sense_id": "ac906c0e-425d-3be4-b5c5-285dc097f5ad",
                                                "text": "Une recrudescence de l’épizootie de fièvre aphteuse est signalée dans le département des Ardennes. Douzy, Étalle, Étion, Marby, Carignan, Regniowez, Juniville, Perthes et Annelles sont parmi les localités les plus éprouvées."
                                            },
                                            {
                                                "example_id": "df83d186-bac1-4bcf-9c80-441cc88cf17b",
                                                "sense_id": "ac906c0e-425d-3be4-b5c5-285dc097f5ad",
                                                "text": "En 1979, dans les derniers mois de l’interminable guerre civile, une épizootie de charbon d'une ampleur exceptionnelle éclate en atteignant le bétail des « réserves » noires rurales, les Southern Tribal Trust Lands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "369094bf-cd7b-3bb0-9622-fceb8bdb9840",
                                        "entry_id": "8bfd0fab-819b-33a0-96ef-a0ac34f46189",
                                        "glosses": [
                                            "Maladie contagieuse qui frappe les animaux."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire",
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5561f7c9-5476-46e1-8cbf-8d1f74993be8",
                                                "sense_id": "369094bf-cd7b-3bb0-9622-fceb8bdb9840",
                                                "text": "En Angleterre, une épizootie effroyable, s'étendant sur presque tout le territoire, ravageant les plus riches troupeaux et immolant 64 000 tètes de bétail (chiffre officiel qui n'exprime que la moitié environ des pertes totales)."
                                            }
