                    {
                        "translation_id": "d04a29dc-dbca-459f-a851-578e32859d70",
                        "source_entry_id": "33de087d-d9af-3f72-b8ec-444d04fbb23a",
                        "source_sense_description": "sword with one sharp edge",
                        "target_lang_word": "пала́ш",
