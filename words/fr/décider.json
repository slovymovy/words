            "senses": [
                {
                    "sense_id": "1fa7d462-1587-30be-b41a-f8dc8dbe6775",
                    "sense_definition": "Prendre une résolution, choisir d'accomplir une action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "choix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons <w>décidé</w> de partir en vacances au bord de la mer."
                        },
                        {
                            "text": "Le directeur <w>décide</w> des priorités pour la nouvelle année scolaire."
                        }
                    ]
                },
                {
                    "sense_id": "0012e1e8-5644-3da4-ad54-9d6367150fa0",
                    "sense_definition": "Amener ou convaincre quelqu'un à faire un choix ou accomplir une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses arguments solides ont fini par me <w>décider</w> à accepter ce poste."
                        },
                        {
                            "text": "La pluie abondante nous a <w>décidés</w> à rester à la maison ce soir."
                        }
                    ],
                    "common_phrases": [
