                        "translation_id": "b1f7665b-09e5-4b1c-9c43-a2dad2c566b2",
                        "source_entry_id": "44063d8f-6fcf-3bc9-8d90-f8cf8577ac3c",
                        "source_sense_id": "1ab547ef-0329-36b1-b42f-9581ef89b235",
                        "target_lang_word": "Kishinev",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kishinev",
