                    {
                        "form_id": "134f4171-c118-4505-89a6-6ebdf4dd4284",
                        "entry_id": "a1512abc-055a-3914-95e7-91be5cfaec87",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fünf-Prozent-Hürden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                        "entry_id": "a1512abc-055a-3914-95e7-91be5cfaec87",
                        "glosses": [
                            "Sperrklausel für Wahlen, die fordert, dass eine Partei gemäß der Stimmverteilung Sitze nur zugeteilt bekommt, wenn sie mindestens fünf Prozent der abgegebenen, gültigen Stimmen auf sich vereint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e4bf2d-8cc2-4ed9-a92e-220448b64dd1",
                                "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                                "text": "Für die Bundestagswahl 1990 galt die Fünf-Prozent-Hürde wegen der besonderen Situation direkt nach der Wiedervereinigung getrennt für West- und Ostdeutschland."
                            },
                            {
                                "example_id": "3ea1e72d-5faf-4260-8b20-5ffa277f9b8d",
                                "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                                "text": "„Einwände, eine Abschaffung der Fünf-Prozent-Hürde gefährde die Demokratie wie in der Weimarer Republik, wies der Grünen-Politiker zurück.“"
                            },
                            {
                                "example_id": "d848ec35-d49a-4eb7-b19b-e40e8e9844f7",
                                "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                                "text": "„Nach einer Umfrage des Meinungsforschungsinstituts INSA für FOCUS Online ist es immerhin jedem dritten Wähler (31,6 Prozent) in Deutschland wichtig, dass die FDP bei der Bundestagswahl über die Fünf-Prozent-Hürde kommt.“"
                            },
                            {
                                "example_id": "cc811ca3-cf70-4a7a-82aa-9743e21527e2",
                                "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                                "text": "„Die FDP hat einer Umfrage zufolge in der Wählergunst verloren und rutscht wieder unter die Fünf-Prozent-Hürde'.“"
                            },
                            {
                                "example_id": "f585609a-a6b5-410e-8a0d-89ef5bcd6dff",
                                "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                                "text": "[Bundestagswahl 2025, 23.2.2025, 18:04 Uhr, Prognose:] „Zwei Parteien liegen derzeit unterhalb der Fünf-Prozent-Hürde.“"
                            },
                            {
                                "example_id": "28808dd0-cf96-4a68-b2f9-a46a04d63266",
                                "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                                "text": "„Analog zu der Gemeinderatswahlordnung soll künftig (erstmals) auch eine Fünf-Prozent-Hürde für alle politischen Parteien gelten.“"
                            },
                            {
                                "example_id": "4b5ee1ab-596e-45c0-9869-77067632ffe9",
                                "sense_id": "24c942ab-4e93-3b8b-aa3e-4b224a88d695",
                                "text": "„Die EVP war letztes Jahr in den Stadtzürcher Wahlen an der Fünf-Prozent-Hürde gescheitert, wenn auch äusserst knapp.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
