                                "example_id": "f3f7b20b-d91c-444a-a533-bec3915cabb7",
                                "sense_id": "839184d6-521f-3153-b106-e5cb04da1697",
                                "text": "At least the captress gets, or thinks she has got, what she wants."
                            },
                            {
                                "example_id": "ceaf5049-7f1b-4091-8348-85779e93d6f9",
                                "sense_id": "839184d6-521f-3153-b106-e5cb04da1697",
                                "text": "Murmurs of expectation, like the purrings of hungry flame, arose from the nearest, who hoped to share in the good fortune of the sorcerer's captress."
                            },
                            {
                                "example_id": "0bae99b3-debb-4a7c-b57e-c1f7763b5df6",
                                "sense_id": "839184d6-521f-3153-b106-e5cb04da1697",
                                "text": "Where did the notion that its captress should be a virgin come from? Again, this was likely to be an Indian trait."
                            }
                        ]
                    }
