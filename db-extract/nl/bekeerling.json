                        "translation_id": "7382773e-4db8-49b3-88ae-a2c40b37ab21",
                        "source_entry_id": "189d19f5-45ef-3669-a390-6c15396a6e34",
                        "source_sense_id": "eb950a26-2523-3acd-a56c-bd9b01ab3883",
                        "source_sense_description": "iemand die zich recentelijk tot een bepaald geloof bekeerd heeft",
                        "target_lang_word": "Konvertit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konvertit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39af7ee2-3ace-321b-9100-285ca58acece",
                                        "entry_id": "0f039b9e-0e5a-3cb3-bee3-59bddcf1b3af",
                                        "glosses": [
                                            "jemand, der zu einem anderen Glauben überwechselt/übergewechselt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab45041c-8d55-440e-9a2e-d3f757bec1f3",
                                                "sense_id": "39af7ee2-3ace-321b-9100-285ca58acece",
                                                "text": "„In Kiew lässt der Konvertit nun alle heidnischen Götterbilder und Statuen zerschlagen oder ins Feuer werfen und befiehlt zudem seinen Untertanen, sich am Ufer des Dnjepr zu einer Massentaufe einzufinden.“"
                                            },
                                            {
                                                "example_id": "223eac7b-5d40-4af4-b4c2-f3d75cf15c6f",
                                                "sense_id": "39af7ee2-3ace-321b-9100-285ca58acece",
                                                "text": "„In den Anfangsjahren des jiddischen Buchdrucks spielten Konvertiten, die nach der Taufe eigene Druckereien betreiben und Werke in ihrer Muttersprache verlegen konnten, eine wichtige Rolle.“"
                                            },
                                            {
                                                "example_id": "ecc68d8c-0f23-4530-b827-aab435541604",
                                                "sense_id": "39af7ee2-3ace-321b-9100-285ca58acece",
                                                "text": "„Zu einem christlichen Lebenswandel gehörte die monogame Ehe, davon waren die Missionare überzeugt, und das verlangten sie von allen Konvertiten.“"
                                            },
                                            {
                                                "example_id": "64d14a7b-01e0-43a2-b64c-86a538233a54",
                                                "sense_id": "39af7ee2-3ace-321b-9100-285ca58acece",
                                                "text": "„Auch einzelne europäische Konvertiten fühlen sich von dieser Version des Islam angesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
