                ],
                "senses": [
                    {
                        "sense_id": "1454d6d9-8fd6-33ca-9f52-7e186f8dbd4d",
                        "entry_id": "d7baceb0-082b-397f-9aae-7660640dfc22",
                        "glosses": [
                            "Presse-légumes ou presse-purée, dans lequel l’écrasement des légumes est provoqué par la pression d’une hélice tournante sur une grille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d425ed03-9e62-46bc-adbf-f9382f1daa3c",
                                "sense_id": "1454d6d9-8fd6-33ca-9f52-7e186f8dbd4d",
                                "text": "Moulinette à légumes, en fer blanc, grille fine. Un système de blocage permet de maintenir la manivelle dans l’axe. En position non bloquée, la grille peut être démontée pour le nettoyage. Les deux pieds et le manche, avec des caoutchoucs blancs, antidérapants, sont fixes."
                            },
                            {
                                "example_id": "c1e65d82-d7ed-4fb4-a66c-2d9c63e1ef9a",
                                "sense_id": "1454d6d9-8fd6-33ca-9f52-7e186f8dbd4d",
                                "text": "Il s'égosillait pour attirer les chalands, mais personne ne semblait se passionner pour ses moulinettes à légumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b1502f2-c9ff-3989-bdd3-699a782232b6",
                        "entry_id": "d7baceb0-082b-397f-9aae-7660640dfc22",
                        "glosses": [
                            "Technique d’initiation à l’escalade, où l’initié est assuré du bas par une corde attachée en haut, à la manière d’une poulie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "51167107-fa2e-33ef-946f-045ebe6a5730",
                        "entry_id": "d7baceb0-082b-397f-9aae-7660640dfc22",
                        "glosses": [
                            "Petit programme informatique qui effectue tout une série de calculs répétitifs et très simples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d516a5-f2f6-43a6-99bf-6e7f3c375d90",
                                "sense_id": "51167107-fa2e-33ef-946f-045ebe6a5730",
                                "text": "Cette moulinette permettait de décomposer les fichiers CSV atterrissant dans ce dossier en plusieurs petits fichiers XML."
                            }
                        ]
                    },
                    {
                        "sense_id": "b39fcf81-f8a0-30fd-a11e-69b67e41caab",
                        "entry_id": "d7baceb0-082b-397f-9aae-7660640dfc22",
                        "glosses": [
