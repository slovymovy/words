                "senses": [
                    {
                        "sense_id": "a5722ed2-27ac-3104-b8e3-988d9c85fd59",
                        "entry_id": "7be683da-0b50-3d17-987a-f08420e53df2",
                        "glosses": [
                            "durch planmäßige Züchtung entstandene (Haus-)Tierart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "996e7246-2bb5-4ab7-84eb-34a29a44964e",
                                "sense_id": "a5722ed2-27ac-3104-b8e3-988d9c85fd59",
                                "text": "„Die vorrangige Nutzung des Hausesels als Packtier brachte wesentlich weniger verschiedene Kulturrassen hervor als dies bei den Pferden der Fall ist.“"
                            },
                            {
                                "example_id": "43b93691-27d3-4962-a140-fc1b9571dc8d",
                                "sense_id": "a5722ed2-27ac-3104-b8e3-988d9c85fd59",
                                "text": "„Die wenigen Kulturrassen, die sich vor allem im Zuge der Maultierzucht entwickeln konnten, sind in Europa, vorrangig in Frankreich, Italien und Spanien, in kleinen Beständen erhalten geblieben.“"
                            }
                        ],
