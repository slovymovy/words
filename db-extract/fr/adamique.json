                        "sense_id": "32720900-95f6-39f9-93ad-307460111ef6",
                        "entry_id": "a09766e2-e2a0-34eb-9ec0-8d6896a79e37",
                        "glosses": [
                            "Langue d'Adam, langue originelle."
                        ],
