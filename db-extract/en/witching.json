                        "glosses": [
                            "Bewitching, enchanting."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "acfc457d-95e6-4359-8433-d6065e0ea668",
                                "sense_id": "e3b9381c-bedf-3d55-a178-0315e036ad72",
                                "text": "But who is this witching beauty by his side, who would fain impress you with a belief that that mischief which will not remain concealed for the briefest period, is not her entire composition?"
                            }
                        ]
                    }
