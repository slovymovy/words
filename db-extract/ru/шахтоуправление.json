                "senses": [
                    {
                        "sense_id": "bda9aab3-4d2b-3db8-a538-6fe71e74ead7",
                        "entry_id": "cd58abd9-6363-3f90-a3fc-1646e561df5c",
                        "glosses": [
                            "руководящий орган на горнопромышленном предприятии, ведущем добычу полезных ископаемых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba90864a-50a7-4369-95d4-b4f612aec929",
                                "sense_id": "bda9aab3-4d2b-3db8-a538-6fe71e74ead7",
                                "text": "Среди машин и беженцев, двигавшихся по обочине шоссе, куда прибило бричку и телегу, ползла грузовая машина шахты No 1-бис, на которой среди работников и имущества шахтоуправления ехали директор шахты Валько и Григорий Ильич Шевцов,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a779802-9b88-490d-a0cc-ee1a833513cf",
                        "source_entry_id": "cd58abd9-6363-3f90-a3fc-1646e561df5c",
                        "source_sense_id": "bda9aab3-4d2b-3db8-a538-6fe71e74ead7",
                        "target_lang_word": "mine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdde2227-9a24-3a34-9c41-eb48d0690461",
                                        "entry_id": "c0129720-a675-35c4-89ac-a13e37686a0c",
                                        "glosses": [
                                            "That or those belonging to me.",
                                            "Used predicatively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba31d58a-d8c2-4b0d-bf02-af5215fc216a",
                                                "sense_id": "cdde2227-9a24-3a34-9c41-eb48d0690461",
                                                "text": "The house itself is mine, but the land is not."
                                            },
                                            {
                                                "example_id": "d4576bd2-833b-419c-ae08-e428f599b0b2",
                                                "sense_id": "cdde2227-9a24-3a34-9c41-eb48d0690461",
                                                "text": "These books are mine."
                                            },
                                            {
                                                "example_id": "36d5ed9a-a9d1-4c49-8516-1c80e3df2e22",
                                                "sense_id": "cdde2227-9a24-3a34-9c41-eb48d0690461",
                                                "text": "Ah, but how beautiful (my baby boy) is! And he is mine, mine for ever. Even if he hates me he will be mine. He cannot help it, he is made out of me; I am his father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45e16a42-f111-3da2-8e20-ba8bbff4e259",
                                        "entry_id": "c0129720-a675-35c4-89ac-a13e37686a0c",
                                        "glosses": [
                                            "That or those belonging to me.",
                                            "Used substantively, with an implied noun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8012c32a-8d1a-4ad3-a176-da935d1eb0ec",
                                                "sense_id": "45e16a42-f111-3da2-8e20-ba8bbff4e259",
                                                "text": "Mine has been a long journey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e67613-9746-3a97-8628-90715d26e902",
                                        "entry_id": "c0129720-a675-35c4-89ac-a13e37686a0c",
                                        "glosses": [
                                            "That or those belonging to me.",
                                            "Used absolutely, set off from the sentence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16dc13a2-7539-4a6a-8753-4684cfcd6589",
                                                "sense_id": "d1e67613-9746-3a97-8628-90715d26e902",
                                                "text": "Mine for only a week so far, it already feels like an old friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b6c521-2c15-351b-bb2a-18cb3123ddd0",
                                        "entry_id": "c0129720-a675-35c4-89ac-a13e37686a0c",
                                        "glosses": [
                                            "That or those belonging to me.",
                                            "My house or home."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805bd32a-b71d-4901-a5eb-be611035194f",
                                                "sense_id": "17b6c521-2c15-351b-bb2a-18cb3123ddd0",
                                                "text": "We had the party at mine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ee3f5b-c7fb-3dd4-9b9a-365d23448fa3",
                                        "entry_id": "c0129720-a675-35c4-89ac-a13e37686a0c",
                                        "glosses": [
                                            "That or those belonging to me.",
                                            "As double possessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e14c6a-04ff-4c66-819b-d0b340bf073f",
                                                "sense_id": "e2ee3f5b-c7fb-3dd4-9b9a-365d23448fa3",
                                                "text": "This house of mine is over 100 years old."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85d57ff4-5801-3663-82c8-52bbc6ca267e",
                                        "entry_id": "8416a758-6d7d-3282-b5ca-850194138a09",
                                        "glosses": [
                                            "My; belonging to me.",
                                            "Used attributively after the noun it modifies."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7a1bdff-9052-4519-a0d3-039f2bf1366a",
                                                "sense_id": "85d57ff4-5801-3663-82c8-52bbc6ca267e",
                                                "text": "[…] Flesh and blood, / You, brother mine, that entertain'd ambition, / […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b21af3b3-69b4-3f2e-9078-b452bff5568a",
                                        "entry_id": "8416a758-6d7d-3282-b5ca-850194138a09",
                                        "glosses": [
                                            "My; belonging to me.",
                                            "Used attributively before a vowel."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "204db742-9777-4070-ae72-09cafa58c218",
                                                "sense_id": "b21af3b3-69b4-3f2e-9078-b452bff5568a",
                                                "text": "Mine eyes have seen the glory of the coming of the Lord: / […]"
                                            },
                                            {
                                                "example_id": "2bcbdc8b-ce41-43d2-bc32-48fcd7715c73",
                                                "sense_id": "b21af3b3-69b4-3f2e-9078-b452bff5568a",
                                                "text": "1930 Winter, Packard Motor Car Company, The Packard Magazine, Volume 9, Number 2, page 6,\nMine host, it seemed, did favors for everybody..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69197c0d-feac-391e-b624-53cb8a8cf5f5",
                                        "entry_id": "61e28a32-efb6-3fea-aaa5-a2cade84638a",
                                        "glosses": [
                                            "An excavation from which ore or solid minerals are taken, especially one consisting of underground tunnels."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f7d324-4e87-41c0-a0c2-4a5bb0ae55d9",
                                                "sense_id": "69197c0d-feac-391e-b624-53cb8a8cf5f5",
                                                "text": "Meronyms: mine shaft, mineshaft; mine car"
                                            },
                                            {
                                                "example_id": "f141962d-57c9-4b0c-8e1f-0c1161cf1662",
                                                "sense_id": "69197c0d-feac-391e-b624-53cb8a8cf5f5",
                                                "text": "This diamond comes from a mine in South Africa."
                                            },
                                            {
                                                "example_id": "c358599e-151f-4b78-b2ee-24e098a8561a",
                                                "sense_id": "69197c0d-feac-391e-b624-53cb8a8cf5f5",
                                                "text": "He came out of the coal mine with a face covered in black."
                                            },
                                            {
                                                "example_id": "52dc072f-d1ce-45b7-9bda-81522977245d",
                                                "sense_id": "69197c0d-feac-391e-b624-53cb8a8cf5f5",
                                                "text": "Most coal and ore comes from open-pit mines nowadays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f4a18b3-e146-3a6f-aa2d-9f2cccf2e3d0",
                                        "entry_id": "61e28a32-efb6-3fea-aaa5-a2cade84638a",
                                        "glosses": [
                                            "Any source of wealth or resources."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba1013f-aeda-4a77-98cd-92c8ab305a41",
                                                "sense_id": "6f4a18b3-e146-3a6f-aa2d-9f2cccf2e3d0",
                                                "text": "She's a mine of information about the history of mathematics."
                                            },
                                            {
                                                "example_id": "f6247563-40f6-4ced-b1e7-9c63eb678f3f",
                                                "sense_id": "6f4a18b3-e146-3a6f-aa2d-9f2cccf2e3d0",
                                                "text": "To those seeking information about train services on the Continent, Cook's Continental Guide is always a mine of accurate information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50586763-3668-38d1-b687-e307219e892f",
                                        "entry_id": "61e28a32-efb6-3fea-aaa5-a2cade84638a",
                                        "glosses": [
                                            "A passage dug toward or underneath enemy lines, which is then packed with explosives."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d3e30c-9ea2-4c9b-9861-2de290d0eda2",
                                                "sense_id": "50586763-3668-38d1-b687-e307219e892f",
                                                "text": "The most famous mine of the American Civil War led to the Battle of the Crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8fa9aca-9af4-3819-ad89-534e7b23099c",
                                        "entry_id": "61e28a32-efb6-3fea-aaa5-a2cade84638a",
                                        "glosses": [
                                            "A device intended to explode when stepped upon or touched, or when approached by a ship, vehicle, or person."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3280711a-5ae7-443d-a8e9-cb4b95d1ccfa",
                                                "sense_id": "e8fa9aca-9af4-3819-ad89-534e7b23099c",
                                                "text": "Holonym: minefield"
                                            },
                                            {
                                                "example_id": "c16485de-29e4-4be9-8a58-d484133165c5",
                                                "sense_id": "e8fa9aca-9af4-3819-ad89-534e7b23099c",
                                                "text": "His left leg was blown off after he stepped on a mine."
                                            },
                                            {
                                                "example_id": "97209ad3-6da0-44f2-85f7-079f96bf2125",
                                                "sense_id": "e8fa9aca-9af4-3819-ad89-534e7b23099c",
                                                "text": "The warship was destroyed by floating mines."
                                            },
                                            {
                                                "example_id": "0ec7b49a-680e-4114-8440-4afeb1828576",
                                                "sense_id": "e8fa9aca-9af4-3819-ad89-534e7b23099c",
                                                "text": "Pack ice, at times mounting to a height of 35 ft., snow, fog, and floating mines all played their part in the disorganisation of railway services, and most of the train ferry services were completely suspended for a month or more; [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96414902-83cc-3a81-9718-7ca250a9f95a",
                                        "entry_id": "61e28a32-efb6-3fea-aaa5-a2cade84638a",
                                        "glosses": [
                                            "A type of firework that explodes on the ground, shooting sparks upward."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "491c3db1-7821-33d4-a15e-4d1e7279028d",
                                        "entry_id": "61e28a32-efb6-3fea-aaa5-a2cade84638a",
                                        "glosses": [
                                            "The cavity made by a caterpillar while feeding inside a leaf."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10e46b08-b81f-39ab-b14b-4780f43e809e",
                                        "entry_id": "61e28a32-efb6-3fea-aaa5-a2cade84638a",
                                        "glosses": [
                                            "A machine or network of machines used to extract units of a cryptocurrency."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bcd3aec-2398-48e3-94ff-27d563e17855",
                                                "sense_id": "10e46b08-b81f-39ab-b14b-4780f43e809e",
                                                "text": "A change to the blockchain method was contemplated to allow mines to hog less electric power."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
