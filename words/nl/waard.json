                {
                    "sense_id": "34faba81-9c86-3f91-85f3-2f2e968e1f2d",
                    "sense_definition": "Een mannetjeseend, vaker <w>woerd</w> genoemd.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tussen de eenden in de vijver zwom een prachtige <w>waard</w>.",
                            "target_lang_translations": {
                                "ru": "Среди уток в пруду плавал красивый <w>селезень</w>.",
                                "en": "Among the ducks in the pond swam a beautiful <w>drake</w>.",
                                "it": "Tra le anatre nello stagno nuotava un bellissimo <w>germano maschio</w>."
                            }
