                ],
                "senses": [
                    {
                        "sense_id": "6290cb61-f650-389b-b7e7-9efb32cee4cb",
                        "entry_id": "967d8cc5-538d-3194-82cb-fd68f5606ad1",
                        "glosses": [
                            "geheel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c26188b2-2ef5-4fb0-9b3a-a11d1dae8ea4",
                                "sense_id": "6290cb61-f650-389b-b7e7-9efb32cee4cb",
                                "text": "De totale productiewaarde van de sector steeg met 10%."
                            }
                        ]
                    },
                    {
                        "sense_id": "f19b8f6e-a414-3670-b979-7f5a2e5f5f85",
                        "entry_id": "967d8cc5-538d-3194-82cb-fd68f5606ad1",
                        "glosses": [
                            "volkomen, volledig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c918a3af-7f8a-4f5c-9d81-89ad01f44355",
                                "sense_id": "f19b8f6e-a414-3670-b979-7f5a2e5f5f85",
                                "text": "De Europese top is uitgelopen op een totale mislukking."
                            },
                            {
                                "example_id": "de9fe1ff-664a-417d-86fc-9f992183d7dd",
                                "sense_id": "f19b8f6e-a414-3670-b979-7f5a2e5f5f85",
                                "text": "Er ligt totaal geen expressie op haar gezicht."
                            },
                            {
                                "example_id": "f4cf58d9-c601-4609-abcb-78612f49bda3",
                                "sense_id": "f19b8f6e-a414-3670-b979-7f5a2e5f5f85",
                                "text": "Vandaag zou ik de woestijn intrekken, een dorre vlakte die mij totaal vreemd was."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "80e3af65-9405-3a93-9371-f1de1919ef8c",
                "word": "totaal",
