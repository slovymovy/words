                                                "example_id": "79915b50-7557-4103-b6a0-5740c627e256",
                                                "sense_id": "23c43fcb-f39d-38a7-8227-1312e4910421",
                                                "text": "Bitte listen Sie auf, was Sie letzte Woche gegessen haben."
                                            },
                                            {
