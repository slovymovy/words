                    {
                        "sense_id": "8667748d-5519-3e4e-8f7c-430926bd6128",
                        "entry_id": "eafc740a-4744-3a33-aa00-75ee40a74b22",
                        "glosses": [
                            "проверка, опробование; выявление качественных или количественных характеристик кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fdc7b0d-fbba-4874-873f-370643b275df",
                                "sense_id": "8667748d-5519-3e4e-8f7c-430926bd6128",
                                "text": "Простейший тест показал, что прибор действительно не включается."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e93dfe6-e34c-3553-bb3b-c2feb348d42b",
                        "entry_id": "eafc740a-4744-3a33-aa00-75ee40a74b22",
                        "glosses": [
                            "инструмент или процедура для проведения теста [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9382b419-ca9e-4b3d-bd57-8320c944d949",
                                "sense_id": "2e93dfe6-e34c-3553-bb3b-c2feb348d42b",
                                "text": "Дайте мне тест на беременность."
                            },
                            {
                                "example_id": "5d36cf4c-17a4-46d3-ab2f-656bb0c84460",
                                "sense_id": "2e93dfe6-e34c-3553-bb3b-c2feb348d42b",
                                "text": "После обеда у меня тест."
                            }
                        ]
                    }
                ],
