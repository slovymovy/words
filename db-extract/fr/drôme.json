                            {
                                "example_id": "b6a0bf8a-452b-43fd-9903-05911a737de6",
                                "sense_id": "04a1a5ed-4e10-3123-af7f-253042f1f8b0",
                                "text": "Je possède encore dans le tiroir d’un meuble une photographie que mon ami Jean-Marc Bernard m’envoya lors de l’exécution capitale à Valence des chauffeurs de la Drôme."
                            },
                            {
                                "example_id": "676d64c9-897e-47b4-acff-366a04a2a4c1",
                                "sense_id": "04a1a5ed-4e10-3123-af7f-253042f1f8b0",
                                "text": "Mais, selon Le Dauphiné, il existe bien des personnes du nom d’Iserable dans la Drôme, notamment vers Romans-sur-Isère."
                            }
                        ]
                    }
