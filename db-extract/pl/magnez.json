                        ]
                    },
                    {
                        "translation_id": "e75fde3b-f0f8-4017-b5f3-08986826136e",
                        "source_entry_id": "fe2fb67a-19ea-31f2-b213-8cdef3561a65",
                        "source_sense_id": "8ed89dba-4d61-39d3-a5df-cd1d4e8760b9",
                        "target_lang_word": "magnésium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnésium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9cc855a-93c7-3423-8840-d83e063b8b21",
                                        "entry_id": "99d9a43d-4b07-36ed-806e-d67480cb55ae",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 12 et de symbole Mg qui fait partie des métaux alcalino-terreux. Sa forme ionique en solution est le Mg²⁺ ou Mg⁺⁺."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a718403-5410-49cf-97e4-18b32af4c220",
                                                "sense_id": "a9cc855a-93c7-3423-8840-d83e063b8b21",
                                                "text": "Plus tard on a reconnu que les acides chromique, chlorique, borique, acétique, et oxalique, ainsi que les chlorures de magnésium et d’étain, et enfin les aluns, se comportaient comme l’acide fluorhydrique."
                                            },
                                            {
                                                "example_id": "875c7e6f-5c47-4213-a9df-b328c7528a4d",
                                                "sense_id": "a9cc855a-93c7-3423-8840-d83e063b8b21",
                                                "text": "Il souleva le siège et le tint en équilibre sur son petit doigt.\n– C’est assez léger, hein ? Alliage d’aluminium et de magnésium, et on a fait le vide à l’intérieur."
                                            },
                                            {
                                                "example_id": "bbc1dd99-efe1-4c3c-b3e3-db21c89893d5",
                                                "sense_id": "a9cc855a-93c7-3423-8840-d83e063b8b21",
                                                "text": "L’aridification croissante est aussi indiquée par des accumulations de calcites à forte teneur en magnésium et d’aragonites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef30594-1c04-33a3-9aec-c72f938457c1",
                                        "entry_id": "99d9a43d-4b07-36ed-806e-d67480cb55ae",
                                        "glosses": [
                                            "Corps simple métallique de l’élément : un métal blanc-gris argenté, très résistant et qui se ternit légèrement quand il est exposé à l’air ambiant."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99614e6-5ad9-496c-b8a4-ae953a0bc0d2",
                                                "sense_id": "6ef30594-1c04-33a3-9aec-c72f938457c1",
                                                "text": "On obtient le magnésium par l’électrolyse du chlorure de magnésium fondu. C’est un métal blanc d’argent très léger, s’oxydant au contact de l’air humide. II brûle au contact de l’air avec une flamme éblouissante et très riche en rayons chimiques, d’où ses emplois en photographie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e3baf5b-8940-3665-9b9a-e5ff1b30cc73",
                                        "entry_id": "99d9a43d-4b07-36ed-806e-d67480cb55ae",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) de magnésium."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74bb47c8-8ce3-47af-b275-cb0edc98239e",
                                                "sense_id": "9e3baf5b-8940-3665-9b9a-e5ff1b30cc73",
                                                "text": "La protéine-kinase CK2 […] nécessite une concentration extraphysiologique d’ions magnésiums pour pouvoir exhiber son activité catalytique maximale."
                                            },
                                            {
                                                "example_id": "6eadba46-d182-4a2e-aebf-caf7b1f8bc81",
                                                "sense_id": "9e3baf5b-8940-3665-9b9a-e5ff1b30cc73",
                                                "text": "Quand le voleur a fracturé ce tiroir, il a déterminé l’explosion d’une certaine quantité de poudre de magnésium, cachée par moi sur la bibliothèque. […] Le malfaiteur qui s’est introduit ici a été photographié sans qu’il s’en doute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fe5c7c9-6426-391d-82f4-e3e9fe64d366",
                                        "entry_id": "99d9a43d-4b07-36ed-806e-d67480cb55ae",
                                        "glosses": [
                                            "Premier type de flash photographique, utilisant de la poudre de magnésium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde97647-0230-4295-96e7-45d700685f49",
                                                "sense_id": "0fe5c7c9-6426-391d-82f4-e3e9fe64d366",
                                                "text": "Le soir du Grand Prix, des dix heures le salon du centre et la serre aux plantes exotiques s’inondèrent des jets éblouissants de la lumière de magnésium, lumière blanche, fluide, plus claire et cependant moins aveuglante que celle de l’électricité et à laquelle ressortaient tout le relief des statues, tous les plis des draperies, comme si le jour lui-même eût voulu prendre part à la fête des Vénérande."
                                            },
                                            {
                                                "example_id": "84e43cf9-f478-4ab9-a974-755e58baa147",
                                                "sense_id": "0fe5c7c9-6426-391d-82f4-e3e9fe64d366",
                                                "text": "Et, tandis que je travaille, haletant, éperdu, le magnésium flambe toujours, à droite, à gauche, en bas, en haut, et des gens crient mon nom à la cantonade."
                                            },
                                            {
                                                "example_id": "b64f6a64-c212-4477-9928-33870f2ae21c",
                                                "sense_id": "0fe5c7c9-6426-391d-82f4-e3e9fe64d366",
                                                "text": "Un officiel est venu. Il s’est fait photographier regardant les ruines d’un air triste. Au magnésium, parce que le jour est encore trop sombre. Il est vite reparti, en auto, pour un autre quartier, un endroit où on a déjà recueilli des blessés, pour se faire photographier au poste de secours, penché sur eux, ou serrant la main d’une pauvre vieille à qui on va couper les jambes."
                                            },
                                            {
                                                "example_id": "68a56972-2105-4625-9c78-b4094ad2b8c9",
                                                "sense_id": "0fe5c7c9-6426-391d-82f4-e3e9fe64d366",
                                                "text": "Dans la lueur du magnésium, on put voir que la femme était jeune encore et qu’il y avait du sang qui coulait de sa bouche en minces filets épars et qu’il y en avait aussi sur le visage de l’homme qui l’avait embrassée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
