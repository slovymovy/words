                        "source_sense_id": "68171d1c-eab0-3c9e-8418-2a2d0a70f438",
                        "source_sense_description": "a simple four-wheeled Russian cart without springs",
                        "target_lang_word": "теле́га",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "теле́га",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f518c54c-32ab-3d2b-9737-b43e914dd8b1",
                                        "entry_id": "db92557b-fa83-311a-9032-87a2f369dd23",
                                        "glosses": [
                                            "четырёхколёсная повозка с низким кузовом и оглобельной или дышловой упряжкой, для перевозки кого-либо, чего-либо живой тягой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4b873bc-d065-41d6-83ac-9b04c44104b9",
                                                "sense_id": "f518c54c-32ab-3d2b-9737-b43e914dd8b1",
                                                "text": "Пётр порыбачить на местный пруд приехал на лошади, запряженной в телегу."
                                            },
                                            {
                                                "example_id": "eef7694f-44e3-44f9-b0b7-3327c35f08fa",
                                                "sense_id": "f518c54c-32ab-3d2b-9737-b43e914dd8b1",
                                                "text": "Просёлочным путем люблю скакать в телеге."
                                            },
                                            {
                                                "example_id": "e2082aea-3cd6-4414-9a0c-27affde05a95",
                                                "sense_id": "f518c54c-32ab-3d2b-9737-b43e914dd8b1",
                                                "text": "В полутьме у входа виднелась телега, лошадь стукнула копытом в гнилые доски."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1934bf-096b-31e9-9342-71061a1b1a20",
                                        "entry_id": "db92557b-fa83-311a-9032-87a2f369dd23",
                                        "glosses": [
                                            "перен. тяжёлая, неблагодарная работа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51d842ad-f3eb-4a79-a6ec-20b886a9aa59",
                                                "sense_id": "0b1934bf-096b-31e9-9342-71061a1b1a20",
                                                "text": "Есть намного более достойные люди чем я, но если вы проголосуете, то я уже буду тянуть эту телегу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86dc118d-9787-3a63-b38b-5d863aaaf65a",
                                        "entry_id": "db92557b-fa83-311a-9032-87a2f369dd23",
                                        "glosses": [
                                            "разг. письменная жалоба, кляуза, донос"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cf5cf5-e187-404d-b4cc-b9f508902419",
                                                "sense_id": "86dc118d-9787-3a63-b38b-5d863aaaf65a",
                                                "text": "Оказывается, сын тренера с друзьями настрочили на меня телегу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc8f5193-1b01-3c8b-9ab5-6f8997bbddcd",
                                        "entry_id": "db92557b-fa83-311a-9032-87a2f369dd23",
                                        "glosses": [
                                            "разг. то же, что тележка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b208121-3953-4ae4-8718-1593c8de4f4e",
                                                "sense_id": "fc8f5193-1b01-3c8b-9ab5-6f8997bbddcd",
                                                "text": "В супермаркете набрала полную телегу продуктов всяких, чтобы на неделю снеди хватило."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a45af7c-506f-33bc-b5f1-d3cef91ec2f5",
                                        "entry_id": "db92557b-fa83-311a-9032-87a2f369dd23",
                                        "glosses": [
                                            "разг. много"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "414ebc5b-6946-4d58-9f65-aac2d65d0d4b",
                                                "sense_id": "0a45af7c-506f-33bc-b5f1-d3cef91ec2f5",
                                                "text": "Друг наш, когда разыгрывали по карте призы, выиграл телегу всякой всячины."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28546d0-751e-3b1d-9616-c742ad11332b",
                                        "entry_id": "db92557b-fa83-311a-9032-87a2f369dd23",
                                        "glosses": [
                                            "жарг., муз. песня в жанре хип-хоп; рэп-куплеты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d47b9fc-b43f-4cc6-bdf9-4ece6dbed9f4",
                                                "sense_id": "a28546d0-751e-3b1d-9616-c742ad11332b",
                                                "text": "Я вырубил видик и включил свою телегу, // Девчонки закричали, это было к месту, // Все мои слова наизусть напевали, // Под «Bad B.» и «Легальный бизне$$» люстру сломали!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188eb5fe-9db9-3d8f-8eaf-d50f3224a31c",
                                        "entry_id": "db92557b-fa83-311a-9032-87a2f369dd23",
                                        "glosses": [
                                            "жарг. машина, автомобиль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9977414-3258-4376-878e-e32258838ba5",
                                                "sense_id": "188eb5fe-9db9-3d8f-8eaf-d50f3224a31c",
                                                "text": "Бездна на подъёме, за двести на приёме, // Далеко уносят мысли о погоне на склоне, // Перед мостом разгон, мы сравняли телеги, // Как будто Тарантино снимал меня в своём сюжете!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "теле́га",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b26d7f93-1549-3957-9147-8ca8153fbc36",
                                        "entry_id": "cfa3a34c-2818-34a3-bcf7-0a99d89800cf",
                                        "glosses": [
                                            "интернет. мессенджер Telegram"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8317cd9d-9079-40ca-9280-b4d2364d5dd3",
                                                "sense_id": "b26d7f93-1549-3957-9147-8ca8153fbc36",
                                                "text": "Я один не понял, почему РосКомПозор телегу блочит? Она ж децентрализованная!"
                                            }
