                "senses": [
                    {
                        "sense_id": "6d93672b-1f86-3916-a338-508500f31f8c",
                        "entry_id": "a1470884-102c-345e-a4ff-bec3059136ed",
                        "glosses": [
                            "Se sponsoriser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf94b557-eac3-41ad-833d-5b89ef33befb",
                                "sense_id": "6d93672b-1f86-3916-a338-508500f31f8c",
                                "text": "Est-il envisageable de se s'\"auto-sponsoriser\", ou de sponsoriser nos actionnaires lors d'évènements ponctuels ?"
                            },
                            {
                                "example_id": "cb0b1607-ff3f-40c5-96ac-ec8a5d3ddeb7",
                                "sense_id": "6d93672b-1f86-3916-a338-508500f31f8c",
                                "text": "Puis-je me sponsoriser moi-même ? Oui. Vous pouvez parfaitement vous auto-sponsoriser."
                            },
                            {
                                "example_id": "6489ceda-c913-494a-8b41-0688f4ddb872",
                                "sense_id": "6d93672b-1f86-3916-a338-508500f31f8c",
                                "text": "Le ressortissant étranger peut aussi utiliser ses propres compétences afin de s'auto-sponsoriser pour la demande de carte verte."
                            }
                        ]
                    }
