                        "examples": [
                            {
                                "example_id": "081f1260-21a4-4647-864b-0d7a9699167c",
                                "sense_id": "a08715ed-4155-3047-8e65-cbd72ae1f97f",
                                "text": "Demonstranten gingen de straat op tegen de nieuwe arbeidswet. Het kwam tot rellen met de politie. De Franse ME voerde charges uit en schoot met traangas op demonstranten."
                            },
                            {
                                "example_id": "2a563395-bbcb-4720-92da-bd50afbb9727",
                                "sense_id": "a08715ed-4155-3047-8e65-cbd72ae1f97f",
                                "text": "De Franse regering houdt het vertrouwen van het parlement, ondanks de invoering van een omstreden arbeidswet die het ontslaan van mensen makkelijker moet maken. Premier Valls negeerde de tegenstanders van de wet en voerde die per decreet in."
                            }
                        ]
