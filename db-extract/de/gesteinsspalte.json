                ],
                "senses": [
                    {
                        "sense_id": "97741a27-36e7-33b0-bcf1-dae97806cb66",
                        "entry_id": "261629b9-464d-37da-bfb5-f153f91d6f08",
                        "glosses": [
                            "eine Spalte, also ein schmaler Einschnitt oder länglicher Riss, im Gestein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a251a901-3614-4a33-ba20-ac80013f6668",
                                "sense_id": "97741a27-36e7-33b0-bcf1-dae97806cb66",
                                "text": "„Lebewesen gedeihen auch in Höhlen und einige Bakterien überleben in mit Wasser gefüllten Gesteinsspalten tief unter der Erde.“"
                            },
                            {
                                "example_id": "06e851b9-a4e6-4428-94fc-800fc81fd1bb",
                                "sense_id": "97741a27-36e7-33b0-bcf1-dae97806cb66",
                                "text": "„Die Arbeiten kamen am Mittwochabend kurzzeitig zum Erliegen, da wegen einer Gesteinsspalte die Schachtwände mit Zement befestigt werden mussten.“"
                            },
                            {
                                "example_id": "cea9bfee-539f-4863-bd04-fbdc097b3773",
                                "sense_id": "97741a27-36e7-33b0-bcf1-dae97806cb66",
                                "text": "„Möglicherweise habe die Förderung die Spannung einer unter der Gaslagerstätte gelegenen Gesteinsspalte erhöht, die daraufhin gebrochen sei.“"
                            },
                            {
                                "example_id": "c8ca68fb-ca2e-45fc-8d22-81d5545fecf4",
                                "sense_id": "97741a27-36e7-33b0-bcf1-dae97806cb66",
                                "text": "„Die Klobürste, mit der er am frühen Morgen noch gespielt hatte, wie die alte Dame neben uns verriet, hatte er achtlos in eine Gesteinsspalte versenkt.“"
                            },
                            {
                                "example_id": "434132c8-77a8-4e35-9923-6e5b508d31b4",
                                "sense_id": "97741a27-36e7-33b0-bcf1-dae97806cb66",
                                "text": "„Obwohl die Erschütterungen in dieser Gesteinsspalte fast immer von den gleichen Erdbebenherden ausgehen, zeigten die damit verbundenen Wellen unterschiedliche Muster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
