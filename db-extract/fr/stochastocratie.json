                    }
                ],
                "senses": [
                    {
                        "sense_id": "487a33fc-e873-36ff-a4dc-f7577478cfa3",
                        "entry_id": "f7e21d52-b4ce-37f1-9f62-6e9d84ae75e2",
                        "glosses": [
                            "Forme de gouvernement où les représentants du peuple sont tirés au sort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39692ad6-a310-472c-8eb9-0512fe9b83a9",
                                "sense_id": "487a33fc-e873-36ff-a4dc-f7577478cfa3",
                                "text": "L’humanité a presque entièrement déserté la Terre qui est redevenue un jardin, et où un système politique assez singulier, la stochastocratie, s’est installé. Dans ce système, le pouvoir est conféré par le hasard."
                            },
                            {
                                "example_id": "38cfe190-f367-4a76-96c4-e19c8b6e12b3",
                                "sense_id": "487a33fc-e873-36ff-a4dc-f7577478cfa3",
                                "text": "La stochastocratie pallie des défauts et faiblesses de la démocratie en évitant les pièges de son contraire."
                            },
                            {
                                "example_id": "96a43fc2-2ab0-460f-81b3-8f6289d0d1c3",
                                "sense_id": "487a33fc-e873-36ff-a4dc-f7577478cfa3",
                                "text": "Votre stochastocratie est démocratique, certes, mais non républicaine, la république étant un régime représentatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b836578-9f7c-4401-967b-44878b742698",
                        "source_entry_id": "f7e21d52-b4ce-37f1-9f62-6e9d84ae75e2",
