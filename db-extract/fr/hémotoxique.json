                        "entry_id": "4e1cb5de-9cb1-3480-9d9d-9749e18406df",
                        "glosses": [
                            "Qualifie un empoisonnement du sang par altération des cellules sanguines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb6b8176-226d-47c8-a900-ea54b4d6e587",
                                "sense_id": "43971206-bb1e-391f-adaf-99d90100c847",
                                "text": "Il existe des formes graves (30 % des cas) où le gonflement évolue en œdème violacé, qui traduit l’action hémotoxique du venin."
                            }
                        ]
                    },
                    {
                        "sense_id": "96015a6f-bd41-30f8-aab4-b7400c87e533",
                        "entry_id": "4e1cb5de-9cb1-3480-9d9d-9749e18406df",
                        "glosses": [
                            "Qualifie un agent chimique qui empêche l’utilisation de l’oxygène par l’organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93cd5ada-663a-48dd-a0b9-834d0ce20099",
                                "sense_id": "96015a6f-bd41-30f8-aab4-b7400c87e533",
                                "text": "Les agents hémotoxiques, comme l’acide cyanhydrique ou le chlorure de cyanogène, agissent en bloquant les échanges sanguins au niveau des cellules en paralysant les systèmes biochimiques d’utilisation de l’oxygène."
                            }
                        ]
                    }
                ],
