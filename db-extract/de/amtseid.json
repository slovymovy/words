                    {
                        "translation_id": "03c0df61-c375-4a83-85be-61ff2ef9cfd3",
                        "source_entry_id": "941568a0-5a76-372e-872a-db3d0e8e32df",
                        "source_sense_id": "98b1c0e7-8d62-38e2-b17d-7569b5ff552a",
                        "source_sense_description": "feierliches Versprechen, die Aufgaben verfassungsgemäß beziehungsweise gesetzestreu zu erfüllen",
                        "target_lang_word": "oath of office",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oath of office",
