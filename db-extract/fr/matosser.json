                ],
                "senses": [
                    {
                        "sense_id": "568ca512-c0e6-3586-b8a8-645e49a0cca3",
                        "entry_id": "99e728aa-9aed-32af-951a-ff3399033f00",
                        "glosses": [
                            "Déplacer du matériel (matos) à bord d’une embarcation afin d’améliorer son assiette (équilibre) en fonction des conditions rencontrées ou prévues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e81a79e-ad8b-4847-80ad-6fc0f64f6084",
                                "sense_id": "568ca512-c0e6-3586-b8a8-645e49a0cca3",
                                "text": "Je bats un nouveau record : 32,37 nœuds. Tout content, j’envoie la photo de mon afficheur de vitesse à mon équipe. A chaque empannage, il faut matosser. Épuisant."
                            },
                            {
                                "example_id": "74a46097-7231-453c-ad98-aee123041550",
                                "sense_id": "568ca512-c0e6-3586-b8a8-645e49a0cca3",
                                "text": "J’ai un repère horaire précis avec l’ordinateur : je suis en train de matosser, donc en pleine action physique, rien voir avec une situation assise où, tu somnoles, tu t’endors, c’est presque normal..."
                            },
                            {
                                "example_id": "d0c34955-7c5b-4392-9819-c3152163c187",
                                "sense_id": "568ca512-c0e6-3586-b8a8-645e49a0cca3",
                                "text": "Les nombreux virements de bord sont propices à l’apprentissage. Je transfère le ballast, je matosse sur l’autre bord, je vire, je transfère à nouveau le ballast, je matosse sur bâbord, je vire à nouveau..."
                            }
                        ]
                    }
