                "senses": [
                    {
                        "sense_id": "b108a6dc-2d65-3488-a74d-d643d820f2c8",
                        "entry_id": "42af7db0-a9a2-3e0d-a1c2-fd1e5f4c36a6",
                        "glosses": [
                            "Like or characteristic of grounds; coarse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5300427f-26fe-4cc5-ab01-9f98685fc217",
                                "sense_id": "b108a6dc-2d65-3488-a74d-d643d820f2c8",
                                "text": "Procure a green-backed, fresh-water pike of about five pounds (the darker ones are generally soft and have a groundy taste) ; […])"
                            },
                            {
                                "example_id": "ca365008-2db2-4d37-8fd5-4dd1f95300e9",
                                "sense_id": "b108a6dc-2d65-3488-a74d-d643d820f2c8",
                                "text": "So having given us some of the groundiest coffee it has ever been my fortune to encounter, and some cigarettes like his own, which were capital smoking, he sat and looked at us till we did not think that we were getting any ' forarder.'"
                            },
                            {
                                "example_id": "48b39585-db32-4eba-8247-4edd41f9cbc3",
                                "sense_id": "b108a6dc-2d65-3488-a74d-d643d820f2c8",
                                "text": "There wasn't much difference, except that the coffee wasn't so groundy."
                            },
                            {
                                "example_id": "8570e968-de0f-4a82-826a-1efb63214b6f",
                                "sense_id": "b108a6dc-2d65-3488-a74d-d643d820f2c8",
                                "text": "So, from an examination of the taste and smell of coffees, the taster knows if a coffee is “soft” or “hard” or “Rioy”; if it is sound or fermented (from improper curing); if it is groundy or mouldy or “hidey.” Coffee is often bought “on description.”"
                            },
                            {
                                "example_id": "c9934a86-64cd-4d17-91f5-0a7311c351fa",
                                "sense_id": "b108a6dc-2d65-3488-a74d-d643d820f2c8",
                                "text": "It is this fat that gives his flesh a groundy taste. When the meat is freed of fat, it is both tender and delicious. It tastes not unlike dark meat of turkey."
                            }
                        ]
                    }
