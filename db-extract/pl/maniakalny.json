                        "source_sense_id": "ac8d37b0-64a4-364c-9843-8464f33983ab",
                        "target_lang_word": "maniacal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maniacal",
