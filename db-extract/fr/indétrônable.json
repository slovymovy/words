                "translations": [
                    {
                        "translation_id": "d11b59f2-8b27-4d63-869e-e8bf7f8026a0",
                        "source_entry_id": "3547e0ba-08fa-30b8-a9eb-2510960e3453",
                        "source_sense_id": "0d6bb89f-77cc-3dbe-bf74-89cba90feedd",
                        "target_lang_word": "unschlagbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unschlagbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d07e3f85-d10e-32c0-bff5-28f354bde49d",
                                        "entry_id": "4e9d8e80-77ed-3290-be43-5854a4ede232",
                                        "glosses": [
                                            "sich nicht besiegen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10950d31-4fa3-4a54-9a17-c59d0e3dce4f",
                                                "sense_id": "d07e3f85-d10e-32c0-bff5-28f354bde49d",
                                                "text": "Der Tiefpunkt war 2000 erreicht, als die Mannschaft, die Beckenbauer als unschlagbar bezeichnet hatte, in der Gruppenphase der EM ausschied, ohne ein einziges Spiel gewonnen zu haben."
                                            },
                                            {
                                                "example_id": "70c68959-5d2e-42a5-ba0d-a1f493196df8",
                                                "sense_id": "d07e3f85-d10e-32c0-bff5-28f354bde49d",
                                                "text": "\"Normalen Kunden sind doch ein paar zusätzliche Milligramm Emissionen völlig egal. Denen ist viel wichtiger, dass sie für ihr Geld auch das beste Auto bekommen. Und da ist VW unschlagbar\", sagt er dem DW-Reporter vor dem Autohaus und zieht an seiner Zigarette."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f074b78-2838-4a77-9b74-9e3fd986cc76",
                        "source_entry_id": "3547e0ba-08fa-30b8-a9eb-2510960e3453",
                        "source_sense_id": "0d6bb89f-77cc-3dbe-bf74-89cba90feedd",
                        "target_lang_word": "unangefochten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unangefochten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                        "entry_id": "b602c363-57c9-39c6-b50f-202a71a9eec6",
                                        "glosses": [
                                            "von niemandem behindert/gehindert/bezweifelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f514e261-c514-4518-b6f7-af1ccf6d3ca1",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "Daniela Ryf war die unangefochtene Siegerin des Triathlon. [Anmerkung: keiner konnte mit Ihr mithalten]"
                                            },
                                            {
                                                "example_id": "137126c7-e565-4944-84c0-17416b50ab96",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„In der Tabelle liegt der FC Bayern mit jetzt vier Minuspunkten […] weiterhin unangefochten auf dem ersten Platz […].“"
                                            },
                                            {
                                                "example_id": "0aff9acd-45c9-452a-bcf6-2f3940a7d74f",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Es sind keine leichten Zeiten, welche Novak Djokovic aktuell durchlebt. Noch vor kurzem die unangefochtene Weltnummer 1, musste der Serbe seinen Thron Andy Murray überlassen.“"
                                            },
                                            {
                                                "example_id": "b24f3e78-1106-4dc4-99d4-86468863e33a",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Doris Heinze ist in ihrer Arbeit unangefochten. Sie schaltet und waltet, wacht über große Produktionen.“"
                                            },
                                            {
                                                "example_id": "cfcdae85-3ef8-4074-acac-23721217054c",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Texas Guinan kannten alle, und zu ihr kamen alle. Die Tochter eines Gemüsehändlers war die unangefochtene Königin des New Yorker Nachtlebens während der Prohibition.“"
                                            },
                                            {
                                                "example_id": "afb3cf88-5bf1-469f-9101-98c412eef30d",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Nach der Rückkehr Michelangelos nach Florenz 1516, fiel Raffael die unangefochtene Führungsrolle unter den Malern, Architekten und Denkmalschützern in der Ewigen Stadt zu.“"
                                            },
                                            {
                                                "example_id": "9247599b-51ea-43a6-a83d-65e08444e850",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Zwar sicherte sich Merkels Wunschkandidatin Annegret Kramp-Karrenbauer beim CDU-Parteitag im vergangenen Jahr knapp den Vorsitz, unangefochten ist sie aber keinesfalls.“"
                                            },
                                            {
                                                "example_id": "7b7baa78-ebaf-4115-92a9-c61611349c65",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Unangefochten bleibt die alleinige Kompetenz der Mitgliedsstaaten [Anmerkung: der Europäischen Union] beim Gesundheitsschutz und der Seuchenbekämpfung.“"
                                            },
                                            {
                                                "example_id": "7f6d65d7-a029-4235-ac41-2d560fbab1f4",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Der amerikanische Sinologe Perry Link kratzt in seinem Gastkommentar am Bild der unangefochtenen Partei unter Xi Jinping.“"
                                            },
                                            {
                                                "example_id": "dd62660a-4aa3-4330-aea9-96188eceba60",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Ohne Übertreibung lässt es sich sagen, dass offene Software in vielen Bereichen der unangefochtene Taktgeber und Innovationstreiber ist.“"
                                            },
                                            {
                                                "example_id": "333682b1-b15c-4462-94d1-8287f5a9e122",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Bayern 1 und Bayern 2 verbuchen einen deutlichen Zugewinn an Hörern, BR-Klassik - ebenfalls mit Reichweitenzuwachs - bleibt unangefochten der Klassiksender Nummer eins.“"
                                            },
                                            {
                                                "example_id": "c3a06938-9ce8-4587-bf78-d10cc984f2d5",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Wien, Wien, nur du allein: Österreichs Hauptstadt ist mit dem „Economist“-Ranking endgültig zur unangefochtenen Nummer eins in Sachen Lebensqualität aufgestiegen.“"
                                            },
                                            {
                                                "example_id": "471d1c4b-3d83-482c-8e15-1d3608801bea",
                                                "sense_id": "c346e202-8e40-3e2a-b89c-ad6b6bc2eec1",
                                                "text": "„Der Roman entstand zwischen 1773 und 1775, erschien aber erst ein gutes Jahrzehnt nach Diderots Tod. Eine reguläre Veröffentlichung zu Lebzeiten hätte die Zensur auf den Plan gerufen, denn kaum eine der damals gültigen Wahrheiten blieb in dem Buch unerörtert und unangefochten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "955c3020-89dc-36bc-a23d-66a66fbab3b8",
                                        "entry_id": "b602c363-57c9-39c6-b50f-202a71a9eec6",
                                        "glosses": [
                                            "nicht bestritten, nicht in Revision/Berufung gegangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9487980-6a20-4b32-88f5-1f3399f3927f",
                                                "sense_id": "955c3020-89dc-36bc-a23d-66a66fbab3b8",
                                                "text": "„Bei Tod einer Partei fällt der Aussetzungsgrund weg, wenn die Erbfolge geklärt ist. Hiervon ist auszugehen, wenn der Erbschein erteilt wird und unangefochten bleibt.“"
                                            },
                                            {
                                                "example_id": "06bbd7e0-9cea-4b30-b47c-6cf452ddd101",
                                                "sense_id": "955c3020-89dc-36bc-a23d-66a66fbab3b8",
                                                "text": "„Der Bestechungsskandal in der Pensionskasse des Kantons Zürich, BVK, wird neu aufgerollt. Nur der Freispruch eines Angeklagten blieb unangefochten.“"
                                            },
                                            {
                                                "example_id": "1d30e151-7a4e-4e22-8163-3225cb4165d2",
                                                "sense_id": "955c3020-89dc-36bc-a23d-66a66fbab3b8",
                                                "text": "„Bezüglich der übrigen Schuldsprüche wie auch der festgestellten Tatbestandserfüllung in nicht selbst verschuldeter Schuldunfähigkeit erwuchs das erstinstanzliche Urteil unangefochten in Rechtskraft.“"
                                            },
                                            {
                                                "example_id": "705efd9d-5bf5-450b-b3de-4e578ec04773",
                                                "sense_id": "955c3020-89dc-36bc-a23d-66a66fbab3b8",
                                                "text": "„Das \"Ergänzungsurteil gemäß § 321 ZPO\" vom 10. November 2017 ist unangefochten geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "936aaf98-0b83-4ecf-8cf0-c7a31bfbf074",
                        "source_entry_id": "3547e0ba-08fa-30b8-a9eb-2510960e3453",
                        "source_sense_id": "0d6bb89f-77cc-3dbe-bf74-89cba90feedd",
                        "target_lang_word": "sattelfest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sattelfest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1918f9e9-3ad0-384e-a692-82089fdd0b91",
                                        "entry_id": "a6d64746-4087-3f50-bd2b-311dfdfba815",
                                        "glosses": [
                                            "etwas gut können, von etwas Bescheid wissen, sich mit etwas auskennen; sicher sein"
                                        ],
                                        "tags": [
                                            "in Bezug auf Personen",
                                            "in Bezug auf etwas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61d05a4-32b0-4f06-865e-44e252adecf0",
                                                "sense_id": "1918f9e9-3ad0-384e-a692-82089fdd0b91",
                                                "text": "„Die Matheprüfung bestehe ich locker, bei dem Thema bin ich sattelfest.“"
                                            },
                                            {
                                                "example_id": "f6b14429-bcbe-48d9-b5cb-a9c70038f7a0",
                                                "sense_id": "1918f9e9-3ad0-384e-a692-82089fdd0b91",
                                                "text": "In Spanisch bin ich noch wenig sattelfest."
                                            },
                                            {
                                                "example_id": "99bf6353-2c62-4721-9374-5996aaa22945",
                                                "sense_id": "1918f9e9-3ad0-384e-a692-82089fdd0b91",
                                                "text": "„Das war ein schwieriges Vorstellungsgespräch: der Interviewer hat mich Sachen gefragt, bei denen ich nicht sattelfest war.“"
                                            },
                                            {
                                                "example_id": "482c05ea-ea66-496c-929a-1de214f55340",
                                                "sense_id": "1918f9e9-3ad0-384e-a692-82089fdd0b91",
                                                "text": "Gegen diese drei offensiv- und laufstarken Gegner wird sich zeigen, wie sattelfest die Bayern-Abwehr wirklich schon ist, […]"
                                            },
                                            {
                                                "example_id": "0b34bbfd-23b7-4b24-b99f-de28d706ae3a",
                                                "sense_id": "1918f9e9-3ad0-384e-a692-82089fdd0b91",
                                                "text": "Doch gerade weil sie [US-Präsidentschaftskandidatin H. Clinton] bei Sachthemen sattelfest ist, meinen die Experten, müsse sie aufpassen, nicht zu abgehoben und akademisch zu wirken."
                                            },
                                            {
