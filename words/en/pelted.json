{
    "word_family": [
        "pelt",
        "pelting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c8f9e33-4d1e-34c6-bbe4-686d13b8b811",
                    "sense_definition": "simple past and past participle of <w>pelt</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry crowd <w>pelted</w> the stage with rotten vegetables.",
                            "target_lang_translations": {
                                "cs": "Rozzuřený dav <w>zasypal</w> pódium shnilou zeleninou."
                            }
                        },
                        {
                            "text": "Heavy rain <w>pelted</w> the roof all night long.",
                            "target_lang_translations": {
                                "cs": "Hustý déšť celou noc <w>bubnoval</w> do střechy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a příčestí minulé slovesa 'pelt', které znamená házet po někom předměty nebo prudce bít (např. o dešti)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "házet",
                                "target_lang_sense_clarification": "ve smyslu zasypat někoho předměty"
                            },
                            {
                                "target_lang_word": "bubnovat",
                                "target_lang_sense_clarification": "ve smyslu prudkého deště narážejícího na povrch"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aa1f50ff-724a-301c-8646-bf52ffe20237",
                    "sense_definition": "Having a specified kind of fur or skin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sleek, black-<w>pelted</w> animal moved silently through the forest.",
                            "target_lang_translations": {
                                "cs": "Elegantní zvíře s <w>černou srstí</w> se tiše pohybovalo lesem."
                            }
                        },
                        {
                            "text": "The thick-<w>pelted</w> bear was well-prepared for the harsh winter.",
                            "target_lang_translations": {
                                "cs": "Medvěd s <w>hustou srstí</w> byl dobře připraven na krutou zimu."
                            }
                        }
                    ],
                    "synonyms": [
                        "furred",
                        "coated"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající určitý druh srsti nebo kůže."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "srstnatý",
                                "target_lang_sense_clarification": "mající srst určitého typu"
                            },
                            {
                                "target_lang_word": "osrstěný",
                                "target_lang_sense_clarification": "mající srst"
                            }
                        ]
                    }
                }
            ]
        }
    ]
