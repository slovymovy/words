                        "examples": [
                            {
                                "example_id": "d3453295-afb5-4aa9-ab25-be32915ad815",
                                "sense_id": "8d53b155-2754-32b4-8601-15ab53c8188f",
                                "text": "„So soll auch Zia-ul-Haq selbst gescherzt haben, ein Coup sei nötig gewesen, um die Gebetsrichtung (qibla) der Politiker zu korrigieren.“"
                            },
                            {
                                "example_id": "6061d5c5-1ea5-4542-9d9b-23cb1e5201f2",
                                "sense_id": "8d53b155-2754-32b4-8601-15ab53c8188f",
                                "text": "„Die Beziehung des Islam zu Jerusalem gründet darauf, dass Muhammad die Stadt in der mekkanischen Zeit als Gebetsrichtung (qibla) vorschrieb; nach seinem Umzug nach Medina änderte er sie später auf Mekka.“"
                            }
                        ],
