                                    {
                                        "sense_id": "fcc534e9-360c-3f85-9ba7-1b2d4c4a228a",
                                        "entry_id": "63df6122-a268-301d-9bc1-0c59a86671e5",
                                        "glosses": [
                                            "Any of various parasitic bloodsucking roundworms which cause disease, especially the species Ancylostoma duodenale and Necator americanus, having hooked mouthparts and entering their hosts by boring through the skin."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395b2ac2-2e02-46d4-9a6d-279f4057b877",
                                                "sense_id": "fcc534e9-360c-3f85-9ba7-1b2d4c4a228a",
                                                "text": "A heavy infestation of more than 100 hookworms can suck up as much as 16 fluid ounces of blood a day. Since hookworm larvae can be transmitted through a mother's milk, infestations can kill infants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01321cdd-337e-3df8-a25b-70a2e1e3fc7b",
                                        "entry_id": "63df6122-a268-301d-9bc1-0c59a86671e5",
                                        "glosses": [
                                            "Infection with one of these parasites."
                                        ],
