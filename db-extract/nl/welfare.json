                        "sense_id": "1c10bb00-2016-303f-946c-85824f5d6ed2",
                        "entry_id": "b33e4191-9bfe-3cb4-ba15-ae4453b0f063",
                        "glosses": [
                            "bezigheid gericht op het sociaal- en psychisch welbevinden van de deelnemers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97097a02-b5df-4a85-bee9-6d8813bde427",
                                "sense_id": "1c10bb00-2016-303f-946c-85824f5d6ed2",
                                "text": "De welfare is 54 jaar geleden ontstaan uit de rooms-katholieke zuil en was vooral bedoeld voor vrouwen die niet werkten, maar zich geheel toelegden op het gezin en het huishouden en daardoor soms enigszins in een sociaal isolement terecht kwamen."
                            },
                            {
                                "example_id": "a43ec1f6-248c-41b7-8213-0ec4dee19798",
                                "sense_id": "1c10bb00-2016-303f-946c-85824f5d6ed2",
                                "text": "De dames vormen ook een gewaardeerd vrijwilligersduo bij De Zonnebloem. Zo verzorgen zij samen iedere dinsdag de handwerkgroep in het Kulturhus, de Welfare."
                            }
                        ]
                    }
