                        "entry_id": "56720093-2396-344c-b7cf-f2e9b81f0d43",
                        "glosses": [
                            "Personne qui torture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "730d6227-b45e-4cc6-82ca-985a7c53d27d",
                                "sense_id": "a33a24c0-d84a-3e5f-a9ba-f8dd472a8825",
                                "text": "Seulement, au mouvement de ses lèvres, le tortureur devina que la force seule avait manqué à Pèlerin pour répondre une fois de plus : « Je ne sais pas !... »"
                            },
                            {
                                "example_id": "5f21ab8f-3674-4f8e-9bfb-f53502f388e3",
                                "sense_id": "a33a24c0-d84a-3e5f-a9ba-f8dd472a8825",
                                "text": "Juges et tortureurs font en réalité même cas de la petite vie supprimée."
                            },
                            {
                                "example_id": "b476398c-c25f-482c-8d11-67138d2bc609",
                                "sense_id": "a33a24c0-d84a-3e5f-a9ba-f8dd472a8825",
                                "text": "Et, dans l’espoir de hâter le bienfait, il adressa lui-même un message téléphonique à la tortureuse."
                            }
                        ]
                    }
