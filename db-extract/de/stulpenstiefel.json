                                        "entry_id": "eaee8f4c-94d8-3495-924e-7aec1957a2fd",
                                        "glosses": [
                                            "A high boot, generally with a band of light-coloured leather around the upper part of the leg; a riding boot."
                                        ],
                                        "tags": [],
