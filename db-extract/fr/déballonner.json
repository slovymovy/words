                "senses": [
                    {
                        "sense_id": "80be197a-e1b3-334e-8fd0-398ab7a7b37b",
                        "entry_id": "89f506ce-9705-34f8-87a6-8b2c090516d5",
                        "glosses": [
                            "de moed verliezen, afhaken"
                        ],
                        "tags": [
