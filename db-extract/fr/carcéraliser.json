                ],
                "senses": [
                    {
                        "sense_id": "ad9173c6-876b-309e-ae87-e392081ead5b",
                        "entry_id": "75898939-cd0a-3fa6-affd-93f4c5c59911",
                        "glosses": [
                            "Donner un caractère carcéral à."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "c04d4f04-ac31-4c75-952f-676220bcef1e",
                                "sense_id": "ad9173c6-876b-309e-ae87-e392081ead5b",
                                "text": "De quoi s’agit-il ? De fusionner l’espace carcéral et la société, de carcéraliser la société."
                            },
                            {
                                "example_id": "33be001b-fdb6-4cbd-8570-30f5872ffbfe",
                                "sense_id": "ad9173c6-876b-309e-ae87-e392081ead5b",
                                "text": "Ainsi risquent-ils plus facilement de se carcéraliser."
                            },
                            {
                                "example_id": "6bfd36ab-a2a0-47cd-b6ab-e7cff9856c1d",
                                "sense_id": "ad9173c6-876b-309e-ae87-e392081ead5b",
                                "text": "Sous l’influence de quels discours, nos sociétés pourraient-elles se « carcéraliser » ?"
                            },
                            {
                                "example_id": "b29656ca-3802-42fb-ad12-ea20ba4680e1",
                                "sense_id": "ad9173c6-876b-309e-ae87-e392081ead5b",
                                "text": "Il est en train de se carcéraliser. — Qu’est-ce que ça veut dire se carcéraliser ? — Il s’habitue. Il prend goût à l’inactivité. La prison, on s’y fait, on n’y est pas si mal quand on est oisif de nature, et peu exigeant. — (Sophie et Dominique Moulinas, Parents à perpétuité)"
                            }
                        ]
                    }
