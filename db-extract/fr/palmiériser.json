                "senses": [
                    {
                        "sense_id": "f05bf563-a0ef-37aa-b4bc-882c02932d5c",
                        "entry_id": "339f7169-1d8a-3e23-9d6e-f3371ce08f2b",
                        "glosses": [
                            "Doter de palmiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9845a33-2560-4548-9bf0-c74cb1dcc752",
                                "sense_id": "f05bf563-a0ef-37aa-b4bc-882c02932d5c",
                                "text": "Paris ont résolu de parasoliser Paris. Et de le palmiériser. Et de le boulodromiser. Et de le transatiser. Et de le littoraliser. Sur trois kilomètres."
                            },
                            {
                                "example_id": "a0b12555-7c41-4a6e-a447-6e1d5932a7fd",
                                "sense_id": "f05bf563-a0ef-37aa-b4bc-882c02932d5c",
                                "text": "Même si cette démarche nous permet d'isoler chaque catégorie, en fait l'observateur sur le terrain ne pas aussi facilement les types de palmeraie et garde impression dominante celle d'un paysage inégalement « palmiérisé »."
                            },
                            {
                                "example_id": "796105c6-f485-474d-a678-3f1688d7d96d",
                                "sense_id": "f05bf563-a0ef-37aa-b4bc-882c02932d5c",
                                "text": "Pornic, Pornic outragé, Pornic brisé, Pornic martyrisé, Pornic palmiérisé, Pornic botaniqué, Pornic escalatorisé. Mais Pornic libéré."
                            }
                        ]
                    }
