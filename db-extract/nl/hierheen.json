        "nl-extract.jsonl": [
            {
                "entry_id": "4dd88a92-4e3a-33cf-9bdd-8ac1aeb835c2",
                "word": "hierheen",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "184ea6d3-68b2-3e6e-b674-13b6ce6184b8",
                        "entry_id": "4dd88a92-4e3a-33cf-9bdd-8ac1aeb835c2",
                        "glosses": [
                            "aanwijzend dichtbij: in de richting van + dit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a8e4f3-ac56-4c13-b688-02be6e7cc779",
                                "sense_id": "184ea6d3-68b2-3e6e-b674-13b6ce6184b8",
                                "text": "Komt hij hierheen? Of komt hij hier toch niet heen?"
                            },
                            {
                                "example_id": "3a4cbf0b-9f4e-4a74-9dbe-8dba0c79217c",
                                "sense_id": "184ea6d3-68b2-3e6e-b674-13b6ce6184b8",
                                "text": "Even later bevond ik me in dezelfde kamer als die eerste dag, die onvergetelijke dag dat Andrew en ik hierheen waren gekomen."
                            },
                            {
                                "example_id": "f28bc7cc-a142-4ea6-9e62-9f59e111ce22",
                                "sense_id": "184ea6d3-68b2-3e6e-b674-13b6ce6184b8",
                                "text": "Er zijn vijf kisten met elk acht muizen - de muizen die onaangeraakt zijn gebleven door de hand der wetenschap (op de raket na waarmee ze hierheen zijn gebracht); de muizen die regelmatig worden geïnjecteerd om te voorkomen dat hun spieren wegteren, en de gemodificeerde muizen die al vanaf hun geboorte extra fors en fit zijn zodat ze zijn toegerust voor een leven zonder zwaartekracht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ab458b8-9884-4c26-bf35-55be6259450f",
                        "source_entry_id": "4dd88a92-4e3a-33cf-9bdd-8ac1aeb835c2",
                        "source_sense_id": "184ea6d3-68b2-3e6e-b674-13b6ce6184b8",
                        "source_sense_description": "in deze richting",
                        "target_lang_word": "hierher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hierher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e5e2d37-de14-37d0-b546-cc3b954dd24f",
                                        "entry_id": "19cc4aea-6d84-30f8-95b1-528ec2e62789",
                                        "glosses": [
                                            "nach hier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01570a23-6a8f-48f8-b247-709606135c27",
                                                "sense_id": "5e5e2d37-de14-37d0-b546-cc3b954dd24f",
                                                "text": "Jetzt habe ich drei Jahre lang Deutsch gelernt, komme hierher und verstehe kein einziges Wort!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3039add-7766-4143-935b-4d3c885c1eb4",
                        "source_entry_id": "4dd88a92-4e3a-33cf-9bdd-8ac1aeb835c2",
                        "source_sense_id": "184ea6d3-68b2-3e6e-b674-13b6ce6184b8",
                        "source_sense_description": "in deze richting",
                        "target_lang_word": "сюда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сюда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "02cb0db9-cff3-37e3-9d64-f62405fa29f2",
                                        "entry_id": "b71bb7f5-48c3-3177-b5bb-18bfe22abbc3",
                                        "glosses": [
                                            "в это место, по направлению в сторону говорящего"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e807f4-04c7-458c-9135-81b80538f144",
                                                "sense_id": "02cb0db9-cff3-37e3-9d64-f62405fa29f2",
                                                "text": "Двух годов ещё нет, как его сюда прислали, а уж наделал делов."
                                            },
                                            {
                                                "example_id": "0d44795b-64b4-4750-9e75-b58aeba35026",
                                                "sense_id": "02cb0db9-cff3-37e3-9d64-f62405fa29f2",
                                                "text": "Иди сюда!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0abe99c1-d324-3ad6-a72c-f3628cffb38b",
                                        "entry_id": "b71bb7f5-48c3-3177-b5bb-18bfe22abbc3",
                                        "glosses": [
                                            "в направлении, указанном говорящим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd13ac8d-6671-4ddb-a813-5ddb5d3c6535",
                                                "sense_id": "0abe99c1-d324-3ad6-a72c-f3628cffb38b",
                                                "text": "Идите вот сюда, в эту дверь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04060cf3-9d12-37e8-9a89-200ab6c3743c",
                                        "entry_id": "b71bb7f5-48c3-3177-b5bb-18bfe22abbc3",
                                        "glosses": [
                                            "перен. к данному моменту, к описываемому обстоятельству, к сути данного дела"
                                        ],
                                        "tags": [
                                            "(об отношении)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c47f44e-8087-4777-822e-ed60676c37b2",
                                                "sense_id": "04060cf3-9d12-37e8-9a89-200ab6c3743c",
                                                "text": "Конечно, насмешники мои многого не знали и не предчувствовали в моих мучениях. Наполовину входило сюда одно сокровенное обстоятельство, которого сам я и не успел и как-то пугался до сих пор разбирать."
                                            },
                                            {
                                                "example_id": "53a96109-37e6-490a-8249-b6e5e04c25f9",
                                                "sense_id": "04060cf3-9d12-37e8-9a89-200ab6c3743c",
                                                "text": "Описание моря с фольклористической, живописной, геологической точки зрения, часто связанное с обращением, сюда не относится, так как явно, что обращение здесь лишь приём, и подлинный собеседник — некто иной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
