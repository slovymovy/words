                        "glosses": [
                            "Nager un peu, nager avec difficulté."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d3ef493f-e666-3fb3-b880-c9f222e6d37d",
                        "entry_id": "5dbb1176-0957-3733-80ae-648adbd60b2d",
                        "glosses": [
                            "S'agiter légèrement, comme quelqu'un qui barbote dans l'eau."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "318251cf-a368-410c-96c1-5aa9061c65e2",
                                "sense_id": "d3ef493f-e666-3fb3-b880-c9f222e6d37d",
                                "text": "Les feuilles des trembles, qui tournaient tout à l’heure leur dos d’argent vers le ciel, refrétillent et nageotent à nouveau dans le courant d’air."
                            },
                            {
                                "example_id": "4faa41df-28f8-472c-be26-33b88d27ce91",
                                "sense_id": "d3ef493f-e666-3fb3-b880-c9f222e6d37d",
                                "text": "Le Meunier continuait de surveiller son bouchon qui nageotait, hésitant à plonger."
                            }
                        ]
                    }
