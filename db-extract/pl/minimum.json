                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c930952e-3daa-435e-9a05-a68074bfb581",
                                                "sense_id": "d4f4ba2f-120f-33c7-9ba6-c5c807485937",
                                                "text": "Минимум и синуса, и косинуса на вещественной оси равняется −1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193d1113-70cf-38b1-bbb0-39e03b2b8653",
                                        "entry_id": "12ac9e95-8807-3490-b07f-610c23a1ca11",
                                        "glosses": [
                                            "самое малое, не меньше"
                                        ],
                                        "tags": [
                                            "в знач. наречия"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fffb88f-663c-4087-82b3-8e836d510dbf",
                                                "sense_id": "193d1113-70cf-38b1-bbb0-39e03b2b8653",
                                                "text": "Я был там минимум пять минут."
                                            }
