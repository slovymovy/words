                    {
                        "sense_id": "903e07f0-efc5-308e-bdeb-c3321ef8206a",
                        "entry_id": "b4f9acb0-352c-37fe-83e3-bec762da824f",
                        "glosses": [
                            "Eigenschaft einer Masse, halbfest und teigig (wie eine Paste, pastös) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac42f45d-9a8c-4824-9e09-c3d1a7a75888",
                                "sense_id": "903e07f0-efc5-308e-bdeb-c3321ef8206a",
                                "text": "„Die Konsistenz können Sie durch die Zugabe von Wasser (max. 10 %) beeinflussen, so dass Sie für die Verarbeitung eine optimale Pastösität erreichen.“"
                            },
                            {
                                "example_id": "6d39335c-5b84-424e-94ba-38e106f6ed31",
                                "sense_id": "903e07f0-efc5-308e-bdeb-c3321ef8206a",
                                "text": "„Aufgrund dieser Erfahrungen wurde der aus dem Betonbau bekannte Ausbreitversuch zur Bestimmung der Pastösität eingeführt.“"
                            },
                            {
                                "example_id": "794cdb0a-fdbf-48be-83ce-2c90322993f9",
                                "sense_id": "903e07f0-efc5-308e-bdeb-c3321ef8206a",
                                "text": "„Ihre in diesem Segment außergewöhnliche Pigmentkonzentration verleiht ihr eine cremige Konsistenz mit Heavy-Body-eingestufter Pastösität.“"
                            },
                            {
                                "example_id": "e57c1d6c-3294-4413-b5f3-6dd6b4e68636",
                                "sense_id": "903e07f0-efc5-308e-bdeb-c3321ef8206a",
                                "text": "„Selbst konstruierte Maschinen sorgen für die richtigen Temperaturen und die Pastösität der Pralinenmasse, die mindestens 41% Haselnuss enthält.“"
                            },
                            {
                                "example_id": "ba4c4afa-0a30-4d26-bf09-f3f868b46589",
                                "sense_id": "903e07f0-efc5-308e-bdeb-c3321ef8206a",
                                "text": "„Bei den hier angebotenen Spachtelmassen ist die Pastösität und Verarbeitunsgzeit des Materials vorgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
