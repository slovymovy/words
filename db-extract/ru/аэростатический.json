                "translations": [
                    {
                        "translation_id": "2f4d7943-0cb4-412b-a29c-88e6a4918ab9",
                        "source_entry_id": "307ca182-4bac-3f20-a292-36a07420973f",
                        "target_lang_word": "aerostatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aerostatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdcfc2d1-1dde-3eea-a9bc-9140f26d8358",
                                        "entry_id": "5aa01aa6-f18e-39e9-93aa-f78c92d068e2",
                                        "glosses": [
                                            "Of or pertaining to aerostatics; pneumatic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c9731a-cf2d-46fa-846f-aa1f32aa0dfb",
                                                "sense_id": "bdcfc2d1-1dde-3eea-a9bc-9140f26d8358",
                                                "text": "I have very much improved my mechanical combinations, for the navigation of the air and water by hydrostatic and aerostatic forces."
                                            },
                                            {
                                                "example_id": "6d4fa88f-d0ce-4391-b886-79a212e49713",
                                                "sense_id": "bdcfc2d1-1dde-3eea-a9bc-9140f26d8358",
                                                "text": "Atmospheric flight is dominated by the presence of atmospheric forces, which can be divided into aerostatic and aerodynamic categories."
                                            },
                                            {
                                                "example_id": "54e4b5a1-614e-4e67-b057-542bb9ac1346",
                                                "sense_id": "bdcfc2d1-1dde-3eea-a9bc-9140f26d8358",
                                                "text": "Hydrostatic and aerostatic guides are widely applied to precision feed tables, since their motion is accurate due to the lack of friction and wearing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a48f50-5355-3a87-b52d-5692d27c0673",
                                        "entry_id": "5aa01aa6-f18e-39e9-93aa-f78c92d068e2",
                                        "glosses": [
                                            "Pertaining to aerial navigation or aeronautics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6f78754-b616-4e87-bcef-86b5bd6a4f8f",
                                                "sense_id": "f8a48f50-5355-3a87-b52d-5692d27c0673",
                                                "text": "The general term for the machines used in this kind of navigation, is that of aërostats, or aërostatic machines; but those which are of a spherical figure, and filled with gas, are better known by the name of air-balloons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "634c7982-798a-4c58-9632-4eb10716f055",
                        "source_entry_id": "307ca182-4bac-3f20-a292-36a07420973f",
                        "target_lang_word": "aerostatyczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aerostatyczny",
