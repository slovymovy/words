{
    "word_family": [
        "tutor",
        "tutorship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27ebb140-74a4-3b16-9a93-df22e687e382",
                    "sense_definition": "A video, text guide, or set of instructions that explains how to perform a specific task or understand a topic.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I watched a video <w>tutorial</w> to learn how to fix the leaking tap.",
                            "target_lang_translations": {
                                "ru": "Я посмотрел <w>видеоурок</w>, чтобы научиться чинить протекающий кран.",
                                "zh": "我看了个视频<w>教程</w>，学会了怎么修漏水的水龙头。",
                                "es": "Vi un <w>tutorial</w> en video para aprender a arreglar el grifo que gotea."
                            }
                        },
                        {
                            "text": "Follow the step-by-step <w>tutorial</w> to install the new software on your computer.",
                            "target_lang_translations": {
                                "ru": "Следуйте пошаговой <w>инструкции</w>, чтобы установить новое программное обеспечение на свой компьютер.",
                                "zh": "请按照分步<w>指南</w>在你的电脑上安装新软件。",
                                "es": "Sigue el <w>tutorial</w> paso a paso para instalar el nuevo software en tu computadora."
                            }
                        }
                    ],
                    "synonyms": [
                        "guide",
                        "how-to",
                        "instruction",
                        "walkthrough",
                        "lesson"
                    ],
                    "common_phrases": [
                        "video tutorial",
                        "online tutorial",
                        "makeup tutorial",
                        "brief tutorial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Видео, текстовое руководство или набор инструкций, объясняющих, как выполнить определенную задачу или понять тему.",
                        "zh": "用于解释如何执行特定任务或理解某个主题的视频、文本指南或说明。",
                        "es": "Guía en video, texto o conjunto de instrucciones que explica cómo realizar una tarea específica o comprender un tema."
                    },
                    "translations": {
                        "ru": [
                            {
