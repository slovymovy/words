                                ]
                            },
                            {
                                "target_word": "Gouda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d12d966-f493-3714-95b7-ec1f078f92ad",
                                        "entry_id": "befae342-313b-3c2f-bc34-dd33f8c9e00a",
                                        "glosses": [
