                ],
                "senses": [
                    {
                        "sense_id": "940fba7d-a8c8-38a7-98b8-02b638266bf6",
                        "entry_id": "4911b3d4-24db-33ac-b559-caa3dd089bc0",
                        "glosses": [
                            "Fachsprache und Berufssprache der Bergleute"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2940025c-a1e3-4062-afb9-b7eb84c8f3fe",
                                "sense_id": "940fba7d-a8c8-38a7-98b8-02b638266bf6",
                                "text": "„Fast völlig rein von fremden Bestandteilen ist die Bergmannssprache (nur Kux ist tschechisches Lehnwort, um 1300 am Südhang des Erzgebirges übernommen).“"
                            },
                            {
                                "example_id": "ac40b350-a5f8-4b81-91dd-8ffde61dd11c",
                                "sense_id": "940fba7d-a8c8-38a7-98b8-02b638266bf6",
                                "text": "„Vor diesem Hintergrund wirkt es fast wie Ironie, dass man solch einen Stollen wie den, in den sich die Überlebenden von Lengede retten konnten, in der Bergmannssprache als alten Mann bezeichnet.“"
                            },
                            {
                                "example_id": "2b7197ca-91df-4561-9703-b04580ee9b42",
                                "sense_id": "940fba7d-a8c8-38a7-98b8-02b638266bf6",
                                "text": "„Eine Anhäufung von schweren oder widerstandsfähigeren Mineralien in Gewässern wird in der Bergmannssprache Seife genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
