                "senses": [
                    {
                        "sense_id": "2c11fc62-70cb-358a-8ab9-412231715e0e",
                        "entry_id": "98b4136e-b9b9-3c36-9dbf-41f69795b916",
                        "glosses": [
                            "Rendre tautologique."
                        ],
                        "tags": [
                            "Peu usité"
                        ],
                        "examples": [
                            {
                                "example_id": "2f097160-8681-426f-9a04-5634d581c1cb",
                                "sense_id": "2c11fc62-70cb-358a-8ab9-412231715e0e",
                                "text": "Pour la première fois d'ailleurs Jarzyna s'est abstenu de multiplier des effets, de tautologiser l'expression des acteurs par la piste sonore ou par la mise en scène."
                            }
                        ]
                    },
                    {
                        "sense_id": "990d0af9-c94a-3dfc-a3ce-feeb3f531efc",
                        "entry_id": "98b4136e-b9b9-3c36-9dbf-41f69795b916",
                        "glosses": [
                            "Dire, énoncer des tautologies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c057a06e-7442-4f60-ac8f-a117b80b8318",
                                "sense_id": "990d0af9-c94a-3dfc-a3ce-feeb3f531efc",
                                "text": "Car l'ouverture, n'hésitons pas à tautologiser en parlant d'ouverture au dehors, peut aussi bien prendre la forme d'une descente au plus profond de soi que celle d'une évasion vers un azur propre à donner le vertige."
                            }
                        ]
                    }
                ],
