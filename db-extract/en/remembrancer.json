                ],
                "senses": [
                    {
                        "sense_id": "8f11168c-6db4-3164-afe5-2ededd32d0b5",
                        "entry_id": "4075fce9-bfe3-304b-9581-ac80aa3e6b02",
                        "glosses": [
                            "Any of several former officials in the Court of Exchequer."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6aacac80-b587-355c-bb18-1ad6ef4df6c1",
                        "entry_id": "4075fce9-bfe3-304b-9581-ac80aa3e6b02",
                        "glosses": [
                            "A similar official of the City of London Corporation."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "8dd1726a-420f-45e6-a8ee-e11626e0135e",
                                "sense_id": "6aacac80-b587-355c-bb18-1ad6ef4df6c1",
                                "text": "“Thank you. Tuesday evening, in four days’ time, Daedra West hosts a gathering, the venue yet to be announced. Possibly one of the guildhalls. Her guest list, so far, is interesting.” She looked at Lev. “The Remembrancer himself may be there. Lesser faces from the City.[…]"
                            },
                            {
                                "example_id": "5ef513f8-c320-44c1-9a1e-9e6fa75bf14f",
                                "sense_id": "6aacac80-b587-355c-bb18-1ad6ef4df6c1",
                                "text": "In particular, Harkaway told him about the unelected offices of the Lord Mayor and the City Remembrancer, who can be mistaken for figureheads but, in fact, have extensive powers."
                            }
                        ]
                    }
                ],
