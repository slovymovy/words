                        "sense_id": "890e938e-294b-39b3-ace8-537ffd7297d4",
                        "entry_id": "7631b551-a616-377f-8c10-b5d80def1426",
                        "glosses": [
                            "Qui forme à un métier et permet donc de s’insérer directement sur le marché du travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d0a868-1f8a-45b0-8eab-09c2e30ab872",
                                "sense_id": "890e938e-294b-39b3-ace8-537ffd7297d4",
                                "text": "Mon parcours n’avait aucune valeur sur le marché du travail, mes six années d’études n’étaient ni prestigieuses ni professionnalisantes. Personne ne voulait de moi."
                            },
                            {
                                "example_id": "1fb3bf71-fbe6-4b20-85eb-1e166145cdee",
                                "sense_id": "890e938e-294b-39b3-ace8-537ffd7297d4",
                                "text": "C’est une formation professionnalisante ; les trois quarts de nos étudiants trouvent un travail dans le mois qui suit la réussite au diplôme."
                            }
                        ]
                    }
