        "nl-extract.jsonl": [
            {
                "entry_id": "0e62fdfd-2a7a-32fa-b636-e0a07257caa7",
                "word": "herleving",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "9ed9f06e-8b6f-4b44-b667-02dde1d4b890",
                        "entry_id": "0e62fdfd-2a7a-32fa-b636-e0a07257caa7",
                        "tags": [
