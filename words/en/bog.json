{
    "word_family": [
        "boggy",
        "bogland",
        "peat-bog",
        "cranberry-bog"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "199fd0df-4ba5-343d-802f-bd0b6726fe06",
                    "sense_definition": "An area of wet, spongy ground consisting of decayed vegetation, often too soft to support much weight.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to be careful not to step into the deep <w>bog</w> while crossing the valley.",
                            "target_lang_translations": {
                                "ru": "Туристам нужно было быть осторожными, чтобы не наступить в глубокое <w>болото</w>, пересекая долину."
                            }
                        },
                        {
                            "text": "A thick <w>bog</w> is easy to get lost in if you do not stay on the marked path.",
                            "target_lang_translations": {
                                "ru": "В густой <w>трясине</w> легко потеряться, если не придерживаться размеченной тропы."
                            }
                        }
                    ],
                    "synonyms": [
                        "swamp",
                        "mire",
                        "quagmire"
                    ],
                    "common_phrases": [
                        "thick bog",
                        "peat bog",
                        "sphagnum bog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок влажной, губчатой почвы, состоящий из разложившейся растительности, часто слишком мягкий, чтобы выдержать большой вес."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болото",
                                "target_lang_sense_clarification": "общий термин для переувлажненного участка земли"
                            },
                            {
                                "target_lang_word": "топь",
                                "target_lang_sense_clarification": "вязкое, глубокое и опасное место на болоте"
                            },
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "зыбкое, засасывающее место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67f23dda-9055-3529-b1c6-1caa477f1735",
                    "sense_definition": "A toilet or a place to defecate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toilet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been on the <w>bog</w> for twenty minutes and shows no sign of coming out.",
                            "target_lang_translations": {
                                "ru": "Он торчит на <w>толчке</w> уже двадцать минут и, похоже, не собирается выходить."
                            }
                        },
                        {
                            "text": "The old cottage only had an outdoor <w>bog</w> at the end of the garden.",
                            "target_lang_translations": {
                                "ru": "В старом коттедже был только уличный <w>сортир</w> в конце сада."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the bog"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in British English"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "UK and Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Туалет или место для дефекации (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "грубо-разговорное обозначение туалета"
                            },
                            {
                                "target_lang_word": "сортир",
                                "target_lang_sense_clarification": "просторечное название туалета"
                            },
                            {
                                "target_lang_word": "параша",
                                "target_lang_sense_clarification": "сленговое, часто тюремное или очень грубое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82d24bd0-7227-3e00-b3c1-b968efcfafba",
                    "sense_definition": "A state of confusion or a situation that hinders progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impediment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was lost in a <w>bog</w> of uncertainty after the main investor pulled out.",
                            "target_lang_translations": {
                                "ru": "Проект погряз в <w>болоте</w> неопределенности после того, как ушел основной инвестор."
                            }
                        },
                        {
                            "text": "His mind was in a <w>bog</w> as he tried to understand the complex legal documents.",
                            "target_lang_translations": {
                                "ru": "В голове у него была полная <w>каша</w> (вязкость), пока он пытался разобраться в сложных юридических документах."
                            }
                        }
                    ],
                    "synonyms": [
                        "mire",
                        "quagmire"
                    ],
                    "common_phrases": [
                        "bog of uncertainty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние замешательства или ситуация, препятствующая прогрессу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болото",
                                "target_lang_sense_clarification": "переносно о застое и отсутствии развития"
                            },
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "о ситуации, которая затягивает и мешает выбраться"
                            },
                            {
                                "target_lang_word": "омут",
                                "target_lang_sense_clarification": "о запутанной или опасной ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37b99cef-1bab-32ba-ae33-34ed1e927236",
                    "sense_definition": "A regional dish, typically consisting of chicken and rice cooked together until moist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prepared a large pot of chicken <w>bog</w> for the family reunion supper.",
                            "target_lang_translations": {
                                "ru": "Она приготовила большую кастрюлю <w>чикен-бога</w> для семейного ужина."
                            }
                        },
                        {
                            "text": "The secret to a good <w>bog</w> is ensuring the rice absorbs all the flavorful chicken stock.",
                            "target_lang_translations": {
                                "ru": "Секрет хорошего <w>блюда</w> в том, чтобы рис впитал в себя весь ароматный куриный бульон."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chicken bog",
                        "rice bog"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Southern United States, particularly South Carolina"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Региональное блюдо, обычно состоящее из курицы и риса, приготовленных вместе до мягкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чикен-бог",
                                "target_lang_sense_clarification": "транслитерация названия специфического американского блюда"
                            },
                            {
                                "target_lang_word": "курица с рисом",
                                "target_lang_sense_clarification": "описательный перевод блюда"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b4212c1d-a4ac-320d-bdc3-d9cc74abd916",
                    "sense_definition": "To be prevented or impeded from making progress; to become stuck.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stuck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The negotiations began to <w>bog</w> down when the two sides could not agree on the budget.",
                            "target_lang_translations": {
                                "ru": "Переговоры начали <w>застревать</w>, когда стороны не смогли договориться о бюджете."
                            }
                        },
                        {
                            "text": "We must ensure the project does not <w>bog</w> down in unnecessary administrative details.",
                            "target_lang_translations": {
                                "ru": "Мы должны убедиться, что проект не <w>увязнет</w> в ненужных административных деталях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bog down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замедляться или останавливаться в развитии; застревать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застревать",
                                "target_lang_sense_clarification": "останавливаться в движении или делах"
                            },
                            {
                                "target_lang_word": "вязнуть",
                                "target_lang_sense_clarification": "переносно о делах, требующих слишком много усилий"
                            },
                            {
                                "target_lang_word": "тормозиться",
                                "target_lang_sense_clarification": "замедляться в прогрессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc6e85da-b6b4-3f5c-9b4d-2d2a34474394",
                    "sense_definition": "To sink or submerge someone or something into a wet, spongy area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stuck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rains threatened to <w>bog</w> the vehicles in the muddy fields.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди грозили тем, что машины <w>увязнут</w> в размокших полях."
                            }
                        },
                        {
                            "text": "The horse was <w>bogged</w> in the marsh and required several men to pull it out.",
                            "target_lang_translations": {
                                "ru": "Лошадь <w>засосало</w> в болоте, и потребовалось несколько человек, чтобы ее вытащить."
                            }
                        }
                    ],
                    "synonyms": [
                        "mire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Погружать кого-либо или что-либо в мокрую, губчатую местность; засасывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увязать",
                                "target_lang_sense_clarification": "застревать в вязкой среде"
                            },
                            {
                                "target_lang_word": "засасывать",
                                "target_lang_sense_clarification": "о действии болота или трясины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "74551cd8-c5ce-3680-9c86-77f39d901490",
                    "sense_definition": "Initialism of Bank of Ghana.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>BoG</w> issued a statement regarding the new currency regulations in the country.",
                            "target_lang_translations": {
                                "ru": "<w>Банк Ганы</w> сделал заявление относительно новых валютных правил в стране."
                            }
                        },
                        {
                            "text": "Investors are closely watching the <w>BoG</w> for any changes in interest rates.",
                            "target_lang_translations": {
                                "ru": "Инвесторы внимательно следят за <w>БГ</w> (Банком Ганы) на предмет любых изменений процентных ставок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура Банка Ганы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Банк Ганы",
                                "target_lang_sense_clarification": "полное название организации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96baeb69-e80f-39a1-b12b-0c1b09b32937",
                    "sense_definition": "Initialism of the Federal Reserve Board of Governors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>BoG</w> consists of seven members who are appointed by the president.",
                            "target_lang_translations": {
                                "ru": "<w>Совет управляющих</w> состоит из семи членов, назначаемых президентом."
                            }
                        },
                        {
                            "text": "Decisions made by the <w>BoG</w> have a significant impact on the national economy.",
                            "target_lang_translations": {
                                "ru": "Решения, принимаемые <w>Советом</w>, оказывают значительное влияние на национальную экономику."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура Совета управляющих Федеральной резервной системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Совет управляющих ФРС",
                                "target_lang_sense_clarification": "официальное название органа в США"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7eccabd0-fe79-3308-b1aa-690fe166a9ad",
                    "sense_definition": "Bold, boastful, or proud.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a very <w>bog</w> fellow, always talking about his own achievements.",
                            "target_lang_translations": {
                                "ru": "Он был очень <w>хвастливым</w> малым, вечно твердил о своих достижениях."
                            }
                        },
                        {
                            "text": "The bird looked <w>bog</w> as it displayed its feathers to the rest of the flock.",
                            "target_lang_translations": {
                                "ru": "Птица выглядела <w>горделиво</w>, демонстрируя свое оперение остальной стае."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bog fellow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Found in some regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смелый, хвастливый или гордый (архаичное или диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спесивый",
                                "target_lang_sense_clarification": "высокомерный и гордый"
                            },
                            {
                                "target_lang_word": "хвастливый",
                                "target_lang_sense_clarification": "любящий похвалиться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}