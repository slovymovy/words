                                "target_senses": [
                                    {
                                        "sense_id": "4070de9a-9b93-3c40-9198-e290b2a78b38",
                                        "entry_id": "380d9e2e-2d40-33b6-9e3d-d8f4d2078fca",
                                        "glosses": [
                                            "Évaluer de façon trop favorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "409155a0-ea9c-42c1-9f82-38dcecc65e5f",
                                                "sense_id": "4070de9a-9b93-3c40-9198-e290b2a78b38",
                                                "text": "Mais d’autres services peuvent aussi être surévalués, tels l’emballage des cartons ou l’utilisation des escaliers."
                                            },
                                            {
                                                "example_id": "2ca68ba0-261b-4b6c-b5f5-02d46eb17311",
                                                "sense_id": "4070de9a-9b93-3c40-9198-e290b2a78b38",
                                                "text": "Mais il ne faut pas surévaluer l’aide canadienne. Les 9 milliards d’aide totale à l’Ukraine nous placent loin derrière plusieurs de nos alliés par rapport à notre poids économique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23e7948c-ed93-49c8-a295-6a1fd2476bf6",
                        "source_entry_id": "45720e42-c704-37a3-b88d-505fb1600d66",
                        "source_sense_description": "to esteem too highly",
                        "target_lang_word": "surestimer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surestimer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09c9fdd1-c9a3-33a5-992e-51903c0492ef",
                                        "entry_id": "ae5c5bee-cf7d-362d-a0df-aa8eb3d316b9",
                                        "glosses": [
                                            "Estimer une chose, une personne au-delà de ce qu’elle mérite, de ce qu’elle vaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3cbc211-fa24-4ab2-b6b9-0238787c0889",
                                                "sense_id": "09c9fdd1-c9a3-33a5-992e-51903c0492ef",
                                                "text": "L'importance d’Hippocrate et du Corpus hippocratique ne saurait être surestimée car l’œuvre du Maître de Cos fut objet d'enseignement médical jusqu'au milieu du XIX^(ème) siècle avant de devenir objet d'histoire."
                                            },
                                            {
                                                "example_id": "a33a5a72-a4b3-4379-a5fd-7facde2d0dc7",
                                                "sense_id": "09c9fdd1-c9a3-33a5-992e-51903c0492ef",
                                                "text": "Entraînées par l’enthousiasme démesuré de l’adolescence, elles surestimèrent leurs capacités physiologiques."
                                            },
                                            {
                                                "example_id": "a34f0052-0eeb-4124-b2b8-7cc779947601",
                                                "sense_id": "09c9fdd1-c9a3-33a5-992e-51903c0492ef",
                                                "text": "Forcées de baisser leurs tarifs pour décrocher des marchés, les entreprises du déménagement ont mis en place, histoire de compenser, des combines bien rodées. La plus connue consiste à surestimer la volumétrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40cd0835-478c-4bd2-acf7-4f2c34e1d431",
                        "source_entry_id": "45720e42-c704-37a3-b88d-505fb1600d66",
                        "source_sense_description": "to esteem too highly",
                        "target_lang_word": "surfaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surfaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7da1c72c-7103-3617-9920-90e29c70781d",
                                        "entry_id": "f9f6d844-0636-34fc-9a5f-18906345e36d",
                                        "glosses": [
                                            "Demander plus qu’il ne faut d’une chose qui est à vendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "471add67-84d4-44b4-bd9a-7af907fcbaf7",
                                                "sense_id": "7da1c72c-7103-3617-9920-90e29c70781d",
                                                "text": "Ses vareuses, ses chemises, ses maillots à raies bleues, furent palpés, retournés et puis enlevés à des prix quelconques, les acheteurs surfaisant pour s’amuser."
                                            },
                                            {
                                                "example_id": "a3799981-0059-4c7e-9c13-ceb7458e5bbb",
                                                "sense_id": "7da1c72c-7103-3617-9920-90e29c70781d",
                                                "text": "Comme nous lui faisions observer que le prix était un peu élevé, il nous répondit d’une façon grandiose en espagnol : « Je ne surfais jamais : cela est bon pour les chrétiens. » Ainsi notre mauvaise foi commerciale nous rend un objet de mépris pour les nations barbares, qui ne comprennent pas que le désir de gagner quelques centimes de plus puisse faire parjurer un homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c56a20d-8d34-399a-9946-ed61a27e7870",
                                        "entry_id": "f9f6d844-0636-34fc-9a5f-18906345e36d",
                                        "glosses": [
                                            "Estimer un homme ou quelque chose au-dessus de sa valeur, le vanter au-delà de son mérite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1210755e-4e50-47b8-b4ac-ccd0e7eadf3c",
                                                "sense_id": "5c56a20d-8d34-399a-9946-ed61a27e7870",
                                                "text": "On a surfait même Montaigne ; il n’est pas toujours savoureux."
                                            },
                                            {
                                                "example_id": "d5c9b77a-6420-4ac0-ad19-e5b92ef248bc",
                                                "sense_id": "5c56a20d-8d34-399a-9946-ed61a27e7870",
                                                "text": "Cet écrivain, cet artiste est très surfait."
                                            },
                                            {
                                                "example_id": "670db1a6-0014-4290-bcbd-8c921b976c1e",
                                                "sense_id": "5c56a20d-8d34-399a-9946-ed61a27e7870",
                                                "text": "Balzac, dans La Recherche de l’Absolu, a dépeint un logis semblable avec son génie visionnaire, mais aussi avec cette mégalomanie qui le portait à tout surfaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
