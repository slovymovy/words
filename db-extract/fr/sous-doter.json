                "senses": [
                    {
                        "sense_id": "f300a4c0-af7e-3ab6-9d44-1ae38129e3e4",
                        "entry_id": "c0a7edac-5583-3452-ac6d-5e7cffd6028d",
                        "glosses": [
                            "Doter de façon insuffisante, ou moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "284895a7-9792-49ee-9bdd-ce3f3c2fbaa6",
                                "sense_id": "f300a4c0-af7e-3ab6-9d44-1ae38129e3e4",
                                "text": "Plusieurs raisons peuvent avoir conduit les répartiteurs à sous-doter 80 colons dans les cuadrillas."
                            },
                            {
                                "example_id": "f8ed95d7-5f16-41d9-80a3-dbef8e7faf11",
                                "sense_id": "f300a4c0-af7e-3ab6-9d44-1ae38129e3e4",
                                "text": "On laisse mourir le service public, on le sous-dote, pour dire ensuite que ça ne marche pas et on le laisse tomber."
                            },
                            {
                                "example_id": "c475abf1-0d6b-4ed9-8eb8-ea756a0c5964",
                                "sense_id": "f300a4c0-af7e-3ab6-9d44-1ae38129e3e4",
                                "text": "La meilleure façon de rendre la CNIL incapable d'accomplir sa mission consiste à la sous-doter en personnel."
                            }
                        ]
                    }
                ],
