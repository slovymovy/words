                    {
                        "translation_id": "ddc11745-04f7-471e-981d-703f5180acc9",
                        "source_entry_id": "51f002e2-03ed-3a65-9990-4085a17f26d3",
                        "source_sense_id": "9167ef14-7fc9-3d72-b4f7-dbdd7931190a",
                        "source_sense_description": "Behörde, die einem Kanzler untersteht oder die diesen in seinen Aufgaben unterstützt",
                        "target_lang_word": "chancellory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chancellory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9afbefe-d9b3-3ccd-a20d-1f16a7bca5d3",
                                        "entry_id": "25efced2-8289-3353-ab58-034fcb352d79",
                                        "glosses": [
                                            "Alternative spelling of chancellery."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec45b04-567a-49b2-8076-68ff8f261a53",
                                                "sense_id": "c9afbefe-d9b3-3ccd-a20d-1f16a7bca5d3",
                                                "text": "The hall of the chancellory had been transformed into a cloakroom and there the crowd was thickest."
                                            },
                                            {
                                                "example_id": "1b2fc8bd-540a-41cb-a5d5-f6aee2d2580e",
                                                "sense_id": "c9afbefe-d9b3-3ccd-a20d-1f16a7bca5d3",
                                                "text": "Bismarck's successor in the chancellory, Count Caprivi, set matters in their true light in a speech in the Reichstag shortly after the publication of Bismarck's Reminiscences."
                                            },
                                            {
                                                "example_id": "71eed2f3-36ff-4865-b418-e932055818f3",
                                                "sense_id": "c9afbefe-d9b3-3ccd-a20d-1f16a7bca5d3",
                                                "text": "Senor Polo had personally brought the document from the chancellory above.\" \""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
