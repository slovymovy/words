                                            {
                                                "example_id": "79853613-ad63-4030-9dba-7e452eb4c58e",
                                                "sense_id": "5a8f3084-3682-369b-a343-266ce4b338cd",
                                                "text": "Gelukkig had het verhaal een goede afloop."
                                            },
                                            {
                                                "example_id": "379c25e9-37a6-4930-8485-e66bd76d797c",
                                                "sense_id": "5a8f3084-3682-369b-a343-266ce4b338cd",
                                                "text": "Na afloop liep men in optocht vanuit de kerk langs het pad met de brandende kaarsjes naar het Finlandplein achter de Kerkring, waar het monument ter herdenking aan de slachtoffers van de Watersnood stond."
                                            },
                                            {
                                                "example_id": "0771e40f-8a06-4642-9b87-80cc0bd878e7",
                                                "sense_id": "5a8f3084-3682-369b-a343-266ce4b338cd",
                                                "text": "Toch fijn dat enkelen die vooraf zo fel en kritisch waren geweest, mij na afloop van de tocht een persoonlijk bericht stuurden om te zeggen hoe mooi ze het vonden dat ik mijn droom achterna was gegaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f64586da-73a5-3383-8242-9385279eb276",
                                        "entry_id": "57df01e1-9989-33d6-b887-beb37e050238",
                                        "glosses": [
                                            "resultaat, uitkomst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6408969d-42f7-467f-887a-36fd4ae6d1bb",
                                                "sense_id": "f64586da-73a5-3383-8242-9385279eb276",
                                                "text": "De gunstige afloop van de cursus leidde tot het behalen van het diploma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39392785-96fd-3d3f-8560-b42bf9f78a37",
                                        "entry_id": "57df01e1-9989-33d6-b887-beb37e050238",
                                        "glosses": [
                                            "ontknoping"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ffebc3-610f-44b1-a559-c85fa7c191f1",
                                                "sense_id": "39392785-96fd-3d3f-8560-b42bf9f78a37",
                                                "text": "Vroeger was er altijd een goede afloop van een verhaal, tegenwoordig mag een roman een open einde of zelfs een slechte afloop hebben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa766c44-cdad-3bf8-b47e-9e9de4b46a89",
                                        "entry_id": "57df01e1-9989-33d6-b887-beb37e050238",
                                        "glosses": [
                                            "expiratie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d7ec4e0-13f6-45ff-89ad-9b6246a5b821",
                                                "sense_id": "fa766c44-cdad-3bf8-b47e-9e9de4b46a89",
                                                "text": "de afloop van een contract"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25c98ae4-4e0f-38e2-833a-6543ee479ed4",
