                "senses": [
                    {
                        "sense_id": "e03731c6-f1a5-3d33-b9b7-41e399cb1b2d",
                        "entry_id": "c2536057-9467-3ec7-81af-47f7ceed3faf",
                        "glosses": [
                            "прост. однокр. к гаркать; громко и отрывисто крикнуть, рявкнуть"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e91858-354f-45c1-a28a-a184df456d6f",
                                "sense_id": "e03731c6-f1a5-3d33-b9b7-41e399cb1b2d",
                                "text": "Красноармейцы дружно гаркнули: «Ура!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "2cc9f43b-0988-3f32-9f44-a97b588090c1",
                        "entry_id": "c2536057-9467-3ec7-81af-47f7ceed3faf",
                        "glosses": [
                            "прост. однокр. к гаркать; со злостью крикнуть, припугнуть окриком"
                        ],
                        "tags": [
                            "semelefactive"
                        ],
                        "examples": [
                            {
                                "example_id": "cfa63add-0787-44e0-95ee-8042450f85df",
                                "sense_id": "2cc9f43b-0988-3f32-9f44-a97b588090c1",
                                "text": "Так бывает — что песенка спета, // Если гаркнет любимая: «Вон!» // Вот и бродит по улице где-то // Одинокий небритый гормон."
                            }
                        ]
                    }
