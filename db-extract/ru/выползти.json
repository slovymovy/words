                ],
                "senses": [
                    {
                        "sense_id": "5bf6dc91-27cd-334e-8522-07eb8dcfc44a",
                        "entry_id": "ced999c1-1830-3f57-b61c-7f2ed9c15874",
                        "glosses": [
                            "выйти ползком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1da444e-d47c-490e-b92c-36aa38865853",
                                "sense_id": "5bf6dc91-27cd-334e-8522-07eb8dcfc44a",
                                "text": "С чердака воры выползли на крышу."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6363694-545b-32db-b65f-ad6adf532e8a",
                        "entry_id": "ced999c1-1830-3f57-b61c-7f2ed9c15874",
                        "glosses": [
                            "вылезти, выйти (о насекомых и пресмыкающихся)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32218ce-f904-4102-bfe2-2053635a47cb",
                                "sense_id": "e6363694-545b-32db-b65f-ad6adf532e8a",
                                "text": "Из щелей выползли тараканы."
                            },
                            {
                                "example_id": "39d4e6ce-4d0a-43f2-aeee-b0998199cedd",
                                "sense_id": "e6363694-545b-32db-b65f-ad6adf532e8a",
                                "text": "Из норы выползла змея."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9c98600-27f4-3f86-8c1c-a2079761cd85",
                        "entry_id": "ced999c1-1830-3f57-b61c-7f2ed9c15874",
                        "glosses": [
                            "перен. разг. шутл. медленно, с трудом выйти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b10227c-3dfd-4865-925e-8ace0aed0e1b",
                                "sense_id": "b9c98600-27f4-3f86-8c1c-a2079761cd85",
                                "text": "Выздоравливающие выползли из больницы погреться на солнце."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ef05a29-e9d8-3e6f-ae41-5a72a3a36308",
                        "entry_id": "ced999c1-1830-3f57-b61c-7f2ed9c15874",
                        "glosses": [
                            "медленно передвигаясь по небосводу, появиться откуда-либо или где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81b91c4c-1a86-47c2-91e7-3e40244cc5cd",
                                "sense_id": "9ef05a29-e9d8-3e6f-ae41-5a72a3a36308",
                                "text": "Красноватый столб прямиком выполз в небо. Долго выползал, увязнув в дымчатой сини. Вот закруглился и воткнулся концом в небо, концом в поля."
                            }
                        ]
                    }
                ],
