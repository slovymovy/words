{
    "word_family": [
        "italic",
        "italics",
        "italicize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24f63954-2ef2-3fea-b174-ce3b3481c266",
                    "sense_definition": "Printed in a slanted typeface style often used for emphasis or titles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book title should be <w>italicized</w> in your final report.",
                            "target_lang_translations": {
                                "zh": "在你的最终报告中，书名应该用<w>斜体</w>标出。"
                            }
                        },
                        {
                            "text": "She <w>italicized</w> the important words to make them stand out.",
                            "target_lang_translations": {
                                "zh": "她把重要的词汇<w>用斜体标出</w>，以使它们更加突出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slanted"
                    ],
                    "common_phrases": [
                        "italicized text",
                        "italicized words"
                    ],
                    "target_lang_definitions": {
                        "zh": "指以倾斜的字体印刷，常用于强调或书名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斜体",
                                "target_lang_sense_clarification": "指文字的倾斜排版样式。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb6c06b6-9eca-3a6f-88fc-b53c8ec58d4d",
                    "sense_definition": "Past tense and past participle of <w>italicize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>italicized</w> every foreign term in the document.",
                            "target_lang_translations": {
                                "zh": "他将文档中的每一个外来词都<w>用斜体标出</w>。"
                            }
                        },
                        {
                            "text": "The editor has <w>italicized</w> the names of the ships.",
                            "target_lang_translations": {
                                "zh": "编辑已经将船名<w>用斜体标出</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb italicize."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 italicize 的过去式或过去分词，意为将文字排版为斜体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用斜体标出",
                                "target_lang_sense_clarification": "指将文字处理成斜体格式的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}