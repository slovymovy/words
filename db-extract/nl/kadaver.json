                    {
                        "translation_id": "46c47321-b5b7-491d-99c5-c84a2acb7194",
                        "source_entry_id": "288a8ca8-8a45-3731-b5b7-7ab0eaff232c",
                        "source_sense_id": "8bce858f-43d8-31f5-a385-5af3046a1515",
                        "source_sense_description": "dood lichaam van een dier",
                        "target_lang_word": "cadáver",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadáver",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "06f019c3-5847-3c8a-911a-7964a8e601a3",
                                        "entry_id": "b72b61db-ab09-3648-bf37-e555c226744c",
                                        "glosses": [
                                            "Cuerpo muerto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1474ede4-72e9-43e7-98b8-c0337bfd7a0a",
                                                "sense_id": "06f019c3-5847-3c8a-911a-7964a8e601a3",
                                                "text": "«Por otro lado, más de una treintena de buitres y un par de alimoches se han encontrado muertos, o agonizantes, en un pueblo de Castilla, junto al cadáver envenenado de una oveja»."
                                            },
                                            {
                                                "example_id": "1d33ffa5-0ef3-44e4-85e3-67285793f32b",
                                                "sense_id": "06f019c3-5847-3c8a-911a-7964a8e601a3",
                                                "text": "«Luego, cuando empieza a repetir sobre la estatua los antiguos ritos, tiene la certeza de que está masajeando el cadáver de Paulina, y esta idea lo pone fuera de juicio»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
