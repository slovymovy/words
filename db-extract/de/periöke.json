                    {
                        "sense_id": "27773b62-6e9c-3acb-b7b4-fe0fec905541",
                        "entry_id": "5a1637e0-0b3f-367e-9629-cc5b597e1cec",
                        "glosses": [
                            "freier Einwohner im antiken Sparta, der aber militärpflichtig und politisch rechtlos war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f01c9ab8-bab3-4267-b243-8c2c09c86a52",
                                "sense_id": "27773b62-6e9c-3acb-b7b4-fe0fec905541",
                                "text": "Sie mußten schon durch ihre Lage den Periöken gegenüber sich verletzt fühlen; der Periöke war mit eigenen Gütern ansgestattet, der Helote war eigenthumslos; der Periöke genoß bürgerliche Freiheit, der Helote war unfrei. (1872)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ae249f-0ddd-48e4-9cec-9273be54c5f5",
