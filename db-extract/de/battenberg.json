                ],
                "senses": [
                    {
                        "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                        "entry_id": "7542cfa5-78b6-3bf8-b02c-98092382dacc",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae42582f-90ac-493a-be50-958dfa9ce56f",
                                "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                                "text": "Frau Battenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5d847578-a578-4722-9a0c-f22f82f79777",
                                "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                                "text": "Herr Battenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4621b7d3-d32b-47ce-879c-cb3023d1cd3a",
                                "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                                "text": "Die Battenbergs fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "9d30caf7-d5c4-4e2b-a067-2e6409f30de8",
                                "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                                "text": "Der Battenberg trägt nie die Pullover, die die Battenberg ihm strickt."
                            },
                            {
                                "example_id": "4fb90475-619a-4a0a-9d98-e12230f9052e",
                                "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Battenberg kommt, geht der Herr Battenberg.“"
                            },
                            {
                                "example_id": "f596c257-dbc4-41b9-8bd2-f51da60301b3",
                                "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                                "text": "Battenberg kommt und geht."
                            },
                            {
                                "example_id": "57d4796b-2ece-40a2-9657-5e96c8a23ad2",
                                "sense_id": "3612ec21-76ac-3e90-b37f-9d8bd675f268",
                                "text": "Battenbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
