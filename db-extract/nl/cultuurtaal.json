                "senses": [
                    {
                        "sense_id": "c4b51240-f566-328f-b4eb-ed92d983430a",
                        "entry_id": "b863c3c9-0a75-3832-a2b2-460d3c779634",
                        "glosses": [
                            "taal die de standaardtaal is in een gebied waar ook dialecten worden gesproken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96f3764-1e4f-4b5f-928a-bfdb8c12951e",
                                "sense_id": "c4b51240-f566-328f-b4eb-ed92d983430a",
                                "text": "In Vlaanderen bestond lange tijd geen Nederlandse cultuurtaal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85c49e15-fc68-4018-8399-4e2e8956c55b",
                        "source_entry_id": "b863c3c9-0a75-3832-a2b2-460d3c779634",
                        "source_sense_id": "c4b51240-f566-328f-b4eb-ed92d983430a",
                        "source_sense_description": "taal die de standaardtaal is in een gebied waar ook dialecten worden gesproken",
                        "target_lang_word": "Kultursprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kultursprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "059befb7-8104-34a1-a700-5b2a0cb35bcc",
                                        "entry_id": "2a7c9724-acbb-3984-b77b-e75e7bc050e7",
                                        "glosses": [
                                            "Sprache als wesentlicher Bestandteil einer bestimmten Kultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02fe2225-76e1-4694-903e-c74583ce88b6",
                                                "sense_id": "059befb7-8104-34a1-a700-5b2a0cb35bcc",
                                                "text": "„Die unvermeidliche Folge, und manche werden sagen: die Strafe für diese Entwicklung neuer Kultursprachen liegt darin, daß die Männer und Frauen, die sich ihrer bedienen, es ungleich schwerer haben, in der Welt Beachtung zu finden, als wenn sie in einer der seit langem anerkannten Kultursprachen geschrieben hätte.“"
                                            },
                                            {
                                                "example_id": "0cdeebf5-1f6d-4b4b-bf0c-9b93c7fd30e6",
                                                "sense_id": "059befb7-8104-34a1-a700-5b2a0cb35bcc",
                                                "text": "„Ben Yehoudas sprachlich-kulturelles Engagement für das Hebräische fand Anklang bei den radikalen Zionisten, die das Jiddische für ‚degeneriertes‘ Deutsch hielten und als Kultursprache nicht akzeptierten.“"
                                            },
                                            {
                                                "example_id": "c773d3ad-bbaa-4764-8f24-22c5fb1f20d2",
                                                "sense_id": "059befb7-8104-34a1-a700-5b2a0cb35bcc",
                                                "text": "„In der Schweiz treffen jedoch drei bedeutende Kultursprachen aufeinander: Deutsch, Französisch und Italienisch.“"
                                            },
                                            {
                                                "example_id": "40b9b2fe-7348-43e0-92f6-c9f774f900ba",
                                                "sense_id": "059befb7-8104-34a1-a700-5b2a0cb35bcc",
                                                "text": "„Sie erfüllten teils liturgische Funktionen, teils Funktionen innerhalb des jüdischen Rechts- und Bildungssystems, und waren daher in der Kultursprache der Juden, Hebräisch (und teilweise in Aramäisch) verfasst, ähnlich wie große Teile der christlichen Kultur in Latein verschriftlicht wurden.“"
                                            },
                                            {
                                                "example_id": "e0513116-e2a2-4509-add6-23eca88a858f",
                                                "sense_id": "059befb7-8104-34a1-a700-5b2a0cb35bcc",
                                                "text": "„Und Deutsch war nicht nur die Kultursprache, deren Schriftsteller einst bewundert und nachgeahmt wurden, sie war - und ist bis heute - auch die Sprache des Alltags.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87ff5a9b-1a79-4e03-8480-2cc6f297f741",
                        "source_entry_id": "b863c3c9-0a75-3832-a2b2-460d3c779634",
                        "source_sense_id": "c4b51240-f566-328f-b4eb-ed92d983430a",
