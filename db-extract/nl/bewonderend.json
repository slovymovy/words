                                            {
                                                "example_id": "52f6942b-64c5-437e-9cb6-7306e054165e",
                                                "sense_id": "e4753746-3494-3a67-a484-ce99c9ab5b5e",
                                                "text": "What more palpable confutation can there be of human vanity and arrogance, of all lofty imaginations, all presumptuous confidences, all turgid humours, all fond self-pleasings and self-admirings, than is that tragical cross […]"
                                            },
                                            {
                                                "example_id": "e9007075-c4ca-4a2e-9983-f2ee171ed796",
                                                "sense_id": "e4753746-3494-3a67-a484-ce99c9ab5b5e",
                                                "text": "We must keep up a constant worship of God in our families, and in our closets; we must be frequent in holy adorings and admirings of God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
