{
    "word_family": [
        "premonitory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06fa0608-2cce-3efa-a78c-6254bf2babe9",
                    "sense_definition": "A strong intuition that something is about to happen, often something negative.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a sudden <w>premonition</w> that something bad was going to happen at the party.",
                            "target_lang_translations": {
                                "zh": "她突然产生了一种<w>预感</w>，觉得聚会上会发生不好的事情。"
                            }
                        },
                        {
                            "text": "I had a strange <w>premonition</w> of danger before I even entered the dark building.",
                            "target_lang_translations": {
                                "zh": "我还没走进那栋昏暗的大楼，就产生了一种奇怪的危险<w>预感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bad feeling",
                        "foreboding",
                        "gut feeling",
                        "hunch"
                    ],
                    "common_phrases": [
                        "have a premonition",
                        "sudden premonition"
                    ],
                    "target_lang_definitions": {
                        "zh": "对即将发生之事（常指不祥之事）的强烈直觉或预感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "预感",
                                "target_lang_sense_clarification": "对将要发生的事情的事先感觉"
                            },
                            {
                                "target_lang_word": "不祥的预感",
                                "target_lang_sense_clarification": "指对坏事即将发生的直觉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b36becde-2032-34b2-9d0c-b137f1823b87",
                    "sense_definition": "A supernatural or clairvoyant experience, such as a dream, that predicts a future event.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old woman claimed her dream was a <w>premonition</w> of the coming storm.",
                            "target_lang_translations": {
                                "zh": "老妇人声称她的梦是即将来临的风暴的<w>预兆</w>。"
                            }
                        },
                        {
                            "text": "He dismissed the vision as a mere coincidence rather than a true <w>premonition</w>.",
                            "target_lang_translations": {
                                "zh": "他不以为意地认为那个幻象纯属巧合，而非真正的<w>预兆</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vision",
                        "second sight"
                    ],
                    "common_phrases": [
                        "true premonition"
                    ],
                    "target_lang_definitions": {
                        "zh": "预知未来的超自然体验或梦境；预兆。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "预兆",
                                "target_lang_sense_clarification": "事情发生前显露出的迹象或梦境提示"
                            },
                            {
                                "target_lang_word": "预知",
                                "target_lang_sense_clarification": "指超自然的先见或预先显现"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}