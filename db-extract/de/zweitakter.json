                "senses": [
                    {
                        "sense_id": "6e30e4c0-6aae-38ab-bfc6-95c76d1cea85",
                        "entry_id": "2204bb82-454d-3e96-aea4-e6c50f9c10f5",
                        "glosses": [
                            "Verbrennungsmotor mit zwei Arbeitsgängen, die während einer Umdrehung der Kurbelwelle durchlaufen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c65dd73-0b92-4435-bd03-f61f8d10c315",
                                "sense_id": "6e30e4c0-6aae-38ab-bfc6-95c76d1cea85",
                                "text": "„Die Zweitakter der Marke MZ aus dem sächsischen Zschopau waren zwar laut, dafür aber unverwüstlich – und preiswert.“"
                            },
                            {
                                "example_id": "0e1c3f1c-3bc3-40ad-ac3a-79539c4db3e2",
                                "sense_id": "6e30e4c0-6aae-38ab-bfc6-95c76d1cea85",
                                "text": "„Den Rollerfahrern kam auch entgegen, dass der Zweitakter einfacher zu tunen war, als es der Viertakter ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
