                "senses": [
                    {
                        "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                        "entry_id": "138d6cc1-e629-362b-bb04-2f401f159cdf",
                        "glosses": [
                            "Engin de traction évoluant sur rail ou sur route."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c035fb5e-689c-49be-be6a-8d5f8dffb024",
                                "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                                "text": "Le wattman P... conduisant un locotracteur refoulait à vive allure un train de berlines de terres quand il vint heurter de la tête un bec de chargement."
                            },
                            {
                                "example_id": "d59f9455-d901-4f36-9f59-346397496d0d",
                                "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                                "text": "Implanté dans cinq centres de formation, ce système est dédié à l'apprentissage de la conduite des locotracteurs destinés, d'une part, à la manœuvre dans les gares, les triages et les chantiers et, d'autre part, à assurer l'acheminement de trains de marchandises ou de rames vides entre les gares."
                            },
                            {
                                "example_id": "66efa426-aeb6-4201-99f9-1e311aa288d7",
                                "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                                "text": "Puis deux gars, les « coltineurs » au sens strict, chargeaient une traverse sur leurs épaules protégées par le « coltin » & les déposaient sur un « lorry », wagonnet, tiré par des chevaux jusqu’en 1945, puis par une « patinette », un locotracteur à gazogène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78e7801a-3414-43e2-aa56-0279247f100b",
                        "source_entry_id": "138d6cc1-e629-362b-bb04-2f401f159cdf",
                        "source_sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                        "target_lang_word": "shunter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shunter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fbff4d5-74f3-3466-9a0a-78c2f3a518b1",
                                        "entry_id": "72cfd656-ee6d-3de9-b625-98e2ea278a99",
                                        "glosses": [
                                            "A railway locomotive used for shunting (switching)."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59180514-7b3d-4e23-8b42-ca21dbb00e40",
                                                "sense_id": "6fbff4d5-74f3-3466-9a0a-78c2f3a518b1",
                                                "text": "Concurrent to this order, Good forged a link with Irish Railways, which resulted in the latter building five shunters with Brush equipment, marking the inception of dieselisation in the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c1e3b2-be71-32a3-b5d0-5a2f8334b488",
                                        "entry_id": "72cfd656-ee6d-3de9-b625-98e2ea278a99",
                                        "glosses": [
                                            "A person who carries out shunting operations."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923beb14-d859-4c63-b7c2-0efdde0a2868",
                                                "sense_id": "f3c1e3b2-be71-32a3-b5d0-5a2f8334b488",
                                                "text": "The electric locomotive is accompanied by a shunter who, in addition to his normal duties, flags the trains over the unprotected level crossings and opens the gates through which the line passes."
                                            },
                                            {
                                                "example_id": "7be7c534-6023-4b96-98f6-bf133cc2c79e",
                                                "sense_id": "f3c1e3b2-be71-32a3-b5d0-5a2f8334b488",
                                                "text": "The shunter has a lightweight portable radio transmitter by which, as he uncouples an incoming train into cuts for marshalling, he informs the Traffic Office of the number of wagons in each cut and its siding; [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c583fb-a954-377f-926f-5786eee1b697",
                                        "entry_id": "72cfd656-ee6d-3de9-b625-98e2ea278a99",
                                        "glosses": [
                                            "One who shunts (carries on arbitrage between London and provincial stock exchanges)."
                                        ],
