                    },
                    {
                        "sense_id": "c4f0e765-5f98-357e-8baf-7a8db89f500c",
                        "entry_id": "e36f435c-deae-3958-abe0-51dbb6d96cf0",
                        "glosses": [
                            "развиваясь, превращаться во что-либо другое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79afb1e0-55c9-48a2-b27a-c583029b4ee1",
                                "sense_id": "c4f0e765-5f98-357e-8baf-7a8db89f500c",
                                "text": "Числа с двадцать пятого августа как зарядил дождь, так шел и шел, и постепенно стал перерастать в снег."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03f72418-7025-4acc-9e1a-f299bf28d8da",
                        "source_entry_id": "e36f435c-deae-3958-abe0-51dbb6d96cf0",
                        "source_sense_description": "обгонять в росте, размере",
                        "target_lang_word": "outgrow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outgrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "985dc221-608d-391f-8bc6-43a4cd67f5a4",
                                        "entry_id": "e7c3d6f2-abbc-333b-8935-9d35f92c2c5b",
                                        "glosses": [
                                            "To become too big in size or too mature in age or outlook to continue to want, need, use, experience, or accept some object, practice, condition, belief, etc."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baca4d58-492e-44f1-bcd2-516dc3e864b2",
                                                "sense_id": "985dc221-608d-391f-8bc6-43a4cd67f5a4",
                                                "text": "Poorer children often have to wear whatever an older sibling has outgrown."
                                            },
                                            {
                                                "example_id": "1b7dddfc-15ab-4862-981f-82f8476d8422",
                                                "sense_id": "985dc221-608d-391f-8bc6-43a4cd67f5a4",
                                                "text": "I used to have allergies but I outgrew all of them."
                                            },
                                            {
                                                "example_id": "3ab130e4-32d3-4d5c-847b-9458e2c9136d",
                                                "sense_id": "985dc221-608d-391f-8bc6-43a4cd67f5a4",
                                                "text": "Some people blame God for their troubles, but one must outgrow such notions."
                                            },
                                            {
                                                "example_id": "b6e5cef1-bdb1-4bec-9bc8-90c9e04988f6",
                                                "sense_id": "985dc221-608d-391f-8bc6-43a4cd67f5a4",
                                                "text": "[…]Most persons are collectors at some periods of their lives. Some outgrow the habit; with others it becomes a mania; and with still others it is a lasting habit intelligently planned as one aspect of a study of a particular subject."
                                            },
                                            {
                                                "example_id": "818e51dc-f4e0-4b3e-8eb7-993504de4ded",
                                                "sense_id": "985dc221-608d-391f-8bc6-43a4cd67f5a4",
                                                "text": "“I think you've outgrown Bonnie,” he said as he drove. […] “Bonnie and I have known each other forever,” I said simply. “Doesn't mean you have to be friends forever.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c407284-c5ca-30d7-9655-7e7ceddff8d8",
                                        "entry_id": "e7c3d6f2-abbc-333b-8935-9d35f92c2c5b",
                                        "glosses": [
                                            "To grow faster or larger than."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "242072e9-c83e-4dd0-a389-85e91ab12cee",
                                                "sense_id": "5c407284-c5ca-30d7-9655-7e7ceddff8d8",
                                                "text": "The best adapted plant varieties tend to outgrow those less adapted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
