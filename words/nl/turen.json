                    "sense_definition": "aandachtig of ingespannen naar iets kijken om het beter te kunnen zien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kapitein stond op de brug en <w>tuurde</w> over de donkere zee.",
                            "target_lang_translations": {
                                "en": "The captain stood on the bridge and <w>peered</w> across the dark sea."
                            }
                        },
                        {
                            "text": "Zij moest langdurig <w>turen</w> naar de kleine letters in het oude boek.",
                            "target_lang_translations": {
                                "en": "She had to <w>peer</w> at the small letters in the old book for a long time."
                            }
                        },
                        {
                            "text": "Met een verrekijker <w>tuurt</w> hij naar de zeldzame vogels in het bos.",
                            "target_lang_translations": {
                                "en": "With binoculars, he <w>gazes</w> at the rare birds in the forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "staren"
                    ],
                    "common_phrases": [
