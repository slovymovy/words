        "nl-extract.jsonl": [
            {
                "entry_id": "8ef4150f-f4fb-3448-a58e-c51665288338",
                "word": "uitflappen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "79e56aa6-5440-3dcc-8553-b69d845ccd40",
                        "entry_id": "8ef4150f-f4fb-3448-a58e-c51665288338",
                        "glosses": [
                            "plotseling en ongewenst iets doms zeggen"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1d1e734f-9fc1-45c0-a5ca-faefc5da101b",
                                "sense_id": "79e56aa6-5440-3dcc-8553-b69d845ccd40",
                                "text": "Een op de drie is ook zo zenuwachtig dat ze er iets dom uitflappen, wat gegarandeerd zorgt voor gefronste wenkbrauwen bij de collega’s. Ook té vriendelijk of te voorzichtig zijn wordt niet geapprecieerd."
                            },
                            {
                                "example_id": "a6590c10-99f4-4bfb-b7de-ad16f368cb0d",
                                "sense_id": "79e56aa6-5440-3dcc-8553-b69d845ccd40",
                                "text": "Het idee achter het lied was volgens het meisje niet de woede tegenover Oranje, maar een grap over wat Mexicanen er allemaal uitflappen tijdens het kijken van een wedstrijd."
                            },
                            {
                                "example_id": "bdb3cad3-7b96-45f2-aa7c-9be9b2c64c48",
                                "sense_id": "79e56aa6-5440-3dcc-8553-b69d845ccd40",
                                "text": "\"Let niet op de rommel\", een uitspraak die moeders er vaak gedachteloos uitflappen. Onzin, vindt mama Elizabeth. Een huis met kinderen is namelijk bij niemand niet spik en span! Om moeders een hart onder de riem te steken, heeft Elizabeth een lijstje gemaakt met dingen die doodnormaal zijn in een huishouden met kinderen inclusief rommel, stapels was en een met speelgoed bezaaide auto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cb87e88-386a-4879-903f-7f8729bd89d6",
                        "source_entry_id": "8ef4150f-f4fb-3448-a58e-c51665288338",
                        "source_sense_id": "79e56aa6-5440-3dcc-8553-b69d845ccd40",
                        "source_sense_description": "plotseling en ongewenst iets doms zeggen",
                        "target_lang_word": "let slip out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c78223a2-b088-47c1-9ba7-bfab10861233",
                        "source_entry_id": "8ef4150f-f4fb-3448-a58e-c51665288338",
                        "source_sense_id": "79e56aa6-5440-3dcc-8553-b69d845ccd40",
                        "source_sense_description": "plotseling en ongewenst iets doms zeggen",
                        "target_lang_word": "blab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcee2593-cdf7-388d-bd88-04d752197e5e",
                                        "entry_id": "3885fff6-1126-3330-a31c-02fa9f9343a1",
                                        "glosses": [
                                            "To tell tales; to gossip without reserve or discretion."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a69ccd9-28b2-47e7-bfdf-bf8efdf41502",
                                                "sense_id": "bcee2593-cdf7-388d-bd88-04d752197e5e",
                                                "text": "And yonder a vile physician blabbing / The case of his patient."
                                            },
                                            {
                                                "example_id": "92ecc1ef-db89-4225-8797-a33019a1a208",
                                                "sense_id": "bcee2593-cdf7-388d-bd88-04d752197e5e",
                                                "text": "1998, \"Helga Blabs It All\", TV episode in season 3 of Hey Arnold!, animated television series created by Craig Bartlett\nHelga Blabs It All."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418f2ec2-1f4a-36cf-a559-c242a66c35c4",
                                        "entry_id": "3885fff6-1126-3330-a31c-02fa9f9343a1",
                                        "glosses": [
                                            "to speak carelessly or excessively"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d5a98c-0791-3680-a270-b36bccf2c47f",
                                        "entry_id": "bade2205-2082-3f93-8897-e33efbea0b4a",
                                        "glosses": [
                                            "One who blabs; a babbler; a telltale; a gossip or gossiper."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19f79c1d-fb5c-40ee-8232-d0c701e18453",
                                                "sense_id": "c4d5a98c-0791-3680-a270-b36bccf2c47f",
                                                "text": "\"You'd better have shoved your grey snout in a hornets' nest, Badger, than suggest that I am the blab,\" said Nikabrik."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d25ecf6c-562e-3325-9f60-2e2adfabf20e",
                                        "entry_id": "bade2205-2082-3f93-8897-e33efbea0b4a",
                                        "glosses": [
                                            "Gossip; prattle."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc34dca8-b1df-441a-a03d-07d81907c355",
                                                "sense_id": "d25ecf6c-562e-3325-9f60-2e2adfabf20e",
                                                "text": "Audie never liked him because he was further in with old Craig than he was, bragging and blowing about his work and the things he could do, while Audie sat quiet as a mouse listening to his blab."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c93358e-e8f0-4a21-b553-d1449c83076c",
                        "source_entry_id": "8ef4150f-f4fb-3448-a58e-c51665288338",
                        "source_sense_id": "79e56aa6-5440-3dcc-8553-b69d845ccd40",
                        "source_sense_description": "plotseling en ongewenst iets doms zeggen",
                        "target_lang_word": "blurt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blurt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fa551f6-2c5a-35e3-8dae-d97f82cf7580",
                                        "entry_id": "09b3bff2-37ba-3238-a8dc-0ad9a953ca1e",
                                        "glosses": [
                                            "To utter suddenly and unadvisedly; to speak quickly or without thought; to divulge inconsiderately — commonly with out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0daf2ce1-b435-4bc6-8065-b7e0bddd9b56",
                                                "sense_id": "7fa551f6-2c5a-35e3-8dae-d97f82cf7580",
                                                "text": "Please think about your reply and don't just blurt out the first thing that comes to mind."
                                            },
                                            {
                                                "example_id": "404fa012-e40f-47fb-a63b-082e23a7040d",
                                                "sense_id": "7fa551f6-2c5a-35e3-8dae-d97f82cf7580",
                                                "text": "\"Who are you?!\" he blurted into the woman's palm, and she shook it off in obvious disgust, wiping spittle onto his D-class uniform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3764d063-26a5-321d-b506-2edb8366913b",
                                        "entry_id": "09b3bff2-37ba-3238-a8dc-0ad9a953ca1e",
                                        "glosses": [
                                            "To spurt."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3431c7e-4667-494b-839a-2cf9023533dd",
                                                "sense_id": "3764d063-26a5-321d-b506-2edb8366913b",
                                                "text": "the sound of rusty water blurting from the faucet in the kitchen"
                                            },
                                            {
                                                "example_id": "77c6faf0-df05-4a8a-a39c-0a81cd9fa88d",
                                                "sense_id": "3764d063-26a5-321d-b506-2edb8366913b",
                                                "text": "Blurted tea onto the monitor at FAL being \"satisfying\" and Brine's reaction . . ."
                                            }
                                        ]
                                    }
                                ]
