                        ],
                        "examples": [
                            {
                                "example_id": "6354a131-391b-40b3-98b4-aef6be989267",
                                "sense_id": "fd6149ae-f56c-393c-88ac-b2c990a6cdc7",
                                "text": "L’urochroé de Bouguer se rapproche du Sternoclyta cyaneipectus; mais il n’a pas, comme celui-ci, de bande blanche après les yeux, et il présente, dans ses rectrices, des caractères différents. Il semble faire le passage aux doryfères par son bec allongé, presque droit et plus fort que chez les Sternoclytes."
                            }
                        ]
                    }
