                                "target_senses": [
                                    {
                                        "sense_id": "df696d8e-5299-35aa-819f-33ca2e5111a4",
                                        "entry_id": "56d98321-c8f4-3437-9d81-4bc187235629",
                                        "glosses": [
                                            "An electronic device for connecting a balanced transmission line to an unbalanced one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc5a894c-bd9f-4192-bd5a-19595330d22c",
                                                "sense_id": "df696d8e-5299-35aa-819f-33ca2e5111a4",
                                                "text": "2001, Rick Sturdivant, Balun Design for Wireless: Mixers, Amplifiers and Antennas, in Practical Filters and Couplers, Noble Publishing Corporation, page 25,\nBaluns find wide use in mixer, antenna and balanced amplifier circuits. Yet balun design is still regarded as if it were black magic by many engineers partly due to the fact that practical design information on baluns can be difficult to find."
                                            },
                                            {
                                                "example_id": "e2bfc617-26fa-49b3-a412-4a9309a6ae62",
                                                "sense_id": "df696d8e-5299-35aa-819f-33ca2e5111a4",
                                                "text": "The Roberts balun [23] design adds an open-circuited stub λ/4 long inside the dummy coax of the folded balun."
                                            },
                                            {
                                                "example_id": "1092ce61-3b37-4f58-aaf4-2313dc5fe49b",
                                                "sense_id": "df696d8e-5299-35aa-819f-33ca2e5111a4",
                                                "text": "In (e) a balun at the end of the coaxial feedline provides equal and opposite voltages to each side of the dipole and eliminates any current from the outside of the feedline."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
