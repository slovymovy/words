                        "source_sense_id": "e11ec991-ee64-35da-809b-b81acd73c9b7",
                        "source_sense_description": "unaufhaltsames, starkes Nachlassen der Gedächtnisfähigkeiten bis hin zur völligen Demenz",
                        "target_lang_word": "maladie d’Alzheimer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maladie d’Alzheimer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fab86da-24c7-38df-b0aa-ad9635c7c306",
                                        "entry_id": "672279a5-9cd1-35f4-ae2f-e93a0e12bf0b",
                                        "glosses": [
                                            "Maladie neurodégénérative du cerveau qui entraîne la perte progressive et irréversible des fonctions mentales et notamment de la mémoire."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af824eea-05f6-4fb7-b68d-f67104d1d873",
                                                "sense_id": "9fab86da-24c7-38df-b0aa-ad9635c7c306",
                                                "text": "Un événement restera toujours dans la mémoire de l'histoire d'un individu, sauf dans des cas pathologiques comme la sénilité ou la maladie d'Alzheimer."
                                            },
                                            {
                                                "example_id": "223d893c-7235-4187-90ca-116894f9a841",
                                                "sense_id": "9fab86da-24c7-38df-b0aa-ad9635c7c306",
                                                "text": "Ces vingt dernières années, des progrès considérables ont été accomplis dans la connaissance et la prise en charge de la maladie d’Alzheimer."
                                            },
                                            {
                                                "example_id": "749b9056-b43f-490c-bb4b-bb9daba318a4",
                                                "sense_id": "9fab86da-24c7-38df-b0aa-ad9635c7c306",
                                                "text": "Autant d'aspects que nous avons articulés autour d'une problématique centrale : la construction sociale de la maladie d’Alzheimer. Il s'agira donc de penser la maladie d’Alzheimer à l'aide des outils conceptuels de la perspective interactionniste et de la sociologie des politiques publiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
