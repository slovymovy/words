                "senses": [
                    {
                        "sense_id": "259155f0-391f-391e-8acf-0db5db9d4902",
                        "entry_id": "53b3b1d0-9913-37e0-a454-60230a2bf679",
                        "glosses": [
                            "Légitimer soi-même, sans attendre la légitimation par quelqu’un d’extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "237a0ead-792a-497a-b2ea-d65e517febe7",
                                "sense_id": "259155f0-391f-391e-8acf-0db5db9d4902",
                                "text": "Ce sont ces deux principes que les néoclassiques utilisent pour auto-légitimer leurs propres théories."
                            },
                            {
                                "example_id": "573402c3-3781-43cc-b388-bf4af96c7642",
                                "sense_id": "259155f0-391f-391e-8acf-0db5db9d4902",
                                "text": "Le modèle systémique, une fois opacifié par une pseudo-logique, tend à s'auto-confirmer et s'auto-légitimer en prédisant ce qu'il contribue à faire exister."
                            }
                        ]
                    }
