                    "sense_id": "ca8cebdd-046e-3ee6-a754-8df8691fa42f",
                    "sense_definition": "niet te bedwingen of tot rust te brengen; vol tomeloze energie of passie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij toonde een <w>ontembare</w> energie tijdens de repetities van het toneelstuk.",
                            "target_lang_translations": {
                                "en": "She showed an <w>untamable</w> energy during the play's rehearsals."
                            }
                        },
                        {
                            "text": "Zijn <w>ontembare</w> nieuwsgierigheid bracht hem telkens weer in onbekende situaties.",
                            "target_lang_translations": {
                                "en": "His <w>insatiable</w> curiosity constantly led him into unfamiliar situations."
                            }
                        }
                    ],
                    "synonyms": [
