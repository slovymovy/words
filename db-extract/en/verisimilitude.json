                    {
                        "translation_id": "1880b051-9bde-486f-b292-3187e69f44bb",
                        "source_entry_id": "b2d77a98-c28e-31bf-8cf9-39040a606422",
                        "source_sense_description": "property of seeming true",
                        "target_lang_word": "Realitätsnähe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Realitätsnähe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e08ee83c-1e90-3758-8846-82736c17f193",
                                        "entry_id": "acac00ff-0758-31e6-920e-049c4ebf3da3",
                                        "glosses": [
                                            "korrekte Aufnahme, Wahrnehmung oder Beschreibung der Wirklichkeit (unter Berücksichtigung unrealistischer Gedanken, Träume und Wünsche)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5995928-5586-43c4-9717-3ff5d1ba1323",
                                                "sense_id": "e08ee83c-1e90-3758-8846-82736c17f193",
                                                "text": "Der neue Simulator ermöglicht eine größere Realitätsnähe der Ausbildung."
                                            },
                                            {
                                                "example_id": "1ba88fcd-3e45-4cf9-80d8-354d1052f522",
                                                "sense_id": "e08ee83c-1e90-3758-8846-82736c17f193",
                                                "text": "„Die Ungenauigkeit führt dazu, dass mir die Realitätsnähe dieses Vorhabens nicht klar ist.“"
                                            },
                                            {
                                                "example_id": "bd91c3ad-e2a9-47e4-ad8f-e64de4d85b41",
                                                "sense_id": "e08ee83c-1e90-3758-8846-82736c17f193",
                                                "text": "„Realitätsnähe meint dabei, dass die künstlich erzeugten Fehler realen Programmierfehlern nahe kommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08218d1a-5221-43f6-a071-5c6023609dd1",
                        "source_entry_id": "b2d77a98-c28e-31bf-8cf9-39040a606422",
                        "source_sense_description": "property of seeming true",
                        "target_lang_word": "Authentizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Authentizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                        "entry_id": "e248566f-6147-3347-afa4-7c91016901e9",
                                        "glosses": [
                                            "Eigenschaft einer Sache, Person oder Organisation, authentisch (auf Echtheit geprüft, zuverlässig) zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a68b8b3f-1432-472c-8cf5-eb114ce516d0",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "Authentizität, so definiert es das Lexikon, bedeutet, dass das Handeln einer Person nicht durch äußere Einflüsse bestimmt wird, sondern in der Person selbst begründet liegt."
                                            },
                                            {
                                                "example_id": "ea00c160-9198-422f-9f88-9a78eb06a312",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "Die Authentizität des Dokuments ist überprüft worden und nicht zu bestreiten."
                                            },
                                            {
                                                "example_id": "cef3e311-eb3c-4b1d-ac38-ce5d11cebc0a",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "„Mitunter stoßen die Fahnder bei dem Procedere auch auf Steuersünder, die sich selbst angezeigt haben - ein Beleg für die Authentizität des Materials.“"
                                            },
                                            {
                                                "example_id": "cbfa7a27-31a2-40c5-a345-6b6edc8a1286",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "In fast allen Lehrplänen und Richtlinien für den Fremdsprachenunterricht können wir den Begriff der Authentizität finden."
                                            },
                                            {
                                                "example_id": "4a5ef6f0-d854-4158-a194-f4f8117d59ca",
                                                "sense_id": "aaae1c3f-1de3-360c-868c-c55484bd98de",
                                                "text": "„Die Authentizität der fremden Gäste wird noch durch die Bauart ihrer Wohnung bekräftigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
