                "senses": [
                    {
                        "sense_id": "147b3acf-ab45-342e-8e52-cfb6f3569896",
                        "entry_id": "7b5db342-0b47-3655-ba31-d3d608615932",
                        "glosses": [
                            "größere, bewohnte unterirdische Siedlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae6e73d0-0aa1-4afc-996a-444e07a86d6d",
                                "sense_id": "147b3acf-ab45-342e-8e52-cfb6f3569896",
                                "text": "„Robert, als habe er jetzt auf rechte Weise Sinn und Ziel seines Aufenthalts in der Katakombenstadt erkannt, ging schon mit festen Schritten davon, während er den Blick kurz zurückwandte, um dem Wächter mit einem Kopfnicken für die Auskunft zu danken.“"
                            },
                            {
                                "example_id": "1e97f2a2-7dbb-4d97-94ec-cdcd7c39dda0",
                                "sense_id": "147b3acf-ab45-342e-8e52-cfb6f3569896",
                                "text": "„Eine richtige „Katakombenstadt“ unter der Erde war entstanden.“"
                            },
                            {
                                "example_id": "670f305f-969a-4e58-92d9-2e8e575daff5",
                                "sense_id": "147b3acf-ab45-342e-8e52-cfb6f3569896",
                                "text": "„Die dritte Stadt war die Katakombenstadt in den Kalksteinbrüchen.“"
                            },
                            {
                                "example_id": "1aead89f-2824-49d9-b0e9-c5d44ffcf0fd",
                                "sense_id": "147b3acf-ab45-342e-8e52-cfb6f3569896",
                                "text": "„Und in der toten Stille der Katakombenstadt wusste er endlich, dass er ganz allein auf der Welt sei, irgendwo auf einem millionenweiten, weit entfernten Stern: er vergaß, dass es noch jemanden außer ihm in dem ganzen Weltall gäbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
