                        "een kalme reactie"
                    ],
                    "target_lang_definitions": {
                        "en": "quiet and controlled, without strong emotions or excitement",
                        "ru": "спокойный и сдержанный, без сильных эмоций или волнения"
                    },
                    "translations": {
