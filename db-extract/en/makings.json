                    {
                        "sense_id": "d9cf5f0f-c45d-3468-84b1-e6dd9346ef72",
                        "entry_id": "3c2d2b7f-ca6e-36c3-8a4d-6812e101ac8a",
                        "glosses": [
                            "Ingrédients (figuré : choses nécessaires), étoffe (figuré ; en parlant d’une personne)."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f02e5837-7dcf-444c-ad4b-5326ed818d19",
                                "sense_id": "d9cf5f0f-c45d-3468-84b1-e6dd9346ef72",
                                "text": "After I saw him stand up to his boss, I decided he had the makings of a man after all.",
                                "translation": "Après que je l’eus vu tenir tête à son patron, je me mis à penser qu’il avait l’étoffe d’un homme après tout."
                            },
                            {
                                "example_id": "e3e8e0ca-fed4-4e7e-a455-f5dae96c870d",
                                "sense_id": "d9cf5f0f-c45d-3468-84b1-e6dd9346ef72",
                                "text": "He has the makings of a fine young man.",
                                "translation": "Il a l’étoffe d’un jeune homme bien sous tout rapport."
                            },
                            {
                                "example_id": "15b8e50d-6981-40d2-a8ce-80a08a7719aa",
                                "sense_id": "d9cf5f0f-c45d-3468-84b1-e6dd9346ef72",
                                "text": "Those are all the makings for good comedy.",
                                "translation": "Voilà tous les ingrédients pour du comique de qualité."
                            }
                        ]
                    }
