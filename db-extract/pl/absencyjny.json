                        "translation_id": "1573b88e-c168-4b32-807e-2544c615e867",
                        "source_entry_id": "75273a07-3a2b-3804-9ffb-f6facec44f75",
                        "source_sense_id": "88ec6b72-5bc1-3589-933b-31b97b1f6174",
                        "source_sense_description": "sich auf das Fernbleiben beziehend; Abwesenheits-, Absenz-, Fehl-",
                        "target_lang_word": "Abwesenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwesenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                        "entry_id": "4d7e74ad-aaff-3677-9a62-79e4feb2e3d2",
                                        "glosses": [
                                            "der Zustand, dass man körperlich nicht zugegen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418fa321-89b5-4e0b-a299-317e76ba3819",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "Er glänzte mal wieder durch Abwesenheit."
                                            },
                                            {
                                                "example_id": "81668475-9b5b-4ebf-bbb3-44ffbdc86fe6",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Denn Kaschmir ist unendlich weich, leicht, schmeichelt der Haut und ist wie eine sanfte Umarmung, weswegen manche Frauen Kaschmirschals bei Abwesenheit des Liebsten auch gerne als Streichelersatz nutzen.“"
                                            },
                                            {
                                                "example_id": "66c393ea-7f30-4065-87ee-76f458d06676",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Zunächst, in Abwesenheit ihres altgedienten Vorsitzenden, hatten die Unabhängigen es halsstarrig abgelehnt, Nichtsozialisten in die Regierung aufzunehmen, und sei es auch nur als Fachleute ohne exekutive Befugnisse.“"
                                            },
                                            {
                                                "example_id": "e6e331e7-3f28-44e2-8104-3ed8c0061b0a",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Ihm war ein Jahr Abwesenheit gewährt worden.“"
                                            },
                                            {
                                                "example_id": "25761f13-2494-424c-ae58-47053a2e76ee",
                                                "sense_id": "78175545-c9d9-345e-95c5-835c9af98f8d",
                                                "text": "„Glück wurde einmal als Abwesenheit von Unruhe definiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0748903-e541-37d8-8dd5-d508a2209a66",
                                        "entry_id": "4d7e74ad-aaff-3677-9a62-79e4feb2e3d2",
                                        "glosses": [
                                            "der Zustand, dass man geistig nicht zugegen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbb6ae6-ad5a-4d78-bb09-3520ac7262da",
                                                "sense_id": "e0748903-e541-37d8-8dd5-d508a2209a66",
                                                "text": "Sein Gesicht drückt völlige Abwesenheit aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04a1970e-7717-4289-86b4-4aee4ff7b881",
                        "source_entry_id": "75273a07-3a2b-3804-9ffb-f6facec44f75",
