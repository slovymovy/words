{
    "word_family": [
        "propeller",
        "propulsion",
        "propulsive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16f98076-b51e-3974-bcde-68caca3cce18",
                    "sense_definition": "To provide an impetus for motion or physical action; to cause to move in a certain direction; to drive or push forward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine is designed to <w>propel</w> the boat across the lake at high speeds.",
                            "target_lang_translations": {
                                "zh": "这台发动机的设计目的是<w>推动</w>船只高速穿过湖面。"
                            }
                        },
                        {
                            "text": "Strong winds <w>propel</w> the ship forward toward the harbor.",
                            "target_lang_translations": {
                                "zh": "强风<w>推进</w>着船只向港口前进。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drive",
                        "push"
                    ],
                    "antonyms": [
                        "stay",
                        "halt",
                        "stop",
                        "rest"
                    ],
                    "common_phrases": [
                        "propel forward"
                    ],
                    "target_lang_definitions": {
                        "zh": "提供动力使物体移动；推动或驱使某物向特定方向前进。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推动",
                                "target_lang_sense_clarification": "指施加力量使物体移动或前进。"
                            },
                            {
                                "target_lang_word": "推进",
                                "target_lang_sense_clarification": "指使物体向前移动，常用于机械或交通工具。"
                            },
                            {
                                "target_lang_word": "驱动",
                                "target_lang_sense_clarification": "指利用动力使机器或车辆运转。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c3ac1b6-0612-3933-b7a9-8764a4bc31c9",
                    "sense_definition": "To provide an impetus for nonphysical change; to cause to arrive to a certain situation or result.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hard work helped <w>propel</w> her to a successful career in politics.",
                            "target_lang_translations": {
                                "zh": "她的努力工作<w>促使</w>她在政治生涯中取得了成功。"
                            }
                        },
                        {
                            "text": "The sudden success of the album <w>propel</w> the band to international fame.",
                            "target_lang_translations": {
                                "zh": "这张专辑的突然成功<w>推动</w>该乐队走向了国际名声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drive",
                        "push"
                    ],
                    "antonyms": [
                        "stay",
                        "halt",
                        "stop"
                    ],
                    "common_phrases": [
                        "propel to success"
                    ],
                    "target_lang_definitions": {
                        "zh": "促使某人或某事进入某种状态或取得某种结果。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "促使",
                                "target_lang_sense_clarification": "指推动某人或某事向特定方向发展。"
                            },
                            {
                                "target_lang_word": "推动",
                                "target_lang_sense_clarification": "指在抽象层面促进事物的发展或进程。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}