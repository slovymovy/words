                ],
                "senses": [
                    {
                        "sense_id": "d659fea9-af93-3132-bc72-1c2305aec3a7",
                        "entry_id": "944dfca1-fb42-3661-8890-2e81f0face34",
                        "glosses": [
                            "Abschnitt an der Front, an der Kämpfe stattfinden"
                        ],
                        "tags": [
                            "auch übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "07707c41-0069-4ec0-a512-c35a789722e2",
                                "sense_id": "d659fea9-af93-3132-bc72-1c2305aec3a7",
                                "text": "„Die Kampflinie verschiebt sich und schneidet auch die Wege zu den Märkten ab.“"
                            },
                            {
                                "example_id": "0035278d-e84b-4d9c-8147-57a79d941000",
                                "sense_id": "d659fea9-af93-3132-bc72-1c2305aec3a7",
                                "text": "„Solche Widersprüche hindern Christian Levrat nicht daran, seine Kampflinie eisern zu halten. Sein strategisches Ziel lautet: mehr staatlich verordnete Verteilungsgerechtigkeit.“"
                            },
                            {
                                "example_id": "912ee309-19cb-4717-86c5-ec28fe994633",
                                "sense_id": "d659fea9-af93-3132-bc72-1c2305aec3a7",
                                "text": "„Die Kanzlei setzte auf die harte Kampflinie, letztlich ohne Fortune.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e5166ecc-2381-32e6-bb1b-9fae9cbb8810",
                        "entry_id": "944dfca1-fb42-3661-8890-2e81f0face34",
                        "glosses": [
                            "zu fahrender Streckenverlauf zur bestmöglichen Verteidigung gegen einen folgenden Gegner auf einer Wettkampfstrecke"
                        ],
                        "tags": [
                            "Motorsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8f64d728-1b95-419f-b16d-d26942cd9af3",
                                "sense_id": "e5166ecc-2381-32e6-bb1b-9fae9cbb8810",
                                "text": "„Am Ende der langen Start-Ziel-Geraden, wo die Autos mit \"viel Flügel\" rund 320 km/h schnell sind, passierte er den verdutzten Schotten auf der äußeren Kampflinie.“"
                            },
                            {
                                "example_id": "a11dc2ec-09ea-4811-92b6-775f4eee646d",
                                "sense_id": "e5166ecc-2381-32e6-bb1b-9fae9cbb8810",
                                "text": "„Der Gegner muss Kampflinie fahren, um den Angriff abzuwehren, und innen anbremsen.“"
                            },
                            {
                                "example_id": "27f6b9db-a22e-486c-882a-15d4c89a594d",
                                "sense_id": "e5166ecc-2381-32e6-bb1b-9fae9cbb8810",
                                "text": "„Ein Duell wie in Monza, als Michael Schumacher Lewis Hamilton mit seiner beinharten Kampflinie rundenlang zur Verzweiflung trieb, gehört damit wohl der Vergangenheit an.“"
                            },
                            {
                                "example_id": "e0d0ba6c-7ea9-4076-8619-b8b298530b50",
                                "sense_id": "e5166ecc-2381-32e6-bb1b-9fae9cbb8810",
                                "text": "„Allerdings durfte sich der Weltmeister nicht lange über die Spitzenposition freuen, denn in der 34. Runde quetschte sich Montoya am Ende der Start-Ziel-Geraden am Kerpener vorbei, obwohl der Kampflinie fuhr.“"
                            },
                            {
                                "example_id": "3d431384-8d29-495b-af03-12e0bd87c5ec",
                                "sense_id": "e5166ecc-2381-32e6-bb1b-9fae9cbb8810",
                                "text": "„Walther musste einige Male Kampflinie fahren, spielte dabei all seine Routine aus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
