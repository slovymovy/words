                "translations": [
                    {
                        "translation_id": "54d22ea8-d49a-4f35-96b7-b0ad76f741f3",
                        "source_entry_id": "2db0b394-10c2-32a4-a00e-e98196e9975c",
                        "source_sense_id": "cfee3a26-818a-38ee-a4f7-89750a60cda4",
                        "target_lang_word": "gemeinsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gemeinsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                        "entry_id": "695bf3dc-7afc-3d14-9bdb-1b81eac0669a",
                                        "glosses": [
                                            "mehreren Personen oder Sachen zugleich eigen (jedem gehört ein Anteil daran)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8508054a-9f85-47f5-99aa-0cf1d91d97a5",
                                                "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                                "text": "Die beiden Länder verfolgen gemeinsame Interessen."
                                            },
                                            {
                                                "example_id": "e42b2e3f-d2fb-44d6-aae5-c2dfee963249",
                                                "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                                "text": "„So unterschiedlich das jeweilige Krisenmanagement auch ist - gemeinsam ist doch allen die Erkenntnis, dass es so jedenfalls keinesfalls weitergehen kann.“"
                                            },
                                            {
                                                "example_id": "f01b183c-8325-4513-87e8-5b94d92722c9",
                                                "sense_id": "ab4b5e05-be85-3fda-ac62-36d095c74d83",
                                                "text": "„Nach der Heirat im August 1926 zog das ungleiche Paar nach Immenhausen bei Kassel, wo sie eine gemeinsame Hausarztpraxis eröffneten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                        "entry_id": "695bf3dc-7afc-3d14-9bdb-1b81eac0669a",
                                        "glosses": [
                                            "in Gemeinschaft, zusammen mit mindestens einem Anderen (neben- und miteinander)"
                                        ],
                                        "tags": [
                                            "auch adverbiell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8a0c1c-2e66-4193-a56b-bb5e234aa398",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Dabei basiert der Q6 auf dem neuen Q5 und damit auf der längsmodularen Plattform. […] Beide Modelle werden gemeinsam im neuen Audi-Werk in San José Chiapa (Mexiko) vom Band rollen.“"
                                            },
                                            {
                                                "example_id": "677fab88-7ff9-4ffb-b65f-a464b1361784",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "Das Buch entstand in gemeinsamer Arbeit der Autoren."
                                            },
                                            {
                                                "example_id": "99727fdb-7b6c-4122-95a1-9070718684e3",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Bald einmal gehörten die Deltaflieger so selbstverständlich zum Himmel über Vaduz wie die Bussarde und Milane, mit denen sie gemeinsam die Aufwinde nützen.“"
                                            },
                                            {
                                                "example_id": "509eacbd-e27d-4257-ac1b-d2279860284f",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                                            },
                                            {
                                                "example_id": "215b5809-ec11-4796-85fc-4973a051d1a7",
                                                "sense_id": "7c328900-525e-3415-b967-ef35b2193d0b",
                                                "text": "„Beim gemeinsamen Kreisen in der Thermik mit den ständigen Abstandsänderungen der Gleitschirme zueinander gilt in besonderem Maße Sehen und Gesehenwerden, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d2c1886-9a48-451f-8ae9-31790cc94ae1",
                        "source_entry_id": "2db0b394-10c2-32a4-a00e-e98196e9975c",
                        "source_sense_id": "cfee3a26-818a-38ee-a4f7-89750a60cda4",
                        "target_lang_word": "miteinander",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miteinander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4d06ad6-429e-3089-bbfe-76f5aa2a5c69",
                                        "entry_id": "659e1876-5db8-3eba-880e-663a3fc9610d",
                                        "glosses": [
                                            "mehrere Personen/Dinge führen gemeinsam dieselbe Handlung aus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e210c455-6814-4cb8-aefd-62fa22928077",
                                                "sense_id": "b4d06ad6-429e-3089-bbfe-76f5aa2a5c69",
                                                "text": "Wollen wir miteinander in Urlaub fahren?"
                                            },
                                            {
                                                "example_id": "cb3158df-4f9f-4295-9bfc-3fbe00856333",
                                                "sense_id": "b4d06ad6-429e-3089-bbfe-76f5aa2a5c69",
                                                "text": "Wir wollen, wie man so schön sagt, miteinander alt werden."
                                            },
                                            {
                                                "example_id": "b6094915-3489-4afa-a28e-a4f31289f6ab",
                                                "sense_id": "b4d06ad6-429e-3089-bbfe-76f5aa2a5c69",
                                                "text": "Die Königreiche kämpften miteinander gegen das römische Reich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e10e92f9-8146-363e-a247-acedc94a6d36",
                                        "entry_id": "659e1876-5db8-3eba-880e-663a3fc9610d",
                                        "glosses": [
                                            "mehrere Personen/Dinge führen eine Handlung gegenseitig aneinander aus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88717f77-3fc1-4741-aa0c-07488e8d76d0",
                                                "sense_id": "e10e92f9-8146-363e-a247-acedc94a6d36",
                                                "text": "Wir wollen das Problem miteinander besprechen."
                                            },
                                            {
                                                "example_id": "48f469ce-89ae-4d60-bfca-ac316cbd1f1f",
                                                "sense_id": "e10e92f9-8146-363e-a247-acedc94a6d36",
                                                "text": "Die Königreiche kämpften miteinander um die Vormachtstellung in der Region."
                                            },
                                            {
                                                "example_id": "7ccc080a-e71b-46ee-9d22-802862d8e5d3",
                                                "sense_id": "e10e92f9-8146-363e-a247-acedc94a6d36",
                                                "text": "Streitet nicht immer miteinander!"
                                            },
                                            {
                                                "example_id": "e566a61e-ff36-4861-aa80-223395cd5afa",
                                                "sense_id": "e10e92f9-8146-363e-a247-acedc94a6d36",
                                                "text": "„Daß Mensch und Natur sehr wohl miteinander auskommen können, haben die sächsischen Freikletterer seit über 130 Jahren bewiesen.“"
                                            },
                                            {
                                                "example_id": "9fd6463d-557b-42ce-a359-dc21b74b5f7d",
                                                "sense_id": "e10e92f9-8146-363e-a247-acedc94a6d36",
                                                "text": "„Die Stämme leben also keineswegs isoliert, sondern schließen Allianzen miteinander und stellen große Armeen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
