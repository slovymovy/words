                "senses": [
                    {
                        "sense_id": "82f1a01f-4f7b-32e6-9b3d-70beac4e266f",
                        "entry_id": "7d2f0334-8358-365e-a5ce-abe991a36525",
                        "glosses": [
                            "w Kościele katolickim: kardynał, który od śmierci papieża do czasu wybrania nowego zarządza Kościołem i państwem Watykan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f63d738c-e0cb-4089-ba1e-4b318368eda4",
                                "sense_id": "82f1a01f-4f7b-32e6-9b3d-70beac4e266f",
                                "text": "Po śmierci papieża kamerling niszczy pierścień Rybaka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ad9078b-b4a6-48e0-9fa1-7792c79f2315",
                        "source_entry_id": "7d2f0334-8358-365e-a5ce-abe991a36525",
                        "source_sense_id": "82f1a01f-4f7b-32e6-9b3d-70beac4e266f",
                        "target_lang_word": "camerlengo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camerlengo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a580b13-9f3a-34da-8cc0-b937b2823bd6",
                                        "entry_id": "7a17d9ca-96ef-31cf-95a0-a540c0868349",
                                        "glosses": [
                                            "The cardinal who administers the Roman Catholic Church in the interregnum between Popes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65fafa5-184d-4569-84a0-3ef5cb3923bf",
                                                "sense_id": "4a580b13-9f3a-34da-8cc0-b937b2823bd6",
                                                "text": "Benedict will also stop using the so-called fisherman’s ring to seal documents. It will be destroyed by the cardinal camerlengo, the acting head of state of Vatican City during the “sede vacante,” the canon law term used when the papacy is vacant."
                                            },
                                            {
                                                "example_id": "2d570570-b6b7-44d5-afda-8ef75e31390f",
                                                "sense_id": "4a580b13-9f3a-34da-8cc0-b937b2823bd6",
                                                "text": "For the conclave, the camerlengo is now responsible for ensuring an “orderly election and its privacy”, according to Universi Dominici Gregis—the apostolic constitution governing papal succession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88b6927e-5923-4141-a1fa-d32528959b99",
                        "source_entry_id": "7d2f0334-8358-365e-a5ce-abe991a36525",
                        "source_sense_id": "82f1a01f-4f7b-32e6-9b3d-70beac4e266f",
                        "target_lang_word": "camerlengo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camerlengo",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "211d2139-4bb2-38de-817a-d303ab3d1a78",
                                        "entry_id": "6f5457d5-112e-3e35-8045-1f3285434af3",
                                        "glosses": [
                                            "kardinaal die de rooms katholieke kerk bestuurt als de paus is afgetreden of overleden en de nieuwe paus nog niet is benoemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31480aa-b8b4-4182-bc3c-8c3249fcb61a",
                                                "sense_id": "211d2139-4bb2-38de-817a-d303ab3d1a78",
                                                "text": "Kardinaal Tarcisio Bertone zal als kardinaal-camerlengo de Rooms-Katholieke Kerk besturen, nadat paus Benedictus XVI op 28 februari is afgetreden. Hij blijft dat doen tot het conclaaf van kardinalen een nieuwe paus heeft gekozen."
                                            },
                                            {
                                                "example_id": "5479ce1c-fd9f-4092-846c-6f2217fdde10",
                                                "sense_id": "211d2139-4bb2-38de-817a-d303ab3d1a78",
                                                "text": "Totdat de nieuwe paus is gekozen, bestuurt kardinaal-camerlengo Tarcisio Bertone met de kardinalen de Rooms-Katholieke Kerk. Hij blijft dat doen tot de kardinalen eruit zijn. Bertones belangrijkste taak is de organisatie van het conclaaf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
