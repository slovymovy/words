                        "target_lang_word": "oční víčko",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d89a0b09-d6e6-4eb6-bdfc-eb10978cf82a",
                        "source_entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                        "source_sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                        "source_sense_description": "anatomy: a thin skin membrane that covers and moves over an eye",
                        "target_lang_word": "víčko",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "víčko",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                        "entry_id": "aa39fdbe-7582-37ca-9e40-5870733ec807",
                                        "glosses": [
                                            "víko"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4ef582-e9d8-4d8a-ba76-98cc952125a8",
                                                "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                                "text": "Neviděls víčko od hořčice? Muselo se asi někam zakutálet, nebo co."
                                            },
                                            {
                                                "example_id": "14b4ffe9-eb4b-49b9-855f-a6da35a2b455",
                                                "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                                "text": "„Víčko“ tomu, čím se zavírá petka, na Moravě nikdo neřekne – jedině „vršek“!"
                                            },
                                            {
                                                "example_id": "b33d537c-5ef6-4954-b12c-83c8347026d2",
                                                "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                                "text": "Nařízení Evropské Unie [správně unie, pozn. wiki] v rámci boje proti jednorázovým plastům ukládá povinné používání neodnímatelných víček od 3. července 2024."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d20660b-f9db-3a82-8a28-25de0eec2e1e",
                                        "entry_id": "aa39fdbe-7582-37ca-9e40-5870733ec807",
                                        "glosses": [
                                            "pohyblivý kožní záhyb chránící oko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b487a14b-93a3-4d73-b087-ececd50aec72",
                                                "sense_id": "9d20660b-f9db-3a82-8a28-25de0eec2e1e",
                                                "text": "Já vidím nakloněné tvoje líčko a v lilijné dřív tváři růžnou vlnu, to skloněné tvé dlouhobrvé víčko, plachý tvůj pohled, tvář těkavostí plnu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c282c4b5-ec5b-48fe-82e4-8eea242744c5",
                        "source_entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                        "source_sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                        "source_sense_description": "anatomy: a thin skin membrane that covers and moves over an eye",
                        "target_lang_word": "ooglid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ooglid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e1706e8-0ba5-398f-b231-f5ad014dbdc6",
                                        "entry_id": "c4d2e5f8-f8ed-3a3f-bc9e-90f5925e209c",
                                        "glosses": [
                                            "een beschermend vlies van huid dat over de ogen bewogen kan worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c0f7652-5c04-4008-9843-29dec660630c",
                                                "sense_id": "2e1706e8-0ba5-398f-b231-f5ad014dbdc6",
                                                "text": "Als je met je ogen knippert, beweeg je je ooglid over je ogen."
                                            },
                                            {
                                                "example_id": "bfa7cf0d-a999-4482-9651-1dd744086200",
                                                "sense_id": "2e1706e8-0ba5-398f-b231-f5ad014dbdc6",
                                                "text": "Als kind had hij een bleek, vrijwel rond gezicht met zware oogleden, waardoor hij iets van een verdrietige Pierrot had."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e01df6a9-a7e2-46fc-8d3e-4ef0567601da",
                        "source_entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                        "source_sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                        "source_sense_description": "anatomy: a thin skin membrane that covers and moves over an eye",
                        "target_lang_word": "paupière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paupière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                        "entry_id": "27a1c9e9-a5dd-32f0-a824-8735ee4ef0c7",
                                        "glosses": [
                                            "Chacune des deux membranes mobiles qui recouvrent le globe de l’œil quand elles se rapprochent, et qui sont bordées de petits poils appelés cils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea0de6b-34b9-40a3-927a-99b2e622d8b2",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "La proéminence de l’arcade de l’œil, […] ajoute encore à cette mélancolie par la tristesse, physique pour ainsi dire, que produisent les paupières quand elles sont trop abaissées sur la prunelle."
                                            },
                                            {
                                                "example_id": "8efe4a0d-f9bd-4160-a181-e3dc21b7cb4a",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "C'étaient des yeux extraordinaires, bleus, mais foncés et brillants à la fois, humides, las, en pleurs et en feu, presque fermés sous le poids des cils et des paupières."
                                            },
                                            {
                                                "example_id": "56003fca-0bf4-4076-a6cc-10fc31db05d0",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "M. D…, à Jarville; paralysie de la paupière supérieure gauche. — Se rend à l'hôpital, où on lui fait des piqûres à la suite desquelles la paupière se soulève, mais l’œil gauche était dévié de 45° vers l'extérieur."
                                            },
                                            {
                                                "example_id": "882684c1-79af-4ec1-9c40-25b8e9e08d75",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "J’aperçois, dans le décor que la pénombre commence à envahir, le modelé de mon front, l’ovale de mon visage et, sous ma paupière clignante, mon regard par lequel j’entre en moi comme dans un tombeau."
                                            },
                                            {
                                                "example_id": "a024cad1-61fe-430e-9f21-e3d37059b5ac",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "Les paupières, quand il les abaisse, témoignent d’une virginité aussi brillante, rêveuse et cadencée que les iris qu’elles cachent."
                                            },
                                            {
                                                "example_id": "e050165a-e5c9-4160-98a6-225e97118abe",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "Je sentais l'intensité du courant grandir et à mesure ma gorge, mes mâchoires, tous les muscles de mon visage, jusqu'à mes paupières se contacter dans une crispation de plus en plus douloureuse."
                                            },
                                            {
                                                "example_id": "f8bae299-14a0-4fce-9c70-821e4f9927ad",
                                                "sense_id": "2d145a10-773f-344c-bf85-dad6dc7dea1f",
                                                "text": "Elle se passa les doigts sur les paupières, les yeux reprirent une expression humaine comme si elle revenait d'une pâmoison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6687ff5e-8d7f-36f6-a4f3-4f6cd15f392a",
                                        "entry_id": "27a1c9e9-a5dd-32f0-a824-8735ee4ef0c7",
                                        "glosses": [
                                            "Cils."
                                        ],
                                        "tags": [
                                            "dated",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b59d1b-0109-4f2a-9cc8-f9ee3391e381",
                                                "sense_id": "6687ff5e-8d7f-36f6-a4f3-4f6cd15f392a",
                                                "text": "[…] en la voyant assise au milieu des femmes anglaises, ses paupières noires, baissées comme leurs paupières blondes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b77b4093-d470-3248-b57c-93f99b5fed52",
                                        "entry_id": "27a1c9e9-a5dd-32f0-a824-8735ee4ef0c7",
                                        "glosses": [
                                            "Yeux, regard."
                                        ],
                                        "tags": [
                                            "dated",
                                            "metonymically",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2821978d-5013-42fe-a34e-d583c7cc866c",
                                                "sense_id": "b77b4093-d470-3248-b57c-93f99b5fed52",
                                                "text": "Et si mes yeux parfois s'ouvrent à la lumière, Bientôt la nuit épaisse obscurcit ma paupière"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1adbe73d-bbb9-47ca-a36c-f6f62116e0d1",
                        "source_entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                        "source_sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                        "source_sense_description": "anatomy: a thin skin membrane that covers and moves over an eye",
                        "target_lang_word": "Augenlid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenlid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "821df552-ecb1-35fa-8d6e-60eace8dcc7e",
                                        "entry_id": "ee737502-3883-34da-817c-0d98210fddd8",
                                        "glosses": [
                                            "Haut zum Bedecken der Augen bei höheren Tieren und dem Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e749351-7219-4ed7-868c-7435ac5ca996",
                                                "sense_id": "821df552-ecb1-35fa-8d6e-60eace8dcc7e",
                                                "text": "Das gerötete Augenlid weist auf eine Entzündung des Auges hin."
                                            },
                                            {
                                                "example_id": "d4a027d3-1d0c-454b-905e-b7db6dc60fee",
                                                "sense_id": "821df552-ecb1-35fa-8d6e-60eace8dcc7e",
                                                "text": "„Hingegossen liegt er da, kaum noch sitzend, seine Augenlider hebt er kaum, und träumt und träumt.“"
                                            },
                                            {
                                                "example_id": "9e016a3f-4eb7-49c2-a54e-9b39379c91cb",
                                                "sense_id": "821df552-ecb1-35fa-8d6e-60eace8dcc7e",
                                                "text": "„Lassehn öffnet die fest verkrampften Augenlider, schleudert den Mantel von sich und stellt sich mit einem Satz auf die Füße, läuft vor den Spiegel und starrt entsetzt in das matte Glas.“"
                                            },
                                            {
                                                "example_id": "fcdd3521-9f4e-4a5c-85fe-36ac758b4d2f",
                                                "sense_id": "821df552-ecb1-35fa-8d6e-60eace8dcc7e",
                                                "text": "„Er versuchte, die Hände aufzuheben und mit ihnen die Augenlider fest- und offenzuhalten.“"
                                            },
                                            {
                                                "example_id": "6c16f177-ff4a-41c8-be61-f05e9406579d",
                                                "sense_id": "821df552-ecb1-35fa-8d6e-60eace8dcc7e",
                                                "text": "„Ihre Augenlider geraten wieder in Bewegung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a75bf896-021a-403d-a6a8-2d98f4db1b52",
                        "source_entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                        "source_sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                        "source_sense_description": "anatomy: a thin skin membrane that covers and moves over an eye",
                        "target_lang_word": "Lid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                        "entry_id": "01f8f441-be3b-38a1-9c1b-bcafb8c0de85",
                                        "glosses": [
                                            "Haut zum Bedecken der Augen bei höheren Tieren und dem Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9f9039-93cf-4fcc-86a5-8940daaaa8fe",
                                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                                "text": "Nur am Zucken ihrer Lider konnte man ihre Aufregung erkennen."
                                            },
                                            {
                                                "example_id": "a5df8b8e-e694-4b67-a0e7-6fb0f23fed4c",
                                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                                "text": "„Sein Mund bewegte sich, und unter den geschlossenen Lidern rasten die Pupillen.“"
                                            },
                                            {
                                                "example_id": "0a6f3c38-9207-48da-af5e-acfaa3a06220",
                                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                                "text": "„Die Augen hat er geschlossen, und sein Gesichtsausdruck verändert sich, als sähe er auf der Innenseite seiner Lider einen tragischen Film in Zeitraffer.“"
                                            },
                                            {
                                                "example_id": "58556b21-e36e-4a3b-a631-fd9d8ae53e5b",
                                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                                "text": "„Ihre Lider hatten eine bläuliche Tönung, und die Augenbrauen schienen Schatten zu werfen, in denen ihre Augen noch tiefer wirkten als bei Tage.“"
                                            },
                                            {
                                                "example_id": "e8510bf3-96fc-4119-b2ba-d05db93712cb",
                                                "sense_id": "2a1d22b6-70d1-3bc4-9628-d3ddffcbc945",
                                                "text": "„Ihre Lider senken sich wie ein Vorhang vor ihre Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8bbc5ce-40e1-418c-be05-318c2bf95c14",
                        "source_entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                        "source_sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                        "source_sense_description": "anatomy: a thin skin membrane that covers and moves over an eye",
                        "target_lang_word": "palpebra",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palpebra",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "d28f2ea5-47b3-343d-abfa-4dbbefbc43a8",
                                        "entry_id": "cb5ca89b-8b50-3653-b156-5d0fe0ad701e",
                                        "glosses": [
                                            "ognuna delle due formazioni cutanee mobili che coprono gli occhi proteggendoli dalla luce e da corpi estranei. L'apertura e chiusura ritmica delle palpebre permette la diffusione del prodotto delle ghiandole lacrimali, mantenendo il globo oculare sempre umido"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f9a2b3f-33b2-4f0c-8d0f-ef1361e574cf",
                        "source_entry_id": "a0f9c76a-dcfe-3100-9093-99f1efab7f63",
                        "source_sense_id": "bacab974-cd08-3925-8e31-1c3d5a3d8ba0",
                        "source_sense_description": "anatomy: a thin skin membrane that covers and moves over an eye",
                        "target_lang_word": "powieka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "powieka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "c075515a-9678-328e-89bb-d34b17ac5925",
                                        "entry_id": "11febc45-8c8b-3a22-8ace-5159cc7cf69f",
                                        "glosses": [
                                            "kawałek skóry zakrywający oko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ffaf10-7448-4133-8ee2-512702878d2f",
                                                "sense_id": "c075515a-9678-328e-89bb-d34b17ac5925",
                                                "text": "Odwlekał ten moment jak najdłużej, ale wreszcie z powrotem wysunął głowę ponad krawędź koca i podniósł powieki."
                                            },
                                            {
                                                "example_id": "84b76a1e-05dc-4456-a39f-17b930b88ad7",
                                                "sense_id": "c075515a-9678-328e-89bb-d34b17ac5925",
                                                "text": "Kobieta w płaszczu zapiętym pod szyję poinformowała później krewnych matematyka, iż już w pozycji leżącej, z powiekami zamkniętymi, wciąż ściskając parasol w kurczowo zaciśniętej dłoni, profesor wyszeptał sinymi wargami słowa, które mogły znaczyć \"O, Polsko!\" lub \"Oj, Polacy!\", ale sprawa pozostała nie wyjaśniona."
                                            },
                                            {
                                                "example_id": "f5b8f420-7c6e-4e64-bf99-b69e0fc962b4",
                                                "sense_id": "c075515a-9678-328e-89bb-d34b17ac5925",
                                                "text": "Na koniec, po godzinie pisania podniósł twarz znad bibuły, spojrzał na szyby zalane deszczem i końcem długiego, kościstego palca powiódł po brzegu zaczerwienionej powieki."
                                            }
                                        ],
