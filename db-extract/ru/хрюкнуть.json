                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86cdb00c-76a1-426b-8a9f-5d2e029c2f1f",
                                "sense_id": "1dd368c3-4d1d-3ff0-a117-0a6fb3a3ccf0",
                                "text": "В сосе́дней ко́мнате гро́мко вздохну́л хозя́ин, пото́м, немно́го погодя́, в своём сара́йчике хрю́кнула свинья́, и опя́ть всё смо́лкло.",
                                "translation": "In the next room, her master sighed loudly, then, a little later, the pig grunted in her shed, and then everything was silent again.",
                                "english": "In the next room, her master sighed loudly, then, a little later, the pig grunted in her shed, and then everything was silent again."
                            }
                        ]
