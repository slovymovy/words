                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428f313b-48f2-4e75-b3ad-c6aaa2e89930",
                                                "sense_id": "8fc03901-befc-385a-8282-df84b1c0ee64",
                                                "text": "Concerns have been raised about available luggage space, with Cash remarking: \"With the upcoming Christmas period there will likely be a large increase in health and safety issues and stress for frontline staff.\""
                                            }
                                        ]
                                    }
                                ]
