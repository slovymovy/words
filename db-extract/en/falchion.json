                    {
                        "translation_id": "a969d836-0909-47e0-ac3f-04d5a62839da",
                        "source_entry_id": "40bc0816-c3c7-3d34-93da-856eb8619fa4",
                        "source_sense_description": "sword",
                        "target_lang_word": "fauchon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fauchon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2deb04f-d209-3efb-8a8f-dc6fed8175de",
                                        "entry_id": "34c3dfc5-27db-376f-a354-4b2deb183f8f",
                                        "glosses": [
                                            "Sabre de taille moyenne, dont la poignée est protégée par une garde."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49872b5c-e4ac-4b88-a4fb-7b08a16705e6",
                                                "sense_id": "c2deb04f-d209-3efb-8a8f-dc6fed8175de",
                                                "text": "Les fauchons étaient en usage au Moyen Âge."
                                            },
                                            {
                                                "example_id": "adff858e-3e9c-469b-a4ff-921c57fbe5c1",
                                                "sense_id": "c2deb04f-d209-3efb-8a8f-dc6fed8175de",
                                                "text": "Aucun n'avait un arc. Des passots et des fauchons composaient leur armement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e4036a-d94d-3756-9983-289c1d8f3da2",
                                        "entry_id": "34c3dfc5-27db-376f-a354-4b2deb183f8f",
                                        "glosses": [
                                            "Petite faux pour couper les céréales, ou faux armée d’un râteau destiné à rabattre les tiges coupées vers la gauche du faucheur ou du moissonneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca284b8-7409-44c9-8b6f-20477284fa5f",
                                                "sense_id": "e8e4036a-d94d-3756-9983-289c1d8f3da2",
                                                "text": "Comme ils se rapprochaient en abaissant leurs fauchons, ils virent les paysans s’écarter, découvrant un brassier et quatre gros tas de feuilles mortes auxquels ils boutèrent le feu en toute hâte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
