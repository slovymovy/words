                "senses": [
                    {
                        "sense_id": "f9c015ef-f005-3967-9052-23bc09011818",
                        "entry_id": "c3bf7cd7-c31f-30ed-8411-62dbc3e797a5",
                        "glosses": [
                            "abgrenzbarer Zeitraum beim Erleiden einer Krankheit; derjenige Zeitraum, in dem ein Erkranken erstmals deutlich zu Tage tritt oder nachzuweisen ist"
                        ],
                        "tags": [
                            "manchmal genauer"
                        ],
                        "examples": [
                            {
                                "example_id": "f5635fe0-7275-493b-b371-34713ef04d5a",
                                "sense_id": "f9c015ef-f005-3967-9052-23bc09011818",
                                "text": "„Bei Kleinkindern stehen häufig körperliche Symptome wie Appetitlosigkeit, Schlafstörungen oder Bauchschmerzen im Vordergrund. Sie werden nach anfänglichem Schreien und Weinen zu Beginn der Erkrankungsphase, meist zunehmend passiv und desinteressiert.“"
                            },
                            {
                                "example_id": "566b1128-792d-425d-9a96-a12b012ba897",
                                "sense_id": "f9c015ef-f005-3967-9052-23bc09011818",
                                "text": "„In der späten, hyperinflammatorischen Erkrankungsphase (Phase III) stehen immunologische Prozesse im Vordergrund, die Virusreplikation ist meist nicht mehr nachweisbar.“"
                            },
                            {
                                "example_id": "81652c8b-7f57-44e0-8ca4-21102c9d63cd",
                                "sense_id": "f9c015ef-f005-3967-9052-23bc09011818",
                                "text": "„Missempfindungen durch Nervenschäden treten in früher Erkrankungsphase oft nachts auf.“"
                            },
                            {
                                "example_id": "b3b2d686-7937-4d3e-88a4-2ca7b78cc923",
                                "sense_id": "f9c015ef-f005-3967-9052-23bc09011818",
                                "text": "„Die zweite Erkrankungsphase, die sich als Meningitis, Meningoenzephalitis oder Meningoenzephalomyelitis manifestiert, bleibt zum Teil aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
