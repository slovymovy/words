                "senses": [
                    {
                        "sense_id": "8aa57805-1308-3f7f-bf65-726347dea2d6",
                        "entry_id": "f6b66d61-4d2a-3052-b05f-3fadcf8039fe",
                        "glosses": [
                            "die geschlossene Zweieinigkeit von etwas; 2 Falten (Fakten) oder auch zwei gleichberechtigte Dinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c095b8-3f0d-4ee1-b720-1861475e7e71",
                                "sense_id": "8aa57805-1308-3f7f-bf65-726347dea2d6",
                                "text": "„Die thematisierte Zweifaltigkeit lässt sich sprachlich-diskursiv nicht darstellen, nicht in üblicher wissenschaftlicher Weise. Der, der darüber schreibt, muss sich selbst einschreiben in den Text.“"
                            },
                            {
                                "example_id": "2351c388-812a-4b07-bc42-7b742ee2036e",
                                "sense_id": "8aa57805-1308-3f7f-bf65-726347dea2d6",
                                "text": "„Die Zweifaltigkeit des Landrates ist also einheitlich nicht zu vertreten.“"
                            },
                            {
                                "example_id": "8dccc461-151a-4bf8-93ea-b83a179e9895",
                                "sense_id": "8aa57805-1308-3f7f-bf65-726347dea2d6",
                                "text": "„Zweifaltigkeit ist zwei Dinge. Zum einen ist es die Einheit, und doch die Trennung, von Ihm und Ihr, von Vater und Tochter, die doch eins sind in Gott.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
