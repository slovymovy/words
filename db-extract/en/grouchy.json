                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478a44dd-0a38-42f3-8a4d-6c9dba1012c7",
                                                "sense_id": "e5b63395-780a-321a-8e54-f6a90f88bbbf",
                                                "text": "Ik wil geen kwaad woord over hem horen."
                                            },
                                            {
                                                "example_id": "33a8ba0f-2deb-44bb-a29f-7684adb3517f",
                                                "sense_id": "e5b63395-780a-321a-8e54-f6a90f88bbbf",
                                                "text": "Alles ging goed, totdat het op een kwade dag fout ging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bde348-41af-3ccf-a4b9-e9c03b9ad3c6",
                                        "entry_id": "87b9855e-c325-3e55-ab32-321088883bc2",
                                        "glosses": [
                                            "tegen de moraal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdcc0c5f-d9b8-41fe-81e0-ea4c6859a0ba",
                                                "sense_id": "51bde348-41af-3ccf-a4b9-e9c03b9ad3c6",
                                                "text": "Hij had kwade bedoelingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5400b081-ce78-33f0-a60e-459a7ea9a4d4",
                                        "entry_id": "87b9855e-c325-3e55-ab32-321088883bc2",
                                        "glosses": [
                                            "woedend, boos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fedb048-b466-4a53-b260-7fd15626f686",
                                                "sense_id": "5400b081-ce78-33f0-a60e-459a7ea9a4d4",
                                                "text": "Hij werd kwader en kwader totdat hij ten slotte ontplofte."
                                            },
                                            {
                                                "example_id": "142f7c75-4adf-4d7f-944b-5d29b50e8805",
                                                "sense_id": "5400b081-ce78-33f0-a60e-459a7ea9a4d4",
                                                "text": "Hij is kwaad op hem."
                                            },
                                            {
                                                "example_id": "464e0b62-b56d-46e4-955d-f3f0fa7b49fa",
                                                "sense_id": "5400b081-ce78-33f0-a60e-459a7ea9a4d4",
                                                "text": "Wanneer iemand kwaad is wordt dat gezien als een graadje erger na boos zijn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kwaad",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e11238a5-8eeb-3adb-b57b-42efaab953b4",
                                        "entry_id": "bd1ee082-4aca-3149-be65-169b95febb70",
                                        "glosses": [
                                            "kwade, boze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761de152-0804-421d-94fe-e13e142a4196",
                                                "sense_id": "e11238a5-8eeb-3adb-b57b-42efaab953b4",
                                                "text": "Denkend aan het totale kwaad denken we allereerst aan Adolf Hitler en Josef Stalin"
                                            },
                                            {
                                                "example_id": "443b41b2-cb72-43c0-bb9e-ac0682ff9b87",
                                                "sense_id": "e11238a5-8eeb-3adb-b57b-42efaab953b4",
                                                "text": "Toch was ik ook opgelucht dat het voorbij was en trok een mini-whiskeyflesje open. Voordat ik dit in één teug naar binnen goot, sloeg ik een kruis en wees in de lucht naar een denkbeeldige maan. Het was mijn persoonlijke dankbetuiging aan de maan, die naar mijn gevoel over me had gewaakt en me had beschermd tegen het kwaad gedurende de tocht."
                                            },
                                            {
                                                "example_id": "694616ad-04c4-49e0-83c2-93fd2687f2bd",
                                                "sense_id": "e11238a5-8eeb-3adb-b57b-42efaab953b4",
                                                "text": "Laat het kwaad niet over de drempel komen, want als de woekering eenmaal binnen is, gaat ze moeilijk weer weg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9adc2c55-4ab8-3d77-9d92-60561101bafe",
                                        "entry_id": "bd1ee082-4aca-3149-be65-169b95febb70",
                                        "glosses": [
                                            "iets dat tegen de moraal is"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ceaff863-0ddd-3888-a751-3aa46f911c6b",
                                        "entry_id": "bd1ee082-4aca-3149-be65-169b95febb70",
                                        "glosses": [
                                            "nadeel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1dc928-e30c-43c7-b3fc-e8991b2b2295",
                                                "sense_id": "ceaff863-0ddd-3888-a751-3aa46f911c6b",
                                                "text": "Even nadenken over de mogelijke effecten had wellicht ook geen kwaad gekund."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64a7858a-c37f-3c73-bf1e-b452b332219c",
                                        "entry_id": "bd1ee082-4aca-3149-be65-169b95febb70",
                                        "glosses": [
                                            "ongeluk, pech"
                                        ],
                                        "tags": [],
                                        "examples": [
