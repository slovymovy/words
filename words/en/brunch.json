    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb42df4c-4afa-3306-b07b-70d8b75484df",
                    "sense_definition": "A meal eaten in the late morning or early afternoon, combining elements of breakfast and lunch.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "brunch_meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We usually meet our friends for Sunday <w>brunch</w> at a nearby café.",
                            "target_lang_translations": {
                                "zh": "我们周日通常会在附近的一家咖啡馆和朋友碰面吃<w>早午餐</w>。"
                            }
                        },
                        {
                            "text": "The hotel restaurant serves a delicious <w>brunch</w> with pancakes and fresh fruit.",
                            "target_lang_translations": {
                                "zh": "这家酒店的餐厅供应美味的<w>早午餐</w>，配有煎饼和新鲜水果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Sunday brunch",
                        "have brunch",
                        "go for brunch"
                    ],
                    "target_lang_definitions": {
                        "zh": "在上午晚些时候或下午早些时候享用的餐食，兼具早餐和午餐的特点。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "早午餐",
                                "target_lang_sense_clarification": "早餐与午餐合二为一的餐食"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e40de2fc-27f9-3eb0-bb39-9eb2f7110ea6",
                    "sense_definition": "To eat a meal that combines breakfast and lunch.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "brunch_meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the morning relaxing on the patio while <w>brunching</w> on pastries.",
                            "target_lang_translations": {
                                "zh": "他们整个上午都在露台上放松，一边<w>吃着早午餐</w>的糕点。"
                            }
                        },
                        {
                            "text": "We decided to <w>brunch</w> together after finishing our morning run.",
                            "target_lang_translations": {
                                "zh": "我们决定在晨跑结束后一起<w>吃早午餐</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brunch together"
                    ],
                    "target_lang_definitions": {
