                "senses": [
                    {
                        "sense_id": "6afef981-eeae-34a4-8bc3-08417beb606b",
                        "entry_id": "3bd10a50-135e-32be-aa3a-50ed3cdf23b0",
                        "glosses": [
                            "Qui provoque ou est de nature à provoquer un traumatisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d43854-c603-4400-a856-fee5ce5427bd",
                                "sense_id": "6afef981-eeae-34a4-8bc3-08417beb606b",
                                "text": "À distance des événements traumatisants, les symptômes dissociatifs feront que les violences, si elles sont mesurées à l’aune d’une échelle émotionnelle, ne paraîtront pas si graves à certaines victimes."
                            },
                            {
                                "example_id": "5fba4164-a04c-432d-94f2-ba74a89b1600",
                                "sense_id": "6afef981-eeae-34a4-8bc3-08417beb606b",
                                "text": "Lorsqu’un événement est traumatisant pour un individu, ce dernier traverse une expérience singulière de rupture dans la continuité de son existence. Il se retrouve figé au temps du trauma. Ce « corps étranger interne » prend beaucoup de place dans son espace psychique et son appartenance à la communauté des êtres vivants est menacée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32e383ee-57ed-416e-87d1-513223265b3c",
                        "source_entry_id": "3bd10a50-135e-32be-aa3a-50ed3cdf23b0",
                        "source_sense_id": "6afef981-eeae-34a4-8bc3-08417beb606b",
