                        "glosses": [
                            "A Scottish surname transferred from the nickname. A variant of Roe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c336bbf6-ab21-3488-9923-8ae02c752035",
                        "entry_id": "86cea3bb-4cd5-3b05-bb55-c7842bceba78",
                        "glosses": [
                            "A diminutive of the female given name Rachel, also used as a formal given name, mostly as a middle name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ea1a7c-be74-4ade-baf8-b206286f25ad",
                                "sense_id": "c336bbf6-ab21-3488-9923-8ae02c752035",
                                "text": "CHUCK. Joyce Mathews! I see and this girl's name is Rae Edwards. What does Rae stand for?\nCHRIS. Rae, Rae!\nCHUCK. Rachel? That's what I'm trying to find out; Sugar Ray? Rae doesn't mean too much to me. Hooray, Sugar Ray, etc. So her name is Rachael H? I see."
                            },
                            {
                                "example_id": "9a95fcd1-5aab-4c9e-b482-e9bc84353480",
                                "sense_id": "c336bbf6-ab21-3488-9923-8ae02c752035",
                                "text": "Jo Rae Perkins was carrying about 50 percent of the vote in Oregon’s primary as of Wednesday afternoon, vanquishing three other Republican candidates to become the party’s nominee for the seat currently held by Senator Jeff Merkley, a Democrat."
                            }
                        ]
                    },
                    {
                        "sense_id": "366f6117-5d35-3748-b470-cf00106b3f7d",
                        "entry_id": "86cea3bb-4cd5-3b05-bb55-c7842bceba78",
                        "glosses": [
                            "Feminine form of Ray."
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "82fa7136-3c00-48c9-bcbe-ad8a732a4a04",
                                "sense_id": "366f6117-5d35-3748-b470-cf00106b3f7d",
                                "text": "My first name is Ray because of a distant relative, a woman, whose name was Rae. I was named for her and spelled my name Rae until I was old enough to realize I was being mocked, when I changed it to the masculine form Ray."
                            }
                        ]
                    }
