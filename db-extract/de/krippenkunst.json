                "senses": [
                    {
                        "sense_id": "191fc530-ea58-3cf9-aedf-a7b35e061e9b",
                        "entry_id": "ef57766d-7526-3fe3-ba57-5ac50b412eec",
                        "glosses": [
                            "religiöse Volkskunst, die das Geheimnis der Geburt Christi sinnfällig und fromm darstellt"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "80dda45c-f42b-4230-9264-32a56e286583",
                                "sense_id": "191fc530-ea58-3cf9-aedf-a7b35e061e9b",
                                "text": "„Fernab von industriell gefertigten Serienproduktionen wird dort die überlieferte Krippenkunst lebendig gehalten.“"
                            },
                            {
                                "example_id": "db3515dc-ed14-48c8-acab-6977dca6ff84",
                                "sense_id": "191fc530-ea58-3cf9-aedf-a7b35e061e9b",
                                "text": "„Und wie in jedem Jahr so kurz vor Weihnachten gibt es auch noch Holz- und Krippenkunst aus dem Erzgebirge und aus Oberammergau.“"
                            },
                            {
                                "example_id": "3f0b322c-30a5-4f77-890f-6e39bb368a36",
                                "sense_id": "191fc530-ea58-3cf9-aedf-a7b35e061e9b",
                                "text": "„Die barocke Weihnachtskrippe erreicht den Höhepunkt ihrer künstlerischen Ausdrucksform in den neapolitanischen Krippenkunst, die wenn auch mit den jeweiligen regionalen Unterschieden, die sizilianische, genuesische und römische Krippe beeinflusst.“"
                            },
                            {
                                "example_id": "4b9318a5-3a45-40de-8f03-a25d42d1240f",
                                "sense_id": "191fc530-ea58-3cf9-aedf-a7b35e061e9b",
                                "text": "„Der Bildhauer hatte sich nach einer Rom-Reise der Krippenkunst verschrieben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
