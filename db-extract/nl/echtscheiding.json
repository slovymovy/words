                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c0b0dba-f307-449a-92e2-1f78cc8237c3",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "Seit ihrer Scheidung redeten Olaf und Martha nicht mehr viel miteinander."
                                            },
                                            {
                                                "example_id": "341fc9a2-39f5-485d-91cb-3c079e9d0efa",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Die Scheidung ist eingereicht; sie wird alsbald ausgesprochen werden.“"
                                            },
                                            {
                                                "example_id": "dfaef78f-ce13-4f1f-8e6b-f0c5388d8c1d",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Ich hatte wirklich schon viel zu lange mit der Scheidung gewartet.“"
                                            },
                                            {
                                                "example_id": "d4a0588f-98bf-4910-b52e-e5513f9b9fe3",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Eine Frau, die in Scheidung lebt, findet allgemeine Beachtung.“"
                                            },
                                            {
                                                "example_id": "ac01c211-0c28-4374-9be3-415aa5729b85",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Die Scheidung war sehr teuer, hat sie mir erzählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b883430e-436d-3760-90c9-ce8f23962eca",
