                    ]
                },
                {
                    "sense_id": "d29030ae-1214-3d96-a777-cad2c6f30f65",
                    "sense_definition": "Rechtsbeistand oder Rechtsanwalt, der für die klagende Partei tätig wird",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Geschädigte erschien nicht persönlich zur Verhandlung, doch sein <w>Kläger</w> vertrat ihn kompetent."
                        },
                        {
                            "text": "Der Richter richtete eine Frage direkt an den anwesenden <w>Kläger</w> des Mandanten."
                        }
                    ],
                    "synonyms": [
                        "Klägervertreter"
                    ],
                    "traits": [
