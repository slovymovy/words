                    {
                        "translation_id": "958ef736-1f2a-46f4-abf0-9c46565e1a14",
                        "source_entry_id": "b7debd74-a98f-3496-81d3-1bd3dac7a4a7",
                        "source_sense_id": "3ef1c66d-fd7a-3cff-b65f-5397da503a88",
                        "source_sense_description": "Medizin: Austritt von Eingeweiden aus der Bauchhöhle durch eine angeborene oder erworbene Öffnung",
                        "target_lang_word": "hernia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hernia",
