                                        "sense_id": "a72382dc-0796-3bbb-8c5b-d3b5bc1730a0",
                                        "entry_id": "0ee60078-ac7d-3f98-8ebd-959becf3b635",
                                        "glosses": [
                                            "Fondre, rendre liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35537685-5619-4a15-82ed-730beeb07005",
                                                "sense_id": "a72382dc-0796-3bbb-8c5b-d3b5bc1730a0",
                                                "text": "Le feu liquéfie le plomb, l’argent, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01d8be4-f1f9-38bd-9f76-6be42593412c",
                                        "entry_id": "0ee60078-ac7d-3f98-8ebd-959becf3b635",
                                        "glosses": [
                                            "Faire perdre toute consistance, toute énergie, toute lucidité ou tout sens moral."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b394ec-13b3-41e7-b0fa-909b08d4cfe7",
                                                "sense_id": "e01d8be4-f1f9-38bd-9f76-6be42593412c",
                                                "text": "La canicule m’a littéralement liquéfié."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf1f2b29-34c3-37b2-a01e-b35582f02342",
                                        "entry_id": "0ee60078-ac7d-3f98-8ebd-959becf3b635",
                                        "glosses": [
                                            "Fondre, devenir liquide."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8609aa29-b093-454b-9c17-743641363820",
                                                "sense_id": "cf1f2b29-34c3-37b2-a01e-b35582f02342",
                                                "text": "Saint Janvier dont le sang se liquéfie si solennellement à Naples."
                                            },
                                            {
                                                "example_id": "f1a1b6a2-5c32-403e-89dc-4ce35e0cd483",
                                                "sense_id": "cf1f2b29-34c3-37b2-a01e-b35582f02342",
                                                "text": "Les vapeurs contenant l'essence se liquéfient dans le serpentin; à l'extrémité de ce dernier, on recueille un liquide d'une apparence blanchâtre due à la présence de l'essence dans ce liquide."
                                            },
                                            {
                                                "example_id": "7d3be70a-75fb-44a6-90ae-762a9c77dca6",
                                                "sense_id": "cf1f2b29-34c3-37b2-a01e-b35582f02342",
                                                "text": "La cire se liquéfie' à la chaleur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3aa3da9-5dd6-4957-b0a4-d099ad876852",
                        "source_entry_id": "dae13eda-2feb-34a6-bd54-542c59317f90",
                        "source_sense_id": "6400d2eb-7931-3042-b66a-d2e89bee6baa",
