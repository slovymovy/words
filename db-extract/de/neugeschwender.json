                ],
                "senses": [
                    {
                        "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                        "entry_id": "2a9ce1d0-b45b-30fc-92f0-843250a42ba8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99f66e0-dd75-4012-91de-175dd7636ea4",
                                "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                                "text": "Frau Neugeschwender ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "22bd6b87-81a5-4ea0-af92-aafb2241befc",
                                "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                                "text": "Herr Neugeschwender wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0d05010f-c08c-43ed-84f9-8542ba95fb4b",
                                "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                                "text": "Die Neugeschwenders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "da41a4e5-8597-4ec9-b291-e82c521cf550",
                                "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                                "text": "Der Neugeschwender trägt nie die Schals, die die Neugeschwender ihm strickt."
                            },
                            {
                                "example_id": "db8dc5c2-33ca-4da9-85b7-a31056f9f777",
                                "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neugeschwender kommt, geht der Herr Neugeschwender.“"
                            },
                            {
                                "example_id": "5861c503-bea6-4de5-b190-bb1da9eed352",
                                "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                                "text": "Neugeschwender kommt und geht."
                            },
                            {
                                "example_id": "db41c490-3c90-42ba-9eee-fb1248f49115",
                                "sense_id": "5846da62-c81a-35b6-9b35-b85007a6913c",
                                "text": "Neugeschwenders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
