                ],
                "senses": [
                    {
                        "sense_id": "9d2989a9-ec4c-3921-8fe7-44149db82fb4",
                        "entry_id": "5bc58ce2-f842-38e2-b422-79a996b3d96b",
                        "glosses": [
                            "to pall on, to become boring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2ce159-89e7-4b0d-ab68-46994c443f35",
                                "sense_id": "9d2989a9-ec4c-3921-8fe7-44149db82fb4",
                                "text": "Э́то ну́жно бы́ло совсе́м не для Вождя́ — его́ э́то уже́ не ра́довало, ему́ уже́ давно́ прие́лось, — э́то ну́жно бы́ло для по́дданных, для просты́х сове́тских люде́й.",
                                "translation": "The Leader himself had absolutely no need of all this; it no longer gave him any pleasure; he had grown sick of it long ago; it was his subjects who needed it, the simple Soviet people.",
                                "english": "The Leader himself had absolutely no need of all this; it no longer gave him any pleasure; he had grown sick of it long ago; it was his subjects who needed it, the simple Soviet people."
                            },
                            {
                                "example_id": "095d5158-0776-4e35-92ac-9d61ac4a7d7a",
                                "sense_id": "9d2989a9-ec4c-3921-8fe7-44149db82fb4",
                                "text": "Ви́ктор посмотре́л на ба́шенку До́ма Профсою́зов, но вме́сто то́чного вре́мени уви́дел прие́вшуюся уже́ рекла́му «Адида́с».",
                                "translation": "Viktor looked at the tower of the Trade Unions Building, but instead of the exact time he saw the by now overfamiliar Adidas advertisement.",
                                "english": "Viktor looked at the tower of the Trade Unions Building, but instead of the exact time he saw the by now overfamiliar Adidas advertisement."
                            }
                        ]
                    }
                ],
