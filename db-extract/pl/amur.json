                                    },
                                    {
                                        "sense_id": "24743672-5532-3a1c-a215-95b451fad692",
                                        "entry_id": "d5d998cd-db35-3f61-b6dc-1217072216cb",
                                        "glosses": [
                                            "Oblast de Russie, situé au nord de la Chine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563c30f2-1dfa-42f6-81a8-6e2682458902",
                                                "sense_id": "24743672-5532-3a1c-a215-95b451fad692",
                                                "text": "Le « fuselage en flammes » de l’appareil avait auparavant été repéré à 16 kilomètres de Tynda, dans l’oblast de l’Amour, par l’équipage d’un hélicoptère des services de secours, selon le ministère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Amour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58d181d9-f02a-3d79-9115-523d80d917b1",
                                        "entry_id": "91575feb-2064-307d-beed-a6ccd0364a46",
                                        "glosses": [
                                            "Personnification de l’amour."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
