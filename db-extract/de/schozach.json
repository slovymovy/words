                "senses": [
                    {
                        "sense_id": "87a82778-5d57-3c50-a7e2-bb8dad5f0847",
                        "entry_id": "59d3374c-b058-3755-9c80-0c2319542cb7",
                        "glosses": [
                            "rechter Nebenfluss des Neckars, der nordwestlich von Vorhof bei Untergruppenbach entspringt und nach 26 km Flusslauf in Sontheim bei Heilbronn in den Neckar mündet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724058d4-f0d7-478c-8cf6-5441627d4d77",
                                "sense_id": "87a82778-5d57-3c50-a7e2-bb8dad5f0847",
                                "text": "„Nach fast 2 Tagen erreicht die ausgelaufene Giftbrühe durch das ungesicherte Kanalsystem den Fluss Schozach.“"
                            },
                            {
                                "example_id": "49562e3c-6e1f-4580-b48b-38d117e696eb",
                                "sense_id": "87a82778-5d57-3c50-a7e2-bb8dad5f0847",
                                "text": "„Drei Jahre nach dem Chemieunfall, der Tausende Fische das Leben kostete, liefert eine gewässerökologische Untersuchung Erkenntnisse zum aktuellen Zustand der Schozach.“"
                            },
                            {
                                "example_id": "038ce054-ed5f-4192-a03f-4741931aec91",
                                "sense_id": "87a82778-5d57-3c50-a7e2-bb8dad5f0847",
                                "text": "„Eine Untersuchung der Kleinstlebewesen in der Schozach ergab nun aber keine Auffälligkeiten gegenüber Messungen vor dem Unglück, wie das Landratsamt mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
