                        "source_entry_id": "0d62e0d9-715f-3689-8552-70e88255ca77",
                        "source_sense_id": "476679a2-187e-399a-8d30-54719f09c720",
                        "source_sense_description": "anhaltend lautes, gellendes oder jammerndes Schreien",
                        "target_lang_word": "outcry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outcry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e62683-a624-3053-b31e-f02943b51d21",
                                        "entry_id": "fdfddfec-0d1d-3f34-a2c1-afd968bb98e2",
                                        "glosses": [
                                            "A loud cry or uproar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7041eb24-1960-469e-8515-7c8bc5a98c6b",
                                                "sense_id": "e1e62683-a624-3053-b31e-f02943b51d21",
                                                "text": "His appearance was greeted with an outcry of jeering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e7516a-947f-3c7d-be39-5e0edf5f9b90",
                                        "entry_id": "fdfddfec-0d1d-3f34-a2c1-afd968bb98e2",
                                        "glosses": [
                                            "A strong protest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4da09626-f232-434a-b023-60dfefc55558",
                                                "sense_id": "06e7516a-947f-3c7d-be39-5e0edf5f9b90",
                                                "text": "The proposal was met with a public outcry."
                                            },
                                            {
                                                "example_id": "32e107aa-3628-4ce0-8fa8-16d010420f04",
                                                "sense_id": "06e7516a-947f-3c7d-be39-5e0edf5f9b90",
                                                "text": "The Western Region has sought approval for the withdrawal of passenger services between Ashchurch Junction and Upton-on-Severn. There was a proposal to withdraw the trains as long ago as 1951, but an outcry from Tewkesbury that it would suffer as a tourist centre secured a reprieve."
                                            },
                                            {
                                                "example_id": "26d7a4f2-4e53-48c6-9550-435563cd01bc",
                                                "sense_id": "06e7516a-947f-3c7d-be39-5e0edf5f9b90",
                                                "text": "This is a scorched earth policy, leaving Labour - which has made the right noises, but not loudly enough - with the job of picking up the pieces. Given the incoherence of the plans, the best hope is that the public outcry - even the Daily Telegraph is against them - delays them enough for a new government to rescue most of the ticket offices from closure, but this is no way to run a railway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0314ce50-6805-389c-b1e0-1675375fe09f",
                                        "entry_id": "fdfddfec-0d1d-3f34-a2c1-afd968bb98e2",
                                        "glosses": [
                                            "An auction."
                                        ],
                                        "tags": [
                                            "India",
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdac5a59-3220-4a3a-a26b-b4e3969403d2",
                                                "sense_id": "0314ce50-6805-389c-b1e0-1675375fe09f",
                                                "text": "to send goods to an outcry"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70c09715-4066-3e79-896e-9bc3b9f1edaa",
                                        "entry_id": "9477a3c4-a162-3abd-bd1e-05410717d809",
                                        "glosses": [
                                            "To cry out."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ad6a0e6-a04c-4247-8e35-ede195a9c96c",
                                                "sense_id": "70c09715-4066-3e79-896e-9bc3b9f1edaa",
                                                "text": "I think any man who outcries against the power of the government in Germany soon ceases to cry at all, because he is crushed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7470c5ba-5895-330b-af22-f90cf6f3a050",
                                        "entry_id": "9477a3c4-a162-3abd-bd1e-05410717d809",
                                        "glosses": [
                                            "To cry louder than."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebd953b-ddd8-4458-970c-2201991729a3",
                                                "sense_id": "7470c5ba-5895-330b-af22-f90cf6f3a050",
                                                "text": "[…] outcrying the clacking of train wheels, the shrill of the whistle […]"
                                            },
                                            {
                                                "example_id": "589833e3-7101-44c3-9429-504a9a9e12d6",
                                                "sense_id": "7470c5ba-5895-330b-af22-f90cf6f3a050",
                                                "text": "The dogs added their voices to the din, howling for hours, each trying to outcry the others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
