                ],
                "senses": [
                    {
                        "sense_id": "4b39912c-faf6-38dc-8f66-5f7942fb3b2b",
                        "entry_id": "a5bb2685-7d78-3fdf-b0e8-e325cc0b1450",
                        "glosses": [
                            "gleichbedeutend mit Nomen appellativum; lateinische Bezeichnung für Gattungsname. Im Gegensatz von Eigennamen bezeichnen Appellativa Mengen gleichartiger Gegenstände."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b539d5c9-6c23-4b69-836f-67a6bea78566",
                                "sense_id": "4b39912c-faf6-38dc-8f66-5f7942fb3b2b",
                                "text": "\"Arbeit\", \"Auto\", \"Kind\", \"Lastwagen\", \"Möbel\" sind einige Beispiele für Appellativa."
                            },
                            {
                                "example_id": "0db301d9-e729-4aa3-86da-d379fcb910bc",
                                "sense_id": "4b39912c-faf6-38dc-8f66-5f7942fb3b2b",
                                "text": "„Dadurch, daß ein Eigenname als Appellativum verwendet werden kann, wird die ursprüngliche Relevanz zugunsten seiner überzeitlichen Bedeutung verändert.“"
                            },
                            {
                                "example_id": "416bdfe5-fbf0-4ed8-a7f4-5a3219629e83",
                                "sense_id": "4b39912c-faf6-38dc-8f66-5f7942fb3b2b",
                                "text": "„Daneben existieren Unterschiede zwischen Eigennamen und Appellativa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7098417b-7705-43f6-bdb7-b9b106f0eb6f",
