                                    {
                                        "sense_id": "c399ac98-7d8f-37d3-bb44-2aa3b51e2647",
                                        "entry_id": "88115318-7795-3f69-ab01-d0ca86ed390c",
                                        "glosses": [
                                            "The act or process of selecting actors, singers, dancers, models, etc."
