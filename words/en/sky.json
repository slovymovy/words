    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b1228ae-c5db-3145-890e-3585dfc19867",
                    "sense_definition": "The atmosphere above a given point, especially as visible from the surface of the Earth as the place where the sun, moon, stars, and clouds are seen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun was shining brightly in the clear blue <w>sky</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Этим утром солнце ярко сияло в чистом голубом <w>небе</w>."
                            }
                        },
                        {
                            "text": "That year, a meteor fell from the <w>sky</w> and landed in the desert.",
                            "target_lang_translations": {
                                "ru": "В тот год метеор упал с <w>неба</w> и приземлился в пустыне."
                            }
                        }
                    ],
                    "synonyms": [
                        "blue",
                        "firmament",
                        "heaven"
                    ],
                    "antonyms": [
                        "floor"
                    ],
                    "common_phrases": [
                        "blue sky",
                        "clear sky",
                        "night sky",
                        "cloudy sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Атмосфера над определенной точкой, особенно видимая с поверхности Земли как место, где находятся солнце, луна, звезды и облака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небо",
                                "target_lang_sense_clarification": "пространство над землей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c64ba4e-a068-32f8-be85-c0a5392abe0f",
                    "sense_definition": "The part of the sky which can be seen from a specific place or at a specific time, often referring to its climate or condition.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I lay back under a warm Texas <w>sky</w> and watched the birds fly by.",
                            "target_lang_translations": {
                                "ru": "Я лежал под теплым техасским <w>небом</w> и наблюдал за пролетающими птицами."
                            }
                        },
                        {
                            "text": "We are not sure how long the <w>cloudy</w> <w>skies</w> will last this week.",
                            "target_lang_translations": {
                                "ru": "Мы не уверены, как долго продержится пасмурное <w>небо</w> на этой неделе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cloudy skies",
                        "stormy skies",
                        "evening sky",
                        "winter skies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть неба, которую можно увидеть из определенного места или в определенное время, часто в контексте климата или погодных условий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небо",
                                "target_lang_sense_clarification": "в контексте погоды или местности"
                            },
                            {
                                "target_lang_word": "небеса",
                                "target_lang_sense_clarification": "часто во множественном числе в поэтическом или погодном контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81f16191-0fd7-3fe9-b0c1-c9bf67dba8b9",
                    "sense_definition": "The abode of God, gods, or celestial beings; heaven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient Greeks believed their gods lived high above in the <w>skies</w>.",
                            "target_lang_translations": {
                                "ru": "Древние греки верили, что их боги живут высоко на <w>небесах</w>."
                            }
                        },
                        {
                            "text": "This mortal has incurred the wrath of the <w>skies</w> through his actions.",
                            "target_lang_translations": {
                                "ru": "Этот смертный навлек на себя гнев <w>небес</w> своими поступками."
                            }
                        }
                    ],
                    "synonyms": [
                        "heaven"
                    ],
                    "common_phrases": [
                        "wrath of the skies",
                        "ruler of the sky"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in plural or with 'the'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обитель Бога, богов или небесных существ; небеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небеса",
                                "target_lang_sense_clarification": "обитель богов"
                            },
                            {
                                "target_lang_word": "небо",
                                "target_lang_sense_clarification": "религиозный контекст"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fc18ca5-558c-39aa-b342-aaa96bda2dfd",
                    "sense_definition": "A light blue color, similar to the color of a clear sky.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a beautiful dress in <w>sky</w> and pink for the summer party.",
                            "target_lang_translations": {
                                "ru": "Она выбрала красивое платье <w>небесно-голубого</w> и розового цветов для летней вечеринки."
                            }
                        },
                        {
                            "text": "The artist used a touch of <w>sky</w> to highlight the horizon.",
                            "target_lang_translations": {
                                "ru": "Художник использовал немного <w>голубого</w>, чтобы подчеркнуть горизонт."
                            }
                        }
                    ],
                    "synonyms": [
                        "blue"
                    ],
                    "common_phrases": [
                        "sky blue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светло-голубой цвет, похожий на цвет ясного неба."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небесно-голубой",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "голубой",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e5efc8-e70d-3910-ba41-195a1002bc2a",
                    "sense_definition": "A cloud.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A single dark <w>sky</w> drifted across the horizon before the storm.",
                            "target_lang_translations": {
                                "ru": "Одинокое темное <w>облако</w> проплыло по горизонту перед бурей."
                            }
                        },
                        {
                            "text": "The sun was hidden behind a thick, grey <w>sky</w> all afternoon.",
                            "target_lang_translations": {
                                "ru": "Солнце весь день было скрыто за густой серой <w>тучей</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage for cloud"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Облако (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облако",
                                "target_lang_sense_clarification": "устаревшее значение"
                            },
                            {
                                "target_lang_word": "туча",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d08a6239-b0fc-3c84-877d-a838020dd7e4",
                    "sense_definition": "To hit, kick, or throw a ball extremely high into the air.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>skied</w> the ball over the crossbar during the final minute.",
                            "target_lang_translations": {
                                "ru": "Нападающий <w>запустил</w> мяч выше перекладины на последней минуте."
                            }
                        },
                        {
                            "text": "He managed to <w>sky</w> the next pitch to left for a sacrifice fly.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>запулить</w> следующую подачу влево для жертвенного флая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sky the ball",
                        "sky a penalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить, пнуть или бросить мяч очень высоко в воздух."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запустить в небо",
                                "target_lang_sense_clarification": "о мяче"
                            },
                            {
                                "target_lang_word": "запулить",
                                "target_lang_sense_clarification": "разговорно, очень высоко"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "716863ee-b195-382d-a28f-30eaddb4550f",
                    "sense_definition": "To toss something upwards, specifically to flip a coin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>sky</w> a coin to see who would go first.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>подбросить</w> монету, чтобы решить, кто пойдет первым."
                            }
                        },
                        {
                            "text": "In <w>skying</w> a coin, the decision is often made by a single toss.",
                            "target_lang_translations": {
                                "ru": "При <w>подбрасывании</w> монеты решение часто принимается одним броском."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skying a coin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for flipping a coin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подбросить что-то вверх, в частности, подбросить монету."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбрасывать",
                                "target_lang_sense_clarification": "монету"
                            },
                            {
                                "target_lang_word": "подбросить вверх",
                                "target_lang_sense_clarification": "предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7b4f036-1571-3f32-8209-8ba3392ed3e0",
                    "sense_definition": "To hang a picture near the top of a wall in an exhibition where it is hard to see.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young artist was disappointed to find the gallery had <w>skied</w> his best work.",
                            "target_lang_translations": {
                                "ru": "Молодой художник был разочарован, обнаружив, что галерея <w>повесила под потолок</w> его лучшую работу."
                            }
                        },
                        {
                            "text": "It is a common complaint among painters that their entries are <w>skied</w> by the committee.",
                            "target_lang_translations": {
                                "ru": "Среди художников часто звучат жалобы на то, что их работы <w>вешают под самый потолок</w> решением комитета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sky a picture"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in art gallery contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повесить картину под самым потолком на выставке, где её трудно разглядеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повесить под потолок",
                                "target_lang_sense_clarification": "о картине на выставке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bea56b29-d448-3548-95ab-a2b963d81b9b",
                    "sense_definition": "A unisex given name of English origin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "All the kids were being called things like <w>Sky</w> and Saffron back then.",
                            "target_lang_translations": {
                                "ru": "В те времена детей часто называли такими именами, как <w>Скай</w> и Саффрон."
                            }
                        },
                        {
                            "text": "My friend <w>Sky</w> is coming over to help me with my homework.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Скай</w> придет ко мне, чтобы помочь с домашним заданием."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Унисекс имя английского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Скай",
                                "target_lang_sense_clarification": "имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "feb27c10-9e77-37c6-b00d-2212341c38f7",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Thomas <w>Sky</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Томас <w>Скай</w>."
                            }
                        },
                        {
                            "text": "We are looking for the records of the <w>Sky</w> family from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье <w>Скай</w> девятнадцатого века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Скай",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c154b4b-12f3-323d-8fac-3d313ed39964",
                    "sense_definition": "Obsolete form of <w>Skye</w>, a Scottish island.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He traveled to the isle of <w>Sky</w> to study the local traditions.",
                            "target_lang_translations": {
                                "ru": "Он отправился на остров <w>Скай</w>, чтобы изучить местные традиции."
                            }
                        },
                        {
                            "text": "Old maps often refer to the island as the Isle of <w>Sky</w>.",
                            "target_lang_translations": {
                                "ru": "На старых картах остров часто упоминается как остров <w>Скай</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Isle of Sky"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма написания Скай (Skye), шотландского острова."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Скай",
                                "target_lang_sense_clarification": "остров"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}