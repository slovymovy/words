                                    {
                                        "sense_id": "c4338b5a-4fe6-3d1d-a7a9-71432478a877",
                                        "entry_id": "7ec8178d-1300-3062-b49c-956f5f4b54aa",
                                        "glosses": [
                                            "A collection of small particles, particularly dirt, that precipitates from a river or other body of water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1201b979-6b6e-4d40-8391-01b304c722e7",
                                                "sense_id": "c4338b5a-4fe6-3d1d-a7a9-71432478a877",
                                                "text": "The Nile delta is composed of sediment that was washed down and deposited at the mouth of the river."
                                            }
