                "senses": [
                    {
                        "sense_id": "5d2497a6-f090-311f-9344-314728e7fd54",
                        "entry_id": "415fa5d9-878f-32c5-a647-68478f97001f",
                        "glosses": [
                            "Beseitigung, Ausschaltung, Entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8ddabfb-016a-4360-aa5b-94825489eb08",
                                "sense_id": "5d2497a6-f090-311f-9344-314728e7fd54",
                                "text": "Die Infektion ist auch noch nach der Elimination des Erregers nachweisbar."
                            },
                            {
                                "example_id": "86985f26-8b13-47d1-8063-6b25e3ae5d5c",
                                "sense_id": "5d2497a6-f090-311f-9344-314728e7fd54",
                                "text": "Auf eine Elimination von Zwischengewinnen konnte verzichtet werden, da die Gesellschaften untereinander zu marktüblichen Bedingungen liefern und die Auswirkungen auf die Gruppenerfolgsrechnung unbedeutend sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b8f6a533-69bc-3f98-8d69-dece08e79ed4",
                        "entry_id": "415fa5d9-878f-32c5-a647-68478f97001f",
                        "glosses": [
                            "direktes Verfahren zur Lösung linearer Gleichungssysteme; rechnerische Beseitigung einer von mehreren unbekannten Größen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eea0ebf-d50a-406d-9332-972f47248f5f",
                                "sense_id": "b8f6a533-69bc-3f98-8d69-dece08e79ed4",
                                "text": "Die Elimination ist ein Verfahren, das mit Äquivalenzumformungen ein beliebiges System auf die Dreiecksform bringt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66b60717-19db-4f70-9946-67994d06430c",
                        "source_entry_id": "415fa5d9-878f-32c5-a647-68478f97001f",
                        "source_sense_id": "5d2497a6-f090-311f-9344-314728e7fd54",
                        "source_sense_description": "Beseitigung, Ausschaltung",
                        "target_lang_word": "elimination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elimination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59ca9d92-d7ac-357e-9b10-156e4d6d9526",
                                        "entry_id": "7b406c57-6229-36ca-9d63-7a7a92589e9b",
                                        "glosses": [
                                            "The act of eliminating, expelling or throwing off."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "253d8aa6-dfdf-4d26-8388-2888ccac463a",
                                                "sense_id": "59ca9d92-d7ac-357e-9b10-156e4d6d9526",
                                                "text": "The real savings of OCR come from the elimination of redundant keyboardings of the same data; from eliminating multiple verification steps; from reducing the number of documents needed to complete a transaction; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e2045a-81cc-3865-8485-306d60389a2c",
                                        "entry_id": "7b406c57-6229-36ca-9d63-7a7a92589e9b",
                                        "glosses": [
                                            "The act of excluding a losing contestant from a match, tournament, or other competition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "536e0e34-938b-4a4f-b650-0c2cd8a7877d",
                                                "sense_id": "39e2045a-81cc-3865-8485-306d60389a2c",
                                                "text": "Everton require at least 3 goals in the second leg to avoid elimination from the FA Cup."
                                            },
                                            {
                                                "example_id": "8e1d3b94-488b-4b79-b77a-7e25be4e0f2e",
                                                "sense_id": "39e2045a-81cc-3865-8485-306d60389a2c",
                                                "text": "Vietnamese tilapia Plastique Tiara was at the forefront of one of Drag Race's most controversial eliminations earlier this year. Although the Texan performer and biological woman was leaving us gooped week-after-week with her runways, she was – spoiler alert! – eliminated in eighth place after lip-syncing against Miss Vanjie, despite having a better track record."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20e8575f-e018-3983-93a1-6d1db9789d64",
                                        "entry_id": "7b406c57-6229-36ca-9d63-7a7a92589e9b",
                                        "glosses": [
                                            "The act of voting off or throwing off a contestant in a reality television competition."
