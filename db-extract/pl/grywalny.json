                "senses": [
                    {
                        "sense_id": "93365b99-e547-3fb9-b979-cd7e96da6f21",
                        "entry_id": "52b90464-616c-3edd-b64d-d1a86cb25673",
                        "glosses": [
                            "taki, w który można zagrać; taki, którym można zagrać"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea174c9-19c0-40ec-9eb7-47315cb573c4",
                                "sense_id": "93365b99-e547-3fb9-b979-cd7e96da6f21",
                                "text": "Fabuła gry przebiega poprzez siedem grywalnych kampanii, których akcja umiejscowiona jest na kontynencie Antagarich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5e1dcc22-75c3-3811-8a4c-15bd98aba840",
                        "entry_id": "52b90464-616c-3edd-b64d-d1a86cb25673",
                        "glosses": [
                            "taki, z którego grając można czerpać przyjemność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214405a6-6996-4596-9461-b017cf8ff42d",
                                "sense_id": "5e1dcc22-75c3-3811-8a4c-15bd98aba840",
                                "text": "Po ostatnich aktualizacjach, w których twórcy starają się dodać nowe mechanizmy, gra nareszcie stała się grywalna."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63aaa9c5-654d-46d1-8bc2-697aafa5d8f9",
                        "source_entry_id": "52b90464-616c-3edd-b64d-d1a86cb25673",
                        "source_sense_id": "93365b99-e547-3fb9-b979-cd7e96da6f21",
                        "target_lang_word": "playable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff1e2510-19e6-3fa3-b8ee-daddfc515f28",
                                        "entry_id": "06fd5794-3b49-3e5d-ac29-501b02a54e84",
                                        "glosses": [
                                            "Able to be played."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "570054bd-8574-47e4-83e3-b4183c868c6c",
                                                "sense_id": "ff1e2510-19e6-3fa3-b8ee-daddfc515f28",
                                                "text": "Not all compact discs are playable in car stereos."
                                            },
                                            {
                                                "example_id": "98c26e45-8e1d-48bf-bcbb-4a8d042ea75f",
                                                "sense_id": "ff1e2510-19e6-3fa3-b8ee-daddfc515f28",
                                                "text": "That original list of 2,315 solutions was embedded in the game’s code. That means the game was playable offline and could be downloaded onto phones or computers. The solutions to the original Wordle game were predetermined through October 20, 2027. The New York Times (NYT) hasn’t said if it plans to make any more changes or additions to that initial list."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a89fbf89-8c04-3efb-a2e8-d93c79aecb7f",
                                        "entry_id": "06fd5794-3b49-3e5d-ac29-501b02a54e84",
                                        "glosses": [
                                            "Of a move, giving a reasonable result; able to be played without losing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1002b8ec-bdfd-48f8-afa5-f2a68f444d51",
                                                "sense_id": "a89fbf89-8c04-3efb-a2e8-d93c79aecb7f",
                                                "text": "Is MAGICS a playable word in Scrabble?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ecd261-b09c-3f16-99e2-27e4f3d0d310",
                                        "entry_id": "06fd5794-3b49-3e5d-ac29-501b02a54e84",
                                        "glosses": [
                                            "Of a game, able to be played and enjoyed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d189aae-92f1-40f0-a706-b73c212b0cda",
                                                "sense_id": "55ecd261-b09c-3f16-99e2-27e4f3d0d310",
                                                "text": "Some of the most playable games tend to be those that've been around the longest: the Breakout/Arkanoid/Batty imitators for instance, or, as here, the Asteroids clones."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "playable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29e03503-601b-3ade-b7c8-6c63e3c59f3b",
                                        "entry_id": "e87fa317-2e28-36c0-9482-7c68258455ff",
                                        "glosses": [
                                            "A character in a game who may be chosen as the player character."
                                        ],
