                "senses": [
                    {
                        "sense_id": "eada5741-f3dd-3fa0-bdfc-b7e5116167cb",
                        "entry_id": "467fbecc-8376-34d8-a974-1828ae58de85",
                        "glosses": [
                            "Eheschließung, deren Grund in erster Linie nicht die Liebe, sondern vernunftgemäße Überlegungen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e6bfe4-03ab-4830-8f34-e4ac2c0ad331",
                                "sense_id": "eada5741-f3dd-3fa0-bdfc-b7e5116167cb",
                                "text": "„Es kam hinzu der häusliche Druck, dem sie seit ihrer konventionellen Vernunftheirat ausgesetzt gewesen war, und der naturgemäß Gegendruck erzeugen mußte.“"
                            },
                            {
                                "example_id": "81d2890e-21a4-420c-9727-c9a2a2e73800",
                                "sense_id": "eada5741-f3dd-3fa0-bdfc-b7e5116167cb",
                                "text": "„Seine eigene Ehe, die der junge Wieland zu Biberach noch spöttisch als Vernunftheirat ausgab, hat sich langsam zu einer wirklichen Liebesbeziehung entwickelt, innig und voller Erotik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6600a88-418c-49b4-9d23-9b1462866b48",
                        "source_entry_id": "467fbecc-8376-34d8-a974-1828ae58de85",
                        "source_sense_id": "eada5741-f3dd-3fa0-bdfc-b7e5116167cb",
                        "source_sense_description": "Eheschließung, deren Grund in erster Linie nicht die Liebe, sondern vernunftgemäße Überlegungen sind",
                        "target_lang_word": "marriage of convenience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marriage of convenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5529b1df-0e95-3f51-8d40-b1596624c072",
                                        "entry_id": "f8502727-0a9c-358f-9107-876209216267",
                                        "glosses": [
                                            "A marriage motivated by some reason other than love; for example, one conducted to obtain residence rights in a country, for financial gain, or for political purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ef5504-b246-4bc1-8fd4-50f14eb87290",
                                                "sense_id": "5529b1df-0e95-3f51-8d40-b1596624c072",
                                                "text": "Widely published author and business consultant would like a marriage of convenience with a woman who is an Irish or Austrian citizen. You get legal resident status in U.S. (and eligibility for student aid), and I get eligibility for prison furloughs plus the citizenship of a neutral country in a few years so I can start a new life elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                        "entry_id": "f8502727-0a9c-358f-9107-876209216267",
                                        "glosses": [
                                            "A big tent alliance of disparate factions (such as political factions)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0254549f-c0bd-4df6-8cb8-8ae63a73d00a",
                                                "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                                "text": "Libertarians and the Religious Right make odd bedfellows, but that marriage of convenience in the Republican Party has stuck around since the 1980s."
                                            },
                                            {
                                                "example_id": "fd51dc2a-a62f-4405-aaac-2d8156507edc",
                                                "sense_id": "cc87daa3-18b6-3ff0-a662-788c158f8ffc",
                                                "text": "Kofi Annan’s marriage of convenience is likely to last only as long as it takes the political players to build up war chests ahead of another electoral bout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
