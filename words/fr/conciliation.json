                        "procédure de conciliation",
                        "tentative de conciliation"
                    ]
                },
                {
                    "sense_id": "870ebce3-d9ba-33a1-ac6f-69ff2c9f6119",
                    "sense_definition": "Action d'harmoniser des textes, des règles ou des concepts en apparence contradictoires.",
