                                "target_senses": [
                                    {
                                        "sense_id": "96e1dd5e-af4a-31e9-aa7c-57d2656c97a2",
                                        "entry_id": "51e78fa8-54cf-34f2-a4a1-343aa7cf3314",
                                        "glosses": [
                                            "Someone who takes advantage of any opportunity to advance their own situation, placing expediency above principle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3baa210-2d32-4973-90c3-c34b47b39aca",
                                                "sense_id": "96e1dd5e-af4a-31e9-aa7c-57d2656c97a2",
                                                "text": "James Milner's angled free-kick was headed on to the post by the tireless Bent and Lampard the opportunist was perfectly placed to stoop and head in from virtually on the goal-line."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ce8f2eb-1806-4931-a431-2cb18742bc0d",
                        "source_entry_id": "a13d34d8-fd0f-304c-97cc-e732f7994e82",
                        "source_sense_id": "54d0ca7f-b5d3-32e5-a6ba-6e5ff72a9490",
