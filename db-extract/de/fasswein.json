                        "source_sense_description": "ein Wein, der in einem Fass gelagert und als solcher angeboten wird",
                        "target_lang_word": "cask wine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cask wine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c42432a-ec16-36cd-a21c-62930f085aac",
                                        "entry_id": "b13bd184-87aa-38da-9997-742a5275a9f8",
                                        "glosses": [
                                            "Wine that is sealed in a plastic bladder and packaged in a cardboard box."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6423de7-9408-4150-bfe7-070457a312ac",
                                                "sense_id": "2c42432a-ec16-36cd-a21c-62930f085aac",
                                                "text": "At the end of the 1970s, a production line for cask wines was introduced."
                                            },
                                            {
                                                "example_id": "3a60cd26-014a-467c-bc23-ff4dc6e3e76b",
                                                "sense_id": "2c42432a-ec16-36cd-a21c-62930f085aac",
                                                "text": "Also, the big wine companies of the eastern states have put cask wine on supermarket shelves tor less than it costs local Swan Valley to produce, let alone sell. And it must be said that the big company cask wine can be easier to live with the morning after."
                                            },
                                            {
                                                "example_id": "2d33c035-0088-48df-9b1d-8870d53ec1e9",
                                                "sense_id": "2c42432a-ec16-36cd-a21c-62930f085aac",
                                                "text": "In this context, bottled wine is a premium product and not generally drunk in the same way or for the same reasons as cask wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf1f31da-3605-3ab2-9ea5-463768877e75",
                                        "entry_id": "b13bd184-87aa-38da-9997-742a5275a9f8",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see cask, wine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4562d1ac-d8e3-4c72-8b41-71574d3ad020",
                                                "sense_id": "bf1f31da-3605-3ab2-9ea5-463768877e75",
                                                "text": "Holland followed suit with a great increase in cask wines and a slight increase in bottled wines."
                                            },
                                            {
                                                "example_id": "43fea656-d3ee-43a5-8868-30af769e9fae",
                                                "sense_id": "bf1f31da-3605-3ab2-9ea5-463768877e75",
                                                "text": "Most common cask wines were a blend of the third, fourth, and fifth cuttings, and they were sold inexpensively and as quickly as possible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
