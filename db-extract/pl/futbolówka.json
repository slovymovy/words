                                            {
                                                "example_id": "ef7cd5a8-d6fa-4a71-ad59-a4605042f2d3",
                                                "sense_id": "c0e42eaa-160c-3309-8f9a-6a9ef86bbc11",
                                                "text": "The aide rides, along with the president's physician, in the “control car,” third in line in the motorcade. He is responsible for the football (or “black box” or “black bag”), a briefcase containing the codes and targeting information the president would require to order or authorize a nuclear attack."
                                            },
                                            {
                                                "example_id": "9554950b-2c35-4850-978b-84dc50c38c6c",
                                                "sense_id": "c0e42eaa-160c-3309-8f9a-6a9ef86bbc11",
                                                "text": "After the lunch broke, we walked to the Trump-Putin press conference, which started about 6 p.m. As Kelly observed to me at some point, there were now two military aides in the room, each carrying his country's nuclear football."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "football",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "025b3baa-7b4f-318c-bca2-9a56a0a63cb5",
                                        "entry_id": "4223fe98-eacf-3517-8712-25fffb0a641b",
                                        "glosses": [
                                            "To play football."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb825b77-828b-44f1-abc5-8aa18773ed93",
                                                "sense_id": "025b3baa-7b4f-318c-bca2-9a56a0a63cb5",
                                                "text": "It was an announcement of the outbreak of what is now termed World War I. Some of us lads were footballing when we heard the news. It left us bewildered."
                                            },
                                            {
                                                "example_id": "8644b049-869c-45a9-9f76-31cc2f00b5dd",
                                                "sense_id": "025b3baa-7b4f-318c-bca2-9a56a0a63cb5",
                                                "text": "You walked up our road, passed the elms that bordered our park until Dutch disease killed them in the early 1970s, diagonally crossed its field where we footballed, turned right at the drinking fountain and cattle trough […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3746e6b6-15a4-45b4-96b7-a4cada5b83de",
                        "source_entry_id": "f8b310d8-60c9-3e1f-b0f1-875877e070ff",
                        "source_sense_id": "1efa9747-2c6b-3b15-a3c7-585abc6edd0b",
