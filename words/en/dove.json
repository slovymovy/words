                {
                    "sense_id": "a478b833-6316-3c99-8d6a-104f489cb201",
                    "sense_definition": "A river in England, forming the boundary between Derbyshire and Staffordshire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "We went for a long walk along the banks of the River <w>Dove</w>.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на долгую прогулку по берегам реки <w>Дав</w>.",
                                "de": "Wir machten einen langen Spaziergang entlang der Ufer des Flusses <w>Dove</w>.",
                                "zh": "我们沿着<w>达夫河</w>岸边走了很长一段路。"
                            }
                        },
                        {
