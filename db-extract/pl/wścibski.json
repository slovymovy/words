                "senses": [
                    {
                        "sense_id": "f8c57306-9427-32ce-b36c-263b8a5295d6",
                        "entry_id": "126a2320-a309-376b-8dc9-54c50fa0c1fd",
                        "glosses": [
                            "natrętnie wtrącający się w cudze sprawy; ciekawski"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf2c5d2-4e5f-4951-9e62-b3319859e31d",
                                "sense_id": "f8c57306-9427-32ce-b36c-263b8a5295d6",
                                "text": "Wylądował w Zakopanem mając za sobą ucieczkę z domu i ze szkoły średniej. Żywy, wesoły, wścibski, miejsca nigdzie nie zagrzał"
                            }
                        ],
