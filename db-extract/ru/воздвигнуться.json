                ],
                "senses": [
                    {
                        "sense_id": "ef1d15ba-a2ce-33e1-98f2-08d0b55d324b",
                        "entry_id": "7f16f76e-535b-372b-9006-8d72d71f94b7",
                        "glosses": [
                            "построиться, соорудиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46e92926-cde7-4b10-80f2-9ed6007956ea",
                                "sense_id": "ef1d15ba-a2ce-33e1-98f2-08d0b55d324b",
                                "text": "В тени густой угрюмых сосен / Воздвигся памятник простой."
                            }
                        ]
                    },
                    {
                        "sense_id": "c16f7768-5f41-3753-8a29-12ded04c0179",
                        "entry_id": "7f16f76e-535b-372b-9006-8d72d71f94b7",
                        "glosses": [
                            "устар. подняться, возвыситься"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ca605f4-ec91-48f2-9199-eed84f6327c6",
                                "sense_id": "c16f7768-5f41-3753-8a29-12ded04c0179",
                                "text": "И видит: неприступных гор / Над ним воздвигнулась громада."
                            }
                        ]
                    },
                    {
                        "sense_id": "28982bc2-430d-310e-b041-c7df8f16984e",
                        "entry_id": "7f16f76e-535b-372b-9006-8d72d71f94b7",
                        "glosses": [
                            "устар. произойти, подняться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41dc5ac1-5758-4628-8b78-e69fe8a2071f",
                                "sense_id": "28982bc2-430d-310e-b041-c7df8f16984e",
                                "text": "От дерзкой наглости разгневанным Петром / Воздвигся в западе войны ужасной гром."
                            },
                            {
                                "example_id": "79dfd4cd-ec4b-40ad-b8b2-032063feec74",
                                "sense_id": "28982bc2-430d-310e-b041-c7df8f16984e",
                                "text": "Поверглись горы, стонет лес, / Воздвиглась сильна буря в понте."
                            }
                        ]
                    }
                ],
