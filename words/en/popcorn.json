                },
                {
                    "sense_id": "f0b00cd6-86ff-305c-a089-54b482668bfa",
                    "sense_definition": "A form of brainstorming in which participants call out their ideas immediately, instead of waiting for an assigned turn to speak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "method_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team used <w>popcorn</w> brainstorming to generate a list of potential solutions quickly.",
                            "target_lang_translations": {
                                "ru": "Команда использовала мозговой штурм в стиле <w>попкорн</w>, чтобы быстро составить список возможных решений.",
                                "zh": "团队使用<w>爆米花式</w>头脑风暴法快速列出了潜在的解决方案。",
                                "es": "El equipo utilizó una lluvia de ideas <w>espontánea</w> para generar rápidamente una lista de posibles soluciones."
                            }
                        },
                        {
                            "text": "In the <w>popcorn</w> method, anyone can speak up as soon as they have an idea.",
                            "target_lang_translations": {
                                "ru": "В методе <w>попкорна</w> любой может высказаться, как только у него появится идея.",
                                "zh": "在<w>爆米花式</w>方法中，任何人只要有想法就可以立即发言。",
                                "es": "En el método de <w>participación libre</w>, cualquiera puede hablar tan pronto como tenga una idea."
                            }
                        }
                    ],
                    "common_phrases": [
                        "popcorn brainstorming",
                        "popcorn style",
                        "popcorn method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид мозгового штурма, при котором участники выкрикивают идеи в произвольном порядке.",
                        "zh": "一种头脑风暴法，参与者不按顺序，想到什么就立即说出来。",
                        "es": "Método de lluvia de ideas donde los participantes expresan sus ideas de forma espontánea."
                    },
                    "translations": {
                        "ru": [
