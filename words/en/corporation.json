                {
                    "sense_id": "d0d71e6c-e64b-3d70-b477-3c5e0549a60d",
                    "sense_definition": "A joint association of employers' and workers' representatives in Fascist Italy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>corporation</w> was established to manage labor relations within the industry.",
                            "target_lang_translations": {
                                "ru": "<w>Корпорация</w> была создана для управления трудовыми отношениями в отрасли.",
                                "zh": "该<w>法团</w>的成立旨在管理行业内的劳资关系。"
                            }
                        },
                        {
                            "text": "Under the new regime, each economic sector was governed by a specific <w>corporation</w>.",
                            "target_lang_translations": {
                                "ru": "При новом режиме каждый сектор экономики управлялся отдельной <w>корпорацией</w>.",
                                "zh": "在新政权下，每个经济部门都由特定的<w>法团</w>管理。"
                            }
                        }
                    ],
