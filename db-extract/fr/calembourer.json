                "senses": [
                    {
                        "sense_id": "6cae49af-4b5b-3f20-9c54-e44b6d9512ec",
                        "entry_id": "3e997c5a-7387-3a55-9204-359fd76e0295",
                        "glosses": [
                            "Faire des calembours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61861406-0b14-42a4-a5dc-341b5e0ce1ae",
                                "sense_id": "6cae49af-4b5b-3f20-9c54-e44b6d9512ec",
                                "text": "Il contrepète, il néologise, il calemboure, il paronymise, il polysémise, bref il prend les mots et les phrases comme il les entend, les épluche, les contorsionne, les transforme, les hache menu, les saisit quelques minutes et les sert bien chauds."
                            },
                            {
                                "example_id": "a17bbfd8-e7aa-435a-b1ec-882b2099b36e",
                                "sense_id": "6cae49af-4b5b-3f20-9c54-e44b6d9512ec",
                                "text": "Quel est ce démon taquin qui pousse les gens à calembourer?..."
                            },
                            {
                                "example_id": "2a46a9f0-2df5-4351-824d-ca8984b1a8e8",
                                "sense_id": "6cae49af-4b5b-3f20-9c54-e44b6d9512ec",
                                "text": "Il m’admire de pouvoir calembourer dans de telles circonstances, considère cela comme une nouvelle preuve de l’inconscience française."
                            }
                        ]
                    }
                ],
