                "senses": [
                    {
                        "sense_id": "331308fc-29bc-3c23-b140-c48c2aaac023",
                        "entry_id": "e98c289e-18da-377d-9106-a7c837c3cffe",
                        "glosses": [
                            "jongen baren (door een zeug)"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "9db7631c-9523-485a-b2b1-3141e776e441",
                                "sense_id": "331308fc-29bc-3c23-b140-c48c2aaac023",
                                "text": "Na de biggen, brengen we een bezoek aan de zeugen die pas zijn bevallen of op het punt staan te biggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b73259a6-0f7a-33cb-91c0-69cd3382cc1f",
                        "entry_id": "e98c289e-18da-377d-9106-a7c837c3cffe",
                        "glosses": [
                            "verdringen door tegen het lichaam te duwen (zoals biggetjes dat doen bij het spelen of het vinden van een tepel bij de zeug)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d437f3de-50cd-47db-8e25-017ed2511a63",
                                "sense_id": "b73259a6-0f7a-33cb-91c0-69cd3382cc1f",
                                "text": "Ten slotte gaf ik toe en liet hem zo ver de kamer in dat hij het blad op een nachtkastje kon zetten voordat ik hem min of meer lijfelijk weer de gang op bigde."
                            },
                            {
                                "example_id": "664b69fb-91fc-47aa-912d-f7d6fe9ab2b8",
                                "sense_id": "b73259a6-0f7a-33cb-91c0-69cd3382cc1f",
                                "text": "De biggen liepen direct met elkaar te spelen, te rennen en te biggen."
                            }
                        ]
                    }
                ],
