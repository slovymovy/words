                "senses": [
                    {
                        "sense_id": "5146aaa3-fb29-37f3-b5a4-75a5c7253f82",
                        "entry_id": "45489c24-8356-30e5-ab80-0d2d2ed7df23",
                        "glosses": [
                            "Mediziner, der auf die Behandlung von Notfällen spezialisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "236669aa-9dbf-435e-96d8-7c84cd21cd08",
                                "sense_id": "5146aaa3-fb29-37f3-b5a4-75a5c7253f82",
                                "text": "Der Notarzt traf 20 Minuten nach dem Unfall ein und konnte den Verletzten versorgen."
                            },
                            {
                                "example_id": "a81689b3-75fc-4217-8047-fe29d8771e28",
                                "sense_id": "5146aaa3-fb29-37f3-b5a4-75a5c7253f82",
                                "text": "„Der Notarzt entdeckt zudem, was der geschockte Ehemann gar nicht wahrgenommen hat.“"
                            },
                            {
                                "example_id": "a08a3b63-c095-4097-abe7-8345f9bc790e",
                                "sense_id": "5146aaa3-fb29-37f3-b5a4-75a5c7253f82",
                                "text": "„Als dann einmal ein männlicher Notarzt kam, haben sie ihm nicht einmal die Tür aufgemacht.“"
                            },
                            {
                                "example_id": "aa9a24ec-83d8-46a6-9eb1-17c483cfa9b5",
                                "sense_id": "5146aaa3-fb29-37f3-b5a4-75a5c7253f82",
                                "text": "„Erst dann springt sie auf, rennt hoch ins Café, um den Notarzt anzurufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
