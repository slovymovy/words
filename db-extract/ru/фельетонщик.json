                "senses": [
                    {
                        "sense_id": "bd51ad7f-50c9-36b2-bbd7-53c1e530bbb6",
                        "entry_id": "5139f91e-9f62-360a-b0ca-02df3c0a071f",
                        "glosses": [
                            "разг. то же, что и фельетонист (с оттенком пренебрежения)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346c4a60-07cc-41a8-b102-67840b946ce0",
                                "sense_id": "bd51ad7f-50c9-36b2-bbd7-53c1e530bbb6",
                                "text": "Положим, честнейший Андрей Александрович, что ваш фельетонщик не знает, продавал ли я или нет крещëную собственность, но вы-то знаете, что я не продавал никогда никакого имения, никаких людей; я смело говорю, что вы это знаете."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81619afb-2c38-4aa5-a030-2c647ee4ba4f",
                        "source_entry_id": "5139f91e-9f62-360a-b0ca-02df3c0a071f",
                        "source_sense_id": "bd51ad7f-50c9-36b2-bbd7-53c1e530bbb6",
                        "target_lang_word": "feuilletonist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuilletonist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca93220f-7ae3-3cbe-a195-2f5400eadd9f",
                                        "entry_id": "731f74ad-bf98-3ac4-bbe9-4a5d4979736f",
                                        "glosses": [
                                            "A writer of feuilletons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7888315a-a68c-4a6b-a6d6-28ad1b0f05e3",
                                                "sense_id": "ca93220f-7ae3-3cbe-a195-2f5400eadd9f",
                                                "text": "In 1895, while Japan was busy beating China, and had convinced herself that she could beat the world, one of the Tōkyō papers achieved a success by the publication of a serial noved entitled Asahi-Zakura, by a feuilletonist called Murai Gensai."
                                            },
                                            {
                                                "example_id": "ff94d651-d097-40bc-ac6a-bf32fd014bf3",
                                                "sense_id": "ca93220f-7ae3-3cbe-a195-2f5400eadd9f",
                                                "text": "But for all this, Grassou gave excellent counsel, like those feuilletonists incapable of writing a book who know very well where a book is wanting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c97748c1-69e0-47e2-94d1-f63dfe97c624",
                        "source_entry_id": "5139f91e-9f62-360a-b0ca-02df3c0a071f",
                        "source_sense_id": "bd51ad7f-50c9-36b2-bbd7-53c1e530bbb6",
                        "target_lang_word": "feuilletonista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
