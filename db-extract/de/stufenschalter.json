                "senses": [
                    {
                        "sense_id": "1927c67c-c870-3252-b0ca-f60382a224c1",
                        "entry_id": "525bc79d-a37b-3cb6-b456-bb971f261b03",
                        "glosses": [
                            "elektrischer Schalter mit mehr als 3 Schaltstellungen, der die stufenweise Erhöhung oder Minderung einer Spannung ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ffe47d4-789c-4dc2-8c55-7886b600ad18",
                                "sense_id": "1927c67c-c870-3252-b0ca-f60382a224c1",
                                "text": "„Der Stufenschalter ist geeicht in Volt/div (1 div = 1 Zentimeter auf dem Bildschirm).“"
                            },
                            {
                                "example_id": "10cd77c6-a1bc-4519-ad29-41813b6e1ba4",
                                "sense_id": "1927c67c-c870-3252-b0ca-f60382a224c1",
                                "text": "„Zur Auswahl eines Messbereiches werden über einen Stufenschalter die entsprechenden Widerstände zugeschaltet.“"
                            },
                            {
                                "example_id": "97db87a6-d5d7-464a-8d4a-05c03fbdd3a0",
                                "sense_id": "1927c67c-c870-3252-b0ca-f60382a224c1",
                                "text": "„Für die Messung einer elektrischen Größe wird mit dem Stufenschalter der richtige Messbereich gewählt und Messleitungen an den Buchsen die mit der gewünschten Messgröße bezeichnet sind angeschlossen.“"
                            },
                            {
                                "example_id": "9e1b981b-8171-4e42-85e8-3637870986dd",
                                "sense_id": "1927c67c-c870-3252-b0ca-f60382a224c1",
                                "text": "„Genau so bedeutend sind die Stufenschalter für große Stromverbraucher wie Fabriken oder auch für Bereiche, in denen der Strom nicht ausfallen darf, wie Krankenhäuser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
