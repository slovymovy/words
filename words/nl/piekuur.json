    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56cf93cc-51e4-3527-aeff-0bfbc8c9c49e",
                    "sense_definition": "een periode gedurende de dag waarop de drukte of activiteit het grootst is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "drukte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het <w>piekuur</w> is het in de supermarkt vaak erg lastig om snel af te rekenen.",
                            "target_lang_translations": {
                                "en": "During the <w>peak hour</w>, it is often very difficult to check out quickly at the supermarket."
                            }
                        },
                        {
                            "text": "De bezorgers werken vooral tijdens het <w>piekuur</w> om zoveel mogelijk bestellingen af te leveren.",
                            "target_lang_translations": {
                                "en": "The delivery drivers work mainly during the <w>rush hour</w> to deliver as many orders as possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "spits",
                        "spitsuur"
                    ],
                    "antonyms": [
                        "daluren"
                    ],
                    "common_phrases": [
                        "tijdens het piekuur",
                        "het dagelijkse piekuur"
                    ],
                    "target_lang_definitions": {
                        "en": "a period during the day when activity or busyness is at its highest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peak hour",
                                "target_lang_sense_clarification": "general period of high activity"
                            },
                            {
                                "target_lang_word": "rush hour",
                                "target_lang_sense_clarification": "busy period in a store or business"
                            },
                            {
                                "target_lang_word": "peak time",
                                "target_lang_sense_clarification": "period of maximum demand or activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "683f5d81-abd1-3e39-9a38-f4cf26fb160a",
                    "sense_definition": "een periode met een zeer hoge verkeersintensiteit, vaak leidend tot files",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het regionale wegennet wordt tijdens de <w>piekuren</w> vaak volledig overbelast door het vele woon-werkverkeer.",
                            "target_lang_translations": {
                                "en": "The regional road network is often completely overloaded during <w>peak hours</w> due to the heavy commuting traffic."
                            }
                        },
                        {
                            "text": "Als je na het <w>piekuur</w> vertrekt, ben je meestal veel sneller op je bestemming.",
                            "target_lang_translations": {
                                "en": "If you leave after <w>rush hour</w>, you usually reach your destination much faster."
                            }
                        }
                    ],
                    "synonyms": [
                        "spits",
                        "spitsuur"
                    ],
                    "antonyms": [
                        "daluren"
                    ],
                    "common_phrases": [
                        "verkeer tijdens piekuren",
                        "het vermijden van piekuren"
                    ],
                    "target_lang_definitions": {
                        "en": "a period with very high traffic intensity, often leading to traffic jams"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peak hour",
                                "target_lang_sense_clarification": "traffic and transportation"
                            },
                            {
                                "target_lang_word": "rush hour",
                                "target_lang_sense_clarification": "heavy traffic period"
                            },
                            {
                                "target_lang_word": "peak period",
                                "target_lang_sense_clarification": "time of high traffic volume"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de4e0536-5fee-3280-94e0-7ea5d74caff5",
                    "sense_definition": "een tijdstip waarop de vraag naar een bepaalde voorziening, zoals water of elektriciteit, maximaal is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consumptie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het waterbedrijf vraagt klanten om het verbruik tijdens het <w>piekuur</w> zoveel mogelijk te beperken.",
                            "target_lang_translations": {
                                "en": "The water company asks customers to limit consumption as much as possible during the <w>peak hour</w>."
                            }
                        },
                        {
                            "text": "De prijs voor elektriciteit is vaak hoger wanneer je stroom verbruikt tijdens een <w>piekuur</w>.",
                            "target_lang_translations": {
                                "en": "The price of electricity is often higher when you use power during a <w>peak hour</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "daluren"
                    ],
                    "common_phrases": [
                        "het elektrisch piekuur",
                        "verbruik tijdens piekuren"
                    ],
                    "target_lang_definitions": {
                        "en": "a time when the demand for a specific utility, such as water or electricity, is at its maximum"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peak hour",
                                "target_lang_sense_clarification": "utility consumption"
                            },
                            {
                                "target_lang_word": "peak time",
                                "target_lang_sense_clarification": "energy or water usage"
                            },
                            {
                                "target_lang_word": "on-peak hour",
                                "target_lang_sense_clarification": "electricity pricing period"
                            }
                        ]
                    }
                }
            ]
        }
    ]
