                        "entry_id": "2978ed6c-f081-3f5c-8843-d80c6f3f5af5",
                        "glosses": [
                            "Gesamtheit der Verfahren zur Herstellung von Metallen oder bestimmten Legierungen aus Erzen oder metallhaltigen Abfällen"
                        ],
                        "tags": [
                            "Werkstoffkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "8a599de3-687d-46ce-b41a-20c92bdc5820",
                                "sense_id": "8ca7f749-74e3-31fd-a69f-7154f6d4faad",
                                "text": "„In der Folgezeit hat Karsten viel zur Entwicklung des Hüttenwesens in Deutschland beigetragen; insbesondere die Entstehung der Zinkindustrie in Schlesien ist auf ihn zurückzuführen.“"
                            }
                        ],
