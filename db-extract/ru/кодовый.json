                                                "sense_id": "0c4cec21-59e2-3600-ab0e-a6bfc15891a7",
                                                "text": "Object-oriented C++ code is easier to understand for a human than C code."
                                            },
                                            {
                                                "example_id": "8de4f4ca-4bbf-456d-bdcc-b04a3d8f0349",
                                                "sense_id": "0c4cec21-59e2-3600-ab0e-a6bfc15891a7",
                                                "text": "I wrote some code to reformat text documents."
                                            },
                                            {
                                                "example_id": "1cd8e672-82db-4943-902c-4678d6b55909",
                                                "sense_id": "0c4cec21-59e2-3600-ab0e-a6bfc15891a7",
                                                "text": "This HTML code may be placed on your web page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a74e2e52-5a1a-3860-b264-732562b21785",
                                        "entry_id": "0cdd773a-fbe2-3e09-abda-dc9a05c072d2",
