                        "glosses": [
                            "The vulva or vagina, or a symbol of them, especially as an object of veneration within certain types of Hinduism, Buddhism, and other cultures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71609b3a-f7c6-4704-af8e-964a633226cd",
                                "sense_id": "cb9e380d-6efa-352a-ac3a-c870253c24ac",
                                "text": "Stroke your partner's thighs and caress her breasts as you make love to her yoni with your mouth and tongue."
                            },
                            {
                                "example_id": "19949c34-6640-4397-bbbc-ec672f492f20",
                                "sense_id": "cb9e380d-6efa-352a-ac3a-c870253c24ac",
                                "text": "In Hinduism [...] and Tantrism [...], the yoni is the generative organ of the Goddess."
                            },
                            {
                                "example_id": "e84c078f-7fe7-4c93-b15f-b46b3872b56c",
                                "sense_id": "cb9e380d-6efa-352a-ac3a-c870253c24ac",
                                "text": "The goddess blesses him by placing his liṅgam in her yoni."
                            }
                        ]
