        "fr-extract.jsonl": [
            {
                "entry_id": "cd530074-f795-323d-b5a6-2a503def5e58",
                "word": "Soleure",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                        "entry_id": "cd530074-f795-323d-b5a6-2a503def5e58",
                        "glosses": [
                            "Ville du canton de Soleure en Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f2820b-17a3-45ca-a4c1-2a8de35fb0f1",
                                "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                                "text": "Si vous nous envoyez quelques lettres adressées aux Délices, ne nous en envoyez à Berne qu’une fois, et gardez les suivantes jusqu’à nouvel ordre, mon cher Colini : car nous sommes un peu en l’air. Nous irons à Soleure, de là nous retournons à Monrion, et nous regagnons ensuite notre lac de Genève."
                            },
                            {
                                "example_id": "ee06f145-723a-488a-a096-c5e36d11bc51",
                                "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                                "text": "Soleure. La belle cathédrale baroque est placée sous l’invocation des saints Urs et Victor."
                            },
                            {
                                "example_id": "3eb08e21-22e0-498f-b77f-1dd839e36b4e",
                                "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                                "text": "Ils se cherchèrent dans la région un logis qui ne fût qu’à eux seuls, et s’achetèrent enfin près de Soleure un petit pavillon délabré du XVIIIᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9f29e4f-2214-37b8-acbc-488caad150b8",
                        "entry_id": "cd530074-f795-323d-b5a6-2a503def5e58",
                        "glosses": [
                            "Canton et district autour de cette ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f711a07a-175b-4f74-b8be-6b603747e875",
                                "sense_id": "d9f29e4f-2214-37b8-acbc-488caad150b8",
                                "text": "Soleure, canton de, (Géog. mod.) canton de la Suisse, & l’onzieme en ordre. Il est borné au nord par le canton de Bâle, au midi & au levant par le canton de Berne, au couchant par ce même canton & en partie par les terres de l’évêque de Bâle. Il s’étend le long de l’Aare, en partie dans la plaine & en partie dans le mont Jura."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24a96958-275d-4b4b-acc6-372835325bfd",
                        "source_entry_id": "cd530074-f795-323d-b5a6-2a503def5e58",
                        "target_lang_word": "Solothurn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Solothurn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90342d9d-a278-301b-92f2-c4689059bba0",
                                        "entry_id": "48337e69-8bc2-3199-bf57-59d880623d82",
                                        "glosses": [
                                            "Hauptstadt des gleichnamigen Schweizer Kantons"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46415fe7-efb0-4307-9232-72ceb58580a2",
                                                "sense_id": "90342d9d-a278-301b-92f2-c4689059bba0",
                                                "text": "„Solothurn liegt beidseits der Aare am Südfuss des Jura, 5 km südlich des «Solothurner Hausbergs» Weissenstein.“"
                                            },
                                            {
                                                "example_id": "d7781457-9f50-4a05-991a-7963a679f813",
                                                "sense_id": "90342d9d-a278-301b-92f2-c4689059bba0",
                                                "text": "„Solothurn gilt als die schönste Barockstadt der Schweiz, wo sich italienische Grandezza mit französischem Charme und Deutschschweizer Bodenständigkeit verbindet. Die so genannte «Ambassadorenstadt» liegt am Jurasüdfuss am Lauf der Aare rund 30 Kilometer östlich von Biel.“"
                                            },
                                            {
                                                "example_id": "0045e8d3-2c17-4493-ae1e-0e73d1f0fd58",
                                                "sense_id": "90342d9d-a278-301b-92f2-c4689059bba0",
                                                "text": "„Die Stadt hat ein überregional bedeutendes Kulturangebot, darunter die Solothurner Film- oder Literaturtage. Die Vielfalt an Museen reicht vom Historischen Museum über das international ausgezeichnete Naturmuseum, ein Steinmuseum, das ENTER PC-Museum oder das Schloss Waldegg bis zum Kabinett für sentimentale Trivialliteratur. Im Museum «Altes Zeughaus» schliesslich kann eine der grössten Waffensammlungen Europas bestaunt werden.“"
                                            },
                                            {
                                                "example_id": "cf7cd750-8ce3-4458-9d49-0404cdb84290",
                                                "sense_id": "90342d9d-a278-301b-92f2-c4689059bba0",
                                                "text": "„Bei Tagesanbruch fuhren sie nach Solothurn zurück, wo Lebel zu tun hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "835ddfd2-def1-3cd5-a89b-f6ae020b094f",
