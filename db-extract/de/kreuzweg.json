                    {
                        "form_id": "bf8965ba-c168-4995-8991-d543400161ed",
                        "entry_id": "c928c288-3465-3c75-b5ab-53d74b3f76d5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kreuzwege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac072ff8-b243-30ea-bde7-c9392a62d439",
                        "entry_id": "c928c288-3465-3c75-b5ab-53d74b3f76d5",
                        "glosses": [
                            "die Kreuzung verschiedener Wege an einer Stelle; die Stelle, an der sich verschiedene Wege gabeln"
                        ],
                        "tags": [
                            "eigentlich und bildlich"
                        ],
                        "examples": [
                            {
                                "example_id": "f014bb7f-8410-434c-b2fa-f35aa116485a",
                                "sense_id": "ac072ff8-b243-30ea-bde7-c9392a62d439",
                                "text": "„Sie seien an einen Kreuzweg gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3e692e7a-213a-34a3-b91b-4da3c84d8634",
                        "entry_id": "c928c288-3465-3c75-b5ab-53d74b3f76d5",
                        "glosses": [
                            "ein Weg in Jerusalem; Teil der Via Dolorosa"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "af3214c1-2575-33bb-8897-4ed3fb74b3ff",
                        "entry_id": "c928c288-3465-3c75-b5ab-53d74b3f76d5",
                        "glosses": [
                            "der Leidensweg Jesu; der Weg, den Jesus als seine Passion nach Golgatha ging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8caaae4d-2a51-4a90-965c-59665a438149",
                                "sense_id": "af3214c1-2575-33bb-8897-4ed3fb74b3ff",
                                "text": "„In den beiden MISEREOR-Kreuzwegen verbindet sich das Leiden der hungernden Menschen mit dem Kreuzweg Jesu.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "3ddbc7ef-60af-3a5e-9de1-b4dcc5a34e5f",
                        "entry_id": "c928c288-3465-3c75-b5ab-53d74b3f76d5",
                        "glosses": [
                            "eine (traditionell in 14 Stationen gegliederte) Andacht für die Fastenzeit, in welcher der Beter des Leidens und Sterbens Christi gedenkt"
                        ],
                        "tags": [
                            "speziell Katholizismus und anglikanische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "d558d0c4-1193-4451-a252-6753f7f6f73d",
                                "sense_id": "3ddbc7ef-60af-3a5e-9de1-b4dcc5a34e5f",
                                "text": "„In den beiden MISEREOR-Kreuzwegen verbindet sich das Leiden der hungernden Menschen mit dem Kreuzweg Jesu.“"
                            },
                            {
                                "example_id": "52cf1fdb-a896-4c58-8a99-d5eaf6a4168a",
                                "sense_id": "3ddbc7ef-60af-3a5e-9de1-b4dcc5a34e5f",
                                "text": "„Vielen Menschen in unserer evangelischen Gemeinde noch unbekannt, liegt an einem Wanderweg oberhalb des Kürtener Waldfriedhofs ein moderner Kreuzweg. Gestaltet vom Franziskanerpater Leo Jahn auf Betreiben des ehemaligen Pfarrers der St. Johannes Baptist Gemeinde in Kürten, Heinz Kramm, stellt dieser Kreuzweg eine eindrückliche Aktualisierung des Leidensweges Christus für unsere Zeit dar. […] Darum möchte ich Sie einladen, sich einmal dieser katholischen Tradition des Kreuzweges anzunähern.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
