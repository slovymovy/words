                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65ef202-520c-4256-9026-e62b807988bc",
                                                "sense_id": "8ca5979d-53c8-321b-b06e-db2d964d31ec",
                                                "text": "Sers-moi un verre de chartreuse… j'ai le cœur sens dessus dessous… ça me remettra… de la verte, tu sais… la jaune est trop fade."
                                            },
                                            {
                                                "example_id": "3e919953-2524-4596-a120-bd03f21aeb88",
                                                "sense_id": "8ca5979d-53c8-321b-b06e-db2d964d31ec",
                                                "text": "– Remettez-vous, cher ami : je partagerai de bon cœur vos tribulations et déboires comme vos béatitudes et aubaines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
