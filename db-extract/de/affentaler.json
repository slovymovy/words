                "senses": [
                    {
                        "sense_id": "825acf71-5ab6-302f-b580-c3189f317c8a",
                        "entry_id": "bc97a78c-8860-3370-8293-342e11e4ea8e",
                        "glosses": [
                            "ein badischer Herkunftstypenwein der Rebsorte Spätburgunder, der laut Lagenverordnung nur aus den Gemarkungen der Gemeinden Bühlertal, Altschweier (Bühl), Affental (Bühl) und Neuweier (Baden-Baden) stammen darf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ad7623c-4eaa-41e6-88f7-a14d86eed896",
                                "sense_id": "825acf71-5ab6-302f-b580-c3189f317c8a",
                                "text": "„Affentaler darf nur als Qualitätswein angeboten werden […].“"
                            },
                            {
                                "example_id": "305aad35-3213-4187-a4b2-bc1e93e15496",
                                "sense_id": "825acf71-5ab6-302f-b580-c3189f317c8a",
                                "text": "„Der Affe auf einer Flasche Affentaler gilt als ‚Markenzeichen‘, was aber dem Namen nicht gerecht wird, da das Wort ‚Affental‘ auf ‚Ave-Tal‘ zurückzuführen ist.“"
                            }
                        ],
