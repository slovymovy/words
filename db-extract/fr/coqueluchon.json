                        "glosses": [
                            "Sorte de capuchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34da138c-6d3b-471c-a33d-2f4ec7fb8660",
                                "sense_id": "329bb65f-571d-386d-bb2c-7a4b46c68c17",
                                "text": "Mam’selle Catherine en robe de satin rose, et la tête couverte d’un coqueluchon où ses cheveux blonds se jouaient dans la dentelle noire."
                            },
                            {
                                "example_id": "227ea18b-f8de-4a5d-bcb2-11317e7cf1a2",
                                "sense_id": "329bb65f-571d-386d-bb2c-7a4b46c68c17",
                                "text": "Toutefois je conseille aux femmes de ne pas sortir le soir sans un mantelet, la tête couverte d’un coqueluchon."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a68987b-da84-3bfb-b5ed-a8fae5919e98",
                        "entry_id": "7a9cae9e-5493-338c-8e15-dec559a55a38",
                        "glosses": [
                            "Sorte de capuchon.",
                            "Tête, visage."
                        ],
                        "tags": [
