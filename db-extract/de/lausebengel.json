                                        "sense_id": "4296966f-e89a-303b-9600-02ac9f88b4a8",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "An itinerant tinsmith and mender of household utensils made of metal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "971c5be0-6463-4807-a313-597536634cca",
                                                "sense_id": "4296966f-e89a-303b-9600-02ac9f88b4a8",
                                                "text": "The blacksmith chased us all to ground\nThey searched all night we were never found\nThe tinker boys and the sheriff's men\nShaking the tallest tree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fba8445-a097-308d-bb68-4fd35a8fc72b",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "A member of the Irish Traveller community or of other itinerant groups; a gypsy."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "dated",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ed0f792-7431-3bfd-9e02-00420c789c85",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "A mischievous person, especially a playful, impish youngster."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a521e8e4-2ecf-35ab-b934-7c46708257ea",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "Someone who repairs, or attempts repair, on anything mechanical, or who invents such devices; one who tinkers; a tinkerer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9270f5-f327-356a-b3ae-b9c08beab647",
                                        "entry_id": "0a3c2746-08e3-3a50-92ff-3ad5b66bdddc",
                                        "glosses": [
                                            "An act of repair or invention."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56c807d0-490c-4149-b884-89cdaaac5ee9",
                                                "sense_id": "cb9270f5-f327-356a-b3ae-b9c08beab647",
                                                "text": "I'll have a tinker and see what I can do."
                                            }
                                        ]
                                    },
