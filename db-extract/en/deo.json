                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd08ca00-f337-4e42-9d49-a9dea6af5994",
                                "sense_id": "adeed7fa-cbbc-34ec-aaf1-848a5f19a5a6",
                                "text": "Some men complain their deos don't work after regular use. Your underarm area can build up immunity to the same product. Alternating two deos can give you total protection."
                            },
                            {
                                "example_id": "4b7ab1b7-5401-4c87-a060-4e5bc12afa2e",
                                "sense_id": "adeed7fa-cbbc-34ec-aaf1-848a5f19a5a6",
                                "text": "He brandishes a can of deodorant (deo) spray as he says this, grinning all the time. 'I started using this about two years ago. I didn't realise deos can be so useful in controlling sweating and keeping me feeling fresh. […]"
                            },
                            {
                                "example_id": "fdaf9fa5-2125-40a2-9b1b-3595a7d1d21f",
                                "sense_id": "adeed7fa-cbbc-34ec-aaf1-848a5f19a5a6",
                                "text": "'Maybe it's a teeny bit embarrassing, but seeing that we're good friends, Jabłonovska, don't you use any deo?' 'Any what?' 'Deo. Deodorant.' She pronounced the final T sharply and distinctly."
                            }
                        ]
                    }
                ],
