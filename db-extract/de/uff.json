                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78a55d92-2fbb-411d-8bfe-e559ec8842fe",
                        "source_entry_id": "1677a229-96f6-37f1-b6df-a47610520cb5",
                        "source_sense_id": "951d7d9b-c36b-3c22-9de1-4ea456f03fd3",
                        "target_lang_word": "whew",
