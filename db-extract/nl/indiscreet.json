                ],
                "senses": [
                    {
                        "sense_id": "ffd6c1cd-49cb-39dc-959b-2a13c90e0723",
                        "entry_id": "46d55551-44c8-3441-95ba-45097ec6f5c5",
                        "glosses": [
                            "onbescheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17fd7cd1-7703-4bf4-b948-8f9ad2e2774f",
                                "sense_id": "ffd6c1cd-49cb-39dc-959b-2a13c90e0723",
                                "text": "Het verzoek om een bijdrage te leveren aan deze bundel is eigenlijk heel indiscreet."
                            }
                        ]
                    },
                    {
                        "sense_id": "467d41c7-51dc-3b5f-bcf3-6517aa0aa0a4",
                        "entry_id": "46d55551-44c8-3441-95ba-45097ec6f5c5",
                        "glosses": [
                            "ongepast, niet netjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7adf3b-b36b-4bc3-bd75-e7a0bc375e79",
                                "sense_id": "467d41c7-51dc-3b5f-bcf3-6517aa0aa0a4",
                                "text": "Door de blik van Danaë op het licht van de naderende Zeus te richten, kwam zij volgens Bal in een positie te liggen die haar bevrijdde van indiscreet voyeurisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "70762c7f-858f-31ca-88b2-3295f7e8a8f5",
                        "entry_id": "46d55551-44c8-3441-95ba-45097ec6f5c5",
                        "glosses": [
                            "inbreuk makend op vertrouwelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0836bbd3-f21a-477b-b30f-b21de1eedd5a",
                                "sense_id": "70762c7f-858f-31ca-88b2-3295f7e8a8f5",
                                "text": "De brief die Otto zo indiscreet had ingezien, was vermoedelijk eveneens afkomstig van zijn tante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf890802-e667-40ee-853f-5ebb24e6b7a9",
                        "source_entry_id": "46d55551-44c8-3441-95ba-45097ec6f5c5",
                        "target_lang_word": "meddlesome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meddlesome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4968ed32-5abf-347e-950b-b62b4f6cc71a",
                                        "entry_id": "8b9d030c-ed29-39c9-87b3-f6e673fbff4e",
                                        "glosses": [
                                            "Characterized or marked by meddling; inclined or having a tendency to meddle or interfere in other people's business."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3338e9a-d22a-4324-bee8-35580bf69c2d",
                                                "sense_id": "4968ed32-5abf-347e-950b-b62b4f6cc71a",
                                                "text": "As this was well before the meddlesome days in which we now live, can Mr. Cox explain why this plan was never carried out?"
                                            },
                                            {
                                                "example_id": "4740df2e-43e4-4c3d-9bc5-125ee24e50df",
                                                "sense_id": "4968ed32-5abf-347e-950b-b62b4f6cc71a",
                                                "text": "The help tended to be officious, the rules, if heeded, restrictive, and the management meddlesome."
                                            },
                                            {
                                                "example_id": "7b20dc39-5971-45d5-a33c-bcda79d54d68",
                                                "sense_id": "4968ed32-5abf-347e-950b-b62b4f6cc71a",
                                                "text": "If those meddlesome kids hadn't turned me in, I'd have gotten away with my nefarious scheme!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2316ba90-5ab7-46bd-be12-88cf1874d876",
                        "source_entry_id": "46d55551-44c8-3441-95ba-45097ec6f5c5",
