                "senses": [
                    {
                        "sense_id": "53cc2342-d3ca-3bd5-8d43-600964ad5928",
                        "entry_id": "995f6fed-fc79-3467-b1fe-13e3a0749468",
                        "glosses": [
                            "Wettstreit, Auseinandersetzung zwischen Rivalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8236919d-f636-470d-9e93-43f6a40cd4be",
                                "sense_id": "53cc2342-d3ca-3bd5-8d43-600964ad5928",
                                "text": "„Wie damals der Kampf zwischen Weiß und Rot, so tobt jetzt der Rivalitätskampf zwischen der Ruhrpolen-Gruppe um Paczkowiak und der um Weselowski.“"
                            },
                            {
                                "example_id": "793b03a9-7960-44ef-8524-e850f6ed2668",
                                "sense_id": "53cc2342-d3ca-3bd5-8d43-600964ad5928",
                                "text": "„In diesem Jahr sind die Spannungen besonders gross, weil sich zwei Gewerkschaften einen Rivalitätskampf liefern: die etablierte und bis vor kurzem einzige Gewerkschaft, National Union of Mineworkers (NUM), und die von NUM-Abtrünnigen gegründete Association of Mineworkers and Construction Union (Amcu).“"
                            },
                            {
                                "example_id": "962f4be0-c6ea-48c2-a0cd-36b52e3dd1a4",
                                "sense_id": "53cc2342-d3ca-3bd5-8d43-600964ad5928",
                                "text": "„Da glänzende Farben für die Männchen in ihrem Rivalitätskampfe mit andern Männchen von Nutzen sind, so werden derartige Farben bei der Zuchtwahl berücksichtigt, mögen sie nun ausschließlich auf das männliche Geschlecht beschränkt überliefert werden oder nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
