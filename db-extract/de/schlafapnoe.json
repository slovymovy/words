                        "target_lang_word": "apnée du sommeil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apnée du sommeil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab3a27b6-cc04-305e-81c0-c25617b24607",
                                        "entry_id": "40dcec8b-ab74-3e8c-84a1-f24135970509",
                                        "glosses": [
                                            "Affection caractérisée par une obstruction des voies respiratoires durant le sommeil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af747292-2758-41ba-85b2-ce685ab1e1ce",
                                                "sense_id": "ab3a27b6-cc04-305e-81c0-c25617b24607",
                                                "text": "L'apnée du sommeil est appelée le syndrome d'apnées-hypopnées obstructives du sommeil (SAHOS), auparavant dénommé le syndrome des apnées obstructives du sommeil (SAOS). Ce syndrome se caractérise par la survenue d’épisodes anormalement fréquents d’interruptions (apnées) ou de réductions (hypopnées) de la respiration durant le sommeil. Ces pauses de respiration durent de 10 à 30 secondes, voire plus, se produisent au moins 5 fois par heure de sommeil et peuvent se répéter une centaine de fois par nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
