                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c2cd11-474f-4f89-9031-4f052a6a49de",
                                                "sense_id": "5aaf423a-cdf2-3a1d-a409-a1272211319d",
                                                "text": "The dog was a rescue with some behavior issues."
                                            }
