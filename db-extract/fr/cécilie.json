                                        "entry_id": "4317243e-5491-3ee4-8b2a-8ffab378a6fa",
                                        "glosses": [
                                            "Any of a group of burrowing amphibians of the order Gymnophiona that resemble earthworms or snakes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b51fc9ba-c3a0-46a3-915f-14f35b90c4ac",
                                                "sense_id": "61cab438-ef36-33ae-b80f-bdf67c8a9e12",
                                                "text": "Today we have just three major lineages of amphibians - the anurans (frogs and toads), the newts and salamanders, and the worm-like caecilians, all of which can trace their ancestry back to long before the dinosaurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
