                    {
                        "translation_id": "36c623c3-3990-4939-94fc-0aa6ea125b82",
                        "source_entry_id": "fe1c25aa-ea44-37ef-af37-0fe884a1b8f8",
                        "source_sense_id": "13b3d2b6-72f7-3717-b1b7-aba70212ecb9",
                        "source_sense_description": "Zoologie: Meeressäugetier, der in den Ozeanen lebt; wissenschaftlich: Balaenoptera musculus",
                        "target_lang_word": "baleine bleue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baleine bleue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fdc7b10-5f57-3859-9645-6badd764511a",
                                        "entry_id": "a73c4a9a-a21c-32ae-b801-31dec6f39da0",
                                        "glosses": [
                                            "Espèce de baleine énorme, le plus gros animal vivant au XXIᵉ siècle, longue et mince, pouvant prendre diverses teintes de gris-bleuté sur le dos, qui se nourrit presque exclusivement de krill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d97abc-aa3f-4d85-a2a7-31198c7879b4",
                                                "sense_id": "1fdc7b10-5f57-3859-9645-6badd764511a",
                                                "text": "La baleine bleue avait en effet surgi assez près du destroyer dans un tumultueux bouillonnement d’écume, alors que ses agresseurs l’attendaient beaucoup plus loin."
                                            },
                                            {
                                                "example_id": "e16f1600-3e7a-45f4-aedb-8141d80f7187",
                                                "sense_id": "1fdc7b10-5f57-3859-9645-6badd764511a",
                                                "text": "Parmi la vingtaine d’espèces de cétacés, d’un poids qui va de 2,5 à 7 tonnes pour l’orque à 150 tonnes pour la baleine bleue, seules quelques espèces sont toujours prisées."
                                            },
                                            {
                                                "example_id": "1faf8b50-e874-41ee-ac74-b21a1a214569",
                                                "sense_id": "1fdc7b10-5f57-3859-9645-6badd764511a",
                                                "text": "Contrairement à une idée reçue, ce ne sont pas les monstres de Jurassic Park qui détiennent les records de poids, mais un animal actuel et paisible de nos océans : la Baleine bleue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
