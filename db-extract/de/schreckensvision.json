                        "examples": [
                            {
                                "example_id": "95687d9c-40bb-40a6-a3a1-f47138bab745",
                                "sense_id": "7acfedd5-e2f9-3567-ab70-2dc559f60248",
                                "text": "„Ich habe plötzlich eine Schreckensvision.“"
                            },
                            {
                                "example_id": "f9b48420-9bc4-49ef-86be-87443b11df12",
                                "sense_id": "7acfedd5-e2f9-3567-ab70-2dc559f60248",
                                "text": "„Was nun kam, hatte Perlmann so oft als Schreckensvision vor sich gesehen, daß es vom vielen Vorstellen gleichsam abgenutzt war.“"
                            },
                            {
                                "example_id": "90f399da-d2aa-4a52-9332-684b1de0ca3d",
                                "sense_id": "7acfedd5-e2f9-3567-ab70-2dc559f60248",
                                "text": "„Aber – als ihm die Schreckensvision aufgestiegen war, wie ein roter Blitz sein Hirn durchleuchtend, da mußte er's niederschreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
