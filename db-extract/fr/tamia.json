        "fr-extract.jsonl": [
            {
                "entry_id": "a6559b8b-2e20-39dc-98e2-7e5a33c71e17",
                "word": "tamia",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d229008c-de6d-4b1b-a971-4723532a4dbd",
                        "entry_id": "a6559b8b-2e20-39dc-98e2-7e5a33c71e17",
                        "tags": [
                            "plural"
                        ],
                        "form": "tamias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a00cea1e-9e3d-3eb2-ac2c-6e13f33372ff",
                        "entry_id": "a6559b8b-2e20-39dc-98e2-7e5a33c71e17",
                        "glosses": [
                            "Petit mammifère de la famille des écureuils (genre scientifique Tamias)."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "463c7bdc-6f84-4087-aafd-8c57f1f049c8",
                                "sense_id": "a00cea1e-9e3d-3eb2-ac2c-6e13f33372ff",
                                "text": "[…] soit elle trouva que Stray offrait un changement assez rafraîchissant, soit elle était aussi étourdie qu’un tamia."
                            },
                            {
                                "example_id": "1d3177ee-d7a0-493f-b101-d750b5f9bc1b",
                                "sense_id": "a00cea1e-9e3d-3eb2-ac2c-6e13f33372ff",
                                "text": "J’ai tiré le traîneau qui raclait et heurtait le sol, faisant un vacarme d’enfer et je ne voyais pas de gibier, que des tamias, des sittelles, des corneilles, des écureuils en alerte qui discouraient dans les cimes (…)."
                            },
                            {
                                "example_id": "075cfba2-e48d-4c82-884f-c2761b4f565f",
                                "sense_id": "a00cea1e-9e3d-3eb2-ac2c-6e13f33372ff",
                                "text": "Sénart est aussi riche en micromammifères et notamment en tamias (Tamias sibiricus barberi), un écureuil originaire d’Asie. Vendus dans les animaleries, les tamias qui se sont échappés ou ont été relâchés par leurs propriétaires sont désormais bien implantés dans certaines forêts françaises."
                            },
                            {
                                "example_id": "30c8c786-e041-42df-88d9-1776a5ee35a6",
                                "sense_id": "a00cea1e-9e3d-3eb2-ac2c-6e13f33372ff",
                                "text": "Les cachettes des petits mammifères comme les tamias et les écureuils jouent aussi un rôle important dans la propagation des graines de pins, même lorsque celles-ci ont déjà été dispersées par le vent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8aba0f0-c10d-4624-a8b6-b18cb6bc1709",
                        "source_entry_id": "a6559b8b-2e20-39dc-98e2-7e5a33c71e17",
                        "source_sense_id": "a00cea1e-9e3d-3eb2-ac2c-6e13f33372ff",
