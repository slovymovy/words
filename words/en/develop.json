{
    "word_family": [
        "development",
        "developer",
        "redevelopment",
        "underdevelopment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0152f67-58ca-3d97-9e2d-189d46509833",
                    "sense_definition": "To create or invent something new, such as a new product, idea, plan, or system.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>develop</w> a detailed plan for the project by next week.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>разработать</w> детальный план проекта к следующей неделе.",
                                "zh": "我需要在下周前为这个项目<w>制定</w>一份详细的计划。"
                            }
                        },
                        {
                            "text": "The company wants to <w>develop</w> software that helps people learn languages faster.",
                            "target_lang_translations": {
                                "ru": "Компания хочет <w>разработать</w> программное обеспечение, которое поможет людям быстрее изучать языки.",
                                "zh": "这家公司想要<w>开发</w>一款能帮助人们更快学习语言的软件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "create",
                        "invent",
                        "design",
                        "produce",
                        "formulate",
                        "devise",
                        "work out"
                    ],
                    "common_phrases": [
                        "develop a plan",
                        "develop a strategy",
                        "develop a product",
                        "develop software",
                        "develop a theory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать или изобретать что-то новое, например, новый продукт, идею, план или систему.",
                        "zh": "创造或发明新事物，例如新产品、想法、计划或系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрабатывать",
                                "target_lang_sense_clarification": "создавать план, систему, продукт"
                            },
                            {
                                "target_lang_word": "создавать",
                                "target_lang_sense_clarification": "творить, делать новым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开发",
                                "target_lang_sense_clarification": "用于产品、软件、资源等"
                            },
                            {
                                "target_lang_word": "制定",
                                "target_lang_sense_clarification": "用于计划、策略等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6075c229-a671-314e-a26e-2a050138fa73",
                    "sense_definition": "To grow or change over a period of time and become more advanced, larger, or stronger.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "growth_intransitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small storm quickly <w>developed</w> into a dangerous hurricane.",
                            "target_lang_translations": {
                                "ru": "Небольшой шторм быстро <w>развился</w> в опасный ураган.",
                                "zh": "那场小风暴很快<w>发展</w>成了危险的飓风。"
                            }
                        },
                        {
                            "text": "Let's wait and see how the situation <w>develops</w> before we make a decision.",
                            "target_lang_translations": {
                                "ru": "Давайте подождем и посмотрим, как будет <w>развиваться</w> ситуация, прежде чем принимать решение.",
                                "zh": "我们先等等看情况如何<w>发展</w>，再做决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grow",
                        "evolve",
                        "mature",
                        "progress",
                        "unfold"
                    ],
                    "antonyms": [
                        "decline",
                        "wither"
                    ],
                    "common_phrases": [
                        "develop into",
                        "develop rapidly",
                        "develop slowly",
                        "begin to develop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расти или изменяться с течением времени, становясь более продвинутым, крупным или сильным.",
                        "zh": "随时间推移而成长或变化，变得更先进、更大或更强。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развиваться",
                                "target_lang_sense_clarification": "расти, прогрессировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发展",
                                "target_lang_sense_clarification": "事物演变、成长"
                            },
                            {
                                "target_lang_word": "演变",
                                "target_lang_sense_clarification": "逐渐变化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0184a9db-e6d7-36cf-ab94-5bdd9e5970cd",
                    "sense_definition": "To improve something or make it bigger, more active, or more advanced.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "growth_transitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reading every day helps children <w>develop</w> their vocabulary and language skills.",
                            "target_lang_translations": {
                                "ru": "Ежедневное чтение помогает детям <w>развивать</w> словарный запас и языковые навыки.",
                                "zh": "每天阅读有助于孩子们<w>培养</w>词汇量和语言能力。"
                            }
                        },
                        {
                            "text": "The government is trying to <w>develop</w> the economy by attracting new businesses.",
                            "target_lang_translations": {
                                "ru": "Правительство пытается <w>развивать</w> экономику, привлекая новые предприятия.",
                                "zh": "政府正试图通过吸引新企业来<w>发展</w>经济。"
                            }
                        }
                    ],
                    "synonyms": [
                        "improve",
                        "enhance",
                        "expand",
                        "boost",
                        "cultivate"
                    ],
                    "antonyms": [
                        "hinder",
                        "stunt"
                    ],
                    "common_phrases": [
                        "develop skills",
                        "develop potential",
                        "develop the economy",
                        "develop resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать что-либо, делать это больше, активнее или совершеннее.",
                        "zh": "改进某事物，使其规模更大、更活跃或更先进。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "улучшать навыки, экономику"
                            },
                            {
                                "target_lang_word": "совершенствовать",
                                "target_lang_sense_clarification": "улучшать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "培养",
                                "target_lang_sense_clarification": "用于技能、能力、兴趣等"
                            },
                            {
                                "target_lang_word": "发展",
                                "target_lang_sense_clarification": "用于经济、事业等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c58ed9d-0698-3c58-940c-c0fb56e14b63",
                    "sense_definition": "To begin to have something, such as a disease, problem, habit, or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you eat too much sugar, you might <w>develop</w> health problems later in life.",
                            "target_lang_translations": {
                                "ru": "Если есть слишком много сахара, в будущем у вас могут <w>появиться</w> проблемы со здоровьем.",
                                "zh": "如果你糖吃得太多，以后可能会<w>患上</w>健康问题。"
                            }
                        },
                        {
                            "text": "She <w>developed</w> a strong interest in painting after visiting the art museum.",
                            "target_lang_translations": {
                                "ru": "У нее <w>появился</w> сильный интерес к живописи после посещения художественного музея.",
                                "zh": "参观完美术馆后，她对绘画<w>产生了</w>浓厚的兴趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acquire",
                        "contract",
                        "get",
                        "form"
                    ],
                    "common_phrases": [
                        "develop a habit",
                        "develop cancer",
                        "develop symptoms",
                        "develop an interest",
                        "develop a relationship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать иметь что-то, например, болезнь, проблему, привычку или чувство.",
                        "zh": "开始患上某种疾病，或养成某种习惯、产生某种感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приобретать",
                                "target_lang_sense_clarification": "получать (болезнь, привычку)"
                            },
                            {
                                "target_lang_word": "вырабатывать",
                                "target_lang_sense_clarification": "формировать привычку"
                            },
                            {
                                "target_lang_word": "появляться",
                                "target_lang_sense_clarification": "возникать (о симптомах, интересе)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "养成",
                                "target_lang_sense_clarification": "用于习惯"
                            },
                            {
                                "target_lang_word": "产生",
                                "target_lang_sense_clarification": "用于兴趣、感觉"
                            },
                            {
                                "target_lang_word": "患上",
                                "target_lang_sense_clarification": "用于疾病"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "664e90a9-5b4f-3153-bc86-cefbb40c5af4",
                    "sense_definition": "To treat photographic film with chemicals to make the pictures visible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to find a shop that can <w>develop</w> this old roll of film.",
                            "target_lang_translations": {
                                "ru": "Мне нужно найти магазин, который сможет <w>проявить</w> эту старую катушку пленки.",
                                "zh": "我得找一家能<w>冲洗</w>这卷旧胶片的店。"
                            }
                        },
                        {
                            "text": "In the past, photographers had to <w>develop</w> their photos in a darkroom.",
                            "target_lang_translations": {
                                "ru": "В прошлом фотографам приходилось <w>проявлять</w> свои фотографии в темной комнате.",
                                "zh": "过去，摄影师必须在暗房里<w>冲洗</w>照片。"
                            }
                        }
                    ],
                    "synonyms": [
                        "process"
                    ],
                    "common_phrases": [
                        "develop film",
                        "develop photos",
                        "develop pictures"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать фотопленку химикатами, чтобы сделать снимки видимыми.",
                        "zh": "用化学药品处理摄影胶片，使影像显现出来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявлять",
                                "target_lang_sense_clarification": "фотографии, пленку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲洗",
                                "target_lang_sense_clarification": "用于胶片、照片"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}