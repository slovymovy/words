                ],
                "senses": [
                    {
                        "sense_id": "bfa17ad0-4313-3923-83da-d651ba25fe89",
                        "entry_id": "0537c715-47c5-3279-bc5f-99e7bff73aa5",
                        "glosses": [
                            "Défaire la ceinture de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69fdc57f-2434-43cb-ba27-f87d69fd5696",
                                "sense_id": "bfa17ad0-4313-3923-83da-d651ba25fe89",
                                "text": "Une bonne cinquantaine de passagers doivent encore se débarrasser de leurs sacs, clés, bijoux, portables, se déchausser, se déceinturer, se débijouter, avant que ce soit notre tour."
                            },
                            {
                                "example_id": "e7101a28-c09d-4e4a-9f9f-a9b50fa1b9a7",
                                "sense_id": "bfa17ad0-4313-3923-83da-d651ba25fe89",
                                "text": "Son premier cep l’émut : quand elle fit sauter le lien de paille, elle eut l’impression de déceinturer une fille, après quoi, écartant les sarments, porteurs de grappes, fourrageant entre les grosses feuilles cuirassées de sulfate, elle eut la sensation gênante de violer de ses propres mains et de fouiller elle ne savait quels ovaires dont elle ramenait les fruits, qui roulaient entre ses doigts, avant de chuter au fond du panier."
                            },
                            {
                                "example_id": "003c07af-a0ba-467a-a209-ed071a0d0772",
                                "sense_id": "bfa17ad0-4313-3923-83da-d651ba25fe89",
                                "text": "Planant dans les airs, tout le monde s’affairait à se « déceinturer » comme il avait coutume de dire, lui qui ne comptait plus ses voyages aériens aux différents coins de la planète."
                            }
                        ]
                    }
                ],
