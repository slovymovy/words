                    "frequency": "High",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'élève a préféré <w>simuler</w> une maladie pour éviter de passer son examen de mathématiques."
                        },
