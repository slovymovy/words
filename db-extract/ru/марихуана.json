                "senses": [
                    {
                        "sense_id": "dd39f9f8-b805-31e9-8777-42b7893faa37",
                        "entry_id": "28d9a3ae-0ba4-3bbc-994b-479abb35bacd",
                        "glosses": [
                            "высушенные зелёные части индийской конопли; лёгкий наркотик, употребляемый курением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a469a14-fca3-40ea-a76e-b57127a7528d",
                                "sense_id": "dd39f9f8-b805-31e9-8777-42b7893faa37",
                                "text": "Полынное масло близко по действию к вытяжке из индийской конопли, из которой делают гашиш и марихуану."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb492285-65f6-42af-bd7d-c57f91048057",
                        "source_entry_id": "28d9a3ae-0ba4-3bbc-994b-479abb35bacd",
                        "source_sense_id": "dd39f9f8-b805-31e9-8777-42b7893faa37",
                        "target_lang_word": "marijuana",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marijuana",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa65ff0-65e7-322b-a384-d551c5221f5f",
                                        "entry_id": "fad35968-74cf-3818-85a1-90a9b4ebc5f8",
                                        "glosses": [
                                            "The inflorescence of the Cannabis sativa plant, smoked or ingested for euphoric effect."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79aa8bf8-ee1a-4a89-a2fc-23d6fe2d016a",
                                                "sense_id": "2fa65ff0-65e7-322b-a384-d551c5221f5f",
                                                "text": "After smoking a bowl of that fine marijuana, they ate some brownies."
                                            },
                                            {
                                                "example_id": "46a51706-779d-43b2-a616-073d501f8acb",
                                                "sense_id": "2fa65ff0-65e7-322b-a384-d551c5221f5f",
                                                "text": "You could smell tea, weed, I mean marijuana, floating in the air, together with the chili beans and beer."
                                            },
                                            {
                                                "example_id": "36967fe7-fe82-440d-bd31-ec0fd22df736",
                                                "sense_id": "2fa65ff0-65e7-322b-a384-d551c5221f5f",
                                                "text": "Exactly. Marijuana is something we just all gradually decided is okay, like Mark Wahlberg as a serious actor. “You know what? Sure, I’ve decided I’m fine with that.”"
                                            },
                                            {
                                                "example_id": "b083de26-7613-4a49-b163-08024c7e4efb",
                                                "sense_id": "2fa65ff0-65e7-322b-a384-d551c5221f5f",
                                                "text": "Sunday is 420 day, when lovers of marijuana get together to celebrate their fondness for weed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fd52995-a2e2-3b91-8da9-272dd507c8bb",
                                        "entry_id": "fad35968-74cf-3818-85a1-90a9b4ebc5f8",
                                        "glosses": [
                                            "The hemp plant itself, Cannabis sativa."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "621b2137-cd4c-49e9-aa90-851aa4f69e22",
                        "source_entry_id": "28d9a3ae-0ba4-3bbc-994b-479abb35bacd",
                        "source_sense_id": "dd39f9f8-b805-31e9-8777-42b7893faa37",
                        "target_lang_word": "cannabis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cannabis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e29bd705-3c27-3bb0-a722-43cce9cc70cf",
                                        "entry_id": "49ae35e0-9532-3364-811f-db67783dfbb1",
                                        "glosses": [
                                            "A tall annual dioecious plant (Cannabis, especially Cannabis sativa), native to central Asia and having alternate, palmately divided leaves and tough bast fibers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44356fb0-4144-324c-b77c-55cb69777d2e",
                                        "entry_id": "49ae35e0-9532-3364-811f-db67783dfbb1",
                                        "glosses": [
                                            "A mildly euphoriant or sedating, intoxicating hallucinogenic drug prepared from various parts of this plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dbfed27-f60c-4cd8-b083-ac64c4ba4161",
                                                "sense_id": "44356fb0-4144-324c-b77c-55cb69777d2e",
                                                "text": "Cannabis use disorder is usually defined as a problematic use of the drug: developing tolerance to weed; using cannabis in larger amounts or over a longer period than intended; being unable to reduce use; spending a lot of time obtaining, using or recovering from the effects of cannabis; giving up important activities and obligations in favor of cannabis; and continued use of the drug despite negative consequences."
                                            },
                                            {
                                                "example_id": "d11cb428-43d6-4bef-96de-45faba5ecef0",
                                                "sense_id": "44356fb0-4144-324c-b77c-55cb69777d2e",
                                                "text": "We determined that the car driver’s transportation of multiple teen passengers, limited driving experience, and likely impairment from effects of cannabis at the time of the crash adversely affected her judgment of the danger of entering the intersection in front of the approaching combination vehicle."
                                            },
                                            {
                                                "example_id": "edd94909-07cc-4fdf-8c8f-94b88e7941c2",
                                                "sense_id": "44356fb0-4144-324c-b77c-55cb69777d2e",
                                                "text": "We found that teen drivers and the public largely misunderstand the legal status of cannabis use and do not fully recognize the risks of cannabis-impaired driving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88d1b728-1c9c-3915-812d-c0dc7174ceed",
                                        "entry_id": "49ae35e0-9532-3364-811f-db67783dfbb1",
                                        "glosses": [
                                            "The purified and decarboxylated resin of the cannabis plant used for medicinal purposes rather than for any intoxicating effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ed8a482-6814-4106-b176-c0ecff92115b",
                        "source_entry_id": "28d9a3ae-0ba4-3bbc-994b-479abb35bacd",
                        "source_sense_id": "dd39f9f8-b805-31e9-8777-42b7893faa37",
                        "target_lang_word": "Marihuana",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marihuana",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e901ac4-2370-3841-a94c-aa9ec9f0fef1",
                                        "entry_id": "fdc25385-4c2b-3cb2-9837-c18dca1158db",
                                        "glosses": [
                                            "Rauschgift in Form von getrockneten Blüten (manchmal auch mit anhängenden Blättchen) der Cannabispflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72bf2e7f-28aa-4c5d-9030-3e67236395d5",
                                                "sense_id": "5e901ac4-2370-3841-a94c-aa9ec9f0fef1",
                                                "text": "Ihr Sohn rauchte Marihuana auf dieser Party!"
                                            },
                                            {
                                                "example_id": "eb8727e6-d952-44d5-b483-fa7a7f24cd3b",
                                                "sense_id": "5e901ac4-2370-3841-a94c-aa9ec9f0fef1",
                                                "text": "Das Inhalieren von Rauch mit Rückständen von Marihuana erhöht die Wahrscheinlichkeit, an Krebs im Bereich des Kopfes und Halses zu erkranken."
                                            },
                                            {
                                                "example_id": "ca5c76a7-a933-4cee-8160-f993e757a588",
                                                "sense_id": "5e901ac4-2370-3841-a94c-aa9ec9f0fef1",
                                                "text": "Marihuana schafft Erleichterung bei der Krebstherapie."
                                            },
                                            {
                                                "example_id": "eaa6d8c2-0447-4630-843b-d236764e707f",
                                                "sense_id": "5e901ac4-2370-3841-a94c-aa9ec9f0fef1",
                                                "text": "„Ich wusste, dass Amalia hin und wieder kiffte und der Meinung war, dass man das Rauchen von Marihuana legalisieren sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
