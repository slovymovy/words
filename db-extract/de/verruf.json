                                    {
                                        "sense_id": "b8d41600-93f6-33b0-ba89-7a2452a516de",
                                        "entry_id": "4cd2293a-8948-3404-8cc6-3f2cc2bd879b",
                                        "glosses": [
                                            "Lack of reverence or esteem; poor reputation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f7024a7-81d7-4d62-96b8-1805287b2ba5",
                                                "sense_id": "b8d41600-93f6-33b0-ba89-7a2452a516de",
                                                "text": "The people of the southeasterly clusters—concerning whom, however, but little is known—have a bad name as cannibals; and for that reason their hospitality is seldom taxed by the mariner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ec9377-83db-30fd-8ed3-ccf66e4e0316",
                                        "entry_id": "4cd2293a-8948-3404-8cc6-3f2cc2bd879b",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see bad, name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9488a8b1-48aa-4a4e-a4f8-fe5f56648868",
                                                "sense_id": "86ec9377-83db-30fd-8ed3-ccf66e4e0316",
                                                "text": "Angina is a bad name to give to your child."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23460068-78c9-48ae-818a-dcef0fd2f1f7",
