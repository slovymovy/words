                        "glosses": [
                            "Spiritisme inspiré par l’œuvre d'Allan Kardec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db94a2bf-b8c4-4b90-b210-be691519f3f1",
                                "sense_id": "54562b9a-4e5a-366b-b1e1-f9caa2e91a46",
                                "text": "C'est pourquoi, tout en étant un « spiritisme », Umbanda tranche si fortement sur le kardécisme."
                            },
                            {
                                "example_id": "25ef13fe-6a2d-457c-a14d-0e679c6f83dd",
                                "sense_id": "54562b9a-4e5a-366b-b1e1-f9caa2e91a46",
                                "text": "Je crains que , dès vos premiers pas dans cette heureuse et brillante carrière, vous ne tombiez , comme plusieurs de vos amis , dans le Kardécisme. Je sais que M. Allan-Kardec et ses associés veulent me faire passer pour un schismatique, tandis que j'ai la prétention d\"être parfaitement orthodoxe."
                            }
                        ]
                    }
