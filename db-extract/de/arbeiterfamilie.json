                "senses": [
                    {
                        "sense_id": "f4d4a5ac-26f5-3b8c-9430-68f2ea3cbffe",
                        "entry_id": "2c6d4722-3a28-3582-955d-0f16e4ce14d3",
                        "glosses": [
                            "eine Familie, in der der Vater (und eventuell auch die Mutter) den Lebensunterhalt mit körperlicher Arbeit verdienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ce6bc72-0de4-41d3-8052-5623a65ef1d6",
                                "sense_id": "f4d4a5ac-26f5-3b8c-9430-68f2ea3cbffe",
                                "text": "Er stammt aus einer klassischen Arbeiterfamilie."
                            },
                            {
                                "example_id": "f73baf4d-7a93-4fde-b1b9-0d59dd601a28",
                                "sense_id": "f4d4a5ac-26f5-3b8c-9430-68f2ea3cbffe",
                                "text": "[…] 55 Prozent der Kinder aus einer Familie der \"oberen Dienstklasse\" besuchen […] das Gymnasium, aber nur 24,4 Prozent der Kinder aus Arbeiterfamilien."
                            },
                            {
                                "example_id": "2f40be43-b1dc-43d0-b2eb-4f9ab000d135",
                                "sense_id": "f4d4a5ac-26f5-3b8c-9430-68f2ea3cbffe",
                                "text": "„Hinter der Käserei wird sie abgebogen sein, um entlang der Getreidespeicher zu den Insthäusern am Ufer des Alle-Stausees zu gelangen, in denen die Arbeiterfamilien untergebracht waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
