                "senses": [
                    {
                        "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                        "entry_id": "2ca5ad57-9516-3ebe-80a5-abf68e6648fb",
                        "glosses": [
                            "weibliche Person, die etwas beaufsichtigt oder bewacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44031595-53f8-44d5-8d94-0af26ac3ae07",
                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                "text": "Die Wärterinnen waren alle eingeschlafen."
                            },
                            {
                                "example_id": "c40264f9-b1ae-4dd8-8990-b2be7770ea03",
                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                "text": "„Einmal will die Wärterin für ihre illegalen Kurierdienste 800, mal 600 Euro g ihres Geliebten Informationen aus dem justizinternen EDV-System gezogen haben.“"
                            },
                            {
                                "example_id": "0b9036d8-d77d-436d-bf65-97b9881e920f",
                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                "text": "„Die Affäre flog auf, weil andere Insassen die Wärterin anzeigten.“"
                            },
                            {
                                "example_id": "04905a22-0533-494a-9644-87567e00b1ce",
                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                "text": "„Die Wärterin hat den Hut gerettet und marschiert nun auf ihren breiten Sohlen heran wie das Schicksal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
