                ],
                "senses": [
                    {
                        "sense_id": "5b245bd6-34c5-3af1-ac9c-dc4b108d96f9",
                        "entry_id": "340f71d7-1225-3e76-be3a-47c097d4c32c",
                        "glosses": [
                            "Rendre moins commode."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b725810-b4d0-4c83-a3b6-2119c6f14af3",
                                "sense_id": "5b245bd6-34c5-3af1-ac9c-dc4b108d96f9",
                                "text": "Alors justement pourquoi désacommoder la vie d'environ 6 millions 800 milles personnes de toutes origines pour accommoder certains groupes religieux extrémistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d1ce60f-f13d-301c-8879-931ee4e9bb28",
                        "entry_id": "340f71d7-1225-3e76-be3a-47c097d4c32c",
                        "glosses": [
                            "Ne plus accommoder, en parlant des yeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b3d4b3-c002-4146-98cd-b6169ac18d91",
                                "sense_id": "0d1ce60f-f13d-301c-8879-931ee4e9bb28",
                                "text": "Au contraire maintenant qu'il utilise sa nouvelle paire de progressifs, il doit légèrement désacommoder (0,25 d )."
                            },
                            {
                                "example_id": "6b6f316b-7e8f-42f7-901e-32ef1413c97b",
                                "sense_id": "0d1ce60f-f13d-301c-8879-931ee4e9bb28",
                                "text": "Dans le pire des cas, après une longue période sans les porter, il peut vous arriver d'avoir un petit effet de tangage le temps que l'oeil désacommode."
                            }
                        ]
                    }
                ],
