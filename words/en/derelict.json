{
    "word_family": [
        "dereliction"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cdd3f463-cce4-3991-88dd-422c52bbea3b",
                    "sense_definition": "In a poor state due to abandonment or lack of care; dilapidated and neglected.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "neglected_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council plans to transform the <w>derelict</w> warehouse into a modern art museum.",
                            "target_lang_translations": {
                                "de": "Der Stadtrat plant, das <w>verfallene</w> Lagerhaus in ein modernes Kunstmuseum umzuwandeln."
                            }
                        },
                        {
                            "text": "Stray cats often find shelter inside the <w>derelict</w> houses on the edge of town.",
                            "target_lang_translations": {
                                "de": "Streunende Katzen finden oft Zuflucht in den <w>verwahrlosten</w> Häusern am Stadtrand."
                            }
                        }
                    ],
                    "synonyms": [
                        "dilapidated",
                        "neglected",
                        "ramshackle",
                        "run-down"
                    ],
                    "common_phrases": [
                        "derelict building",
                        "derelict land",
                        "derelict warehouse",
                        "derelict factory"
                    ],
                    "target_lang_definitions": {
                        "de": "Aufgrund von Verlassenheit oder mangelnder Pflege in einem schlechten Zustand; baufällig und vernachlässigt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verfallen",
                                "target_lang_sense_clarification": "baufällig, im Zerfall begriffen"
                            },
                            {
                                "target_lang_word": "verwahrlost",
                                "target_lang_sense_clarification": "ungepflegt, vernachlässigt"
                            },
                            {
                                "target_lang_word": "heruntergekommen",
                                "target_lang_sense_clarification": "in schlechtem Zustand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce5b7f5b-e665-3029-a070-184386e8487d",
                    "sense_definition": "Abandoned or forsaken by the owner or guardian.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abandoned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They discovered a <w>derelict</w> ship drifting aimlessly several miles off the coast.",
                            "target_lang_translations": {
                                "de": "Sie entdeckten ein <w>verlassenes</w> Schiff, das einige Meilen vor der Küste ziellos trieb."
                            }
                        },
                        {
                            "text": "The explorer documented several <w>derelict</w> vehicles left behind in the desert.",
                            "target_lang_translations": {
                                "de": "Der Forscher dokumentierte mehrere <w>zurückgelassene</w> Fahrzeuge in der Wüste."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandoned",
                        "deserted",
                        "forsaken"
                    ],
                    "common_phrases": [
                        "derelict ship",
                        "derelict vessel"
                    ],
                    "target_lang_definitions": {
                        "de": "Vom Eigentümer oder Betreuer aufgegeben oder verlassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlassen",
                                "target_lang_sense_clarification": "von Menschen oder Besitzern aufgegeben"
                            },
                            {
                                "target_lang_word": "aufgegeben",
                                "target_lang_sense_clarification": "nicht weiter genutzt oder beansprucht"
                            },
                            {
                                "target_lang_word": "herrenlos",
                                "target_lang_sense_clarification": "ohne erkennbaren Besitzer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8717ee3f-ff99-3712-97c2-066a1877093c",
                    "sense_definition": "Failing to perform an obligation or duty; negligent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "negligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard was accused of being <w>derelict</w> in his duty after sleeping through his shift.",
                            "target_lang_translations": {
                                "de": "Dem Wachmann wurde vorgeworfen, <w>pflichtvergessen</w> gehandelt zu haben, nachdem er seine Schicht verschlafen hatte."
                            }
                        },
                        {
                            "text": "Officials who fail to enforce safety regulations are dangerously <w>derelict</w>.",
                            "target_lang_translations": {
                                "de": "Beamte, die Sicherheitsvorschriften nicht durchsetzen, handeln auf gefährliche Weise <w>pflichtwidrig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "careless",
                        "negligent",
                        "remiss"
                    ],
                    "common_phrases": [
                        "derelict in duty",
                        "derelict to duty"
                    ],
                    "target_lang_definitions": {
                        "de": "Einer Verpflichtung oder Pflicht nicht nachkommend; nachlässig oder pflichtwidrig."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "pflichtvergessen",
                                "target_lang_sense_clarification": "seine Pflichten schuldhaft vernachlässigend"
                            },
                            {
                                "target_lang_word": "nachlässig",
                                "target_lang_sense_clarification": "unachtsam bei Pflichten"
                            },
                            {
                                "target_lang_word": "pflichtwidrig",
                                "target_lang_sense_clarification": "gegen bestehende Pflichten verstoßend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f251727-13ff-34ba-ae42-67b5682d06d3",
                    "sense_definition": "Property, such as a building or ship, that has been deserted and left abandoned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abandoned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The abandoned tugboat was considered a hazardous <w>derelict</w> by the coast guard.",
                            "target_lang_translations": {
                                "de": "Das verlassene Schleppschiff wurde von der Küstenwache als gefährliches <w>Wrack</w> eingestuft."
                            }
                        },
                        {
                            "text": "Urban explorers entered the decaying <w>derelict</w> to take photographs of the interior.",
                            "target_lang_translations": {
                                "de": "Urban Explorer betraten die verfallende <w>Ruine</w>, um das Innere zu fotografieren."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein aufgegebener oder verlassener Gegenstand bzw. Eigentum, wie etwa ein verlassenes Gebäude oder ein Geisterschiff."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wrack",
                                "target_lang_sense_clarification": "verlassenes, meist beschädigtes Schiff oder Fahrzeug"
                            },
                            {
                                "target_lang_word": "Geisterschiff",
                                "target_lang_sense_clarification": "verlassenes Schiff auf See"
                            },
                            {
                                "target_lang_word": "Ruine",
                                "target_lang_sense_clarification": "verfallenes, verlassenes Gebäude"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed8c18cb-77f9-341c-b18a-6631a5670f1c",
                    "sense_definition": "A homeless or destitute person with no regular job or home; a vagrant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destitute_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local charities set up warm shelters to protect <w>derelicts</w> during the freezing winter.",
                            "target_lang_translations": {
                                "de": "Lokale Hilfsorganisationen richteten warme Notunterkünfte ein, um <w>Obdachlose</w> während des eisigen Winters zu schützen."
                            }
                        },
                        {
                            "text": "He lived as a penniless <w>derelict</w> on the railway platforms for many months.",
                            "target_lang_translations": {
                                "de": "Er lebte viele Monate lang als mittelloser <w>Landstreicher</w> auf den Bahnsteigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "drifter",
                        "hobo",
                        "tramp",
                        "vagrant"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine obdachlose, mittellose Person ohne festen Wohnsitz oder Arbeit; Landstreicher."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Obdachloser",
                                "target_lang_sense_clarification": "Person ohne festen Wohnsitz"
                            },
                            {
                                "target_lang_word": "Landstreicher",
                                "target_lang_sense_clarification": "umherziehende, wohnungslose Person"
                            },
                            {
                                "target_lang_word": "Gestrandeter",
                                "target_lang_sense_clarification": "gesellschaftlich abgestürzte Person"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5e8697b-02e3-3385-a9a0-0c292b8b13c3",
                    "sense_definition": "To abandon, neglect, or forsake something or someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abandoned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics questioned why the city chose to <w>derelict</w> the historic harbor facilities.",
                            "target_lang_translations": {
                                "de": "Kritiker fragten sich, warum die Stadt sich dazu entschied, die historischen Hafenanlagen <w>verfallen zu lassen</w>."
                            }
                        },
                        {
                            "text": "The developers were accused of deliberately <w>derelicting</w> the site before demolition.",
                            "target_lang_translations": {
                                "de": "Den Bauherren wurde vorgeworfen, das Gelände vor dem Abriss absichtlich <w>verwahrlosen gelassen</w> zu haben."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas oder jemanden aufgeben, vernachlässigen oder im Stich lassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufgeben",
                                "target_lang_sense_clarification": "aufhören, etwas zu erhalten oder zu pflegen"
                            },
                            {
                                "target_lang_word": "verwahrlosen lassen",
                                "target_lang_sense_clarification": "etwas vernachlässigen und verfallen lassen"
                            },
                            {
                                "target_lang_word": "verlassen",
                                "target_lang_sense_clarification": "im Stich lassen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}