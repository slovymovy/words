                    {
                        "translation_id": "58d2c47e-21de-4492-a030-5a452d4574ad",
                        "source_entry_id": "e2a2ec88-9ae5-3e6e-9782-2928952666b1",
                        "source_sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
                        "target_lang_word": "anthropocentrisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropocentrisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b48383ab-a4ce-3298-941b-0c130bc43872",
                                        "entry_id": "252ded68-6fb9-3959-ad53-2f69c0460fa8",
                                        "glosses": [
                                            "Doctrine implicite ou diffuse, dominante dans certaines cultures et époques, qui considère que l’humain est au centre de toute chose."
                                        ],
                                        "tags": [
                                            "Écologie politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48ef653b-3c1b-4331-a46e-f29bb5990dc2",
                                                "sense_id": "b48383ab-a4ce-3298-941b-0c130bc43872",
                                                "text": "Le darwinisme, on le sait, est affiché par Freud comme un moment capital de la pensée humaine, comme une des trois grandes révolutions détrônant l’homme de son anthropocentrisme, entre la révolution copernicienne qui détrône la terre de sa place centrale et la révolution freudienne qui détrône même l'âme humaine de sa centration puisqu'elle se trouve excentrée par rapport à son propre inconscient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32f959b4-24f9-41bc-b5dd-4c895f1bbdc2",
                        "source_entry_id": "e2a2ec88-9ae5-3e6e-9782-2928952666b1",
                        "source_sense_id": "de75b51a-778d-3b2a-b2dc-7c233e6be26e",
                        "target_lang_word": "antropocentrismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antropocentrismo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bbf899a1-e1e0-3524-a004-29bb216f7694",
                                        "entry_id": "a8b08f59-234f-3880-a6c3-1dc581ecfee7",
                                        "glosses": [
                                            "Doctrina y teoría filosófica que considera al hombre como centro del universo o medida de todas las cosas, siendo además la finalidad última de la naturaleza."
                                        ],
