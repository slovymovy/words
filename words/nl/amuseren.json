                                "target_lang_word": "enjoy oneself",
                                "target_lang_sense_clarification": "to take pleasure in an activity"
                            },
                            {
                                "target_lang_word": "have a good time",
                                "target_lang_sense_clarification": "to experience enjoyment or fun"
                            },
                            {
                                "target_lang_word": "amuse oneself",
                                "target_lang_sense_clarification": "to keep oneself occupied in a pleasant way"
