                "senses": [
                    {
                        "sense_id": "7db98e77-bec7-3a32-b7b5-062120f2c6b5",
                        "entry_id": "6b3dd31c-f995-31da-9749-6f81d4ee71d8",
                        "glosses": [
                            "blizzard, snowstorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7f1908-004a-4f7e-a4e4-e7eb6a07a4ef",
                                "sense_id": "7db98e77-bec7-3a32-b7b5-062120f2c6b5",
                                "text": "Ни конца нигде, ни края, в поле ночью не видать.\nВыла вьюга, как шальная.\nВ эту вьюгу шли два друга воевать.\nЗа тебя, земля родная,\nВ эту вьюгу шли два друга воевать.",
                                "translation": "No end, no edge anywhere in sight in the field at night.\nThe blizzard howled, like mad.\nIn this blizzard two friends went to fight.\nFor thee, dear homeland,\nIn this blizzard two friends went to fight.",
                                "english": "No end, no edge anywhere in sight in the field at night.\nThe blizzard howled, like mad.\nIn this blizzard two friends went to fight.\nFor thee, dear homeland,\nIn this blizzard two friends went to fight."
                            }
                        ]
                    }
