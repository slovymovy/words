                "senses": [
                    {
                        "sense_id": "f279f954-c7cf-3359-b9e2-462708662f4e",
                        "entry_id": "c4831bfb-6e8c-318a-b50b-05a46efdace8",
                        "glosses": [
                            "Musikstück, Film, Serie oder Ähnliches aus älterer Zeit – aber immer noch gerne oder zumindest hin und wieder angehört/angesehen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "48170f01-9e67-409c-8de6-ee8c90ad6eb3",
                                "sense_id": "f279f954-c7cf-3359-b9e2-462708662f4e",
                                "text": "Kannst du nochmal ein paar Oldies abspielen?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9bb238e2-c273-37dd-86a0-3423d0d7abb8",
                        "entry_id": "c4831bfb-6e8c-318a-b50b-05a46efdace8",
                        "glosses": [
                            "älterer Gegenstand wie zum Beispiel ein Fahrzeug, ein Möbelstück, ein technisches Gerät – mit einem gewissen nostalgischen Blickwinkel betrachtet"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c3bc74b5-d875-490c-b9da-0d0440bb4170",
                                "sense_id": "9bb238e2-c273-37dd-86a0-3423d0d7abb8",
                                "text": "„Neben den Bulldogs und den Oldies waren zudem auch noch betagte Motorräder zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f494cd8c-66f3-3624-ad1f-abce25828491",
                        "entry_id": "c4831bfb-6e8c-318a-b50b-05a46efdace8",
                        "glosses": [
                            "ältere Person – im Vergleich zu anderen"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "03e7d534-aafe-480d-8e36-c8d8c25df032",
                                "sense_id": "f494cd8c-66f3-3624-ad1f-abce25828491",
                                "text": "„Schon wenn Simon Ammann bei dieser 72. Vierschanzentournee oben auf der Schanze kurz vor dem Losfahren ist, brandet ein Jubel in Orkanstärke auf. […] Es sind diese Gänsehaut-Momente, für die der inzwischen 42-jährige Oldie das harte Training auf sich nimmt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
