                "senses": [
                    {
                        "sense_id": "6f0011e8-a6c3-3db3-82ef-b373da13f5f0",
                        "entry_id": "04f0c6da-f460-39f6-835e-3f7b565385b4",
                        "glosses": [
                            "Folie, die als Verpackung eines Gegenstandes verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31db226b-bc00-4e21-893a-1204711dc297",
                                "sense_id": "6f0011e8-a6c3-3db3-82ef-b373da13f5f0",
                                "text": "„Auch die Firma Tetra Pak setzt bei der Herstellung mancher Verpackungen auf Zuckerrohr. Und in den USA ist es Materialforschern gelungen, Verpackungsfolie aus Milch zu fertigen.“"
                            },
                            {
                                "example_id": "36ace658-2c98-4e07-b84b-1fb4ab72a9b5",
                                "sense_id": "6f0011e8-a6c3-3db3-82ef-b373da13f5f0",
                                "text": "„Also riss er die Verpackungsfolie auf und – stellte fest, dass er eine Bibel in der Hand hatte.“"
                            },
                            {
                                "example_id": "ed0ecda2-481c-44d7-937b-d7d61968ec66",
                                "sense_id": "6f0011e8-a6c3-3db3-82ef-b373da13f5f0",
                                "text": "„Aber als Geschäftsführer der Firma Nehlsen, eines mittelständischen Entsorgungsunternehmens mit Sitz im Bremer Hafen, sammelt Wilcken jedes Jahr 25.000 Tonnen Plastikabfälle ein. Meist Verpackungsfolien, von Discountern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
