                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a7cd1e5-de92-439b-9fab-1ede8bfadb66",
                                "sense_id": "c127e552-ded5-3244-a1da-b76e5dd93ecf",
                                "text": "„Das Dach ist eingestürzt, die schweren Balken liegen kreuz und quer, aber an den Wänden erkennt man noch die Kacheln, wo die Käse- oder die Fleischtheke war.“"
                            },
                            {
                                "example_id": "455e6163-bd95-4cf4-a171-3df3dce744af",
                                "sense_id": "c127e552-ded5-3244-a1da-b76e5dd93ecf",
                                "text": "„Der Hof der Firma ist sehr schlicht gehalten und im winzigen Verkaufsladen steht eine überschaubare Käsetheke.“"
                            },
                            {
                                "example_id": "efe75169-c4d9-42c5-b635-9a2e62db60c8",
                                "sense_id": "c127e552-ded5-3244-a1da-b76e5dd93ecf",
                                "text": "„Früher hatte es einen Gemüsehändler, einen Dorfladen mit Käsetheke, eine Bäckerei und eine Metzgerei gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
