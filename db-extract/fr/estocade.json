                                            },
                                            {
                                                "example_id": "751a5834-36a4-4a82-a1fc-30c403d6aed7",
                                                "sense_id": "d8e544af-ba09-3d2e-9379-e759a5cc9eb0",
                                                "text": "Ze leken geen van beiden erg te hebben in de leeuw, waarvan ook niet precies duidelijk was of hij wel of niet tot de aanval zou overgaan."
                                            },
                                            {
                                                "example_id": "d391a501-b8f9-4a8e-bf35-a4ed348cb5d5",
                                                "sense_id": "d8e544af-ba09-3d2e-9379-e759a5cc9eb0",
                                                "text": "Keer op keer deed de vlieg een aanval op haar neus, en hoewel ze hem telkens wegwuifde bleef hij met grote vasthoudendheid en niet-aflatende energie terugkomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b996d50d-ea53-388d-9384-bbff68c859ad",
                                        "entry_id": "5da0ec4f-f41f-328b-a805-dd2e53be69bf",
                                        "glosses": [
                                            "plotselinge, vaak kortstondige, aandoening bijv. een griepaanval, hartaanval etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3919db-b32f-41cf-942f-fb8b99eae75c",
                                                "sense_id": "b996d50d-ea53-388d-9384-bbff68c859ad",
                                                "text": "Tijdens het slaapverwekkende college kregen veel leerlingen last van een aanval van slaap."
                                            },
                                            {
                                                "example_id": "e0d53c7a-4894-4360-a4d2-5746abe07ec7",
                                                "sense_id": "b996d50d-ea53-388d-9384-bbff68c859ad",
                                                "text": "'Ik ben vanavond voor een kort wc- bezoek en verfrissend biertje dit etablissement binnengelopen, maar door een aanval van hypersomnie ben ik wat langer gebleven.'"
                                            },
                                            {
                                                "example_id": "42d435e5-32b9-4c65-9d5e-fe87a53580cd",
                                                "sense_id": "b996d50d-ea53-388d-9384-bbff68c859ad",
                                                "text": "Ze gaf over en kreeg aanvallen van diarree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1be018a-e202-370b-a493-216bfd0bcf52",
                                        "entry_id": "5da0ec4f-f41f-328b-a805-dd2e53be69bf",
                                        "glosses": [
                                            "het plotseling en hevig komen opzetten van iets (veelal onaangenaams) in het algemeen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a21c6dd0-ae77-45a3-8eb1-0499869b619a",
                                                "sense_id": "d1be018a-e202-370b-a493-216bfd0bcf52",
                                                "text": "Hij kreeg een aanval van woede."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aanval",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9efefd16-9b2b-3cff-817b-40ba4a98fe10",
                                        "entry_id": "ae8e40e5-f022-3e5b-be31-d934c2fa47e2",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van aanvallen"
