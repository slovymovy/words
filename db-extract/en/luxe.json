                "senses": [
                    {
                        "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                        "entry_id": "e4efb84e-676e-3e5a-9d1b-a969a9fbe290",
                        "glosses": [
                            "Luxurious, sophisticated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c6af25-7263-4b6c-9e1c-14dded8a648f",
                                "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                                "text": "A pair of luxe Scottish golf resorts operated by Donald Trump suffered millions of dollars in losses during 2015, according to recent filings with a U.K. government agency, adding another complication to Trump's pitch for the White House, in which he has frequently emphasized his business acumen."
                            },
                            {
                                "example_id": "4ba42f5c-bb99-43d7-b254-4d6fdf7f03c0",
                                "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                                "text": "The luxe department store Barneys New York announced this week that it would launch a new Instagram-ready cannabis department called The High End."
                            },
                            {
                                "example_id": "38e77040-bfe2-4c57-92f0-28573bcd3588",
                                "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                                "text": "Lots of shows at fashion week utilize dry brushing nail techniques on the models because it gives a super luxe finish with minimal effort."
                            },
                            {
                                "example_id": "0eee779d-6ad1-4238-a290-5fb6afaba65f",
                                "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                                "text": "\"The quality and the tailoring is what makes it so luxe,\" Mr. [Michael] Reynolds said. \"Like a piece you'd see created by Hermès, it's not over the top.\""
                            },
                            {
                                "example_id": "4bed590b-8145-42b0-977e-611b88f21c16",
                                "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                                "text": "As a designer and brand builder, [Greg] Chait has turned The Elder Statesman into the coolest of cool and the luxe-est of luxe; the proof is in the many copycats of his tie-dye knitwear and slouchy casual spirit."
                            },
                            {
                                "example_id": "c2403114-d8f1-4ed9-894c-82160b3fd606",
                                "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                                "text": "I found it extremely luxe that there was a stack of large-format Moleskines you could take at your whim from the cabinet behind the receptionist."
                            },
                            {
                                "example_id": "ef206508-ce13-472c-a1c9-595642fdc610",
                                "sense_id": "d60bc1d2-c32a-3d4e-b0ea-a1fb9a066b9f",
                                "text": "Wrap yourself in this ultra-soft and lightweight waffle robe, inspired by some of the most luxe spas."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "827038af-6211-3f40-987a-aa8b28667c3d",
