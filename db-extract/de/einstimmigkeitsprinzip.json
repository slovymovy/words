                "senses": [
                    {
                        "sense_id": "95955168-b52c-3a66-aef0-056dcde55ad1",
                        "entry_id": "c9db27a4-87e2-30cc-a16d-b2b796f4c68d",
                        "glosses": [
                            "Grundsatz, dass sich bei einer Abstimmung alle anwesenden Stimmberechtigten für eine Sache und ohne Gegenstimme entscheiden"
                        ],
                        "tags": [
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "223a4de8-7781-4c3b-b17e-dcedc9d8e27e",
                                "sense_id": "95955168-b52c-3a66-aef0-056dcde55ad1",
                                "text": "„Im übrigen gilt nach dem Maastrichter Vertrag für die Beschlußfassung über die europäischen Rahmenprogramme noch das Einstimmigkeitsprinzip.“"
                            },
                            {
                                "example_id": "64b97714-d3ca-41d7-a8b2-418210c6650b",
                                "sense_id": "95955168-b52c-3a66-aef0-056dcde55ad1",
                                "text": "„Für Beschlüsse der IMK gilt das Einstimmigkeitsprinzip.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
