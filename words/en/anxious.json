{
    "word_family": [
        "anxiety",
        "anxiously",
        "anxiousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8c79f97a-dd45-3b30-9f59-60190c1e68b5",
                    "sense_definition": "Feeling nervous, worried, or uneasy about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could tell she was <w>anxious</w> as she was biting her nails.",
                            "target_lang_translations": {
                                "ru": "Я видел, что она <w>нервничала</w>, так как она грызла ногти."
                            }
                        },
                        {
                            "text": "Many students feel <w>anxious</w> about exams and their future careers.",
                            "target_lang_translations": {
                                "ru": "Многие студенты <w>беспокоятся</w> из-за экзаменов и своей будущей карьеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "uneasy",
                        "worrisome",
                        "unquiet",
                        "concerned",
                        "fraught"
                    ],
                    "antonyms": [
                        "calm",
                        "relaxed",
                        "confident"
                    ],
                    "common_phrases": [
                        "feel anxious",
                        "anxious about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство нервозности, беспокойства или тревоги по какому-либо поводу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоящийся",
                                "target_lang_sense_clarification": "испытывающий волнение"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "находящийся в состоянии тревоги"
                            },
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "о человеке или его состоянии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                    "sense_definition": "Wanting to do something very much; eagerly or earnestly desirous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>anxious</w> to please, so you can count on him.",
                            "target_lang_translations": {
                                "ru": "Он очень <w>старается</w> угодить, так что вы можете на него рассчитывать."
                            }
                        },
                        {
                            "text": "The team was <w>anxious</w> to start the project as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Команда <w>горела желанием</w> начать проект как можно скорее."
                            }
                        }
                    ],
                    "synonyms": [
                        "solicitous"
                    ],
                    "antonyms": [
                        "unwilling",
                        "reluctant",
                        "indifferent"
                    ],
                    "common_phrases": [
                        "anxious to please",
                        "anxious to hear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное желание сделать что-либо; страстное стремление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремящийся",
                                "target_lang_sense_clarification": "очень желающий что-то сделать"
                            },
                            {
                                "target_lang_word": "жаждущий",
                                "target_lang_sense_clarification": "сильно желающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                    "sense_definition": "Experiencing a strong feeling of disquietude or extreme concern, especially regarding future or unknown events.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>anxious</w> to hear how her test results were.",
                            "target_lang_translations": {
                                "ru": "Она с <w>волнением</w> ждала результатов своего теста."
                            }
                        },
                        {
                            "text": "They faced an <w>anxious</w> wait as the final votes were being counted.",
                            "target_lang_translations": {
                                "ru": "Их ждало <w>тревожное</w> ожидание, пока шел подсчет последних голосов."
                            }
                        }
                    ],
                    "synonyms": [
                        "angstful",
                        "disturbed",
                        "restless",
                        "solicitous",
                        "worrisome"
                    ],
                    "antonyms": [
                        "composed",
                        "unconcerned"
                    ],
                    "common_phrases": [
                        "anxious wait",
                        "anxious moment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное чувство беспокойства или крайней озабоченности, особенно в отношении будущих или неизвестных событий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озабоченный",
                                "target_lang_sense_clarification": "крайне обеспокоенный чем-либо"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "сильно волнующийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                    "sense_definition": "Causing or accompanied by a state of worry or distress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon spent several <w>anxious</w> hours in the operating room.",
                            "target_lang_translations": {
                                "ru": "Хирург провел несколько <w>напряженных</w> часов в операционной."
                            }
                        },
                        {
                            "text": "There was an <w>anxious</w> wait before the results were revealed.",
                            "target_lang_translations": {
                                "ru": "Последовало <w>мучительное</w> ожидание перед тем, как были объявлены результаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "restless",
                        "uneasy",
                        "worrisome",
                        "unquiet",
                        "nerve-wracking"
                    ],
                    "antonyms": [
                        "soothing",
                        "comforting"
                    ],
                    "common_phrases": [
                        "anxious labor",
                        "anxious care"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий беспокойство или сопровождающийся состоянием тревоги и стресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "вызывающий чувство страха или волнения"
                            },
                            {
                                "target_lang_word": "мучительный",
                                "target_lang_sense_clarification": "полный напряжения и ожидания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}