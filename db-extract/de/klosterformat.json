                        "sense_id": "4d594b54-7768-33fb-8623-f33e24d3465e",
                        "entry_id": "076fedd5-071b-35ae-b553-7db236d7885a",
                        "glosses": [
                            "ein Format von Mauerziegeln, das etwas größer, in der Regel 28,5 x 13,5 x 8,5 cm, als das normale Ziegelformat ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d6b610a-6a66-4723-8915-444f373cb6a3",
                                "sense_id": "4d594b54-7768-33fb-8623-f33e24d3465e",
                                "text": "Ziegel im Klosterformat wurden vor allen Dingen für mittelalterliche Kirchen- und Klosterbauten verwendet."
                            },
                            {
                                "example_id": "fe18f6ec-7cf4-40e4-a1d0-796ca2e3f3f2",
                                "sense_id": "4d594b54-7768-33fb-8623-f33e24d3465e",
                                "text": "„Das sogenannte „Klosterformat“ für Handstrichziegel ist kein einheitliches System, sondern unterscheidet sich in den einzelnen Klosterbauschulen, da raumgreifende Normung während der Handfertigung der Backsteingotik nicht nötig war.“"
                            }
                        ],
