                    {
                        "sense_id": "741221b9-ee24-3bc1-99a1-29ea06c1b014",
                        "entry_id": "ad2450ad-f4bc-3528-9498-a31ee12f2508",
                        "glosses": [
                            "Féminin singulier de douloureux."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0074ef48-2e19-4e4a-baf6-3de00be2c601",
                                "sense_id": "741221b9-ee24-3bc1-99a1-29ea06c1b014",
                                "text": "Je sentais l’intensité du courant grandir et à mesure ma gorge, mes mâchoires, tous les muscles de mon visage, jusqu’à mes paupières se contracter dans une crispation de plus en plus douloureuse."
                            },
                            {
                                "example_id": "2b3ef7da-88da-4bf8-b1fc-5c73f0697ea0",
                                "sense_id": "741221b9-ee24-3bc1-99a1-29ea06c1b014",
                                "text": "L’automne s’éloigne comme une femme douloureuse qui a perdu tout ce qu’elle aime."
                            }
                        ]
                    }
                ],
