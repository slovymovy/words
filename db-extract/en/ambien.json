                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470f9f23-b715-4bb3-bf5c-01f10f852641",
                                "sense_id": "7d230fa9-7169-363e-bef0-3911c1898972",
                                "text": "The city never sleeps / Better slip you an Ambien"
                            },
                            {
                                "example_id": "9cd5c256-e49e-412d-b589-eb8c349a6368",
                                "sense_id": "7d230fa9-7169-363e-bef0-3911c1898972",
                                "text": "But Eckleburg is powerless against her, so I take an Ambien, and then, at 2 AM, the New York City Department of Transportation decides it's the perfect time to rip up the street."
                            },
                            {
                                "example_id": "2bc4ce51-757c-4dff-84c1-3dddb963462e",
                                "sense_id": "7d230fa9-7169-363e-bef0-3911c1898972",
                                "text": "Silicon Valley is not going to suddenly take an Ambien and stop innovating."
                            },
                            {
                                "example_id": "f84de282-ac6a-4df5-b7c7-3e5771fcda3f",
                                "sense_id": "7d230fa9-7169-363e-bef0-3911c1898972",
                                "text": "They ingest Ambien, Seroquel, LSD, Adderall, Oxycodone, cocaine, Flexeril, Percocet, psilocybin mushrooms and codeine."
                            },
                            {
                                "example_id": "a3de8689-8138-438f-8b98-7b7960a4800d",
                                "sense_id": "7d230fa9-7169-363e-bef0-3911c1898972",
                                "text": "This week’s find: a subreddit devoted to all the wonderfully deranged things people have done while under the influence of Ambien sleeping pills, or while experiencing a visit from the Ambien walrus, as redditors are known to call it."
                            },
                            {
                                "example_id": "a9ea8ee6-12a2-4d9b-a9d7-29c0cedaca8a",
                                "sense_id": "7d230fa9-7169-363e-bef0-3911c1898972",
                                "text": "Roseanne Barr said she was “Ambien tweeting” when she wrote racist remarks on Twitter […]. But on Wednesday the makers of Ambien, the sleep aid, were having none of it.[…] “While all pharmaceutical treatments have side effects, racism is not a known side effect of any Sanofi medication.”"
                            }
                        ]
