                        "glosses": [
                            "Dont on peut supprimer l’enchantement ; qui peut être désenchanté."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a90243e8-7be6-4974-8701-ed33bcf46f7c",
                                "sense_id": "f9e93741-10ad-30e2-865e-0b80bf11c9c0",
                                "text": "Désormais savoir et non-savoir progressent de concert dans un monde qui « n’est pas désenchantable. Plus vite que tout savoir, l’irréfléchi se renouvelle, il est inépuisable »."
                            },
                            {
                                "example_id": "5f3e136c-9166-4f55-aa54-6a870a0cf6f8",
                                "sense_id": "f9e93741-10ad-30e2-865e-0b80bf11c9c0",
                                "text": "Né dans un jardin et destiné à y retourner, créé par le caprice d’un Dieu assez fou pour imaginer l’ornithorynque, « ce compromis entre le colibri, la vipère, la poule et le kangourou boxeur », notre monde n’est tout simplement pas désenchantable."
                            },
                            {
                                "example_id": "2bd798c4-8c29-48df-9793-358c7dd292ee",
                                "sense_id": "f9e93741-10ad-30e2-865e-0b80bf11c9c0",
                                "text": "La version dorée du fossoyeur sera désenchantable pour 400 poussières pendant une durée limitée lorsque le changement sera appliqué."
                            }
                        ]
                    }
