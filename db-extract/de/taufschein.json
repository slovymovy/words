                "senses": [
                    {
                        "sense_id": "9c763691-6c09-398c-b482-d02551c2e87e",
                        "entry_id": "84bad4be-ba8f-3a87-a2b5-8bd1749b8fb7",
                        "glosses": [
                            "kirchliche Urkunde, die eine durchgeführte Taufe bescheinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad305f28-5f9a-4e57-8735-ac22472d7fe4",
                                "sense_id": "9c763691-6c09-398c-b482-d02551c2e87e",
                                "text": "„Wieso bei einem Kirchenaustritt in der Stadt Salzburg explizit der Taufschein verlangt wird, ist eine Frage für sich.“"
                            },
                            {
                                "example_id": "623aacf4-39e6-4fc3-8c96-8b57cb97ef7f",
                                "sense_id": "9c763691-6c09-398c-b482-d02551c2e87e",
                                "text": "„Das Taufpfarramt ergänzt den alten Taufschein mit dem Firmungsvermerk und eventuellen weiteren Eintragungen oder stellt einen neuen Taufschein aus.“"
                            },
                            {
                                "example_id": "a8b6ae9d-a2fe-4fc6-8b53-1e13792675b1",
                                "sense_id": "9c763691-6c09-398c-b482-d02551c2e87e",
                                "text": "„Er übergab mir den Taufschein seiner Nichte und eine Aufstellung über ihre Mitgift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
