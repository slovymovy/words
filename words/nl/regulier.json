                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het klooster woont een <w>reguliere</w> kanunnik. ",
                            "target_lang_translations": {
                                "en": "A <w>regular</w> canon lives in the monastery."
                            }
                        },
                        {
                            "text": "Zij traden toentertijd toe tot de <w>reguliere</w> geestelijkheid.",
                            "target_lang_translations": {
                                "en": "At that time, they joined the <w>regular</w> clergy."
                            }
                        }
                    ],
                    "antonyms": [
                        "singulier"
                    ],
                    "target_lang_definitions": {
