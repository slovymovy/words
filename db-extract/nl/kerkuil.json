                        "entry_id": "0b34bcec-4866-3c28-a2ff-f38c7b0230a7",
                        "glosses": [
                            "bepaald soort vogel, Tyto alba, met een lichte onderzijde en een opvallende, hartvormige sluier die gewoonlijk in gebouwen broedt"
                        ],
                        "tags": [
                            "uilen"
                        ],
                        "examples": [
                            {
                                "example_id": "bbec5272-a9f6-43be-85d6-ce76724ce951",
                                "sense_id": "679d6867-7fef-3088-91a1-c3eec2213014",
                                "text": "Bij een handelaar in Noord-Brabant zijn meer dan 100 vogels in beslag genomen. Het gaat om kerkuilen, Turkmeense oehoes, verschillende soorten kwartels en allerlei soorten tropische vogels, meldt de Landelijke Inspectiedienst Dierenbescherming (LID)."
                            }
                        ]
                    }
