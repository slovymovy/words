                                "target_senses": [
                                    {
                                        "sense_id": "1b52baee-aab6-3800-8543-4fecda42a031",
                                        "entry_id": "a15997be-7157-3bb8-9d53-e8afe859b28b",
                                        "glosses": [
                                            "To fix firmly or set securely or deeply."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63900ba5-6180-43d0-bf93-01ae1d7cb06b",
                                                "sense_id": "1b52baee-aab6-3800-8543-4fecda42a031",
                                                "text": "That strength of body is often equal to the courage of mind implanted in the fair sex, will not be denied by those who have seen the water-women of Plymouth; the female drudges of Ireland, Wales, and Scotland; the fish-women of Billinsgate; the weeders, podders, and hoppers, who swarm the fields; and the lowest beings of the feminine gender wo swagger in the streets of London."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bfc1311-0138-3039-8d8d-639b2f584930",
                                        "entry_id": "a15997be-7157-3bb8-9d53-e8afe859b28b",
                                        "glosses": [
                                            "To insert (something) surgically into the body."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b44dbd50-4b27-4705-87d2-a6bb403d5957",
                                                "sense_id": "7bfc1311-0138-3039-8d8d-639b2f584930",
                                                "text": "If you prefer a “natural look” for your male Poodle, ask your vet about a vasectomy or implanting artificial testicles (called neuticles)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87af0b3c-0bdf-322d-af02-c9030264374f",
                                        "entry_id": "a15997be-7157-3bb8-9d53-e8afe859b28b",
                                        "glosses": [
                                            "Of an embryo, to become attached to and embedded in the womb."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "implant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c21595f-dd19-3e2a-aad7-cddc4bb2b71b",
                                        "entry_id": "f96b25d9-2823-37ee-adb8-e99b0cbfaef6",
                                        "glosses": [
                                            "Anything surgically implanted in the body, such as a tissue graft or prosthesis, particularly breast implants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67a512a-164d-4598-8bac-2add04b1f363",
                                                "sense_id": "2c21595f-dd19-3e2a-aad7-cddc4bb2b71b",
                                                "text": "They existed at a time in history when shock therapy, brain tissue manipulation, implants, drug experimentation and lobotomies were treatments de jour."
                                            },
                                            {
                                                "example_id": "aca332e3-cb3d-4696-a9e1-9f5481ce699c",
                                                "sense_id": "2c21595f-dd19-3e2a-aad7-cddc4bb2b71b",
                                                "text": "Microbial samples and peri-implant crestal bone levels of all implant sites were obtained before, during and after the breakdown period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a6b904-c2ca-309e-99f6-82882de7d073",
                                        "entry_id": "f96b25d9-2823-37ee-adb8-e99b0cbfaef6",
                                        "glosses": [
                                            "A representative of a travel company, working within the office of a large client and exclusively dealing with that client."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0589bfe2-f2c9-43d6-894d-4b525df1ec0d",
                        "source_entry_id": "e0a61e75-1097-3c63-b151-bdcc2cdf33d0",
                        "source_sense_id": "a034c406-cb2b-3672-a07a-16b8c4c4e028",
                        "target_lang_word": "Implantat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Implantat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                        "entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                                        "glosses": [
                                            "in den Körper operativ eingepflanztes künstliches Gerät, das dort permanent oder zumindest für einen längeren Zeitraum verbleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c3e2fe-0281-4a0b-9eca-849d94cb9457",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "Die Chirurgen setzen dem Patienten in einer dreistündigen Operation ein Implantat in den Knochen."
                                            },
                                            {
                                                "example_id": "6b3af04a-ff14-4af9-bbbc-8f98962d19b5",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "Statt Sport zu treiben, ließ sich Klaus Implantate in die Waden einsetzen."
                                            },
                                            {
                                                "example_id": "8d0cad82-25e7-425f-8b0b-c328e04ac4c0",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "„Aus der Altersschwerhörigkeit führt kein Weg heraus, da können nur noch Hörgeräte oder Implantate helfen.“"
                                            },
                                            {
                                                "example_id": "63c1f1d5-3d28-4d4c-999b-b280de0ec835",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "„Die Patientinnen sollen am besten mit ihrem Arzt sprechen und per Ultraschall oder Kernspintomografie erfassen lassen, ob ihr Implantat möglicherweise beschädigt ist.“"
                                            },
                                            {
                                                "example_id": "f0eb3977-13c8-451b-abd5-a6c2328af0b8",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "„Den mümmelnden Greis gibt es nicht mehr. Er trägt Implantate.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44435e4b-8bba-35a5-bed1-3b48f8db7993",
                                        "entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                                        "glosses": [
                                            "Platzierung von Zähnen in nicht besetzte Zahnkammern (Alveolen)"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf400c65-94d3-4514-a499-fd920b98e797",
                                                "sense_id": "44435e4b-8bba-35a5-bed1-3b48f8db7993",
                                                "text": "„Die gute Nachricht: Wer Wert auf ein Implantat legt, um Zahnverlust zu verbergen und so auch Kau- und Sprechproblemen vorzubeugen, kann einem bereits begonnenen Abbau der Alveolen entgegenwirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
