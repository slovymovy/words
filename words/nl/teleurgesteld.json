            "senses": [
                {
                    "sense_id": "6f2d53c3-3a60-3ae3-b79a-ab9f556f248a",
                    "sense_definition": "Een onaangenaam gevoel hebbend omdat een verwachting of hoop niet uitgekomen is",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>teleurgestelde</w> kinderen begonnen luid te protesteren toen het uitje werd afgelast.",
                            "target_lang_translations": {
                                "ru": "<w>Разочарованные</w> дети начали громко протестовать, когда поездку отменили.",
                                "en": "The <w>disappointed</w> children started protesting loudly when the outing was cancelled.",
                                "zh": "当郊游被取消时，<w>失望的</w>孩子们开始大声抗议。"
                            }
                        },
                        {
                            "text": "Ik ben diep <w>teleurgesteld</w> dat mijn favoriete team de finale heeft verloren.",
                            "target_lang_translations": {
                                "ru": "Я глубоко <w>разочарован</w>, что моя любимая команда проиграла финал.",
                                "en": "I am deeply <w>disappointed</w> that my favorite team lost the final.",
                                "zh": "我最喜欢的球队在决赛中失利，我感到深切的<w>失望</w>。"
                            }
                        },
                        {
                            "text": "Ruald keek een beetje <w>teleurgesteld</w>, maar drong niet verder aan.",
                            "target_lang_translations": {
                                "ru": "Руальд выглядел немного <w>разочарованным</w>, но не стал настаивать.",
                                "en": "Ruald looked a bit <w>disappointed</w>, but did not insist further.",
                                "zh": "鲁阿尔德看起来有点<w>失望</w>，但没有继续坚持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ontgoocheld"
                    ],
                    "antonyms": [
                        "tevreden",
                        "voldaan"
                    ],
                    "common_phrases": [
                        "diep teleurgesteld",
                        "zwaar teleurgesteld",
                        "teleurgesteld zijn",
                        "teleurgesteld kijken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий неприятное чувство из-за того, что ожидания или надежды не оправдались",
                        "en": "Feeling unhappy because something was not as good as expected or because something you hoped for did not happen",
                        "zh": "感到失望的，因期望或希望落空而产生不愉快的心情"
                    },
                    "translations": {
                        "ru": [
                            {
