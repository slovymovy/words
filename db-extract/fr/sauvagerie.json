                                    {
                                        "sense_id": "cdd3ca49-4c31-3ca2-9e8c-9524686a3240",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "Savage or brutal behaviour; barbarity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ebee89-d875-442c-9069-a949bddb1ed4",
                                                "sense_id": "cdd3ca49-4c31-3ca2-9e8c-9524686a3240",
                                                "text": "“For some reason the women have not reverted to savagery so rapidly as the men.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4472ba2-1aff-3f00-9a27-324e5947367b",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "A violent act of cruelty."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cdb5a4f-2b12-3287-8f9c-895b724af8b2",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "Savages collectively; the world of savages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "087ca7f9-2952-4a2d-9d36-79c61ff1b6db",
                                                "sense_id": "3cdb5a4f-2b12-3287-8f9c-895b724af8b2",
                                                "text": "They spring out of an element of diffused homosexuality which is at least as marked in civilization as it is in savagery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d520e752-d6e0-3e4f-8673-a8ed64629cdc",
                                        "entry_id": "ab903226-18a0-3c27-852c-a4503c830ffe",
                                        "glosses": [
                                            "Wild growth of plants."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ab8e667-9a9c-4a02-b02e-2597a46d391c",
                                                "sense_id": "d520e752-d6e0-3e4f-8673-a8ed64629cdc",
                                                "text": "[…] they […] made, amongst other features, lead ponds. With their departure these lands once more reverted to savagery; gardening, along with virtually all aspects of culture, disappeared and with it the man-made water gardens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
