{
    "word_family": [
        "injection",
        "injector",
        "injectable",
        "reinject",
        "microinjection"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a15d8bc-04e6-3f2a-a9b8-bab56f38f8a4",
                    "sense_definition": "To push or pump a liquid or substance into a cavity, passage, or body part using a needle or similar device.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_physical_injection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse had to <w>inject</w> a painkilling drug into the patient's arm.",
                            "target_lang_translations": {
                                "ru": "Медсестре пришлось <w>ввести</w> обезболивающее в руку пациента."
                            }
                        },
                        {
                            "text": "Doctors often <w>inject</w> insulin to help manage blood sugar levels.",
                            "target_lang_translations": {
                                "ru": "Врачи часто <w>вводят</w> инсулин, чтобы помочь контролировать уровень сахара в крови."
                            }
                        }
                    ],
                    "synonyms": [
                        "infuse",
                        "inoculate"
                    ],
                    "antonyms": [
                        "extract",
                        "withdraw"
                    ],
                    "common_phrases": [
                        "inject a drug",
                        "inject into veins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить жидкость или вещество в полость, проход или часть тела с помощью иглы или аналогичного устройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить",
                                "target_lang_sense_clarification": "лекарство или раствор"
                            },
                            {
                                "target_lang_word": "впрыскивать",
                                "target_lang_sense_clarification": "жидкость под давлением или шприцем"
                            },
                            {
                                "target_lang_word": "вкалывать",
                                "target_lang_sense_clarification": "разговорное, о лекарстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e66c1035-fd1a-3e6b-b8e2-1178273c4e1e",
                    "sense_definition": "To administer a substance to a person or animal by means of a needle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_physical_injection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please lie back while the medical team <w>injects</w> you with the anesthetic.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, лягте, пока медицинская бригада <w>вводит</w> вам анестетик."
                            }
                        },
                        {
                            "text": "The veterinarian will <w>inject</w> the dog with a vaccine during the checkup.",
                            "target_lang_translations": {
                                "ru": "Ветеринар <w>сделает</w> собаке <w>укол</w> вакцины во время осмотра."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaccinate",
                        "jab"
                    ],
                    "common_phrases": [
                        "inject with medicine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать укол человеку или животному для введения лекарственного вещества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать укол",
                                "target_lang_sense_clarification": "пациенту"
                            },
                            {
                                "target_lang_word": "вводить",
                                "target_lang_sense_clarification": "препарат человеку"
                            },
                            {
                                "target_lang_word": "инъецировать",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f5dd47-981e-39f7-a5a1-1a836e4f7f34",
                    "sense_definition": "To introduce or add a new quality or element into something to improve it or change its character.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "introduction_of_elements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new manager tried to <w>inject</w> some spice into the team's daily routine.",
                            "target_lang_translations": {
                                "ru": "Новый менеджер попытался <w>привнесть</w> немного остроты в повседневную рутину команды."
                            }
                        },
                        {
                            "text": "Adding a few jokes can <w>inject</w> some humor into a boring presentation.",
                            "target_lang_translations": {
                                "ru": "Несколько шуток могут <w>добавить</w> немного юмора в скучную презентацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "introduce",
                        "insert",
                        "infuse"
                    ],
                    "antonyms": [
                        "remove",
                        "eliminate"
                    ],
                    "common_phrases": [
                        "inject some spice",
                        "inject new life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привносить или добавлять новое качество или элемент во что-либо для улучшения или изменения характера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привносить",
                                "target_lang_sense_clarification": "новые элементы или качества"
                            },
                            {
                                "target_lang_word": "добавлять",
                                "target_lang_sense_clarification": "разнообразие или интерес"
                            },
                            {
                                "target_lang_word": "вдыхать",
                                "target_lang_sense_clarification": "новую жизнь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ee201d5-ee86-3dca-9ec6-645caf077f7e",
                    "sense_definition": "To introduce something suddenly, forcefully, or with great impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "introduction_of_elements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrival of the punk movement <w>injected</w> a sense of urgency into the music scene.",
                            "target_lang_translations": {
                                "ru": "Появление панк-движения <w>привнесло</w> ощущение безотлагательности в музыкальную сцену."
                            }
                        },
                        {
                            "text": "The coach wanted to <w>inject</w> energy into the game by making quick substitutions.",
                            "target_lang_translations": {
                                "ru": "Тренер хотел <w>придать</w> игре энергии, сделав быстрые замены."
                            }
                        }
                    ],
                    "synonyms": [
                        "instill",
                        "interject"
                    ],
                    "common_phrases": [
                        "inject a sense of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внедрять что-либо внезапно, энергично или с большим влиянием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внедрять",
                                "target_lang_sense_clarification": "энергию или идеи"
                            },
                            {
                                "target_lang_word": "вселять",
                                "target_lang_sense_clarification": "чувство или уверенность"
                            },
                            {
                                "target_lang_word": "придавать",
                                "target_lang_sense_clarification": "динамику или импульс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aecf56c4-876c-34de-b433-fa324a7b9b83",
                    "sense_definition": "To insert malicious or external code into a computer program or database, often through a security flaw.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hackers often try to <w>inject</w> SQL data into vulnerable login forms.",
                            "target_lang_translations": {
                                "ru": "Хакеры часто пытаются <w>внедрить</w> SQL-данные в уязвимые формы входа."
                            }
                        },
                        {
                            "text": "The script was designed to <w>inject</w> code into the browser's memory space.",
                            "target_lang_translations": {
                                "ru": "Скрипт был разработан для <w>внедрения</w> кода в пространство памяти браузера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inject code",
                        "inject SQL"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставлять вредоносный или внешний код в компьютерную программу или базу данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внедрять",
                                "target_lang_sense_clarification": "код или данные"
                            },
                            {
                                "target_lang_word": "инъецировать",
                                "target_lang_sense_clarification": "технический термин в IT"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7c86455-98c7-3d86-9311-8c4e722feacd",
                    "sense_definition": "To habitually take drugs by means of a needle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_physical_injection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been struggling with addiction and has not <w>injected</w> for over a week.",
                            "target_lang_translations": {
                                "ru": "Он борется с зависимостью и не <w>кололся</w> уже больше недели."
                            }
                        },
                        {
                            "text": "The documentary focused on the lives of people who <w>inject</w> heroin.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм посвящен жизни людей, которые <w>употребляют</w> героин внутривенно."
                            }
                        }
                    ],
                    "synonyms": [
                        "shoot up"
                    ],
                    "common_phrases": [
                        "stop injecting"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the context of substance abuse"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привычно употреблять наркотики с помощью иглы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колоться",
                                "target_lang_sense_clarification": "сленг, о наркотиках"
                            },
                            {
                                "target_lang_word": "вводить внутривенно",
                                "target_lang_sense_clarification": "о наркотических веществах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abef5eff-6857-35ad-998c-736cfb3ad32d",
                    "sense_definition": "To cast or throw something onto something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text described how they would <w>inject</w> mound on mound during construction.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте описывалось, как они <w>наваливали</w> курган на курган во время строительства."
                            }
                        },
                        {
                            "text": "In the old poem, the giants <w>inject</w> heavy stones upon the walls.",
                            "target_lang_translations": {
                                "ru": "В старинной поэме великаны <w>набрасывают</w> тяжелые камни на стены."
                            }
                        }
                    ],
                    "synonyms": [
                        "cast",
                        "throw"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набрасывать или наваливать что-либо на что-то другое (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наваливать",
                                "target_lang_sense_clarification": "груды земли или камни"
                            },
                            {
                                "target_lang_word": "набрасывать",
                                "target_lang_sense_clarification": "предметы сверху"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}