                        "entry_id": "0c798c62-6889-3e41-a279-1c13dc86def4",
                        "glosses": [
                            "A surname originating as an occupation for someone who made bows for archery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00bd9644-52f3-4112-88ed-e90975a673e4",
                                "sense_id": "d7856d8e-ed33-3f97-b80b-28760ebb4201",
                                "text": "Dr. Werthimer recalled that Dr. Bowyer and his wife, Jane Baker Bowyer, an education professor at nearby Mills College, had cultivated a Japanese garden in their backyard, “the most serene place you could imagine,” and also attended Burning Man."
                            }
                        ]
                    }
                ],
