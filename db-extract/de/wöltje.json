                "senses": [
                    {
                        "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                        "entry_id": "8736a34b-f473-3196-92a0-d73fc56d1788",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e197b60-26a6-4c4f-b84e-791b9ca68b11",
                                "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                                "text": "Frau Wöltje ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2b87853f-4a0f-4b41-a1bb-70af8b745c65",
                                "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                                "text": "Herr Wöltje wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "07b6dd86-48e4-4687-addf-c8367eb56634",
                                "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                                "text": "Die Wöltjes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "792cc7d6-8559-4e09-8f53-b6f08605554f",
                                "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                                "text": "Der Wöltje trägt nie die Schals, die die Wöltje ihm strickt."
                            },
                            {
                                "example_id": "bf9ece65-36f5-4890-8408-94cca3faca2c",
                                "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wöltje kommt, geht der Herr Wöltje.“"
                            },
                            {
                                "example_id": "cd7fae2a-0f7f-4ae0-9eef-4be6dd28d5f7",
                                "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                                "text": "Wöltje kommt und geht."
                            },
                            {
                                "example_id": "d5147931-a8f3-465c-90f9-f47207c6cd55",
                                "sense_id": "c8949e49-f1e9-3fd3-9301-21687e14ec74",
                                "text": "Wöltjes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
