                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0562ca5-aaba-435b-a8cf-524e6ed6bfb6",
                                "sense_id": "556b913b-c485-3bcf-b523-c5d8afff499e",
                                "text": "And Annie could have wept for pity of him;\nAnd yet she held him on delayingly\nWith many a scarce-believable excuse,\nTrying his truth and his long-sufferance,\nTill half-another year had slipt away."
                            },
                            {
                                "example_id": "273a61ed-1e1f-47f7-bec4-37c8e96474f6",
                                "sense_id": "556b913b-c485-3bcf-b523-c5d8afff499e",
                                "text": "The mother glanced round at the bed, and said, glad to occupy herself delayingly with the minor care: “Why, you have been sitting up all night! You will kill yourself.”"
                            },
                            {
                                "example_id": "8e4efdd2-c6fc-4bd8-8b4c-d1fedb3f50d9",
                                "sense_id": "556b913b-c485-3bcf-b523-c5d8afff499e",
                                "text": "He was unpacking too, though as coyly and delayingly as he had undressed that day at the Highgate Ponds."
                            }
                        ]
                    }
                ],
