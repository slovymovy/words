                                        "glosses": [
                                            "Faculté motrice commandée par le cerveau et permettant la contraction musculaire et le mouvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8841ce-d5ec-485f-95f8-25b6ba702e2e",
                                                "sense_id": "802ab384-2daf-3217-b794-ad6de3453b3d",
                                                "text": "On parle de motricité réflexe quand le geste est indépendant de la volonté."
                                            },
                                            {
                                                "example_id": "b447cf28-c02f-46cf-9ed3-7b0e473eeb82",
                                                "sense_id": "802ab384-2daf-3217-b794-ad6de3453b3d",
                                                "text": "Elle s’applique sans modification pour l’analyse de la motricité spontanée jusqu’à deux mois après la naissance."
                                            }
                                        ]
                                    }
                                ]
                            }
