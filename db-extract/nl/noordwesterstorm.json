                            {
                                "example_id": "4b5bbd3a-d422-49ee-964b-b35f98f151b0",
                                "sense_id": "0278eb04-ebe1-36a3-a1e9-eb8f07b7101d",
                                "text": "Het is deze week honderd jaar geleden dat er een noordwesterstorm over ons land trok en de dorpen die nu Amsterdam-Noord vormen geheel onder water zette. De herdenking van de ramp, ook wel de vergeten Watersnoodramp genoemd, begint woensdag."
                            },
                            {
                                "example_id": "66fe840f-4282-4c71-b2df-3d14ffea2f64",
                                "sense_id": "0278eb04-ebe1-36a3-a1e9-eb8f07b7101d",
                                "text": "Eerder vanochtend waarschuwden de weerdiensten al dat de kustprovincies morgen rekening moeten houden met stormwinden. Langs de noordkust staat een noordwesterstorm, mogelijk windkracht 9. Het hele land krijgt te maken met zware windstoten."
                            }
                        ]
