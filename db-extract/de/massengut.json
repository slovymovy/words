                "senses": [
                    {
                        "sense_id": "1375d6f6-00bf-3cb9-9def-9c44b17bc01b",
                        "entry_id": "ca0618d1-d089-3d9a-a6c6-b9bbb1cfdbec",
                        "glosses": [
                            "Ware, die in sehr großen Mengen verfrachtet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5233d9b2-56a9-4b68-bc37-554cbdc5940a",
                                "sense_id": "1375d6f6-00bf-3cb9-9def-9c44b17bc01b",
                                "text": "„Wie wichtig der Rhein als Transportweg für Massengüter und Container ist, wurde deutlich, als im März 2007 nach der Havarie eines Containerschiffes der Fluss für mehrere Tage gesperrt werden musste.“"
                            },
                            {
                                "example_id": "3f537bb7-b00c-40bb-ac82-3f36308a1f3b",
                                "sense_id": "1375d6f6-00bf-3cb9-9def-9c44b17bc01b",
                                "text": "„In der Antike legte man üppig verzierte Amphoren als Beigabe ins Grab oder sie wurden, mit kostbarem Öl gefüllt, den Siegern sportlicher Wettkämpfe überreicht. Unbemalt und schmucklos dienten sie jedoch als wichtigster Transportbehälter in der antiken Welt – für Massengüter wie Getreide, Wein, Olivenöl, Früchte und Würzsoßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
