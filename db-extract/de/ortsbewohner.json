                "senses": [
                    {
                        "sense_id": "b71f6b84-4050-3687-9fa7-8001bdd08996",
                        "entry_id": "48a9075d-9b92-30be-9237-3f62650f98a9",
                        "glosses": [
                            "jemand, der/die in einem bestimmten Ort wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fe73c0c-844d-4fe8-a6f8-2e284997c8b6",
                                "sense_id": "b71f6b84-4050-3687-9fa7-8001bdd08996",
                                "text": "„Er erinnerte sich dumpf daran, in die Kneipe gegangen zu sein, wo ihn die anderen Ortsbewohner wie üblich völlig ignoriert hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f1ac029-8347-4939-88c8-f04456e9bfe9",
                        "source_entry_id": "48a9075d-9b92-30be-9237-3f62650f98a9",
                        "source_sense_id": "b71f6b84-4050-3687-9fa7-8001bdd08996",
