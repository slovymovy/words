                        "glosses": [
                            "Rendre plusieurs choses complémentaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd6e9e1f-864f-4812-8312-72ee8abc63ec",
                                "sense_id": "cf638fa2-ac1f-3953-b644-6d0f0a9bdc57",
                                "text": "Conceptualiser, bien sûr, c'est-à-dire identifier et différencier des choses, complémentariser ou rendre indépendants des facteurs déterminants."
                            },
                            {
                                "example_id": "980a4ec9-cb56-4202-a026-505da742e5ce",
                                "sense_id": "cf638fa2-ac1f-3953-b644-6d0f0a9bdc57",
                                "text": "L'expérience montrerait que les communes qui réussissent à complémentariser leur économie par des moyens extra-ruraux, arriveraient à se maintenir à un niveau suffisant."
                            }
                        ]
                    }
