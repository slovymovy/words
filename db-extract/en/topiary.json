{
    "word": "topiary",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4faf2969-78d9-3a6e-8a04-12c1be8c8869",
                "word": "topiary",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "42e61b35-664b-340f-8ae0-d8f1b0c68599",
                        "entry_id": "4faf2969-78d9-3a6e-8a04-12c1be8c8869",
                        "glosses": [
                            "Of, or relating to art of topiaries."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "254df3f9-c395-4760-aef7-14766011274b",
                                "sense_id": "42e61b35-664b-340f-8ae0-d8f1b0c68599",
                                "text": "As the topiary art has been allowed to practically die out, it is difficult to secure the services of skilled clippers."
                            }
                        ]
                    },
                    {
                        "sense_id": "341d30dd-50f8-3d20-b43f-661b60ff2775",
                        "entry_id": "4faf2969-78d9-3a6e-8a04-12c1be8c8869",
                        "glosses": [
                            "Of a tree or shrub, trimmed in artistic shape."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98566f7f-ab81-48db-9a61-6c8680785f64",
                        "source_entry_id": "4faf2969-78d9-3a6e-8a04-12c1be8c8869",
                        "source_sense_description": "relating to the art of topiaries",
                        "target_lang_word": "topiaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topiaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b34eb116-994f-3555-9870-ee32ddb639df",
                                        "entry_id": "04129697-d1aa-35c3-bb4e-9a31d4680718",
                                        "glosses": [
                                            "Qui concerne l’art des jardins d’agrément, en particulier la sculpture végétale."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d9bfc7-a8a3-42da-94e9-f70246775bdd",
                                                "sense_id": "b34eb116-994f-3555-9870-ee32ddb639df",
                                                "text": "Les principales plantes topiaires en France sont les Buxus (buis) et les Taxus (ifs)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "topiaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "351578aa-bc34-3be1-88a3-4606181ebfbd",
                                        "entry_id": "5a5c7cc4-097b-32f3-9307-7f735e4a74ad",
                                        "glosses": [
                                            "Art topiaire. Art d’orner les jardins d’agrément et de tailler les buis, les ifs ou d’autres arbres en formes décoratives."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc9880dc-60d4-4663-abbb-e4d437629186",
                                                "sense_id": "351578aa-bc34-3be1-88a3-4606181ebfbd",
                                                "text": "Ailleurs souffle sur la topiaire le vent du zen, qui inspire tant de jardiniers contemporains."
                                            },
                                            {
                                                "example_id": "805f1a14-830a-477a-b450-a6c526e603e3",
                                                "sense_id": "351578aa-bc34-3be1-88a3-4606181ebfbd",
                                                "text": "Le travail à la française, le topiaire, concerne des arbustes de 1 m - 1m 20, des gros pots aux formes simples (boules, fuseaux, colonnes) mais le Buxus Figuren fait 20 cm pas plus !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd1323ed-c872-389a-8d8c-8df8d878b681",
                                        "entry_id": "5a5c7cc4-097b-32f3-9307-7f735e4a74ad",
                                        "glosses": [
                                            "Plante taillée ou sculptée de manière décorative."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b2fd3d1-ca39-4bc6-bb62-b30986344ba3",
                                                "sense_id": "fd1323ed-c872-389a-8d8c-8df8d878b681",
                                                "text": "Plus l’arbuste est grand, plus le topiaire pourra être imposant."
                                            },
                                            {
                                                "example_id": "1038b8af-2db7-4efb-a2a4-14b792d6101d",
                                                "sense_id": "fd1323ed-c872-389a-8d8c-8df8d878b681",
                                                "text": "Plus il y aura de nouvelles pousses plus la topiaire sera belle et dense."
                                            },
                                            {
                                                "example_id": "7ed5e2b1-b843-45c0-a345-eb7d2d882b4a",
                                                "sense_id": "fd1323ed-c872-389a-8d8c-8df8d878b681",
                                                "text": "Les topiaires de maman, sur le thème de l’espace, ont survécu au blizzard, mais portent les stigmates des bourrasques. La fusée est un peu tordue. Les ET aux visages bleus ont mauvaise mine. On dirait des mannequins de crash-test après un essai qui s’est mal passé. Le buis sphérique, censé représenté Pluton, ressemble plus à un tumbleweed du Far West, ou à une botte de foin en perdition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
