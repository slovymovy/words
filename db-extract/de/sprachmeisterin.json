                        "sense_id": "c008a238-16a5-31f3-9689-b90e90f84931",
                        "entry_id": "98b1e4e2-7d63-31ca-9759-72e034363463",
                        "glosses": [
                            "weibliche Person, die es versteht, meisterlich mit der Sprache umzugehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc907a1-a046-4e53-a41e-a02a97aee8d0",
                                "sense_id": "c008a238-16a5-31f3-9689-b90e90f84931",
                                "text": "„Kein Zweifel auch, dass der Sprachmeisterin, die weniger Worte bedarf, um vieles zu sagen, mit ‚Nai‘ ein großer Wurf gelungen ist: das Buch des Lebens von einem, der auszieht, die Welt zu erobern und sich dabei findet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
