                        "entry_id": "02b2cf0b-af60-35cc-9a1c-fff562f1e42a",
                        "glosses": [
                            "Mitglied einer Flugzeugbesatzung, das für die Überwachung und Wartung technischer Systeme zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf513b49-2c2d-42e2-93cd-e899da67434a",
                                "sense_id": "11899e89-743a-34d0-ac22-d56b5d800e2c",
                                "text": "„Ein junger, pummeliger Flugingenieur reichte dem Amerikaner ein Headset, damit er und der Pilot bequem miteinander kommunizieren konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c8c4dac-9855-4ecd-bc0a-8d01de72f6ec",
                        "source_entry_id": "02b2cf0b-af60-35cc-9a1c-fff562f1e42a",
                        "source_sense_id": "11899e89-743a-34d0-ac22-d56b5d800e2c",
                        "source_sense_description": "Mitglied einer Flugzeugbesatzung für technische Angelegenheiten",
                        "target_lang_word": "flight engineer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flight engineer",
