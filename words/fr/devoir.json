{
    "word_family": [
        "redevable",
        "redevance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f0d9f14-e22e-3906-a732-05d4e0a908c3",
                    "sense_definition": "Être tenu ou obligé de faire quelque chose par une règle, une nécessité ou une contrainte morale.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour réussir son examen, elle <w>doit</w> réviser tous les soirs avec sérieux."
                        },
                        {
                            "text": "Nous <w>devons</w> partir maintenant pour ne pas manquer notre train de banlieue."
                        }
                    ],
                    "synonyms": [
                        "falloir"
                    ]
                },
                {
                    "sense_id": "c4ac520e-7199-358a-bcd3-27d156f407db",
                    "sense_definition": "Avoir une somme d'argent à rembourser ou un bien matériel à rendre à quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dette",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te <w>dois</w> encore vingt euros pour le repas d'hier au restaurant."
                        },
                        {
                            "text": "Il <w>doit</w> beaucoup d'argent à sa banque après cet achat imprévu."
                        }
                    ],
                    "common_phrases": [
                        "devoir de l'argent"
                    ]
                },
                {
                    "sense_id": "961263c6-0d62-353d-a419-b39d6dcd2aa3",
                    "sense_definition": "Être très probable ou prévisible d'après les apparences ou la logique.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "probabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train a pris du retard et <w>doit</w> arriver vers vingt heures."
                        },
                        {
                            "text": "Il n'est pas encore arrivé, il a <w>dû</w> rater son bus ce matin."
                        }
                    ]
                },
                {
                    "sense_id": "367d972d-4c92-36cc-a4a6-771f879e70c3",
                    "sense_definition": "Être redevable de quelque chose à quelqu'un, lui attribuer la cause ou l'origine d'un bienfait.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin l'a soigné à temps, il lui <w>doit</w> la vie."
                        },
                        {
                            "text": "Ce jeune chercheur <w>doit</w> toute sa réussite au soutien sans faille de sa tutrice."
                        }
                    ],
                    "common_phrases": [
                        "devoir la vie"
                    ]
                },
                {
                    "sense_id": "58b7678b-973f-3ca4-89ea-92fe8374aacc",
                    "sense_definition": "Se consacrer moralement à une tâche ou estimer qu'on a la responsabilité d'agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En tant que responsable de l'équipe, elle se <w>doit</w> de soutenir ses collaborateurs en difficulté."
                        },
                        {
                            "text": "Le directeur se <w>doit</w> d'intervenir pour calmer les tensions entre les employés."
                        }
                    ],
                    "common_phrases": [
                        "se devoir de"
                    ]
                },
                {
                    "sense_id": "017f2cbf-5a4d-37b0-a715-6d093bf45eca",
                    "sense_definition": "Forme d'inversion au subjonctif imparfait marquant une concession extrême équivalant à quand même.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dussé</w>-je attendre toute la journée, je ne partirai pas sans obtenir une explication claire."
                        },
                        {
                            "text": "Il terminera ce projet complexe à temps, <w>dût</w>-il y passer la nuit entière."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "tournure littéraire et soutenue"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9774107f-91e0-3373-b2d3-4a4a04c4c834",
                    "sense_definition": "Travail ou exercice scolaire prescrit par un enseignant pour être accompli en dehors des heures de cours.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "scolaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'école, les enfants terminent leur <w>devoir</w> de mathématiques avant le dîner."
                        },
                        {
                            "text": "Le professeur a distribué un long <w>devoir</w> à rendre pour lundi matin."
                        }
                    ],
                    "common_phrases": [
                        "faire ses devoirs",
                        "devoir maison"
                    ]
                },
                {
                    "sense_id": "8b3c73be-7a1d-3658-9546-b120c4961183",
                    "sense_definition": "Prescription morale, juridique ou civique imposée par la conscience, la société ou la loi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque citoyen a le <w>devoir</w> civique d'aller voter lors des élections nationales."
                        },
                        {
                            "text": "Le pompier a accompli son <w>devoir</w> avec courage malgré les flammes menaçantes."
                        }
                    ],
                    "synonyms": [
                        "obligation"
                    ],
                    "antonyms": [
                        "droit"
                    ],
                    "common_phrases": [
                        "sens du devoir",
                        "accomplir son devoir"
                    ]
                },
                {
                    "sense_id": "9af9e46b-ef96-3639-ab72-a8ea7a034cd8",
                    "sense_definition": "Témoignages de respect et hommage funèbre solennel accordés à une personne décédée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la ville est venue rendre les derniers <w>devoirs</w> au maire disparu."
                        },
                        {
                            "text": "Les proches se sont réunis en silence pour lui rendre cet ultime <w>devoir</w>."
                        }
                    ],
                    "synonyms": [
                        "funérailles",
                        "obsèques"
                    ],
                    "common_phrases": [
                        "derniers devoirs"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "souvent employé au pluriel dans des contextes formels"
                        }
                    ]
                }
            ]
        }
    ]
}