                "senses": [
                    {
                        "sense_id": "35f9a2df-6974-378a-b6fe-f0824209ca46",
                        "entry_id": "34fdc5a5-0cfe-3f7d-9469-a4a080854849",
                        "glosses": [
                            "To bear; to endure; to tolerate."
                        ],
                        "tags": [
                            "dialectal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3eecee91-ef42-4157-b6eb-6969500f5e4b",
                                "sense_id": "35f9a2df-6974-378a-b6fe-f0824209ca46",
                                "text": "And doubting naught right courteous all, in your accustomed wont: And gentle ears, our author he is prest to bide the brunt"
                            }
                        ]
                    },
                    {
                        "sense_id": "832e0bad-9cd5-3344-9c82-c0d86f113d95",
                        "entry_id": "34fdc5a5-0cfe-3f7d-9469-a4a080854849",
                        "glosses": [
                            "To face with resistance; to encounter; to withstand."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "224e093e-5637-4986-ba90-975d90000f6d",
                                "sense_id": "832e0bad-9cd5-3344-9c82-c0d86f113d95",
                                "text": "Tech[elles]. I heare them come, ſhall wee encounter them? / Tam[burlaine]. Keep all your ſtandings, and not ſtir a foot, / Myſelfe will bide the danger of the brunt."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ab5bd74-6c9c-3e57-8fc4-88807d9af641",
                        "entry_id": "34fdc5a5-0cfe-3f7d-9469-a4a080854849",
                        "glosses": [
                            "To dwell or reside in a location; to abide."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b2699705-8314-4753-916b-99dda9ecbf6f",
                                "sense_id": "3ab5bd74-6c9c-3e57-8fc4-88807d9af641",
                                "text": "All knees to thee shall bow of them that bide / In heaven or earth, or under earth, in hell."
                            },
                            {
                                "example_id": "bd88d747-4921-4271-9893-729b14919716",
                                "sense_id": "3ab5bd74-6c9c-3e57-8fc4-88807d9af641",
                                "text": "John Dodds, the herd who bode in the place, was standing at the door, and he looked to see who was on the road so late."
                            }
                        ]
                    },
                    {
                        "sense_id": "35056928-2646-32d9-8262-dc49aa7ca1f4",
                        "entry_id": "34fdc5a5-0cfe-3f7d-9469-a4a080854849",
                        "glosses": [
                            "To wait; to be in expectation; to stay; to remain."
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dda5c4db-2f5f-4892-869d-784ba9ccee1d",
                                "sense_id": "35056928-2646-32d9-8262-dc49aa7ca1f4",
                                "text": "And thither wending there that night they bode."
                            },
                            {
                                "example_id": "0b833678-5949-4327-9a97-604848adaf00",
                                "sense_id": "35056928-2646-32d9-8262-dc49aa7ca1f4",
                                "text": "\"Bide here,\" he says, \"and birl the wine till I return. This is a ploy of my own on which no man follows me.\""
                            },
                            {
                                "example_id": "2c3877dc-67e1-4791-af69-d4f0c7f8c6c1",
                                "sense_id": "35056928-2646-32d9-8262-dc49aa7ca1f4",
                                "text": "It’s you, it’s you must go and I must bide."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a275ff5-c038-3be9-8751-e4d3dca12794",
                        "entry_id": "34fdc5a5-0cfe-3f7d-9469-a4a080854849",
                        "glosses": [
                            "To wait for; to await."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02c536aa-a08b-4016-b135-b4cb6f99588b",
                        "source_entry_id": "34fdc5a5-0cfe-3f7d-9469-a4a080854849",
                        "source_sense_description": "(intransitive) (archaic or dialectal) To wait; to be in expectation; to stay; to remain",
                        "target_lang_word": "čekat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "čekat",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "36345acf-e22d-3648-9e28-b3e45847c7b0",
                                        "entry_id": "b08b9dfc-5ff3-35a7-9fd9-25bf99cc0905",
                                        "glosses": [
                                            "(čekat na + akuzativ) zůstávat někde, než se něco stane"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4205c95-6eaf-4a39-be97-a8472aee5f03",
                                                "sense_id": "36345acf-e22d-3648-9e28-b3e45847c7b0",
                                                "text": "Čekal na příjezd vlaku."
                                            },
                                            {
                                                "example_id": "681bf707-e370-4879-a669-07d4a3e4e6e9",
                                                "sense_id": "36345acf-e22d-3648-9e28-b3e45847c7b0",
                                                "text": "Hele, tady je to jako na vojně: spěchá se, aby se čekalo, a čeká se, aby se spěchalo."
                                            },
                                            {
                                                "example_id": "e6da69fe-1a32-489d-b5c9-6dec308b8649",
                                                "sense_id": "36345acf-e22d-3648-9e28-b3e45847c7b0",
                                                "text": "»Musil jsem čekat, až mně vyplatí peníze,« odvětil muž sebevědomě."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07ebc09-4d15-3e73-b9eb-27e44da0613f",
                                        "entry_id": "b08b9dfc-5ff3-35a7-9fd9-25bf99cc0905",
                                        "glosses": [
                                            "myslet, že se něco stane"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc1bf595-b964-4221-8ef2-6fd5370f5602",
                                                "sense_id": "a07ebc09-4d15-3e73-b9eb-27e44da0613f",
                                                "text": "Čekal, že přijedou, ale nepřijeli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47767d00-043b-382e-b445-680be6c66b3a",
                                        "entry_id": "b08b9dfc-5ff3-35a7-9fd9-25bf99cc0905",
                                        "glosses": [
                                            "(čekat s + instrumentál) odkládat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f473fa1e-903e-49ce-9207-0a170174ad7c",
                                                "sense_id": "47767d00-043b-382e-b445-680be6c66b3a",
                                                "text": "Čekal se zahájením až do pozdních hodin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2689a10c-d9c5-34d3-b514-3073e6bc6bfe",
                                        "entry_id": "b08b9dfc-5ff3-35a7-9fd9-25bf99cc0905",
                                        "glosses": [
                                            "být připraven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68578a70-e575-45b3-9eee-89b40d870c89",
                                                "sense_id": "2689a10c-d9c5-34d3-b514-3073e6bc6bfe",
                                                "text": "Čekal, co se stane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a80b349-ecf1-3208-a641-70809aa08366",
                                        "entry_id": "b08b9dfc-5ff3-35a7-9fd9-25bf99cc0905",
                                        "glosses": [
                                            "vypadat nutně"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289c7859-296e-4915-bf99-98c4586f585c",
                                                "sense_id": "3a80b349-ecf1-3208-a641-70809aa08366",
                                                "text": "Čeká ho trest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a3efcaa-7510-4b18-9392-e86897b6d9c8",
                        "source_entry_id": "34fdc5a5-0cfe-3f7d-9469-a4a080854849",
