                "senses": [
                    {
                        "sense_id": "79e59f64-0904-37c4-99df-ac8fee2906a1",
                        "entry_id": "20af17a3-4c2f-34ce-8ec7-30a93bb54e7d",
                        "glosses": [
                            "Lokalität, in der Jazz gespielt wird"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "efcda05c-1a4e-44c3-a9ad-9356c02cd5a6",
                                "sense_id": "79e59f64-0904-37c4-99df-ac8fee2906a1",
                                "text": "„In den ersten Tagen seit seiner Rückkehr war er im banalen Alltag rumgedümpelt, hatte sich in seinen Sessel vergraben, sich ins Bett gelegt und der Welt den Hintern zugedreht, hin und wieder hatte er auch mal in Jazzbuden rumgerockt, mit alten Typen palavert, neuen Leuten zugehört, aber nur selten mitgemischt.“"
                            },
                            {
                                "example_id": "fc77d3a3-07b8-4bdf-862f-b54a5ef2b31f",
                                "sense_id": "79e59f64-0904-37c4-99df-ac8fee2906a1",
                                "text": "„Immerhin werden zwischen 19 Uhr und 1 Uhr zwölf Bands drei Räume des Marriott-Hotels in Jazzkeller, sagen wir lieber, in Jazzbuden verwandeln.“"
                            },
                            {
                                "example_id": "d1614e6c-c44e-478a-b2c7-3614ef435f35",
                                "sense_id": "79e59f64-0904-37c4-99df-ac8fee2906a1",
                                "text": "„Manche Betriebe, von Bars über Jazzbuden bis zu Stripteaselokalen, halten ihre Tore dennoch unverdrossen offen und buhlen um die wenigen Kunden.“"
                            },
                            {
                                "example_id": "ae3e14a9-b622-4c0d-806e-f9344ca7d68a",
                                "sense_id": "79e59f64-0904-37c4-99df-ac8fee2906a1",
                                "text": "„Vier Tage lang bespielen internationale Helden der Jazzszene die ganze Alt- und Neustadt, machen Beiseln, Kaffeehäuser und Wirtshäuser zu Jazzbuden und verlangen dabei noch nicht mal Eintritt.“"
                            },
                            {
                                "example_id": "eab32c0b-b21f-43f0-979b-6a7379c7c0c3",
                                "sense_id": "79e59f64-0904-37c4-99df-ac8fee2906a1",
                                "text": "„Ja dieses Empfinden, im Ghetto der Kirchen gefangen zu sein, erzeugt bei den lebendigsten Gemeindegliedern ein regelrechtes Heimweh nach dem draussenstehenden Bruder, ein Heimweh nach der Strasse hin: Bald tritt einer auf und redet das Evangelium in der Art und Sprache des Sportplatzes oder der Jazzbude; hier geht ein Christ in die Dancings, dort sucht einer Kontakt mit dem Kinopublikum, mit der Geschäftswelt oder mit den Politikern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
