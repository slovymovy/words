{
    "word_family": [
        "хрень",
        "хреновый",
        "хренеть"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d79a1b65-af7d-3a8e-a1dc-43da590bfbb1",
                    "sense_definition": "Стать наглым, дерзким, потерять чувство меры.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он совсем <w>охренел</w> и начал хамить всем окружающим без всякой причины.",
                            "target_lang_translations": {
                                "en": "He <w>got completely out of line</w> and started being rude to everyone around him for no reason."
                            }
                        },
                        {
                            "text": "Ты что, <w>охренел</w> так со мной разговаривать?",
                            "target_lang_translations": {
                                "en": "Are you <w>out of your mind</w> talking to me like that?"
                            }
                        }
                    ],
                    "synonyms": [
                        "обнаглеть",
                        "оборзеть"
                    ],
                    "common_phrases": [
                        "совсем охренел"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое просторечие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To become insolent, brazen, or lose all sense of propriety."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to get out of line",
                                "target_lang_sense_clarification": "to behave in an unacceptable or rude manner"
                            },
                            {
                                "target_lang_word": "to get cocky",
                                "target_lang_sense_clarification": "to become overly confident or arrogant"
                            },
                            {
                                "target_lang_word": "to lose one's mind",
                                "target_lang_sense_clarification": "idiomatic expression for acting in an absurd or rude way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91a6915a-b9f5-3408-9cd3-1cb25a669709",
                    "sense_definition": "Испытать сильное удивление или шок.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я просто <w>охренел</w>, когда узнал, сколько стоит этот старый автомобиль.",
                            "target_lang_translations": {
                                "en": "I was <w>absolutely stunned</w> when I found out how much this old car costs."
                            }
                        },
                        {
                            "text": "Все вокруг <w>охренели</w> от такой неожиданной новости.",
                            "target_lang_translations": {
                                "en": "Everyone around was <w>blown away</w> by such unexpected news."
                            }
                        }
                    ],
                    "synonyms": [
                        "обалдеть",
                        "офигеть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое просторечие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To experience intense surprise, shock, or disbelief."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be stunned",
                                "target_lang_sense_clarification": "to be shocked or surprised"
                            },
                            {
                                "target_lang_word": "to be blown away",
                                "target_lang_sense_clarification": "to be extremely impressed or shocked"
                            },
                            {
                                "target_lang_word": "to be floored",
                                "target_lang_sense_clarification": "to be completely surprised or overwhelmed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d864fdb4-7fcf-3046-affa-bd8e38b988a6",
                    "sense_definition": "Сильно страдать от чего-либо, например, от холода, голода или усталости.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы стояли на остановке два часа и просто <w>охренели</w> от холода.",
                            "target_lang_translations": {
                                "en": "We stood at the bus stop for two hours and were <w>frozen stiff</w>."
                            }
                        },
                        {
                            "text": "Я <w>охренел</w> от такой тяжелой работы за весь день.",
                            "target_lang_translations": {
                                "en": "I was <w>completely worn out</w> from such hard work all day."
                            }
                        }
                    ],
                    "common_phrases": [
                        "охренеть от холода"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое просторечие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To suffer intensely from something, such as cold, hunger, or exhaustion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be worn out",
                                "target_lang_sense_clarification": "to be extremely tired or exhausted"
                            },
                            {
                                "target_lang_word": "to be frozen stiff",
                                "target_lang_sense_clarification": "to suffer intensely from cold"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5ea25313-0d56-327f-aad9-7f8fea3aa13a",
                    "sense_definition": "Выражение сильного удивления, возмущения или шока.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Охренеть</w>! Я не ожидал увидеть тебя здесь сегодня.",
                            "target_lang_translations": {
                                "en": "<w>Holy crap</w>! I didn't expect to see you here today."
                            }
                        },
                        {
                            "text": "Ты выиграл в лотерею? <w>Охренеть</w> просто!",
                            "target_lang_translations": {
                                "en": "You won the lottery? <w>No way</w>!"
                            }
                        }
                    ],
                    "synonyms": [
                        "обалдеть",
                        "офигеть"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое просторечие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation used to express strong surprise, indignation, or shock."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "holy crap",
                                "target_lang_sense_clarification": "vulgar exclamation of surprise"
                            },
                            {
                                "target_lang_word": "no way",
                                "target_lang_sense_clarification": "expression of disbelief"
                            },
                            {
                                "target_lang_word": "holy cow",
                                "target_lang_sense_clarification": "mild exclamation of surprise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}