                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2c117bed-f3bd-320b-b38e-b64f1f4d0e46",
                        "entry_id": "97be7ae9-3069-3205-9743-70f535bc6ab5",
