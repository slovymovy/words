{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6ef9d4e-4f16-371a-9d9c-ce663c10b1d0",
                    "sense_definition": "A state of disorder or a botched situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire project turned into a complete <w>bollix</w> after the manager quit.",
                            "target_lang_translations": {
                                "ru": "Весь проект превратился в полный <w>бардак</w> после того, как уволился менеджер."
                            }
                        },
                        {
                            "text": "He made a total <w>bollix</w> of the presentation by forgetting his notes.",
                            "target_lang_translations": {
                                "ru": "Он полностью <w>запорол</w> презентацию, забыв свои записи."
                            }
                        }
                    ],
                    "synonyms": [
                        "mess",
                        "muddle",
                        "botch"
                    ],
                    "common_phrases": [
                        "make a bollix"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние беспорядка или проваленная ситуация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бардак",
                                "target_lang_sense_clarification": "разговорное обозначение полного беспорядка"
                            },
                            {
                                "target_lang_word": "провал",
                                "target_lang_sense_clarification": "неудачный результат дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2ea183c-4d7f-343a-af9a-7e53d73221d1",
                    "sense_definition": "A state of confusion or bewilderment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions were such a <w>bollix</w> that nobody knew what to do.",
                            "target_lang_translations": {
                                "ru": "Инструкции были такой <w>неразберихой</w>, что никто не знал, что делать."
                            }
                        },
                        {
                            "text": "There was a total <w>bollix</w> regarding the schedule for the meeting.",
                            "target_lang_translations": {
                                "ru": "Возникла полная <w>путаница</w> с расписанием встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "confusion",
                        "disarray"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние замешательства или неразберихи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неразбериха",
                                "target_lang_sense_clarification": "состояние путаницы и отсутствия ясности"
                            },
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "состояние, когда всё перепутано"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34f9a77d-9afa-3cd3-9368-82aa8a41de80",
                    "sense_definition": "A foolish, annoying, or unpleasant person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop acting like a <w>bollix</w> and listen to what I am saying.",
                            "target_lang_translations": {
                                "ru": "Перестань вести себя как <w>идиот</w> и слушай, что я говорю."
                            }
                        },
                        {
                            "text": "He is a total <w>bollix</w> for treating his friends that way.",
                            "target_lang_translations": {
                                "ru": "Он полный <w>придурок</w>, раз так обращается со своими друзьями."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "jerk",
                        "idiot"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly informal and offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый, раздражающий или неприятный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идиот",
                                "target_lang_sense_clarification": "грубое обозначение глупого человека"
                            },
                            {
                                "target_lang_word": "придурок",
                                "target_lang_sense_clarification": "оскорбительное обозначение неприятного человека"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9c69509-ddc7-3e36-a201-af815c8f5794",
                    "sense_definition": "To ruin or fail to perform a task correctly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to <w>bollix</w> up the repair job completely.",
                            "target_lang_translations": {
                                "ru": "Мне удалось полностью <w>запороть</w> ремонт."
                            }
                        },
                        {
                            "text": "Do not <w>bollix</w> this opportunity by being late again.",
                            "target_lang_translations": {
                                "ru": "Не <w>провалите</w> эту возможность, опоздав снова."
                            }
                        }
                    ],
                    "synonyms": [
                        "botch",
                        "bungle",
                        "ruin"
                    ],
                    "common_phrases": [
                        "bollix up"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испортить что-либо или не справиться с задачей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запороть",
                                "target_lang_sense_clarification": "разговорное: испортить дело"
                            },
                            {
                                "target_lang_word": "провалить",
                                "target_lang_sense_clarification": "не справиться с задачей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f57d38f-84ac-3003-abee-bfd27164a675",
                    "sense_definition": "To cause someone to be confused or unable to think clearly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex rules only served to <w>bollix</w> the new students.",
                            "target_lang_translations": {
                                "ru": "Сложные правила только <w>запутали</w> новых студентов."
                            }
                        },
                        {
                            "text": "His strange explanation just <w>bollixed</w> everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Его странное объяснение просто <w>сбило с толку</w> всех в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "bewilder",
                        "muddle"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and potentially offensive."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести кого-либо в замешательство, сбить с толку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбить с толку",
                                "target_lang_sense_clarification": "запутать кого-либо"
                            },
                            {
                                "target_lang_word": "запутать",
                                "target_lang_sense_clarification": "лишить ясности мышления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}