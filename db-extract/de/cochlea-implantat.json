                ],
                "senses": [
                    {
                        "sense_id": "c4395fc7-aa8d-3cc4-9cd6-cf79786429c5",
                        "entry_id": "735aee93-e0a6-31c4-9123-293eba0a8a22",
                        "glosses": [
                            "in die Hörschnecke eingepflanztes Gerät für Menschen mit geschädigtem Gehör, deren Hörnerv und Hörbahn noch funktioniert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59aab6fc-4f7b-4dd1-a8ef-f421935db05d",
                                "sense_id": "c4395fc7-aa8d-3cc4-9cd6-cf79786429c5",
                                "text": "„Mit dreieinhalb Jahren wurde ihr im linken Ohr ein so genanntes Cochlea-Implantat, eine Innenohr-Prothese, eingesetzt.“"
                            },
                            {
                                "example_id": "e9c81bde-a005-4013-b193-f675a0ac0cc6",
                                "sense_id": "c4395fc7-aa8d-3cc4-9cd6-cf79786429c5",
                                "text": "„Diese Perspektive wird wohl berücksichtigt werden müssen, wenn das Amtsgericht in Goslar demnächst darüber entscheiden soll, ob einem eineinhalb Jahre alten Kind ein Cochlea-Implantat eingepflanzt werden soll.“"
                            },
                            {
                                "example_id": "8bcaa5a0-5ef5-40ac-8b23-1f6848b0f839",
                                "sense_id": "c4395fc7-aa8d-3cc4-9cd6-cf79786429c5",
                                "text": "„Allerdings konnte er in den zurückliegenden anderthalb Jahren rund 15 Wochen weniger trainieren als geplant. Erst wegen der akuten Erkrankung und dann im Herbst 2023 noch einmal wegen einer Operation, bei der ihm ein Cochlea-Implantat eingesetzt wurde.“"
                            },
                            {
                                "example_id": "25c724f5-b315-4fae-afd6-44053cde7a70",
                                "sense_id": "c4395fc7-aa8d-3cc4-9cd6-cf79786429c5",
                                "text": "„Der Weg zu einem Cochlea-Implantat könne aufgrund der Diagnostik ein wenig länger dauern, aber es lohne sich.“"
                            },
                            {
                                "example_id": "b2eb7b9d-41b7-446e-9fa3-43dc471446a7",
                                "sense_id": "c4395fc7-aa8d-3cc4-9cd6-cf79786429c5",
                                "text": "„Das Cochlea-Implantat besteht aus einem externen Teil (bestehend aus Mikrofon, Sprachprozessor, Batterie oder Akku und Spule) und einem implantierten Teil (bestehend aus Spule, Signalprozessor mit Stimulator und Elektroden für die Stimulation).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
