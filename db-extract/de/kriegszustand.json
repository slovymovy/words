                    {
                        "form_id": "be444afd-c899-48f1-a379-a83ad467c424",
                        "entry_id": "f6755d68-0b3a-36a1-abdb-5934f8afe5e1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kriegszustände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38ed9f46-4591-3a81-b3d5-92e068921ca7",
                        "entry_id": "f6755d68-0b3a-36a1-abdb-5934f8afe5e1",
                        "glosses": [
                            "Sachverhalt, dass sich zwei Parteien miteinander im Krieg befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "075b4c06-e032-46ab-a0b8-b482afc5bfc5",
                                "sense_id": "38ed9f46-4591-3a81-b3d5-92e068921ca7",
                                "text": "„Die USA gingen ohne erklärten Kriegszustand zu offenen Angriffen auf deutsche Uboote über.“"
                            },
                            {
                                "example_id": "c4c195d0-eadf-4163-b0a9-ae1a1ef4c868",
                                "sense_id": "38ed9f46-4591-3a81-b3d5-92e068921ca7",
                                "text": "„Nun, ich bin zurzeit in einem Land, das sich nicht de jure, aber de facto im Kriegszustand befindet.“"
                            },
                            {
                                "example_id": "c5a1d1e2-58d9-411c-8dc3-1f324bbb6695",
                                "sense_id": "38ed9f46-4591-3a81-b3d5-92e068921ca7",
                                "text": "„Doch die Zuhörer konnten wenig mit der formelhaften Bekanntgabe des drohenden Kriegszustandes anfangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9742d950-cbc8-47e2-8137-969ad1bb1164",
                        "source_entry_id": "f6755d68-0b3a-36a1-abdb-5934f8afe5e1",
                        "source_sense_id": "38ed9f46-4591-3a81-b3d5-92e068921ca7",
                        "source_sense_description": "Sachverhalt, dass sich zwei Parteien miteinander im Krieg befinden",
                        "target_lang_word": "state of war",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "state of war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da207c22-31c7-35dc-8f8d-7cdc9781bd5c",
                                        "entry_id": "b0337894-8e40-358e-9cf2-e2713e9317c3",
                                        "glosses": [
                                            "A state of armed conflict between states, irrespective of a declaration of war."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e048b07c-48a7-49d6-80d9-947dc7f308c2",
                                                "sense_id": "da207c22-31c7-35dc-8f8d-7cdc9781bd5c",
                                                "text": "I ask that the Congress declare, that since the unprovoked and dastardly attack by Japan on Sunday, December 7th, 1941, a state of war has existed between the United States and the Japanese Empire."
                                            },
                                            {
                                                "example_id": "748419d6-712f-42dd-83e4-ca9861ce4702",
                                                "sense_id": "da207c22-31c7-35dc-8f8d-7cdc9781bd5c",
                                                "text": "In 1924 the Hashemite King Hussein was driven out of the Hedjaz by Ibn Saud, and a state of war sprang up between the new kingdoms of Saudi Arabia and Trans-Jordan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
