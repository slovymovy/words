                        "source_sense_id": "ddb2d23e-9d07-3c48-a88f-fd399b2ebd05",
                        "target_lang_word": "let out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "let out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eac83640-37b2-3c17-a51c-f9b3099503c2",
                                        "entry_id": "e89f4118-ae14-3ff1-85e9-4a75f4c9ba27",
                                        "glosses": [
                                            "To release."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d065f4-d1e2-4e29-bfe0-60f3246ae18a",
                                                "sense_id": "eac83640-37b2-3c17-a51c-f9b3099503c2",
                                                "text": "If you go into the aviary, don't let out any of the birds!"
                                            },
                                            {
                                                "example_id": "c0bd2f07-ac4c-430d-bd91-5b5440574d36",
                                                "sense_id": "eac83640-37b2-3c17-a51c-f9b3099503c2",
                                                "text": "I was able to let the butterfly out of the window."
                                            },
                                            {
                                                "example_id": "22d22595-9e05-4f9b-8277-3ff4ab999bae",
                                                "sense_id": "eac83640-37b2-3c17-a51c-f9b3099503c2",
                                                "text": "The students were let out of school early."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f335ad26-09c5-3cad-b155-9de88d068982",
                                        "entry_id": "e89f4118-ae14-3ff1-85e9-4a75f4c9ba27",
                                        "glosses": [
                                            "Of a school: to finish for the day or term, allowing the pupils to go home."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21eda087-7cdc-43fe-83b2-e47d4968c639",
                                                "sense_id": "f335ad26-09c5-3cad-b155-9de88d068982",
                                                "text": "We're gonna have practice tomorrow morning for an assembly we're giving on Thursday before school lets out for Easter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd57ad37-47b5-3698-81b9-584ba0c53237",
                                        "entry_id": "e89f4118-ae14-3ff1-85e9-4a75f4c9ba27",
                                        "glosses": [
                                            "To allow to operate at higher speed by adjusting controls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b98802ac-4be2-44a2-a7a7-79d95f2c4efb",
                                                "sense_id": "bd57ad37-47b5-3698-81b9-584ba0c53237",
                                                "text": "He let out the reins when they were a mile from the barn."
                                            },
                                            {
                                                "example_id": "94788549-4d2a-4596-be17-c4618bb6625b",
                                                "sense_id": "bd57ad37-47b5-3698-81b9-584ba0c53237",
                                                "text": "The engineer let out the throttle after the train crossed the bridge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a5e695-9b31-3a16-b040-e8bf56b344ac",
                                        "entry_id": "e89f4118-ae14-3ff1-85e9-4a75f4c9ba27",
                                        "glosses": [
                                            "To rent out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0992f2b0-0b22-4f6a-bd74-69f77cd6464b",
                                                "sense_id": "05a5e695-9b31-3a16-b040-e8bf56b344ac",
                                                "text": "We let out the house and went on a two-year world trip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0682f1fb-0d5d-3ac2-abbc-9d6077eed7a4",
                                        "entry_id": "e89f4118-ae14-3ff1-85e9-4a75f4c9ba27",
                                        "glosses": [
                                            "To enlarge by adjusting one or more seams."
                                        ],
                                        "tags": [
                                            "of clothing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "701c24ed-f877-42dd-90de-9517d01b20b1",
                                                "sense_id": "0682f1fb-0d5d-3ac2-abbc-9d6077eed7a4",
                                                "text": "After the holidays he had to have his suits let out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f8cad6-0e6f-35ff-839f-26a7adb379e3",
                                        "entry_id": "e89f4118-ae14-3ff1-85e9-4a75f4c9ba27",
                                        "glosses": [
                                            "Of sound, to emit."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d96b6876-b595-4438-afc0-0bf694bc0b69",
                                                "sense_id": "71f8cad6-0e6f-35ff-839f-26a7adb379e3",
                                                "text": "The dog let out a yelp."
                                            },
                                            {
                                                "example_id": "ad6b3bf0-ca7d-4756-b8e8-ea128c140bf8",
                                                "sense_id": "71f8cad6-0e6f-35ff-839f-26a7adb379e3",
                                                "text": "For a moment Mr. Stink fell silent. Then he opened his mouth and let out the deepest darkest dirtiest burp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e644f37-ed28-335a-a8c7-6e1f70789b7c",
                                        "entry_id": "e89f4118-ae14-3ff1-85e9-4a75f4c9ba27",
                                        "glosses": [
                                            "To disclose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09af02bc-41da-41ba-98e7-4d614a4dca28",
                                                "sense_id": "2e644f37-ed28-335a-a8c7-6e1f70789b7c",
                                                "text": "He accidentally let out the location for the meeting."
                                            }
                                        ]
