    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c60f1be6-9c21-38ca-9f22-4991a7207563",
                "word": "Barnaby",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1bf807c-ff28-31ad-8f7b-cdb70faeda6d",
                        "entry_id": "c60f1be6-9c21-38ca-9f22-4991a7207563",
                        "glosses": [
                            "A male given name from Hebrew, from the medieval vernacular form of Barnabas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9dd5a7c-e15a-4768-be68-b1957a47e6bc",
                                "sense_id": "c1bf807c-ff28-31ad-8f7b-cdb70faeda6d",
                                "text": "This day the sun is in his chiefest height\nWith Barnaby the Bright."
                            },
                            {
                                "example_id": "d28fff83-5a1c-4f4a-8767-9558d7f3b709",
                                "sense_id": "c1bf807c-ff28-31ad-8f7b-cdb70faeda6d",
                                "text": "The name Barnaby may strike the reader as out of place in so Celtic a pedigree; but this was an anglicisation of the true name, Brian Oge - - - Now, times are altered, and his anglicised descendants will probably begin to use Brian as a family name again, rejecting Barnaby as less respectable."
                            },
                            {
                                "example_id": "ae075527-bbd8-42f9-aa27-8827e73905bd",
                                "sense_id": "c1bf807c-ff28-31ad-8f7b-cdb70faeda6d",
                                "text": "Barnaby liked his own name. He was proud of its differentness and would never answer to \"Barney\", or any other nickname."
                            },
                            {
                                "example_id": "9b97f47d-8d4d-4d6c-85d7-993f680f79e5",
                                "sense_id": "c1bf807c-ff28-31ad-8f7b-cdb70faeda6d",
                                "text": "But instead of pressing the button that would have taped the play she pressed the button that activated the built-in microphone and recorded a hundred and twenty minutes of hers and Barnaby's home life, which aurally consisted of 'Want a cup of tea?' 'No thanks.'"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cdfee61e-7248-33d3-85bd-70e7338ca4c3",
                "word": "Barnaby",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e4001b1-b7e3-38a2-966d-16b4af455f26",
                        "entry_id": "cdfee61e-7248-33d3-85bd-70e7338ca4c3",
                        "glosses": [
                            "A lively and fast-paced dance; (by extension) any quick and uneven movement."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5d1cc284-6c94-4340-91dd-c64763c8caff",
                                "sense_id": "8e4001b1-b7e3-38a2-966d-16b4af455f26",
                                "text": "Bounce cry the port-holes, out they fly\nAnd make the world dance Barnaby."
                            },
                            {
                                "example_id": "032dff15-2b38-43ed-9e58-77f9649e5507",
                                "sense_id": "8e4001b1-b7e3-38a2-966d-16b4af455f26",
                                "text": "It was a regular Barnaby dance; I'd never seen anyone move so quickly. Before the culprit bolted out the door into the night,"
                            },
                            {
                                "example_id": "d5feafb0-ffb7-4ec0-b863-b4e6c501ba7a",
                                "sense_id": "8e4001b1-b7e3-38a2-966d-16b4af455f26",
                                "text": "\"Owell gave me this. Said to get it to you in a Barnaby dance. 'Ere it is.\" His tongue scraped across his lower lip as he stared at Charity."
                            },
                            {
                                "example_id": "d3942b4e-f59f-4dcc-b9a5-30dc7429db3d",
                                "sense_id": "8e4001b1-b7e3-38a2-966d-16b4af455f26",
                                "text": "We were now doing a strange sort of Barnaby dance: shuffling to and fro as I blocked his attempts to set off in pursuit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
