                ],
                "senses": [
                    {
                        "sense_id": "dc698430-aa22-3ad1-996b-723aaa0806c7",
                        "entry_id": "8cbbee50-65a5-3c32-92c1-3152c90e5014",
                        "glosses": [
                            "Betreiber eines Einzelhandelsunternehmens mit zahlreichen Filialen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324cd44e-705a-4210-8e28-5cd46282e75e",
                                "sense_id": "dc698430-aa22-3ad1-996b-723aaa0806c7",
                                "text": "„Lars, 16, und Meike, 14, Schlecker, Kinder des größten deutschen Drogeriefilialisten Anton Schlecker, werden aus dem Elternhaus verschleppt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0be28ece-23bc-3423-8416-ea58a5f45fe4",
                        "entry_id": "8cbbee50-65a5-3c32-92c1-3152c90e5014",
                        "glosses": [
                            "Einzelhandelsunternehmen, das über viele Filialen verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a579bbb7-596e-4235-912d-c1abfbdb22c5",
                                "sense_id": "0be28ece-23bc-3423-8416-ea58a5f45fe4",
                                "text": "„Die Restrukturierungspläne von Thalia, Deutschlands größtem Filialisten, versetzen die Buch-Branche in Aufruhr.“"
                            },
                            {
                                "example_id": "cb256c5c-e3d2-4933-a951-244ecb7088d0",
                                "sense_id": "0be28ece-23bc-3423-8416-ea58a5f45fe4",
                                "text": "„Das Unternehmens [sic!] ist heute mit 600 Läden der größte Filialist in der Türkei.“"
                            },
                            {
                                "example_id": "81f99273-cee4-4f2d-8a77-142b7fb3ca59",
                                "sense_id": "0be28ece-23bc-3423-8416-ea58a5f45fe4",
                                "text": "„Lange hatten große Markenhersteller eher Schwierigkeiten, sich modisch gegen massiv expandierende Filialisten wie Zara und H&M zu behaupten, deren Produkte ohne prominentes Logo auskommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "80ccbfe4-1a54-3319-a569-21d6749be650",
                        "entry_id": "8cbbee50-65a5-3c32-92c1-3152c90e5014",
                        "glosses": [
                            "Leiter in der Filiale eines Einzelhandelsunternehmens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed460309-283f-489e-af1c-5b82ff1632d4",
                                "sense_id": "80ccbfe4-1a54-3319-a569-21d6749be650",
                                "text": "Der Schwager Theobald ist nun zum Filialisten bei unserem örtlichen Lebensmitteldiscounter aufgestiegen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "5c00b47c-d81f-393a-97db-97e01012a85a",
                        "entry_id": "8cbbee50-65a5-3c32-92c1-3152c90e5014",
                        "glosses": [
                            "Seelsorger in einer Filialgemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c5b0cee-4f79-4e9b-b42d-7338212fbb9b",
                                "sense_id": "5c00b47c-d81f-393a-97db-97e01012a85a",
                                "text": "„Sollen aber diese sonntägigen Prüfungen jetzt noch beibehalten werden, so dehne man die Verpflichtung zur Theilnahme an denselben wenigstens nicht, wie in Sachsen gewöhnlich, bis zum 20., sondern bloß, wie die großherzogl. weimarische Anordnung passender vorschreibt, bis zum 16. Lebensjahre aus, gestatte aber auch dem Geistlichen, besonders wenn er Filialist ist, daß er an Sonntagen, wo er Beichte und Communion abzuhalten, auch wohl noch andere Amtsverrichtungen zu vollziehen hat, die Examina aussetze; […]“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "8ea8eed0-2300-38be-aaa3-0bc0c69d43a1",
                        "entry_id": "8cbbee50-65a5-3c32-92c1-3152c90e5014",
                        "glosses": [
                            "Mitglied einer Filialgemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7972b45-433f-4b0d-9528-beaaf035c61c",
                                "sense_id": "8ea8eed0-2300-38be-aaa3-0bc0c69d43a1",
                                "text": "Heute fanden sich nur fünf Filialisten ein."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
