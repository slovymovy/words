                "senses": [
                    {
                        "sense_id": "1158177e-0357-357b-80c1-a238aaea6219",
                        "entry_id": "7369227c-79a7-3aa0-89b9-a98db4878ff8",
                        "glosses": [
                            "Hund, der darauf trainiert ist, an Unfall- oder Katastrophenorten Leichen zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85cbb5ac-4f4a-4ac4-b8ee-6c4ca88e7817",
                                "sense_id": "1158177e-0357-357b-80c1-a238aaea6219",
                                "text": "„Zu den Ergebnissen der Suche, an der auch zwei Leichenspürhunde beteiligt waren, wurden zunächst keine Angaben gemacht.“"
                            },
                            {
                                "example_id": "b3ba032a-033c-47e8-93d6-df7a1cbee739",
                                "sense_id": "1158177e-0357-357b-80c1-a238aaea6219",
                                "text": "„Es ist stets derselbe Ablauf: Zunächst wird ein Rettungshund von seinem Führer durch die Trümmer geleitet, dann folgt ein Leichenspürhund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
