        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
                "word": "pusher",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "78a70473-3871-4afb-a60d-433449c1ee54",
                        "entry_id": "1f0956ae-f7ce-3888-a6ec-e93a11aca3ea",
