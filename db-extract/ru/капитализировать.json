                "translations": [
                    {
                        "translation_id": "f60919cf-3548-435c-9d24-31f25c9b9597",
                        "source_entry_id": "3b5f0fdf-3b87-3bdd-8a56-fde02a802e84",
                        "target_lang_word": "capitalize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capitalize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e549d42-7c35-3c97-b1d5-bfda4d59594e",
                                        "entry_id": "914dd400-fa26-39bb-81ab-25ba709e5703",
                                        "glosses": [
                                            "In writing or editing, to write (something: either an entire word or text, or just the initial letter(s) thereof) in capital letters, in upper case."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca38a0ae-32a5-4843-b338-c7351b5bb715",
                                                "sense_id": "7e549d42-7c35-3c97-b1d5-bfda4d59594e",
                                                "text": "In German, all nouns are capitalized."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1102f8f-09f9-3a1e-95e2-6d2c1281ca09",
                                        "entry_id": "914dd400-fa26-39bb-81ab-25ba709e5703",
                                        "glosses": [
                                            "To contribute or acquire capital (money or other resources) for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3139cdc7-2909-41a6-ae71-e3327ed168ef",
                                                "sense_id": "e1102f8f-09f9-3a1e-95e2-6d2c1281ca09",
                                                "text": "Some states require proof that a new venture is properly capitalized before the state will issue a certificate of incorporation."
                                            },
                                            {
                                                "example_id": "0a62461c-530d-490a-a8dc-05d2ad63501f",
                                                "sense_id": "e1102f8f-09f9-3a1e-95e2-6d2c1281ca09",
                                                "text": "To have any hope of success a new venture must be properly capitalized."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ff6ddd-a8fe-3b2e-9819-8b4afba3a200",
                                        "entry_id": "914dd400-fa26-39bb-81ab-25ba709e5703",
                                        "glosses": [
                                            "To convert into capital, i.e., to get cash or similar immediately fungible resources for some less fungible property or source of future income."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aeb10513-ed4d-40e4-b50c-0ca30125ae17",
                                                "sense_id": "f3ff6ddd-a8fe-3b2e-9819-8b4afba3a200",
                                                "text": "If we obtain a loan using the business as collateral, the effect will be to capitalize our next ten years of income, giving us cash today that we can use to buy out our competitor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec4f93e-b880-3533-9936-b65d7456a312",
                                        "entry_id": "914dd400-fa26-39bb-81ab-25ba709e5703",
                                        "glosses": [
                                            "To treat as capital, not as an expense."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ea4416f-9d54-38ca-ae09-1ad1b42907c1",
                                        "entry_id": "914dd400-fa26-39bb-81ab-25ba709e5703",
                                        "glosses": [
                                            "To profit or to obtain an advantage."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddda0889-fbbc-4f1a-9873-afb327595d26",
                                                "sense_id": "2ea4416f-9d54-38ca-ae09-1ad1b42907c1",
                                                "text": "The home team took several shots on goal but was unable to capitalize until late in the game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978487da-d320-3613-ba9e-83519d8d540d",
                                        "entry_id": "914dd400-fa26-39bb-81ab-25ba709e5703",
                                        "glosses": [
                                            "To seize, as an opportunity; to obtain a benefit from; to invest on something profitable."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2bc1d4-1464-4565-812b-2c263e3f1d4d",
                                                "sense_id": "978487da-d320-3613-ba9e-83519d8d540d",
                                                "text": "The home team appeared to have the advantage throughout the game, and finally capitalized on their opponents' weakness with just two minutes remaining, scoring several points in quick succession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
