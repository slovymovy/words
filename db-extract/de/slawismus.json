                "senses": [
                    {
                        "sense_id": "071f5f34-8c6c-3ed9-902c-220d9e846d6c",
                        "entry_id": "f295c101-1d26-33f8-97b5-7e9c55dab42e",
                        "glosses": [
                            "Wort oder anderes sprachliches Element aus einer der slawischen Sprachen, das in eine andere Sprache entlehnt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1dd598-3b65-44f9-af29-0b1e643b3be5",
                                "sense_id": "071f5f34-8c6c-3ed9-902c-220d9e846d6c",
                                "text": "„Das Korpus enthält 44 Slawismen.“"
                            },
                            {
                                "example_id": "d98c74a6-930b-429d-8294-cc73149b021a",
                                "sense_id": "071f5f34-8c6c-3ed9-902c-220d9e846d6c",
                                "text": "„Der überregionalen Verständlichkeit wegen wurden zum Beispiel in jiddischen Büchern, die in Osteuropa verfasst und gedruckt wurden, Slawismen vermieden, obwohl diese schon längst Teil des gesprochenen Ostjiddisch gewesen sein müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
