                ],
                "senses": [
                    {
                        "sense_id": "5d617c1b-7cb5-3482-95f5-198786dc8563",
                        "entry_id": "0a3c7a2f-f336-3289-9a3c-1ebed50f94c9",
                        "glosses": [
                            "mieszkaniec miasta Padwy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41b6317-a23b-437d-abdf-8c1fbfb1b213",
                                "sense_id": "5d617c1b-7cb5-3482-95f5-198786dc8563",
                                "text": "Padewczycy bardzo kochają swojego patrona."
                            },
                            {
                                "example_id": "3f1a4425-175c-4727-854c-587ad0fcacd9",
                                "sense_id": "5d617c1b-7cb5-3482-95f5-198786dc8563",
                                "text": "Uger Buzzacarini był padewczykiem, wykształcony na tamtejszym uniwersytecie, został sprowadzony do Polski prawdopodobnie przez (…) Sulisława kanonika krakowskiego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1646d024-f1cc-364d-858b-2ad8df85683a",
                        "entry_id": "0a3c7a2f-f336-3289-9a3c-1ebed50f94c9",
                        "glosses": [
                            "student (absolwent) Uniwersytetu Padewskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6038bcc8-c4ee-43bb-ae5e-9dc6fff35635",
                                "sense_id": "1646d024-f1cc-364d-858b-2ad8df85683a",
                                "text": "Do grupy tych najwszechstronniej wykształconych pod względem formalnym należą przede wszystkim padewczycy, przebywający w różnych latach, niekiedy równocześnie, w uniwersytecie padewskim"
                            },
                            {
                                "example_id": "b6ce3278-32ff-4116-872f-483ed8fc2d6d",
                                "sense_id": "1646d024-f1cc-364d-858b-2ad8df85683a",
                                "text": "Aby lepiej zrozumieć, na czym ta analogiczność «De optimo senatore» względem dzieła Cycerona miałaby polegać, należy przypomnieć, że jednym z padewczyków współpracujących z Nideckim przy edycji fragmentów był Jan Kochanowski"
                            },
                            {
                                "example_id": "02cb41fb-658e-4962-955e-b26b4c264a1f",
                                "sense_id": "1646d024-f1cc-364d-858b-2ad8df85683a",
                                "text": "W roku 1565 szeregi dawnych padewczyków w kancelarii królewskiej u boku Myszkowskiego zasilił przedstawiciel młodszego już pokolenia — Jan Zamoyski, przyszły podkanclerzy, a potem kanclerz i hetman wielki koronny"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
