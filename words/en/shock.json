{
    "word_family": [
        "shocker",
        "shocking",
        "shockproof",
        "aftershock",
        "shockable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea3fc00e-bf2e-318a-8943-3e6976db3ad5",
                    "sense_definition": "A sudden or violent mental or emotional disturbance; something that causes intense surprise or upset.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of his resignation came as a huge <w>shock</w> to the team.",
                            "target_lang_translations": {
                                "ru": "Новость о его отставке стала огромным <w>шоком</w> для команды.",
                                "zh": "他辞职的消息让团队感到非常<w>震惊</w>。"
                            }
                        },
                        {
                            "text": "It was a terrible <w>shock</w> to discover that the house had been sold.",
                            "target_lang_translations": {
                                "ru": "Было ужасным <w>ударом</w> узнать, что дом был продан.",
                                "zh": "发现房子已经被卖掉，这真是一个可怕的<w>打击</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "surprise",
                        "astonishment",
                        "amazement",
                        "jolt",
                        "blow"
                    ],
                    "common_phrases": [
                        "culture shock",
                        "a big shock",
                        "come as a shock",
                        "recover from the shock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное или сильное душевное или эмоциональное потрясение; то, что вызывает сильное удивление или расстройство.",
                        "zh": "指突然或剧烈的精神或情感上的震动；引起强烈惊讶或不安的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шок",
                                "target_lang_sense_clarification": "сильное эмоциональное потрясение"
                            },
                            {
                                "target_lang_word": "потрясе́ние",
                                "target_lang_sense_clarification": "глубокое переживание"
                            },
                            {
                                "target_lang_word": "уда́р",
                                "target_lang_sense_clarification": "перен. неожиданная беда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震惊",
                                "target_lang_sense_clarification": "强烈的精神震动"
                            },
                            {
                                "target_lang_word": "打击",
                                "target_lang_sense_clarification": "指令人难受的意外事件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59c539fb-30e2-3ef4-8dd0-b5e190dc1095",
                    "sense_definition": "A sudden burst of electrical energy hitting a person or animal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "electric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful with that loose wire or you might get a <w>shock</w>.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен с этим оголенным проводом, иначе можешь получить <w>удар током</w>.",
                                "zh": "小心那根松动的电线，否则你可能会<w>触电</w>。"
                            }
                        },
                        {
                            "text": "The static <w>shock</w> from the doorknob made him jump.",
                            "target_lang_translations": {
                                "ru": "Статический <w>разряд</w> от дверной ручки заставил его подпрыгнуть.",
                                "zh": "门把手上的静电<w>电击</w>让他跳了起来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric shock",
                        "get a shock",
                        "static shock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный разряд электрической энергии, поражающий человека или животное.",
                        "zh": "电流突然通过人体或动物身体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́р то́ком",
                                "target_lang_sense_clarification": "поражение электричеством"
                            },
                            {
                                "target_lang_word": "электрошо́к",
                                "target_lang_sense_clarification": "медицинское или техническое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触电",
                                "target_lang_sense_clarification": "遭受电流冲击"
                            },
                            {
                                "target_lang_word": "电击",
                                "target_lang_sense_clarification": "电流造成的冲击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1fd7a12-b5a8-3624-92a7-f8fd96ad8211",
                    "sense_definition": "A state of distress or numbness following a mental or emotional disturbance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat there in <w>shock</w>, unable to speak or move after the accident.",
                            "target_lang_translations": {
                                "ru": "Она сидела в <w>шоке</w>, не в силах говорить или двигаться после аварии.",
                                "zh": "事故发生后，她坐在那里处于<w>休克</w>状态，无法说话或移动。"
                            }
                        },
                        {
                            "text": "The victims were treated for <w>shock</w> and minor injuries at the scene.",
                            "target_lang_translations": {
                                "ru": "Пострадавшим оказали помощь от <w>шока</w> и незначительных травм на месте происшествия.",
                                "zh": "受害者在现场接受了针对<w>休克</w>和轻微伤的治疗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bewilderment",
                        "stupefaction"
                    ],
                    "common_phrases": [
                        "in shock",
                        "state of shock",
                        "go into shock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние дистресса или оцепенения после душевного или эмоционального потрясения.",
                        "zh": "在精神或情感受到冲击后出现的痛苦或麻木状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шок",
                                "target_lang_sense_clarification": "психологическое состояние"
                            },
                            {
                                "target_lang_word": "шо́ковое состоя́ние",
                                "target_lang_sense_clarification": "состояние оцепенения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "休克",
                                "target_lang_sense_clarification": "心理上的麻木状态"
                            },
                            {
                                "target_lang_word": "惊恐状态",
                                "target_lang_sense_clarification": "受惊后的心理反应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96aaef9e-6f9b-3a9c-a805-6b73a65c8f5e",
                    "sense_definition": "A sudden, heavy physical impact or collision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shock</w> of the landing caused the airplane's gear to collapse.",
                            "target_lang_translations": {
                                "ru": "<w>Удар</w> при посадке привел к поломке шасси самолета.",
                                "zh": "着陆时的<w>冲击</w>导致飞机的起落架坍塌了。"
                            }
                        },
                        {
                            "text": "These running shoes are designed to absorb the <w>shock</w> of each step.",
                            "target_lang_translations": {
                                "ru": "Эти беговые кроссовки созданы, чтобы поглощать <w>ударную нагрузку</w> при каждом шаге.",
                                "zh": "这些跑鞋的设计旨在吸收每一步产生的<w>震动</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "absorb the shock",
                        "withstand the shock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, сильный физический удар или столкновение.",
                        "zh": "突然且强烈的物理撞击或碰撞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́р",
                                "target_lang_sense_clarification": "физическое воздействие"
                            },
                            {
                                "target_lang_word": "толчо́к",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "сотрясе́ние",
                                "target_lang_sense_clarification": "вибрация от удара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲击",
                                "target_lang_sense_clarification": "物理上的撞击力"
                            },
                            {
                                "target_lang_word": "震动",
                                "target_lang_sense_clarification": "撞击产生的晃动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65e9e9c7-626b-38fb-8c94-20bd3b403edc",
                    "sense_definition": "A critical medical condition where the body is not getting enough blood flow, often life-threatening.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient went into <w>shock</w> due to severe blood loss.",
                            "target_lang_translations": {
                                "ru": "У пациента наступил <w>шок</w> из-за сильной кровопотери.",
                                "zh": "由于严重失血，病人陷入了<w>休克</w>。"
                            }
                        },
                        {
                            "text": "Paramedics arrived quickly to treat the driver for <w>shock</w>.",
                            "target_lang_translations": {
                                "ru": "Парамедики быстро прибыли, чтобы вывести водителя из состояния <w>шока</w>.",
                                "zh": "医护人员迅速赶到，对司机进行<w>休克</w>救治。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "anaphylactic shock",
                        "septic shock",
                        "go into shock"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критическое медицинское состояние, при котором организм получает недостаточно крови; часто угрожает жизни.",
                        "zh": "一种危及生命的医学状况，通常由血液循环不足引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шок",
                                "target_lang_sense_clarification": "медицинский диагноз"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "休克",
                                "target_lang_sense_clarification": "医学上的危急状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b084056-3385-3740-add9-a90a40d27009",
                    "sense_definition": "A mechanical device used to dampen sudden movements or impacts; a shock absorber.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic told me that the rear <w>shocks</w> on my truck need replacing.",
                            "target_lang_translations": {
                                "ru": "Механик сказал мне, что задние <w>амортизаторы</w> на моем грузовике требуют замены.",
                                "zh": "修理工告诉我，我卡车上的后<w>减震器</w>需要更换。"
                            }
                        },
                        {
                            "text": "Good <w>shocks</w> make driving on a bumpy road much more comfortable.",
                            "target_lang_translations": {
                                "ru": "Хорошие <w>амортизаторы</w> делают езду по неровной дороге гораздо комфортнее.",
                                "zh": "好的<w>减震器</w>能让在颠簸路面上行驶变得舒适得多。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rear shocks",
                        "new shocks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for shock absorber"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое устройство, используемое для гашения резких движений или ударов; амортизатор.",
                        "zh": "用于减缓突然运动或冲击的机械装置；减震器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амортиза́тор",
                                "target_lang_sense_clarification": "техническая деталь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减震器",
                                "target_lang_sense_clarification": "车辆上的机械部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31722553-6c9d-35c9-b338-e35994e547ee",
                    "sense_definition": "A thick, messy bunch or tuft of hair.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy had a messy <w>shock</w> of red hair that covered his eyes.",
                            "target_lang_translations": {
                                "ru": "У мальчика была растрепанная <w>копна</w> рыжих волос, закрывавшая глаза.",
                                "zh": "那个男孩有一头遮住眼睛的、乱蓬蓬的红发<w>乱蓬蓬的头发</w>。"
                            }
                        },
                        {
                            "text": "She recognized him by the <w>shock</w> of white hair standing up on his head.",
                            "target_lang_translations": {
                                "ru": "Она узнала его по <w>копне</w> седых волос, торчащих на голове.",
                                "zh": "她认出了他，因为他头上有一簇竖起来的白发<w>乱蓬蓬的头发</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mop"
                    ],
                    "common_phrases": [
                        "shock of hair",
                        "shock of white hair"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "descriptive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Густая, спутанная копна или пучок волос.",
                        "zh": "浓密且凌乱的一簇头发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копна́",
                                "target_lang_sense_clarification": "о волосах"
                            },
                            {
                                "target_lang_word": "ша́пка",
                                "target_lang_sense_clarification": "перен. о густых волосах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乱蓬蓬的头发",
                                "target_lang_sense_clarification": "形容头发浓密凌乱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a94cb60-4664-30c8-9fec-b28bb7da4069",
                    "sense_definition": "To cause someone to feel surprised, upset, or offended.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise <w>shocked</w> the baby and made her cry.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий шум <w>испугал</w> ребенка и заставил его плакать.",
                                "zh": "突如其来的巨大噪音<w>惊吓</w>到了婴儿，让她哭了起来。"
                            }
                        },
                        {
                            "text": "It <w>shocked</w> us to learn how much money had been stolen.",
                            "target_lang_translations": {
                                "ru": "Нас <w>шокировало</w>, когда мы узнали, сколько денег было украдено.",
                                "zh": "得知被偷了这么多钱，我们感到非常<w>震惊</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flabbergast",
                        "startle",
                        "surprise"
                    ],
                    "common_phrases": [
                        "shocked by",
                        "shocked to see",
                        "shocked to hear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то чувствовать удивление, расстройство или обиду.",
                        "zh": "使某人感到惊讶、不安或冒犯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шоки́ровать",
                                "target_lang_sense_clarification": "вызывать шок"
                            },
                            {
                                "target_lang_word": "потряса́ть",
                                "target_lang_sense_clarification": "сильно волновать"
                            },
                            {
                                "target_lang_word": "поража́ть",
                                "target_lang_sense_clarification": "сильно удивлять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "震惊",
                                "target_lang_sense_clarification": "使人感到意外"
                            },
                            {
                                "target_lang_word": "使……受惊",
                                "target_lang_sense_clarification": "使人感到害怕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21ff1215-99c2-30e1-9a85-8c0e6cfecaa7",
                    "sense_definition": "To give an electric shock to someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you touch that electric fence, it will <w>shock</w> you.",
                            "target_lang_translations": {
                                "ru": "Если ты дотронешься до этого электрического забора, тебя <w>ударит током</w>.",
                                "zh": "如果你碰到那个电围栏，它会<w>电击</w>你。"
                            }
                        },
                        {
                            "text": "The faulty toaster <w>shocked</w> me when I tried to unplug it.",
                            "target_lang_translations": {
                                "ru": "Неисправный тостер <w>ударил</w> меня <w>током</w>, когда я пытался выключить его из розетки.",
                                "zh": "当我试图拔掉插头时，那个故障的烤面包机<w>电击</w>了我。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get shocked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-то или что-то электрическим током.",
                        "zh": "使某人或某物遭受电击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уда́рить то́ком",
                                "target_lang_sense_clarification": "электричеством"
                            },
                            {
                                "target_lang_word": "бить то́ком",
                                "target_lang_sense_clarification": "электричеством (несов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电击",
                                "target_lang_sense_clarification": "用电流冲击"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5ce497b-d632-3507-99c6-c30407ff6df4",
                    "sense_definition": "Causing intense surprise, horror, or distress; unexpected.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team used <w>shock</w> tactics to intimidate their opponents.",
                            "target_lang_translations": {
                                "ru": "Команда использовала <w>шокирующую</w> тактику, чтобы запугать противников.",
                                "zh": "该队使用<w>令人震惊的</w>战术来恐吓对手。"
                            }
                        },
                        {
                            "text": "His <w>shock</w> announcement left the entire room silent.",
                            "target_lang_translations": {
                                "ru": "Его <w>неожиданное</w> заявление заставило замолчать весь зал.",
                                "zh": "他那<w>突如其来的</w>声明让整个房间陷入了沉默。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shock tactics",
                        "shock announcement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "attributive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильное удивление, ужас или дистресс; неожиданный.",
                        "zh": "引起强烈惊讶、恐惧或痛苦的；出乎意料的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шоки́рующий",
                                "target_lang_sense_clarification": "производящий впечатление"
                            },
