                        "entry_id": "6df29966-3dfd-3fc8-bf77-600067b41676",
                        "glosses": [
                            "is een artistieke compositie (schilderij, tekening, foto) van roerloze of levenloze objecten, die met zorg zijn belicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98072ded-6a39-4d28-9d36-7afb9711c0ea",
                                "sense_id": "ce212356-164f-3b56-aa82-fa312d28fd20",
                                "text": "Tegenwoordig kent het stilleven een heropleving, zie bijvoorbeeld Henk Helmantel, een van de Noordelijke realisten."
                            }
                        ]
                    }
                ],
