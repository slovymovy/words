        "fr-extract.jsonl": [
            {
                "entry_id": "c3b1b2e1-9515-33ed-8287-0bf5f0e7459d",
                "word": "macrohistoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "929a558d-2a03-3327-8a8c-170750e3aac9",
                        "entry_id": "c3b1b2e1-9515-33ed-8287-0bf5f0e7459d",
                        "glosses": [
                            "Courant de recherche historiographique analysant les faits historiques dans un large cadre faisant appel à la géographie, la sociologie, la démographie, l’économie, la culture... Ce qui s’oppose à la microhistoire, centrée sur des individus, des faits locaux, la petite échelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a68c05ca-74da-4cb2-81ec-959c97925ea9",
                                "sense_id": "929a558d-2a03-3327-8a8c-170750e3aac9",
                                "text": "On peut alors se rendre compte que le processus de création d’une microhistoire diffère de la macrohistoire aussi bien dans ses objectifs que dans ses méthodes."
                            },
                            {
                                "example_id": "e7b0f609-7694-4241-9d7d-4b62b7f71c93",
                                "sense_id": "929a558d-2a03-3327-8a8c-170750e3aac9",
                                "text": "À l’inverse, la macrohistoire analyse les différents types de phénomènes susceptibles d’exercer une influence globale sur la trajectoire d’une société déterminée. Elle englobe ainsi des histoires des civilisations, des approches économiques, etc."
                            },
                            {
                                "example_id": "9511fadb-78c0-401e-a753-55aa26f2a208",
                                "sense_id": "929a558d-2a03-3327-8a8c-170750e3aac9",
                                "text": "Lorsque la recherche en histoire de la traduction englobe l’ensemble des ramifications de la traduction sur la culture, la littérature, les langues, les échanges interculturels, les institutions, la politique, l’économie, etc., on fait de la macrohistoire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
