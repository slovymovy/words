                "senses": [
                    {
                        "sense_id": "5390832e-c953-3779-a547-f6a2faf877ab",
                        "entry_id": "7c53454b-7548-3c6c-b6fe-9285da8a8647",
                        "glosses": [
                            "schmale, längliche Öffnung, die eine Luftzirkulation ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ebf5c1-1c86-4ce0-8588-c6f8722243f9",
                                "sense_id": "5390832e-c953-3779-a547-f6a2faf877ab",
                                "text": "„Der Lüftungsschlitz kann individuell gestaltet sein.“"
                            },
                            {
                                "example_id": "fd8f8ec4-1330-49a8-b88f-ae7f679347aa",
                                "sense_id": "5390832e-c953-3779-a547-f6a2faf877ab",
                                "text": "„Der Lüftungsschlitz dient dazu, dass Luft zwischen Unterdach und Dachdeckung gelangen kann und ist deshalb als (relativ grosse) Öffnung konzipiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
