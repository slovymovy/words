                    "frequency": "Middle",
                    "semantic_group_id": "finanse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy pracownicy chętnie <w>złożyli</w> się na wspólny prezent urodzinowy dla szefa.",
