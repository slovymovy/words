        "ru-extract.jsonl": [
            {
                "entry_id": "efac321d-a47c-3139-846a-489d19a0c97c",
                "word": "въявь",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5894124d-e43b-3ac2-8d39-6b51f724c6fb",
                        "entry_id": "efac321d-a47c-3139-846a-489d19a0c97c",
                        "glosses": [
                            "устар., книжн. не во сне, не в бреду, воображении и т. п.; в действительности, на самом деле; наяву"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da34b141-91ca-4cce-a977-1bddb98efbef",
                                "sense_id": "5894124d-e43b-3ac2-8d39-6b51f724c6fb",
                                "text": "И вот первую встречную соху, первую борону на яровой борозде Степан осмотрел, как сказочную небылицу, словно увидел въявь ступу бабы-яги."
                            },
                            {
                                "example_id": "842a7602-d97f-40e6-9ff0-088487513497",
                                "sense_id": "5894124d-e43b-3ac2-8d39-6b51f724c6fb",
                                "text": "Передо мной совершалась въявь отчаянная, лихорадочная борьба судорожно напряженной воли и внутреннего бессилия."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3ba4d70-f310-3f03-af8e-bcecb90b3d86",
                        "entry_id": "efac321d-a47c-3139-846a-489d19a0c97c",
                        "glosses": [
                            "устар., книжн. явно, открыто, не тайно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "112ff0d1-7fba-4623-aafb-b2ae15a3c363",
                                "sense_id": "b3ba4d70-f310-3f03-af8e-bcecb90b3d86",
                                "text": "Ведь я въяве видел, не морокой."
                            },
                            {
                                "example_id": "73837376-c2ba-4d0c-8480-237e0377706e",
                                "sense_id": "b3ba4d70-f310-3f03-af8e-bcecb90b3d86",
                                "text": "Он въяве морочит."
                            },
                            {
                                "example_id": "7604e1a5-f548-46ab-be1b-753bde3e8be1",
                                "sense_id": "b3ba4d70-f310-3f03-af8e-bcecb90b3d86",
                                "text": "Он въяве говорит, на весь мир."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b135ad2-7abd-302d-80a1-ac9146704d0d",
                        "entry_id": "efac321d-a47c-3139-846a-489d19a0c97c",
                        "glosses": [
                            "вводн. сл., устар., разг. в самом деле, действительно (обычно с усилительными словами: и, да и)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c22265-4ad3-4930-a356-3c5b5ff050df",
                                "sense_id": "6b135ad2-7abd-302d-80a1-ac9146704d0d",
                                "text": "Да и въявь это он."
                            },
                            {
                                "example_id": "03c0e470-ad2e-4e5d-84f1-c7fe3d53a9e8",
                                "sense_id": "6b135ad2-7abd-302d-80a1-ac9146704d0d",
                                "text": "И въявь это было так."
                            }
                        ]
                    }
                ],
