                            }
                        },
                        {
                            "text": "The hotel was decorated <w>extravagantly</w> with gold leaf and expensive marble statues.",
                            "target_lang_translations": {
                                "zh": "这家酒店用金箔和昂贵的大理石雕像装饰得十分<w>铺张</w>。"
                            }
                        }
                    ],
