            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8acc32c5-04ba-3479-9cc7-b7de9fdd2810",
                    "sense_definition": "Сочный съедобный плод дерева или кустарника, обычно сладкий или кисло-сладкий.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "еда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро на завтрак она ест свежие <w>фрукты</w> и пьёт зелёный чай.",
                            "target_lang_translations": {
                                "fr": "Chaque matin au petit-déjeuner, elle mange des <w>fruits</w> frais et boit du thé vert."
                            }
                        },
                        {
                            "text": "В этом магазине всегда можно купить спелые <w>фрукты</w> по доступной цене.",
                            "target_lang_translations": {
                                "fr": "Dans ce magasin, on peut toujours acheter des <w>fruits</w> mûrs à un prix abordable."
                            }
                        }
                    ],
                    "synonyms": [
                        "плод"
                    ],
                    "antonyms": [
                        "овощ"
                    ],
                    "common_phrases": [
                        "свежие фрукты",
                        "спелые фрукты",
                        "сушёные фрукты"
                    ],
                    "target_lang_definitions": {
                        "fr": "Fruit comestible et juteux d'un arbre ou d'un arbuste, généralement sucré ou acidulé."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fruit",
                                "target_lang_sense_clarification": "produit végétal comestible et sucré"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10dd9ded-975b-331c-be41-c684245c3693",
                    "sense_definition": "Неприятный, странный, подозрительный или ненадёжный человек.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "человек",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Будь с ним осторожен, я сразу понял, что это ещё тот <w>фрукт</w>.",
                            "target_lang_translations": {
                                "fr": "Sois prudent avec lui, j'ai tout de suite compris que c'était un <w>drôle de zèbre</w>."
                            }
                        },
                        {
                            "text": "Мы быстро поняли, что за <w>фрукт</w> перед нами сидит и чего от него ждать.",
                            "target_lang_translations": {
                                "fr": "Nous avons vite compris à quel <w>numéro</w> nous avions affaire et à quoi nous attendre de sa part."
                            }
                        }
                    ],
                    "synonyms": [
                        "субъект",
                        "тип"
                    ],
                    "common_phrases": [
                        "тот ещё фрукт",
                        "что за фрукт"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное неодобрительное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne désagréable, bizarre, louche ou peu recommandable."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "drôle de zèbre",
                                "target_lang_sense_clarification": "individu suspect ou étrange"
                            },
                            {
                                "target_lang_word": "coco",
                                "target_lang_sense_clarification": "individu louche ou peu fiable, souvent péjoratif"
                            },
                            {
                                "target_lang_word": "numéro",
                                "target_lang_sense_clarification": "personnage singulier, bizarre ou douteux"
                            },
                            {
                                "target_lang_word": "énergumène",
                                "target_lang_sense_clarification": "personne au comportement étrange ou suspect"
                            }
                        ]
                    }
                }
            ]
        }
    ]
