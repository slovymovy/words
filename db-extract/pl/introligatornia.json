                        "glosses": [
                            "zakład rzemieślniczy, w którym oprawia się książki i inne wydawnictwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f0bbcd-479f-44b1-bf6d-208a982b5f26",
                                "sense_id": "790b0cdd-24a8-3d38-adde-8732be90ce3a",
                                "text": "Dysponujemy własną drukarnią offsetową i cyfrową, naświetlarnią, introligatornią, pracownią sitodruku i tampondruku."
