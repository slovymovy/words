                        "target_lang_word": "lentille d’eau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lentille d’eau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2d18b66-5993-3193-bd78-5946b95f82dc",
                                        "entry_id": "5d58349b-ec87-3dee-aa04-6a0e701f715a",
                                        "glosses": [
                                            "Nom vernaculaire donné à plusieurs plantes aquatiques flottantes."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f92468-3ef1-4580-9f48-5dac6f9a6724",
                                                "sense_id": "f2d18b66-5993-3193-bd78-5946b95f82dc",
                                                "text": "Cet observateur avait placé dans un vase de verre une certaine quantité d’eau de mare couverte de ces petits végétaux à deux feuilles étalées, à racine pendante en plein liquide, appelés lentilles d’eau."
                                            },
                                            {
                                                "example_id": "b0551891-de5b-46d0-b22c-db474a6d05a2",
                                                "sense_id": "f2d18b66-5993-3193-bd78-5946b95f82dc",
                                                "text": "Ainsi un Potamot, Potamogeton crispus se trouve en Europe, Asie, Afrique, Amérique et Australie. Il en est de même pour des Lentilles d’eau du genre Lemna."
                                            },
                                            {
                                                "example_id": "0b07c71a-6195-4368-8d13-cdc29854c976",
                                                "sense_id": "f2d18b66-5993-3193-bd78-5946b95f82dc",
                                                "text": "Le ragondin présente un régime alimentaire herbivore. C'est un rongeur polyphage qui s'attaque aux bulbes et aux racines des plantes aquatiques en particulier les roseaux. Il aime aussi potamots et laîches, scirpes, trèfles, lentilles d'eau, nénuphars et cultures […]."
                                            },
                                            {
                                                "example_id": "4f1e8685-4190-462a-831c-676bfd57ee73",
                                                "sense_id": "f2d18b66-5993-3193-bd78-5946b95f82dc",
                                                "text": "Les lentilles d’eau font de la roubine un chemin vert tendre entre saules et frênes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
