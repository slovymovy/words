                "senses": [
                    {
                        "sense_id": "24e7d983-4e2c-303f-9ff9-766772746c53",
                        "entry_id": "28676ca4-50b3-34c5-80bf-579e5bc61c8c",
                        "glosses": [
                            "veel zin hebben in het aanvallen; geneigd om aan te vallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7ec3c0-73e1-48fb-9ee7-1e57c4acc22a",
                                "sense_id": "24e7d983-4e2c-303f-9ff9-766772746c53",
                                "text": "PSV sloeg toe toen het aanvalslustige Volendam de bal verspeelde en Joey Veerman het veld overstak. De Volendammer bediende met een fraaie pass Guus Til, die niet zelfzuchtig was en direct de vrijstaande Luuk de Jong aanspeelde: 0-1."
                            },
                            {
                                "example_id": "a0f06caf-2ac3-4ab4-a403-931091e8e16b",
                                "sense_id": "24e7d983-4e2c-303f-9ff9-766772746c53",
                                "text": "Achter een kopgroep van vier waren Sep Vanmarcke en Taco van der Hoorn aanvalslustig, maar beiden kregen te maken met pech (lekke band en val). Julius van den Berg (EF) sloop wel mee in de achtervolging, kroop in het wiel van het Ineos-trio Michal Kwiatkowski, Luke Rowe en Owain Doull en kwam zo in de kopgroep van twaalf."
                            }
                        ]
                    }
