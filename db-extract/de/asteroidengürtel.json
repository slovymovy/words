                "senses": [
                    {
                        "sense_id": "d65cc4d6-f2d7-3944-bdf9-715bdf0ca4fe",
                        "entry_id": "48ded63e-1dde-3162-aab1-672716ab55c1",
                        "glosses": [
                            "ringförmige Ansammlung von Asteroiden in einem Sonnensystem, insbesondere der Hauptgürtel zwischen Mars und Jupiter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a0ba5a4-c8db-4d46-92f9-4f7ca2eb32c6",
                                "sense_id": "d65cc4d6-f2d7-3944-bdf9-715bdf0ca4fe",
                                "text": "Etwa 90 % der bekannten Asteroiden befinden sich im Asteroidengürtel zwischen Mars und Jupiter."
                            },
                            {
                                "example_id": "4f13cb30-9a3a-44cf-9675-267f361633a5",
                                "sense_id": "d65cc4d6-f2d7-3944-bdf9-715bdf0ca4fe",
                                "text": "„Ihn wird Rosetta am 10. Juli 2010 während ihres zweiten Flugs durch den Asteroidengürtel mit einer Vorbeifluggeschwindigkeit von 15 km/s aus rund 3 000 km Entfernung beobachten.“"
                            },
                            {
                                "example_id": "2ff76037-5e6a-4340-a9cb-5e46a3cb2c7f",
                                "sense_id": "d65cc4d6-f2d7-3944-bdf9-715bdf0ca4fe",
                                "text": "„Als Asteroidengürtel, Planetoidengürtel oder Hauptgürtel wird die Ansammlung von Asteroiden und Zwergplaneten im Sonnensystem genannt, die sich zwischen den Planetenbahnen von Mars und Jupiter befindet. Der Großteil der bisher bekannten Asteroiden und Zwergplaneten des Sonnensystems befindet sich in diesem Bereich. Dort sind derzeit mehr als 600.000 solcher Objekte erfasst.“"
                            },
                            {
                                "example_id": "b641d0f2-8589-406f-b199-e0aeeae7b292",
                                "sense_id": "d65cc4d6-f2d7-3944-bdf9-715bdf0ca4fe",
                                "text": "„Das Auto des Auslieferators hat genügend potentielle Energie in den Batterien stecken, dass man damit ein Pfund Speck in den Asteroidengürtel schießen könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
