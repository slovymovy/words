{
    "word_family": [
        "envelop",
        "envelope"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8f918ef-e00c-3bf5-a377-a5fdd18a4b26",
                    "sense_definition": "The act of surrounding or covering something completely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surrounding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total <w>envelopment</w> of the city by fog made travel impossible.",
                            "target_lang_translations": {
                                "ru": "Полное <w>окружение</w> города туманом сделало передвижение невозможным."
                            }
                        },
                        {
                            "text": "The gradual <w>envelopment</w> of the small village by the expanding forest was fascinating to watch.",
                            "target_lang_translations": {
                                "ru": "За постепенным <w>поглощением</w> маленькой деревни разрастающимся лесом было интересно наблюдать."
                            }
                        }
                    ],
                    "synonyms": [
                        "encirclement",
                        "surrounding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс полного окружения или покрытия чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружение",
                                "target_lang_sense_clarification": "процесс охвата со всех сторон"
                            },
                            {
                                "target_lang_word": "покрытие",
                                "target_lang_sense_clarification": "процесс обволакивания или накрытия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f4543c-ada7-3e4a-a0c9-e2e3220db2a9",
                    "sense_definition": "Something that acts as a cover or wrapping.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surrounding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark <w>envelopment</w> of the night sky hid the stars from view.",
                            "target_lang_translations": {
                                "ru": "Темный <w>покров</w> ночного неба скрыл звезды из виду."
                            }
                        },
                        {
                            "text": "She felt safe within the warm <w>envelopment</w> of her thick wool blanket.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя в безопасности, укутавшись в теплое <w>одеяло</w> из толстой шерсти."
                            }
                        }
                    ],
                    "synonyms": [
                        "covering",
                        "wrapping"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что служит покровом или оберткой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "то, что укрывает или окутывает"
                            },
                            {
                                "target_lang_word": "обертка",
                                "target_lang_sense_clarification": "материал, в который что-то завернуто"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6009bcbd-a7fc-3eb0-b4da-022a888d3b47",
                    "sense_definition": "A military maneuver where forces move around the enemy to attack from behind.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general planned a swift <w>envelopment</w> to cut off the enemy's supply lines.",
                            "target_lang_translations": {
                                "ru": "Генерал спланировал быстрый <w>охват</w>, чтобы отрезать пути снабжения противника."
                            }
                        },
                        {
                            "text": "The successful <w>envelopment</w> forced the opposing army to surrender quickly.",
                            "target_lang_translations": {
                                "ru": "Успешный <w>охват</w> вынудил армию противника быстро сдаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "flanking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Военный маневр, при котором войска обходят противника для атаки с тыла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охват",
                                "target_lang_sense_clarification": "военный маневр по окружению противника"
                            },
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "маневр для захода в тыл"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39cbb094-acb8-3059-81bc-d9befd237ddc",
                    "sense_definition": "A fencing technique involving moving the blade in a circle while maintaining contact with the opponent's blade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fencing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fencer used a precise <w>envelopment</w> to disarm his opponent's defense.",
                            "target_lang_translations": {
                                "ru": "Фехтовальщик использовал точный <w>обвод</w>, чтобы нейтрализовать защиту противника."
                            }
                        },
                        {
                            "text": "Mastering the <w>envelopment</w> requires excellent control and sensitivity in the wrist.",
                            "target_lang_translations": {
                                "ru": "Освоение <w>обвода</w> требует отличного контроля и чувствительности кисти."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Техника фехтования, при которой клинок описывает круг, сохраняя контакт с клинком противника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвод",
                                "target_lang_sense_clarification": "фехтовальный прием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}