                                                "sense_id": "a1ed7690-5acd-3da8-8a04-70efaa4c6930",
                                                "text": "Sapperlot, da habt ihr aber groß für uns aufgetischt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac87c332-1a90-3cef-a63a-de924163919d",
                                        "entry_id": "bbc87c76-876d-32fc-aad8-1bd3c3122707",
                                        "glosses": [
                                            "Ausruf der Verwünschung, Entrüstung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a89bee5-ff29-4128-a1d0-2239dfc47ae6",
                                                "sense_id": "ac87c332-1a90-3cef-a63a-de924163919d",
                                                "text": "Ja, sapperlot, hast du was an den Ohren? Du sollst sofort damit aufhören, habe ich gesagt!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
