                    },
                    {
                        "translation_id": "7aad9f5f-7daa-477f-82ce-080dc804b952",
                        "source_entry_id": "cc4bbec8-f9e0-3442-9fda-4ee265d6a439",
                        "source_sense_id": "e2d4fd66-a170-337f-9848-f1ef15be155f",
