                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed7de089-0fe1-391a-9240-0e7c0667e4f6",
                        "entry_id": "595f33f6-cba2-3cae-b39f-a08e33d6fa22",
                        "glosses": [
                            "yeah, yep (impolite, sometimes implying a question - so what?)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b0b1631e-e3a9-4dbc-9589-95e21f133ebf",
                                "sense_id": "ed7de089-0fe1-391a-9240-0e7c0667e4f6",
                                "text": "Ты э́то чита́л? — Ну, и?",
                                "translation": "Have you read this? - Yeah, so what?",
                                "english": "Have you read this? - Yeah, so what?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "61893d63-30cc-3566-a7d1-05ff0f4edf3e",
                "word": "ну",
                "pos": "intj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91a0425a-b10d-3d90-be09-2a7e3f570e7d",
                        "entry_id": "61893d63-30cc-3566-a7d1-05ff0f4edf3e",
                        "glosses": [
                            "well"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ac01a6a-780c-429d-baae-d180bcca369f",
                                "sense_id": "91a0425a-b10d-3d90-be09-2a7e3f570e7d",
                                "text": "Ну!",
                                "translation": "Well! (indicating surprise and a little disbelief)",
                                "english": "Well! (indicating surprise and a little disbelief)"
                            },
                            {
                                "example_id": "430045f8-797d-4860-888b-97d6244cce76",
                                "sense_id": "91a0425a-b10d-3d90-be09-2a7e3f570e7d",
                                "text": "Ну что ж?",
                                "translation": "So what now?",
                                "english": "So what now?"
                            },
                            {
                                "example_id": "72eb6550-e940-4ef9-835a-4430c37581de",
                                "sense_id": "91a0425a-b10d-3d90-be09-2a7e3f570e7d",
                                "text": "Ну так что́ же?",
                                "translation": "So what is it?",
                                "english": "So what is it?"
                            },
                            {
                                "example_id": "38c8e3e6-5c90-4e46-9478-a4435c718f7c",
                                "sense_id": "91a0425a-b10d-3d90-be09-2a7e3f570e7d",
                                "text": "Да ну́!",
                                "translation": "No/I don't need it/I don't want to!",
                                "english": "No/I don't need it/I don't want to!"
                            },
                            {
                                "example_id": "09b39ada-c27f-4ed7-a994-b4e56d03d01e",
                                "sense_id": "91a0425a-b10d-3d90-be09-2a7e3f570e7d",
                                "text": "Да ну?!",
                                "translation": "Really?!",
                                "english": "Really?!"
                            },
                            {
                                "example_id": "92d2efcc-7093-4db6-803c-b003219f872e",
                                "sense_id": "91a0425a-b10d-3d90-be09-2a7e3f570e7d",
                                "text": "— Мне немного надо! — говорил он, — курочка есть? — ну, супцу из курочки сварите! Может быть, солонинка есть — солонинки кусочек приготовьте! Жарковца какого-нибудь… вот я и сыт!",
                                "translation": "‘It’s little enough I need!’ he said. ‘Is there chicken? – well, make a little chicken broth! Perhaps there’s salt beef? – then do a bit of salt beef! And a roast of some sort – for me that will suffice!’",
                                "english": "‘It’s little enough I need!’ he said. ‘Is there chicken? – well, make a little chicken broth! Perhaps there’s salt beef? – then do a bit of salt beef! And a roast of some sort – for me that will suffice!’"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "ru-extract.jsonl": [
