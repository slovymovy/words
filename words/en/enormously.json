{
    "word_family": [
        "enormous",
        "enormity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1d81984e-e2dc-36bc-8caa-8fd7e2d3e6ee",
                    "sense_definition": "To a very great degree or extent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gloria is <w>enormously</w> pleased with our progress.",
                            "target_lang_translations": {
                                "ru": "Глория <w>чрезвычайно</w> довольна нашим прогрессом."
                            }
                        },
                        {
                            "text": "He was <w>enormously</w> popular among his peers.",
                            "target_lang_translations": {
                                "ru": "Он был <w>необычайно</w> популярен среди своих сверстников."
                            }
                        }
                    ],
                    "synonyms": [
                        "highly",
                        "greatly",
                        "immensely",
                        "vastly",
                        "very"
                    ],
                    "common_phrases": [
                        "enormously popular",
                        "enormously pleased"
                    ],
                    "target_lang_definitions": {
                        "ru": "В очень большой степени или в огромном масштабе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чрезвычайно",
                                "target_lang_sense_clarification": "указывает на высокую степень проявления качества"
                            },
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "общеупотребительный усилитель"
                            },
                            {
                                "target_lang_word": "необычайно",
                                "target_lang_sense_clarification": "подчеркивает исключительность степени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90cc415d-52af-3d86-877a-69d9ba6118ed",
                    "sense_definition": "In a shocking or scandalous manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crime was <w>enormously</w> cruel and shocked the entire community.",
                            "target_lang_translations": {
                                "ru": "Преступление было <w>чудовищно</w> жестоким и потрясло всё общество."
                            }
                        },
                        {
                            "text": "He behaved <w>enormously</w> badly during the formal dinner.",
                            "target_lang_translations": {
                                "ru": "Он вёл себя <w>вопиюще</w> плохо во время официального ужина."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шокирующим или скандальным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудовищно",
                                "target_lang_sense_clarification": "указывает на крайне негативный, возмутительный характер действия"
                            },
                            {
                                "target_lang_word": "вопиюще",
                                "target_lang_sense_clarification": "подчеркивает скандальность или недопустимость поведения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
