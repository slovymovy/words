                "senses": [
                    {
                        "sense_id": "dfa817ed-d8b8-3349-a70c-a9c9785fb271",
                        "entry_id": "190386b4-a457-3170-9e4c-3f44223fb00d",
                        "glosses": [
                            "een kast die de inhoud ook tijdens een brand beschermd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd737a46-2195-4b83-8545-295a0054733c",
                                "sense_id": "dfa817ed-d8b8-3349-a70c-a9c9785fb271",
                                "text": "- Een brandkast beschermt de inhoud tegen brand en diefstal, maar niet tegen de thermische lans van Aage Meinesz (1942-1985).."
                            },
                            {
                                "example_id": "35906bd0-17b2-4f14-b0bf-645a1a91ad31",
                                "sense_id": "dfa817ed-d8b8-3349-a70c-a9c9785fb271",
                                "text": "- In de kelder van de bank stond een enorme brandkast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ee6cb9f-f88e-4536-bd73-15ec6a1cb9a1",
                        "source_entry_id": "190386b4-a457-3170-9e4c-3f44223fb00d",
                        "source_sense_id": "dfa817ed-d8b8-3349-a70c-a9c9785fb271",
                        "target_lang_word": "safe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "safe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3995756e-ed9c-3aff-96d7-cb48cdad81df",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Not in danger; out of harm's reach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffc484d-8bcd-4f31-9de5-dc6fca19525a",
                                                "sense_id": "3995756e-ed9c-3aff-96d7-cb48cdad81df",
                                                "text": "You’ll be safe from the storm here in the cabin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c90092e-bf01-393c-ad5d-361c52c209c5",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Free from risk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cdf9c0b-6f90-4eed-afb7-b9001281fdaa",
                                                "sense_id": "0c90092e-bf01-393c-ad5d-361c52c209c5",
                                                "text": "It’s safe to eat this berry."
                                            },
                                            {
                                                "example_id": "854bb637-81ed-4a45-9382-48ea10f040b9",
                                                "sense_id": "0c90092e-bf01-393c-ad5d-361c52c209c5",
                                                "text": "In fact, in presenting the home life of these people I have been at some pains to avoid the extreme of privation, taking the cases just as they came to hand on the safer middle-ground of average earnings."
                                            },
                                            {
                                                "example_id": "ef4a433d-9cb3-4df7-939f-1331a67afaf5",
                                                "sense_id": "0c90092e-bf01-393c-ad5d-361c52c209c5",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "9bcf6b0b-76a0-4fa0-ad14-b847240f0507",
                                                "sense_id": "0c90092e-bf01-393c-ad5d-361c52c209c5",
                                                "text": "Probably the safest and easiest 'tool' that you can use to get off your rusty-dusty and follow your choice of exercise routine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f601fdec-724f-318b-868c-4129fc19140f",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Providing protection from danger; providing shelter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "781948b9-7b23-4681-be7f-d040048987a5",
                                                "sense_id": "f601fdec-724f-318b-868c-4129fc19140f",
                                                "text": "We have to find a safe spot, where we can hide out until this is over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01437d14-203a-34da-9f4a-9bdb07be6181",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "When a batter successfully reaches first base, or when a baserunner successfully advances to the next base or returns to the base he last occupied; not out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2803291-5c78-496d-8b99-ba858812c230",
                                                "sense_id": "01437d14-203a-34da-9f4a-9bdb07be6181",
                                                "text": "The pitcher attempted to pick off the runner at first, but he was safe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9969b39d-a846-307d-81f6-31e70fcdf2ef",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "In a location that renders it difficult to pot."
                                        ],
                                        "tags": [
                                            "of an object ball"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aded2c42-1c23-3631-b479-80d39cc252d0",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Properly secured."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9043fb56-6c04-44ea-a587-a0920b7bac1c",
                                                "sense_id": "aded2c42-1c23-3631-b479-80d39cc252d0",
                                                "text": "The documents are safe inside the cabbinet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "babe3897-0d36-30c0-804c-d49d218f8bd4",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Not susceptible to a specified source of harm."
                                        ],
                                        "tags": [
                                            "used after a noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff36d4fd-c367-4759-aab6-10241cbb6072",
                                                "sense_id": "babe3897-0d36-30c0-804c-d49d218f8bd4",
                                                "text": "dishwasher-safe"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Great, cool, awesome, respectable; a term of approbation, often as interjection."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "578672c7-e5b4-4fe0-9089-1a52d9de71af",
                                                "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                                                "text": "and you also forgot to mentioned^([sic]) the wheels man you know bmw playing / ragga jungle hip hop tunes / and on the mobile / yeah safe! / nice one / later"
                                            },
                                            {
                                                "example_id": "a15840d8-cba3-4b80-ac5d-7f551da1a250",
                                                "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                                                "text": "Young Mal: Yu can’t. Irie means yer cool, yer safe, everything awright."
                                            },
                                            {
                                                "example_id": "6a5e155d-4226-4bf8-929d-51937abffbe9",
                                                "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                                                "text": "“If you need more, just ring, yeah?” Punch said.\n “Safe,” Brian answered."
                                            },
                                            {
                                                "example_id": "35fd570f-a2b9-47e3-8822-b226af0eab9b",
                                                "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                                                "text": "They end the call. Fami goes over to Paul. They touch hands.¶ Femi: Yeah, safe man."
                                            },
                                            {
                                                "example_id": "60b9d6ac-864d-4595-8bbe-18de8c39e47c",
                                                "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                                                "text": "“Yeah, safe mate, wassup?” says one hoodie, who should at least be credited with attempting a more detailed sentence construction."
                                            },
                                            {
                                                "example_id": "8de19186-4b91-47d5-a458-33dc435e3173",
                                                "sense_id": "50fe17a9-bd8f-378e-93f1-4575903aa76b",
                                                "text": "Dom (David Jonsson): Hey, love the photos. They're just so—\nNathan (Simon Manyonda): Safe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f6f372f-051c-32d8-8b15-44e63d0851e9",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Supported by evidence and unlikely to be overturned. Usually used in the negative, as unsafe."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "263c30dc-8536-4797-8c3d-db42939117cd",
                                                "sense_id": "6f6f372f-051c-32d8-8b15-44e63d0851e9",
                                                "text": "It is clear that this is not a safe conviction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a21d30-4f95-3801-9b89-17b544878323",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Lenient, usually describing a teacher that is easy-going."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e14f9c6-e7c1-39f3-bd8a-1c16dd9e15da",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Reliable; trusty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73c3ccbc-3cfd-3472-b2f0-22f1bfb52585",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Certain; sure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d54c646f-e978-4cea-9446-32203629551b",
                                                "sense_id": "73c3ccbc-3cfd-3472-b2f0-22f1bfb52585",
                                                "text": "\"[…] so if you think he is at the infirmary, I'll make my way there.\" \"He's safe to be there, my lad, because he's house surgeon to the infirmary, and they do say he's a very clever one.\""
                                            },
                                            {
                                                "example_id": "f0d6dd16-70f7-4a5a-824c-2c3f6f948afc",
                                                "sense_id": "73c3ccbc-3cfd-3472-b2f0-22f1bfb52585",
                                                "text": "\"He's safe to be hanged, an' that, all in an' out, when they recovred there senses an' ther tongue, offert to make affidavid on, if they were askt upon oath.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fa42751-161a-32c0-8aa9-0c09ab55f6dc",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Cautious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7300fe6e-60d0-3a10-98a5-8af98f97a01d",
                                        "entry_id": "16fcfd4b-f482-395b-8e29-52ecda1a6fa5",
                                        "glosses": [
                                            "Of a programming language, type-safe or more generally offering well-defined behavior despite programming errors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "safe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d64dde4d-b8ae-382b-b643-a97a338b177a",
                                        "entry_id": "3ddac87f-a9a4-3875-9328-ba18634148c6",
                                        "glosses": [
                                            "A box, usually made of metal, in which valuables can be locked for safekeeping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f11852f1-5d22-4326-8547-7437d859a8b5",
                                                "sense_id": "d64dde4d-b8ae-382b-b643-a97a338b177a",
                                                "text": "The small-timers, as he put it, kept their currency in their homes, in safes, in false ceilings, under beds. When necessary, our tax people know where to look. The big-timers, however, use Swiss banks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aaca130-bdd7-38ec-9dde-f4e627b404f7",
                                        "entry_id": "3ddac87f-a9a4-3875-9328-ba18634148c6",
                                        "glosses": [
                                            "A condom."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d57cdc-0a3c-4025-88b5-6aa14e7662aa",
                                                "sense_id": "6aaca130-bdd7-38ec-9dde-f4e627b404f7",
                                                "text": "Condoms ARE available, on the underground market, at the outrageous price of ten dollars a piece! Now, I do not mind paying ten bucks for a good piece, as well as some peace of mind, but even the mere possession of these 'safes' is a disciplinary offense!"
                                            },
                                            {
                                                "example_id": "c88a5443-e193-4443-abad-8eb2dd7dfebe",
                                                "sense_id": "6aaca130-bdd7-38ec-9dde-f4e627b404f7",
                                                "text": "She'd better have an arsenal of Trojans in her purse just in case he wasn't carrying a safe in his back pocket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159eade4-5875-3a97-a2ad-e841eb768319",
                                        "entry_id": "3ddac87f-a9a4-3875-9328-ba18634148c6",
                                        "glosses": [
                                            "A ventilated or refrigerated chest or closet for securing provisions from noxious animals or insects."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe2738c-603a-4984-83af-4f498a52d15f",
                                                "sense_id": "159eade4-5875-3a97-a2ad-e841eb768319",
                                                "text": "The other room was a kitchen, with an open fireplace, a safe, a dresser and a tin sink, with a tap from the tank outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c9343e-320f-37d2-982d-95613b952255",
                                        "entry_id": "3ddac87f-a9a4-3875-9328-ba18634148c6",
                                        "glosses": [
                                            "A safety bicycle."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "safe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76943893-e0c4-3c51-9fb2-297e4462a7f6",
                                        "entry_id": "a5b06375-42b2-31eb-b568-fbf66adf222d",
                                        "glosses": [
                                            "To make something safe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1c99bfe-830e-4991-b46e-37a6ded4bd10",
                                                "sense_id": "76943893-e0c4-3c51-9fb2-297e4462a7f6",
                                                "text": "“It just trails behind the pylon until I land, then Cramer removes it when he safes the rocket pods. No evidence of anything when I taxi back inside the compound.”"
                                            },
                                            {
                                                "example_id": "143dcee2-6070-465b-8300-ef8a9fd72526",
                                                "sense_id": "76943893-e0c4-3c51-9fb2-297e4462a7f6",
                                                "text": "One of the most important events after touchdown will be to safe the Dauntless, which will include purging the engines and shutting down the landing systems […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
