                        ],
                        "form": "die Meinungsfreiheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                        "entry_id": "e62b3dee-2197-3e98-996e-e251a7944723",
                        "glosses": [
                            "das subjektive Recht jedes Menschen seine Meinung zu äußern und zu verbreiten"
                        ],
                        "tags": [
                            "Rechtswesen",
                            "Weltanschauung",
                            "Westen",
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "35c7183d-9a2d-45bb-a225-8eae9b573ba9",
                                "sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                                "text": "Jeder sollte in einer Demokratie von seiner Meinungsfreiheit Gebrauch machen dürfen."
                            },
                            {
                                "example_id": "10531dc8-74a0-4031-963e-0a9feb887962",
                                "sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                                "text": "Zur Verwendung anonymer Nutzerkennzeichnungen: „Für die einen ist genau sie eine der großen Stärken des Netzes, ein Garant für Meinungsfreiheit und Privatsphäre.“"
                            },
                            {
                                "example_id": "dc03936e-1aa3-4a4a-bd00-fce1cba3b8fb",
                                "sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                                "text": "„Auch berechtigte Fragen kommen zur Sprache; die wichtigste ist, jedenfalls in den Augen der arabischen Kommentatoren, warum es in Europa und Frankreich Gesetze gibt, die das Leugnen des Holocaust – richtigerweise – unter Strafe stellen und warum Deutschland negative Darstellungen von Juden in den Medien verbietet, während Kritik an den Symbolen des Islams als Ausdruck der Meinungs- und Gedankenfreiheit gelten soll; diesen Punkt sprach etwa Muhammad al-Ramihi im zuvor erwähnten Beitrag an.“"
                            },
                            {
                                "example_id": "c8650b0d-d5f8-479e-a04f-757505671bf2",
                                "sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                                "text": "„Vor dem Gesetz waren nun alle Menschen gleich, bei garantierter Meinungsfreiheit.“"
                            },
                            {
                                "example_id": "edbe744a-3cf5-4c14-a94b-557d2b4ac0a3",
                                "sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                                "text": "„Beide Wörter implizieren zudem, dass es keine echte Meinungsfreiheit gebe.“"
                            },
                            {
                                "example_id": "96c00699-f3b4-4a00-8f50-74c205a12c9e",
                                "sense_id": "e6b9be47-9130-33df-a594-fef301e33307",
                                "text": "„Für jemanden, der der Ideologie der AfD anhängt, heißt Meinungsfreiheit: Es gibt nur eine Meinung, und zwar unsere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
