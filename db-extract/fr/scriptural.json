                ],
                "senses": [
                    {
                        "sense_id": "9d8d0d43-963f-38dd-9b45-23a432baba2b",
                        "entry_id": "519f4ffc-e05d-3117-8d14-ba8ad6aab8bb",
                        "glosses": [
                            "Relatif à l'écriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1cf0edb-246c-4852-954b-0c6e903a4818",
                                "sense_id": "9d8d0d43-963f-38dd-9b45-23a432baba2b",
                                "text": "Analyse scripturale."
                            },
                            {
                                "example_id": "e32b1d3c-2489-4d42-b250-cb7ac25fce70",
                                "sense_id": "9d8d0d43-963f-38dd-9b45-23a432baba2b",
                                "text": "L'amélioration des compétences scripturales des élèves."
                            }
                        ]
                    },
                    {
                        "sense_id": "8760c687-d67b-308f-9817-621f1a969a29",
                        "entry_id": "519f4ffc-e05d-3117-8d14-ba8ad6aab8bb",
                        "glosses": [
                            "Relatif aux Écritures, à la Bible."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "cffb472f-09ef-4d93-a0f7-1ca249d5a822",
                                "sense_id": "8760c687-d67b-308f-9817-621f1a969a29",
                                "text": "L’espèce de métonymie scripturale employée ici pour exprimer l’énormité inouïe du péché que Dieu va punir, laisse dans la pensée une empreinte singulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5ecf403-c7e5-3196-8131-dfad3be1ae03",
                        "entry_id": "519f4ffc-e05d-3117-8d14-ba8ad6aab8bb",
                        "glosses": [
                            "Se dit de la masse monétaire écrite, créée par les agents économiques (chèque, lettre de change, etc.) par opposition aux monnaies métallique ou papier créées par l'État."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "d7fa5803-622d-449a-95f4-86211429526f",
                                "sense_id": "f5ecf403-c7e5-3196-8131-dfad3be1ae03",
                                "text": "L’arnaque à la fausse facture est malheureusement un phénomène courant qui touche aussi bien les acheteurs privés que publics, alertent Julien Cisamolo et Clément Bourgeois, du service des moyens de paiement scripturaux de la Banque de France."
                            },
                            {
                                "example_id": "085a4700-a8ee-4f1a-9cbd-8d6e392a93ce",
                                "sense_id": "f5ecf403-c7e5-3196-8131-dfad3be1ae03",
                                "text": "La monnaie scripturale."
                            },
                            {
                                "example_id": "ca11941b-b7aa-409b-b127-f7f242c7c5a4",
                                "sense_id": "f5ecf403-c7e5-3196-8131-dfad3be1ae03",
                                "text": "En Europe, un tiers des transactions scripturales se fait par carte bancaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "835ec1aa-e7b2-48d8-b86c-54434d9c9359",
                        "source_entry_id": "519f4ffc-e05d-3117-8d14-ba8ad6aab8bb",
                        "source_sense_description": "Relatif à l'écriture",
                        "target_lang_word": "writing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "writing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b7736c-4787-3cba-9635-f824e0907536",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "Graphism of symbols such as letters that express some meaning."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d72575-24ad-4fb3-8e99-f497b30605b4",
                                                "sense_id": "c8b7736c-4787-3cba-9635-f824e0907536",
                                                "text": "Because writing of any kind is no more and no less than a graphic representation of speech[…], to study its nature and history we must often have recourse to the speech, that is, to the language, that the writing writes."
                                            },
                                            {
                                                "example_id": "fb36aed3-1830-4d9e-bca3-f2509052b0b2",
                                                "sense_id": "c8b7736c-4787-3cba-9635-f824e0907536",
                                                "text": "Early writing appeared in both societies around 3000 B.C.E., mainly for administrative purposes in Egypt and for accounting and trading in Sumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d3c06a7-9fa0-3b9e-8e4b-208944e1c0c4",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "Something written, such as a document, article or book."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "202e0f3d-a710-3bff-ba48-f763cd6ae3b2",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "The process of representing a language with symbols or letters."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f35036d1-ad55-3605-914d-b83c36c40a5b",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "A work of an author."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bd6a57b-4fda-48b7-bf92-67bbb0ae3f0f",
                                                "sense_id": "f35036d1-ad55-3605-914d-b83c36c40a5b",
                                                "text": "Congrats, you did an interesting piece of writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "222e3813-06ae-3545-b320-84ec6c92aff6",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "The style of writing of a person."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da005a20-c4e5-4913-94db-bde0f71bdc1e",
                                                "sense_id": "222e3813-06ae-3545-b320-84ec6c92aff6",
                                                "text": "I can't read your writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "553e0f76-8a56-3c9c-8143-b5af38a9a343",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "Intended for or used in writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
