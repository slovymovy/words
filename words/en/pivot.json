{
    "word_family": [
        "pivotal",
        "pivoting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b26bfa6-daee-3ff4-b0f8-5eef06dea19d",
                    "sense_definition": "To turn or rotate on a single fixed point.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer <w>pivoted</w> on her toes to face the audience.",
                            "target_lang_translations": {
                                "de": "Die Tänzerin <w>drehte sich</w> auf ihren Zehenspitzen, um dem Publikum zuzuwenden."
                            }
                        },
                        {
                            "text": "He <w>pivoted</w> on his heel and walked out of the room.",
                            "target_lang_translations": {
                                "de": "Er <w>drehte sich</w> auf dem Absatz um und verließ den Raum."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotate",
                        "spin",
                        "swivel"
                    ],
                    "common_phrases": [
                        "pivot on heel"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich um einen festen Punkt drehen oder rotieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich drehen",
                                "target_lang_sense_clarification": "allgemeine Bewegung um eine Achse"
                            },
                            {
                                "target_lang_word": "schwenken",
                                "target_lang_sense_clarification": "eine drehende Bewegung ausführen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a4e9e74-967a-304b-b550-d8b5bf46c639",
                    "sense_definition": "To make a sudden or significant change in business strategy or policy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startup had to <w>pivot</w> its business model after failing to attract enough individual customers.",
                            "target_lang_translations": {
                                "de": "Das Startup musste sein Geschäftsmodell <w>umstellen</w>, nachdem es nicht genug Privatkunden gewinnen konnte."
                            }
                        },
                        {
                            "text": "Successful entrepreneurs often <w>pivot</w> their strategy when they realize their initial plan is not working.",
                            "target_lang_translations": {
                                "de": "Erfolgreiche Unternehmer <w>ändern</w> oft ihre Strategie, wenn sie merken, dass ihr ursprünglicher Plan nicht funktioniert."
                            }
                        }
                    ],
                    "synonyms": [
                        "shift",
                        "reorient"
                    ],
                    "common_phrases": [
                        "pivot strategy"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine plötzliche oder bedeutende Änderung der Geschäftsstrategie oder Politik vornehmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Strategie ändern",
                                "target_lang_sense_clarification": "geschäftliche Neuausrichtung"
                            },
                            {
                                "target_lang_word": "umsteuern",
                                "target_lang_sense_clarification": "einen Kurswechsel vollziehen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b517850-2f36-3042-9b86-f6508c137039",
                    "sense_definition": "A central pin or shaft on which a mechanism turns.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy gate rotates smoothly on a steel <w>pivot</w>.",
                            "target_lang_translations": {
                                "de": "Das schwere Tor dreht sich reibungslos auf einem stählernen <w>Drehpunkt</w>."
                            }
                        },
                        {
                            "text": "The machine's main <w>pivot</w> requires regular lubrication to prevent wear.",
                            "target_lang_translations": {
                                "de": "Der Haupt<w>drehpunkt</w> der Maschine erfordert regelmäßige Schmierung, um Verschleiß zu verhindern."
                            }
                        }
                    ],
                    "synonyms": [
                        "axle",
                        "spindle",
                        "hinge"
                    ],
                    "common_phrases": [
                        "central pivot"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein zentraler Stift oder eine Welle, um die sich ein Mechanismus dreht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Drehpunkt",
                                "target_lang_sense_clarification": "mechanischer Punkt der Rotation"
                            },
                            {
                                "target_lang_word": "Angelpunkt",
                                "target_lang_sense_clarification": "fester Punkt, um den sich etwas bewegt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5856c10-86dd-3670-940f-bded194722ff",
                    "sense_definition": "A person or thing that is central to the success or development of a situation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was the <w>pivot</w> around which the entire project team revolved.",
                            "target_lang_translations": {
                                "de": "Sie war der <w>Angelpunkt</w>, um den sich das gesamte Projektteam drehte."
                            }
                        },
                        {
                            "text": "The new policy became the <w>pivot</w> of the political debate.",
                            "target_lang_translations": {
                                "de": "Die neue Politik wurde zum <w>Dreh- und Angelpunkt</w> der politischen Debatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "centerpiece",
                        "cornerstone",
                        "linchpin"
                    ],
                    "common_phrases": [
                        "central pivot"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder Sache, die für den Erfolg oder die Entwicklung einer Situation von zentraler Bedeutung ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Angelpunkt",
                                "target_lang_sense_clarification": "figurativ für den Mittelpunkt einer Entwicklung"
                            },
                            {
                                "target_lang_word": "Dreh- und Angelpunkt",
                                "target_lang_sense_clarification": "idiomatisch für das Wichtigste einer Angelegenheit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}