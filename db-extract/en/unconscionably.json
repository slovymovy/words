                        "sense_id": "1b4d748f-26a1-3085-8a8c-cf8bcc4dfbfd",
                        "entry_id": "3df1e875-e4e7-35b9-bf09-d335fc0fbeec",
                        "glosses": [
                            "In an unconscionable manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d414fa6-472f-4318-8528-6ba46fd06176",
                                "sense_id": "1b4d748f-26a1-3085-8a8c-cf8bcc4dfbfd",
                                "text": "Unconscionably, they and their outliers in the hard Brexit media have attempted to stifle debate and question those who demand proper scrutiny of the most significant political and economic challenge to Britain in decades."
                            },
                            {
                                "example_id": "2a8b455c-2f6c-49db-924f-4e982348ca5b",
                                "sense_id": "1b4d748f-26a1-3085-8a8c-cf8bcc4dfbfd",
                                "text": "“[…] They talk of you as if you were Croesus—and I expect the beggars sponge on you unconscionably.” And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a514c465-7076-4233-8d21-e55d286a4c1f",
                        "source_entry_id": "3df1e875-e4e7-35b9-bf09-d335fc0fbeec",
                        "source_sense_id": "1b4d748f-26a1-3085-8a8c-cf8bcc4dfbfd",
                        "source_sense_description": "in an unconscionable manner",
                        "target_lang_word": "déraisonnablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déraisonnablement",
