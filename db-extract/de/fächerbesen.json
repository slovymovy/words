                "senses": [
                    {
                        "sense_id": "38936f91-2811-3ea9-9933-153c25a93f7c",
                        "entry_id": "644e3b2c-b26b-3a01-bc07-19485722f5f8",
                        "glosses": [
                            "Gartengerät mit fächerförmigem Ende, das zum Zusammenkehren von Laub oder anderem losem, typischerweise grobem Zeug, Gartenabfall dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06daeee-b835-4802-9321-58acc39f7133",
                                "sense_id": "38936f91-2811-3ea9-9933-153c25a93f7c",
                                "text": "„Im Schrank hingen Grubber, Haken, Fächerbesen und Schippen verschiedener Größen.“"
                            },
                            {
                                "example_id": "b60d55d7-6bd0-457a-971c-81946714d65f",
                                "sense_id": "38936f91-2811-3ea9-9933-153c25a93f7c",
                                "text": "„Er schielte auf die sich bewegende Grabplatte und stellte den Fächerbesen an einen Baum.“"
                            },
                            {
                                "example_id": "4f4548f4-f716-46fe-8edc-5b14c757346d",
                                "sense_id": "38936f91-2811-3ea9-9933-153c25a93f7c",
                                "text": "„Dabei geht es mit dem Fächerbesen viel besser, so wird alles aufgesammelt und nicht in den Garten der Nachbarn oder auf die Straße geblasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
