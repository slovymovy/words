                    }
                ],
                "senses": [
                    {
                        "sense_id": "22acfec1-cd33-32b1-a8e5-441b888f8e6f",
                        "entry_id": "964d37c8-fd36-39e8-a790-57e66e6d95dd",
                        "glosses": [
                            "архит. простенок, обычно украшенный орнаментом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d43445-51bf-4e67-8273-8c6859437e95",
                                "sense_id": "22acfec1-cd33-32b1-a8e5-441b888f8e6f",
                                "text": "Тимпан и архитрав портала поддерживаются с боков двумя широкими плоскими пилонами, а в середине – четырехгранным столбом-трюмо, разделяющим надвое дверной проем."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d1c6783-6858-3e74-854e-f9898438f614",
                        "entry_id": "964d37c8-fd36-39e8-a790-57e66e6d95dd",
                        "glosses": [
                            "высокое стоячее зеркало, обычно помещенное в простенке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e2a5b0-aac2-47bc-98ab-060111912a01",
                                "sense_id": "8d1c6783-6858-3e74-854e-f9898438f614",
                                "text": "Золотые трюмо в оконных простенках отовсюду глотали гостиную зеленоватыми поверхностями зеркал..."
                            },
                            {
                                "example_id": "4c06b50d-194b-4302-bccd-ab6ac183a549",
                                "sense_id": "8d1c6783-6858-3e74-854e-f9898438f614",
                                "text": "Софья Петровна вошла в парадную ― роскошную, но грязную, с камином, с огромным разбитым трюмо и мраморным купидоном без одного крыла."
                            },
                            {
                                "example_id": "47e97d68-04d9-484e-bb91-5bde5927e9a2",
                                "sense_id": "8d1c6783-6858-3e74-854e-f9898438f614",
                                "text": "...в той самой комнате, где между окнами стояло трюмо и посверкивал на солнце медный краник водопровода, и родилась Майка через пять лет после рождения Жорика."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb449311-01e3-32ac-bb32-4a1af94dda16",
                        "entry_id": "964d37c8-fd36-39e8-a790-57e66e6d95dd",
                        "glosses": [
                            "туалетный столик с зеркальной панелью сверху, часто разделённой на три расположенные под углом друг к другу части, чтобы видеть себя с разных сторон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970f08d4-54f1-430a-ba8a-b79962a28f26",
                                "sense_id": "fb449311-01e3-32ac-bb32-4a1af94dda16",
                                "text": "А на трюмо можно еще два боковых зеркала открыть и в профиль на себя смотреть, чего я терпеть не могу."
                            },
                            {
                                "example_id": "56653de8-1618-4e0f-822c-50b9cfff414b",
                                "sense_id": "fb449311-01e3-32ac-bb32-4a1af94dda16",
                                "text": "Попытаться разместить мамино и дочкино «хозяйство» на одном трюмо ― все равно что определить для отца и сына одно место за столом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b51b10c7-440c-4bce-8c31-83ea92d2c17b",
                        "source_entry_id": "964d37c8-fd36-39e8-a790-57e66e6d95dd",
                        "source_sense_description": "зеркало",
                        "target_lang_word": "trumeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trumeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccca4693-cf55-3076-acb4-5cead520c179",
                                        "entry_id": "836d2b4d-eec9-3b7a-b7cd-8594f1c9b738",
                                        "glosses": [
                                            "Jarret de bœuf."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "137077f8-b3ac-374d-b66c-ca7bc9757300",
                                        "entry_id": "836d2b4d-eec9-3b7a-b7cd-8594f1c9b738",
                                        "glosses": [
                                            "Pilier entre deux baies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0678a0-138b-4cd5-a18b-f28591341b9e",
                                                "sense_id": "137077f8-b3ac-374d-b66c-ca7bc9757300",
                                                "text": "Longtemps, entre le double vantail des deux baies jumelles, elle s’était adossée au trumeau, dont le pilier porte une statue de sainte Agnès, la martyre de treize ans, une petite fille comme elle, avec la palme et un agneau à ses pieds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa7ef337-58cb-3a62-b3d7-659e3bb181e5",
                                        "entry_id": "836d2b4d-eec9-3b7a-b7cd-8594f1c9b738",
                                        "glosses": [
                                            "Panneau de menuiserie qui occupe tout l’espace entre deux fenêtres, dans l’intérieur d’un appartement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9b650e-1706-4759-9eb9-75c2f53b5545",
                                                "sense_id": "aa7ef337-58cb-3a62-b3d7-659e3bb181e5",
                                                "text": "Mais quand, conduit par madame de Gabry, j’entrai dans le grand salon du rez-de-chaussée, je vis les planchers bombés, les plinthes pourries, les boiseries fendillées, les peintures des trumeaux tournées au noir et pendant aux trois quarts hors de leurs châssis."
                                            },
                                            {
                                                "example_id": "fddb62bc-b108-434f-a43c-1075017bf68c",
                                                "sense_id": "aa7ef337-58cb-3a62-b3d7-659e3bb181e5",
                                                "text": "Un peu de vent faisait envoler un corbeau qui retombait dans le lointain et, contre le ciel blanchissant, le lointain des bois paraissait plus bleu, comme peint dans ces camaïeux qui décorent les trumeaux des anciennes demeures."
                                            },
                                            {
                                                "example_id": "0bdee4d1-217c-44d5-bcee-8fd1a807874a",
                                                "sense_id": "aa7ef337-58cb-3a62-b3d7-659e3bb181e5",
                                                "text": "Le soir, on mange la soupe en parlant des trumeaux montés dans l’après-midi, des aires de planchers à ourder le lendemain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a6adf0-0b9c-32d4-8052-0090161707a8",
                                        "entry_id": "836d2b4d-eec9-3b7a-b7cd-8594f1c9b738",
                                        "glosses": [
                                            "Pan métallique situé entre deux fenêtres dans un véhicule (autocar ou voiture de chemin de fer)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e444d54-53d6-49d4-8972-5cdd8da8aa6c",
                                                "sense_id": "52a6adf0-0b9c-32d4-8052-0090161707a8",
                                                "text": "M'sieur le contrôleur, j'avais demandé une place côté fenêtre, or j'ai la vue complètement obstruée par le trumeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5ba4715-6dff-38e7-8843-e91149555615",
                                        "entry_id": "836d2b4d-eec9-3b7a-b7cd-8594f1c9b738",
                                        "glosses": [
                                            "Panneau de glace qui occupe l’espace entre deux fenêtres, ou qui est placé au-dessus d’une cheminée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dbe036c-d94e-443d-959f-df90a0e036fe",
                                                "sense_id": "b5ba4715-6dff-38e7-8843-e91149555615",
                                                "text": "Quelques miroirs encadrés dans le style Louis XV remplissaient mal les grands trumeaux des cheminées. Il y avait entre ce mobilier et le formidable manoir où il flottait inaperçu, le contraste inévitable qui rend la noblesse de nos jours si faible et si pauvre auprès de la condition de ses aïeux."
                                            },
                                            {
                                                "example_id": "19736102-4537-4e23-a9e3-9a9fe571cf94",
                                                "sense_id": "b5ba4715-6dff-38e7-8843-e91149555615",
                                                "text": "[…] une glace à bordure dorée avait remplacé l’antique trumeau, où se voyait une bergère bleue et rose."
                                            },
                                            {
                                                "example_id": "97c96cb4-a30d-4676-bbf9-9f44b1de0273",
                                                "sense_id": "b5ba4715-6dff-38e7-8843-e91149555615",
                                                "text": "Les hautes glaces à trumeau reflétaient la lueur des bougies et les deux visages inquiets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c62f236-f53a-3728-97c3-f7298944aec3",
                                        "entry_id": "836d2b4d-eec9-3b7a-b7cd-8594f1c9b738",
                                        "glosses": [
                                            "Panneau de bois sculpté et peint qui décore la partie supérieure d’une glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef5b4116-cd51-433c-a416-1398c1299017",
                                                "sense_id": "7c62f236-f53a-3728-97c3-f7298944aec3",
                                                "text": "On me donne d’ordinaire une chambre assez propre tendue en vieille tapisserie avec un trumeau au-dessus de la glace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cb4ff4e-25e1-36c4-b286-d02671b563f2",
                                        "entry_id": "836d2b4d-eec9-3b7a-b7cd-8594f1c9b738",
                                        "glosses": [
                                            "Personne âgée excessivement maquillée."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ironic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
