                    }
                ],
                "senses": [
                    {
                        "sense_id": "ceeea2cb-ce47-3690-8950-3bb10d03dff6",
                        "entry_id": "2b344030-74dd-313e-b370-0b32bca18321",
                        "glosses": [
                            "Demi-heure. Note d’usage : On dit de une heure et demie à onze heures et demie, mais rarement les autres (sinon midi, ou minuit, et demi, qui ne sont plus de la même forme)."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "23555092-0317-4e4e-a13c-6afe88ad9d48",
                                "sense_id": "ceeea2cb-ce47-3690-8950-3bb10d03dff6",
                                "text": "Enfin, la pendule-réclame Guérin-Boutron, fixée près d’une cabine de téléphone, marquait une fois pour toutes la demie de minuit, en cas de contestation."
                            },
                            {
                                "example_id": "83ce0f8c-3f07-42e5-b1a1-ab7763ebc449",
                                "sense_id": "ceeea2cb-ce47-3690-8950-3bb10d03dff6",
                                "text": "Huit heures et demie : Gregory se lance dans la cuisine, claquant la porte."
                            }
                        ]
                    },
                    {
                        "sense_id": "071edfe9-bb7d-3ecb-bb24-681cd481c3e1",
                        "entry_id": "2b344030-74dd-313e-b370-0b32bca18321",
                        "glosses": [
                            "Demi-finale."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1a1a7b84-2b69-4235-a465-a0aef7ae11bd",
                                "sense_id": "071edfe9-bb7d-3ecb-bb24-681cd481c3e1",
                                "text": "Les Français joueront ce mercredi (17 h 15) la deuxième place de leur poule face à la Slovénie de Luka Doncic, un an après le contre historique de Nicolas Batum en demie des Jeux olympiques."
                            },
                            {
                                "example_id": "015372a4-ac51-4fe3-a0b7-9572471d2ed5",
                                "sense_id": "071edfe9-bb7d-3ecb-bb24-681cd481c3e1",
                                "text": "Ce fut plus délicat pour la Toulousaine Laurène Roisin, qui a dû passer par la Q2 pour aller en demie."
                            },
                            {
                                "example_id": "15860952-f9bc-409f-958a-278374037f79",
                                "sense_id": "071edfe9-bb7d-3ecb-bb24-681cd481c3e1",
                                "text": "Thibaut Courtois s’était exprimé à peu près en ces termes, à la suite de la demie perdue par la Belgique."
                            }
                        ]
                    },
