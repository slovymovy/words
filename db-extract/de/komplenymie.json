                "senses": [
                    {
                        "sense_id": "b63cb1ba-99c3-334f-8332-32a46b9b53a8",
                        "entry_id": "802a5a3b-64da-3e69-a558-80eb71926533",
                        "glosses": [
                            "semantische Beziehung zwischen Komplenymen; das sind Wörter, bei denen das eine semantisch im Gegensatz zu einem anderen steht, wobei sich beide gegenseitig ergänzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df68a1d9-112f-4a98-82fa-cbf0bbfd2a3a",
                                "sense_id": "b63cb1ba-99c3-334f-8332-32a46b9b53a8",
                                "text": "„Zu den paradigmatischen Angaben gehören unter anderen Synonymie, Antonymie, Hyponymie, Hyperonymie, Komplenymie und Meronymie.“"
                            },
                            {
                                "example_id": "ee18c3a6-fd8b-4816-a0b3-8c92ac484fa6",
                                "sense_id": "b63cb1ba-99c3-334f-8332-32a46b9b53a8",
                                "text": "Als Beispiel für Komplenymie nennt Duden die Wörter „ledig“ und „verheiratet“, wobei „ledig“ als „nicht verheiratet“ umschrieben werden kann."
                            },
                            {
                                "example_id": "99947ab1-bdcd-4f71-a204-4458b824be7e",
                                "sense_id": "b63cb1ba-99c3-334f-8332-32a46b9b53a8",
                                "text": "„In ersterem Falle lägen Komplesemie, Antosemie und Konversosemie, im zweiten Falle Komplenymie, Antonymie und Konversonymie vor (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
