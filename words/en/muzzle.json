{
    "word_family": [
        "muzzler",
        "unmuzzle",
        "muzzling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64ba4225-ea99-34ca-b327-6e2eaf84d10d",
                    "sense_definition": "A device used to prevent an animal from biting or eating, which is worn on its snout.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law requires that certain breeds of dogs must wear a <w>muzzle</w> in public parks.",
                            "target_lang_translations": {
                                "ru": "Закон требует, чтобы собаки определенных пород носили <w>намордник</w> в общественных парках."
                            }
                        },
                        {
                            "text": "The trainer carefully placed a leather <w>muzzle</w> on the nervous dog to ensure everyone's safety.",
                            "target_lang_translations": {
                                "ru": "Тренер осторожно надел кожаный <w>намордник</w> на нервную собаку, чтобы обеспечить безопасность окружающих."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leather muzzle",
                        "wear a muzzle",
                        "dog muzzle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, надеваемое на морду животного, чтобы оно не могло кусаться или есть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намордник",
                                "target_lang_sense_clarification": "сетка или ремни для животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae19663e-0fd3-3a86-93e7-5c917a56aed8",
                    "sense_definition": "The protruding part of an animal's head which includes the nose, mouth and jaws.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse gently nudged my hand with its soft, velvet-like <w>muzzle</w> looking for a treat.",
                            "target_lang_translations": {
                                "ru": "Лошадь осторожно ткнулась в мою руку своей мягкой, бархатистой <w>мордой</w> в поисках лакомства."
                            }
                        },
                        {
                            "text": "The cat had a small white patch of fur right on the tip of its <w>muzzle</w>.",
                            "target_lang_translations": {
                                "ru": "У кошки было маленькое белое пятнышко меха прямо на кончике <w>мордочки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "snout"
                    ],
                    "common_phrases": [
                        "animal muzzle",
                        "soft muzzle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступающая часть головы животного, включающая нос, рот и челюсти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морда",
                                "target_lang_sense_clarification": "передняя часть головы животного"
                            },
                            {
                                "target_lang_word": "рыло",
                                "target_lang_sense_clarification": "вытянутая часть головы некоторых животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec4cf533-a142-34bf-beed-b758c3014085",
                    "sense_definition": "The mouth or the end for entrance or discharge of a gun, pistol etc., that the bullet emerges from.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "firearms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bright flash of light appeared at the <w>muzzle</w> of the rifle when the shot was fired.",
                            "target_lang_translations": {
                                "ru": "В момент выстрела у <w>дула</w> винтовки появилась яркая вспышка света."
                            }
                        },
                        {
                            "text": "The soldier was taught to never point the <w>muzzle</w> of his weapon at anything he did not intend to shoot.",
                            "target_lang_translations": {
                                "ru": "Солдата учили никогда не направлять <w>дуло</w> оружия на то, во что он не собирается стрелять."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muzzle flash",
                        "muzzle velocity",
                        "rifle muzzle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выходное отверстие ствола огнестрельного оружия, из которого вылетает пуля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуло",
                                "target_lang_sense_clarification": "отверстие ствола оружия"
                            },
                            {
                                "target_lang_word": "жерло",
                                "target_lang_sense_clarification": "отверстие пушки или крупного орудия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a41aaede-e66f-3bd0-8d3c-a571ba4b9dc8",
                    "sense_definition": "A person's mouth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "human_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stuffed the delicious pastry into his <w>muzzle</w> and chewed with great enthusiasm.",
                            "target_lang_translations": {
                                "ru": "Он запихнул вкусное пирожное в свою <w>морду</w> и с энтузиазмом зажевал."
                            }
                        },
                        {
                            "text": "The old man wiped the crumbs from his <w>muzzle</w> before continuing his story.",
                            "target_lang_translations": {
                                "ru": "Старик вытер крошки со своей <w>физиономии</w> перед тем, как продолжить рассказ."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used humorously or disparagingly to refer to a human mouth."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рот человека (используется в шутливом или пренебрежительном смысле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морда",
                                "target_lang_sense_clarification": "грубое или шутливое обозначение лица/рта"
                            },
                            {
                                "target_lang_word": "рыло",
                                "target_lang_sense_clarification": "пренебрежительное обозначение лица/рта"
                            },
                            {
                                "target_lang_word": "пасть",
                                "target_lang_sense_clarification": "грубое обозначение рта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8bfaba0-a099-36c2-b9e1-9667534400db",
                    "sense_definition": "To bind or confine an animal's mouth by putting a muzzle, as to prevent it from eating or biting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer had to <w>muzzle</w> the ox to prevent it from eating the grain while working.",
                            "target_lang_translations": {
                                "ru": "Фермеру пришлось <w>надеть намордник</w> на вола, чтобы тот не ел зерно во время работы."
                            }
                        },
                        {
                            "text": "It is often necessary to <w>muzzle</w> a dog before the vet can perform a painful procedure.",
                            "target_lang_translations": {
                                "ru": "Часто необходимо <w>надеть намордник</w> на собаку, прежде чем ветеринар сможет провести болезненную процедуру."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemuzzle"
                    ],
                    "common_phrases": [
                        "muzzle a dog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Надеть намордник на животное, чтобы ограничить его возможность кусаться или есть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надеть намордник",
                                "target_lang_sense_clarification": "на животное"
                            },
                            {
                                "target_lang_word": "зануздать",
                                "target_lang_sense_clarification": "переносно: усмирить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39cbbea2-1aff-3b5f-9c1c-5f54532adbf3",
                    "sense_definition": "To restrain from speaking, expressing opinion or acting; to gag; to silence; to censor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "censorship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government attempted to <w>muzzle</w> the press to prevent the scandal from becoming public.",
                            "target_lang_translations": {
                                "ru": "Правительство попыталось <w>заткнуть рот</w> прессе, чтобы не допустить огласки скандала."
                            }
                        },
                        {
                            "text": "Critics argued that the new law was a blatant attempt to <w>muzzle</w> political opposition.",
                            "target_lang_translations": {
                                "ru": "Критики утверждали, что новый закон был явной попыткой <w>заставить замолчать</w> политическую оппозицию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muzzle the press",
                        "muzzle the opposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишить возможности свободно выражать свое мнение; подвергнуть цензуре или заставить замолчать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заткнуть рот",
                                "target_lang_sense_clarification": "лишить возможности говорить"
                            },
                            {
                                "target_lang_word": "заставить замолчать",
                                "target_lang_sense_clarification": "подавить оппозицию или прессу"
                            },
                            {
                                "target_lang_word": "обуздать",
                                "target_lang_sense_clarification": "ограничить свободу действий или слова"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}