                    {
                        "sense_id": "88a4cdd1-28af-3f2e-83a9-ffb2921f97a9",
                        "entry_id": "b6852df9-8a97-30da-923d-cd2623a45843",
                        "glosses": [
                            "Kleinstadt in Süd-Bayern am Alpenrand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9506b0f5-749f-4f42-8a31-6ce617487166",
                                "sense_id": "88a4cdd1-28af-3f2e-83a9-ffb2921f97a9",
                                "text": "„Blütezeit des Passionsspiels war das 14. und 15.Jahrhundert, gelegentlich hat es sich bis in die Gegenwart erhalten (Oberammergau).“"
                            },
                            {
                                "example_id": "13f4839d-2f86-407e-a5a2-6276aad63607",
                                "sense_id": "88a4cdd1-28af-3f2e-83a9-ffb2921f97a9",
                                "text": "„Zu gefährlichen Jagdszenen in der Luft kam es am Sonntag über Oberammergau. Ein Gleitschirmpilot befand sich im Anflug auf einen Oberammergauer Landeplatz, als ihn das ferngesteuerte Flugobjekt fast zum Absturz brachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
