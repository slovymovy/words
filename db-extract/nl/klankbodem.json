                                                "sense_id": "851f1edd-182e-3dff-89cf-7c7885d7dd38",
                                                "text": "Bei dem Sitar besteht der Korpus aus einem Kürbis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb1c3979-1c92-3083-8e55-98adfc5c2c5b",
                                        "entry_id": "37d7e33c-a55c-3bb9-b06f-60ccf76b83e3",
                                        "glosses": [
                                            "der tragende Teil eines Möbelstücks (ohne Türen, andere nicht feste Elemente sowie Sockel beziehungsweise Füße)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f24611-38e2-4fc2-9791-5b733ca19d3b",
                                                "sense_id": "fb1c3979-1c92-3083-8e55-98adfc5c2c5b",
                                                "text": "Bei diesem Schrank lässt sich der Korpus leider nicht zerlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "37949ecb-7af7-310e-9b3a-7f495296e819",
