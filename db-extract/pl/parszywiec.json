                        ]
                    },
                    {
                        "translation_id": "a3765439-29d2-439d-892d-7a69aac00ed7",
                        "source_entry_id": "e1829c09-d36b-33de-b3ea-0ee6a0875393",
                        "source_sense_id": "beb9ef17-07a8-3a76-ae04-b269d76bf846",
                        "target_lang_word": "stinkard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stinkard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "624907f8-23f4-33f8-b05d-e7bf8cd299b2",
                                        "entry_id": "83d00321-32fb-3861-900f-cc00b6bcda9c",
                                        "glosses": [
                                            "Any of various malodorous animals."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3f109f-5167-40da-ad0c-4c52e41d1c53",
                                                "sense_id": "624907f8-23f4-33f8-b05d-e7bf8cd299b2",
                                                "text": "His nose, however, again gushed out blood, a system of defence which seemed as natural to him as that resorted to by the race of stinkards."
                                            },
                                            {
                                                "example_id": "58c563ee-dd17-460e-868d-9f7e31ffac16",
                                                "sense_id": "624907f8-23f4-33f8-b05d-e7bf8cd299b2",
                                                "text": "Next you have a group of stinkards, vermin whom I hold in abomination. . . . [T]here have been cases proved of persons being killed in their beds by the odour of stinkards; and it is sufficient for one of these creatures merely to pass through a granary, a fruit-room, or a cellar, to render every provision in them uneatable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d64d987d-04ab-3629-8f89-349c5b756377",
                                        "entry_id": "83d00321-32fb-3861-900f-cc00b6bcda9c",
                                        "glosses": [
                                            "A teledu or stink badger, endemic to the island of Java, Mydaus javanensis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38a65f5b-c5bc-354b-a43f-121d55fbe9a2",
                                        "entry_id": "83d00321-32fb-3861-900f-cc00b6bcda9c",
                                        "glosses": [
                                            "A person whose behavior is hurtful and unsavory; a stinker."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887c6c18-bc26-4f46-9ca3-fda2656cbe86",
                                                "sense_id": "38a65f5b-c5bc-354b-a43f-121d55fbe9a2",
                                                "text": "[H]e asked with great emotion, if I thought him a monster and a stinkard!"
                                            },
                                            {
                                                "example_id": "31fd943c-15b5-4377-b67d-811c4eca290f",
                                                "sense_id": "38a65f5b-c5bc-354b-a43f-121d55fbe9a2",
                                                "text": "Thou'rt a sweatbox and a stinkard, sir."
                                            },
                                            {
                                                "example_id": "86435252-aa59-4845-9b6c-8671db15ad4f",
                                                "sense_id": "38a65f5b-c5bc-354b-a43f-121d55fbe9a2",
                                                "text": "\"The Heartbreak Kid,\" by contrast, is a mean piece of work with an unsympathetic, lying stinkard of an anti-hero."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3eb4c57-8699-4aa9-938d-318feef27ff5",
                        "source_entry_id": "e1829c09-d36b-33de-b3ea-0ee6a0875393",
                        "source_sense_id": "beb9ef17-07a8-3a76-ae04-b269d76bf846",
                        "target_lang_word": "Schuft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                        "entry_id": "5e36eeba-70ca-3c67-8fd4-72a3ef695484",
                                        "glosses": [
                                            "gemeiner, niederträchtiger Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "980d4c9b-50e5-4aa1-8bf5-aaa39e8c0216",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "Peter ist ein elender Schuft, er lebt ständig auf Kosten anderer und lügt wie gedruckt."
                                            },
                                            {
                                                "example_id": "6b498573-d6f6-4cde-8b1f-8a6b911d7c99",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "Du Schuft! Hättest du mir nicht wenigstens einen Schokoriegel übrig lassen können?"
                                            },
                                            {
                                                "example_id": "e45d63cc-8f14-4f79-bfa0-354439c21188",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "Seitdem Maria mich als gemeinen Schuft bezeichnet hat, rede ich kein Wort mehr mit ihr."
                                            },
                                            {
                                                "example_id": "a05e64f1-4531-4225-9063-6bb954f3695d",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "„Er wollte anständig sein, aber da sind Schufte und Strolche und Lumpen, darum will Franz Biberkopf nichts mehr sehen und hören von der Welt, und wenn er Penner wird, er versauft den letzten Pfennig von seinem Geld.“"
                                            },
                                            {
                                                "example_id": "8c03fbce-a2ac-4df8-a5b0-f25ff7c0da87",
                                                "sense_id": "8a0e3ae4-c02e-379a-9fbe-a6b4d08359b3",
                                                "text": "„Er packte den Schuft an der Kehle und schlug ihm die Waffe aus der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0476812-b02f-464a-be8e-9d55034e93b3",
                        "source_entry_id": "e1829c09-d36b-33de-b3ea-0ee6a0875393",
                        "source_sense_id": "beb9ef17-07a8-3a76-ae04-b269d76bf846",
                        "target_lang_word": "Schurke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schurke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e09cda42-53ae-3f92-b6b1-ef613a3a46f2",
                                        "entry_id": "4552da7d-7d0c-31db-98a6-4ecbb82b9205",
                                        "glosses": [
                                            "jemand, der moralisch verwerflich handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8d6668-f94b-40b5-9b7b-71560fd9d3e7",
                                                "sense_id": "e09cda42-53ae-3f92-b6b1-ef613a3a46f2",
                                                "text": "Die Schurken haben das Haus ganz ausgeräumt."
                                            },
                                            {
                                                "example_id": "67364f97-3856-4a99-8dff-af76a8b9a7c5",
                                                "sense_id": "e09cda42-53ae-3f92-b6b1-ef613a3a46f2",
                                                "text": "„Ich war keiner dieser typischen Schurken, die sowohl in der Literatur wie auch im Leben herumwuseln, die mit Absicht Böses verursachen.“"
                                            },
                                            {
                                                "example_id": "a27756d1-e410-4369-a34c-6834efb2def8",
                                                "sense_id": "e09cda42-53ae-3f92-b6b1-ef613a3a46f2",
                                                "text": "„Erstaunt starrte ich den durchtriebenen kleinen Schurken an.“"
                                            },
                                            {
                                                "example_id": "d779fc7b-aace-4566-8500-746de358616a",
                                                "sense_id": "e09cda42-53ae-3f92-b6b1-ef613a3a46f2",
                                                "text": "„Die Schurken im Steinbruch schienen zu verhandeln, was sie machen sollten.“"
                                            },
                                            {
                                                "example_id": "df58953d-ef90-4f3f-9b23-d70837595e62",
                                                "sense_id": "e09cda42-53ae-3f92-b6b1-ef613a3a46f2",
                                                "text": "„Im Großen und Ganzen sind Männer dieses Schlags nicht so schlecht wie ihr Ruf, obwohl es unter ihnen auch ganz schöne Schurken gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
