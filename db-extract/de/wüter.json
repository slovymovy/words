                    },
                    {
                        "translation_id": "694165d8-278e-414a-bf96-028ae125fac5",
                        "source_entry_id": "e15a63c0-f1cd-300d-9d8d-16ff5112cdc2",
                        "source_sense_id": "6bbf90ff-63cc-3631-bdd7-cae69bde0b03",
                        "source_sense_description": "ein Mensch, der schnell wütend wird und leicht tobt",
                        "target_lang_word": "forcené",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forcené",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb8f25a-40be-3938-aae7-60c266d9c114",
                                        "entry_id": "98bc0c96-d985-3571-a397-dc3bec7dae1b",
                                        "glosses": [
                                            "Qui est emporté par la colère, la fureur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424350ae-4c15-4cfd-830a-884245533ecf",
                                                "sense_id": "3fb8f25a-40be-3938-aae7-60c266d9c114",
                                                "text": "Tu as l'air d'une sibylle dans son antre, qui étouffe, qui écume, qui est forcenée."
                                            },
                                            {
                                                "example_id": "e673bb5f-c724-4aca-9e8a-80cff39b3837",
                                                "sense_id": "3fb8f25a-40be-3938-aae7-60c266d9c114",
                                                "text": "Elle me parla avec une chaleur, une exubérance presque insolites ; il y avait quelque chose de forcené dans son optimisme."
                                            },
                                            {
                                                "example_id": "01f051e6-232e-41b8-aa71-b023697eaf32",
                                                "sense_id": "3fb8f25a-40be-3938-aae7-60c266d9c114",
                                                "text": "Dans les asiles de fous, les infirmières lui parlent des patients qu’elles connaissent souvent mieux que les médecins eux-mêmes, ayant pour ainsi dire à habiter leur enfer. Les femmes, à les en croire, sont fréquemment plus forcenées que les hommes, des désirs et des fureurs frustrés débordant, comme une bave obscène, de ces bouches de matrones ou de demoiselles bourgeoises qu’on n’aurait pas cru en savoir aussi long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac46dad4-5ba9-3f61-857d-b9df98c2bcc5",
                                        "entry_id": "98bc0c96-d985-3571-a397-dc3bec7dae1b",
                                        "glosses": [
                                            "Qualifie un cheval emporté. À rapprocher d’acculé, cabré, effaré, effarouché, effrayé et furieux."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea3a174e-5ebf-4bcd-b89b-d30d949cd855",
                                                "sense_id": "ac46dad4-5ba9-3f61-857d-b9df98c2bcc5",
                                                "text": "Un blason avec un cheval forcené."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forcené",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35de8283-55ae-3755-b19b-dbe06a252d15",
                                        "entry_id": "6045477c-22ce-39a0-b895-af636a8d34b3",
                                        "glosses": [
                                            "Personne forcenée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b571bbba-35e9-4c43-9cd6-19995e5596cc",
                                                "sense_id": "35de8283-55ae-3755-b19b-dbe06a252d15",
                                                "text": "C’est un forcené."
                                            },
                                            {
                                                "example_id": "3e171f7c-dc2f-401d-875d-ba698deba93a",
                                                "sense_id": "35de8283-55ae-3755-b19b-dbe06a252d15",
                                                "text": "Il se débattit comme un forcené."
                                            },
                                            {
                                                "example_id": "4290bc70-9b6c-46b5-979c-aa125d2f27a7",
                                                "sense_id": "35de8283-55ae-3755-b19b-dbe06a252d15",
                                                "text": "Mes premiers échanges avec le forcené ne donnent rien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forcené",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3dc978-4e77-3da6-8915-234a232afb62",
                                        "entry_id": "738e2297-12ce-350a-93fc-ccdb217a2217",
                                        "glosses": [
                                            "Participe passé masculin singulier de forcener."
                                        ],
