                                "target_senses": [
                                    {
                                        "sense_id": "5adf682a-6ffd-3f36-88ca-ba2af2d9b919",
                                        "entry_id": "bdce317b-f2a4-3304-868b-30498337c306",
                                        "glosses": [
                                            "geringe räumliche Entfernung, von einem bestimmten Punkt aus gesehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e5a075-89be-44a1-8a0e-539fd54149bd",
                                                "sense_id": "5adf682a-6ffd-3f36-88ca-ba2af2d9b919",
                                                "text": "Der Bodyguard befand sich in der Nähe des Politikers."
                                            },
                                            {
                                                "example_id": "a1d0f6b0-4042-43a2-b8b4-a40608566a5d",
                                                "sense_id": "5adf682a-6ffd-3f36-88ca-ba2af2d9b919",
                                                "text": "„Nachbarinnen haben ihn am Abend vor der Tat in der Nähe des Hauses gesehen.“"
                                            },
                                            {
                                                "example_id": "382e31d2-9279-4f95-a01c-a920fe557f12",
                                                "sense_id": "5adf682a-6ffd-3f36-88ca-ba2af2d9b919",
                                                "text": "„In der Nähe der Kathedrale bleibt sie zurück, sie geht sehr langsam.“"
                                            },
                                            {
                                                "example_id": "d0d62de6-f4d4-4356-907d-f1856a049c79",
                                                "sense_id": "5adf682a-6ffd-3f36-88ca-ba2af2d9b919",
                                                "text": "„Jemand in ihrer Nähe wiederholte zuvorkommend den Namen, zu dem sie sich endlich bekannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2f6d54f-925f-3267-b24e-cca0a29a8bbb",
                                        "entry_id": "bdce317b-f2a4-3304-868b-30498337c306",
                                        "glosses": [
                                            "eine Zeit, die (von einem bestimmten Zeitpunkt aus gesehen) nicht weit in der Zukunft liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97b6fcd-71ba-4d4d-afe6-49bd14707fd6",
                                                "sense_id": "b2f6d54f-925f-3267-b24e-cca0a29a8bbb",
                                                "text": "Die zeitliche Nähe des Ereignisses lässt die Spannung steigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5925a1bf-c126-37ff-92d8-b13aa37e0c58",
                                        "entry_id": "bdce317b-f2a4-3304-868b-30498337c306",
                                        "glosses": [
                                            "enge persönliche oder soziale Verbundenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc783578-481e-49dc-9e06-0ebbc901d8ea",
                                                "sense_id": "5925a1bf-c126-37ff-92d8-b13aa37e0c58",
                                                "text": "Trotz der Entfernung empfanden wir uns in freundschaftlicher Nähe verbunden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e0a01382-cd3d-3d36-9ec4-2e3e75588b54",
                                        "entry_id": "bdce317b-f2a4-3304-868b-30498337c306",
                                        "glosses": [
                                            "große, flach gebaute Fähre mit geringem Tiefgang"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00c751cf-6a3e-45a7-b0b0-413e173e1b6d",
                                                "sense_id": "e0a01382-cd3d-3d36-9ec4-2e3e75588b54",
                                                "text": "Man bat die Schiffer, des Nachts die Nähen und Nachen anzuketten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
