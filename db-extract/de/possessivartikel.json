                "senses": [
                    {
                        "sense_id": "b8dfddaa-af1e-3a53-9bda-77262a6e6a93",
                        "entry_id": "b4e89394-0d99-3ccf-b8b1-4e18c1744964",
                        "glosses": [
                            "possessives, also besitzanzeigendes, Artikelwort; z. B. im Deutschen mein, dein, sein, wenn sie vor einem Substantiv stehen wie bei sein (gelbes) Haus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a99dba-8213-44eb-87c6-a1348be2a572",
                                "sense_id": "b8dfddaa-af1e-3a53-9bda-77262a6e6a93",
                                "text": "„Während die Possessivartikel ein Substantiv wie ein Artikel begleiten: my house, ersetzen die Pronomina das Substantiv: Is this your house? – yes, it is mine.“"
                            },
                            {
                                "example_id": "fc4285b0-08a6-427b-bfcb-d18fc663fd0f",
                                "sense_id": "b8dfddaa-af1e-3a53-9bda-77262a6e6a93",
                                "text": "„Der Possessivartikel und das Possessivpronomen signalisieren ‚Besitz‘ oder ‚Zusammengehörigkeit‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
