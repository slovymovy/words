{
    "word_family": [
        "bush",
        "bushy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c421175e-1682-3b2d-abde-4d1479e183f6",
                    "sense_definition": "A small bush or shrub.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A tiny sparrow hid quietly beneath the leafy <w>busket</w> near the garden wall.",
                            "target_lang_translations": {
                                "zh": "一只小麻雀悄悄藏在花园矮墙旁枝繁叶茂的<w>小灌木</w>下。"
                            }
                        },
                        {
                            "text": "The path was framed by flowering <w>buskets</w> that bloomed early in spring.",
                            "target_lang_translations": {
                                "zh": "小径两侧栽满了初春便盛开的开花<w>矮树丛</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrublet",
                        "bushlet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "小灌木或矮树丛"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小灌木",
                                "target_lang_sense_clarification": "矮小的小树丛"
                            },
                            {
                                "target_lang_word": "矮树丛",
                                "target_lang_sense_clarification": "低矮的灌木丛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1fcbb2-669e-3627-852e-57da2e2e9f42",
                    "sense_definition": "A small sprig, cluster of flowers, or bouquet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a dainty <w>busket</w> of wild violets pinned to her collar.",
                            "target_lang_translations": {
                                "zh": "她的衣领上别着一束用野生紫罗兰做成的小巧<w>花束</w>。"
                            }
                        },
                        {
                            "text": "The children gathered fresh May <w>buskets</w> to celebrate the arrival of the festival.",
                            "target_lang_translations": {
                                "zh": "孩子们采集了新鲜的五月<w>小花束</w>来庆祝节日的到来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bouquet",
                        "posy",
                        "sprig",
                        "nosegay"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or archaic poetic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古语或诗歌用语）一小束花、小花束或一小枝花"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小花束",
                                "target_lang_sense_clarification": "小束的花朵束"
                            },
                            {
                                "target_lang_word": "花束",
                                "target_lang_sense_clarification": "用于装饰或赠送的花簇"
                            },
                            {
                                "target_lang_word": "小花枝",
                                "target_lang_sense_clarification": "一小枝花"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99e6fa3b-09f7-31a9-b7d9-008c9468f25f",
                    "sense_definition": "A section of a garden specifically planted with or devoted to shrubs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landscaper added a tidy <w>busket</w> to separate the lawn from the terrace.",
                            "target_lang_translations": {
                                "zh": "景观设计师增建了一处整齐的<w>灌木区</w>，将草坪与露台隔开。"
                            }
                        },
                        {
                            "text": "Birds frequently nested in the quiet corners of the overgrown <w>busket</w>.",
                            "target_lang_translations": {
                                "zh": "鸟儿们常在那片杂草丛生的<w>灌木林</w>深处的安静角落里筑巢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrubbery",
                        "bosquet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical or obsolete gardening term"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（园艺或旧时用语）花园中的灌木丛区域或小灌木林"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灌木区",
                                "target_lang_sense_clarification": "花园中栽植灌木的区域"
                            },
                            {
                                "target_lang_word": "灌木林",
                                "target_lang_sense_clarification": "小丛林或灌木造景区"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}