                                                "sense_id": "1d4f74af-0d28-30af-aa93-a49b26114cdd",
                                                "text": "W tym roku Wszystkich Świętych wypadło w niedzielę."
                                            },
                                            {
                                                "example_id": "17ccbc45-a497-4abe-bde6-53a3d56c8f36",
                                                "sense_id": "1d4f74af-0d28-30af-aa93-a49b26114cdd",
                                                "text": "W dzień Wszystkich Świętych Polacy zapalają na grobach znicze."
                                            },
                                            {
                                                "example_id": "3c768e1c-ac50-4558-8e62-a3454c77e44b",
                                                "sense_id": "1d4f74af-0d28-30af-aa93-a49b26114cdd",
                                                "text": "Po dniu Wszystkich Świętych następują Zaduszki."
                                            },
                                            {
                                                "example_id": "606a6640-e80d-4c08-a36a-eba9868fb579",
                                                "sense_id": "1d4f74af-0d28-30af-aa93-a49b26114cdd",
                                                "text": "Znicze skończyły się na dwa dni przed świętem Wszystkich Świętych."
                                            }
