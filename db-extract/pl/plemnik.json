                                        "entry_id": "8aea64d2-7d5a-37a8-b714-440516222350",
                                        "glosses": [
                                            "cellula germinale maschile degli animali con il compito di raggiungere il gamete femminile (ovulo) per fecondarlo, durante la riproduzione sessuale anfigonica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8312ca42-a2f9-4397-9a59-a166e7b1c6ad",
                                                "sense_id": "7f9e674e-7726-3ca7-9f44-c7baf556ee92",
                                                "text": "qualora si perda lo spermatozoo presente nello sperma per una causa \"accidentale\" o \"volontariamente\", certo è che non si \"riforma\" in tutti i casi"
                                            }
