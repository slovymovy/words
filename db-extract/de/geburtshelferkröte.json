                "senses": [
                    {
                        "sense_id": "8b05e848-7c15-314e-9999-d3af91ca59ae",
                        "entry_id": "7011ebfc-b9f3-3217-8a4e-6f36594f0e5f",
                        "glosses": [
                            "brutpflegender Froschlurch aus der Gattung Alytes, der seinen Laich bis zur Entwicklung mit sich herumträgt, zum Beispiel die in Deutschland heimische Art Alytes obstetricans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88ddc992-7fe7-432b-8cb2-ec574280d481",
                                "sense_id": "8b05e848-7c15-314e-9999-d3af91ca59ae",
                                "text": "Geburtshelferkröten haben eine einzigartige Form der Brutpflege entwickelt."
                            },
                            {
                                "example_id": "19a4fe1a-83f7-4272-a8b9-2ed1c3281efd",
                                "sense_id": "8b05e848-7c15-314e-9999-d3af91ca59ae",
                                "text": "„Die Stammesgeschichte der Geburtshelferkröte ist bisher nicht vollständig geklärt.“"
                            },
                            {
                                "example_id": "ae608d9c-57ac-4f8b-98d7-d4b8ae6cde24",
                                "sense_id": "8b05e848-7c15-314e-9999-d3af91ca59ae",
                                "text": "„In Baden-Württemberg kann man die Geburtshelferkröte nur im südlichen Schwarzwald und in der angrenzenden Vorbergzone finden.“"
                            },
                            {
                                "example_id": "ac0765d4-941b-4054-88ec-e86c840093de",
                                "sense_id": "8b05e848-7c15-314e-9999-d3af91ca59ae",
                                "text": "„In der Schweiz wurde die Geburtshelferkröte zum Tier des Jahres 2013 gekürt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a78c6eb0-9bd6-4ce9-9fba-bb7ccc9403c7",
                        "source_entry_id": "7011ebfc-b9f3-3217-8a4e-6f36594f0e5f",
                        "source_sense_id": "8b05e848-7c15-314e-9999-d3af91ca59ae",
                        "target_lang_word": "midwife toad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "midwife toad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "080678b7-1075-3a93-b1ef-63b7852eb867",
                                        "entry_id": "a0428cf8-f17e-308d-9eef-f802ee2ee09d",
                                        "glosses": [
                                            "Any species of the genus Alytes, the males of which carry fertilised eggs on their backs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79c3be6-c4c6-441a-b930-00e12471c709",
                                                "sense_id": "080678b7-1075-3a93-b1ef-63b7852eb867",
                                                "text": "Fossils suggest that midwife toads were once widespread on Majorca and Menorca, but disappeared from lowlands of the former and entirely from the latter island several thousand years ago and coincident with the fossil appearance of the snake Natrix maura and the large frog Rana perezi."
                                            },
                                            {
                                                "example_id": "8eeada85-d32c-4113-b2e7-70f74fb1cd78",
                                                "sense_id": "080678b7-1075-3a93-b1ef-63b7852eb867",
                                                "text": "A key preserved male specimen of the midwife toad was eventually shown to have been injected with India ink in the region of the normally pigmented nuptial pad."
                                            },
                                            {
                                                "example_id": "d3503985-ed13-4c9d-9836-def86c774d27",
                                                "sense_id": "080678b7-1075-3a93-b1ef-63b7852eb867",
                                                "text": "The midwife toad is a slow-moving, terrestrial amphibian represented by four species of the genus Alytes (family Discoglossidae). The best-known species is A. obstetricans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
