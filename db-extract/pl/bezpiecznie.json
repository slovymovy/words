                                "sense_id": "d741ae70-a5bf-3f9f-81ae-c4db9087693d",
                                "text": "Neon PZU z napisem „Z nami bezpieczniej” rzucał snop trupiego światła"
                            },
                            {
                                "example_id": "26510fdc-66f7-41f1-a412-c366bc10c220",
                                "sense_id": "d741ae70-a5bf-3f9f-81ae-c4db9087693d",
                                "text": "W lokalach wyborczych można czuć się bezpiecznie dzięki przestrzeganiu wytycznych władz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
