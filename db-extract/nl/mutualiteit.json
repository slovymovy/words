                            {
                                "example_id": "99ab235a-294b-44f9-bcf0-63a2a66a7d72",
                                "sense_id": "514c8a15-8076-3b74-9a59-182a4fd271cb",
                                "text": "Maar aangezien er normen vastgesteld moeten worden en overeenkomsten ontworpen behoren te worden voor de goederenruil is een maatschappij slechts mogelijk op basis van wederkerigheid, van de ‘mutualiteit’."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8b2f478-7371-32ef-87b2-435207da26f9",
                        "entry_id": "93ded422-59b1-3c44-b443-8db3a85162dc",
                        "glosses": [
                            "ziekenfonds, onderlinge verzekering"
                        ],
                        "tags": [
                            "België"
                        ],
                        "examples": [
                            {
                                "example_id": "93573f2b-d9cc-489a-b54a-a9b8aefdcbde",
                                "sense_id": "c8b2f478-7371-32ef-87b2-435207da26f9",
                                "text": "De eerste Pensioenwet die de Kamer net voor de verkiezingen heeft goedgekeurd, voorziet in een premie van de staat ten voordele van de aangeslotenen bij een erkende mutualiteit en in een jaarlijkse tegemoetkoming aan elk lid dat aan de mutualiteit een minimumbijdrage heeft gestort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dfdcaa1-2f0b-4c0b-af74-c5c065d0d36d",
