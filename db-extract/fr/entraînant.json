                                                "example_id": "74f3bb6a-fab1-49f5-a3dd-cd3a865de795",
                                                "sense_id": "d5e26203-d2c0-3483-9f45-c0a06f85d751",
                                                "text": "He sounded upbeat when I talked to him."
