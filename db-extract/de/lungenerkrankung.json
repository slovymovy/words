                "senses": [
                    {
                        "sense_id": "63672277-300d-37da-90a7-10998e550e61",
                        "entry_id": "356544bd-742e-3dfa-99ed-e522a00ba7cf",
                        "glosses": [
                            "Befall der Lunge mit einer Krankheit"
                        ],
                        "tags": [
                            "Krankheiten"
                        ],
                        "examples": [
                            {
                                "example_id": "8222528e-f13e-488f-84b1-33fa1f0fcba0",
                                "sense_id": "63672277-300d-37da-90a7-10998e550e61",
                                "text": "„Bei der sogenannten Bodyplethysmografie maßen sie verschiedene Werte während des Atmens, anhand derer sich Lungererkrankungen voreinander unterscheiden lassen.“"
                            },
                            {
                                "example_id": "6dee3af0-8a8b-4459-9e9f-2bab2b9b51b8",
                                "sense_id": "63672277-300d-37da-90a7-10998e550e61",
                                "text": "„Sie hat sich mutmaßlich eine Lungenerkrankung, vielleicht eine Tuberkulose zugezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
