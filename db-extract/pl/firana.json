                "senses": [
                    {
                        "sense_id": "f5c69ce3-c389-30ff-a7b7-de21f95bb664",
                        "entry_id": "bdbd562e-8669-3d99-980c-7d854ba37d8b",
                        "glosses": [
                            "ozdobna zasłona na okno z półprzezroczystej tkaniny"
                        ],
                        "tags": [
                            "środ."
                        ],
                        "examples": [
                            {
                                "example_id": "d38c8c20-db6e-4e1a-b6ff-de2363448253",
                                "sense_id": "f5c69ce3-c389-30ff-a7b7-de21f95bb664",
                                "text": "Danka zdjęła firany i zamoczyła je na całą noc w wodzie z proszkiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2868470c-656c-4b25-9676-5a81697930e8",
                        "source_entry_id": "bdbd562e-8669-3d99-980c-7d854ba37d8b",
                        "source_sense_id": "f5c69ce3-c389-30ff-a7b7-de21f95bb664",
                        "target_lang_word": "Gardine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gardine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee198add-da34-3ce2-bee8-5a883d297db1",
                                        "entry_id": "894fc905-224c-3608-8f87-471373e4ec9b",
                                        "glosses": [
                                            "dünner Vorhang, den man vor Fenster hängt, um die Sicht nach innen zu verhindern und den Lichteinfall abzuschwächen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998f5aea-2237-4a63-941a-c79ec7127abd",
                                                "sense_id": "ee198add-da34-3ce2-bee8-5a883d297db1",
                                                "text": "Machst du bitte die Gardinen zu?"
                                            },
                                            {
                                                "example_id": "7a7e2972-5fa6-4b7d-aebb-188c1eed7079",
                                                "sense_id": "ee198add-da34-3ce2-bee8-5a883d297db1",
                                                "text": "„Es geht beim Betrachten dieses Buches gar nicht um die Frage, ob da lauter kleine Buñuels heranwuchsen; vielmehr um die hochbrisante, wie viele Rinnsale einen Popanz-Staat unterhöhlten. Der Wandlitz-Lächerlichkeit mit all den Attributen der diktatorischen Spießer, diesen Kunstledersofas, Hirschgeweihen und Pornofilmräumen, wird auf fast heitere Weise, spielerisch, ein Spiegel entgegengehalten - waren die dort um die Gardine im Volvo besorgt, mußten die hier sich sorgen um das Filmmaterial, weil die Hitze der Projektorlampe - wenn beim Abspielen der Projektor stoppte - den Film schmelzen ließ.“"
                                            },
                                            {
                                                "example_id": "48284636-0322-4500-9113-49d8f4317b4d",
                                                "sense_id": "ee198add-da34-3ce2-bee8-5a883d297db1",
                                                "text": "„Ob Gardine, Teppich, Sofastoff oder Bettwäsche - bis zum 15. Januar werden auf der Fachmesse die Textiltrends von morgen präsentiert."
                                            },
                                            {
                                                "example_id": "f2028d65-b1da-4d95-a862-a7867f6fcac2",
                                                "sense_id": "ee198add-da34-3ce2-bee8-5a883d297db1",
                                                "text": "„Es ist nicht schwer zu ermitteln, wer 1992 in welchem Haus wohnte. Hinter den Fenstern der Serben hängen Gardinen; die Häuser der Muslime sind zerschossen, die Dächer durchsiebt, die Mauern durchbrochen. Wie Totenköpfe sehen sie aus, bei manchen steht nur noch der feuerfeste Schornstein.“"
                                            },
                                            {
                                                "example_id": "31525834-c4b6-4f29-9a4f-4a4775587ad7",
                                                "sense_id": "ee198add-da34-3ce2-bee8-5a883d297db1",
                                                "text": "„Ein Pfeil wies eine Treppe hinauf, die in einer kleinen Cafeteria mit Häkeldeckchen und gemusterten Gardinen endete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gardine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68f688f0-3e44-3129-9b1d-624d5f24df0c",
                                        "entry_id": "ad00ba3a-53e7-36be-947d-7e194fc42462",
                                        "glosses": [
                                            "alter nordfriesischer weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f740b1c-67aa-4118-acce-ef8a5c3a8ae2",
                                                "sense_id": "68f688f0-3e44-3129-9b1d-624d5f24df0c",
                                                "text": "Sie heißt Gardine."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
