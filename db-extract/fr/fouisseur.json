                                    },
                                    {
                                        "sense_id": "8121a0aa-caab-3ace-bf93-b29aa69ad10a",
                                        "entry_id": "36ff1382-c6e3-3746-aa04-da19f3163c8f",
                                        "glosses": [
                                            "Person, die im Untergrund/Hintergrund aktiv gegen andere arbeitet"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
