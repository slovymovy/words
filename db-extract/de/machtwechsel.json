                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b7f3c9d-fe00-48e4-8164-8ef11ee2987d",
                                "sense_id": "fc026f86-f65d-3db4-8caf-f99bb8b4095a",
                                "text": "„Aus den häufigen Machtwechseln resultierten die vielfältige Kultur der Stadt und die bunt zusammengesetzte Bevölkerung.“"
                            },
                            {
                                "example_id": "84f1acb1-c19d-4dec-be30-ef2d040fe234",
                                "sense_id": "fc026f86-f65d-3db4-8caf-f99bb8b4095a",
                                "text": "„Ein Machtwechsel stand bevor, was natürlich nicht jedem passte.“"
                            }
