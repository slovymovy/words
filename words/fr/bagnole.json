                        {
                            "text": "Il a garé sa vieille <w>bagnole</w> juste devant l'entrée du garage.",
                            "target_lang_translations": {
                                "en": "He parked his old <w>car</w> right in front of the garage entrance.",
                                "ru": "Он припарковал свою старую <w>машину</w> прямо перед входом в гараж.",
                                "nl": "Hij heeft zijn oude <w>auto</w> net voor de ingang van de garage geparkeerd.",
                                "de": "Er hat seine alte <w>Karre</w> direkt vor dem Eingang zur Garage geparkt.",
                                "pl": "Zaparkował swój stary <w>samochód</w> tuż przed wejściem do garażu.",
                                "it": "Ha parcheggiato la sua vecchia <w>macchina</w> proprio davanti all'ingresso del garage.",
                                "cs": "Zaparkoval své staré <w>auto</w> hned před vjezdem do garáže.",
                                "tr": "Eski <w>arabasını</w> garajın girişinin hemen önüne park etti.",
                                "es": "Aparcó su viejo <w>coche</w> justo delante de la entrada del garaje.",
                                "zh": "他把自己那辆旧<w>车</w>停在了车库入口的正前方。"
                            }
                        },
                        {
                            "text": "Nous devons prendre la <w>bagnole</w> pour aller faire les courses au supermarché.",
                            "target_lang_translations": {
                                "en": "We have to take the <w>car</w> to go grocery shopping at the supermarket.",
                                "ru": "Нам нужно взять <w>машину</w>, чтобы съездить за продуктами в супермаркет.",
                                "nl": "We moeten de <w>auto</w> nemen om boodschappen te doen bij de supermarkt.",
                                "de": "Wir müssen die <w>Karre</w> nehmen, um im Supermarkt einzukaufen.",
                                "pl": "Musimy wziąć <w>samochód</w>, żeby pojechać na zakupy do supermarketu.",
                                "it": "Dobbiamo prendere la <w>macchina</w> per andare a fare la spesa al supermercato.",
                                "cs": "Musíme vzít <w>auto</w>, abychom zajeli nakoupit do supermarketu.",
                                "tr": "Süpermarkete alışverişe gitmek için <w>arabayı</w> almamız gerekiyor.",
                                "es": "Tenemos que coger el <w>coche</w> para ir a hacer la compra al supermercado.",
                                "zh": "我们得开<w>车</w>去超市买东西。"
                            }
                        }
