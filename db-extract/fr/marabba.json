                        "glosses": [
                            "Instrument de musique à cordes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40353d9-110d-4e70-98ba-8e3b273288a9",
                                "sense_id": "847f9751-a5f3-3c09-a7fe-124ce0dddb88",
                                "text": "Les Arabes ont un autre instrument pour jouer avec l'archet, appelé marabba; il consiste en une corde de crin et une peau tendue sur le corps de l'instrument. Il s'accorde à merveille avec les voix aiguës des chanteurs dans les cafés publics."
                            },
                            {
                                "example_id": "5b4c7276-0ebb-4f20-831e-91d974c43a53",
                                "sense_id": "847f9751-a5f3-3c09-a7fe-124ce0dddb88",
                                "text": "Le semensendje est l'instrument des vagabonds, qui accompagne les danseuses. Les Arabes appellent marabba un autre violon à une corde de crin de cheval, dont le corps est aussi tendu d'une peau: ce violon s'accorde très bien avec la voix aigre des chanteurs du commun, qui crient à plein gosier, quand ils chantent dans les cafés."
                            }
                        ]
                    }
