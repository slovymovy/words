                            {
                                "example_id": "bec8f2bc-b3a4-4a3f-9d95-9be8bb3b6868",
                                "sense_id": "fa116ab1-959c-3750-bbab-6af54eb25853",
                                "text": "Та девка не прислуга, а блудня, кою он своим ближним опричникам изредка попользовать даёт."
                            }
                        ]
                    },
                    {
                        "sense_id": "deb4193b-f703-3ff7-bbb4-0f82f23cfa82",
                        "entry_id": "44e8fe7c-c468-3e2b-b6c0-0752915e2f12",
                        "glosses": [
                            "прост. тот, кто крадёт еду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5c2d913-8979-44ae-94df-1c5871701668",
                                "sense_id": "deb4193b-f703-3ff7-bbb4-0f82f23cfa82",
                                "text": "Такой блудня у него кот, все знают, хоть кого спроси."
                            }
                        ]
                    }
