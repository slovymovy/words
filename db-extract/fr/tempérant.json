                ],
                "senses": [
                    {
                        "sense_id": "3da5427a-2371-3e23-a5c3-90c64e020ce4",
                        "entry_id": "0b5d335e-aa36-3140-99e7-da6678ea5e44",
                        "glosses": [
                            "Personne tempérante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d177e8-261b-4f19-8290-59cc51103a6d",
                                "sense_id": "3da5427a-2371-3e23-a5c3-90c64e020ce4",
                                "text": "Le tempérant évite toutes sortes d’excès."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5030151-c512-4b82-9105-cd79d92b394b",
                        "source_entry_id": "0b5d335e-aa36-3140-99e7-da6678ea5e44",
                        "source_sense_id": "3da5427a-2371-3e23-a5c3-90c64e020ce4",
