                            }
                        ]
                    },
                    {
                        "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                        "entry_id": "c73058f0-8893-321b-aeed-85921993e679",
                        "glosses": [
                            "to drive, to reduce, to bring, to carry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d66720-21fc-40c3-ac4f-12151c3fb562",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до сумасше́ствия",
                                "translation": "to drive crazy",
                                "english": "to drive crazy"
                            },
                            {
                                "example_id": "de50cdd5-0ce2-4608-8553-d425ee7a2644",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до конца́",
                                "translation": "to carry through, to carry to conclusion, to complete",
                                "english": "to carry through, to carry to conclusion, to complete"
                            },
                            {
                                "example_id": "6f5a9cf1-e78e-4bc4-a7f9-6416c1e36134",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до бе́шенства",
                                "translation": "to drive up the wall, to drive crazy, to drive nuts, to enrage",
                                "english": "to drive up the wall, to drive crazy, to drive nuts, to enrage"
                            },
                            {
                                "example_id": "7221fd7c-ff4e-49cd-98b7-202a3f26f2bc",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до изнеможе́ния",
                                "translation": "to tire out",
                                "english": "to tire out"
                            },
                            {
                                "example_id": "b3c9e1e3-dcc8-4a20-82ea-cd5707008e8e",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до беды́",
                                "translation": "to lead to trouble",
                                "english": "to lead to trouble"
                            },
                            {
                                "example_id": "88ebf569-62b9-41a6-8670-51795ee7bed5",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до нищеты́",
                                "translation": "to reduce to poverty",
                                "english": "to reduce to poverty"
                            },
                            {
                                "example_id": "8d82db2b-6563-4801-997c-7f0ba66054b7",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до отча́яния",
                                "translation": "to drive to despair",
                                "english": "to drive to despair"
                            },
                            {
                                "example_id": "29c86a17-2549-429d-8b77-950101529982",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до слёз",
                                "translation": "to drive to tears, to make cry",
                                "english": "to drive to tears, to make cry"
                            },
                            {
                                "example_id": "7a4d14ff-6641-41cb-8fc0-c5ad7834ba6e",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до соверше́нства",
                                "translation": "to perfect, to bring to perfection",
                                "english": "to perfect, to bring to perfection"
                            },
                            {
                                "example_id": "e128f9d4-64e7-4206-82f1-5c823dfd642a",
                                "sense_id": "d9749f2e-03c2-3e5a-bae4-f8fc06026946",
                                "text": "доводи́ть до кра́йности",
                                "translation": "to push too far, to drive over the edge, to take to extremes, to carry to an extreme",
                                "english": "to push too far, to drive over the edge, to take to extremes, to carry to an extreme"
                            }
                        ]
