                "senses": [
                    {
                        "sense_id": "0ea3e751-4e01-3ed1-99ae-f8607764061f",
                        "entry_id": "f076a355-03fb-3c89-a9c8-501e386fd743",
                        "glosses": [
                            "jemand, der eine Verhandlung führt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "02f7bd24-e5df-442d-92e2-c2496198ad59",
                                "sense_id": "0ea3e751-4e01-3ed1-99ae-f8607764061f",
                                "text": "Der Verhandler unserer Firma hatte erreicht, dass die Zahlungen für drei Monate gestundet werden."
                            },
                            {
                                "example_id": "c97f1df6-c0e9-440a-a9ac-5ec016675e50",
                                "sense_id": "0ea3e751-4e01-3ed1-99ae-f8607764061f",
                                "text": "„Als einer, der viele Jahre als sein \"Nachbar\" im selben Regierungsgebäude mit ihm viele Verhandlungen geführt hat, habe ich ihn als lösungsorientierten Verhandler, aber auch als Freund und interessanten Gesprächspartner erlebt\", so der Bundeskanzler.“"
                            },
                            {
                                "example_id": "f94df78a-c66e-4bc4-934d-aa202a4c7db8",
                                "sense_id": "0ea3e751-4e01-3ed1-99ae-f8607764061f",
                                "text": "„Die Steuerreform 2004 und 2005 trage eindeutig die Handschrift der freiheitlichen Verhandler unter Landeshauptmann Jörg Haider, so Bundesparteiobmann Haupt.“"
                            },
                            {
                                "example_id": "28345692-cd30-4c6f-bf86-496e287a62d2",
                                "sense_id": "0ea3e751-4e01-3ed1-99ae-f8607764061f",
                                "text": "„Gleichzeitig aber entwickelte sich der ehemalige Handelslehrer zu einem brillanten Verhandler und einer vorzüglich vernetzten Figur der internationalen Diplomatie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
