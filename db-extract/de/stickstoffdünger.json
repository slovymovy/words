                    {
                        "sense_id": "7252e91a-6972-3f3d-a1a7-2df988101960",
                        "entry_id": "ff622f84-4e69-3389-9474-2ea8860579e3",
                        "glosses": [
                            "Düngemittel, welches den gedüngten Pflanzen den für ihr Wachstum benötigten Stickstoff zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2befd8a-cc98-45e6-9fcf-169e76e67643",
                                "sense_id": "7252e91a-6972-3f3d-a1a7-2df988101960",
                                "text": "„Stickstoffdünger wird industriell durch das Haber-Bosch-Verfahren erzeugt, in großen Fabriken entsteht mit viel Energieaufwand Ammonium aus Luft.“"
                            },
                            {
                                "example_id": "3b83b845-d171-4d76-86ac-fa80e04cfa31",
                                "sense_id": "7252e91a-6972-3f3d-a1a7-2df988101960",
                                "text": "„In den Daten sei ein klarer Zusammenhang zwischen den Emissionen und den regional eingesetzten Mengen von Stickstoffdünger erkennbar.“"
                            }
                        ],
