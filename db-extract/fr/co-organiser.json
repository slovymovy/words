                "senses": [
                    {
                        "sense_id": "c2661612-f2f0-3141-9d76-14d2ac59d0b0",
                        "entry_id": "589e91d6-6e24-3582-a790-ef14073c5e92",
                        "glosses": [
                            "Organiser en commun avec quelqu’un d’autre (ou plusieurs autres)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b878585-70e6-4bbc-bbc5-a54544710bd0",
                                "sense_id": "c2661612-f2f0-3141-9d76-14d2ac59d0b0",
                                "text": "En 1998, une conférence du Foresight Institute sur l’ingénierie moléculaire est soutenue par la NSF, qui co-organise un forum animé par Roco lui-même."
                            },
                            {
                                "example_id": "0382be26-6e71-4416-8f96-ee4eba9ba326",
                                "sense_id": "c2661612-f2f0-3141-9d76-14d2ac59d0b0",
                                "text": "La course, co-organisée par le comité de la Ronde Finstérienne, le comité de Saint-Jacques/Guiclan, et la Landivisienne Cycliste, s’élancera à 14 h pour 10 tours de 5 km à effectuer."
                            },
                            {
                                "example_id": "4280c942-5e10-4ca5-a09e-0ad85252e19f",
                                "sense_id": "c2661612-f2f0-3141-9d76-14d2ac59d0b0",
                                "text": "Co-organisé avec Samuel Dumas, fondateur d’Acadee, un organisme de formation à la blockchain."
                            }
                        ]
