                                    {
                                        "sense_id": "4bd2ea16-4ec7-380f-9a47-f1f66a26ec6e",
                                        "entry_id": "e8d3107b-162c-3ef8-afa4-82b3b5d80dc4",
                                        "glosses": [
                                            "Zustand oder Eigenschaft, aktiv zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bdc007a-42bb-4755-924e-78203eff332c",
                                                "sense_id": "4bd2ea16-4ec7-380f-9a47-f1f66a26ec6e",
                                                "text": "Deine Aktivität im Unterricht lässt zu wünschen übrig."
                                            },
                                            {
                                                "example_id": "63909e09-0f4b-4f4a-ab38-fd7f4f3ca882",
                                                "sense_id": "4bd2ea16-4ec7-380f-9a47-f1f66a26ec6e",
                                                "text": "Mann sucht Freizeitpartnerin für sportliche Aktivitäten."
                                            },
                                            {
                                                "example_id": "675b2060-bef2-4583-b60a-09419fae1429",
                                                "sense_id": "4bd2ea16-4ec7-380f-9a47-f1f66a26ec6e",
                                                "text": "„Als ich am schwarzen Brett vorbeikam, stellte ich fest, dass eine weitere Aktivität angeboten wurde.“"
                                            },
                                            {
                                                "example_id": "749e7ad1-ce6b-4a62-a922-4370d80817b6",
                                                "sense_id": "4bd2ea16-4ec7-380f-9a47-f1f66a26ec6e",
                                                "text": "„Seine sportlichen Aktivitäten wie Extrembergsteigen und Gleitschirmfliegen legen nahe, dass er gern an seine Grenzen ging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6fc568ef-25ee-3bc8-a785-18bbb6d7f6af",
                                        "entry_id": "e8d3107b-162c-3ef8-afa4-82b3b5d80dc4",
                                        "glosses": [
                                            "physikalische Größe zur Definition eines radioaktiven Stoffes"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a95755-8d47-4cc7-a2a8-5edb647e1888",
                                                "sense_id": "6fc568ef-25ee-3bc8-a785-18bbb6d7f6af",
                                                "text": "Dieser Stoff besitzt eine hohe Aktivität."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "848f548f-1e1d-3f30-bf46-a6db60d65f62",
                                        "entry_id": "e8d3107b-162c-3ef8-afa4-82b3b5d80dc4",
                                        "glosses": [
                                            "kleinste Ausführungseinheit in einem Arbeitsablauf, dem eine Tätigkeit, ausführende Ressourcen (Personen, Maschinen), zu benutzende Ressourcen (Werkzeuge, Maschinen, anderweitige Betriebsmittel) und zeitliche Abhängigkeiten (Reihenfolge, Ausführungsdauer usw.) zugeordnet sind"
                                        ],
                                        "tags": [
                                            "Arbeitsplanung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "366ae394-881b-43da-8b88-dbcbdf9a4719",
                                                "sense_id": "848f548f-1e1d-3f30-bf46-a6db60d65f62",
