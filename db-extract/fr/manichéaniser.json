                "senses": [
                    {
                        "sense_id": "73e565a9-6338-3dff-9034-5cac79508253",
                        "entry_id": "d6743d30-bbff-3a4b-9ee4-c9f032be714d",
                        "glosses": [
                            "Donner un caractère manichéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f8bd495-6bdd-49f0-9e4b-34cd116865f2",
                                "sense_id": "73e565a9-6338-3dff-9034-5cac79508253",
                                "text": "Bien évidemment, la triple force de cet Agora réside dans sa capacité à ne pas stigmatiser, caricaturer ou manichéaniser."
                            },
                            {
                                "example_id": "307b8948-6a10-4193-8b03-bbcab91f021d",
                                "sense_id": "73e565a9-6338-3dff-9034-5cac79508253",
                                "text": "Il faut exagérer, manichéaniser, amplifier !"
                            },
                            {
                                "example_id": "d3c1eeae-52f8-4462-95fa-5f0f81863243",
                                "sense_id": "73e565a9-6338-3dff-9034-5cac79508253",
                                "text": "Je dis juste qu'il faut pas manichéaniser le monde et j'ai moyennement apprécié le lynchage extrême."
                            }
                        ]
                    }
