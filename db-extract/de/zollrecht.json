                                "example_id": "eaf781dc-4235-45fe-aedf-f287fcecf0a8",
                                "sense_id": "4426cd16-db33-3bdb-ae72-84e52938c7d2",
                                "text": "„Die Definitionen des europäischen Zollrechts und des nationalen Außenwirtschaftsrechts sind nicht deckungsgleich, sondern unterscheiden sich im Detail.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
