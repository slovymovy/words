                    {
                        "sense_id": "ccaab0ed-19b1-3578-b0f4-1a559235524a",
                        "entry_id": "ca15531d-5d88-3864-af85-9eca787b5f9b",
                        "glosses": [
                            "defensivster Spieler einer Sportmannschaft, der Gegentore verhindern soll und meist mit Sonderrechten ausgestattet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa92fb5-ba1e-4ead-8758-0551da800eb3",
                                "sense_id": "ccaab0ed-19b1-3578-b0f4-1a559235524a",
                                "text": "Die Keeper der Heimmannschaft musste drei Gegentore hinnehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2d55e62a-2ea2-3612-81ee-dfce50e136bc",
                        "entry_id": "ca15531d-5d88-3864-af85-9eca787b5f9b",
