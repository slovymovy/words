                                                "sense_id": "3925bbf1-5459-32dc-a40d-1707050fde34",
                                                "text": "Give me a hoist over that wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b97fb95-aa8d-356b-b4fc-04e79498ca1d",
                                        "entry_id": "5d080dd2-37ba-3450-ab17-35e795389703",
                                        "glosses": [
                                            "The triangular vertical position of a flag, as opposed to the flying state, or triangular vertical position of a sail, when flying from a mast."
                                        ],
                                        "tags": [],
