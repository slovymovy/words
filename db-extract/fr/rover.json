        "fr-extract.jsonl": [
            {
                "entry_id": "0acc2492-4a5b-347b-a578-a9fa19cfbcd5",
                "word": "rover",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "407db4d7-8441-4a49-88d5-93a80118318b",
                        "entry_id": "0acc2492-4a5b-347b-a578-a9fa19cfbcd5",
                        "tags": [
                            "plural"
                        ],
                        "form": "rovers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "781156ea-7d7a-3c7e-ac87-a06114bc3a07",
                        "entry_id": "0acc2492-4a5b-347b-a578-a9fa19cfbcd5",
                        "glosses": [
                            "Robot mobile conçu pour se déplacer, effectuer des prélèvements, analyses ou photographies à la surface d’astres éloignés de la Terre et du système solaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79df7d29-d1c7-4652-80bd-c3cd157b8bd9",
                                "sense_id": "781156ea-7d7a-3c7e-ac87-a06114bc3a07",
                                "text": "Les rovers Opportunity et Spirit se sont posés sur des faces opposées de Mars en 2004 et sont partis à la recherche de signes géologiques qui démontreraient que cette planète froide et sèche était jadis humide et chaude."
                            },
                            {
                                "example_id": "de5bb4d3-6f06-4ff6-9dab-b66c46b3d4af",
                                "sense_id": "781156ea-7d7a-3c7e-ac87-a06114bc3a07",
                                "text": "Après avoir parcouru pas moins de 468 millions de kilomètres dans l'espace depuis son décollage en juillet 2020 du cap Canaveral en Floride, la mission Mars 2020 s’apprête à larguer le rover Perseverance à la surface de la planète Mars."
                            }
                        ]
                    },
                    {
                        "sense_id": "01dcce34-a72d-338c-bf63-8f9e55d53b9c",
                        "entry_id": "0acc2492-4a5b-347b-a578-a9fa19cfbcd5",
                        "glosses": [
                            "Rôdeur, position d’un joueur au centre du terrain."
                        ],
                        "tags": [
                            "Football australien"
                        ],
                        "examples": [
                            {
                                "example_id": "07918fac-9262-4190-a3f0-717e6f907f4c",
                                "sense_id": "01dcce34-a72d-338c-bf63-8f9e55d53b9c",
                                "text": "J’ai vu South Adelaide jouer contre Sturt. C’est Sturt qui a gagné, dans les dix dernières minutes, mené depuis le début. Sans doute grâce à la détermination et à l’intelligence de leur « rover » aborigène."
                            },
                            {
                                "example_id": "1f0c490a-a4b5-41d8-9a6a-b18b6b725ad1",
                                "sense_id": "01dcce34-a72d-338c-bf63-8f9e55d53b9c",
                                "text": "Seuls sont admis dans le carré central le joueur de centre, le rover et les deux followers de chaque équipe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41a9129e-0b17-48d9-8385-dc48d8ecc109",
                        "source_entry_id": "0acc2492-4a5b-347b-a578-a9fa19cfbcd5",
                        "source_sense_description": "robot",
                        "target_lang_word": "rover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0247375c-ddaf-34b6-9d10-4880c37153a1",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A randomly selected target."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "146bbb48-5bf5-4c8e-b662-a493b110737f",
                                                "sense_id": "0247375c-ddaf-34b6-9d10-4880c37153a1",
                                                "text": "\"By my hilt! no. There was little Robby Withstaff, and Andrew Salblaster, and Wat Alspaye, who broke the neck of the German. Mon Dieu! what men they were! Take them how you would, at long butts or short, hoyles, rounds, or rovers, better bowmen never twirled a shaft over their thumb-nails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7939ae82-efc5-31d2-9f74-cbe57ad62e65",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "One who roves, a wanderer, a nomad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98fa99e4-5e0a-48a1-b1b6-02f8ad92c0c8",
                                                "sense_id": "7939ae82-efc5-31d2-9f74-cbe57ad62e65",
                                                "text": "I must go down to the seas again, to the vagrant gypsy life,\nTo the gull's way and the whale's way, where the wind's like a whetted knife;\nAnd all I ask is a merry yarn from a laughing fellow-rover,\nAnd quiet sleep and a sweet dream when the long trick's over."
                                            },
                                            {
                                                "example_id": "d7b31a02-f100-4124-8069-19b4e1846113",
                                                "sense_id": "7939ae82-efc5-31d2-9f74-cbe57ad62e65",
                                                "text": "But these islands, undisturbed for years, relapsed into their previous obscurity; and it is only recently that anything has been known concerning them. Once in the course of a half century, to be sure, some adventurous rover would break in upon their peaceful repose. and astonished at the unusual scene, would be almost tempted to claim the merit of a new discovery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fc3681e-4662-32fe-b9b3-29f117424820",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A vagabond, a tramp, an unsteady, restless person, one who by habit doesn't settle down or marry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f6f1a0-a3f2-449d-92d9-98cf58e45145",
                                                "sense_id": "3fc3681e-4662-32fe-b9b3-29f117424820",
                                                "text": "Give him the word, that I'm not a rover, and tell him that his lonely days are over."
                                            },
                                            {
                                                "example_id": "21bdf584-6ae5-45d6-8087-93adf5cb3a5a",
                                                "sense_id": "3fc3681e-4662-32fe-b9b3-29f117424820",
                                                "text": "She is a rover and dislikes any sort of ties, physical or emotional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9bfcd8-64eb-38e2-a3dc-00f350d00769",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A vehicle for exploring extraterrestrial bodies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e16785d9-9898-4580-b852-fe37c0ab87da",
                                                "sense_id": "5a9bfcd8-64eb-38e2-a3dc-00f350d00769",
                                                "text": "September 19, 2005, Dave Lane, Mars Exploration Rover \"OPPORTUNITY\"\nNASA's Mars Exploration Rover Opportunity is currently traveling southward over a pavement of outcrop dubbed the \"Erebus Highway.\" \"Erebus Crater,\" the rover's next target, lies less than 100 meters (328 feet) south of its current position"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d02a92fc-ea29-397a-8f39-33f0a0b578e9",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A remotely-operated vehicle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7a1d17f-1403-3800-bf09-babb3e64ec06",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A position that is one of three of a team's followers, who follow the ball around the ground. Formerly a position for short players, rovers in professional leagues are frequently over 183 cm (6')."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d3868e2-cb65-3e01-96a1-bce43f735d92",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A defensive back position whose coverage responsibilities are a hybrid of those of a cornerback, safety and linebacker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "052fa208-da61-45e1-9bba-bff5e579b181",
                                                "sense_id": "0d3868e2-cb65-3e01-96a1-bce43f735d92",
                                                "text": "I went to Coach Beamer and, because we had a lot of outside linebackers, ask him if I could play rover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "919d9abe-46b1-3d0a-af29-1bdbb6769a8b",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A ball which has passed through all the hoops and would go out if it hit the stake but is continued in play; also, the player of such a ball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fb1a1fb-e9df-38bf-809e-6d29597f6a81",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "The tenth defensive player in slow-pitch softball."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3dbd6e5-c3f2-3057-a273-83357771eab3",
                                        "entry_id": "0ef85dee-9fc4-3bdf-bf22-09b463ffee6d",
                                        "glosses": [
                                            "A sort of arrow."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5c140ef-d349-4413-84b0-4a6733eb6fe9",
                                                "sense_id": "c3dbd6e5-c3f2-3057-a273-83357771eab3",
                                                "text": "All sorts, flights, rovers, and butt shafts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0769c75-6344-31d7-99f7-854f41806e17",
                                        "entry_id": "418be03c-25ce-3883-b5dd-6b57c8e486e7",
                                        "glosses": [
                                            "A pirate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "185cc781-0a9e-4a3c-8455-8c6286545fdc",
                                                "sense_id": "c0769c75-6344-31d7-99f7-854f41806e17",
                                                "text": "Diogenes will deſpiſe thee for all that, who being expoſed and offered to ſale by the rovers and theeves that tooke him, cried and proclaimed himſelfe aloud: Who will buy a maſter who?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41ab14f2-f11c-3c1b-969b-a1e89eaa01b1",
                                        "entry_id": "418be03c-25ce-3883-b5dd-6b57c8e486e7",
                                        "glosses": [
                                            "A pirate ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca6187d-f981-4a16-a795-24f9d5ab2da8",
                                                "sense_id": "41ab14f2-f11c-3c1b-969b-a1e89eaa01b1",
                                                "text": "The first was this: our ship making her course towards the Canary Islands, or rather between those islands and the African shore, was surprised in the grey of the morning by a Turkish rover of Sallee, who gave chase to us with all the sail she could make."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0c1c1a7-b686-4952-a287-e121b840f3bc",
                        "source_entry_id": "0acc2492-4a5b-347b-a578-a9fa19cfbcd5",
