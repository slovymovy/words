                    {
                        "sense_id": "ae964e7f-8f0e-3bb2-9258-fd175f10293e",
                        "entry_id": "eb1f36fe-47b5-34c7-8bef-b3c694a8034f",
                        "glosses": [
                            "Tier, das Abscheu, Angst oder dergleichen auslöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b1961d1-5942-4194-b9d5-159e882213f7",
                                "sense_id": "ae964e7f-8f0e-3bb2-9258-fd175f10293e",
                                "text": "„Das war nichts anderes als ein hässliches, gefährliches Drecksvieh.“"
                            },
                            {
                                "example_id": "c98c106f-fc9a-4234-ab7e-022e7b0b20e0",
                                "sense_id": "ae964e7f-8f0e-3bb2-9258-fd175f10293e",
                                "text": "„Die Frontlinie verläuft dabei entlang \"treuester Freund\" beziehungsweise \"niedlichster Mitbewohner\" auf der einen Seite - meist jene der Tierbesitzer - sowie \"Drecksvieh\" und \"Schädling\" auf der anderen, meist geäußert nach dem Tritt in den Hundehaufen oder dem Blick auf das geplünderte Garten-Buffet.“"
                            },
                            {
                                "example_id": "54767e90-9a44-47e2-8fa5-80ad41ecbfcf",
                                "sense_id": "ae964e7f-8f0e-3bb2-9258-fd175f10293e",
                                "text": "„Aber das Drecksvieh zeigte sich nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
