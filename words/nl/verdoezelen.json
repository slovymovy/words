                    "sense_definition": "Trachten aan de aandacht te onttrekken; verbergen of maskeren om ontdekking te voorkomen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze trachtten te <w>verdoezelen</w> dat er veel geld verdwenen was.",
                            "target_lang_translations": {
                                "en": "They tried to <w>cover up</w> the fact that a lot of money had disappeared."
                            }
                        },
                        {
                            "text": "De politicus probeerde de waarheid te <w>verdoezelen</w> tijdens het interview.",
                            "target_lang_translations": {
                                "en": "The politician tried to <w>gloss over</w> the truth during the interview."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbergen",
                        "maskeren",
                        "verhullen",
                        "toedekken"
                    ],
                    "antonyms": [
                        "onthullen",
                        "openbaren"
                    ],
                    "common_phrases": [
                        "de waarheid verdoezelen",
                        "fouten verdoezelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To try to keep something out of sight or attention; to hide, cover up, or mask to prevent discovery."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cover up",
                                "target_lang_sense_clarification": "to conceal a mistake, crime, or embarrassing fact"
                            },
                            {
                                "target_lang_word": "gloss over",
                                "target_lang_sense_clarification": "to treat or describe something bad in a way that makes it seem less important"
                            },
                            {
                                "target_lang_word": "hush up",
                                "target_lang_sense_clarification": "to suppress information or prevent it from becoming public"
                            },
                            {
                                "target_lang_word": "conceal",
                                "target_lang_sense_clarification": "to hide or keep something secret"
                            }
