            "senses": [
                {
                    "sense_id": "227012d8-466b-3545-acd7-d9191fb26f90",
                    "sense_definition": "Feeling stressed, strained, or exhausted as a result of being subject to constant demands, pressure, or torment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager looked tired and <w>harassed</w> after dealing with angry customers all morning.",
                            "target_lang_translations": {
                                "de": "Der Manager sah müde und <w>gestresst</w> aus, nachdem er sich den ganzen Vormittag mit wütenden Kunden auseinandergesetzt hatte."
                            }
                        },
                        {
                            "text": "He managed to raise three energetic children while maintaining a calm demeanor, never seeming <w>harassed</w>.",
                            "target_lang_translations": {
                                "de": "Er schaffte es, drei lebhafte Kinder großzuziehen und dabei eine ruhige Ausstrahlung zu bewahren, ohne je <w>gehetzt</w> zu wirken."
                            }
                        }
                    ],
                    "synonyms": [
                        "stressed",
                        "pressured",
                        "strained"
                    ],
                    "antonyms": [
                        "relaxed",
                        "carefree"
                    ],
                    "common_phrases": [
                        "look harassed",
                        "feel harassed"
                    ],
                    "target_lang_definitions": {
                        "de": "Gestresst, überfordert oder erschöpft aufgrund ständiger Anforderungen, Belastungen oder Schikanen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gestresst",
                                "target_lang_sense_clarification": "stark beansprucht, nervlich belastet"
                            },
                            {
                                "target_lang_word": "gehetzt",
                                "target_lang_sense_clarification": "unter Zeit- oder Leistungsdruck stehend"
                            },
                            {
                                "target_lang_word": "überarbeitet",
                                "target_lang_sense_clarification": "erschöpft durch zu viele Anforderungen"
                            },
                            {
                                "target_lang_word": "geplagt",
                                "target_lang_sense_clarification": "von Sorgen oder Belastungen gezeichnet"
                            }
                        ]
                    }
