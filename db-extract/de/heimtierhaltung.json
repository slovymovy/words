                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c654272c-a4eb-45b6-9c51-42f24df6de05",
                                "sense_id": "4281f766-e74c-3a35-8f01-b25e70c34315",
                                "text": "Die Heimtierhaltung entwickelte sich 2007 entgegen dem demografischen Trend: Denn Heimtiere lebten zunehmend bei jüngeren Tierhaltern und in Haushalten mit 3 oder mehr Personen."
                            },
                            {
                                "example_id": "910bba12-572c-4b69-a9c8-2bc4d49f2170",
                                "sense_id": "4281f766-e74c-3a35-8f01-b25e70c34315",
                                "text": "„Einen weiteren Fortschritt im Bereich der Heimtierhaltung gab es durch die Neuregelungen der Tierschutz-Hundeverordnung vom 2.5.2001.“"
                            },
                            {
                                "example_id": "8f6411bc-b7a3-4df6-b66b-558042542a21",
                                "sense_id": "4281f766-e74c-3a35-8f01-b25e70c34315",
                                "text": "„Beim Betreten des Rathauses entdeckt der Besucher auf dem Boden Tierspuren, die zur Ausstellung „artgerechte Heimtierhaltung“ der BUNDSpechte Jüchen führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
