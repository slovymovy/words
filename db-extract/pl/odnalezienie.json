                "senses": [
                    {
                        "sense_id": "8282d9ee-b4d8-3ba3-b059-529ca7037eb5",
                        "entry_id": "c7205f58-3960-3d8c-afba-5c652a109e3d",
                        "glosses": [
                            "rzecz. odczas. od odnaleźć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d29958-6ab9-46e6-a520-e227202038c2",
                                "sense_id": "8282d9ee-b4d8-3ba3-b059-529ca7037eb5",
                                "text": "Odnalezienie nowego domu wydawało się niemal niemożliwe, bo imperialni zagrozili publicznie, że każdy cywilizowany świat, który zapewni schronienie czy możliwość bezpiecznego przelotu jednostkom Sojuszu, padnie ofiarą wyniszczających sankcji i okupacji."
                            },
                            {
                                "example_id": "455e2755-d428-4c64-8ee8-ae42f6f6263e",
                                "sense_id": "8282d9ee-b4d8-3ba3-b059-529ca7037eb5",
                                "text": "– Miast frasować się losem ubogich dziadów – odezwał się znowu demeryt – i przeżywać rozterki moralne, użyłbyś raczej swych talentów celem odnalezienia drogi."
                            },
                            {
                                "example_id": "ff4df1af-c497-4fd0-a485-6d25332a5058",
                                "sense_id": "8282d9ee-b4d8-3ba3-b059-529ca7037eb5",
                                "text": "Aby splatynować Ragnarok wymagane jest odczytanie inskrypcji wyrytych w kamieniu, odnalezienie zwojów oraz skradzionych skarbów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
