                        "glosses": [
                            "Défaire ce qui était engrené."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d84fbce9-1735-4fc0-9bb8-aeb9ce2c8b61",
                                "sense_id": "0948196f-bcc3-35ab-8dd6-2554b4c187a1",
                                "text": "Un manchon d’embrayage avec son bras de levier sert à engrener ou dégrener la vis sans fin et le volant ou croisillon."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8e3eb12-17e2-3333-9033-82863addd90a",
                        "entry_id": "88acfa81-b896-30ea-8c28-e7caf6475087",
                        "glosses": [
                            "Se séparer, se quitter."
                        ],
                        "tags": [
                            "obsolete",
