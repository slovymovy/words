{
    "word_family": [
        "grounding",
        "groundless",
        "ungrounded",
        "groundwork"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1bed75a3-aa67-3cfe-9f31-97d12cc30dd2",
                    "sense_definition": "Not allowed to leave the house or participate in social activities as a punishment, usually applied to children or teenagers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <grounded> for a week because he failed his math test.",
                            "target_lang_translations": {
                                "ru": "Его <наказали> на неделю, потому что он провалил тест по математике.",
                                "es": "Estuvo <castigado sin salir> durante una semana porque reprobó su examen de matemáticas."
                            }
                        },
                        {
                            "text": "My parents said I am <grounded> until I clean my room.",
                            "target_lang_translations": {
                                "ru": "Родители сказали, что я <наказан> (не выйду из дома), пока не уберусь в своей комнате.",
                                "es": "Mis padres dijeron que estoy <castigado> hasta que limpie mi habitación."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grounded for life",
                        "grounded for a week",
                        "get grounded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказанный родителями (обычно запретом выходить из дома или гулять с друзьями).",
                        "es": "Castigado sin salir de casa o sin participar en actividades sociales, generalmente aplicado a niños o adolescentes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказан",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "под домашним арестом",
                                "target_lang_sense_clarification": "ироничное или сленговое выражение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "castigado",
                                "target_lang_sense_clarification": "sin poder salir"
                            },
                            {
                                "target_lang_word": "castigado sin salir",
                                "target_lang_sense_clarification": "prohibición expresa de salir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae75a23-d8cb-3233-ac50-67fac9053613",
                    "sense_definition": "Prohibited from flying, usually due to bad weather, mechanical issues, or regulations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All flights were <grounded> due to the heavy fog.",
                            "target_lang_translations": {
                                "ru": "Все самолеты <остались на земле> из-за сильного тумана.",
                                "es": "Todos los vuelos quedaron <en tierra> debido a la densa niebla."
                            }
                        },
                        {
                            "text": "The pilot was <grounded> pending a medical examination.",
                            "target_lang_translations": {
                                "ru": "Пилот был <отстранён от полётов> до прохождения медицинского осмотра.",
                                "es": "El piloto fue <suspendido de vuelo> a la espera de un examen médico."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grounded flight",
                        "grounded aircraft",
                        "stay grounded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не допущенный к полетам или оставленный на земле (о самолетах или пилотах).",
                        "es": "Con la prohibición de volar, generalmente debido al mal tiempo, problemas mecánicos o normativas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстранённый от полётов",
                                "target_lang_sense_clarification": "о пилоте"
                            },
                            {
                                "target_lang_word": "оставленный на земле",
                                "target_lang_sense_clarification": "о самолёте или рейсе"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "en tierra",
                                "target_lang_sense_clarification": "avión o vuelo sin autorización de despegar"
                            },
                            {
                                "target_lang_word": "detenido en tierra",
                                "target_lang_sense_clarification": "aeronave impedida de despegar"
                            },
                            {
                                "target_lang_word": "suspendido de vuelo",
                                "target_lang_sense_clarification": "piloto o tripulación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0becea1e-0dbd-3913-9987-e0c385e04c4b",
                    "sense_definition": "Connected to the earth as a safety measure for electricity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the washing machine is plugged into a <grounded> outlet.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что стиральная машина подключена к <заземлённой> розетке.",
                                "es": "Asegúrate de que la lavadora esté conectada a un enchufe <con toma de tierra>."
                            }
                        },
                        {
                            "text": "The electrician checked to ensure the wiring was properly <grounded>.",
                            "target_lang_translations": {
                                "ru": "Электрик проверил, правильно ли <заземлена> проводка.",
                                "es": "El electricista comprobó que el cableado estuviera correctamente <conectado a tierra>."
                            }
                        }
                    ],
                    "synonyms": [
                        "earthed"
                    ],
                    "common_phrases": [
                        "grounded outlet",
                        "grounded wire"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in US; 'earthed' is common in UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединенный с землей проводником для безопасности (об электричестве).",
                        "es": "Conectado a la tierra como medida de seguridad eléctrica."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заземлённый",
                                "target_lang_sense_clarification": "электрика"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "conectado a tierra",
                                "target_lang_sense_clarification": "electricidad"
                            },
                            {
                                "target_lang_word": "con toma de tierra",
                                "target_lang_sense_clarification": "enchufe o instalación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fbb79f4-1121-39bd-85df-970f1b123316",
                    "sense_definition": "Having a sensible, realistic, and stable attitude toward life; not arrogant or flighty.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite her fame, she remained a very <grounded> person.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свою славу, она оставалась очень <уравновешенным> человеком.",
                                "es": "A pesar de su fama, siguió siendo una persona muy <centrada>."
                            }
                        },
                        {
                            "text": "He is a <grounded> leader who always listens to his team.",
                            "target_lang_translations": {
                                "ru": "Он <здравомыслящий> лидер, который всегда прислушивается к своей команде.",
                                "es": "Es un líder <con los pies en la tierra> que siempre escucha a su equipo."
                            }
                        }
                    ],
                    "synonyms": [
                        "sensible",
                        "down-to-earth",
                        "level-headed"
                    ],
                    "antonyms": [
                        "flighty",
                        "pretentious",
                        "spacy",
                        "out of touch"
                    ],
                    "common_phrases": [
                        "stay grounded",
                        "remain grounded",
                        "keep someone grounded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий здравым смыслом, реалистичный и устойчивый психологически.",
                        "es": "Que tiene una actitud sensata, realista y equilibrada ante la vida; con los pies en la tierra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уравновешенный",
                                "target_lang_sense_clarification": "о характере"
                            },
                            {
                                "target_lang_word": "здравомыслящий",
                                "target_lang_sense_clarification": "реалистичный"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "con los pies en la tierra",
                                "target_lang_sense_clarification": "realista y sensato"
                            },
                            {
                                "target_lang_word": "sensato",
                                "target_lang_sense_clarification": "juicioso y equilibrado"
                            },
                            {
                                "target_lang_word": "centrado",
                                "target_lang_sense_clarification": "estable y maduro"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1901a7b2-216f-3b09-bc37-e0bcccbb818d",
                    "sense_definition": "Stuck on the bottom of a body of water; unable to move because the water is too shallow.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <grounded> ship had to wait for the high tide to float again.",
                            "target_lang_translations": {
                                "ru": "<Севший на мель> корабль должен был ждать прилива, чтобы снова поплыть.",
                                "es": "El barco <encallado> tuvo que esperar a la marea alta para volver a flotar."
                            }
                        },
                        {
                            "text": "Rescue boats were sent to help the <grounded> vessel near the reef.",
                            "target_lang_translations": {
                                "ru": "Спасательные катера были отправлены на помощь <севшему на мель> судну у рифа.",
                                "es": "Se enviaron barcos de rescate para ayudar a la embarcación <varada> cerca del arrecife."
                            }
                        }
                    ],
                    "synonyms": [
                        "aground"
                    ],
                    "common_phrases": [
                        "grounded vessel",
                        "grounded ship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Застрявший на дне водоема, неспособный двигаться из-за мелководья.",
                        "es": "Atascado en el fondo de una masa de agua, incapaz de moverse debido a la poca profundidad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "севший на мель",
                                "target_lang_sense_clarification": "о судне"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "encallado",
                                "target_lang_sense_clarification": "embarcación"
                            },
                            {
                                "target_lang_word": "varado",
                                "target_lang_sense_clarification": "embarcación"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
