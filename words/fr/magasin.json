                        "grand magasin",
                        "magasin de vêtements"
                    ]
                },
                {
                    "sense_id": "5dd3ad37-85d3-3721-8f11-9b3eaff138cb",
                    "sense_definition": "Plateforme numérique permettant de télécharger ou d'acheter des applications et des contenus en ligne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous pouvez télécharger cette nouvelle application directement sur le <w>magasin</w> en ligne."
                        },
                        {
                            "text": "Ce jeu vidéo est disponible gratuitement dans le <w>magasin</w> d'applications de votre téléphone."
