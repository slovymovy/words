                                        "entry_id": "019b89f5-0376-3899-b985-10bac3d92696",
                                        "glosses": [
                                            "The Paleozoic era."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73610ece-7ea0-4495-a3b7-14b8c4bf0fdc",
                        "source_entry_id": "f34e0200-2f14-3404-9832-26ab7a845ab9",
                        "source_sense_id": "d7b94959-4427-3ddb-9e5c-57da8e1f8455",
