                {
                    "sense_id": "666db4c2-bc53-3da0-9663-9bd423fed18d",
                    "sense_definition": "Devenir pâle, perdre ses couleurs naturelles ou son intensité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "changement_couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a commencé à <w>pâlir</w> dès qu'il a appris la mauvaise nouvelle."
                        },
                        {
                            "text": "Le ciel matinal s'éclaire tandis que les étoiles se mettent à <w>pâlir</w>."
                        }
                    ],
                    "synonyms": [
                        "blêmir"
                    ],
                    "antonyms": [
                        "rougir"
                    ],
                    "common_phrases": [
                        "pâlir de peur",
                        "pâlir d'effroi"
                    ]
                },
                {
                    "sense_id": "0aeda227-4cc2-37a6-9316-c380fce25ceb",
                    "sense_definition": "Perdre de sa force, de son importance ou de son prestige par comparaison.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affaiblissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ses victoires semblent <w>pâlir</w> à côté de cet exploit impressionnant."
                        },
                        {
                            "text": "Son talent éclatant a fini par faire <w>pâlir</w> tous ses rivaux lors de la compétition."
                        }
                    ],
                    "synonyms": [
                        "s'estomper",
                        "s'effacer"
                    ],
                    "antonyms": [
                        "briller",
                        "resplendir"
                    ],
                    "common_phrases": [
                        "faire pâlir d'envie"
                    ]
                },
                {
                    "sense_id": "328dbcdb-08d8-3613-bb76-7657fdb134ca",
                    "sense_definition": "Rendre pâle, faire perdre ses couleurs à une personne ou à un objet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "changement_couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible maladie a visiblement <w>pâli</w> son visage autrefois éclatant de santé."
                        },
                        {
                            "text": "La forte lumière du soleil a <w>pâli</w> les couleurs délicates de ce tissu ancien."
