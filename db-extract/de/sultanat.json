                ],
                "senses": [
                    {
                        "sense_id": "7d4f0428-fdee-3288-a66d-77809aa0610e",
                        "entry_id": "4e088fe2-787e-34ba-9f7c-85e0e898bb56",
                        "glosses": [
                            "Gebiet, über das ein Sultan herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e32f87-0f74-48e7-ab98-54578aadb9be",
                                "sense_id": "7d4f0428-fdee-3288-a66d-77809aa0610e",
                                "text": "„Im nördlichen Teil von Sumatra genoss das wirtschaftlich starke Sultanat von Aceh eine weitestgehende Unabhängigkeit.“"
                            },
                            {
                                "example_id": "33402593-b921-43c9-865e-6a875383f3c3",
                                "sense_id": "7d4f0428-fdee-3288-a66d-77809aa0610e",
                                "text": "„Das Sultanat bestand weiter, aber als Protektorat.“"
                            },
                            {
                                "example_id": "b9f4cbe1-aaee-4ec7-8179-c3f78cd5701c",
                                "sense_id": "7d4f0428-fdee-3288-a66d-77809aa0610e",
                                "text": "„1861 kommt es im Zuge eines Erbfolgestreits zunächst zur Teilung in das Sultanat Sansibar und das eigentliche Sultanat Oman.“"
                            }
                        ],
