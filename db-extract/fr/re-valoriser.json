                                    {
                                        "sense_id": "27a06148-b271-36df-8afa-aa515940f826",
                                        "entry_id": "f7214016-8c99-333c-9b13-09aec0786ede",
                                        "glosses": [
                                            "etwas in seinem Wert (erneut) heraufsetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067741ad-b3ef-43e4-b32c-0f30040ec8e4",
                                                "sense_id": "27a06148-b271-36df-8afa-aa515940f826",
                                                "text": "Doch seitdem der Risikoappetit auf den Märkten sinkt, werden die Positionen aufgelöst, was den Yen stark aufwerten lässt."
                                            },
                                            {
                                                "example_id": "e7831057-1c3f-4968-9ace-2878b5a08085",
                                                "sense_id": "27a06148-b271-36df-8afa-aa515940f826",
                                                "text": "„Zwiebeln sind wichtig, finde ich. Frisch und scharf werten sie jedes Essen auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05aa452e-88c0-3db0-a827-cddde72c18c2",
                                        "entry_id": "f7214016-8c99-333c-9b13-09aec0786ede",
                                        "glosses": [
                                            "etwas in Ansehen, Image heraufsetzen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce77577e-155b-4ee9-bfdf-2f30c621ed6c",
                                                "sense_id": "05aa452e-88c0-3db0-a827-cddde72c18c2",
                                                "text": "Er versuchte, seine Partei aufzuwerten, obwohl die Vorgänger für die Verbesserungen gesorgt haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7c744a2-e265-4201-a631-0a39978e29bb",
                        "source_entry_id": "37c998e7-08f3-3ef8-b033-a02367106073",
                        "source_sense_id": "9ee9e7ca-6bf7-3c1d-873c-e40e6de6c00d",
                        "target_lang_word": "improve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e7ce30f-ccc8-3160-abc6-dca17677bebe",
                                        "entry_id": "9a75060d-697b-337b-876f-816986a0fd2a",
                                        "glosses": [
                                            "To make (something) better; to increase the value or productivity (of something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29314f58-3cad-4d92-961d-80ca189d8f68",
                                                "sense_id": "6e7ce30f-ccc8-3160-abc6-dca17677bebe",
                                                "text": "Painting the woodwork will improve this house."
                                            },
                                            {
                                                "example_id": "00919362-537a-4353-8a32-fc71bd25f899",
                                                "sense_id": "6e7ce30f-ccc8-3160-abc6-dca17677bebe",
                                                "text": "Buying more servers would improve performance."
                                            },
                                            {
                                                "example_id": "843ba5ca-7305-4304-9ea6-907301659317",
                                                "sense_id": "6e7ce30f-ccc8-3160-abc6-dca17677bebe",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b27b7908-3d60-33da-b6e8-53a3919164a0",
                                        "entry_id": "9a75060d-697b-337b-876f-816986a0fd2a",
                                        "glosses": [
                                            "To become better."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65883c83-116d-464a-89dc-ebffe8aae96f",
                                                "sense_id": "b27b7908-3d60-33da-b6e8-53a3919164a0",
                                                "text": "I have improved since taking the tablets."
                                            },
                                            {
                                                "example_id": "7081aafa-4c9a-48a3-9cce-656c7f02a3dd",
                                                "sense_id": "b27b7908-3d60-33da-b6e8-53a3919164a0",
                                                "text": "The error messages have improved since the last version, when they were incomprehensible."
                                            },
                                            {
                                                "example_id": "7c4d7a95-21de-4382-bcc5-45f06aa511e4",
                                                "sense_id": "b27b7908-3d60-33da-b6e8-53a3919164a0",
                                                "text": "“My Continental prominence is improving,” I commented dryly. Von Lindowe cut at a furze bush with his silver-mounted rattan. “Quite so,” he said as dryly, his hand at his mustache. “I may say if your intentions were known your life would not be worth a curse.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa8a278-ff02-339c-8b1a-40b89ac7d105",
                                        "entry_id": "9a75060d-697b-337b-876f-816986a0fd2a",
                                        "glosses": [
                                            "To use or employ to good purpose; to turn to profitable account."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f408e3c7-72c7-4553-a24b-c01d7cabb13b",
                                                "sense_id": "5fa8a278-ff02-339c-8b1a-40b89ac7d105",
                                                "text": "to improve one's time;  to improve his means"
                                            },
                                            {
                                                "example_id": "902f2640-3583-492a-9754-4a30bf4749c1",
                                                "sense_id": "5fa8a278-ff02-339c-8b1a-40b89ac7d105",
                                                "text": "We shall especially honour God, by discharging faithfully those offices which God hath entrusted us with: by improving diligently those talents which God hath committed to us"
                                            },
                                            {
                                                "example_id": "dc845b4a-91e2-4bbd-8b36-60f0ce555491",
                                                "sense_id": "5fa8a278-ff02-339c-8b1a-40b89ac7d105",
                                                "text": "[A] hint that I do not remember to have seen opened and improved […]"
                                            },
                                            {
                                                "example_id": "883097ee-e28d-4108-bffe-c77a08d5fbf3",
                                                "sense_id": "5fa8a278-ff02-339c-8b1a-40b89ac7d105",
                                                "text": "How doth the little busy bee / Improve each shining hour."
                                            },
                                            {
                                                "example_id": "4b007e3d-f8d8-4095-a172-3db61d889380",
                                                "sense_id": "5fa8a278-ff02-339c-8b1a-40b89ac7d105",
                                                "text": "[T]he court has alſo an opportunity, which it ſeldom fails to improve, […]"
                                            },
                                            {
                                                "example_id": "6683810a-89c8-487c-a19d-cc2afd6d74d9",
                                                "sense_id": "5fa8a278-ff02-339c-8b1a-40b89ac7d105",
                                                "text": "March 7, 1778, George Washington, letter\nTrue policy, as well as good faith, in my opinion, binds us to improve the occasion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "improve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d49028fa-38e7-3eb8-9aa3-e09b8cbe9a50",
                                        "entry_id": "50f682bb-02a8-31f7-9078-fd8dc71b2e68",
                                        "glosses": [
                                            "To disprove or make void; to refute."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2938ee9b-d368-4dd8-b83c-aa1367d5f286",
                                                "sense_id": "d49028fa-38e7-3eb8-9aa3-e09b8cbe9a50",
                                                "text": "One ſayth this and a nother that / but can not agre. Nether can any of them make ſo ſtronge a reaſon vvhich a nother can not improve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71321633-cc27-390f-91a4-6e256b0c2594",
                                        "entry_id": "50f682bb-02a8-31f7-9078-fd8dc71b2e68",
                                        "glosses": [
                                            "To disapprove of; to find fault with; to reprove; to censure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c1304d-43a1-4124-ad16-55b39162d96e",
                                                "sense_id": "71321633-cc27-390f-91a4-6e256b0c2594",
                                                "text": "[W]hen he reherſed his preachinge and his doynges vnto the hye Apoſtles / they coulde improve no thinge […]"
                                            },
                                            {
                                                "example_id": "0d5e6ceb-5467-4e92-818b-ec420cbdda7a",
                                                "sense_id": "71321633-cc27-390f-91a4-6e256b0c2594",
                                                "text": "You would improve his negligence, too oft to ease retir’d: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
