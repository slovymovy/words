                ],
                "senses": [
                    {
                        "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                        "entry_id": "2e2d01d1-d327-3039-ac38-29f3f65b4465",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7b8d01-3eaa-4410-afef-d787dbce07cd",
                                "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                                "text": "Frau Neckermann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eea221bc-4feb-483e-bf93-396439cd2ab8",
                                "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                                "text": "Herr Neckermann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e8bf7247-599e-43bc-a4b5-2aaa2e641b04",
                                "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                                "text": "Die Neckermanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0d4fd513-d9b0-414e-a0f4-678bacb60420",
                                "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                                "text": "Der Neckermann trägt nie die Schals, die die Neckermann ihm strickt."
                            },
                            {
                                "example_id": "fda55920-ac01-4f31-881d-0eb0575b6a4d",
                                "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neckermann kommt, geht der Herr Neckermann.“"
                            },
                            {
                                "example_id": "1d69a845-5701-4c60-ae74-a8865736a4b9",
                                "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                                "text": "Neckermann kommt und geht."
                            },
                            {
                                "example_id": "ac51f4f9-2ade-468c-86ed-dc6a4d0eddc8",
                                "sense_id": "075deb95-1b8f-33bc-845b-69472217444a",
                                "text": "Neckermanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
