                ],
                "senses": [
                    {
                        "sense_id": "7d6c8157-e209-3a00-acad-2c011bd36faf",
                        "entry_id": "072e85e2-2264-38fc-ba96-1c6db71dd4f7",
                        "glosses": [
                            "Dilatation permanente d’une veine, produite par l’accumulation du sang dans sa cavité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a71cee2-9f3c-488f-8ab1-8806b490df8f",
                                "sense_id": "7d6c8157-e209-3a00-acad-2c011bd36faf",
                                "text": "Moi-même je restais souvent debout en classe. Je pensais ainsi verser plus énergiquement mon fluide dans l’esprit des élèves.\n« Attention aux varices ! » m’avait dit mon inspecteur général, M. Staingel.\nDès lors, je craignis de voir l’horizon de ma carrière barré par ces grands cordons flexueux."
                            },
                            {
                                "example_id": "aece38f9-4a3f-4df8-9d2c-e2dd8a14c36a",
                                "sense_id": "7d6c8157-e209-3a00-acad-2c011bd36faf",
                                "text": "Le flux portal peut être diminué s'il existe une circulation collatérale importante, à partir de la veine coronaire ou de la veine splénique, dans les varices qu'elles alimentent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4a3153f-f24c-4644-96a0-6b0db726e447",
                        "source_entry_id": "072e85e2-2264-38fc-ba96-1c6db71dd4f7",
                        "source_sense_id": "7d6c8157-e209-3a00-acad-2c011bd36faf",
                        "target_lang_word": "Krampfader",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krampfader",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                        "entry_id": "05441821-a632-34d6-850e-99c5f2eda07e",
                                        "glosses": [
                                            "defekte Vene, in der das Blut nicht mehr zurückfließt (meist äußerlich sichtbar)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3cdafc-008e-46c3-a2f9-49749d1bfd5e",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "Sie hat sich die Krampfadern an den Beinen ziehen lassen."
                                            },
                                            {
                                                "example_id": "ad3ea67c-69c8-4cc4-b607-4426f56cb322",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "„Herrliche Zeiten ohne motorisierte Schützeneinheiten, in denen heute dafür gesorgt wird, daß auch Leute mit Krampfadern zu ihrem Militärdienst kommen!“"
                                            },
                                            {
                                                "example_id": "3893f0bb-8645-4035-94fb-83a435541b0c",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "„Ihre dickschenkligen Beine waren von Krampfadern durchzogen.“"
                                            },
                                            {
                                                "example_id": "5b473965-79f2-446d-b89e-dd2dd1c6e6ed",
                                                "sense_id": "a0d5f8e2-c99d-3e7b-8c3c-177b7f023254",
                                                "text": "„Die ältere Frau hatte Krampfadern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
