                "senses": [
                    {
                        "sense_id": "1fe5cc0d-172a-3eed-9023-d56e9d693bd3",
                        "entry_id": "7d250157-abf3-304b-ba9b-c5c6bab632d5",
                        "glosses": [
                            "obywatel Syrii lub mieszkaniec Syrii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d966b67e-59f8-4c50-b395-8eaada19d3b4",
                                "sense_id": "1fe5cc0d-172a-3eed-9023-d56e9d693bd3",
                                "text": "Podczas gdy Zachód i syryjska opozycja uznała referendum za fikcję, Moskwa oświadczyła, że wyniki referendum wskazują na ogromne poparcie, jakim cieszy się wśród Syryjczyków prezydent Baszar el-Asad."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f40f6a2d-ad1d-4d58-8add-498d4b64a106",
                        "source_entry_id": "7d250157-abf3-304b-ba9b-c5c6bab632d5",
                        "source_sense_id": "1fe5cc0d-172a-3eed-9023-d56e9d693bd3",
                        "target_lang_word": "Syrian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Syrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3722ef63-ca36-39e6-b337-ace16fa10739",
                                        "entry_id": "d11b2bb5-8cd8-3558-9ede-474f0c3faaf3",
                                        "glosses": [
                                            "Of, from, or pertaining to Syria, the Syrian people or the Syrian language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd19968-3ac4-428f-977f-5871aa7167b7",
                                                "sense_id": "3722ef63-ca36-39e6-b337-ace16fa10739",
                                                "text": "The Syrian force was pulled back quickly and with reportedly heavy losses, but it stayed around long enough to remind the world that the Syrians are still the biggest blusterers and brinkmen in the Middle East."
                                            },
                                            {
                                                "example_id": "c97f6f7f-5546-47c8-afe0-7bab13120b20",
                                                "sense_id": "3722ef63-ca36-39e6-b337-ace16fa10739",
                                                "text": "In contrast to the political dynamics of the preunion period, these struggles were heavily influenced by the new prominence of Syrian capitalists[…]"
                                            },
                                            {
                                                "example_id": "c48fc211-e3ce-496b-b04a-d5c84070884b",
                                                "sense_id": "3722ef63-ca36-39e6-b337-ace16fa10739",
                                                "text": "Representatives of the Syrian National Council and the National Coordination Body for Democratic Change in Syria signed an agreement late Friday in Cairo for a transition in a post-Assad era, the NCB said on its Facebook page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f706f01f-a29b-3434-8dcd-10336cb1a41f",
                                        "entry_id": "d11b2bb5-8cd8-3558-9ede-474f0c3faaf3",
                                        "glosses": [
                                            "Of, from, or pertaining to the Assyrian people or the Syriac language"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Syrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e5b548-2bfd-3332-8e04-9b392f5c97fe",
                                        "entry_id": "728d15ee-88e4-3619-ad02-ae4b8b645cbc",
                                        "glosses": [
                                            "A person from Syria or of Syrian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a457224-8374-4329-b70c-fbdcc889dd85",
                                                "sense_id": "a6e5b548-2bfd-3332-8e04-9b392f5c97fe",
                                                "text": "The Syrian force was pulled back quickly and with reportedly heavy losses, but it stayed around long enough to remind the world that the Syrians are still the biggest blusterers and brinkmen in the Middle East."
                                            },
                                            {
                                                "example_id": "b711ff77-c575-4fa5-9cb4-dc67ede5c797",
                                                "sense_id": "a6e5b548-2bfd-3332-8e04-9b392f5c97fe",
                                                "text": "He said the agreement calls for the refusal of any non-Arab foreign intervention, an important issue because some Syrians want international intervention to overthrow the al-Assad regime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d35e3cc-a1c0-3957-93d5-f0549e543c4d",
                                        "entry_id": "728d15ee-88e4-3619-ad02-ae4b8b645cbc",
                                        "glosses": [
                                            "A person of Assyrian descent."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
