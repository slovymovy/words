                        "examples": [
                            {
                                "example_id": "fe8f34ae-5588-4335-9aec-6dccbe449d99",
                                "sense_id": "e6d35550-6ef0-3185-8b09-1dd85c06dd26",
                                "text": "Mignonne, allons voir si la rose\nQui ce matin avoit desclose\nSa robe de pourpre au Soleil,\nA point perdu ceste vesprée\nLes plis de sa robe pourprée,\nEt son teint au vostre pareil."
                            }
                        ]
                    },
                    {
                        "sense_id": "5397ef86-ca7c-3fc5-ae0d-3ce2bce02af0",
                        "entry_id": "98af2cb9-a191-3d7b-8eb7-c2b8b2c780ec",
                        "glosses": [
                            "Terme affectueux utilisé entre des amies."
                        ],
                        "tags": [
                            "Centre"
                        ],
                        "examples": [
                            {
                                "example_id": "b17f2037-d985-4bd5-ad54-52f2e0ce650c",
                                "sense_id": "5397ef86-ca7c-3fc5-ae0d-3ce2bce02af0",
                                "text": "Il ne se tranquillisa qu’en voyant, à l’aube nouvelle, Jeanne sortir fraîche et matinale de la chambre de sa mignonne pour aller respirer l’air des champs."
                            }
                        ]
