                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bff3c1f-a43f-3c41-8a9d-528f805539dd",
                                        "entry_id": "f5ab6dc0-cc88-3412-8a81-7e05ded66df6",
                                        "glosses": [
                                            "A portion of food or drink, as a refreshment taken on a journey; also, a stop for rest and refreshment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da565ae-8401-4075-9133-137148bf0e1b",
                                                "sense_id": "3bff3c1f-a43f-3c41-8a9d-528f805539dd",
                                                "text": "A short stop, but no refreshment. Such baits are frequently given by the natives of the principality to their keffels, or horses, particularly after climbing a hill."
                                            },
                                            {
                                                "example_id": "84fcb2f7-bfbe-4627-a471-c92b6042ca9b",
                                                "sense_id": "3bff3c1f-a43f-3c41-8a9d-528f805539dd",
                                                "text": "The tediousness of a two hours' bait at Petty-France, in which there was nothing to be done but to eat without being hungry, and loiter about without any thing to see, next followed […]"
                                            }
                                        ]
                                    },
                                    {
