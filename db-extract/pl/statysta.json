                    {
                        "sense_id": "5224bf9c-b412-3448-a6e1-1062f5dec669",
                        "entry_id": "05885720-65b5-37be-8323-aeb8ff345e78",
                        "glosses": [
                            "odtwórca ról podrzędnych (zwykle niemych) w scenach zbiorowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c715620d-7b5b-4147-b06e-b2a5e618cc38",
                                "sense_id": "5224bf9c-b412-3448-a6e1-1062f5dec669",
                                "text": "Już wstępny nabór do filmu zgromadził ponad 300 statystów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "420adf84-0af9-317d-b0e7-6e00bb2c85e8",
                        "entry_id": "05885720-65b5-37be-8323-aeb8ff345e78",
                        "glosses": [
                            "osoba nieuczestnicząca czynnie, postronna, bierny obserwator"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "109dc09e-b0bf-4fcc-b79a-8014b6f50c19",
                                "sense_id": "420adf84-0af9-317d-b0e7-6e00bb2c85e8",
                                "text": "W tych emocjonujących zdarzeniach byłem jedynie statystą."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "dc01ff68-1b71-31e2-b085-fd4d79cb1d3f",
                        "entry_id": "05885720-65b5-37be-8323-aeb8ff345e78",
                        "glosses": [
                            "mąż stanu, polityk"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5f922b56-c056-43ab-ad59-ba672047ba10",
                                "sense_id": "dc01ff68-1b71-31e2-b085-fd4d79cb1d3f",
                                "text": "Choć nikt go o to nie podejrzewał, z hetmana okazał się być nader tęgi statysta."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
