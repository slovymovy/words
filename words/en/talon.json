                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When all interest coupons were used, the investor presented the <w>talon</w> for a new sheet.",
                            "target_lang_translations": {
                                "de": "Als alle Zinsscheine verbraucht waren, legte der Anleger den <w>Talon</w> vor, um einen neuen Bogen zu erhalten."
                            }
                        },
                        {
                            "text": "The bond certificate included a detachable <w>talon</w> at the end of the coupon strip.",
                            "target_lang_translations": {
                                "de": "Anleiheurkunde enthielt einen abtrennbaren <w>Erneuerungsschein</w> am Ende des Couponbogens."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Erneuerungsschein zum Bezug eines neuen Zins- oder Dividendenscheinbogens."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Talon",
                                "target_lang_sense_clarification": "Erneuerungsschein für Wertpapiere"
                            },
                            {
                                "target_lang_word": "Erneuerungsschein",
                                "target_lang_sense_clarification": "für Coupons bei Anleihen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f44956c4-f221-3f16-8964-dccd7cf67cd9",
                    "sense_definition": "A small projection on the rear surface of an elephant's tooth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The zoologist examined the small <w>talon</w> on the fossilized elephant molar.",
                            "target_lang_translations": {
                                "de": "Der Zoologe untersuchte den kleinen <w>Zahnfortsatz</w> auf dem fossilen Elefantenmahlzahn."
                            }
                        },
                        {
                            "text": "A distinct <w>talon</w> was visible on the rear ridge of the tooth specimen.",
                            "target_lang_translations": {
                                "de": "Ein deutlicher <w>Fortsatz</w> war auf der hinteren Leiste des Zahnpräparats zu erkennen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleiner Fortsatz auf der Rückseite eines Elefantenzahns."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Talonid",
                                "target_lang_sense_clarification": "Anatomischer Fortsatz an Zähnen"
                            }
                        ]
                    }
                }
            ]
