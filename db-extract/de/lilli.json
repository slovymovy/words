                                        "glosses": [
                                            "A female given name from English, popular around 1900 and currently returning to favor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f99fe3-9a69-43b9-a448-04c88884ca1e",
                                                "sense_id": "fa5af88b-f0ab-3c3e-af44-a95aea5c95c7",
                                                "text": "\"Poor little thing! She is very wee and frail, isn't she? Only two months old. We came away from the north, as soon as I was able to travel. She is called Lily.\"\nI remembered Horace having once told me that his mother's name had been Lilias."
                                            },
                                            {
                                                "example_id": "48f2ba38-c312-49da-ae22-70cedb1f6be2",
                                                "sense_id": "fa5af88b-f0ab-3c3e-af44-a95aea5c95c7",
                                                "text": "\"Lily is such a romantic name. It sounds to me like soft music; it's the sort of name to make one dream of fanciful things.\"\nLily smiled. \"It's my grandmother's name. Coincidence, maybe, but she grew the most beautiful lilies.\""
                                            }
                                        ]
                                    }
                                ]
                            }
