                    {
                        "form_id": "1b24fc81-3d79-4c3d-9021-77e32d63ac31",
                        "entry_id": "2b2b6aeb-9e12-35ca-8536-2170815120df",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Freibeträge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8263edcd-f74b-3a4c-87d8-5acbbf7d6ecd",
                        "entry_id": "2b2b6aeb-9e12-35ca-8536-2170815120df",
                        "glosses": [
                            "eine bestimmte, definierte Summe Geld, die von einer Regel nicht betroffen ist (sondern unvermindert zur Verfügung steht); der Teil vom Einkommen, für den keine Einkommensteuer gezahlt werden muss"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "8d0b4e68-d728-462e-b7aa-faa8c823a5e3",
                                "sense_id": "8263edcd-f74b-3a4c-87d8-5acbbf7d6ecd",
                                "text": "Diesen Freibetrag können Sie sich auch gleich auf der Lohnsteuerkarte eintragen lassen, sagte man mir 1982."
                            },
                            {
                                "example_id": "c088c3ce-2f64-46f1-92cb-2d0e0093bd58",
                                "sense_id": "8263edcd-f74b-3a4c-87d8-5acbbf7d6ecd",
                                "text": "Einen Freibetrag für die Lohnsteuer können Sie in die ELStAM, die elektronischen Lohnsteuerabzugsmerkmale, eintragen lassen, sagte man mir 2021."
                            },
                            {
                                "example_id": "d095f2e9-fb7e-4a08-9606-6ec662ec82c0",
                                "sense_id": "8263edcd-f74b-3a4c-87d8-5acbbf7d6ecd",
                                "text": "Ihr wurde für land- und forstwirtschaftliche Einkünfte ein Freibetrag von 900,00 € p.a. gewährt."
                            },
                            {
                                "example_id": "818dd0a9-cb50-4554-b913-c4129748560d",
                                "sense_id": "8263edcd-f74b-3a4c-87d8-5acbbf7d6ecd",
                                "text": "„Im allgemeinen Sprachgebrauch werden die Begriffe Freibetrag und Pauschbetrag oft verwechselt. Das ist der Unterschied: Der Freibetrag ist ein Teil des Einkommens, der steuerfrei ist. Beträge, die den Freibetrag überschreiten, werden besteuert. Der Pauschbetrag ist ein Betrag, der in der Steuererklärung von der Steuerlast abgesetzt werden kann, ohne dass das Finanzamt Belege für die entstandenen Kosten sehen will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a92426f-a5b2-4adf-9372-b1d6a75773e3",
                        "source_entry_id": "2b2b6aeb-9e12-35ca-8536-2170815120df",
                        "source_sense_id": "8263edcd-f74b-3a4c-87d8-5acbbf7d6ecd",
                        "target_lang_word": "allowance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allowance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59bd76a5-b1df-3401-8daa-dc40a6d287f0",
                                        "entry_id": "964ee428-317e-35d6-af14-cd57f1f8730a",
                                        "glosses": [
                                            "Permission; granting, conceding, or admitting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f9d8a54-c68c-420f-896e-2b87b61887b8",
                                                "sense_id": "59bd76a5-b1df-3401-8daa-dc40a6d287f0",
                                                "text": "you sent a large commission to Gregory de Cassado, to conclude, without the King's will or the state's allowance"
                                            },
                                            {
                                                "example_id": "7eefec9a-097c-4aae-8569-5ff7e01f7d5e",
                                                "sense_id": "59bd76a5-b1df-3401-8daa-dc40a6d287f0",
                                                "text": "[Mr. Michie] Q[uestion]. Didn't Dr. Carter, Director of the OHTA [Office of Health Technology Assessment], and Martin Erlichman, OHTA scientific analyst assigned to this assessment, express to you concerns about 60 days being unreasonable as far as timeframe was concerned for this assessment? [Mr. Marshall] A[nswer]. There was some discussion about that, but that occurred some time later when we made the decision to put a notice in the Federal Register. We—when we do an assessment, we put a notice in the Federal Register and then that requires the allowance of a certain amount of time for public comment."
                                            },
                                            {
                                                "example_id": "5191ac53-b7a2-411f-983c-fdfd6028e29f",
                                                "sense_id": "59bd76a5-b1df-3401-8daa-dc40a6d287f0",
                                                "text": "The physical background of foaming of the complex fermentation liquids is not well understood. Proteins do play a major role, but all other components can also be important. Foaming is a problem, but its relation to mass transfer leads to the allowance of a certain amount of foam on top of the fermenter. For foam control a number of methods are available. Most widely used are the antifoam liquids and the centrifugal separator. The latter one should be equipped with a safety antifoam dosage device also and is less attractive for large-scale applications."
                                            },
                                            {
                                                "example_id": "9eeeaeae-e32c-4be9-87da-1b3f26afdcce",
                                                "sense_id": "59bd76a5-b1df-3401-8daa-dc40a6d287f0",
                                                "text": "The colossal stupidity of the one-party strategy has had three disastrous effects: the nurturance of right-wing Republican homophobes, the weakening and silencing of pro-gay, progressive Republicans, and the allowance of lacklustrer^([sic]), liberal Democrats to exploit us at their will and ignore us at their convenience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9593a29e-ba18-3f78-a604-d43cf3d62113",
                                        "entry_id": "964ee428-317e-35d6-af14-cd57f1f8730a",
                                        "glosses": [
                                            "Acknowledgment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815268e9-94f7-464d-a9b9-a26aed4debb5",
                                                "sense_id": "9593a29e-ba18-3f78-a604-d43cf3d62113",
                                                "text": "The censure of the which one must in your allowance overweigh a whole theater of others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a312312-9adb-34ea-8623-0eb2a0837742",
                                        "entry_id": "964ee428-317e-35d6-af14-cd57f1f8730a",
                                        "glosses": [
                                            "An amount, portion, or share that is allotted or granted; a sum granted as a reimbursement, a bounty, or as appropriate for any purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa357ef7-615c-492e-8531-f7ea4698da49",
                                                "sense_id": "5a312312-9adb-34ea-8623-0eb2a0837742",
                                                "text": "her meagre allowance of food or drink"
                                            },
                                            {
                                                "example_id": "4fd252c6-4930-4b30-9b34-fa0af91064c6",
                                                "sense_id": "5a312312-9adb-34ea-8623-0eb2a0837742",
                                                "text": "Being a volunteer is unpaid, but we get accommodation and a living allowance of 100 euros a week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b020edd-8bd9-3e31-b82b-dc8d81fc1d7a",
                                        "entry_id": "964ee428-317e-35d6-af14-cd57f1f8730a",
                                        "glosses": [
                                            "An amount, portion, or share that is allotted or granted; a sum granted as a reimbursement, a bounty, or as appropriate for any purpose.",
                                            "Such a sum or portion granted to a family member or familiar, especially one's own child; pocket money for such a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75c1fd9-dfc0-4363-b88f-ce2fa04c59ff",
                                                "sense_id": "9b020edd-8bd9-3e31-b82b-dc8d81fc1d7a",
                                                "text": "She gives her daughters each an allowance of thirty dollars a month."
                                            },
                                            {
                                                "example_id": "22e47fd6-38d8-4508-b425-d9e839747c07",
                                                "sense_id": "9b020edd-8bd9-3e31-b82b-dc8d81fc1d7a",
                                                "text": "Some persons averred that Sir Pitt Crawley gave his brother a handsome allowance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00a78780-f665-3a8e-ab49-c256134a64f7",
                                        "entry_id": "964ee428-317e-35d6-af14-cd57f1f8730a",
                                        "glosses": [
                                            "Abatement; deduction; the taking into account of mitigating circumstances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90ee257c-3890-435b-b1a8-7a131bda5953",
                                                "sense_id": "00a78780-f665-3a8e-ab49-c256134a64f7",
                                                "text": "to make allowance for his naivety"
                                            },
                                            {
                                                "example_id": "ac1bd316-eb3e-4572-8d20-b627aea2cc10",
                                                "sense_id": "00a78780-f665-3a8e-ab49-c256134a64f7",
                                                "text": "After making the largest allowance for fraud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59da9067-fb16-3c82-b3fe-2020d261f505",
                                        "entry_id": "964ee428-317e-35d6-af14-cd57f1f8730a",
                                        "glosses": [
                                            "A deduction from the gross weight of goods, such as to discount their container's weight or per a custom differing by country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12d8e1fe-470a-4c88-9474-2eb1210b01d1",
                                                "sense_id": "59da9067-fb16-3c82-b3fe-2020d261f505",
                                                "text": "Minus the allowance, the total came to thirteen tons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0468f593-8837-3e81-aba3-c29f2d296305",
                                        "entry_id": "964ee428-317e-35d6-af14-cd57f1f8730a",
                                        "glosses": [
                                            "A permitted reduction in the weight that a racehorse must carry."
                                        ],
