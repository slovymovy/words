                ],
                "senses": [
                    {
                        "sense_id": "016a8726-5c6b-3974-9a8c-a45b404689c9",
                        "entry_id": "1727d219-a15b-3631-9db7-66933f5aa49a",
                        "glosses": [
                            "Crème fouettée, légèrement sucrée et vanillée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceb15f86-d4e6-412f-a731-de2c826d93f6",
                                "sense_id": "016a8726-5c6b-3974-9a8c-a45b404689c9",
                                "text": "Je passai à la boulangerie près de chez nous et pris un magnifique bavarois au chocolat que la boulangère qui nous connaissait bien m'agrémenta rapidement d'un magnifique « Bon anniversaire Papa » à l'aide d'une poche à douille de chantilly. Je m'en léchai les doigts d'avance ."
                            },
                            {
                                "example_id": "a151791c-1884-4e18-b52f-d0f44c8d0491",
                                "sense_id": "016a8726-5c6b-3974-9a8c-a45b404689c9",
                                "text": "Sur le marché de Montargis (Loiret) ce samedi matin, l’ancien ministre de l’Éducation nationale a été aspergé de mousse blanche, possiblement de la chantilly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18464c47-7671-431d-8b3b-bd6dfd575c40",
                        "source_entry_id": "1727d219-a15b-3631-9db7-66933f5aa49a",
                        "source_sense_id": "016a8726-5c6b-3974-9a8c-a45b404689c9",
                        "source_sense_description": "Crème fouettée, légèrement sucrée et vanillée",
                        "target_lang_word": "Schlagsahne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlagsahne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13940204-a94b-3d8b-a7ea-c9e31a81d887",
                                        "entry_id": "4f081fc9-d5bd-3d5f-83c6-9aeb0c9f7fc3",
                                        "glosses": [
                                            "Sahne mit einem Fettanteil von 30 bis 35 Prozent"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43954b8-aae3-4ada-a488-4fe84ad5807f",
                                                "sense_id": "13940204-a94b-3d8b-a7ea-c9e31a81d887",
                                                "text": "Ich muss noch 200 Gramm Schlagsahne für das Lachs-Sahne-Gratin kaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3326e3d0-20e2-3534-8bee-667b5db627bf",
                                        "entry_id": "4f081fc9-d5bd-3d5f-83c6-9aeb0c9f7fc3",
                                        "glosses": [
                                            "(gesüßte) Schlagsahne^([1]), die geschlagen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b279b5f1-0d9b-4063-b420-78e60f26e469",
                                                "sense_id": "3326e3d0-20e2-3534-8bee-667b5db627bf",
                                                "text": "Möchtest du etwas Schlagsahne auf dein Stück Kuchen?"
                                            },
                                            {
                                                "example_id": "9c0793ad-d45d-43a8-9431-dc55bfa7966c",
                                                "sense_id": "3326e3d0-20e2-3534-8bee-667b5db627bf",
                                                "text": "Er überhäufte den Mohnstrudel mit Unmengen von Schlagsahne."
                                            },
                                            {
                                                "example_id": "6e6820c9-390f-4066-ac16-e81304e47ce3",
                                                "sense_id": "3326e3d0-20e2-3534-8bee-667b5db627bf",
                                                "text": "„So sitzen sie ruhig nebeneinander und denken rückwärts und vorwärts, essen Bienenstich und einen Mohrenkopf mit Schlagsahne.“"
                                            },
                                            {
                                                "example_id": "8c09efce-a2dc-46c7-bebe-f1d034334f6b",
                                                "sense_id": "3326e3d0-20e2-3534-8bee-667b5db627bf",
                                                "text": "„Irgendwann mußten sie ja mit ihren Pflaumen, der Schlagsahne und dem Tischgebet fertig sein.“"
                                            },
                                            {
                                                "example_id": "079c4cc4-1fa5-4719-9564-dc0892759296",
                                                "sense_id": "3326e3d0-20e2-3534-8bee-667b5db627bf",
                                                "text": "„Der eine trank Whisky, der andere aß Eis mit Schlagsahne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
