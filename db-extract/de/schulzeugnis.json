                                        "sense_id": "c214a5d0-f44f-37f0-8593-c9373a3075be",
                                        "entry_id": "baaf97a7-6386-3d24-b0f5-ebe09ff24a1e",
                                        "glosses": [
                                            "A document, on cardboard or plain paper, indicating the grades that a student has earned, issued at the end of a term of a regular period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7ed94d5-c9a5-477f-b19c-2860ee263b08",
                                                "sense_id": "c214a5d0-f44f-37f0-8593-c9373a3075be",
