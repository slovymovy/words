                        "target_lang_word": "wallpaper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wallpaper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3607a7-dcaf-3c7f-a92a-f111b1e23df9",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "Decorative paper-like material used to cover the inner walls of buildings."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58cf3c12-b2d0-302e-9396-823dc020e1a9",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "A roll of such paper."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c766142-bdf7-305c-b255-11fe3902c5fa",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "A style or design of such material."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69bf2a75-6561-4e44-8170-54d44851084e",
                                                "sense_id": "4c766142-bdf7-305c-b255-11fe3902c5fa",
                                                "text": "He is letting her select the wallpapers for the whole house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc57431-4349-335d-847d-6ff5eced48c5",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "Anything that serves as a background or part of the surroundings."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c00c980-a3f2-4707-84f1-b0012f219b45",
                                                "sense_id": "4dc57431-4349-335d-847d-6ff5eced48c5",
                                                "text": "This was not the wallpaper television that flickered away in the background in every dealing room but was not really watched. This was finely targeted and timely broadcast of stuff dealers would want to drop everything to watch."
                                            },
                                            {
                                                "example_id": "8b88d9d6-48ca-4a3d-ae1d-334edf9dafab",
                                                "sense_id": "4dc57431-4349-335d-847d-6ff5eced48c5",
                                                "text": "Her experiences are too early and too much part of the emotional wallpaper to be grasped in this way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac7456c-1ed3-3ac3-bc02-df95f7fc4a98",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "An image or tiled pattern used as the background of a computer desktop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b96f32d-4c1d-49f2-b14a-9395bf2fbe78",
                                                "sense_id": "4ac7456c-1ed3-3ac3-bc02-df95f7fc4a98",
                                                "text": "He chose a Minecraft design as his computer's wallpaper."
                                            },
                                            {
                                                "example_id": "ab4e4052-b829-4df0-9dc0-2d2f415123de",
                                                "sense_id": "4ac7456c-1ed3-3ac3-bc02-df95f7fc4a98",
                                                "text": "You can design your own wallpaper using Paintbrush. A wallpaper appears on your desktop in tiles. The number of tiles that are needed to cover the desktop depends on the size of the canvas you use to create a wallpaper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27da1794-e53c-318f-ac6d-66b6f5d886db",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "Generic footage of a building or location that may be used in the background of a related news report."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deeba025-4694-4878-b5f3-cdfafbe814b0",
                                                "sense_id": "27da1794-e53c-318f-ac6d-66b6f5d886db",
                                                "text": "Scripts that include brief reference to a picture turn stock footage from 'wallpaper' to illustration."
                                            },
                                            {
                                                "example_id": "b482d6f2-cbe1-457b-a627-ee41f1a8d57a",
                                                "sense_id": "27da1794-e53c-318f-ac6d-66b6f5d886db",
                                                "text": "News bulletins on television may need general rather than specific footage. This is known as wallpaper — moving pictures over which the news item is read."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b846425b-ce29-36a8-bcbb-2f6ea03287fb",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "Gaudy mass-produced stamps, typically of little or no value and only produced for sale to collectors."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c919e295-608f-3075-9078-152b3bfdb4b4",
                                        "entry_id": "8c7d8a4c-2630-39cc-bb7b-c026bb044506",
                                        "glosses": [
                                            "A radio operator's collection of awards and QSL cards."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f09d20-9844-4cad-9f1a-ffef8b0e8def",
                                                "sense_id": "c919e295-608f-3075-9078-152b3bfdb4b4",
                                                "text": "Some of my wallpaper includes ORS, OPS […]"
                                            },
                                            {
                                                "example_id": "fe288eeb-498b-40ba-a612-29d6451ec7ac",
                                                "sense_id": "c919e295-608f-3075-9078-152b3bfdb4b4",
                                                "text": "So if you are a technical ham and are looking for one more piece of \"wallpaper\" to put up at the shack, consider […]"
                                            },
                                            {
                                                "example_id": "eb9f65be-2ee3-42d7-8f5b-e4d57a178cf6",
                                                "sense_id": "c919e295-608f-3075-9078-152b3bfdb4b4",
                                                "text": "Wallpaper. Hams love awards, and thousands of awards are available."
                                            }
                                        ]
                                    }
                                ]
                            },
