                                    {
                                        "sense_id": "383cca57-732b-3e51-806c-9fcf6645af2d",
                                        "entry_id": "88295e8e-7bd3-33d3-9fbe-f99706e1764a",
                                        "glosses": [
                                            "Related to, characteristic of, or espousing femonationalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55e1520a-d420-4905-9a53-2e0f3962c769",
                                                "sense_id": "383cca57-732b-3e51-806c-9fcf6645af2d",
                                                "text": "In the final analytical section, we offer examples of ways in which feminists have tried to actively contest femonationalist tendencies."
                                            },
                                            {
                                                "example_id": "63e9690c-902f-453d-8447-7b89e47cd313",
                                                "sense_id": "383cca57-732b-3e51-806c-9fcf6645af2d",
                                                "text": "The femonationalist territorialisation of Muslim men as sexual offenders may be exemplified with the Sweden Democrats, who in that op-ed in Wall Street Journal argued that Sweden's high rape figures are due to an 'open-door immigration' of particularly men from Muslim countries […]"
                                            },
                                            {
                                                "example_id": "bd05c1a5-20f8-4af2-822d-5500fbf4e1e0",
                                                "sense_id": "383cca57-732b-3e51-806c-9fcf6645af2d",
                                                "text": "Femonationalist discourse is increasingly utilized by both Hindu and Buddhist nationalist representatives to figuratively rescue women from what they deem are the oppressive structures of Islam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
