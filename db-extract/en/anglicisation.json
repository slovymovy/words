                    {
                        "translation_id": "72e07799-5d5a-4b2e-b6de-03594023874d",
                        "source_entry_id": "5143f312-506d-3b24-9083-723051a7c064",
                        "source_sense_id": "e1d8c696-825c-3c44-8ad1-90b95ddd18b7",
                        "source_sense_description": "process of anglicising",
                        "target_lang_word": "anglicisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anglicisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05952332-f895-34a6-b70c-61d9288ae622",
                                        "entry_id": "06cda625-8e42-3655-b6e3-de89a7c8b387",
                                        "glosses": [
                                            "Action de donner une forme propre à la langue anglaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c9d68c5-8b93-4a00-9d47-48dcb23988b4",
                                                "sense_id": "05952332-f895-34a6-b70c-61d9288ae622",
                                                "text": "Angliciser son nom, en se faisant appeler John au lieu de Jean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35914ea-a8c0-397b-90d9-462fbdc49946",
                                        "entry_id": "06cda625-8e42-3655-b6e3-de89a7c8b387",
                                        "glosses": [
                                            "Action de modifier les mœurs, les institutions et la langue (d'un peuple) pour les rendre identiques à ceux de l'Angleterre, ou à ceux des territoires qui parlent la langue d'Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992665d3-31f6-4e34-a16a-4b6c216e02d3",
                                                "sense_id": "d35914ea-a8c0-397b-90d9-462fbdc49946",
                                                "text": "Conçu dans un dessein d'anglicisation, l'Acte constitutionnel de 1791 se révélait une erreur : loin d'inciter les Canadiens français à s'angliciser, le parlementarisme avait été perçu et utilisé comme un moyen de libération."
                                            },
                                            {
                                                "example_id": "ee364400-aba7-4970-83d8-73d7e7496d45",
                                                "sense_id": "d35914ea-a8c0-397b-90d9-462fbdc49946",
                                                "text": "On remarque, depuis plusieurs années déjà, une anglicisation de Montréal."
                                            },
                                            {
                                                "example_id": "e66cf462-8195-4041-ba5a-2e441ff2c04f",
                                                "sense_id": "d35914ea-a8c0-397b-90d9-462fbdc49946",
                                                "text": "Cette anglicisation à marche forcée n’est ni un nouvel espéranto ni un trissotinisme mais un fait de société : une révolution. L’affaire ne date pas d’aujourd’hui."
                                            },
                                            {
                                                "example_id": "42a376b4-81fa-4311-9b42-981afbb3f64d",
                                                "sense_id": "d35914ea-a8c0-397b-90d9-462fbdc49946",
                                                "text": "L’analyse longitudinale des données de recensement les plus récentes confirme la faiblesse du français en regard de l’anglais comme langue d’assimilation à Montréal, ainsi que l’emballement de l’ anglicisation des francophones à l’extérieur du Québec et du Nouveau-Brunswick."
                                            },
                                            {
                                                "example_id": "6130c6af-3870-4629-8271-7721102a886a",
                                                "sense_id": "d35914ea-a8c0-397b-90d9-462fbdc49946",
                                                "text": "Le processus d’ anglicisation est tel que la France se classe désormais devant non moins de 19 anciennes colonies britanniques ayant toutes l’anglais pour langue co-officielle, de jure ou de facto, selon le dernier classement EF EPI (Education First, English Proficiency Index) relatif au niveau de maîtrise de la langue anglaise par la population d’un pays !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
