                ],
                "senses": [
                    {
                        "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                        "entry_id": "a05dcb1f-9434-35b1-9398-d3b222c91627",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b2bfd7-7e26-43de-bf22-e83265464ca0",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "Frau Cotte ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c30ba604-e186-4eb8-8769-b1d2d85ae79d",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "Herr Cotte wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "047436d2-dab0-4314-aed6-5b11629fd9b4",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "Die Cottes kommen heute aus dem Saarland."
                            },
                            {
                                "example_id": "f93c5c1b-e2af-41bf-8d7b-66c447343af2",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "Der Cotte trägt nie die Schals, die die Cotte ihm strickt."
                            },
                            {
                                "example_id": "c63d64bd-3742-491b-a590-257b5abf04e4",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cotte kommt, geht der Herr Cotte.“"
                            },
                            {
                                "example_id": "fee39445-763d-498f-ab15-1223f6162d38",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "Cotte kommt und geht."
                            },
                            {
                                "example_id": "03fedc39-ad91-4ae9-b92a-645c126c5996",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "Cottes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "c3796b0f-ea58-4f5d-9ab8-66c11a6d0392",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "An verregneten Herbsttagen ist Familie Cottes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "bb893c59-efbf-43fb-bf68-5062c3b7eec1",
                                "sense_id": "1123a762-e5bd-3854-91ad-6c3a68962b5d",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Cotte das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
