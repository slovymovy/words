                            {
                                "example_id": "49d10851-7689-4cea-b2b7-5aa8adfcd4f8",
                                "sense_id": "5364e3a6-422a-3a7f-8892-56e7dccaacd9",
                                "text": "Hij was alleen maar als toehoorder bij de vergadering aanwezig, hij had geen spreekrecht en ook geen stemrecht."
                            },
                            {
                                "example_id": "942f07d0-791b-413d-b425-116c35eb9615",
                                "sense_id": "5364e3a6-422a-3a7f-8892-56e7dccaacd9",
                                "text": "Er waren 700 toehoorders aanwezig tijdens het openluchtoptreden van de popmuzikant."
                            }
                        ]
                    }
                ],
