                    "frequency": "High",
                    "semantic_group_id": "noun_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette boutique vend des sacs et divers <w>accessoires</w> de mode très élégants."
                        },
                        {
                            "text": "Il a acheté un nouvel <w>accessoire</w> pour recharger son téléphone plus vite."
                        }
                    ],
                    "synonyms": [
