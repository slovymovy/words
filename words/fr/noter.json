    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14590bc2-fa6e-3379-9648-89f001822a49",
                    "sense_definition": "Écrire quelque chose sur un support papier ou numérique pour s'en souvenir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>noter</w> l'adresse du restaurant dans ton carnet."
                        },
                        {
                            "text": "Pendant la réunion, elle <w>note</w> soigneusement toutes les remarques du client."
                        }
                    ],
                    "synonyms": [
                        "prendre des notes"
                    ],
                    "common_phrases": [
                        "noter une adresse",
                        "noter un rendez-vous"
                    ]
                },
                {
                    "sense_id": "ebecd4f3-70a8-3035-87b0-6f76a2170c39",
                    "sense_definition": "Attribuer une note chiffrée ou une appréciation à un devoir, un examen ou un élève.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a passé tout le week-end à <w>noter</w> les examens de ses étudiants."
                        },
                        {
                            "text": "Cet enseignant a la réputation de <w>noter</w> sévèrement les devoirs écrits."
                        }
                    ],
                    "common_phrases": [
                        "noter les copies",
                        "noter sévèrement"
                    ]
                },
                {
                    "sense_id": "d22a84bb-675c-3ad9-a151-d2b67cc0d870",
                    "sense_definition": "Faire remarquer ou souligner un fait particulier digne d'attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est important de <w>noter</w> que les horaires d'ouverture changent la semaine prochaine."
                        },
                        {
                            "text": "Le conférencier a tenu à faire <w>noter</w> les progrès accomplis depuis l'année dernière."
                        }
                    ],
                    "common_phrases": [
                        "il est à noter",
                        "il convient de noter"
                    ]
                },
                {
                    "sense_id": "24736876-571f-32a8-a100-ded300c0ca4f",
                    "sense_definition": "Remarquer ou observer consciemment un fait ou un détail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a <w>noté</w> une amélioration nette de l'état général du patient."
                        },
                        {
                            "text": "Nous avons pu <w>noter</w> une baisse constante de la fréquentation du magasin."
                        }
                    ],
                    "common_phrases": [
                        "noter un changement",
                        "noter une amélioration"
                    ]
                },
                {
