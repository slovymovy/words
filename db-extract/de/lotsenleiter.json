                ],
                "senses": [
                    {
                        "sense_id": "680412b9-ead7-3300-933a-816e64fe4109",
                        "entry_id": "be57e96e-df53-3544-9bc8-739cc3acdd32",
                        "glosses": [
                            "Leiter, auf der Lotsen auf dem Wasser vom Lotsenboot an und von Bord des zu manövrierenden Schiffes (beispielsweise einem Frachter, einem Containerschiff) klettern"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "9574f273-cc0b-491c-bea0-82ccf17b03e3",
                                "sense_id": "680412b9-ead7-3300-933a-816e64fe4109",
                                "text": "Bei schwerer See oder nachts ist das Klettern auf einer Lotsenleiter wirklich gefährlich: wenn du abrutschst und in die kalte See fällst kannst du ertrinken."
                            },
                            {
                                "example_id": "b68a776b-9081-4de7-a0d6-51ff03fae05f",
                                "sense_id": "680412b9-ead7-3300-933a-816e64fe4109",
                                "text": "Die Lotsenleiter (pilot ladder) in der Handelsschifffahrt muss bestimmten Sicherheitsvorschriften genügen. […] Bei der Lotsenleiter werden […] Bretter so durch die Taue verbunden, dass sie sich nicht drehen können."
                            },
                            {
                                "example_id": "af39a828-44e6-4d6c-b985-325ed660a1be",
                                "sense_id": "680412b9-ead7-3300-933a-816e64fe4109",
                                "text": "„Die Lotsenleiter war spannend“, berichtet sie [Kira Lynn]. Die war ihr Angstbild beim Praktikum. Sie meisterte sie bei Windstärke sieben auf der Elbe, als sie mit Harald Gossing vom Lotsenversetzboot aus nachts die Jakobsleiter hinauf an Bord der Patras stieg, einen 144 Meter langen Öltanker."
                            },
                            {
                                "example_id": "d6b47855-5c3f-42bc-b154-4519d1ee2eb8",
                                "sense_id": "680412b9-ead7-3300-933a-816e64fe4109",
                                "text": "Ich reduzierte die Fahrstufe auf , eine Weile später auf < Stopp >. Unsere Lotsenleiter hing bereits an der backbord Seite bereit."
                            },
                            {
                                "example_id": "07328120-01bc-4a10-a0d5-5ec9ff21929b",
                                "sense_id": "680412b9-ead7-3300-933a-816e64fe4109",
                                "text": "In der Elbmündung herrschte ein WNW-Wind der Stärke 3 und leichter nordwestlicher Schwell, so dass die Lotsenleiter an der Backbord-Seite, der Leeseite des Schiffes, geriggt wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
