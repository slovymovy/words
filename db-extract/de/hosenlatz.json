                "senses": [
                    {
                        "sense_id": "baae9443-ec38-32d1-a89a-d9394f321a15",
                        "entry_id": "a4096abe-8e0c-3516-a4c2-363781257236",
                        "glosses": [
                            "Vorrichtung im Schritt einer Jungen- oder Männerhose, die sich öffnen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb7c34a5-d199-4631-9b85-cf781bd13ae8",
                                "sense_id": "baae9443-ec38-32d1-a89a-d9394f321a15",
                                "text": "„Als es vorbei war, kroch ich mit offenem Hosenlatz wieder unterm Schreibtisch hervor.“"
                            },
                            {
                                "example_id": "0ec28b43-d6ea-4e36-93f1-58ca5b45d14b",
                                "sense_id": "baae9443-ec38-32d1-a89a-d9394f321a15",
                                "text": "„Wenn der Hosenlatz eines Mannes offen ist, dann ist das sein Problem, du hast nichts gesehen.“"
                            },
                            {
                                "example_id": "ef6be6f5-9e74-460d-9bf1-fc0fadab31af",
                                "sense_id": "baae9443-ec38-32d1-a89a-d9394f321a15",
                                "text": "„Ich spielte ein Weilchen mit ihr, dann rutschte sie von ihrem Hochsitz herunter, legte beide Arme um meinen Hals, öffnete verstohlen meinen Hosenlatz und griff mit der Hand nach meinem Kugellager.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
