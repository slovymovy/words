                "senses": [
                    {
                        "sense_id": "ec4b17d2-306f-3be6-9e07-45bfa8ece025",
                        "entry_id": "edb43ff1-07b9-3fb7-aecf-a9bb38f8607f",
                        "glosses": [
                            "Seitenfläche eines Objektes, die durch Schneiden entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ab7c4f-7424-4712-b6d2-212fd62d6788",
                                "sense_id": "ec4b17d2-306f-3be6-9e07-45bfa8ece025",
                                "text": "„Dann die Kartoffeln waschen, halbieren, auf einem geölten Blech verteilen und mit Salz bestreuen. Mit der Schnittfläche nach unten auflegen und für ca. 35 min. bei 220 Grad backen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "04771de8-c642-3284-8eaf-3b6a2863eae8",
                        "entry_id": "edb43ff1-07b9-3fb7-aecf-a9bb38f8607f",
                        "glosses": [
                            "gemeinsame Punktmenge einer Ebene und eines Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59348fe-8837-46f7-ba53-32d00b08e216",
                                "sense_id": "04771de8-c642-3284-8eaf-3b6a2863eae8",
                                "text": "„Völkerrechtler legen fest, daß die Grenze im Boden unterirdisch als gedachte Schnittfläche bis zum Erdmittelpunkt verläuft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
