                        ],
                        "form": "die Sondersprache"
                    },
                    {
                        "form_id": "e864c578-19f4-485f-8beb-0762ecbb64ec",
                        "entry_id": "ac65b96e-5a80-331b-b4fc-c761eb789c7c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sondersprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                        "entry_id": "ac65b96e-5a80-331b-b4fc-c761eb789c7c",
                        "glosses": [
                            "Varietät einer Sprache, die nicht von allen Sprechern dieser Sprache verstanden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d1bf44-32a6-4218-8e01-f54547ea44ba",
                                "sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                                "text": "Sondersprachen sind an bestimmte Sprechergruppen einer Sprachgemeinschaft gebunden und für Außenstehende teilweise oder ganz unverständlich."
                            },
                            {
                                "example_id": "550d5e45-a491-44a5-aebe-60820bbf69f6",
                                "sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                                "text": "„In den entwickelteren Verhältnissen des 14./17. Jahrhunderts mit ihrem aufstrebenden Städtewesen und einer weitergehenden gesellschaftlichen Aufspaltung spielen die meist über die landschaftlichen Räume hinaus geltenden Sondersprachen sozialer Gruppen eine wichtigere Rolle als je zuvor.“"
                            },
                            {
                                "example_id": "b41a19fc-478e-416e-adb6-239ce35a2928",
                                "sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                                "text": "„Diesen sachorientierten Fachsprachen stehen die gruppenorientierten Sondersprachen gegenüber.“"
                            },
                            {
                                "example_id": "b4e0d85a-fdb9-442d-aee1-50cf999ad3c5",
                                "sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                                "text": "„Diese Sondersprache gewann dann einen Anstrich der Erinnerung und gehört nun in die Stammtischgespräche über die Erlebnisse von einst.“"
                            },
                            {
                                "example_id": "5eea572f-786e-43f7-a62c-aaa8f56548f2",
                                "sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                                "text": "„Wie es zu dieser Einschätzung kommen konnte, wie stark der Einfluss des Jiddischen auf die deutschen Sondersprachen tatsächlich ist und welche Rolle das Rotwelsche bei der Vermittlung der vielen Jiddismen in die aktuelle Umgangssprache gespielt hat, das erläutert der Beitrag »Hebraismen in deutschen Sondersprachen«.“"
                            },
                            {
                                "example_id": "3e6ce2cd-28a3-4fb1-942c-1c466d4b4b04",
                                "sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                                "text": "„Steht das Tarnungsinteresse von Sondersprachen im Vordergrund, spricht man von Geheimsprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b56207e6-333f-49b4-b2be-30bd97e4978f",
                        "source_entry_id": "ac65b96e-5a80-331b-b4fc-c761eb789c7c",
                        "source_sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                        "source_sense_description": "Linguistik: Varietät einer Sprache, die nicht von allen Sprechern dieser Sprache verstanden wird",
                        "target_lang_word": "idiom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59d87e37-8c8d-4f6d-8ecf-ad670d282f6c",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "In English, idiom requires the indefinite article in a phrase such as \"she's an engineer\", whereas in Spanish, idiom forbids it."
                                            },
                                            {
                                                "example_id": "251e739c-fe54-45ed-9e43-37d875570181",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "Some of the usage prescriptions improved clarity and were kept; others that yielded discordant violations of idiom were eventually revised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people.",
                                            "A programming construct or phraseology that is characteristic of the language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ed047a-020a-4bdf-92d8-b8bd6707f9af",
                                                "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                                "text": "I have to use the same assignment and call to raw_input in two places. How can I avoid that? I can use the while True/break idiom: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A language or language variety; specifically, a restricted dialect used in a given historical period, context etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694ce1c5-20d5-41ca-94e1-4514efdf8a2d",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "In the idiom of the day, they were sutlers, although today they'd probably be called vendors."
                                            },
                                            {
                                                "example_id": "9364d6fd-b949-416f-bd8f-3126dd3dee8c",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "Many parents and teachers have become irritated to the point of distraction at the way the weed-style growth of \"like\" has spread through the idiom of the young."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An established phrasal expression whose meaning may not be deducible from the literal meanings of its component words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db5e533-89e7-4d96-996a-2da4bc4ae757",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "She often spoke in idioms, pining for salad days and complaining about pots calling the kettle black."
                                            },
                                            {
                                                "example_id": "4d267c6a-d6ab-4038-a898-cb5fa85f273c",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "You’re history, we say […]. Surely it is an American idiom. Impossible to imagine a postwar European saying, “You’re history. . . . That’s history,” meaning fuhgeddaboudit, pal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An artistic style (for example, in art, architecture, or music); an instance of such a style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416762a8-e688-4c82-9ce0-cf636b403e6a",
                                                "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                                "text": "the idiom of the expressionists"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a5f3e52-b4e6-44fe-b951-c8202291a64e",
                        "source_entry_id": "ac65b96e-5a80-331b-b4fc-c761eb789c7c",
                        "source_sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                        "source_sense_description": "Linguistik: Varietät einer Sprache, die nicht von allen Sprechern dieser Sprache verstanden wird",
                        "target_lang_word": "sublanguage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sublanguage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baa055ea-f71a-3e68-8f86-fbb5bb7fa882",
                                        "entry_id": "1d11bde3-26ea-3727-9529-aa4a44b677ac",
                                        "glosses": [
                                            "A subset of a language, in particular of a programming language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ae7b84-b5d0-4542-be92-1ffd6397fe60",
                                                "sense_id": "baa055ea-f71a-3e68-8f86-fbb5bb7fa882",
                                                "text": "DML is considered a sublanguage of SQL. It's concerned with manipulating data stored in the database. DML consists of four commonly used statements: INSERT, UPDATE, DELETE, and MERGE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3ca0d56-4603-317d-a322-692500ec34dd",
                                        "entry_id": "1d11bde3-26ea-3727-9529-aa4a44b677ac",
                                        "glosses": [
                                            "A language restricted to a specific context, such as a particular subject area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56abb464-e246-4442-9c4a-a326d9073d03",
                                                "sense_id": "d3ca0d56-4603-317d-a322-692500ec34dd",
                                                "text": "the sublanguage of weather bulletins"
                                            },
                                            {
                                                "example_id": "163a6f66-12f6-4b93-8356-db5c8df772dc",
                                                "sense_id": "d3ca0d56-4603-317d-a322-692500ec34dd",
                                                "text": "We define sublanguage here as the particular language used in a body of texts dealing with a circumscribed subject area (often reports or articles on a technical speciality or science subfield), in which the authors share a common vocabulary and common habits of word usage."
                                            },
                                            {
                                                "example_id": "629bad8d-16a9-4f8b-a440-a0279d33711e",
                                                "sense_id": "d3ca0d56-4603-317d-a322-692500ec34dd",
                                                "text": "Sublanguages are usually taken from science and technology domains and are restricted to a particular topic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16e37e9c-1758-458d-a6d3-070c74c45293",
                        "source_entry_id": "ac65b96e-5a80-331b-b4fc-c761eb789c7c",
                        "source_sense_id": "952d8e37-05d1-33ba-8365-bca96e6ff634",
                        "source_sense_description": "Linguistik: Varietät einer Sprache, die nicht von allen Sprechern dieser Sprache verstanden wird",
                        "target_lang_word": "argot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                        "entry_id": "060430ba-46fc-339c-bb26-6d3bf7dabce5",
                                        "glosses": [
                                            "Langage de convention utilisé à l’origine par les voleurs, les malfaiteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48453ff0-c8ea-4008-aa84-346e5dd11f46",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Dans l’argot du temps on appelait M. Louis un homme spécial ; sa spécialité financière l’avait conduit à entasser l’argent des contribuables dans le trésor, pour le faire prendre par Bonaparte."
                                            },
                                            {
                                                "example_id": "205ad304-9b77-4c3d-b4eb-f6bcaf723dd0",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "C'est un garçon fort agréable que Bernard. Soigné, rasé de près, le teint clair, il s'exprime dans une langue choisie et ne fait usage de l’argot qu'en d'exceptionnelles circonstances."
                                            },
                                            {
                                                "example_id": "2c81be9e-9557-4da6-a27f-a6d601452aeb",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Et, tout à l'heure, quand il s'était adressé à la prostituée enceinte, il avait usé d'un terme dont la grossièreté\nTirant son origine d'une langue moins noble et moins enveloppée que l’argot\nMe choquait encore secrètement."
                                            },
                                            {
                                                "example_id": "5766989d-b8c2-4f5a-8c8b-8bbcaee523e5",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Après une vie exemplaire de vigilance et d’autorité, il paraît que le pauvre homme est tombé en enfance, qu’il se promène par les chemins de Claquebue en disant des vilains mots d’argot et en prêchant la fraternité."
                                            },
                                            {
                                                "example_id": "84c54123-df73-449c-ac49-f7c46d961055",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Il convient de savoir qu'un « coq », dans l’argot d’avant guerre, signifiait un louis, car mon récit repose sur cette explication, […]."
                                            },
                                            {
                                                "example_id": "8eb789fe-fe41-44ec-990d-2905c6485de6",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Les jeunes Français parlent un mélange de français, de verlan, d’arabe, de tzigane, d’anglais, de vieil argot et d'expressions inventées. « J'ai le seum » tiré de l'arabe, veut dire « Je suis en colère »."
                                            },
                                            {
                                                "example_id": "d08a1e7d-6696-466b-90d2-474ce3a90d2b",
                                                "sense_id": "019661b8-e83c-3cb1-9b9d-dae1d764c768",
                                                "text": "Si l’on met à part les simples témoignages d’argotiers proprement dits ou de personnes les fréquentant professionnellement (policiers, magistrats), ce qui frappe c’est le caractère relativement tardif des études consacrées aux argots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                        "entry_id": "060430ba-46fc-339c-bb26-6d3bf7dabce5",
                                        "glosses": [
                                            "Jargon ou sociolecte ; vocabulaire (et parfois autres traits de langage) utilisé au sein d'une profession ou bien d'un milieu ou classe sociale particulière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80b5bf7e-d778-49d5-a1da-9c22daa16080",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des bouchers (Louchébem)"
                                            },
                                            {
                                                "example_id": "12278cdb-92ec-41a7-83c4-e5ab3721e2ce",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot de la Bourse."
                                            },
                                            {
                                                "example_id": "86967a18-d0d5-4dd0-b678-b783c19c0d11",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des cités."
                                            },
                                            {
                                                "example_id": "c1dc43d1-1560-46f8-a51b-f57c780a9421",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des peintres, des écoliers."
                                            },
                                            {
                                                "example_id": "bd44bf52-a675-471f-8bb9-1e1d99b5ce65",
                                                "sense_id": "4ac0ec7e-390d-3b6d-8118-07426f95b514",
                                                "text": "L’argot des coulisses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3de4c9f-a1f8-3861-bf5a-23d7054238dd",
                                        "entry_id": "060430ba-46fc-339c-bb26-6d3bf7dabce5",
                                        "glosses": [
                                            "Langage populaire, non académique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a894ca-cde9-4253-8a88-b16d43b73915",
                                                "sense_id": "b3de4c9f-a1f8-3861-bf5a-23d7054238dd",
                                                "text": "En argot français, si le hareng saur est appelé gendarme, c'est peut-être parce qu'on pense qu'un gendarme est raide comme un hareng saur."
                                            },
                                            {
                                                "example_id": "0d38f268-b019-4588-995c-dbe5ff78d105",
                                                "sense_id": "b3de4c9f-a1f8-3861-bf5a-23d7054238dd",
                                                "text": "La cuisine était la préfecture de police dans l’argot des voleurs qui redoutaient sans doute de s'y retrouver pour être cuisinés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "argot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d409218f-2060-356f-9bb2-866709c2b1ad",
                                        "entry_id": "f902119d-f6be-3777-aa6a-144be9de55af",
                                        "glosses": [
                                            "Bois qui est au-dessus de l'œil sur le rameau."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
