                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d529ca03-0617-300d-aade-f6e66293bf72",
                        "entry_id": "b12049dc-4f46-34b1-9b17-db5c24e93c6a",
                        "glosses": [
                            "разг. без всякого умысла, без предумышленной цели, простодушно, не отдавая себе отчета"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e0ffce8-d056-447a-961e-991bc4d22913",
                        "source_entry_id": "b12049dc-4f46-34b1-9b17-db5c24e93c6a",
                        "source_sense_id": "d529ca03-0617-300d-aade-f6e66293bf72",
                        "target_lang_word": "sans raison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans raison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d80a5bc9-300d-3aae-a642-5310c5f02ed9",
                                        "entry_id": "53102ca4-9a91-39fe-8726-236375e767bd",
                                        "glosses": [
                                            "Sans aucun bon sens, déraisonnablement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ef7ce22-39ef-4ee6-b00b-da51635e3316",
                                                "sense_id": "d80a5bc9-300d-3aae-a642-5310c5f02ed9",
                                                "text": "— Vous aimez ça, vous, le sucre du pays ? Moi, j’aime ça sans raison…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea17ce26-bbab-454d-bd18-42305c194dfd",
                        "source_entry_id": "b12049dc-4f46-34b1-9b17-db5c24e93c6a",
                        "source_sense_id": "d529ca03-0617-300d-aade-f6e66293bf72",
                        "target_lang_word": "ingénument",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingénument",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fdf5d23-c767-3ab5-aa5c-9aeb50cb97e5",
                                        "entry_id": "9a3a4ee4-1a2f-34a9-a2af-4eac85f8dbbb",
                                        "glosses": [
                                            "D’une manière ingénue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28b83f96-84a8-4833-9864-564d35fbde2e",
                                                "sense_id": "2fdf5d23-c767-3ab5-aa5c-9aeb50cb97e5",
                                                "text": "Là se montrent ingénument la grossièreté et la franchise."
                                            },
                                            {
                                                "example_id": "4608ed6f-bc3d-4c2a-8340-3b2dc7c80ea7",
                                                "sense_id": "2fdf5d23-c767-3ab5-aa5c-9aeb50cb97e5",
                                                "text": "En ce cas, tout ce que doit faire un historien, c’est de conter ingénument le fait, sans vouloir pénétrer les motifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a5e9067-e62b-3390-983e-8ab4d8781f55",
                                        "entry_id": "9a3a4ee4-1a2f-34a9-a2af-4eac85f8dbbb",
                                        "glosses": [
                                            "Sincèrement, franchement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ced63d7-e05d-412b-943f-41e55abd0747",
                                                "sense_id": "8a5e9067-e62b-3390-983e-8ab4d8781f55",
                                                "text": "J'aime mieux confesser ingénument mon péché que de me mettre en peine de le mal justifier."
                                            },
                                            {
                                                "example_id": "7ca5322c-305b-4235-af94-9e49e0600764",
                                                "sense_id": "8a5e9067-e62b-3390-983e-8ab4d8781f55",
                                                "text": "Pour moi, je lui dirais ingénument la chose."
                                            },
                                            {
                                                "example_id": "411ebc10-3ba9-48f7-901c-c5d947c18c01",
                                                "sense_id": "8a5e9067-e62b-3390-983e-8ab4d8781f55",
                                                "text": "Xanthus en aperçut une [inscription] qu’il ne put entendre, quoiqu'il demeurât longtemps à en chercher l’explication ; elle était composée des premières lettres de certains mots ; le philosophe avoua ingénument que cela passait son esprit."
                                            },
                                            {
                                                "example_id": "234d55e9-38a9-4379-9164-d66bfa8dce3b",
                                                "sense_id": "8a5e9067-e62b-3390-983e-8ab4d8781f55",
                                                "text": "Je sais que bien des gens parlent de l’Ingénu ; tout ce que je puis répondre très ingénument, c’est que je ne l’ai point vu encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cedc9d2-bfd5-4c28-b245-73144aeb72ec",
                        "source_entry_id": "b12049dc-4f46-34b1-9b17-db5c24e93c6a",
