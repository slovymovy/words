                        "glosses": [
                            "een identiteitsbewijs dat op een kaart gedrukt is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affe712c-8736-4d0b-9b2b-d86c94a6a365",
                                "sense_id": "10e63f50-b63a-3c32-9e79-4b884e3bef11",
                                "text": "De politie heeft vandaag gecontroleerd of iedereen zijn identiteitskaart bij zich had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef6e32d8-db4f-44e4-8e8b-c96eed6acbf3",
                        "source_entry_id": "01e06d46-763c-30b3-a056-d2fb403c6fbf",
                        "source_sense_id": "10e63f50-b63a-3c32-9e79-4b884e3bef11",
                        "source_sense_description": "een identiteitsbewijs dat op een kaart gedrukt is",
                        "target_lang_word": "Ausweis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausweis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbe6af80-a2df-398e-88fb-c3fbb7998b0c",
                                        "entry_id": "4e7fb694-2526-3b2a-8cc2-f07a6bbdda05",
                                        "glosses": [
                                            "Dokument, das als Bestätigung oder Legitimation ausgestellt worden ist und Angaben zur betreffenden Person enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251e372d-bda6-4da0-af7b-2d656db5b81c",
                                                "sense_id": "cbe6af80-a2df-398e-88fb-c3fbb7998b0c",
                                                "text": "Ich habe meinen Ausweis zu Hause liegen lassen."
                                            },
                                            {
                                                "example_id": "46f87902-05c4-40a4-9475-6007af60498f",
                                                "sense_id": "cbe6af80-a2df-398e-88fb-c3fbb7998b0c",
                                                "text": "Ist Dein Ausweis schon abgelaufen?"
                                            },
                                            {
                                                "example_id": "39062e9f-a4ab-4d19-ab48-5c21365038b8",
                                                "sense_id": "cbe6af80-a2df-398e-88fb-c3fbb7998b0c",
                                                "text": "„Unser Ostberliner Stadtführer stieg dann in unseren Bus, begrüßte uns und sammelte erst einmal unsere Ausweise ein.“"
                                            },
                                            {
                                                "example_id": "9ef38d2b-fae5-4cd6-85e0-6d4fa52da8a1",
                                                "sense_id": "cbe6af80-a2df-398e-88fb-c3fbb7998b0c",
                                                "text": "„Da war der Ausweis des Toten.“"
                                            },
                                            {
                                                "example_id": "f26404bd-6e30-4f25-94ef-cd0e18c64564",
                                                "sense_id": "cbe6af80-a2df-398e-88fb-c3fbb7998b0c",
                                                "text": "„Irinas Ausweis war also ebenso wenig wert wie seine Dienstmarke.“"
                                            },
                                            {
                                                "example_id": "35c8beef-ae8d-46e0-91dc-792b543cd97b",
                                                "sense_id": "cbe6af80-a2df-398e-88fb-c3fbb7998b0c",
                                                "text": "„Als der Zug dort einfuhr, sah sie auf dem Bahnsteig die Militärpolizei stehen und die Ausweise der Ankommenden kontrollieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ea0be78-a52f-3e12-82b2-00fc64db5486",
                                        "entry_id": "4e7fb694-2526-3b2a-8cc2-f07a6bbdda05",
                                        "glosses": [
                                            "Kenntlichmachung eines Sachverhaltes, insbesondere von Teilbeträgen einer Summe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff07627-421e-4663-bd15-7708f84da4f0",
                                                "sense_id": "5ea0be78-a52f-3e12-82b2-00fc64db5486",
                                                "text": "Bitte erstellen Sie mir die Rechnung mit Ausweis der Mehrwertsteuer, da die Vorsteuer sonst nicht rückforderbar ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70211f15-fa60-4bd7-acd9-d2145d132039",
                        "source_entry_id": "01e06d46-763c-30b3-a056-d2fb403c6fbf",
                        "source_sense_id": "10e63f50-b63a-3c32-9e79-4b884e3bef11",
