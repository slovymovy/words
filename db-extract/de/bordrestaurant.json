                        "glosses": [
                            "Restaurant, das sich an Bord eines Zugs oder Schiffs befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ccb7d8b-d47e-47ed-8f5c-9573eec922dd",
                                "sense_id": "ecfd17f9-2917-300d-9dda-a8e3aa52fa4c",
                                "text": "„Es gibt ja nicht viele Bewegungsmöglichkeiten an Bord und so laufen wir, um überhaupt zu laufen, mehrmals täglich zwischen Bordrestaurant, Kabine, Sonnendeck und Bug hin und her, auf und ab und so begegnen wir der auffällig gekleideten Frau, die jeden Tag einen anderen Hut trägt.“"
                            }
                        ],
