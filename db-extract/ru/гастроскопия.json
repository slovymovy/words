                                    {
                                        "sense_id": "b02c819a-526d-3db1-94f0-18d610a741a8",
                                        "entry_id": "c7792395-5b9c-3ab6-9c74-001a3239eaa4",
                                        "glosses": [
                                            "Endoscopie de l’estomac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf0199f6-ec71-4f78-b94f-c32c405145e9",
                                                "sense_id": "b02c819a-526d-3db1-94f0-18d610a741a8",
                                                "text": "La gastroscopie, ou plus précisément l'œso-gastro-duodé- noscopie, est devenue, depuis son introduction il y a environ 20 ans, l'examen de référence pour l'exploration du tractus digestif haut, jusqu'à la deuxième portion du duodénum."
                                            },
                                            {
                                                "example_id": "011e7d92-28c8-4abe-bc41-8c72590edc8b",
                                                "sense_id": "b02c819a-526d-3db1-94f0-18d610a741a8",
                                                "text": "La gastroscopie est une exploration visuelle, qui sert à mettre en évidence des lésions de l'œsophage, de l'estomac et du duodénum."
                                            }
                                        ]
                                    }
                                ]
                            }
