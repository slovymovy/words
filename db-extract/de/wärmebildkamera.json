                "senses": [
                    {
                        "sense_id": "abaeee55-4b7a-3f1f-9fe2-03aea2fab45a",
                        "entry_id": "97d098c1-66e9-3c28-9b9a-b6e50f9f5d58",
                        "glosses": [
                            "elektronisches Gerät zur Erstellung von Wärmebildern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df299756-c33a-495f-aaed-5d83df55d9f2",
                                "sense_id": "abaeee55-4b7a-3f1f-9fe2-03aea2fab45a",
                                "text": "„Die Erstellung der Bauthermografie erfolgt mittels Wärmebildkamera und ist sehr wetterabhängig.“"
                            },
                            {
                                "example_id": "aadcec59-9ba5-4298-a40b-b8d96a8d9e28",
                                "sense_id": "abaeee55-4b7a-3f1f-9fe2-03aea2fab45a",
                                "text": "„So verkündete der türkische Europa-Minister im Dezember stolz, die EU spendiere seinem Land modernste Wärmebildkameras für die Außengrenze.“"
                            },
                            {
                                "example_id": "cfb27916-75e9-4e64-b327-58f99e509efe",
                                "sense_id": "abaeee55-4b7a-3f1f-9fe2-03aea2fab45a",
                                "text": "„Zwar seien die Einsätze teuer, die dabei verwendete Wärmebildkamera erziele aber so gute Erfolge, dass die Hubschrauber einfach öfter angefordert würden, erklärt Werner Senn, Abteilungsleiter der Flugpolizei im Innenministerium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
