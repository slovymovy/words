                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66239d42-d361-4968-805d-29b49b09db91",
                                "sense_id": "fb96e98a-cf7c-300e-b980-fb4b177f7495",
                                "text": "Une honte en béton, qui « bantoustise » Ghaza, est baptisé par ces « propres journalistes » en panne de vocabulaire « mur de séparation »."
                            },
                            {
                                "example_id": "99f72a86-50c2-4a20-b176-a54602c9f54a",
                                "sense_id": "fb96e98a-cf7c-300e-b980-fb4b177f7495",
                                "text": "C’est pas des bantoustans, la banlieue, voilà, on est en train de bantoustiser la banlieue avec des artistes banlieue, des plans… de l’économie banlieue, et cétéra, et cétéra."
                            }
                        ]
                    }
