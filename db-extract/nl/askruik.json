                        "entry_id": "7a62e8a0-c66f-319e-9ae1-8e27aeeefa18",
                        "glosses": [
                            "een pot waarin de as van een overledene in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "547cfa87-bf5d-4a15-bc42-001c0405fbd9",
                                "sense_id": "12bd7723-5cb0-3180-9990-05381fb4de60",
                                "text": "De 14-jarige Maarten van Duijn, vrijwilliger bij de hulp aan zeezoogdieren, vond zaterdag de eerste askruik op het strand van Noordwijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07bf341f-6a45-470c-85a4-ca72fc1bed6a",
                        "source_entry_id": "7a62e8a0-c66f-319e-9ae1-8e27aeeefa18",
                        "source_sense_id": "12bd7723-5cb0-3180-9990-05381fb4de60",
                        "source_sense_description": "een pot waarin de as van een overledene in zit",
                        "target_lang_word": "urn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A vase with a footed base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad61042a-a746-47b8-89a5-d3f3af209f9d",
                                                "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                                "text": "A rustic, digging in the ground by Padua, […]found an urn, or earthen pot, in which there was another urn."
                                            },
                                            {
                                                "example_id": "8b040093-8f61-4e11-9285-159e6bf5a8c2",
                                                "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                                "text": "His scattered limbs with my dead body burn, / And once more join us in the pious urn."
                                            },
                                            {
                                                "example_id": "d2138ee9-f3c8-4afb-af12-27e995bbb522",
                                                "sense_id": "e95f4619-0091-3a10-ba2d-2d380b4ad7cd",
                                                "text": "Mary Fibbs and all her friends start making coughing noises whenever I come near them, and then they all giggle and Mary says Grandfather mixes his cough medicine in the urns on top of the gate posts after dark with his umbrella, and now Jessamy!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58556f54-ee9f-3ea6-8393-d2349b5178b3",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A metal vessel for serving tea or coffee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50c360fb-91f2-37b4-a27e-88a6b96e439b",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A vessel for the ashes or cremains of a deceased person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6bcf24-c486-4a72-b485-d4168da90e2e",
                                                "sense_id": "50c360fb-91f2-37b4-a27e-88a6b96e439b",
                                                "text": "So draw him home to those that mourn\n⁠In vain; a favourable speed\n⁠Ruffle thy mirror’d mast, and lead\nThro’ prosperous floods his holy urn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a4350c-0ec5-3b45-873d-7a01a692a6e7",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "Any place of burial; the grave."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e385b3d-1263-43db-9be2-911014aa3208",
                                                "sense_id": "83a4350c-0ec5-3b45-873d-7a01a692a6e7",
                                                "text": "Or lay these bones in an unworthy urn, / Tombless, with no remembrance over them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4168d61e-075d-32e8-ae7e-f39c199514ea",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A measure of capacity for liquids, containing about three gallons and a half, wine measure. It was half the amphora, and four times the congius."
                                        ],
                                        "tags": [
                                            "Roman",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39b1f880-faf8-37c2-b6ad-0c54e8ec42dd",
                                        "entry_id": "1b03209a-3945-34ee-8567-bd333b507156",
                                        "glosses": [
                                            "A hollow body shaped like an urn, in which the spores of mosses are contained; a spore case; a theca."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
