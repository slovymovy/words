                                        "examples": [
                                            {
                                                "example_id": "50d04ca4-eb05-4733-b985-64e44aee3ac2",
                                                "sense_id": "1b1135e4-57cf-361e-b80d-8005da099088",
                                                "text": "[T]he fire-dragon\nhad rased the coastal region and reduced\nforts and earthworks to dust and ashes,\nso the war-king planned and plotted his revenge."
                                            },
                                            {
                                                "example_id": "a6a8423b-b1b3-427b-8c1d-e750a424dc20",
                                                "sense_id": "1b1135e4-57cf-361e-b80d-8005da099088",
                                                "text": "Adam continued to moan in hypnotic agony. Joshua needed to make a move. Boldly, Joshua strode toward the firedragon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c886e3-4859-3a01-8a2e-f13ef055d290",
