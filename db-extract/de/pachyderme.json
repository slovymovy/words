                    {
                        "translation_id": "0e98d1af-72e1-4887-bb0b-aceb6ad678e8",
                        "source_entry_id": "bfec1e08-f1b5-373e-82b8-e1ed78041681",
                        "source_sense_id": "059f2089-3fe6-3c1d-8c07-d6dc13002ea5",
