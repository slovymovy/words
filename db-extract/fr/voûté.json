                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a42776-a684-493e-8179-83c5f9a3c061",
                                "sense_id": "c24763c3-a140-3a95-9f41-9a5b1505a1b3",
                                "text": "On y pénètre par une rue voûtée qui se lie à une autre voûte assez longue et très obscure."
                            },
                            {
                                "example_id": "90d7d9a1-bf9d-45c7-91e8-edaa58a5812b",
                                "sense_id": "c24763c3-a140-3a95-9f41-9a5b1505a1b3",
                                "text": "Une cave voûtée."
                            },
                            {
                                "example_id": "52722488-e303-4220-819a-0a196f139832",
                                "sense_id": "c24763c3-a140-3a95-9f41-9a5b1505a1b3",
                                "text": "Cet homme est déjà un peu voûté."
                            },
                            {
                                "example_id": "17364fca-35a0-4446-af7a-7675791854a4",
                                "sense_id": "c24763c3-a140-3a95-9f41-9a5b1505a1b3",
                                "text": "Il marche le dos voûté."
                            }
                        ]
