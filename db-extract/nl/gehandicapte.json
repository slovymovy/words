                        "examples": [
                            {
                                "example_id": "058bcd04-10d2-4152-8b0c-5428ef2bf500",
                                "sense_id": "65f9dd89-b6be-312d-8d06-56556824d525",
                                "text": "Chronisch zieken en gehandicapten worden onevenredig hard getroffen door de nieuwe bezuinigingen."
