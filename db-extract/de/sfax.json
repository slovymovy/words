                            {
                                "example_id": "6315b8bd-72c6-476d-8ea3-fc9f7d6df58f",
                                "sense_id": "ff33c33b-a248-3d11-b024-b286b05279de",
                                "text": "„Aus Sfax sind seit Anfang des Jahres zahlreiche Menschen gestartet, um das Mittelmeer in Richtung Europa zu überqueren.“"
