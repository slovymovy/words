                "senses": [
                    {
                        "sense_id": "7e3b9e18-ee55-3f57-9255-bd26630e26a5",
                        "entry_id": "31603b32-042e-3b70-9c51-8237de91148a",
                        "glosses": [
                            "Crise d’épilepsie ou évanouissement."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "20f3ff17-af50-46db-b335-2e69902d5892",
                                "sense_id": "7e3b9e18-ee55-3f57-9255-bd26630e26a5",
                                "text": "Elle a vraiment l’air sur le point de tomber en digue-digue; alors, je passe mon bras autour de sa taille et je l’amène s’asseoir près du bastingage du pont arrière."
                            },
                            {
                                "example_id": "01930c45-cc97-447c-974d-2070ed043f85",
                                "sense_id": "7e3b9e18-ee55-3f57-9255-bd26630e26a5",
                                "text": "Je retourne auprès de la bonniche en digue-digue, la soulève — je ne sais pas comment elle est nourrie, mais elle ne pèse pas lourd —, la transporte dans le salon et l’installe sur le canapé en question."
                            }
                        ]
                    },
                    {
                        "sense_id": "454403db-7c09-333a-a03e-b911a1da549f",
                        "entry_id": "31603b32-042e-3b70-9c51-8237de91148a",
                        "glosses": [
                            "Dégradation progressive."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8ec8b275-0cf8-44c4-9815-5620a5212957",
                                "sense_id": "454403db-7c09-333a-a03e-b911a1da549f",
                                "text": "Tout ça part en digue-digue."
                            },
                            {
                                "example_id": "18c2ddd3-c49c-4ec7-ae3c-fe8ec263a447",
                                "sense_id": "454403db-7c09-333a-a03e-b911a1da549f",
                                "text": "C'est vrai, regarde : des institutions, aussi solidement ancrées que la famille et le mariage, eh ben, ça tombe en digue-digue."
                            }
                        ]
                    }
