                                    {
                                        "sense_id": "d2de9bf0-4906-30ff-8cf3-d41e96eb431a",
                                        "entry_id": "9db31d9e-3dd7-3922-8dd9-784d171783ef",
                                        "glosses": [
                                            "A binary compound of iodine and another element or radical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "731681ab-7054-3893-bfe5-4f1e44484391",
                                        "entry_id": "9db31d9e-3dd7-3922-8dd9-784d171783ef",
                                        "glosses": [
                                            "A binary compound of iodine and another element or radical.",
                                            "Any salt of hydroiodic acid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5527dd-6b20-4ef0-b5af-faeba2987ce5",
                                                "sense_id": "731681ab-7054-3893-bfe5-4f1e44484391",
                                                "text": "The organification of iodide in the thyroid gland was described using a second order rate constant (KthybindC, /nmol/L*hr/kg thyroid weight) fitted to provide thyroidal iodide stores near the maximal value, which increased with age."
                                            },
                                            {
                                                "example_id": "1a053597-22e8-4491-99b8-8a070cf7be89",
                                                "sense_id": "731681ab-7054-3893-bfe5-4f1e44484391",
                                                "text": "Presence of nitrides, argonides, arsenides, and iodides in the crystalline rocks"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "543cce61-01dd-34b0-9115-84c3edc0247e",
                                        "entry_id": "9db31d9e-3dd7-3922-8dd9-784d171783ef",
                                        "glosses": [
                                            "The anionic form of an iodine atom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67be2735-03b2-4db1-8818-074e5ea91059",
                        "source_entry_id": "9d36b78b-bb28-345e-96d7-a1bcb22347d0",
                        "source_sense_id": "dc574466-bb12-3ad3-b07c-8bb1ec580bc0",
                        "target_lang_word": "iodure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iodure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a7e34da-e564-3b6b-8cde-4c4cde1f6793",
                                        "entry_id": "0d84732e-4a74-3787-b974-7deec475f302",
                                        "glosses": [
                                            "Combinaison de l’iode avec un corps simple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b9a792e-0e80-4257-9499-8d4f73eccbf7",
                                                "sense_id": "6a7e34da-e564-3b6b-8cde-4c4cde1f6793",
                                                "text": "Cette expérience prouve qu'une température élevée décompose également l’iodure tellurique dans cette combinaison."
                                            },
                                            {
                                                "example_id": "1b431fa4-68ef-4aa8-81e6-b696765e9643",
                                                "sense_id": "6a7e34da-e564-3b6b-8cde-4c4cde1f6793",
                                                "text": "Thymol C₁₀H₁₄O. […]. Traité en solution alcaline par une solution d’iode dans l’iodure de potassium, il donne une poudre rouge brun, très employée sous le nom d’aristol."
                                            },
                                            {
                                                "example_id": "c7d26158-fee4-4e64-a181-62f540ee934f",
                                                "sense_id": "6a7e34da-e564-3b6b-8cde-4c4cde1f6793",
                                                "text": "Un second procédé consiste à traiter le p-fluorophényl sulfinate de sodium par l’iodure d’éthyle dans l’éthanol."
                                            },
                                            {
                                                "example_id": "6ae2ef8d-9060-4bd1-a301-b4826c515cea",
                                                "sense_id": "6a7e34da-e564-3b6b-8cde-4c4cde1f6793",
                                                "text": "C'est ainsi que le méthylarsonite de sodium réagit sous cette seconde forme, avec l’iodure de méthyle, pour donner le diméthylarsinate de sodium."
                                            },
                                            {
                                                "example_id": "279616dc-a0f8-40e3-83ef-25ca68301f5b",
                                                "sense_id": "6a7e34da-e564-3b6b-8cde-4c4cde1f6793",
                                                "text": "Le diiode permettant d’étalonner la solution de thiosulfate peut être aussi préparé extemporanément par oxydation des iodures par le dichromate de potassium en milieu acide selon la réaction : Cr₂O₇²⁻ + 6 I⁻ + 14 H⁺ → 2 Cr₃⁺ + 3 I₂ + 7 H₂O."
                                            }
                                        ]
                                    }
                                ]
                            },
