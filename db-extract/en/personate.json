    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4f1bff01-ea04-31b0-9d19-0e045f1d3595",
                "word": "personate",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd85fdeb-b864-3ecb-a8b8-cd02da729581",
                        "entry_id": "4f1bff01-ea04-31b0-9d19-0e045f1d3595",
                        "glosses": [
                            "Having the throat of a corolla nearly closed by a projection of the base of the lower lip (reminiscent of a mask), as in the flower of the snapdragon."
                        ],
                        "tags": [
                            "not-comparable",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "ea6cd581-6cc6-414c-a350-4ae8ecb0ffc2",
                                "sense_id": "bd85fdeb-b864-3ecb-a8b8-cd02da729581",
                                "text": "This arrangement is well typified in plants with a personate corolla, such as the toad-flax and snap-dragon, ..."
                            },
                            {
                                "example_id": "97bd055f-c680-4b72-a842-1669720e5ac0",
                                "sense_id": "bd85fdeb-b864-3ecb-a8b8-cd02da729581",
                                "text": "[…] the commencement of the tube of a personate or labiate flower."
                            },
                            {
                                "example_id": "1bbf6f4a-63c2-4f7a-8f2d-42ce560b5718",
                                "sense_id": "bd85fdeb-b864-3ecb-a8b8-cd02da729581",
                                "text": "Bumble bees are a sturdy race of insects, made to crowd, push, probe, and burrow; therefore they prefer a tubular or bell-shaped flower that they can enter, or a personate or papilionaceous flower that they can force, or a tubular ..."
                            },
                            {
                                "example_id": "00cd1349-e7d7-4346-b6bb-62fd1ac59bf2",
                                "sense_id": "bd85fdeb-b864-3ecb-a8b8-cd02da729581",
                                "text": "Botanically, the palate is a rounded prominence on the lower lip, closing or nearly closing the throat of a personate flower."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "24a8a349-e70a-49c7-adba-ff0ae2baf4f5",
