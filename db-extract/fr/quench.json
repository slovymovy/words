                        "glosses": [
                            "Arrêt brutal d’un appareil de RMN ou d’IRM, s’accompagnant d’un dégagement d’hélium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b85b1fb9-9663-4c6c-bc1e-b9dcd16e3ab2",
                                "sense_id": "97de9cd3-03c8-3125-973d-3d917d9bb3de",
                                "text": "Le quench est l'un des principaux risques de l'IRM. Il s'agit de la vaporisation (c'est-à-dire le passage de l'état liquide à l'état gazeux) brutale de l'hélium liquide qui s'échappe de la cuve de l'aimant. Un quench peut être volontaire ou accidentel, et avoir des conséquences graves."
                            }
                        ]
                    },
