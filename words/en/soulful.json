            "senses": [
                {
                    "sense_id": "ee203ab7-0460-328f-825c-f1e5785f630e",
                    "sense_definition": "Expressing deep, sincere, or intense emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer gave a <w>soulful</w> performance that brought the entire audience to tears.",
                            "target_lang_translations": {
                                "cs": "Zpěvák podal <w>procítěný</w> výkon, který dohnal celé publikum k slzám."
                            }
                        },
                        {
                            "text": "She looked at him with <w>soulful</w> eyes, trying to convey her unspoken sadness.",
                            "target_lang_translations": {
                                "cs": "Podívala se na něj <w>dojemnýma</w> očima a snažila se vyjádřit svůj nevyřčený smutek."
                            }
                        }
                    ],
                    "synonyms": [
                        "expressive",
                        "emotional",
                        "moving",
                        "passionate"
                    ],
                    "antonyms": [
                        "emotionless",
                        "unfeeling"
                    ],
                    "common_phrases": [
                        "soulful eyes",
                        "soulful voice",
                        "soulful music"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyjadřující hluboké, upřímné nebo intenzivní emoce."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "procítěný",
                                "target_lang_sense_clarification": "vyjadřující hluboké emoce"
                            },
                            {
                                "target_lang_word": "dojemný",
                                "target_lang_sense_clarification": "vyvolávající silné pocity"
                            },
                            {
                                "target_lang_word": "duchaplný",
                                "target_lang_sense_clarification": "mající hloubku a výraz"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15d89875-88dc-32c6-9c06-d25f9eef0aef",
                    "sense_definition": "A quantity or amount that fills or satisfies the soul.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day, she found a <w>soulful</w> of peace in the quiet garden.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém dni našla v tiché zahradě <w>duši naplňující</w> klid."
                            }
                        },
                        {
                            "text": "He needed a <w>soulful</w> of inspiration to finish his difficult painting.",
                            "target_lang_translations": {
                                "cs": "Potřeboval <w>pořádnou dávku</w> inspirace, aby dokončil svůj náročný obraz."
                            }
