                ],
                "senses": [
                    {
                        "sense_id": "144d6487-6cec-3312-9b21-fa1b294b5e26",
                        "entry_id": "5c18748a-3220-336c-944a-1ab51fb36ede",
                        "glosses": [
                            "Entièrement écrit de la main de la même personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47c4e62-75c3-4cea-ad73-45db62f9f612",
                                "sense_id": "144d6487-6cec-3312-9b21-fa1b294b5e26",
                                "text": "Ce nom de Trognon lui fit entrevoir quelque machination, il crut à quelque vice de forme projeté par avance, à quelque infidélité préméditée par la Cibot, et il résolut de se servir de ce Trognon pour se faire dicter un testament olographe qu’il cachèterait et serrerait dans le tiroir de sa commode."
                            },
                            {
                                "example_id": "93dc117c-e715-48fb-a98b-2fce1dbbf82e",
                                "sense_id": "144d6487-6cec-3312-9b21-fa1b294b5e26",
                                "text": "Le testament olographe qui serait écrit, même partiellement, par une autre personne que le testateur serait nul."
                            },
                            {
                                "example_id": "84924bf4-82f2-4110-b866-c5a719927255",
                                "sense_id": "144d6487-6cec-3312-9b21-fa1b294b5e26",
                                "text": "Stéphane a retrouvé dans un placard de l’appartement, que le testament olographe avait mis à l’abri d’une intrusion de la famille, un grand sac"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4b3ea8e-afbd-489c-bf7b-3b53776f5c2e",
                        "source_entry_id": "5c18748a-3220-336c-944a-1ab51fb36ede",
                        "source_sense_id": "144d6487-6cec-3312-9b21-fa1b294b5e26",
                        "source_sense_description": "Entièrement écrit de la main de la même personne",
                        "target_lang_word": "holographic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holographic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93463a43-6729-3462-a658-af91ff0a4dc5",
                                        "entry_id": "6d490bfd-cd62-31dd-9cfb-425ab3029af3",
                                        "glosses": [
                                            "In the form of a hologram or holograph."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a830847b-fe76-4c29-b2eb-f2557aa77a88",
                                                "sense_id": "93463a43-6729-3462-a658-af91ff0a4dc5",
                                                "text": "Abba meanwhile, all of whom are still alive, will outsource their touring to holographic versions of themselves in 2019. “It’s perfect. We can be on stage while I’m home walking the dogs,” the band’s Benny Andersson said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c72f4b4b-ff58-3bb2-916f-2ad0227a5e15",
                                        "entry_id": "6d490bfd-cd62-31dd-9cfb-425ab3029af3",
                                        "glosses": [
                                            "Handwritten by a single writer."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7593a5f-8a15-4b5e-8fe9-dbe1ee6badd5",
                                                "sense_id": "c72f4b4b-ff58-3bb2-916f-2ad0227a5e15",
                                                "text": "a holographic will or testament"
                                            },
                                            {
                                                "example_id": "5dcf471d-a8a2-487e-ba2e-da1e4ab21757",
                                                "sense_id": "c72f4b4b-ff58-3bb2-916f-2ad0227a5e15",
                                                "text": "[…] although the will is holographic, and a holographic instrument cannot be admitted to probate where testator told the subscribing witnesses that it was not his will, […]"
                                            },
                                            {
                                                "example_id": "c3280ca2-a8e2-407e-a2da-bd13ee0adb97",
                                                "sense_id": "c72f4b4b-ff58-3bb2-916f-2ad0227a5e15",
                                                "text": "Upon the face of the will, which is holographic, and of considerable length, there is not the slightest evidence of derangement […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
