                                "tr": "Yeni bisikletimden çok <w>memnunum</w>.",
                                "es": "Estoy muy <w>satisfecho</w> con mi nueva bicicleta."
                            }
                        },
                        {
                            "text": "De leraar was <w>tevreden</w> over de resultaten van de toets.",
                            "target_lang_translations": {
                                "ru": "Учитель был <w>доволен</w> результатами теста.",
                                "en": "The teacher was <w>satisfied</w> with the results of the test.",
                                "pl": "Nauczyciel był <w>zadowolony</w> z wyników testu.",
                                "de": "Der Lehrer war mit den Ergebnissen der Prüfung <w>zufrieden</w>.",
                                "fr": "L'enseignant était <w>satisfait</w> des résultats du test.",
                                "it": "L'insegnante era <w>soddisfatto</w> dei risultati del test.",
                                "cs": "Učitel byl <w>spokojený</w> s výsledky testu.",
                                "tr": "Öğretmen sınav sonuçlarından <w>memnundu</w>.",
                                "es": "El profesor estaba <w>contento</w> con los resultados del examen."
                            }
                        }
