                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b333857-39fc-419f-a5b7-aa546bc90765",
                                                "sense_id": "fe5aba71-1df7-3f39-ab65-a34a8dd42622",
                                                "text": "W wyniku referendum został odwołany - prawo demokracji. Ale paradoksalnie wójt miał przestać pracować dla gminy w czasie, gdy z powodzeniem finalizował kilka najważniejszych inwestycji."
                                            },
                                            {
                                                "example_id": "e15a617f-fe40-4156-87b6-64b91a630b90",
                                                "sense_id": "fe5aba71-1df7-3f39-ab65-a34a8dd42622",
                                                "text": "Polska reprezentacja od lat z powodzeniem uczestniczy w mistrzostwach świata w siatkówce."
                                            },
                                            {
                                                "example_id": "a3cf9e4d-9636-420b-8083-1cd96f7308a2",
                                                "sense_id": "fe5aba71-1df7-3f39-ab65-a34a8dd42622",
                                                "text": "Uczę się gruzińskiego bez powodzenia od roku."
                                            },
                                            {
                                                "example_id": "afabebf7-4544-4301-8d8f-9d930931a6ad",
                                                "sense_id": "fe5aba71-1df7-3f39-ab65-a34a8dd42622",
                                                "text": "Jego/jej największą aspiracją jest mieć powodzenie w życiu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "3b3b02ec-5fcc-39f0-a31e-ec4c308d8847",
                                        "entry_id": "d22bfb5c-fe88-3f03-935a-016fb8989fe4",
                                        "glosses": [
                                            "atrakcyjność w oczach innych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322d3c66-46c2-46fc-b4cc-514e57f00b36",
                                                "sense_id": "3b3b02ec-5fcc-39f0-a31e-ec4c308d8847",
                                                "text": "Franek miał powodzenie u kobiet."
                                            }
                                        ],
