                "senses": [
                    {
                        "sense_id": "4e086005-d0c9-3f3f-abc9-7cb5fb0751c2",
                        "entry_id": "061aa111-41d6-3820-8e10-53817d90d615",
                        "glosses": [
                            "In a limp manner, without support or resistance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f17fbe63-a42c-41be-aaf4-d841c99f89f7",
                                "sense_id": "4e086005-d0c9-3f3f-abc9-7cb5fb0751c2",
                                "text": "The flag hung limply in the still air."
                            },
                            {
                                "example_id": "9fc47bd9-0903-4ec5-911b-8f2bfc64e64f",
                                "sense_id": "4e086005-d0c9-3f3f-abc9-7cb5fb0751c2",
                                "text": "Ah, but someone was raising her, so they were going to lay her on the trestles, and she not dead. She opened her eyes, took a deep breath, then limply and contritely placed both arms round Andrew's neck."
                            },
                            {
                                "example_id": "2357f871-880a-44c7-8956-dd2b73e98ef5",
                                "sense_id": "4e086005-d0c9-3f3f-abc9-7cb5fb0751c2",
                                "text": "He went on kissing her with unflagging industry, while she remained limply in his arms, in a species of satisfied trance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57457817-1e8b-4047-af01-9b25b0dce1a5",
                        "source_entry_id": "061aa111-41d6-3820-8e10-53817d90d615",
                        "source_sense_id": "4e086005-d0c9-3f3f-abc9-7cb5fb0751c2",
                        "source_sense_description": "Translations",
                        "target_lang_word": "bezwładnie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezwładnie",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                        "entry_id": "8c69cee3-a98a-3638-8776-9469d27a7b56",
                                        "glosses": [
                                            "w sposób bezwładny"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e605419e-eed2-4c3d-b3c9-092f790b8a50",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Jeżeli sprawy dadzą się w ten sposób ułożyć, opuszczam ramiona, rzucam się bezwładnie kolejom losu, niech wszystko ginie, przepada, niech się raz kończą piekielne udręczenia"
                                            },
                                            {
                                                "example_id": "e5125916-04dc-4339-a12f-58ab0c6c34fa",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Spoczywał bezwładnie na stole oparty"
                                            },
                                            {
                                                "example_id": "41415ca9-84e2-4995-bbb1-afc300224c77",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Chciał coś powiedzieć, ale się zatoczył nagle jak pijany i ciężko, bezwładnie zwalił się na podłogę"
                                            },
                                            {
                                                "example_id": "1f0035a6-7fd4-42f8-897d-b131dc9a3e4f",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Polluks poruszył jeszcze kilka razy wiosłami i — jak Sotion — osunął się bezwładnie na deski"
                                            },
                                            {
                                                "example_id": "25b8bb38-f4aa-48f7-8b45-83669b19bb55",
                                                "sense_id": "ae3b2780-dc88-3308-bd38-ab7be82dc7d9",
                                                "text": "Kij wypadł mi na ziemię, ręce obwisły bezwładnie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
