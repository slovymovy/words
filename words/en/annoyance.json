{
    "word_family": [
        "annoy",
        "annoying",
        "annoyed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37083fd0-9911-38d0-80e6-a321c4dafd2b",
                    "sense_definition": "The psychological state of being annoyed or irritated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She could not hide her <w>annoyance</w> when the meeting was delayed for the third time.",
                            "target_lang_translations": {
                                "nl": "Ze kon haar <w>ergernis</w> niet verbergen toen de vergadering voor de derde keer werd uitgesteld."
                            }
                        },
                        {
                            "text": "He tried to keep his <w>annoyance</w> in check while listening to the repetitive complaints.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde zijn <w>ergernis</w> in toom te houden terwijl hij naar de herhalende klachten luisterde."
                            }
                        }
                    ],
                    "synonyms": [
                        "exasperation",
                        "frustration",
                        "irritation",
                        "vexation"
                    ],
                    "common_phrases": [
                        "show annoyance",
                        "hide annoyance"
                    ],
                    "target_lang_definitions": {
                        "nl": "De psychologische toestand van geïrriteerd of geërgerd zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ergernis",
                                "target_lang_sense_clarification": "het gevoel van onvrede of irritatie"
                            },
                            {
                                "target_lang_word": "irritatie",
                                "target_lang_sense_clarification": "het gevoel van ongeduld of boosheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03e33c56-192b-3a25-a74b-89786ae1abe5",
                    "sense_definition": "A person or thing that causes irritation or bother.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant buzzing of the fly was a major <w>annoyance</w> during the quiet afternoon.",
                            "target_lang_translations": {
                                "nl": "Het constante gezoem van de vlieg was een grote <w>ergernis</w> tijdens de rustige middag."
                            }
                        },
                        {
                            "text": "Dealing with slow internet speeds is a daily <w>annoyance</w> for many remote workers.",
                            "target_lang_translations": {
                                "nl": "Omgaan met trage internetsnelheden is een dagelijkse <w>ergernis</w> voor veel thuiswerkers."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "irritation"
                    ],
                    "common_phrases": [
                        "minor annoyance",
                        "real annoyance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een persoon of ding dat irritatie of last veroorzaakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ergernis",
                                "target_lang_sense_clarification": "iets dat irritatie opwekt"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "iets dat hinderlijk is"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc8b666b-5a99-3f0b-bc73-602b99b49568",
                    "sense_definition": "An act or instance of annoying someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant tapping on the desk was an <w>annoyance</w> that eventually caused a confrontation.",
                            "target_lang_translations": {
                                "nl": "Zijn constante getik op het bureau was een <w>hinderlijke handeling</w> die uiteindelijk tot een confrontatie leidde."
                            }
                        },
                        {
                            "text": "The persistent <w>annoyance</w> of the telemarketer finally forced her to hang up the phone.",
                            "target_lang_translations": {
                                "nl": "De aanhoudende <w>irritatie</w> door de telemarketeer dwong haar uiteindelijk om de telefoon op te hangen."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "irritation"
                    ],
                    "common_phrases": [
                        "persistent annoyance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een handeling of voorval waarbij iemand wordt geërgerd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "hinder",
                                "target_lang_sense_clarification": "het storen van iemand"
                            },
                            {
                                "target_lang_word": "irritatie",
                                "target_lang_sense_clarification": "het proces van iemand irriteren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}