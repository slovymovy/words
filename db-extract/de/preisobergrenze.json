                "senses": [
                    {
                        "sense_id": "c2ff7e9f-7e08-3221-8d64-2f150e4119de",
                        "entry_id": "5b58c57d-b612-3d7b-8ebf-8ec41db14193",
                        "glosses": [
                            "oberste Preisgrenze (die jemand beim Fremdbezug einer Ware oder Dienstleistung nicht überschreiten darf, kann oder will)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963bbc05-2bda-4fd5-9967-c492a9f048fe",
                                "sense_id": "c2ff7e9f-7e08-3221-8d64-2f150e4119de",
                                "text": "«[…] Wie die amerikanische Finanzministerin […] bei ihrem Besuch in Kanada erklärte, verhandeln die USA und verbündete Staaten konkret über eine Preisobergrenze für Erdöl. Damit sollen die Einnahmen Moskaus aus Ölexporten gesenkt und zugleich die wirtschaftlichen Folgen des Ukraine-Kriegs für andere Länder abgeschwächt werden.»"
                            },
                            {
                                "example_id": "d6e791b7-50cf-4307-9eb8-003de2becd77",
                                "sense_id": "c2ff7e9f-7e08-3221-8d64-2f150e4119de",
                                "text": "„Er meinte, die ökonomische Situation unter Kontrolle zu bekommen, indem er den Unternehmern und Kaufleuten eine Preisobergrenze befahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
