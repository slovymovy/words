                "senses": [
                    {
                        "sense_id": "09ecc2d7-5408-31ce-9291-ee534a10c767",
                        "entry_id": "50c58621-8352-38af-95c2-f1b5ff957f28",
                        "glosses": [
                            "Donner un caractère trash à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0e4fbf-5b3d-4382-8479-08f4efab8f9f",
                                "sense_id": "09ecc2d7-5408-31ce-9291-ee534a10c767",
                                "text": "Chez Balenciaga, ils ont vraiment trashé le vêtement, c’est rapiécé."
                            }
                        ]
                    },
                    {
                        "sense_id": "3338cb1d-2be4-31eb-84f2-afd362947eeb",
                        "entry_id": "50c58621-8352-38af-95c2-f1b5ff957f28",
                        "glosses": [
                            "Dénigrer, traiter comme moins que rien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f8b22f9-817b-4a9c-b7ac-77acb29628fc",
                                "sense_id": "3338cb1d-2be4-31eb-84f2-afd362947eeb",
                                "text": "C'est une manière de tendre le baton pour se faire battre, alors qu'en France on trashe facilement ce qui ne marche pas comme prévu."
                            },
                            {
                                "example_id": "bf7f3478-7349-4df8-9a99-8c028a219cb1",
                                "sense_id": "3338cb1d-2be4-31eb-84f2-afd362947eeb",
                                "text": "Quand des avocats trashent le carcéral, soyons là."
                            },
                            {
                                "example_id": "b4a2d1b0-9db3-4c3d-8407-6da0b55b0967",
                                "sense_id": "3338cb1d-2be4-31eb-84f2-afd362947eeb",
                                "text": "Le jour où on trashera les patrons comme on trashe les \"émeutiers Nutella\" on aura avancé..."
                            }
                        ]
                    }
