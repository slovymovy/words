                ],
                "senses": [
                    {
                        "sense_id": "9848c0fa-33b8-3d09-aab0-9e102101f90e",
                        "entry_id": "83647982-136e-39e7-b545-d61eb00f5356",
                        "glosses": [
                            "rekensom, raadsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "468a49c9-e62d-4f53-a4ea-93d0b68119a9",
                                "sense_id": "9848c0fa-33b8-3d09-aab0-9e102101f90e",
                                "text": "De opgaven in deze toets zijn meerkeuzevragen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a05c8b7-21f1-33c3-84ca-219947cea325",
                        "entry_id": "83647982-136e-39e7-b545-d61eb00f5356",
                        "glosses": [
                            "een moeilijke klus, onderneming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414204e5-4bd2-4c88-a14c-0d400a2bb402",
                                "sense_id": "7a05c8b7-21f1-33c3-84ca-219947cea325",
                                "text": "Het winnen van deze wedstrijd zal een schier onmogelijke opgave zijn."
                            },
                            {
                                "example_id": "6d1985b1-2da8-49ad-98e2-1ea26baef2d0",
                                "sense_id": "7a05c8b7-21f1-33c3-84ca-219947cea325",
                                "text": "Dat is geen gemakkelijke opgave, zegt gedragswetenschapper Merkelbach. \"Verandering leidt altijd tot weerstand.\" Zeker bij ingesleten gewoontes zijn veranderingen volgens haar lastig, en fietsen zonder helm is voor Nederlanders doodnormaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ab2e6de-3392-380a-ba1f-4cea3a5f6c44",
                        "entry_id": "83647982-136e-39e7-b545-d61eb00f5356",
                        "glosses": [
                            "het opgeven (van de strijd)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51dbda2e-4cfb-40b2-bf3b-9b7207ffbb60",
                                "sense_id": "3ab2e6de-3392-380a-ba1f-4cea3a5f6c44",
                                "text": "Na de opgave van zijn tegenstander ging de tennisser automatisch door in het toernooi."
                            }
                        ]
                    },
                    {
                        "sense_id": "94d9640d-596a-3fde-a267-661d7ec6b1b3",
                        "entry_id": "83647982-136e-39e7-b545-d61eb00f5356",
                        "glosses": [
                            "een document dat financiële activiteiten samenvat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d5ff785-00b4-4b1b-aa16-894172b8afe2",
                                "sense_id": "94d9640d-596a-3fde-a267-661d7ec6b1b3",
                                "text": "Ik heb een opgave ontvangen van mijn betaalde premies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "742763cf-55dd-41e1-8537-a41759e73684",
                        "source_entry_id": "83647982-136e-39e7-b545-d61eb00f5356",
                        "target_lang_word": "Aufgabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufgabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b892546-f98a-35ff-8987-fe60e775cf18",
                                        "entry_id": "db267e7d-60fb-33fc-9ebd-4b1d6041b383",
                                        "glosses": [
                                            "etwas, das zu erledigen ist; Arbeitsauftrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee271078-c002-40f5-ade6-5e0b5dfe8f72",
                                                "sense_id": "9b892546-f98a-35ff-8987-fe60e775cf18",
                                                "text": "„Beim Motorfliegen kommt es im Gegensatz zum Segelfliegen mehr darauf an, fliegerische, navigatorische und technische Aufgaben zu meistern.“"
                                            },
                                            {
                                                "example_id": "51e42924-b892-499a-9087-fefa80e153ce",
                                                "sense_id": "9b892546-f98a-35ff-8987-fe60e775cf18",
                                                "text": "Meine vordringlichste Aufgabe ist es jetzt, mich um die Kinder zu kümmern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81b17cd2-f684-3b87-a2e2-37ee6f013b06",
                                        "entry_id": "db267e7d-60fb-33fc-9ebd-4b1d6041b383",
                                        "glosses": [
                                            "willentliches oder erzwungenes Beenden eines Vorhabens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a287ffcd-8a78-4cf1-8e51-6d2b6a2e9508",
                                                "sense_id": "81b17cd2-f684-3b87-a2e2-37ee6f013b06",
                                                "text": "Ein Bänderriss zwang ihn zur Aufgabe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dde1eed5-3554-31d1-aa10-a3e1e99ea0b7",
                                        "entry_id": "db267e7d-60fb-33fc-9ebd-4b1d6041b383",
                                        "glosses": [
                                            "Abgabe von Gepäck, Transportgut oder Poststücken zu deren Beförderung oder Aufbewahrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "873325ff-f0d3-43bb-878a-44c12e304178",
                                                "sense_id": "dde1eed5-3554-31d1-aa10-a3e1e99ea0b7",
                                                "text": "Für die Aufgabe einer Büchersendung muss ich heute noch zur Post."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "72596639-d3df-3ea2-8254-db60007f7be7",
                                        "entry_id": "db267e7d-60fb-33fc-9ebd-4b1d6041b383",
                                        "glosses": [
                                            "eine Sachmaterie, für die ein Träger der öffentlichen Verwaltung kraft Gesetzes fachlich zuständig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f232365d-9edd-4500-b510-1ff052832f18",
                                                "sense_id": "72596639-d3df-3ea2-8254-db60007f7be7",
                                                "text": "Die Gefahrenabwehr ist eine Aufgabe, die der Polizei gesetzlich zugewiesen worden ist."
                                            }
