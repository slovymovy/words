                                                "sense_id": "669fa4eb-63c8-372b-b951-7ddca27370c5",
                                                "text": "you can't fight city hall"
                                            },
                                            {
                                                "example_id": "5efaed5d-ce0f-4a00-90d2-bfa1ead2fd5a",
