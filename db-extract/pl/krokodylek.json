                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "05aa320f-3c1a-3c1f-b45a-fdf9bb2f236a",
                        "entry_id": "d1e9d14b-133e-3988-af59-5d8494d058bc",
                        "glosses": [
                            "rodzaj zakończenia przewodu (zacisku) w postaci dwóch dociskających się ramion, umożliwiającego wygodne łączenie obwodów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb4beca3-18a7-4f1d-8871-2d7c33ea7074",
                                "sense_id": "05aa320f-3c1a-3c1f-b45a-fdf9bb2f236a",
                                "text": "(Czy ty) masz może przewody do akumulatora zakończone krokodylkami?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
