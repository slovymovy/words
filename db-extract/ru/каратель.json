                        "glosses": [
                            "устар. тот, кто карает, наказывает кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b76e919e-4344-4389-b583-70f320127128",
                                "sense_id": "8eeb4217-4658-3705-8694-d4d77adbe3e1",
                                "text": "Царь, ты заступник бедных, покровитель добрых и гневный каратель злых."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1efb3e4-f0db-325c-ac83-a606f727a764",
