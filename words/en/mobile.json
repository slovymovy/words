{
    "word_family": [
        "mobility",
        "mobilize",
        "mobilization",
        "immobile",
        "immobilize",
        "demobilize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "700fdc52-c576-35a5-be2c-71afe3a49d8a",
                    "sense_definition": "Relating to or operating via mobile phones and wireless technology.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "telephony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy a new <w>mobile</w> phone soon.",
                            "target_lang_translations": {
                                "ru": "Мне нужно скоро купить новый <w>мобильный</w> телефон.",
                                "zh": "我很快需要买一部新的<w>移动</w>电话。"
                            }
                        },
                        {
                            "text": "Most people use <w>mobile</w> apps for banking these days.",
                            "target_lang_translations": {
                                "ru": "В наши дни большинство людей используют <w>мобильные</w> приложения для банковских операций.",
                                "zh": "如今大多数人使用<w>移动</w>应用程序进行银行业务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cellular",
                        "wireless",
                        "cell"
                    ],
                    "common_phrases": [
                        "mobile phone",
                        "mobile app",
                        "mobile device",
                        "mobile network",
                        "mobile data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к мобильным телефонам, сотовой связи и беспроводным технологиям.",
                        "zh": "与移动电话、蜂窝网络或无线技术相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мобильный",
                                "target_lang_sense_clarification": "относящийся к сотовой связи"
                            },
                            {
                                "target_lang_word": "сотовый",
                                "target_lang_sense_clarification": "о телефоне или сети"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "移动",
                                "target_lang_sense_clarification": "指代移动通信技术"
                            },
                            {
                                "target_lang_word": "蜂窝",
                                "target_lang_sense_clarification": "指代移动网络类型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a3ab133-adb1-3c5d-8215-734bf5033b12",
                    "sense_definition": "Able to move or be moved freely or easily from place to place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library has a <w>mobile</w> unit that visits rural villages.",
                            "target_lang_translations": {
                                "ru": "У библиотеки есть <w>передвижное</w> отделение, которое посещает сельские деревни.",
                                "zh": "图书馆有一辆<w>流动</w>图书车，会去乡村巡回服务。"
                            }
                        },
                        {
                            "text": "They decided to buy a <w>mobile</w> home to travel around the country.",
                            "target_lang_translations": {
                                "ru": "Они решили купить <w>мобильный</w> дом, чтобы путешествовать по стране.",
                                "zh": "他们决定买一辆<w>移动式</w>房车去全国旅行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "movable",
                        "portable",
                        "transportable"
                    ],
                    "antonyms": [
                        "fixed",
                        "immobile",
                        "stationary",
                        "immovable"
                    ],
                    "common_phrases": [
                        "mobile home",
                        "mobile library",
                        "mobile hospital",
                        "upwardly mobile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный свободно двигаться или перемещаться с места на место; не стационарный.",
                        "zh": "能够自由或轻松地从一处移动到另一处的；非固定的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передвижной",
                                "target_lang_sense_clarification": "о библиотеках, госпиталях, домах"
                            },
                            {
                                "target_lang_word": "мобильный",
                                "target_lang_sense_clarification": "способный к быстрому перемещению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "移动式",
                                "target_lang_sense_clarification": "指设备或设施可移动"
                            },
                            {
                                "target_lang_word": "流动",
                                "target_lang_sense_clarification": "指服务或机构可移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1066c0eb-132c-38f7-a483-7f17bf03607a",
                    "sense_definition": "Changing quickly in appearance or expression, usually describing facial features.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>mobile</w> features revealed his surprise before he could speak.",
                            "target_lang_translations": {
                                "ru": "Его <w>подвижные</w> черты лица выдали удивление, прежде чем он успел заговорить.",
                                "zh": "他那<w>生动</w>的面部表情在他开口前就流露出了惊讶。"
                            }
                        },
                        {
                            "text": "She has a very <w>mobile</w> face that displays every emotion she feels.",
                            "target_lang_translations": {
                                "ru": "У нее очень <w>подвижное</w> лицо, на котором отражается каждая эмоция.",
                                "zh": "她有一张非常<w>灵动</w>的脸，能表现出她感受到的每一种情绪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expressive",
                        "changeable"
                    ],
                    "common_phrases": [
                        "mobile face",
                        "mobile features"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро меняющийся в выражении (обычно о чертах лица или мимике).",
                        "zh": "指面部表情或特征变化迅速且生动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвижный",
                                "target_lang_sense_clarification": "о лице или мимике"
                            },
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "выразительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生动",
                                "target_lang_sense_clarification": "形容表情丰富"
                            },
                            {
                                "target_lang_word": "灵动",
                                "target_lang_sense_clarification": "形容面部特征变化快"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25d25084-34b3-3666-87fb-2210c0385baa",
                    "sense_definition": "A portable telephone that connects to a wireless network.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "telephony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please switch off your <w>mobile</w> during the meeting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выключите свой <w>мобильный</w> во время встречи.",
                                "zh": "开会期间请关掉您的<w>手机</w>。"
                            }
                        },
                        {
                            "text": "I left my <w>mobile</w> at home and cannot call anyone.",
                            "target_lang_translations": {
                                "ru": "Я оставил свой <w>мобильник</w> дома и не могу никому позвонить.",
                                "zh": "我把<w>手机</w>落在家里了，没法给任何人打电话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cell phone",
                        "cell",
                        "smartphone"
                    ],
                    "common_phrases": [
                        "on my mobile",
                        "lost my mobile"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for mobile phone"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Портативный телефон, который подключается к беспроводной сотовой сети.",
                        "zh": "一种连接到无线网络的便携式电话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мобильный телефон",
                                "target_lang_sense_clarification": "полное название устройства"
                            },
                            {
                                "target_lang_word": "мобильник",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "сотовый",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手机",
                                "target_lang_sense_clarification": "移动电话的通用称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ac43a6d-e48f-3297-ab33-088ca32375f7",
                    "sense_definition": "A decorative structure or sculpture with hanging parts that move freely in the air.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby stared happily at the colorful <w>mobile</w> above the crib.",
                            "target_lang_translations": {
                                "ru": "Ребенок радостно смотрел на разноцветный <w>мобиль</w> над кроваткой.",
                                "zh": "婴儿开心地盯着婴儿床上方色彩鲜艳的<w>悬挂装饰</w>。"
                            }
                        },
                        {
                            "text": "He created a delicate <w>mobile</w> using paper birds and wire.",
                            "target_lang_translations": {
                                "ru": "Он создал изящный <w>мобиль</w> из бумажных птиц и проволоки.",
                                "zh": "他用纸鸟和金属丝制作了一个精致的<w>动态悬挂装饰</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "stabile"
                    ],
                    "common_phrases": [
                        "hanging mobile",
                        "crib mobile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративная подвесная конструкция, части которой свободно движутся в воздухе.",
                        "zh": "一种装饰性结构或雕塑，其悬挂部件可在空气中自由移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мобиль",
                                "target_lang_sense_clarification": "украшение или игрушка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风铃装饰",
                                "target_lang_sense_clarification": "指悬挂的动态艺术品"
                            },
                            {
                                "target_lang_word": "动态悬挂装饰",
                                "target_lang_sense_clarification": "指艺术装置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ecda1294-af0b-3e59-b9aa-c5c6a91cb886",
                    "sense_definition": "A city in southwestern Alabama, USA.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They traveled to <w>Mobile</w> to attend the annual festival.",
                            "target_lang_translations": {
                                "ru": "Они поехали в <w>Мобил</w>, чтобы посетить ежегодный фестиваль.",
                                "zh": "他们前往<w>莫比尔</w>参加年度节日。"
                            }
                        },
                        {
                            "text": "The port of <w>Mobile</w> is an important trade hub for the region.",
                            "target_lang_translations": {
                                "ru": "Порт <w>Мобила</w> является важным торговым узлом региона.",
                                "zh": "<w>莫比尔</w>港是该地区重要的贸易枢纽。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город на юго-западе штата Алабама, США.",
                        "zh": "美国阿拉巴马州西南部的一个城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мобил",
                                "target_lang_sense_clarification": "город"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莫比尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}