                        "form": "den Hausbau"
                    },
                    {
                        "form_id": "c019e394-35af-4239-babe-fe3d5dd28632",
                        "entry_id": "aa0df8c0-06f9-37e6-ab31-e4daf2db2c1a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hausbauten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c05388d1-b68c-3ff4-aa52-d8e8029fc529",
                        "entry_id": "aa0df8c0-06f9-37e6-ab31-e4daf2db2c1a",
                        "glosses": [
                            "Errichtung eines Gebäudes"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "901067b2-e8a4-40dd-ab6e-073a1648e3be",
                                "sense_id": "c05388d1-b68c-3ff4-aa52-d8e8029fc529",
                                "text": "„Ein Hausbau soll immer für alle Beteiligten Glück bringen.“"
                            },
                            {
                                "example_id": "167a46af-1615-46a5-ad45-bcd309777f31",
                                "sense_id": "c05388d1-b68c-3ff4-aa52-d8e8029fc529",
                                "text": "„Bauherren, die ihren Hausbau in einem Bautagebuch dokumentieren, sollten gerade in der Übergangszeit stets auch die Außenluft- und die Raumlufttemperaturen sowie die relative Luftfeuchte innen mit dokumentieren, rät der Verband.“"
                            },
                            {
                                "example_id": "04ea019a-60b3-4156-8043-ca21b18946d5",
                                "sense_id": "c05388d1-b68c-3ff4-aa52-d8e8029fc529",
                                "text": "„Die Fenster sind sowohl beim Hausbau als auch bei Renovierungen immer ein großer Kostenfaktor.“"
                            },
                            {
                                "example_id": "2f67c3a0-023a-409c-bfb6-704770f00cb3",
                                "sense_id": "c05388d1-b68c-3ff4-aa52-d8e8029fc529",
                                "text": "„Die neuen Errungenschaften betreffen zum Beispiel den Hausbau, denn die Germanen übernahmen von den Römern nach und nach die Technik der festen Steinmauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7849cc5c-e1d5-3c50-a0a2-36ceda336f1d",
                        "entry_id": "aa0df8c0-06f9-37e6-ab31-e4daf2db2c1a",
                        "glosses": [
                            "das errichtete Gebäude"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cfc9a1eb-df87-4110-9919-cbaf32e044f1",
                                "sense_id": "7849cc5c-e1d5-3c50-a0a2-36ceda336f1d",
                                "text": "In Afrika sind viele Hausbauten rund."
                            },
                            {
                                "example_id": "78d31dbc-de4a-41e9-97e9-8d442c3763ad",
                                "sense_id": "7849cc5c-e1d5-3c50-a0a2-36ceda336f1d",
                                "text": "„Bei ihren Gesellen-Wanderschaften lernten die jungen Zimmermannsleute etliche neue Stilrichtungen in Deutschland, aber auch an vielen anderen Plätzen in Europa kennen, was die Vielfalt der Hausbauten bis heute reichlich dokumentiert.“"
                            },
                            {
                                "example_id": "d8e83065-8a2a-4681-ab07-411732c4e900",
                                "sense_id": "7849cc5c-e1d5-3c50-a0a2-36ceda336f1d",
                                "text": "„Ich hatte immer mehr als genug zu tun mit Abbildungen von Pferden und Kanonen, Pflanzen und Tieren, Handwerkern und ihren Hausbauten, Bauern auf dem Feld und im Stall.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
