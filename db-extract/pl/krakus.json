                        "entry_id": "7380853f-b209-3635-b11e-368143c1576d",
                        "glosses": [
                            "żołnierz lekkiej kawalerii polskiej z okresu Księstwa Warszawskiego i powstania listopadowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea24c697-775a-4bf2-8d9c-b113eb5b416d",
                                "sense_id": "d0710f54-01af-399f-9b7a-36d0916b15ab",
                                "text": "Co za śmiałość, co za siła, / Zazdrość widzieć tych wiarusów; / Gdybym chłopcem się rodziła, / Tobym poszła do Krakusów,"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
