                                    {
                                        "sense_id": "029e8771-3728-39dc-b88d-f1646e9bd567",
                                        "entry_id": "7aff1ebc-b264-3c27-b4c4-cb9de3f74ba1",
                                        "glosses": [
                                            "forma żeńska od: mediewista"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ee1ff57-97fb-4737-9add-5f1620254bde",
                                                "sense_id": "029e8771-3728-39dc-b88d-f1646e9bd567",
                                                "text": "Basia interesowała się historią starożytną, ale w końcu została mediewistką."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "695c7fcf-6785-4a9f-88b6-b94820e10b18",
                        "source_entry_id": "5d7a8f0f-6d35-3cb6-ae32-f5e959924494",
                        "source_sense_id": "57a4ef7b-10e7-3554-911d-c2e48b9f3e70",
                        "target_lang_word": "médiéviste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médiéviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                                        "entry_id": "5dd95740-6980-38cb-863d-d604cc40da19",
                                        "glosses": [
                                            "(Historiographie) Celui, celle qui se consacre à l'étude du Moyen Âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddfa2641-d255-4a48-a17b-e26d3f23b596",
                                                "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                                                "text": "C’est le plus savant des médiévistes actuels."
                                            },
                                            {
                                                "example_id": "f915a4e1-828c-41bc-bc51-fb90fb0d7f09",
                                                "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                                                "text": "Pour le médiéviste, le mot d’ordre était pourtant simple : il ne s’agissait concrètement de rien d’autre que de faire une histoire de la raison réfléchissant sur la foi dans la théologie."
                                            },
                                            {
                                                "example_id": "aa1e5dfe-35b3-4537-ad70-f5e600083060",
                                                "sense_id": "fba58a0a-9123-3c27-9a93-946a9041116a",
                                                "text": "Voilà ce que démontre scientifiquement un rapport historique commandé en 1988 par Jordi Pujol, l’antéprédecesseur de Puigdement, à cinq médiévistes barcelonais sur le « processus d’indépendance de la Catalogne »…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
