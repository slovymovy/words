                        "entry_id": "d0065dc9-0b10-3aff-814b-7eb47d0cfa91",
                        "glosses": [
                            "Causing a bitter taste or smell."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "377cbad0-3a9a-4367-ba0f-bbd6600c57cc",
                                "sense_id": "0662c824-107c-32d1-82b5-8ff506196c40",
                                "text": "The Consumer Product Safety Commission also questions the effectiveness of the bittering agent and wrote that there is no evidence that DB or any other possible adversive agent is actually effective at limiting the ingestion of consumer products ."
                            },
                            {
                                "example_id": "c723f2b2-9e7f-4d70-849b-467db03ec87d",
                                "sense_id": "0662c824-107c-32d1-82b5-8ff506196c40",
                                "text": "Centennial is an aroma-type cultivar that is used for its aromatic properties and bittering potential ."
                            },
                            {
                                "example_id": "43d123e8-5f0b-4684-be6f-8b9fa2a22fda",
                                "sense_id": "0662c824-107c-32d1-82b5-8ff506196c40",
                                "text": "a bittering agent in antifreeze"
                            }
                        ]
                    }
                ],
