                                        "sense_id": "7ccc84d0-7ff9-3e1d-9315-1085e53d1038",
                                        "entry_id": "083851e6-f4e1-3f4b-bdec-e442cc34ea52",
                                        "glosses": [
                                            "Obsolete form of griping (“pinching and spasmodic pain in the intestines”)."
                                        ],
                                        "tags": [
