                        "cross_references": [
                            {
                                "target_word": "généticien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                                        "entry_id": "3ac7391b-9d64-3f85-b1c0-4701e70c943a",
                                        "glosses": [
                                            "Scientifique qui étudie les gènes, spécialiste de la génétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b2dbe4-ac85-4aee-a129-60ea77d94e61",
                                                "sense_id": "7c40bba7-d786-3102-9c1f-ba1eb8c27a56",
                                                "text": "Et, les consultants viennent parfois rencontrer le généticien comme celui qui va tout expliquer, tout résoudre de façon magique, un peu comme un Dieu, une position bien difficile pour ce médecin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15a59453-891f-40de-b8da-d1b404e6a371",
                        "source_entry_id": "1a1cfe54-2887-3fa7-b3cd-6f6422678aeb",
                        "source_sense_id": "2d552452-da7a-31e8-a08b-9175911bfa35",
                        "target_lang_word": "genetista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genetista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7b719f46-80da-3194-b7b7-1c9dc1e8d4ed",
