                        "entry_id": "e01a697d-57d5-34c9-9741-97d5080860c2",
                        "glosses": [
                            "Teil des Mittelmeeres zwischen Balkanhalbinsel und Kleinasien, der mit dem Schwarzen Meer durch den Bosporus verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e7e160a-8357-42b1-a9fc-f597764a21a3",
                                "sense_id": "77699e20-ba7b-3004-a9f7-18405361b35d",
                                "text": "Die Ägäis ist ein Nebenmeer des Mittelmeers."
                            },
                            {
                                "example_id": "055868d2-c0e1-4da9-9903-9e2f968c2927",
                                "sense_id": "77699e20-ba7b-3004-a9f7-18405361b35d",
                                "text": "Unseren letzten Urlaub verbrachten wir an der Ägäis."
                            },
                            {
                                "example_id": "4ff79cae-35f5-4d18-9e45-d42b71f89848",
                                "sense_id": "77699e20-ba7b-3004-a9f7-18405361b35d",
                                "text": "Das Lagerfeuer an der Ägäis erlosch erst am frühen Morgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
