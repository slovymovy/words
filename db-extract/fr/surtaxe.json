                ],
                "senses": [
                    {
                        "sense_id": "ae905a02-6c2c-320b-aa66-dee65602495a",
                        "entry_id": "de420e59-c292-3937-a1b8-41e5fd1f8dfb",
                        "glosses": [
                            "Ce qu’on ajoute en surcroît à une taxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "569208d8-1be0-426a-859e-22a2125db9f6",
                                "sense_id": "ae905a02-6c2c-320b-aa66-dee65602495a",
                                "text": "Une surtaxe de consommation est perçue sur les « produits de luxe » depuis 1986; sur les importations, la surtaxe est ad valorem et comporte huit taux compris entre 5 % et 70 %. La surtaxe frappe aussi les produits fabriqués localement."
                            },
                            {
                                "example_id": "0d8b2507-9bce-4d49-877a-4cec49db89e1",
                                "sense_id": "ae905a02-6c2c-320b-aa66-dee65602495a",
                                "text": "Dans la « guerre de l’acier » — comme « Le Figaro » (9/3) désigne l’offensive protectionniste de Trump —, on ne connaît pas toujours pays par pays le montant des surtaxes douanières qui seront appliquées par les États-Unis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f23f4065-a9be-3eb0-9f82-9c04ef514e54",
                        "entry_id": "de420e59-c292-3937-a1b8-41e5fd1f8dfb",
                        "glosses": [
                            "Taxe excessive et illégale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc7f9c0-d013-4fa5-93e5-eaa8b491bd2a",
                                "sense_id": "f23f4065-a9be-3eb0-9f82-9c04ef514e54",
                                "text": "Je me ferai décharger de cette surtaxe."
                            }
                        ]
                    },
                    {
                        "sense_id": "53f8c456-457c-36be-8a72-2d3b88cfa33e",
                        "entry_id": "de420e59-c292-3937-a1b8-41e5fd1f8dfb",
                        "glosses": [
                            "Amende."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "522f9258-58ee-41d3-ae70-79c4189a89ce",
                        "source_entry_id": "de420e59-c292-3937-a1b8-41e5fd1f8dfb",
                        "target_lang_word": "Nachporto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachporto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e427110-1996-3a02-ac42-41e23aace62d",
                                        "entry_id": "c8691fbb-cfb8-3279-a162-ada6d8f12dfc",
                                        "glosses": [
                                            "Gebühr, die vom Empfänger gezahlt werden muss, wenn Postgut nicht ausreichend frankiert wurde"
                                        ],
                                        "tags": [
                                            "Postwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cb39452-0082-42be-aca6-e5e728349ecc",
                                                "sense_id": "7e427110-1996-3a02-ac42-41e23aace62d",
                                                "text": "„Auf einem anderen, unfreien, mit Nachporto belegten Eilbrief von Stuttgart nach Straßburg finden wir auf der Rückseite nicht nur den Ankunftstempel von Straßburg, sondern auch den daneben abgeschlagenen, individuellen Stempel des Zustellers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55b71a9c-7736-4cc8-836f-0d0282bef02b",
                        "source_entry_id": "de420e59-c292-3937-a1b8-41e5fd1f8dfb",
                        "target_lang_word": "Strafporto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strafporto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "939dabdf-6bbe-3749-8037-f12f6e4a47aa",
                                        "entry_id": "b45878ca-976b-3438-9514-e3aa00e475dd",
                                        "glosses": [
                                            "Gebühr, die vom Empfänger gezahlt werden muss, wenn Postgut nicht ausreichend frankiert wurde"
                                        ],
                                        "tags": [
                                            "Postwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd03595-cb3e-47dc-889d-d7873d90ac07",
                                                "sense_id": "939dabdf-6bbe-3749-8037-f12f6e4a47aa",
                                                "text": "„Üblich war es bei der Reichspost jedoch, dass bei fehlendem Eilporto das 1,5-fache des fehlenden Portos als Nachgebühr oder genauer als Strafporto erhoben wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fdbd816-5836-4dd2-b2b5-37acfa0ada24",
                        "source_entry_id": "de420e59-c292-3937-a1b8-41e5fd1f8dfb",
                        "target_lang_word": "Zuschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "(erhöhtes) Entgelt, das man für Sonderleistungen oder in bestimmten Situationen bezahlen muss oder bekommt"
                                        ],
                                        "tags": [
                                            "Finanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ab3769-b15b-4be9-888b-32857597d6df",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der Zuschlag durch erhöhte Transportkosten wird laufend angepasst."
                                            },
                                            {
                                                "example_id": "9cf9d8ca-1d97-44fc-a97a-2010d8181340",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der Zuschlag für die Schnellzugverbindung kann auch beim Schaffner gelöst werden."
                                            },
                                            {
                                                "example_id": "65a17a1c-1780-4fba-985f-b252e478b9aa",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der inoffizielle und illegale Zuschlag für Touristen beträgt mindestens 20 %."
                                            },
                                            {
                                                "example_id": "06f82a97-5a03-421a-a003-a9699e1fd300",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Die Zuschläge zum Arbeitslohn für Sonntags-, Feiertags- und Nachtarbeit bewegen sich zwischen 25 und 190 % und sind zusätzlich sozialversicherungsfrei und steuerfrei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "Auftragserteilung, Geschäftsabschluss, Versteigerungsentscheidung (traditionell bzw. meist durch einen Schlag besiegelt)"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46db6166-f5cd-4593-bbd3-947670495cd0",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "Bei der Versteigerung erhielt ein telefonisches Angebot den Zuschlag."
                                            },
                                            {
                                                "example_id": "02e81db3-090c-432b-a24f-50b068efe20e",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "Nachdem Istanbul den Zuschlag erhalten hatte, hat Serhan Ada bei der Gestaltung des Kulturhauptstadt-Programmes mitgearbeitet."
                                            },
                                            {
                                                "example_id": "edcad24d-130c-4717-a142-7ac410d116f9",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "„Die Bundesnetzagentur hat den Zuschlag für den Bau von 79 neuen Windrädern erteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "Zusätze bei Mischungen wie Legierungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b321258-316d-4606-af1a-aa80f9e48c62",
                                                "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                                "text": "Durch Zuschlag von Mangan soll Stahl widerstandsfähiger gemacht werden."
                                            },
                                            {
                                                "example_id": "d664f3b7-48f5-4370-9969-3c01f4dee5c5",
                                                "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                                "text": "„Der Hochofen wird abwechselnd mit Koks und dem Gemisch aus Eisenerz und Zuschlägen, dem Möller, beschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
