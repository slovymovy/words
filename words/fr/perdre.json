{
    "word_family": [
        "perte",
        "perdition",
        "reperdre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17c0dcc1-4464-348b-b7d6-bd98103a7e04",
                    "sense_definition": "Égarer un objet, ne plus savoir où il se trouve.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "egarer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai encore <w>perdu</w> mes clés de voiture ce matin dans le salon."
                        },
                        {
                            "text": "Fais attention à ne pas <w>perdre</w> tes papiers pendant le voyage."
                        }
                    ],
                    "synonyms": [
                        "égarer"
                    ],
                    "antonyms": [
                        "trouver"
                    ],
                    "common_phrases": [
                        "perdre ses clés",
                        "perdre ses papiers"
                    ]
                },
                {
                    "sense_id": "8ac61b1f-b7f8-3c06-9600-13618ba3d20a",
                    "sense_definition": "Ne pas remporter la victoire dans un jeu, un match ou une compétition.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "defaite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe ne veut pas <w>perdre</w> ce match important ce soir."
                        },
                        {
                            "text": "Si tu continues à jouer ainsi, tu vas <w>perdre</w> la partie."
                        }
                    ],
                    "antonyms": [
                        "gagner"
                    ],
                    "common_phrases": [
                        "perdre un match",
                        "perdre la partie"
                    ]
                },
                {
                    "sense_id": "9ea9a9a1-3fca-3ef2-a2fa-a5e02e1fbb8d",
                    "sense_definition": "Faire un mauvais usage de quelque chose, gaspiller son temps ou ses ressources.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gaspiller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous ne devons plus <w>perdre</w> de temps avec ces discussions inutiles."
                        },
                        {
                            "text": "Le professeur commence à <w>perdre</w> patience devant le bruit des élèves."
                        }
                    ],
                    "common_phrases": [
                        "perdre son temps",
                        "perdre patience"
                    ]
                },
                {
                    "sense_id": "cd32c7e5-c11a-3113-a2b5-318796c8dec5",
                    "sense_definition": "Être séparé d'un proche ou d'une personne chère par la mort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deuil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>perdu</w> son grand-père l'année dernière après une longue maladie."
                        },
                        {
                            "text": "Il est difficile de surmonter la douleur quand on vient de <w>perdre</w> un ami."
                        }
                    ],
                    "common_phrases": [
                        "perdre un proche"
                    ]
                },
                {
                    "sense_id": "e28245ad-7a2a-3c32-a6d6-f0510c123cfd",
                    "sense_definition": "Subir la disparition ou la diminution d'une faculté physique, morale ou d'un état.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "faculte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme commence à <w>perdre</w> la mémoire avec l'âge."
                        },
                        {
                            "text": "Le blessé a failli <w>perdre</w> connaissance après le choc violent."
                        }
                    ],
                    "common_phrases": [
                        "perdre la mémoire",
                        "perdre connaissance",
                        "perdre courage"
                    ]
                }
            ]
        }
    ]
}