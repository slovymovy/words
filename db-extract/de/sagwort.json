                "senses": [
                    {
                        "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                        "entry_id": "e89a4ef7-bac2-34cd-9822-979d8ae76b55",
                        "glosses": [
                            "Phraseologismus, bei dem die Aussage einem Sprecher mit einer Wendung wie „sagte er/sie\\\" zugewiesen wird“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86cc1d2c-cdb8-4a47-9ab7-c1eb6b2eceaa",
                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                "text": "„Jünger als das Sprichwort und auch heute noch in immer neuen Beispielen auftretend, ist das sogenannte Sagwort, auch ‚Wellerismus‘ (so nach der Figur Samuel Weller in Charles Dickens' ‚Pickwick Papers‘).“"
                            },
                            {
                                "example_id": "88f144df-7a21-44d9-94a4-7b1ae1945f55",
                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                "text": "Spalding zitiert ein bekanntes Sagwort: „Wo man singt, da laß dich ruhig nieder, sagte der Teufel, und setzte sich auf einen Bienenschwarm.“"
                            },
                            {
                                "example_id": "08cebbbc-5cb3-49f6-954c-6aa5e224c89b",
                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                "text": "„Für Sagwörter ist der Zusammenprall zweier Konzepte konstitutiv.“"
                            },
                            {
                                "example_id": "aab5c124-09ad-4cdb-bb25-f6ca3a3f38a1",
                                "sense_id": "169e1469-ee0f-3a63-a9b5-55520e997e90",
                                "text": "„Dies geschieht auf dem Weg der Umprägung eines Sprichworts in Form des Beispielsprichworts oder Sagworts (Wellerismus).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
