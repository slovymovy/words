                                    {
                                        "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                        "entry_id": "c6ea043d-8eca-39e7-8acf-1d766cf708c9",
                                        "glosses": [
                                            "das gewaltsame Wegnehmen; das Rauben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfae291c-50a4-440f-9c59-cde523acfc49",
                                                "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                                "text": "Das Museum meldete heute den Raub eines wertvolles Gemäldes."
                                            },
                                            {
                                                "example_id": "56a69c2a-1759-44c8-af90-4e00afc1cba2",
                                                "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                                "text": "Für den Raub des Maibaumes bestehen Regeln, und diese müssen genau beachtet werden."
                                            },
                                            {
                                                "example_id": "dd202ae0-360a-4bfd-b82f-f21e507e314a",
                                                "sense_id": "2f9dd3e1-2eca-3d55-a5bb-3ec9f840724a",
                                                "text": "„Unter den Rassen der westlichen Honigbiene wurde die italienische Biene mit einer besonders starken Neigung zum Raub identifiziert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab034e20-5480-307b-bee2-f03ca9505ecb",
                                        "entry_id": "c6ea043d-8eca-39e7-8acf-1d766cf708c9",
                                        "glosses": [
                                            "die Wegnahme einer fremden beweglichen Sache durch Gewalt gegen eine Person oder unter Androhung einer gegenwärtigen Gefahr für Leib und Leben mit der Absicht, die Sache sich oder einem Dritten rechtswidrig zuzueignen (§ 249 StGB in Deutschland)"
                                        ],
                                        "tags": [
                                            "Strafrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b442227d-e6ef-4ac5-aef7-c4d04c6fc47c",
                                                "sense_id": "ab034e20-5480-307b-bee2-f03ca9505ecb",
                                                "text": "Das Gericht verurteilte den Mann wegen Raubes."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                        "entry_id": "c6ea043d-8eca-39e7-8acf-1d766cf708c9",
                                        "glosses": [
                                            "das geraubte Gut, die Beute"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "713978d2-5795-4f16-bbad-9cb1f4a83920",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Dieses Vogels Raub sind Mäuse und Frösche."
                                            },
                                            {
                                                "example_id": "1e378eac-3290-4ed1-8f4a-18ee7db4bc00",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Das gesamte Anwesen wurde ein Raub der Flammen."
                                            },
                                            {
                                                "example_id": "ded66ba4-8001-452c-b767-c24898d2adcc",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Der neu angelegte, feinsandige Badestrand wurde ein Raub der Wellen."
                                            },
                                            {
                                                "example_id": "089cbca0-af2b-4a97-aa4f-d8140a20e81f",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Der Täter versteckte den Raub im Keller."
                                            },
                                            {
                                                "example_id": "3a37889a-b867-4f90-8dfb-b5111fda2ce2",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "Die Jungs teilten den Raub unter sich auf, und jeder bekam den gleichen Anteil."
                                            },
                                            {
                                                "example_id": "c9e59de5-0797-4b8a-9a6f-3ba8bb2d578d",
                                                "sense_id": "1cad0ccb-576b-3bf3-bdda-dc0d77afc7a4",
                                                "text": "„Er, der in göttlicher Gestalt war, hielt es nicht für einen Raub, Gott gleich zu sein, sondern entäußerte sich selbst und nahm Knechtsgestalt an, ward den Menschen gleich und der Erscheinung nach als Mensch erkannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
