                "senses": [
                    {
                        "sense_id": "10a9581f-08a8-3e8e-8e4a-a3141bf4b3e8",
                        "entry_id": "3b942716-33e9-3985-a552-bc03e7df848c",
                        "glosses": [
                            "aspirierter [Verschluss]laut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fff43cca-7b28-4377-b293-50c65d601e8d",
                                "sense_id": "10a9581f-08a8-3e8e-8e4a-a3141bf4b3e8",
                                "text": "„Dem ausgeprägten System der indogermanischen Verschlußlaute steht ein sehr schwach ausgeformtes der Spiranten gegenüber: nur s und, an die Stellung vor indogermanischen Media und Media aspirata gebunden, seine stimmhafte Entsprechung z sind vorhanden.“"
                            },
                            {
                                "example_id": "da051e55-c4bc-4299-833e-cef4591c38a9",
                                "sense_id": "10a9581f-08a8-3e8e-8e4a-a3141bf4b3e8",
                                "text": "„Daher finden wir in vielen Grammatiken noch die Bezeichnungen Tenues für die stimmlosen und Mediae für die stimmhaften unbehauchten Verschlußlaute, während man die behauchten (…) Aspiratae nennt.“"
                            },
                            {
                                "example_id": "a107adf6-47cc-4e3d-8c10-024e365f9dc1",
                                "sense_id": "10a9581f-08a8-3e8e-8e4a-a3141bf4b3e8",
                                "text": "„Im Abchasischen ist die Wiedergabe der Aspiraten und Ejektive äußerst inkonsistent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
