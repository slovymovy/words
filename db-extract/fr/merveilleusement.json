                        ]
                    },
                    {
                        "translation_id": "46e3160b-c74a-46f4-964d-9db92c287ac6",
                        "source_entry_id": "7c0da8dc-487b-3a51-9f3a-f89c38cdf889",
                        "source_sense_id": "2764d67f-2dc5-331e-aa5b-e59175ee205c",
                        "target_lang_word": "verwonderlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwonderlijk",
