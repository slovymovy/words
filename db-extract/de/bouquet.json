                ],
                "senses": [
                    {
                        "sense_id": "2a3d39c7-8372-3d7e-8790-73dfba85e790",
                        "entry_id": "607a6b09-d7bd-3748-9e06-2f671134e862",
                        "glosses": [
                            "bouquet (a bunch of flowers, or rarely an assortment of other ornaments)"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "09a49fdf-f163-4d5a-b415-da1d6a5f2eb3",
                                "sense_id": "2a3d39c7-8372-3d7e-8790-73dfba85e790",
                                "text": "Sie hielt ein Bouquet von Alpenblümlein in der schneeigen Hand und grüßte mich mit der Natürlichkeit eines Kindes durch eine trauliche Handbewegung und Kopfnicken, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "59a578c0-ee28-3ef8-8b89-983d4fb9f45d",
                        "entry_id": "607a6b09-d7bd-3748-9e06-2f671134e862",
                        "glosses": [
                            "bouquet (heart note of a perfume, scent of a particular wine)"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e9b11f3c-5519-4ab1-89b6-97fd242fa73a",
                                "sense_id": "59a578c0-ee28-3ef8-8b89-983d4fb9f45d",
                                "text": "Nur wenige Traubenarten haben ein starkes Bouquet, das sich schon dem Most mittheilt. Bei den meisten bildet sich dasselbe erst durch die Gährung oder wird wesentlich verändert oft selbst zerstört."
                            }
                        ]
                    }
                ],
