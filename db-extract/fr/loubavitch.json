                                        "sense_id": "3489aac8-0dfc-3a26-a541-934cc3bf39f1",
                                        "entry_id": "939f8870-5edb-36f5-b7f5-23867c327f18",
                                        "glosses": [
                                            "Of or relating to the Chabad movement in Judaism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878f6b9f-51f7-49a1-87e9-f62097c064d8",
                                                "sense_id": "3489aac8-0dfc-3a26-a541-934cc3bf39f1",
                                                "text": "According to Hasidic lore, Rabbi Shneur Zalman of Liadi, the first Lubavitcher Rebbe, once visited the city of Shklov known for its brilliant, wise and erudite scholars."
