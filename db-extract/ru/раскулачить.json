                    },
                    {
                        "sense_id": "c2558a9e-098f-34c0-aa43-9f88247205b7",
                        "entry_id": "87e1a947-655a-38ba-b007-5fc479bb3407",
                        "glosses": [
                            "перен., разг. обокрасть"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6da71a7a-3010-30d3-9f09-a128ba617936",
                        "entry_id": "87e1a947-655a-38ba-b007-5fc479bb3407",
                        "glosses": [
                            "перен., разг. разобрать машину, механизм, сняв с них детали для использования при ремонте других машин, механизмов"
                        ],
                        "tags": [],
