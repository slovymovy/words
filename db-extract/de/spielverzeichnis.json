                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aaa9b58-891e-43f5-8919-0fd0f50cddb3",
                                "sense_id": "278ee81d-829b-397c-9ef4-b8e243294c7c",
                                "text": "„Zur besseren Orientierung wurde dem Buch ein alphabetisches Spielverzeichnis angefügt, in dem das gesuchte Spiel leicht aufgefunden werden kann.“"
                            },
                            {
                                "example_id": "614f85e4-c593-4b18-a5d7-f99016becdb5",
                                "sense_id": "278ee81d-829b-397c-9ef4-b8e243294c7c",
                                "text": "„Das Spielverzeichnis des 25. Kapitels enthält neben allgemeineren Rätselformen am Ende eine Reihe von Textstücken aus mindestens 22 Scherzfragen […].“"
                            },
                            {
                                "example_id": "64be18ff-1ffa-4805-9afd-3410d41663d3",
                                "sense_id": "278ee81d-829b-397c-9ef4-b8e243294c7c",
                                "text": "„Die Speicherstände der PC-Version sind im Spielverzeichnis zu finden.“"
                            },
                            {
                                "example_id": "2e16fada-b8a7-4781-b518-f2f6e7c8ac46",
                                "sense_id": "278ee81d-829b-397c-9ef4-b8e243294c7c",
                                "text": "„Weiterhin können auch Workshop-Externe Mods im Spielverzeichnis installiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
