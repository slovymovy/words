        "nl-extract.jsonl": [
            {
                "entry_id": "c1ecf683-9e1c-3473-863d-1e5f0acce43f",
                "word": "misleidend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2fb07d9-01f8-31c0-bc1f-c1c791640061",
                        "entry_id": "c1ecf683-9e1c-3473-863d-1e5f0acce43f",
                        "glosses": [
                            "met de uitdrukkelijke bedoeling om mensen dingen te laten geloven die niet waar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba385f95-17a6-4fa4-8049-a597f20b01ae",
                                "sense_id": "a2fb07d9-01f8-31c0-bc1f-c1c791640061",
                                "text": "Coca-Cola mag dit jaar het Gouden Windei in de prijzenkast zetten. Het bedrijf krijgt de onderscheiding voor het \"meest misleidende\" voedingsproduct met zijn \"inspired by clouds crispy smartwater\"."
                            },
                            {
                                "example_id": "5ee4c7bc-b6ff-46f4-98d4-cf441b02dbd0",
                                "sense_id": "a2fb07d9-01f8-31c0-bc1f-c1c791640061",
                                "text": "Op woensdag 20 maart zijn in Nederland Provinciale Statenverkiezingen. Eind mei volgen de verkiezingen voor het Europees Parlement. \"We moeten niet naïef zijn”, zei Ollongren eerder dit jaar over de mogelijk misleidende beïnvloeding van burgers. Veel nepnieuws en desinformatie komt uit het buitenland, bijvoorbeeld Rusland.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dec3a76c-1293-444c-8af2-d92c3bc60aab",
                        "source_entry_id": "c1ecf683-9e1c-3473-863d-1e5f0acce43f",
                        "source_sense_id": "a2fb07d9-01f8-31c0-bc1f-c1c791640061",
                        "target_lang_word": "likely to mislead",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "af1952a4-0fe7-4fa3-8f72-e6bfaa7ccecf",
                        "source_entry_id": "c1ecf683-9e1c-3473-863d-1e5f0acce43f",
                        "source_sense_id": "a2fb07d9-01f8-31c0-bc1f-c1c791640061",
                        "target_lang_word": "untruthful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "untruthful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                                        "entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                                        "glosses": [
                                            "Not giving the truth; providing untrue facts; lying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43e0718e-23b0-4bda-be56-ee5ac3311ca5",
                                                "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                                                "text": "Cousin, good night; / And whatsoe’er be told of me henceforth, / A most untruthful annalist were he, / Who said I did not love my cousin Anna."
                                            },
                                            {
                                                "example_id": "6ab55e29-3bb2-4942-9ac5-0d8173d6298e",
                                                "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                                                "text": "Upon principle it is his aim to exhibit integrity of dealing, honest and godly sincerity to all men; if he fail, it must be in degree, it cannot be in kind; for a false and untruthful mind can never rightly know God; the more we know of him, the more upright and ingenuous, and liberal, and kind, and humane, and generous, must be our conduct to man."
                                            },
                                            {
                                                "example_id": "768e310b-953b-453c-8463-8914371ab2e4",
                                                "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                                                "text": "He who obeys not the good Shepherd of the soul and heart has an untruthful mind; a mind filled with fallacies; a mind of wrong resolvings and concludings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14dfa14d-3abf-3a71-b9c6-6aa49aec1569",
                                        "entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                                        "glosses": [
                                            "Pertaining to falsehood; corrupt; dishonest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d5fe85-4f2b-4895-8b9f-a56898153abb",
                                                "sense_id": "14dfa14d-3abf-3a71-b9c6-6aa49aec1569",
                                                "text": "But what was our astonishment when the “Seven Letters by Anglicanus” made their appearance amongst us, accompanied by the report that you—one of our brethren—was the author of that untruthful, bitter, and malignant publication!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc6e91f1-a5f7-46b2-b875-2924c73895fd",
                        "source_entry_id": "c1ecf683-9e1c-3473-863d-1e5f0acce43f",
                        "source_sense_id": "a2fb07d9-01f8-31c0-bc1f-c1c791640061",
                        "target_lang_word": "misleading",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misleading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91d024b4-dcdc-325d-8bbb-115260e4d396",
                                        "entry_id": "e8d0880b-5089-3461-8895-77f79fb99e34",
                                        "glosses": [
                                            "Deceptive or tending to mislead or create a false impression, even if technically true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddea82fd-dc0d-44bb-a479-9c3a746113ab",
                                                "sense_id": "91d024b4-dcdc-325d-8bbb-115260e4d396",
                                                "text": "The problem does not appear so hopeless when misleading metaphor is discarded."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "misleading",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a9579c-7d4f-31bf-96cc-ec3b680cd3e0",
                                        "entry_id": "4bc45f1f-12aa-3fab-9ce2-1d4d1a2b3c1f",
                                        "glosses": [
                                            "present participle and gerund of mislead"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
