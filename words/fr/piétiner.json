    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ddbef17-c124-33fe-b1f4-c73cb52b45b6",
                    "sense_definition": "Frapper le sol des pieds à plusieurs reprises ou s'agiter sur place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_pieds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spectateurs attendaient dans le froid et <w>piétinaient</w> pour se réchauffer."
                        },
                        {
                            "text": "L'enfant commence à <w>piétiner</w> d'impatience en attendant son tour."
                        }
                    ],
                    "synonyms": [
                        "trépigner"
                    ],
                    "common_phrases": [
                        "piétiner sur place",
                        "piétiner d'impatience"
                    ]
                },
                {
                    "sense_id": "785cf5b7-92de-3697-b310-8f3ab453bc56",
                    "sense_definition": "Fouler ou écraser quelque chose sous ses pieds de manière répétée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fouler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faites attention à ne pas <w>piétiner</w> les fleurs dans le jardin."
                        },
                        {
                            "text": "La foule en panique a failli <w>piétiner</w> plusieurs personnes tombées par terre."
                        }
                    ],
                    "synonyms": [
                        "écraser",
                        "fouler"
                    ]
                },
                {
                    "sense_id": "0364e176-763e-389b-b55f-dc303d23a36a",
                    "sense_definition": "Ne faire aucun progrès, stagner dans le déroulement d'une action ou d'un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stagnation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enquête de police <w>piétine</w> depuis des semaines faute d'indices sérieux."
                        },
                        {
                            "text": "Les négociations internationales continuent de <w>piétiner</w> sans issue claire."
                        }
                    ],
                    "synonyms": [
                        "stagner",
                        "s'enliser"
                    ],
                    "antonyms": [
                        "progresser",
                        "avancer"
                    ]
                },
                {
                    "sense_id": "40cfc2c5-c84c-3126-9139-50c165875bcc",
                    "sense_definition": "Mépriser totalement, bafouer ou violer délibérément des principes ou des règles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fouler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce gouvernement autoritaire refuse d'écouter le peuple et <w>piétine</w> les droits fondamentaux."
                        },
                        {
                            "text": "En refusant d'admettre ses torts, il a totalement <w>piétiné</w> la confiance de ses associés."
                        }
                    ],
                    "synonyms": [
                        "bafouer",
                        "mépriser",
                        "enfreindre"
                    ],
                    "antonyms": [
                        "respecter"
                    ]
                }
            ]
        }
    ]
