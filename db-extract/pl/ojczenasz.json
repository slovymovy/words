                    {
                        "sense_id": "f7ec64f2-e6c0-3251-bf2a-67d3d71d9449",
                        "entry_id": "84559312-4cd7-3bba-be55-a448e380bb7a",
                        "glosses": [
                            "modlitwa chrześcijan zaczynająca się od słów „Ojcze nasz”"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c856f45-3880-4234-9395-e7e3448ebc5f",
                                "sense_id": "f7ec64f2-e6c0-3251-bf2a-67d3d71d9449",
                                "text": "Jako pokutę odmówiłem pięć ojczenaszów i pięć zdrowasiek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7f075b9-2cfd-42a2-ae84-e8cd6e40dafc",
                        "source_entry_id": "84559312-4cd7-3bba-be55-a448e380bb7a",
                        "source_sense_id": "f7ec64f2-e6c0-3251-bf2a-67d3d71d9449",
                        "target_lang_word": "Our Father",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Our Father",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0130cfb5-e026-3500-89c4-d7915b3b5c8a",
                                        "entry_id": "20a21293-e522-3ddb-8989-73acc3a88b62",
                                        "glosses": [
                                            "God; God the Father."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54941251-8208-3eba-a70b-b0041b6791be",
                                        "entry_id": "20a21293-e522-3ddb-8989-73acc3a88b62",
                                        "glosses": [
                                            "(Our Father) The Lord's Prayer, which begins with these words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425b5a7e-b541-4191-8d7b-324bcb6a3188",
                                                "sense_id": "54941251-8208-3eba-a70b-b0041b6791be",
                                                "text": "“What did the priest, and all of you, keep on saying when we first went in?” / “Our Fathers, Hail Maries, and Glorias; couldn’t you hear?” asked Emily, laughing."
                                            },
                                            {
                                                "example_id": "afabe488-7ab1-4c11-88c0-91523abfdef0",
                                                "sense_id": "54941251-8208-3eba-a70b-b0041b6791be",
                                                "text": "\"You are our Father as well as theirs. Permit us, for a short space, to meet in brotherhood, that we may have an added knowledge of that eternal life which awaits us, and so be helped during our years of waiting in this lower world.\" He ended with the \"Our Father\", in which we all joined."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02bfbcef-1852-4f2a-a262-41577254e532",
                        "source_entry_id": "84559312-4cd7-3bba-be55-a448e380bb7a",
                        "source_sense_id": "f7ec64f2-e6c0-3251-bf2a-67d3d71d9449",
                        "target_lang_word": "Lord's Prayer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lord's Prayer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b1e3f30-a18c-3dae-86e4-62fd55ef2eac",
                                        "entry_id": "62a44d77-f1d1-35ec-b965-c79d2fac9e8e",
                                        "glosses": [
                                            "The prayer which, according to the New Testament of the Bible, Jesus Christ taught his disciples in the Sermon on the Mount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed06c99d-ab62-4037-82ec-0534ae530159",
                                                "sense_id": "9b1e3f30-a18c-3dae-86e4-62fd55ef2eac",
                                                "text": "He sat down in the middle of the floor, took his chalk out and marked a large ring around him, and round about this he wrote the Lord's Prayer, and then he did not feel afraid even if Old Nick himself should come."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
