                    "frequency": "Low",
                    "semantic_group_id": "indecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was <w>teetering</w> on the brink of total collapse."
                        },
                        {
                            "text": "The country was <w>teetering</w> on the edge of a major economic crisis."
                        }
                    ],
                    "common_phrases": [
