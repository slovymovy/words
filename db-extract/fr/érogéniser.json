                "senses": [
                    {
                        "sense_id": "c0f62769-3b06-37c4-b80c-5a77eccfe308",
                        "entry_id": "9d5d7670-68d2-31d0-bee2-e33a74e8ce9c",
                        "glosses": [
                            "Donner un caractère érogène à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d8e494-1316-497b-9881-55d8093fadad",
                                "sense_id": "c0f62769-3b06-37c4-b80c-5a77eccfe308",
                                "text": "On peut dire que l’enfant sevré du sein, du téter (vase communicant, anthropophagie fantasmatique), érogénise d’autant plus le subtil qu’il perçoit de sa mère."
                            },
                            {
                                "example_id": "4de1b971-073c-471b-ae96-4fd3a4e11777",
                                "sense_id": "c0f62769-3b06-37c4-b80c-5a77eccfe308",
                                "text": "Il est un fait que nous sommes les seuls primates à « érogéniser » les seins."
                            },
                            {
                                "example_id": "5f4ff95c-f873-4627-bfd2-52a3c4e50fe9",
                                "sense_id": "c0f62769-3b06-37c4-b80c-5a77eccfe308",
                                "text": "Il faut donc érogéniser le marché, par une surenchère d'appâts; la « publicité » consiste à exploiter les soi-disant motivations profondes de la sexualité;"
                            }
                        ]
                    }
