                ],
                "senses": [
                    {
                        "sense_id": "c0d70810-6235-3570-a5c3-a64f8a29dfbb",
                        "entry_id": "a5459c34-1c63-3f4e-81d6-ff8fa77c515e",
                        "glosses": [
                            "leichter, offener Pferdewagen mit zwei oder vier Rädern; Buggy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf30bb7-0d98-438c-a7a2-3feaf33b9dc1",
                                "sense_id": "c0d70810-6235-3570-a5c3-a64f8a29dfbb",
                                "text": "« Son père lui jetait un manteau sur les épaules, ils montaient dans un petit buggy qu’elle conduisait elle-même et tous deux retournaient à Montjouvain. »"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e4726d3-84ad-4734-b7c4-6579df061610",
                        "source_entry_id": "a5459c34-1c63-3f4e-81d6-ff8fa77c515e",
                        "source_sense_id": "c0d70810-6235-3570-a5c3-a64f8a29dfbb",
                        "source_sense_description": "leichter, offener Pferdewagen mit zwei oder vier Rädern; Buggy",
                        "target_lang_word": "Buggy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buggy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                        "entry_id": "e88226a5-a3b1-3336-af39-30b8474e62ed",
                                        "glosses": [
                                            "einspänniger, zwei- oder vierrädriger, leichter, zumeist offener Wagen (der früher beim Trabrennen benutzt wurde)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc6b0233-45e6-42f9-a68c-3f9d8d824931",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„Zu den halbgedeckten, einspännigen Fuhrwerken gehört auch das Buggy ([…]).“"
                                            },
                                            {
                                                "example_id": "895cfdbd-234e-4c66-845b-260ffa3a1a3b",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„‚Das Pferd scheute und ging samt Buggy und Fahrer nach rechts in die Wiese durch,‘ meldet die Polizei.“"
                                            },
                                            {
                                                "example_id": "3e10710e-49c4-418d-8bb7-7186d1842893",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„Besonders spannend wird es am Sonnabendnachmittag: Beim ‚Jump and Drive‘ müssen die Reiter zuerst mit dem Pferd über den Parcours, anschließend wird eine Geländestrecke im Buggy absolviert.“"
                                            },
                                            {
                                                "example_id": "dbea6de9-c542-4e91-8b6a-406e6fa8ae71",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„Albert Sporrädli und seine Freiberger-Fuchs-Stute Nevada stellten sich besser auf die Fahreigenschaften ihres Buggys ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                        "entry_id": "e88226a5-a3b1-3336-af39-30b8474e62ed",
                                        "glosses": [
                                            "kleines, geländegängiges Automobil mit offener Karosserie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d3b8b6-0978-4bb5-9967-3228641d0e5e",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Die Anfahrt durch die 20 Kilometer lange Dünenlandschaft ist nur mit Jeeps zu bewältigen oder mit Buggys am Strand entlang.“"
                                            },
                                            {
                                                "example_id": "645a021f-f19d-4e0c-9d1d-b6bb4079ee91",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Manchmal läuft der Regisseur selbst Gefahr, dem bunten Zauber zu erliegen; zu Samba-Klängen filmt er vom Helikopter aus ein über die Dünen kurvendes Buggy, als müßte er seinen Zuschauern den Sandstrand verkaufen.“"
                                            },
                                            {
                                                "example_id": "e5e5feac-252c-4eaa-9ee7-1c8fb0511709",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Die Jungs fuhren mit dem Buggy rasant durch die steilen Sanddünen, die Mädchen ritten mit Pferden am Strand entlang.“"
                                            },
                                            {
                                                "example_id": "fb9e9852-6cd9-4f09-aaa1-63ae273bf308",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„An seinem Buggy, mit dem er tagtäglich von der Rocinha hinunter zum Strand von Sao Conrado fährt, flattert demonstrativ ein Schweizer Fähnchen.“"
                                            },
                                            {
                                                "example_id": "0948b97b-2030-4697-b720-4e099c17c993",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Pferde hat der Rancher nicht mehr. Mit einem Buggy fährt er täglich seine 200 Hektar große Weide ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e47cc4eb-864c-3b64-b95a-5f9536255d09",
                                        "entry_id": "e88226a5-a3b1-3336-af39-30b8474e62ed",
                                        "glosses": [
                                            "leichter, zusammenklappbarer Kinderwagen für Kleinkinder, die bereits sitzen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f3b772-ee0c-4efe-a1c4-e371f4584009",
                                                "sense_id": "e47cc4eb-864c-3b64-b95a-5f9536255d09",
                                                "text": "„Früher verbrachte der Journalist seine Vormittage mit Zeitunglesen oder bei Pressekonferenzen, heute schiebt er seinen zwölf Monate alten Sohn Simon im Buggy durch die Mainzer Innenstadt.“"
                                            },
                                            {
                                                "example_id": "143fbe31-9e69-411e-85d9-934632f94c73",
                                                "sense_id": "e47cc4eb-864c-3b64-b95a-5f9536255d09",
                                                "text": "„Kinder tobten herum, schoben ihre Buggys zwischen den Wartenden umher oder spielten mit ratternden Autos.“"
                                            },
                                            {
                                                "example_id": "30eb3020-4a0a-4b1f-9bb2-99c6b7537e3a",
                                                "sense_id": "e47cc4eb-864c-3b64-b95a-5f9536255d09",
                                                "text": "„Ratlos steht die dick bepackte Mutter mit Buggy und Kleinkind vor der Zugangsschranke zur Pariser S-Bahn. An ihr vorbei hasten die Berufstätigen, stecken ihre Tickets in den dafür vorgesehenen Schlitz und gehen durch die Sperre, die für einen Buggy viel zu schmal ist.“"
                                            },
                                            {
                                                "example_id": "190ef6b1-a283-4794-a3b0-dfdb4e6ab928",
                                                "sense_id": "e47cc4eb-864c-3b64-b95a-5f9536255d09",
                                                "text": "„Während die Mutter auf den weinenden kleinen Kerl einschimpfte, stimmte ein Mädchen in einem Buggy weiter hinten aus Solidarität in das Geheul mit ein.“"
                                            },
                                            {
                                                "example_id": "2380bb4a-82cb-4576-bdac-9ce3cf733f56",
                                                "sense_id": "e47cc4eb-864c-3b64-b95a-5f9536255d09",
                                                "text": "„Adam sitzt wieder in seinem Buggy und reibt sich die Augen mit seinen kleinen Fäusten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "335519d0-fa08-3964-8ebb-bf4d0130b953",
                "word": "buggy",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4a9e466-6332-3367-a46c-49fdeb17784c",
                        "entry_id": "335519d0-fa08-3964-8ebb-bf4d0130b953",
                        "glosses": [
                            "leichtes, offenes und geländegängiges Automɔbil mit großen Reifen; Buggy"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fb72b98-ea84-4458-8f38-0ed089b132f5",
                        "source_entry_id": "335519d0-fa08-3964-8ebb-bf4d0130b953",
                        "source_sense_id": "e4a9e466-6332-3367-a46c-49fdeb17784c",
                        "source_sense_description": "leichter, offener Pferdewagen mit zwei oder vier Rädern",
                        "target_lang_word": "Buggy",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buggy",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                        "entry_id": "e88226a5-a3b1-3336-af39-30b8474e62ed",
                                        "glosses": [
                                            "einspänniger, zwei- oder vierrädriger, leichter, zumeist offener Wagen (der früher beim Trabrennen benutzt wurde)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc6b0233-45e6-42f9-a68c-3f9d8d824931",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„Zu den halbgedeckten, einspännigen Fuhrwerken gehört auch das Buggy ([…]).“"
                                            },
                                            {
                                                "example_id": "895cfdbd-234e-4c66-845b-260ffa3a1a3b",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„‚Das Pferd scheute und ging samt Buggy und Fahrer nach rechts in die Wiese durch,‘ meldet die Polizei.“"
                                            },
                                            {
                                                "example_id": "3e10710e-49c4-418d-8bb7-7186d1842893",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„Besonders spannend wird es am Sonnabendnachmittag: Beim ‚Jump and Drive‘ müssen die Reiter zuerst mit dem Pferd über den Parcours, anschließend wird eine Geländestrecke im Buggy absolviert.“"
                                            },
                                            {
                                                "example_id": "dbea6de9-c542-4e91-8b6a-406e6fa8ae71",
                                                "sense_id": "3d17baa9-509b-3816-b0a4-bd341845c5d5",
                                                "text": "„Albert Sporrädli und seine Freiberger-Fuchs-Stute Nevada stellten sich besser auf die Fahreigenschaften ihres Buggys ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                        "entry_id": "e88226a5-a3b1-3336-af39-30b8474e62ed",
                                        "glosses": [
                                            "kleines, geländegängiges Automobil mit offener Karosserie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2d3b8b6-0978-4bb5-9967-3228641d0e5e",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Die Anfahrt durch die 20 Kilometer lange Dünenlandschaft ist nur mit Jeeps zu bewältigen oder mit Buggys am Strand entlang.“"
                                            },
                                            {
                                                "example_id": "645a021f-f19d-4e0c-9d1d-b6bb4079ee91",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Manchmal läuft der Regisseur selbst Gefahr, dem bunten Zauber zu erliegen; zu Samba-Klängen filmt er vom Helikopter aus ein über die Dünen kurvendes Buggy, als müßte er seinen Zuschauern den Sandstrand verkaufen.“"
                                            },
                                            {
                                                "example_id": "e5e5feac-252c-4eaa-9ee7-1c8fb0511709",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Die Jungs fuhren mit dem Buggy rasant durch die steilen Sanddünen, die Mädchen ritten mit Pferden am Strand entlang.“"
                                            },
                                            {
                                                "example_id": "fb9e9852-6cd9-4f09-aaa1-63ae273bf308",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„An seinem Buggy, mit dem er tagtäglich von der Rocinha hinunter zum Strand von Sao Conrado fährt, flattert demonstrativ ein Schweizer Fähnchen.“"
                                            },
                                            {
                                                "example_id": "0948b97b-2030-4697-b720-4e099c17c993",
                                                "sense_id": "3b97e2cf-9215-32f8-9e67-c0475bf271f3",
                                                "text": "„Pferde hat der Rancher nicht mehr. Mit einem Buggy fährt er täglich seine 200 Hektar große Weide ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e47cc4eb-864c-3b64-b95a-5f9536255d09",
                                        "entry_id": "e88226a5-a3b1-3336-af39-30b8474e62ed",
                                        "glosses": [
                                            "leichter, zusammenklappbarer Kinderwagen für Kleinkinder, die bereits sitzen können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f3b772-ee0c-4efe-a1c4-e371f4584009",
