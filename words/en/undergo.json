{
    "word_family": [
        "go",
        "undergoing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6862c77e-9432-34d0-8c9c-e82d40a867d1",
                    "sense_definition": "To experience something necessary, unpleasant, or painful, such as a medical treatment or a difficult period.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient had to <w>undergo</w> surgery because of her broken leg.",
                            "target_lang_translations": {
                                "ru": "Пациентке пришлось <w>перенести</w> операцию из-за сломанной ноги.",
                                "zh": "由于腿部骨折，病人不得不<w>接受</w>手术。",
                                "es": "La paciente tuvo que <w>someterse a</w> una cirugía debido a su pierna rota."
                            }
                        },
                        {
                            "text": "The victim <w>underwent</w> great trauma after the accident occurred.",
                            "target_lang_translations": {
                                "ru": "Пострадавший <w>испытал</w> тяжелую травму после того, как произошла авария.",
                                "zh": "事故发生后，受害者<w>经历</w>了巨大的创伤。",
                                "es": "La víctima <w>experimentó</w> un gran trauma después de que ocurriera el accidente."
                            }
                        }
                    ],
                    "synonyms": [
                        "endure",
                        "suffer",
                        "bear",
                        "go through",
                        "experience"
                    ],
                    "common_phrases": [
                        "undergo surgery",
                        "undergo treatment",
                        "undergo tests"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переживать что-то необходимое, неприятное или болезненное, например, медицинское лечение или трудный период.",
                        "zh": "经历或承受某种必要、不愉快或痛苦的事情，例如医疗程序或困难时期。",
                        "es": "Experimentar algo necesario, desagradable o doloroso, como un tratamiento médico o un periodo difícil."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "испытывать боль или трудности"
                            },
                            {
                                "target_lang_word": "подвергаться",
                                "target_lang_sense_clarification": "становиться объектом воздействия, например, операции"
                            },
                            {
                                "target_lang_word": "проходить",
                                "target_lang_sense_clarification": "завершать процесс лечения или обследования"
                            },
                            {
                                "target_lang_word": "испытывать",
                                "target_lang_sense_clarification": "переживать чувства или состояния"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接受",
                                "target_lang_sense_clarification": "用于医疗检查或手术"
                            },
                            {
                                "target_lang_word": "经历",
                                "target_lang_sense_clarification": "体验某种过程或状态"
                            },
                            {
                                "target_lang_word": "承受",
                                "target_lang_sense_clarification": "忍受痛苦或压力"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "someterse a",
                                "target_lang_sense_clarification": "pasar por un proceso médico o una prueba"
                            },
                            {
                                "target_lang_word": "padecer",
                                "target_lang_sense_clarification": "sufrir una enfermedad o una situación difícil"
                            },
                            {
                                "target_lang_word": "experimentar",
                                "target_lang_sense_clarification": "vivir una situación o estado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe2e286-a084-3aaa-bfb9-1d89145022ea",
                    "sense_definition": "To experience or pass through a process of change, transformation, or development.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old building is <w>undergoing</w> major renovations to become a modern hotel.",
                            "target_lang_translations": {
                                "ru": "Старое здание <w>проходит</w> через капитальный ремонт, чтобы стать современным отелем.",
                                "zh": "这座老建筑正在<w>进行</w>大规模翻新，以改建成一家现代化的酒店。",
                                "es": "El viejo edificio está <w>pasando por</w> una renovación importante para convertirse en un hotel moderno."
                            }
                        },
                        {
                            "text": "The project is <w>undergoing</w> great changes to meet the new requirements.",
                            "target_lang_translations": {
                                "ru": "Проект <w>претерпевает</w> большие изменения, чтобы соответствовать новым требованиям.",
                                "zh": "该项目正在<w>经历</w>重大变革以满足新要求。",
                                "es": "El proyecto está <w>experimentando</w> grandes cambios para cumplir con los nuevos requisitos."
                            }
                        }
                    ],
                    "synonyms": [
                        "experience",
                        "go through"
                    ],
                    "common_phrases": [
                        "undergo changes",
                        "undergo transformation",
                        "undergo renovation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переживать или проходить через процесс изменений, трансформации или развития.",
                        "zh": "经历或处于某种变化、转型或发展的过程中。",
                        "es": "Experimentar o pasar por un proceso de cambio, transformación o desarrollo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претерпевать",
                                "target_lang_sense_clarification": "подвергаться изменениям или трансформациям"
                            },
                            {
                                "target_lang_word": "проходить через",
                                "target_lang_sense_clarification": "стадию развития или процесс"
                            },
                            {
                                "target_lang_word": "подвергаться",
                                "target_lang_sense_clarification": "воздействию процесса, например, реконструкции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "经历",
                                "target_lang_sense_clarification": "处于变化的过程中"
                            },
                            {
                                "target_lang_word": "进行",
                                "target_lang_sense_clarification": "处于某种改造或修缮过程中"
                            },
                            {
                                "target_lang_word": "发生",
                                "target_lang_sense_clarification": "指事物本身出现变化"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "experimentar",
                                "target_lang_sense_clarification": "sufrir cambios o transformaciones"
                            },
                            {
                                "target_lang_word": "pasar por",
                                "target_lang_sense_clarification": "atravesar un proceso de desarrollo o cambio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcbc141f-44be-3fb9-b513-d60211d3a18d",
                    "sense_definition": "To go or move under or beneath something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat had to <w>undergo</w> the low bridge to reach the harbor.",
                            "target_lang_translations": {
                                "ru": "Маленькой лодке пришлось <w>пройти под</w> низким мостом, чтобы добраться до гавани.",
                                "zh": "小船必须从低矮的桥下<w>穿过</w>才能到达港口。",
                                "es": "El pequeño bote tuvo que <w>pasar por debajo del</w> puente bajo para llegar al puerto."
                            }
                        },
                        {
                            "text": "The divers <w>underwent</w> the ice sheet to explore the freezing water below.",
                            "target_lang_translations": {
                                "ru": "Дайверы <w>прошли под</w> ледяной щит, чтобы исследовать ледяную воду внизу.",
                                "zh": "潜水员从冰层下方<w>穿过</w>，去探索下方的冰冷水域。",
                                "es": "Los buzos <w>pasaron por debajo de</w> la capa de hielo para explorar el agua helada de abajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "pass under",
                        "go beneath"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This literal sense of moving beneath is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить или перемещаться под чем-либо (устаревшее значение).",
                        "zh": "从某物下方穿过或移动（古语用法）。",
                        "es": "Pasar o moverse por debajo de algo (uso poco común)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проходить под",
                                "target_lang_sense_clarification": "физическое перемещение под объектом"
                            },
                            {
                                "target_lang_word": "проплывать под",
                                "target_lang_sense_clarification": "движение под чем-либо в воде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "从……下方穿过",
                                "target_lang_sense_clarification": "物理位置上的移动"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pasar por debajo de",
                                "target_lang_sense_clarification": "movimiento físico bajo un objeto"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}