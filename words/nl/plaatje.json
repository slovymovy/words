                                "target_lang_word": "Bild",
                                "target_lang_sense_clarification": "wie ein Bild (z.B. bildhübsch)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a98164d0-e3f8-3fe4-803d-0cc0718d7a2b",
                    "sense_definition": "Een kleine tandprothese die slechts een deel van het gebit vervangt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tandarts adviseerde een <w>plaatje</w> om de ontbrekende voortand te vervangen.",
                            "target_lang_translations": {
                                "en": "The dentist advised a <w>partial denture</w> to replace the missing front tooth.",
                                "ru": "Стоматолог посоветовал <w>пластинку</w>, чтобы заменить отсутствующий передний зуб.",
                                "de": "Der Zahnarzt empfahl eine <w>Teilprothese</w>, um den fehlenden Schneidezahn zu ersetzen."
                            }
                        },
                        {
                            "text": "Hij moet zijn <w>plaatje</w> elke avond goed schoonmaken.",
                            "target_lang_translations": {
                                "en": "He has to clean his <w>plate</w> thoroughly every evening.",
                                "ru": "Он должен хорошо чистить свою <w>пластинку</w> каждый вечер.",
                                "de": "Er muss seine <w>Zahnplatte</w> jeden Abend gründlich reinigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebitje",
                        "tandprothese"
                    ],
                    "common_phrases": [
                        "een plaatje dragen"
                    ],
                    "target_lang_definitions": {
                        "en": "A small dental prosthesis that replaces only a part of the teeth.",
                        "ru": "Небольшой зубной протез, заменяющий лишь часть зубов.",
                        "de": "Eine kleine Zahnprothese, die nur einen Teil des Gebisses ersetzt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "partial denture",
                                "target_lang_sense_clarification": "a removable dental appliance"
                            },
                            {
                                "target_lang_word": "plate",
                                "target_lang_sense_clarification": "informal term for a dental prosthesis"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пластинка",
                                "target_lang_sense_clarification": "съемный зубной протез"
                            },
                            {
                                "target_lang_word": "зубной протез",
                                "target_lang_sense_clarification": "частичный"
                            }
                        ],
