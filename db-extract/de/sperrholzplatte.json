                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5049e030-6776-4e15-b8b5-4298405ce757",
                                "sense_id": "8df67277-dbf5-3f0d-9429-37d2ed8fc1e4",
                                "text": "„Die Türen und zwei Fenster waren mit Sperrholzplatten vernagelt, und hinter der Rezeption stand ein neuer Angestellter.“"
                            },
                            {
                                "example_id": "f31aeeb7-b1f5-4c92-b96a-2b7b66c18d9d",
                                "sense_id": "8df67277-dbf5-3f0d-9429-37d2ed8fc1e4",
                                "text": "„Abgesehen vom Badezimmer ist sein Kabuff der einzig private Raum in der Wohnung. Es ist ein Würfel, den er sich selbst aus Sperrholzplatten zusammengezimmert hat.“"
                            },
                            {
                                "example_id": "30a8232a-4144-438f-ade8-48250c5a31e8",
                                "sense_id": "8df67277-dbf5-3f0d-9429-37d2ed8fc1e4",
                                "text": "„Er hat sich sogar einen Schreibtisch aus ein paar Sperrholzplatten bauen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
