                                    {
                                        "sense_id": "9cdcbd11-1073-3f49-99b0-3fc80aa329c8",
                                        "entry_id": "fe626e77-edc6-3bd6-90d6-da3e28a013e5",
                                        "glosses": [
                                            "The act or process of shaping footwear on a last."
                                        ],
