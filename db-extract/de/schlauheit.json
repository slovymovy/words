                    {
                        "form_id": "7dcef7b2-292e-43d2-af51-bc9b64d7aa8e",
                        "entry_id": "5e989c70-6a7f-32e1-8c0a-bd3e564d7226",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Schlauheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a951e208-a98c-3e79-ad77-9b209cfe602d",
                        "entry_id": "5e989c70-6a7f-32e1-8c0a-bd3e564d7226",
                        "glosses": [
                            "Eigenschaft, klug, gescheit oder listig zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a515bca7-8764-4bd3-9dd6-d6155ecad908",
                                "sense_id": "a951e208-a98c-3e79-ad77-9b209cfe602d",
                                "text": "„Sie verfolgte ihr Ziel mit unbewußter, aber hartnäckiger Schlauheit, mit einer Schlauheit, wie sie bei Geisteskranken vorkommt […].“"
                            },
                            {
                                "example_id": "b5b56e93-71ef-4f79-877d-2d7350081c7a",
                                "sense_id": "a951e208-a98c-3e79-ad77-9b209cfe602d",
                                "text": "„Durch Schlauheit war sie überlistet worden, durch Schlauheit mußte sie sich wieder befreien.“"
                            },
                            {
                                "example_id": "8a7965b6-2661-4c21-846f-3fab6a3c06e5",
                                "sense_id": "a951e208-a98c-3e79-ad77-9b209cfe602d",
                                "text": "„Die ehrlose Schlauheit seiner Concurrenten läßt den Ehrlichen eine gewisse Schwäche fühlen, die er troß des Bewußtseins seiner Tüchtigkeit nicht zu überwinden vermag.“"
                            },
                            {
                                "example_id": "36e18bc0-9681-4b93-8345-6c22ca4e57b0",
                                "sense_id": "a951e208-a98c-3e79-ad77-9b209cfe602d",
                                "text": "„Dieser Claus trug die Schellenkappe nicht aus Schlauheit, sondern wegen seiner geistigen Behinderung, wie wir heute sagen würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "26f36ff0-bccd-3df1-afda-97c4d6339f46",
                        "entry_id": "5e989c70-6a7f-32e1-8c0a-bd3e564d7226",
                        "glosses": [
                            "etwas, das [1] zum Ausdruck bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d6d27f-fbaa-4df5-9d95-3ca2039daf8a",
                                "sense_id": "26f36ff0-bccd-3df1-afda-97c4d6339f46",
                                "text": "„Er überwindet oder umgeht sie, und sein Verfahren dabei erscheint häufig als Schlauheit.“"
                            },
                            {
                                "example_id": "2a9bce8d-97e2-49c6-b5d1-749773a167e0",
                                "sense_id": "26f36ff0-bccd-3df1-afda-97c4d6339f46",
                                "text": "„Da ist kein Platz für Häme und Schadenfreude und auch nicht für kleine taktische Schlauheiten.“"
                            },
                            {
                                "example_id": "f822299b-37ab-4b60-8233-5e499b7ff2e4",
                                "sense_id": "26f36ff0-bccd-3df1-afda-97c4d6339f46",
                                "text": "„Es wird hemmungslos kalauerhaft gereimt, mit naturwissenschaftlichen Schlauheiten jongliert, die nirgendwohin führen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
