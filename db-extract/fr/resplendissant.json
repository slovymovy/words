                    {
                        "translation_id": "98936c0e-2b66-4ab9-a76c-58292d5be2ce",
                        "source_entry_id": "7bac72b8-83f7-3c48-a7b0-9a0bf0826c42",
                        "source_sense_id": "ff3c4180-0538-32ac-840c-11ecd8741f69",
                        "source_sense_description": "Qui resplendit.",
                        "target_lang_word": "strahlend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strahlend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c2b084-ba8c-365c-90c2-09f88cc44152",
                                        "entry_id": "f85bc35b-b930-3809-ac1d-c4eacce8a8e5",
                                        "glosses": [
                                            "von einer Strahlenquelle ausgehende Energie, Wellen oder Materie"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9a7363d-ee1c-462a-881b-517edf8f6b70",
                                                "sense_id": "b2c2b084-ba8c-365c-90c2-09f88cc44152",
                                                "text": "In dem ehemaligen Salzstock [der Schachtanlage Asse] lagern etwa 126.000 Fässer mit leicht- und mittelstark strahlendem Atommüll."
                                            },
                                            {
                                                "example_id": "066eaca2-75aa-416b-a320-506be1980586",
                                                "sense_id": "b2c2b084-ba8c-365c-90c2-09f88cc44152",
                                                "text": "[Schlagzeile:] Störfall - Strahlendes Wasser aus Atomkraftwerk Temelin ausgetreten"
                                            },
                                            {
                                                "example_id": "106f5195-6573-4ba1-9e12-8af10dc5d144",
                                                "sense_id": "b2c2b084-ba8c-365c-90c2-09f88cc44152",
                                                "text": "In hundert Metern Höhe über den strahlenden Reaktoren lag die Radioaktivität bei 87,7 Millisievert."
                                            },
                                            {
                                                "example_id": "4d44b6b8-a24b-44b7-9148-a8acd4252ad7",
                                                "sense_id": "b2c2b084-ba8c-365c-90c2-09f88cc44152",
                                                "text": "Um eine weitere Kontaminierung des Meerwassers mit strahlenden Emissionen des Kernkraftwerks zu verhindern, verfolgt der KKW-Betreiber TEPCO eine neue Strategie."
                                            },
                                            {
                                                "example_id": "c456c3df-5b4a-478b-8758-2ca0985ae1e8",
                                                "sense_id": "b2c2b084-ba8c-365c-90c2-09f88cc44152",
                                                "text": "[…] Zug um Zug [werden] die Evakuierungsanordnungen für die Dörfer rund um die strahlende Kraftwerkruine [Fukushima] aufgehoben […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b14d44a-31ad-33f0-8146-e22be58571e5",
                                        "entry_id": "f85bc35b-b930-3809-ac1d-c4eacce8a8e5",
                                        "glosses": [
                                            "schönes Wetter signalisierend"
                                        ],
                                        "tags": [
                                            "Wetter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d28dbac5-52fe-4fee-9dbd-48c0a4e7ad78",
                                                "sense_id": "6b14d44a-31ad-33f0-8146-e22be58571e5",
                                                "text": "Der bei strahlendem Sonnenschein […] aufsteigende Fesselballon mit der Aufschrift „Stoppt Kinderarbeit“ sorgte stundenlang für Aufmerksamkeit und Diskussionen."
                                            },
                                            {
                                                "example_id": "2cd43d9b-d70a-47db-bd9e-e01a957eb27f",
                                                "sense_id": "6b14d44a-31ad-33f0-8146-e22be58571e5",
                                                "text": "Rund 2500 Zuschauer applaudierten, als Box-Weltmeister Wladimir Klitschko, Fußball-Legende Uwe Seeler und Ex-Champion Henry Maske das bronzene Max-Schmeling-Denkmal unter strahlend blauem Himmel in Hollenstedt enthüllten."
                                            },
                                            {
                                                "example_id": "4b2250c0-ecef-4149-8ed9-e33a25781fd8",
                                                "sense_id": "6b14d44a-31ad-33f0-8146-e22be58571e5",
                                                "text": "Der Tag war klirrend kalt, aber der Himmel strahlend blau […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c5b3b8d0-2a3d-3762-88de-49e8b3fa01f1",
                                        "entry_id": "f85bc35b-b930-3809-ac1d-c4eacce8a8e5",
                                        "glosses": [
                                            "sehr hell erleuchtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2f6d2d2-d8d5-4f31-a777-d9c897ef7849",
                                                "sense_id": "c5b3b8d0-2a3d-3762-88de-49e8b3fa01f1",
                                                "text": "Sein Gesicht war braun gebrannt, seine Zähne leuchteten darin strahlend weiß."
                                            },
                                            {
                                                "example_id": "f8108384-926a-4e28-9ccd-3e7fdad21617",
                                                "sense_id": "c5b3b8d0-2a3d-3762-88de-49e8b3fa01f1",
                                                "text": "[Schlagzeile:] Strahlendes London - In London hat das \"Lumière\"- Lichtfestival begonnen. […]"
                                            },
                                            {
                                                "example_id": "bd571c4f-3cbe-4f96-96bb-a213eeafab7c",
                                                "sense_id": "c5b3b8d0-2a3d-3762-88de-49e8b3fa01f1",
                                                "text": "„Ich sah in dieser pechschwarzen Dunkelheit ein kleines, strahlend helles Licht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b38ca761-565d-3388-880f-99adf57295f9",
                                        "entry_id": "f85bc35b-b930-3809-ac1d-c4eacce8a8e5",
                                        "glosses": [
                                            "äußerst positiv"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d549d8-a171-45df-aa13-f640258af7bc",
                                                "sense_id": "b38ca761-565d-3388-880f-99adf57295f9",
                                                "text": "Steve Jobs: „Ich glaube, Apple´s strahlendste und innovativste Tage kommen noch. […]“"
                                            },
                                            {
                                                "example_id": "108416a2-183b-463e-9fd9-6e3eba719162",
                                                "sense_id": "b38ca761-565d-3388-880f-99adf57295f9",
                                                "text": "[Designerin und Modeel Sahar al-Rabi:] „Ich will mit meinem Beruf die schöne und strahlende Seite des Iraks zeigen.“"
                                            },
                                            {
                                                "example_id": "4676fc16-16ea-4ab8-98ec-83f706f37acf",
                                                "sense_id": "b38ca761-565d-3388-880f-99adf57295f9",
                                                "text": "[…] die Erfolgsautorin [Hera Lind], die gerade ihren 60. Geburtstag gefeiert hat, spricht […] offen über die weniger strahlenden Seiten ihres Lebens, über finanzielle Probleme und Anfeindungen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "785e0235-ad90-3a8e-b92c-75b2ed401cbe",
                                        "entry_id": "f85bc35b-b930-3809-ac1d-c4eacce8a8e5",
                                        "glosses": [
                                            "in klaren durchdringenden Tönen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ce4c8e4-7526-49e9-8564-d9b8c1d66a02",
                                                "sense_id": "785e0235-ad90-3a8e-b92c-75b2ed401cbe",
                                                "text": "Christa Ludwig verfügte über eine seltene Klangüppigkeit im Mezzo- und Altregister, verbunden mit einer strahlenden hohen Lage."
                                            },
                                            {
                                                "example_id": "db1c0362-0ba7-4bc2-81c1-63cfb5e184c0",
                                                "sense_id": "785e0235-ad90-3a8e-b92c-75b2ed401cbe",
                                                "text": "Die zentrale Rolle des Eléazar […] fordert einen dramatischen Tenor mit strahlender Kraft in der Bruststimme und wurde später zur Paraderolle des italienischen Tenors Enrico Caruso."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f493b521-5398-3543-910a-5c9f50789864",
                                        "entry_id": "f85bc35b-b930-3809-ac1d-c4eacce8a8e5",
                                        "glosses": [
                                            "mit einem breiten Lächeln, auch: in hervorragender Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a479d8b9-9b00-477f-9a17-554ba668c83b",
                                                "sense_id": "f493b521-5398-3543-910a-5c9f50789864",
                                                "text": "Mit federnden Schritten betritt Tom Franz den Raum – sportliche Gestalt, kurze Haare, strahlendes Lächeln."
                                            },
                                            {
                                                "example_id": "d1604bbd-1153-4dbc-b45a-88c709cf8b9c",
                                                "sense_id": "f493b521-5398-3543-910a-5c9f50789864",
                                                "text": "Der strahlende Sieger sprang auf das Podest und reckte die Arme in die Höhe."
                                            },
                                            {
                                                "example_id": "26f0cdab-f8d5-4a1a-8216-54e274a27742",
                                                "sense_id": "f493b521-5398-3543-910a-5c9f50789864",
                                                "text": "Strahlender Gewinner dieser Oscar-Nacht war der 74-jährige Clint Eastwood. Er erhielt den Preis für den besten Film des Jahres, ein Boxer-Drama namens „Million Dollar Baby“ […]"
                                            },
                                            {
                                                "example_id": "469b4fed-4d94-495c-8312-39871d3ee437",
                                                "sense_id": "f493b521-5398-3543-910a-5c9f50789864",
                                                "text": "Erschöpft, aber überglücklich nahmen die Spieler der Crash Eagles nach dem Schlusspfiff den großen Pokal entgegen und präsentierten sich als strahlende Deutsche Meister 2004."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
