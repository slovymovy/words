                },
                {
                    "sense_id": "19496639-0c7e-34b6-867d-ff579e4b049a",
                    "sense_definition": "Any electronic device worn on the head, such as those used for virtual reality or augmented reality.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wearable_technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on the VR <w>headset</w> and was immediately transported into a digital forest.",
