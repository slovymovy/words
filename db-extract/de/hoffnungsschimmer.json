                        "source_sense_description": "ein wenig Hoffnung",
                        "target_lang_word": "glimmer of hope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glimmer of hope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca55bba-6477-37ab-88cb-1d3c326b605b",
                                        "entry_id": "93a40041-e765-3198-97fc-c82714290db4",
                                        "glosses": [
                                            "A good omen; a small but undependable chance of something positive to come."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c59ea7e3-2111-47ca-9c1f-c48cdb340ead",
                                                "sense_id": "7ca55bba-6477-37ab-88cb-1d3c326b605b",
                                                "text": "After more than a year of unrelenting bad economic numbers, we finally received a glimmer of hope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
