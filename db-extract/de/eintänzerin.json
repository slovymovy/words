                "senses": [
                    {
                        "sense_id": "84fdabad-8910-311d-a8f4-915fe25898d2",
                        "entry_id": "d2965a0e-2939-3d76-8ac2-62808395a3db",
                        "glosses": [
                            "Frau, die auf einer Tanzfläche einen Tanz vorführt, um Stimmung zu erzeugen, die anderen zum Tanzen zu motivieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61980239-b979-4a3d-a187-3b5aa1970107",
                                "sense_id": "84fdabad-8910-311d-a8f4-915fe25898d2",
                                "text": "„Die junge Frau war vor ihrer Heirat Eintänzerin im ›Palais de Danse‹ in Drymouth gewesen […]“"
                            },
                            {
                                "example_id": "2e74939e-dd1a-414a-8602-12d6c88d2d96",
                                "sense_id": "84fdabad-8910-311d-a8f4-915fe25898d2",
                                "text": "„Als er eine Eintänzerin auf einer Reise kennenlernt, macht er sie zu seiner Geliebten und für die Mitbewohner zu seiner Sprechstundenhilfe.“"
                            },
                            {
                                "example_id": "8e2babc1-b99d-4f72-a152-a0289fad5e0e",
                                "sense_id": "84fdabad-8910-311d-a8f4-915fe25898d2",
                                "text": "„Sie hatte außer sich selbst nicht viel in die Ehe eingebracht, war ohne nennenswerte Berufsausbildung geblieben und hatte nur so dann und wann in schäbigen Lokalen als Eintänzerin gearbeitet.“"
                            },
                            {
                                "example_id": "2976d80d-4bda-4799-8f2e-567aee940fa9",
                                "sense_id": "84fdabad-8910-311d-a8f4-915fe25898d2",
                                "text": "„Sie war Eintänzerin im besten Hotel am Platze, und der Inhaber wollte sie adoptieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
