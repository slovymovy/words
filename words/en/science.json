{
    "word_family": [
        "scientific",
        "scientist",
        "scientifically",
        "scientism",
        "pseudoscience",
        "neuroscience",
        "bioscience"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dbaab2cf-6b95-3e20-b14d-88ab8c2b040b",
                    "sense_definition": "The study of the physical and natural world through observation and experiment, often as a school subject.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "scientific_discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My favorite subjects at school are <w>science</w>, mathematics, and history.",
                            "target_lang_translations": {
                                "ru": "Мои любимые предметы в школе — <w>естествознание</w>, математика и история."
                            }
                        },
                        {
                            "text": "The students are doing a <w>science</w> experiment in the laboratory today.",
                            "target_lang_translations": {
                                "ru": "Сегодня ученики проводят <w>научный</w> эксперимент в лаборатории."
                            }
                        }
                    ],
                    "synonyms": [
                        "sci",
                        "sci."
                    ],
                    "common_phrases": [
                        "science teacher",
                        "science project",
                        "science class"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изучение физического и природного мира посредством наблюдений и экспериментов, часто как школьный предмет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "естествознание",
                                "target_lang_sense_clarification": "как школьный предмет"
                            },
                            {
                                "target_lang_word": "наука",
                                "target_lang_sense_clarification": "общая область знаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "867cbe55-bdbf-3517-b005-4e2753726072",
                    "sense_definition": "The collective body of knowledge and the systematic process of study using the scientific method.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "scientific_discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern <w>science</w> has helped us understand how the human brain works.",
                            "target_lang_translations": {
                                "ru": "Современная <w>наука</w> помогла нам понять, как работает человеческий мозг."
                            }
                        },
                        {
                            "text": "The discovery was a major <w>advancement</w> in <w>science</w> and technology.",
                            "target_lang_translations": {
                                "ru": "Это открытие стало важным шагом вперед в <w>науке</w> и технике."
                            }
                        }
                    ],
                    "common_phrases": [
                        "advancement in science",
                        "modern science",
                        "popular science"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность знаний и систематический процесс исследования с использованием научного метода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наука",
                                "target_lang_sense_clarification": "система знаний и метод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63d3749c-380b-343e-b5bc-ea75e5c63e14",
                    "sense_definition": "A particular branch of knowledge or field of study that follows systematic principles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific_discipline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economics is a messy discipline: too fluid to be a <w>science</w>, too rigorous to be an art.",
                            "target_lang_translations": {
                                "ru": "Экономика — сложная дисциплина: слишком изменчивая, чтобы быть <w>наукой</w>, и слишком строгая, чтобы быть искусством."
                            }
                        },
                        {
                            "text": "Social studies is often considered a social <w>science</w> rather than a humanities subject.",
                            "target_lang_translations": {
                                "ru": "Обществознание часто считают общественной <w>наукой</w>, а не гуманитарным предметом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "social science",
                        "political science",
                        "natural science"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная ветвь знаний или область исследования, следующая систематическим принципам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наука",
                                "target_lang_sense_clarification": "отдельная дисциплина"
                            },
                            {
                                "target_lang_word": "дисциплина",
                                "target_lang_sense_clarification": "отрасль знаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14b423a9-4a75-3182-a5ca-29eadaeef497",
                    "sense_definition": "The community of scientists and researchers as a whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific_community",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Science</w> knows it doesn't know everything; otherwise, it would stop.",
                            "target_lang_translations": {
                                "ru": "<w>Наука</w> знает, что она знает не всё; иначе она бы остановилась."
                            }
                        },
                        {
                            "text": "The global <w>science</w> community worked together to develop the new vaccine.",
                            "target_lang_translations": {
                                "ru": "Мировое <w>научное</w> сообщество работало вместе над созданием новой вакцины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "science community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщество ученых и исследователей в целом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наука",
                                "target_lang_sense_clarification": "научное сообщество"
                            },
                            {
                                "target_lang_word": "ученые",
                                "target_lang_sense_clarification": "сообщество людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce78166f-b16d-3a8f-ae29-d3a3fe2fabe2",
                    "sense_definition": "Knowledge or skill gained through study or practice; mastery of a specific area.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author demonstrates a deep and accurate <w>science</w> in mental philosophy.",
                            "target_lang_translations": {
                                "ru": "Автор демонстрирует глубокое и точное <w>знание</w> ментальной философии."
                            }
                        },
                        {
                            "text": "He applied his <w>science</w> of the craft to build the intricate clock.",
                            "target_lang_translations": {
                                "ru": "Он применил всё свое <w>мастерство</w> в ремесле, чтобы собрать эти сложные часы."
                            }
                        }
                    ],
                    "synonyms": [
                        "science"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in older literature to mean general knowledge or mastery"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Знания или навыки, полученные в результате обучения или практики; мастерство в определенной области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знание",
                                "target_lang_sense_clarification": "осведомленность или эрудиция"
                            },
                            {
                                "target_lang_word": "мастерство",
                                "target_lang_sense_clarification": "владение навыком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcb482cc-f0a2-3dd0-8003-eabe7ccafd61",
                    "sense_definition": "A term used to refer to the sport of boxing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fighter was a master of the <w>science</w>, using technique over brute force.",
                            "target_lang_translations": {
                                "ru": "Боец был мастером <w>техники</w>, предпочитая мастерство грубой силе."
                            }
                        },
                        {
                            "text": "Many have laughed at the idea that boxing is a <w>science</w> of national service.",
                            "target_lang_translations": {
                                "ru": "Многие смеялись над идеей, что бокс — это <w>наука</w> на службе отечеству."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweet science"
                    ],
                    "common_phrases": [
                        "sweet science"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrase 'the sweet science'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Термин, используемый для обозначения бокса как вида спорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусство",
                                "target_lang_sense_clarification": "о технике бокса"
                            },
                            {
                                "target_lang_word": "наука",
                                "target_lang_sense_clarification": "в контексте 'благородное искусство самообороны'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3451fb5f-3450-3dc7-a888-5b6f7f961cc8",
                    "sense_definition": "To apply scientific principles or methods to solve a problem.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apply_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>science</w> our way out of this technical difficulty.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>найти научное решение</w> этой технической проблемы."
                            }
                        },
                        {
                            "text": "The engineers <w>scienced</w> the problem until they found a viable solution.",
                            "target_lang_translations": {
                                "ru": "Инженеры <w>применяли научные методы</w> к проблеме, пока не нашли жизнеспособное решение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "science the problem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Modern informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Применять научные принципы или методы для решения проблемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подходить научно",
                                "target_lang_sense_clarification": "использовать научный метод"
                            },
                            {
                                "target_lang_word": "решать с помощью науки",
                                "target_lang_sense_clarification": "применять знания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a53851d-02f5-3915-a544-30ab4025629c",
                    "sense_definition": "To instruct someone or make them skilled in a particular field of knowledge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young scholar was deep-<w>scienced</w> in the ancient lore of philosophy.",
                            "target_lang_translations": {
                                "ru": "Молодой ученый был глубоко <w>посвящен</w> в древние познания философии."
                            }
                        },
                        {
                            "text": "He sought to <w>science</w> his pupils in the rigorous methods of research.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>обучить</w> своих учеников строгим методам исследования."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обучать кого-либо или делать его искусным в определенной области знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обучать",
                                "target_lang_sense_clarification": "давать научные знания"
                            },
                            {
                                "target_lang_word": "просвещать",
                                "target_lang_sense_clarification": "вводить в курс наук"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}