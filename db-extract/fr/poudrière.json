                    {
                        "translation_id": "a2671ba4-ba7f-404e-ac9f-2b8254ee15c7",
                        "source_entry_id": "07c55010-1bfe-3524-aed8-ef535f37d16d",
                        "source_sense_id": "dd7b68d6-f93f-3e1e-80b7-1ebb6e56c5d5",
                        "source_sense_description": "Magasin où l’on conserve la poudre à canon",
                        "target_lang_word": "kruitmagazijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kruitmagazijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1b21bd-c428-35f3-ba2e-e3a87a5ba1d9",
                                        "entry_id": "bc93c794-b010-3392-ab8e-2d7bcac3e7cc",
                                        "glosses": [
                                            "verstevigde ruimte waarin men kruit bewaart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca13aa92-ae3f-4cb6-a3cc-1fe446af099b",
                                                "sense_id": "dd1b21bd-c428-35f3-ba2e-e3a87a5ba1d9",
                                                "text": "Waarom was Judiths serene, maar nog steeds wat gelige voorhoofd niet allang uit elkaar gesprongen bij het terugdenken aan een verleden liefdeshandeling; het met aandacht aanraken van zo'n granaat waarvan zij er meer in haar schedel borg dan er bommen waren in 's lands Kruitmagazijn."
                                            },
                                            {
                                                "example_id": "ec167bc8-de5d-4ab2-aca8-67f5620ec67b",
                                                "sense_id": "dd1b21bd-c428-35f3-ba2e-e3a87a5ba1d9",
                                                "text": "Een paar jaar later bleef het orgel gespaard bij een explosie van de Spaanse toren –het kruitmagazijn in Château-des-Ducs in het centrum van Nantes– dat de glas-in-loodramen van de kathedraal verwoestte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee7e5ef5-7428-4a05-9977-6c02a282a9c6",
                        "source_entry_id": "07c55010-1bfe-3524-aed8-ef535f37d16d",
                        "source_sense_id": "60e4a72b-75fd-335e-86b6-b4106da46913",
                        "source_sense_description": "Zone où il suffit d’un simple incident pour qu’un conflit se généralise.",
                        "target_lang_word": "Pulverfass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pulverfass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8df9eba-ea3b-3107-9365-bdbb283e5bfa",
                                        "entry_id": "d539bd8d-0e29-3f12-9dbf-c1f583a24b12",
                                        "glosses": [
                                            "Fass zur Aufbewahrung und zum Transport von Schießpulver"
                                        ],
                                        "tags": [
                                            "früher"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8948a147-c144-4997-bed3-4a49987d11bc",
                                                "sense_id": "c8df9eba-ea3b-3107-9365-bdbb283e5bfa",
                                                "text": "„Die Ladungen der Sklavenschiffe, über die in guter Kaufmannsart sorgfältig Buch geführt wurde, vermitteln einen präzisen Eindruck: Gewehre, Pulverfässer, Branntwein, Stoffe, Glas- und Eisenwaren, das sind die Waren, die gegen Millionen Afrikaner eingetauscht wurden.“"
                                            },
                                            {
                                                "example_id": "a35d0985-dad2-417d-9f85-f1d8da9861e4",
                                                "sense_id": "c8df9eba-ea3b-3107-9365-bdbb283e5bfa",
                                                "text": "„Während eines Gelages feuerten sie eine Salve von Kanonenschüssen ab. Dabei sprangen offenbar Funken auf die Pulverfässer der ‚Oxford‘ über, das Schiff explodierte und sank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                        "entry_id": "d539bd8d-0e29-3f12-9dbf-c1f583a24b12",
                                        "glosses": [
                                            "brisante, gefährliche, spannungsreiche (politische) Lage/Situation"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "161ae425-9fba-4cbf-9230-37a59cf129cc",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Die Strategie der gnadenlosen Unterdrückung mag zwar kurzfristig funktioniert haben, doch der Iran sowie Bahrain werden ein Pulverfass bleiben, solange die autokratischen Regimes jegliche politische Öffnung kategorisch ablehnen.“"
                                            },
                                            {
                                                "example_id": "1f4688e7-aee1-4a4a-96c5-c2be3a95fcaf",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Serbia irredenta - zerstört wurde Jugoslawien nicht durch eine Verschwörung fremder Mächte, sondern durch serbischen Größenwahn, den Anspruch auf Heimholung aller ‚unerlösten Landsleute‘ in einer Region ethnischer Pulverfässer.“"
                                            },
                                            {
                                                "example_id": "d7d71bc4-5447-40c9-87f9-0aa024978d08",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Solange der Zugang zu ökonomischen, sozialen und kulturellen Rechten erschwert bleibt, sind alle Länder Pulverfässer.“"
                                            },
                                            {
                                                "example_id": "35413951-9e17-4773-947d-4ed33478ef8d",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„So stellte er die rhetorische Frage, ob es für europäische Nationen nicht sinnvoller sei, ‚jetzt einige Millionen zur Lösung des Problems beizutragen, anstatt zu warten, bis das Pulverfass explodiert ist und dann einige Milliarden auszugeben‘.“"
                                            },
                                            {
                                                "example_id": "5b5546da-6fac-438f-89bb-fca935a8d87b",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Das ölreichste Gebiet der Welt rund um den persischen Golf gilt währenddessen als politisches Pulverfass.“"
                                            },
                                            {
                                                "example_id": "225336ff-54c1-48bb-b462-9dac89608078",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Iran gleicht einem Pulverfass. Es bedarf einer Kleinigkeit, damit dieses Pulverfass in die Luft fliegt.“"
                                            },
                                            {
                                                "example_id": "7c415e46-2161-4db6-a056-be45d154a3f2",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Das Dorf glich bereits einem Pulverfass, als kurz vor Ostern der Wehrsportverein Vederö ein paramilitärisches Lager in Gyöngyöspata ankündigte.“"
                                            },
                                            {
                                                "example_id": "4ea56eac-134b-40d3-baaa-5c0fc5e9d613",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Nicht zum ersten Mal wird im Pulverfass Kosovo beim Dauerkonflikt zwischen Serben und Albanern kräftig gezündelt.“"
                                            },
                                            {
                                                "example_id": "0d36cc0c-0e29-4e80-a5b2-22939c9a7720",
                                                "sense_id": "196cc57e-f90a-3241-b139-0563c37caf50",
                                                "text": "„Wenn die Menschen das Wahlergebnis nicht anerkennen, kann das zu einem Pulverfass werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "600e8831-cbc9-3a00-8e60-2a8f44164b96",
                                        "entry_id": "d539bd8d-0e29-3f12-9dbf-c1f583a24b12",
                                        "glosses": [
                                            "(staatlicher) Aufbewahrungsort für größere Mengen an Munition"
                                        ],
