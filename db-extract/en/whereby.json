                                                "sense_id": "f942c12c-4ad8-3303-881d-def56703992e",
                                                "text": "Man fragte sich, wodurch er ertappt worden war."
                                            },
                                            {
                                                "example_id": "5e88a960-5808-4845-92b8-5db148f3ebef",
                                                "sense_id": "f942c12c-4ad8-3303-881d-def56703992e",
                                                "text": "Wodurch hast du von der offenen Stelle erfahren?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de41a4ae-5e64-34e2-aabb-f76189e61e13",
                                        "entry_id": "b6e2b3c9-f680-326b-a577-5d7b3d89e0e7",
                                        "glosses": [
                                            "aus dem eben erwähnten Grund heraus"
                                        ],
                                        "tags": [
                                            "relativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e542b81b-7654-4367-a025-08a794353e78",
                                                "sense_id": "de41a4ae-5e64-34e2-aabb-f76189e61e13",
                                                "text": "Er ist viel auf Reisen gewesen, wodurch natürlich auch kostbare Zeit verlorengegangen ist."
                                            },
                                            {
                                                "example_id": "fbbf71b9-902c-4dbe-a54e-ac1e928a7eba",
                                                "sense_id": "de41a4ae-5e64-34e2-aabb-f76189e61e13",
                                                "text": "„Ein Vogelflügel ist gewölbt und zwingt allein durch sein Profil die Luft auf seiner Oberseite auf einen längeren Weg, wodurch dort Unterdruck und damit Auftrieb entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d3615201-1941-3fc9-b161-94088ccf9b9e",
                                        "entry_id": "b6e2b3c9-f680-326b-a577-5d7b3d89e0e7",
                                        "glosses": [
                                            "durch welches hindurch"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21df96c3-e5ef-4ff1-bed8-236a14a56509",
                                                "sense_id": "d3615201-1941-3fc9-b161-94088ccf9b9e",
                                                "text": "Das ist das Tor, wodurch er kommen muss!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
