                        "examples": [
                            {
                                "example_id": "fe49566a-ad52-4787-b08d-6702cdfa587a",
                                "sense_id": "d8159207-a003-3cf9-8fa5-acae5a38efa0",
                                "text": "Het was een halsketting met afwisselend grote smaragden en kleine sterrenformaties van briljanten, allemaal fonkelend alsof ze nieuw waren, hoewel het sieraad uit de vroege negentiende eeuw moest komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d9fe09c-bfbf-30b4-8dd2-f7e20d624717",
                        "entry_id": "a78a299d-17bd-3e03-b51c-8841556eb494",
                        "glosses": [
                            "sportteam dat bestaat uit heel beroemde spelers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1100a724-2969-4298-96d9-586b4ca889ae",
                                "sense_id": "4d9fe09c-bfbf-30b4-8dd2-f7e20d624717",
                                "text": "Real Madrid begon furieus aan het duel en kreeg meteen twee halve kansen. De Franse sterrenformatie moest in de eerste tien minuten even vrezen om onder de voet gelopen te worden, maar in de eerste de beste tegenstoot kwam Mbappé in een goede schietpositie. Hij stuitte echter op de uitgestrekte Thibaut Courtois."
                            },
                            {
                                "example_id": "c6f1a987-c885-4b18-9b73-028b3fbae3c0",
                                "sense_id": "4d9fe09c-bfbf-30b4-8dd2-f7e20d624717",
                                "text": "Door de 121-110 nederlaag in Arizona tegen Phoenix Suns is het niet meer mogelijk voor de sterrenformatie rond LeBron James om tiende te worden in de Western Conference. Daardoor lopen de Lakers de play-offs mis, voor de zevende keer alweer in de afgelopen negen jaar."
                            }
                        ]
                    }
