                                "target_lang_sense_clarification": "ogólnie mięso jeleniowatych lub zwierząt łownych"
                            },
                            {
                                "target_lang_word": "sarnina",
                                "target_lang_sense_clarification": "mięso sarny"
                            },
                            {
                                "target_lang_word": "jelenina",
                                "target_lang_sense_clarification": "mięso jelenia"
                            }
                        ]
