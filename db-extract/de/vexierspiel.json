                ],
                "senses": [
                    {
                        "sense_id": "305ecfb6-f2ce-391c-abe2-c51fe33b1a8c",
                        "entry_id": "0878f304-76e4-3c22-b3c1-e4c6404971d1",
                        "glosses": [
                            "gedankliche Herausforderung, etwas zu entwirren und/oder neu zusammenzusetzen; knifflige Aufgabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8170f5-16ec-45fc-bd1b-e4309fa74944",
                                "sense_id": "305ecfb6-f2ce-391c-abe2-c51fe33b1a8c",
                                "text": "Dieser Kriminalfall wuchs sich zu einem langwierigen Vexierspiel aus."
                            },
                            {
                                "example_id": "ae05d12e-f70c-4681-9e0b-05072a42cd40",
                                "sense_id": "305ecfb6-f2ce-391c-abe2-c51fe33b1a8c",
                                "text": "„Jünger lädt hier zu einem Vexierspiel ein, das, auf literarischer wie psychischer Ebene angesiedelt, gleichermaßen unterschiedlichste Formen und Genres – Anti-Märchen, Parabel, »gothic novel« – wie auch die eigenen Erwartungen und Ängste des Lesers anspricht.“"
                            },
                            {
                                "example_id": "85ed47a3-4e1e-4bea-856d-679815a36924",
                                "sense_id": "305ecfb6-f2ce-391c-abe2-c51fe33b1a8c",
                                "text": "„Wo die eigene Zukunft nicht lag, hatten ihm unter anderem der »Anti-Ovid«, der ihm als Vexierspiel geraten war, und seine Angriffe auf Uz, die er bereute, vor Augen geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00751239-4f4a-3b9a-ad95-31e3dd580f78",
                        "entry_id": "0878f304-76e4-3c22-b3c1-e4c6404971d1",
                        "glosses": [
                            "Spiel, bei dem geneckt und gefoppt, getäuscht wird"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1cb13292-fa10-470e-a6db-888237e6dba2",
                                "sense_id": "00751239-4f4a-3b9a-ad95-31e3dd580f78",
                                "text": "„Das Schelmische der Themen hat die Form ergriffen und treibt mit ihr ein lustiges Vexierspiel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
