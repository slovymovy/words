                "senses": [
                    {
                        "sense_id": "c2e1438b-4799-3d7e-aaa3-cc36fc81db52",
                        "entry_id": "1e23260b-c2be-3768-81f5-69d7962e763f",
                        "glosses": [
                            "israelischer Auslandsgeheimdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81be2195-3017-4afe-98a3-bc947b4f72a8",
                                "sense_id": "c2e1438b-4799-3d7e-aaa3-cc36fc81db52",
                                "text": "„Dass Israel sich prinzipiell zu den Aktivitäten seines Geheimdienstes nicht äußert, heizt die Gerüchte nur weiter an. Fachleute halten es allerdings für unwahrscheinlich, dass der Mossad die Vielzahl von Sabotageakten allein stemmen könnte.“"
                            },
                            {
                                "example_id": "4e917ee7-252f-4a44-be12-35f073750a69",
                                "sense_id": "c2e1438b-4799-3d7e-aaa3-cc36fc81db52",
                                "text": "„Ihr verstorbener Mann war ein hohes Tier beim Mossad – dem israelischen Geheimdienst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4cfe21a9-f63e-33d6-b531-19c237729087",
                        "entry_id": "1e23260b-c2be-3768-81f5-69d7962e763f",
                        "glosses": [
                            "Abteilung der Hagana, die sich um die illegale Einwanderung von Juden nach Palästina kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3821c516-c195-42fe-8b64-2cdfe07ee55e",
                                "sense_id": "4cfe21a9-f63e-33d6-b531-19c237729087",
                                "text": "„Es wurden keine klaren Prioritäten gesetzt, und meist waren die Aktionen des Mossad schlecht vorbereitet, so daß man sie fast als waghalsig bezeichnen kann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
