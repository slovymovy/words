    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "784793ff-6cf0-3052-9206-20f283bb008c",
                    "sense_definition": "kobieta w stosunku do swoich dzieci, matka",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rodzina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja <w>mama</w> przygotowała dzisiaj pyszny obiad dla całej rodziny.",
                            "target_lang_translations": {
                                "en": "My <w>mum</w> prepared a delicious dinner for the whole family today."
                            }
                        },
                        {
                            "text": "Dziecko biegnie prosto w objęcia swojej <w>mamy</w>.",
                            "target_lang_translations": {
                                "en": "The child is running straight into the arms of its <w>mother</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "matka",
                        "mamusia",
                        "mateczka",
                        "mateńka",
                        "matula",
                        "mamuśka",
                        "rodzicielka"
                    ],
                    "common_phrases": [
                        "moja mama",
                        "kochana mama"
                    ],
                    "target_lang_definitions": {
                        "en": "A woman in relation to her children; a female parent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mum",
                                "target_lang_sense_clarification": "Informal term for mother, common in British English."
                            },
                            {
                                "target_lang_word": "mother",
                                "target_lang_sense_clarification": "Standard, neutral term for a female parent."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e42d031-834a-34b7-9c86-8311a5e581b8",
                    "sense_definition": "kobieta karmiąca piersią cudze dziecko",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opieka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach zamożne rodziny często zatrudniały <w>mamkę</w> do karmienia niemowlęcia.",
                            "target_lang_translations": {
                                "en": "In olden times, wealthy families often hired a <w>wet nurse</w> to feed the infant."
                            }
                        },
                        {
                            "text": "Dziecko było bardzo przywiązane do swojej <w>mamki</w>.",
                            "target_lang_translations": {
                                "en": "The child was very attached to its <w>wet nurse</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mamka"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "termin historyczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A woman who breastfeeds another person's child."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wet nurse",
                                "target_lang_sense_clarification": "Historical term for a woman employed to breastfeed another's infant."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "662e0fe3-f148-3cdc-8202-13c6e7c9a317",
                    "sense_definition": "osoba zajmująca się opieką nad dziećmi",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opieka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doświadczona <w>piastunka</w> zajmowała się dziećmi przez cały dzień.",
                            "target_lang_translations": {
                                "en": "An experienced <w>nanny</w> looked after the children all day."
                            }
                        },
                        {
                            "text": "Dzieci bardzo lubiły swoją <w>piastunkę</w> za jej cierpliwość.",
                            "target_lang_translations": {
                                "en": "The children were very fond of their <w>nanny</w> for her patience."
                            }
                        }
                    ],
                    "synonyms": [
                        "piastunka"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "termin przestarzały"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who takes care of children."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nanny",
                                "target_lang_sense_clarification": "A person employed to care for children in a household."
                            },
                            {
                                "target_lang_word": "nursemaid",
                                "target_lang_sense_clarification": "An archaic term for a woman employed to look after children."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3842a327-65c9-33fe-a7ad-cff551993407",
                    "sense_definition": "określenie teściowej używane przez zięcia lub synową",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rodzina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zięć zawsze zwraca się do teściowej per <w>mamo</w>.",
                            "target_lang_translations": {
                                "en": "The son-in-law always addresses his <w>mother-in-law</w> as 'mum'."
                            }
                        },
                        {
                            "text": "Synowa bardzo szanuje swoją <w>mamę</w>.",
                            "target_lang_translations": {
                                "en": "The daughter-in-law respects her <w>mother-in-law</w> very much."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w relacjach rodzinnych"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A term of address for a mother-in-law used by a son-in-law or daughter-in-law."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mother-in-law",
                                "target_lang_sense_clarification": "The mother of one's spouse."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0274e34b-22be-32c1-9a0f-403a46f646df",
                    "sense_definition": "określenie żony",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rodzina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na Kresach starsi ludzie często nazywali swoją żonę <w>mamą</w>.",
                            "target_lang_translations": {
                                "en": "In the Kresy region, older people often referred to their wife as <w>mother</w>."
                            }
                        },
                        {
                            "text": "Mój dziadek zawsze mówił o babci moja <w>mama</w>.",
                            "target_lang_translations": {
                                "en": "My grandfather always spoke of my grandmother as his <w>mother</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "używane na Kresach"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A regional term used to refer to one's wife."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mother",
                                "target_lang_sense_clarification": "regional: a man's word for his wife"
                            }
                        ]
                    }
                }
            ]
