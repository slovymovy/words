                "senses": [
                    {
                        "sense_id": "ebd65fcc-4cdd-335a-829d-01308505396c",
                        "entry_id": "6998400e-a4df-3551-a3e4-d9994fee28a9",
                        "glosses": [
                            "Grube oder kleine Vertiefung in der Erde oder einem anderen Substrat, in die eine Pflanze eingesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9b0063b-2bd2-4e3c-bb35-a5e2918a3c50",
                                "sense_id": "ebd65fcc-4cdd-335a-829d-01308505396c",
                                "text": "„Ein Helfer hält den Strauch frei in das Pflanzloch, bis die Erde eingefüllt und durch leichtes Rütteln zwischen den Wurzeln verteilt ist.“"
                            },
                            {
                                "example_id": "7b876c97-c9f9-4548-b54f-2decb8f66460",
                                "sense_id": "ebd65fcc-4cdd-335a-829d-01308505396c",
                                "text": "„Nachdem die Pflanzlöcher gegraben waren, schnitten sie das äußerste Ende sämtlicher Wurzeln ab, der guten wie der schlechten, und setzten sie in Kompost ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
