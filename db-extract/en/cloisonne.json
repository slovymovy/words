                        "entry_id": "51ae53aa-2ea8-384e-9a3b-035192c125fe",
                        "glosses": [
                            "A decorative technique for metalwork, especially brass, whereby colored enamel is baked in partitions (cloisons) between raised ridges of the metal."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ec22641-cfed-4998-a01d-2899487c9d07",
                                "sense_id": "25e120ea-2f02-3b7b-a28f-fd291daf298d",
                                "text": "Cloisonne is sometimes seen as a cheaper alternative to jewelled encrustation or filigree."
                            },
                            {
                                "example_id": "448d5c20-8918-4864-8892-906a5607654c",
                                "sense_id": "25e120ea-2f02-3b7b-a28f-fd291daf298d",
                                "text": "Zoë wore a pair of cloisonne earrings she had bought in France."
                            }
                        ]
                    },
