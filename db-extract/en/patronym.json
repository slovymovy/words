                                "target_senses": [
                                    {
                                        "sense_id": "1cc6e3c4-2383-334f-9f06-361c83d10831",
                                        "entry_id": "2f8e7664-257c-3206-a5d4-43c2e3a52f33",
                                        "glosses": [
                                            "Personenname, vom Namen des Vaters abgeleiteter Name"
                                        ],
                                        "tags": [
                                            "Onomastik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec252ef4-29c1-4626-9760-b311bb3e0ca7",
                                                "sense_id": "1cc6e3c4-2383-334f-9f06-361c83d10831",
                                                "text": "Ein Name wie „Svensson“ (wörtlich: „Sohn des Sven“) ist ein Beispiel für ein Patronym."
                                            },
                                            {
                                                "example_id": "a3fe72e2-b31b-4385-89a5-0fc78188d864",
                                                "sense_id": "1cc6e3c4-2383-334f-9f06-361c83d10831",
                                                "text": "Viele Patronyme sind zu Familiennamen geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd8faa66-bcbe-4d0a-84d1-9bc6a93f5f25",
                        "source_entry_id": "3c3ef20c-9e74-3907-8aff-6b03f7f67bd2",
                        "source_sense_description": "name of someone's father",
                        "target_lang_word": "Patronymikon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patronymikon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6606530c-bcd7-3211-9e5e-ca2bfafa866d",
                                        "entry_id": "af873d35-bc22-3ba0-8675-da44efb0520c",
                                        "glosses": [
                                            "Bezeichnung, die vom Namen des Vaters abgeleitet ist"
                                        ],
                                        "tags": [
                                            "speziell Onomastik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b25e224-5d3c-469a-b8b0-7a3aeb91808f",
                                                "sense_id": "6606530c-bcd7-3211-9e5e-ca2bfafa866d",
                                                "text": "Der Pelide ist ein Patronymikon, das vom Namen „Peleus“ abgeleitet ist."
                                            },
                                            {
                                                "example_id": "3b20d8fe-b306-4250-9e2a-16fe8f89ff53",
                                                "sense_id": "6606530c-bcd7-3211-9e5e-ca2bfafa866d",
                                                "text": "„Ohne Zweifel gehören die Vaternamen oder Patronymika zu der ältesten Schicht der Familiennamen; wir können ihre Ausbildung an zahlreichen urkundlichen Belegen verfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b694612-4478-4965-9ad8-c867fd6539f6",
                        "source_entry_id": "3c3ef20c-9e74-3907-8aff-6b03f7f67bd2",
                        "source_sense_description": "name of someone's father",
                        "target_lang_word": "Patronymikum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ae9620c2-1119-488b-89af-1c7be380fed6",
                        "source_entry_id": "3c3ef20c-9e74-3907-8aff-6b03f7f67bd2",
                        "source_sense_description": "name of someone's father",
                        "target_lang_word": "Vatername",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vatername",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "630db947-4df5-38da-a768-f9f490640d2a",
                                        "entry_id": "210faafc-a68a-3eb7-b037-5395c8e367b2",
                                        "glosses": [
                                            "Namenszusatz für eine Person, der dem Namen des Vaters entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9672891e-c156-4009-8338-c8aad623818d",
                                                "sense_id": "630db947-4df5-38da-a768-f9f490640d2a",
                                                "text": "„Neben den Vatername konnte eine Person besonders durch den Sippennamen näher bestimmt werden.“"
                                            },
                                            {
                                                "example_id": "45179d1b-a1c1-4bb8-a75f-265314b2f79d",
                                                "sense_id": "630db947-4df5-38da-a768-f9f490640d2a",
                                                "text": "„Solche patronymischen Angaben oder Vaternamen sind noch im Isländischen oder im Russischen üblich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d84fbed-84b2-34af-8e2a-fc1ee0e52ccd",
                                        "entry_id": "210faafc-a68a-3eb7-b037-5395c8e367b2",
                                        "glosses": [
                                            "der den Mitgliedern einer Familie gemeinsame Teil des (vollständigen) Namens"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55870d62-7607-4981-bf66-7c95a1da4d33",
                        "source_entry_id": "3c3ef20c-9e74-3907-8aff-6b03f7f67bd2",
                        "source_sense_description": "name of someone's father",
                        "target_lang_word": "Vatersname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vatersname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecd40381-ed05-3a79-9d76-50f84e05a344",
                                        "entry_id": "44c11d76-e37e-3763-afac-8298f2380b23",
                                        "glosses": [
                                            "Vorname des Vaters als Namensbestandteil seines Kindes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c980d4cb-f933-4976-9f7a-f5f59ff00dbc",
                                                "sense_id": "ecd40381-ed05-3a79-9d76-50f84e05a344",
                                                "text": "Die isländischen Nachnamen sind keine Familien- sondern Vatersnamen."
                                            },
                                            {
                                                "example_id": "6d0dee11-1804-4f6e-89de-cd1a9e57dada",
                                                "sense_id": "ecd40381-ed05-3a79-9d76-50f84e05a344",
                                                "text": "In Russland reden sich Bekannte mit Vor- und Vatersnamen, Freunde mit Kosenamen an."
                                            },
                                            {
                                                "example_id": "e985ac13-60f7-4415-8b61-287232480178",
                                                "sense_id": "ecd40381-ed05-3a79-9d76-50f84e05a344",
                                                "text": "Bei den Tamilen steht der Vatersname vor dem persönlichen Namen."
                                            },
                                            {
                                                "example_id": "7061875c-8d72-4671-b743-56e0785f7de1",
                                                "sense_id": "ecd40381-ed05-3a79-9d76-50f84e05a344",
                                                "text": "„Die Namen sind - soweit sie bisher gelesen werden konnten - typische hebräische Männernamen, oft in der ausführlichen Form von Namen und Vatersnamen, verbunden durch Hebräisch ben oder Aramäisch bar (Sohn des), wie sie im synagogalen Kontext zu erwarten sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ea910f7-963f-39b3-9ba8-222075658fdd",
                                        "entry_id": "44c11d76-e37e-3763-afac-8298f2380b23",
                                        "glosses": [
                                            "der den Mitgliedern einer Familie gemeinsame Teil des (vollständigen) Namens"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
