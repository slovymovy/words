                "senses": [
                    {
                        "sense_id": "bf829697-a1ff-3ff7-b962-29a007c0f531",
                        "entry_id": "26f5cf3a-b9b9-3e8d-aac2-85819a7c837b",
                        "glosses": [
                            "Gegenstand, an dem jemand kleinere handwerkliche oder technische Arbeiten vornimmt, um ihn zu verbessern, zu reparieren oder umzugestalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b6ed12-a833-4a9a-b5b1-f5cad2e31a52",
                                "sense_id": "bf829697-a1ff-3ff7-b962-29a007c0f531",
                                "text": "„Himmeli ist eine aufwendige Bastelei aus Stroh, die in Finnland, Litauen, Lettland, Schweden und in der Ukraine eine beliebte Weihnachtsdekoration darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86630b9c-f6f9-3c36-8326-4a8d3c7c48f2",
                        "entry_id": "26f5cf3a-b9b9-3e8d-aac2-85819a7c837b",
                        "glosses": [
                            "permanentes und von anderen meist als lästig empfundenes Werkeln an etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5ac0c4-db2f-4428-8f98-6ac95c56ae7f",
                                "sense_id": "86630b9c-f6f9-3c36-8326-4a8d3c7c48f2",
                                "text": "„Wo man es mit ‚armen‘ Baustoffen zu tun hatte, kamen meist architektonisch wenig ansprechende ökologische Experimente heraus – und das Selbstbauen, Reparieren und Umbauen wurde sowieso schnell als krude Bastelei von Aussteigern mit ideologisch eingeschränkter Weltsicht abgetan.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b453949d-90ff-41c7-a5ab-ab093a6475fe",
                        "source_entry_id": "26f5cf3a-b9b9-3e8d-aac2-85819a7c837b",
                        "source_sense_id": "bf829697-a1ff-3ff7-b962-29a007c0f531",
                        "source_sense_description": "Gegenstand, an dem jemand kleinere Arbeiten vornimmt",
                        "target_lang_word": "handicraft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handicraft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64651f73-97ed-3eba-80f5-89e1f1b508ee",
                                        "entry_id": "0e1acd14-a9d9-3137-aaa1-27c8830b2327",
                                        "glosses": [
                                            "A trade requiring skill of hand; manual occupation; handcraft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be86f32-48d0-4ae3-b3d6-830da36da641",
                                                "sense_id": "64651f73-97ed-3eba-80f5-89e1f1b508ee",
                                                "text": "I regard the Grand Seignior , who is obliged , by an express command in the Alcoran , to learn and practise some handicraft trade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7edb682-f883-369d-9156-b558bb380845",
                                        "entry_id": "0e1acd14-a9d9-3137-aaa1-27c8830b2327",
                                        "glosses": [
                                            "An artifact produced by handicraft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                        "entry_id": "0e1acd14-a9d9-3137-aaa1-27c8830b2327",
                                        "glosses": [
                                            "A man who earns his living by handicraft; a handicraftsman."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67cf9792-0338-407c-8387-2615fc97fae6",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "his men were all baſe handie craftes, as coblers, and curriers, and tinkers, whereof ſome had barres of yron[…]"
                                            },
                                            {
                                                "example_id": "429a24b0-e506-45bd-9a22-ade5648a0bb3",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "the Handicrafts-Shops begin to open"
                                            },
                                            {
                                                "example_id": "8cc8df27-137e-47a4-801f-9f099bc7755a",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "The M[e]chanicks, and handy-crafts were Induſtrious, Thrifty, and the main ſupporters of the Trade of France."
                                            },
                                            {
                                                "example_id": "a40d441d-20f5-4c03-ac8e-ca1ded69e51a",
                                                "sense_id": "a6ac211a-294f-3636-ad2c-2077976dcf0e",
                                                "text": "\"Why, thou knowest, father,\" he said, smiling, \"that we handicrafts best love the folks we live by;[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "898ccc0d-c2e9-4652-9469-2cfd14d73bcd",
                        "source_entry_id": "26f5cf3a-b9b9-3e8d-aac2-85819a7c837b",
                        "source_sense_id": "bf829697-a1ff-3ff7-b962-29a007c0f531",
                        "source_sense_description": "Gegenstand, an dem jemand kleinere Arbeiten vornimmt",
                        "target_lang_word": "bricolage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bricolage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3370ac6e-e6a8-357c-8ac4-32f7dd52c8fd",
                                        "entry_id": "15614983-88b9-3422-965c-21f0f732f986",
                                        "glosses": [
                                            "Activité manuelle visant à réparer, ou fabriquer des petits objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c987b0-e286-4314-bfb9-89185779c0b3",
                                                "sense_id": "3370ac6e-e6a8-357c-8ac4-32f7dd52c8fd",
                                                "text": "Dans sa passion pour le bricolage, cet homme pratiquement analphabète, au tempérament rude, se mit à « réparer » tout ce que la maison comportait de gadgets, y compris ceux qui fonctionnaient parfaitement bien."
                                            },
                                            {
                                                "example_id": "a0f9c785-ceff-4f8c-b9c2-cc885b4d3c32",
                                                "sense_id": "3370ac6e-e6a8-357c-8ac4-32f7dd52c8fd",
                                                "text": "J’aime mon lieu de vie tel qu’il est, assez rustique, sauvage et vivant, pour ne pas ressembler à un cliché dans La Maison de Marie-Claire – soyons honnête, je n’en ai pas les moyens et pourtant je suis une pro dans l’art de la récup’ et du bricolage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83de3db7-76fe-3133-9c01-1105426b6538",
                                        "entry_id": "15614983-88b9-3422-965c-21f0f732f986",
                                        "glosses": [
                                            "Activité manuelle visant à réparer, ou fabriquer des petits objets.",
                                            "Coupage et collage de matériaux, pour donner un travail artistique."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca54b4e-bdb5-4981-b122-13970901c044",
                                                "sense_id": "83de3db7-76fe-3133-9c01-1105426b6538",
                                                "text": "Nous allons faire du bricolage. Apporte des ciseaux, de la colle, des crayons et du carton pour que nous fassions un œuf de Pâques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ebc5a6e-adde-3947-be95-59e44a4bc390",
                                        "entry_id": "15614983-88b9-3422-965c-21f0f732f986",
                                        "glosses": [
                                            "Travail amateur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf67ce09-1851-4d93-82fc-39c7784571b1",
                                                "sense_id": "7ebc5a6e-adde-3947-be95-59e44a4bc390",
                                                "text": "C’est tout le paradoxe du fonctionnement de ces pensions marrons. Elles sont pointées du doigt pour leur prise en charge qui ressemble à du bricolage sanitaire et même médical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
