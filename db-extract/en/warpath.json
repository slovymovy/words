                        "entry_id": "6ce7bf6e-2591-3eb4-9a25-fd468278ac39",
                        "glosses": [
                            "The route taken by a party of Native Americans going on a warlike expedition."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "dd055a3c-aa56-46f7-bc2f-5aeb6e0960d3",
                                "sense_id": "27910902-7178-3039-aa33-56a09c9a25e0",
                                "text": "He went often to visit the spot where the women had buried her, and sat musing there, when, it was thought, by some of his friends, he would have done better to try to amuse himself in the chase, or by diverting his thoughts in the war-path."
                            }
                        ]
