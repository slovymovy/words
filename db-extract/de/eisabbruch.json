                        "glosses": [
                            "Vorgang, bei dem ein Teil von einem Gletscher abbricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ae7b896-14c0-4161-9c7b-e453f5ab4aa9",
                                "sense_id": "7646aba2-13c1-3dda-a463-8176689039be",
                                "text": "„Ein Eisabbruch löste die Lawine aus, die Schneemassen rauschten unterhalb des Lagers 1 den Berg hinab.“"
                            },
                            {
                                "example_id": "03a3f8af-5d95-44fb-af1c-29f3cdede191",
                                "sense_id": "7646aba2-13c1-3dda-a463-8176689039be",
                                "text": "„Am 5. August 2010 erlangte der Gletscher internationale Aufmerksamkeit, als es an seiner Zunge zum größten Eisabbruch in der Arktis seit 1962 kam.“"
                            }
