                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8126d126-78b8-4a3d-9e06-8773fdeabe5f",
                                "sense_id": "934f312e-b511-34aa-94a6-0ec8a832a4b7",
                                "text": "Bardziej z dupy argumentu nie było na składzie? Zbiorkomem na pewno szybciej rozwieziesz tych ludzi niż autami.",
                                "translation": "There wasn't a bullshit argument in stock? You'll get those people there faster with mass transit much faster than with cars.",
                                "english": "There wasn't a bullshit argument in stock? You'll get those people there faster with mass transit much faster than with cars."
                            },
                            {
                                "example_id": "5524d0f5-8180-47fd-b1db-f72bff24c250",
                                "sense_id": "934f312e-b511-34aa-94a6-0ec8a832a4b7",
                                "text": "A z resztą zgoda - dojazd zbiorkomem jest na Służewiec koszmarny.",
                                "translation": "I agree with the others - mass transit to Służewiec is nightmarish.",
                                "english": "I agree with the others - mass transit to Służewiec is nightmarish."
                            }
                        ]
                    }
