                        "cross_references": [
                            {
                                "target_word": "troop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5c05aea-00f5-36f4-8f52-5e00425cf5fc",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "A collection of people; a number; a multitude (in general)."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "245f6bd1-3447-463f-9fa1-c7627b2fb7f1",
                                                "sense_id": "d5c05aea-00f5-36f4-8f52-5e00425cf5fc",
                                                "text": "That which should accompany old age — / As honour, love, obedience, troops of friends — / I must not look to have."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d19a85-970a-3f8a-be5d-0ab59c799a18",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "A small unit of cavalry or armour commanded by a captain, corresponding to a platoon or company of infantry."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a80bd9c-415d-3bcb-989b-cf0842d2dc05",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "A detachment of soldiers or police, especially horse artillery, armour, or state troopers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e89279a-8259-36e1-b68a-23a281346128",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "A group of soldiers; military forces."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "297d4793-f5c7-43ae-9073-6046021d3cac",
                                                "sense_id": "3e89279a-8259-36e1-b68a-23a281346128",
                                                "text": "Ah, knovv you not the Citie fauours them, / And they haue troupes of Souldiers at their beck?"
                                            },
                                            {
                                                "example_id": "0dde0a75-1948-4cea-9de4-6a901929fe12",
                                                "sense_id": "3e89279a-8259-36e1-b68a-23a281346128",
                                                "text": "Farewell the plumed troop, and the big wars."
                                            },
                                            {
                                                "example_id": "8a4247e2-6523-491f-8a74-ca8df04ee46e",
                                                "sense_id": "3e89279a-8259-36e1-b68a-23a281346128",
                                                "text": "His troops moved to victory with the precision of machines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7afd9d30-6d34-3cdb-a1b8-4f0a86d171e7",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "An individual soldier or member of a military force; a trooper."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35514098-b5da-47d3-b305-a7038c9f98e7",
                                                "sense_id": "7afd9d30-6d34-3cdb-a1b8-4f0a86d171e7",
                                                "text": "One American M48 was slightly grazed and one American troop lightly wounded."
                                            },
                                            {
                                                "example_id": "8af28850-45b4-401b-970f-188856178b80",
                                                "sense_id": "7afd9d30-6d34-3cdb-a1b8-4f0a86d171e7",
                                                "text": "Although the mission failed, at least 5 ISIL militants were killed, however 1 American troop was wounded. According to the reports, Jordan had a role in the operation and that one Jordanian soldier had been wounded as well."
                                            },
                                            {
                                                "example_id": "fa5d6de4-1ed3-4006-ad91-09eb9f546932",
                                                "sense_id": "7afd9d30-6d34-3cdb-a1b8-4f0a86d171e7",
                                                "text": "2022, CNN, First Russian troop to speak out publicly against Putin’s war. Hear what he has to say (archived)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df2c91fe-9181-3596-904a-839961f40357",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "A company of actors; a troupe."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ff0d99-4dab-4a26-a6d1-5c5453b890ea",
                                                "sense_id": "df2c91fe-9181-3596-904a-839961f40357",
                                                "text": "In order to form the new troop to a greater degree of perfection, the four principal actors were placed in the seminary of the cadets"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1474411e-5f5e-3a5c-96cd-38d56919e67d",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "A chapter of a national girl or boy scouts organization, consisting of one or more patrols of 6 to 8 youngsters each."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48642573-d9af-4959-a0fe-591897968574",
                                                "sense_id": "1474411e-5f5e-3a5c-96cd-38d56919e67d",
                                                "text": "Lord Baden-Powell of Gilwell (1920), Aids To Scoutmastership, page 6: “It is the Patrol System that makes the Troop, and all Scouting for that matter, a real co-operative effort.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f78be254-2c69-3706-a48f-3b60a8f1213a",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
                                        "glosses": [
                                            "A group of monkeys."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a465c5d-982b-3c48-a3be-89808420ae7f",
                                        "entry_id": "541084ef-1a79-3edc-a30e-164f86910d22",
