{
    "word_family": [
        "waive",
        "waivable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a89a51d1-c24f-30a1-b6e1-9080db4065b4",
                    "sense_definition": "A legal document or formal agreement that removes a requirement or gives up a right.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_relinquishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to sign a <w>waiver</w> when I went skydiving, agreeing not to sue even if something went wrong.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось подписать <w>отказ</w> от претензий, когда я пошел прыгать с парашютом, согласившись не подавать в суд, даже если что-то пойдет не так."
                            }
                        },
                        {
                            "text": "The company asked all participants to sign a liability <w>waiver</w> before the event started.",
                            "target_lang_translations": {
                                "ru": "Компания попросила всех участников подписать <w>освобождение</w> от ответственности перед началом мероприятия."
                            }
                        }
                    ],
                    "synonyms": [
                        "release",
                        "disclaimer",
                        "renunciation"
                    ],
                    "common_phrases": [
                        "liability waiver",
                        "sign a waiver",
                        "waiver request"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический документ или официальное соглашение, отменяющее требование или фиксирующее отказ от права."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказ",
                                "target_lang_sense_clarification": "письменное заявление об отказе от претензий или прав"
                            },
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "от ответственности или обязательств"
                            },
                            {
                                "target_lang_word": "соглашение об отказе",
                                "target_lang_sense_clarification": "от права или требования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aa3cfc1-5a05-3a45-887a-ad3d14a291f1",
                    "sense_definition": "An official permission to ignore a specific rule or requirement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_relinquishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I needed a <w>waiver</w> from the department head to take the course because I didn't have the prerequisites.",
                            "target_lang_translations": {
                                "ru": "Мне потребовалось <w>разрешение</w> от заведующего кафедрой, чтобы записаться на курс, так как у меня не было необходимых предварительных знаний."
                            }
                        },
                        {
                            "text": "The athlete received a medical <w>waiver</w> allowing him to compete despite his recent injury.",
                            "target_lang_translations": {
                                "ru": "Спортсмен получил медицинское <w>освобождение</w>, позволившее ему соревноваться, несмотря на недавнюю травму."
                            }
                        }
                    ],
                    "synonyms": [
                        "exemption",
                        "dispensation"
                    ],
                    "common_phrases": [
                        "medical waiver",
                        "fee waiver",
                        "grant a waiver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное разрешение игнорировать конкретное правило или требование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "от выполнения правила или требования"
                            },
                            {
                                "target_lang_word": "исключение",
                                "target_lang_sense_clarification": "из общих правил"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "на несоблюдение формальных требований"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc850948-620f-38ff-989a-2a9762f3c228",
                    "sense_definition": "The act of intentionally choosing not to insist on a right, claim, or privilege.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_relinquishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>waiver</w> of his right to an attorney was documented by the court.",
                            "target_lang_translations": {
                                "ru": "<w>Отказ</w> от его права на адвоката был задокументирован судом."
                            }
                        },
                        {
                            "text": "The landlord's <w>waiver</w> of the late fee was a one-time gesture of goodwill.",
                            "target_lang_translations": {
                                "ru": "<w>Неприменение</w> арендодателем штрафа за просрочку было разовым жестом доброй воли."
                            }
                        }
                    ],
                    "synonyms": [
                        "relinquishment",
                        "surrender",
                        "abdication"
                    ],
                    "antonyms": [
                        "assertion",
                        "enforcement"
                    ],
                    "common_phrases": [
                        "waiver of rights",
                        "express waiver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт намеренного выбора не настаивать на праве, требовании или привилегии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказ",
                                "target_lang_sense_clarification": "от права, претензии или привилегии"
                            },
                            {
                                "target_lang_word": "неприменение",
                                "target_lang_sense_clarification": "права или санкции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b99fb40-c46f-32d9-b4ac-42033162f899",
                    "sense_definition": "To <w>waive</w>; to give up a right or to remove a requirement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The department <w>waivered</w> the standard application fee for students from low-income families.",
                            "target_lang_translations": {
                                "ru": "Департамент <w>отменил</w> стандартный регистрационный взнос для студентов из малообеспеченных семей."
                            }
                        },
                        {
                            "text": "He was allowed to graduate after the dean <w>waivered</w> the final credit requirement.",
                            "target_lang_translations": {
                                "ru": "Ему разрешили выпуститься после того, как декан <w>сделал исключение</w> для последнего требования по кредитам."
                            }
                        }
                    ],
                    "synonyms": [
                        "waive",
                        "relinquish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказаться от права или отменить требование (глагол)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказаться",
                                "target_lang_sense_clarification": "от права или требования"
                            },
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "требование или сбор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb820c9d-356c-36bc-ab42-a085d2528f8c",
                    "sense_definition": "A misspelling of <w>waver</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His voice <w>waivered</w> as he spoke, though he meant to write that it wavered.",
                            "target_lang_translations": {
                                "ru": "Его голос <w>дрогнул</w>, когда он говорил, хотя он имел в виду написание 'wavered'."
                            }
                        },
                        {
                            "text": "Many people mistakenly use <w>waivered</w> when they mean the person hesitated or shook.",
                            "target_lang_translations": {
                                "ru": "Многие люди ошибочно используют форму 'waivered', когда имеют в виду, что человек <w>заколебался</w> или задрожал."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочное написание слова 'waver' (колебаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "ошибочное написание"
                            },
                            {
                                "target_lang_word": "дрогнуть",
                                "target_lang_sense_clarification": "ошибочное написание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}