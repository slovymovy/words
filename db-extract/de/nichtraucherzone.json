                "senses": [
                    {
                        "sense_id": "1ed83e3a-b0d0-340f-b9b2-674b4485691d",
                        "entry_id": "727eaf45-fbf2-343f-a505-da2a26ec8c86",
                        "glosses": [
                            "bestimmter, räumlicher Bereich, in dem das Tabakrauchen nicht erlaubt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d6e1508-1c9f-475f-b746-42aea3c7def6",
                                "sense_id": "1ed83e3a-b0d0-340f-b9b2-674b4485691d",
                                "text": "„Ob es Raucher- und Nichtraucherzonen gibt - oder ob es sich um ein kleines Kaschemmerl handelt, bei dem sich die Besitzer nur entscheiden mussten: Lassen sie pofeln oder nicht.“"
                            },
                            {
                                "example_id": "f922bd33-7ff4-4044-af75-d7bd32a51897",
                                "sense_id": "1ed83e3a-b0d0-340f-b9b2-674b4485691d",
                                "text": "„In beinahe allen untersuchten Nichtraucherzonen in der Gastronomie wurden die Vorgaben des Tabakgesetzes nicht erfüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
