                                "example_id": "bf089bc0-0bd1-408c-9edd-994915f61387",
                                "sense_id": "96606e0d-176e-3aa4-9b70-1449556552b9",
                                "text": "„Da klang es zart und melodisch in die tiefe Weihnachtsstille hinein: ‚Du, du liegst mir im Herzen!‘“"
                            },
                            {
                                "example_id": "a9dc8ea1-20bb-4924-aebd-48e85a6f3fff",
                                "sense_id": "96606e0d-176e-3aa4-9b70-1449556552b9",
                                "text": "„Befangen von der romantischen Schönheit und der friedlichen Weihnachtsstille dieser Mondnacht verließen beide Freunde wortlos den geheimnisvollen Ort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
