                        "entry_id": "644e0fd8-853b-3173-a1ba-34ca72b284f8",
                        "glosses": [
                            "To cause disagreement or alienation among or within."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a6a9877c-0efa-4f66-af9d-a7319e91aacb",
                                "sense_id": "5b604e90-7f11-369a-bd7a-805be94dfa3b",
                                "text": "If they cannot disunite them by domestic broils, then they engage their neighbours against them."
                            },
                            {
                                "example_id": "022ccafd-c060-4009-89cc-27e4e7278cb8",
                                "sense_id": "5b604e90-7f11-369a-bd7a-805be94dfa3b",
                                "text": "Secrets disunite a family."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe1426b0-4dd4-341b-aa40-74c4f9a7a881",
                        "entry_id": "644e0fd8-853b-3173-a1ba-34ca72b284f8",
                        "glosses": [
                            "To separate, sever, or split."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "48bc1f72-fe8f-4c21-8db1-2658e7df9f09",
                                "sense_id": "fe1426b0-4dd4-341b-aa40-74c4f9a7a881",
                                "text": "I have discovered how to disunite that force and that particle."
                            }
                        ]
                    },
                    {
                        "sense_id": "404b3344-5df7-31f8-b4e4-9a2dba35b3a1",
                        "entry_id": "644e0fd8-853b-3173-a1ba-34ca72b284f8",
                        "glosses": [
                            "To disintegrate; to come apart."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cf68008d-ee44-48f5-afa5-4915de9ba1f7",
                                "sense_id": "404b3344-5df7-31f8-b4e4-9a2dba35b3a1",
                                "text": "You cannot bind me more to you, my lord.\nFarewell till we renew... I trust, renew\nA converse ne'er to disunite again."
                            }
                        ]
                    }
                ],
