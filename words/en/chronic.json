    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ebab9ce-c89d-33ff-b256-8d72bbe242c5",
                    "sense_definition": "Persisting for a long time or constantly recurring, especially of an illness or medical condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient has been suffering from <w>chronic</w> back pain for over ten years.",
                            "target_lang_translations": {
                                "ru": "Пациент страдает от <w>хронической</w> боли в спине уже более десяти лет."
                            }
                        },
                        {
                            "text": "Doctors are looking for new ways to treat <w>chronic</w> cough in elderly patients.",
                            "target_lang_translations": {
                                "ru": "Врачи ищут новые способы лечения <w>хронического</w> кашля у пожилых пациентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "prolonged",
                        "lasting"
                    ],
                    "antonyms": [
                        "acute",
                        "transient"
                    ],
                    "common_phrases": [
                        "chronic pain",
                        "chronic illness",
                        "chronic cough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохраняющийся в течение длительного времени или постоянно повторяющийся, особенно в отношении болезни или медицинского состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хронический",
                                "target_lang_sense_clarification": "о болезни или состоянии"
                            },
                            {
                                "target_lang_word": "затяжной",
                                "target_lang_sense_clarification": "длящийся долгое время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d9ce9a1-395f-34dd-b9a2-8f272a27e814",
                    "sense_definition": "Of a problem or negative situation, continuing over an extended period of time.",
