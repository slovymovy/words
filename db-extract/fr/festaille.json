                                                "sense_id": "fdc8ab7d-0102-31d6-8505-62c16ae93fd1",
                                                "text": "They are feasting on turkey and venison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feasting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0907e48f-7381-3db3-9de7-a8934090d0fd",
                                        "entry_id": "6b7327a5-147b-37d7-b42e-292ba05da52e",
                                        "glosses": [
                                            "A feast, or an occasion on which people or animals feast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6781166c-d232-480f-9d6f-c1348962039e",
                                                "sense_id": "0907e48f-7381-3db3-9de7-a8934090d0fd",
                                                "text": "The lover at last fell ill; he fairly wasted away; and was so unhappy, that he gave up all his feastings and entertainments."
                                            },
                                            {
                                                "example_id": "2935f8c5-3bf7-4924-9522-08d578c53681",
                                                "sense_id": "0907e48f-7381-3db3-9de7-a8934090d0fd",
                                                "text": "There was hooch galore, and meat and feastings, and they took kindly to the new order."
                                            },
                                            {
                                                "example_id": "be1a288b-2f75-4f2a-a45a-3aa48c3f8be3",
                                                "sense_id": "0907e48f-7381-3db3-9de7-a8934090d0fd",
                                                "text": "Despite many feastings, the wolves were hungry again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "211ccaac-002b-4e98-ac25-89efd402d1e6",
