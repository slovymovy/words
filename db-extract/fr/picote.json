                "senses": [
                    {
                        "sense_id": "324937ca-0211-38cd-9809-cc341bd1fcba",
                        "entry_id": "0318a8ca-7f97-39d4-940e-3dfee2cecb76",
                        "glosses": [
                            "Maladie due à la transmission accidentelle du cowpox virus du bovin vers l'Homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e42dd23f-403f-434b-896b-c696239726be",
                                "sense_id": "324937ca-0211-38cd-9809-cc341bd1fcba",
                                "text": "Le coussin du prie-Dieu porte les stigmates de ses longues séances. Il n’a plus de couleur et la trame en est si usée qu’on sent la bourre comme de la picote sous les genoux."
                            },
                            {
                                "example_id": "0de79590-bdfc-4ef4-b68d-2b512f09ff57",
                                "sense_id": "324937ca-0211-38cd-9809-cc341bd1fcba",
                                "text": "Nous comprenons facilement aujourd'hui que les deux virus, celui de la variole et celui de la picote, ont des protéines au moins en partie communes parce qu'ils sont proches cousins, dérivant d'un ancêtre commun."
                            }
                        ]
                    }
