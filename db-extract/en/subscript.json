                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6b3aef7f-7046-40b5-b4d5-11665851be22",
                        "source_entry_id": "c7f7975e-8476-3e38-b2fc-d3b3b855a0b6",
                        "source_sense_description": "a type of lettering form",
                        "target_lang_word": "indice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8c46bc-d5e7-3eaf-80d3-470e40db071d",
                                        "entry_id": "34a19add-e6b1-31b2-9505-f88c06ea76c3",
                                        "glosses": [
                                            "Signe apparent et probable qu’une chose existe ou s'est produite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b494c318-5132-494e-ad0d-04880b5c5298",
                                                "sense_id": "7a8c46bc-d5e7-3eaf-80d3-470e40db071d",
                                                "text": "Le surlendemain […] dans la soirée, la couleur bleue de l'eau, indice des grands fonds, m'apprenait ma sortie du golfe de Panama."
                                            },
                                            {
                                                "example_id": "52f3938a-89e9-4ded-a4f5-6612dedd347f",
                                                "sense_id": "7a8c46bc-d5e7-3eaf-80d3-470e40db071d",
                                                "text": "Les recherches portant sur l’apparition des premiers indices d’anthropisation et l’évolution du signal anthropique sur le territoire français se sont particulièrement multipliées au cours de ces dernières années […]."
                                            },
                                            {
                                                "example_id": "e2f2f38a-8817-4927-a46f-e1a996e4e440",
                                                "sense_id": "7a8c46bc-d5e7-3eaf-80d3-470e40db071d",
                                                "text": "Le cadavre de la victime âgée d’une trentaine d’années a été découvert après des investigations menées à parti ^([sic]) des indices trouvés sur le suspect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34542e69-c2fb-3e75-a5a3-167113555dc3",
                                        "entry_id": "34a19add-e6b1-31b2-9505-f88c06ea76c3",
                                        "glosses": [
                                            "Nombre permettant un classement ou une indexation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eefe5bcb-a8e0-4c34-a958-30e4999e1178",
                                                "sense_id": "34542e69-c2fb-3e75-a5a3-167113555dc3",
                                                "text": "Le crâne morvandeau, en définitive, semble trouver son indice moyen de largeur vers 84, ce qui le classe, sous ce rapport, avec les autres populations du type celtique."
                                            },
                                            {
                                                "example_id": "7cae72d9-d0a7-4c83-9baf-5a796c1cd082",
                                                "sense_id": "34542e69-c2fb-3e75-a5a3-167113555dc3",
                                                "text": "Bien que le système offre en théorie des possibilités infinies, les indices de plus de six chiffres sont généralement peu utiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70684cb4-4397-33f0-b752-b82ca16f69b0",
                                        "entry_id": "34a19add-e6b1-31b2-9505-f88c06ea76c3",
                                        "glosses": [
                                            "Quotient, rapport ou ratio d’un nombre à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daae1183-1ebc-4467-ab27-27111b7f88df",
                                                "sense_id": "70684cb4-4397-33f0-b752-b82ca16f69b0",
                                                "text": "L’indice d’octane d’un carburant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b46b144-dbd6-3ebb-b2b2-8d9d7cacb1a1",
                                        "entry_id": "34a19add-e6b1-31b2-9505-f88c06ea76c3",
                                        "glosses": [
                                            "Indicateur économique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1ff630-88de-46b7-b434-304e5d8e1edc",
                                                "sense_id": "1b46b144-dbd6-3ebb-b2b2-8d9d7cacb1a1",
                                                "text": "C'est ainsi que la quasi-totalité des prix des grands produits industriels connaissent au XIXᵉ siècle un trend orienté à la baisse. Dans la sidérurgie française par exemple, les « fers et aciers ouvrés » passent de l’indice 100 en 1850 à l’indice 72 en 1911."
                                            },
                                            {
                                                "example_id": "70a942c4-937c-4347-9813-fd62ad13893f",
                                                "sense_id": "1b46b144-dbd6-3ebb-b2b2-8d9d7cacb1a1",
                                                "text": "L’indice Dow Jones avait baissé de 508 points dès le 19 et le 20, plus rien n'était cotable, l’affolement fut général et les cotations durent être interrompues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9ad9617-fb39-3bde-873c-f365065c4c3a",
                                        "entry_id": "34a19add-e6b1-31b2-9505-f88c06ea76c3",
                                        "glosses": [
                                            "Notation de moindre corps, placée en position inférieure et à droite d’un élément du texte que l’indice complète; cette notation est utilisée entre autres pour numéroter des éléments d’ensembles dénombrables en mathématique ou exprimer des numéros atomiques en physique; l’indice est symétrique de l’exposant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71b42a27-cfab-3bd4-a5e7-8119f8c6ea8a",
                                        "entry_id": "34a19add-e6b1-31b2-9505-f88c06ea76c3",
                                        "glosses": [
                                            "Entier naturel repérant la position d'un élément dans une séquence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65d9e503-7c76-390b-9bfe-70630f5ced0b",
                                        "entry_id": "34a19add-e6b1-31b2-9505-f88c06ea76c3",
                                        "glosses": [
                                            "Coordonnée caractérisant la position d’une case d’un tableur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
