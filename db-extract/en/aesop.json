                        "glosses": [
                            "An Ancient Greek author, famous for the fables ascribed to him."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8d5b39b-b1f2-4ad7-a1ed-19fa8388fd27",
                                "sense_id": "850b460b-3e48-3af3-a5e2-5221ca3fcc23",
                                "text": "I'll win them by politeness, and... and... show them that I've nothing to do with that Aesop, that buffoon, that Pierrot, and have merely been taken in over this affair, just as they have."
                            }
                        ]
