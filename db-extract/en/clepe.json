                "senses": [
                    {
                        "sense_id": "b9d88dad-7ff3-35fd-9773-9d9e52f709ae",
                        "entry_id": "adbb5068-70dd-3e48-b559-01efb368d4d7",
                        "glosses": [
                            "To give a call; cry out; appeal."
                        ],
                        "tags": [
                            "archaic",
