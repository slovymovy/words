                {
                    "sense_id": "05822368-b24a-3035-85cb-9b66f29fe526",
                    "sense_definition": "When; used to refer to a past event.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you remember <w>since</w> we lay all night in the windmill?",
                            "target_lang_translations": {
                                "ru": "Ты помнишь, <w>как</w> мы всю ночь пролежали на мельнице?",
                                "nl": "Herinner je je nog <w>toen</w> we de hele nacht in de windmolen lagen?",
                                "pl": "Pamiętasz, <w>jak</w> leżeliśmy całą noc w wiatraku?",
                                "de": "Erinnerst du dich, <w>als</w> wir die ganze Nacht in der Windmühle lagen?",
                                "fr": "Te souviens-tu de <w>quand</w> nous sommes restés allongés toute la nuit dans le moulin ?",
                                "it": "Ti ricordi <w>di quando</w> siamo rimasti sdraiati tutta la notte nel mulino a vento?",
                                "cs": "Pamatuješ si, <w>jak</w> jsme celou noc leželi ve větrném mlýně?",
                                "tr": "Bütün gece yel değirmeninde yattığımız <w>zamanı</w> hatırlıyor musun?",
                                "es": "¿Te acuerdas de <w>cuando</w> pasamos toda la noche acostados en el molino de viento?"
                            }
                        },
                        {
                            "text": "It is a long time <w>since</w> we were happy together.",
                            "target_lang_translations": {
                                "ru": "Прошло много времени с тех пор, <w>как</w> мы были счастливы вместе.",
                                "nl": "Het is lang geleden <w>dat</w> we gelukkig waren samen.",
                                "pl": "Minęło dużo czasu, <w>odkąd</w> byliśmy razem szczęśliwi.",
                                "de": "Es ist lange her, <w>seit</w> wir zusammen glücklich waren.",
                                "fr": "Il y a bien longtemps <w>depuis que</w> nous étions heureux ensemble.",
                                "it": "È passato molto tempo <w>da quando</w> eravamo felici insieme.",
                                "cs": "Je to už dlouho, <w>co</w> jsme spolu byli šťastní.",
                                "tr": "Birlikte mutlu olduğumuz <w>günlerden bu yana</w> uzun zaman geçti.",
                                "es": "Ha pasado mucho tiempo <w>desde que</w> éramos felices juntos."
                            }
                        }
