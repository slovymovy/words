                ],
                "senses": [
                    {
                        "sense_id": "45480656-d15e-3c14-9742-82955bdf6805",
                        "entry_id": "317cda4f-cabe-36e5-8304-6b5db0e76386",
                        "glosses": [
                            "книжн. соотносимый, связываемый или соотносящий, связывающий с чем-либо; служащий для соотнесения с чем-либо, привязки к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f1c382-8ec4-479f-8f51-f614bf24358a",
                                "sense_id": "45480656-d15e-3c14-9742-82955bdf6805",
                                "text": "При этом у каждого этноса или этнической группы есть свой собственный набор референтных этнических групп, предопределенный историей нации, а в каждом этническом самосознании складывается своеобразная иерархия значимых иноэтнических общностей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57fba4f5-9bda-4632-a9f9-ec69a995cf9b",
                        "source_entry_id": "317cda4f-cabe-36e5-8304-6b5db0e76386",
                        "source_sense_id": "45480656-d15e-3c14-9742-82955bdf6805",
                        "target_lang_word": "reference",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e23158-42cb-3381-9c7a-439c95dde38e",
                                        "entry_id": "cb21f390-f692-3316-bddf-aa4e7c039794",
                                        "glosses": [
                                            "A relationship or relation (to something)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "literary",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa79741e-94c6-4694-abf0-9b432118ad04",
                                                "sense_id": "b3e23158-42cb-3381-9c7a-439c95dde38e",
                                                "text": "A man is beloued of a man, in that he is a man, but all theſe are farre more eminent and great, when they ſhal proceed from a ſanctified ſpirit, that hath a true touch of Religion, and a reference to God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6fec048-c849-3084-b036-fa7ff5738c88",
                                        "entry_id": "cb21f390-f692-3316-bddf-aa4e7c039794",
                                        "glosses": [
                                            "A measurement one can compare (some other measurement) to."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "666499b8-692a-31e0-9428-1c3fa393cd63",
                                        "entry_id": "cb21f390-f692-3316-bddf-aa4e7c039794",
                                        "glosses": [
                                            "Information about a person, provided by someone (a referee) with whom they are well acquainted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f813cc01-861c-40c7-a805-ceb4d88043d0",
                                                "sense_id": "666499b8-692a-31e0-9428-1c3fa393cd63",
                                                "text": "Changes will befall, and friends may part, / But distance only cannot change the heart / And were I call’d to prove th’ assertion true, / One proof should serve—a reference to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0e66ba8-2caa-3832-8c16-79509a411763",
                                        "entry_id": "cb21f390-f692-3316-bddf-aa4e7c039794",
                                        "glosses": [
                                            "A person who provides this information; a referee."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c18e661a-82d1-37d6-9e29-72bc29748ac6",
                                        "entry_id": "cb21f390-f692-3316-bddf-aa4e7c039794",
