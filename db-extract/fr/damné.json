                    {
                        "sense_id": "626202c6-db89-37e0-aa43-5b15ff1ac03a",
                        "entry_id": "6544cfe7-8356-3d03-bc02-aefc147f21db",
                        "glosses": [
                            "Qui est condamné aux peines de l’enfer, qui est puni des peines de l’enfer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "355a8e64-e3b7-470e-9903-ea61dc09da7d",
                                "sense_id": "626202c6-db89-37e0-aa43-5b15ff1ac03a",
                                "text": "Tu es damné à jamais."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c40f8da-387f-301c-87b6-bb111d029838",
                        "entry_id": "6544cfe7-8356-3d03-bc02-aefc147f21db",
                        "glosses": [
                            "Qui cause de la colère ou de l’impatience."
                        ],
                        "tags": [
                            "familiar",
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "0d8452ad-4af4-4905-ac3f-3d3b04b48d1d",
                                "sense_id": "1c40f8da-387f-301c-87b6-bb111d029838",
                                "text": "Cette damnée affaire me fait perdre mon temps."
                            },
                            {
                                "example_id": "310b25e7-7201-46b5-baed-127b098ad557",
                                "sense_id": "1c40f8da-387f-301c-87b6-bb111d029838",
                                "text": "L’orfèvre. – Jeune ! jeune ! cela vous plaît à dire. On n’est pas jeune avec une barbe comme celle-là ; et cependant Dieu sait si leur damnée de musique me donne envie de danser !"
                            }
                        ]
                    }
                ],
