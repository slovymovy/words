                ],
                "senses": [
                    {
                        "sense_id": "01ebf09d-9d13-3e03-be01-36b459b9b1f1",
                        "entry_id": "660ff820-12ca-3918-8635-1a6d40945f69",
                        "glosses": [
                            "Considérer en fonction du Talmud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75eaeb55-d977-4d5e-aa42-9cdffcfbda86",
                                "sense_id": "01ebf09d-9d13-3e03-be01-36b459b9b1f1",
                                "text": "L’une d’elles, inattendue, est une certaine libération par rapport à la Loi en tant qu’écrit qu’il faudrait talmudiser à l’infini."
                            },
                            {
                                "example_id": "daf77f11-d389-4691-ad36-7bad73ca4b52",
                                "sense_id": "01ebf09d-9d13-3e03-be01-36b459b9b1f1",
                                "text": "Sans doute, disent-ils, de nos jours, on fignole, on raffine, on sophistique mais on ne fait jamais que talmudiser."
                            },
                            {
                                "example_id": "28b872c1-4686-4aec-883f-1aa075419bdf",
                                "sense_id": "01ebf09d-9d13-3e03-be01-36b459b9b1f1",
                                "text": "Ce sont des morceaux des livres, tous interminables, que Kafka écrivit, qui sont là, étudiés, talmudisés, dans sa correspondance."
                            }
                        ]
                    },
                    {
                        "sense_id": "cde2b0d6-da4c-3d6c-8efb-cd7bacff84a3",
                        "entry_id": "660ff820-12ca-3918-8635-1a6d40945f69",
                        "glosses": [
                            "Soumettre à l'influence du Talmud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0861b11-679b-4617-b886-343d96742a21",
                                "sense_id": "cde2b0d6-da4c-3d6c-8efb-cd7bacff84a3",
                                "text": "Le rayonnement du Talmud ne semble pas les avoir atteint, pas plus qu’une bonne fraction des Israélites d’Iran, d’Afghanistan ou des Indes qui furent talmudisés très tardivement."
                            }
                        ]
                    }
                ],
