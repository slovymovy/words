                ],
                "senses": [
                    {
                        "sense_id": "dfb19010-6d38-39d7-ba14-4321a98cd268",
                        "entry_id": "95bacfdc-6a80-3bd6-8e9d-177c6c66acf3",
                        "glosses": [
                            "положить в несколько приёмов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d530a21-48a3-40ac-b19e-ea41b13cd784",
                                "sense_id": "dfb19010-6d38-39d7-ba14-4321a98cd268",
                                "text": "Наложить пюре."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f928bb5-13c9-3173-978b-640d5167a69e",
                        "entry_id": "95bacfdc-6a80-3bd6-8e9d-177c6c66acf3",
                        "glosses": [
                            "соединить, обеспечив контакт с поверхностью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a577fc39-9f1f-4ed7-b099-392326651618",
                                "sense_id": "6f928bb5-13c9-3173-978b-640d5167a69e",
                                "text": "Наложить грим."
                            },
                            {
                                "example_id": "9f3a3be5-8194-48da-bf0c-f81d65477ef4",
                                "sense_id": "6f928bb5-13c9-3173-978b-640d5167a69e",
                                "text": "Наложить шов."
                            },
                            {
                                "example_id": "9a391b2d-7803-487d-89cb-4897547ec5d7",
                                "sense_id": "6f928bb5-13c9-3173-978b-640d5167a69e",
                                "text": "Таз очень узкий. Когда его тянули, пришлось наложить щипцы. От этого голова немного помялась."
                            }
                        ]
                    },
                    {
                        "sense_id": "7129292c-bf5c-3e50-bde6-30bd1b4225dc",
                        "entry_id": "95bacfdc-6a80-3bd6-8e9d-177c6c66acf3",
                        "glosses": [
                            "объединить элементы при монтаже фото, видео, звука"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf89d7cf-59b3-4e2e-be0d-6da27ecbbbbb",
                                "sense_id": "7129292c-bf5c-3e50-bde6-30bd1b4225dc",
                                "text": "Наложить звук."
                            }
                        ]
                    },
                    {
                        "sense_id": "06c805ab-4e59-3f65-97a6-07cbd759d0fc",
                        "entry_id": "95bacfdc-6a80-3bd6-8e9d-177c6c66acf3",
                        "glosses": [
                            "класть, наваливать что-л. в каком-либо количестве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932cd9b3-0b8e-46b2-bebd-de9d01646877",
                                "sense_id": "06c805ab-4e59-3f65-97a6-07cbd759d0fc",
                                "text": "Любители литературы, прочтя нечаянно Задига, хвалили его как святую книгу для того, что ему является светлый дух; но когда я назвал Вольтера его сочинителем, то по многих крестах решились они наложить на себя покаяние."
                            }
                        ]
                    },
                    {
                        "sense_id": "c275eebf-1d0c-330c-83d4-c042bd76bb5f",
                        "entry_id": "95bacfdc-6a80-3bd6-8e9d-177c6c66acf3",
                        "glosses": [
                            "неперех., жарг. испражниться, обычно в стрессовой ситуации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da832c41-303b-4468-a8d3-2cff0d0558d5",
                                "sense_id": "c275eebf-1d0c-330c-83d4-c042bd76bb5f",
                                "text": "— Нашкодил и в штаны наложил со страху?"
                            }
                        ]
                    }
                ],
