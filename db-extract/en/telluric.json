                "senses": [
                    {
                        "sense_id": "6d3d7754-97b1-3e25-a004-10c551cf911b",
                        "entry_id": "55e997f9-94d2-3405-bd33-12780bd875d2",
                        "glosses": [
                            "Pertaining to the Earth, earthly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147033ad-c0c7-4a3d-b5c9-2743d904a106",
                                "sense_id": "6d3d7754-97b1-3e25-a004-10c551cf911b",
                                "text": "My sister always says she loves novels where you feel an elemental strength, primordial, telluric."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf46e2e6-1ca8-3b4a-b8a8-93f08e3e5f89",
                        "entry_id": "55e997f9-94d2-3405-bd33-12780bd875d2",
                        "glosses": [
                            "Containing tellurium in a lower valency than in tellurous compounds."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e122290-2d66-405e-8666-0a2279aae0da",
                        "source_entry_id": "55e997f9-94d2-3405-bd33-12780bd875d2",
                        "source_sense_description": "pertaining to the Earth",
                        "target_lang_word": "aards",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aards",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9d281c19-aa74-359a-83d2-dfaaefaffb1c",
                                        "entry_id": "2d92401a-0876-3bd6-a15e-3654175ab991",
                                        "glosses": [
                                            "betrekking hebbende op de aarde, tot de aarde behorend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e9214e3-6744-44a4-adfa-1a04f16a396b",
                                                "sense_id": "9d281c19-aa74-359a-83d2-dfaaefaffb1c",
                                                "text": "Het vakantieoord lijkt wel het aardse paradijs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1fde59d-ce43-3557-b0d0-f417406b0377",
                                        "entry_id": "2d92401a-0876-3bd6-a15e-3654175ab991",
                                        "glosses": [
                                            "betrekking hebbend op grond of gesteente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a11f4d-cef5-45ff-9e8a-77d36f814bb6",
                                                "sense_id": "b1fde59d-ce43-3557-b0d0-f417406b0377",
                                                "text": "De ronde bergen in de verten kleurden pastelblauw en lila en vormden een mooi contrast met de warme aardse kleuren om mij heen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02c751e5-4bc2-3a54-86fa-3b2866b7b07e",
                                        "entry_id": "2d92401a-0876-3bd6-a15e-3654175ab991",
                                        "glosses": [
                                            "op het huidige leven hier op aarde betrekking hebbend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685c1a79-ffbc-4f2f-bec1-1b0baaab2078",
                                                "sense_id": "02c751e5-4bc2-3a54-86fa-3b2866b7b07e",
                                                "text": "Dit keer met haar gedachten bij meer aardse dingen."
                                            },
                                            {
                                                "example_id": "3c87163e-2c40-495c-ae82-cfa6c52db98c",
                                                "sense_id": "02c751e5-4bc2-3a54-86fa-3b2866b7b07e",
                                                "text": "Hij was als een aardse god die zijn eigen universum schiep."
                                            },
                                            {
                                                "example_id": "7a0bfe9c-f028-4e24-847a-f911475282d0",
                                                "sense_id": "02c751e5-4bc2-3a54-86fa-3b2866b7b07e",
                                                "text": "Eens verlaten wij dit aardse tranendal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "741d2853-a0ca-4b65-8a3f-e61337bc2737",
                        "source_entry_id": "55e997f9-94d2-3405-bd33-12780bd875d2",
                        "source_sense_description": "pertaining to the Earth",
                        "target_lang_word": "tellurique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tellurique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3349278d-ced5-3cf4-be22-029ebc4f4e78",
                                        "entry_id": "f8189301-1cab-3a6d-af19-546470ec2a65",
                                        "glosses": [
                                            "Relatif à la terre ou au sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b89ae9c-dbff-4e7a-9746-b0d8abd9c1b1",
                                                "sense_id": "3349278d-ced5-3cf4-be22-029ebc4f4e78",
                                                "text": "Dans ces milieux se forment souvent les tourbières bombées ou « tourbières à Sphaignes » […]. Elles émergent au-dessus de l’eau tellurique et dans la suite utilisent essentiellement l’eau atmosphérique."
                                            },
                                            {
                                                "example_id": "748d1f8c-270a-4112-b1c8-730850cb9b72",
                                                "sense_id": "3349278d-ced5-3cf4-be22-029ebc4f4e78",
                                                "text": "Ce groupement, qui représente le stade initial des tourbières de transition, s'installe dans les petites cuvettes et les flaques remplies d'eau tellurique (…)."
                                            },
                                            {
                                                "example_id": "6304d4f8-2485-4ce9-82aa-0cca0924344d",
                                                "sense_id": "3349278d-ced5-3cf4-be22-029ebc4f4e78",
                                                "text": "Si les divinités telluriques de Puisaye président à la naissance de Colette, il ne faut pas oublier que les dieux liés à l'eau bercent son destin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8797fda1-7a45-31a4-9e94-84d5028eaba1",
                                        "entry_id": "f8189301-1cab-3a6d-af19-546470ec2a65",
                                        "glosses": [
                                            "Qualifie les planètes similaires à la Terre par leur constitution de roches et de métaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e44972fa-aa64-42ea-b7bd-0c7210303fd5",
                                                "sense_id": "8797fda1-7a45-31a4-9e94-84d5028eaba1",
                                                "text": "Il avait prévu ce processus, l'avait quantifié, et il était finalement parvenu, bravant l'indifférence, voire le scepticisme général, à en publier les résultats sous forme de prédiction observationnelle quelques jours seulement avant l'arrivée de Voyager 1 : « ... Io pourrait être à présent l’objet de type tellurique le plus intensivement chauffé de tout le système solaire... sa surface devrait être sujette à un volcanisme à grande échelle et récurrent, entraînant un dégazage massif... les images de lo par Voyager pourraient révéler une structure et une histoire planétaires considérablement différentes de tout ce qui a été observé auparavant. »"
                                            },
                                            {
                                                "example_id": "2cd623c6-79dd-4a0a-87d1-2fb8166e31e3",
                                                "sense_id": "8797fda1-7a45-31a4-9e94-84d5028eaba1",
                                                "text": "Les biais importants qui affectent l’observation des exoplanètes expliquent que l’attention humaine focalise sur les planètes de type terrestre, dites telluriques, orbitant autour des plus petites étoiles, nommées naines rouges."
                                            },
                                            {
                                                "example_id": "8405935c-edaa-4638-a780-9af540eeaacd",
                                                "sense_id": "8797fda1-7a45-31a4-9e94-84d5028eaba1",
                                                "text": "Jusqu’aux années 1990, nous ne connaissions qu’un seul cas de système planétaire : le système solaire, avec son cortège de planètes telluriques dans la partie interne (Mercure, Vénus, la Terre, Mars), ses planètes géantes dans la partie externe (Jupiter, Saturne, Uranus et Neptune) et ses petits corps rocheux ou glacés – astéroïdes, objets de la ceinture de Kuiper et comètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32a21c28-73cd-3c55-a5cc-9c8031b7010a",
                                        "entry_id": "f8189301-1cab-3a6d-af19-546470ec2a65",
                                        "glosses": [
                                            "Qualifie l’acide produit par la combinaison du tellure avec l’oxygène et les sels formés avec ce métal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f1c35bf-2443-44c9-b7d0-86d768f343c9",
                                                "sense_id": "32a21c28-73cd-3c55-a5cc-9c8031b7010a",
                                                "text": "L’acide tellurique cristallise en gros prismes hexagonaux qui contiennent trois équivalents d’eau."
                                            },
                                            {
                                                "example_id": "652aa30b-ccb6-47c4-8841-741ef715e5f7",
                                                "sense_id": "32a21c28-73cd-3c55-a5cc-9c8031b7010a",
                                                "text": "Cette expérience prouve qu’une température élevée décompose également l’iodure tellurique dans cette combinaison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
