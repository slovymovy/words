                "translations": [
                    {
                        "translation_id": "d7f49c3d-963e-4643-921e-f3ceda4bcb72",
                        "source_entry_id": "14bed0ad-ce2b-36c0-9a38-84463aa2982b",
                        "source_sense_id": "8981bb15-100d-331c-803a-f0120e7fce81",
                        "target_lang_word": "persuasion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persuasion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "192e142b-b4c5-3d6d-9d6f-6c9ba38abaf8",
                                        "entry_id": "d138fa61-badd-3b62-a2a5-7fb0e095e9da",
                                        "glosses": [
                                            "The act of persuading, or trying to do so; the addressing of arguments to someone with the intention of changing their mind or convincing them of a certain point of view, course of action etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "554d7f7a-61e2-454a-93f0-252c8ce2034c",
                                                "sense_id": "192e142b-b4c5-3d6d-9d6f-6c9ba38abaf8",
                                                "text": "With the base unleashed, the White House was unable to broker a compromise, either by persuasion or by pressure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a884be0c-3e1a-3689-a3ef-09b429833884",
                                        "entry_id": "d138fa61-badd-3b62-a2a5-7fb0e095e9da",
                                        "glosses": [
                                            "An argument or other statement intended to influence one's opinions or beliefs; a way of persuading someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1c84282-5f86-4fcd-acba-967a34229dde",
                                                "sense_id": "a884be0c-3e1a-3689-a3ef-09b429833884",
                                                "text": "Not Hermes Prolocutor to the Gods,\nCould vſe perſwaſions more pathetical."
                                            },
                                            {
                                                "example_id": "da5e03d9-3a34-4f62-8804-9ad855543d00",
                                                "sense_id": "a884be0c-3e1a-3689-a3ef-09b429833884",
                                                "text": "Sadie curses, weeps, then, infected by Mr. Hamilton's writhing persuasions, prays and becomes penitent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e694522-4cce-34a2-8b7d-7f38d6c60e17",
                                        "entry_id": "d138fa61-badd-3b62-a2a5-7fb0e095e9da",
                                        "glosses": [
                                            "An argument or other statement intended to influence one's opinions or beliefs; a way of persuading someone.",
                                            "All activity attempting to influence or control others' behavior or profession of beliefs, from convincing to threatening, assault, or battery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9cc72b0-de66-499c-b142-4533aec27827",
                                                "sense_id": "6e694522-4cce-34a2-8b7d-7f38d6c60e17",
                                                "text": "Some of the shopowners were resistant to the extortion, so the mafia did some persuasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "335a17c7-01bb-356a-980d-b347b57a63e9",
                                        "entry_id": "d138fa61-badd-3b62-a2a5-7fb0e095e9da",
                                        "glosses": [
                                            "A strongly held conviction, opinion or belief."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94824323-3fab-462e-a541-72ee1dc5b5c4",
                                                "sense_id": "335a17c7-01bb-356a-980d-b347b57a63e9",
                                                "text": "It is his persuasion that abortion should never be condoned."
                                            },
                                            {
                                                "example_id": "0ecd8a8f-7ede-40f1-86b3-b081482ebb54",
                                                "sense_id": "335a17c7-01bb-356a-980d-b347b57a63e9",
                                                "text": "Social understanding and equality can neither be nurtured through fear, nor intimidation. Surely this goes for people of all sexual persuasions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b6338ee-a51c-3e17-b90f-db21d630f772",
                                        "entry_id": "d138fa61-badd-3b62-a2a5-7fb0e095e9da",
                                        "glosses": [
                                            "One's ability or power to influence someone's opinions or feelings; persuasiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b02b36b7-1f16-3344-8f6f-4de0895cc053",
                                        "entry_id": "d138fa61-badd-3b62-a2a5-7fb0e095e9da",
                                        "glosses": [
                                            "A specified religious adherence, a creed; any school of thought or ideology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19070dd5-fba4-483f-af72-ffe4773f442c",
                                                "sense_id": "b02b36b7-1f16-3344-8f6f-4de0895cc053",
                                                "text": "As a convert from the Baptist persuasion more than 40 years ago, I still feel like an outsider in the church despite the kindness and acceptance of Catholic friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                        "entry_id": "d138fa61-badd-3b62-a2a5-7fb0e095e9da",
                                        "glosses": [
                                            "Another personal, animal or inanimate trait that is not (very) liable to be changed by persuasion, such as sex, gender, ethnicity, origin, profession or nature."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "humorous",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b16772fd-9408-4fca-a10e-3f3f6715f4b9",
                                                "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                                "text": "1871 February 14, J.J., \"More Solution\", Latter-Day Saints Millennial Star, page 105.\nLet us pray that the next generation be all of the male persuasion."
                                            },
                                            {
                                                "example_id": "415ebcbd-d893-4301-925b-43bad5e12280",
                                                "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                                "text": "To say that a woman is of the female persuasion was originally meant for a joke. As such it might pass — once. You might, indeed, refuse to smile; still, you wouldn't feel like invoking the law. But the constant and persistent use of this unfunny bit of fun has grown to be something of a public calamity. It is matter or congratulation, however, that such linguistic lese-majesty is far more common in England than in America."
                                            },
                                            {
                                                "example_id": "ce338b36-f97c-49e7-85c8-b1606ee6b9c6",
                                                "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                                "text": "AND turning for tor the moment from National to local affairs, we note there is a chimpanzee of the female persuasion out at Lincoln Park, of whom it is said that she can do everything but talk."
                                            },
                                            {
                                                "example_id": "ffc94512-7a9b-4914-9eca-5ffee25a829b",
                                                "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                                "text": "This plainly implies that an equine animal either is of the feminine gender or is of the neuter persuasion."
                                            },
                                            {
                                                "example_id": "46a3dfcd-c9c1-432a-b35f-bd90d8682c76",
                                                "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                                "text": "Being a discussion between a Swede and an Australian of the medical persuasion, conversation turned to Pehr Edman who, as a Swedish expatriate, spent many years in Australia heading up the School of Medical Research at St Vincent's Hospital."
                                            },
                                            {
                                                "example_id": "45903202-02a1-4167-81bf-bee2336c1221",
                                                "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                                "text": "The moonlight was bright this night; playing the part of a miniature sun as it reflected off the white faces of the Caucasian troops, but failing to reveal those of the darker persuasion. \"One thing, Charlie can see them better than he can see me.\""
                                            },
                                            {
                                                "example_id": "919388f6-47b0-4e18-9dcd-d5c2f842cc8c",
                                                "sense_id": "a63dc894-13c4-3dd1-b6ba-5e56502bb99a",
                                                "text": "She searched for something to say, something other than, So will this New Year's kiss be of the French persuasion?, and then found herself mumbling, “Vive la France.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7214babc-3292-41c7-bec5-6cad9de56e14",
                        "source_entry_id": "14bed0ad-ce2b-36c0-9a38-84463aa2982b",
                        "source_sense_id": "8981bb15-100d-331c-803a-f0120e7fce81",
                        "target_lang_word": "persuasion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persuasion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caf53baa-5f0a-37b0-8737-f0a8797e1735",
                                        "entry_id": "0e4a9c67-a08e-3975-bbb8-2671cac1fb25",
                                        "glosses": [
                                            "Processus visant à modifier les attitudes, opinions ou comportements d’autrui à l’aide de messages, d’arguments ou d’influences diverses."
                                        ],
                                        "tags": [
                                            "Psychologie sociale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2024fb45-da54-4a88-91a3-d31a0a4e4e30",
                                                "sense_id": "caf53baa-5f0a-37b0-8737-f0a8797e1735",
                                                "text": "Cet orateur a le don de la persuasion."
                                            },
                                            {
                                                "example_id": "eee3fa70-67b0-44c5-8cfd-e5dfc3add609",
                                                "sense_id": "caf53baa-5f0a-37b0-8737-f0a8797e1735",
                                                "text": "Elle a obtenu ce qu'elle voulait par persuasion plutôt que par autorité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87c8b992-2543-3310-8e8b-27ca9a459ed3",
                                        "entry_id": "0e4a9c67-a08e-3975-bbb8-2671cac1fb25",
                                        "glosses": [
                                            "Qualité de ce qui persuade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8da70200-dc07-4fb3-bf7b-187fb96c2e02",
                                                "sense_id": "87c8b992-2543-3310-8e8b-27ca9a459ed3",
                                                "text": "Ce mouvement était inimitable; il avait la canaillerie, l'impudence, la persuasion d'un dresseur, d'un tombeur de femmes."
                                            },
                                            {
                                                "example_id": "b01d91b6-9f9d-4f09-a6ec-978412af2fcb",
                                                "sense_id": "87c8b992-2543-3310-8e8b-27ca9a459ed3",
                                                "text": "La fougue et la persuasion de ses plaidoiries sont remarquables."
                                            },
                                            {
                                                "example_id": "5788f4d7-b73f-4790-a6a7-e3d706e52364",
                                                "sense_id": "87c8b992-2543-3310-8e8b-27ca9a459ed3",
                                                "text": "Un sourire sincère a parfois plus de force de persuasion qu'un long discours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0df27e-6905-3a24-8824-ab26a4e05a2d",
                                        "entry_id": "0e4a9c67-a08e-3975-bbb8-2671cac1fb25",
                                        "glosses": [
                                            "Fait d'être persuadé ; état de celui qui est persuadé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6858aa9-24fa-45d9-9963-5002fb2f98ed",
                                                "sense_id": "0a0df27e-6905-3a24-8824-ab26a4e05a2d",
                                                "text": "Elle est très attachée à moi, j’en ai la persuasion."
                                            },
                                            {
                                                "example_id": "0fcc9ca6-5839-425b-baeb-70334eab5ad3",
                                                "sense_id": "0a0df27e-6905-3a24-8824-ab26a4e05a2d",
                                                "text": "J’ai agi dans la persuasion que vous m’approuveriez."
                                            },
                                            {
                                                "example_id": "69b4e28f-9f9b-4ec8-a884-28d3bfba44ad",
                                                "sense_id": "0a0df27e-6905-3a24-8824-ab26a4e05a2d",
                                                "text": "« Il peut y avoir des gens qui ont poussé la Philosophie au point de vivre dans une parfaite tranquillité dans ce monde, sans aucune persuasion d'une vie à venir, & même avec une forte persuasion du contraire. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
