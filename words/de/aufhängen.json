{
    "word_family": [
        "Aufhänger",
        "Aufhängung"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2556081e-6fd8-3b23-8211-b68bd993d972",
                    "sense_definition": "Etwas an einer dafür vorgesehenen Stelle befestigen, sodass es frei nach unten hängt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "befestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hier an der Garderobe kannst du deine nasse Jacke <w>aufhängen</w>."
                        },
                        {
                            "text": "Wir wollen am kommenden Wochenende ein neues Bild im Wohnzimmer <w>aufhängen</w>."
                        }
                    ],
                    "antonyms": [
                        "abhängen",
                        "abnehmen"
                    ],
                    "common_phrases": [
                        "ein Bild aufhängen",
                        "Wäsche aufhängen"
                    ]
                },
                {
                    "sense_id": "b57f9252-fded-3f53-b957-437b7fe79374",
                    "sense_definition": "Ein Telefongespräch beenden, indem man den Hörer auf die Station legt oder das Gespräch abbricht.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "telefonieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er wurde plötzlich wütend und <w>hängte</w> ohne ein weiteres Wort einfach <w>auf</w>."
                        },
                        {
                            "text": "Nachdem das kurze Gespräch beendet war, <w>hängte</w> sie den Hörer wieder <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "auflegen",
                        "einhängen"
                    ],
                    "common_phrases": [
                        "den Hörer aufhängen",
                        "einfach aufhängen"
                    ]
                },
                {
                    "sense_id": "4d72d579-3c09-3de9-a91c-bce20c2484a4",
                    "sense_definition": "Plötzlich nicht mehr reagieren oder einfrieren (auf Computer oder Software bezogen).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstuerzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Computer hat sich mitten im Spiel plötzlich komplett <w>aufgehängt</w>."
                        },
                        {
                            "text": "Immer wenn ich diese Datei öffne, <w>hängt</w> sich das Programm sofort <w>auf</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich aufhängen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich in Bezug auf Technik"
                        }
                    ]
                },
                {
                    "sense_id": "d35cc32f-f78a-3d55-8511-47b15136a33c",
                    "sense_definition": "Jemanden oder sich selbst durch Strangulieren an einem Seil töten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Verbrecher wurde im späten Mittelalter öffentlich auf dem Marktplatz <w>aufgehängt</w>."
                        },
                        {
                            "text": "Aus tiefer Verzweiflung wollte sich der Gefangene in seiner Zelle <w>aufhängen</w>."
                        }
                    ],
                    "synonyms": [
                        "aufknüpfen",
                        "erhängen"
                    ],
                    "common_phrases": [
                        "sich aufhängen"
                    ]
                },
                {
                    "sense_id": "297a7fe5-65b0-3011-94f9-51ce6cf2cc22",
                    "sense_definition": "Eine Idee, ein Projekt oder eine Präsentation an einem zentralen Leitmotiv festmachen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "konzept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir sollten die gesamte Kampagne an diesem aktuellen Thema <w>aufhängen</w>."
                        },
                        {
                            "text": "Die Journalistin <w>hängte</w> ihren Artikel geschickt an einem persönlichen Einzelschicksal <w>auf</w>."
                        }
                    ],
                    "common_phrases": [
                        "an einem Thema aufhängen"
                    ]
                },
                {
                    "sense_id": "cab209ba-8421-3d7b-ac10-89d155ffb136",
                    "sense_definition": "Jemandem eine lästige, unangenehme oder ungeplante Verpflichtung übertragen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie haben ihm im Büro die Organisation des gesamten Sommerfestes <w>aufgehängt</w>."
                        },
                        {
                            "text": "Warum musst du mir eigentlich immer die unangenehmsten Aufgaben <w>aufhängen</w>?"
                        }
                    ],
                    "synonyms": [
                        "anhängen",
                        "auflasten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c991db20-d338-3a66-b8d1-4eaa83eae573",
                    "sense_definition": "Der Vorgang des Befestigens an einer Stelle; substantivierte Form des Verbs <w>aufhängen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "befestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim <w>Aufhängen</w> der nassen Wäsche im Garten schien die warme Sonne."
                        },
                        {
                            "text": "Das <w>Aufhängen</w> des schweren Spiegels im Flur dauerte fast eine Stunde."
                        }
                    ],
                    "common_phrases": [
                        "beim Aufhängen der Wäsche"
                    ]
                }
            ]
        }
    ]
}