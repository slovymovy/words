                        "examples": [
                            {
                                "example_id": "e8ebe09e-a16c-428e-aa57-070713ae8134",
                                "sense_id": "026a2158-a63c-3104-99df-71baa545e657",
                                "text": "In De Twentsche Courant Tubantia van dinsdag een leesverhaal over het mogelijke vertrek van Stevo van het historische complex De Peuverweide."
                            },
                            {
                                "example_id": "d80a7f85-f09b-43dd-ba41-516f809e3779",
                                "sense_id": "026a2158-a63c-3104-99df-71baa545e657",
                                "text": "Speciaal voor jou hebben we een boek van maar liefst 148 pagina's vol met verhalen, puzzels, kleurplaten, cocktailrecepten en natuurlijk een uitgebreide zomerhoroscoop. We vroegen actrice en schrijfster Marian Mudder om een sexy en spannend leesverhaal te schrijven en onze lezeressen biechtten hun grootste zomergeheimen aan ons op."
                            }
                        ]
                    },
