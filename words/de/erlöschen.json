            "senses": [
                {
                    "sense_id": "b0d56432-f391-3887-927b-8c856358280d",
                    "sense_definition": "von Feuer oder Lichtquellen: aufhören zu brennen oder zu leuchten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feuer_licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als der starke Wind aufkam, <w>erlosch</w> die Kerze auf dem Tisch sofort."
                        },
                        {
                            "text": "Ohne weiteres trockenes Holz <w>erlischt</w> das Feuer nach wenigen Minuten."
                        }
                    ],
                    "synonyms": [
                        "ausgehen",
                        "verlöschen"
                    ],
                    "common_phrases": [
                        "die Kerze erlischt",
                        "das Feuer erlischt"
                    ]
                },
                {
                    "sense_id": "64ea35d1-1789-3c60-9389-864a273f3899",
                    "sense_definition": "die rechtliche Gültigkeit oder Wirksamkeit verlieren; nicht mehr gültig sein",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "recht_gueltigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ihr Anspruch auf Schadenersatz <w>erlischt</w> nach Ablauf der gesetzlichen Frist."
                        },
                        {
                            "text": "Mit der Kündigung des Vertrags ist auch die Betriebserlaubnis endgültig <w>erloschen</w>."
                        }
                    ],
                    "synonyms": [
                        "ablaufen",
                        "verfallen",
                        "auslaufen",
                        "enden"
                    ],
                    "common_phrases": [
                        "der Anspruch erlischt",
                        "die Frist ist erloschen"
                    ]
                },
                {
                    "sense_id": "40e17a2f-3e0c-3965-8789-01e09f3f28fc",
                    "sense_definition": "von Vulkanen: dauerhaft aufhören, vulkanische Aktivität zu zeigen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologen vermuten, dass dieser Vulkan schon vor Jahrtausenden vollständig <w>erloschen</w> ist."
                        },
                        {
                            "text": "Die Forscher befürchten, dass der Vulkan nicht <w>erloschen</w> ist, sondern nur schläft."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "ein erloschener Vulkan"
                    ]
                },
                {
                    "sense_id": "993a7a31-8209-31f6-ba99-ff89a5fba8cc",
                    "sense_definition": "von Geschlechtern oder Dynastien: durch das Fehlen von Nachkommen aufhören zu existieren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dynastie_aussterben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit dem kinderlosen Tod des letzten Herzogs <w>erlosch</w> die traditionsreiche Adelsfamilie."
                        },
                        {
                            "text": "Das einst so mächtige Herrscherhaus ist im späten Mittelalter vollständig <w>erloschen</w>."
                        }
                    ],
                    "synonyms": [
                        "aussterben"
                    ],
                    "common_phrases": [
