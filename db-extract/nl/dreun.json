                "senses": [
                    {
                        "sense_id": "765fb8f7-1b01-343e-b9e0-b826052eb211",
                        "entry_id": "eef9d956-68cc-3748-b52a-a13617271b5f",
                        "glosses": [
                            "een luid laag geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90d78e5f-f340-4ec0-8716-2a6ccd63e93a",
                                "sense_id": "765fb8f7-1b01-343e-b9e0-b826052eb211",
                                "text": "Er klonk een dreun toen het gevaarte omviel."
                            }
                        ]
                    },
                    {
                        "sense_id": "10b08f80-3462-3b81-86c5-4a1e0d16efd3",
                        "entry_id": "eef9d956-68cc-3748-b52a-a13617271b5f",
                        "glosses": [
                            "een harde klap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "616762c7-cee9-46c6-9d52-21a734eaa6b3",
                                "sense_id": "10b08f80-3462-3b81-86c5-4a1e0d16efd3",
                                "text": "Hij verkocht hem een harde dreun."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9e33910-21be-4e57-9778-131d79ad2951",
                        "source_entry_id": "eef9d956-68cc-3748-b52a-a13617271b5f",
                        "source_sense_id": "10b08f80-3462-3b81-86c5-4a1e0d16efd3",
                        "source_sense_description": "een harde klap",
                        "target_lang_word": "bash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7cfebc-744a-3253-931e-83b19adec5c1",
                                        "entry_id": "adbd2934-6fa9-35a6-aa45-5501f36909d6",
                                        "glosses": [
                                            "To strike heavily."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09630173-f10d-4066-b26f-a1b789ca000d",
                                                "sense_id": "8f7cfebc-744a-3253-931e-83b19adec5c1",
                                                "text": "The thugs kept bashing the cowering victim."
                                            },
                                            {
                                                "example_id": "3ad3b768-c1fe-4927-a0c5-744298917cd8",
                                                "sense_id": "8f7cfebc-744a-3253-931e-83b19adec5c1",
                                                "text": "If the engine won't start, bash it with this hammer."
                                            },
                                            {
                                                "example_id": "82b730de-2fb8-4078-b93c-0ec91387b91a",
                                                "sense_id": "8f7cfebc-744a-3253-931e-83b19adec5c1",
                                                "text": "It isn't the creature's fault that it bashed its head against a tree outside our hole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32b1d644-a50e-360a-8517-0af2a9696378",
                                        "entry_id": "adbd2934-6fa9-35a6-aa45-5501f36909d6",
                                        "glosses": [
                                            "To collide; used with into or together."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11962c70-db0e-476a-9296-ae7af8c4a39a",
                                                "sense_id": "32b1d644-a50e-360a-8517-0af2a9696378",
                                                "text": "Don't bash into me with that shopping trolley."
                                            },
                                            {
                                                "example_id": "38c4fb24-548f-4ace-92d6-aad4d0a69324",
                                                "sense_id": "32b1d644-a50e-360a-8517-0af2a9696378",
                                                "text": "The bulls backed apart and ran together, tusks clashing — Ed held his trunk down while Conrad curled his high over his head, out of the way of Ed's tusks as the faces bashed together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d833d6-76ed-3ac8-be81-97344ba837f9",
                                        "entry_id": "adbd2934-6fa9-35a6-aa45-5501f36909d6",
                                        "glosses": [
                                            "To criticize harshly."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd847045-9ded-4733-8307-194149fbd771",
                                                "sense_id": "d7d833d6-76ed-3ac8-be81-97344ba837f9",
                                                "text": "He bashed my ideas."
                                            },
                                            {
                                                "example_id": "804ed87c-7f52-4351-b05d-c39d9fb441b3",
                                                "sense_id": "d7d833d6-76ed-3ac8-be81-97344ba837f9",
                                                "text": "The entertainment industry, the artistic community, and much of the educational establishment, which so profoundly influence American culture, relentlessly assault religion, promote promiscuity, encourage illegitimacy, and bash America."
                                            },
                                            {
                                                "example_id": "12744a50-365f-4543-bd13-234afe6f002e",
                                                "sense_id": "d7d833d6-76ed-3ac8-be81-97344ba837f9",
                                                "text": "This is consistent with new research about to be published by Tax Justice UK that found that, when making the case for a more progressive tax system, bashing the wealthy resonated far less well with voters than specific arguments about closing loopholes and increasing particular taxes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "584b0bb4-215a-3931-90b4-fdd572449314",
                                        "entry_id": "ac9d43eb-c90f-3677-a034-b77ad4e536b6",
                                        "glosses": [
                                            "A forceful blow or impact."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54b367b4-3f08-4c97-8bb4-74b9eb462712",
                                                "sense_id": "584b0bb4-215a-3931-90b4-fdd572449314",
                                                "text": "He got a bash on the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56568329-5ded-3b38-8563-2305abbf49f9",
                                        "entry_id": "ac9d43eb-c90f-3677-a034-b77ad4e536b6",
                                        "glosses": [
                                            "A large party; a gala event."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3125818d-fbf9-4d0e-a14b-a14a48105b54",
                                                "sense_id": "56568329-5ded-3b38-8563-2305abbf49f9",
                                                "text": "They had a big bash to celebrate their tenth anniversary."
                                            },
                                            {
                                                "example_id": "94629f10-9abe-41ce-8c33-5d76b4abff74",
                                                "sense_id": "56568329-5ded-3b38-8563-2305abbf49f9",
                                                "text": "The party level ramps up at Thornaby, where a gaggle of women on a 50th birthday bash join us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd1d6cdf-d6ee-3a02-93f4-d86b04a3f6aa",
                                        "entry_id": "ac9d43eb-c90f-3677-a034-b77ad4e536b6",
                                        "glosses": [
                                            "An attempt at doing something."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e91e28-4b34-442d-b7d0-17999c5b6110",
                                                "sense_id": "dd1d6cdf-d6ee-3a02-93f4-d86b04a3f6aa",
                                                "text": "give something a bash"
                                            },
                                            {
                                                "example_id": "7feb3339-0260-4faa-8da2-52f6059fd493",
                                                "sense_id": "dd1d6cdf-d6ee-3a02-93f4-d86b04a3f6aa",
                                                "text": "I'm not sure I'll be any good at this, but let me have a bash."
                                            },
                                            {
                                                "example_id": "aef8e227-17ec-42a5-8390-d9a8206d8d11",
                                                "sense_id": "dd1d6cdf-d6ee-3a02-93f4-d86b04a3f6aa",
                                                "text": "This was my first bash at macramé, so I'm quite pleased with how it's turned out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6020071-a3f3-34ce-9090-f25a4ba467ff",
                                        "entry_id": "b982c560-9bc6-375c-94c1-078f1bf91a0c",
                                        "glosses": [
                                            "To abash (make ashamed)"
                                        ],
                                        "tags": [
                                            "obsolete",
