    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0e86796-fade-3226-b960-28285e9ca33d",
                    "sense_definition": "Simple past and past participle of <w>divide</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>divided</w> the students into small groups for the project.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>разделил</w> учеников на небольшие группы для работы над проектом.",
                                "tr": "Öğretmen, proje için öğrencileri küçük gruplara <w>böldü</w>.",
                                "zh": "老师为了做项目把学生们<w>分</w>成了几个小组。"
                            }
                        },
                        {
                            "text": "She <w>divided</w> the apple into four equal pieces.",
                            "target_lang_translations": {
                                "ru": "Она <w>разделила</w> яблоко на четыре равные части.",
                                "tr": "Elmayı dört eşit parçaya <w>böldü</w>.",
                                "zh": "她把苹果<w>切成</w>了均等的四块。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола divide.",
                        "tr": "Divide fiilinin geçmiş zaman ve geçmiş zaman ortacı hali.",
                        "zh": "动词 divide 的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделил",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "разделённый",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "böldü",
                                "target_lang_sense_clarification": "geçmiş zaman"
                            },
                            {
                                "target_lang_word": "bölünmüş",
                                "target_lang_sense_clarification": "geçmiş zaman ortacı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分",
                                "target_lang_sense_clarification": "使分开或划分为若干部分"
                            },
                            {
                                "target_lang_word": "划分",
                                "target_lang_sense_clarification": "分割、归类"
                            },
                            {
                                "target_lang_word": "分成",
                                "target_lang_sense_clarification": "使成为若干部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da567969-5917-3ffc-b213-db78ed125367",
                    "sense_definition": "Separated or split into distinct parts or pieces.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>divided</w> lands were distributed among the heirs.",
                            "target_lang_translations": {
                                "ru": "<w>Разделённые</w> земли были распределены между наследниками.",
                                "tr": "<w>Bölünmüş</w> araziler mirasçılar arasında paylaştırıldı.",
                                "zh": "<w>被分割的</w>土地分给了各位继承人。"
                            }
                        },
                        {
                            "text": "We sat in a room <w>divided</w> by a glass partition.",
                            "target_lang_translations": {
                                "ru": "Мы сидели в комнате, <w>разделённой</w> стеклянной перегородкой.",
                                "tr": "Cam bir bölme ile <w>bölünmüş</w> bir odada oturduk.",
                                "zh": "我们坐在一个由玻璃隔断<w>隔开的</w>房间里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split",
                        "separated",
                        "split up",
                        "partitioned"
                    ],
                    "antonyms": [
                        "combined",
                        "undivided"
                    ],
                    "common_phrases": [
                        "divided into parts",
                        "divided attention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделённый или расщеплённый на отдельные части или куски.",
                        "tr": "Belirgin parçalara veya bölümlere ayrılmış.",
                        "zh": "分开的；分割成不同部分的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделённый",
                                "target_lang_sense_clarification": "на части"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölünmüş",
                                "target_lang_sense_clarification": "parçalara ayrılmış"
                            },
                            {
                                "target_lang_word": "ayrılmış",
                                "target_lang_sense_clarification": "kısımlara ayrılmış"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分开的",
                                "target_lang_sense_clarification": "彼此分离的"
                            },
                            {
                                "target_lang_word": "分割的",
                                "target_lang_sense_clarification": "被划分为不同部分的"
                            },
                            {
                                "target_lang_word": "分裂的",
                                "target_lang_sense_clarification": "肢解或割裂的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef7ce4e9-8f6f-3473-b1bf-5c8ec58ce475",
                    "sense_definition": "Characterized by disagreement, conflicting interests, or disunity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Public opinion is deeply <w>divided</w> on this controversial issue.",
                            "target_lang_translations": {
                                "ru": "Общественное мнение по этому спорному вопросу глубоко <w>расколото</w>.",
                                "tr": "Kamuoyu bu tartışmalı konuda derin bir şekilde <w>bölünmüş</w> durumda.",
                                "zh": "公众在这个争议性问题上的意见存在很大<w>分歧</w>。"
                            }
                        },
                        {
                            "text": "The committee remained <w>divided</w> regarding the new policy.",
                            "target_lang_translations": {
                                "ru": "Комитет остался <w>разобщённым</w> в отношении новой политики.",
                                "tr": "Komite, yeni politika konusunda <w>bölünmüş</w> kalmaya devam etti.",
                                "zh": "委员会在新政策上依然意见<w>不一</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disunited",
                        "split"
                    ],
                    "antonyms": [
                        "unified",
                        "undivided",
                        "united"
                    ],
                    "common_phrases": [
                        "deeply divided",
                        "divided opinion",
                        "divided loyalties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся разногласиями, конфликтом интересов или отсутствием единства.",
                        "tr": "Anlaşmazlık, çatışan çıkarlar veya birlik eksikliği ile karakterize edilen.",
                        "zh": "有分歧的；产生裂痕的；意见不一致的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расколотый",
                                "target_lang_sense_clarification": "о мнениях или группах"
                            },
                            {
                                "target_lang_word": "разобщённый",
                                "target_lang_sense_clarification": "лишённый единства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölünmüş",
                                "target_lang_sense_clarification": "fikir ayrılığı yaşayan"
                            },
                            {
                                "target_lang_word": "ayrışmış",
                                "target_lang_sense_clarification": "birlik içinde olmayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有分歧的",
                                "target_lang_sense_clarification": "意见或立场不一的"
                            },
                            {
                                "target_lang_word": "分裂的",
                                "target_lang_sense_clarification": "群体或意见产生严重对立的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45147365-98b8-3e97-a673-aa7356874f2c",
                    "sense_definition": "Describes a road separated into lanes that move in opposite directions by a median.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We drove for hours along the <w>divided</w> highway without seeing a town.",
                            "target_lang_translations": {
                                "ru": "Мы часами ехали по шоссе <w>с разделительной полосой</w>, не видя ни одного города.",
                                "tr": "Hiç kasaba görmeden saatlerce <w>bölünmüş</w> yolda sürdük.",
                                "zh": "我们沿着<w>有分隔带的</w>高速公路开了好几个小时，一个人烟聚集的城镇都没见到。"
                            }
                        },
                        {
                            "text": "It is safer to drive on a <w>divided</w> road at night.",
                            "target_lang_translations": {
                                "ru": "Ночью безопаснее ехать по дороге <w>с разделительной полосой</w>.",
                                "tr": "Geceleyin <w>bölünmüş</w> yolda araba sürmek daha güvenlidir.",
                                "zh": "夜间在<w>设有中央隔离带的</w>道路上行驶更安全。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "divided highway",
                        "divided road"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает дорогу, на которой встречные потоки отделены друг от друга разделительной полосой.",
                        "tr": "Karşı yönlerdeki trafik akışlarının bir orta refüj ile birbirinden ayrıldığı yolları tanımlar.",
                        "zh": "（道路）设有中央分隔带的，双向分道的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с разделительной полосой",
                                "target_lang_sense_clarification": "о дороге"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bölünmüş",
                                "target_lang_sense_clarification": "yol tipi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有中央分隔带的",
                                "target_lang_sense_clarification": "指公路设中间隔离设施"
                            },
                            {
                                "target_lang_word": "双向分道的",
                                "target_lang_sense_clarification": "指对向车道彼此分开的道路"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}