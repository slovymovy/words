                        "entry_id": "bbfcce52-6690-3581-92a9-70986efec3ef",
                        "glosses": [
                            "gelijkvloerse kruising tussen een pad en een spoorweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a6ba1b2-04f9-43c7-bf70-4a00befea8c6",
                                "sense_id": "2668f7ab-5772-3701-b99c-0ea013f79756",
                                "text": "Tussen Geldermalsen en Tiel wordt een overpad over het spoor weggehaald."
                            }
                        ]
