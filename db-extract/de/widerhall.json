                "senses": [
                    {
                        "sense_id": "e2ad14b9-ba36-3f7f-b176-67c0202d7b5e",
                        "entry_id": "9e158666-08b0-32e3-8120-9c12577093c7",
                        "glosses": [
                            "Hall, Laut, der auf ein Hindernis stößt und von dort reflektiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be818c2-65e3-47f9-a6fd-a99407783411",
                                "sense_id": "e2ad14b9-ba36-3f7f-b176-67c0202d7b5e",
                                "text": "„Als sie wieder schlief, glaubte Thomas, in einem fernen Widerhall noch immer diesen für ihn ungewöhnlichen Schrei zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df8c1d9c-aa0e-31a4-91f0-125fcaedeb38",
                        "entry_id": "9e158666-08b0-32e3-8120-9c12577093c7",
                        "glosses": [
                            "Resonanz auf etwas, Wiederkehr von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e7895c37-54c0-4d65-9e52-5853e41faaad",
                                "sense_id": "df8c1d9c-aa0e-31a4-91f0-125fcaedeb38",
                                "text": "„Trotzdem war es wie ein unheimlicher Widerhall aus Cooks Tagen: eine unbekannte Küste bei Nacht, Trommelschläge in der Ferne.“"
                            },
                            {
                                "example_id": "f7ab9acf-4ce6-483b-95b4-94cc2787de3e",
                                "sense_id": "df8c1d9c-aa0e-31a4-91f0-125fcaedeb38",
                                "text": "„Auf ihren vielfältigen Wanderungen der Liebe erkannte Sabina rasch den Widerhall größerer Lieben und Begierden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98c77090-fe14-4e25-a26c-74be96ca689f",
                        "source_entry_id": "9e158666-08b0-32e3-8120-9c12577093c7",
                        "source_sense_id": "e2ad14b9-ba36-3f7f-b176-67c0202d7b5e",
                        "source_sense_description": "Hall, Laut, der auf ein Hindernis stößt und von dort reflektiert wird",
                        "target_lang_word": "yankı",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yankı",
                                "target_lang_code": "tr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ecfc089-5c88-3aa9-8d5d-7976fcb1a747",
                                        "entry_id": "4aa90b37-8cc0-3a29-8d78-2a0cca6e3780",
                                        "glosses": [
                                            "sesin bir yere çarpıp geri dönmesiyle duyulan ikinci ses, aksiseda, inikâs, akis, eko"
                                        ],
                                        "tags": [
                                            "akustik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12e54997-f89a-4c15-984a-95b30e411b24",
                                                "sense_id": "8ecfc089-5c88-3aa9-8d5d-7976fcb1a747",
                                                "text": "Ben kişisiz seyyahı meçhuller caddesinin. Ben yankısından kaçan çocuk kendi sesinin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f2c51ee-7f84-36b4-bac6-59c2ead822e1",
                                        "entry_id": "4aa90b37-8cc0-3a29-8d78-2a0cca6e3780",
                                        "glosses": [
                                            "bir olgunun çevrede uyandırdığı duygu, düşünce, dedikodu gibi tepki, akis, inikâs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ea71ae-f49b-4761-a781-0e9d20decc78",
                                                "sense_id": "0f2c51ee-7f84-36b4-bac6-59c2ead822e1",
                                                "text": "Bu çığlıklar, ağızdan ağıza, kulaktan kulağa geniş yankılarla bütün yurdu kaplıyordu."
                                            }
                                        ]
                                    }
                                ]
