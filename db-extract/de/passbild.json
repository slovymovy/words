                "senses": [
                    {
                        "sense_id": "93a47c58-9e5d-3430-8d2f-a65f8a1e7ccb",
                        "entry_id": "a56c6c0e-97ac-3d67-8519-1f93df77d7f1",
                        "glosses": [
                            "kleinformatige Portraitaufnahme einer Person zum Befestigen in einem Pass oder Ausweis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf505c3-5c0e-42a6-8f39-9fda34022eb0",
                                "sense_id": "93a47c58-9e5d-3430-8d2f-a65f8a1e7ccb",
                                "text": "„Die ausstellenden Behörden verlangen für Passbilder zur Ausstellung von Personalausweisen, Reisepässen und Führerscheinen ein Bildformat von 35 × 45 mm (ohne Rand).“"
                            },
                            {
                                "example_id": "3307e815-a05d-41e7-a049-cafa26677a84",
                                "sense_id": "93a47c58-9e5d-3430-8d2f-a65f8a1e7ccb",
                                "text": "„Als Passbild diente ein verbeultes Gesicht mit abstehenden Ohren und dicker Nase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
