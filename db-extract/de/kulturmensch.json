                "senses": [
                    {
                        "sense_id": "1135b6cb-eec4-3aa4-b4f0-df66f89665ea",
                        "entry_id": "43aa7dca-cb29-3631-a36a-c73c3cb73272",
                        "glosses": [
                            "Mensch, der einem ausgeprägten Kulturvolk angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c49a32e-7139-4525-893d-6b608bde6cec",
                                "sense_id": "1135b6cb-eec4-3aa4-b4f0-df66f89665ea",
                                "text": "„In Wissenschaft als Beruf, einem Vortrag von starkem persönlichem Bekenntnischarakter, liefert Weber dazu eine Art intellektueller Verhaltenslehre: Der moderne Kulturmensch lebe in heterogenen Ordnungen und \"fremdbrüderlichen\" Dauerkonflikten. Arbeit und Wirtschaft, Religion und Recht, Wissenschaft und Kunst hätten als separierte Sphären ihre durchrationalisierten Eigengesetzlichkeiten entwickelt.“"
                            },
                            {
                                "example_id": "3d2138d3-db72-4437-8982-e49ce30b8ae9",
                                "sense_id": "1135b6cb-eec4-3aa4-b4f0-df66f89665ea",
                                "text": "„Die moderne Anthropologie übersieht heute einigermaßen den unsäglich mühevollen Weg vom Urmenschen zum Kulturmenschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8914002-3cbf-32a5-8ce9-9e7bad4b4062",
                        "entry_id": "43aa7dca-cb29-3631-a36a-c73c3cb73272",
                        "glosses": [
                            "Mensch, der seine Freizeit gerne mit Kulturgenüssen wie Lesen oder dem Besuch von Konzerten, Theateraufführungen oder Ausstellungen verbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e675713-9296-4553-bfe8-5ccf9fde53dd",
                                "sense_id": "c8914002-3cbf-32a5-8ce9-9e7bad4b4062",
                                "text": "„Er sieht und fühlt sich durchaus als philosophisch belesener Kulturmensch, der gerne von seinen Theaterbesuchen in Paris erzählt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
