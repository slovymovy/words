                                            {
                                                "example_id": "cc1b35f3-ae03-4167-89c5-090ae239ecfa",
                                                "sense_id": "2a6c165b-85df-3f97-9cf0-889dc5e1952a",
                                                "text": "Zu Silvester gibt es bei uns immer eine leckere Bowle."
                                            },
                                            {
                                                "example_id": "1d29f309-cd82-429f-b8c7-f85fbbf52bea",
                                                "sense_id": "2a6c165b-85df-3f97-9cf0-889dc5e1952a",
                                                "text": "„Wenn die Freunde nicht von der Vergangenheit reden, bei einer Bowle oder einem Punsch, und dabei ihre langen bemalten Porzellanpfeifen rauchen, komponiert Hoffmann wieder.“"
                                            },
                                            {
                                                "example_id": "3b553c96-1019-4160-8f6c-ac094857730d",
                                                "sense_id": "2a6c165b-85df-3f97-9cf0-889dc5e1952a",
                                                "text": "„Damit war die Bestellung beendet, und ehe zehn Minuten um waren, erschien die Bowle, darauf nicht mehr als drei oder vier Waldmeisterblättchen schwammen, nur gerade genug, den Beweis der Echtheit zu führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aca5db1b-6e1e-3084-b899-1d7383303ee9",
                                        "entry_id": "a4d6f29c-c444-3806-a3f6-612a4ec98f27",
                                        "glosses": [
                                            "Gefäß, in dem [1] serviert wird"
                                        ],
