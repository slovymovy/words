            {
                "entry_id": "00366eef-029b-3a69-a1d2-1e03b54455ee",
                "word": "tisserand",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "28464296-3eda-4e6f-8797-0d21d0db5c76",
                        "entry_id": "00366eef-029b-3a69-a1d2-1e03b54455ee",
                        "tags": [
