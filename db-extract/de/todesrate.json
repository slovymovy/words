                "senses": [
                    {
                        "sense_id": "957059ea-9ebc-322d-8b68-4f315cba1004",
                        "entry_id": "4a147130-9276-3793-9065-307fbf6442b5",
                        "glosses": [
                            "Anzahl derjenigen Personen einer untersuchten Gruppe, die sterben (Todesfälle, oft bezogen auf 1 Jahr und 1.000/100.000 Personen, Rate)"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "4605423b-9af4-425a-a85e-18b63da71883",
                                "sense_id": "957059ea-9ebc-322d-8b68-4f315cba1004",
                                "text": "„Die Todesrate hatten wir im letzten Abschnitt eingeführt als Quotient aus Anzahl Todesfälle im Zeitintervall dividiert durch Personenzeit. Als Zeiteinheit wird üblicherweise ein Jahr verwendet.“"
                            },
                            {
                                "example_id": "3ea8a48e-6121-4177-bfac-fbcd31aadb94",
                                "sense_id": "957059ea-9ebc-322d-8b68-4f315cba1004",
                                "text": "„Für New York wurde 1812 eine Todesrate von mehr als 700 pro 10000 Ew. geschätzt.“"
                            },
                            {
                                "example_id": "23c3cab7-75c6-444a-9cf6-68d8c5b675ab",
                                "sense_id": "957059ea-9ebc-322d-8b68-4f315cba1004",
                                "text": "„Fokussiert man altersabhängige Todesraten, so sterben bis zu 2,7/100 um 55jährige Männer den Sekundenherztod, d. h. in der Regel Erwerbstätige und Unterhaltspflichtige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
