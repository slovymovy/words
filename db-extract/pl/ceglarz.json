                    {
                        "sense_id": "7a244890-7780-37a8-9852-4260eeea30b7",
                        "entry_id": "c2842f57-2cb6-389c-974e-377295e011d8",
                        "glosses": [
                            "rzemieślnik wytwarzający cegły, trudniący się ceglarstwem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "000aafc9-74c5-453a-819d-4571b74df64a",
                                "sense_id": "7a244890-7780-37a8-9852-4260eeea30b7",
