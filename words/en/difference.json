{
    "word_family": [
        "differ",
        "different",
        "differential",
        "differentiate",
        "differentiation",
        "differently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "268b41a7-7c66-37b8-b27a-d497865b8259",
                    "sense_definition": "A characteristic or detail that makes one thing distinct from another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are three <w>differences</w> between these two pictures.",
                            "target_lang_translations": {
                                "ru": "Между этими двумя картинками есть три <w>отличия</w>.",
                                "zh": "这两张照片之间有三处<w>区别</w>。"
                            }
                        },
                        {
                            "text": "Can you tell the <w>difference</w> between butter and margarine?",
                            "target_lang_translations": {
                                "ru": "Ты можешь увидеть <w>разницу</w> между сливочным маслом и маргарином?",
                                "zh": "你能<w>区分</w>黄油和人造黄油吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "disparity",
                        "divergence"
                    ],
                    "antonyms": [
                        "sameness"
                    ],
                    "common_phrases": [
                        "tell the difference",
                        "spot the difference",
                        "know the difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеристика или деталь, которая отличает одну вещь от другой.",
                        "zh": "使一事物区别于另一事物的特征或细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличие",
                                "target_lang_sense_clarification": "отличительная черта"
                            },
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "несходство"
                            },
                            {
                                "target_lang_word": "различие",
                                "target_lang_sense_clarification": "качество отличия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区别",
                                "target_lang_sense_clarification": "事物间的不同之处"
                            },
                            {
                                "target_lang_word": "差异",
                                "target_lang_sense_clarification": "事物间的不同点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a90336-233b-3c0c-9863-50eaf8bf91a4",
                    "sense_definition": "A significant change in or effect on a situation or state.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It just won't make much <w>difference</w> to me.",
                            "target_lang_translations": {
                                "ru": "Для меня это не будет иметь большого <w>значения</w>.",
                                "zh": "这对我来说不会有太大<w>影响</w>。"
                            }
                        },
                        {
                            "text": "Your support really made a <w>difference</w> to the team's success.",
                            "target_lang_translations": {
                                "ru": "Твоя поддержка действительно имела <w>значение</w> для успеха команды.",
                                "zh": "你的支持确实对团队的成功起到了关键<w>作用</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a difference",
                        "make no difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительное изменение или влияние на ситуацию или состояние.",
                        "zh": "对某种情况或状态产生的重大改变或影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значение",
                                "target_lang_sense_clarification": "важность, влияние"
                            },
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "в выражениях типа \"какая разница\""
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "影响",
                                "target_lang_sense_clarification": "产生的作用"
                            },
                            {
                                "target_lang_word": "作用",
                                "target_lang_sense_clarification": "对结果产生的影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb35b874-df4b-3dd0-84fe-1347234499fe",
                    "sense_definition": "The quality or state of being unlike or dissimilar.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to learn to be more tolerant of <w>difference</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно научиться быть более терпимым к <w>различиям</w>.",
                                "zh": "你需要学会对<w>差异</w>更加包容。"
                            }
                        },
                        {
                            "text": "The <w>difference</w> in their ages is not important to them.",
                            "target_lang_translations": {
                                "ru": "<w>Разница</w> в их возрасте для них не важна.",
                                "zh": "他们年龄上的<w>差异</w>对他们来说并不重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diversity",
                        "variation",
                        "dissimilarity"
                    ],
                    "antonyms": [
                        "sameness",
                        "identity"
                    ],
                    "common_phrases": [
                        "cultural difference",
                        "celebrate difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние непохожести, несходства.",
                        "zh": "事物之间不相同或不相似的性质或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "различие",
                                "target_lang_sense_clarification": "разнообразие, инаковость"
                            },
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "степень несходства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不同",
                                "target_lang_sense_clarification": "不相同"
                            },
                            {
                                "target_lang_word": "差异",
                                "target_lang_sense_clarification": "不一致的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d7e5ccd-1db3-381f-8666-9df9a7f60d0d",
                    "sense_definition": "The result obtained by subtracting one number from another.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>difference</w> between 21 and 3 is 18.",
                            "target_lang_translations": {
                                "ru": "<w>Разность</w> между 21 и 3 равна 18.",
                                "zh": "21减3的<w>差</w>是18。"
                            }
                        },
                        {
                            "text": "Calculate the <w>difference</w> between your total income and your expenses.",
                            "target_lang_translations": {
                                "ru": "Вычислите <w>разность</w> между вашим общим доходом и расходами.",
                                "zh": "计算你的总收入和支出之间的<w>差额</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "balance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат вычитания одного числа из другого.",
                        "zh": "一个数减去另一个数所得的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разность",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "差",
                                "target_lang_sense_clarification": "数学减法结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b3580f7-d924-31ea-a2b5-dfac98ad1e50",
                    "sense_definition": "A disagreement or argument about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have our little <w>differences</w>, but we are firm friends.",
                            "target_lang_translations": {
                                "ru": "У нас есть небольшие <w>разногласия</w>, но мы крепкие друзья.",
                                "zh": "我们之间有一些小<w>分歧</w>，但我们依然是好朋友。"
                            }
                        },
                        {
                            "text": "They decided to settle their <w>differences</w> privately without lawyers.",
                            "target_lang_translations": {
                                "ru": "Они решили уладить свои <w>разногласия</w> в частном порядке без адвокатов.",
                                "zh": "他们决定私下解决彼此的<w>分歧</w>，不请律师。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conflict",
                        "dispute",
                        "difference of opinion",
                        "dissension"
                    ],
                    "common_phrases": [
                        "settle differences",
                        "resolve differences",
                        "put aside differences"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несогласие или спор по какому-либо поводу.",
                        "zh": "关于某事的意见不合或争论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разногласие",
                                "target_lang_sense_clarification": "спор, отсутствие согласия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分歧",
                                "target_lang_sense_clarification": "意见不一致"
                            },
                            {
                                "target_lang_word": "争执",
                                "target_lang_sense_clarification": "争论不休"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8ac2cf3-4ccd-3986-9d33-4a6f4b2ba923",
                    "sense_definition": "Choice or preference.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "choice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That now he chooseth with vile <w>difference</w> to be a beast.",
                            "target_lang_translations": {
                                "ru": "Что теперь он с гнусным <w>выбором</w> предпочитает быть зверем.",
                                "zh": "他现在卑劣地<w>选择</w>成为一只野兽。"
                            }
                        },
                        {
                            "text": "He exercised his <w>difference</w> with great care in the matter.",
                            "target_lang_translations": {
                                "ru": "Он осуществлял свой <w>выбор</w> в этом вопросе с большой осторожностью.",
                                "zh": "他在这件事上非常谨慎地行使了他的<w>选择权</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature like Spenser."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбор или предпочтение (устаревшее).",
                        "zh": "选择或偏好（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбор",
                                "target_lang_sense_clarification": "устаревшее значение"
                            },
                            {
                                "target_lang_word": "предпочтение",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择",
                                "target_lang_sense_clarification": "挑选"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0621eb3a-0466-3627-b93f-cbaea2a8d374",
                    "sense_definition": "To distinguish or differentiate between things.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The various species are <w>differenced</w> by the shape of their leaves.",
                            "target_lang_translations": {
                                "ru": "Различные виды <w>различаются</w> формой листьев.",
                                "zh": "不同物种通过叶子的形状来加以<w>区分</w>。"
                            }
                        },
                        {
                            "text": "In heraldry, the coat of arms is <w>differenced</w> to indicate a younger branch of the family.",
                            "target_lang_translations": {
                                "ru": "В геральдике герб <w>видоизменяется</w> для обозначения младшей ветви рода.",
                                "zh": "在纹章学中，族徽会进行<w>改动</w>以标示家族的旁系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "differentiate",
                        "distinguish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Различать или проводить различие между вещами.",
                        "zh": "辨别或区分事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "различать",
                                "target_lang_sense_clarification": "находить отличия"
                            },
                            {
                                "target_lang_word": "отличать",
                                "target_lang_sense_clarification": "выделять из других"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区分",
                                "target_lang_sense_clarification": "辨别不同"
                            },
                            {
                                "target_lang_word": "辨别",
                                "target_lang_sense_clarification": "分辨出差异"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}