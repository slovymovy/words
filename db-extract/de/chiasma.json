                "senses": [
                    {
                        "sense_id": "7cad1cf8-b8ca-35de-9582-11ed2f57c0f4",
                        "entry_id": "d7b8a171-a6d0-3fff-bbb0-a0165f059230",
                        "glosses": [
                            "Austausch von Segmenten zwischen zwei homologen Chromosomen während der Prophase I der Meiose"
                        ],
                        "tags": [
                            "Genetik",
                            "Zytologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9e48c88b-8ec1-409d-b53a-dc40df0cc84c",
                                "sense_id": "7cad1cf8-b8ca-35de-9582-11ed2f57c0f4",
                                "text": "F. A. JANSSENS beobachtete während der Meiose von Batrachoseps attenuatus (einem Amphibium) die Überkreuzung einzelner Chromosomenarme im Diplotänstadium und nannte diesen Zustand Chiasma."
                            },
                            {
                                "example_id": "8abde32f-f099-4d5a-a562-daecc24ad5e2",
                                "sense_id": "7cad1cf8-b8ca-35de-9582-11ed2f57c0f4",
                                "text": "\"Es liegt nahe, diese Chiasmata zu den aus Kreuzungsdaten erschlossenen Crossovern in Beziehung zu setzen … Diese Ergebnisse rechtfertigen die Auffassung, daß Crossover und Chiasmata verschiedene Aspekte des gleichen Phänomens sind …\""
                            },
                            {
                                "example_id": "59b03e4a-2d6a-46a0-838c-b181020165d0",
                                "sense_id": "7cad1cf8-b8ca-35de-9582-11ed2f57c0f4",
                                "text": "Durch eine solche „Überkreuzung“ (Chiasma) werden die auf den abgetrennten Teilstücken liegenden Gene aus ihrer bisherigen Koppelungsgruppe gelöst und gegeneinander ausgetauscht."
                            },
                            {
                                "example_id": "1faeb279-aca1-40aa-831a-1a9b8ec6419b",
                                "sense_id": "7cad1cf8-b8ca-35de-9582-11ed2f57c0f4",
                                "text": "Chiasma ist das lichtmikroskopische Erscheinungsbild eines Crossing-overs. Die beiden Begriffe werden oft synonym verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
