                        ],
                        "examples": [
                            {
                                "example_id": "f4540ae8-a1c8-4b53-84e8-3b3b585e8ce7",
                                "sense_id": "24741a5f-405d-32b8-b73c-d5ab928f4319",
                                "text": "the seed with wings attached withstood storage very significantly better than dewinged seed."
                            },
                            {
                                "example_id": "a49ba931-f1fb-41c1-ae74-53b82420f987",
                                "sense_id": "24741a5f-405d-32b8-b73c-d5ab928f4319",
                                "text": "The birds were then dewinged, debeaked, and skinned for tissue sample removal."
                            },
                            {
                                "example_id": "7452f646-c506-4b88-807a-c576ef6a9db6",
                                "sense_id": "24741a5f-405d-32b8-b73c-d5ab928f4319",
                                "text": "1. An apparatus for dewinging a bird […]"
                            },
                            {
                                "example_id": "7430ba9d-3cd7-4cdb-b7f5-c15e8141a3db",
                                "sense_id": "24741a5f-405d-32b8-b73c-d5ab928f4319",
                                "text": "The birds are de-winged after birth to prevent them flying in the house."
                            },
                            {
                                "example_id": "dbbf177a-8718-42cb-88f6-ac10d35e65e5",
                                "sense_id": "24741a5f-405d-32b8-b73c-d5ab928f4319",
                                "text": "A few examples of poultry husbandry practices that have been questioned include the following: / […] 7. Beak trimming, dubbing, dewinging, detoeing, and other hatchery-initiated management practices."
