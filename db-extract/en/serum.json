                                                "sense_id": "0737bfd4-66e2-3913-b2ed-270663e11fce",
                                                "text": "Im Serum finden sich die Antikörper (Agglutinine) Anti-A (a) und Anti-B (ß)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ab28085-5e02-37d9-82c2-1d9a95354f98",
                                        "entry_id": "47f431f5-9e49-3dd3-b7d7-5f17d1d2a355",
                                        "glosses": [
                                            "Immunserum, Antikörper zum Zwecke einer Schutzimpfung"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a47b66c-0093-4c47-b36c-383cad6014fb",
                                                "sense_id": "7ab28085-5e02-37d9-82c2-1d9a95354f98",
                                                "text": "Bei einer passiven Impfung werden nicht Erreger gespritzt, sondern ein Serum mit spezifischen Antikörpern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "07351fe9-3ca7-343a-a741-da87453475ae",
                                        "entry_id": "47f431f5-9e49-3dd3-b7d7-5f17d1d2a355",
                                        "glosses": [
                                            "Gegengift, eine Flüssigkeit, die zur Heilung von Vergiftungen (auch durch Biss- und Stichwunden) eingesetzt wird"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5001a005-1845-4af3-89f3-709fed2f0899",
                                                "sense_id": "07351fe9-3ca7-343a-a741-da87453475ae",
                                                "text": "Von einer Kreuzotter oder Aspisviper gebissen? Dann sollte man sich im Krankenhaus mit einem Serum behandeln lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "29003b70-9631-3a86-b6fa-84a70aa9a63a",
                                        "entry_id": "47f431f5-9e49-3dd3-b7d7-5f17d1d2a355",
                                        "glosses": [
                                            "zähflüssige Darreichungsform"
                                        ],
                                        "tags": [
                                            "Kosmetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f47fd8ee-0167-49eb-b636-f657a54c2f49",
                                                "sense_id": "29003b70-9631-3a86-b6fa-84a70aa9a63a",
                                                "text": "Das Serum mit den Fingerspitzen leicht unter den Augen einklopfen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
