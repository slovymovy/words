                "senses": [
                    {
                        "sense_id": "c39a42e0-906c-3ce9-a48e-465e4858a5ae",
                        "entry_id": "f6e56733-abfa-36ae-9c2b-8e56a7875ce0",
                        "glosses": [
                            "Engloutir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ffc2ee6-bfb5-4dc2-9ec7-ca429ea8834e",
                                "sense_id": "c39a42e0-906c-3ce9-a48e-465e4858a5ae",
                                "text": "Orphée, l'homme aux rats, les tire jusqu'à la fin, où réengloutir les revenants."
                            },
                            {
                                "example_id": "628190ae-7d88-4cb1-bd44-7474bcff4aab",
                                "sense_id": "c39a42e0-906c-3ce9-a48e-465e4858a5ae",
                                "text": "Par cet Évangile, à cette vie terrestre dans laquelle nous allons nous réengloutir, le souffle ne manquera pas, le souffle qui vient de Dieu."
                            }
                        ]
                    }
