                        "sense_id": "d7317dde-5118-3312-87cd-be1bf0ecf64f",
                        "entry_id": "2b58a483-2bfd-3a7c-8917-4d2b0707da1c",
                        "glosses": [
                            "nicht weiterverarbeitetes Fleisch von frisch geschlachteten Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2eec4d3-c802-4da1-8c25-1041f1b9f551",
                                "sense_id": "d7317dde-5118-3312-87cd-be1bf0ecf64f",
                                "text": "Frischfleisch kaufe ich grundsätzlich nur beim Metzger meines Vertrauens."
                            },
                            {
                                "example_id": "908c0999-46f8-4996-8768-fcbadedcb715",
                                "sense_id": "d7317dde-5118-3312-87cd-be1bf0ecf64f",
                                "text": "„Noch schneller als im März 1915 die Preise für Frischfleisch gefallen waren, stiegen sie im Sommer an, weil einfach Tiere im schlachtfähigen Alter fehlten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
