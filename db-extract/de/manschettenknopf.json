                ],
                "senses": [
                    {
                        "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                        "entry_id": "70db2103-fb75-3321-ad42-0e0aead69e35",
                        "glosses": [
                            "Utensil (zwei untereinander verbundene Knöpfe), mit dem das untere Ende des Ärmels eines Herrenhemdes, das keinen Knopf, sondern nur zwei Knopflöcher aufweist, geschlossen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c207b53a-b455-4bee-98c2-4a3ca951ef38",
                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                "text": "„Hier hob Dr. Valenti die Hand, wobei seine goldenen Manschettenknöpfe im Sonnenlicht blitzten.“"
                            },
                            {
                                "example_id": "133ec854-59ff-48cd-a561-c019c9bbba9c",
                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                "text": "„Renate schenkte Opa zum 78. Geburtstag zwei emaillierte Manschettenknöpfe.“"
                            },
                            {
                                "example_id": "476c5a73-6096-49ec-be66-2dd24c9e205c",
                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                "text": "„Alles andere ist zu Gold geworden, das keusche Gold der Manschettenknöpfe, ein goldenes feinmaschiges Uhrenarmband, ein goldenes Cartierfeuerzeug.“"
                            },
                            {
                                "example_id": "c0855828-31ae-425b-b27d-620ef920c98a",
                                "sense_id": "42421ea7-e3b2-34d5-8079-17168e7b1db2",
                                "text": "„Als sie aus dem Schlafzimmer kam, hatte sie die Manschettenknöpfe und die Krawattennadel in der Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
