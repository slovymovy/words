{
    "word_family": [
        "surge",
        "resurge",
        "resurgence",
        "upsurge"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0101c3f3-fda0-3d4d-b1ed-06a6d59083f4",
                    "sense_definition": "present participle and gerund of <w>surge</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported <w>surging</w> profits after the successful launch of their new product.",
                            "target_lang_translations": {
                                "es": "La empresa reportó beneficios <w>en fuerte aumento</w> tras el exitoso lanzamiento de su nuevo producto."
                            }
                        },
                        {
                            "text": "Flood waters were <w>surging</w> down the street during the heavy rainstorm.",
                            "target_lang_translations": {
                                "es": "Las aguas de la inundación <w>se desbordaban con fuerza</w> por la calle durante la intensa tormenta."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surging crowd",
                        "surging demand"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio presente y gerundio de 'surge'; que aumenta repentina y fuertemente o se mueve en tromba."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "creciente",
                                "target_lang_sense_clarification": "que aumenta rápidamente (precios, demanda)"
                            },
                            {
                                "target_lang_word": "en aumento",
                                "target_lang_sense_clarification": "que experimenta un alza súbita"
                            },
                            {
                                "target_lang_word": "desbordándose",
                                "target_lang_sense_clarification": "moverse con fuerza como el agua"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1944045-a240-331f-b23e-55d0d8dfff92",
                    "sense_definition": "The action or an instance of a surge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>surging</w> of the crowd caused panic near the stadium entrance.",
                            "target_lang_translations": {
                                "es": "La repentina <w>oleada</w> de la multitud causó pánico cerca de la entrada del estadio."
                            }
                        },
                        {
                            "text": "Engineers tried to prevent the continuous <w>surging</w> of electrical power in the grid.",
                            "target_lang_translations": {
                                "es": "Los ingenieros intentaron evitar las continuas <w>sobretensiones</w> de energía eléctrica en la red."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Acción o instancia de aumentar repentinamente o abalanzarse con fuerza; oleada o sobretensión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "oleada",
                                "target_lang_sense_clarification": "movimiento impetuoso de personas o agua"
                            },
                            {
                                "target_lang_word": "alza",
                                "target_lang_sense_clarification": "aumento rápido y considerable"
                            },
                            {
                                "target_lang_word": "sobretensión",
                                "target_lang_sense_clarification": "pico o aumento repentino de energía eléctrica"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}