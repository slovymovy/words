                                "example_id": "7e2d3a86-50c7-453c-bce1-6515b117a183",
                                "sense_id": "12837cbb-c660-3e71-b752-d2093d0dc9a0",
                                "text": "„Die ersten deutschen Rollenmarken gab es zur Zeit des Deutschen Kaiserreichs.“"
                            }
