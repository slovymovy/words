                "senses": [
                    {
                        "sense_id": "7df57813-d5dc-3858-9e0a-7c1121583037",
                        "entry_id": "f2bdf649-1c54-3ed1-bd71-6119cdc666f6",
                        "glosses": [
                            "osoba niedowierzająca lub niewierząca"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dfa81ee7-01a5-408b-8b2e-96522ae1feef",
                                "sense_id": "7df57813-d5dc-3858-9e0a-7c1121583037",
                                "text": "Podnieś rękę i włóż ją do mego boku, i nie bądź niedowiarkiem, lecz wierzącym!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "7a4ebfcc-6e7a-3fff-8424-06696e976082",
                        "entry_id": "f2bdf649-1c54-3ed1-bd71-6119cdc666f6",
                        "glosses": [
                            "osoba sceptycznie nastawiona do czegoś przyjmowanego przez innych"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9f63cc02-0e7e-45ea-8649-fde09d4226e7",
                                "sense_id": "7a4ebfcc-6e7a-3fff-8424-06696e976082",
                                "text": "Przeciwnicy ich, niedowiarki, ostrzegają, że na rewolucję za wcześnie, że ludu nie uświadomi nikt w ciągu lat kilku, pod czujnem okiem wroga"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
