                                "target_senses": [
                                    {
                                        "sense_id": "9d7e640a-34e2-3990-8d30-3bd15c6f9fe9",
                                        "entry_id": "e9e4162e-0548-3d11-b5b0-7e551c04b475",
                                        "glosses": [
                                            "der neunte Monat im Jahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5fb79b9-931e-461e-8125-95a64f4b38cf",
                                                "sense_id": "9d7e640a-34e2-3990-8d30-3bd15c6f9fe9",
                                                "text": "Der September folgt auf den August."
                                            },
                                            {
                                                "example_id": "4652f729-06bb-4fc0-b5a7-fde472aaf896",
                                                "sense_id": "9d7e640a-34e2-3990-8d30-3bd15c6f9fe9",
                                                "text": "„Dabei durchläuft die Sonne um den 21. März und den 23. September die Schnittpunkte der Ekliptik mit dem Himmelsäquator; es ist dies die Zeit der Tagundnachtgleichen (Äquinoktien), die beiden Schnittpunkte werden Frühlings- und Herbstpunkt genannt.“"
                                            },
                                            {
                                                "example_id": "2abe8def-6656-4284-9cb1-87e043ebb025",
                                                "sense_id": "9d7e640a-34e2-3990-8d30-3bd15c6f9fe9",
                                                "text": "„Wegen der Erntefülle und der milden Wärme war der September dem alten Millbacher immer der liebste Monat.“"
                                            },
                                            {
                                                "example_id": "638c75c0-fab1-4be0-8c07-5b20cc9fa2c8",
                                                "sense_id": "9d7e640a-34e2-3990-8d30-3bd15c6f9fe9",
                                                "text": "„Solches Wetter herrschte auch am zweiten September in der zehnten Vormittagsstunde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5ffb45f-2817-4a93-a851-4e592d7243e3",
                        "source_entry_id": "3d3df854-7733-384a-af66-be89b73664d0",
                        "source_sense_id": "25e8d366-30dd-32c4-8c78-95adac38a250",
