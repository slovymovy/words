                                "target_senses": [
                                    {
                                        "sense_id": "ba2fd763-96fb-39dd-aa5b-79bf7aebd413",
                                        "entry_id": "3ab0674b-52a2-35d6-b3f4-52c366257d4e",
                                        "glosses": [
                                            "Qui tient à la nuque, qui appartient ou qui a rapport à la nuque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a23c156-dbca-4341-b0bc-9ed5200e2117",
                                                "sense_id": "ba2fd763-96fb-39dd-aa5b-79bf7aebd413",
                                                "text": "Rapidement, l’état de Viktor s’est dégradé. Raideur nucale, forte fièvre, inflammation du foie, de la rate, des poumons et du cœur, problème de pression, bref un portrait inquiétant."
                                            },
                                            {
                                                "example_id": "5d33e987-eda6-4299-8af2-6c35d132745a",
                                                "sense_id": "ba2fd763-96fb-39dd-aa5b-79bf7aebd413",
                                                "text": "D’abord dislocation nucale. Manuelle. Le gosse a dû morfler."
                                            },
                                            {
                                                "example_id": "9dd50cbc-59df-420d-a00a-b1bae990c638",
                                                "sense_id": "ba2fd763-96fb-39dd-aa5b-79bf7aebd413",
                                                "text": "À l'échographie de datation, autour de la douzième semaine de grossesse, le personnel détecte une anomalie de la clarté nucale, un indicateur potentiel de trisomie 21."
                                            }
                                        ]
                                    }
                                ]
                            }
