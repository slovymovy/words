                ],
                "senses": [
                    {
                        "sense_id": "ec6ac50c-3d24-32c7-93d0-fb2f152c9c2f",
                        "entry_id": "fee4b438-4837-3338-b22b-3e52687bc976",
                        "glosses": [
                            "Raum zur Aufnahme von Körperausscheidungen von nicht ständig in einer Wohnung Wohnenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67edeb48-03a4-4ce4-bcc8-7c806912a39c",
                                "sense_id": "ec6ac50c-3d24-32c7-93d0-fb2f152c9c2f",
                                "text": "„Über den Umweg solcher Mitbringsel wurde es auch wieder gesellschaftsfähig, ein Stück Seife zwecks Wohlgeruch ins Bad oder die Gästetoilette zu legen.“"
                            },
                            {
                                "example_id": "668039db-8aa5-471a-9de8-a6ce3d460bb2",
                                "sense_id": "ec6ac50c-3d24-32c7-93d0-fb2f152c9c2f",
                                "text": "„Die Tür zur Gästetoilette war unversperrt, auch für die drei Kinder in der Wohnung.“"
                            },
                            {
                                "example_id": "6293db71-da04-4fd7-9c41-5fe18ba968c3",
                                "sense_id": "ec6ac50c-3d24-32c7-93d0-fb2f152c9c2f",
                                "text": "„Die Planung des Badezimmers oder der Gästetoilette wird dabei oft vernachlässigt.“"
                            },
                            {
                                "example_id": "8d02835c-fe0e-4c8b-9403-56e96f66afd2",
                                "sense_id": "ec6ac50c-3d24-32c7-93d0-fb2f152c9c2f",
                                "text": "„Schnell verschwand ich mit ihr in der Gästetoilette.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab73e7ab-002a-3050-b611-980cc2b450f2",
                        "entry_id": "fee4b438-4837-3338-b22b-3e52687bc976",
                        "glosses": [
                            "Raum zur Aufnahme von Körperausscheidungen für zahlende Besucher eines Lokals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e697e18e-e7d2-4f34-8f2d-6878a9b55801",
                                "sense_id": "ab73e7ab-002a-3050-b611-980cc2b450f2",
                                "text": "„Außerdem gibt es am Platz sechs Stände, die Alkohol ausschenken oder einen Imbiss betreiben, und da schreibt das Gaststättenrecht zwingend eine Personal- und eine Gästetoilette vor, womit die Stände auch nicht dienen können.“"
                            },
                            {
                                "example_id": "49891c6a-07eb-4e9e-b2a9-2d029f30dc68",
                                "sense_id": "ab73e7ab-002a-3050-b611-980cc2b450f2",
                                "text": "„Es stehen gemäß Aufteilungsplan ein straßenseitiger Gastraum, Flur 1, Gästetoilette, Küche, Flur 2, Sanitärbereich Personal, Lager Gaststätte und ein Kellerverschlag (hier: 3 Räume) zur Verfügung.“"
                            },
                            {
                                "example_id": "d280c222-199c-4451-a1be-b36ef295881b",
                                "sense_id": "ab73e7ab-002a-3050-b611-980cc2b450f2",
                                "text": "„Fragt man dort nämlich nach der Gästetoilette, stellt man fest, dass es so etwas häufig nicht gibt.“"
                            },
                            {
                                "example_id": "071ad452-9f4a-44dc-9025-903316cf0e32",
                                "sense_id": "ab73e7ab-002a-3050-b611-980cc2b450f2",
                                "text": "„Einen dunklen Durchgang links von der Bar, den Eingang zu dem Korridor, wo Jimmie sein Büro hatte und wo sich die Gästetoiletten befanden.“"
                            },
                            {
                                "example_id": "b45d1e34-68e3-44bf-bfdd-87be2cd6d54f",
                                "sense_id": "ab73e7ab-002a-3050-b611-980cc2b450f2",
                                "text": "„Er lief in die Gästetoilette und wollte sich gerade genervt an einem der Waschbecken etwas kaltes Wasser ins Gesicht schütten, als er die Stimmen hinter sich hörte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
