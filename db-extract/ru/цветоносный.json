                "senses": [
                    {
                        "sense_id": "04f4ade1-52f9-3a17-9482-5bf354c1fc71",
                        "entry_id": "8cebf92c-b884-332b-92a9-34a0414e8475",
                        "glosses": [
                            "ботан. имеющий цветки, дающий цветки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170e4868-72f4-46f9-8f3a-64df0757f690",
                                "sense_id": "04f4ade1-52f9-3a17-9482-5bf354c1fc71",
                                "text": "Дефицит калия приводит к замедлению или остановке роста, уменьшению цветоносных стеблей."
                            },
                            {
                                "example_id": "efd4c527-ff9f-4394-9c31-0e68f42611f4",
                                "sense_id": "04f4ade1-52f9-3a17-9482-5bf354c1fc71",
                                "text": "Этот симпатичный однолетник также образует розетку из листьев, из центра которой вырастают цветоносные побеги."
                            }
                        ]
                    }
                ],
