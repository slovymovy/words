                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c6f1647-3f1f-3ace-a96f-d648f8cf9174",
                        "entry_id": "f8b34317-1744-3ab7-a367-9c6b608d01df",
                        "glosses": [
                            "Action de semer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f2f3691-a77b-48ff-954d-c405f3974921",
                                "sense_id": "8c6f1647-3f1f-3ace-a96f-d648f8cf9174",
                                "text": "Le caporal et sa petite femme avaient aussi refait leurs semailles, qui avaient si bien réussi pendant la saison chaude."
                            },
                            {
                                "example_id": "cc0836c8-142f-42a1-86a6-dd40463c6ff9",
                                "sense_id": "8c6f1647-3f1f-3ace-a96f-d648f8cf9174",
                                "text": "Mais bientôt le flot revient vers le rivage, la mer monte ; de toutes parts on s’empresse, on rentre chez soi, sûr que la mer va remplacer ce qu’on vient de lui prendre, et qu’on pourra, dans quelques heures, recommencer une récolte qui n’a jamais demandé de semailles."
                            },
                            {
                                "example_id": "18d68029-d35c-4640-8293-51d563bde519",
                                "sense_id": "8c6f1647-3f1f-3ace-a96f-d648f8cf9174",
                                "text": "On le répand avant ou après la semaille, et aussi quelquefois après le repiquage. Quand on l’emploie avant la semaille, quelques jours avant l’épandage on donne un labour suivi d’un hersage pour bien meublir le sol."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4e65d9b-0b6b-3f28-8578-9fbace1c6708",
                        "entry_id": "f8b34317-1744-3ab7-a367-9c6b608d01df",
                        "glosses": [
                            "Ces grains semés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c9af9aee-0aec-4222-bdd5-29683b96431d",
                                "sense_id": "d4e65d9b-0b6b-3f28-8578-9fbace1c6708",
                                "text": "Les corbeaux picorent dans les champs les semailles généreusement lancées par les machines agricoles."
                            }
                        ]
                    },
                    {
                        "sense_id": "4213c1e8-78f8-3e01-b20c-0e278da4e7cc",
                        "entry_id": "f8b34317-1744-3ab7-a367-9c6b608d01df",
                        "glosses": [
                            "Saison ou le temps durant lequel on ensemence les terres."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cd26731a-82d9-4f0c-8a44-df459a12e73b",
                                "sense_id": "4213c1e8-78f8-3e01-b20c-0e278da4e7cc",
                                "text": "Les pigeons pendant la semaille et pendant les environs de la moisson et pendant la moisson causent un dégât terrible en pure perte pour l'état, pour le colon et pour leur propriétaire."
                            },
                            {
                                "example_id": "47fc3543-358e-4235-941a-0a0748e6003f",
                                "sense_id": "4213c1e8-78f8-3e01-b20c-0e278da4e7cc",
                                "text": "[…] ; circonstance très heureuse pour les pays comme le nôtre, où les récoltes du froment souffrent beaucoup, au moins année sur trois, par les grandes pluies qui tombent pendant les semailles."
                            }
                        ]
                    }
