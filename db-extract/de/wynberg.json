                "senses": [
                    {
                        "sense_id": "18f4db1c-7f65-35d1-9ae5-4ffe79095f3b",
                        "entry_id": "75a11fba-f0d4-3166-9e09-b4533655087b",
                        "glosses": [
                            "südlicher Stadtteil von Kapstadt"
