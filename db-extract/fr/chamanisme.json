        "fr-extract.jsonl": [
            {
                "entry_id": "19fd0053-48bd-3d8f-8cc5-2442b65e636f",
                "word": "chamanisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57199c70-3f36-4ed9-9904-dd43777e25d8",
                        "entry_id": "19fd0053-48bd-3d8f-8cc5-2442b65e636f",
                        "tags": [
                            "plural"
                        ],
                        "form": "chamanismes"
                    },
                    {
                        "form_id": "40e8039c-d020-4abb-8c8e-a565b5bda626",
                        "entry_id": "19fd0053-48bd-3d8f-8cc5-2442b65e636f",
                        "tags": [],
                        "form": "shamanisme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "200569fe-3906-34f4-9ec2-a4f8c2d400f7",
                        "entry_id": "19fd0053-48bd-3d8f-8cc5-2442b65e636f",
                        "glosses": [
                            "Système symbolique de médiation entre les humains et les esprits de la nature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d78467-a4bd-4bec-9ddc-a8299bdbd74e",
                                "sense_id": "200569fe-3906-34f4-9ec2-a4f8c2d400f7",
                                "text": "Ake Hultkrantz présente le chamanisme comme un complexe culturel religio-magique et conclut : puisque le monde surnaturel est le monde de la religion, le chamanisme joue donc un rôle religieux et il n’est pas interdit de supposer que toutes les expériences extatiques à l’origine de renouveaux religieux remontent aux chamans des temps anciens."
                            },
                            {
                                "example_id": "995fb777-e756-4919-9086-070829a63307",
                                "sense_id": "200569fe-3906-34f4-9ec2-a4f8c2d400f7",
                                "text": "— C’est qui, Pollock ? Excusez mon inculture.\n— Jackson Pollock était un peintre américain de l’après-guerre. Un expressionniste abstrait, un des chefs de file du mouvement, même. Il était très influencé par le chamanisme. Il est mort en 1956. »"
                            },
                            {
                                "example_id": "3e51e1bf-ffcf-4731-a12e-5f298092f486",
                                "sense_id": "200569fe-3906-34f4-9ec2-a4f8c2d400f7",
                                "text": "Le chamanisme, a constaté M. Liogier, a également l’avantage de se présenter comme « une médecine holistique soignant l’esprit et le corps en même temps », et favorisant donc toutes « les pratiques spontanéistes pour se retrouver, s’exprimer, lever ses blocages »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c20c336d-66a9-4191-8c69-64cbb8bf47e9",
                        "source_entry_id": "19fd0053-48bd-3d8f-8cc5-2442b65e636f",
                        "source_sense_id": "200569fe-3906-34f4-9ec2-a4f8c2d400f7",
                        "target_lang_word": "Schamanismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schamanismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a078420-dc53-3f17-84ed-bac70e57d186",
                                        "entry_id": "90270be1-c05b-3a7f-ac61-310382056954",
                                        "glosses": [
                                            "Glaube an die Fähigkeit mancher Menschen, Geister zu beschwören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6476163-dd18-487f-bb3f-8c3c2da0ff0e",
                                                "sense_id": "7a078420-dc53-3f17-84ed-bac70e57d186",
                                                "text": "„Diejenigen, die die Prostitution als das älteste Gewerbe ansehen, vergessen, dass der Schamanismus mindestens ein paar Jahrhunderte älter ist.“"
                                            },
                                            {
                                                "example_id": "7e629248-cb58-427f-bba0-9b268394ab35",
                                                "sense_id": "7a078420-dc53-3f17-84ed-bac70e57d186",
                                                "text": "„Ihre Religion war der Schamanismus, ihre Priester waren die Schamanen.“"
                                            },
                                            {
                                                "example_id": "7cd766fb-897b-435e-9fd8-14d5ced7f608",
                                                "sense_id": "7a078420-dc53-3f17-84ed-bac70e57d186",
                                                "text": "„Man zwang die Sámi, ihre Volkskultur, die naturreligiösen Momente wie den Schamanismus völlig zu verleugnen oder abzulegen.“"
                                            },
                                            {
                                                "example_id": "11544df0-f3a3-4cff-9476-ed5b25177cba",
                                                "sense_id": "7a078420-dc53-3f17-84ed-bac70e57d186",
                                                "text": "„Die Bewohner waren mehrheitlich Nomaden mit Hang zum Schamanismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
