{
    "word_family": [
        "ovate",
        "oviform",
        "oviparous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8ae9f12-89a4-3eed-aeaa-5c52adc8004c",
                    "sense_definition": "Prolonged and enthusiastic applause given by an audience.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "applause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience stood up to give the performer a long <w>ovation</w> after the concert.",
                            "target_lang_translations": {
                                "zh": "音乐会结束后，观众起立为表演者送上长时间的<w>热烈掌声</w>。"
                            }
                        },
                        {
                            "text": "The team received a standing <w>ovation</w> from the crowd for their incredible performance.",
                            "target_lang_translations": {
                                "zh": "该团队凭借令人惊叹的表现赢得了人群起立<w>喝彩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "applause"
                    ],
                    "antonyms": [
                        "booing",
                        "jeering",
                        "hissing"
                    ],
                    "common_phrases": [
                        "standing ovation"
                    ],
                    "target_lang_definitions": {
                        "zh": "观众长时间且热烈的掌声与欢呼"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "热烈掌声",
                                "target_lang_sense_clarification": "观众长时间热烈的鼓掌"
                            },
                            {
                                "target_lang_word": "欢呼",
                                "target_lang_sense_clarification": "热烈的欢呼与喝彩"
                            },
                            {
                                "target_lang_word": "喝彩",
                                "target_lang_sense_clarification": "大声称好、喝彩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "765afd65-1382-3711-ae96-0c943014f18a",
                    "sense_definition": "A public ceremony or celebration held to recognize an achievement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero returned home to a grand <w>ovation</w> from the grateful citizens.",
                            "target_lang_translations": {
                                "zh": "英雄凯旋归来，受到了心怀感激的市民们盛大的<w>热烈欢迎</w>。"
                            }
                        },
                        {
                            "text": "She felt uncomfortable with the public <w>ovation</w> organized in her honor.",
                            "target_lang_translations": {
                                "zh": "面对为表彰她而组织的公开<w>庆祝仪式</w>，她感到有些不自在。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "为表彰成就而举行的公开庆祝或热烈欢迎仪式"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "热烈欢迎",
                                "target_lang_sense_clarification": "公众热情的迎接与致意"
                            },
                            {
                                "target_lang_word": "庆祝仪式",
                                "target_lang_sense_clarification": "公开表彰的仪式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ecb6eaa-d95d-319a-acee-2f4d6519ee51",
                    "sense_definition": "A minor victory celebration in ancient Rome, less significant than a formal triumph.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "celebration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general was granted an <w>ovation</w> rather than a full triumph for his victory.",
                            "target_lang_translations": {
                                "zh": "鉴于这场胜利，将军获得了举行<w>小凯旋式</w>的荣誉，而非盛大的正式凯旋式。"
                            }
                        },
                        {
                            "text": "Historical records describe the specific rituals performed during a Roman <w>ovation</w>.",
                            "target_lang_translations": {
                                "zh": "历史文献详细记载了罗马<w>小凯旋式</w>期间举行的具体仪式。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to ancient Roman history."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "古罗马时期对取得较小军事胜利的将领举行的小凯旋式"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小凯旋式",
                                "target_lang_sense_clarification": "古罗马次于大凯旋式的庆祝仪式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46da8b81-fecb-3c8c-a212-e4ce94c3cbe1",
                    "sense_definition": "To show great appreciation to someone through prolonged applause.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "applause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fans <w>ovationed</w> the star as she walked onto the stage.",
                            "target_lang_translations": {
                                "zh": "当那位明星走上舞台时，粉丝们纷纷向她<w>欢呼致意</w>。"
                            }
                        },
                        {
                            "text": "They <w>ovationed</w> the speaker for his inspiring words at the conference.",
                            "target_lang_translations": {
                                "zh": "在大会上，他们为演讲者鼓舞人心的话语<w>热烈鼓掌</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "通过热烈而持久的鼓掌或欢呼向某人致意"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "热烈鼓掌",
                                "target_lang_sense_clarification": "为某人报以持久热烈的掌声"
                            },
                            {
                                "target_lang_word": "欢呼致意",
                                "target_lang_sense_clarification": "以欢呼声表达赞许"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8df7ead4-6ebe-363e-b305-0ae925a8441d",
                    "sense_definition": "The biological process of laying eggs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study examined the <w>ovation</w> patterns of various insect species in the wild.",
                            "target_lang_translations": {
                                "zh": "该研究调查了野外多种昆虫的<w>产卵</w>模式。"
                            }
                        },
                        {
                            "text": "Scientists observed the <w>ovation</w> process to understand the reproductive cycle of the species.",
                            "target_lang_translations": {
                                "zh": "科学家观察了其<w>产卵</w>过程，以了解该物种的繁殖周期。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in scientific contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "产卵（生物学旧称或罕用语）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "产卵",
                                "target_lang_sense_clarification": "生物排出卵子的过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}