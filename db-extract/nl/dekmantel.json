                                "target_senses": [
                                    {
                                        "sense_id": "4675a00b-5461-39b7-8f9f-df43cf076a37",
                                        "entry_id": "3520e9b4-181a-32f7-9025-faf18e7cfda6",
                                        "glosses": [
                                            "Deliberate misspelling of guys."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "alt-of",
                                            "deliberate",
                                            "misspelling",
