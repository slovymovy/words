                    {
                        "sense_id": "9443c0f9-43f5-39e0-804a-57d197b098c9",
                        "entry_id": "c9f4cdd7-f27b-321c-8a7d-b21938c7b882",
                        "glosses": [
                            "een groot evenement met zang en dans en muzikale optredens"
                        ],
                        "tags": [
                            "feest"
                        ],
                        "examples": [
                            {
                                "example_id": "4c5d3bcc-1cd1-45f8-820f-2a05bacf7853",
                                "sense_id": "9443c0f9-43f5-39e0-804a-57d197b098c9",
                                "text": "In Nederland worden jaarlijks enkele grote festival gehouden."
                            },
                            {
                                "example_id": "b45681a7-cd7d-4426-b50e-38f1df3c1888",
                                "sense_id": "9443c0f9-43f5-39e0-804a-57d197b098c9",
                                "text": "Het werd de spannendste Eurovisie-ontknoping in vele jaren. Maar de uitkomst was die waar Nederland na 44 jaar naar smachtte: Duncan Laurence is winnaar van het Songfestival. Bijna een halve eeuw na de zege van Teach-in komt het festival volgend jaar weer naar Nederland."
                            },
                            {
                                "example_id": "471728c3-436e-4aee-a1cb-2694b8069ccb",
                                "sense_id": "9443c0f9-43f5-39e0-804a-57d197b098c9",
                                "text": "Het drukbezochte festival Down the Rabbit Hole had afgelopen weekend te kampen met meerdere last-minute afzeggingen, onder meer wegens coronabesmettingen. Een optreden gaat wel vaker niet door op het laatste moment, maar corona heeft die kans vergroot. Wat gebeurt er als een artiest vlak voor het geplande optreden geen acte de présence op een festival kan geven?"
                            }
                        ]
                    }
                ],
