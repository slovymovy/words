                                                "sense_id": "00665fbc-4eb6-3c59-ab1c-e1f61d123915",
                                                "text": "Очевидный промах."
                                            },
                                            {
                                                "example_id": "855e8d5d-4223-4471-98af-4d4dfcc04013",
                                                "sense_id": "00665fbc-4eb6-3c59-ab1c-e1f61d123915",
                                                "text": "В ней произошла перемена — это было очевидно."
                                            },
                                            {
                                                "example_id": "dfcccfda-043d-4d6d-8cca-bd79a80841b7",
                                                "sense_id": "00665fbc-4eb6-3c59-ab1c-e1f61d123915",
                                                "text": "Очевидна цель его объяснений — успокоить меня."
                                            }
