                    {
                        "sense_id": "2c3040bd-b4fd-3828-a418-0e367008c0b6",
                        "entry_id": "3b9f8943-ecfa-3ba9-b9d3-9a062d99ee2f",
                        "glosses": [
                            "Variante orthographique de gnochon, « imbécile »."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "10a142b9-ef08-4e51-be70-a99708c19539",
                                "sense_id": "2c3040bd-b4fd-3828-a418-0e367008c0b6",
                                "text": "Nous prends-tu pour des niochons ?"
                            },
                            {
                                "example_id": "cd4a1f98-c33b-48ca-abc6-81d0a04d2e95",
                                "sense_id": "2c3040bd-b4fd-3828-a418-0e367008c0b6",
                                "text": "Il y en avait des innocents, pas capables de couper une branche, on appelait ça des vrais niochons !"
                            },
                            {
                                "example_id": "12c56918-e4b6-4ba1-b1a7-5ec0cf9db29a",
                                "sense_id": "2c3040bd-b4fd-3828-a418-0e367008c0b6",
                                "text": "Espèce de niochon, d’insignifiant, de pas d’allure! Voir que c’est ça que je t’avais demandé."
                            },
                            {
                                "example_id": "360b9697-7def-4210-91f4-f4484c78fe9b",
                                "sense_id": "2c3040bd-b4fd-3828-a418-0e367008c0b6",
                                "text": "Le troisième lien est un projet de «niochons», peste le chef péquiste, Paul St-Pierre-Plamondon, soulignant que la position de son parti face à ce projet «injustifiable» a toujours été la même, contrairement au Parti libéral du Québec."
                            }
                        ]
                    }
