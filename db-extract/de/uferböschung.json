                ],
                "senses": [
                    {
                        "sense_id": "10a24734-6fa2-33bf-b1fb-6a79200672fc",
                        "entry_id": "dd4eaea7-7b4e-3878-a65a-5d8205955b83",
                        "glosses": [
                            "schräg oder steil abfallender Rand eines Gewässers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8510d1c5-5593-4aa7-9b41-f72a644ac942",
                                "sense_id": "10a24734-6fa2-33bf-b1fb-6a79200672fc",
                                "text": "„Tagsüber herrschte in den versteckten Dörfern jenseits der Uferböschung eine geisterhafte Stille.“"
                            },
                            {
                                "example_id": "24c1698a-d4ed-4ac0-bc6a-1821835322f1",
                                "sense_id": "10a24734-6fa2-33bf-b1fb-6a79200672fc",
                                "text": "„Einmal suchte ich die Kanone auf, die uns so viel Ärger gemacht hatte und die wir nicht zum Schweigen hatten bringen können, weil sie am Fuß einer Uferböschungin der Nähe der Landungsstelle stand.“"
                            },
                            {
                                "example_id": "44c92a9e-a812-4bbf-8d5c-d403025f4c93",
                                "sense_id": "10a24734-6fa2-33bf-b1fb-6a79200672fc",
                                "text": "„Mein Vater war nun auf die Idee gekommen, die Wertsachen vorne auf den Lastwagen zu laden, um sie dann hinten, auf der andern Seite, zum Teil wieder abzuladen und in der Uferböschung zu verstecken.“"
                            },
                            {
                                "example_id": "3f33005c-3c44-478f-943c-1b1fead6dc2b",
                                "sense_id": "10a24734-6fa2-33bf-b1fb-6a79200672fc",
                                "text": "„Bei solchen Anlässen hält ihn keine Uferböschung, dann fließt er voller Zerstörungswut über Wiesen, Weiden, Kiesbänke und Buschwald.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
