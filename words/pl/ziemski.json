                            {
                                "target_lang_word": "terrestrial",
                                "target_lang_sense_clarification": "pertaining to planet Earth"
                            },
                            {
                                "target_lang_word": "Earth's",
                                "target_lang_sense_clarification": "belonging to or of planet Earth"
                            },
                            {
                                "target_lang_word": "earthly",
                                "target_lang_sense_clarification": "relating to Earth as a celestial body"
