                        "glosses": [
                            "wiążący się z ryzykiem, grożący niebezpieczeństwem lub popełnieniem błędu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485a3a04-005e-48a7-822d-736258b1af55",
                                "sense_id": "0062fa15-5b5f-3a15-b9a5-1ca011be6f5a",
                                "text": "Bywają interesy ryzykowne, ale dają szybki zysk i łatwe są do zwinięcia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "562e643a-3153-4b76-9603-13a2bbba2009",
                        "source_entry_id": "d2447aef-886b-38d8-9561-9e0d95f3065c",
                        "source_sense_id": "0062fa15-5b5f-3a15-b9a5-1ca011be6f5a",
                        "target_lang_word": "risky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "risky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab6f8f22-98b0-34c7-89d0-22715dc8893e",
                                        "entry_id": "af27dfc8-1360-3b1a-ab47-4388674fe78d",
                                        "glosses": [
                                            "Dangerous, involving risks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc772f87-1f6e-4912-9f66-4384f1650c13",
                                                "sense_id": "ab6f8f22-98b0-34c7-89d0-22715dc8893e",
                                                "text": "Investing in this start-up company could be risky."
                                            },
                                            {
                                                "example_id": "c61b31d8-3c9f-4dd6-a6c4-a1a92eb90443",
                                                "sense_id": "ab6f8f22-98b0-34c7-89d0-22715dc8893e",
                                                "text": "Jumping on the train from the bridge to catch the terrorist was a highly risky operation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8420fb0d-2d69-3e54-afc1-89afab7bad3b",
                                        "entry_id": "af27dfc8-1360-3b1a-ab47-4388674fe78d",
                                        "glosses": [
                                            "Misspelling of risqué."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45cfab75-1c7e-484f-8c53-45a99794506a",
                                                "sense_id": "8420fb0d-2d69-3e54-afc1-89afab7bad3b",
                                                "text": "Have you no risky songs, no indecent ballads?"
                                            },
                                            {
                                                "example_id": "93eb6f1d-43e9-4ee4-94a5-00222b80496d",
                                                "sense_id": "8420fb0d-2d69-3e54-afc1-89afab7bad3b",
                                                "text": "That awkward moment when someone doesn't reply to your risky text message."
                                            },
                                            {
                                                "example_id": "d3ad66c0-7e50-4f04-a163-7999cc0746a4",
                                                "sense_id": "8420fb0d-2d69-3e54-afc1-89afab7bad3b",
                                                "text": "Ronald Frankau (pronounced Franco) wrote a few risky songs, such as FANNY'S BEEN EVACUATED NOW with the line “and for half a pound of butter, well a lady's got to eat” ~ he got banned for it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "093deceb-29f1-458b-b0d3-e77d92f5de17",
                        "source_entry_id": "d2447aef-886b-38d8-9561-9e0d95f3065c",
                        "source_sense_id": "0062fa15-5b5f-3a15-b9a5-1ca011be6f5a",
                        "target_lang_word": "chancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dbc892a-a618-35c3-86aa-af1016a05bd3",
                                        "entry_id": "0126da8f-9295-32fa-b36c-6c20627420c2",
                                        "glosses": [
                                            "Uncertain; risky; hazardous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68219396-25eb-41bf-bd4f-0f330f17f1fb",
                                                "sense_id": "6dbc892a-a618-35c3-86aa-af1016a05bd3",
                                                "text": "In winter steam contributes a fairly high proportion of its tractive effort, say 15 per cent, to heating the train. Diesels have at the moment separate oil-fired boilers which are somewhat chancy affairs, and only electric locomotives grab unlimited power for heating which does not affect their punctuality."
                                            },
                                            {
                                                "example_id": "4e1c6580-b607-49ed-9dc5-b6359c77236a",
                                                "sense_id": "6dbc892a-a618-35c3-86aa-af1016a05bd3",
                                                "text": "You might think it's foolish\n This chancy rendezvous\n (You might think) You might think I'm crazy\n (All I want) All I want is you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a7761f-42e4-34b8-ac8a-81d7986b0a9b",
                                        "entry_id": "0126da8f-9295-32fa-b36c-6c20627420c2",
                                        "glosses": [
                                            "Subject to chance; random."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76f51fda-9f4b-34b4-9706-7f7d2d1e6230",
                                        "entry_id": "0126da8f-9295-32fa-b36c-6c20627420c2",
                                        "glosses": [
                                            "Lucky; bringing good luck."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b10355-00c2-4ff3-addd-c8f4b6685beb",
                                                "sense_id": "76f51fda-9f4b-34b4-9706-7f7d2d1e6230",
                                                "text": "His haggard gaze swept this way and that, seeking possible succour where reason told him there could be no succour; and then as his vision pieced together this outjutting architectural feature and that into a coherent picture of his immediate surroundings he knew where he was. The one bit of chancy luck in a sequence of direful catastrophes had brought him here[Pg 49] to this very spot. Why, this must be West Ninth Street; it had to be, it was—oh joy, it was!."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
