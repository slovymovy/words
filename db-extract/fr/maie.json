                                                "sense_id": "3ead3abe-7850-32c3-9c96-af923a46edf5",
                                                "text": "Bei Inkontinenz muss man Vorlagen verwenden."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "640da4f7-57ee-3565-bee0-9efd5bea0679",
                                        "entry_id": "b0985661-532d-39c4-806d-71e33f62fbd6",
                                        "glosses": [
