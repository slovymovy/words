                "senses": [
                    {
                        "sense_id": "0a339884-3adb-3e74-aa09-8ea7a0980dbf",
                        "entry_id": "b9e2bc3e-b93f-3fd6-9356-355b3613f957",
                        "glosses": [
                            "Gesamtheit des römischen Adels im antiken Rom"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da151cf4-7ed8-3c71-8cfa-ef87ba78f717",
                        "entry_id": "b9e2bc3e-b93f-3fd6-9356-355b3613f957",
                        "glosses": [
                            "Gesamtheit der wohlhabenden Bürger im Mittelalter"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d3586f6b-5fa7-4c02-92b2-2171d142f3b2",
                                "sense_id": "da151cf4-7ed8-3c71-8cfa-ef87ba78f717",
                                "text": "„Das deutschsprachige Prager Patriziat sollte verschwinden.“"
                            },
                            {
                                "example_id": "1dafa86c-bb64-4739-af53-75235a663335",
                                "sense_id": "da151cf4-7ed8-3c71-8cfa-ef87ba78f717",
                                "text": "„Gegen seinen Zugriff rebellierte das selbstbewusste Patriziat und Philipp musste 1302 in Courtrai eine vernichtende Schlachtniederlage hinnehmen, die den Krieg jedoch nicht beendete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2eeb776-e43c-4c61-ac9b-f80f76592b89",
                        "source_entry_id": "b9e2bc3e-b93f-3fd6-9356-355b3613f957",
                        "source_sense_id": "0a339884-3adb-3e74-aa09-8ea7a0980dbf",
                        "source_sense_description": "Gesamtheit des römischen Adels im antiken Rom",
                        "target_lang_word": "patriciate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriciate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "683ca5e5-9953-3386-be9a-977660eb9bac",
                                        "entry_id": "b4059047-804c-303d-9eef-bcdb62d248ca",
                                        "glosses": [
                                            "The rank of a patrician"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da019385-5bec-3e04-9771-cb7be79367bc",
                                        "entry_id": "b4059047-804c-303d-9eef-bcdb62d248ca",
                                        "glosses": [
                                            "The aristocracy or nobility"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1bda81-bbe4-4e7f-ad21-376c7902e96c",
                                                "sense_id": "da019385-5bec-3e04-9771-cb7be79367bc",
                                                "text": "The idea of his frivolity had, no doubt, to do with his personal designation, which represented—as yet, for our young woman, a little confusedly—a connection with an historic patriciate, a class that, in turn, also confusedly, represented an affinity with a social element that she had never heard otherwise described than as \"fashion.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f58c549b-d4cd-42a5-8b55-0ac185654f10",
                        "source_entry_id": "b9e2bc3e-b93f-3fd6-9356-355b3613f957",
                        "source_sense_id": "0a339884-3adb-3e74-aa09-8ea7a0980dbf",
                        "source_sense_description": "Gesamtheit des römischen Adels im antiken Rom",
                        "target_lang_word": "patriciat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriciat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d6e7fee-0f37-3c89-9884-34c098ea9713",
                                        "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                                        "glosses": [
                                            "Ordre des patriciens chez les anciens romains."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4714cad-af56-471f-b149-8b2493df97ca",
                                                "sense_id": "5d6e7fee-0f37-3c89-9884-34c098ea9713",
                                                "text": "Au sein du patriciat, rallié en grande majorité au nouvel état de choses, il restait un petit clan irréductible dont le chef était Claudius Appius […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86d0aea-2246-3b96-91e6-9a7142761af1",
                                        "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                                        "glosses": [
                                            "À partir de Constantin, dignité de patrice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e0b713f-ad19-4761-95c5-879cae222580",
                                                "sense_id": "d86d0aea-2246-3b96-91e6-9a7142761af1",
                                                "text": "On ne parvenait ordinairement au patriciat qu’après avoir passé par les plus grandes charges, comme celle de consul, de préfet du prétoire, de préfet de la ville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                                        "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                                        "glosses": [
                                            "Ordre des nobles dans les gouvernements modernes où ils sont appelés les patriciens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0b74a1f-03aa-4e4d-bf27-ea8c10680428",
                                                "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                                                "text": "Je n’ai pas vu votre ville de Genève […] là, point de noblesse, mais un patriciat ; qui, sans être onéreux à personne, maintient le lustre des bonnes familles."
                                            },
                                            {
                                                "example_id": "7e192908-471f-48bd-9907-10d1f14367eb",
                                                "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                                                "text": "Fortune et participation continue à la gestion des affaires municipales sont bien les deux éléments qui caractérisent le patriciat."
                                            },
                                            {
                                                "example_id": "c2fdf05d-9fe3-4cab-940c-b1a79f0c9dd4",
                                                "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                                                "text": "Peu savent qu’à côté de cette bourgeoisie marchande subsiste, d’une part, une vieille noblesse datant du Saint-Empire, de l’autre, un patriciat issu des petites villes, magistrats, officiers, administrateurs, possesseurs de noms bien connus eux aussi dans l’histoire des Pays-Bas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
