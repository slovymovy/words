                        "examples": [
                            {
                                "example_id": "6f579e4e-d808-4f44-899f-151667a3b533",
                                "sense_id": "2d60e0a4-b4b5-30e0-9480-bc49e21a3efc",
                                "text": "Deus ex machina (Latijn: \"god uit een machine\") is een narratieve techniek waarbij er sprake is van een onverwachte ontknoping van een verhaal."
                            },
                            {
                                "example_id": "da64a8e8-b049-4366-ab89-87c62bab1008",
                                "sense_id": "2d60e0a4-b4b5-30e0-9480-bc49e21a3efc",
                                "text": "Het werd de spannendste Eurovisie-ontknoping in vele jaren. Maar de uitkomst was die waar Nederland na 44 jaar naar smachtte: Duncan Laurence is winnaar van het Songfestival. Bijna een halve eeuw na de zege van Teach-in komt het festival volgend jaar weer naar Nederland."
                            }
                        ]
                    }
