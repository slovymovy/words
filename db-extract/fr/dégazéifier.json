                "senses": [
                    {
                        "sense_id": "694005cb-c632-3336-ac83-a043b0c5e06a",
                        "entry_id": "d8529231-4d39-3b96-80d3-46208de09fc2",
                        "glosses": [
                            "Enlever le gaz contenu dans un liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4943b473-9ced-407a-8b50-465ed6d2ffe5",
                                "sense_id": "694005cb-c632-3336-ac83-a043b0c5e06a",
                                "text": "En revanche, pensez à bien dégazéifier la boisson, en remuant avec une cuillère."
                            },
                            {
                                "example_id": "007c1c5c-eacc-46ba-ab7e-8855b9f7dffe",
                                "sense_id": "694005cb-c632-3336-ac83-a043b0c5e06a",
                                "text": "Nous avons résolu ce problème en introduisant d’abord l’essence non dégazéifiée, puis en la dégazéifiant dans l’appareil de mesure même."
                            },
                            {
                                "example_id": "b3fcc321-a4f9-4e6b-a0c2-42a0b52d7175",
                                "sense_id": "694005cb-c632-3336-ac83-a043b0c5e06a",
                                "text": "Sur certains points, on peut constater l’existence d’échappements de ce gaz, véritables cheminées par où se dégazéifient les eaux souterraines."
                            }
                        ]
                    }
                ],
