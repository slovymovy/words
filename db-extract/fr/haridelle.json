                    },
                    {
                        "translation_id": "eb9fa923-81f3-43ce-9d82-7b8a10ff6a84",
                        "source_entry_id": "c4e13451-7673-3cbe-8962-a4c5ef211ba2",
                        "source_sense_description": "Cheval efflanqué et médiocre",
                        "target_lang_word": "Gaul",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaul",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                        "entry_id": "24e2fb89-ddd8-3ac1-867b-bd4cde4825b4",
                                        "glosses": [
                                            "minderwertiges Pferd"
                                        ],
                                        "tags": [
                                            "abschätzig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4155be82-22a7-4644-be63-a6bbfabd6b34",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "Guck dir den Gaul an!"
                                            },
                                            {
                                                "example_id": "a384751f-aaca-4d3c-8af9-da145ceb491b",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "Für den lahmen Gaul ist mir der Kaufpreis zu hoch."
                                            },
                                            {
                                                "example_id": "bda411c2-847f-47b6-80cc-c50fdf10b2d0",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "„Ein Cowboy braucht dringend einen neuen Gaul und geht zu einem Pferdehändler.“"
                                            },
                                            {
                                                "example_id": "ddf47974-8cde-4419-9b6d-41e12cfb2224",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "„Mit diesen Worten nahm er seine gewichtige Reitpeitsche, mit der er wirklich einst einen Damhirsch zu Boden geschlagen, von der Wand, steckte eine gewaltige Pistole in seine lange Rocktasche und bestieg seinen Gaul.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1495191-cb98-397e-9a01-34527b0e7c1e",
                                        "entry_id": "24e2fb89-ddd8-3ac1-867b-bd4cde4825b4",
                                        "glosses": [
                                            "Pferd"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a69a075-5c0c-452c-a206-056407325a70",
                                                "sense_id": "d1495191-cb98-397e-9a01-34527b0e7c1e",
                                                "text": "„Es gab gar diplomatische Verwicklungen, als John Major 1993 zu seinem 50. Geburtstag vom Präsidenten Turkmenistans einen Gaul geschenkt bekam (SPIEGEL 36/1997).“"
                                            },
                                            {
                                                "example_id": "7de0eacf-4593-4162-a41e-7be7e81d861c",
                                                "sense_id": "d1495191-cb98-397e-9a01-34527b0e7c1e",
                                                "text": "„Er kam dann stets mit zwei Gäulen im Schlepptau und konnte sich bei meinem Vater mit Heu versorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3595eaa7-1628-4c82-a98c-e037fae6b260",
                        "source_entry_id": "c4e13451-7673-3cbe-8962-a4c5ef211ba2",
                        "source_sense_description": "Cheval efflanqué et médiocre",
                        "target_lang_word": "nag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e187a01-06da-329f-9627-369bf4b9045b",
                                        "entry_id": "497dc644-2f99-38cb-b0f7-180a0e2c8563",
                                        "glosses": [
                                            "A small horse; a pony."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b47d58bd-a485-3eb2-9b76-17624a4009fa",
                                        "entry_id": "497dc644-2f99-38cb-b0f7-180a0e2c8563",
                                        "glosses": [
                                            "An old, useless horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3418a35b-7949-4ee4-b46f-a782390dd472",
                                                "sense_id": "b47d58bd-a485-3eb2-9b76-17624a4009fa",
                                                "text": "We used to lure the nags into the back of our truck with oats and sugar, then we'd drive back to town to this warehouse and inject the nags with small quantities of morphine I'd stolen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef5c9cd-9983-31c8-af31-7765c58c8e08",
                                        "entry_id": "497dc644-2f99-38cb-b0f7-180a0e2c8563",
                                        "glosses": [
                                            "A paramour."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0e88520-8d0d-4776-affb-f237ffeb2cd3",
                                                "sense_id": "cef5c9cd-9983-31c8-af31-7765c58c8e08",
                                                "text": "Yon ribaudred nag of Egypt – Whom leprosy o'ertake!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1f87a20-d2b7-382a-bd10-67be2aca12e7",
                                        "entry_id": "3b170c36-0488-3160-baf6-87468381689a",
                                        "glosses": [
                                            "To repeatedly remind or complain to (someone) in an annoying way, often about insignificant or unnecessary matters."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe1ca777-28c9-40af-a42d-e09ed062972e",
                                                "sense_id": "b1f87a20-d2b7-382a-bd10-67be2aca12e7",
                                                "text": "The room is never cleaned, so her mother nags and nags until she explodes with frustration and threatens to sell her to the lowest bidder."
                                            },
                                            {
                                                "example_id": "456d7fd0-2581-4aaa-9af4-b1b459b53d8a",
                                                "sense_id": "b1f87a20-d2b7-382a-bd10-67be2aca12e7",
                                                "text": "Anyone would think that I nagged at you, Amanda! (From Amanda! by Robin Klein)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d256bf-f6d2-33bf-8e8d-860b21d759e8",
                                        "entry_id": "3b170c36-0488-3160-baf6-87468381689a",
                                        "glosses": [
                                            "To bother with persistent thoughts or memories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a06e43e3-26fa-4ce1-9aed-53caee49a16c",
                                                "sense_id": "a9d256bf-f6d2-33bf-8e8d-860b21d759e8",
                                                "text": "The notion that he forgot something nagged him the rest of the day."
                                            },
                                            {
                                                "example_id": "b1b4791e-ce43-4e9d-93c8-5507b43b034c",
                                                "sense_id": "a9d256bf-f6d2-33bf-8e8d-860b21d759e8",
                                                "text": "I guess it happens all the time in crime stories where the detective suddenly remembers a bit of conversation that nags him in some way, then for some inexplicable reason, it's just right there in front of you, like a sign pointing 'here!"
                                            },
                                            {
                                                "example_id": "1f01ecae-8775-40a5-bbf7-d0305ada2a46",
                                                "sense_id": "a9d256bf-f6d2-33bf-8e8d-860b21d759e8",
                                                "text": "Sometimes I write because there is a question that nags at me, sometimes because there is a question that nags at other people."
                                            },
                                            {
                                                "example_id": "0656a93c-16f3-4a1f-b610-eae6e1d9df4e",
                                                "sense_id": "a9d256bf-f6d2-33bf-8e8d-860b21d759e8",
                                                "text": "You are sleeping on your side in the bed in your flat, heavily embroiled in a dream which sucks and nags at you and makes no sense; an old primary school teacher is there and a cat you have to take to a supermarket; you are in a canoe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e0e627e-ab04-385d-82e6-f98e383a9046",
                                        "entry_id": "3b170c36-0488-3160-baf6-87468381689a",
                                        "glosses": [
                                            "To bother or disturb persistently in any way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d0cea0-ba59-429b-b4f1-858f9035e7f4",
                                                "sense_id": "2e0e627e-ab04-385d-82e6-f98e383a9046",
                                                "text": "But at night, around the uncertain edge of dreams, and when the wind nags, there are few whom an odd sound will not thrill"
                                            },
                                            {
                                                "example_id": "3535fe89-79a5-4c49-8f94-77316fe43ab1",
                                                "sense_id": "2e0e627e-ab04-385d-82e6-f98e383a9046",
                                                "text": "When a breeze comes up and nags the surface, it sparkles like a gemstone."
                                            },
                                            {
                                                "example_id": "97fe3527-f25a-4ee4-b4de-76d5f56287ef",
                                                "sense_id": "2e0e627e-ab04-385d-82e6-f98e383a9046",
                                                "text": "We are well accustomed as we look out upon Nature at close range to see great creatures harrassed^([sic]) by little creatures. The lot of each big one seems to be in the keeping of some little one, which never quits it, nags it, stings it, wears it out, drives it desperate, makes life somewhat a burden to it and death somewhat a relief."
                                            },
                                            {
                                                "example_id": "48ab2282-b55a-4498-a252-8d63af4ea247",
                                                "sense_id": "2e0e627e-ab04-385d-82e6-f98e383a9046",
                                                "text": "a nagging pain in his left knee"
                                            },
                                            {
                                                "example_id": "00b27425-6cd6-453a-abe1-d7729d8ab38a",
                                                "sense_id": "2e0e627e-ab04-385d-82e6-f98e383a9046",
                                                "text": "a nagging north wind"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3696661-ca87-3b13-99eb-6d25fdca1299",
                                        "entry_id": "14bc9bab-4a82-34c8-83a0-b8739f1885fe",
                                        "glosses": [
                                            "Someone or something that nags."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e02e7a-8607-4e11-9065-d98e115e230c",
                                                "sense_id": "f3696661-ca87-3b13-99eb-6d25fdca1299",
                                                "text": "'That fellow is a nag.' 'Aye, the worst kind,' agreed Hamish, and then smiled, and at that smile, Miss Gunnery thawed even more."
                                            },
                                            {
                                                "example_id": "a851cfa5-1724-4ef4-81bf-24f549e540e4",
                                                "sense_id": "f3696661-ca87-3b13-99eb-6d25fdca1299",
                                                "text": "When we see Wolfe struggling with many depictions of woman characters throughout the novel (the earlier ones being nags and white trash), we greatly admire the development of this living tribute to Aline Bernstein, a woman whom he ends up despising in his later life."
                                            },
                                            {
                                                "example_id": "b442a7e5-839a-4710-bb6b-4571552aa4a2",
                                                "sense_id": "f3696661-ca87-3b13-99eb-6d25fdca1299",
                                                "text": "But, pchA has to produce more than awareness, always-on alerts/nags, or edu-tainment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "662659cb-109c-3a06-9031-30a7400e3e67",
                                        "entry_id": "14bc9bab-4a82-34c8-83a0-b8739f1885fe",
                                        "glosses": [
                                            "A repeated complaint or reminder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487932ac-5ddb-45c0-b93b-fecc38574b43",
                                                "sense_id": "662659cb-109c-3a06-9031-30a7400e3e67",
                                                "text": "And finally the biggest thank you of all to my partner Steven Winston for your love, enthusiasm, encouragement, support, humour, nags, and glasses of wine."
                                            },
                                            {
                                                "example_id": "c8275a94-d392-4b27-aa32-b7617c408af8",
                                                "sense_id": "662659cb-109c-3a06-9031-30a7400e3e67",
                                                "text": "I turned it on Eileen and threw in a couple of my normal nags about her driving."
                                            },
                                            {
                                                "example_id": "abafe3f4-3ad3-4ccc-88f2-cdd3d308b497",
                                                "sense_id": "662659cb-109c-3a06-9031-30a7400e3e67",
                                                "text": "A girl who expects her mother to nag her about her untidy bedroom will hear that message, even though the mother may want to talk about something quite different, so a loving invitiation to go shopping that started \"When you've finished in your bedroom this morning. . .\" might result in the child screaming, storming out and slamming the door because she expected this to be a nag about the state of the room and didn't let you finish with “ . . . shall we go to the shopping centre?”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22768ad8-1fe6-39d3-ab27-5ba2c667a01b",
                                        "entry_id": "14bc9bab-4a82-34c8-83a0-b8739f1885fe",
                                        "glosses": [
                                            "A persistent, bothersome thought or worry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca51062-1bac-4cca-b3b3-0314d8afb561",
                                                "sense_id": "22768ad8-1fe6-39d3-ab27-5ba2c667a01b",
                                                "text": "All that while there was a little nag going on at the back of his mind, which he strove to disregard. But it insisted on attention, and to get rid of it he put down his palette abruptly and got out his mustard-tin cash-box and counted his money."
                                            },
                                            {
                                                "example_id": "eb7e8c95-38d3-4215-b338-41dc9a6b7b2f",
                                                "sense_id": "22768ad8-1fe6-39d3-ab27-5ba2c667a01b",
                                                "text": "During my lengthy aerobic strolls (which more or less served as a tool of meditation), that thought about “college” became a persistent nag."
                                            },
                                            {
                                                "example_id": "c0fb3be4-2b93-489b-bc26-773d9ee49e1a",
                                                "sense_id": "22768ad8-1fe6-39d3-ab27-5ba2c667a01b",
                                                "text": "There are two ways to get rid of our nags. We can either use Ninja decision-making to turn them quickly into actions, stored in our second brain to be revisited when we have some time. Or we can simply just capture and collect the nag, knowing that our systems will ensure we return to it later."
                                            },
                                            {
                                                "example_id": "6201fede-1d3a-43b2-9233-659169f36159",
                                                "sense_id": "22768ad8-1fe6-39d3-ab27-5ba2c667a01b",
                                                "text": "That feeling turned into a very persistent nag."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d96ea723-d915-3511-aab4-837aa38726b0",
                                        "entry_id": "09a0a1e3-5f65-3db5-8035-47ae02f1782a",
                                        "glosses": [
                                            "Misspelling of knack."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
