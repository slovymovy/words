                        "glosses": [
                            "rodzaj tkaniny bawełnianej, konopnej lub lnianej o splocie atłasowym, jednobarwnej (bielonej) lub pasiastej, stosowanej dawniej na bieliznę, podszewki i obicia"
                        ],
                        "tags": [],
                        "examples": [
