    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "50626cac-3672-3a58-a93a-46575a33c244",
                "word": "cobbing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "184f49d6-80a9-4baa-9c88-07da9742a51f",
                        "entry_id": "50626cac-3672-3a58-a93a-46575a33c244",
                        "tags": [
                            "plural"
                        ],
                        "form": "cobbings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3064123-e631-306c-bc27-89b8013ce3b0",
                        "entry_id": "50626cac-3672-3a58-a93a-46575a33c244",
                        "glosses": [
                            "an unofficial form of punishment among the crew or prisoners involving blows to the buttocks from a piece of wood or a handsaw."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dff14a3b-fd08-462f-aabf-1afc248633e4",
                                "sense_id": "b3064123-e631-306c-bc27-89b8013ce3b0",
                                "text": "Previous to the infliction of cobbing, or booting, the delinquent is fairly tried by a court, consisting of–a president, the oldest soldier; members, next two oldest soldiers, youngest soldier, next youngest soldier."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7e00fb8-5ee6-3e06-bb49-3ca91740f37d",
                        "entry_id": "50626cac-3672-3a58-a93a-46575a33c244",
                        "glosses": [
                            "The manual separation of minerals in ore using a hammer."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72f505ab-9cb2-4e56-879a-e672a589f5f6",
                                "sense_id": "c7e00fb8-5ee6-3e06-bb49-3ca91740f37d",
                                "text": "It is, therefore, always so arranged that the dressing progresses gradually through all the operations, beginning in the mine and ending with the cobbing, or, as the case may be. with the concentration."
                            },
                            {
                                "example_id": "9632bd81-4f9d-4753-9a8f-9dfd6b46570b",
                                "sense_id": "c7e00fb8-5ee6-3e06-bb49-3ca91740f37d",
                                "text": "To-day, however, cobbing is still an important operation, carried out with a three-fold purpose: first, to separate pure masses of different minerals from one another and from adhereing pieces of gangue, preparing them at once for the market with qa minimum loss from comminution; secondly, to separate several classes of crussing ores according to the predominance of one or the other of the different minerals they contains; and lastly, to produce a classification according to the nature of the gangue."
                            },
                            {
                                "example_id": "2f09f78d-ff84-43a6-9486-8e72ed8556ce",
                                "sense_id": "c7e00fb8-5ee6-3e06-bb49-3ca91740f37d",
                                "text": "Wheeler provides greater detail on ore treatment, such as traditional cobbing and sorting methods."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9d237a2-6857-3f11-b7ad-8de7409cc6a2",
                        "entry_id": "50626cac-3672-3a58-a93a-46575a33c244",
                        "glosses": [
                            "The production of cobs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d199c3d4-8426-470c-8dc0-b0e2beaf01dd",
                                "sense_id": "c9d237a2-6857-3f11-b7ad-8de7409cc6a2",
                                "text": "In America, Canada, and Central Europe, for example, snow lies feet deep on the ground in the winter, and the summers are sufficiently hot to enable maize to be grown successfully for cobbing,"
                            },
                            {
                                "example_id": "38559e87-31bb-4cd6-a03e-684686a7a723",
                                "sense_id": "c9d237a2-6857-3f11-b7ad-8de7409cc6a2",
                                "text": "There were highly significant differences in percent cobbing between the two fertilizer levels, with the unfertilized treatment producing significantly more cobs than the fertilized treatment."
                            },
                            {
                                "example_id": "c7970c6e-586d-4521-bae8-ac39292c9153",
                                "sense_id": "c9d237a2-6857-3f11-b7ad-8de7409cc6a2",
                                "text": "Symptom is stunting of plant, premature wilting of leaves, chlorotic stripes on young leaves, leaf purpling, excessive tillering and cobbing and formation of barren cobs."
                            }
                        ]
                    }
                ],
