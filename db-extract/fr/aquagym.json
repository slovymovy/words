                    {
                        "sense_id": "8762cb4a-29aa-352b-8489-2bb7f4734f5a",
                        "entry_id": "918c2371-be37-3c20-bdc6-c6ff1bf453a0",
                        "glosses": [
                            "Gymnastique pratiquée dans l’eau."
                        ],
                        "tags": [
                            "Gymnastique"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae7d9ec-286a-4c75-b1e2-1ebd4febd586",
                                "sense_id": "8762cb4a-29aa-352b-8489-2bb7f4734f5a",
                                "text": "L’aqua-jogging et l’aquagym sont devenus extrêmement populaires."
                            },
                            {
                                "example_id": "b09e5382-edac-49e7-a4be-821c31319fb3",
                                "sense_id": "8762cb4a-29aa-352b-8489-2bb7f4734f5a",
                                "text": "Tonique tout l’année avec l’aquagym (journal metro nᵒ 992 du 24 août 2006)"
                            },
                            {
                                "example_id": "4d359914-ae6a-4185-8b7a-afc2ae21cb0b",
                                "sense_id": "8762cb4a-29aa-352b-8489-2bb7f4734f5a",
                                "text": "Vendredi 30 juin de 16h à 21h, l’équipe du Centre aqua-récréatif proposera des séances découverte aquagym, aquabike, aqua-fit’ et aqua-jogging de 20 minutes chacune."
                            }
                        ]
