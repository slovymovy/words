                                                "example_id": "851c2687-15df-42e5-95d7-1bcef3bb5c98",
                                                "sense_id": "ca3c0f87-94a9-3ebd-9ca4-d1e0c5c41307",
                                                "text": "settled visage and deliberate word"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d5f1b5-700b-3baf-a578-806eaca47deb",
                                        "entry_id": "0ee78e32-0488-3cc7-a994-20c5ee2d3f1a",
                                        "glosses": [
                                            "Of a person, weighing facts and arguments with a view to a choice or decision; carefully considering the probable consequences of a step; slow in determining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d91e05-eb56-4cb9-a4a8-4bcba391170e",
                                                "sense_id": "e8d5f1b5-700b-3baf-a578-806eaca47deb",
                                                "text": "The jury took eight hours to come to its deliberate verdict."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6726ddf5-de61-3cce-89ef-f822cdf2fd94",
                                        "entry_id": "0ee78e32-0488-3cc7-a994-20c5ee2d3f1a",
                                        "glosses": [
                                            "Not hasty or sudden; slow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd378d7d-030d-4ff1-ae73-4ee5f0385026",
                                                "sense_id": "6726ddf5-de61-3cce-89ef-f822cdf2fd94",
                                                "text": "His enunciation was so deliberate."
                                            }
                                        ]
                                    }
                                ]
                            },
