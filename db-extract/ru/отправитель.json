                                                "sense_id": "afde0563-1b4f-3f07-8a82-67266953d30b",
                                                "text": "Die Adresse des Absenders gehört auf jedes Paket."
                                            },
                                            {
                                                "example_id": "e808c2fe-8418-4566-8925-3b2c66ecc063",
                                                "sense_id": "afde0563-1b4f-3f07-8a82-67266953d30b",
                                                "text": "„Die Fotos werden als eine Art Empfangsbestätigung zurück an den Absender geschickt.“"
                                            }
