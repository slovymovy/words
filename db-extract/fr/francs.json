                "senses": [
                    {
                        "sense_id": "c471191a-62ed-34bb-a4aa-fd8447cc5cb0",
                        "entry_id": "4da5a804-e122-3bbe-b0bd-6e4847375815",
                        "glosses": [
                            "Peuple germanique dont les tribus s’établirent définitivement en Gaule à partir du Vᵉ siècle."
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "746071b3-2783-4a49-b97c-a44f5d150466",
                                "sense_id": "c471191a-62ed-34bb-a4aa-fd8447cc5cb0",
                                "text": "D'ailleurs, […], il est impossible de ne pas tenir compte de ce fait que les juifs ont habité la France cinq siècles avant les Francs, les Burgondes et les Wisigoths et huit siècles avant les Normands."
                            },
                            {
                                "example_id": "f5af9382-0f2d-440d-a7e7-a1463cb71145",
                                "sense_id": "c471191a-62ed-34bb-a4aa-fd8447cc5cb0",
                                "text": "Jusqu'au moment de son mariage, Clovis était resté attaché en principe aux croyances traditionnelles des Francs."
                            }
                        ]
                    }
                ],
