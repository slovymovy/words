                                "sense_id": "bf9a4784-b768-3d3c-9aa7-fc39ca3a2f07",
                                "text": "Der Reichtum an Landschaftsformen, die klare Luft mit dem meist blauen Himmel und die abwechslungsreichen bunten Gesteine geben Neumexiko seinen sprichwörtlichen Zauber."
                            },
                            {
                                "example_id": "85e48cdf-8071-4fa5-8c90-3a2a475b1f34",
                                "sense_id": "bf9a4784-b768-3d3c-9aa7-fc39ca3a2f07",
                                "text": "In Neumexiko liegt der Carlsbad-Caverns-Nationalpark mit seinen bekannten Tropfsteinhöhlen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
