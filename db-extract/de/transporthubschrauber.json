                ],
                "senses": [
                    {
                        "sense_id": "afa6eaff-114d-3461-b615-9f5191ade79e",
                        "entry_id": "ac1085f5-05d0-3b84-8d9e-bd3df3dd004b",
                        "glosses": [
                            "Hubschrauber, der zum Transportieren dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dd29f94-3714-4701-925b-7b03fdda243e",
                                "sense_id": "afa6eaff-114d-3461-b615-9f5191ade79e",
                                "text": "„Die überwiegende Mehrheit der Helikopter waren Transporthubschrauber.“"
                            },
                            {
                                "example_id": "55e68ea8-6054-41b5-be5e-d5241b3d5e06",
                                "sense_id": "afa6eaff-114d-3461-b615-9f5191ade79e",
                                "text": "„Sie dürften sich längst darüber im Klaren sein, dass ein Scharfschütze ihren Plan vereitelt hatte, die abfliegenden Transporthubschrauber abzuschießen.“"
                            },
                            {
                                "example_id": "5a14f90b-1e02-4c97-a38f-d87f94abe331",
                                "sense_id": "afa6eaff-114d-3461-b615-9f5191ade79e",
                                "text": "„Die Taliban beschlagnahmten Dutzende von Panzern, gepanzerte Autos, Militärfahrzeuge, Waffen und sechs Mig-21-Kampfbomber sowie sechs Transporthubschrauber, die noch aus der Zeit der sowjetischen Besatzung stammten.“"
                            },
                            {
                                "example_id": "e320565b-adef-49ce-9412-d212ead4268b",
                                "sense_id": "afa6eaff-114d-3461-b615-9f5191ade79e",
                                "text": "„Sie schaffen ihre Soldaten mit Transporthubschraubern rein.“"
                            },
                            {
                                "example_id": "09c5c921-97ec-4ac4-b9dd-72bb78fc3c3a",
                                "sense_id": "afa6eaff-114d-3461-b615-9f5191ade79e",
                                "text": "„Getragen vom wopp-wopp-wopp der breiten Rotorblätter des Transporthubschraubers schweben wir dieser seltsamen, mirakulösen Landschaft aus leuchtenden zerklüfteten Bergen entgegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
