                        "translation_id": "9ae07895-085c-4932-af81-1c96454ce2eb",
                        "source_entry_id": "9b012622-ae89-3610-8317-b62e4604ed7e",
                        "source_sense_id": "361db69d-4df4-33b2-ae1f-65c1ab9d7d27",
                        "target_lang_word": "serin cini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serin cini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15d4587b-3b9a-3378-8489-f2525f3fe33e",
                                        "entry_id": "3847ec62-fdd6-3d89-a6b1-86ea024a811b",
                                        "glosses": [
                                            "Espèce de très petit oiseau passereau d'Eurasie et du nord de l'Afrique, voisin du canari, au bec très court, au plumage d’un jaune vif teinté de reflets verdâtres et rayé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8041752-d30d-4086-a373-6c2d757d4cb8",
                                                "sense_id": "15d4587b-3b9a-3378-8489-f2525f3fe33e",
                                                "text": "Le Serin cini a pour cri typique un gazouillis sonore formé de trilles « trirrlilit » souvent lancé quand il est en vol."
                                            },
                                            {
                                                "example_id": "5d21eb3e-6681-4203-87da-933a530dbfb6",
                                                "sense_id": "15d4587b-3b9a-3378-8489-f2525f3fe33e",
                                                "text": "Proche parent du serin des Canaries, qui est la souche de tous les canaris connus, le serin cini est une espèce sauvage à part entière."
                                            },
                                            {
                                                "example_id": "318a9bee-eee3-494e-9875-9638fbe2aade",
                                                "sense_id": "15d4587b-3b9a-3378-8489-f2525f3fe33e",
                                                "text": "Le Serin cini est un oiseau de plaine ou de moyenne montagne, d'affinités méridionales, donc appréciant un bon ensoleillement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
