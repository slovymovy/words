{
    "word_family": [
        "alignment",
        "aligner",
        "misalign",
        "realign"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb7a2d17-c338-3ad1-a23c-51dae304e59e",
                    "sense_definition": "To place or arrange things in a straight line or in correct relative positions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>align</w> the margins of the document so that the text looks professional.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>выровняйте</w> поля документа, чтобы текст выглядел профессионально."
                            }
                        },
                        {
                            "text": "The mechanic needs to <w>align</w> wheels to ensure the car drives straight.",
                            "target_lang_translations": {
                                "ru": "Механику нужно <w>отрегулировать</w> развал-схождение колес, чтобы машина ехала прямо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "align wheels",
                        "align the margins",
                        "perfectly align"
                    ],
                    "target_lang_definitions": {
                        "ru": "Располагать или выстраивать предметы по прямой линии или в правильном взаимном положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выравнивать",
                                "target_lang_sense_clarification": "располагать по прямой линии"
                            },
                            {
                                "target_lang_word": "выстраивать в линию",
                                "target_lang_sense_clarification": "формировать ряд"
                            },
                            {
                                "target_lang_word": "регулировать",
                                "target_lang_sense_clarification": "настраивать положение, например, колес"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bec9eae8-1415-32b0-b6ac-a59716128884",
                    "sense_definition": "To give support to a person, organization, or cause, or to agree with their ideas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affiliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small nation decided to <w>align</w> with its neighbors to improve regional security.",
                            "target_lang_translations": {
                                "ru": "Малая страна решила <w>объединиться</w> со своими соседями для укрепления региональной безопасности."
                            }
                        },
                        {
                            "text": "It is important to <w>align</w> oneself with a mentor who shares your professional values.",
                            "target_lang_translations": {
                                "ru": "Важно <w>найти</w> наставника, который разделяет ваши профессиональные ценности."
                            }
                        }
                    ],
                    "synonyms": [
                        "ally",
                        "support",
                        "side with"
                    ],
                    "common_phrases": [
                        "align with",
                        "align oneself with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать поддержку человеку, организации или делу, либо разделять их идеи и взгляды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "вступать в союз"
                            },
                            {
                                "target_lang_word": "примыкать",
                                "target_lang_sense_clarification": "присоединяться к группе или взглядам"
                            },
                            {
                                "target_lang_word": "солидаризироваться",
                                "target_lang_sense_clarification": "выражать согласие и поддержку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ef2b89a-ecd2-38f7-a19d-8afc48980fab",
                    "sense_definition": "To organize or change something so that it has a consistent relationship with something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company must <w>align</w> goals with the new market strategy to remain competitive.",
                            "target_lang_translations": {
                                "ru": "Компания должна <w>согласовать</w> цели с новой рыночной стратегией, чтобы оставаться конкурентоспособной."
                            }
                        },
                        {
                            "text": "We need to <w>align</w> expectations before we start the project to avoid future conflicts.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>согласовать</w> ожидания перед началом проекта, чтобы избежать конфликтов в будущем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "align goals",
                        "align expectations",
                        "align interests"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать или изменять что-либо так, чтобы оно соответствовало или гармонировало с чем-то другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласовывать",
                                "target_lang_sense_clarification": "приводить в соответствие цели или ожидания"
                            },
                            {
                                "target_lang_word": "координировать",
                                "target_lang_sense_clarification": "увязывать действия или планы"
                            },
                            {
                                "target_lang_word": "адаптировать",
                                "target_lang_sense_clarification": "подстраивать под стратегию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4b0f99f-9387-35a2-b6ee-d799a171834d",
                    "sense_definition": "To move into or form a straight line.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The planets will <w>align</w> in a rare celestial event visible from Earth tonight.",
                            "target_lang_translations": {
                                "ru": "Планеты <w>выстроятся</w> в ряд в ходе редкого астрономического явления, которое можно будет наблюдать с Земли сегодня ночью."
                            }
                        },
                        {
                            "text": "The pedestrians <w>aligned</w> in such a way that from above they made a pyramidal pattern.",
                            "target_lang_translations": {
                                "ru": "Пешеходы <w>выстроились</w> таким образом, что сверху они образовали пирамидальный узор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "planets align"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вставать или выстраиваться в прямую линию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выстраиваться",
                                "target_lang_sense_clarification": "вставать в ряд или линию"
                            },
                            {
                                "target_lang_word": "равняться",
                                "target_lang_sense_clarification": "становиться в строю по линии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9086c48-ccd3-33ec-a4c4-1c16fcb326f5",
                    "sense_definition": "To store data in computer memory in a way that matches the architecture's word size.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The compiler will <w>align</w> data to the nearest word boundary for faster access.",
                            "target_lang_translations": {
                                "ru": "Компилятор будет <w>выравнивать</w> данные по ближайшей границе слова для более быстрого доступа."
                            }
                        },
                        {
                            "text": "You must <w>align</w> memory addresses to prevent hardware exceptions on this processor.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>выравнивать</w> адреса памяти, чтобы предотвратить аппаратные исключения на этом процессоре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "align data",
                        "memory align"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Размещать данные в памяти компьютера таким образом, чтобы они соответствовали размеру машинного слова архитектуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выравнивать",
                                "target_lang_sense_clarification": "технический термин для адресации памяти"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}