                                "target_senses": [
                                    {
                                        "sense_id": "36d46ed7-b05a-32b8-99a1-3a17f440362d",
                                        "entry_id": "97d868db-866a-386e-b4f6-6455af7dfb61",
                                        "glosses": [
                                            "État de celui, de celle, qui n'a pas atteint la maturité de ses comportements sociaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39bdee11-c015-46da-aabb-a5e33b84a2e0",
                                                "sense_id": "36d46ed7-b05a-32b8-99a1-3a17f440362d",
                                                "text": "Le stéréotype de l'immaturité de la prostituée sera, on le sait, promis à un long avenir; il provient de la confusion, délibérément opérée, entre maturité et acceptation des valeurs de la société globale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
