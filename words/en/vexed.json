        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "22f2cb4e-7bf3-369d-807d-34fdc69f1f72",
                    "sense_definition": "Feeling annoyed, irritated, or distressed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She became increasingly <w>vexed</w> as she struggled to cope with the demands of the job.",
                            "target_lang_translations": {
                                "ru": "Она становилась всё более <w>раздраженной</w>, пытаясь справиться с требованиями работы.",
                                "es": "Se fue sintiendo cada vez más <w>molesta</w> mientras luchaba por lidiar con las exigencias del trabajo."
                            }
                        },
                        {
                            "text": "He was <w>vexed</w> by the constant interruptions during his important meeting.",
                            "target_lang_translations": {
                                "ru": "Он был <w>раздражен</w> постоянными прерываниями во время важной встречи.",
                                "es": "Estaba <w>irritado</w> por las constantes interrupciones durante su importante reunión."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyed",
                        "irritated",
                        "frustrated"
                    ],
                    "antonyms": [
                        "pleased",
                        "calm"
                    ],
                    "common_phrases": [
                        "visibly vexed",
                        "deeply vexed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий раздражение, досаду или обеспокоенность.",
                        "es": "Que siente enfado, irritación, disgusto o preocupación."
                    },
                    "translations": {
                        "ru": [
                            {
