                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e7a3842-5b43-4309-94a6-db6cc240893a",
                                                "sense_id": "f2956160-daae-3a49-a1bc-71f0ea733839",
                                                "text": "She [Chloe Kelly] waited for confirmation of the goal before taking off her shirt and waving it around her head, while being lifted by her team-mates in a moment of pure elation."
                                            }
                                        ]
                                    },
