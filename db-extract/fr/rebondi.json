                                            {
                                                "example_id": "1c84f3d1-7193-40d6-a117-3ce499395a11",
                                                "sense_id": "2fda0a7e-9236-3463-95b8-c0f15be31e72",
                                                "text": "September 24, 1712, The Spectator No. 492, letter from a prude\nDulcissa plumps into a chair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plump",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b997a78b-396a-3eaa-bb9d-d50eeac61e49",
                                        "entry_id": "646a83a9-9327-3982-9559-b1d91f8ca7bb",
                                        "glosses": [
                                            "Directly; suddenly; perpendicularly."
                                        ],
                                        "tags": [],
                                        "examples": [
