                "senses": [
                    {
                        "sense_id": "968c6983-acf9-3e5e-8bf8-65e307c7ae5b",
                        "entry_id": "356b3688-0191-3195-9a6e-3e248ecbb280",
                        "glosses": [
                            "Former des mamelons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "613f20f5-6cec-4ff0-9e88-c92b015d9b08",
                                "sense_id": "968c6983-acf9-3e5e-8bf8-65e307c7ae5b",
                                "text": "D'anciennes termitières qui mamelonnent la plaine."
                            },
                            {
                                "example_id": "067012e1-a5ac-422f-b3c5-25cc9a330158",
                                "sense_id": "968c6983-acf9-3e5e-8bf8-65e307c7ae5b",
                                "text": "Ce plateau largement ondulé ( et que mamelonnent seules les petites côtes boisées de Dieuze, […] ), c'est cette fameuse trouée que, […], les Allemands ont feint de laisser ouverte."
                            },
                            {
                                "example_id": "d7d6b8c4-d354-4bf9-8943-14226bd15fec",
                                "sense_id": "968c6983-acf9-3e5e-8bf8-65e307c7ae5b",
                                "text": "La voûte des petites cavernes formées par l'entassement des rochers était revêtue d'une couche mamelonnée d'ascidies simples, espèces de mollusques qui vivent et meurent sans changer de place; …."
                            }
                        ]
                    }
