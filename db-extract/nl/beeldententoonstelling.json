                        "examples": [
                            {
                                "example_id": "4a76f18a-002b-4f7e-a9d5-e7eee6e13432",
                                "sense_id": "9dc30fac-6d69-3239-a02a-bd835fc23a30",
                                "text": "Bij de opening van een beeldententoonstelling in het Amstelpark, waar dienbladen met in de zon fonkelende glaasjes werden rondgedragen, had hij 's middags al aangevangen met drinken."
                            },
                            {
                                "example_id": "150ac353-b047-4d82-b82c-888cf98bf6ea",
                                "sense_id": "9dc30fac-6d69-3239-a02a-bd835fc23a30",
                                "text": "Een jaarlijks terugkerende beeldententoonstelling in Zuid-Limburg gaat dit jaar niet door uit angst voor diefstal. De organisatie vreest dat de 100 beelden niet veilig zijn vanwege de vele koperdiefstallen van de afgelopen tijd."
                            },
                            {
                                "example_id": "03fcd6ec-a7c0-4c63-ac30-7567cde4e350",
                                "sense_id": "9dc30fac-6d69-3239-a02a-bd835fc23a30",
                                "text": "Prinses Beatrix heeft de beeldententoonstelling ARTZUID in het zuiden van Amsterdam geopend. Langs de Apollolaan, de Minervalaan en de Zuidas is een 2,5 kilometer lange route uitgestippeld met sculpturen van 21 internationaal bekende hedendaagse kunstenaars."
                            }
                        ]
