                "senses": [
                    {
                        "sense_id": "c19f5838-4892-3a88-bb09-1b04d428496f",
                        "entry_id": "ff2f3e60-e00e-3393-aa87-79c5428b32f8",
                        "glosses": [
                            "emotional bewegende Erfahrung bei der Begegnung mit einer Gebirgslandschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9685fc73-039c-4f86-9daf-2d029e786372",
                                "sense_id": "c19f5838-4892-3a88-bb09-1b04d428496f",
                                "text": "„Das ersehnte Bergerlebnis ist nur auf dem Wege über ein gewisses Wagnis erreichbar.“"
                            },
                            {
                                "example_id": "617aba37-2cee-483f-99e0-1b84f5489ff0",
                                "sense_id": "c19f5838-4892-3a88-bb09-1b04d428496f",
                                "text": "„Bergerlebnisse im Zillertal lassen sich auf vielfältige Weise zelebrieren. Beispielsweise beim Klettern, […].“"
                            },
                            {
                                "example_id": "95a7dd39-9e62-4289-b781-270d62c44887",
                                "sense_id": "c19f5838-4892-3a88-bb09-1b04d428496f",
                                "text": "„Die sogenannten Pistengeher suchen nicht in erster Linie das ultimative Bergerlebnis.“"
                            },
                            {
                                "example_id": "f85ed73a-5f46-43be-b574-8d5812de6c38",
                                "sense_id": "c19f5838-4892-3a88-bb09-1b04d428496f",
                                "text": "„Am Themenweg Almzeit warten packend inszenierte Bergerlebnisse auf der Skigebietsseite und unberührte Naturräume auf der Stillen Seite von Sölden.“"
                            },
                            {
                                "example_id": "1a9750d3-4915-4f04-b22b-574bbb1f0b36",
                                "sense_id": "c19f5838-4892-3a88-bb09-1b04d428496f",
                                "text": "„DAV-Sprecher Thomas Bucher beklagt, dass es bei Anlagen wie dem Flying Fox nicht mehr um das »originäre Bergerlebnis« gehe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
