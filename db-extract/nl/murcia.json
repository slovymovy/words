                                        "entry_id": "1474ebd3-3d16-3c9b-a7d8-e1d08374c7a0",
                                        "glosses": [
                                            "Commune et ville d’Espagne, chef-lieu de la province du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4332192-3cc6-4ff5-bc68-dd88fbbcf0de",
                                                "sense_id": "c89506bf-c805-3f16-ad4b-a5056f5f7308",
                                                "text": "Vedette de la chanson ranchera (cow-boy) mexicaine, Vicente Fernández, 72 ans, a effectué en juin 2012 sa tournée d’adieux en Espagne, avec des concerts à Madrid, Barcelone et Murcie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc1c86c-02dd-39a9-b060-15e6e6f90b35",
                                        "entry_id": "1474ebd3-3d16-3c9b-a7d8-e1d08374c7a0",
                                        "glosses": [
                                            "Province et communauté autonome d’Espagne."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bec65346-7449-475a-81f6-f0635848d11f",
                                                "sense_id": "9bc1c86c-02dd-39a9-b060-15e6e6f90b35",
                                                "text": "Le frère de la députée et maire du Cannet est accusé d’avoir vendu, par sa société Riviera Invest, des appartements sur plans, en Grenade et Murcie, qui n’ont jamais été construits et sur des terrains qui ne lui appartenaient pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93241e0d-49b8-39e6-b059-69ff464158fe",
                                        "entry_id": "1474ebd3-3d16-3c9b-a7d8-e1d08374c7a0",
                                        "glosses": [
                                            "province et royaume (vassal et ensuite protectorat) d’Espagne ayant pour capitale la ville de Murcie de la Reconquista à 1982."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d1ba45-cf0b-4da7-8530-a498ec14a8e3",
                                                "sense_id": "93241e0d-49b8-39e6-b059-69ff464158fe",
                                                "text": "Je parcourais lentement, me dit-il un jour, les fertiles confins de ces belles province de la Grenade et de la Murcie, incertain si j’étais plus attiré par les charmes de celle que je venais voir, que retenu par les délices de celle que j’allais quitter ; …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3201211-51be-339f-90ca-3d537ecb36f2",
                                        "entry_id": "1474ebd3-3d16-3c9b-a7d8-e1d08374c7a0",
                                        "glosses": [
                                            "Taïfa maure d’Al-Andalus, de l’effondrement du califat de Cordoue en 1031 jusqu’à la Reconquista."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
