                            }
                        ]
                    },
                    {
                        "sense_id": "eca749d6-d4b2-36cf-9e79-1292bd69ad38",
                        "entry_id": "c75b6581-7640-30e4-bb8e-473d4f5b08d6",
                        "glosses": [
                            "in het openbaar iets propageren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb082c32-93b9-408b-921c-ffc7448042fa",
                                "sense_id": "eca749d6-d4b2-36cf-9e79-1292bd69ad38",
                                "text": "Hij heeft de doelstelling van Wikipedia uitgedragen op school."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ca9af00-0d2b-3655-b54e-d87f4a6b4ce6",
                        "entry_id": "c75b6581-7640-30e4-bb8e-473d4f5b08d6",
                        "glosses": [
                            "bedelen, uitdelen, verdelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "880054a3-6019-406f-9f03-c353946fd8b8",
                                "sense_id": "9ca9af00-0d2b-3655-b54e-d87f4a6b4ce6",
                                "text": "De post uitdragen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15ecee3c-03d8-409d-9d34-43f581ecee4e",
                        "source_entry_id": "c75b6581-7640-30e4-bb8e-473d4f5b08d6",
                        "target_lang_word": "advertise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advertise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e827919c-12b4-3949-b557-feed174ce14f",
                                        "entry_id": "924183b6-40ff-357a-9727-c50262a8d6e7",
                                        "glosses": [
                                            "To give (especially public) notice of (something); to announce publicly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "138f0494-1736-32ec-a724-0bef22a68168",
                                        "entry_id": "924183b6-40ff-357a-9727-c50262a8d6e7",
                                        "glosses": [
                                            "To provide information about a person or goods and services to influence others."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf5499cb-f1ec-4a62-999b-40b5a947388e",
                                                "sense_id": "138f0494-1736-32ec-a724-0bef22a68168",
                                                "text": "For personal needs, advertise on the internet or in a local newspaper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e0f1cb8-c9ec-3746-a46f-5d3a3201afac",
                                        "entry_id": "924183b6-40ff-357a-9727-c50262a8d6e7",
                                        "glosses": [
                                            "To provide public information about (a product, service etc.) in order to attract public awareness and increase sales."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9444cfa7-7caa-4ef0-bbae-daa51c1ffd85",
                                                "sense_id": "3e0f1cb8-c9ec-3746-a46f-5d3a3201afac",
                                                "text": "Over the air, they advertise their product on drive-time radio talk shows and TV news shows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79780930-b9df-3e4d-9f37-8c462d4380f9",
                                        "entry_id": "924183b6-40ff-357a-9727-c50262a8d6e7",
                                        "glosses": [
                                            "To notify (someone) of something; to call someone's attention to something."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e8bb060-5ac8-4437-afd8-b45bfbd2cd4a",
                                                "sense_id": "79780930-b9df-3e4d-9f37-8c462d4380f9",
                                                "text": "Socrates being advertiſed, that the God of wiſdome, had attributed the name of wiſe vnto him, was thereat much aſtoniſhed, and diligently ſearching and rouzing vp himſelf, and ranſaking the very ſecrets of his heart, found no foundation or ground for his divine ſentence."
                                            },
                                            {
                                                "example_id": "30cb2c39-5b05-42f7-82ee-7cdfbf039629",
                                                "sense_id": "79780930-b9df-3e4d-9f37-8c462d4380f9",
                                                "text": "[T]he Queene [Isabella of France], vvhen ſhee vvas […] aduertiſed of her huſbands dethronization, ſhee outvvardly expreſſed ſo great extremity of paſſion (notvvithſtanding that at the ſame time ſhee vvas tolde of her ſonnes [Edward III of England's] ſurrogation) as if ſhee had beene diſtraught in her vvittes: […]"
                                            },
                                            {
                                                "example_id": "58936448-8ba6-46d2-afa9-4faf0f077681",
                                                "sense_id": "79780930-b9df-3e4d-9f37-8c462d4380f9",
                                                "text": "[…] I am daily advertiſed by ſeveral friends and correſpondents from Oxford, that I have omitted many particulars, which it is proper to animadvert upon, in order to compleat the Secret Hiſtory of that place; and I have therefore, in compliance with their requeſt, reſolved to reſume this work, and continue to publiſh ſome part of it every Act-Term, till the whole is finiſhed, and the ſubject fully exhauſted: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba7f646e-0016-3c3d-81c4-c5f2ed6bcda5",
                                        "entry_id": "924183b6-40ff-357a-9727-c50262a8d6e7",
                                        "glosses": [
                                            "In gin rummy, to discard a card of one's preferred suit so as to mislead the opponent into thinking you do not want it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "955cddd1-5146-47bf-8643-305d80db1f86",
                                                "sense_id": "ba7f646e-0016-3c3d-81c4-c5f2ed6bcda5",
                                                "text": "The safest time to answer a possible advertisement is when you have no indication as to what suit your opponent wants. Then even if he has advertised, the odds are that your answer is not the card he is looking for."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
