                        "tags": [],
                        "examples": [
                            {
                                "example_id": "765e0966-c1cf-46a5-abc2-d337c77637b9",
                                "sense_id": "0e58feb2-2555-3dcc-b953-15ecb4e9441b",
                                "text": "Als Geringverdienerin und Alleinerziehende muss sie sehen, wie sie mit ihrem knappen Monatsbudget über die Runden kommt."
                            },
                            {
                                "example_id": "cb3efd45-9fcd-4c9f-b895-a3ea9e81bd02",
                                "sense_id": "0e58feb2-2555-3dcc-b953-15ecb4e9441b",
                                "text": "„Linda B. musste erst fünf Jahre Psychoterror überstehen, bevor ihr jemand den Tipp gab, dass sie als Geringverdienerin keineswegs auf einen Rechtsbeistand verzichten müsse.“"
                            }
                        ],
