                            {
                                "example_id": "af8a8c99-637e-4bcb-a203-9e57669413d2",
                                "sense_id": "e0f24308-b2f9-3d27-aca2-eea2c1a19e48",
                                "text": "Er zijn vele zilverzouten die zo slecht oplosbaar zijn dat je kunt zeggen dat ze onoplosbaar zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "8642ab82-166a-359b-8a3a-bae7ede7701c",
                        "entry_id": "e862916a-19fd-3526-a47d-bdce83e6bc18",
                        "glosses": [
                            "van een probleem of raadsel dat de oplossing niet gevonden is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e041fac-1056-4a53-8b4d-254ae829480c",
                                "sense_id": "8642ab82-166a-359b-8a3a-bae7ede7701c",
                                "text": "Na vele jaren is van de onoplosbare moord toch de moordenaar bekend geworden."
                            },
                            {
                                "example_id": "71d86e6e-6c5a-4752-8659-3c8ff6d846e7",
                                "sense_id": "8642ab82-166a-359b-8a3a-bae7ede7701c",
                                "text": "Ja, dat was precies wat zijn en Louises probleem was. Schijnbaar onoplosbaar."
                            }
                        ]
                    }
