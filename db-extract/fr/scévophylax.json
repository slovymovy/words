                "senses": [
                    {
                        "sense_id": "39c09daf-1b69-3db9-be14-669c7037a26c",
                        "entry_id": "9cab27a9-4681-3018-90be-28e875202f95",
                        "glosses": [
                            "Sacristain chargé de garder les vases sacrés, les ustensiles et autres choses précieuses qui se conservaient dans les églises."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "8290c3ec-f647-4f93-92f0-d8320002d663",
                                "sense_id": "39c09daf-1b69-3db9-be14-669c7037a26c",
                                "text": "Διάκονία peut désigner tout office ou fonction spécialisée confiée à un moine à l'intérieur de la communauté, fonction d'économe, cellérier, canonarque (chef du chœur), scévophylax (gardien des ornements sacrés), etc."
                            },
                            {
                                "example_id": "c813ab5e-a873-402a-b59d-9049373bcc2d",
                                "sense_id": "39c09daf-1b69-3db9-be14-669c7037a26c",
                                "text": "Mais cette dignité étoit fort considérable, car on voit plusieurs scevophilactes tirés de la sacristie pour être élevés sur le siège patriarchal de Constantinople"
                            },
                            {
                                "example_id": "d25ff90f-b8fb-46bd-b18c-0cf22902fa99",
                                "sense_id": "39c09daf-1b69-3db9-be14-669c7037a26c",
                                "text": "Suicer observe, d'après Photius, que le scevophilacte étoit souvent le même officier que les Grecs nommoient Chartophylax"
                            }
                        ]
                    }
                ],
