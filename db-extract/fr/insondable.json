                                        "entry_id": "e0ec4c4a-9e88-3c35-9873-5c532d9f68a5",
                                        "glosses": [
                                            "Very deep (especially of water deeper than a lead line can measure); bottomless, immeasurable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd659d9-1127-44ae-b2cd-4c43d13e9dd3",
                                                "sense_id": "70beeae7-bea7-3cc2-92fc-b48c162887db",
                                                "text": "Prais’d be the fathomless universe, / For life and joy, and for objects and knowledge curious, / And for love, sweet love—but praise! praise! praise! / For the sure-enwinding arms of cool-enfolding death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "991f5bb0-6c4d-3193-9996-48813359af93",
                                        "entry_id": "e0ec4c4a-9e88-3c35-9873-5c532d9f68a5",
                                        "glosses": [
                                            "unfathomable or incomprehensible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
