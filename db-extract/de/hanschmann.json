                ],
                "senses": [
                    {
                        "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                        "entry_id": "353934a7-75f4-38c0-a7de-07194605bb30",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324fd0d1-5948-41f5-9e00-edfe5ac59372",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "Frau Hanschmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5179fb08-bba5-40ea-9c6c-36db394e1812",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "Herr Hanschmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "361fc127-82e8-47f9-a341-5046e3557b97",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "Die Hanschmanns kommen heute vom Millstätter See."
                            },
                            {
                                "example_id": "618e5af5-b934-4ca4-8d06-93e4d1f746ab",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "Der Hanschmann trägt nie die Schals, die die Hanschmann ihm strickt."
                            },
                            {
                                "example_id": "468340a1-9770-4494-a518-8573dd8772c5",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hanschmann kommt, geht der Herr Hanschmann.“"
                            },
                            {
                                "example_id": "1dafc11a-0b77-4fbb-83d4-f0743d03ea58",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "Hanschmann kommt und geht."
                            },
                            {
                                "example_id": "a3f6e6bf-40a0-4a4a-88a5-692b6c05efa3",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "Hanschmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5147da00-ac8b-4c7f-ba77-1bacb45fe122",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "An verregneten Herbsttagen ist Familie Hanschmanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "d7bddcbc-cfe9-4b56-898e-2918775fbae6",
                                "sense_id": "ec6d22c0-7147-3fbd-8bde-e04ff3a0d03d",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hanschmann das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
