                        "entry_id": "e9a9ec25-5f56-3279-8857-a24b714bfd08",
                        "glosses": [
                            "Alternatif, relativement à un courant électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4bdf928-ad34-4930-a3a0-252f43386388",
                                "sense_id": "d340ca89-0f87-3e1f-a03e-480d1ae8ebe8",
                                "text": "Tout appareil faradique destiné à la pratique médicale, qui ne possède pas la première et la seconde bélice […]"
                            },
                            {
                                "example_id": "7721eccf-0883-4034-b35a-bd18d9f99618",
                                "sense_id": "d340ca89-0f87-3e1f-a03e-480d1ae8ebe8",
                                "text": "Nous remettions ça encore à propos de tout et de rien, des bas-varices, du courant faradique optima, du traitement des cellulites de la région du coude…"
                            },
                            {
                                "example_id": "e1148b71-b610-41d8-917a-143d27396b0c",
                                "sense_id": "d340ca89-0f87-3e1f-a03e-480d1ae8ebe8",
                                "text": "La stimulation faradique est faite d'impulsions de durée brève (1 ms) délivrées en impulsions isolées ou à l'aide d'un courant périodique de fréquence de 5o Hz."
                            }
                        ]
                    }
