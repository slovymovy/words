                                "target_senses": [
                                    {
                                        "sense_id": "df311bdd-e805-33ca-9c26-38bc6a24bd76",
                                        "entry_id": "4988f39c-24d1-304d-adc4-6d0dc61d253d",
                                        "glosses": [
                                            "Relatif à la Lusitanie, aux Lusitaniens, Ibères habitant l'ouest de la péninsule ibérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f9079b3-ddb0-4004-906d-f1341d4a417f",
                                                "sense_id": "df311bdd-e805-33ca-9c26-38bc6a24bd76",
                                                "text": "Les guerres lusitaniennes portées par le chef lusitanien Viriate se terminent avec l'assassinat de ce dernier par ses lieutenants et la paix signée avec les Romains en 139 avant J.C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89f04d4-1795-3261-87af-6231d4fcb363",
                                        "entry_id": "4988f39c-24d1-304d-adc4-6d0dc61d253d",
                                        "glosses": [
                                            "Synonyme littéraire de portugais. → voir lusitain"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e51e62-4e84-4ade-baef-d7ec6e3ad3b4",
                                                "sense_id": "f89f04d4-1795-3261-87af-6231d4fcb363",
                                                "text": "…un voyage maritime et gourmand au cœur des saveurs lusitaniennes."
                                            },
                                            {
                                                "example_id": "19fc8106-2c25-4156-b639-e9625ca37ddb",
                                                "sense_id": "f89f04d4-1795-3261-87af-6231d4fcb363",
                                                "text": "Michel Chandeigne a été le pionnier de la diffusion de la culture lusitanienne en France, accompagnant l’ouverture du Portugal à l'Europe […]."
                                            },
                                            {
                                                "example_id": "b9904cd0-9d28-4eb2-bf05-021afea7fb59",
                                                "sense_id": "f89f04d4-1795-3261-87af-6231d4fcb363",
                                                "text": "Beaucoup de concessions, donc, sauf une : faire l’amour avec elle, tandis que son paternel – l’ours lusitanien au pot de miel – dormait juste de l’autre côté de la fine cloison plâtrée de leur chambre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lusitanien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cc77874-4f08-3265-82ba-5ac476a533dd",
                                        "entry_id": "56b48af5-21f5-3b4f-928f-dd4c5bf4090f",
                                        "glosses": [
                                            "Race de cheval de parade et cheval de selle de sang d’origine portugaise, dérivé du cheval ibère, très proche du pure race espagnole et dont la taille au garrot moyenne est voisine de 1,6 m : haute école, spectacle équestre, dressage, corrida, loisirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f96592c-421c-4cc4-9031-ad99c54a4eed",
                                                "sense_id": "3cc77874-4f08-3265-82ba-5ac476a533dd",
                                                "text": "Moins tributaire des aléas de l’histoire que son voisin l’andalou, le lusitanien n’a pas connu d'hémorragie dans ses effectifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
