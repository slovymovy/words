                {
                    "sense_id": "c6e859fe-ccbc-3eb8-847d-651b0abae633",
                    "sense_definition": "Mouiller abondamment et détremper, en particulier par une forte pluie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouiller",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un orage soudain a éclaté et la pluie nous a complètement <w>rincés</w>.",
                            "target_lang_translations": {
                                "en": "A sudden storm broke out and the rain completely <w>drenched</w> us.",
                                "ru": "Внезапно разразилась гроза, и дождь нас полностью <w>промочил</w>.",
                                "de": "Plötzlich brach ein Gewitter los, und der Regen hat uns völlig <w>durchnässt</w>.",
                                "es": "De repente estalló una tormenta y la lluvia nos <w>empapó</w> por completo.",
                                "zh": "突然刮起了暴风雨，我们被大雨<w>淋湿</w>了。"
                            }
                        },
                        {
                            "text": "Sans manteau sous cette averse, vous allez vous faire <w>rincer</w> en quelques minutes.",
                            "target_lang_translations": {
                                "en": "Without a coat in this downpour, you'll get <w>soaked</w> within minutes.",
                                "ru": "Без плаща под таким ливнем вы <w>промокнете</w> за несколько минут.",
                                "de": "Ohne Mantel werden Sie bei diesem Platzregen in wenigen Minuten <w>durchnässt</w>.",
                                "es": "Sin abrigo bajo este aguacero, <w>se</w> van a <w>calar</w> en cuestión de minutos.",
                                "zh": "这场阵雨里若不穿外套，你几分钟就会被<w>淋透</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "détremper",
                        "inonder",
                        "tremper"
                    ],
                    "antonyms": [
                        "sécher"
                    ],
                    "common_phrases": [
                        "se faire rincer"
                    ],
                    "traits": [
