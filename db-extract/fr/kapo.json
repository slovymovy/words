                                            {
                                                "example_id": "9929fe61-9673-455d-ba3c-4629ff24820b",
                                                "sense_id": "5196fc19-5a81-330c-a951-3b578f345304",
                                                "text": "Der Kapo hat seine Anweisungen korrekt gegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd6870ff-0e86-3c7a-b825-37f84683b474",
                                        "entry_id": "f84dae3b-f292-3151-82cc-f7f09f27e680",
