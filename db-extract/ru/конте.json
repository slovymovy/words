                                        ]
                                    },
                                    {
                                        "sense_id": "17215798-03cb-36a9-8338-66fce005e362",
                                        "entry_id": "0b1375ec-1aa5-3eec-b8c3-56a27fd383c2",
                                        "glosses": [
                                            "Commandant militaire."
                                        ],
                                        "tags": [
