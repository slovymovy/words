                    {
                        "sense_id": "f235d9d2-0a55-3434-9bbc-074098d58411",
                        "entry_id": "26523e47-1cb2-3261-98b2-f44dc57177ee",
                        "glosses": [
                            "Équivalent du juron anglais goddamn."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "e09ca0a2-87e3-4f5f-9959-e7425bbd30c9",
                                "sense_id": "f235d9d2-0a55-3434-9bbc-074098d58411",
                                "text": "Goddam ! on vous apporte un pied de bœuf salé sans pain. C'est admirable ! Aimez-vous à boire un coup d'excellent bourgogne ou de clairet ? rien que celui-ci. (Il débouche une bouteille.)"
                            },
                            {
                                "example_id": "4a6eaa27-8894-44f4-8e21-3b1fd6175c31",
                                "sense_id": "f235d9d2-0a55-3434-9bbc-074098d58411",
                                "text": "L’autre sursauta, le regarda avec des yeux ronds, puis grogna :\n– Goddam ! I don’t understand what you say ! avant de lui tourner le dos."
                            }
                        ]
                    }
                ],
