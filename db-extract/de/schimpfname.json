                        "form": "den Schimpfnamen"
                    },
                    {
                        "form_id": "a834ed8b-4cd7-4126-bdb8-8a68a106ed41",
                        "entry_id": "bd750166-d4fa-3d1a-a877-35f9dbb83d69",
                        "tags": [
                            "accusative",
