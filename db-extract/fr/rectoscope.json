                    {
                        "sense_id": "caf13779-048a-37be-9c8c-6c94341bf6bb",
                        "entry_id": "84b62a14-4f59-3a60-978d-c056442522c4",
                        "glosses": [
                            "Appareil tubulaire muni d'une lumière pour procéder à l'examen du rectum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b22cf4c-c491-499f-bb3e-718936428e8d",
                                "sense_id": "caf13779-048a-37be-9c8c-6c94341bf6bb",
                                "text": "Une rectoscopie est un examen médical permettant à l'aide d'un rectoscope introduit dans l'anus, de visualiser le canal anal, la totalité du rectum et la partie distale du côlon sigmoïde, jusqu'à la charnière rectosigmoïdienne située à 12 ou 13 cm de la marge anale."
                            },
                            {
                                "example_id": "d27d141f-84b3-497c-bc3f-324f05bed95d",
                                "sense_id": "caf13779-048a-37be-9c8c-6c94341bf6bb",
                                "text": "Elle est réalisée avec un rectoscope rigide de 25 cm de longueur et de 2 cm de diamètre, dont on trouve actuellement des exemplaires à usage unique."
                            }
                        ]
                    }
                ],
