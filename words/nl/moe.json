                    "frequency": "Low",
                    "semantic_group_id": "vermoeidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>moede</w> reiziger zocht eindelijk een plek om de nacht door te brengen.",
                            "target_lang_translations": {
                                "en": "The <w>weary</w> traveler finally sought a place to spend the night."
                            }
                        },
                        {
                            "text": "Zijn <w>moeë</w> ogen staarden naar de verre horizon terwijl de zon langzaam onderging.",
                            "target_lang_translations": {
                                "en": "His <w>tired</w> eyes stared at the distant horizon while the sun slowly set."
                            }
