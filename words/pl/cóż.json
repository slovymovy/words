                            "text": "<w>Cóż</w> to za niespodzianka!",
                            "target_lang_translations": {
                                "ru": "<w>Что за</w> сюрприз!"
                            }
                        },
                        {
                            "text": "<w>Cóż</w> za niesamowity widok przed nami.",
                            "target_lang_translations": {
                                "ru": "<w>Что за</w> невероятный вид перед нами."
                            }
