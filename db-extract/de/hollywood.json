                        "sense_id": "73121da2-738a-3b5c-ab99-48fdd77fac71",
                        "entry_id": "12db8bca-4e22-3390-9633-686637a41f6e",
                        "glosses": [
                            "Stadtteil der US-Stadt Los Angeles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae52621-61a3-49da-a71a-62f5f740829d",
                                "sense_id": "73121da2-738a-3b5c-ab99-48fdd77fac71",
                                "text": "Was, du gehst nach Hollywood?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b83aff29-e172-3c31-8653-2c4a927dfe91",
                        "entry_id": "12db8bca-4e22-3390-9633-686637a41f6e",
                        "glosses": [
                            "das Zentrum der US-amerikanischen Filmindustrie"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7ceae6bb-3f0b-481c-9ee1-536d90e372af",
                                "sense_id": "b83aff29-e172-3c31-8653-2c4a927dfe91",
                                "text": "Was, du gehst nach Hollywood?"
                            },
                            {
                                "example_id": "f58a626f-1689-410c-ba88-08eb52726510",
                                "sense_id": "b83aff29-e172-3c31-8653-2c4a927dfe91",
                                "text": "Es ist der Traum vieler junger Menschen, nach Hollywood zu gelangen und dort den großen Karrieredurchbruch zu schaffen."
                            },
                            {
                                "example_id": "10e653b2-9ff2-4834-9dc5-dd9f476b37f7",
                                "sense_id": "b83aff29-e172-3c31-8653-2c4a927dfe91",
                                "text": "„Robert Lantz wird sein neuer Agent in Amerika, und er handelt glänzende Verträge mit Hollywood aus.“"
                            },
                            {
                                "example_id": "81d02845-f202-42b7-b835-fb57b38c61d5",
                                "sense_id": "b83aff29-e172-3c31-8653-2c4a927dfe91",
                                "text": "„Doch, doch, Sie haben schon verstanden: Hollywood importiert nach wie vor sein Talent aus Deutschland.“"
                            },
                            {
                                "example_id": "06d67f43-9d14-461c-ad78-051ad67053c4",
                                "sense_id": "b83aff29-e172-3c31-8653-2c4a927dfe91",
                                "text": "„Er könnte in Hollywood Drehbücher schreiben, fern von Repressalien durch das nationalsozialistische Regime.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
