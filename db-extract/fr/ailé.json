                                                "text": "weak-winged"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a6757e5-8793-3720-b3c0-e86d118a1f2b",
                                        "entry_id": "3b9f5f74-acf8-3617-8e78-ec8e04446578",
                                        "glosses": [
                                            "Having wings.",
                                            "Having the specified number of wings."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62761420-b6d6-41b7-b800-365bfde85b07",
                                                "sense_id": "5a6757e5-8793-3720-b3c0-e86d118a1f2b",
                                                "text": "The six-winged Seraphim are the angels closest to God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbd68bb8-6373-3a12-9d17-4fc3563e6f0b",
                                        "entry_id": "3b9f5f74-acf8-3617-8e78-ec8e04446578",
                                        "glosses": [
                                            "Flying or soaring as if on wings."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1e6f2fc-d22b-3f5e-b280-7b0e361b17a2",
                                        "entry_id": "3b9f5f74-acf8-3617-8e78-ec8e04446578",
                                        "glosses": [
                                            "Swift."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e43052f1-8446-4aaf-8a5e-fe755aa175a5",
                                                "sense_id": "f1e6f2fc-d22b-3f5e-b280-7b0e361b17a2",
                                                "text": "Come Tamburlain, now whet thy winged ſword\nAnd lift thy loftie arme into the cloudes,\nThat it may reach the King of Perſeas crowne,\nAnd ſet it ſafe on my victorious head."
                                            }
                                        ]
                                    }
