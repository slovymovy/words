                    },
                    {
                        "sense_id": "23c317de-6ef6-3126-b72a-4d1837f3ce08",
                        "entry_id": "25f362db-ac58-3487-ad52-f8f6adf71f80",
                        "glosses": [
                            "to give a sound flogging"
                        ],
                        "tags": [
