                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb4ca4a-30d1-3361-a607-c92d2e60e2c1",
                                        "entry_id": "1e49dcc8-1383-36dd-8a86-052bf0885077",
                                        "glosses": [
                                            "Libyen oder die Libyer betreffend, aus Libyen kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bd3276b-0d93-49ea-a5b5-e0f06e195bfb",
                                                "sense_id": "bcb4ca4a-30d1-3361-a607-c92d2e60e2c1",
                                                "text": "Sie segelten unter libyscher Flagge, die Besatzung bestand neben dem Kapitän aus fünf Offizieren und fünfundzwanzig Matrosen."
                                            },
                                            {
                                                "example_id": "1d392ee7-2ecb-4f5e-8fe4-b646e3d71661",
                                                "sense_id": "bcb4ca4a-30d1-3361-a607-c92d2e60e2c1",
                                                "text": "Anläßlich eines solchen Manövers eskalierte die Konfrontation mit dem Abschuß zweier libyscher Flugzeuge im August 1981."
                                            },
                                            {
                                                "example_id": "6d271e12-f778-4be9-95cd-8abe71f86e24",
                                                "sense_id": "bcb4ca4a-30d1-3361-a607-c92d2e60e2c1",
                                                "text": "Nach einem mannhaften Bekenntnisse vor dem Stadthalter Ämilianus wurde Dionysius nach Kephro in Libyen und sodann, weil er unter den dortigen Heiden mit Erfolg den Samen des göttlichen Wortes ausstreute, nach dem „noch rauheren und libyscheren“ Kolluthion in der Mareotis verbannt."
                                            },
                                            {
                                                "example_id": "96e0dd2f-09a9-4275-b7ce-7886c9db32a8",
                                                "sense_id": "bcb4ca4a-30d1-3361-a607-c92d2e60e2c1",
                                                "text": "Das folgende Jahr trug Antigonos einen neuen Beinamen ein, “libyschster aller punischen Hellenen”, weil er abermals tief in den Süden reiste, über den Gyr hinaus in Gebiete, in denen die riesigen menschenähnlichen Fellwesen heimisch waren, die zweieinhalb Jahrhunderte zuvor Hanno der Seefahrer gorilla genannt hatte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfd70d5a-40fe-4709-bcde-07d962bca2a1",
                        "source_entry_id": "87b7511d-3e5c-39f9-bfa0-c05569cb9435",
                        "source_sense_id": "1de21730-6843-3438-ae54-d232fb82e0e3",
