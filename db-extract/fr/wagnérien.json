                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ce7a4e8-2d7a-3da0-964a-82608404a2a3",
                        "entry_id": "93c8deca-07ca-38be-bc84-e72d1ec45204",
                        "glosses": [
                            "Relatif à Wagner, à sa musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "705795a0-4a48-44be-b464-eedf1ffcbb91",
                                "sense_id": "0ce7a4e8-2d7a-3da0-964a-82608404a2a3",
                                "text": "Le rendu donnait un style wagnérien (la métaphore est d’Herbin lui-même, grand amateur de musique classique), spectacle fait de quelques passes immédiatement verticales, de nuques longues et de moustaches guerrières donnant aux courses époumonées une indéniable esthétique télévisuelle."
                            },
                            {
                                "example_id": "5c381414-5736-4fdc-9333-7388f4baf744",
                                "sense_id": "0ce7a4e8-2d7a-3da0-964a-82608404a2a3",
                                "text": "Parce que Charlie Roquin a le talent de nous émerveiller dans ces joutes oratoires wagnériennes, passionnantes, tout en maintenant une pression sur le lecteur quant à l’issue de cette confrontation."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef194aef-d08f-369f-86da-550e9951b2c7",
                        "entry_id": "93c8deca-07ca-38be-bc84-e72d1ec45204",
                        "glosses": [
                            "Relatif à la milice russe « Wagner »."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "564f5804-8296-4c9d-a0c7-7ff207030c13",
                        "source_entry_id": "93c8deca-07ca-38be-bc84-e72d1ec45204",
                        "target_lang_word": "wagnerianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wagnerianisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31ca4c82-1312-3cb9-8c64-bee8888e6bd2",
                                        "entry_id": "773ae92b-0b7b-3671-b668-dd83ca069e42",
                                        "glosses": [
                                            "im Stil Richard Wagners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4419235-0e7a-46ec-bfa0-3fc275591189",
                                                "sense_id": "31ca4c82-1312-3cb9-8c64-bee8888e6bd2",
                                                "text": "Da mag das Orchester noch so wagnerianisch aufrauschen: […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db6d8a4-d5d2-4317-b9de-45bb934f41c3",
                        "source_entry_id": "93c8deca-07ca-38be-bc84-e72d1ec45204",
                        "target_lang_word": "Wagnerian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wagnerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08aefab9-da6f-3411-9056-b32e6b899a4c",
                                        "entry_id": "9fab2140-7afe-38ef-ad21-20c1886a1335",
                                        "glosses": [
                                            "Of, or characteristic of Richard Wagner, or his music; (by extension) of epic dimensions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527991e2-3b17-472b-8bf9-274169f6c5ca",
                                                "sense_id": "08aefab9-da6f-3411-9056-b32e6b899a4c",
                                                "text": "Clearly, Hitler saw his historical function as a Wagnerian grand opera. Vast cosmic changes required an accompaniment of slaughter on a colossal scale."
                                            },
                                            {
                                                "example_id": "32e89101-06eb-43c8-a610-63d42e277ed5",
                                                "sense_id": "08aefab9-da6f-3411-9056-b32e6b899a4c",
                                                "text": "It is a glossy film with gross, opulent opticals and little comic, or any, relief; it has the jaundiced complexion of an early 60s underground film, which it is; it is ponderous, Wagnerian, and feels about five hours long (its running time is about an hour)."
                                            },
                                            {
                                                "example_id": "e19abac8-6cc4-49ea-a50b-3026569495ff",
                                                "sense_id": "08aefab9-da6f-3411-9056-b32e6b899a4c",
                                                "text": "Thus Gilgamesh and Enkidu as a dyad express a Wagnerian leitmotif that plays upon themes from racial memories of the two different races at the dawn of hominization."
                                            }
                                        ]
                                    }
                                ]
                            },
