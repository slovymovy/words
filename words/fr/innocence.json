                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a présenté de nouvelles preuves pour démontrer l'<w>innocence</w> de son client devant le juge."
                        },
                        {
                            "text": "Le suspect a toujours clamé son <w>innocence</w> malgré les nombreuses accusations portées contre lui."
                        }
                    ],
                    "antonyms": [
