                    "sense_id": "1e7a0134-da04-3832-a427-6624b7fa524c",
                    "sense_definition": "De manier waarop iets is samengesteld of georganiseerd.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "structuur",
                    "name_type": "no",
                    "examples": [
