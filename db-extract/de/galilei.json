                "senses": [
                    {
                        "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                        "entry_id": "07dd7506-64b3-3ce1-90ef-7cc2d4d865bb",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06831936-b5a7-4ca8-a67e-4d75a65394b5",
                                "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                                "text": "Galilei kommt und geht."
                            },
                            {
                                "example_id": "c26310e0-030c-4e7d-8e20-290ce7d59de5",
                                "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                                "text": "Galileis kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e877f3f1-7ae3-40ef-9103-b49f9474bbf3",
                                "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                                "text": "Frau Galilei ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a3cba9c5-4d08-4579-8ad7-b2a50ada6274",
                                "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                                "text": "Herr Galilei wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a81066a9-9802-459e-9ba5-a3be2217376a",
                                "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                                "text": "Die Galileis fahren heute nach Mailand."
                            },
                            {
                                "example_id": "2cb17f9e-4cf4-4f42-96d0-bbc174095556",
                                "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                                "text": "Der Galilei trägt nie die Schals, die die Galilei ihm strickt."
                            },
                            {
                                "example_id": "f30be390-bdae-4ccd-8338-08687ebcf775",
                                "sense_id": "1e3309c8-0e8d-3b31-9e6e-e4d192fa4afe",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Galilei kommt, geht der Herr Galilei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
