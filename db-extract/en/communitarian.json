                    {
                        "sense_id": "e809b235-b0ba-3440-8829-c62d4e18efd4",
                        "entry_id": "5055e3e0-0315-3085-8543-522751674db5",
                        "glosses": [
                            "Considering the community to be of central importance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec4c849-9a8c-4c68-80b6-704f15400a89",
                                "sense_id": "e809b235-b0ba-3440-8829-c62d4e18efd4",
                                "text": "Prior to the modern age, most human societies were communitarian."
                            },
                            {
                                "example_id": "f32b7807-7591-42d9-b960-8075eddab96c",
                                "sense_id": "e809b235-b0ba-3440-8829-c62d4e18efd4",
                                "text": "Based on their remarks, he said, some of the smart-meter opponents are a blend of egalitarian and communitarian."
                            }
                        ]
                    },
                    {
                        "sense_id": "facc4f71-f20e-3cd4-b623-19bd07b719fc",
                        "entry_id": "5055e3e0-0315-3085-8543-522751674db5",
                        "glosses": [
                            "Of or pertaining to the philosophy of communitarianism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e51207a-bcd7-4266-83ee-8980fc250f40",
                                "sense_id": "facc4f71-f20e-3cd4-b623-19bd07b719fc",
                                "text": "This book takes a communitarian approach to ethics."
                            }
                        ]
                    }
                ],
