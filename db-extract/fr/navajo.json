                "senses": [
                    {
                        "sense_id": "9290895d-384f-3585-9b07-c315e0aedeb7",
                        "entry_id": "a6ef45ec-31a3-3b40-9208-62582763754d",
                        "glosses": [
                            "Membre du peuple amérindien d’Amérique du Nord des Navajos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a9fde7-115d-4f2c-a24e-a37b0f13306e",
                                "sense_id": "9290895d-384f-3585-9b07-c315e0aedeb7",
                                "text": "Mais, d’un geste, le jeune Navajo baissa son arme. Au passage, il heurta l’une des branches du mesquite, ce qui provoqua un mouvement brusque du cerf-mulet. Ses muscles vibrèrent comme la queue d’un crotale et il releva la tête, aux aguets."
                            },
                            {
                                "example_id": "84c1fef3-cff5-489b-8c9a-56cb655e7753",
                                "sense_id": "9290895d-384f-3585-9b07-c315e0aedeb7",
                                "text": "Le festival offrait ainsi l’opportunité d’admirer une Navajo en plein travail devant le hogan."
                            }
                        ]
                    }
                ],
