                },
                {
                    "sense_id": "d837dadc-8bea-3cfb-aa1a-a04931ee1ae5",
                    "sense_definition": "A decorative casket or box used to hold the relics of a saint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval <w>chasse</w> was adorned with intricate enamel work and precious gemstones.",
                            "target_lang_translations": {
