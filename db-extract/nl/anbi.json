                        "glosses": [
                            "instelling die belastingvoordelen heeft omdat het zonder winstoogmerk het algemene nut dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770e0d94-1672-4489-b6f1-0581b6e0b763",
                                "sense_id": "98f924c4-cb8f-3842-9f33-bb0fb9b3a32f",
                                "text": "Die stichtingen zijn door de Belastingdienst erkend als Algemeen Nut Beogende Instelling (ANBI). Daardoor hoeven ze geen belasting te betalen over giften, en mogen ze zelf uitkeringen doen waarover geen belasting hoeft te worden betaald. Ook mogen donateurs hun giften aan de stichtingen aftrekken."
                            },
                            {
                                "example_id": "ab3b1f61-2503-4d23-bf4a-6e8a0da7990b",
                                "sense_id": "98f924c4-cb8f-3842-9f33-bb0fb9b3a32f",
                                "text": "Giften aan goede doelen met een anbi-status zijn aftrekbaar voor de belastingen en de organisatie geniet ook andere belastingvoordelen. Anbi is de afkorting van: algemeen nut beogende instelling. In totaal zijn er zo'n 36.000 organisaties met deze status."
                            }
                        ]
                    }
