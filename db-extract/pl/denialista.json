                                        "sense_id": "85394e18-fe92-3141-a35d-d8447803081f",
                                        "entry_id": "8e1d858e-1668-3040-97fd-56803190b7c9",
                                        "glosses": [
                                            "jemand, der leugnet, der etwas in Abrede stellt oder verneint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bfea2eb-80e0-49b2-8a03-12fccb360489",
                                                "sense_id": "85394e18-fe92-3141-a35d-d8447803081f",
                                                "text": "Er war ein Leugner ewiger Wahrheiten, ein Rebell und ein Rationalist."
                                            },
                                            {
                                                "example_id": "f00aa131-160d-44f0-82c7-f66af7337ccd",
                                                "sense_id": "85394e18-fe92-3141-a35d-d8447803081f",
                                                "text": "Du bist ein Leugner und Heuchler! Natürlich hast du die Tür nicht abgeschlossen, und ich glaube dir nicht, dass dir das, was dann passierte, leid tut."
                                            }
                                        ],
