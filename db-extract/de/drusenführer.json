                    {
                        "sense_id": "5c1a27e7-6a39-3b37-920a-e4d374c5bf96",
                        "entry_id": "e10cf783-7433-383a-bdb1-52c1b36212fc",
                        "glosses": [
                            "Anführer einer drusischen Gruppierung, aus Drusen bestehenden Bewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d854f202-525c-449a-b050-b13cb8ff7bbc",
                                "sense_id": "5c1a27e7-6a39-3b37-920a-e4d374c5bf96",
                                "text": "„Sein mächtiger Kontrahent, Innenminister und Drusenführer Kamal Dschumblat, der sich auch schon für Nassers Panarabismus begeistert hatte, gerierte sich jetzt als leidenschaftlicher Befürworter des palästinensischen Widerstands, für den er die volle Solidarität und Unterstützung der Libanesen forderte.“"
                            },
                            {
                                "example_id": "fbba3a04-e5c8-4af3-8bba-301fe8559f3c",
                                "sense_id": "5c1a27e7-6a39-3b37-920a-e4d374c5bf96",
                                "text": "„In einem vertraulichen Memorandum an Eschkol erklärte Allon, dass es zwischen den Drusenführern und Damaskus allgemeine Spannungen gebe und dass die Drusen sich vielleicht erheben würden, um sich einen eigenen Staat zu erkämpfen.“"
                            }
                        ],
