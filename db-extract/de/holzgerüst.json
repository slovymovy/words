                "senses": [
                    {
                        "sense_id": "92249d96-9bf1-3dee-973d-2f3f382036a1",
                        "entry_id": "fbc93dbc-c7da-3d7c-9798-6f09c96ac233",
                        "glosses": [
                            "Gerüst aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da98425d-afd7-42ce-9aad-37b6019267d2",
                                "sense_id": "92249d96-9bf1-3dee-973d-2f3f382036a1",
                                "text": "„Bei uns bauten Handwerker Holzgerüste auf, weil das Haus seinen Außenputz bekommen sollte.“"
                            },
                            {
                                "example_id": "5a25ac31-e899-4447-9210-cca92278aba3",
                                "sense_id": "92249d96-9bf1-3dee-973d-2f3f382036a1",
                                "text": "„Die Schau fand nicht in der Kirche statt, sondern von einem Holzgerüst aus, das man vor der Kirche errichtet und mit Teppichen verhängt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
