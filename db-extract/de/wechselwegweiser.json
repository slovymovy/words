                "senses": [
                    {
                        "sense_id": "6f9d3633-0c18-3746-b8da-96b498e34719",
                        "entry_id": "38322a68-5ddc-3888-900c-2f920437ae3d",
                        "glosses": [
                            "Wegweiser auf Autobahnen und anderen Straßen, dessen Inhalt dynamisch an die Verkehrssituation angepasst werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6156a9f-c3fd-454c-adc5-00c3f2e64f67",
                                "sense_id": "6f9d3633-0c18-3746-b8da-96b498e34719",
                                "text": "„Kommt es zu Verkehrsstörungen auf einem Streckenabschnitt, wird der Verkehr mit Hilfe von Wechselwegweisern auf eine Alternativroute umgeleitet.“"
                            },
                            {
                                "example_id": "0c65f655-555b-44dd-a821-ee431003b699",
                                "sense_id": "6f9d3633-0c18-3746-b8da-96b498e34719",
                                "text": "Um möglichst schnell über kurze Sperrungen zu informieren, nutzt das ASTRA sogenannte Wechselwegweiser."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
