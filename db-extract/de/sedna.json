                ],
                "senses": [
                    {
                        "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                        "entry_id": "84a7b0ca-5559-3c02-a5e7-258ef6f92145",
                        "glosses": [
                            "großes transneptunisches Objekt jenseits des Kuipergürtels, das höchstwahrscheinlich zu den Zwergplaneten gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76993c68-8d1a-4228-9beb-5d46fe0d969a",
                                "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                                "text": "Sedna wurde am 14. November 2003 entdeckt."
                            },
                            {
                                "example_id": "9f11aebf-1bab-436a-b05a-f25581f017b4",
                                "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                                "text": "Sednas Oberfläche ist rot gefärbt."
                            },
                            {
                                "example_id": "cbf7acda-03c7-4802-8ecd-96e16f7df959",
                                "sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                                "text": "„Sedna hat einen Durchmesser von höchstens 1600 Kilometern, das entspricht etwa drei Vierteln der Größe Plutos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efd8e900-6f2d-4490-9958-3ea6956ff233",
                        "source_entry_id": "84a7b0ca-5559-3c02-a5e7-258ef6f92145",
                        "source_sense_id": "32019209-07ba-3441-a9ce-056a92b5691e",
                        "source_sense_description": "Planetoid",
                        "target_lang_word": "Sedna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sedna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02fb3a34-fcef-39d2-bfab-0c8ef8fdf4d4",
                                        "entry_id": "147cc77a-cac5-3ff5-8921-ac616d9d3467",
                                        "glosses": [
                                            "The Inuit goddess of the sea and marine animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d12d22b-bd40-4a98-afb8-4c3c1906410c",
                                                "sense_id": "02fb3a34-fcef-39d2-bfab-0c8ef8fdf4d4",
                                                "text": "Sedna began to enjoy keeping all the sea creatures away from the humans by tucking them into her now miles-long hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a294138f-113d-3f5c-8c96-1d8922f8d1d0",
                                        "entry_id": "147cc77a-cac5-3ff5-8921-ac616d9d3467",
                                        "glosses": [
                                            "a dwarf planet whose eccentric detached orbit is wholly beyond the Kuiper belt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a68e9f0-e8e1-452a-a6f1-6d142d937cf9",
                                                "sense_id": "a294138f-113d-3f5c-8c96-1d8922f8d1d0",
                                                "text": "Scattered beyond the Kuiper Belt is a disk of objects such as Eris and Sedna."
                                            },
                                            {
                                                "example_id": "dad163dc-cc19-4219-bbab-49cccb6a4d56",
                                                "sense_id": "a294138f-113d-3f5c-8c96-1d8922f8d1d0",
                                                "text": "Brown clicked on a button to have the computer calculate just how far away the object was, and came up with a distance farther than Pluto, even farther than Sedna: about 97 AU. Then he ran some quick calculations to estimate how big the object was, assuming that it was as reflective as Sedna."
                                            },
                                            {
                                                "example_id": "abf1c9e3-46bf-4a2e-b615-e8122f4d8996",
                                                "sense_id": "a294138f-113d-3f5c-8c96-1d8922f8d1d0",
                                                "text": "2010, Rodney S. Gomes, Jean S. Soares, Sedna, 2004 VN112 and 2000 CR105: the tip of an iceberg, Julio A. Fernández, Daniela Lazzaro, Dina Prialnik, Rita Schulz (editors), Icy Bodies of the Solar System: Proceedings of the 263rd Symposium of the International Astronomical Union (IAU S263), page 67,\nWe review two main scenarios that may have implanted Sedna, 2004 VN112 and 2000 CR105 on their current peculiar orbits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7683d39b-a0cb-3409-96fd-3470031056c8",
                                        "entry_id": "147cc77a-cac5-3ff5-8921-ac616d9d3467",
                                        "glosses": [
                                            "Ellipsis of Sedna Planitia: a plain on the planet of Venus"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
