                                "target_senses": [
                                    {
                                        "sense_id": "9c3c4b2d-31c3-393a-8f33-a802e7bfa8bc",
                                        "entry_id": "826cd409-9ebb-372e-9bba-dfa3b2eb666e",
                                        "glosses": [
                                            "Of or pertaining to the Waldenses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb1c78e-7c54-4018-8d36-7039f7ffcdb1",
                                                "sense_id": "9c3c4b2d-31c3-393a-8f33-a802e7bfa8bc",
                                                "text": "A spin-off of the Waldensian sect began in 1207 when Durand of Huesca, an early follow of Waldo, converted to Catholicism."
                                            },
                                            {
                                                "example_id": "b24e1682-78d9-44a3-beb6-2bbaf8965f8c",
                                                "sense_id": "9c3c4b2d-31c3-393a-8f33-a802e7bfa8bc",
                                                "text": "Valdensian communities took to the mountains of Savoy, and would defy the authorities in the best Burgundian manner for centuries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Waldensian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb432138-3a62-3f29-94e6-c5a005a2e0b9",
