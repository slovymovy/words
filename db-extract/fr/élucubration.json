                    {
                        "sense_id": "5e1cd2da-807e-3bc9-bd8f-26ea15b187d9",
                        "entry_id": "9069985c-0291-31b1-b7c1-fa932f3a1adb",
                        "glosses": [
                            "lucubration, elucubration (results of intense study with little value; used ironically)"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "12647305-3233-467e-843d-baf9e365733d",
                                "sense_id": "5e1cd2da-807e-3bc9-bd8f-26ea15b187d9",
                                "text": "Insultée, ridiculisée, elle dut s'enfermer dans ses domaines; et malgré un tempérament généreux, devenue à moitié folle, elle ne produisit plus que d'extravagantes élucubrations."
                            }
                        ]
