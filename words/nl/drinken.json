                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>drink</w> elke ochtend een kopje koffie bij het ontbijt.",
                            "target_lang_translations": {
                                "en": "I <w>drink</w> a cup of coffee every morning at breakfast.",
                                "ru": "Я <w>пью</w> чашку кофе каждое утро за завтраком.",
                                "pl": "Każdego ranka do śniadania <w>piję</w> filiżankę kawy.",
                                "de": "Ich <w>trinke</w> jeden Morgen eine Tasse Kaffee zum Frühstück.",
                                "fr": "Je <w>bois</w> une tasse de café chaque matin au petit-déjeuner.",
                                "it": "<w>Bevo</w> una tazza di caffè ogni mattina a colazione.",
