                ],
                "senses": [
                    {
                        "sense_id": "31bae9c5-fe6e-35e3-86c9-3e3d13875c30",
                        "entry_id": "c43e1f29-29dd-3e34-931a-c77e332cbeaa",
                        "glosses": [
                            "bereid zich te gedragen in overeenstemming met algemeen aanvaarde waarden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff515db-9df7-4b07-9f28-fe0b93e42b0f",
                                "sense_id": "31bae9c5-fe6e-35e3-86c9-3e3d13875c30",
                                "text": "Een deugdzaam leven is een wijs leven."
                            },
                            {
                                "example_id": "699a76ec-1ecd-4da1-b049-f9684f22ddc6",
                                "sense_id": "31bae9c5-fe6e-35e3-86c9-3e3d13875c30",
                                "text": "Zoals van een deugdzame vrouw werd verwacht, knikte deze dan begripvol en luisterde gedwee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44b00bc2-4231-43a5-a30a-1325284f67e9",
                        "source_entry_id": "c43e1f29-29dd-3e34-931a-c77e332cbeaa",
                        "source_sense_id": "31bae9c5-fe6e-35e3-86c9-3e3d13875c30",
                        "source_sense_description": "bereid zich te gedragen in overeenstemming met algemeen aanvaarde waarden",
                        "target_lang_word": "tugendhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tugendhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "723a030b-d27a-3664-a3f1-a4a8d9b02598",
                                        "entry_id": "23f4f9af-f53c-3e48-9d28-bd5b3111554a",
                                        "glosses": [
                                            "den Sitten entsprechend, sich vorbildlich verhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710c1b85-9810-431c-9ae3-5bf693b7ae19",
                                                "sense_id": "723a030b-d27a-3664-a3f1-a4a8d9b02598",
                                                "text": "„Auch Robbespierre hielt sich bekanntlich für einen tugendhaften Menschen, als er all jene, die nicht seinen Tugendvorstellungen entsprachen, auf die Guillotine schickte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "084c5dd7-20c9-422a-b4ed-81485eacf9b4",
                        "source_entry_id": "c43e1f29-29dd-3e34-931a-c77e332cbeaa",
                        "source_sense_id": "31bae9c5-fe6e-35e3-86c9-3e3d13875c30",
                        "source_sense_description": "bereid zich te gedragen in overeenstemming met algemeen aanvaarde waarden",
                        "target_lang_word": "tugendsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tugendsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03e8f53e-caab-3c27-9a64-fc4f8f036856",
                                        "entry_id": "280e65ee-0bbb-3512-a98e-64dd56e14ba8",
                                        "glosses": [
                                            "moralisch hohen Standards genügend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94adfb7a-88a7-48b9-84c8-7812a030cfb7",
                                                "sense_id": "03e8f53e-caab-3c27-9a64-fc4f8f036856",
                                                "text": "Immer brav, bescheiden, tugendsam - dann kommt man auch nicht vom rechten Wege ab. Eigentlich ganz einfach."
                                            },
                                            {
                                                "example_id": "635c047d-c6a6-4df4-ac11-849c03b65ddd",
                                                "sense_id": "03e8f53e-caab-3c27-9a64-fc4f8f036856",
                                                "text": "„Sie war von jung auf schön gewesen und war es auch noch jetzt, von ziemlicher Größe, war gottesfürchtig, tugendsam, fröhlich und friedsam, was mich auch bewegte, dass ich sie zur Ehe nahm.“"
                                            },
                                            {
                                                "example_id": "842366e4-92e4-4557-bc0d-316f1fb5249e",
                                                "sense_id": "03e8f53e-caab-3c27-9a64-fc4f8f036856",
                                                "text": "Das genaue Gegenbild zu Kleopatra hatte Octavian in der eigenen Familie: Es war seine Schwester Octavia, die nach dem Tod Fulvias Antonius' vierte Gemahlin wurde. Sie galt als extrem tugendsam und so familienorientiert, wie man sich das in Rom nur wünschen konnte […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c179452-f05c-46f0-8b99-ef9ffbe20a0e",
                        "source_entry_id": "c43e1f29-29dd-3e34-931a-c77e332cbeaa",
                        "source_sense_id": "31bae9c5-fe6e-35e3-86c9-3e3d13875c30",
                        "source_sense_description": "bereid zich te gedragen in overeenstemming met algemeen aanvaarde waarden",
                        "target_lang_word": "virtuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f986961-762b-3d7b-8ffd-aa1a55d2116a",
                                        "entry_id": "2d3deba2-d7f5-378c-9a4c-48f161a16575",
                                        "glosses": [
                                            "Full of virtue; having excellent moral character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a2301c-25cd-4aec-8550-0ab2c4f9706d",
                                                "sense_id": "3f986961-762b-3d7b-8ffd-aa1a55d2116a",
                                                "text": "Successful communities need strong, selfless leaders and a virtuous people."
                                            },
                                            {
                                                "example_id": "4d7c4ce7-6c16-4bc2-a954-2ff2bb1bbe56",
                                                "sense_id": "3f986961-762b-3d7b-8ffd-aa1a55d2116a",
                                                "text": "Her virtuous, pale-blue, saucerlike eyes flooded with leviathan tears on unexpected occasions and made Yossarian mad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b61517b5-96c4-42a2-8105-1b3ea65a7c82",
                        "source_entry_id": "c43e1f29-29dd-3e34-931a-c77e332cbeaa",
                        "source_sense_id": "31bae9c5-fe6e-35e3-86c9-3e3d13875c30",
                        "source_sense_description": "bereid zich te gedragen in overeenstemming met algemeen aanvaarde waarden",
                        "target_lang_word": "vertueux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vertueux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ea6ab6-aa9d-32a8-aae9-9b73902a14e5",
                                        "entry_id": "b9cf0c64-9679-3638-9196-469bb612629a",
                                        "glosses": [
                                            "Qui a de la vertu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "828b815b-2804-4c1c-9d47-0bb849932a26",
                                                "sense_id": "f0ea6ab6-aa9d-32a8-aae9-9b73902a14e5",
                                                "text": "Ô phrénologues ! L’inéducabilité érigée en principe ? quel inhominalisme ! La sublime créature est éducable, voyante et libre, criminelle ou vertueuse à son choix, responsable."
                                            },
                                            {
                                                "example_id": "9a47937c-1be7-4852-bb12-b24f29b66ca8",
                                                "sense_id": "f0ea6ab6-aa9d-32a8-aae9-9b73902a14e5",
                                                "text": "Je suis une femme très-vertueuse selon les lois : je lui rends sa maison agréable, je ferme les yeux sur ses intrigues, je ne prends rien sur sa fortune, il peut en gaspiller les revenus à son gré, j'ai soin seulement d'en conserver le capital."
                                            },
                                            {
                                                "example_id": "b1b07881-33d9-4304-9629-25ebe5d46210",
                                                "sense_id": "f0ea6ab6-aa9d-32a8-aae9-9b73902a14e5",
                                                "text": "Quoique le malheur passe pour développer les vertus, il ne les développe que chez les gens vertueux ; car ces sortes de nettoyages de conscience n’ont lieu que chez les gens naturellement propres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2d44c8-b9e9-32d2-9ff8-b8dd297f371f",
                                        "entry_id": "b9cf0c64-9679-3638-9196-469bb612629a",
                                        "glosses": [
                                            "Qui ne commet pas de péchés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d71e910b-b2fc-3838-8761-25767cebeed6",
                                        "entry_id": "b9cf0c64-9679-3638-9196-469bb612629a",
                                        "glosses": [
                                            "Qui est chaste, pudique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec1b807-827b-45c2-92a7-3d60167b9156",
                                                "sense_id": "d71e910b-b2fc-3838-8761-25767cebeed6",
                                                "text": "Quelques femmes vertueuses et tendres n'ont presque pas d'idée des plaisirs physiques; elles s'y sont rarement exposées, si l'on peut parler ainsi, […]."
                                            },
                                            {
                                                "example_id": "b5642240-6cb6-4985-be2f-08dc1dc20d4c",
                                                "sense_id": "d71e910b-b2fc-3838-8761-25767cebeed6",
                                                "text": "Elle est vertueuse, au sens ignoblement étroit qu’on donne à ce mot, à l’époque, quand on l’emploie au féminin, comme si la vertu pour la femme ne concernait qu’une fente du corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75061881-95a8-3a60-bce2-6f548c5e5840",
                                        "entry_id": "b9cf0c64-9679-3638-9196-469bb612629a",
                                        "glosses": [
                                            "Qui est inspiré par la vertu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44f4addb-1b99-46d3-a9bb-fe8941bb132d",
                                                "sense_id": "75061881-95a8-3a60-bce2-6f548c5e5840",
                                                "text": "Les paroles indignées du lieutenant sur la conduite de ses poilus, les amplifications moins vertueuses mais ultra-séduisantes qu’y ajouta Lénac, mirent l’eau à la bouche des hommes de la 8ᵉ."
                                            },
                                            {
                                                "example_id": "ff5a01e4-815f-42ef-be6a-bd61d8e0a968",
                                                "sense_id": "75061881-95a8-3a60-bce2-6f548c5e5840",
                                                "text": "Dans le cadre de la labellisation, les entreprises retenues devront mettre en œuvre une gestion vertueuse de leurs déchets d’activités."
                                            },
                                            {
                                                "example_id": "b18491fb-79fe-4340-b9c5-0480e87f4532",
                                                "sense_id": "75061881-95a8-3a60-bce2-6f548c5e5840",
                                                "text": "Avec Ecomobicoin, « un validateur devient éligible en effectuant une action vertueuse, comme se déplacer à pied ou à vélo », explique son co-créateur Pascal Lafourcade, docteur en informatique et maître de conférences à l’université Clermont-Auvergne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
