                    {
                        "form_id": "535b7ae3-1f18-4713-bad6-dc766e3b5f7e",
                        "entry_id": "a30efb2b-41b0-3f85-9fa0-4285a9837caf",
                        "tags": [
                            "accusative",
                            "plural"
