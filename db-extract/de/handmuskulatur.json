                "senses": [
                    {
                        "sense_id": "e10e1e39-6caf-3ccf-a629-c0bb8e48bf5b",
                        "entry_id": "ab86639d-cb19-3aa6-8523-bb35f5765c3a",
                        "glosses": [
                            "Gesamtheit der Muskeln in der Hand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ff1c9d-9d70-4d70-9014-6ec99cec93ed",
                                "sense_id": "e10e1e39-6caf-3ccf-a629-c0bb8e48bf5b",
                                "text": "„Die sogenannte Musiker-Dystonie betrifft meistens die Handmuskulatur und tritt vor allem bei Geigern und Pianisten auf.“"
                            },
                            {
                                "example_id": "5a54d195-6afb-4c5c-8062-24bb4abfb5a0",
                                "sense_id": "e10e1e39-6caf-3ccf-a629-c0bb8e48bf5b",
                                "text": "„Handgymnastik umfasst verschiedene Übungen, welche die Handmuskulatur dehnen und kräftigen.“"
                            },
                            {
                                "example_id": "f3fe419e-ff13-42e4-8c6e-6bd543501fc8",
                                "sense_id": "e10e1e39-6caf-3ccf-a629-c0bb8e48bf5b",
                                "text": "„Beschließt man zum Beispiel, die Hand auf die Herdplatte zu legen, übermitteln Nervenbahnen den entsprechenden Befehl vom Gehirn an die Arm- und Handmuskulatur.“"
                            },
                            {
                                "example_id": "a2aa893e-ad53-481b-b089-b335158809aa",
                                "sense_id": "e10e1e39-6caf-3ccf-a629-c0bb8e48bf5b",
                                "text": "„Immer wieder gab's Rückschläge in all den Jahren, so hatte er auch mit der Golferkrankheit ‚yips‘ (unwillkürliches Zucken der Arm- und Handmuskulatur) zu kämpfen.“"
                            },
                            {
                                "example_id": "6a9d0759-1f4c-4fd8-bd84-9e9669829780",
                                "sense_id": "e10e1e39-6caf-3ccf-a629-c0bb8e48bf5b",
                                "text": "„Führt Bierkonsum zum Erschlaffen der Handmuskulatur, so dass die Flaschen ohne Zutun des Trinkers fallen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
