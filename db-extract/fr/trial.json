                    {
                        "sense_id": "76914aa2-18eb-35a7-822e-0079a144f6d1",
                        "entry_id": "451ac3bc-245e-3c42-837b-d2dfbc9ba87b",
                        "glosses": [
                            "Ténor léger dans l’opéra-comique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622d0edd-c901-4868-b6de-60d6354cafdf",
                                "sense_id": "76914aa2-18eb-35a7-822e-0079a144f6d1",
                                "text": "Je causerai théâtre, racontars de coulisses, potins de province, et, comme dit Popof, la connaissance sera bientôt faite avec le joyeux trial et la charmante dugazon."
                            },
                            {
                                "example_id": "68f9d4f3-33a9-4ec1-8582-8c9044c7740b",
                                "sense_id": "76914aa2-18eb-35a7-822e-0079a144f6d1",
                                "text": "[Dédé] ne se gêne pas pour leur envoyer que le mezzo a meuglé comme une vache et que le fameux Robichon, qui se croit ténor, ce n'est qu'un trial qui gueule."
                            },
                            {
                                "example_id": "bf129de5-a1ed-4de9-a874-3370050f043d",
                                "sense_id": "76914aa2-18eb-35a7-822e-0079a144f6d1",
                                "text": "M. Thivel croyant toujours jouer son rôle d’Agnelet de Maître Patelin ne parle plus qu’en bêlant. Quel dommage, car notre trial a des qualités et il pourrait mieux faire."
                            }
                        ]
                    }
