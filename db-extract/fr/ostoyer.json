                "senses": [
                    {
                        "sense_id": "60f1efcc-3137-3239-b14d-5cc69881ed6d",
                        "entry_id": "6170ab9b-5394-302a-b3ad-1b9f15d38ba2",
                        "glosses": [
                            "Faire la guerre."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "163b4535-3970-4fcd-9af7-33be674e5e0e",
                                "sense_id": "60f1efcc-3137-3239-b14d-5cc69881ed6d",
                                "text": "Quand ces gens d’armes et leurs routes (troupes) se furent deux ou trois jours rafraîchis en Pampelune, ils eurent conseil que ils se departiroient et s’en iroient par garnisons pour être mieux au large, car les montagnes de Navarre sont trop dures et trop froides en hiver pour ostoyer (faire la guerre), et trop y a de neiges."
                            },
                            {
                                "example_id": "9877758c-7ada-4aac-997e-58ab184df569",
                                "sense_id": "60f1efcc-3137-3239-b14d-5cc69881ed6d",
                                "text": "Ses connaissances en médecine lui ont permis de soigner les navrés tandis que ses pairs ostoyaient et se faisaient honteusement débriser par leurs ennemis."
                            }
                        ]
                    }
                ],
