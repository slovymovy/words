                    {
                        "translation_id": "530db30f-7635-410b-92a5-96d13502fec7",
                        "source_entry_id": "391c1f94-d735-3d6d-9434-1ffb0168d10c",
                        "source_sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                        "source_sense_description": "Sport: Anwendung unerlaubter Substanzen zur Leistungssteigerung",
                        "target_lang_word": "dopage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dopage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                        "entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                                        "glosses": [
                                            "Utilisation d’une drogue, d’un médicament ou d’une intervention biologique, que ce soit prohibé ou non, dans le but d’améliorer une performance physique, intellectuelle, psychique…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2656c967-48ff-4a69-ae71-25b3215def31",
                                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                                "text": "Les cas de dopage se multiplient aux Jeux Olympiques."
                                            },
                                            {
                                                "example_id": "13ff6c8e-bcaf-4f34-8389-8a47e0b4fa7e",
                                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                                "text": "Le dopage des cadres, des étudiants."
                                            },
                                            {
                                                "example_id": "fb57f7f7-24bc-463d-8e48-df7210dd8aa4",
                                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                                "text": "La définition du dopage telle qu’on la connaît actuellement, nous renvoie à une liste de produits et de procédés qui est sans cesse en évolution."
                                            },
                                            {
                                                "example_id": "181b091f-5764-4a4d-a3b8-6d99d20586d6",
                                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                                "text": "Géant du sport mondial accusé d’une cascade de tricheries et de dopage institutionnalisé, la Russie a été exclue pour deux ans des grandes compétitions internationales, dont deux éditions des Jeux olympiques, une sentence jeudi du Tribunal arbitral du sport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a589718f-f161-3463-a622-0c463f9acd22",
                                        "entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                                        "glosses": [
                                            "Ajout de petites quantités d’éléments, appelées impuretés, à un semi-conducteur pour en modifier les caractéristiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
