                        "source_sense_id": "76351883-2a6b-3873-aad5-c82f4ac87026",
                        "source_sense_description": "door experimenten, proefnemingen, waarnemingen en ervaring",
                        "target_lang_word": "experimental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "experimental",
