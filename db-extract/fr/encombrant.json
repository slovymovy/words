                                        "glosses": [
                                            "Burdensome or hindering, as if a weight or drag; vexatious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0316222d-b4da-4ed8-afeb-929d8c043251",
                                                "sense_id": "28c8933d-d83d-3a8f-b616-d0c7fe721296",
                                                "text": "\"You can throw off your cumbersome disguise here,\" said Lucy, though the words could scarcely be distinguished, from her excessive agitation, Evelyn hastily caught up a cloak and cap laid ready for him, and a few minutes brought them into the sitting-room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a6571e-ed88-36aa-83a3-7c93fbe1f741",
                                        "entry_id": "7b439702-6f3a-3dca-8fbc-fa4fdefef796",
                                        "glosses": [
                                            "Not easily managed or handled; awkward; clumsy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d098c57-a893-48ad-8839-edf733d91612",
                                                "sense_id": "c3a6571e-ed88-36aa-83a3-7c93fbe1f741",
                                                "text": "Cumbersome machines can endanger operators and slow down production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff16a76-831a-3944-a40d-eef5f0dba7a2",
                                        "entry_id": "7b439702-6f3a-3dca-8fbc-fa4fdefef796",
                                        "glosses": [
                                            "Hard, difficult, demanding to handle or get around with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13cff584-3d43-4482-97bd-c088a986462e",
                                                "sense_id": "4ff16a76-831a-3944-a40d-eef5f0dba7a2",
                                                "text": "A slave’s work was as cumbersome as toiling on the fields, or in the mines."
                                            }
                                        ]
                                    },
