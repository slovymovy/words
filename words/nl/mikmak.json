                        {
                            "text": "De tentoonstelling toonde een bonte <w>mikmak</w> van verschillende kunststijlen door elkaar.",
                            "target_lang_translations": {
                                "en": "The exhibition showed a colorful <w>hodgepodge</w> of different art styles mixed together."
                            }
