                "senses": [
                    {
                        "sense_id": "d1807901-8fce-30f7-8a2c-b04666396ef9",
                        "entry_id": "68866dc5-c713-384f-92c9-0cfe2a708cd3",
                        "glosses": [
                            "untere Putzschicht, auf der weitere Beschichtungen aufgebracht werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f864673f-f71a-46eb-80bc-e5849faf965f",
                                "sense_id": "d1807901-8fce-30f7-8a2c-b04666396ef9",
                                "text": "„Auf den Rohputz wird ein mit Kohlenstaub grau bis schwarz nuancierter Putz aufgetragen.“"
                            },
                            {
                                "example_id": "3aa475e4-ae8f-410e-9970-2e6d6fa6fd9e",
                                "sense_id": "d1807901-8fce-30f7-8a2c-b04666396ef9",
                                "text": "„Am schönsten war die nach Süden gerichtete Rückseite des Hauses, deren weiß gestrichener Rohputz das Licht reflektierte und die Wärme aufnahm.“"
                            },
                            {
                                "example_id": "6edd7430-598b-496d-b747-0982af2ea11d",
                                "sense_id": "d1807901-8fce-30f7-8a2c-b04666396ef9",
                                "text": "„Manche sind einfach heruntergekommen, andere mit grauem Rohputz verkleidet, den auf Gehweghöhe uninspirierte Graffiti zuwuchern.“"
                            },
                            {
                                "example_id": "55b4d905-e9cb-4634-9bfc-d0c651710dba",
                                "sense_id": "d1807901-8fce-30f7-8a2c-b04666396ef9",
                                "text": "„Wir planen alles genau und ich denke, es wird eine Woche dauern, bis wir die Wände im Rohputz fertig haben.“"
                            },
                            {
                                "example_id": "c0ae116a-bd13-4775-8d3b-ec709a06555c",
                                "sense_id": "d1807901-8fce-30f7-8a2c-b04666396ef9",
                                "text": "„Wir waren als Kinder oft eingeschlossen, die Wände unserer Zimmer waren im Rohputz, also ohne Tapeten.“"
                            },
                            {
                                "example_id": "b388cc9e-346b-4b67-b55e-c8d3ec22d51b",
                                "sense_id": "d1807901-8fce-30f7-8a2c-b04666396ef9",
                                "text": "„Geplant von jemandem mit viel mehr Geld als Geschmack, wie der grausam weiß leuchtende Rohputz zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
