                                        "sense_id": "efed28af-6dad-378f-8497-1074194d1944",
                                        "entry_id": "6878ed79-ec62-3d78-9bdd-05bb4de3e78c",
                                        "glosses": [
                                            "An electronic speaker designed to produce high-frequency sound."
