                ],
                "senses": [
                    {
                        "sense_id": "f89c2f3e-e74f-3823-885e-307e6f2f6533",
                        "entry_id": "91f1b09a-9b0d-30a7-9e20-ef54bb88dc3a",
                        "glosses": [
                            "Donner un caractère écoresponsable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33ac2bd4-4f23-49cc-a967-b9ec6247a7dd",
                                "sense_id": "f89c2f3e-e74f-3823-885e-307e6f2f6533",
                                "text": "Bien que l’environnement devrait être au cœur de tes préoccupations, le but de ce carnet n’est pas de faire de toi un David Suzuki, mais plutôt de t'écosensibiliser et de t'écoresponsabiliser!"
                            },
                            {
                                "example_id": "b22c5096-4984-4e27-ba3e-027f868c1513",
                                "sense_id": "f89c2f3e-e74f-3823-885e-307e6f2f6533",
                                "text": "Trucs, astuces et solutions concrètes pour écoresponsabiliser votre quotidien!"
                            },
                            {
                                "example_id": "7c7d50ad-45c0-4df5-810d-18acc17c849d",
                                "sense_id": "f89c2f3e-e74f-3823-885e-307e6f2f6533",
                                "text": "Pour plus d'information sur les moyens à notre disposition pour écoresponsabiliser votre événement, n'hésitez pas à communiquer avec nous."
                            }
                        ]
                    }
                ],
