                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d47ac43-492f-4e44-b512-cd6187f32ae1",
                                "sense_id": "a8384300-c75e-39b7-9677-dc5860bfd8b0",
                                "text": "Na drie weken door Zweden getrokken te hebben beginnen we morgen aan de terugtocht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72fcadd7-671d-4c44-9741-e773eaa45a67",
                        "source_entry_id": "357fa4da-ef7a-32ef-a142-87aa8b646b10",
                        "source_sense_id": "a8384300-c75e-39b7-9677-dc5860bfd8b0",
                        "source_sense_description": "de tocht terug naar een eerder beginpunt",
                        "target_lang_word": "Rückfahrt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bfd40c5-deb4-3c2d-990f-7b5d3501d9be",
                                        "entry_id": "b449d6d9-83dd-3b5d-a3d1-b33ae72a7c08",
                                        "glosses": [
                                            "Fahrt dahin zurück, von wo man aufgebrochen war"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f314347-d776-4093-a3ea-455cf3f0837f",
                                                "sense_id": "2bfd40c5-deb4-3c2d-990f-7b5d3501d9be",
                                                "text": "„Nachdem er diesem seine Geschichte erzählt hatte, durfte er seine Rückfahrt nach England abarbeiten.“"
                                            },
                                            {
                                                "example_id": "d3246b24-dbc4-4cb7-b37f-dcd0bb1a6781",
                                                "sense_id": "2bfd40c5-deb4-3c2d-990f-7b5d3501d9be",
                                                "text": "„Bei bestem Ausflugswetter am Sonntagnachmittag verkeilt sich eine der 32 Kabinen und macht damit eine Rückfahrt an den Drahtseilen unmöglich.“"
                                            },
                                            {
                                                "example_id": "a76624d1-3a61-48ba-ab95-664cb4ec6e7a",
                                                "sense_id": "2bfd40c5-deb4-3c2d-990f-7b5d3501d9be",
                                                "text": "„Im Gegensatz zur Hinfahrt stand Sylvia auf der Rückfahrt förmlich in Flammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98f92aa7-d955-4de2-9fc7-596ab21a9272",
                        "source_entry_id": "357fa4da-ef7a-32ef-a142-87aa8b646b10",
