        "fr-extract.jsonl": [
            {
                "entry_id": "c8aa5d05-f1bf-3c7f-aad0-f22ab8989058",
                "word": "hypoxie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aa2c38ca-bad1-419a-b32a-0d02fe56d15b",
                        "entry_id": "c8aa5d05-f1bf-3c7f-aad0-f22ab8989058",
                        "tags": [
                            "plural"
                        ],
                        "form": "hypoxies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4c8fbe01-4c1e-32a9-aaab-d9dbfaea2cd2",
                        "entry_id": "c8aa5d05-f1bf-3c7f-aad0-f22ab8989058",
                        "glosses": [
                            "Phénomène qui se produit en milieu aquatique quand la concentration du dioxygène dissous est réduite à un point critique pour les organismes vivants dans ce milieu."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ed14399c-1b26-3a06-9537-4a5594f349ab",
                        "entry_id": "c8aa5d05-f1bf-3c7f-aad0-f22ab8989058",
                        "glosses": [
                            "Oxygénation insuffisante des tissus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace27768-e614-46fe-9dda-0418e1d92eea",
                                "sense_id": "ed14399c-1b26-3a06-9537-4a5594f349ab",
                                "text": "L’hypoxie n’a pas lésé ses fonctions cérébrales."
                            },
                            {
                                "example_id": "6c71a095-5b4a-4596-91b9-7b4e4e1a1223",
                                "sense_id": "ed14399c-1b26-3a06-9537-4a5594f349ab",
                                "text": "C'est dans cette veine que l'on trouve par exemple les chambres à hypoxie. Totalement hermétiques elles permettent aux sportifs de haut niveau de recréer les conditions de manque d'oxygène propre à une altitude de 3000 mètres."
                            },
                            {
                                "example_id": "bc4cdafa-e2bb-41c6-8ab1-916e615c645f",
                                "sense_id": "ed14399c-1b26-3a06-9537-4a5594f349ab",
                                "text": "C’est vrai que l’alpinisme n’a pas de règles, et chacun fait comme il veut. Mais si l’on considère les bouteilles d’oxygène, qui suppriment quasiment tout risque d’hypoxie d’altitude, l’ascension en file indienne sur les traces des sherpas, sur des parois apprivoisées par un réseau de cordes et de petites échelles, et parsemées de camps et de dépôts de bouteilles… que reste-t-il de la montagne ?"
                            },
                            {
                                "example_id": "df26acf3-d644-4182-b25f-0e8fbb41de11",
                                "sense_id": "ed14399c-1b26-3a06-9537-4a5594f349ab",
                                "text": "Cette dernière découverte ouvre la voie d’un lien entre la pénétration du virus dans les neurones observés à la fois dans les cultures de cellules cérébrales et les tissus cérébraux post-mortem, et l’hypoxie et les accidents ischémiques observés dans le cerveau des malades."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4068e606-9c96-435f-82ff-80575fbec697",
                        "source_entry_id": "c8aa5d05-f1bf-3c7f-aad0-f22ab8989058",
                        "source_sense_id": "4c8fbe01-4c1e-32a9-aaab-d9dbfaea2cd2",
                        "source_sense_description": "Concentration insuffisante en dioxygène dans l’eau",
                        "target_lang_word": "Hypoxie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypoxie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1421c00d-c71e-3c23-8dcc-94f6634be488",
                                        "entry_id": "c0c21fc3-48f0-3b9b-a0ac-45fa2e90624c",
                                        "glosses": [
                                            "Sauerstoffmangel im Körpergewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c793706f-7aca-4e6c-ad05-a6d3ed055345",
                                                "sense_id": "1421c00d-c71e-3c23-8dcc-94f6634be488",
                                                "text": "Hypoxie (Sauerstoffmangel) und Unreife sind für mehr als 50 Prozent der Frühsterblichkeit und für eine Vielzahl von Hirnschädigungen verantwortlich."
                                            },
                                            {
                                                "example_id": "83373264-036d-4f2d-a783-4b08f92021be",
                                                "sense_id": "1421c00d-c71e-3c23-8dcc-94f6634be488",
                                                "text": "Eine Untersuchung am Rudolf-Virchow-Universitätsklinikum in Berlin etwa zeigte 1994, dass Sauerstoffmangel, die sogenannte Hypoxie, Visionen provoziert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5971a927-7c51-32c1-9632-af9cd71fc80d",
                                        "entry_id": "c0c21fc3-48f0-3b9b-a0ac-45fa2e90624c",
                                        "glosses": [
                                            "das Leben aquatischer Lebewesen beeinträchtigender Mangel an gelöstem Sauerstoff in Gewässern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "172c4682-d3dd-4736-880d-48f2b824bb18",
                                                "sense_id": "5971a927-7c51-32c1-9632-af9cd71fc80d",
                                                "text": "Stickstoff und Phosphat, Nährstoffe für den schnell wachsenden Mais, werden durch den Regen von den Feldern des Mittleren Westens in den Mississippi gespült und tragen in Teilen des Golfs von Mexiko zur Hypoxie bei."
                                            },
                                            {
                                                "example_id": "8be863b7-94d7-4cd8-8fdf-4d9ce1ebc18c",
                                                "sense_id": "5971a927-7c51-32c1-9632-af9cd71fc80d",
                                                "text": "Die Ursache ist Eutrophierung, Überdüngung mit Stickstoff vor allem aus der Landwirtschaft: Im Wasser lässt er die Algen blühen, sie verbrauchen den Sauerstoff, erzeugen „Hypoxie“ und bringen damit erst das andere Leben und dann sich selbst zu Tode."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42fc6d9e-cb19-4675-87bc-1791773942b1",
                        "source_entry_id": "c8aa5d05-f1bf-3c7f-aad0-f22ab8989058",
