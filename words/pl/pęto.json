    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0963c2e4-42d9-3c78-94ab-ab23bbd094da",
                    "sense_definition": "odcinek kiełbasy zwinięty w łuk i zakończony wiązaniem, zazwyczaj sznurkiem",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na kolację kupiłem w sklepie całe <w>pęto</w> wędzonej kiełbasy.",
                            "target_lang_translations": {
                                "ru": "На ужин я купил в магазине целое <w>кольцо</w> копченой колбасы."
                            }
                        },
                        {
                            "text": "W spiżarni na hakach wisiało niejedno <w>pęto</w> wiejskiej kiełbasy.",
                            "target_lang_translations": {
                                "ru": "В кладовой на крюках висело не одно <w>колечко</w> домашней колбасы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pęto kiełbasy"
                    ],
                    "target_lang_definitions": {
                        "ru": "кусок колбасы в форме кольца или дуги, связанный концами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кольцо колбасы",
                                "target_lang_sense_clarification": "связка или цельный дугообразный кусок"
                            },
                            {
                                "target_lang_word": "колечко",
                                "target_lang_sense_clarification": "о колбасе"
                            },
                            {
                                "target_lang_word": "кружок колбасы",
                                "target_lang_sense_clarification": "цельное кольцо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f445b123-6331-39fd-9553-2060e3196c7e",
                    "sense_definition": "kajdany lub więzy, często używane metaforycznie jako ograniczenie wolności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "niewola",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naród walczył przez wiele lat, aby wreszcie zrzucić <w>pęta</w> niewoli.",
                            "target_lang_translations": {
                                "ru": "Народ боролся долгие годы, чтобы наконец сбросить <w>оковы</w> рабства."
                            }
                        },
                        {
                            "text": "Czuł, że rodzinne oczekiwania stanowiły dla niego niewidzialne <w>pęta</w>.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что ожидания семьи были для него невидимыми <w>путами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kajdany",
                        "okowy",
                        "więzy"
                    ],
                    "common_phrases": [
                        "zrzucić pęta",
                        "zerwać pęta"
                    ],
                    "target_lang_definitions": {
                        "ru": "кандалы, оковы или узы, часто в переносном значении как ограничение свободы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оковы",
                                "target_lang_sense_clarification": "кандалы, путы в переносном или прямом смысле"
                            },
                            {
                                "target_lang_word": "узы",
                                "target_lang_sense_clarification": "то, что связывает, лишает свободы"
                            },
                            {
                                "target_lang_word": "путы",
                                "target_lang_sense_clarification": "ограничение свободы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bad2eec1-53f3-3990-bb89-805592a33f8d",
                    "sense_definition": "sznur, rzemień lub łańcuch zakładany na nogi zwierzęcia, by ograniczyć mu możliwość ucieczki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hodowla",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz założył koniowi skórzane <w>pęto</w>, aby ten nie uciekł z pastwiska.",
                            "target_lang_translations": {
                                "ru": "Хозяин надел на коня кожаные <w>путы</w>, чтобы тот не убежал с пастбища."
                            }
                        },
                        {
                            "text": "Stare <w>pęto</w> leżało w kącie stajni obok siodeł i uprzęży.",
                            "target_lang_translations": {
                                "ru": "Старые <w>путы</w> валялись в углу конюшни рядом с седлами и упряжью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pęto dla konia"
                    ],
                    "target_lang_definitions": {
                        "ru": "веревка, ремень или цепь, надеваемая на ноги животного (обычно лошади), чтобы оно не убежало"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путы",
                                "target_lang_sense_clarification": "для стреноживания скота"
                            },
                            {
                                "target_lang_word": "тренога",
                                "target_lang_sense_clarification": "веревка для стреноживания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95300b1f-b45a-35b5-9bb1-818676053d00",
                    "sense_definition": "męski narząd rozrodczy",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Użył wulgaryzmu, nazywając męskie przyrodzenie wielkim <w>pętem</w>.",
                            "target_lang_translations": {
                                "ru": "Он выругался, назвав мужское достоинство здоровенным <w>хером</w>."
                            }
                        },
                        {
                            "text": "W ulicznej kłótni pijany mężczyzna krzyczał coś o swoim <w>pęcie</w>.",
                            "target_lang_translations": {
                                "ru": "В уличной ссоре пьяный мужчина кричал что-то о своем <w>члене</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "penis"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "użycie wulgarne lub dosadne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "мужской половой орган (грубое или просторечное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хер",
                                "target_lang_sense_clarification": "вульгарное, о члене"
                            },
                            {
                                "target_lang_word": "член",
                                "target_lang_sense_clarification": "мужской половой орган"
                            },
                            {
                                "target_lang_word": "елда",
                                "target_lang_sense_clarification": "грубое, просторечное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
