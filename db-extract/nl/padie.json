                        "glosses": [
                            "geoogste rijst die nog gedorst of gepeld moet worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3691bdc-1fd7-4a22-9e3f-f7efafe39719",
                                "sense_id": "36648532-b883-3696-8565-299fb3bb32db",
                                "text": "Door één of twee ossen rondjes te laten lopen over de rijsthalmen, lieten de rijstkorrels door het vertrappen los en ze kwamen op het kleed terecht. Vervolgens werden de halmen als stro weggegooid en de padie of ongepelde rijstkorrels werden na het wannen in jutezakken afgevoerd."
                            }
