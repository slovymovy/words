                    "sense_definition": "Здесь; в этом месте.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я живу <w>тут</w> уже много лет.",
                            "target_lang_translations": {
                                "en": "I have lived <w>here</w> for many years.",
                                "zh": "我<w>这里</w>已经住了很多年了。",
                                "nl": "Ik woon hier al vele jaren.",
                                "pl": "Mieszkam <w>tutaj</w> od wielu lat.",
                                "de": "Ich lebe schon seit vielen Jahren <w>hier</w>.",
                                "fr": "J'habite <w>ici</w> depuis de nombreuses années.",
                                "it": "Vivo <w>qui</w> da molti anni.",
                                "cs": "Žiji <w>tady</w> už mnoho let.",
                                "tr": "Uzun yıllardır <w>burada</w> yaşıyorum.",
                                "es": "Vivo <w>aquí</w> desde hace muchos años."
                            }
                        },
                        {
                            "text": "Где-то <w>тут</w> должен быть магазин.",
                            "target_lang_translations": {
                                "en": "There must be a shop somewhere <w>here</w>.",
                                "zh": "商店应该就在<w>这儿</w>附近。",
                                "nl": "Ergens hier moet een winkel zijn.",
                                "pl": "Gdzieś <w>tutaj</w> powinien być sklep.",
                                "de": "Irgendwo <w>hier</w> muss ein Geschäft sein.",
                                "fr": "Il doit y avoir un magasin quelque part par <w>ici</w>.",
                                "it": "Deve esserci un negozio da qualche parte <w>qui</w>.",
                                "cs": "Někde <w>tady</w> musí být obchod.",
                                "tr": "Buralarda bir yerde bir dükkan olmalı.",
                                "es": "Debe haber una tienda por <w>aquí</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "здесь"
                    ],
                    "antonyms": [
                        "там"
                    ],
                    "common_phrases": [
                        "тут и там",
                        "тут как тут"
