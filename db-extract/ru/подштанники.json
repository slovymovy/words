                "senses": [
                    {
                        "sense_id": "e617e9b4-029b-312b-bfe9-6751eb4fddea",
                        "entry_id": "ca72d1d3-7883-31c1-84cd-b38b66b473bb",
                        "glosses": [
                            "разг. разновидность мужского нижнего белья, то же, что кальсоны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a7b438-582e-432a-8dc0-8e31d56e2d85",
                                "sense_id": "e617e9b4-029b-312b-bfe9-6751eb4fddea",
                                "text": "Ситуацию усугубляет русская зима — время года, когда подштанники для мужчин являются такой же необходимой частью гардероба, как колготки для настоящей леди в любую жару."
                            },
                            {
                                "example_id": "38199aa6-2829-4d17-b374-c7ce06bc656c",
                                "sense_id": "e617e9b4-029b-312b-bfe9-6751eb4fddea",
                                "text": "Ваня вытерся собственным новым полотенцем и надел в предбаннике собственное бельё: рубаху и подштанники с оловянными пуговицами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4caacff-dad1-49ae-ad4a-9fc1fb7e7be7",
                        "source_entry_id": "ca72d1d3-7883-31c1-84cd-b38b66b473bb",
                        "source_sense_id": "e617e9b4-029b-312b-bfe9-6751eb4fddea",
                        "target_lang_word": "underpants",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underpants",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "652f8d11-d636-32e5-847d-1334c5815088",
                                        "entry_id": "0b83cca0-8429-37d5-8caa-0bc98df3f63b",
                                        "glosses": [
                                            "Underwear covering the genitalia and often buttocks, usually going no higher than the navel."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e67312bc-16a2-41e1-88ad-a530ecfb90a2",
                                                "sense_id": "652f8d11-d636-32e5-847d-1334c5815088",
                                                "text": "The Italian fashion of wearing red underpants on December 31 is becoming popular, reputedly to guarantee luck for the new year."
                                            },
                                            {
                                                "example_id": "58962095-dbd8-4766-bbd8-0b11243377ca",
                                                "sense_id": "652f8d11-d636-32e5-847d-1334c5815088",
                                                "text": "She takes off her fatigue pants and throws them in the washer and the surgical greens and her bloodstained bra and turns on the machine. She is wearing socks and underpants and a .38 Special with a shrouded hammer in an ankle holster."
                                            },
                                            {
                                                "example_id": "70701495-f04e-4822-be6c-3cfff3913df2",
                                                "sense_id": "652f8d11-d636-32e5-847d-1334c5815088",
                                                "text": "He wore khakis slung so low that five inches of his underpants showed—dark blue boxers with big white polka dots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
