                        "glosses": [
                            "Not stayed or held back."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "25c6341b-dd31-46fb-be9d-d51aa7597c7d",
                                "sense_id": "d42434dc-33ba-3855-b417-a61a4c08a5a1",
                                "text": "In vain: your turbulence is unallayed, My flame unquenched; your rioting unstayed; My life so wretched from your strife to save it That death were welcome did I dare to brave it."
                            },
                            {
                                "example_id": "be95ad5e-9043-4a7f-9b93-23fc9aaf7282",
                                "sense_id": "d42434dc-33ba-3855-b417-a61a4c08a5a1",
                                "text": "No niggard churl our High Chieftain, But lavishly His gifts are made, Like streams from a moat that flow amain, Or rushing waves that rise unstayed."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f1152b4-5ec4-3c8f-8c96-24e6b42cf913",
