                    "frequency": "Middle",
                    "semantic_group_id": "pensee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce documentaire propose de porter un autre <w>regard</w> sur les événements récents."
                        },
                        {
                            "text": "Le philosophe porte un <w>regard</w> très lucide sur l'évolution de notre époque."
                        }
                    ],
                    "common_phrases": [
                        "porter un regard",
                        "regard critique",
                        "changer de regard"
                    ]
                },
                {
                    "sense_id": "3ac82df2-e8d7-367d-8109-fbaad2e14c15",
                    "sense_definition": "Ouverture maçonnée fermée par une plaque, permettant l'accès et la surveillance d'une canalisation souterraine.",
