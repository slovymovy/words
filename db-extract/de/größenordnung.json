                ],
                "senses": [
                    {
                        "sense_id": "f7e7f5b2-40c5-3490-ac0a-45e7b354811b",
                        "entry_id": "7e051362-08e6-3100-886b-91fc686be6a9",
                        "glosses": [
                            "Größe, Menge, Umfang von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85339960-ffd6-4533-a2e3-b36761eddfdb",
                                "sense_id": "f7e7f5b2-40c5-3490-ac0a-45e7b354811b",
                                "text": "„Es handelt sich offenbar um approximative und ungesicherte Schätzungen; aber die Größenordnungen und Gesamtentwicklungen können als tragfähig gelten.“"
                            },
                            {
                                "example_id": "b2e607c8-7d2a-43a7-8dde-3d85826ed339",
                                "sense_id": "f7e7f5b2-40c5-3490-ac0a-45e7b354811b",
                                "text": "„Bis zum frühen Sonntagabend (Ortszeit) hatte es nur in der Innenstadt der weitflächigen Millionenmetropole einzelne Proteste gegeben – in einer Größenordnung, die sonst kaum größere Wellen schlagen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0c8e811-40fd-3f61-904b-77af355cf0e9",
                        "entry_id": "7e051362-08e6-3100-886b-91fc686be6a9",
                        "glosses": [
                            "„Faktor, der notwendig ist, um in der jeweiligen Zahlendarstellung einen Wert um eine Stelle zu vergrößern oder zu verkleinern, bei Beibehaltung der einzelnen Ziffern und ihrer Reihenfolge“"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e88739-6351-447a-8ef1-6ad34a7f8d87",
                                "sense_id": "b0c8e811-40fd-3f61-904b-77af355cf0e9",
                                "text": "„Die Römer (und Ägypter) mussten für jede neue Größenordnung ein neues Zeichen einführen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "079f381b-1e68-497a-8609-87fad2c43f0a",
                        "source_entry_id": "7e051362-08e6-3100-886b-91fc686be6a9",
                        "source_sense_id": "f7e7f5b2-40c5-3490-ac0a-45e7b354811b",
