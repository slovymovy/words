                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95184d0a-495b-4724-964f-3e84272550e5",
                                "sense_id": "df6adb15-6b48-3b2e-888e-4e6ca43cf28f",
                                "text": "Dziad wrócił z wojny z nerwicą okopową i bez lewej nogi."
                            },
                            {
                                "example_id": "01069eff-6114-4521-8a4a-74142c87d277",
                                "sense_id": "df6adb15-6b48-3b2e-888e-4e6ca43cf28f",
                                "text": "W rejonie ulicy Okopowej zebrało się kilkuset ludzi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5530165e-9a18-3f9b-843c-67a743265f45",
                        "entry_id": "2691bc9e-97a5-3b5a-a1e2-25fa7b0f1ae5",
                        "glosses": [
                            "związany z uprawą roślin dla bulw lub korzeni wymagających okopywania, dotyczący takiej uprawy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b470b04d-6951-4f9a-bff4-c32a1d9de658",
                                "sense_id": "5530165e-9a18-3f9b-843c-67a743265f45",
                                "text": "Do roślin okopowych należą: ziemniak, burak, rzepa i marchew."
