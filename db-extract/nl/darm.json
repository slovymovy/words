                    {
                        "sense_id": "3dff6d0e-8fb4-371d-91d2-535fec40998f",
                        "entry_id": "6951125b-b5a5-3e6a-a568-4725590401fc",
                        "glosses": [
                            "onderdeel van het spijsverteringsstelsel tussen de maag en de anus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc55ba8-fef3-42a0-9224-d1d89b686bbb",
                                "sense_id": "3dff6d0e-8fb4-371d-91d2-535fec40998f",
                                "text": "De 12-vingerige darm, de dunne darm en en dikke darm zijn de belangrijkste onderdelen van het spijsverteringskanaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d864382-d491-3df2-acfc-a31143baf916",
