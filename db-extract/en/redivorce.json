                        "sense_id": "c0af18e2-57b5-38e7-ba16-043d62aa4e01",
                        "entry_id": "fa48bdf2-91fd-3a68-b3c0-1003d42b90e7",
                        "glosses": [
                            "To divorce after a remarriage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53a4dd3f-d9ff-4fa7-a7e6-eb183437cdfc",
                                "sense_id": "c0af18e2-57b5-38e7-ba16-043d62aa4e01",
                                "text": "Data in table G show that according to the results of the June 1985 survey, 26 percent of women eligible to redivorce had done so by age 75."
                            },
                            {
                                "example_id": "e2db5848-d102-4163-9577-962d2fd009d8",
                                "sense_id": "c0af18e2-57b5-38e7-ba16-043d62aa4e01",
                                "text": "Whites redivorce more frequently than blacks."
                            },
                            {
                                "example_id": "a0906245-71bb-4fb9-b36c-b822f445d314",
                                "sense_id": "c0af18e2-57b5-38e7-ba16-043d62aa4e01",
                                "text": "Many persons who remarry subsequently redivorce, however."
                            }
                        ]
                    }
