                "senses": [
                    {
                        "sense_id": "da5a8c7f-b0d8-31b8-80cd-ed32229f544e",
                        "entry_id": "d252eb32-9824-32a8-bad9-19e564a9c896",
                        "glosses": [
                            "begeisterte Läuferin; Frau beziehungsweise Mädchen, die (das) mit großer Begeisterung regelmäßig/häufig läuft"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "5392bf64-7dee-456e-8dff-701d211deacc",
                                "sense_id": "da5a8c7f-b0d8-31b8-80cd-ed32229f544e",
                                "text": "„Die große Laufenthusiastin besucht gerade einen Freund in Paderborn.“"
                            },
                            {
                                "example_id": "2d576fd1-77e9-4d66-a6e7-8eafc6553ce1",
                                "sense_id": "da5a8c7f-b0d8-31b8-80cd-ed32229f544e",
                                "text": "„Die Seriensiegerin der Wertung des Kyffhäuser-Lauf-Cups ist als Laufenthusiastin eine Ausnahme im Landkreis.“"
                            },
                            {
                                "example_id": "a1a81769-f88b-4368-8be8-d4f62b07a0c5",
                                "sense_id": "da5a8c7f-b0d8-31b8-80cd-ed32229f544e",
                                "text": "„Die Laufenthusiastin erreichte in der tollen Zeit von 20:23 Minuten als dritte Läuferin das Ziel.“"
                            },
                            {
                                "example_id": "0ccc0e19-3f4b-43ce-b4de-ed23858fb1ce",
                                "sense_id": "da5a8c7f-b0d8-31b8-80cd-ed32229f544e",
                                "text": "„Ob jung oder alt, Laufenthusiastin oder Anfänger, beim Störlauf haben alle Spaß.“"
                            },
                            {
                                "example_id": "143d61ab-d51d-4150-bbb2-27ee343f01d3",
                                "sense_id": "da5a8c7f-b0d8-31b8-80cd-ed32229f544e",
                                "text": "„Dort will die Laufenthusiastin den Halbmarathon in Angriff nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
