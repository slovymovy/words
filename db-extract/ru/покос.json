                            {
                                "target_word": "mowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91137b34-d98d-3c08-8120-816845dd6523",
                                        "entry_id": "04270ca2-62f2-3003-b7ba-39a691491096",
                                        "glosses": [
                                            "The activity by which something is mown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0fd3c64-d09a-4701-8022-1dce571d5720",
                                                "sense_id": "91137b34-d98d-3c08-8120-816845dd6523",
                                                "text": "One gallon costs about $220, covers an acre and lasts through about two mowings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4be2f9e-54e3-349b-b501-4bcf3b1c3e8a",
                                        "entry_id": "04270ca2-62f2-3003-b7ba-39a691491096",
                                        "glosses": [
                                            "Land from which grass is cut."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4849393-138b-3d09-8a86-2f745b128cdb",
                                        "entry_id": "04270ca2-62f2-3003-b7ba-39a691491096",
                                        "glosses": [
                                            "The grass clippings resulting from mowing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd12154-a705-4073-9933-2c1e885eaeb3",
                                                "sense_id": "f4849393-138b-3d09-8a86-2f745b128cdb",
                                                "text": "You may advantageously use the mowings of the lawn as linings to the bed each time the lawn is mown."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edf654f4-6740-4670-a55a-3ea22e255316",
                        "source_entry_id": "9568956e-239f-32b6-9d12-d7ba0edf67b2",
                        "source_sense_description": "косьба, кошение травы",
                        "target_lang_word": "Mahd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mahd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91d259f8-7e2b-3bcc-a97d-c225065e9d9c",
                                        "entry_id": "ae573d81-ee0d-39fe-80ea-e8ff8b8a3387",
                                        "glosses": [
                                            "das Mähen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff1c764-9e83-4415-a056-53ce83683b63",
                                                "sense_id": "91d259f8-7e2b-3bcc-a97d-c225065e9d9c",
                                                "text": "„Nicht daran zu denken, daß sie hinüberfährt; die Frühjahrsbestellung, die erste Mahd, alles findet ohne sie statt.“"
                                            },
                                            {
                                                "example_id": "77428901-9238-4982-a3bc-14c43c9bce1f",
                                                "sense_id": "91d259f8-7e2b-3bcc-a97d-c225065e9d9c",
                                                "text": "„Die späte Mahd im Sommer ermöglicht, dass sich ein artenreicher Pflanzenbestand halten kann.“"
                                            },
                                            {
                                                "example_id": "50bad71f-8b86-4442-9deb-6c21071998ab",
                                                "sense_id": "91d259f8-7e2b-3bcc-a97d-c225065e9d9c",
                                                "text": "„Sie ist die Voraussetzung dafür, dass sich als Folge der traditionellen Mahd auf basischen Braunerden großflächig orchideenreiche Trespen-Halbtrockenrasen entwickeln konnten.“"
                                            },
                                            {
                                                "example_id": "e5fc66b7-433d-4177-b12c-367fb6092619",
                                                "sense_id": "91d259f8-7e2b-3bcc-a97d-c225065e9d9c",
                                                "text": "„Die Mahd wird am besten bei kühlerem, bedecktem Wetter durchgeführt, wenn weniger Insekten unterwegs sind.“"
                                            },
                                            {
                                                "example_id": "06d9e1b5-cfb6-403c-a50b-1fbbf16ec8d6",
                                                "sense_id": "91d259f8-7e2b-3bcc-a97d-c225065e9d9c",
                                                "text": "„Ein sauberer Schnitt mit einem Messerbalkenmähwerk verhindert, dass unnötig viele Tiere bei der Mahd getötet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64f16254-3b43-3343-96f5-153d1de3b739",
                                        "entry_id": "ae573d81-ee0d-39fe-80ea-e8ff8b8a3387",
                                        "glosses": [
                                            "das, was gemäht wurde; Abgemähtes, das in einer Reihe liegt"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4400c05f-140a-4cbf-9b3a-945f30291280",
                                                "sense_id": "64f16254-3b43-3343-96f5-153d1de3b739",
                                                "text": "„Alles war still, es klangen keine Glocken mehr, und sie hörte nichts als die Lerchen, die mit ihrem Tirili aus der ringsumher in Garben stehenden Mahd in die Luft emporstiegen.“"
                                            },
                                            {
                                                "example_id": "1db741e6-d7a3-4e94-831c-7af13425aef8",
                                                "sense_id": "64f16254-3b43-3343-96f5-153d1de3b739",
                                                "text": "„Gemäht wird aber bevorzugt bei hochstehender Sonne, um eine möglichst trockene Mahd zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mahd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfae88ae-b85b-3a0d-92da-e9499ce9b982",
                                        "entry_id": "90ccfe00-f89a-3c3d-b3a3-75beff1dbadb",
                                        "glosses": [
                                            "in hohen gebirgigen Lagen gelegene Wiese"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65358721-1d39-417c-a081-b80a6b336072",
                                                "sense_id": "bfae88ae-b85b-3a0d-92da-e9499ce9b982",
                                                "text": "„Wenn man aber im Gereute schnitt, beim Schleppen des Heus von diesen hochgelegenen Mahden, konnten sie sich allen Freuden einer Bergauffahrt ergeben“"
                                            },
                                            {
                                                "example_id": "29c66926-2142-4e5d-9690-b9ce4018f51e",
                                                "sense_id": "bfae88ae-b85b-3a0d-92da-e9499ce9b982",
                                                "text": "„Seit einigen Jahren kann die Art immer wieder in den Oberen Mähdern, im Seelachengebiet und am Alten Rhein gesichtet werden.“"
                                            },
                                            {
                                                "example_id": "e46bce28-a137-4e9c-b4fc-753e17f8819b",
                                                "sense_id": "bfae88ae-b85b-3a0d-92da-e9499ce9b982",
                                                "text": "„Auf Bergwiesen jetzt bloß noch im Wolfertstal; viele dieser ungedüngten, bloß einmal jährlich gemähten Mähder sind heute zugewachsen, aufgeforstet oder in gedüngte, mehrschnittige Fettwiesen überführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c581030-b6d9-4ee5-a6d3-95221db5f01f",
