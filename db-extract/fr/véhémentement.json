            {
                "entry_id": "9616e870-a420-3204-b796-74e40f10ed33",
                "word": "véhémentement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
                        "entry_id": "9616e870-a420-3204-b796-74e40f10ed33",
                        "glosses": [
                            "Très fortement, violemment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd5791af-0fa0-4014-802d-cd064db0e601",
                                "sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
                                "text": "— Pourquoi dire d’un accusé qu’il est véhémentement suspecté d’un tel crime, pour dire qu’il en est violemment suspect ?"
                            },
                            {
                                "example_id": "45229cb7-907f-4816-8de9-12f6f59ec239",
                                "sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
                                "text": "— Helvétius est véhémentement soupçonné d’avoir fait cet ouvrage [le Sermon du rabbin Akib],"
                            },
                            {
                                "example_id": "d48e96d1-bf28-4008-a9cf-6757e7e65287",
                                "sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
                                "text": "Ce très léger excès, péché de gourmandise dont il s’accusait d’ailleurs véhémentement, et duquel il n’était guère coutumier, l’avait vivement dérangé, […]."
                            },
                            {
                                "example_id": "a381b2fa-e996-4a12-b8b8-e31b37cbedfa",
                                "sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
                                "text": "A Philippe Auguste, qui venait de rappeler les juifs dans son royaume, il reprocha véhémentement de n'avoir pas tenu compte des lois canoniques réglementant les rapports entre chrétiens et juifs."
                            },
                            {
                                "example_id": "831ab218-0daa-4879-b592-b0470baa789b",
                                "sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
                                "text": "Un seul moyen d'organiser […] : créer cette taxe de superposition sur le revenu total de chaque citoyen quelque peu fortuné dont les conservateurs m'ont si véhémentement reproché d'avoir eu l'idée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f316c0a-74cc-4b42-8717-bb58eab618f1",
                        "source_entry_id": "9616e870-a420-3204-b796-74e40f10ed33",
                        "source_sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
                        "target_lang_word": "gewaltig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewaltig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "348107f6-bcda-3603-9358-a1a848eaff92",
                                        "entry_id": "297ba897-0b9e-386b-90fe-b7e1253f2923",
                                        "glosses": [
                                            "sehr groß oder sehr bedeutend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9859921-49b4-4df6-a2c3-ca09deb64546",
                                                "sense_id": "348107f6-bcda-3603-9358-a1a848eaff92",
                                                "text": "Gewaltige Wolken türmten sich auf."
                                            },
                                            {
                                                "example_id": "c4d8be0d-fe85-4390-bdcf-80bf3216b4b6",
                                                "sense_id": "348107f6-bcda-3603-9358-a1a848eaff92",
                                                "text": "Das macht aber einen gewaltigen Unterschied!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7c33ae2-e0b6-3bf6-aeab-88511ac9b23c",
                                        "entry_id": "297ba897-0b9e-386b-90fe-b7e1253f2923",
                                        "glosses": [
                                            "sehr"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0228678-782f-4286-9692-38279bbc3034",
                                                "sense_id": "c7c33ae2-e0b6-3bf6-aeab-88511ac9b23c",
                                                "text": "„Das gelungene Bubenstück hätte ihm eine erhebliche Aufmerksamkeit gesichert und einen gewaltigen Ansehensschub verschafft.“"
                                            },
                                            {
                                                "example_id": "4d00c7d6-c80a-435a-b368-80e9585d3885",
                                                "sense_id": "c7c33ae2-e0b6-3bf6-aeab-88511ac9b23c",
                                                "text": "Da täuschst du dich aber gewaltig, mein Lieber!"
                                            },
                                            {
                                                "example_id": "10f9d781-aa7e-4295-bf10-2b4bc9141e7c",
                                                "sense_id": "c7c33ae2-e0b6-3bf6-aeab-88511ac9b23c",
                                                "text": "Das ist dir aber gewaltig gut gelungen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "277b2f9c-536e-3213-ac77-a30302f05989",
                                        "entry_id": "297ba897-0b9e-386b-90fe-b7e1253f2923",
                                        "glosses": [
                                            "mit viel Macht ausgestattet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde5d410-6ac4-40ad-bec6-e2714eb6a884",
                                                "sense_id": "277b2f9c-536e-3213-ac77-a30302f05989",
                                                "text": "Er war einer der gewaltigsten Studiobosse Hollywoods."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "127bf343-527c-4833-8077-f9aa55038710",
                        "source_entry_id": "9616e870-a420-3204-b796-74e40f10ed33",
                        "source_sense_id": "eeb22340-57ec-331c-9194-5c3c9d1c821d",
