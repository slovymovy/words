                                                "sense_id": "a4c5812b-9a02-3d0b-8308-1c75843512c6",
                                                "text": "Toucherent les piocheurs de leurs marres un grand tombeau de bronze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b928e4e5-6803-3559-8eb3-bb6e443ecd3a",
