                                        "sense_id": "bf36e366-7634-3900-8c59-d4f0c65c32a8",
                                        "entry_id": "d76e3a15-c9d6-346d-9fe2-c0631d033d52",
                                        "glosses": [
                                            "bývalý stát na území dnešního Německa, Polska, části Pobaltí a dalších přiléhajících území"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f812679-28b9-473c-ba82-0e0abb6d7f27",
                                                "sense_id": "bf36e366-7634-3900-8c59-d4f0c65c32a8",
                                                "text": "Čím dále, tím jasněji se ukazovalo, že Prusko bylo válku tu podniklo ve vlastním prospěchu k rozšíření svého území, k čemuž krátkozraké Rakousko stalo se mu bezděčným pomocníkem."
                                            }
