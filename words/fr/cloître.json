                {
                    "sense_id": "061bad89-be9c-3af3-8fc5-9143fb03f842",
                    "sense_definition": "Galerie couverte à arcades entourant la cour intérieure ou le préau d'un monastère ou d'une cathédrale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les moines se promenaient en silence sous les arcades du <w>cloître</w>."
                        },
                        {
                            "text": "Ce <w>cloître</w> gothique conserve de magnifiques colonnes sculptées datant du treizième siècle."
                        }
                    ],
                    "common_phrases": [
                        "cloître roman",
                        "cloître gothique",
                        "arcades du cloître"
                    ]
                },
                {
                    "sense_id": "c57580a0-9dfd-33c9-a352-1c7afa1773e1",
                    "sense_definition": "Monastère, couvent, ou état de vie religieuse retirée du monde.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a choisi d'entrer au <w>cloître</w> pour consacrer son existence à la prière."
                        },
                        {
                            "text": "Après de longues hésitations, le jeune homme décida d'embrasser la vie du <w>cloître</w>."
                        }
                    ],
                    "synonyms": [
                        "monastère",
                        "couvent"
                    ],
                    "common_phrases": [
