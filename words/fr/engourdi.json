                    "frequency": "Middle",
                    "semantic_group_id": "manque de sensibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après être resté assis trop longtemps, il avait la jambe complètement <w>engourdie</w>."
                        },
                        {
                            "text": "À cause du froid glacial, elle essayait de réchauffer ses doigts <w>engourdis</w> près du feu."
                        }
                    ],
                    "synonyms": [
                        "endormi",
                        "gourd",
                        "paralysé"
                    ],
                    "antonyms": [
