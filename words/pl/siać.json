    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e38b1a07-ca97-3489-8d3d-12404a553c63",
                    "sense_definition": "umieszczać nasiona w ziemi w celu ich wykiełkowania i wzrostu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiosną rolnicy <w>sieją</w> zboże na polach za naszą wsią.",
                            "target_lang_translations": {
                                "ru": "Весной фермеры <w>сеют</w> зерно на полях за нашей деревней."
                            }
                        },
                        {
                            "text": "W tej części ogrodu zwykle <w>sieję</w> słoneczniki i marchew.",
                            "target_lang_translations": {
                                "ru": "В этой части сада я обычно <w>сею</w> подсолнухи и морковь."
                            }
                        }
                    ],
                    "synonyms": [
                        "zasiewać",
                        "obsiewać"
                    ],
                    "common_phrases": [
                        "siać zboże",
                        "siać trawę",
                        "siać w ogrodzie"
                    ],
                    "target_lang_definitions": {
                        "ru": "сажать семена в землю для их прорастания и роста"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "семена в землю"
                            },
                            {
                                "target_lang_word": "засевать",
                                "target_lang_sense_clarification": "поле, участок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bad6c792-cb5d-38f2-a482-6b849a0f77ca",
                    "sense_definition": "rozpowszechniać lub wywoływać jakieś zjawiska, nastroje bądź emocje, zwłaszcza negatywne",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rozprzestrzenianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nieznajomy mężczyzna zaczął <w>siać</w> panikę wśród pasażerów pociągu.",
                            "target_lang_translations": {
                                "ru": "Незнакомый мужчина начал <w>сеять</w> панику среди пассажиров поезда."
                            }
                        },
                        {
                            "text": "Fałszywe wiadomości w internecie <w>sieją</w> zamęt w całym społeczeństwie.",
                            "target_lang_translations": {
                                "ru": "Фейковые новости в интернете <w>сеют</w> смуту во всём обществе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "siać panikę",
                        "siać zamęt",
                        "siać niezgodę",
                        "siać strach"
                    ],
                    "target_lang_definitions": {
                        "ru": "распространять или вызывать какие-либо явления, настроения или эмоции, особенно отрицательные"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "панику, раздор, сомнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "120e7af8-1663-3151-a5ba-4a8f205d1f85",
                    "sense_definition": "rozrzucać na powierzchni ziemi sypkie substancje, na przykład nawóz",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz regularnie <w>sieje</w> nawóz mineralny przed nadejściem deszczu.",
                            "target_lang_translations": {
                                "ru": "Хозяин регулярно <w>вносит</w> минеральные удобрения перед дождём."
                            }
                        },
                        {
                            "text": "Pracownicy zaczęli <w>siać</w> wapno na zakwaszoną glebę w sadzie.",
                            "target_lang_translations": {
                                "ru": "Работники начали <w>рассыпать</w> известь по закисленной почве в саду."
                            }
                        }
                    ],
                    "common_phrases": [
                        "siać nawóz"
                    ],
                    "target_lang_definitions": {
                        "ru": "разбрасывать по поверхности земли сыпучие вещества, например удобрения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассыпать",
                                "target_lang_sense_clarification": "удобрения, известь по земле"
                            },
                            {
                                "target_lang_word": "вносить",
                                "target_lang_sense_clarification": "удобрения в почву"
                            },
                            {
                                "target_lang_word": "разбрасывать",
                                "target_lang_sense_clarification": "по поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72e87f35-b9bf-388c-bc70-59c4031952aa",
                    "sense_definition": "strzelać seriami lub gęsto, rozpraszając pociski w stronę celu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strzelanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Żołnierz ukryty w ruinach budynku nieustannie <w>siał</w> ogniem maszynowym.",
                            "target_lang_translations": {
                                "ru": "Солдат, укрывшийся в руинах здания, непрерывно <w>поливал</w> пулемётным огнём."
                            }
                        },
                        {
                            "text": "Działo zaczęło <w>siać</w> pociskami po okolicznych wzgórzach.",
                            "target_lang_translations": {
                                "ru": "Орудие принялось <w>осыпать</w> окрестные холмы снарядами."
                            }
                        }
                    ],
                    "synonyms": [
                        "strzelać"
                    ],
                    "common_phrases": [
                        "siać ołowiem",
                        "siać ogniem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie prowadzenia gęstego ognia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вести плотный огонь сериями, рассеивая пули или снаряды в сторону цели"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыпать",
                                "target_lang_sense_clarification": "пулями, очередями"
                            },
                            {
                                "target_lang_word": "поливать",
                                "target_lang_sense_clarification": "свинцом, огнём"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9ec416d-d761-38ab-b3a7-c22383c6be49",
                    "sense_definition": "gubić coś, kłaść w nieznane miejsce lub zostawiać bez pamiętania gdzie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gubienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znowu gdzieś <w>posiałem</w> klucze od mieszkania i nie mogę wyjść z domu.",
                            "target_lang_translations": {
                                "ru": "Я снова где-то <w>посеял</w> ключи от квартиры и не могу выйти из дома."
                            }
                        },
                        {
                            "text": "On bez przerwy <w>sieje</w> drobne przedmioty po wszystkich pokojach.",
                            "target_lang_translations": {
                                "ru": "Он постоянно <w>теряет</w> мелкие вещи по всем комнатам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w znaczeniu gubienia rzeczy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "терять вещи по рассеянности, класть в неизвестное место и забывать где"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "терять по рассеянности (прост.)"
                            },
                            {
                                "target_lang_word": "терять",
                                "target_lang_sense_clarification": "вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9ac852a-5df9-3120-866f-d4135485abe4",
                    "sense_definition": "przesiewać sypki materiał przez sito w celu oczyszczenia lub rozdzielenia",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kobieta od rana <w>siała</w> mąkę przez gęste sito do wielkiej misy.",
                            "target_lang_translations": {
                                "ru": "Женщина с утра <w>сеяла</w> муку через густое сито в большую миску."
                            }
                        },
                        {
                            "text": "Robotnicy starannie <w>siali</w> piasek na budowie, aby usunąć kamienie.",
                            "target_lang_translations": {
                                "ru": "Рабочие тщательно <w>просеивали</w> песок на стройке, чтобы удалить камни."
                            }
                        }
                    ],
                    "synonyms": [
