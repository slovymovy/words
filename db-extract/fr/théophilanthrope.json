                        "glosses": [
                            "Relatif à la théophilanthropie"
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "79a75159-a613-412a-aa2e-5e538bd35bc8",
                                "sense_id": "d8659f98-7b75-36ea-a4b3-c6ca021ba011",
                                "text": "C’est dans cet établissement, devant les élèves et les familles réunis, qu’a lieu le premier exercice du culte théophilanthrope en janvier 1797. On note que les cinq premiers dirigeants, dont Chemin et Haüy, sont très probablement francs-maçons."
                            }
                        ]
                    }
