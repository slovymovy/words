                    {
                        "sense_id": "194f5b7d-5010-38d2-9cff-c901b6008bef",
                        "entry_id": "9fd01f38-ad46-319c-9f44-b58c8fa13577",
                        "glosses": [
                            "A yellow or green liqueur made by Carthusian monks."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8659ea30-8a8a-476a-81a7-d96ca1ad75dd",
                                "sense_id": "194f5b7d-5010-38d2-9cff-c901b6008bef",
                                "text": "Old Tinker, in evening dress, sat uncomfortably, sideways, upon the edge of a wicker and brocade “chaise lounge,” finishing a tiny glass of chartreuse, while Talbot Potter, in the middle of the room, took leave of a second guest who had been dining with him."
                            },
                            {
                                "example_id": "4c888987-e5f4-4c43-9685-92140502051d",
                                "sense_id": "194f5b7d-5010-38d2-9cff-c901b6008bef",
                                "text": "Many liqueurs, among them chartreuse and benedictine, have long been held in great esteem as aphrodisiac aids."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8bf480f-f667-30ed-b889-41f5cb98e919",
                        "entry_id": "9fd01f38-ad46-319c-9f44-b58c8fa13577",
                        "glosses": [
                            "A greenish-yellow color."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "55db12cd-c9bb-44d1-bd88-9583b4b35638",
                                "sense_id": "c8bf480f-f667-30ed-b889-41f5cb98e919",
                                "text": "Well, we shot the line and we went for broke\nWith a thousand screamin' trucks\nAn' eleven long-haired Friends a' Jesus\nIn a chartreuse microbus."
                            }
                        ]
                    },
