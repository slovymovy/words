                                    {
                                        "sense_id": "8f855ae4-0f11-3ba0-978a-6f7a39372b93",
                                        "entry_id": "da8a71b2-edc1-3322-8b06-67308a26b61c",
                                        "glosses": [
                                            "present participle and gerund of fail"
                                        ],
                                        "tags": [
                                            "form-of",
