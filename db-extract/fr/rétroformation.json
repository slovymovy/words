                    {
                        "translation_id": "18e932df-67b1-4b71-a58f-a26018990cb3",
                        "source_entry_id": "97f8acf9-5c68-38f7-948c-19567d1a0565",
                        "source_sense_id": "adabac64-186a-3800-82e6-6fe3ccf17c49",
                        "target_lang_word": "Rückbildung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückbildung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bf13cf2-b8b0-30c6-8a50-d3277108b39a",
                                        "entry_id": "a6f75684-9014-358c-8825-3b14997d6add",
                                        "glosses": [
                                            "allmähliches Verschwinden bestimmter Krankheitserscheinungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5726dcc4-dac6-4090-ae3a-0519e50e9a29",
                                                "sense_id": "9bf13cf2-b8b0-30c6-8a50-d3277108b39a",
                                                "text": "„Typisch sind ein abrupter Beginn innerhalb von 48 Stunden und eine rasche Rückbildung der Symptome.“"
                                            },
                                            {
                                                "example_id": "1a2e4ede-37d7-4bfd-8f0a-ac68f407957f",
                                                "sense_id": "9bf13cf2-b8b0-30c6-8a50-d3277108b39a",
                                                "text": "„Danach setzt langsam eine Rückbildung der Krankheitserscheinungen, das Stadium catarrhale, ein, ohne Narben zu hinterlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f06252d-3f89-3c12-babd-583bc4092d01",
                                        "entry_id": "a6f75684-9014-358c-8825-3b14997d6add",
                                        "glosses": [
                                            "besondere Art der Wortbildung, bei der aus einem früher vorhandenen längeren Wort durch Kürzung oder Morphemaustausch ein neues gebildet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431f1ee0-84db-4fc0-bce9-6c25e1e61a23",
                                                "sense_id": "2f06252d-3f89-3c12-babd-583bc4092d01",
                                                "text": "Das Verb „notland(en)“ gilt als eine Rückbildung durch Weglassen des Ableitungsmorphems „-ung“ aus dem Substantiv „Notlandung“. Das Substantiv „Häm-e“ gilt als eine Rückbildung durch Austausch des Ableitungsmorphems „-isch“ gegen „-e“ aus dem Adjektiv „häm-isch“."
                                            },
                                            {
                                                "example_id": "24e0ed36-ce24-4bba-96a1-cf6d8c5008a7",
                                                "sense_id": "2f06252d-3f89-3c12-babd-583bc4092d01",
                                                "text": "„Solche Rückbildungen sind durchweg feminin.“"
                                            },
                                            {
                                                "example_id": "0ea4beb8-04a3-43b1-813d-49b8ab2363d1",
                                                "sense_id": "2f06252d-3f89-3c12-babd-583bc4092d01",
                                                "text": "„Das wäre der erste Unterschied zur Kerngrammatik, die den Verbbezug als Basis wie als Rückbildung herstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "835f50fb-99bb-37c9-acd8-add8f03a2a3c",
                                        "entry_id": "a6f75684-9014-358c-8825-3b14997d6add",
                                        "glosses": [
                                            "Wiederherstellung des körperlichen Zustands nach einer Geburt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "653ce789-7831-4c1b-ba3f-552f7e1806e3",
                                                "sense_id": "835f50fb-99bb-37c9-acd8-add8f03a2a3c",
                                                "text": "„Die Dauer dieses Vorgangs ist von Frau zu Frau unterschiedliche, eine Faustregel besagt aber, dass die Rückbildung in etwa so lange dauert wie die Schwangerschaft. Die jeweilige körperliche Verfassung und Veranlagung kann die Rückbildung aber ebenso beschleunigen wie verlangsamen.“"
                                            },
                                            {
                                                "example_id": "537c5280-7675-4d58-b8c9-b02d4fdce12e",
                                                "sense_id": "835f50fb-99bb-37c9-acd8-add8f03a2a3c",
                                                "text": "„Da Yoga ein kraftvolles Tool ist, um die Rückbildung nach der Geburt zu fördern, sollte die Yogapraxis speziell auf die Zeit nach der Geburt angepasst sein.“"
                                            },
                                            {
                                                "example_id": "efb507f1-43ec-42eb-bb8b-07f003107a26",
                                                "sense_id": "835f50fb-99bb-37c9-acd8-add8f03a2a3c",
                                                "text": "„Zwar war man sich einig, dass Aktivität für Schwangere günstig ist und Fitness den Geburtsvorgang und die rasche Rückbildung fördert.“"
                                            },
                                            {
                                                "example_id": "582fc02b-90f0-4e83-bcfc-10d4fbcd4761",
                                                "sense_id": "835f50fb-99bb-37c9-acd8-add8f03a2a3c",
                                                "text": "„Außerdem ist das Beckenbodentraining eine gute Vorbereitung für die Geburt, und ebenso sinnvoll ist das Üben in der Zeit der Rückbildung.“"
                                            },
                                            {
                                                "example_id": "ebdd99d5-2227-4246-882f-4531c399d3f6",
                                                "sense_id": "835f50fb-99bb-37c9-acd8-add8f03a2a3c",
                                                "text": "„Wenn Sie bereits vor der Schwangerschaft regelmäßig trainiert haben und die Schwangerschaft normal verläuft, kann und soll das Training weitergeführt werden, denn gerade während und nach der Schwangerschaft, in der Phase der Rückbildung, ist eine starke Muskulatur wichtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7dc54cde-66e4-3566-b0bd-8ea295a40b01",
                                        "entry_id": "a6f75684-9014-358c-8825-3b14997d6add",
                                        "glosses": [
                                            "Verkümmern eines Organs, das (nach einer bestimmten Zeit) nicht mehr genutzt wird oder altersbedingt geschwächt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a59341b5-609d-4ebf-925e-b80f9e852e99",
                                                "sense_id": "7dc54cde-66e4-3566-b0bd-8ea295a40b01",
                                                "text": "„Zu viel Glykogen in den Muskeln führt zur Rückbildung der Muskeln.“"
                                            },
                                            {
                                                "example_id": "8c22e38b-951e-42e5-b665-79647a8cbbde",
                                                "sense_id": "7dc54cde-66e4-3566-b0bd-8ea295a40b01",
                                                "text": "„Nach der Pubertät findet eine gewisse Rückbildung des Organs statt.“"
                                            },
                                            {
                                                "example_id": "fe3b9607-ce44-4d8e-8cd1-00353747de0d",
                                                "sense_id": "7dc54cde-66e4-3566-b0bd-8ea295a40b01",
                                                "text": "„Die niedrigsten Wilden, selbst diejenigen, bei denen ein Rückfall in einen mehr tierähnlichen Zustand mit gleichzeitiger körperlicher Rückbildung anzunehmen ist, stehn immer noch weit höher als jene Übergangsgeschöpfe.“"
                                            },
                                            {
                                                "example_id": "667f5b5b-1d87-46f4-ba35-85babb8298a3",
                                                "sense_id": "7dc54cde-66e4-3566-b0bd-8ea295a40b01",
                                                "text": "„Die Feinheit des Geruchsorgans war freilich bei der Menschheit in der Rückbildung begriffen; aber warum sollte man diese nicht steuern können?“"
                                            },
                                            {
                                                "example_id": "4d9a06de-6888-4d38-bd44-ba5835aad7c6",
                                                "sense_id": "7dc54cde-66e4-3566-b0bd-8ea295a40b01",
                                                "text": "[übertragen:] „Die Ehe ist für die zwanziger Jahre ein nöthiges, für die dreissiger ein nützliches, aber nicht nöthiges Institut: für das spätere Leben wird sie oft schädlich und befördert die geistige Rückbildung des Mannes.“"
                                            },
                                            {
                                                "example_id": "0d8ff9bc-69dd-4c63-a3c4-42bda00151b4",
                                                "sense_id": "7dc54cde-66e4-3566-b0bd-8ea295a40b01",
                                                "text": "„Bei der Wochenbettbetreuung werden die Rückbildung der Gebärmutter und die Heilung des Geburtsweges kontinuierlich beobachtet, um Verzögerungen rechtzeitig zu erkennen und einer möglichen Infektion vorzubeugen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
