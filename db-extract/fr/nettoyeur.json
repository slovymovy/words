            {
                "entry_id": "79ba7918-b29d-35eb-9da8-5b0bffdbefbc",
                "word": "nettoyeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "165e0736-0399-459b-9e8d-6f0cb33f5f0c",
                        "entry_id": "79ba7918-b29d-35eb-9da8-5b0bffdbefbc",
                        "tags": [
                            "plural"
                        ],
                        "form": "nettoyeurs"
                    },
                    {
                        "form_id": "9519caa4-e169-4df3-a81f-0990ea9323b2",
                        "entry_id": "79ba7918-b29d-35eb-9da8-5b0bffdbefbc",
                        "tags": [
                            "feminine"
                        ],
                        "form": "nettoyeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29c3941d-c620-3588-b396-0538450be8e9",
                        "entry_id": "79ba7918-b29d-35eb-9da8-5b0bffdbefbc",
                        "glosses": [
                            "Employé dont la principale fonction est le nettoyage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58c29cc8-b9c5-426b-8c1b-75d10fba8221",
                                "sense_id": "29c3941d-c620-3588-b396-0538450be8e9",
                                "text": "Les emplois « non qualifiés » ne disparaissent pas. Ils se déplacent de l’industrie vers le commerce et les services. Regroupant une majorité de femmes, les non-qualifiés sont nettoyeurs, préposés de la Poste, employées de maison, ouvrière du textile."
                            },
                            {
                                "example_id": "ed471fbc-0ac5-4e3d-a374-44c30075652f",
                                "sense_id": "29c3941d-c620-3588-b396-0538450be8e9",
                                "text": "La comparaison entre deux nettoyeurs, un expérimenté (X) et un débutant (Y), montre que les compétences se forgent dans l’action. Le nettoyeur X s’emploie à préparer et à faciliter le travail de remontage, en fonction de la connaissance qu’il en a."
                            },
                            {
                                "example_id": "b59728f2-7379-4725-a42a-38195048af73",
                                "sense_id": "29c3941d-c620-3588-b396-0538450be8e9",
                                "text": "Des « nettoyeurs » saoudiens ont été envoyés à Istanbul pour effacer les preuves du meurtre du journaliste Jamal Khashoggi, dont le corps reste introuvable un mois après sa disparition, a affirmé aujourd'hui un haut responsable turc."
                            }
                        ]
                    },
                    {
                        "sense_id": "5658130e-bdce-3cfb-8f1b-a457645c73bc",
                        "entry_id": "79ba7918-b29d-35eb-9da8-5b0bffdbefbc",
                        "glosses": [
                            "Appareil destiné à nettoyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e114d93-c956-4636-a674-fbcd6cc6b908",
                                "sense_id": "5658130e-bdce-3cfb-8f1b-a457645c73bc",
                                "text": "Un nettoyeur à haute pression."
                            }
                        ]
                    },
                    {
                        "sense_id": "a73db5af-5ec2-335d-8583-f483288db694",
                        "entry_id": "79ba7918-b29d-35eb-9da8-5b0bffdbefbc",
                        "glosses": [
                            "Pressing, nettoyeur à sec."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "85b916d4-d6b3-4301-ac9d-ff0935913789",
                                "sense_id": "a73db5af-5ec2-335d-8583-f483288db694",
                                "text": "J’ai apporté ton habit au nettoyeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adddd32d-7393-4eb9-815b-68ce34a2bd92",
                        "source_entry_id": "79ba7918-b29d-35eb-9da8-5b0bffdbefbc",
                        "source_sense_description": "personne",
                        "target_lang_word": "cleaner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cleaner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b649152-6d11-34e0-b50e-574cfe7ded29",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A person whose occupation is to clean things, especially rooms, floors, and windows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b095080b-97c4-420a-a9d6-80c6e9262faf",
                                                "sense_id": "9b649152-6d11-34e0-b50e-574cfe7ded29",
                                                "text": "The cleaner worked, of course, at nights. He had to coal and light up the engine, as well as clean it, for the next day's work, which commenced with a light run to Barnham to \"bring in the goods\" from that station at about 6.30 a.m."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd689c9-89ab-3cb0-82be-fbf47677586c",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A device that cleans, such as the vacuum cleaner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef93602a-6e1e-37c6-9d16-cea530bb0f90",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A substance used for cleaning; especially, one retailed for that purpose and meant for use on things other than one's own body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751d43b9-b69a-4297-84e6-b4dc4a0dfd1b",
                                                "sense_id": "ef93602a-6e1e-37c6-9d16-cea530bb0f90",
                                                "text": "Near-synonym: cleaning fluid"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f3ff22-7505-3a8a-9ee3-65732384bd87",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A professional laundry or dry cleaner (business)."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0090358-33c4-4c26-a2d4-11584103cdd8",
                                                "sense_id": "57f3ff22-7505-3a8a-9ee3-65732384bd87",
                                                "text": "I'll have to take this shirt to the cleaners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd8525e-fb5f-326e-b722-5743f0b55c92",
                                        "entry_id": "f4afecd6-7ab0-3f08-82ad-45cdd1e1a229",
                                        "glosses": [
                                            "A fixer; a person who disposes of bodies and evidence."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
