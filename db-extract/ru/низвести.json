                    }
                ],
                "senses": [
                    {
                        "sense_id": "69dac8d8-eb2f-32c4-8ae4-1e4ef108ff60",
                        "entry_id": "60c39550-3433-347f-94fe-dfa09a90c733",
                        "glosses": [
                            "устар. свести вниз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c7f75b7-1de5-409d-a0e7-112a6e4f5249",
                                "sense_id": "69dac8d8-eb2f-32c4-8ae4-1e4ef108ff60",
                                "text": "Хочу лететь, подняться выше, // Но цепь звенит мне: «Не пущу!» // И я припомню, что в оковы // Меня от неба низвели, // Но проклинать в тоске суровой // Не смею жизни и земли."
                            },
                            {
                                "example_id": "ab421168-b8f5-49b9-a56c-07ddbf199785",
                                "sense_id": "69dac8d8-eb2f-32c4-8ae4-1e4ef108ff60",
                                "text": "Предположим, что все казённые места заняты, а в столицах конкуренция низвела плату неизвестному медику средней руки до последнего minimum: спрашивается, куда деваться кончившему курс?"
                            },
                            {
                                "example_id": "b8b9b258-1891-4c04-b7d1-62b04cf9056c",
                                "sense_id": "69dac8d8-eb2f-32c4-8ae4-1e4ef108ff60",
                                "text": "Огонь пришёл Я низвести на землю, и как желал бы, чтобы он уже возгорелся!"
                            }
                        ]
                    },
                    {
                        "sense_id": "3d19b16f-e629-3085-83bf-8c8073d12256",
                        "entry_id": "60c39550-3433-347f-94fe-dfa09a90c733",
                        "glosses": [
                            "устар., высок. ниспослать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ca347d-a052-4d2d-99b8-0024c70f27d4",
                                "sense_id": "3d19b16f-e629-3085-83bf-8c8073d12256",
                                "text": "Да, вас судьба благословила, // Вам душу мирную дала, // Во взоре ясность засветила // И в сердце радость низвела."
                            },
                            {
                                "example_id": "af23429b-6e85-4a0a-b1f9-34ca6e4caf60",
                                "sense_id": "3d19b16f-e629-3085-83bf-8c8073d12256",
                                "text": "Ты дал им понять, что тебе всё возможно, низведи же в сердца их любовь к другим людям!"
                            }
                        ]
                    },
                    {
                        "sense_id": "031cb1f5-64f0-31b2-9f6a-25ab2c582fed",
                        "entry_id": "60c39550-3433-347f-94fe-dfa09a90c733",
                        "glosses": [
                            "книжн. лишить высокого положения, уровня; свести на более низкую ступень, степень и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "320dee1c-f9e3-46a8-b551-d6008e166a14",
                                "sense_id": "031cb1f5-64f0-31b2-9f6a-25ab2c582fed",
                                "text": "Пусть глух остается человек, пусть сонно проходит жизнь свою, пусть не содрогается, пусть не плачет в глубине сердца, пусть низведёт до такого усыпленья свою душу, чтобы уже ничто не произвело в ней потрясения!"
                            },
                            {
                                "example_id": "8e4c7e59-b817-4505-9b57-a06005911612",
                                "sense_id": "031cb1f5-64f0-31b2-9f6a-25ab2c582fed",
                                "text": "Жизнь, исполненная разного рода авантюр, немножко чересчур низко низвела нравственный уровень госпожи Жиглинской!"
                            },
                            {
                                "example_id": "c005f805-5716-4427-8902-583083650698",
                                "sense_id": "031cb1f5-64f0-31b2-9f6a-25ab2c582fed",
                                "text": "И первого я попа Макара низведу в полное ничтожество."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0de895f2-4dee-444f-a2e5-8bd762caf79a",
                        "source_entry_id": "60c39550-3433-347f-94fe-dfa09a90c733",
                        "target_lang_word": "reduzieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reduzieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baae79b7-ba7a-3ac7-863b-9d1e763ca63f",
                                        "entry_id": "2cd16b21-37b1-3ff0-b5d7-2fb0377ff4f9",
                                        "glosses": [
                                            "etwas in seinem Wert geringer machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc9aeea-c122-4137-88f1-37d7db4e1fe8",
                                                "sense_id": "baae79b7-ba7a-3ac7-863b-9d1e763ca63f",
                                                "text": "Im nächsten Jahr müssen wir unsere Verluste reduzieren."
                                            },
                                            {
                                                "example_id": "513d1ddb-f4a0-45a0-9339-88c7ee36c21c",
                                                "sense_id": "baae79b7-ba7a-3ac7-863b-9d1e763ca63f",
                                                "text": "Reduzieren Sie bitte nach dem Anbraten die Hitze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9443925c-0fb7-3599-8ece-2258fad8b5fa",
                                        "entry_id": "2cd16b21-37b1-3ff0-b5d7-2fb0377ff4f9",
                                        "glosses": [
                                            "vereinfachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bbcbb4-3502-4932-a952-65cafbc7420e",
                                                "sense_id": "9443925c-0fb7-3599-8ece-2258fad8b5fa",
                                                "text": "Den Bruch kann man noch reduzieren. Statt 2/6 kann man auch ein Drittel sagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12d91253-9024-3398-b117-c0b2f1cf7580",
                                        "entry_id": "2cd16b21-37b1-3ff0-b5d7-2fb0377ff4f9",
                                        "glosses": [
                                            "sich abschwächen, schwächer werden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "101f69d4-0b1c-490d-8789-de7caec0682e",
                                                "sense_id": "12d91253-9024-3398-b117-c0b2f1cf7580",
                                                "text": "Die Probleme würden sich natürlich deutlich reduzieren, wenn es eine eindeutige Gesetzeslage gäbe."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bbccab8b-7458-37a1-b085-4f2bcf7e2d13",
                                        "entry_id": "2cd16b21-37b1-3ff0-b5d7-2fb0377ff4f9",
                                        "glosses": [
                                            "einen Vokal abschwächen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "96391550-46f2-3728-84e6-122ad030b97d",
                                        "entry_id": "2cd16b21-37b1-3ff0-b5d7-2fb0377ff4f9",
                                        "glosses": [
                                            "eine Reduktion vornehmen, desoxydieren"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b16660f6-eb58-4ab0-914a-5fa07599c617",
                                                "sense_id": "96391550-46f2-3728-84e6-122ad030b97d",
                                                "text": "„Der sehr stabile Benzolring lässt sich nur unter speziellen Bedingungen reduzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "80b1f30c-78a8-37cd-9946-12547653f385",
                                        "entry_id": "2cd16b21-37b1-3ff0-b5d7-2fb0377ff4f9",
                                        "glosses": [
                                            "auf den Normalwert umrechnen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "ad3e99f8-7dd7-3d30-a58e-410d267ea9f4",
                                        "entry_id": "2cd16b21-37b1-3ff0-b5d7-2fb0377ff4f9",
                                        "glosses": [
                                            "durch Einkochen eine mehr oder weniger dickflüssige Konsistenz erreichen"
                                        ],
                                        "tags": [
                                            "Kochkunst",
                                            "besonders bei Suppen und Saucen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ca444d2-6055-4c17-b3a0-fc65fa12b67b",
                                                "sense_id": "ad3e99f8-7dd7-3d30-a58e-410d267ea9f4",
                                                "text": "Den Fond dann reduzieren, bis nur noch 50 cl der Flüssigkeit übrig sind."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ced0519-670c-4986-ae35-06515bee6649",
                        "source_entry_id": "60c39550-3433-347f-94fe-dfa09a90c733",
                        "target_lang_word": "herabsetzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herabsetzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b918a2c0-fd90-329f-a9d4-66704d532569",
                                        "entry_id": "2322fba3-50a3-3cb4-9742-5a2e4720c82f",
                                        "glosses": [
                                            "(einen Wert) geringer machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e67956d-6980-42fb-9d1a-062db43a66b7",
                                                "sense_id": "b918a2c0-fd90-329f-a9d4-66704d532569",
                                                "text": "Wegen der geringen Nachfrage hat der Geschäftsführer die Preise herabgesetzt."
                                            },
                                            {
                                                "example_id": "014f1ec1-a908-43c9-a869-d697006e2064",
                                                "sense_id": "b918a2c0-fd90-329f-a9d4-66704d532569",
                                                "text": "In der Versuchskammer setzen die Physiker für das Experiment den Luftdruck herab."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "13e68e0e-ae52-3eae-9acd-3a1f90ed1b37",
                                        "entry_id": "2322fba3-50a3-3cb4-9742-5a2e4720c82f",
                                        "glosses": [
                                            "mit Geringschätzung, kränkend behandeln; die Bedeutung oder das Ansehen einer Person oder Sache schmälern"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e0dc211-96e2-4e1b-bf81-b120a10cb482",
                                                "sense_id": "13e68e0e-ae52-3eae-9acd-3a1f90ed1b37",
                                                "text": "„Die Diskussion verläuft teilweise so, dass ich Sorge habe, sie könnten pauschal das Ansehen der Politiker herabsetzen.“"
                                            },
                                            {
                                                "example_id": "5b3e4824-c629-4f1e-91f1-dcb7d0e1d95e",
                                                "sense_id": "13e68e0e-ae52-3eae-9acd-3a1f90ed1b37",
                                                "text": "„Haben Sie jemals dem anderen gegenüber verächtlich reagiert – ihn herabgesetzt, erniedrigt oder abgewertet?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
