                    {
                        "sense_id": "6ad61969-6d3b-3dd4-91c4-3e188510bf21",
                        "entry_id": "52239019-f32c-3c9a-84c4-7c2f2badb870",
                        "glosses": [
                            "Pièce d'un moteur ou d'un générateur qui assure la relation électrique entre rotor et stator."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df3292fc-c849-4326-9795-3521053f3814",
                                "sense_id": "6ad61969-6d3b-3dd4-91c4-3e188510bf21",
                                "text": "[…] ; l'autre par une triple dérivation aboutissant à une large plaque métallique terminée par un balai frotteur, dans le genre de ceux des collecteurs de dynamos."
                            }
                        ]
                    },
                    {
                        "sense_id": "276de8aa-dd6f-32f4-b20d-f5a938933f91",
                        "entry_id": "52239019-f32c-3c9a-84c4-7c2f2badb870",
                        "glosses": [
                            "Plateau supérieur du condensateur, de celui qui est en rapport direct avec la source d’électricité."
