                                    {
                                        "sense_id": "ff8c2d7b-dc4f-3261-9aba-bc144a49b155",
                                        "entry_id": "25e4eba1-1f16-3e81-8cfb-93e5ac080660",
                                        "glosses": [
                                            "A style of Afro-Caribbean music that originated in Trinidad and Tobago during the early to the mid-19th century and spread to the rest of the Caribbean Antilles and Venezuela by the mid-20th century."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fffea12-31ad-4381-b8bc-41a897af4624",
                                                "sense_id": "ff8c2d7b-dc4f-3261-9aba-bc144a49b155",
                                                "text": "'How you does live, Mr. Wordsworth?' I asked him one day.\nHe said, 'You mean how I get money?'\nWhen I nodded, he laughed in a crooked way.\nHe said, 'I sing calypsoes in the calypso season.'\n'And that last you the rest of the year?'\n'It is enough.'"
                                            }
                                        ]
                                    },
