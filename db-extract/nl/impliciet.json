                        "entry_id": "67666a4e-5528-3778-97c4-25762b1921e0",
                        "glosses": [
                            "niet uitdrukkelijk gezegd of erbij geschreven, maar wel in het gezegde of geschrevene opgesloten liggend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058601ee-b1aa-4d9d-985b-c0ee1e42f002",
                                "sense_id": "34c3426e-4662-36f3-9335-26a0bcde400e",
                                "text": "- In die tekst valt een impliciet verband te herkennen."
                            },
                            {
                                "example_id": "757683d7-cf1c-4393-8353-c7e6b43241d3",
                                "sense_id": "34c3426e-4662-36f3-9335-26a0bcde400e",
                                "text": "- Volgens mij heeft heeft hij daarmee impliciet toegegeven dat hij zelf ook vindt dat hij een grove fout heeft gemaakt."
                            }
                        ]
                    }
