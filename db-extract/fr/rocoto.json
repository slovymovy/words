                        "glosses": [
                            "Nom vernaculaire de Capsicum pubescens espèce de piment à fleurs violettes aux graines noies et rugueuses, originaire du Pérou et de Bolivie il aussi cultivé dans d’autres pays d’Amérique latine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01e5434-b905-4d0f-80db-37cf235801cf",
                                "sense_id": "bda6c6cd-9983-3ece-84cc-dc56b474372f",
                                "text": "Le piment manzana est aussi connu sous le nom de rocoto, de peron et de caballo. Sa couleur habituelle est le jaune orangé, il ressemble beaucoup à un poivron avec 7 cm de haut et 3 cm de diamètre."
                            }
                        ]
                    },
                    {
                        "sense_id": "dba37d24-6978-3d99-81da-c69471f01c9b",
                        "entry_id": "5d7af693-858c-3c5a-ace9-973ec4d1c9a7",
                        "glosses": [
