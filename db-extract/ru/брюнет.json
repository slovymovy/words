                                                "text": "Le merle brunet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brunet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99737936-c43e-368f-9673-220bc42b64ad",
                                        "entry_id": "81ac5b99-baf3-34f6-9320-783d67774020",
                                        "glosses": [
                                            "Personne qui a les cheveux un peu brun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae1dc915-3e91-42eb-a25d-5a3d1cf31404",
                                                "sense_id": "99737936-c43e-368f-9673-220bc42b64ad",
                                                "text": "Une petite brunette."
                                            },
                                            {
                                                "example_id": "90fbc806-051c-4e08-acb6-e0bd35c005fc",
                                                "sense_id": "99737936-c43e-368f-9673-220bc42b64ad",
                                                "text": "Un joli brunet."
                                            },
                                            {
                                                "example_id": "cb4fbbe8-b604-459e-8412-cc93b8684ca7",
                                                "sense_id": "99737936-c43e-368f-9673-220bc42b64ad",
                                                "text": "Quand il a eu sept ans, j'ai pensé que ce serait Alfano, le fils du baron Calproni, un brunet malingre."
                                            }
                                        ]
                                    }
                                ]
                            },
