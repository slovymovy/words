                "senses": [
                    {
                        "sense_id": "ca7dae9e-5bfa-3287-9a53-a791c50db036",
                        "entry_id": "0a2b1289-838c-314e-b839-15981acfc19b",
                        "glosses": [
                            "Kreuzung (genetisch), die eigenständige aber nur bedingt direkt vererbbare Merkmale hervorbringt"
                        ],
                        "tags": [
                            "speziell Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "ccc656c3-e3ca-40c3-a446-8e9f1b3e610a",
                                "sense_id": "ca7dae9e-5bfa-3287-9a53-a791c50db036",
                                "text": "Oftmals werden statt Küken alter Hühnerrassen Küken von Hybridrassen verwendet, da diese in vielen Fällen einen höheren Ertrag einbringen."
                            },
                            {
                                "example_id": "473357a8-8bab-49c1-a7cf-2ede0e9a38b6",
                                "sense_id": "ca7dae9e-5bfa-3287-9a53-a791c50db036",
                                "text": "„Sein Alptraum war das Entstehen einer neuen bösen Hybridrasse im Norden von Australien, hervorgebracht durch die Vermischung von Aborigines, Asiaten […]“"
                            },
                            {
                                "example_id": "67130851-b3f9-4656-83ba-135e05d1a6f9",
                                "sense_id": "ca7dae9e-5bfa-3287-9a53-a791c50db036",
                                "text": "„Küken einer Hybridrasse bringen für den Mäster den Vorteil der hohen Mastleistung und Fleischqualität.“"
                            },
                            {
                                "example_id": "df2b1996-d9e1-408c-b8f6-7d134ba8cc22",
                                "sense_id": "ca7dae9e-5bfa-3287-9a53-a791c50db036",
                                "text": "„Fölsch hat einmal eine Schar echter Bankivahühner und eine moderne Hybridrasse frei gehalten und beide miteinander verglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
