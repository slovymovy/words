                        "sense_id": "d45afc7b-a7c7-38bb-8d14-cdccf24cf033",
                        "entry_id": "9e05af8e-210b-33ad-84dd-8adc76ef4b07",
                        "glosses": [
                            "Retourner un organe comme on le ferait du doigt d’un gant, replier vers l’intérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7016f828-82a5-4379-a655-c99e225110ef",
                                "sense_id": "d45afc7b-a7c7-38bb-8d14-cdccf24cf033",
                                "text": "Après avoir ouvert le thorax du côté gauche, il (le chirurgien Tuffier) invagine l’aorte en la repoussant de son annulaire droit (comme il enfilerait un doigt de gant) jusqu'à l'orifice du ventricule gauche."
                            },
                            {
                                "example_id": "63789c79-72c3-4ca5-ad9c-b183602a9837",
                                "sense_id": "d45afc7b-a7c7-38bb-8d14-cdccf24cf033",
                                "text": "L'iléus est souvent produit par une anse intestinale qui s'invagine."
                            },
                            {
                                "example_id": "86ebe4a7-e3b6-4d4f-a0b4-02c27ec9be95",
                                "sense_id": "d45afc7b-a7c7-38bb-8d14-cdccf24cf033",
                                "text": "Les sons rentreront dans l’orgue après le service et l’avenir s’invaginera dans le Passé comme il a toujours fait."
                            }
                        ]
                    }
                ],
