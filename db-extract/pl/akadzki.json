                ],
                "translations": [
                    {
                        "translation_id": "1eec9e61-12da-49fe-a6e2-1982c9bab4df",
                        "source_entry_id": "efc4bb5b-ce4d-37c1-8bdc-2ba69dd44ec9",
                        "source_sense_id": "561af0e0-25e0-3ecd-8cc0-f870f348272a",
                        "source_sense_description": "historisch: sich auf die Akkadier beziehend; akkadisch",
                        "target_lang_word": "akkadisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akkadisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4417b22b-f206-3273-9b9e-b6eccaee9cb6",
                                        "entry_id": "1f1be9d3-e258-3bcc-9d3f-5f187db7b112",
                                        "glosses": [
                                            "auf Akkad bezogen: die Dynastie von Akkade und ihren Herrschaftsbereich betreffend. Auch Kultur und Sprache der Akkader im Gegensatz zu denen der zeitgenössischen Sumerer"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "567e5f02-8c02-424b-a5f5-4d34a14e5b44",
                                                "sense_id": "4417b22b-f206-3273-9b9e-b6eccaee9cb6",
                                                "text": "In der neusumerischen Kunst vermischten sich akkadische und sumerische Stilelemente."
                                            },
                                            {
                                                "example_id": "baa7eaf9-0713-4e67-8d8c-f6b7004e5c2b",
                                                "sense_id": "4417b22b-f206-3273-9b9e-b6eccaee9cb6",
                                                "text": "„Die Narām-Sîn-Stele ist eine Siegesstele des akkadischen Königs Narām-Sîn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "771dc6f0-28b6-32bc-8b9c-cf7a9b92eefe",
                                        "entry_id": "1f1be9d3-e258-3bcc-9d3f-5f187db7b112",
                                        "glosses": [
                                            "auf Nordbabylonien, die historische Region Akkad, bezogen. In der Regel den kulturellen Gegensatz zum (ursprünglich) sumerischen Süden betonend"
                                        ],
                                        "tags": [
                                            "historical",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae746f16-a644-459c-b774-92f656aed718",
                                                "sense_id": "771dc6f0-28b6-32bc-8b9c-cf7a9b92eefe",
                                                "text": "Im akkadischen Norden Babyloniens finden wir schon früh viele Personennamen, die einer semitischen Sprache entstammen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c6139ebb-2e80-34a6-8837-898ec8ba2cf1",
                                        "entry_id": "1f1be9d3-e258-3bcc-9d3f-5f187db7b112",
                                        "glosses": [
                                            "die nach Akkad und den Akkadern benannte ostsemitische Sprache meinend."
                                        ],
                                        "tags": [
                                            "sprachwissenschaftlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97527c0b-65d8-4e2e-abb7-2b4637e319ad",
                                                "sense_id": "c6139ebb-2e80-34a6-8837-898ec8ba2cf1",
                                                "text": "Wir finden viele sumerische Lehnwörter in akkadischen Texten."
                                            },
                                            {
                                                "example_id": "91143519-7f93-4b3a-9d7f-331576edceb8",
                                                "sense_id": "c6139ebb-2e80-34a6-8837-898ec8ba2cf1",
                                                "text": "„Besonders rühmt sich Chammurapi, daß er ›Recht und Gerechtigkeit in der Sprache des Landes festgelegt habe‹, d.h. daß er die Satzungen nicht in der heiligen sumerischen Sprache, sondern akkadisch abfaßte, so daß jedermann sie lesen und verstehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
