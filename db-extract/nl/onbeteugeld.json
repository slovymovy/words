                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc3632f-4cdc-4953-b836-d1f77bbf86b4",
                                "sense_id": "ef8f763f-89a9-3f94-96bf-41e8138c31d9",
                                "text": "Katholieken gaan ervan uit dat alle mensen in principe goed zijn, maar de zonde heeft de mensheid al meteen in het begin als een spirituele ziekte besmet en kan haar in spiritueel opzicht te gronde richten als hij onbeteugeld zijn gang kan gaan.",
                                "translation": "Catholics take it as given that all people in principle are good, but that sin has infected humanity immediately from the beginning as a spiritual sickness and can lead humanity aground in spiritual matters if it can get its way unbridled.",
                                "english": "Catholics take it as given that all people in principle are good, but that sin has infected humanity immediately from the beginning as a spiritual sickness and can lead humanity aground in spiritual matters if it can get its way unbridled."
                            }
                        ]
