                                    },
                                    {
                                        "sense_id": "c2882755-06cf-3af4-9fa6-11b09c4d5758",
                                        "entry_id": "fbd72cf3-fc99-3a63-8532-e5b83c56820a",
                                        "glosses": [
                                            "aus Pflanzen hergestellt, gewonnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd61668e-ac1c-4635-9ed8-89d491d26441",
                                                "sense_id": "c2882755-06cf-3af4-9fa6-11b09c4d5758",
                                                "text": "Meine Mutter schwört auf pflanzliche Ernährung, ich aber brauche einmal pro Woche ein gutes Steak."
                                            },
                                            {
                                                "example_id": "2e702adf-7ce9-4917-baa9-689e6b547928",
                                                "sense_id": "c2882755-06cf-3af4-9fa6-11b09c4d5758",
                                                "text": "„Mit Blick auf den CO₂-Ausstoß erzielt pflanzliche Milch eine [um den Faktor 4,5] bessere Ökobilanz als Kuhmilch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e56b462-32e9-4e32-8a5e-3305bb783d26",
                        "source_entry_id": "ef7cbd9d-524c-386c-917e-d756d897c13b",
                        "source_sense_id": "c3b7ad95-a210-39dc-bf92-9edb54072dfd",
                        "source_sense_description": "tot de planten behorend, uit planten bestaand of daarvan afkomstig",
                        "target_lang_word": "vegetable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vegetable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40df23ca-a46c-3017-b810-a85c8a52c8a3",
                                        "entry_id": "6f97bd3b-90f2-3baf-a26a-a404d11b3460",
                                        "glosses": [
                                            "Any plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f74d49-e25c-414c-a8d8-e94b8f16171b",
                                                "sense_id": "40df23ca-a46c-3017-b810-a85c8a52c8a3",
                                                "text": "That he might ascertain whether any of the cloths of ancient Egypt were made of hemp, M. Dutrochet has examined with the microscope the weavable filaments of this last vegetable."
                                            },
                                            {
                                                "example_id": "34761220-965b-417e-a6ef-944280a06b95",
                                                "sense_id": "40df23ca-a46c-3017-b810-a85c8a52c8a3",
                                                "text": "The first of the tall trees was reached, and by the bearings proved the wrong one. So with the second. The third rose nearly two hundred feet into the air above a clump of underwood — a giant of a vegetable, with a red column as big as a cottage, and a wide shadow around in which a company could have manoeuvred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c0fefa-161f-3714-a864-9c51edc2272f",
                                        "entry_id": "6f97bd3b-90f2-3baf-a26a-a404d11b3460",
                                        "glosses": [
                                            "A plant raised for some edible part of it, such as the leaves, roots, fruit or flowers, but excluding any plant considered to be a fruit, grain, herb, or spice in the culinary sense."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9761fa17-08e7-3c26-a755-db2a12675220",
                                        "entry_id": "6f97bd3b-90f2-3baf-a26a-a404d11b3460",
                                        "glosses": [
                                            "The edible part of such a plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9dca448-2db5-3cf8-b28a-de4eff03b296",
                                        "entry_id": "6f97bd3b-90f2-3baf-a26a-a404d11b3460",
                                        "glosses": [
                                            "A person whose brain (or, infrequently, whose body) has been damaged to the point that they cannot interact with the surrounding environment; a person in a persistent vegetative state."
                                        ],
