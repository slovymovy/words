            {
                "entry_id": "2efbfda5-442c-3e25-9871-dd07f9394056",
                "word": "Atérien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02b8d29a-3f8b-316f-9c1a-a7f79fba4efa",
                        "entry_id": "2efbfda5-442c-3e25-9871-dd07f9394056",
                        "glosses": [
                            "Faciès industriel d’Afrique du Nord, correspondant plus ou moins à la fin du paléolithique moyen et au début du paléolithique supérieur."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "53308b28-1a2d-4af0-9747-687e8b5d6526",
                                "sense_id": "02b8d29a-3f8b-316f-9c1a-a7f79fba4efa",
                                "text": "La phase finale du Moustérien local porte le nom d’Atérien et est caractérisée par l'emploi généralisé d’outils pédonculés."
                            }
                        ]
                    }
                ],
