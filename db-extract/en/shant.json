                "senses": [
                    {
                        "sense_id": "7918d942-0617-36d0-a98a-c5d6631ebae8",
                        "entry_id": "e5daf186-0aac-302b-a88b-177ab3588307",
                        "glosses": [
                            "A drink, usually a pint."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8cf306be-b804-4d3e-8b45-3d2060dfd4aa",
                                "sense_id": "7918d942-0617-36d0-a98a-c5d6631ebae8",
                                "text": "If yez is smart yer will take out enough for a shant and some fun, enough to buy yer missus or yer tart a new dress, enough to put shoes on yer sister's weans, even, but leave the rest under yer feet for the next day, an' the day arter that."
                            },
                            {
                                "example_id": "e669b4fa-c94b-40b9-a0fa-eb9ebe03789e",
                                "sense_id": "7918d942-0617-36d0-a98a-c5d6631ebae8",
                                "text": "Welcoming Captain St Claire, Prince Rupert ordered him a shant of dark porter and called upon him to speak of his travels."
                            },
                            {
                                "example_id": "f58f75b5-7980-4c6c-97e6-501591ee6ab9",
                                "sense_id": "7918d942-0617-36d0-a98a-c5d6631ebae8",
                                "text": "Well, if you're willing to sub me a shant of bivvy, then I'll tell ya"
                            }
                        ]
                    },
                    {
                        "sense_id": "fa11ee7a-5ca3-3850-b44f-a75e78f0c8d2",
                        "entry_id": "e5daf186-0aac-302b-a88b-177ab3588307",
                        "glosses": [
                            "A shack or shanty."
                        ],
                        "tags": [
                            "Ireland",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "d8091842-9362-4ca8-ad6d-e92b4f1aaf28",
                                "sense_id": "fa11ee7a-5ca3-3850-b44f-a75e78f0c8d2",
                                "text": "Why, I wouldn't swap this old wrack of a shant , ez I've called it, with the treasures it contains to-day, for al the bloomin'est bloomed mansions that ever stood on the face of the earth."
                            },
                            {
                                "example_id": "49ba9e28-17d9-4e20-809a-22a96570087b",
                                "sense_id": "fa11ee7a-5ca3-3850-b44f-a75e78f0c8d2",
                                "text": "I clapped Ehren on the shoulder and went away to stare broodingly upon that cramph of a shant."
                            },
                            {
                                "example_id": "3756ac5f-ce48-416a-b13f-50c505054372",
                                "sense_id": "fa11ee7a-5ca3-3850-b44f-a75e78f0c8d2",
                                "text": "I'd rather deliver in the Glossop Grubber than that apology for a shant."
                            }
                        ]
                    }
                ],
