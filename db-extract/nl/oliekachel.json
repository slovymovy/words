                        "sense_id": "e2d7ce85-9af6-31f4-8f47-671ce1e68cf0",
                        "entry_id": "3edb98a5-05e1-34d5-a495-846a27020bdb",
                        "glosses": [
                            "een kachel die warmte geeft door de verbranding van petroleum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee8d4bf-40e6-4ca1-88db-5cc2b999b3bb",
                                "sense_id": "e2d7ce85-9af6-31f4-8f47-671ce1e68cf0",
                                "text": "De brand is volgens de brandweer mogelijk ontstaan in een oliekachel in de kamer van een van de kinderen."
                            },
                            {
                                "example_id": "1541e688-96cc-40d3-945d-943a11513ab0",
                                "sense_id": "e2d7ce85-9af6-31f4-8f47-671ce1e68cf0",
                                "text": "De brand brak vannacht uit op de vijfde etage van de flat. Mitros vermoedt dat de brand is ontstaan in een oliekachel die in de woning stond. De zeven bewoners van het appartement hebben rook ingeademd en zijn uit voorzorg naar het ziekenhuis gebracht."
                            },
                            {
                                "example_id": "dbe7512f-1c9c-4289-9097-861cabf65b0f",
                                "sense_id": "e2d7ce85-9af6-31f4-8f47-671ce1e68cf0",
                                "text": "Koolmonoxide wordt wel een sluipmoordenaar genoemd. Het gas komt vrij bij onvolledige verbranding van een brandstof in bijvoorbeeld een cv-ketel, geiser, gasfornuis, hout-, gas- en oliekachel of open haard."
                            }
                        ]
                    }
