                "senses": [
                    {
                        "sense_id": "c306a000-14aa-3a0b-b4ca-6ff58a01e3f7",
                        "entry_id": "2963db4f-0c20-37c8-b821-2f64846b7d83",
                        "glosses": [
                            "lang stevig mes waarmee men zich al kappend een weg kan banen in het oerwoud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906e0260-aaf6-48f9-8321-ea04e7e19e6e",
                                "sense_id": "c306a000-14aa-3a0b-b4ca-6ff58a01e3f7",
                                "text": "De machete maakte het pad vrij van de vele obstakels."
                            },
                            {
                                "example_id": "7f00b8ab-2f3a-4d0c-97f6-2de7c4fa6af2",
                                "sense_id": "c306a000-14aa-3a0b-b4ca-6ff58a01e3f7",
                                "text": "Maar in de etalage hingen ook harken en wieders, reservebanden, kleren, vreemde helmen, fietswielen, petroleumlampen, spiritusbranders, touwen, machetes, vistuig en alles wat je kon bedenken of zelfs niet kon bedenken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "424353aa-a7df-4eba-ac58-be0150c01696",
                        "source_entry_id": "2963db4f-0c20-37c8-b821-2f64846b7d83",
                        "source_sense_id": "c306a000-14aa-3a0b-b4ca-6ff58a01e3f7",
                        "source_sense_description": "licht gebogen zwaard",
                        "target_lang_word": "Machete",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14346a8a-9a6c-3ee3-b0e5-b26653e6e44c",
                                        "entry_id": "d0002bad-e7c2-3ee9-8e80-e60057af20cb",
                                        "glosses": [
                                            "Messer zur Ernte landwirtschaftlicher Produkte, Buschmesser"
                                        ],
                                        "tags": [
                                            "Waffe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f760e782-808c-41d5-bce7-251930c576cf",
                                                "sense_id": "14346a8a-9a6c-3ee3-b0e5-b26653e6e44c",
                                                "text": "In diesem Film wird mit Macheten gekämpft."
                                            },
                                            {
                                                "example_id": "6751ce9f-5471-4614-8643-766a1576a000",
                                                "sense_id": "14346a8a-9a6c-3ee3-b0e5-b26653e6e44c",
                                                "text": "„Ihre Gewehre und die Macheten lassen nichts Gutes ahnen.“"
                                            },
                                            {
                                                "example_id": "6607cc07-00ee-4c8d-acc2-16075a9fdca2",
                                                "sense_id": "14346a8a-9a6c-3ee3-b0e5-b26653e6e44c",
                                                "text": "„Hinter einer gerodeten Lichtung mit Feldern und Pflanzungen zog Kaba seine Machete aus dem Gürtel und schlug mit kräftigen Hieben eine schmale Schneise ins Dickicht.“"
                                            },
                                            {
                                                "example_id": "b5eb17e1-6f7f-4c2b-8932-f5ef46e7d7ad",
                                                "sense_id": "14346a8a-9a6c-3ee3-b0e5-b26653e6e44c",
                                                "text": "„Der Machete schien schwer wie eine Axt zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5eeb1ba7-9356-468d-9543-8283ee1c12f5",
                        "source_entry_id": "2963db4f-0c20-37c8-b821-2f64846b7d83",
                        "source_sense_id": "c306a000-14aa-3a0b-b4ca-6ff58a01e3f7",
                        "source_sense_description": "licht gebogen zwaard",
                        "target_lang_word": "machete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97eca4da-7aa1-3271-819d-183816f1f4ba",
                                        "entry_id": "8572f09e-c487-3c94-b545-7a0359a182f2",
                                        "glosses": [
                                            "A sword-like tool used for cutting large plants with a chopping motion, or used as a weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a288495c-8c4e-4042-8dc4-57e886d8e103",
                                                "sense_id": "97eca4da-7aa1-3271-819d-183816f1f4ba",
                                                "text": "Near-synonyms: (all sometimes or regionally synonymous) bolo, golok, panga, parang, sundang"
                                            },
                                            {
                                                "example_id": "f65547d0-a4b2-436f-a335-ee5e87838b0b",
                                                "sense_id": "97eca4da-7aa1-3271-819d-183816f1f4ba",
                                                "text": "It breaks loose one rope at a time, haphazardly, tossing the Filipinos up into the air. A boy with a machete cuts the one remaining line, which pops up and lashes him across the face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645cec26-19c6-34a9-a4f3-c88235e47bdf",
                                        "entry_id": "8572f09e-c487-3c94-b545-7a0359a182f2",
                                        "glosses": [
                                            "A small stringed instrument from Madeira, Portugal, having a double bulged body, traditionally of wood, with a small rib and four metallic strings, sometimes attached by wooden pegs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "machete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2eba31-8a61-3dee-bd5f-e585fc732c58",
                                        "entry_id": "ffc5e569-404b-3f51-bc7c-3de974eca5a2",
                                        "glosses": [
                                            "To cut or chop with a machete."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdb8b0da-dbe7-4aa1-ba6f-b0ce060a325c",
                                                "sense_id": "8f2eba31-8a61-3dee-bd5f-e585fc732c58",
                                                "text": "After some hours of intense work, we had macheted a path through the jungle to the bank of the river."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f15480c-0b27-4940-a6e5-71bb7504500b",
                        "source_entry_id": "2963db4f-0c20-37c8-b821-2f64846b7d83",
                        "source_sense_id": "c306a000-14aa-3a0b-b4ca-6ff58a01e3f7",
                        "source_sense_description": "licht gebogen zwaard",
                        "target_lang_word": "machette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dd16db9-fa33-32ff-af40-1fdaa40624d8",
                                        "entry_id": "03fe0129-58ef-3c03-b3e7-2f33e089040f",
                                        "glosses": [
                                            "Long couteau muni d’une lame épaisse mesurant environ 40 centimètres de long et au manche court, servant généralement à se frayer un chemin dans les régions à végétation dense, à ouvrir des fruits à coque dure comme la noix de coco, à tailler les feuilles de palmier, etc., aussi utilisé comme arme blanche."
                                        ],
                                        "tags": [
                                            "Coutellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28ffb616-f159-4560-bc33-0dfebca98931",
                                                "sense_id": "9dd16db9-fa33-32ff-af40-1fdaa40624d8",
                                                "text": "Nous avançons à la machette dans la bien nommée forêt impénétrable de Bwindi."
                                            },
                                            {
                                                "example_id": "832ebf3e-16a4-4e3c-802d-50ac4bfb05fa",
                                                "sense_id": "9dd16db9-fa33-32ff-af40-1fdaa40624d8",
                                                "text": "Ces voyages étaient de véritables aventures et il convenait chaque fois de se préparer au pire en emportant pelles, haches, machettes, crics, tire-forts et surtout les inévitables \"caisse-popote\", \"lit-picot\" et moustiquaires, sans oublier un ou deux manœuvres. — (Bernard Le Doux, O Tangani, Liv’éditions, 1994)"
                                            },
                                            {
                                                "example_id": "878744bc-6cd0-4336-ab23-9b349145f0cb",
                                                "sense_id": "9dd16db9-fa33-32ff-af40-1fdaa40624d8",
                                                "text": "Les policiers ont également confisqué un pistolet à impulsion électrique, un bâton rétractable, une machette, un fusil à plomb et une arme à air comprimé"
                                            }
                                        ]
                                    }
                                ]
                            },
