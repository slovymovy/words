                                "target_senses": [
                                    {
                                        "sense_id": "d9fbf6ea-c856-31ef-8d98-7cc89cd708b8",
                                        "entry_id": "69cb4733-bd02-3250-8dc9-37e33aac35ae",
                                        "glosses": [
                                            "Qui se rapporte au mercantilisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bc8168e-9ce4-4ca3-a388-b0edab88ace8",
                                                "sense_id": "d9fbf6ea-c856-31ef-8d98-7cc89cd708b8",
                                                "text": "La doctrine mercantiliste, sur les relations entre économie et politique des nations, a pour point de départ, pour principe la formule célèbre : « L'argent est le nerf de la guerre. »"
                                            },
                                            {
                                                "example_id": "decc014b-5cb1-42bb-aab5-9b5648049615",
                                                "sense_id": "d9fbf6ea-c856-31ef-8d98-7cc89cd708b8",
                                                "text": "L’exemple le plus célèbre de cette rationalisation, caractéristique de l’économie mercantiliste, est le commerce transatlantique, dit \"commerce triangulaire\"."
                                            }
                                        ]
                                    }
                                ]
                            },
