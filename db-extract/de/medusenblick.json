                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "abe3614d-8711-4035-8994-9dfa3851f018",
                                "sense_id": "9f1cca68-1c6c-3666-9f66-be5a7b3248fa",
                                "text": "„Sie warf einen wahren Medusenblick in Richtung Eingangsportal.“"
                            },
                            {
                                "example_id": "71fcef12-7593-484a-a71a-b86dd2b8ff1d",
                                "sense_id": "9f1cca68-1c6c-3666-9f66-be5a7b3248fa",
                                "text": "„Ich hatte völlig vergessen, was für einen Medusenblick Leticia manchmal haben kann.“"
                            },
                            {
                                "example_id": "315fc8c7-bf00-4cfd-9eda-b608d5c1fa0c",
                                "sense_id": "9f1cca68-1c6c-3666-9f66-be5a7b3248fa",
                                "text": "„Sein Medusenblick verwandelt jedes Vergnügen in Schmerz: Vergnügen der Sinne, der Empfindsamkeit, der Leidenschaften und selbst des Nachdenkens werden vor ihm zule[t]zt Ekel oder Schmerz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
