                "senses": [
                    {
                        "sense_id": "e2cf1e1a-bb84-3b34-b21e-d64a6f67a127",
                        "entry_id": "9dd1df21-cd37-3788-a3cf-7c20a396c4fa",
                        "glosses": [
                            "Person, die in einem Handwerk Meister ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b1173f-c6c5-447f-a923-2e9fa2b47dac",
                                "sense_id": "e2cf1e1a-bb84-3b34-b21e-d64a6f67a127",
                                "text": "„Er soll bei einem Handwerksmeister, einem Besenbinder, geschafft haben.“"
                            },
                            {
                                "example_id": "e72b789f-0035-4186-91d3-cd968816b4bf",
                                "sense_id": "e2cf1e1a-bb84-3b34-b21e-d64a6f67a127",
                                "text": "„Wer als Bürgermeister, Ortsbauernführer oder sonstwie ein Amt bekleidete, wer als Handwerksmeister, als Gastwirt oder als Kaufmann in besonderem Ansehen stand, der wurde nun abgeholt.“"
                            }
                        ],
