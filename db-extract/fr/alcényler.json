                "senses": [
                    {
                        "sense_id": "ad1c3ae4-5565-3a0e-aa2c-dd1f67dd36ee",
                        "entry_id": "d6c05fbb-0159-3e0c-8b29-d073cf20ae27",
                        "glosses": [
                            "Introduire un radical alcényle dans une molécule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec96a345-0fe7-4cb6-a64c-6aee85bedf1e",
                                "sense_id": "ad1c3ae4-5565-3a0e-aa2c-dd1f67dd36ee",
                                "text": "Grâce au couplage de Heck, il est possible d’alcényler ou d’aryler des oléfines ne possédant pas d'atome d'hydrogène en position allylique, avec des résultats prévisibles, comme l’éthylène, les éthylènes substitués par des groupes électroattracteurs et des styrènes."
                            },
                            {
                                "example_id": "b041a6ab-3a91-4233-863d-7d8c4b59b710",
                                "sense_id": "ad1c3ae4-5565-3a0e-aa2c-dd1f67dd36ee",
                                "text": "Seules les cétones 5b + 6b et 5c + 6c, monoalkylées en position 1, ont pu être alcénylées."
                            }
                        ]
                    }
