                    {
                        "sense_id": "1684ea4d-1788-3929-ad7f-546548167ef7",
                        "entry_id": "838f0e78-7083-3fdb-a7bf-02a3efcb3b0d",
                        "glosses": [
                            "The act of disparaging, of belittling."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e23aa551-6faf-4b86-a1fc-41e83a4ce0d0",
                                "sense_id": "1684ea4d-1788-3929-ad7f-546548167ef7",
                                "text": "His disparagement of his opponent failed to dissuade voters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "738fdf4e-c309-45cd-a2e3-7b8710c25d9b",
                        "source_entry_id": "838f0e78-7083-3fdb-a7bf-02a3efcb3b0d",
                        "source_sense_id": "1684ea4d-1788-3929-ad7f-546548167ef7",
                        "source_sense_description": "An act of disparaging",
                        "target_lang_word": "Verunglimpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verunglimpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                        "entry_id": "143c7379-3e0a-3471-90a8-cdd90e765236",
                                        "glosses": [
                                            "Herabsetzung, Verächtlichmachung von jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63292ca3-ac82-4862-9a6d-3079ef3e7601",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Seit Mitte des 19. Jahrhunderts wurde es zur Verunglimpfung von Personen verwendet.“"
                                            },
                                            {
                                                "example_id": "78c92635-1df6-43ea-a677-5639c4d26389",
                                                "sense_id": "7ff6b2bd-6d86-3344-8b3d-7f81f2a2fa11",
                                                "text": "„Der sogenannte Blasphemieartikel 295 a-c des pakistanischen Strafgesetzbuchs stellt die Schändung religiöser Texte jeder Religionsgruppe unter Strafe. Auf die Verunglimpfung des Korans steht lebenslange Haft, auf die des Propheten die Todesstrafe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "603313a0-0239-4cdc-9d0e-637368718e74",
                        "source_entry_id": "838f0e78-7083-3fdb-a7bf-02a3efcb3b0d",
                        "source_sense_id": "1684ea4d-1788-3929-ad7f-546548167ef7",
                        "source_sense_description": "An act of disparaging",
                        "target_lang_word": "Herabsetzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herabsetzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                        "entry_id": "b62f3149-6d6f-3336-8841-26f97be355b5",
                                        "glosses": [
                                            "Handlung, etwas weniger oder kleiner zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a574e9-f82b-4977-9812-a913a35bde3f",
                                                "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                                "text": "„Sollte das Finanzamt den Antrag auf Herabsetzung ablehnen, kann der Unternehmer Einspruch einlegen.“"
                                            },
                                            {
                                                "example_id": "7154b583-689f-4a7d-bf24-8dc82dcb46b5",
                                                "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                                "text": "„Sofern der Anspruch auf Herabsetzung bereits zum Zeitpunkt der Gebührenfestsetzung feststeht, darf die Gebühr nur in der Höhe festgesetzt werden, die der in den Kanal eingeleiteten Wassermenge entspricht.“"
                                            },
                                            {
                                                "example_id": "9d38b120-5945-45d1-923c-063f8196a2b9",
                                                "sense_id": "84e0eaaf-b9c5-3cdc-8f5d-fc261f10105c",
                                                "text": "„Mit seiner Berufung erstrebt er die Herabsetzung des Strafausmaßes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1248759d-0fb5-3d2c-9faf-0efacdb3ad7f",
                                        "entry_id": "b62f3149-6d6f-3336-8841-26f97be355b5",
                                        "glosses": [
                                            "unsachliche Geringschätzung der Bedeutung eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25fcd250-7889-4701-86b7-a3488bff91c0",
                                                "sense_id": "1248759d-0fb5-3d2c-9faf-0efacdb3ad7f",
                                                "text": "„[Andreas Rödder:] Die Grenze würde ich dort ziehen, wo die Menschenwürde betroffen ist und es zu persönlichen Beleidigungen, völkischem Denken und der Herabsetzung anderer Menschen kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33f71325-3f4a-491a-9dd5-96ffb8d420c7",
                        "source_entry_id": "838f0e78-7083-3fdb-a7bf-02a3efcb3b0d",
                        "source_sense_id": "1684ea4d-1788-3929-ad7f-546548167ef7",
                        "source_sense_description": "An act of disparaging",
                        "target_lang_word": "Herabwürdigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herabwürdigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                        "entry_id": "b40eeef4-9e87-37bb-a8ee-c98fe1bd6a6e",
                                        "glosses": [
                                            "Geringschätzung der Leistung einer Person; Abwertung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b54fd63-7fe6-40fc-a9e4-e2a26ecf99a5",
                                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                                "text": "„Er empfindet diese Behauptung als eine Herabwürdigung seiner Person.“"
                                            },
                                            {
                                                "example_id": "9295b303-8339-4384-8dc1-8325bc672054",
                                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                                "text": "„Die Herabwürdigung kommt dadurch ohne externe Verweise auf persönliche Merkmale, wie beispielsweise schlechte Kleidung, oder andere Verhaltensweisen des zahlungssäumigen Mitglieds aus.“"
                                            },
                                            {
                                                "example_id": "63d2654a-0f2c-44f0-bb01-8ec948a792d6",
                                                "sense_id": "8d61785c-b074-32da-9f9d-71f373a70c58",
                                                "text": "„Nichts ist besser oder schlechter als das andere, und Herabwürdigungen mit Ausdrücken wie ‚banal‘ oder ‚stupide‘ sind selbstverständlich verboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
