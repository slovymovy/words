                            {
                                "example_id": "ff94e5cc-8fe5-40ea-90a7-27e52492846a",
                                "sense_id": "41e270a6-34f2-3c15-b9ab-054af0428387",
                                "text": "Les domestiques assassinent assez volontiers leurs maîtres, sous le prétexte moral de mettre les bijoux et l’argent d’iceux à la caisse d’épargne."
                            },
                            {
                                "example_id": "16936798-9979-4f7f-9008-e5f483c46856",
                                "sense_id": "41e270a6-34f2-3c15-b9ab-054af0428387",
                                "text": "Naturellement, Abel le Rat et Laugu du Moulin étaient d’iceux."
                            }
                        ]
                    }
