            "senses": [
                {
                    "sense_id": "a32e0298-0259-3642-a0d6-3d8896850971",
                    "sense_definition": "Sous-vêtement féminin en forme de jupe, porté sous une robe ou une autre jupe pour lui donner du volume ou par pudeur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté un <w>jupon</w> blanc en dentelle pour mettre sous sa nouvelle robe légère."
                        },
                        {
                            "text": "Ce tissu est tellement transparent qu'il faut absolument porter un <w>jupon</w> par-dessous."
                        }
                    ],
                    "synonyms": [
                        "sous-jupe"
                    ],
                    "common_phrases": [
                        "jupon en dentelle",
                        "porter un jupon",
                        "jupon de dessous"
                    ]
                },
                {
                    "sense_id": "df87d11f-a73d-383f-94e1-d42b6d7e7b77",
                    "sense_definition": "Femme ou compagnie féminine, envisagée comme objet de séduction galante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son voisin a toujours été connu pour aimer courir le <w>jupon</w> dès qu'il en a l'occasion."
                        },
                        {
                            "text": "Il passe ses week-ends à poursuivre les <w>jupons</w> au lieu de se consacrer sérieusement à ses études."
                        }
                    ],
                    "common_phrases": [
                        "courir le jupon",
                        "coureur de jupons"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Sens figuré et familier"
                        }
                    ]
                },
                {
                    "sense_id": "5ce685a5-73f4-3585-9b53-a1f0cd19c817",
                    "sense_definition": "Cotte d'armes ou tunique sans manches que les hommes d'armes portaient par-dessus leur armure au Moyen Âge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chevalier a endossé un <w>jupon</w> brodé à ses armoiries avant de s'élancer dans la mêlée."
                        },
                        {
                            "text": "Au musée de l'armée, on peut admirer un <w>jupon</w> de combat conservé depuis plusieurs siècles."
                        }
                    ],
                    "synonyms": [
                        "cotte d'armes"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Terme d'histoire militaire médiévale"
                        }
                    ]
                }
            ]
        }
