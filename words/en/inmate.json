{
    "word_family": [
        "mate",
        "inmate-ship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4226d1a-9318-3d4d-9dd9-9cfb842ffd83",
                    "sense_definition": "A person confined to an institution such as a prison or a psychiatric hospital.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prison <w>inmate</w> was released early for good behavior after serving five years.",
                            "target_lang_translations": {
                                "ru": "Тюремный <w>заключённый</w> был освобожден досрочно за хорошее поведение после пяти лет заключения."
                            }
                        },
                        {
                            "text": "Each <w>inmate</w> is required to follow a strict daily schedule within the facility.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>заключённый</w> обязан соблюдать строгий распорядок дня внутри учреждения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "prison inmate",
                        "former inmate",
                        "inmate population"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, содержащийся в закрытом учреждении, таком как тюрьма или психиатрическая больница."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключённый",
                                "target_lang_sense_clarification": "в тюрьме"
                            },
                            {
                                "target_lang_word": "пациент",
                                "target_lang_sense_clarification": "в психиатрической больнице"
                            },
                            {
                                "target_lang_word": "узник",
                                "target_lang_sense_clarification": "лицо, лишенное свободы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a8170f1-31d5-30b0-b1b0-ed96615f566e",
                    "sense_definition": "A person who shares a residence or lives in a specific building, such as a lodger or student.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "resident",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inmate</w> of the boarding house complained about the noise coming from the street.",
                            "target_lang_translations": {
                                "ru": "<w>Жилец</w> пансиона жаловался на шум, доносящийся с улицы."
                            }
                        },
                        {
                            "text": "As a fellow <w>inmate</w> of this dormitory, you should respect the shared common areas.",
                            "target_lang_translations": {
                                "ru": "Как <w>обитатель</w> этого общежития, вы должны уважать общие зоны пользования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fellow inmate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Now more commonly referred to as a resident or occupant."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, проживающий в определенном здании или жилом помещении, например, жилец или студент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обитатель",
                                "target_lang_sense_clarification": "житель дома или комнаты"
                            },
                            {
                                "target_lang_word": "жилец",
                                "target_lang_sense_clarification": "проживающий в доме"
                            },
                            {
                                "target_lang_word": "постоялец",
                                "target_lang_sense_clarification": "в пансионе или гостинице"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28625b7d-1cca-31af-8c3d-4413afca9850",
                    "sense_definition": "A person who is traveling or being carried inside a vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "traveler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inmate</w> of the carriage looked out the window at the passing countryside.",
                            "target_lang_translations": {
                                "ru": "<w>Пассажир</w> кареты смотрел в окно на проплывающие мимо сельские пейзажи."
                            }
                        },
                        {
                            "text": "The small cabin provided just enough room for a single <w>inmate</w> to sit comfortably.",
                            "target_lang_translations": {
                                "ru": "В маленькой каюте было достаточно места лишь для того, чтобы один <w>пассажир</w> мог с комфортом сидеть."
                            }
                        }
                    ],
                    "synonyms": [
                        "passenger"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical contexts to describe passengers in enclosed transport."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, путешествующий или находящийся внутри транспортного средства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пассажир",
                                "target_lang_sense_clarification": "в транспортном средстве"
                            },
                            {
                                "target_lang_word": "седок",
                                "target_lang_sense_clarification": "в экипаже или карете"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}