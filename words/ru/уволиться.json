{
    "word_family": [
        "увольнение",
        "увольнительный",
        "уволить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e12d487-5e48-3920-94c0-b1849fcd804b",
                    "sense_definition": "Прекратить трудовые отношения по собственному желанию или уйти с работы.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он решил <w>уволиться</w> с работы, чтобы найти более интересное место.",
                            "target_lang_translations": {
                                "en": "He decided to <w>quit</w> his job to find a more interesting position."
                            }
                        },
                        {
                            "text": "Многие сотрудники решили <w>уволиться</w> после того, как компания объявила о сокращении зарплат.",
                            "target_lang_translations": {
                                "en": "Many employees decided to <w>resign</w> after the company announced salary cuts."
                            }
                        }
                    ],
                    "synonyms": [
                        "уйти"
                    ],
                    "antonyms": [
                        "устроиться"
                    ],
                    "common_phrases": [
                        "уволиться с работы"
                    ],
                    "target_lang_definitions": {
                        "en": "To terminate one's employment voluntarily or to quit a job."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quit",
                                "target_lang_sense_clarification": "General term for leaving a job voluntarily."
                            },
                            {
                                "target_lang_word": "resign",
                                "target_lang_sense_clarification": "Formal term for giving notice and leaving a position."
                            },
                            {
                                "target_lang_word": "leave one's job",
                                "target_lang_sense_clarification": "Common phrase for ending employment."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeb9b92a-a477-3286-a29f-cc0930ded9b5",
                    "sense_definition": "Получить временное освобождение от служебных обязанностей или учёбы, обычно для военнослужащих.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдат попросил командира <w>уволиться</w> в город на несколько часов.",
                            "target_lang_translations": {
                                "en": "The soldier asked his commander for <w>leave</w> to go into town for a few hours."
                            }
                        },
                        {
                            "text": "После долгой службы он наконец смог <w>уволиться</w> в запас.",
                            "target_lang_translations": {
                                "en": "After long service, he was finally able to be <w>discharged</w> into the reserves."
                            }
                        }
                    ],
                    "synonyms": [
                        "отпроситься"
                    ],
                    "common_phrases": [
                        "уволиться в запас"
                    ],
                    "target_lang_definitions": {
                        "en": "To receive temporary leave from duties or studies, typically used in a military context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get leave",
                                "target_lang_sense_clarification": "Military or official permission to be absent."
                            },
                            {
                                "target_lang_word": "be discharged",
                                "target_lang_sense_clarification": "Specifically for leaving military service (e.g., into the reserves)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddc1f078-3a24-33cf-af92-c238b64f2174",
                    "sense_definition": "Страдательная форма глагола <w>уволить</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из-за грубого нарушения дисциплины он был <w>уволен</w> без права восстановления.",
                            "target_lang_translations": {
                                "en": "Due to a gross violation of discipline, he was <w>fired</w> without the right to reinstatement."
                            }
                        },
                        {
                            "text": "Сотрудник может быть <w>уволен</w> только в соответствии с трудовым кодексом.",
                            "target_lang_translations": {
                                "en": "An employee can only be <w>dismissed</w> in accordance with the labor code."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Грамматическая форма пассивного залога."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The passive form of the verb 'to fire' or 'to dismiss'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be fired",
                                "target_lang_sense_clarification": "Common, direct term for involuntary termination."
                            },
                            {
                                "target_lang_word": "be dismissed",
                                "target_lang_sense_clarification": "Formal term for being removed from a position."
                            },
                            {
                                "target_lang_word": "be laid off",
                                "target_lang_sense_clarification": "Termination due to company downsizing or economic reasons."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}