                ],
                "senses": [
                    {
                        "sense_id": "406ff893-2307-3882-8cc5-5e854ca6989d",
                        "entry_id": "4a98d892-fb38-3792-9cc5-e498ee7138f2",
                        "glosses": [
                            "Vorlage mit Text, Bild und so weiter, die für die Herstellung gedruckter Kopien verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa75d33d-2493-471a-8ac6-3ffcf5ca8559",
                                "sense_id": "406ff893-2307-3882-8cc5-5e854ca6989d",
                                "text": "„Damals, in den siebziger Jahren, schrieb man noch alles mit Schreibmaschine und falls man mehrere Kopien eines Textes brauchte, benötigte man zuerst eine Druckvorlage.“"
                            },
                            {
                                "example_id": "5cab00a3-18c7-4a26-8615-b3c14976afe1",
                                "sense_id": "406ff893-2307-3882-8cc5-5e854ca6989d",
                                "text": "„Abweichungen von der Druckvorlage sind im Text so dokumentiert, daß hochgestellte Kleinbuchstaben die geänderten Worte, Satzteile oder Sätze einschließen.“"
                            },
                            {
                                "example_id": "eeaec809-3bb6-4b6f-94bd-c838a19e75ae",
                                "sense_id": "406ff893-2307-3882-8cc5-5e854ca6989d",
                                "text": "„Auf der linken Seite finden Sie hingegen die Symbolleiste, mit der Sie neue Elemente in die Druckvorlage einfügen können (Werkzeugleite).“"
                            },
                            {
                                "example_id": "f407e060-8117-41dd-87c0-301a08ba7d15",
                                "sense_id": "406ff893-2307-3882-8cc5-5e854ca6989d",
                                "text": "„Voellmy fand in den 50er Jahren des letzten Jahrhunderts sechs Blätter von der Hand Füßlis, die er als Druckvorlage für das zweite Bändchen ‚Sämtlicher Schriften des Armen Mannes im Tockenburg‘ identifizierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
