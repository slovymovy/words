                                "target_senses": [
                                    {
                                        "sense_id": "5a10601b-2ae1-346e-90e5-cbaa636f132b",
                                        "entry_id": "5c50455c-3e07-3b86-b03f-f19449bc3d14",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df57daa3-7f41-40aa-99c3-029fd3eee8a7",
                                                "sense_id": "5a10601b-2ae1-346e-90e5-cbaa636f132b",
                                                "text": "В передней повозке тщедушный Василий Борисыч с толстой уставщицей Аркадией сел."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e61857ab-4e74-3588-aed1-547a25afb414",
                                        "entry_id": "5c50455c-3e07-3b86-b03f-f19449bc3d14",
                                        "glosses": [
                                            "часть древней Греции, жители которой, по большей части, пастухи и охотники, отличались простотою нравов и обычаев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed69d8f-0fcd-4e96-8151-26529237857a",
                                                "sense_id": "e61857ab-4e74-3588-aed1-547a25afb414",
                                                "text": "Вот милый всем творец! иль сердцем, иль умом // Грозит тебе он пленом: // В Аркадии б он был счастливым пастушком, // В Афинах ― Демосфеном."
                                            },
                                            {
                                                "example_id": "f0114702-5885-41b7-8b6e-f5f8822d057c",
                                                "sense_id": "e61857ab-4e74-3588-aed1-547a25afb414",
                                                "text": "И я, как вы, жила в Аркадии счастливой, // И я, на утре дней, в сих рощах и лугах // Минутны радости вкусила: // Любовь в мечтах златых мне счастие сулила: // Но что ж досталось мне в сих радостных местах?"
                                            },
                                            {
                                                "example_id": "cd604290-2cfb-4e18-878f-213c8150f80e",
                                                "sense_id": "e61857ab-4e74-3588-aed1-547a25afb414",
                                                "text": "В те баснословные времена Аркадией правил царь Ликаон, тиран и сластолюбец, отец сорока девяти сыновей, таких же нечестивых, как он сам, и рожденной от нимфы единственной дочери, красавицы Каллисто."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
