                "senses": [
                    {
                        "sense_id": "85b89aa7-24bc-390b-b893-676904979bd8",
                        "entry_id": "780c8c72-814e-343f-b4c7-c6e0091ae71f",
                        "glosses": [
                            "gedeelte van de atmosfeer van de aarde buiten de stratosfeer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c7750b-baf6-4bf8-a3c4-5d480703fda1",
                                "sense_id": "85b89aa7-24bc-390b-b893-676904979bd8",
                                "text": "de ionosfeer zorgt ervoor dat radiogolven voor een deel worden gereflecteerd. Hierdoor kunnen radiogolven veel verder komen dan anders mogelijk zou zijn door de ronding van de aarde"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d0b9374-a46b-48f3-9268-1aedc7543a9c",
                        "source_entry_id": "780c8c72-814e-343f-b4c7-c6e0091ae71f",
                        "source_sense_id": "85b89aa7-24bc-390b-b893-676904979bd8",
                        "target_lang_word": "Ionosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ionosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                        "entry_id": "977ac710-4c33-38cd-bb70-d4f109aaed66",
                                        "glosses": [
                                            "äußerste Schicht der Atmosphäre eines Himmelskörpers (meist der Erde), die durch Sonnenstrahlung Ionen und freie Elektronen enthält"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c15dcf8-5a1b-466b-8f45-076d710201fa",
                                                "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                                "text": "„Die Ionosphäre — jene Schicht, die zwischen 80 und 500 Kilometern unseren Planeten umgibt — ist bis heute so gut wie unerforscht.“"
                                            },
                                            {
                                                "example_id": "2bfc00bc-833f-4642-883a-c5fbc2a15cff",
                                                "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                                "text": "„Diesmal wird die besondere Aufmerksamkeit der Himmelsforscher verschiedenen noch wenig ergründeten Phänomenen gelten, die sich vor allem in der Ionosphäre und der oberen Atmosphäre abspielen.“"
                                            },
                                            {
                                                "example_id": "c8756257-f583-4e01-95d8-b803c1b05af0",
                                                "sense_id": "7cd0fc61-3068-344f-b501-08a3a6595cd3",
                                                "text": "„Denn hier in Polnähe trifft der wechselnde Sonnenwind besonders intensiv auf die Erde, beeinflusst die Ionosphäre – und möglicherweise auch das Klima.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "687f2be5-be44-41fb-97a6-28b261169c1f",
                        "source_entry_id": "780c8c72-814e-343f-b4c7-c6e0091ae71f",
                        "source_sense_id": "85b89aa7-24bc-390b-b893-676904979bd8",
                        "target_lang_word": "ionosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ionosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02935ee6-4698-3a50-ab72-99f3d7bd7e68",
                                        "entry_id": "6c8fb7d4-3f1e-3eae-92ca-ee20907d9aac",
                                        "glosses": [
                                            "The part of the Earth's atmosphere beginning at an altitude of about 50 kilometers (31 miles) and extending outward 500 kilometers (310 miles) or more."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3049cc7-a542-4770-874e-fe19e3a4fa91",
                                                "sense_id": "02935ee6-4698-3a50-ab72-99f3d7bd7e68",
                                                "text": "Dave frowned as he tried to answer. \"Well, I suppose the atmosphere is oxygen and nitrogen, mostly; then there's the ionosphere and the ozone layer. As I remember, the color of the sky is due to the scattering of light—light rays being diffracted in the air.\""
                                            },
                                            {
                                                "example_id": "fd63daf4-5e8a-43e9-b945-1af5fc137a9f",
                                                "sense_id": "02935ee6-4698-3a50-ab72-99f3d7bd7e68",
                                                "text": "Solar storms drive currents of millions of amps through the electrically conductive upper layer of our atmosphere (known as the ionosphere). These currents, which can fluctuate rapidly, drive powerful magnetic disturbances at the Earth's surface that in turn induce electrical currents in the planet's crust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f5b408e-e086-3135-83d4-1f513acbf663",
                                        "entry_id": "6c8fb7d4-3f1e-3eae-92ca-ee20907d9aac",
                                        "glosses": [
                                            "The similar region of the atmosphere of another planet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d135997-0a04-4369-931c-a145596651fc",
                        "source_entry_id": "780c8c72-814e-343f-b4c7-c6e0091ae71f",
                        "source_sense_id": "85b89aa7-24bc-390b-b893-676904979bd8",
                        "target_lang_word": "ionosphère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ionosphère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e76955fe-e1b0-33c7-8479-f49fdf2ff108",
                                        "entry_id": "348dfc09-0ec4-3e8d-a24a-900b6d8a2364",
                                        "glosses": [
                                            "Région entourant un objet céleste, ionisée par les radiations d’une étoile proche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d94b1325-af42-4aae-9366-9d47501ecc52",
                                                "sense_id": "e76955fe-e1b0-33c7-8479-f49fdf2ff108",
                                                "text": "Sans compter l’ouverture qui serait offerte aux actes de « piraterie » paralysante ; car il suffirait de diffuser en haute atmosphère 25 tonnes de fluor pour désélectroniser l’ionosphère et, par conséquent, supprimer durablement toute possibilité de communication radio à longue distance."
                                            },
                                            {
                                                "example_id": "4347feb5-b897-4346-afbf-ad9294031b8e",
                                                "sense_id": "e76955fe-e1b0-33c7-8479-f49fdf2ff108",
                                                "text": "Haarp est pointé du doigt à la suite de vidéos dans lesquelles on aperçoit des flashs lumineux dans le ciel de Marrakech, les complotistes y voyant une manipulation de l’ionosphère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
