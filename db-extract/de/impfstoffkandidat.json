                        "entry_id": "f58f6ba4-1313-3b4d-8473-ca89bbd95f9a",
                        "glosses": [
                            "Serum (Impfstoff), das man während seiner Entwicklung testet, weil es vermutlich/hoffentlich als Impfstoff gegen eine bestimmte Infektionskrankheit geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466bd35b-3ee4-4258-9b37-340f954ace99",
                                "sense_id": "5f1087af-e41c-33d0-a96c-8e07b0b47569",
                                "text": "„Sieben vielversprechende Impfstoffkandidaten hatten die Forscher in ihren Pipelines gehabt, alle waren erfolgreich an Affen getestet worden.“"
                            },
                            {
                                "example_id": "9102d91d-3407-47c3-ad7e-ddd09393064a",
                                "sense_id": "5f1087af-e41c-33d0-a96c-8e07b0b47569",
                                "text": "„Aktuell gibt es drei Linien von Impfstoffkandidaten.“"
                            }
                        ],
