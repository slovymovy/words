                        "examples": [
                            {
                                "example_id": "418ab7bb-9239-40c0-8596-7169a6b4cc89",
                                "sense_id": "b0fbd234-55b9-3ac8-bad0-8bf03e4eef6f",
                                "text": "Deze week schreef het Rijksinstituut voor Volksgezondheid en Milieu (RIVM) in een rapport dat als Nederland zijn klimaatdoelstelling wil halen, we minder dierlijke producten zouden moeten eten. Als voorbeeld van een maatregel om de vleesconsumptie terug te dringen suggereerde het RIVM vlees duurder te maken, via een extra belasting."
                            },
                            {
                                "example_id": "6e09c28e-978d-4b31-bdae-f196b0096741",
                                "sense_id": "b0fbd234-55b9-3ac8-bad0-8bf03e4eef6f",
                                "text": ",,Het aandeel van elektrische auto’s en waterstof voertuigen moet behoorlijk omhoog als we de klimaatdoelstelling willen halen en de opwarming van de aarde onder de 2 graden Celsius willen houden.”"
                            },
                            {
                                "example_id": "37fca4a1-88f4-4d26-bb33-010f7519eec7",
                                "sense_id": "b0fbd234-55b9-3ac8-bad0-8bf03e4eef6f",
                                "text": "Het uit de lucht halen van broeikasgassen is noodzakelijk om de klimaatdoelstelling van Parijs te halen. Alleen de uitstoot van CO2 verminderen door bijvoorbeeld meer windmolens te bouwen is niet genoeg, waarschuwen klimaatdeskundigen vandaag in een brief aan minister Wiebes van Economische Zaken en Klimaat."
                            }
                        ]
                    }
