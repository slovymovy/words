                                "target_lang_sense_clarification": "студенческий сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大学",
                                "target_lang_sense_clarification": "高等学府"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fa04a31-f73c-32dc-9f63-d88350fc7b55",
                    "sense_definition": "The edible part of a sea urchin, often eaten as sushi.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a piece of fresh <w>uni</w> sushi for us.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил нам суши со свежим <w>уни</w>.",
                                "zh": "主厨为我们准备了一贯新鲜的<w>海胆</w>寿司。"
                            }
                        },
                        {
                            "text": "I enjoy the creamy texture and sweet flavor of high-quality <w>uni</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нравится кремовая текстура и сладковатый вкус качественного <w>уни</w>.",
                                "zh": "我喜欢优质<w>海胆黄</w>细腻的口感和鲜甜的风味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sea urchin roe"
                    ],
                    "common_phrases": [
                        "fresh uni",
                        "uni sushi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобная часть (икра) морского ежа, используемая в японской кухне.",
                        "zh": "海胆的可食用部分（海胆黄或海胆生殖腺），常用于制作寿司"
                    },
                    "translations": {
