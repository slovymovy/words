                                    },
                                    {
                                        "sense_id": "b71d93c4-e8ab-396a-b04d-3ce4515b886d",
                                        "entry_id": "633dc219-9dcd-3ee4-a03b-a8ecf3cfd2c6",
                                        "glosses": [
                                            "Synonyme de malhonnêteté ; improbité."
                                        ],
                                        "tags": [
                                            "Rare en ce sens"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30e3bff2-6f26-4c23-bc95-99c0f37834f4",
                                                "sense_id": "b71d93c4-e8ab-396a-b04d-3ce4515b886d",
                                                "text": "Qu’il me soit reproché d’avoir placé ma confiance en de tels crapauds dont la déshonnêteté vient d’éclater ; qu’il me soit reproché ma faiblesse de n’en avoir point fait rouer une bonne douzaine, je souscrirai à la semonce […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fe482fa-4306-46b8-8d2a-6b94c78beacc",
                        "source_entry_id": "2b11cb8a-7867-38d4-9f67-f96b6f5418c4",
