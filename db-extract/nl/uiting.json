                "senses": [
                    {
                        "sense_id": "d7f75390-be9f-36e4-9841-aea9d581f134",
                        "entry_id": "d82af80d-5938-3787-92fa-f26349be6226",
                        "glosses": [
                            "dat wat men laat zien of merken, al of niet door woorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb9f150-6855-4464-a368-9f955631b3e3",
                                "sense_id": "d7f75390-be9f-36e4-9841-aea9d581f134",
                                "text": "Een uiting van woede was het gevolg."
                            },
                            {
                                "example_id": "222845f7-cf2c-4086-8468-9e2f58e11cca",
                                "sense_id": "d7f75390-be9f-36e4-9841-aea9d581f134",
                                "text": "Ik had juist het gevoel dat elkaar vrijheid gunnen een mooie uiting van liefde is en dat het gezond voor je relatie kan zijn om van tijd tot tijd alleen te zijn."
                            },
                            {
                                "example_id": "de61eb28-67a4-4565-a18a-c1dd32171ed2",
                                "sense_id": "d7f75390-be9f-36e4-9841-aea9d581f134",
                                "text": "In Europa krijgen we slechts voorbeelden van uitgesproken extreme Amerikanen te zien, alleen maar uitingen van contrasten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad40c0ed-d1c2-4e16-b8f3-b8f370dab082",
                        "source_entry_id": "d82af80d-5938-3787-92fa-f26349be6226",
                        "source_sense_id": "d7f75390-be9f-36e4-9841-aea9d581f134",
                        "target_lang_word": "expression",
