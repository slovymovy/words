                    ]
                },
                {
                    "sense_id": "e688021d-d860-3e8d-a12b-29ed2f5ed929",
                    "sense_definition": "Als Anerkennung oder Belohnung für eine erfolgreich erbrachte Leistung verliehenes Ehren- oder Leistungszeichen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "auszeichnung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der erfolgreichen Prüfung im Schwimmen erhielt das Kind sein erstes <w>Abzeichen</w>."
                        },
                        {
                            "text": "Für ihre herausragenden sportlichen Leistungen wurde ihr ein goldenes <w>Abzeichen</w> verliehen."
                        }
                    ],
                    "synonyms": [
                        "Auszeichnung",
                        "Medaille"
                    ],
                    "common_phrases": [
                        "ein Abzeichen erwerben",
                        "ein Abzeichen erhalten"
                    ]
                },
                {
                    "sense_id": "a14ee2de-4fff-364f-aae7-05b1c51a95b5",
                    "sense_definition": "Charakteristische, von der übrigen Fell- oder Hautfärbung abweichende Musterung am Körper eines Tieres.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das junge braune Pferd hatte ein auffälliges weißes <w>Abzeichen</w> auf der Stirn."
                        },
                        {
                            "text": "Anhand der hellen <w>Abzeichen</w> an den Beinen konnte der Züchter die Tiere leicht unterscheiden."
                        }
                    ],
                    "synonyms": [
                        "Erkennungsmerkmal",
                        "Kennzeichen"
                    ],
                    "common_phrases": [
                        "weiße Abzeichen"
                    ]
                }
            ]
        }
