                                "target_senses": [
                                    {
                                        "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                        "entry_id": "679ce93c-115f-357f-8686-8194234b1842",
                                        "glosses": [
                                            "Clipping of gummy shark."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aef5989-16cd-4a58-b313-62f614c8c68a",
                                                "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                                "text": "Over there [the UK], gummies are called smooth hound and a six kilo fish would stop the nation."
                                            },
                                            {
                                                "example_id": "fb5d31fa-42fa-46b8-83de-8e74177a760b",
                                                "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                                "text": "2007, Bill Classon, Fishing Guide to Victoria′s Coastline, Australian Fishing Network, page 60,\nWestern Port is a great location to find gummies. […] Gummy sharks are one of the favoured species in Western Port and for good reason: they put up a strong fight and feed of fresh flake is pretty hard to beat."
                                            },
                                            {
                                                "example_id": "0f07979d-752b-433f-891e-95d39e5a3e3f",
                                                "sense_id": "cf57d9dc-b6b6-3918-9900-5163c2428077",
                                                "text": "This area of vast mudflats is right at the top of the port is home to some of the best gummy shark fishing around.[…]As the water drops, the feeding gummies drop off the banks and wait in the channels for food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bb7d80f-daec-300d-adcf-595533c56018",
                                        "entry_id": "679ce93c-115f-357f-8686-8194234b1842",
                                        "glosses": [
                                            "A sheep that is losing or has lost its teeth."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gummy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
