                "senses": [
                    {
                        "sense_id": "85830c30-27aa-3939-af31-181146560f64",
                        "entry_id": "79aa7977-efa0-38f0-9e93-e5ebac5b496d",
                        "glosses": [
                            "Anregung für ein Spielgeschehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d0f2f6-f026-46da-81ec-05221403627d",
                                "sense_id": "85830c30-27aa-3939-af31-181146560f64",
                                "text": "„Besonders der Spielleiter hat einen entscheidenden Einfluss auf den Spielverlauf, weil er Spielvorschläge unterbreitet, Aktionen anregt, Spielprozesse strukturiert und der Gruppe auch bei der Auswertung der Spielerfahrungen hilft.“"
                            },
                            {
                                "example_id": "ec5016b2-8bde-413c-9eee-c698ea0edb84",
                                "sense_id": "85830c30-27aa-3939-af31-181146560f64",
                                "text": "„Spielvorschlag: Je zwei Kinder stehen sich gegenüber, fassen sich an den Händen und bewegen sich während des Singens nach den Vorgaben im Text.“"
                            },
                            {
                                "example_id": "c079fa4c-7bd2-4c3d-921a-2fb600551ec3",
                                "sense_id": "85830c30-27aa-3939-af31-181146560f64",
                                "text": "„Das Spektrum der Einzelbeiträge reicht von der Reflexion konfliktreicher Erzieher-Kind-Konstellationen über Anregungen zur friedenspädagogischen Elternarbeit im Kindergarten bis hin zu praktisch verwertbaren Informationen über Kinderbücher und kommentierten Spielvorschlägen zur Friedenserziehung.“"
                            },
                            {
                                "example_id": "e37934bb-0703-4766-a007-4f979bdc1baf",
                                "sense_id": "85830c30-27aa-3939-af31-181146560f64",
                                "text": "„Über 200 Seiten sind gefüllt mit Spielvorschlägen für Sechs- bis Vierzehnjährige, die schlicht als solche nehmen mag, wem Crattys spieldidaktischer Ansatz nicht paßt.“"
                            },
                            {
                                "example_id": "6c68f882-3071-4de9-8a48-5a8e657a023e",
                                "sense_id": "85830c30-27aa-3939-af31-181146560f64",
                                "text": "„Die Studenten sind nicht ganz unvorbereitet auf die Kinder losgelassen worden; sie haben die Richtlinien ihrer Zentrale, und sie sind in einem Kursus unterwiesen worden: Gruppenpädagogik, Spielvorschläge, Erste Hilfe, Erziehungsberatung, psychologische Probleme bis hin zum Bettnässen – alles in drei Tagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
