                        "examples": [
                            {
                                "example_id": "8a2e318b-b2c2-41b2-a531-898328162024",
                                "sense_id": "bd15845a-3660-3fc0-8f70-0d574c5f3fc0",
                                "text": "M. Tresca présente de la part de M. Farcot la description d’un système mécanique très ingénieux : le servo-moteur qui sert d’intermédiaire entre la main de l’ouvrier et l’outil, et permettra de manier avec la même facilité des organes puissants ou des organes légers."
                            },
                            {
                                "example_id": "a6b4a03b-fc5c-453e-8af5-dfce693eeae7",
                                "sense_id": "bd15845a-3660-3fc0-8f70-0d574c5f3fc0",
                                "text": "Prix Plumey : décerné à M. Joseph Farcot, pour son intéressant appareil le servo-moteur ou moteur asservi… c’est sur le Château-Renaud qu’a été faite la première application du servo-moteur en 1869."
                            }
                        ]
                    }
