                        "glosses": [
                            "Being complacent; a feeling of contentment or satisfaction; complacency."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c34a8ea0-697a-46bc-9438-0ef6ade76af8",
                                "sense_id": "7eba002c-13a2-37dd-8f70-36a366444ab8",
                                "text": "[T]he inward Complacence we find in acting reaſonably and vertuouſly, and the Diſquiet we feel from vicious Choices and Purſuits, is protracted beyond the Acts themſelves from whence it aroſe, and renewed often upon our Souls, by diſtant Reflections; […]"
                            }
