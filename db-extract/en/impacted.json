                        "glosses": [
                            "Of a tooth, subject to dental impaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c094801f-4a35-46d3-a99f-36f6dc691e4f",
                                "sense_id": "49c8d7e2-1f8e-3572-9f5b-4689806259bf",
                                "text": "Being the last teeth to erupt in the oral cavity, many wisdom teeth are impacted."
                            }
