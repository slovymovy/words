        "fr-extract.jsonl": [
            {
                "entry_id": "9cf2452d-2ead-33ce-8f46-41c8d6eae94d",
                "word": "récrimination",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7afb37d-0641-43c3-994f-0bf857bb95e3",
                        "entry_id": "9cf2452d-2ead-33ce-8f46-41c8d6eae94d",
                        "tags": [
                            "plural"
                        ],
                        "form": "récriminations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b31a6fd-5cd4-3cde-b758-dc80fa2164c6",
                        "entry_id": "9cf2452d-2ead-33ce-8f46-41c8d6eae94d",
                        "glosses": [
                            "Accusation qui tend à en repousser une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a7b058-7984-42d9-a132-b47899c39e61",
                                "sense_id": "5b31a6fd-5cd4-3cde-b758-dc80fa2164c6",
                                "text": "Tout ce qu’il dit contre moi n’est qu’une récrimination."
                            },
                            {
                                "example_id": "c3fdce7b-e76d-429c-a547-8a869d15c014",
                                "sense_id": "5b31a6fd-5cd4-3cde-b758-dc80fa2164c6",
                                "text": "Vous ne dites cela que par récrimination."
                            },
                            {
                                "example_id": "5a30fedc-9732-44bf-85e0-2958c4c54152",
                                "sense_id": "5b31a6fd-5cd4-3cde-b758-dc80fa2164c6",
                                "text": "Ce ne sont là que des récriminations."
                            },
                            {
                                "example_id": "c702e786-7acb-4020-a3cb-12399886eac3",
                                "sense_id": "5b31a6fd-5cd4-3cde-b758-dc80fa2164c6",
                                "text": "User de récriminations."
                            }
                        ]
                    },
                    {
                        "sense_id": "592f8a04-b5e4-3d5f-98c9-1e3adfd782fe",
                        "entry_id": "9cf2452d-2ead-33ce-8f46-41c8d6eae94d",
                        "glosses": [
                            "Reproche ; réclamation désobligeante ; critique amère."
                        ],
                        "tags": [],
                        "note": "Ce terme est généralement utilisé au pluriel",
                        "examples": [
                            {
                                "example_id": "ee503ece-ba92-4c91-8bcd-2cf0fa2b1218",
                                "sense_id": "592f8a04-b5e4-3d5f-98c9-1e3adfd782fe",
                                "text": "Les récriminations ne commencent à se produire qu'après le 9 thermidor, c'est-à-dire lorsque la Révolution est en déclin."
                            },
                            {
                                "example_id": "7578b560-22f9-4580-bf27-023674843b13",
                                "sense_id": "592f8a04-b5e4-3d5f-98c9-1e3adfd782fe",
                                "text": "Tous ces braves gens s'entendaient parfaitement entre eux, et cette existence commune, dans un si étroit espace, n'entraîna ni gêne ni récrimination."
                            },
                            {
                                "example_id": "29f0da75-0c95-439c-854d-c9dbd12d103a",
                                "sense_id": "592f8a04-b5e4-3d5f-98c9-1e3adfd782fe",
                                "text": "Il crut que leurs récriminations constantes contre leur sort étaient le résultat de la conscience de leur misérable situation..."
                            },
                            {
                                "example_id": "fc84084a-2b1d-4864-8215-9c950303919d",
                                "sense_id": "592f8a04-b5e4-3d5f-98c9-1e3adfd782fe",
                                "text": "Quand le cycliste revenait, pédestrement, haletant et fourbu, Grubb n’écoutait aucune récrimination."
                            },
                            {
                                "example_id": "64a1e53c-9b18-4e64-a509-82db154d1915",
                                "sense_id": "592f8a04-b5e4-3d5f-98c9-1e3adfd782fe",
                                "text": "Mais les succès de ces convertisseurs bénévoles devaient être considérables, à en juger par les récriminations qu'il souleva de la part des auteurs des Évangiles et par les flèches que leur décochent les satiriques latins, …."
                            },
                            {
                                "example_id": "a3aa1438-3539-46e2-8f0b-76ab2b8ed045",
                                "sense_id": "592f8a04-b5e4-3d5f-98c9-1e3adfd782fe",
                                "text": "Sachez que j’accorde toujours une grande attention à vos propos et que je vous rejoins parfois dans vos récriminations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29d11c57-c6df-48a7-9537-d9ba26d16354",
