            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52f8a381-4a48-3562-8abc-b35a7fed0c49",
                    "sense_definition": "etwas in etwas hineintun, hineinschieben oder hineinpressen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>steckte</w> den Schlüssel schnell ins Schloss und öffnete die Tür."
                        },
                        {
                            "text": "Vor Kälte <w>steckt</w> sie ihre Hände tief in die warmen Manteltaschen."
                        }
                    ],
                    "common_phrases": [
                        "die Hände in die Taschen stecken",
                        "den Schlüssel ins Schloss stecken"
                    ]
                },
                {
                    "sense_id": "c2ac7c5e-915d-3326-af72-b6c7949d92d0",
                    "sense_definition": "in etwas festsitzen oder sich fest im Inneren von etwas befinden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir <w>stecken</w> seit über einer Stunde auf der Autobahn im Stau fest."
                        },
                        {
                            "text": "Der alte Schlüssel <w>steckt</w> noch immer von außen an der Haustür."
                        }
                    ],
                    "common_phrases": [
                        "im Stau stecken",
                        "im Schlamm stecken"
                    ]
                },
                {
                    "sense_id": "635bd541-712b-32ad-b71c-4cb2687b835f",
                    "sense_definition": "sich an einem unbekannten oder schwer auffindbaren Ort befinden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aufenthalt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wo <w>steckst</w> du denn so lange, wir warten schon seit einer halben Stunde?"
                        },
                        {
                            "text": "Niemand weiß genau, wo der Chef heute den ganzen Nachmittag <w>steckt</w>."
                        }
                    ],
                    "common_phrases": [
                        "wo steckst du"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "häufig in Suchfragen verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "c6dfd6ce-f3db-3afa-a637-1b9c62200b3a",
                    "sense_definition": "die heimliche Ursache von etwas sein oder der Urheber hinter etwas sein",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ursache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Polizei vermutet, dass organisierte Kriminalität hinter dem Raubüberfall <w>steckt</w>."
                        },
                        {
                            "text": "Ich frage mich wirklich, welche böse Absicht eigentlich hinter diesem Plan <w>steckt</w>."
                        }
                    ],
                    "common_phrases": [
                        "hinter etwas stecken"
                    ]
                },
                {
                    "sense_id": "d0143787-148b-3e66-9cfb-b44e165541cc",
                    "sense_definition": "jemandem eine Information heimlich oder vertraulich zuspielen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verraten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein Kollege hat mir gestern <w>gesteckt</w>, dass die Firma bald verkauft werden soll."
                        },
                        {
                            "text": "Bitte verrate niemandem mein Geheimnis, ich habe es dir nur im Vertrauen <w>gesteckt</w>."
                        }
                    ],
                    "synonyms": [
                        "mitteilen",
                        "zustecken"
                    ],
                    "common_phrases": [
                        "jemandem etwas stecken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich für heimlich mitteilen"
                        }
                    ]
                }
            ]
        },
