                    {
                        "translation_id": "a60f0938-1560-4676-92b1-2c584b435ed8",
                        "source_entry_id": "e5a72e57-72c5-3a9c-9157-536906722343",
                        "source_sense_id": "c9ff3afb-10d7-35c9-8100-33a50c4d256a",
