                "senses": [
                    {
                        "sense_id": "176ad58a-71f1-302c-978f-5e1aea8aa29f",
                        "entry_id": "4fb70077-84d0-3ed9-aa5d-7b2e416cc9b6",
                        "glosses": [
                            "Fachgebiet, das sich mit der äußeren und inneren Gestaltung (Design) von Kraftfahrzeugen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4226dc93-3e58-475d-8b24-faa020c254d6",
                                "sense_id": "176ad58a-71f1-302c-978f-5e1aea8aa29f",
                                "text": "„Neben dem Autodesign zum Einstieg sind es Elemente des kreativen Schreibens, Fragen der Physik oder der Geografie.“"
                            },
                            {
                                "example_id": "907b71cc-d442-48dc-80b3-e97fcbef73d9",
                                "sense_id": "176ad58a-71f1-302c-978f-5e1aea8aa29f",
                                "text": "„Zu den 1920er Jahren hin konzentrierte sich die lokale Industrie auf innovative und experimentelle Automobilherstellung, Autozubehör, Autodesign und die Filmindustrie.“"
                            },
                            {
                                "example_id": "b00c53ca-6173-43ff-be8f-fe5485dd8934",
                                "sense_id": "176ad58a-71f1-302c-978f-5e1aea8aa29f",
                                "text": "„Aufgrund des Konkurrenzdrucks in der Branche sei Autodesign ein ‚sensibler Indikator für gesellschaftliche Veränderungen‘.“"
                            },
                            {
                                "example_id": "603ba418-2afc-4663-97be-2896a673f25a",
                                "sense_id": "176ad58a-71f1-302c-978f-5e1aea8aa29f",
                                "text": "„Auch hier fängst du mit vielen hellen Linien entwickelnd an zu zeichnen und betonst dann die Linie, die für dein Autodesign richtig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
