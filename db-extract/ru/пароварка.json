                                    },
                                    {
                                        "sense_id": "85f20e58-8269-31fb-9c4c-6956960f92c1",
                                        "entry_id": "21eb2e3e-f172-3a1b-8f69-891560e255a1",
                                        "glosses": [
                                            "A drinking session."
                                        ],
                                        "tags": [
