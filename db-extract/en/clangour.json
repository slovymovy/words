                                    {
                                        "sense_id": "19142418-90a5-3f5a-aaf1-aa6d87a6264c",
                                        "entry_id": "c0c878cc-ca1a-3c2c-be8e-82b4357317f5",
                                        "glosses": [
                                            "langdurig luid naklinken"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c49c778-744c-416a-be5f-cf27bc197e94",
                                                "sense_id": "19142418-90a5-3f5a-aaf1-aa6d87a6264c",
                                                "text": "Het geluid van een alpenhoorn galmde door het dal."
                                            },
                                            {
                                                "example_id": "e2ff58e5-5bc0-41cb-85f8-93727ab0b075",
                                                "sense_id": "19142418-90a5-3f5a-aaf1-aa6d87a6264c",
                                                "text": "Woorden schieten nu zelfs tekort. Een ijselijke kreet galmt over de weide op de top van La Planche des Belles Filles. ‘Aaaargh!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6576164-00c6-3cb5-8793-1f29e1d4579d",
                                        "entry_id": "c0c878cc-ca1a-3c2c-be8e-82b4357317f5",
                                        "glosses": [
                                            "op overdreven trage wijze iets zingen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "065af712-480d-42be-a9a2-c0d2fedcd54b",
                                                "sense_id": "f6576164-00c6-3cb5-8793-1f29e1d4579d",
                                                "text": "De behoudende gemeente galmde luidkeels een psalm in de oude berijming."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
