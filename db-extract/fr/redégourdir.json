                ],
                "senses": [
                    {
                        "sense_id": "3b49cc34-8d82-389f-b30a-b1aea20fa78b",
                        "entry_id": "1ccf7d36-5c33-3d93-94bc-8587498d2c7e",
                        "glosses": [
                            "Dégourdir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad89d3c-4226-47e0-a5a5-b78f619866f4",
                                "sense_id": "3b49cc34-8d82-389f-b30a-b1aea20fa78b",
                                "text": "C’est pour me redégourdir les mollets dans les vignes bourguignonnes et retrouver le goût de la glaise !!"
                            },
                            {
                                "example_id": "9ca9cdc8-8576-48f5-a25d-83d82f898204",
                                "sense_id": "3b49cc34-8d82-389f-b30a-b1aea20fa78b",
                                "text": "J’en suis plutôt content car, après trois mois, il est temps de se redégourdir les jambes, de revoir du monde, de connaître la raison de son réveil."
                            }
                        ]
                    },
                    {
                        "sense_id": "808e38b1-dffd-3493-8166-d0326f6e6373",
                        "entry_id": "1ccf7d36-5c33-3d93-94bc-8587498d2c7e",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e911fa89-f7cc-456a-9344-eedf5e791679",
                                "sense_id": "808e38b1-dffd-3493-8166-d0326f6e6373",
                                "text": "[…] sur dégourdi, on sera obligé de redégourdir la pièce, c’est-à-dire de la porter une seconde […]"
                            }
                        ]
                    }
