                        "sense_id": "f4288682-f8f2-335c-803d-bf4020455c31",
                        "entry_id": "0e5b5678-670b-3566-b86b-ed9088f1e424",
                        "glosses": [
                            "auf die Gotik zurückgreifender historistischer Kunst- und Architekturstil des 19. Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e76dc76d-058f-4f9d-8367-22661f3dce02",
                                "sense_id": "f4288682-f8f2-335c-803d-bf4020455c31",
                                "text": "„Vom Stil her war sie, soweit das Fernglas erkennen ließ, in jener frühesten experimentellen Form der Neugotik gehalten, die der pompösen Upjohn-Periode voranging und einige der Formen und Proportionen des georgianischen Zeitalters beibehielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
