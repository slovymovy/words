{
    "word_family": [
        "stunt"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0fd61d81-01f3-30ce-aa51-6aa60c39bd26",
                    "sense_definition": "Prevented from growing or developing fully and hence shorter or smaller than usual.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A poor diet often leads to <w>stunted</w> growth in young children.",
                            "target_lang_translations": {
                                "ru": "Плохое питание часто приводит к <w>задержке</w> роста у маленьких детей."
                            }
                        },
                        {
                            "text": "The rocky soil resulted in <w>stunted</w> trees that never reached their full height.",
                            "target_lang_translations": {
                                "ru": "Каменистая почва привела к тому, что деревья остались <w>низкорослыми</w> и не достигли своей полной высоты."
                            }
                        }
                    ],
                    "synonyms": [
                        "undersized",
                        "undeveloped"
                    ],
                    "antonyms": [
                        "thriving",
                        "developed"
                    ],
                    "common_phrases": [
                        "stunted growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задержанный в росте или развитии, не достигший нормальных размеров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задержанный в росте",
                                "target_lang_sense_clarification": "о развитии организма или растения"
                            },
                            {
                                "target_lang_word": "низкорослый",
                                "target_lang_sense_clarification": "о растениях или деревьях, не достигших высоты"
                            },
                            {
                                "target_lang_word": "недоразвитый",
                                "target_lang_sense_clarification": "общий термин для неполного развития"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a429786b-1435-33eb-941b-b1f7f04d964a",
                    "sense_definition": "Of a person: shorter than usual for one's age.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child appeared <w>stunted</w> compared to his classmates due to a chronic illness.",
                            "target_lang_translations": {
                                "ru": "Ребенок казался <w>отстающим</w> в росте по сравнению со своими одноклассниками из-за хронического заболевания."
                            }
                        },
                        {
                            "text": "Doctors monitored the <w>stunted</w> boy to ensure he received proper nutrition.",
                            "target_lang_translations": {
                                "ru": "Врачи наблюдали за <w>отстающим</w> в росте мальчиком, чтобы убедиться, что он получает полноценное питание."
                            }
                        }
                    ],
                    "synonyms": [
                        "short"
                    ],
                    "target_lang_definitions": {
                        "ru": "О человеке: имеющий рост ниже среднего для своего возраста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстающий в росте",
                                "target_lang_sense_clarification": "о ребенке, чей рост ниже нормы"
                            },
                            {
                                "target_lang_word": "низкорослый",
                                "target_lang_sense_clarification": "о человеке маленького роста"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7997e67e-c9fb-37b3-b3ed-8d3edb0d5a4a",
                    "sense_definition": "Simple past and past participle of <w>stunt</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lack of sunlight <w>stunted</w> the plant's development over the winter months.",
                            "target_lang_translations": {
                                "ru": "Недостаток солнечного света <w>замедлил</w> развитие растения в зимние месяцы."
                            }
                        },
                        {
                            "text": "The harsh climate <w>stunted</w> the crops and led to a poor harvest.",
                            "target_lang_translations": {
                                "ru": "Суровый климат <w>задержал</w> рост сельскохозяйственных культур и привел к плохому урожаю."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb stunt."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие глагола 'stunt' (замедлять рост, препятствовать развитию)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замедлил",
                                "target_lang_sense_clarification": "прошедшее время глагола"
                            },
                            {
                                "target_lang_word": "задержал",
                                "target_lang_sense_clarification": "о препятствовании развитию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}