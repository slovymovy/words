                                            "Someone who sends."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efe54851-17e7-41e8-97fa-9dc759a3d9c6",
                                                "sense_id": "19476fb7-4c61-3acd-8298-5208333e8eaa",
                                                "text": "The package was addressed to someone we didn't know, so we returned it to the sender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5409133f-3328-345e-a3c3-af98d7aeced6",
