                                "example_id": "8152ca0a-4a5e-4c4d-9cb1-c6452b2d427f",
                                "sense_id": "27ce67b2-b2ab-3317-8070-8595dc7cfc94",
                                "text": "Anyway, there are only a few hundred clients in the world who regularly buy couture, including Middle Eastern royalty and American businesswomen."
                            }
                        ]
