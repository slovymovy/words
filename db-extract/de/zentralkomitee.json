                ],
                "senses": [
                    {
                        "sense_id": "6b31307e-56c4-3f89-99a6-d7fe1af464fa",
                        "entry_id": "f93e854d-bdc3-38cb-bb0a-f91de00d689a",
                        "glosses": [
                            "oberstes Gremium innerhalb einer kommunistischen Partei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89abf29-6cb7-474e-ad1d-80490446abbb",
                                "sense_id": "6b31307e-56c4-3f89-99a6-d7fe1af464fa",
                                "text": "„Eine Stunde nach der Entdeckung des geöffneten Grabes wurde das Programm von Radio Samarkand unterbrochen, und als es wenige Minuten später wieder auf Sendung ging, verlas der Radiosprecher Propagandamaterial, das vom Zentralkomitee der Kommunistischen Partei Usbekistans für solche prekären Momente bereitgehalten wurde.“"
                            },
                            {
                                "example_id": "e5e5e5cb-8ca4-438a-99ee-11b86a8c6628",
                                "sense_id": "6b31307e-56c4-3f89-99a6-d7fe1af464fa",
                                "text": "„›Bei A. T. Masondo handelt es sich um Ambrose Thenjiwe Masondo. Im Exil bis dreiundneunzig, ehemaliges Mitglied des Zentralkomitees der Kommunistischen Partei, Schatzmeister der National Union of Mine Workers und Mitglied des Nationalkongresses von COSATU.‹“"
                            },
                            {
                                "example_id": "a7221604-9a07-4978-b79d-3c7ca10f8c62",
                                "sense_id": "6b31307e-56c4-3f89-99a6-d7fe1af464fa",
                                "text": "„Ende Mai 1945, wenige Wochen nach der deutschen Kapitulation, entschied das Zentralkomitee der Kommunistischen Partei Polens, alle Deutschen aus den nunmehr Polen zugerechneten Gebieten zu entfernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
