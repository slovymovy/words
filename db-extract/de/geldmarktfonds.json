                "senses": [
                    {
                        "sense_id": "1fa88d1e-8b08-3698-be01-b3adc3991bbe",
                        "entry_id": "1f7a2122-23c6-311a-8b44-a4fe3854f146",
                        "glosses": [
                            "Investmentfonds, der überwiegend oder gänzlich in Termingelder, Schuldscheindarlehen und Anleihen mit geringer Restlaufzeit investiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52363ed4-4fb5-4b79-b43d-a865cd6ef21d",
                                "sense_id": "1fa88d1e-8b08-3698-be01-b3adc3991bbe",
                                "text": "„Auch in den USA hielt sich Paypal mit Bankdienstleistungen bisher zurück. Einzige Ausnahme war die Möglichkeit, überschüssige Liquidität auf dem Paypal-Konto in Geldmarktfonds zu legen.“"
                            },
                            {
                                "example_id": "05faa446-9676-4fad-b4ae-fe0bdcfda4c6",
                                "sense_id": "1fa88d1e-8b08-3698-be01-b3adc3991bbe",
                                "text": "„Geldmarktfonds sollen eigentlich ein sicherer Parkplatz für Liquidität sein. Doch auf der Suche nach dem Extrakick Rendite gingen einige Anbieter zu weit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
