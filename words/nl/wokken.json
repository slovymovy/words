                    "frequency": "Middle",
                    "semantic_group_id": "keukengerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vrijwilligers scheppen in grote <w>wokken</w> sardientjes om, bedoeld voor een groep vluchtelingen die de afgelopen dagen naar Thailand is gekomen.",
                            "target_lang_translations": {
                                "en": "Volunteers are turning sardines in large <w>woks</w>, intended for a group of refugees who have arrived in Thailand in the past few days."
                            }
                        },
                        {
                            "text": "De chef-kok gebruikt verschillende <w>wokken</w> om de maaltijden snel te bereiden.",
