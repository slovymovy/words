                        "examples": [
                            {
                                "example_id": "5c3970a0-7bbd-4ede-ac2b-4ffc4e4dfc14",
                                "sense_id": "f9e7662c-4208-37b7-ae50-3a26b36b6649",
                                "text": "„Den angestrebten Privatisierungserlös wollte der Beamte nicht benennen.“"
                            },
