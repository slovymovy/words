                        "source_sense_id": "a3892a65-b674-302b-b398-ffc1cab40f0b",
                        "source_sense_description": "schwäbisch, vornehmlich in Baden-Württemberg: Geizhals",
                        "target_lang_word": "penny-pincher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penny-pincher",
