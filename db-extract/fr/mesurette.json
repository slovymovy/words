                    {
                        "translation_id": "bca58e47-b9e8-4e35-ac17-951094d26619",
                        "source_entry_id": "8081c911-0375-3aab-8793-42f5ef658b5e",
                        "source_sense_id": "0f3dc23b-5eab-396f-a606-8107078e857a",
                        "source_sense_description": "umgangssprachlich, Politik, Wirtschaft: unzureichende Maßnahme",
                        "target_lang_word": "unzureichend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzureichend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0729845a-6302-3c8e-a5c0-ae17a67d3301",
                                        "entry_id": "8c1fde07-5c35-3794-80b0-413d4fb8c11b",
                                        "glosses": [
                                            "nicht ausreichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb978e4-6a5a-481f-a5e9-9b1fc8f16db0",
                                                "sense_id": "0729845a-6302-3c8e-a5c0-ae17a67d3301",
                                                "text": "[Schlagzeile:] „UN-Bericht: \"Eklatant unzureichende\" Klimapolitik“"
                                            },
                                            {
                                                "example_id": "8f655018-21dc-4967-b501-5c348d45e8e8",
                                                "sense_id": "0729845a-6302-3c8e-a5c0-ae17a67d3301",
                                                "text": "Der Bau wurde wegen unzureichender Finanzmittel eingestellt."
                                            },
                                            {
                                                "example_id": "52510f6c-0836-47ae-a238-09f9d62f832a",
                                                "sense_id": "0729845a-6302-3c8e-a5c0-ae17a67d3301",
                                                "text": "Was der Schüler in seinem Referat geboten hat, ist für ein »gut« unzureichend."
                                            },
                                            {
                                                "example_id": "2d9aa6d7-8f72-44a7-bdea-e12f795eeca6",
                                                "sense_id": "0729845a-6302-3c8e-a5c0-ae17a67d3301",
                                                "text": "[Coronapandemie:] Die Maßnahmen der Landesregierungen von Bayern bis Schleswig-Holstein zum \"Lockdown light\" im November waren schlicht unzureichend, wie man an den steigenden Todeszahlen sehen kann."
                                            },
                                            {
                                                "example_id": "69840069-37db-4073-96cd-5b915f3fd757",
                                                "sense_id": "0729845a-6302-3c8e-a5c0-ae17a67d3301",
                                                "text": "„Magnitski war 2009 während der Untersuchungshaft in einem russischen Gefängnis gestorben, nachdem er misshandelt und unzureichend medizinisch versorgt worden war.“"
                                            },
                                            {
                                                "example_id": "d2a8b967-8be7-420f-93fb-87131e652339",
                                                "sense_id": "0729845a-6302-3c8e-a5c0-ae17a67d3301",
                                                "text": "„Die südlichen EU-Länder Italien, Spanien, Griechenland und Malta halten die Vorschläge aus Brüssel zur Asylreform für unzureichend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ff598f6-bcba-4b24-9b2e-16f7085fb180",
                        "source_entry_id": "8081c911-0375-3aab-8793-42f5ef658b5e",
                        "source_sense_id": "0f3dc23b-5eab-396f-a606-8107078e857a",
                        "source_sense_description": "umgangssprachlich, Politik, Wirtschaft: unzureichende Maßnahme",
                        "target_lang_word": "Maßnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maßnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                        "entry_id": "14ecd827-d911-3b15-9070-66285ce8de94",
                                        "glosses": [
                                            "zweckbestimmte Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df684163-ee75-4c1c-837f-0b24a1e28505",
                                                "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                                "text": "Alle getroffenen Maßnahmen haben nicht ausgereicht, um das Unglück zu verhindern."
                                            },
                                            {
                                                "example_id": "35cbd231-74ee-437b-9a72-18931d40a646",
                                                "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                                "text": "Welche Maßnahmen treffen Sie, um die Kostenabweichung zu minimieren?"
                                            },
                                            {
                                                "example_id": "ec448582-eac7-46f2-a969-003600864f4f",
                                                "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                                "text": "Haben Sie Maßnahmen angedacht mit denen das Projekt doch noch fristgerecht fertiggestellt werden kann."
                                            },
                                            {
                                                "example_id": "083f7566-6cda-4928-81f9-a7f0db379ebb",
                                                "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                                "text": "Welche Maßnahmen wollen Sie ergreifen, wenn es weiter schneit?"
                                            },
                                            {
                                                "example_id": "4ebacf74-40b5-4130-9442-4fe58bda9dba",
                                                "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                                "text": "„Um die Klimaziele einzuhalten, müssten“ […] „90 Prozent der Autos in den USA bis 2050 elektrisch betrieben werden. Das wäre nur mit drastischen Maßnahmen möglich.“"
                                            },
                                            {
                                                "example_id": "6d6a10be-93dc-455d-a31a-fd68b4d8db4a",
                                                "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                                "text": "„Wird dem Arbeitslosen ein Arbeitsplatz oder eine Maßnahme zur Wiedereingliederung in das Arbeitsleben angeboten, so ist häufig zweifelhaft, ob die Beschäftigung oder Weiterbildungsmaßnahme dem Arbeitslosen aus gesundheitlichen Gründen zumutbar ist.“"
                                            },
                                            {
                                                "example_id": "38e1abee-d274-4c63-ba4c-6bb4340a6a60",
                                                "sense_id": "2d352bd9-150e-3e68-b510-90c38b33803c",
                                                "text": "„Und selbst diejenigen, die in eine Maßnahme der Arbeitsagentur oder in eine Vollzeitklasse der beruflichen Schulen gehen, selbst die landen dann hinterher nicht alle in Ausbildung, sondern drehen eine weitere Warteschleife.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
