                "senses": [
                    {
                        "sense_id": "7536ec16-59ee-3dd2-bd0f-b407bd050626",
                        "entry_id": "da7b524a-dc28-3ca5-a254-f5306b64d3fd",
                        "glosses": [
                            "Mangel an Fachkräften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b20fac7-0767-450d-b96c-c3b3cd27e9a2",
                                "sense_id": "7536ec16-59ee-3dd2-bd0f-b407bd050626",
                                "text": "Ich bin der Meinung, dass der Fachkräftemangel seine Ursache im Spruch: \"Der Klügere gibt nach!\" und den absurden Anforderungen, die die Unternehmen an die Fachkraft haben, hat."
                            },
                            {
                                "example_id": "1556138e-9c56-44c4-99e7-d6b1bd9109e7",
                                "sense_id": "7536ec16-59ee-3dd2-bd0f-b407bd050626",
                                "text": "Die Konjunktur läuft gut, doch Fachkräftemangel wird immer stärker zur Beschäftigungs- und Wachstumsbremse am Standort Deutschland."
                            },
                            {
                                "example_id": "e3b86b9a-2059-4017-a05f-97de3c68f217",
                                "sense_id": "7536ec16-59ee-3dd2-bd0f-b407bd050626",
                                "text": "„Es ist scheinbar das letzte Aufbäumen einer Elite, die nicht anerkennen will, dass Gleichberechtigung nicht das huldvolle Gewähren einzelner Beförderungen, sondern in Zeiten von Fachkräftemangel und hoch qualifizierten Frauen ökonomisch geboten ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
