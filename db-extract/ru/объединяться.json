                                                "sense_id": "5f03345b-ea3e-300d-b7ca-036b71a8546b",
                                                "text": "The two companies merged."
                                            },
                                            {
                                                "example_id": "51970dc9-2934-4f00-acd2-61205b7dd2ca",
                                                "sense_id": "5f03345b-ea3e-300d-b7ca-036b71a8546b",
                                                "text": "to merge all natural and all social sentiment in inordinate vanity"
                                            },
                                            {
                                                "example_id": "4259a97f-1b28-4cfe-aeef-d4c9dee52450",
                                                "sense_id": "5f03345b-ea3e-300d-b7ca-036b71a8546b",
                                                "text": "Whig and Tory were merged and swallowed up in the transcendent duties of patriots—Englishmen—lovers of liberty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40fb56ef-e631-332a-9e7f-f2ffda51b1fd",
                                        "entry_id": "552ed103-0230-35b6-9f60-0ce68f1c8651",
                                        "glosses": [
                                            "To blend gradually into something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06ff4ae5-7558-44ea-8a72-fe5132a9df1c",
                                                "sense_id": "40fb56ef-e631-332a-9e7f-f2ffda51b1fd",
                                                "text": "The lanes of traffic merged."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "merge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36834326-7b87-32e1-8837-c00870058b73",
                                        "entry_id": "1d583048-0d58-3e9b-871a-4b5987a5f529",
                                        "glosses": [
                                            "The joining together of multiple sources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25488da0-fe0b-46d1-a115-bd5316225a48",
                                                "sense_id": "36834326-7b87-32e1-8837-c00870058b73",
                                                "text": "There are often accidents at that traffic merge."
                                            },
                                            {
                                                "example_id": "5c038b65-f00d-4083-8494-221517b47c17",
                                                "sense_id": "36834326-7b87-32e1-8837-c00870058b73",
