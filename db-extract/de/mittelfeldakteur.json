                "senses": [
                    {
                        "sense_id": "5da259e8-6650-395c-b03a-1aeed3963885",
                        "entry_id": "7698ee1c-d3c4-3cd3-aa65-bbad6924e9b8",
                        "glosses": [
                            "Spieler mit einer Position zwischen Abwehr und Sturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d6712ed-fc2a-48d7-a949-fbd8873de1aa",
                                "sense_id": "5da259e8-6650-395c-b03a-1aeed3963885",
                                "text": "„Der 1,74 Meter große Mittelfeldakteur Cristóforo ist der jüngere Bruder des Fußballtorhüters Federico Cristóforo.“"
                            },
                            {
                                "example_id": "46a0a423-18fa-47d8-97da-33d2d5194d33",
                                "sense_id": "5da259e8-6650-395c-b03a-1aeed3963885",
                                "text": "„Dort wurde der Mittelfeldakteur Stammkraft.“"
                            },
                            {
                                "example_id": "ef7f7642-666f-4480-80e3-cbbda15abcdf",
                                "sense_id": "5da259e8-6650-395c-b03a-1aeed3963885",
                                "text": "„Der 23-jährige Stürmer des Schweizer Erstligisten FC Thun, Sandro Iaschwili, absolvierte wie der 31-jährige Mittelfeldakteur Ionut Stancu (Rapid Bukarest) ein Probetraining.“"
                            },
                            {
                                "example_id": "59114007-82c0-4a49-981d-67b461471aa8",
                                "sense_id": "5da259e8-6650-395c-b03a-1aeed3963885",
                                "text": "„Den Mittelfeldakteur plagen Knieprobleme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ca49cb9-b99a-43a8-ac60-0b98f177ab8d",
                        "source_entry_id": "7698ee1c-d3c4-3cd3-aa65-bbad6924e9b8",
                        "source_sense_id": "5da259e8-6650-395c-b03a-1aeed3963885",
                        "source_sense_description": "Sport, Fußball: Spieler mit einer Position zwischen Abwehr und Sturm",
                        "target_lang_word": "midfielder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
