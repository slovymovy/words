                "entry_id": "d9655bdc-c843-373f-a249-a776d2461bf4",
                "word": "heartrending",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "765f4e89-e8b3-460d-8b13-8e9c03aaa6da",
                        "entry_id": "d9655bdc-c843-373f-a249-a776d2461bf4",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more heartrending"
                    },
                    {
                        "form_id": "4bb694f1-1b4c-4730-9774-2997ac2855a7",
                        "entry_id": "d9655bdc-c843-373f-a249-a776d2461bf4",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most heartrending"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4eda4cd8-6ebb-31ab-aac4-fb11c98587d3",
                        "entry_id": "d9655bdc-c843-373f-a249-a776d2461bf4",
                        "glosses": [
                            "That causes great grief, anguish or distress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7172eb5f-1e2b-4aa4-8032-ab8eb6881dd1",
                                "sense_id": "4eda4cd8-6ebb-31ab-aac4-fb11c98587d3",
                                "text": "[T]he old man, who appeared to be an ardent fisherman, told me of the large trout he caught in the neighbourhood thirty years ago, when he came here from Gudbrandsdale, and made the most heartrending complaints of the decrease of fish and increase of saw-dust, just as Sir Humphry Davy makes in his Salmonia."
                            },
                            {
                                "example_id": "b750ced3-1e2d-49ee-b472-8f39e3eea04d",
                                "sense_id": "4eda4cd8-6ebb-31ab-aac4-fb11c98587d3",
                                "text": "It wavered an instant—then there was a heartrending crash—and the canary-coloured cart, their pride and their joy, lay on its side in the ditch, an irredeemable wreck."
                            }
                        ]
                    },
                    {
                        "sense_id": "dba556c4-1344-3eb0-9bfb-89bc9712f6ea",
                        "entry_id": "d9655bdc-c843-373f-a249-a776d2461bf4",
                        "glosses": [
                            "That elicits deep sympathy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d62c5073-d415-4426-aeb6-7b8ebc2dda62",
                                "sense_id": "dba556c4-1344-3eb0-9bfb-89bc9712f6ea",
                                "text": "I am suddenly assaulted by the most heartrending puppy-dog eyes I've ever seen as Emi pouts."
                            },
                            {
                                "example_id": "52b3b134-9fbd-411a-a499-1e8ffc40043d",
                                "sense_id": "dba556c4-1344-3eb0-9bfb-89bc9712f6ea",
                                "text": "Oh, Marilla, it was heartrending. Mr. Phillips made such a beautiful farewell speech beginning, ‘The time has come for us to part.’ It was very affecting. And he had tears in his eyes too, Marilla."
                            }
                        ]
                    }
                ],
                "translations": [
