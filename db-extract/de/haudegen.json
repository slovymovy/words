                "senses": [
                    {
                        "sense_id": "e32efeff-2b34-3281-befe-cfefb1dd176a",
                        "entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                        "glosses": [
                            "im 17. Jahrhundert benutzter Degen mit zwei Schneiden zum Hauen und Schlagen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                        "entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                        "glosses": [
                            "übertragen von der Waffe: Soldat mit Kampferfahrungen, der sich durch seine verwegene und draufgängerische Art auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05a7ecae-3067-4ab8-aebf-e15c45fc3e84",
                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                "text": "Mein Großvater war ein alter Haudegen."
                            },
                            {
                                "example_id": "0bab1cbf-90af-4863-aba6-d388782f99c6",
                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                "text": "„Als ich dem Burschen den Brief zeigte und ihm seine Lüge vorwarf, erklärte er mir, er wäre so gern in das Heer eingetreten und habe geglaubt, er müsse sich dann als Haudegen aufspielen; ich möge ihm doch verzeihen, auch wegen des Märchens, daß ihm seine Mutter Geld schicken werde.“"
                            },
                            {
                                "example_id": "7eded791-4bc3-4b18-b118-9b51a48b3079",
                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                "text": "„Nach der Machtübertragung setzte Hitler den Haudegen als Reichskommissar in Bayern ein, kurz darauf als Reichsleiter des Kolonialpolitischen Amtes der NSDAP.“"
                            },
                            {
                                "example_id": "038080e0-9ea2-4a95-af22-08300b3a54c4",
                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                "text": "„Interessant, dass der vermeintliche Repräsentant des Rokoko den Ton des hexenverlassnen und von Prophezeiungen genarrten Haudegens, der in der Poesie der Stelle aufbewahrt ist, trifft, der Romantiker dem Gescheiterten, der Zuflucht in poetischer Kaltschnäuzigkeit sucht, ein Wortkleid überstreift, das wunderschön ist, aber doch weiter vom englischen Original.“"
                            },
                            {
                                "example_id": "e3cb0345-e2a0-4991-9534-648cf58e9efe",
                                "sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                                "text": "„Aber der Prophet fühlte sich in der festen Burg seines Gottes und in der Wartburg des sächsischen Kurfürsten sicherer als im Gemäuer eines ritterlichen Haudegens.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdd2497d-547e-4f7c-8fef-2b4429da8489",
                        "source_entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                        "source_sense_id": "e32efeff-2b34-3281-befe-cfefb1dd176a",
                        "source_sense_description": "Degen mit zwei Schneiden",
                        "target_lang_word": "soldado destemido",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "566568b4-46d9-42fe-a60d-623d12b2fd29",
                        "source_entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                        "source_sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                        "source_sense_description": "kampferprobter, draufgängerischer Mann",
                        "target_lang_word": "warhorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warhorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "Any horse used in horse-cavalry, but especially one bearing an armoured knight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab25a72f-ee42-477c-8962-e9cc3c3bfe15",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "Just within the inner edge of the circle stood a soldier, in the military attire of a strange nation; and without it was his warhorse, in the center of a collection of mounted domestics, seemingly in readiness to undertake some distant journey."
                                            },
                                            {
                                                "example_id": "a0f43e27-259d-48e8-8f0f-49d634f31943",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "As he spoke, the knight-errant, who had remounted his war-horse, galloped forward to the royal stand, with a silken kerchief bound round his wounded arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "An experienced person who has been through many battles, situations or contests; someone who has given long service."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10c4133d-c4d1-412f-9d0d-8cc52c7afcc5",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Near-synonym: workhorse"
                                            },
                                            {
                                                "example_id": "b78bd018-c017-4464-b4b9-33a1d6830faf",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Among other accidents of that year was a Democratic president. Judge Atwood was a warhorse of Democracy."
                                            },
                                            {
                                                "example_id": "322c37eb-6621-42a3-9a65-40d0dfbf0425",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Certainly this was a bold proposal to an old warhorse like Ecuyer, and, like a true English bulldog, he voiced a reply which made the Indians wince."
                                            },
                                            {
                                                "example_id": "27692a21-7652-402c-84ab-658e479517e1",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "“I don't know. I never notice much. Oh, they do kid me about not being in the army—especially the old warhorses, the old men that aren't going themselves. And this Bogart boy. And Mr. Hicks's son—he's a horrible brat. But probably he's licensed to say what he thinks about his father's hired man!”"
                                            },
                                            {
                                                "example_id": "6b715c56-a55d-446b-a52f-773f1fd9de78",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Srinath: India's warhorse [title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "A regularly revived theatrical or musical work, as with Hamlet or a Beethoven symphony, or as excerpts thereto. May imply that the work in question has become hackneyed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b560fc-0d4a-4c37-9782-5824ec1d0584",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "a Wagner warhorse"
                                            },
                                            {
                                                "example_id": "80b89e3b-e486-4335-bfa8-7d89ac73d809",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "I remember taking the old warhorse, “Una Voce Poco Fa,” from Il Barbiere (Rossini) to three of the greatest living singing masters in Italy."
                                            },
                                            {
                                                "example_id": "b962e7ee-1509-479b-aae3-7f4c0745ff47",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "Les Ballets Trockadero de Monte Carlo[…] presented a typical program of Russian warhorses of the 19th and early 20th centuries[…]"
                                            },
                                            {
                                                "example_id": "64e5ad9e-fc3f-49b7-b1ce-63a60810b634",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "A Mendelssohn Warhorse Gets the Perlman Treatment [title]"
                                            },
                                            {
                                                "example_id": "f463cba4-a769-4a32-917e-f9fc0b6866ea",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "[…] the ROH mounts a new production of an Italian repertory warhorse that is fully on the level of the one it replaces […"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "095cf797-35e5-4b05-be04-119b3cffa6ed",
                        "source_entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                        "source_sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                        "source_sense_description": "kampferprobter, draufgängerischer Mann",
                        "target_lang_word": "bretteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bretteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32456d12-86c1-3589-bea3-5d0c79137108",
                                        "entry_id": "b08eb01d-9b7e-3a64-a99b-79d6dda52aa6",
                                        "glosses": [
                                            "Celui qui aime à se battre à l’épée, à ferrailler."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0509cb0-b441-4250-a146-140c62964f0a",
                                                "sense_id": "32456d12-86c1-3589-bea3-5d0c79137108",
                                                "text": "Mais tu étais cadet, et sous l’ancien droit, le patrimoine dont tu as eu la moitié appartenait entièrement à ton frère aîné. […]. Si la Constituante n'avait passé un trait de plume sur cet article de la loi, tu serais à l’heure qu'il est de toute nécessité chevalier d’industrie, barnabote, aventurier, abbé, bretteur, coureur de ruelles."
                                            },
                                            {
                                                "example_id": "11e0eef3-75e5-40cd-8de3-4340affa4552",
                                                "sense_id": "32456d12-86c1-3589-bea3-5d0c79137108",
                                                "text": "Personne ne se permettait de railler Augereau [1757-1816] sur cet article, car on savait qu'il était grand bretteur, très brave, et avait fait mettre les pouces au célèbre Saint-Georges [1745-1799], la plus forte lame de France."
                                            },
                                            {
                                                "example_id": "729b2a08-ccd4-4b56-a9ed-9d0757533177",
                                                "sense_id": "32456d12-86c1-3589-bea3-5d0c79137108",
                                                "text": "Bretteurs et menteurs sans vergogne,\nCe sont les cadets de Gascogne !"
                                            },
                                            {
                                                "example_id": "b5c9af78-0f11-42b7-b09e-14bcaaa33333",
                                                "sense_id": "32456d12-86c1-3589-bea3-5d0c79137108",
                                                "text": "S’il croisait le chemin d’un tigre féroce, il le tuait en le frappant violemment avec son bâton [car ses parents ne voulaient plus qu'il joue avec les couteaux]. Les gens de la région, fascinés par son talent de bretteur, l’ont surnommé Quât Gioi (Maître Fouet)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2febe008-a81d-3280-bca4-ceeec36be275",
                                        "entry_id": "b08eb01d-9b7e-3a64-a99b-79d6dda52aa6",
                                        "glosses": [
                                            "Celui qui se bat avec les idées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f7c78e-c485-42a3-89bc-7e61f44eb05f",
                                                "sense_id": "2febe008-a81d-3280-bca4-ceeec36be275",
                                                "text": "[…] sa vie de bretteur théorique ferraillant contre les idées coupables, selon lui, d’avoir engendré le nazisme, mais aussi contre une extrême gauche dont il a qualifié les dérives de « fascistes » dans les années 1960 : tout cela a fini par confondre son trajet d’homme et de penseur avec l’histoire de l’Allemagne d’après-guerre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4eea111-c40e-4338-8b2f-2c1fdf37a6a9",
                        "source_entry_id": "0e978793-3948-3498-afe3-b7a4f5b2144b",
                        "source_sense_id": "b5d8aa37-bacc-3300-8f8f-b89a827789ac",
                        "source_sense_description": "kampferprobter, draufgängerischer Mann",
                        "target_lang_word": "baroudeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baroudeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcaed587-a10c-36d4-941b-21fb05c26176",
                                        "entry_id": "07988c43-c85d-3c09-9c39-71a8094d93cd",
                                        "glosses": [
                                            "Soldat ou guerrier qui a beaucoup combattu."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b290a0a3-2cf1-4820-a088-808f0c0402d0",
                                                "sense_id": "bcaed587-a10c-36d4-941b-21fb05c26176",
                                                "text": "J'avais un brigadier-chef qui avait fait l’Indochine, le parfait baroudeur, qui commençait à être violent."
                                            },
                                            {
                                                "example_id": "4f49a7ed-24d4-4bcd-a752-5ba9d7ca3725",
                                                "sense_id": "bcaed587-a10c-36d4-941b-21fb05c26176",
                                                "text": "[…], l'aspirant de réserve Seveau, le passionné de botanique, porte lui aussi le brevet de pilote de l'armée de l'air. Et pourtant, il va se révéler dans les mois à venir comme le plus redoutable « baroudeur » de toute la LVF !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03ee5ec1-9701-3dc0-9b42-944ae63a98a0",
                                        "entry_id": "07988c43-c85d-3c09-9c39-71a8094d93cd",
                                        "glosses": [
                                            "Aventurier ; voyageur intrépide ; globe-trotteur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "045b1658-b243-3c92-96a4-fe02b39597c6",
                                        "entry_id": "07988c43-c85d-3c09-9c39-71a8094d93cd",
                                        "glosses": [
                                            "Coureur qui va chercher les échappées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4420e67c-4a4f-4b4a-ae76-e881930060f1",
                                                "sense_id": "045b1658-b243-3c92-96a4-fe02b39597c6",
                                                "text": "Le baroudeur est un cycliste de bonne volonté. Son tempérament le porte à l'attaque. Il flingue. Dans une débauche d'énergie dont il a le secret, il se porte à l'avant et tient tête à tout un peloton déchaîné."
                                            },
                                            {
                                                "example_id": "870480e2-21be-48c1-a668-9d722fed0703",
                                                "sense_id": "045b1658-b243-3c92-96a4-fe02b39597c6",
                                                "text": "Jusqu'à cette période, tout coureur était un baroudeur, car le succès d'une course dépendait à l'époque de tactiques mouvementées : il fallait attaquer tôt et avec beaucoup de détermination, […]."
                                            },
                                            {
                                                "example_id": "19d878e5-7013-4b6a-8fa8-977d65b4df53",
                                                "sense_id": "045b1658-b243-3c92-96a4-fe02b39597c6",
                                                "text": "Un groupe de baroudeurs, sans tricolore, s’est échappé par l'avant. Mais le peloton des meilleurs a décidé de chasser les courageux. Sans pitié."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baroudeur",
                                "target_lang_code": "fr",
                                "target_senses": [
