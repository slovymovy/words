    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                "word": "loquacity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9ab5e1e2-dab5-47db-8ae4-723bf17a5312",
                        "entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "tags": [
                            "plural"
                        ],
                        "form": "loquacities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                        "entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "glosses": [
                            "Talkativeness; the quality of being loquacious."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "01e315bd-fb76-4200-92fe-8d95c9b84b79",
                                "sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                                "text": "A man that were ſo diſpoſed, may ſeeme in reaſon to reproove […] the loquacity of Euripides, […]"
                            },
                            {
                                "example_id": "baf63779-a856-4667-a857-d2bfbab337dc",
                                "sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                                "text": "Neither is eloquence or rhetoric unclaimed by him: he perſuaded with Stentorian loquacity, and convinces by the irreſiſtible powers of a bellowing horſe laugh."
                            },
                            {
                                "example_id": "ce46f9b2-c1ae-421e-987e-16c09225cd33",
                                "sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                                "text": "Their silence would have been awkward but for the loquacity of Jane, who talked enough for all three."
                            },
                            {
                                "example_id": "b25c26b9-5722-4820-950c-923fe5a22b94",
                                "sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                                "text": "Here was news for us, for Mr Kelada, with all his loquacity, had never told anyone what his business was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "262f4562-372e-4e29-9533-81a1e8afd0c0",
                        "source_entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "source_sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                        "source_sense_description": "talkativeness — see also talkativeness",
                        "target_lang_word": "spraakzaamheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spraakzaamheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "01232d74-cd23-3d2a-9c0a-bce15fb3779d",
                                        "entry_id": "48165373-db73-3a1e-a964-a2c7b96a08b7",
                                        "glosses": [
                                            "geneigdheid om veel te praten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ff4a30-a596-416d-a6e7-e7a6163e24ed",
                                                "sense_id": "01232d74-cd23-3d2a-9c0a-bce15fb3779d",
                                                "text": "Boer Herman bleek helemaal niet zo bleu, althans wat spraakzaamheid betreft. „Weinig mensen in mijn omgeving zullen zeggen dat ik een stille ben”, zegt hij. „Ik ben blij dat mijn vriendinnen hebben doorgezet, dat ik geschreven heb, want het klikte meteen. We hadden veel raakvlakken”, vertelt Fleur."
                                            },
                                            {
                                                "example_id": "166d4347-268e-4f5f-925f-ba4a0c063c7d",
                                                "sense_id": "01232d74-cd23-3d2a-9c0a-bce15fb3779d",
                                                "text": "Zijn spraakzaamheid was plotseling verdwenen en had plaatsgemaakt voor een naïef en stil gevoel van bewondering."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02d683a3-633b-4a8f-bd34-b281cebcb17c",
                        "source_entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "source_sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                        "source_sense_description": "talkativeness — see also talkativeness",
                        "target_lang_word": "loquacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loquacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                        "entry_id": "dc5dfe6f-cb88-373a-8619-24c174b28152",
                                        "glosses": [
                                            "Habitude de parler beaucoup ; tendance au bavardage ; état de celui ou de celle qui est loquace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2429dfc5-4827-4a3b-aa56-3485634feb5d",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Cette rencontre était de nature à vivement frapper madame de Staël ; à son retour au château, elle en parla peu, malgré le besoin d’expansion qui, chez elle, dégénérait en loquacité ; mais elle en parut fortement préoccupée."
                                            },
                                            {
                                                "example_id": "afe61f3f-4a09-4f2e-b5be-fae86ba39fdd",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Quoique très instruite, elle n’avoit ni les caprices, ni l’humeur qu’on attribue aux gens de lettres, qui tantôt se livrent à une loquacité importune, tantôt se renferment dans un silence méprisant."
                                            },
                                            {
                                                "example_id": "ebf92101-99de-460f-b98c-5d90a7b4eaf5",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Comme si l’ivresse eût délié sa langue, l’ivresse qui met dans la bouche des hommes un balbutiement pareil à la voix des bêtes, lui, dès qu’il était saoul, devenait d’une loquacité terrible."
                                            },
                                            {
                                                "example_id": "274f5946-14dc-44a9-bb66-5e91d7559bbe",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Pendant un moment, la morgue germanique lutta en lui avec la simplicité anglaise, et aussi avec sa bienveillance naturelle et sa loquacité, et elle eut le dessous."
                                            },
                                            {
                                                "example_id": "7599b54f-a532-4994-9c89-86844addd296",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "L’un était […] probablement silencieux par ordre ; l’autre, gêné de trouver Mikkelsen et Münck parlant sa langue, était d’une loquacité un peu déconcertante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a430d1e-8822-33b1-8fae-98753529f7ad",
                                        "entry_id": "dc5dfe6f-cb88-373a-8619-24c174b28152",
                                        "glosses": [
                                            "Logorrhée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c3472f6-8168-4bb0-bb75-6975b1a73ede",
                                                "sense_id": "0a430d1e-8822-33b1-8fae-98753529f7ad",
                                                "text": "Ces sortes de réveils étaient marquées par un cri aigu et par la projection des membres, tantôt d’un côté, tantôt d’un autre, et les premiers jours par une loquacité semi-délirante qui n’inquiétait pas moins que la stupeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c7efa39-f4c5-4f9e-9563-072c6ecc735e",
                        "source_entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "source_sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                        "source_sense_description": "talkativeness — see also talkativeness",
                        "target_lang_word": "Schwatzhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwatzhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04560ae8-b602-3407-a7ee-d6ce39ab12a3",
                                        "entry_id": "2df7d726-bb4c-3aac-b858-87ab7502807e",
                                        "glosses": [
                                            "Neigung viel zu reden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "417661f8-ba04-4345-9ef9-60caa669b5df",
                                                "sense_id": "04560ae8-b602-3407-a7ee-d6ce39ab12a3",
                                                "text": "„Ich aber fand die Schwatzhaftigkeit von Signora F. unglaublich, die doch nicht ganz Korfu verraten mußte, welcher Art die Geschichten waren, die ich ihr unter vier Augen erzählte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e60991b5-bc5e-4726-a44a-0072bd970a7e",
                        "source_entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "source_sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                        "source_sense_description": "talkativeness — see also talkativeness",
                        "target_lang_word": "Geschwätzigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschwätzigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48cdaf33-4ebc-31da-82a6-c5e4e49daab7",
                                        "entry_id": "9de82c8c-cc9b-3799-8272-48506d9a8beb",
                                        "glosses": [
                                            "Neigung viel zu reden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9f0e0d5-2458-44fb-971d-4b3af39c9524",
                                                "sense_id": "48cdaf33-4ebc-31da-82a6-c5e4e49daab7",
                                                "text": "„Ein Teil von ihnen drängte die ächzende Gangway empor und bevölkerte in lauter, fröhlicher Geschwätzigkeit das Deck, während sich der Rest der Leute wartend auf der Pier verteilte.“"
                                            },
                                            {
                                                "example_id": "7b9b5577-e32f-4bdd-8fa9-a0010be4af1a",
                                                "sense_id": "48cdaf33-4ebc-31da-82a6-c5e4e49daab7",
                                                "text": "„Gerede und Geschwätzigkeit galten als zwei gravierende Charaktermängel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b23aba9-cb1c-4386-8a2b-a10910c80090",
                        "source_entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "source_sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                        "source_sense_description": "talkativeness — see also talkativeness",
                        "target_lang_word": "Gesprächigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesprächigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                        "entry_id": "232c5dfc-beb5-37ff-9850-6b7c9c4435e3",
                                        "glosses": [
                                            "Eigenschaft, gerne und viel zu reden, zu sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f34d94c-cce0-4c02-8934-95521faeccf7",
                                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                                "text": "„Denn inzwischen war der Kaffee aufgetragen, und das Klappern der Tassen und die bald geweckte allgemeine Gesprächigkeit ließen vorläufig nur eine Unterhaltung im engsten Kreise zu.“"
                                            },
                                            {
                                                "example_id": "67d43eb4-7fba-4553-b61d-f08d7c409cb0",
                                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                                "text": "„Was ist in dem geselligen Gastmahl reizender als die Unterhaltung, die belebte Gesprächigkeit, und was belebt diese mehr als der Wein?“"
                                            },
                                            {
                                                "example_id": "aee5576d-f808-46de-a75c-b4124c6a48a8",
                                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                                "text": "„In deutlicher Geringschätzung wichen die herben Kelten der dringlichen Gesprächigkeit ihrer Nachbarn aus, mit unverhohlener Mißbilligung mieden sie ihre müßige Geselligkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14579c6e-4bb7-4281-8cdb-eff853845414",
                        "source_entry_id": "6c7f2ce3-c14d-3ab7-9633-b7f43e954f97",
                        "source_sense_id": "305a921b-8b2d-3dc7-8ce7-6189e9646e66",
                        "source_sense_description": "talkativeness — see also talkativeness",
                        "target_lang_word": "Redseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                        "entry_id": "eac94cde-89f9-3801-a6ca-41881d2aac7f",
                                        "glosses": [
                                            "Eigenschaft, gern und viel zu reden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95429a27-e0c6-468c-87c1-19bc83e38ec0",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "Aufgrund seiner Redseligkeit ist er ein gefürchteter Kunde."
                                            },
                                            {
                                                "example_id": "60b4a866-595a-4508-bc6b-e5103392bbc7",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Grenfeld orderte mit einer seit Jahren eingeübten Handbewegung zwei Whiskeys und hoffte auf die einsetzende Redseligkeit seines Kollegen.“"
                                            },
                                            {
                                                "example_id": "a0d4c379-823d-4e5a-a8ee-0b4507ffd55b",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Schließlich gilt auch der Niederdeutsche dem Oberdeutschen als bedächtig und trocken, eher zur Wortkargheit als zur Redseligkeit geneigt.“"
                                            },
                                            {
                                                "example_id": "c99328fe-ce0e-4451-bf95-8c81695cbd12",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Ihre Redseligkeit brachte mich zum Lachen.“"
                                            },
                                            {
                                                "example_id": "30c4b3db-2180-4682-ae3b-c7df5b21e982",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Tüchtigkeit und Redseligkeit passen nicht zusammen, da ist etwas schief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
