                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf4a3206-2bdb-34ae-b924-809c594c9aab",
                        "entry_id": "7c5daa0c-00f0-32a3-9ab1-f4d6f71381ba",
                        "glosses": [
                            "Occuper plus que ce qui serait normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1dcfb3b-c512-4690-8ada-e291504a5209",
                                "sense_id": "bf4a3206-2bdb-34ae-b924-809c594c9aab",
                                "text": "L'offre globalement insuffisante en logements contraint de nombreux ménages bruxellois à suroccuper leur logement et à recourir à d’autres stratégies et modalités d’habiter telles que le retardement de la décohabitation, la colocation, l’habitat groupé ou l’occupation (temporaire et précaire) de logements vacants."
                            },
                            {
                                "example_id": "e7ea3519-0e49-4177-860d-a0f511b318bf",
                                "sense_id": "bf4a3206-2bdb-34ae-b924-809c594c9aab",
                                "text": "C'est Rove qui, paraît-il, a poussé Bush à suroccuper le terrain des «valeurs»."
                            },
                            {
                                "example_id": "cb2b8d39-8972-436e-ba52-6164920f38d3",
                                "sense_id": "bf4a3206-2bdb-34ae-b924-809c594c9aab",
                                "text": "Nous avons la fâcheuse tendance à nous occuper, voire de nous « suroccuper » (de peur de nous ennuyer sans doute)."
                            }
                        ]
                    }
                ],
