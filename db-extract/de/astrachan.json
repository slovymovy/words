                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5607f770-9d45-4d6a-9fc1-17fadea17ab0",
                                "sense_id": "22668d6c-3af8-3cf6-8ef3-c584ed5581aa",
                                "text": "„Bei Astrachan betrat Humboldt das erste Dampfschiff seines Lebens.“"
