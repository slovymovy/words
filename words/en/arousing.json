    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e1ac6d38-a553-374d-9b26-8c1204db75d2",
                    "sense_definition": "Causing sexual excitement or strong emotional stimulation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arousal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie contained several <w>arousing</w> scenes that were considered controversial by the censors.",
                            "target_lang_translations": {
                                "zh": "这部电影包含几个被审查员认为有争议的<w>刺激性</w>场景。"
                            }
                        },
                        {
                            "text": "He found the <w>arousing</w> music to be quite distracting during his study session.",
                            "target_lang_translations": {
                                "zh": "他发现那段<w>令人兴奋的</w>音乐在他学习时非常让人分心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stimulating",
                        "exciting",
                        "provocative"
                    ],
                    "antonyms": [
                        "unstimulating",
                        "boring"
                    ],
                    "common_phrases": [
                        "arousing effect",
                        "arousing experience"
                    ],
                    "target_lang_definitions": {
                        "zh": "引起性兴奋或强烈情感刺激的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刺激性的",
                                "target_lang_sense_clarification": "指引起强烈感官或情感反应的"
                            },
                            {
                                "target_lang_word": "令人兴奋的",
                                "target_lang_sense_clarification": "指引起情绪高涨或生理兴奋的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52718467-70cc-30c4-8966-fa7d940c3cfa",
                    "sense_definition": "Present participle and gerund of <w>arouse</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arousal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise was <w>arousing</w> the sleeping baby from his nap.",
                            "target_lang_translations": {
                                "zh": "巨大的噪音把正在午睡的婴儿<w>唤醒</w>了。"
                            }
                        },
                        {
                            "text": "She is <w>arousing</w> curiosity among her colleagues by keeping her new project a secret.",
                            "target_lang_translations": {
                                "zh": "她对新项目保密，这在同事中<w>激起</w>了好奇心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "arousing interest",
                        "arousing suspicion"
                    ],
                    "target_lang_definitions": {
                        "zh": "唤醒、引起或激起（某事）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唤醒",
                                "target_lang_sense_clarification": "指使人从睡眠中醒来"
                            },
                            {
                                "target_lang_word": "激起",
                                "target_lang_sense_clarification": "指引起某种情感、兴趣或反应"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dcb47d6-8fed-3001-94b4-1de128435ee7",
                    "sense_definition": "The act or process of waking someone up or stimulating them into action.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arousal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>arousings</w> of the crowd signaled that the protest was about to begin.",
                            "target_lang_translations": {
                                "zh": "人群中突然的<w>骚动</w>预示着抗议活动即将开始。"
                            }
                        },
                        {
                            "text": "These frequent <w>arousings</w> from his deep sleep left him feeling exhausted throughout the day.",
                            "target_lang_translations": {
                                "zh": "这些频繁的<w>唤醒</w>使他整天都感到精疲力竭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awakening",
                        "stimulation"
                    ],
                    "common_phrases": [
                        "sudden arousings"
                    ],
                    "target_lang_definitions": {
                        "zh": "唤醒或激发行动的过程"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唤醒",
                                "target_lang_sense_clarification": "指从睡眠中被叫醒的行为"
                            },
                            {
                                "target_lang_word": "激发",
                                "target_lang_sense_clarification": "指促使某人采取行动或产生某种状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}