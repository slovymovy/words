                            "short-form"
                        ],
                        "form": "неизбы́вна"
                    },
                    {
                        "form_id": "8ec2fc60-c827-4f82-8bb0-566b194a9d3a",
                        "entry_id": "0f5b52d2-114a-3007-924a-227399bd86c8",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "неизбы́вны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a2071fe-bdc1-3c42-8c22-3cffee15dd99",
                        "entry_id": "0f5b52d2-114a-3007-924a-227399bd86c8",
                        "glosses": [
                            "книжн. такой, от которого трудно, невозможно избавиться; неистребимый; такой, что не кончается, не иссякает"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d77b536-42d0-4d34-b56f-93f1d37f3701",
                                "sense_id": "3a2071fe-bdc1-3c42-8c22-3cffee15dd99",
                                "text": "Правда, победная радость тут же сменилась неизбывной тревогой ― побеждённый соседний люд хлынул в страну победителей и начал её объедать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b8f8ed5-36e3-4a8d-8bbe-01567332362c",
                        "source_entry_id": "0f5b52d2-114a-3007-924a-227399bd86c8",
                        "source_sense_id": "3a2071fe-bdc1-3c42-8c22-3cffee15dd99",
                        "target_lang_word": "inescapable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inescapable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9687f46-1b56-36b9-86d5-ef9e91e8c79a",
                                        "entry_id": "a6ed1c9c-ba2f-3750-98a2-7395d2e53bc9",
                                        "glosses": [
                                            "Impossible (unable) to avoid or escape; not escapable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7daba732-1c79-4674-90e8-af1f4e986e06",
                                                "sense_id": "c9687f46-1b56-36b9-86d5-ef9e91e8c79a",
                                                "text": "Later, the US national security adviser, Jake Sullivan, told CNN that Ukraine could not join Nato immediately as it was “an inescapable fact” that the treaty’s mutual defence clause would mean allies would be obliged to enter a direct war with Russia."
                                            },
                                            {
                                                "example_id": "8623aecc-0c71-4c24-8d8a-461d536bdda3",
                                                "sense_id": "c9687f46-1b56-36b9-86d5-ef9e91e8c79a",
                                                "text": "The Rugby flyover, too, is now an inescapable feature of the West Coast main line landscape."
                                            },
                                            {
                                                "example_id": "2a06143d-a5e1-477e-b0c1-f975f7c384d9",
                                                "sense_id": "c9687f46-1b56-36b9-86d5-ef9e91e8c79a",
                                                "text": "Wages absorbed 80% of the total revenue (which was inescapable), and they were rising at almost twice the rate of fares, which were pegged by law."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2321bd9-dd7e-4835-9b49-569258f74f41",
                        "source_entry_id": "0f5b52d2-114a-3007-924a-227399bd86c8",
                        "source_sense_id": "3a2071fe-bdc1-3c42-8c22-3cffee15dd99",
                        "target_lang_word": "persistent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persistent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cda0d9ec-54ed-3549-9d3c-6c524da86d33",
                                        "entry_id": "09111f05-7d6a-3f30-8aee-ccd2a4f21924",
                                        "glosses": [
                                            "Obstinately refusing to give up or let go."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbaf2d3b-6429-41f8-b14a-2705573f509d",
                                                "sense_id": "cda0d9ec-54ed-3549-9d3c-6c524da86d33",
                                                "text": "She has had a persistent cough for weeks."
                                            },
                                            {
                                                "example_id": "b17f72b2-451f-4cf8-beea-5e4fef7276cd",
                                                "sense_id": "cda0d9ec-54ed-3549-9d3c-6c524da86d33",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland. His ability to run at defences is instantly striking, but it is his clever use of possession that has persuaded some shrewd judges that he is an even better prospect than Theo Walcott."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e01d16a4-825c-3756-8bc5-335b23853d0a",
                                        "entry_id": "09111f05-7d6a-3f30-8aee-ccd2a4f21924",
                                        "glosses": [
                                            "Insistently repetitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e6bbdb-e6f2-4f2d-a283-5afae3f2757c",
                                                "sense_id": "e01d16a4-825c-3756-8bc5-335b23853d0a",
                                                "text": "There was a persistent knocking on the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcac6143-0b38-37ef-a2a9-5f81d9152318",
                                        "entry_id": "09111f05-7d6a-3f30-8aee-ccd2a4f21924",
                                        "glosses": [
                                            "Indefinitely continuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9bf890e-2c68-405a-9a29-b82afb52fc83",
                                                "sense_id": "dcac6143-0b38-37ef-a2a9-5f81d9152318",
                                                "text": "There have been persistent rumours for years."
                                            },
                                            {
                                                "example_id": "3fac3f1c-a3d1-4972-922d-a01b503b3a37",
                                                "sense_id": "dcac6143-0b38-37ef-a2a9-5f81d9152318",
                                                "text": "Although many individuals seek meaningful social connection, they face persistent barriers to sustaining relationships, including communication difficulties, social rejection, loneliness, and limited social opportunities (Elmose, 2019; Mendelson et al., 2016; Sosnowy et al., 2019). The gap between social motivation and real-life opportunities for social interaction may contribute to persistent social isolation in this population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20bf7583-f484-3a25-9a0f-305b7c8c6782",
                                        "entry_id": "09111f05-7d6a-3f30-8aee-ccd2a4f21924",
                                        "glosses": [
                                            "Lasting past maturity without falling off."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70994dcc-5841-47b9-b0ec-c2509a94daa0",
                                                "sense_id": "20bf7583-f484-3a25-9a0f-305b7c8c6782",
                                                "text": "Pine cones have persistent scales."
                                            },
                                            {
                                                "example_id": "0b57bd37-3b7e-4e8f-9e44-ebae216a443d",
                                                "sense_id": "20bf7583-f484-3a25-9a0f-305b7c8c6782",
                                                "text": "The Jubulaceae have a leaf whose lobule, usually transformed into a water-sac, is normally very narrowly attached to the stem and to the dorsal lobe; indeed some Frullania taxa reproduce vegetatively by dropping the dorsal lobes, but not the lobules, and Neohattoria has caducous lobules but persistent lobes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca50aaa-78a6-31a5-998b-96ea40ef6edc",
                                        "entry_id": "09111f05-7d6a-3f30-8aee-ccd2a4f21924",
                                        "glosses": [
                                            "Of data or a data structure: not transient or temporary, but remaining in existence after the termination of the program that creates it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd523ecc-3a83-4a16-81db-6e4b1ab7c3c7",
                                                "sense_id": "3ca50aaa-78a6-31a5-998b-96ea40ef6edc",
                                                "text": "Once written to a disk file, the data becomes persistent: it will still be there tomorrow when we run the next program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce15d797-d23e-3cb1-9387-3c157731f545",
                                        "entry_id": "09111f05-7d6a-3f30-8aee-ccd2a4f21924",
                                        "glosses": [
                                            "Describing a fractal process that has a positive Brown function"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dda51a8-6d2f-3d33-a62b-267b52d886b6",
                                        "entry_id": "09111f05-7d6a-3f30-8aee-ccd2a4f21924",
                                        "glosses": [
                                            "non-transient."
                                        ],
                                        "tags": [
                                            "of a state"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
