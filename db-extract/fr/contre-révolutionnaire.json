                            "masculine",
                            "feminine"
                        ],
                        "form": "contre-révolutionnaires"
                    },
                    {
                        "form_id": "8d3925fc-bcc8-4a59-a759-b976655a8c90",
                        "entry_id": "661a5349-b420-3761-99d7-713de5ec8f1b",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "contrerévolutionnaire"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9922fb5-3477-321e-95fa-cd2b1f31c5b6",
                        "entry_id": "661a5349-b420-3761-99d7-713de5ec8f1b",
                        "glosses": [
                            "Qui est favorable à la contre-révolution, qui tend à la contre-révolution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77c9f345-14b1-4d64-b89a-92f4ff5ab446",
                                "sense_id": "a9922fb5-3477-321e-95fa-cd2b1f31c5b6",
                                "text": "Après qu’elle eut signé sa déposition, on lui avait annoncé qu’elle serait renvoyée à la frontière pour \"activités contre-révolutionnaires et antibolcheviques\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "193e5908-ec8f-3b54-af1c-62522cf63f71",
                        "entry_id": "661a5349-b420-3761-99d7-713de5ec8f1b",
                        "glosses": [
                            "Qui veut détruire les évolutions politiques, sociales et civiles postérieures à la Révolution française."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ff9daa60-4087-4445-9622-427674c35443",
                                "sense_id": "193e5908-ec8f-3b54-af1c-62522cf63f71",
                                "text": "Sans désemparer, nous avons pris à partie celles de ces congrégations qui s'adonnaient à l'enseignement et qui, par un enseignement de doctrines contre-révolutionnaires, battaient en brèche l'édifice républicain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b420279-7a6d-406f-9747-f9ddc7211ab9",
                        "source_entry_id": "661a5349-b420-3761-99d7-713de5ec8f1b",
                        "target_lang_word": "counter-revolutionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counter-revolutionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19e58e31-3835-326c-aeb8-29a7cb85d3a3",
                                        "entry_id": "55989fd8-5309-36f7-be79-b592b773cd87",
                                        "glosses": [
                                            "Alternative form of counterrevolutionary."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd83f08-a9bc-449c-a450-bb52f34dbc70",
                                                "sense_id": "19e58e31-3835-326c-aeb8-29a7cb85d3a3",
                                                "text": "Chienyang County in Shensi Province on the loess highland has fairly rich water resources, but there was little irrigated land — averaging 0.4 mu per person — before the Cultural Revolution owing to interference and sabotage by Liu Shao-chi’s counter-revolutionary revisionist line.",
                                                "translation": "大寨——中国农业战綫上的一面紅旗",
                                                "english": "大寨——中国农业战綫上的一面紅旗"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "counter-revolutionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a0e0ef-e3cb-337a-9bbd-465c8c41b1d4",
                                        "entry_id": "aa2a1f0a-3ec5-34b8-8629-7ccb0f6c7068",
                                        "glosses": [
                                            "Alternative form of counterrevolutionary."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30888879-e0bf-45a1-b993-89743154d440",
                        "source_entry_id": "661a5349-b420-3761-99d7-713de5ec8f1b",
                        "target_lang_word": "counterrevolutionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counterrevolutionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2da09980-54ca-301a-b747-18d52519a655",
                                        "entry_id": "5f2d8c30-a5d3-3007-8652-26e4e52e59ba",
                                        "glosses": [
                                            "In opposition to a revolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c82c20-aabf-4409-8b60-30393ea98223",
                                                "sense_id": "2da09980-54ca-301a-b747-18d52519a655",
                                                "text": "In early 1990, he was sentenced to two years by the Loudi Prefecture Intermediate Court on a charge of \"counterrevolutionary propaganda and incitement.\" He was then sent to Longxi Prison for reform through labor, and has since been released."
                                            },
                                            {
                                                "example_id": "43435fb5-fdf6-4329-83ae-59f35d7c30d3",
                                                "sense_id": "2da09980-54ca-301a-b747-18d52519a655",
                                                "text": "It seems likely that states in the Middle East and North Africa could divide into three camps. […] In the second, Egypt and Tunisia will struggle to realize their revolutionary promise and ideals while resisting the counterrevolutionary forces of the old regimes."
                                            },
                                            {
                                                "example_id": "a424cb95-74b0-4936-9268-42956472a8f1",
                                                "sense_id": "2da09980-54ca-301a-b747-18d52519a655",
                                                "text": "To go back in time, as it were, the counterrevolutionary bloc—Saudi Arabia, the United Arab Emirates, Bahrain, Egypt, and their allies in Yemen, Libya, and elsewhere—believes the future must be more authoritarian than ever."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "counterrevolutionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84923685-64ae-323a-a86a-babd36bd76ad",
                                        "entry_id": "13695b8c-2896-3455-843a-a43004c750ee",
                                        "glosses": [
                                            "A person who opposes a revolution and attempts to reverse the changes made by it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d9498c-c678-476e-a3f7-9e78601d254c",
                                                "sense_id": "84923685-64ae-323a-a86a-babd36bd76ad",
                                                "text": "Two “counterrevolutionaries” were sentenced to death and executed publicly before cheering thousands in Shanghai Aug. 28, according to a Shanghai radio report received in Tokyo today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ba36f6-a73a-46c2-9f4d-4831e381ed29",
                        "source_entry_id": "661a5349-b420-3761-99d7-713de5ec8f1b",
                        "target_lang_word": "contrarrevolucionario",
                        "target_lang_code": "es",
