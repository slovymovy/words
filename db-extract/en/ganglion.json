                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034374e6-a813-4d7e-89f0-52f3d4899d56",
                                                "sense_id": "2d4147f3-c337-39ce-bf9c-98d80d0c6068",
                                                "text": "Ich habe einen Kopf Wirsing gekauft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0aa9d9e1-c2df-3868-978c-6d7aad5e6a44",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
