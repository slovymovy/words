                ],
                "senses": [
                    {
                        "sense_id": "4906ec97-52f8-3813-8c84-6ee4bc942c36",
                        "entry_id": "e936d5e1-bc0b-37ff-9b17-7ec33cfe4c21",
                        "glosses": [
                            "Anzahl Krankenhauseinweisungen (Hospitalisierungen) aufgrund einer bestimmten Erkrankung, die auf eine Gesamtmenge, zum Beispiel 100.000 Einwohner, und einen gewissen Zeitraum, zum Beispiel 7 Tage, bezogen wird"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "60392d19-72ca-4582-bb1e-c64d69151947",
                                "sense_id": "4906ec97-52f8-3813-8c84-6ee4bc942c36",
                                "text": "„Seit dem 19. Juli 2021 wird vom Robert Koch-Institut (RKI) im Situationsbericht zusätzlich zur 7-Tage-Inzidenz der Neuinfizierten auch eine 7-Tage-Inzidenz der Hospitalisierten, die Hospitalisierungsinzidenz, veröffentlicht.“"
                            },
                            {
                                "example_id": "9bacf79a-74f8-4f2c-bd0c-e21dc1b2285e",
                                "sense_id": "4906ec97-52f8-3813-8c84-6ee4bc942c36",
                                "text": "„Das heißt, diese werden jeweils immer für den Zeitraum der vergangenen sieben Tage addiert und auf 100.000 Einwohner umgerechnet. So setzt sich die Hospitalisierungsrate - oder anders gesagt - die Hospitalisierungsinzidenz zusammen.“"
                            },
                            {
                                "example_id": "1da51ea4-a08e-4aa1-9749-3c9e0085578b",
                                "sense_id": "4906ec97-52f8-3813-8c84-6ee4bc942c36",
                                "text": "„Die Hospitalisierungsinzidenz weist die hospitalisierten COVID-19-Fälle unter den in den letzten 7 Tagen gemeldeten Fällen bezogen auf 100.000 Menschen aus. Die Angaben können nach Altersgruppe und Bundesland aufgeschlüsselt werden.“"
                            },
                            {
                                "example_id": "29f1b02e-9f87-4003-b4c9-32e18c328596",
                                "sense_id": "4906ec97-52f8-3813-8c84-6ee4bc942c36",
                                "text": "„Bund und Länder richten die Einführung von 2G, 2G plus und Kontaktverboten an den Hospitalisierungsinzidenzen 3, 6 und 9 aus. Die Zahlen wirken einfach, doch die Berechnung der Inzidenz ist ungenau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
