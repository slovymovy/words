                ],
                "senses": [
                    {
                        "sense_id": "cd8eb763-3dff-3f65-811a-eb94d037a9b9",
                        "entry_id": "e58884ba-d4ee-344e-9242-644bd1d4119c",
                        "glosses": [
                            "Normaliser plus que nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e90c4d7-ed49-45a1-b24b-9f2ea53084ab",
                                "sense_id": "cd8eb763-3dff-3f65-811a-eb94d037a9b9",
                                "text": "Surnormaliser consiste à ne retenir qu'un nombre très réduit de modèles choisis parmi les plus utilisés et dont, par conséquent, les producteurs sont assurés d'avoir la vente."
                            },
                            {
                                "example_id": "76302397-1b73-4b1f-ab5c-8ec1941c8ebc",
                                "sense_id": "cd8eb763-3dff-3f65-811a-eb94d037a9b9",
                                "text": "Je comprends qu'on ne doit pas normaliser, et je n'ai jamais essayé de surnormaliser depuis que je fais des interventions."
                            }
                        ]
                    }
                ],
