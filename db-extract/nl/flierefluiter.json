                "forms": [
                    {
                        "form_id": "269b1d8c-a49f-448f-a023-5520ca8b90f4",
                        "entry_id": "2f75849b-990f-3001-ac7e-266c33b28f91",
                        "tags": [
                            "plural"
                        ],
                        "form": "flierefluiters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23ba0832-f8e7-3c7c-8e0c-696097b29bf0",
                        "entry_id": "2f75849b-990f-3001-ac7e-266c33b28f91",
                        "glosses": [
                            "vrolijk en/of oppervlakkig persoon die zich niets aantrekt van normen en waarden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "954ec7f0-9076-403c-8b92-d3cc443e541f",
                                "sense_id": "23ba0832-f8e7-3c7c-8e0c-696097b29bf0",
                                "text": "Arme Omar Sy. Sinds zijn doorbraak in Intouchables mag hij vooral opdraven in de rol van vrolijke, viriele zwarte man die tegen wil en dank de zorg op zich neemt van een vreemde en dat met verve doet. In Intouchables een man in een rolstoel, in Demain tout commence een dochtertje van wier bestaan de flierefluiter niet op de hoogte was."
                            },
                            {
                                "example_id": "58966fd4-e622-4bdf-9304-83234a4ca61e",
                                "sense_id": "23ba0832-f8e7-3c7c-8e0c-696097b29bf0",
                                "text": "Het werk maakt korte metten met de indruk dat Van der Elsken vooral een vrolijke, anti-autoritaire, oppervlakkige flierefluiter was. Hij was wel degelijk, ook in voorbereiding en research, een man van de inhoud."
                            }
                        ]
                    },
                    {
                        "sense_id": "a57c65e9-be2b-3275-a8ee-7eeb4562dbf2",
                        "entry_id": "2f75849b-990f-3001-ac7e-266c33b28f91",
                        "glosses": [
                            "iemand die weinig of niets zinnigs uitvoert"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1212ba45-bd1c-49ad-b2c9-3aea1b30f3fa",
                        "source_entry_id": "2f75849b-990f-3001-ac7e-266c33b28f91",
                        "source_sense_id": "23ba0832-f8e7-3c7c-8e0c-696097b29bf0",
                        "source_sense_description": "een vrolijk, oppervlakkig persoon die zich niets aantrekt van normen en waarden en vooral lui en werkschuw is",
                        "target_lang_word": "lounger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lounger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                        "entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
                                        "glosses": [
                                            "One who lounges; an idler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d813e81f-36e7-4f8f-a9cb-84fbe37caa57",
                                                "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                                "text": "Three or four men noticed my condition; and, evidently setting it down to the results of over many pegs, charitably endeavoured to draw me apart from the rest of the loungers."
                                            },
                                            {
                                                "example_id": "05086733-46ba-46ca-8891-a72396afd416",
                                                "sense_id": "c97bd29b-d007-34d6-8a93-e214ea0f987e",
                                                "text": "These colors, falling upon the throng of monomachists and loungers much as we see the aureate beams of divine favor fall on hierarchs in art, lent them an appearance insubstantial and thaumaturgic, as though they had all been produced a moment before by the flourish of a cloth and would vanish into the air again at a whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "515f914a-0374-34a1-9796-1dc5a277c753",
                                        "entry_id": "145809cc-8cc1-330b-99cc-ff580ca69ea0",
                                        "glosses": [
                                            "A chair made for lounging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415d73d5-d2e7-459a-9a38-69c2efe64746",
                                                "sense_id": "515f914a-0374-34a1-9796-1dc5a277c753",
                                                "text": "You shoulda heard me in the lounger / Telling people what they was"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
