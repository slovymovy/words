                {
                    "sense_id": "7c4f3ae7-5ad8-33ba-ac25-893df4f8bdb8",
                    "sense_definition": "À un moment quelconque, un jour, dans une phrase hypothétique, interrogative ou comparative.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps_indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si <w>jamais</w> tu passes par Paris, viens nous rendre visite.",
                            "target_lang_translations": {
                                "en": "If you <w>ever</w> pass through Paris, come and visit us.",
                                "ru": "Если ты <w>когда-нибудь</w> будешь проезжать через Париж, заходи к нам в гости.",
                                "nl": "Als je <w>ooit</w> door Parijs komt, kom dan even bij ons langs.",
                                "de": "Wenn du <w>jemals</w> durch Paris kommst, besuch uns doch.",
                                "pl": "Jeśli <w>kiedykolwiek</w> przejedziesz przez Paryż, wpadnij do nas w odwiedziny.",
                                "it": "Se <w>mai</w> passi per Parigi, vieni a trovarci.",
                                "cs": "Pokud <w>někdy</w> pojedeš přes Paříž, zastav se u nás.",
                                "tr": "<w>Olur da</w> yolun Paris'e düşerse bize uğra.",
                                "es": "Si <w>alguna vez</w> pasas por París, ven a vernos.",
                                "zh": "<w>万一</w>你路过巴黎，就来看看我们吧。"
                            }
                        },
                        {
                            "text": "Cette ville historique reste aujourd'hui plus vivante et dynamique que <w>jamais</w>.",
                            "target_lang_translations": {
                                "en": "This historic city remains more lively and dynamic today than <w>ever</w>.",
                                "ru": "Этот исторический город и сегодня живее и динамичнее, чем <w>когда-либо</w>.",
                                "nl": "Deze historische stad is vandaag levendiger en dynamischer dan <w>ooit</w>.",
                                "de": "Diese historische Stadt ist heute lebendiger und dynamischer denn <w>je</w>.",
                                "pl": "To historyczne miasto jest dziś żywsze i prężniejsze niż <w>kiedykolwiek</w>.",
                                "it": "Questa città storica è oggi più viva e dinamica che <w>mai</w>.",
                                "cs": "Tohle historické město je dnes živější a dynamičtější než <w>kdy</w> jindy.",
                                "tr": "Bu tarihi kent bugün <w>her zamankinden</w> daha canlı ve dinamik.",
                                "es": "Esta ciudad histórica sigue hoy más viva y dinámica que <w>nunca</w>.",
                                "zh": "这座历史名城如今比以往<w>任何时候</w>都更加充满活力。"
                            }
                        }
