                                    {
                                        "sense_id": "40ad3e9f-0bc3-329e-897c-96a6be816b42",
                                        "entry_id": "aae02ee5-fcf2-32f5-95fc-80a316f932fe",
                                        "glosses": [
                                            "mit Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "817df604-9635-4196-9dc9-03130e92d01b",
                                                "sense_id": "40ad3e9f-0bc3-329e-897c-96a6be816b42",
                                                "text": "Ich spiele gern Schach."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19640cb6-5d0a-378b-86ee-3a7446db2806",
                                        "entry_id": "aae02ee5-fcf2-32f5-95fc-80a316f932fe",
                                        "glosses": [
                                            "häufig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0feb6db0-5028-491a-ab2a-07e49aeb9d50",
                                                "sense_id": "19640cb6-5d0a-378b-86ee-3a7446db2806",
                                                "text": "Solche Unfälle enden gern tödlich."
                                            },
                                            {
                                                "example_id": "8503a02f-f179-41dc-96b4-92e5f8eae0b4",
                                                "sense_id": "19640cb6-5d0a-378b-86ee-3a7446db2806",
                                                "text": "Auch Lavendel oder Hortensien werden gern von Insekten angeflogen […]"
                                            },
                                            {
                                                "example_id": "a26069f7-e1cc-463b-a5b9-bf506d0a8bd2",
                                                "sense_id": "19640cb6-5d0a-378b-86ee-3a7446db2806",
                                                "text": "„So etwas steht in bester gesellschaftspolitischer Tatort-Tradition, geht aber gern sehr schief.“"
                                            },
                                            {
                                                "example_id": "8065674a-dcf7-4bbd-a40b-0c9d3831e1f9",
                                                "sense_id": "19640cb6-5d0a-378b-86ee-3a7446db2806",
                                                "text": "„Jetzt sei es auch notwendig, dass das Wildbret vom Schwarzwild gern gegessen und von den Verbrauchern kräftig nachgefragt wird, heißt es in einer Mitteilung des BJV weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3d69a79-58c6-36c0-9cd1-319df299a1f3",
                                        "entry_id": "aae02ee5-fcf2-32f5-95fc-80a316f932fe",
                                        "glosses": [
                                            "mögen"
                                        ],
