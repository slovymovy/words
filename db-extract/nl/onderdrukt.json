                        "tags": [
                            "form-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d3e4a6fd-2049-4e1b-b5af-6a9546597a78",
                                "sense_id": "c3b78390-4ac0-3634-a5af-f0ac0873db60",
                                "text": "Onderdrukt!"
                            },
                            {
                                "example_id": "9ae0c2a5-2a3e-4ff6-9db5-83362d347b15",
                                "sense_id": "c3b78390-4ac0-3634-a5af-f0ac0873db60",
                                "text": "Het is een volledig losgeslagen apparaat dat uiterst reactionair is, èn de mensen begrijpen niet, hoezeer het ons allen - vooral ook psychisch - onderdrukt."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e11bf02-598f-3b90-b5f8-d3b6efa7b4b5",
                        "entry_id": "8a60dccb-8b72-31e8-b82b-6b644308de1d",
                        "glosses": [
