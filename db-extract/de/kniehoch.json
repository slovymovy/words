                ],
                "senses": [
                    {
                        "sense_id": "b3183707-2142-39ea-a621-1068910de333",
                        "entry_id": "f7c776ce-67d0-3e49-b2f2-1b7711bc9700",
                        "glosses": [
                            "auf der Höhe der Knie, bis zu den Knien reichend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6f97220-3e14-42b4-acc4-2ba57e2690d6",
                                "sense_id": "b3183707-2142-39ea-a621-1068910de333",
                                "text": "„Unkraut wuchs fast kniehoch aus Rissen im Asphalt.“"
                            },
                            {
                                "example_id": "c335207d-3b81-46ce-8ddf-2ffa09173751",
                                "sense_id": "b3183707-2142-39ea-a621-1068910de333",
                                "text": "„Nachdem er sein Motorrad abgeschlossen hatte, ging er quer über den verdorrten Rasen und an den kniehohen Hecken vorbei zum Seiteneingang.“"
                            },
                            {
                                "example_id": "8a3bc492-bcd7-45d0-9634-dcd061e0f33b",
                                "sense_id": "b3183707-2142-39ea-a621-1068910de333",
                                "text": "„Der Sarg steht auf einem kniehohen Tisch, so dass sich der Deckel ein wenig unter Brusthöhe befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9350cf8-eeee-45c6-ac92-565e7fded988",
                        "source_entry_id": "f7c776ce-67d0-3e49-b2f2-1b7711bc9700",
