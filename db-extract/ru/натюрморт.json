                    {
                        "translation_id": "46ef2f41-a8e4-41b4-abb7-1e02ecc5c7ee",
                        "source_entry_id": "8500602c-75ab-3e25-bd2d-d357bdfa8f03",
                        "target_lang_word": "nature morte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nature morte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc355d7-a981-363b-aab5-2deb8fc0dad2",
                                        "entry_id": "e3bb3d94-a4dc-351f-89ce-434f6a1a9fb4",
                                        "glosses": [
                                            "Image d’objets inanimés."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c68cc7b-1973-44dc-b4a4-8c79d2125230",
                                                "sense_id": "3dc355d7-a981-363b-aab5-2deb8fc0dad2",
                                                "text": "Les quatre grands panneaux avaient dû être ménagés de façon à recevoir des peintures de nature morte ; mais ils étaient restés vides, le propriétaire de l’hôtel ayant sans doute reculé devant une dépense purement artistique."
                                            },
                                            {
                                                "example_id": "7a743e92-19bf-4c39-905c-9c6eedad4142",
                                                "sense_id": "3dc355d7-a981-363b-aab5-2deb8fc0dad2",
                                                "text": "« Je ne parviens plus du tout à trouver d’intérêt aux natures mortes ; depuis l’invention de la photographie, je trouve que ça n’a plus aucun sens. Enfin, c’est un point de vue personnel…» conclut-il sur un ton d’excuse."
                                            },
                                            {
                                                "example_id": "83228b59-b030-4b92-b903-f1b1bf784bd3",
                                                "sense_id": "3dc355d7-a981-363b-aab5-2deb8fc0dad2",
                                                "text": "Paradoxalement, la nature morte, représentation d’objets immobiles, exige du spectateur une mobilité du regard qui, entre les parties et le tout, doit en permanence créer du lien ou, pour le dire autrement, lire le tableau non seulement pour ce qu’il donne à voir (ici, en l’ocurrence, des livres), mais également pour ce qu’il dit ou énonce à l’égal d’un texte."
                                            }
                                        ]
                                    }
                                ]
                            }
