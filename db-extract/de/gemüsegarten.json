                ],
                "senses": [
                    {
                        "sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                        "entry_id": "494fd2d3-8892-3272-8e0c-e07e3f40f7a6",
                        "glosses": [
                            "Garten, in dem Gemüse angebaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c58f8a-e1eb-4eec-8218-f5551420e949",
                                "sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                                "text": "Sie bepflanzte am Sonntag ihren Gemüsegarten."
                            },
                            {
                                "example_id": "be8ab63f-8626-4823-989c-857c324e17ac",
                                "sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                                "text": "„Das Camp war auch umweltfreundlich, produzierte Solarstrom und verarbeitete alle Küchenabfälle zu Kompost, mit dem der ausgedehnte Gemüsegarten gedüngt wurde.“"
                            },
                            {
                                "example_id": "2bc5ca8f-1b0c-4070-932d-a7e092102e72",
                                "sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                                "text": "„Kinder arbeiten in Gemüsegärten.“"
                            },
                            {
                                "example_id": "a2353df5-c8c9-4f28-b0e0-11b9b0c9c519",
                                "sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                                "text": "„Überall wurden die Parks in Gemüsegärten umgewandelt.“"
                            },
                            {
                                "example_id": "d23628f4-5266-499e-bc95-f7ac26f80cde",
                                "sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                                "text": "„Sam liegt auf dem schmalen Weg aus Betonplatten, der den Gemüsegarten in zwei Hälften teilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e34905c0-9e54-4436-aed1-1ee72329d4a1",
                        "source_entry_id": "494fd2d3-8892-3272-8e0c-e07e3f40f7a6",
                        "source_sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                        "source_sense_description": "Garten, in dem Gemüse angebaut ist",
                        "target_lang_word": "vegetable garden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vegetable garden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0ff7d6-76e6-3c6a-96a7-4117211b9086",
                                        "entry_id": "16bd8446-42e5-3738-aef1-56220e9890f8",
                                        "glosses": [
                                            "A garden where vegetables and herbs are grown for personal or household use, sometimes inclusive of cold frames, greenhouses, and market gardens. (This entry is a translation hub.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "349d50f7-5c03-4ae0-ad66-f4df6f0cd7ce",
                                                "sense_id": "dc0ff7d6-76e6-3c6a-96a7-4117211b9086",
                                                "text": "The hovel stood in the centre of what had once been a vegetable garden, but was now a patch of rank weeds. Surrounding this, almost like a zareba, was an irregular ring of gorse and brambles, an unclaimed vestige of the original common."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c67c84d-4938-428e-a1e8-b24635276a9d",
                        "source_entry_id": "494fd2d3-8892-3272-8e0c-e07e3f40f7a6",
                        "source_sense_id": "7c765803-c49b-3f01-967f-a57314c5f9c3",
                        "source_sense_description": "Garten, in dem Gemüse angebaut ist",
                        "target_lang_word": "kitchen garden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kitchen garden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee3def5-f1dd-30c8-9e64-e660bc8825fc",
                                        "entry_id": "bb000ee4-8bc2-330a-8f98-f2a0053b9a72",
