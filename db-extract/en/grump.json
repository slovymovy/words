                                    {
                                        "sense_id": "437c2f9c-d654-397c-8c9c-3ac84143190f",
                                        "entry_id": "1bcb7378-ad17-3330-8040-d639615c26c6",
                                        "glosses": [
                                            "Être de mauvaise humeur tout en grognant constamment."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0eaa43c-1da7-4c81-b37f-693405402077",
                                                "sense_id": "437c2f9c-d654-397c-8c9c-3ac84143190f",
                                                "text": "— Oh toi, ronchonne-t-elle, tu joues l’esprit fort, n’empêche que tu dormais mal, souviens-toi. Et que t'as été bien content de rhabiter Paris."
                                            },
                                            {
                                                "example_id": "2677dc71-68ad-449a-b760-b595ac53ed40",
                                                "sense_id": "437c2f9c-d654-397c-8c9c-3ac84143190f",
                                                "text": "Et ce monsieur commençait à ronchonner, il devenait exigeant, réclamait pour la nourriture."
                                            },
                                            {
                                                "example_id": "d716b937-8c78-4337-a5c3-d885f01c5ff0",
                                                "sense_id": "437c2f9c-d654-397c-8c9c-3ac84143190f",
                                                "text": "Il y a maintenant deux semaines que la victoire de Joe Biden a été déclarée par tous les observateurs éclairés de la scène politique américaine et, depuis ce jour, on n'a vu pratiquement aucun signe de vie de la part de Donald Trump, mis à part ses incontournables tweets et quelques sorties où les caméras l’ont capté de loin à ronchonner sur ses parcours de golf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
