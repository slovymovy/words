                    {
                        "translation_id": "160a10d5-8ef6-4aef-8b15-3bf203c7bfec",
                        "source_entry_id": "63088ab9-5837-30ff-a091-e074e3c8b515",
                        "source_sense_description": "able to be transferred to another person, with or without endorsement",
                        "target_lang_word": "negoziabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negoziabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49f7631f-995f-37a3-80c4-1ec43d48682a",
                                        "entry_id": "808e266f-50b0-381d-ae88-92c342cdbe3f",
                                        "glosses": [
                                            "handelsfähig, umsetzbar"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e5b2a2a-8396-465f-b185-645791179ec7",
                                                "sense_id": "49f7631f-995f-37a3-80c4-1ec43d48682a",
                                                "text": "„Zur Rechtfertigung dieses Antrags wurde gesagt: Es sei ein Bedürfniß des Handelsstandes, daß der Kaufmann in den Stand gesetzt werde, seine Forderungen negoziabel zu machen.“ (1863)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fa90fc0-9164-46c1-a022-b3081d3894f3",
                        "source_entry_id": "63088ab9-5837-30ff-a091-e074e3c8b515",
                        "source_sense_description": "open to negotiation or bargaining",
                        "target_lang_word": "négociable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "négociable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03c5efa6-d1e8-3f0c-a2ad-643a4b8a30c9",
                                        "entry_id": "fe991086-bb05-3db8-b936-1c31d7903d86",
                                        "glosses": [
                                            "Qui peut se négocier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4fa7320-33ae-4e1a-a973-b08b5bb79864",
                                                "sense_id": "03c5efa6-d1e8-3f0c-a2ad-643a4b8a30c9",
                                                "text": "Mais l’essentiel des difficultés ne tient-il pas, d’une part à une certaine incapacité à inventer un nouveau négociable, et d’autre part, à la crise d’adaptation que connaît aujourd’hui le syndicalisme."
                                            },
                                            {
                                                "example_id": "3c41aecd-98e7-4e89-90e7-6953e0d8b96a",
                                                "sense_id": "03c5efa6-d1e8-3f0c-a2ad-643a4b8a30c9",
                                                "text": "Toute la question est là. Qu’est-ce qui est négociable. Qu’est-ce qui n’est pas négociable. […] Le monde sera jugé sur ce qu’il aura considéré comme négociable ou non négociable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f35be3-30b8-33ef-aa6c-9e6bd0c0a327",
                                        "entry_id": "fe991086-bb05-3db8-b936-1c31d7903d86",
                                        "glosses": [
                                            "Qualifie, à la Bourse, une valeur mobilière ou un effet public faisant l’objet de transactions courantes, et qui n’est frappé d’aucune restriction particulière."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e192e2-1013-4902-a91f-6b09050bc07b",
                                                "sense_id": "89f35be3-30b8-33ef-aa6c-9e6bd0c0a327",
                                                "text": "Cet effet, ce billet est négociable, n’est pas négociable."
                                            },
                                            {
                                                "example_id": "df1947fc-0736-490a-b71d-f4bb925f1a2f",
                                                "sense_id": "89f35be3-30b8-33ef-aa6c-9e6bd0c0a327",
                                                "text": "L’instrument financier est aussi un bien en lui-même, en raison de sa forme instrumentale de titre négociable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c020def-b94e-4407-a1c0-76927e07014a",
                        "source_entry_id": "63088ab9-5837-30ff-a091-e074e3c8b515",
                        "source_sense_description": "open to negotiation or bargaining",
                        "target_lang_word": "verhandelbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verhandelbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4076e56c-fdb5-312e-a388-0602f83dcad0",
                                        "entry_id": "886131a1-e6b5-3807-832f-cf75477b8119",
                                        "glosses": [
                                            "noch nicht festgelegt, nach Diskussion veränderbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfdc1ab7-772b-4440-b58e-3c70bd25937b",
                                                "sense_id": "4076e56c-fdb5-312e-a388-0602f83dcad0",
                                                "text": "„Da die Warenanbieter jederzeit austauschbar und auch die Preise jederzeit neu verhandelbar waren, war insbesondere aufgrund der speziellen Konkurrenz- und Produktionssituation sowie der speziellen Kundenstruktur die persönliche Arbeitsleistung des Klägers zur Aufrechterhaltung des konkreten Betriebes erforderlich gewesen.“"
                                            },
                                            {
                                                "example_id": "f9c049cc-3f05-4be1-88e1-04051c4fdfec",
                                                "sense_id": "4076e56c-fdb5-312e-a388-0602f83dcad0",
                                                "text": "„Es ist an dieser Stelle auch Schmid nicht zu unterstellen, dass dieses Werte verhandelbar und subjektiv zu füllen sind, zumal sie im europäischen Rahmen rechtlich geschützt sind.“"
                                            },
                                            {
                                                "example_id": "55518e70-5e57-4550-8ab6-f9e96b31f166",
                                                "sense_id": "4076e56c-fdb5-312e-a388-0602f83dcad0",
                                                "text": "„Kummer ist nicht verhandelbar, Betroffenheit kann man Menschen weder verordnen noch absprechen.“"
                                            },
                                            {
                                                "example_id": "1a1c2ed0-37f8-4302-9a6c-fcb2df7da9ee",
                                                "sense_id": "4076e56c-fdb5-312e-a388-0602f83dcad0",
                                                "text": "„[Die Entscheidungsprämissen] sind nicht direkt kommunizierbar und nicht verhandelbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
