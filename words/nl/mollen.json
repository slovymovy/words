                            "target_lang_translations": {
                                "en": "The drunk youths <w>trashed</w> the entire tent after the party."
                            }
                        },
                        {
                            "text": "Als je niet voorzichtig bent, ga je die dure computer nog <w>mollen</w>.",
                            "target_lang_translations": {
