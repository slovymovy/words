                                        "examples": [
                                            {
                                                "example_id": "cff1c878-83cb-4d48-bbd0-04bad8bcd70e",
                                                "sense_id": "a02cf968-e783-331c-8350-0962cf66f620",
                                                "text": "Ich war höchst überrascht, dass die Wahl so ausgegangen ist."
                                            },
                                            {
                                                "example_id": "2d4c3594-748b-49ab-8d31-771428897171",
                                                "sense_id": "a02cf968-e783-331c-8350-0962cf66f620",
                                                "text": "„Ebenso sensibel für Empfindlichkeiten regierte Theoderich seine höchst unterschiedlichen Untertanen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
