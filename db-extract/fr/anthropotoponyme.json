                "senses": [
                    {
                        "sense_id": "3edf11f0-f4bd-325e-a9a5-17390eac5859",
                        "entry_id": "e6c75c65-efb5-3599-bf91-d007bb9cee31",
                        "glosses": [
                            "Toponyme portant le nom d’une personne."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "c9abe2f9-c852-48ea-8002-1e23eca0d945",
                                "sense_id": "3edf11f0-f4bd-325e-a9a5-17390eac5859",
                                "text": "L’identité individuelle se décline sous la forme de l’anthropotoponyme (ex. : Mont Adéla-Lessard, Lac Charlotte, Barrage Daniel-Johnson, Lac Aurélien) tandis que l’identité sociale et culturelle se manifeste par des toponymes évoquant la famille."
                            }
                        ]
                    },
                    {
                        "sense_id": "830d4aa7-9777-3c32-bf23-e3c598c5fa70",
                        "entry_id": "e6c75c65-efb5-3599-bf91-d007bb9cee31",
                        "glosses": [
                            "Nom de personne renvoyant à une origine géographique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d79b7c-b6c2-47b8-85e9-880cfe0719f6",
                                "sense_id": "830d4aa7-9777-3c32-bf23-e3c598c5fa70",
                                "text": "DANYACH est un anthropotoponyme (un nom de personne venant d’un nom de lieu) comme DUNYACH et les deux patronymes sont originellement occitans."
                            }
                        ]
                    }
                ],
