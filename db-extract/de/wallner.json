                "senses": [
                    {
                        "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                        "entry_id": "dfedc873-e7ce-3146-aec0-a866e013ef15",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname; Vorkommen ist in Österreich höher als in Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9babf9e0-7879-4d49-a4d0-ee6797e098c4",
                                "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                                "text": "Frau Wallner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1e8f8457-8149-4f03-80e3-b53b7eee02fc",
                                "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                                "text": "Herr Wallner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f4aaf61f-dbd2-4480-b0e1-24bc901cbb4f",
                                "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                                "text": "Die Wallners fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "2d0b9de7-70c5-4d68-a37c-e2fa8b568b25",
                                "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                                "text": "Der Wallner trägt nie die Pullover, die die Wallner ihm strickt."
                            },
                            {
                                "example_id": "7f27ceea-a6ab-4408-b586-7747310dc52c",
                                "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wallner kommt, geht der Herr Wallner.“"
                            },
                            {
                                "example_id": "e07c5ef8-0429-4a8e-9e51-e3b8699cae6b",
                                "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                                "text": "Wallner kommt und geht."
                            },
                            {
                                "example_id": "ef714759-aa17-49d7-85f2-024a022faad8",
                                "sense_id": "e25a83e6-5472-3c83-8d97-4425760b978c",
                                "text": "Wallners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
