            "senses": [
                {
                    "sense_id": "e6911af8-1b6f-3694-9367-6e0a21ea46da",
                    "sense_definition": "The quality of being worthy of attention; importance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The discovery of the ancient manuscript is of great <w>significance</w> to historians.",
                            "target_lang_translations": {
                                "ru": "Открытие этой древней рукописи имеет огромное <w>значение</w> для историков.",
                                "de": "Die Entdeckung des antiken Manuskripts ist von großer <w>Bedeutung</w> für Historiker."
                            }
                        },
                        {
                            "text": "We must consider the political <w>significance</w> of this decision before moving forward.",
                            "target_lang_translations": {
                                "ru": "Мы должны оценить политическое <w>значение</w> этого решения, прежде чем двигаться дальше.",
                                "de": "Wir müssen die politische <w>Bedeutung</w> dieser Entscheidung abwägen, bevor wir fortfahren."
                            }
                        }
                    ],
                    "synonyms": [
                        "import"
                    ],
                    "antonyms": [
                        "insignificance",
                        "triviality"
                    ],
                    "common_phrases": [
                        "of great significance",
                        "historical significance",
                        "attach significance to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, заслуживающее внимания; важность.",
                        "de": "Die Eigenschaft, Aufmerksamkeit zu verdienen; Wichtigkeit."
                    },
                    "translations": {
