                "senses": [
                    {
                        "sense_id": "a6553c72-b9f4-340d-b0dd-d60cb337a9f3",
                        "entry_id": "a4d6368c-7d77-3e83-89cc-78b86716f155",
                        "glosses": [
                            "Cliquer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f1b78db1-2f76-4fd9-b17b-0619b06a72df",
                                "sense_id": "a6553c72-b9f4-340d-b0dd-d60cb337a9f3",
                                "text": "Quelques images, parce que vous le valez bien 😉 (attention, y’a des “title” sur chaque url, laissez planer la souris avant de clickouiller)"
                            },
                            {
                                "example_id": "1985ff4c-1880-4726-8775-4ea6348a977b",
                                "sense_id": "a6553c72-b9f4-340d-b0dd-d60cb337a9f3",
                                "text": "Personnellement leurs loi à la c* me gavent (et sont d’autant plus inutiles que les « bleus », pour qui je présume que cette loi a été faite, ne savent de toute manière pas faire la distinction et se demandent même parfois si les cookies n’apportent pas des malware !), et clickouiller partout pour accéder à chaque site m’enquiquine sévèrement."
                            },
                            {
                                "example_id": "a61ae34e-7527-4e83-915e-ddd8a03a7a1d",
                                "sense_id": "a6553c72-b9f4-340d-b0dd-d60cb337a9f3",
                                "text": "Autant je vois commet ça protège des robots, autant en quoi ça protège d’une VM qui clickouille toute seule ?"
                            }
                        ]
                    }
