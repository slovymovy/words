                                    {
                                        "sense_id": "9fdabc84-0ec2-3326-b249-14620179569c",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "Tilia L., drzewo liściaste z podrodziny lipowatych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b0204b5-b4bc-4edb-b65f-4b2431dd8dd6",
                                                "sense_id": "9fdabc84-0ec2-3326-b249-14620179569c",
                                                "text": "A wieczorkiem, po zachodzie słońca, gdy już wszelkie roboty będą skończone, chciałbym sobie tutaj siadywać albo tam pod lipami, patrzeć na tę wodę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d16f4794-1e53-3646-a093-48dd679a7b8a",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "drewno lipowe"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "9d297ba4-336a-3fd9-9ffa-0fdcb70db027",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "kwiat lipowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74fc1dd2-8ffd-4e0e-9862-0dc45ff102f8",
                                                "sense_id": "9d297ba4-336a-3fd9-9ffa-0fdcb70db027",
                                                "text": "Napar z lipy jest skutecznym środkiem w leczeniu grypy i przeziębienia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "80dbd08a-427b-37bf-ad97-1d54375ee18c",
                                        "entry_id": "8de40594-2504-367e-b995-eb6f04dd6ee9",
                                        "glosses": [
                                            "kłamstwo, oszustwo"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a653f86a-79f4-47a2-83de-f39f85fc0aa0",
                                                "sense_id": "80dbd08a-427b-37bf-ad97-1d54375ee18c",
                                                "text": "Ten katalog to jakaś lipa, nie kupuj nic w tym sklepie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "ff4f0d31-75ac-3e5c-987c-d0d723ecd9b1",
