                "senses": [
                    {
                        "sense_id": "fd979d6e-8bac-38d4-93d9-23b43badb89f",
                        "entry_id": "e4149aa5-37f5-3f3f-b057-37e25e6920ac",
                        "glosses": [
                            "feest dat men viert vlak voor de vastentijd waarbij men danst, zingt, bier drinkt en zich verkleedt"
                        ],
                        "tags": [
                            "feest"
                        ],
                        "examples": [
                            {
                                "example_id": "86a48f4b-f3a3-4b5b-b9c0-5ed0db70f0f9",
                                "sense_id": "fd979d6e-8bac-38d4-93d9-23b43badb89f",
                                "text": "Ali kwam anderhalf jaar geleden Nederland binnen als vluchteling uit Aleppo, nu is hij een van de prinsen van Maastricht. De 21-jarige Syriër is vanaf morgen carnavalsprins Ali d'n Ierste in Maastricht tijdens Vastelaovend – zoals ze in Limburg het carnavalsfeest noemen."
                            },
                            {
                                "example_id": "258123ff-fd94-4091-85ec-bc5dcc08ff77",
                                "sense_id": "fd979d6e-8bac-38d4-93d9-23b43badb89f",
                                "text": "In de aanloop naar het carnavalsfeest zijn er ook maatregelen genomen. Vluchtelingen hebben volgens correspondent Jeroen Wollaars bijvoorbeeld les gehad over wat het feest inhoudt."
                            },
                            {
                                "example_id": "b2463064-6934-4b11-9a07-d5df6faa9c98",
                                "sense_id": "fd979d6e-8bac-38d4-93d9-23b43badb89f",
                                "text": "In delen van Nederland is het carnavalsfeest losgebarsten. Vooral de treinen richting het zuiden zaten vol met verklede feestgangers. In sommige steden begon het katholieke feest gisteren al."
                            }
                        ]
                    }
