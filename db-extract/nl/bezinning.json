                                "example_id": "b9018dd2-9cc0-470e-9089-633608d73c1c",
                                "sense_id": "a713eeba-9d1e-3db7-bfdf-68f829aa7945",
                                "text": "Tijdens mijn vakantie in de bergen, had ik veel momenten van bezinning en innerlijke rust.",
                                "translation": "During my vacation in the mountains, I had many moments of contemplation and inner peace.",
                                "english": "During my vacation in the mountains, I had many moments of contemplation and inner peace."
                            }
                        ]
