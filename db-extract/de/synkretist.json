                "senses": [
                    {
                        "sense_id": "ef9a4737-6b91-3da3-b7ea-935f521a4fb8",
                        "entry_id": "19e4eb4f-7a77-34c3-8ecd-e419d12728af",
                        "glosses": [
                            "eine Person, der Synkretismus, also eine Vermischung von Lehr- oder Glaubenssystemen, vorgeworfen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7cf2c43-5ea8-47e2-aa63-d2f9f0c992f1",
                                "sense_id": "ef9a4737-6b91-3da3-b7ea-935f521a4fb8",
                                "text": "„Synkretisten hießen im 16. Jahrhundert die Philosophen, die zwischen Platon und Aristoteles vermitteln wollten.“"
                            },
                            {
                                "example_id": "721d7d75-aa43-4d25-b470-5b21d2a2dbc2",
                                "sense_id": "ef9a4737-6b91-3da3-b7ea-935f521a4fb8",
                                "text": "Am Ende seines Lebens war er Synkretist und identifizierte sich mit einer Art Weltseele, mit der er durch das Unterbewusstsein in Verbindung zu stehen meinte."
                            },
                            {
                                "example_id": "c9be215f-f92a-4e71-ad7e-53ed38275cb7",
                                "sense_id": "ef9a4737-6b91-3da3-b7ea-935f521a4fb8",
                                "text": "Ek[k!]lektiker und Synkretist, der er war, nahm er alles unterschiedslos als gegeben."
                            },
                            {
                                "example_id": "b08af617-ca72-4d89-ad7d-6a6f1c18a748",
                                "sense_id": "ef9a4737-6b91-3da3-b7ea-935f521a4fb8",
                                "text": "Der bekennende Synkretist und Eklektiker Hermann Nitsch, von der Kirche lange als blasphemischer Gottseibeiuns geächtet, liebt den Pomp des Mysteriums, er liebt das alte tridentinische Ritual samt Weihrauch, Latein und golddurchwirkten Messgewändern."
                            },
                            {
                                "example_id": "27e82783-138c-483e-a433-a71d384c5d5f",
                                "sense_id": "ef9a4737-6b91-3da3-b7ea-935f521a4fb8",
                                "text": "Johannes Paul II. war mit Sicherheit kein Synkretist, suchte aber das Gespräch und das Gebet mit allen Religionen im Wissen darum, dass alle Religionen im Anliegen der Orientierung an Transzendenz und im Anliegen des Schutzes der spirituellen Würde der Menschen geeint sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
