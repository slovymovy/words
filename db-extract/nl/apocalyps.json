                        "tags": [
                            "plural"
                        ],
                        "form": "apocalypsen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5995ad5a-e405-3b50-8ab1-f27fe5cf7133",
                        "entry_id": "43b9e686-7356-3cd1-960d-e6f3d54582b6",
                        "glosses": [
                            "einde van de wereld, zoals beschreven in het Bijbelboek Openbaringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8912df07-e5b4-4bd1-9fdd-f21db78fea60",
                                "sense_id": "5995ad5a-e405-3b50-8ab1-f27fe5cf7133",
                                "text": "De vier ruiters van de apocalyps."
                            },
                            {
                                "example_id": "bcff7313-e9ed-47f0-b3d9-ebe6d2316976",
                                "sense_id": "5995ad5a-e405-3b50-8ab1-f27fe5cf7133",
                                "text": "De apocalyps? Ook die is terug van weggeweest, in de koortsdromen van christelijke nationalisten en tech-miljardairs rond Trump die smachten naar het einde van de seculier-humanistische orde. Een euforisch ondergangsdenken dat Naomi Klein treffend „Eindtijdfascisme” noemt."
                            }
                        ]
                    },
                    {
                        "sense_id": "bcb851d9-90be-38a2-a3c4-ed8d221854c0",
                        "entry_id": "43b9e686-7356-3cd1-960d-e6f3d54582b6",
                        "glosses": [
                            "een zeer dramatische gebeurtenis, in het bijzonder een die nog verwacht wordt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a3078789-e9ad-4ebb-b776-7ab07f3e596e",
                                "sense_id": "bcb851d9-90be-38a2-a3c4-ed8d221854c0",
                                "text": "Angst voor een apocalyps."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6495c66-17ff-3380-86b9-a97944851ebf",
                        "entry_id": "43b9e686-7356-3cd1-960d-e6f3d54582b6",
                        "glosses": [
                            "onthulling, openbaring"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "889c9011-3798-4ea5-bce0-d72faf8a86c9",
                        "source_entry_id": "43b9e686-7356-3cd1-960d-e6f3d54582b6",
                        "source_sense_id": "5995ad5a-e405-3b50-8ab1-f27fe5cf7133",
                        "source_sense_description": "einde van de wereld, zoals beschreven in het Bijbelboek Openbaringen",
                        "target_lang_word": "Apokalypse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apokalypse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b5a98ac-b31f-35a2-9c45-6c81ec901539",
                                        "entry_id": "fdc9e21c-d01f-3f18-b493-12d3d7f6be1b",
                                        "glosses": [
                                            "prophetische Schrift, die das Weltende verkündet (insbesondere die geheime Offenbarung des Johannes im letzten Buch des Neuen Testamentes)"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d6b5c49-1b6a-40b5-a654-7413f7730d91",
                                                "sense_id": "5b5a98ac-b31f-35a2-9c45-6c81ec901539",
                                                "text": "Die Offenbarung des Johannes, auch kurz Apokalypse genannt, ist das letzte in der üblichen Aufzählung der biblischen Bücher und die einzige apokalyptische Schrift des Neuen Testamentes."
                                            },
                                            {
                                                "example_id": "45883627-6450-46cb-8733-d8a4e517a36d",
                                                "sense_id": "5b5a98ac-b31f-35a2-9c45-6c81ec901539",
                                                "text": "„Unverständlich und sogar lächerlich erschien ihm jetzt sein Mordplan gegen Napoleon und die Berechnungen, die er mit der kabbalistischen Zahl und dem Tier aus der Apokalypse angestellt hatte.“"
                                            },
                                            {
                                                "example_id": "6ad8f822-e24a-47c3-939e-e17745cee3e9",
                                                "sense_id": "5b5a98ac-b31f-35a2-9c45-6c81ec901539",
                                                "text": "„Der Krug enthielt Evangelien und Apokalypsen, Gebete und weitere Schriften auf Papyrus, gebündelt zu mehr als einem Dutzend Kodizes.“"
                                            },
                                            {
                                                "example_id": "f04a1de8-5f6b-4cf1-a553-5f8e8d29f5d4",
                                                "sense_id": "5b5a98ac-b31f-35a2-9c45-6c81ec901539",
                                                "text": "„Es bestand aus 222 Folioblättern (Satzspiegel 13,6 x 24,3 cm), und die Apokalypse war illustriert mit Abwandlungen der Holzstiche von Dürers Zyklus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff4588c5-b082-3f10-a351-a945abf94616",
                                        "entry_id": "fdc9e21c-d01f-3f18-b493-12d3d7f6be1b",
                                        "glosses": [
                                            "fürchterliche Katastrophe, grauenhaftes Unheil, Untergang"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fa51cef-da62-4d1b-8f75-040b7a034fd4",
                                                "sense_id": "ff4588c5-b082-3f10-a351-a945abf94616",
                                                "text": "„Insbesondere junge Literaten des Expressionismus machten ihrem Verdruß über die verknöcherte Gesellschaft durch Herbeirufen der Apokalypse Luft.“"
                                            },
                                            {
                                                "example_id": "66168397-b08c-458e-b0d4-e35776aa4f40",
                                                "sense_id": "ff4588c5-b082-3f10-a351-a945abf94616",
                                                "text": "„Wir lebten in einer Zeit, in der jeder Messias, jede Apokalypse möglich waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b5d3c88-d091-4ca0-ae6d-b623bc80c942",
                        "source_entry_id": "43b9e686-7356-3cd1-960d-e6f3d54582b6",
                        "source_sense_id": "5995ad5a-e405-3b50-8ab1-f27fe5cf7133",
                        "source_sense_description": "einde van de wereld, zoals beschreven in het Bijbelboek Openbaringen",
                        "target_lang_word": "apocalypse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apocalypse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "833933bf-0080-3ae0-85fe-8fca55d2406f",
                                        "entry_id": "5d77476b-60b5-3ee9-b4e2-c48b0d449409",
                                        "glosses": [
                                            "A revealing, especially a prophecy of, or the unfolding of, supernatural events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bb8a9bb-8790-4bab-9a19-7cbfcb308ae8",
                                                "sense_id": "833933bf-0080-3ae0-85fe-8fca55d2406f",
                                                "text": "The early development of Perl 6 was punctuated by a series of apocalypses by Larry Wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d31ef8-c829-3773-bfbb-b880f916f3cf",
                                        "entry_id": "5d77476b-60b5-3ee9-b4e2-c48b0d449409",
                                        "glosses": [
                                            "A huge disaster; a cataclysmic event; destruction or ruin of large scope and scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da8a5cf-3038-4043-b113-f0297b276f7d",
                                                "sense_id": "52d31ef8-c829-3773-bfbb-b880f916f3cf",
                                                "text": "Near-synonyms: cataclysm, catastrophe, holocaust; armageddon, doomsday, end times, eschaton, judgement day, judgment day"
                                            },
                                            {
                                                "example_id": "6c6360b2-c2a3-46b9-9182-54b8bc7c89cc",
                                                "sense_id": "52d31ef8-c829-3773-bfbb-b880f916f3cf",
                                                "text": "A nuclear apocalypse would have been possible if tensions went out of control during the Cuban Missile Crisis."
                                            },
                                            {
                                                "example_id": "9869e882-4114-4a21-a273-52117fb9ea9d",
                                                "sense_id": "52d31ef8-c829-3773-bfbb-b880f916f3cf",
                                                "text": "Man has forgotten the soul and thus doomed his civilization to apocalypse."
                                            },
                                            {
                                                "example_id": "f1cdac7b-4c00-43cc-b28a-cbea86ae6847",
                                                "sense_id": "52d31ef8-c829-3773-bfbb-b880f916f3cf",
                                                "text": "The Spanish mission in America soon became not so much crusade as apocalypse."
                                            },
                                            {
                                                "example_id": "bce97978-230b-4974-8631-d8a0bb2da36f",
                                                "sense_id": "52d31ef8-c829-3773-bfbb-b880f916f3cf",
                                                "text": "In 2016, President Barack Obama told his staff that Donald Trump’s election victory was “not the apocalypse”. By any definition, he was correct. But understood in the original sense of the Greek word apokálypsis, meaning “unveiling”, Obama could not give the same reassurance in 2025."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c87233d5-bba3-3265-8de9-5799c9be9f19",
                                        "entry_id": "5d77476b-60b5-3ee9-b4e2-c48b0d449409",
                                        "glosses": [
                                            "The unveiling of events prophesied in the Revelation; the second coming and the end of life on Earth; global destruction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd05728-0ecc-431a-ab0a-1621853e824f",
                                                "sense_id": "c87233d5-bba3-3265-8de9-5799c9be9f19",
                                                "text": "Meronyms: Final Judgment, Judgment Day, judgement day, judgment day"
                                            },
                                            {
                                                "example_id": "6dfe4026-cbbc-44b2-9b9f-0b6d05fe55c1",
                                                "sense_id": "c87233d5-bba3-3265-8de9-5799c9be9f19",
                                                "text": "Near-synonym: Ragnarok"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bcc0949-5bcd-34f9-9daa-768d9c51b7cb",
                                        "entry_id": "5d77476b-60b5-3ee9-b4e2-c48b0d449409",
                                        "glosses": [
                                            "The Book of Revelation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "035cb645-4918-4a0c-a33c-1e8223eae64d",
                        "source_entry_id": "43b9e686-7356-3cd1-960d-e6f3d54582b6",
                        "source_sense_id": "5995ad5a-e405-3b50-8ab1-f27fe5cf7133",
                        "source_sense_description": "einde van de wereld, zoals beschreven in het Bijbelboek Openbaringen",
                        "target_lang_word": "apocalypse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apocalypse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ba526da-3abb-3ecf-bf44-ef1657ea0e69",
                                        "entry_id": "c2f7e09b-0b01-3d53-a937-3164056d93fd",
                                        "glosses": [
                                            "Genre littéraire très prisé par les juifs (du Iᵉʳ siècle av. J.-C. au Iᵉʳ siècle de notre ère), et les judéo-chrétiens au Iᵉʳ siècle de notre ère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94643a34-f177-4268-8dbb-084dbdbc1839",
                                                "sense_id": "4ba526da-3abb-3ecf-bf44-ef1657ea0e69",
                                                "text": "Cette idéologie ne se serait certainement pas formée d’une manière aussi para­doxale, si on n’avait cru fermement aux catastrophes décrites par les nombreuses apocalypses qui furent composées à la fin du Iᵉʳ siècle et au commencement du IIᵉ ; on était persuadé que le monde allait être livré complètement au règne du mal et que le Christ viendrait ensuite donner la victoire définitive à ses élus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ce0b22b-ba7e-3541-a1a7-7fea6ce79c38",
                                        "entry_id": "c2f7e09b-0b01-3d53-a937-3164056d93fd",
                                        "glosses": [
                                            "Chose mystérieuse, cachée."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d35aa1-5657-406d-a5c0-833d962e6ffb",
                                                "sense_id": "7ce0b22b-ba7e-3541-a1a7-7fea6ce79c38",
                                                "text": "Un style d’Apocalypse est un style obscur."
                                            },
                                            {
                                                "example_id": "7531d4ab-1744-4ef6-ac4b-99e0cca1296e",
                                                "sense_id": "7ce0b22b-ba7e-3541-a1a7-7fea6ce79c38",
                                                "text": "À merveille! s’écria Athos, vous êtes le roi des poètes; mon cher Aramis, vous parlez comme l’Apocalypse et vous êtes vrai comme l’évangile. Il ne vous reste maintenant que l’adresse à mettre sur cette lettre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e3d352a-a72b-397a-994e-e89db0ea1c35",
                                        "entry_id": "c2f7e09b-0b01-3d53-a937-3164056d93fd",
                                        "glosses": [
                                            "Fin du monde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2dc32a-c754-400e-ba15-9ef4daf09a17",
                                                "sense_id": "3e3d352a-a72b-397a-994e-e89db0ea1c35",
                                                "text": "Mais, d’après les archéologues, rien n’indiquerait la fin du monde pour 2012, comme le prétendent les tenants d’un tout proche cataclysme. Bien au contraire. Les tables calendaires de Xultun, datées du IXᵉ siècle, se projettent en réalité sur plus de 6,000 ans. L’apocalypse, selon les Mayas, n’est donc pas pour demain !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025266b2-b044-3c84-864a-cd6e6bd1a8c3",
                                        "entry_id": "c2f7e09b-0b01-3d53-a937-3164056d93fd",
                                        "glosses": [
                                            "Catastrophe générale comparable à la fin du monde."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c49f201-2a1a-47ac-86d5-548c8be14633",
                                                "sense_id": "025266b2-b044-3c84-864a-cd6e6bd1a8c3",
                                                "text": "Une guerre nucléaire déclencherait une apocalypse."
                                            }
                                        ]
                                    }
                                ]
                            },
