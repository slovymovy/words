                        "titre de propriété",
                        "droit de propriété"
                    ]
                },
                {
                    "sense_id": "58e7ba4b-849e-3456-8188-ec611a4666fb",
                    "sense_definition": "Bien immobilier constitué d'un terrain ou d'une maison avec ses dépendances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "immobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes grands-parents possèdent une vaste <w>propriété</w> entourée de vignes dans le sud de la France."
                        },
                        {
                            "text": "Un haut mur de pierre délimite la <w>propriété</w> et protège les habitants des regards indiscrets."
                        }
                    ],
                    "common_phrases": [
