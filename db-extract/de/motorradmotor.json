                        "glosses": [
                            "Motor, der als Antriebsmotor eines Motorrads verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50103400-47d3-4fc6-b7e4-3e836f5a6af3",
                                "sense_id": "92e576ca-4f8e-3399-80b2-a95690204e23",
                                "text": "„Denn es war gar nicht so einfach, den Antrieb nach hinten zu verlagern, den Motorradmotor mit einem automobilen Renngetriebe zu verheiraten und die unterschiedlichen Schaltkreise miteinander zu verknüpfen, erzählt er von den Kniffen der Konstruktion.“"
                            },
                            {
                                "example_id": "972aa5c3-7993-4007-8fcb-8707793fb605",
                                "sense_id": "92e576ca-4f8e-3399-80b2-a95690204e23",
                                "text": "„Ein Motorradmotor treibt den Rennwagen \"TUfast\" der Maschinenbaustudenten der TU Garching an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
