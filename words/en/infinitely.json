    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a1e0d160-bd1c-3d17-8e5b-677037f45d61",
                    "sense_definition": "In an endless manner without any bounds or limits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The universe seems to expand <w>infinitely</w> in all directions.",
                            "target_lang_translations": {
                                "nl": "Het universum lijkt zich in alle richtingen <w>oneindig</w> uit te breiden."
                            }
                        },
                        {
                            "text": "The stars appear to twinkle <w>infinitely</w> across the night sky.",
                            "target_lang_translations": {
                                "nl": "De sterren lijken <w>oneindig</w> te fonkelen aan de nachtelijke hemel."
                            }
                        }
                    ],
                    "synonyms": [
                        "ceaselessly",
                        "incessantly",
                        "nonstop",
                        "continuously"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een eindeloze manier, zonder enige grenzen of beperkingen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "oneindig",
                                "target_lang_sense_clarification": "verwijzend naar iets zonder einde of limiet"
                            },
                            {
                                "target_lang_word": "onbegrensd",
                                "target_lang_sense_clarification": "zonder enige vorm van begrenzing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3196ad2f-f6ae-34ac-9af3-708252cfcb9d",
                    "sense_definition": "To a very great or extreme degree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "infinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>infinitely</w> more capable than his predecessor.",
                            "target_lang_translations": {
                                "nl": "Hij is <w>oneindig</w> veel capabeler dan zijn voorganger."
                            }
                        },
                        {
                            "text": "Modern technology has <w>infinitely</w> improved our access to information.",
                            "target_lang_translations": {
                                "nl": "Moderne technologie heeft onze toegang tot informatie <w>oneindig</w> verbeterd."
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "utterly",
                        "completely"
                    ],
                    "target_lang_definitions": {
                        "nl": "In zeer grote of extreme mate."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "oneindig",
                                "target_lang_sense_clarification": "gebruikt als versterker voor een eigenschap"
                            },
                            {
                                "target_lang_word": "bijzonder",
                                "target_lang_sense_clarification": "in hoge mate"
                            },
                            {
                                "target_lang_word": "stukken",
                                "target_lang_sense_clarification": "informeel, gebruikt bij vergelijkingen"
                            }
                        ]
                    }
                }
            ]
        }
