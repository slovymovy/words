                    },
                    {
                        "sense_id": "a19e4ebc-f8a7-3f20-900d-7cdc661e36e0",
                        "entry_id": "aff3cc02-3213-3d80-9336-0fea97167755",
                        "glosses": [
                            "The mathematical equivalence of two seemingly different theoretical descriptions of a physical system."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2d29401-a586-402e-8f17-3415fa1a57b7",
                                "sense_id": "a19e4ebc-f8a7-3f20-900d-7cdc661e36e0",
                                "text": "wave-particle duality"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cf3cf70-5cb9-49e9-83b3-a18c60ae32a3",
                        "source_entry_id": "aff3cc02-3213-3d80-9336-0fea97167755",
                        "source_sense_description": "classification into two subclasses or opposed parts",
                        "target_lang_word": "dualité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dualité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85f90cdb-3bf1-3ed2-abf0-e71b998f337f",
                                        "entry_id": "5323ba7c-ceb4-371c-8bdf-edca553bfe39",
                                        "glosses": [
                                            "Caractère ou état de ce qui est double."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b44abe8-aa88-49ae-9375-abf349cd8de6",
                                                "sense_id": "85f90cdb-3bf1-3ed2-abf0-e71b998f337f",
                                                "text": "Ainsi, comme il y a deux principes, l'un mâle et l'autre femelle, l'un actif et l'autre passif, dans toute dualité, quelle qu'elle soit, l'un des termes sera mâle et actif, l'autre passif et femelle ; […]."
                                            },
                                            {
                                                "example_id": "60f6e2e5-8726-4a8f-82d5-874817194de1",
                                                "sense_id": "85f90cdb-3bf1-3ed2-abf0-e71b998f337f",
                                                "text": "– Comment expliquez-vous, monsieur le professeur, me dit-il brusquement vers la fin du dîner, comment expliquez-vous la dualité ou la duplicité de notre nature ?…\nEt, comme il s'aperçut que je ne le comprenais pas parfaitement, il reprit :\n– Ne vous êtes-vous jamais trouvé au haut d'une tour ou bien au bord d'un précipice, ayant à la fois la tentation de vous élancer dans le vide et un sentiment de terreur absolument contraire ?…"
                                            },
                                            {
                                                "example_id": "411db5b3-eb89-4d6a-b8bd-7e7f8895ee6c",
                                                "sense_id": "85f90cdb-3bf1-3ed2-abf0-e71b998f337f",
                                                "text": "Je cherchai donc à me représenter la dualité onde-corpuscule par une image spatiale où le corpuscule serait le centre d'un phénomène ondulatoire étendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13fd1965-955b-3e7c-9c75-ec165023da8e",
                                        "entry_id": "5323ba7c-ceb4-371c-8bdf-edca553bfe39",
                                        "glosses": [
                                            "Fait d'être dual pour un graphe."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08715a39-db1c-4fe5-a611-aa9c2468810c",
                        "source_entry_id": "aff3cc02-3213-3d80-9336-0fea97167755",
                        "source_sense_description": "classification into two subclasses or opposed parts",
