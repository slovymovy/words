                {
                    "sense_id": "24b7cb1a-3291-3c38-af6c-943edb70819b",
                    "sense_definition": "Sert à introduire une restriction ou une nuance : cependant, néanmoins.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a promis de venir, <w>maintenant</w> rien ne prouve qu'il tiendra parole.",
                            "target_lang_translations": {
                                "en": "He promised to come; <w>however</w>, nothing proves that he will keep his word.",
                                "ru": "Он обещал прийти, <w>однако</w> ничто не доказывает, что он сдержит слово.",
                                "nl": "Hij heeft beloofd te komen; niets bewijst <w>echter</w> dat hij zijn woord zal houden.",
                                "de": "Er hat versprochen zu kommen. <w>Doch</w> nichts beweist, dass er sein Wort halten wird.",
                                "pl": "Obiecał przyjść, <w>jednak</w> nic nie dowodzi, że dotrzyma słowa.",
                                "it": "Ha promesso di venire; <w>tuttavia</w>, nulla dimostra che manterrà la parola.",
                                "cs": "Slíbil, že přijde; <w>ovšem</w> nic nedokazuje, že slib dodrží.",
                                "tr": "Gelmeye söz verdi, <w>ancak</w> sözünü tutacağını gösterecek hiçbir şey yok.",
                                "es": "Prometió venir; <w>sin embargo</w>, nada demuestra que cumplirá su palabra.",
                                "zh": "他答应要来，<w>不过</w>没有任何迹象表明他会守约。"
                            }
                        },
                        {
                            "text": "C'est un bon candidat ; <w>maintenant</w>, je doute qu'il accepte ce salaire.",
                            "target_lang_translations": {
                                "en": "He's a good candidate; <w>that said</w>, I doubt he'll accept this salary.",
                                "ru": "Это хороший кандидат; <w>впрочем</w>, я сомневаюсь, что он согласится на такую зарплату.",
                                "nl": "Hij is een goede kandidaat; <w>overigens</w> betwijfel ik of hij dit salaris zal accepteren.",
                                "de": "Er ist ein guter Kandidat; <w>allerdings</w> bezweifle ich, dass er dieses Gehalt akzeptiert.",
                                "pl": "To dobry kandydat; <w>jednak</w> wątpię, czy zaakceptuje to wynagrodzenie.",
                                "it": "È un buon candidato; <w>detto questo</w>, dubito che accetti questo stipendio.",
                                "cs": "Je to dobrý kandidát; <w>nicméně</w> pochybuji, že tenhle plat přijme.",
                                "tr": "İyi bir aday; <w>bununla birlikte</w>, bu maaşı kabul edeceğinden şüpheliyim.",
                                "es": "Es un buen candidato; <w>ahora bien</w>, dudo que acepte este salario.",
                                "zh": "他是个不错的候选人；<w>但是</w>，我怀疑他不会接受这份薪水。"
                            }
                        }
