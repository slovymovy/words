                                "target_senses": [
                                    {
                                        "sense_id": "7c1c643c-e6f5-379e-abdb-d0dc7c1d009a",
                                        "entry_id": "28ea0f41-d875-3f41-96a6-589a5475da23",
                                        "glosses": [
                                            "Table en céramique, en métal ou en pierre, comportant un bassin creusé dans lequel on lave la vaisselle, et qui a un trou pour l’écoulement des eaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437e8460-45c7-4353-85cb-78b3b503cfb4",
                                                "sense_id": "7c1c643c-e6f5-379e-abdb-d0dc7c1d009a",
                                                "text": "Des devis vont être également demandés à des entreprises afin de changer certains éléments vétustes de six appartements : les baignoires à remplacer par des douches à l’italienne, des lavabos, des éviers et la robinetterie."
                                            },
                                            {
                                                "example_id": "134bf7c3-a10d-41ac-86e1-231a50387723",
                                                "sense_id": "7c1c643c-e6f5-379e-abdb-d0dc7c1d009a",
                                                "text": "Elle mouchait la chandelle qui clairait sur le bord de l’évier, quand la porte s'ouvrit."
                                            },
                                            {
                                                "example_id": "1b796e29-4fbd-4675-b1ff-11c2d93a65a0",
                                                "sense_id": "7c1c643c-e6f5-379e-abdb-d0dc7c1d009a",
                                                "text": "Après avoir raclé le fond de mousseline de saumon, Victor emporta la calotte vide vers les éviers."
                                            },
                                            {
                                                "example_id": "a27653f6-b624-4ff2-b568-967a4a4877c5",
                                                "sense_id": "7c1c643c-e6f5-379e-abdb-d0dc7c1d009a",
                                                "text": "Je gagnai le vestibule à tâtons, entre la cuisine et la buanderie. Je cherchais toujours. Disparue, l’essoreuse à linge, remplacé, l'ancien lavoir. À la place, un évier moderne."
                                            },
                                            {
                                                "example_id": "b40ae6b5-64ab-4c3d-8601-74926ece44e9",
                                                "sense_id": "7c1c643c-e6f5-379e-abdb-d0dc7c1d009a",
                                                "text": "Vous pouvez aller prendre un café si ça vous dit, j'en ai une pleine cafetière. Vous trouverez les tasses dans le placard au-dessus de l’évier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6866da12-9d31-3b0f-8077-6c569f28657a",
                                        "entry_id": "28ea0f41-d875-3f41-96a6-589a5475da23",
                                        "glosses": [
                                            "Rigole d'écoulement des eaux pluviales, caniveau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
