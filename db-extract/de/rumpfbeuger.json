                "senses": [
                    {
                        "sense_id": "69956784-5084-319a-9ff9-eca27a889bc7",
                        "entry_id": "f5ea8bfb-403e-3269-ba2d-a2610cf9f4bc",
                        "glosses": [
                            "Muskelgruppe zur Beugung des Rumpfes, die vom Schädel bis zum Becken als Gegenspieler des dorsalen Rückenstranges unterhalb bzw. ventral der Wirbelsäule verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b551c47b-aaa1-454f-ae21-0b90d20b3b83",
                                "sense_id": "69956784-5084-319a-9ff9-eca27a889bc7",
                                "text": "„Die Gegenpsieler des dorsalen Rückenstranges sind die unterhalb (ventral) der Wirbelsäule verlaufenden, gleichfalls vom Schädel bis zum Becken reichenden Rumpfbeuger.“"
                            },
                            {
                                "example_id": "c5523902-535b-4ae3-ac9a-5ed266979b7c",
                                "sense_id": "69956784-5084-319a-9ff9-eca27a889bc7",
                                "text": "„Es empfiehlt sich die vorrangige Kräftigung der Hüft- und Rumpfbeuger im ausgewogenen Verhältnis zu deren Antagonisten (Hüft- und Rumpfstrecker).“"
                            },
                            {
                                "example_id": "a8d19c34-c3ad-4d0f-9719-2133b86e70cb",
                                "sense_id": "69956784-5084-319a-9ff9-eca27a889bc7",
                                "text": "„Diese Muskelgruppe der Rumpfbeuger besteht nur aus einer Handvoll Muskeln – kein Vergleich zu der Vielzahl der Rücken oder der Schultermuskeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad38228a-4ae7-38b2-8e3c-a1d04948f44e",
                        "entry_id": "f5ea8bfb-403e-3269-ba2d-a2610cf9f4bc",
                        "glosses": [
                            "Fitnessgerät, an dem man die Beugemuskulatur des Rumpfes (unter anderem die Bauchmuskulatur) trainieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dabfa1a7-b57d-4fe6-a41f-20de9a4fb265",
                                "sense_id": "ad38228a-4ae7-38b2-8e3c-a1d04948f44e",
                                "text": "„Der Rumpfbeuger sorgt für ein starkes Körperzentrum, indem insbesondere die oft vernachlässigte Taille beansprucht wird (obliquus externus, obliquus internus, quadratus lumborum). Diese Übung kann im Fitnesscenter mithilfe eines Trainingsgerätes durchgeführt werden. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
