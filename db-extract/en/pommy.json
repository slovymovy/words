                "senses": [
                    {
                        "sense_id": "933eb6b7-505a-3ae2-8c38-37e7bb05c1cd",
                        "entry_id": "e163a908-b43c-380d-8d44-79fde7b2b6cb",
                        "glosses": [
                            "English; British."
                        ],
                        "tags": [
                            "Australia",
