                "senses": [
                    {
                        "sense_id": "6d17e27e-1400-3f0b-b9ee-cff44dbc3032",
                        "entry_id": "4495a82d-61cd-38aa-9cda-746706077aa5",
                        "glosses": [
                            "Bavard ; beau parleur ; personne qui baratine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9907fc-ba4d-4b1f-951b-31b6ee2cc667",
                                "sense_id": "6d17e27e-1400-3f0b-b9ee-cff44dbc3032",
                                "text": "Eh bien, j'ai le plaisir, preuve à l'appui, de m'inscrire en faux contre cette maligne assertion. Ceux qui l'affirment, l'assènent à tout bout de champ, le proclament à l'envi ont la langue plus fourchue que vipère aspic, ils galèjent mieux que Marseillais à la pétanque, ils ne sont que vils baratineurs, ils mythonent, pipeautent, racontent des craques ou accrochent des paletots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e863a867-cf51-441c-b886-6b5d7de1b056",
                        "source_entry_id": "4495a82d-61cd-38aa-9cda-746706077aa5",
                        "source_sense_id": "6d17e27e-1400-3f0b-b9ee-cff44dbc3032",
                        "target_lang_word": "Schmeichler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmeichler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51b4fea8-cd2c-337e-8822-350e9a3f1bc6",
                                        "entry_id": "952628bb-dfd5-37d1-b2fa-17aa82d3842e",
                                        "glosses": [
                                            "Person, die in übertriebener Weise jemandem Komplimente macht, Gutes über jemanden verbreitet, eventuell auch nur, um sich Wohlwollen, Zuneigung zu sichern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2574078-3828-4ca8-b25c-d99b31ae4394",
                                                "sense_id": "51b4fea8-cd2c-337e-8822-350e9a3f1bc6",
                                                "text": "Er war der perfekte Schmeichler und die Frauen lagen ihm zu Füßen."
                                            },
                                            {
                                                "example_id": "4ebc0220-9638-4f12-9558-f8e8972e998b",
                                                "sense_id": "51b4fea8-cd2c-337e-8822-350e9a3f1bc6",
                                                "text": "„Der Bauer stand mit seiner Familie allein und bedrückt in einer Ecke, da er keine Schmeichler hatte, weder Freunde noch versteckte Feinde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "602ff5ab-4410-40ee-b1f6-4a9cf8cb8795",
                        "source_entry_id": "4495a82d-61cd-38aa-9cda-746706077aa5",
