                        "glosses": [
                            "Having no arms."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9390c824-792b-4471-869a-9a2e82a35588",
                                "sense_id": "02200478-f5ca-3e30-b7f4-e90bbc8f1d6d",
                                "text": "When you have been waited on by armless hands, and have had a short conversation with a cat, nothing can surprise you much."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a5de961-dbfd-4d4f-a1fa-827125dafe66",
