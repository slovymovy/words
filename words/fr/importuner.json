            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c375104b-bac4-3b1e-98e1-ee11ed3ba20a",
                    "sense_definition": "Déranger ou fatiguer quelqu'un par une présence insistante, des demandes ou des propos intempestifs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "derangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pardonnez-moi de vous <w>importuner</w> si tard, mais j'ai une question urgente à vous poser."
                        },
                        {
                            "text": "Cet individu a été arrêté après avoir <w>importuné</w> plusieurs passants dans la rue commerçante."
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "embêter",
                        "ennuyer"
                    ],
                    "common_phrases": [
                        "craindre d'importuner",
                        "sans vouloir importuner",
                        "importuner les passants"
                    ]
                },
                {
                    "sense_id": "60070dfa-cfd1-3a2b-9dca-7c35f8815f4c",
                    "sense_definition": "Causer une gêne ou un désagrément, en parlant d'un bruit, d'un événement ou d'une pensée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "derangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bourdonnement constant des travaux voisins finit par <w>importuner</w> tous les résidents de l'immeuble."
                        },
                        {
                            "text": "Ce triste souvenir l'<w>importunait</w> chaque fois qu'elle passait devant son ancienne maison."
                        }
                    ],
                    "synonyms": [
                        "agacer",
                        "ennuyer"
                    ],
                    "common_phrases": [
                        "bruit qui importune"
                    ]
                }
            ]
        }
