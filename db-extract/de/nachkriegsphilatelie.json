                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35eebe62-1d94-4dac-99f6-e1319eefb5c0",
                                "sense_id": "4248dab7-0261-37e0-912c-c37a0f380e1c",
                                "text": "„Somit ist es im 70. Jahr nach Erscheinen der ersten Notopfermarken im Dezember 1948 gelungen, eine veritable Neuentdeckung zu diesem äußerst interessanten Gebiet der deutschen Nachkriegsphilatelie zu tätigen.“"
                            },
                            {
                                "example_id": "aba2fe68-8650-4a10-b09c-426a53e5a634",
                                "sense_id": "4248dab7-0261-37e0-912c-c37a0f380e1c",
                                "text": "„Hier hatte die Nachkriegsphilatelie schon begonnen.“"
                            },
                            {
                                "example_id": "090bbcf2-4539-4dc3-be5e-103706c9edb5",
                                "sense_id": "4248dab7-0261-37e0-912c-c37a0f380e1c",
                                "text": "„Unter diesem Namen schaffte es der graphisch wie handwerklich talentierte Fälscher, in die Geschichte der deutschen Nachkriegsphilatelie einzugehen.“"
                            }
