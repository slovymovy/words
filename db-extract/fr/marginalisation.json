                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef266a0-0e3e-419f-a601-380ddd893aea",
                                                "sense_id": "507f0a74-ae76-353b-988d-12a9490478b9",
                                                "text": "A falta de acesso à educação contribui para a marginalização de comunidades vulneráveis"
                                            }
                                        ]
