                "senses": [
                    {
                        "sense_id": "6074c2e5-3aec-3d06-8927-1b9d110ab080",
                        "entry_id": "34c272a6-4042-34b6-b65b-074d1f9b881f",
                        "glosses": [
                            "Bestandsaufnahme eines Inventars, Erstellen einer Inventarliste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31d1145-dd95-453d-9854-b1c1be72ae6b",
                                "sense_id": "6074c2e5-3aec-3d06-8927-1b9d110ab080",
                                "text": "Als Konservator am Institut für Denkmalpflege der DDR war er von 1987 bis 1990 für die Inventarisation und praktische Denkmalpflege in Ostberlin und im Bezirk Potsdam zuständig."
                            },
                            {
                                "example_id": "d5a7dbd0-e1f2-4886-a3b0-d11163f8d706",
                                "sense_id": "6074c2e5-3aec-3d06-8927-1b9d110ab080",
                                "text": "Den ersten Versuch einer Inventarisierung aller deutschen Kulturdenkmale unternahm Georg Dehio."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14db2a41-63f0-471b-a876-65b6238ee621",
                        "source_entry_id": "34c272a6-4042-34b6-b65b-074d1f9b881f",
                        "source_sense_id": "6074c2e5-3aec-3d06-8927-1b9d110ab080",
                        "source_sense_description": "Bestandsaufnahme eines Inventars, Erstellen einer Inventarliste",
                        "target_lang_word": "inventory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76078b01-dd62-3ea8-8393-3bf9deef384a",
                                        "entry_id": "5a87abc7-c79f-30fe-b693-554d14afbd2c",
                                        "glosses": [
                                            "The stock of an item on hand at a particular location or business."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f905dd6-7c8b-4948-b4ee-a60497fc3bbe",
                                                "sense_id": "76078b01-dd62-3ea8-8393-3bf9deef384a",
                                                "text": "Due to an undersized inventory at the Boston outlet, customers had to travel to Providence to find the item."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb99c8bf-c7e5-3ac0-9766-a3b80e22cc23",
                                        "entry_id": "5a87abc7-c79f-30fe-b693-554d14afbd2c",
                                        "glosses": [
                                            "A detailed list of all of the items on hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b658e5d5-cfc5-41d5-bb3c-acf3d8e63c81",
                                                "sense_id": "cb99c8bf-c7e5-3ac0-9766-a3b80e22cc23",
                                                "text": "The inventory included several items that one wouldn't normally think to find at a cheese shop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3af549a9-160f-3633-8ce2-401d99d00882",
                                        "entry_id": "5a87abc7-c79f-30fe-b693-554d14afbd2c",
                                        "glosses": [
                                            "The process of producing or updating such a list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097b6f0f-1d2d-4fdf-9ef9-18f62511a59a",
                                                "sense_id": "3af549a9-160f-3633-8ce2-401d99d00882",
                                                "text": "This month's inventory took nearly three days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43ff13e1-b460-345c-8272-d6132c4263bd",
                                        "entry_id": "5a87abc7-c79f-30fe-b693-554d14afbd2c",
                                        "glosses": [
                                            "A space containing the items available to a character, especially in a video game, for immediate use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8b7c9b7-cedb-4af7-87a1-25101f9e7fc3",
                                                "sense_id": "43ff13e1-b460-345c-8272-d6132c4263bd",
                                                "text": "You can't get through the underground tunnel if there are more than three items in your inventory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a612e07c-0b54-38b4-909a-35f30012ee09",
                                        "entry_id": "5a87abc7-c79f-30fe-b693-554d14afbd2c",
                                        "glosses": [
                                            "The total set of a (specified) linguistic feature (within a language etc.)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f10e66d-1617-473e-8b5a-889528308c6d",
                                                "sense_id": "a612e07c-0b54-38b4-909a-35f30012ee09",
                                                "text": "Germanic languages have a marked tendency towards large vocalic inventories."
                                            },
                                            {
                                                "example_id": "92225dfe-9882-40b6-80ee-fc40ddb8335e",
                                                "sense_id": "a612e07c-0b54-38b4-909a-35f30012ee09",
                                                "text": "Most final consonants have been lost, resulting in a tonal language with a rich consonantal and vocalic inventory, but with a relatively simple syllabic structure.."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inventory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afb86dde-40d6-3529-8f0a-ef8fc6b22742",
                                        "entry_id": "5efe2450-4dbd-3c84-b034-b1e0e12023a4",
                                        "glosses": [
                                            "To take stock of the resources or items on hand; to produce an inventory."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6222b41e-8d6c-4ea9-bd46-91bf19f40415",
                                                "sense_id": "afb86dde-40d6-3529-8f0a-ef8fc6b22742",
                                                "text": "The main job of the night shift was to inventory the store, and restock when necessary."
                                            },
                                            {
                                                "example_id": "debf1c9f-f05f-4e25-9df5-a2ee02ddb4a1",
                                                "sense_id": "afb86dde-40d6-3529-8f0a-ef8fc6b22742",
                                                "text": "‘Now,’ said Jethro, ‘we’re inventorying all the stock today, do you want to lend a hand?’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e2c810d-89b6-4e29-81c7-30c430167be1",
                        "source_entry_id": "34c272a6-4042-34b6-b65b-074d1f9b881f",
                        "source_sense_id": "6074c2e5-3aec-3d06-8927-1b9d110ab080",
                        "source_sense_description": "Bestandsaufnahme eines Inventars, Erstellen einer Inventarliste",
                        "target_lang_word": "recensement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recensement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7ac4b5-9831-3362-9071-b9f475f8d271",
                                        "entry_id": "f8d06089-04d6-31da-a9ee-6af8ccaf85d1",
                                        "glosses": [
                                            "Dénombrement ou inventaire de personnes, d’effets, de suffrages, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caa8555f-8dba-4ff4-bf3f-38f9d674210e",
                                                "sense_id": "7e7ac4b5-9831-3362-9071-b9f475f8d271",
                                                "text": "Le 5 mars 1911, eut lieu le recensement qui donna à Bourg-la-Reine le chiffre de 5 072 habitants."
                                            },
                                            {
                                                "example_id": "e3f97f62-40c6-4164-8587-f7665d18b26f",
                                                "sense_id": "7e7ac4b5-9831-3362-9071-b9f475f8d271",
                                                "text": "Dans le canton de Mezel, la commune moribonde de Creisset avait encore, en 1906, 80 habitants. Au recensement de 1928, son nom même a disparu; il ne reste d'elle que quelques tronçons de murailles."
                                            },
                                            {
                                                "example_id": "fb0857de-d2e5-4ce8-b5c2-210917b6a3bf",
                                                "sense_id": "7e7ac4b5-9831-3362-9071-b9f475f8d271",
                                                "text": "Le général annamite mit le comble au mécontentement du peuple en ordonnant que l'on cadastrât les propriétés et que l'on fît le recensement de la population."
                                            },
                                            {
                                                "example_id": "daf2d4a0-f204-42b6-b9ea-474145b38dfb",
                                                "sense_id": "7e7ac4b5-9831-3362-9071-b9f475f8d271",
                                                "text": "Il a fait le recensement de ses rentes. — D’après le recensement des sommes reçues, il constate que… — Il faut procéder au recensement des voix."
