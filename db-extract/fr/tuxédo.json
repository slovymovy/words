                                                "sense_id": "0b809ba3-e9b7-3056-a147-ca388e4d5c70",
                                                "text": "He wore a tuxedo for his sister's wedding."
                                            },
                                            {
                                                "example_id": "5ba0fd2b-2f46-40a2-bbe6-0df462f2b707",
                                                "sense_id": "0b809ba3-e9b7-3056-a147-ca388e4d5c70",
                                                "text": "His mom bought a tuxedo for him."
