                "senses": [
                    {
                        "sense_id": "f54e7016-77cf-39ff-b8ea-e9694ebe1951",
                        "entry_id": "adaf1142-be26-30b4-a094-1083f3b67d8b",
                        "glosses": [
                            "Gruppe (Herde) von zusammenlebenden Ziegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24ebf4a-b4a8-4fbf-89b4-def8690e801a",
                                "sense_id": "f54e7016-77cf-39ff-b8ea-e9694ebe1951",
                                "text": "„Ein Stück weiter stolperten wir in eine Ziegenherde, die sich in wildem Durcheinander ihren Weg den steilen Hang hinunter suchte.“"
                            },
                            {
                                "example_id": "7fcc36ca-85d0-4cb2-9d6a-ab591fa584ee",
                                "sense_id": "f54e7016-77cf-39ff-b8ea-e9694ebe1951",
                                "text": "„Das Grundstück direkt gegenüber der Stelle, wo Atticus stand, lag brach; eine Ziegenherde graste auf der verwilderten Weide.“"
                            },
                            {
                                "example_id": "e4c69c7a-5fbc-4048-b618-bb2b7fe4fa6b",
                                "sense_id": "f54e7016-77cf-39ff-b8ea-e9694ebe1951",
                                "text": "„Am Morgen war mir das Leben so einfach vorgekommen, als ich aufgewacht war und den falschen Frühling gesehen und die Flöte des Mannes mit seiner Ziegenherde gehört und mir draußen die Rennzeitung gekauft hatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
