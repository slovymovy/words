{
    "word_family": [
        "custom",
        "customize",
        "customer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a3d80a51-af1e-3a0d-86da-929652d9e6ab",
                    "sense_definition": "In accordance with, or established by, custom or common usage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "customary_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>customary</w> to shake hands when meeting someone for the first time.",
                            "target_lang_translations": {
                                "ru": "При знакомстве <w>принято</w> пожимать руку."
                            }
                        },
                        {
                            "text": "She returned to her <w>customary</w> seat at the back of the library.",
                            "target_lang_translations": {
                                "ru": "Она вернулась на своё <w>привычное</w> место в конце библиотеки."
                            }
                        }
                    ],
                    "synonyms": [
                        "conventional",
                        "habitual"
                    ],
                    "common_phrases": [
                        "customary practice",
                        "customary procedure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствующий обычаям или общепринятой практике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обы́чный",
                                "target_lang_sense_clarification": "соответствующий общепринятым нормам или правилам"
                            },
                            {
                                "target_lang_word": "привы́чный",
                                "target_lang_sense_clarification": "то, что стало нормой в силу повторения или традиции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc2bf91c-a680-3fc5-b141-66a602b93394",
                    "sense_definition": "Holding or held by custom.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_tenure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The land was held under <w>customary</w> rights that had existed for centuries.",
                            "target_lang_translations": {
                                "ru": "Земля находилась во владении на основе <w>обычного права</w>, существовавшего веками."
                            }
                        },
                        {
                            "text": "These <w>customary</w> tenants paid their dues according to ancient local traditions.",
                            "target_lang_translations": {
                                "ru": "Эти <w>зависимые по обычаю</w> арендаторы платили взносы согласно древним местным традициям."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на традиционном праве или обычаях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обы́чный",
                                "target_lang_sense_clarification": "в контексте права: основанный на обычае"
                            },
                            {
                                "target_lang_word": "традицио́нный",
                                "target_lang_sense_clarification": "основанный на давних местных традициях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a2250ac-dc56-3c6d-b5f3-0954fe0e4bfe",
                    "sense_definition": "A book containing laws and usages, or customs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval <w>customary</w> detailed the specific obligations of the villagers.",
                            "target_lang_translations": {
                                "ru": "Средневековый <w>сборник обычаев</w> подробно описывал конкретные обязанности сельских жителей."
                            }
                        },
                        {
                            "text": "Historians studied the old <w>customary</w> to understand the region's legal history.",
                            "target_lang_translations": {
                                "ru": "Историки изучали старинный <w>свод обычаев</w>, чтобы понять правовую историю региона."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сборник законов, правил или обычаев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбо́рник обыча́ев",
                                "target_lang_sense_clarification": "книга, содержащая свод местных правил"
                            },
                            {
                                "target_lang_word": "суде́бник",
                                "target_lang_sense_clarification": "исторический документ, содержащий свод законов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}