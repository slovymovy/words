{
    "word_family": [
        "bestrew",
        "overstrew",
        "strewment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bcbd627a-47ea-3f6c-8f97-69fd35c0ce48",
                    "sense_definition": "To scatter or distribute objects or pieces of something over an area, especially in a random or messy manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scatter_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children managed to <w>strew</w> toys all over the living room floor within minutes.",
                            "target_lang_translations": {
                                "ru": "Детям удалось за несколько минут <w>разбросать</w> игрушки по всему полу в гостиной.",
                                "zh": "孩子们几分钟内就把玩具<w>乱扔</w>得满客厅地板都是。"
                            }
                        },
                        {
                            "text": "It is a tradition to <w>strew</w> flowers along the path during the wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Существует традиция <w>усыпать</w> цветами дорожку во время свадебной церемонии.",
                                "zh": "婚礼仪式上，沿路<w>撒满</w>鲜花是一种传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scatter",
                        "sprinkle"
                    ],
                    "common_phrases": [
                        "strew flowers",
                        "strew papers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбрасывать или распределять предметы или части чего-либо по поверхности, особенно в беспорядке.",
                        "zh": "将物体或碎片散乱地分布在某处，通常指杂乱无章地散布。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбрасывать",
                                "target_lang_sense_clarification": "хаотично распределять предметы по поверхности"
                            },
                            {
                                "target_lang_word": "разбросать",
                                "target_lang_sense_clarification": "раскидать в беспорядке"
                            },
                            {
                                "target_lang_word": "усыпать",
                                "target_lang_sense_clarification": "покрывать поверхность, бросая цветы, листья и т.д."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "散布",
                                "target_lang_sense_clarification": "将物体分散地放置在某处"
                            },
                            {
                                "target_lang_word": "撒满",
                                "target_lang_sense_clarification": "将花瓣或细小物体铺撒在表面"
                            },
                            {
                                "target_lang_word": "乱扔",
                                "target_lang_sense_clarification": "杂乱地丢弃或放置物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99bf46c5-7559-360f-89ca-27a85c1d7d3b",
                    "sense_definition": "To cover a surface, or lie scattered upon it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scatter_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autumn leaves <w>strew</w> the forest path, creating a colorful carpet.",
                            "target_lang_translations": {
                                "ru": "Осенние листья <w>устилают</w> лесную тропинку, создавая красочный ковер.",
                                "zh": "秋叶<w>铺满</w>了林间小径，形成了一块彩色的地毯。"
                            }
                        },
                        {
                            "text": "Countless plastic bottles <w>strew</w> the beach after the weekend festival.",
                            "target_lang_translations": {
                                "ru": "Бесчисленные пластиковые бутылки <w>устилают</w> пляж после фестиваля в выходные.",
                                "zh": "周末音乐节过后，海滩上<w>布满</w>了无数的塑料瓶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scatter"
                    ],
                    "common_phrases": [
                        "strew the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность или лежать на ней в разбросанном виде.",
                        "zh": "覆盖某表面，或散乱地躺在某表面上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устилать",
                                "target_lang_sense_clarification": "покрывать сплошным слоем (о листьях, ветках)"
                            },
                            {
                                "target_lang_word": "быть разбросанным",
                                "target_lang_sense_clarification": "лежать на поверхности в беспорядке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铺满",
                                "target_lang_sense_clarification": "物体散落在表面形成覆盖层"
                            },
                            {
                                "target_lang_word": "布满",
                                "target_lang_sense_clarification": "某处到处都是散落的物体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91f629ff-0f03-3c16-b9db-ac96fa0cd529",
                    "sense_definition": "To spread abroad or disseminate information, rumors, or ideas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disseminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels attempted to <w>strew</w> discord among the local population.",
                            "target_lang_translations": {
                                "ru": "Мятежники пытались <w>посеять</w> раздор среди местного населения.",
                                "zh": "叛军试图在当地民众中<w>散布</w>不和。"
                            }
                        },
                        {
                            "text": "She may <w>strew</w> dangerous conjectures that could harm the investigation.",
                            "target_lang_translations": {
                                "ru": "Она может <w>распространить</w> опасные домыслы, которые могут навредить следствию.",
                                "zh": "她可能会<w>散布</w>危险的推测，从而损害调查工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scatter"
                    ],
                    "common_phrases": [
                        "strew rumors"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is literary or dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространять или сеять информацию, слухи или идеи.",
                        "zh": "传播或散布信息、谣言或思想。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "распространять раздоры, сомнения, слухи"
                            },
                            {
                                "target_lang_word": "распространять",
                                "target_lang_sense_clarification": "делать известным слухи или идеи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "散布",
                                "target_lang_sense_clarification": "传播谣言或负面信息"
                            },
                            {
                                "target_lang_word": "播下",
                                "target_lang_sense_clarification": "比喻引起某种情绪或后果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2db1e2e4-4c59-31ac-aab2-8755941429bc",
                    "sense_definition": "To populate or fill something with items at random points.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scatter_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor had to correct the essay because spelling mistakes <w>strewed</w> the text.",
                            "target_lang_translations": {
                                "ru": "Редактору пришлось исправлять эссе, потому что орфографические ошибки буквально <w>пестрили</w> в тексте.",
                                "zh": "编辑不得不修改这篇文章，因为文中<w>布满</w>了拼写错误。"
                            }
                        },
                        {
                            "text": "Small islands <w>strew</w> the vast ocean, making navigation difficult.",
                            "target_lang_translations": {
                                "ru": "Мелкие острова <w>усеивают</w> бескрайний океан, затрудняя навигацию.",
                                "zh": "小岛<w>点缀</w>在广阔的海洋中，使得航行变得困难。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполнять или усеивать что-либо объектами в случайных местах.",
                        "zh": "在某处随机地填充或散布物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усеивать",
                                "target_lang_sense_clarification": "быть расположенным во множестве мест на пространстве"
                            },
                            {
                                "target_lang_word": "пестрить",
                                "target_lang_sense_clarification": "быть наполненным мелкими элементами (например, ошибками)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点缀",
                                "target_lang_sense_clarification": "零星地分布在某处"
                            },
                            {
                                "target_lang_word": "布满",
                                "target_lang_sense_clarification": "某处到处散布着某种元素"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}