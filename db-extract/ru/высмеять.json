                                        "entry_id": "a4a4f12b-2f5c-31fd-bb94-e9ee75097107",
                                        "glosses": [
                                            "iemand door te lachen bespotten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c84c5194-419e-4d7f-b4a0-01ad5d07baeb",
                                                "sense_id": "fd63e946-2643-3c62-9212-d545cbb01201",
                                                "text": "Ik werd vroeger op school veel uitgelachen."
                                            },
                                            {
                                                "example_id": "479af3a1-821c-4f6b-ad68-652f040fba35",
                                                "sense_id": "fd63e946-2643-3c62-9212-d545cbb01201",
                                                "text": "Barbie werd uitgelachen dat hij al drie weken lang alleen maar ‘ramen bomb’ at (een pakje noedels met een pakje aardappelpuree en een blik tonijn door elkaar)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
