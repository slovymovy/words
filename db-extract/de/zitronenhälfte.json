                        "examples": [
                            {
                                "example_id": "df80ec0f-fe88-411a-b3ea-1dbbe84155df",
                                "sense_id": "e6578cd3-9bed-3f1d-8636-76c69053edc6",
                                "text": "„Ich muss noch den Kupferkessel auf Hochglanz bringen, wozu ich dann eine in Salz getauchte Zitronenhälfte nehme.“"
                            },
                            {
                                "example_id": "301b288d-ecf7-485f-851c-393aa4090856",
                                "sense_id": "e6578cd3-9bed-3f1d-8636-76c69053edc6",
                                "text": "„Ich hatte dieses Etablissement gewählt, um über die Zitronen zu sprechen, die mir frühmorgendlichen Stress verursachten, und prompt servierte man mir hier Zitronenhälften, raffiniert verpackt in weißer Baumwollgaze, als hätte man sie extra für mich verhüllt.“"
                            }
                        ],
