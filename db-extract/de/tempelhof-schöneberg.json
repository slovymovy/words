                                "example_id": "d8a098ca-6597-4b4b-be28-cab89d83707d",
                                "sense_id": "f3f51122-3317-326f-8e95-b5c07845ea41",
                                "text": "„Tempelhof-Schöneberg: Die beiden »Hälften« dieser Zweckgemeinschaft sind höchst unterschiedlich.“"
                            },
                            {
                                "example_id": "fd7fd95a-31e2-4370-af93-cd1e43deb490",
                                "sense_id": "f3f51122-3317-326f-8e95-b5c07845ea41",
                                "text": "In Tempelhof-Schöneberg, genauer gesagt in Schöneberg, liegt das deutschlandweit bekannte Kaufhaus KaDeWe, was Kaufhaus des Westens bedeutet."
                            },
                            {
                                "example_id": "a6382ec2-70b4-4916-a54a-87afa9e359c8",
                                "sense_id": "f3f51122-3317-326f-8e95-b5c07845ea41",
                                "text": "Viele gemütliche und schöne Straßen mit Altbauhäuserzeilen sind in Tempelhof-Schöneberg noch erhalten geblieben."
                            }
                        ],
