                        "form": "die Radiästhesie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8864d322-80ca-315c-b310-5fd29ac20595",
                        "entry_id": "13fc7c4f-c352-3f70-af06-c4563f9ef396",
                        "glosses": [
                            "vermeintliche Fähigkeit, gewisse Strahlen mittels Pendel oder Wünschelrute zu erkennen und damit Vorkommen von Wasser und Metall ausfindig zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8227d777-dc47-4a3e-875f-a303f7f6e5d6",
                                "sense_id": "8864d322-80ca-315c-b310-5fd29ac20595",
                                "text": "„Die Radiästhesie oder Radionik wurde in den 1920er Jahren in den USA begründet und wird heute leider immer noch den Pseudowissenschaften oder Parawissenschaften zugeordnet.“"
                            },
                            {
                                "example_id": "cae52a8b-d1ee-482a-9c8d-2b296040f086",
                                "sense_id": "8864d322-80ca-315c-b310-5fd29ac20595",
                                "text": "„In der Radiästhesie werden mit dem Pendel unsichtbare Phänomene wie Erdstrahlen gesucht.“"
                            },
                            {
                                "example_id": "1b3c8443-5287-4f0c-ad59-fa4952b38891",
                                "sense_id": "8864d322-80ca-315c-b310-5fd29ac20595",
                                "text": "„Solchen Kraftorten geht auch die Radiästhesie nach, wörtlich die Wahrnehmung von Strahlen, und meint die Lehre von Strahlenwirkungen auf Organismen, die mittels einer außergewöhnlichen Strahlenfühligkeit bzw. Strahlenempfindlichkeit erkundet werden.“"
                            },
                            {
                                "example_id": "3395a070-0e6f-4c48-917f-217c19b824e6",
                                "sense_id": "8864d322-80ca-315c-b310-5fd29ac20595",
                                "text": "„Nach den Erkenntnissen der Radiästhesie strahlt ein Wasserstoffatom durch seine rechts- oder linksdrehende Eigenrotation polarisierte Schwingung ab.“"
                            },
                            {
                                "example_id": "b50e78dc-ad44-49d8-ae84-c750a2f1a501",
                                "sense_id": "8864d322-80ca-315c-b310-5fd29ac20595",
                                "text": "„Hans Gasperl gibt einen Einblick in die sogenannte Radiästhesie und erklärt, wie man die vorhandenen Energien im Alltag für sich nutzen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
