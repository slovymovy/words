                "senses": [
                    {
                        "sense_id": "bec9b31f-f376-3c62-ada4-8e6ee727b926",
                        "entry_id": "735b9a26-1326-374c-a813-ff4ba895f2aa",
                        "glosses": [
                            "Zimmer, in dem geraucht werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddee2efa-d4b5-44e7-a020-b1f335cf40af",
                                "sense_id": "bec9b31f-f376-3c62-ada4-8e6ee727b926",
                                "text": "„Ernste Männer würfelten im Rauchzimmer bei Gin, Brandy, Whisky und Cocktails.“"
                            },
                            {
                                "example_id": "4bd29236-896e-4380-93c1-c15395155fb1",
                                "sense_id": "bec9b31f-f376-3c62-ada4-8e6ee727b926",
                                "text": "„Nach dem Essen nahmen die Herren Kognak und Zigarren im Rauchzimmer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "410866c7-9cd1-446a-8374-14a56fe24d84",
                        "source_entry_id": "735b9a26-1326-374c-a813-ff4ba895f2aa",
                        "source_sense_id": "bec9b31f-f376-3c62-ada4-8e6ee727b926",
                        "source_sense_description": "Zimmer, in dem geraucht werden darf",
                        "target_lang_word": "fumoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fumoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82e371c0-4729-3a5a-84d8-ed877e80c0c4",
                                        "entry_id": "6a087846-c971-3b32-9302-7ecce08aa9ff",
                                        "glosses": [
                                            "Bâtiment destiné à fumer les viandes et les poissons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                                        "entry_id": "6a087846-c971-3b32-9302-7ecce08aa9ff",
                                        "glosses": [
                                            "Pièce qui, dans les appartements, dans les hôtels, dans les entreprises, est réservée aux fumeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a71231-bab5-465b-a69b-05aebf3131b9",
                                                "sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                                                "text": "Le fumoir occupait, à l’extrémité du grand salon, une des pièces rondes formées par les tourelles."
                                            },
                                            {
                                                "example_id": "d54894fa-b7bf-4338-8000-1e90ab57c29d",
                                                "sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                                                "text": "Il se rendit à pied rue d’Antin où il avait un entresol, et, arrivé dans son fumoir, s’enferma pour écrire à Mlle de Vénérande."
                                            },
                                            {
                                                "example_id": "292b40ba-a4c3-42fb-8e4e-99113060e01f",
                                                "sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                                                "text": "Il s’attardait dans le fumoir, attendant la fin du repas, lorsqu’on vint l’avertir que le comte était remonté dans sa chambre et l’attendait."
                                            },
                                            {
                                                "example_id": "5f39fd61-8c4f-45df-a193-0805daaab47f",
                                                "sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                                                "text": "Si vous ne connaissez les actrices que par les conversations de fumoir, n’en dites rien."
                                            },
                                            {
                                                "example_id": "101afe96-3179-4848-b272-e593bcfd9fb1",
                                                "sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                                                "text": "Il existait encore à Torcy une petite pièce confortable qu’on appelait le fumoir : à une époque que tu n'as pas connue, on ne fumait guère devant les dames, et les messieurs étaient censés se réunir pour fumer tout à leur aise, dans cette petite pièce. Après le déjeuner, nous sommes allés au fumoir, où on a apporté du café et des liqueurs, et le jeune Bousquet est venu avec nous."
                                            },
                                            {
                                                "example_id": "d7cfcddb-4c69-4f62-8518-40b8e0e566aa",
                                                "sense_id": "70e72126-68aa-37a8-8eab-0c2484ed6360",
                                                "text": "On aurait pu se croire dans un fumoir anglais\nNous sirotions à deux un breuvage irlandais\nDehors, c'était la pluie, la tempête, le froid\nA nos pieds, reposait un très vieux braque hongrois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
