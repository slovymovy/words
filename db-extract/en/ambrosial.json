                    },
                    {
                        "form_id": "f1bf16ab-eda6-447d-9e18-2556829a7366",
                        "entry_id": "53ebba25-1980-34f3-b3b8-06b27e3770b2",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ambrosial"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6da67fd8-b5aa-3b33-b6ca-00d9eed335f2",
                        "entry_id": "53ebba25-1980-34f3-b3b8-06b27e3770b2",
                        "glosses": [
                            "Pertaining to or worthy of the gods."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "e12f9d23-0b32-49f7-bcd2-d3a1e7b92141",
                                "sense_id": "6da67fd8-b5aa-3b33-b6ca-00d9eed335f2",
                                "text": "And whilst he slept she [Venus] over him would spred / Her mantle, colour’d like the starry skyes, / And her soft arme lay underneath his hed, / And with ambrosiall kisses bathe his eyes [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "26f63b68-529a-3718-b6c5-6ae47da3dc2f",
                        "entry_id": "53ebba25-1980-34f3-b3b8-06b27e3770b2",
                        "glosses": [
                            "Succulently sweet or fragrant; balmy, divine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbcf91e2-2f67-4594-9d96-936ccf406859",
                                "sense_id": "26f63b68-529a-3718-b6c5-6ae47da3dc2f",
                                "text": "Thy Chamber vvith Ambroſiall odors breatheth, / Nevv loues and true loues vnto them that entreateth, / And furious Mars made milde his Faulcheon ſheatheth / At thy delicious aſpect: […]"
                            },
                            {
                                "example_id": "c2f64cde-683c-4a48-8b7d-7d2d5bf7474a",
                                "sense_id": "26f63b68-529a-3718-b6c5-6ae47da3dc2f",
                                "text": "VVhile thus she spake, / She touched his eye-lashes with libant lip / And breath'd ambrosial odours; […]"
                            },
                            {
                                "example_id": "612b13cc-0d55-458f-9efd-3f0eae98fc00",
                                "sense_id": "26f63b68-529a-3718-b6c5-6ae47da3dc2f",
                                "text": "[T]his young hero, rising from his bed, proceeded to decorate his beautiful person, and shave his ambrosial chin […]"
                            },
                            {
                                "example_id": "3ac789b1-c364-4148-9e34-7686dda7f9f6",
                                "sense_id": "26f63b68-529a-3718-b6c5-6ae47da3dc2f",
                                "text": "By your cheek of vermil hue, / By your lip’s ambrosial dew, / By your soft and languid eye, / By your swelling bosom’s sigh, / You taught me love."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a09dd8-c504-44a3-aca6-b85ccc8fbdfe",
                        "source_entry_id": "53ebba25-1980-34f3-b3b8-06b27e3770b2",
                        "source_sense_description": "succulently sweet or fragrant",
                        "target_lang_word": "ambrosiaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambrosiaque",
