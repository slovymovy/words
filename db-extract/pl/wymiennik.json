                        "sense_id": "39bd1a64-f825-3186-bc5a-a6c6830cc7fe",
                        "entry_id": "6660a029-c2ae-3c43-944a-17cb714dff80",
                        "glosses": [
                            "to, co podlega lub służy wymianie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "109ac319-93c0-443d-bb4d-2116331cfc0c",
                                "sense_id": "39bd1a64-f825-3186-bc5a-a6c6830cc7fe",
                                "text": "Jeden wymiennik węglowodanowy jest to taka ilość danego produktu żywnościowego, w jakiej zawarte jest 10g węglowodanów złożonych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bec12abf-5bb0-3c28-bb54-43b47c5e7825",
                        "entry_id": "6660a029-c2ae-3c43-944a-17cb714dff80",
                        "glosses": [
                            "urządzenie służące do wymiany ciepła między dwoma ośrodkami, wymiennik ciepła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "665c04e3-73d6-4431-b584-2c2b0bc89b3f",
                                "sense_id": "bec12abf-5bb0-3c28-bb54-43b47c5e7825",
                                "text": "Schemat przedstawia budowę wymiennika ciepła."
                            },
                            {
                                "example_id": "9c285658-8538-4eeb-ad78-581eb58b3818",
                                "sense_id": "bec12abf-5bb0-3c28-bb54-43b47c5e7825",
                                "text": "Awaria wymiennika ciepła była powodem niedogrzania budynku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
