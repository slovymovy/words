    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "650f490c-964b-332b-970f-eaaf8316325d",
                    "sense_definition": "Bloquer un passage, une voie, en y mettant un obstacle qui empêche la circulation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blocage_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un arbre tombé sur la route <w>obstrue</w> la circulation depuis ce matin."
                        },
                        {
                            "text": "Les manifestants ont décidé d'<w>obstruer</w> l'entrée principale du bâtiment administratif."
                        }
                    ],
                    "synonyms": [
                        "bloquer",
                        "barrer",
                        "encombrer"
                    ],
                    "antonyms": [
                        "dégager",
                        "débloquer"
                    ],
                    "common_phrases": [
                        "obstruer le passage",
                        "obstruer la voie"
                    ]
                },
                {
                    "sense_id": "5189a3ac-27fa-3d6c-b80d-ed7a222b06c8",
                    "sense_definition": "Boucher ou engorger un tuyau, un conduit ou un vaisseau sanguin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engorgement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des feuilles mortes ont fini par <w>obstruer</w> la gouttière de la maison."
                        },
                        {
                            "text": "Un caillot de sang peut <w>obstruer</w> une artère et provoquer de graves complications."
                        }
                    ],
                    "synonyms": [
                        "boucher",
                        "engorger",
                        "oblitérer"
                    ],
                    "antonyms": [
                        "déboucher",
                        "désengorger"
                    ],
                    "common_phrases": [
                        "obstruer les artères",
                        "obstruer un conduit"
                    ]
                },
                {
                    "sense_id": "05e8c32a-cf6e-3a57-a4ce-79f5d1aceeae",
                    "sense_definition": "Masquer ou gêner la visibilité de quelque chose en se plaçant devant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "visibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand bâtiment récent vient malheureusement <w>obstruer</w> la vue sur les montagnes."
                        },
                        {
                            "text": "Veillez à ne rien poser sur le tableau de bord pour ne pas <w>obstruer</w> la vue du conducteur."
                        }
                    ],
                    "synonyms": [
                        "masquer",
                        "cacher"
                    ],
                    "antonyms": [
                        "dégager"
                    ],
                    "common_phrases": [
                        "obstruer la vue"
                    ]
                }
            ]
        }
    ]
