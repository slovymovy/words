                        "examples": [
                            {
                                "example_id": "847ac0a8-cdea-418d-b318-15d362b43b8e",
                                "sense_id": "96c58364-ae32-3baf-877a-cdb52894dc20",
                                "text": "He randomised the marbles by spilling them onto the floor."
                            }
                        ]
