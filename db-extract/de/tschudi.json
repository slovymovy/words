                "senses": [
                    {
                        "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                        "entry_id": "1453e5ef-718b-3cc6-be84-8364def9025c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba9f2a7-e2c5-4494-b885-bb926f9c4930",
                                "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                                "text": "Frau Tschudi ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "39a25196-4233-4974-b43e-514e6bbadec9",
                                "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                                "text": "Herr Tschudi wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "78624204-2eb7-48be-b4a8-30bea00f2931",
                                "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                                "text": "Die Tschudis fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1be9d67d-94a9-483a-b42f-84986a7471aa",
                                "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                                "text": "Der Tschudi trägt nie die Pullover, die die Tschudi ihm strickt."
                            },
                            {
                                "example_id": "a39ea428-ef2f-4890-9f04-1f98d49d6dff",
                                "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tschudi kommt, geht der Herr Tschudi.“"
                            },
                            {
                                "example_id": "cde2fea6-36b2-4178-8e53-e8b5274b08ba",
                                "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                                "text": "Tschudi kommt und geht."
                            },
                            {
                                "example_id": "6970fc8f-0629-4fcd-bb44-806c4971ab28",
                                "sense_id": "dde05e29-3304-3030-b19e-261a244f6732",
                                "text": "Tschudis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
