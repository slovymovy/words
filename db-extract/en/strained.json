                                        "glosses": [
                                            "Qui subit une tension (arc, élastique, ressort, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf9a79dd-79f3-4dd4-936d-ffa36ce049be",
                                                "sense_id": "e67222c8-96c4-3658-930e-3941a6226a55",
                                                "text": "L’élastique est tendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b4b3b0d-199b-3e6b-8b9b-796a7dab8bed",
                                        "entry_id": "ca9ef9ed-3f37-3b68-a4aa-53064c6579bc",
                                        "glosses": [
                                            "Qui exerce un effort en parlant des muscles, du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f000a41e-c392-4136-8dab-3a9042a10a7b",
                                                "sense_id": "3b4b3b0d-199b-3e6b-8b9b-796a7dab8bed",
                                                "text": "Le buste tendu comme un arc, les reins cambrés, la jambe allongée et levée en arrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbac9dbc-8f01-3931-a69a-bcf7bef46492",
                                        "entry_id": "ca9ef9ed-3f37-3b68-a4aa-53064c6579bc",
                                        "glosses": [
                                            "Arrondi, enflé, œdémateux, turgescent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29a558fd-43e9-49e1-a301-82e24702eaa5",
                                                "sense_id": "cbac9dbc-8f01-3931-a69a-bcf7bef46492",
                                                "text": "La mamelle du sein est tendue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "516e2d66-0308-3bd8-a0e1-e1f7e98705da",
                                        "entry_id": "ca9ef9ed-3f37-3b68-a4aa-53064c6579bc",
                                        "glosses": [
                                            "Qui subit une tension intellectuelle, concentré, attentif, intense, en parlant de l’esprit, d’une personnalité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e1722b0-0ff8-477a-ba23-2908cffa3487",
                                                "sense_id": "516e2d66-0308-3bd8-a0e1-e1f7e98705da",
                                                "text": "Esprit, volonté tendu(e) à se rompre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c234c10f-0c87-3605-a20f-9bb2bec5e523",
                                        "entry_id": "ca9ef9ed-3f37-3b68-a4aa-53064c6579bc",
                                        "glosses": [
                                            "Qui exprime cette tension intellectuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6bc3b2-a7c3-4428-b4e8-0df4938c4fab",
                                                "sense_id": "c234c10f-0c87-3605-a20f-9bb2bec5e523",
                                                "text": "Un visage tendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418c8d5f-8a07-3182-a63a-4b5aae7f9ae5",
                                        "entry_id": "ca9ef9ed-3f37-3b68-a4aa-53064c6579bc",
                                        "glosses": [
                                            "Qui subit une tension nerveuse, angoissé, anxieux, énervé, soucieux, nerveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec76ad6-8f37-4bcc-aeff-27b5c87a4656",
                                                "sense_id": "418c8d5f-8a07-3182-a63a-4b5aae7f9ae5",
                                                "text": "Il est préoccupé, tendu, irritable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9aa6896-36c3-3edb-ae22-0122805778ec",
                                        "entry_id": "ca9ef9ed-3f37-3b68-a4aa-53064c6579bc",
                                        "glosses": [
                                            "Qui marque un tempérament tourmenté, un état d’énervement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6c18f35-b1bb-41be-8145-6089bf1712d7",
                                                "sense_id": "b9aa6896-36c3-3edb-ae22-0122805778ec",
                                                "text": "La situation est tendue entre eux, ils passent leur temps à se disputer."
                                            },
                                            {
                                                "example_id": "bc17d277-fe3e-4f52-8f78-742508692872",
                                                "sense_id": "b9aa6896-36c3-3edb-ae22-0122805778ec",
                                                "text": "Le style de sa poésie est tendu, nerveux, incisif."
                                            },
                                            {
                                                "example_id": "897b77aa-d157-45ba-806f-1457f3d21282",
                                                "sense_id": "b9aa6896-36c3-3edb-ae22-0122805778ec",
                                                "text": "Dans les années 2000, les relations entre Harrods et la famille royale étaient pourtant tendues, en raison du rachat du groupe par Mohamed Al-Fayed, père de Dodi Al-Fayed, dernier compagnon de Lady Diana."
                                            },
                                            {
                                                "example_id": "cbb3b6d1-faa3-4f82-bf30-855c669076ca",
                                                "sense_id": "b9aa6896-36c3-3edb-ae22-0122805778ec",
                                                "text": "C’est l’un des paradoxes de l’époque : on se plaint des interviews consensuelles et aseptisées, mais dès qu’un échange est un peu tendu, il est considéré comme un clash, dès qu’une parole surnage, ça devient l’engueulade du siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0848103e-9fc0-3d54-8e74-f527c024dc70",
                                        "entry_id": "ca9ef9ed-3f37-3b68-a4aa-53064c6579bc",
                                        "glosses": [
                                            "Compliqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f601d935-97f7-4541-bb9e-47c73bd2fcfc",
                                                "sense_id": "0848103e-9fc0-3d54-8e74-f527c024dc70",
                                                "text": "C'est 25 mètres sous l'eau et il fait noir. Même pour les experts, c'est tendu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44260a5b-aad9-3a6f-9185-8d6b38a73682",
                                        "entry_id": "9e241fbd-1ae4-30f9-be92-e87ebfd48a49",
                                        "glosses": [
                                            "Participe passé masculin singulier de tendre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a523e5c5-ab6d-4975-aff1-6f328e19ced6",
                                                "sense_id": "44260a5b-aad9-3a6f-9185-8d6b38a73682",
                                                "text": "Cette Amérique n’est plus. Du fait de la troisième vague d’immigration et des conditions nouvelles de l’existence au xxe siècle, elle a tendu à se désanglo-saxonniser."
                                            }
                                        ]
                                    }
                                ]
                            }
