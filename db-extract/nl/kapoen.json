                "senses": [
                    {
                        "sense_id": "d1d466a7-0f90-3e33-9410-5d43702b3303",
                        "entry_id": "a32f6355-2377-3f17-9c61-0bbc3d58ee4d",
                        "glosses": [
                            "gesneden of gecastreerde haan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "005ab9b2-f702-4f0b-81ae-7cc7595d5f84",
                                "sense_id": "d1d466a7-0f90-3e33-9410-5d43702b3303",
                                "text": "⧖ Hy stierf verwinnaer in alle kampen, en droeg over zig eenen steen, genoemd Alectorius, die in den buyk van eenen haen of kapoen gevonden word, ter grootte van eene kleyne boon."
                            }
                        ]
                    },
                    {
                        "sense_id": "e28750d8-e9b0-3fb1-8069-a462eac4399d",
                        "entry_id": "a32f6355-2377-3f17-9c61-0bbc3d58ee4d",
                        "glosses": [
                            "iemand die ondeugend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "513fa298-3ac5-4fbf-8965-3482135a7dd1",
                                "sense_id": "e28750d8-e9b0-3fb1-8069-a462eac4399d",
                                "text": "⧖ De vriendschap van het lieve dier.\nVerschaft mij waarlijk veel plezier.\nDaarom bemin ik mijnen hond;\nIk houd hem zuiver en gezond,\nIk maak hem een fatsoenlijk nest.\nEn zorg voor eten in zijn' test.\nSoms krijgt hij een stuk boterham\nDan zegt dit lief kapoentje.... ham!"
                            }
                        ]
                    }
