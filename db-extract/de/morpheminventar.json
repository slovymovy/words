                        "glosses": [
                            "Menge der Morpheme (einer Sprache, eines Textes…)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "695cf97f-d74f-454c-99c8-86b67e5e20c3",
                                "sense_id": "f1408aeb-cec7-36ce-8286-eadff08ff929",
                                "text": "Ein Morpheminventar des Deutschen hat Gerhard Augst erarbeitet."
                            },
                            {
                                "example_id": "aa4595d3-d405-481e-9036-60957ee3595a",
                                "sense_id": "f1408aeb-cec7-36ce-8286-eadff08ff929",
                                "text": "„In seiner Gesamtheit listet es das Morpheminventar der deutschen Gegenwartssprache umfassend auf.“"
                            },
                            {
                                "example_id": "1f8eba6d-6414-4309-b8ba-de5574e77473",
                                "sense_id": "f1408aeb-cec7-36ce-8286-eadff08ff929",
                                "text": "„Die Aufgaben dieser Disziplin sind vor allem: … - die Ermittlung des Morpheminventars einer Sprache…“"
                            },
                            {
                                "example_id": "e28d0f9a-a9c4-439b-b7d5-293a702d8805",
                                "sense_id": "f1408aeb-cec7-36ce-8286-eadff08ff929",
                                "text": "„Das Morpheminventar unserer Sprache läßt sich nach unterschiedlichen Kriterien gliedern....“"
                            },
                            {
                                "example_id": "984743ad-ced9-49b9-a29f-e5d8faa606c4",
                                "sense_id": "f1408aeb-cec7-36ce-8286-eadff08ff929",
                                "text": "Bünting verweist mit dem Indexstichwort Morpheminventar auf die Computerzählung der Morpheme im Wörterbuch von Wahrig, worin „fast 5000 deutschstämmige Morpheme und fast 10000 insgesamt“ gefunden wurden."
                            }
                        ],
