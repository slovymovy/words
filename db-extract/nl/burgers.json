                        "examples": [
                            {
                                "example_id": "ac0b57c5-3934-476c-b8d6-a2e589b1d892",
                                "sense_id": "e8619e9c-e15c-3ac3-939f-e5d58ff916be",
                                "text": "Ze waren begonnen met het vermoorden van burgers door niet alleen Berlijn maar ook andere Duitse steden te bombarderen."
                            },
                            {
                                "example_id": "5924a246-77c6-426e-9365-f00c3252b070",
                                "sense_id": "e8619e9c-e15c-3ac3-939f-e5d58ff916be",
                                "text": "Zo werd in Athene een festival voor de stadsgodin Pallas Athene ingesteld dat Atheense burgers jaarlijks de gelegenheid gaf zich met elkaar te meten, maar één keer per vier jaar ook deelnemers van buiten Athene toeliet."
                            },
                            {
                                "example_id": "5999f2c4-3dc9-472e-ae96-6d68a2479bbb",
                                "sense_id": "e8619e9c-e15c-3ac3-939f-e5d58ff916be",
                                "text": "Ideale burgers hadden een ideaal lichaam en de vele atletische standbeelden lieten zien hoe dat eruitzag."
                            }
                        ]
                    }
