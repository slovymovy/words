                "senses": [
                    {
                        "sense_id": "35bb9733-d540-3611-89e9-713130e95707",
                        "entry_id": "5ad0446a-f8a9-3e21-902c-c08749cea5f3",
                        "glosses": [
                            "parmeński, dotyczący Parmy, miasta we Włoszech (dziś tylko w wyrażeniu ser parmezański)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "76679ffb-dbff-4e33-98c6-c4a035fb1a63",
                                "sense_id": "35bb9733-d540-3611-89e9-713130e95707",
                                "text": "Pomiędzy wojskami austriackimi, które przeciw Piemontczykom walczyły, wyliczają dzienniki 4 000 żołnierzy parmezańskich, których księżna Parmy w posiłku dostarczyła"
                            },
                            {
                                "example_id": "0a41cff2-16c0-41c4-b0d2-0837498bed45",
                                "sense_id": "35bb9733-d540-3611-89e9-713130e95707",
                                "text": "26. lutego: Ponieważ parmezańscy powstańcy starali się uwieść do buntu wierne rządowi gminy Piacenzy i zbliżyli się ku tej twierdzy, przeto dowódca tejże wysłał naprzeciw nim oddział piechoty i pluton huzarów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
