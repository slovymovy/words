                        ],
                        "examples": [
                            {
                                "example_id": "2f686db2-db1b-425b-8684-cba14aa1553f",
                                "sense_id": "9217cd71-6960-3e44-8a38-9ccdd14780bd",
                                "text": "De Roosendaalsche renner Bronger is naar wij vernemen aangeworven voor de groote Fransche klassieker Parijs—Sedan over een afstand van 270 K.M.",
                                "translation": "The cyclist from Roosendaal has been, as we have learnt, recruited for the big French classic Paris-Sedan over a distance of 270 km.",
                                "english": "The cyclist from Roosendaal has been, as we have learnt, recruited for the big French classic Paris-Sedan over a distance of 270 km."
                            },
                            {
                                "example_id": "6c71bf19-99bd-40d3-9df3-c93e2249b1bc",
                                "sense_id": "9217cd71-6960-3e44-8a38-9ccdd14780bd",
                                "text": "In een Belgische klassieker voor Onafhankelijken over een afstand van 184 km., heeft Jan van Gelderen uit Sluiskil zich kranig geweerd.",
                                "translation": "In a Belgian cycling classic for independent cyclists with a length of 184, Jan van Gelderen from Sluiskil has put up a tough fight.",
                                "english": "In a Belgian cycling classic for independent cyclists with a length of 184, Jan van Gelderen from Sluiskil has put up a tough fight."
                            },
                            {
                                "example_id": "7ff7ceb9-5e60-46ce-a763-09f953680afc",
                                "sense_id": "9217cd71-6960-3e44-8a38-9ccdd14780bd",
                                "text": "1950/1951, Martin W. Duyzings, Sport op twee wielen, De Koepel (publ.), page 97.\nGij vindt zijn naam niet op de erelijsten der klassiekers, hij gold in de Tour de France uitsluitend als premie-jager en won meer dan eens een etappe in een massa-sprint, nadat hij door zijn ploegmaten handig gelanceerd was.",
                                "translation": "You don't find his name in the halls of fame of the road cycling classics, he exclusively functioned in the Tour de France as a finisher and won more than once a stage in a bunch sprint, after he had been cleverly jumpstarted by his crew mates.",
                                "english": "You don't find his name in the halls of fame of the road cycling classics, he exclusively functioned in the Tour de France as a finisher and won more than once a stage in a bunch sprint, after he had been cleverly jumpstarted by his crew mates."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfa1acef-c203-3515-9a4b-f22daefbd18a",
                        "entry_id": "0fbfea09-b2a8-35ed-b4b6-0b4c75ad9fbb",
                        "glosses": [
                            "a sports classic, a traditional match",
                            "a match between the football clubs Ajax and Feyenoord"
                        ],
                        "tags": [
                            "Netherlands",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ec02a618-5cf6-44c0-9280-6d8b98011eb7",
                                "sense_id": "cfa1acef-c203-3515-9a4b-f22daefbd18a",
                                "text": "Men zou het de klassieker van de techniek kunnen noemen, al is die van Feijenoord momenteel dan wel meer geslepen.",
                                "translation": "One could call is the classic of technique, although in taht case Feijenoord's technique is currently more polished.",
                                "english": "One could call is the classic of technique, although in taht case Feijenoord's technique is currently more polished."
                            },
                            {
                                "example_id": "c6c9e1db-1fce-4af1-bffe-df76d7585ab5",
                                "sense_id": "cfa1acef-c203-3515-9a4b-f22daefbd18a",
                                "text": "Door ernstige supportersrellen wordt de klassieker sinds 2009 zonder uitpubliek gespeeld.",
                                "translation": "Due to serious rioting by supporters [of the two clubs], the classic has been played without the guest club's supporter base [in attendance] since 2009.",
                                "english": "Due to serious rioting by supporters [of the two clubs], the classic has been played without the guest club's supporter base [in attendance] since 2009."
                            }
                        ]
                    }
