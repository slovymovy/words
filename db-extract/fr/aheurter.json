                        ],
                        "form": "s’aheurter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ed43d5d-6393-3e2a-aceb-3e742b50caa6",
                        "entry_id": "ad5af151-fd33-352c-9293-416ea1fbb5bf",
                        "glosses": [
                            "Contrecarrer quelqu’un."
                        ],
                        "tags": [
                            "dated",
                            "literary",
                            "rare",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "26bf8dbc-0b33-3182-8ab4-6e084cb25698",
                        "entry_id": "ad5af151-fd33-352c-9293-416ea1fbb5bf",
                        "glosses": [
                            "Être aheurté à quelqu'un ou quelque chose. Être arrêté par quelqu'un ou quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "50b3de8b-97fc-498d-9574-d5fed859781c",
                                "sense_id": "26bf8dbc-0b33-3182-8ab4-6e084cb25698",
                                "text": "Mais, dit-on, il y a des obscurités et sans cela, on ne serait pas aheurté à Jésus-Christ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                        "entry_id": "ad5af151-fd33-352c-9293-416ea1fbb5bf",
                        "glosses": [
                            "Se heurter à quelque chose, à un sentiment, une opinion, s'opiniâtrer, s'obstiner."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "babbe9e6-fd6d-46f2-9245-6c6c6005214f",
                                "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                                "text": "Votre belle-mère voulait vous faire religieuse, et elle était aheurtée à cela."
                            },
                            {
                                "example_id": "930f747b-a278-4f4b-ae98-7a71284e3865",
                                "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                                "text": "Voilà à quel état d'esprit venait s'aheurter la prédication de Maximilla et de Priscilla."
                            },
                            {
                                "example_id": "e9079dca-37f2-4829-a7f3-c5a8b697f5f2",
                                "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                                "text": "Cet admirable livre [Jane Eyre] paraissait terne au goût des éditeurs et il l’est en effet, mais il l’est en raison d’un art qui s’aheurte à la vérité sobre et redoute la « littérature »."
                            },
                            {
                                "example_id": "1bffa705-89a6-4c57-80bb-be8a471911b3",
                                "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                                "text": "S’aheurter à un sentiment, à une opinion."
                            },
                            {
                                "example_id": "c9f53b06-8b84-4e58-8bf0-86fea8955103",
                                "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                                "text": "Il s’aheurte à cela contre l’avis de tous ses parents."
                            },
                            {
                                "example_id": "2be04845-db51-4b9e-9b9f-ac0c75b42345",
                                "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                                "text": "S’aheurter à faire quelque chose."
                            },
                            {
                                "example_id": "cd96a579-3191-42ce-89c7-8db98da9c583",
                                "sense_id": "5b823200-0ada-3d32-ad3f-782cd32191fa",
                                "text": "C’est un homme qui s’aheurte tellement à ce qu’il s’est mis une fois dans la tête, qu’on ne le fait jamais revenir."
                            }
                        ]
                    }
                ],
