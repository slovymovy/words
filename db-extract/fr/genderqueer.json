                        "sense_id": "159c7ef1-e0f0-32c1-8962-d064ba931bfb",
                        "entry_id": "7dd819cd-1a0d-30b1-896c-7ee2b3c798a7",
                        "glosses": [
                            "D’une identité de genre qui n’est ni masculine ni féminine, qui sort du schéma binaire « homme ou femme »."
                        ],
                        "tags": [
                            "Genres humains et identités de genre"
                        ],
                        "examples": [
                            {
                                "example_id": "8c15d735-785f-472d-bdb5-6f1b870ce12f",
                                "sense_id": "159c7ef1-e0f0-32c1-8962-d064ba931bfb",
                                "text": "234 personnes ont sollicité les services de CIGALE (112 femmes, 108 hommes et 11 personnes transgenres et 3 personnes genderqueers) et les 348 heures d’encadrement ont été effectuées en relation directe avec les usagers, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86a5dad4-24f1-4033-bb39-95843815509a",
                        "source_entry_id": "7dd819cd-1a0d-30b1-896c-7ee2b3c798a7",
                        "source_sense_id": "159c7ef1-e0f0-32c1-8962-d064ba931bfb",
                        "target_lang_word": "genderqueer",
