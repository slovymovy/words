                ],
                "senses": [
                    {
                        "sense_id": "812d69d2-82c1-3c07-b805-716f86ec863e",
                        "entry_id": "c0e58e4d-09ae-3818-b5d5-f3aaf3a2d540",
                        "glosses": [
                            "Ce qui se rapporte aux affects : humeurs, émotions, sentiments, motivations, passions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e1347a-653f-4ac2-bf04-6e2d1a65e7b8",
                                "sense_id": "812d69d2-82c1-3c07-b805-716f86ec863e",
                                "text": "Ce retour à l’honnêteté affective et sexuelle des élites françaises est un progrès probablement plus important pour notre pays que les changements et manipulations constitutionnels de l’après-guerre ou de 1958."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7ec3a67-8b39-3bae-9112-b4dff8681fb6",
                        "entry_id": "c0e58e4d-09ae-3818-b5d5-f3aaf3a2d540",
                        "glosses": [
                            "Tendre, affectueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9a3966f-434d-4fb0-a1d1-3c55f7530900",
                                "sense_id": "a7ec3a67-8b39-3bae-9112-b4dff8681fb6",
                                "text": "Cet enfant est très affectif."
                            }
                        ]
                    },
                    {
                        "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                        "entry_id": "c0e58e4d-09ae-3818-b5d5-f3aaf3a2d540",
                        "glosses": [
                            "Qui inspire de l’affection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce932fa-8cb7-4116-8a41-b7adc0e121f2",
                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                "text": "Il parle des choses de Dieu d’une manière très affective."
                            },
                            {
                                "example_id": "d38f2b1a-9106-425b-8696-0d552b9d32e1",
                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                "text": "Saint Bernard est un des pères de l’église les plus affectifs."
                            },
                            {
                                "example_id": "2b72a8aa-ae2a-45f5-a8ad-e00edc3b470a",
                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                "text": "On a imprimé des livres sous le titre de Théologie affective."
                            },
                            {
                                "example_id": "7c446f09-2fde-44cb-8ee4-9d9afcf66376",
                                "sense_id": "d16f6e64-a37c-31db-b952-c88b168d76af",
                                "text": "Ainsi, les cadres qui manifestent un fort engagement affectif et qui sont donc plus mobilisés ne le sont pas pour des conditions matérielles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e908e9a6-6090-444a-9e0f-3bc0297304f0",
