                                        "entry_id": "efd05afc-a45c-303b-8067-963fbe74210a",
                                        "glosses": [
                                            "ein zylinderförmiger, hohler Gegenstand zur Durchleitung von Flüssigkeiten, Gasen und Feststoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d6d9445-9a5c-4cce-8fce-4f720fe4fb2e",
                                                "sense_id": "0c859306-54c2-317a-a254-6f92b0fbd382",
                                                "text": "Das sind sehr stabile Rohre."
                                            },
                                            {
                                                "example_id": "e5382949-885c-4a2a-9a76-cc6230a518f7",
                                                "sense_id": "0c859306-54c2-317a-a254-6f92b0fbd382",
                                                "text": "„Noby wies auf diverse Rohre, die sich hinter dem Dieselmotor erstreckten und in der Decke verschwanden.“"
                                            },
                                            {
                                                "example_id": "f0c95a04-ea76-45f1-b247-274823455bb5",
                                                "sense_id": "0c859306-54c2-317a-a254-6f92b0fbd382",
                                                "text": "„Zersplitterte Rohre, verrostete Eisenträger starrten wie Skeletteile in die Luft.“"
                                            },
                                            {
                                                "example_id": "3af096fd-39e8-41ed-a98a-6dc04e087b0b",
                                                "sense_id": "0c859306-54c2-317a-a254-6f92b0fbd382",
                                                "text": "„Das Rohr des Herdes war leicht wieder zu befestigen und durch ein zerbrochenes Fenster zu führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b01e34e7-6990-3851-ac14-ca6f1bee43e6",
                                        "entry_id": "efd05afc-a45c-303b-8067-963fbe74210a",
                                        "glosses": [
