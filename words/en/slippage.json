{
    "word_family": [
        "slip",
        "slipper",
        "slippery",
        "slipway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0c41959-5682-36b8-9a46-4c26410bc4aa",
                    "sense_definition": "A decline, failure, or delay in performance, standards, or a planned schedule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager noticed a worrying <w>slippage</w> in overall customer satisfaction this quarter.",
                            "target_lang_translations": {
                                "ru": "Менеджер заметил тревожный <w>спад</w> общего уровня удовлетворенности клиентов в этом квартале."
                            }
                        },
                        {
                            "text": "Supply-chain problems led to a significant <w>slippage</w> in the project schedule.",
                            "target_lang_translations": {
                                "ru": "Проблемы с цепочкой поставок привели к значительному <w>отставанию</w> от графика проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "decline",
                        "deterioration",
                        "drop"
                    ],
                    "antonyms": [
                        "improvement",
                        "progress"
                    ],
                    "common_phrases": [
                        "schedule slippage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спад, ухудшение показателей или отставание от намеченного графика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отставание",
                                "target_lang_sense_clarification": "от графика, плана"
                            },
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "в показателях, стандартах"
                            },
                            {
                                "target_lang_word": "ухудшение",
                                "target_lang_sense_clarification": "качества или ситуации"
                            },
                            {
                                "target_lang_word": "срыв сроков",
                                "target_lang_sense_clarification": "задержка графика"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "670fd53f-a713-3d16-9111-928392a67b61",
                    "sense_definition": "The act of sliding or slipping out of place, especially from a secure position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_slip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician tightened the clamp securely to prevent any <w>slippage</w> during operation.",
                            "target_lang_translations": {
                                "ru": "Техник надежно затянул зажим, чтобы предотвратить любое <w>соскальзывание</w> во время работы."
                            }
                        },
                        {
                            "text": "Ice on the walkway caused dangerous <w>slippage</w> for pedestrians.",
                            "target_lang_translations": {
                                "ru": "Лед на дорожке создавал опасное <w>скольжение</w> для пешеходов."
                            }
                        }
                    ],
                    "synonyms": [
                        "sliding",
                        "skidding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скольжение или смещение с исходного, надежно зафиксированного места."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соскальзывание",
                                "target_lang_sense_clarification": "смещение с места"
                            },
                            {
                                "target_lang_word": "скольжение",
                                "target_lang_sense_clarification": "процесс движения по поверхности"
                            },
                            {
                                "target_lang_word": "смещение",
                                "target_lang_sense_clarification": "сдвиг детали или предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "144a57db-86ac-3258-a7b1-8a41feff6b45",
                    "sense_definition": "The measured amount, distance, or extent by which something has moved or fallen behind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers recorded a two-inch <w>slippage</w> in the foundation after the heavy rainfall.",
                            "target_lang_translations": {
                                "ru": "Инженеры зафиксировали двухдюймовый <w>сдвиг</w> фундамента после сильного ливня."
                            }
                        },
                        {
                            "text": "The team worked overtime to recover the two weeks of <w>slippage</w> in the timeline.",
                            "target_lang_translations": {
                                "ru": "Команда работала сверхурочно, чтобы наверстать двухнедельное <w>отставание</w> от графика."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Измеренная величина, расстояние или период, на который объект сдвинулся или отстал от нормы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "величина смещения",
                                "target_lang_sense_clarification": "физическое расстояние сдвига"
                            },
                            {
                                "target_lang_word": "задержка",
                                "target_lang_sense_clarification": "размер отставания по времени"
                            },
                            {
                                "target_lang_word": "сдвиг",
                                "target_lang_sense_clarification": "изменение положения или срока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c4fdd78-43b0-39f0-9c5f-dd0096514944",
                    "sense_definition": "The downward movement of earth or rock on a slope; a landslip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rains triggered a massive soil <w>slippage</w> along the mountain road.",
                            "target_lang_translations": {
                                "ru": "Проливные дожди вызвали масштабный <w>оползень</w> вдоль горной дороги."
                            }
                        },
                        {
                            "text": "The <w>slippage</w> at the cliffside was detected by sensors before any damage occurred.",
                            "target_lang_translations": {
                                "ru": "<w>Сползание грунта</w> на краю обрыва было обнаружено датчиками до того, как возникли какие-либо повреждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "landslip",
                        "landslide"
                    ],
                    "common_phrases": [
                        "soil slippage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сползание грунта или горных пород вниз по склону; оползень."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оползень",
                                "target_lang_sense_clarification": "сход грунта"
                            },
                            {
                                "target_lang_word": "сползание",
                                "target_lang_sense_clarification": "медленный сдвиг почвы или пород"
                            },
                            {
                                "target_lang_word": "сдвиг грунта",
                                "target_lang_sense_clarification": "смещение пластов земли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc4c6f1b-16f1-3692-82fc-a01dec26bb0c",
                    "sense_definition": "A loss of power, motion, or efficiency in a mechanical system caused by friction loss or slipping parts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_slip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Worn gear teeth caused noticeable power <w>slippage</w> in the engine.",
                            "target_lang_translations": {
                                "ru": "Изношенные зубья шестерен привели к заметному <w>проскальзыванию</w> мощности в двигателе."
                            }
                        },
                        {
                            "text": "Adjusting the drive belt will reduce <w>slippage</w> and restore efficiency.",
                            "target_lang_translations": {
                                "ru": "Регулировка приводного ремня уменьшит <w>проскальзывание</w> и восстановит эффективность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "belt slippage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потеря мощности, движения или эффективности в механической системе из-за трения или проскальзывания деталей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проскальзывание",
                                "target_lang_sense_clarification": "в механизмах, ремнях, шестернях"
                            },
                            {
                                "target_lang_word": "пробуксовка",
                                "target_lang_sense_clarification": "колес, привода"
                            },
                            {
                                "target_lang_word": "скольжение",
                                "target_lang_sense_clarification": "механическое трение со сдвигом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82cc53ef-a2b5-366e-a240-a8a307cbcb17",
                    "sense_definition": "The difference between the expected price of a financial trade and the price at which it is actually executed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High market volatility can lead to substantial <w>slippage</w> when executing large orders.",
                            "target_lang_translations": {
                                "ru": "Высокая волатильность рынка может привести к существенному <w>проскальзыванию</w> при исполнении крупных ордеров."
                            }
                        },
                        {
                            "text": "Traders often set a maximum acceptable <w>slippage</w> to avoid unexpected losses.",
                            "target_lang_translations": {
                                "ru": "Трейдеры часто устанавливают максимально допустимое <w>проскальзывание</w>, чтобы избежать неожиданных потерь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "price slippage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разница между ожидаемой ценой сделки и реальной ценой ее исполнения на финансовом рынке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проскальзывание",
                                "target_lang_sense_clarification": "разница в цене исполнения ордера"
                            },
                            {
                                "target_lang_word": "слиппедж",
                                "target_lang_sense_clarification": "жаргонизм в трейдинге"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}