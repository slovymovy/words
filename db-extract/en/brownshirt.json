                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c35f843d-0367-4d97-b753-1e3692249630",
                                                "sense_id": "860aebad-0501-39e0-b90e-f939610d1dca",
                                                "text": "Om zijn opmerkingen over migratie werd hij een bruinhemd genoemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d34b9dd-412b-46ae-a15d-45a63c601d71",
                        "source_entry_id": "0caff7bb-1dfb-3936-8da0-e33abf339444",
                        "source_sense_description": "a uniformed member of the Nazi party",
                        "target_lang_word": "chemise brune",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chemise brune",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3af4ade5-90cd-3c80-9ebb-8c0a33669540",
                                        "entry_id": "6b7b25d5-6af0-347e-8b38-3b205bccb3da",
                                        "glosses": [
                                            "Membre de la Sturmabteilung, de la SA nazie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "983f0cc0-d155-3d7b-8731-001d5f3e4aa2",
                                        "entry_id": "6b7b25d5-6af0-347e-8b38-3b205bccb3da",
                                        "glosses": [
                                            "Fasciste."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89c8a3cb-e08f-452a-8071-952f182968dc",
                                                "sense_id": "983f0cc0-d155-3d7b-8731-001d5f3e4aa2",
                                                "text": "D'emblée, Ardisson interpelle son invité. \"J'avais envie de vous voir en face ce soir, Yassine, parce que quand quelqu'un dit du mal de moi, je préfère l'inviter. (...) Quel est le problème, Yassine? Est-ce qu'en France, on peut critiquer toutes les religions, sauf l'islam? Comme vous dites que je suis devenu une chemise brune, c'est quand même le point Godwin, c'est quand même que je suis un nazi. Je ne critique pas l'islam, j'ai peur des islamistes. Je pense que nous sommes un certain nombre dans ce pays\", explique l'animateur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e551d319-f5bd-4f21-90f1-31598eac7ca3",
                        "source_entry_id": "0caff7bb-1dfb-3936-8da0-e33abf339444",
                        "source_sense_description": "a uniformed member of the Nazi party",
                        "target_lang_word": "Braunhemd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Braunhemd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71331462-fd91-3bf1-a405-3346b63f6d27",
                                        "entry_id": "6d93b1bd-e1bb-39da-a2b1-7936a3c9da0a",
                                        "glosses": [
                                            "Hemd der Uniform von Nationalsozialisten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b1b546-ff17-4998-bac7-998969573843",
                                                "sense_id": "71331462-fd91-3bf1-a405-3346b63f6d27",
                                                "text": "„Rom wurde freigesprochen, weil Glaser einen Entlastungszeugen fand, der den Mut hatte, im Gerichtssaal gegen die auf ein Todesurteil wartenden Braunhemden aufzutreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da1c05e2-9219-3d1a-bcbf-bcd0a931e2ae",
                                        "entry_id": "6d93b1bd-e1bb-39da-a2b1-7936a3c9da0a",
                                        "glosses": [
                                            "Person, die [1] trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305d66c8-3886-416d-9f39-c267d3c221f7",
                                                "sense_id": "da1c05e2-9219-3d1a-bcbf-bcd0a931e2ae",
                                                "text": "„Johann hatte keine gute Meinung von ihr und wurde sogar einmal von den Braunhemden verprügelt, aber er wollte überleben.“"
                                            },
                                            {
                                                "example_id": "2db4350d-f4a6-4576-bf58-2f25d56b2df0",
                                                "sense_id": "da1c05e2-9219-3d1a-bcbf-bcd0a931e2ae",
                                                "text": "„Ein Trupp von Braunhemden war gerade dabei, die Litfaßsäule mit knallroten Transparenten zu überkleben.“"
                                            },
                                            {
                                                "example_id": "a32a2f4e-cdbc-45c2-82e7-a40c0783038a",
                                                "sense_id": "da1c05e2-9219-3d1a-bcbf-bcd0a931e2ae",
                                                "text": "„Seine Braunhemden sind nichts als Pöbel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
