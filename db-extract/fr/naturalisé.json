                        "entry_id": "c9c0d1ef-3891-3e63-87b6-7e95ab06f0f4",
                        "glosses": [
                            "Personne qui a été naturalisée pour obtenir la nationalité du pays de son choix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b552ab7-8f9b-45c4-8e5e-ab03d0b9fac1",
                                "sense_id": "282a8bf1-ca87-3d41-aa50-ae34f74fd06c",
                                "text": "Je crains que mon pays ne puisse jamais compter sur moi dans une guerre civile et j'ai toujours strictement refusé de commander le moindre peloton d'exécution, ce qui est dû probablement à quelque obscur complexe de naturalisé."
                            }
                        ]
                    }
                ],
