                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd6900f3-6c80-4c99-8c26-cce963ad1781",
                                "sense_id": "9c1769cf-14ce-3134-a735-9ed30d8d776d",
                                "text": "„Auch im Ferienzug will er keinen Überfall riskieren, weil er ebenfalls zu stark besetzt war.“"
                            },
                            {
                                "example_id": "c7011349-ce55-4409-a638-3a725c40e9fd",
                                "sense_id": "9c1769cf-14ce-3134-a735-9ed30d8d776d",
                                "text": "„Soweit ich mich erinnern kann, bestand der Ferienzug aus weißen Küchenwagen, blauen Club - und Kinowagen, roten Speisewagen sowie roten und grünen Schlafwagen.“"
                            }
                        ],
