                                "sense_id": "941dc8c3-75ff-3a63-ac60-7b0c82af1ded",
                                "text": "Hij heeft het papier domweg weggegooid."
                            },
                            {
                                "example_id": "f3d45d30-56ac-4d38-92ca-ed35f57e1bc8",
                                "sense_id": "941dc8c3-75ff-3a63-ac60-7b0c82af1ded",
                                "text": "Domweg gelukkig, in de Dapperstraat."
                            },
