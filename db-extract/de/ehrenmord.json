                "senses": [
                    {
                        "sense_id": "2eff89bf-2fd9-3550-a3e4-3b8e4ac93aa6",
                        "entry_id": "5fae2754-f2f8-3d3c-8e69-44e2f50c61c1",
                        "glosses": [
                            "honour killing, honor killing"
                        ],
