                    {
                        "translation_id": "115b53be-072c-46ed-851e-b2faed35322c",
                        "source_entry_id": "bc679786-7021-3b4b-aa19-e027c58d444b",
                        "source_sense_id": "93ab5f68-97d3-3c64-974a-6c11703be804",
