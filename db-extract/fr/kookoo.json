                        "glosses": [
                            "Spécialité culinaire d’Iran, où les ingrédients sont liés avec des œufs puis cuits à la poêle sous forme de galette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90b10c17-c402-4284-9bfd-356393ae2748",
                                "sense_id": "9c33e8cd-6bcb-342d-88f2-5beb67fb5ff3",
                                "text": "Le kookoo est un plat iranien non seulement très facile et très rapide à préparer, mais en plus, frais et bon marché."
                            },
                            {
                                "example_id": "4b1e75a0-68cf-4635-a0aa-87a93d83173c",
                                "sense_id": "9c33e8cd-6bcb-342d-88f2-5beb67fb5ff3",
                                "text": "Par son apparence et sa texture, on assimile souvent le kuku à un kookoo perse, un eggah du Moyen-Orient, une tortilla espagnole ou encore une frittata italienne."
                            },
                            {
                                "example_id": "25c7a6fc-4c4a-4a5e-b8dc-69160723bcb2",
                                "sense_id": "9c33e8cd-6bcb-342d-88f2-5beb67fb5ff3",
                                "text": "A mi-chemin entre la tarte et l'omelette, le kookoo est l'une des recettes les plus populaires du pays."
                            }
                        ]
                    }
