                                    {
                                        "sense_id": "622b88b5-b94d-3d0c-b08c-388090d920ed",
                                        "entry_id": "b2b3f9b8-e230-3f22-9641-c3b9c4cb288b",
                                        "glosses": [
                                            "Qui est porté à embrasser, qui en a la manie ou l’habitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90159893-4b77-4449-965d-3cbf9182e91e",
                                                "sense_id": "622b88b5-b94d-3d0c-b08c-388090d920ed",
                                                "text": "Non pour obéir à une vie sentimentalement agitée, mais parce que je suis plus embrasseur que la moyenne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "embrasseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc292054-8db9-3c8e-bb4b-79ae2229dd8e",
                                        "entry_id": "0a02c5a7-8e1c-3620-b2ac-be267dc07e24",
                                        "glosses": [
                                            "Celui qui embrasse, qui aime à embrasser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b2dc4b9-c341-401b-adf5-aa1713a155dc",
                                                "sense_id": "dc292054-8db9-3c8e-bb4b-79ae2229dd8e",
                                                "text": "Il était plus vif que le roi, plus en dehors, affectueux, grand embrasseur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "embrasseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e81d827-dbc4-32da-a9be-2097a5b73fa5",
                                        "entry_id": "aab9a6d5-9d05-3395-9616-aca7b334e282",
                                        "glosses": [
                                            "Bande de fer qui embrasse les tourillons d’une pièce d’artillerie, pendant le forage ^([1])."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce10aeda-64d1-48cb-b45c-76b5a5c91026",
                        "source_entry_id": "9a2003d0-0370-33d5-aa8b-1f8c3c870aac",
                        "source_sense_description": "one who kisses",
                        "target_lang_word": "Küsser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Küsser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                        "entry_id": "5153140c-2cdb-3186-8a9a-cd6bd9d0fb6e",
                                        "glosses": [
                                            "Person, die eine andere küsst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079ceb60-3842-4587-8bbf-26b8f769c883",
                                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                                "text": "„Aggressive Küsser sind nach Erfahrung der Befragten Egoisten, die vor allem selbst auf ihre Kosten kommen wollen.“"
                                            },
                                            {
                                                "example_id": "7248979b-b2f9-4191-a1ee-57c0b01c3882",
                                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                                "text": "„Als Lejla noch lebte, haben sie einander mindestens 20 SMS am Tag geschickt. Haben über Mindestlohn und Chancengleichheit diskutiert, über schlechte Küsser und krasse Diätregeln gelästert, über Differenzialrechnungen geklagt und sich gegenseitig über neue Nagellackmarken und neue Pickel informiert.“"
                                            },
                                            {
                                                "example_id": "d86164b9-5b05-445f-937f-62b0b46e1156",
                                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                                "text": "„Die Spanier fanden bei einer weiteren Studie zum \"Europäischen Kussverhalten\" auch heraus, dass Deutschland besonders schlechte Küsser hervorbringt.“"
                                            },
                                            {
                                                "example_id": "28dd89fa-3edd-4ec5-8703-d7c7e3fe0a9b",
                                                "sense_id": "14bead87-0080-3c3e-af0d-a1ab69693c89",
                                                "text": "„Es gab die enthusiastischen Küsser, die mit der Zunge spielten, und solche, die beim Küssen automatisch versuchten, eine Hand unter mein T-Shirt zu schieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
