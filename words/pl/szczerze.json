                {
                    "sense_id": "2a1a0f6d-880b-33d7-9d1f-eaa0beae12ec",
                    "sense_definition": "Słowo wzmacniające wypowiedź, oznaczające, że coś jest prawdziwe lub bardzo intensywne; naprawdę.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jestem <szczerze> zdziwiony, że tak szybko skończyłeś pracę.",
                            "target_lang_translations": {
                                "ru": "Я <искренне> удивлен, что ты так быстро закончил работу.",
                                "en": "I am <genuinely> surprised that you finished the work so quickly.",
                                "nl": "Ik ben <oprecht> verbaasd dat je zo snel klaar was met het werk.",
                                "de": "Ich bin <wirklich> überrascht, dass du die Arbeit so schnell beendet hast.",
                                "fr": "Je suis <vraiment> surpris que tu aies fini le travail si vite.",
                                "it": "Sono <davvero> sorpreso che tu abbia finito il lavoro così velocemente.",
                                "cs": "Jsem <upřímně> překvapený, že jsi tak rychle dokončil práci.",
                                "tr": "İşi bu kadar çabuk bitirmene <gerçekten> şaşırdım.",
                                "es": "Estoy <realmente> sorprendido de que hayas terminado el trabajo tan rápido.",
                                "zh": "你这么快就完成了工作，我感到<w>真心地</w>惊讶。"
                            }
                        },
                        {
                            "text": "Ona <szczerze> nienawidzi wstawać wcześnie rano.",
                            "target_lang_translations": {
                                "ru": "Она <по-настоящему> ненавидит вставать рано утром.",
                                "en": "She <really> hates getting up early in the morning.",
                                "nl": "Ze haat het <echt> om vroeg in de ochtend op te staan.",
                                "de": "Sie hasst es <aufrichtig>, früh am Morgen aufzustehen.",
                                "fr": "Elle déteste <vraiment> se lever tôt le matin.",
                                "it": "Lei odia <veramente> alzarsi presto la mattina.",
                                "cs": "Ona <opravdu> nesnáší vstávání brzy ráno.",
                                "tr": "Sabah erkenden kalkmaktan <cidden> nefret ediyor.",
                                "es": "Ella <sinceramente> odia levantarse temprano por la mañana.",
                                "zh": "她<w>真正地</w>讨厌清晨起床。"
                            }
                        }
                    ],
