                        "glosses": [
                            "mężczyzna obsługujący garderobę aktorską"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11205efd-517e-4b00-b5c4-48827e8bb737",
                                "sense_id": "f7d6936d-b59c-3771-94e5-7594b29163a9",
                                "text": "W połowie spektaklu garderobiani oczekują już w garderobach."
                            }
                        ],
