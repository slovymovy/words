                        "sense_id": "0720f5a2-4086-36de-85fd-5bfc3ad699ad",
                        "entry_id": "e9097248-efa1-388c-ae1d-73aeea78abb0",
                        "glosses": [
                            "Variété mixte (viande surtout) de très petits taurins, originaires du Portugal (nord), à cornes longues et à robe fauve, plus petite que le taurin barrosa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1be36961-3806-434c-8957-3db9965322e5",
                                "sense_id": "0720f5a2-4086-36de-85fd-5bfc3ad699ad",
                                "text": "La cachena vit aussi en Galice (Espagne)."
                            },
                            {
                                "example_id": "a1f81187-624e-48db-b1e9-0259bd74ba84",
                                "sense_id": "0720f5a2-4086-36de-85fd-5bfc3ad699ad",
                                "text": "Concernant les bovins, le pays compte une dizaine de races dont la quasi totalité était destinée au travail de la terre. Le nord du Portugal possède une variété significative de races bovines : la Barrosâ, la Galega, la Cachena, la Mirandesa, la Maronesa, la Marinhoa et la Arouquesa."
                            }
                        ]
                    }
