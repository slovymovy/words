                "senses": [
                    {
                        "sense_id": "d4dedd51-4997-3c52-b8b3-bdb817fb812a",
                        "entry_id": "703c1b45-bc54-33e4-9b20-2b23e0e51b8c",
                        "glosses": [
                            "разг. превзойти громкостью, продолжительностью или музыкальностью свиста кого-либо, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ff63b7-c766-42ad-a76b-02fe48d58e73",
                                "sense_id": "d4dedd51-4997-3c52-b8b3-bdb817fb812a",
                                "text": "Тогда он встал во весь рост и еще громче пересвистел аплодисменты зала."
                            },
                            {
                                "example_id": "737cd173-127b-46da-96f4-73c6efadb858",
                                "sense_id": "d4dedd51-4997-3c52-b8b3-bdb817fb812a",
                                "text": "Радиолюбителям надо проявить максимум гражданской сознательности для того, чтобы часы молчания были, действительно, вечерами слушания дальних станций, а не вечерами упражнений «кто кого пересвистит»."
                            }
                        ]
                    }
