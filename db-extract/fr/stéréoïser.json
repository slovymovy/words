                "senses": [
                    {
                        "sense_id": "9347ff7d-9db4-38da-bf43-2cab8b3c616f",
                        "entry_id": "b91ee605-02f3-3d50-93d0-42f5a7422cd7",
                        "glosses": [
                            "Donner un caractère stéréo à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee7d637-341a-4441-834b-b39246ee7032",
                                "sense_id": "9347ff7d-9db4-38da-bf43-2cab8b3c616f",
                                "text": "Selon l'éditeur, toute la différence sonore vient de là. Caractéristiques : Flanger « through-zero »; Permet de « stéréoïser » les sons mono; Effet flanger à l'ancienne pouvant être utilisé à des fins brutales; Automatisation Midi."
                            },
                            {
                                "example_id": "ebc51a21-1c80-4f62-a0f5-51c48881b5ef",
                                "sense_id": "9347ff7d-9db4-38da-bf43-2cab8b3c616f",
                                "text": "Cependant not' cerveau a l'habitude de mélanger et stéréoïser ce que deux yeux voient."
                            },
                            {
                                "example_id": "0c23ad4c-0ac2-477e-ba0f-a9103fc35460",
                                "sense_id": "9347ff7d-9db4-38da-bf43-2cab8b3c616f",
                                "text": "Le choix d'un retard au format Mono In/Stereo Out permet de « stéréoïser » la sortie d'une piste mono."
                            }
                        ]
                    }
                ],
