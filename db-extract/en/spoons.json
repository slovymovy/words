                        "sense_id": "6f386284-5393-3987-a5aa-aa2cb83f84a9",
                        "entry_id": "83b7e99f-bd03-3e54-9eef-61d05ad6861e",
                        "glosses": [
                            "Any pub belonging to the Wetherspoons chain."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2eefde6c-440e-4711-8a16-e451a23080a2",
                                "sense_id": "6f386284-5393-3987-a5aa-aa2cb83f84a9",
                                "text": "We took up the recommendation of the Pheasant in Brill, which is a lovely pub but which sadly only did food until 2 which we'd missed, so went to Spoons in Bicester for a late lunch instead, via a quick inspection of the charming little church in Ludgershall."
                            },
                            {
                                "example_id": "111fe123-1df6-40bd-b2c8-e09a4e444494",
                                "sense_id": "6f386284-5393-3987-a5aa-aa2cb83f84a9",
                                "text": "We went to Spoons but it was too busy so went across to The Punch House which I'm glad we did as the food was delicious. I had wild rice, nut and honey bake."
                            }
                        ]
                    }
