                "senses": [
                    {
                        "sense_id": "8b9ddbda-a288-3a44-bd3a-47772488ec88",
                        "entry_id": "bc02be37-733b-3802-82b5-5c66d8373dd7",
                        "glosses": [
                            "dat er geen verzekering voor is af te sluiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b971b19-e51d-457d-946d-b3d942c15999",
                                "sense_id": "8b9ddbda-a288-3a44-bd3a-47772488ec88",
                                "text": "In een interview aan nieuwswebsite Vox zegt Dave Jones, die leiding gaf aan de regulering van de verzekeringsmarkt in Californië, dat Ämerika is begonnen is aan een gestage mars naar een onverzekerbare toekomst\"."
                            },
                            {
                                "example_id": "e1539465-00db-4277-a3ba-b44a4df87a81",
                                "sense_id": "8b9ddbda-a288-3a44-bd3a-47772488ec88",
                                "text": "Volgens Broenland zijn de overlevingskansen van mensen met kanker de afgelopen decennia enorm gestegen. \"Dit betekent dat de groep mensen die met of na kanker leeft steeds groter wordt, en dus dat de groep die onverzekerbaar is meegroeit.\""
                            }
                        ]
                    }
