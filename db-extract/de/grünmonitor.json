                "senses": [
                    {
                        "sense_id": "f2df2bb6-3a4e-3273-b832-efa6987428f6",
                        "entry_id": "0f636cec-c0c8-33da-b5a2-22d966231745",
                        "glosses": [
                            "ein Monochrommonitor, der grüne Zeichen und Grafiken auf schwarzem Hintergrund darstellt"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "cd693a61-99ef-4e57-82bd-5bc93f8846c5",
                                "sense_id": "f2df2bb6-3a4e-3273-b832-efa6987428f6",
                                "text": "Der Grünmonitor schränkt gegenüber dem Farbmonitor die Grafikbearbeitung ein, da er nur Grün und Schwarz darstellen kann."
                            },
                            {
                                "example_id": "914baecd-f94a-476e-b699-fc2843841a1a",
                                "sense_id": "f2df2bb6-3a4e-3273-b832-efa6987428f6",
                                "text": "Zur visuellen Darstellung dient ein Grünmonitor mit den Auflösungen 64×16 oder 80×24 Zeichen."
                            },
                            {
                                "example_id": "7513507a-bdc3-4d0b-9991-43bae485a175",
                                "sense_id": "f2df2bb6-3a4e-3273-b832-efa6987428f6",
                                "text": "Ging es dennoch über eine nicht erfasste Strasse oder einen Waldweg, sprang das Fadenkreuz auf dem (damals noch üblichen) Grünmonitor eben auf die nächst erreichbare Strasse."
                            },
                            {
                                "example_id": "68cb5823-26aa-4f85-a67a-27cf611c5034",
                                "sense_id": "f2df2bb6-3a4e-3273-b832-efa6987428f6",
                                "text": "„Als Komplettangebot mit integriertem Kassettenrekorder und Grünmonitor (Farbmonitor optional) konnte der CPC-464 über 2 Mio. mal verkauft werden.“"
                            },
                            {
                                "example_id": "0e30720a-7f04-4f7d-ae67-78b929988c36",
                                "sense_id": "f2df2bb6-3a4e-3273-b832-efa6987428f6",
                                "text": "„Erst der Computer (anfangs noch mit Grünmonitor und echter, spiegelnder Bildröhre) hat diese einfach zu merkenden Richtwerte zunichte gemacht.“"
                            },
                            {
                                "example_id": "561a2b40-3879-4ba7-918a-8b53373eb6a7",
                                "sense_id": "f2df2bb6-3a4e-3273-b832-efa6987428f6",
                                "text": "„Und dort bekommt man einen umfangreichen Einblick in die DDR-Computertechnik. PCs, Computerterminals, Drucker … etwa zwei Drittel der alten Maschinen sind noch funktionsfähig wie der Nadeldrucker K6314, PC 1715 oder der RFT-Bürocomputer MC 80.22 mit eingebautem Grünmonitor sowie Kassettenrekorder & EPROM Brenner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
