                "senses": [
                    {
                        "sense_id": "f22270cb-61e1-3d46-b065-8af840e47a5a",
                        "entry_id": "0976f28f-3d5a-3050-8b0f-7e4de7951ed4",
                        "glosses": [
                            "In spite of, notwithstanding."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "df5f21a3-8280-4f3b-a3f4-eb5c75409b37",
                                "sense_id": "f22270cb-61e1-3d46-b065-8af840e47a5a",
                                "text": "He saugh a mayde walkinge him biforn, / Of whiche mayde anon, maugree hir heed, / By verray force he rafte hir maydenheed; […]"
                            },
                            {
                                "example_id": "a19598f7-e1fd-4bc0-8d1f-b61652690083",
                                "sense_id": "f22270cb-61e1-3d46-b065-8af840e47a5a",
                                "text": "In my mind it is a ſign of a great deal of natural Integrity and inbred Nobleneſs of ſpirit, that maugre the heavineſs of his Complexion that thus ſtrongly bears him dovvn from apprehending ſo concerning Metaphyſicall Truths, yet he retains ſo vivid reſentments of the more sſolid Morality."
                            },
                            {
                                "example_id": "c7a588d5-53bb-40c0-b8fd-0af978979967",
                                "sense_id": "f22270cb-61e1-3d46-b065-8af840e47a5a",
                                "text": "He chains the Deev in the centre of the mountain, and at the suit of Merjân hastens to attack another powerful Deev named Houdkonz; but here, alas! fortune deserts him, and, maugre his talismans and enchanted arms, the gallant Tahmuras falls beneath his foe."
                            }
                        ]
                    }
