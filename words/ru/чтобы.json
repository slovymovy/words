{
    "word_family": [
        "что",
        "чтоб"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "05506b1a-84f5-358d-95df-a25d8867bdbe",
                    "sense_definition": "Союз, указывающий на цель совершения действия; соответствует по значению словам «для того, чтобы».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он пошёл к ним, <w>чтобы</w> во всём разобраться.",
                            "target_lang_translations": {
                                "en": "He went to them <w>to</w> sort everything out.",
                                "zh": "他去找他们，<w>为了</w>把事情弄清楚。"
                            }
                        },
                        {
                            "text": "Мы встали рано утром, <w>чтобы</w> успеть на первый поезд.",
                            "target_lang_translations": {
                                "en": "We got up early in the morning <w>to</w> catch the first train.",
                                "zh": "我们一大早就起床了，<w>为了</w>赶上第一班火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "дабы"
                    ],
                    "common_phrases": [
                        "для того чтобы",
                        "с тем чтобы",
                        "так чтобы"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate the purpose or aim of an action",
                        "zh": "用于表示动作的目的，相当于“为了”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "indicating purpose"
                            },
                            {
                                "target_lang_word": "in order to",
                                "target_lang_sense_clarification": "formal purpose"
                            },
                            {
                                "target_lang_word": "so that",
                                "target_lang_sense_clarification": "purpose with a clause"
                            },
                            {
                                "target_lang_word": "so as to",
                                "target_lang_sense_clarification": "purpose before an infinitive"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "为了",
                                "target_lang_sense_clarification": "表示目的"
                            },
                            {
                                "target_lang_word": "以便",
                                "target_lang_sense_clarification": "表示目的，较正式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70c5c31a-8109-352c-bb5f-13e882386f36",
                    "sense_definition": "Вводит придаточные предложения, выражающие желание, необходимость, сомнение или предполагаемое действие (часто после глаголов «хотеть», «требовать», «сомневаться»).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "subjunctive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не хочу, <w>чтобы</w> такое когда-нибудь повторилось.",
                            "target_lang_translations": {
                                "en": "I don't want this <w>to</w> ever happen again.",
                                "zh": "我不希望<w>让</w>这种事再发生。"
                            }
                        },
                        {
                            "text": "Невозможно, <w>чтобы</w> она сделала это нарочно.",
                            "target_lang_translations": {
                                "en": "It is impossible <w>that</w> she did it on purpose.",
                                "zh": "她不可能故意这样做。"
                            }
                        }
                    ],
                    "synonyms": [
                        "чтоб"
                    ],
                    "common_phrases": [
                        "хочу чтобы",
                        "важно чтобы",
                        "нужно чтобы"
                    ],
                    "target_lang_definitions": {
                        "en": "Introduces a subordinate clause expressing desire, necessity, or doubt",
                        "zh": "引导从句，表示愿望、必要性、怀疑或假设的情况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "that",
                                "target_lang_sense_clarification": "introducing a clause"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "infinitive marker after verbs of desire"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "让",
                                "target_lang_sense_clarification": "表示希望或要求某人做某事"
                            },
                            {
                                "target_lang_word": "希望",
                                "target_lang_sense_clarification": "表示愿望"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f7e0025b-0219-36d0-9981-3248db5fd6c1",
                    "sense_definition": "Употребляется для выражения категорического приказа, требования или угрозы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imperative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Чтобы</w> духу твоего здесь не было!",
                            "target_lang_translations": {
                                "en": "<w>Make sure</w> not a trace of you remains here!",
                                "zh": "<w>务必</w>立刻从这里消失！"
                            }
                        },
                        {
                            "text": "<w>Чтобы</w> завтра работа была полностью готова!",
                            "target_lang_translations": {
                                "en": "<w>See to it that</w> the work is completely ready by tomorrow!",
                                "zh": "<w>必须</w>在明天之前把工作全部完成！"
                            }
                        }
                    ],
                    "synonyms": [
                        "чтоб"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express a strong command, demand, or threat",
                        "zh": "用于表达强烈的命令、要求或威胁。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make sure",
                                "target_lang_sense_clarification": "expressing a demand"
                            },
                            {
                                "target_lang_word": "see to it that",
                                "target_lang_sense_clarification": "expressing a command"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "务必",
                                "target_lang_sense_clarification": "表示强烈的命令"
                            },
                            {
                                "target_lang_word": "必须",
                                "target_lang_sense_clarification": "表示强制性的要求"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}