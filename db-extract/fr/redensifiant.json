                            {
                                "example_id": "ff068a4f-94a3-4fd5-9d41-5ec16078fb80",
                                "sense_id": "c5e88cb7-5d7e-3024-b1b7-930e2291c783",
                                "text": "Certains produits de dernière génération, aux noms étranges, étaient, disait-on, capables de véritables miracles : acides de fruit « revitalisants », élastine « redensifiante », collagène « repulpant », rétinol « restructurant »."
                            },
                            {
                                "example_id": "c9927083-b953-476c-ac3c-e4e2fc1bea16",
                                "sense_id": "c5e88cb7-5d7e-3024-b1b7-930e2291c783",
                                "text": "Au programme, des soins redensifiants, des compléments alimentaires anti-relâchement et une protection solaire même en ville."
                            },
                            {
                                "example_id": "a5e4e606-aeec-4e4b-84bb-52f2274cdaa5",
                                "sense_id": "c5e88cb7-5d7e-3024-b1b7-930e2291c783",
                                "text": "Crèmes soins redensifiantes et de la cosméto-soin !"
