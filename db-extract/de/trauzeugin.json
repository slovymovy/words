                "senses": [
                    {
                        "sense_id": "fff6692f-b2cd-399d-b38b-594383e90225",
                        "entry_id": "8dba29a0-dc27-3b7f-9271-abf195d3768f",
                        "glosses": [
                            "Frau, die als Zeugin an einer Trauung teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86254b0d-a9bd-4130-bd5c-d2b1e62fd41b",
                                "sense_id": "fff6692f-b2cd-399d-b38b-594383e90225",
                                "text": "„Louise, die zum ersten Mal Trauzeugin ist, trägt ihre Bluse mit Bubi-Kragen und ein Paar Ohrringe.“"
                            },
                            {
                                "example_id": "741b9682-a50b-49e5-8d8f-b56bc48f9108",
                                "sense_id": "fff6692f-b2cd-399d-b38b-594383e90225",
                                "text": "„Die Trauzeugin hingegen wollte ihr wahres Alter nicht verraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
