                                        "entry_id": "12524e56-72ec-344a-8c03-5071be75c91e",
                                        "glosses": [
                                            "\\\"What did you say?\\\" or \\\"Repeat what you have said.\\\" A polite formula used when one has not heard or understood what has been said."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8576ed1-c025-4ae5-bee8-e0075569b92d",
                                                "sense_id": "4e9fb727-ddd8-3903-9e28-5115d2626d5c",
                                                "text": "I'm sorry, I didn't hear you. Please say again?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61bd19c9-404f-331f-b0cb-45fcaf2257e1",
                                        "entry_id": "12524e56-72ec-344a-8c03-5071be75c91e",
                                        "glosses": [
                                            "To repeat part of or entire message transmitted over the radio, used instead of \\\"repeat\\\" which is an artillery procedure word."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
