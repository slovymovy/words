                            },
                            {
                                "target_word": "Hebe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8ff0bbd-1ec1-31da-bd7a-bdf0b09e9497",
                                        "entry_id": "d77f6459-8930-3988-af8c-188c1546474e",
                                        "glosses": [
                                            "A Jew."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53a730c5-0870-461d-8242-075d4fd26634",
                                                "sense_id": "f8ff0bbd-1ec1-31da-bd7a-bdf0b09e9497",
                                                "text": "Well, that's what you get for betting on a Hebe.\nWhat did you say?\nI'm just saying\nMax Baer ain't no Jew."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d10eea1d-707c-4c09-8d72-59bed1b8324d",
                        "source_entry_id": "5f659e20-236e-3db6-af23-53052ad03663",
                        "source_sense_id": "17d5e709-4d32-3072-a6dc-25625e2695c6",
                        "target_lang_word": "Hebe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83c70093-5cea-3ff2-92aa-27738382c572",
                                        "entry_id": "5109af6d-458b-3e68-bc91-5f0eecbf55ed",
                                        "glosses": [
                                            "Abgabe, Spende"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d72a064c-e73c-418c-b303-98b960a7920b",
                                                "sense_id": "83c70093-5cea-3ff2-92aa-27738382c572",
                                                "text": "„Und dies ist die Hebe, die ihr von ihnen nehmen sollt: Gold und Silber und Kupfer; […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a759db66-183f-3e12-a685-a4499573790e",
                                        "entry_id": "5c0ee8f2-64d1-358b-b654-12dc5e682937",
                                        "glosses": [
                                            "griechische Göttin der Jugend; eine Tochter von Zeus und Hera und Mundschenkin der Götter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a1b3d0-6973-40b9-b3ba-32ef20a151a8",
                                                "sense_id": "a759db66-183f-3e12-a685-a4499573790e",
                                                "text": "„Hebe hat tatsächlich kaum einen Mythos, wenn man davon absieht, dass sie Herakles’ Gattin wird, nachdem er im Tode zu göttlichem Rang erhoben ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d75d795f-56c1-3ebc-9fef-75c36402393a",
                                        "entry_id": "d4ddbdaf-6a5c-3a63-9b77-0352eeeb7563",
                                        "glosses": [
                                            "Angestellte in der Gastronomie, deren Aufgabe der Ausschank von Getränken und die Bedienung der Gäste ist"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5082e171-8439-496a-b85d-5ddfe9c1bf1e",
                                                "sense_id": "d75d795f-56c1-3ebc-9fef-75c36402393a",
                                                "text": "Wo bleibt denn die schöne Hebe mit unseren Getränken?"
                                            },
                                            {
                                                "example_id": "7c12dd49-9f1b-4f1e-94ab-2ea51702d45f",
                                                "sense_id": "d75d795f-56c1-3ebc-9fef-75c36402393a",
                                                "text": "„Clairmont kämmte mich gerade, als meine Hebe mit einem Korb in den Händen erschien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
