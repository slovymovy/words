                                            {
                                                "example_id": "335ec439-3232-491b-bcb5-9d57062ddc11",
                                                "sense_id": "98951e19-27d2-37f7-bf6c-4d783462a112",
                                                "text": "Nach hunderten Jahren Dornröschenschlaf wurde diese antike Stadt wiederentdeckt."
                                            },
                                            {
                                                "example_id": "4f8939d8-cb69-4a7c-ba92-ef01d5ea0d0e",
                                                "sense_id": "98951e19-27d2-37f7-bf6c-4d783462a112",
                                                "text": "„In einer Krypta der Kathedrale von Vilnius haben Forschende die lange verschollenen Insignien polnischer und litauischer Herrscher wiederentdeckt.“"
                                            }
