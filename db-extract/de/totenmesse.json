                ],
                "senses": [
                    {
                        "sense_id": "96c37476-053a-304f-ad7e-0046f3667749",
                        "entry_id": "5be3cdcd-3fe8-3c0f-a1ad-c93ab9babdeb",
                        "glosses": [
                            "die Messfeier für Verstorbene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48fadea-618e-4d41-ba0c-c1b994e15b8d",
                                "sense_id": "96c37476-053a-304f-ad7e-0046f3667749",
                                "text": "Rhythmus und Ablauf des Stücks werden von sechs liturgischen Teilen der lateinischen Totenmesse, die als Grundgerüst fungieren, und neun eingeschobenen Gedichtvertonungen des Poeten Wilfred Owen bestimmt."
                            },
                            {
                                "example_id": "31c3f06b-727a-46c8-9073-4eebf46ea15d",
                                "sense_id": "96c37476-053a-304f-ad7e-0046f3667749",
                                "text": "„Am dritten Tage ließ man buddhistische Mönche kommen und die Totenmesse lesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c89114a-0df9-3f2a-a8d1-d872a4d80bce",
                        "entry_id": "5be3cdcd-3fe8-3c0f-a1ad-c93ab9babdeb",
                        "glosses": [
                            "die Messfeier für einen Verstorbenen, meist unmittelbar vor seiner Beerdigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676f0bc8-1992-43d8-aae1-830d8e6c3103",
                                "sense_id": "6c89114a-0df9-3f2a-a8d1-d872a4d80bce",
                                "text": "Die Totenmesse fand vor der Beerdigung statt."
                            },
                            {
                                "example_id": "0351039b-8690-41c8-818e-94cd87fbec3a",
                                "sense_id": "6c89114a-0df9-3f2a-a8d1-d872a4d80bce",
                                "text": "„Reverend William Clarke hielt die Totenmesse und trug ein von Louis verfasstes Gebet vor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "82da124a-9871-33e9-b0e1-cb3269b148c4",
                        "entry_id": "5be3cdcd-3fe8-3c0f-a1ad-c93ab9babdeb",
                        "glosses": [
                            "eine Komposition zur feierlich-musikalischen Ausgestaltung von [1]"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "18b4993c-4c42-4751-9d8c-3af44ef3aef5",
                                "sense_id": "82da124a-9871-33e9-b0e1-cb3269b148c4",
                                "text": "\"Totenmessen gibt es so viele. Es ist müßig, ihnen eine weitere hinzuzufügen.\""
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
