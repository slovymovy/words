                                "sense_id": "387c65ea-5aac-30bb-8c1f-6dbd4ebebc37",
                                "text": "Faire une récurrence sur ℕ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5300bf32-abcb-4773-acae-5805db8b314a",
                        "source_entry_id": "2972669c-eff8-3daa-914f-7c124ec8e51f",
                        "target_lang_word": "Rekurrenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rekurrenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cebdc341-41a4-3e1a-bd64-755a110564c8",
                                        "entry_id": "f0f3798b-31d1-332a-8148-12d0227147aa",
                                        "glosses": [
                                            "Wiederholung sprachlicher Einheiten im Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e1ed46-b311-4b67-a7a8-ba5d03618a2f",
                                                "sense_id": "cebdc341-41a4-3e1a-bd64-755a110564c8",
                                                "text": "In einem Text über Haustierhaltung werden semantische Merkmale (Seme) wie [+belebt], [+männlich], [+weiblich] in den Bedeutungen der erwähnten Tiere mehrfach vorkommen und so zum semantischen Zusammenhalt (Isotopie) des Textes beitragen."
                                            },
                                            {
                                                "example_id": "109fd0ae-be28-4497-ac0c-36eb49a8be0c",
                                                "sense_id": "cebdc341-41a4-3e1a-bd64-755a110564c8",
                                                "text": "Auch die Rekurrenz grammatischer Einheiten (z.B. des gleichen Tempus) kann zum Zusammenhalt der Sätze in Texten beitragen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3c590e1-c3cf-3efb-a401-0f6ea3a93551",
                                        "entry_id": "f0f3798b-31d1-332a-8148-12d0227147aa",
                                        "glosses": [
                                            "Wiederholung, mehrfaches Vorkommen von Krankheiten, Symptomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11091fa1-22d8-461b-94dd-31cb87619084",
                                                "sense_id": "b3c590e1-c3cf-3efb-a401-0f6ea3a93551",
                                                "text": "In der Medizin wird das erneute Auftreten von Symptomen auch als Rekurrenz bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b19e5a78-f4d7-4908-912a-11325f070ebf",
                        "source_entry_id": "2972669c-eff8-3daa-914f-7c124ec8e51f",
                        "target_lang_word": "Wiederkehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederkehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dad04e1-1d74-3906-ac3a-bcafb7f3d2cc",
                                        "entry_id": "27673e07-0f4a-3c9f-92cb-df76deff3472",
                                        "glosses": [
                                            "Vorgang, erneut zu erscheinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ebc486-6e0b-4d54-b40d-304dc3b6ff92",
                                                "sense_id": "9dad04e1-1d74-3906-ac3a-bcafb7f3d2cc",
                                                "text": "„Und als er sich verbissen an die Wiederkehr bestimmter Worte hielt, bildeten sie durch ihre Wiederholung eher Widersprüche als Anhaltspunkte.“"
                                            },
                                            {
                                                "example_id": "17ee0f4a-fabf-4d1d-a4fa-4c095db8a991",
                                                "sense_id": "9dad04e1-1d74-3906-ac3a-bcafb7f3d2cc",
                                                "text": "„Aber die Rückabwicklung der Nachkriegsordnung und die Wiederkehr der überwunden geglaubten Machtpolitik könnte alte nationale Erfahrungen in neuem Licht erscheinen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99709544-6aef-3e2c-b37d-8401f779b96a",
                                        "entry_id": "27673e07-0f4a-3c9f-92cb-df76deff3472",
                                        "glosses": [
                                            "Vorgang, wiederholt vorzukommen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b707a7c-7925-404d-90bf-fa76f23a90ba",
                        "source_entry_id": "2972669c-eff8-3daa-914f-7c124ec8e51f",
                        "target_lang_word": "Wiederholung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiederholung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                        "entry_id": "b327cd12-b8c2-3d32-be07-527f29be9791",
                                        "glosses": [
                                            "nochmalige Durchführung einer Tat, einer Vorgehensweise, einer Übung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fceeddb-c8cc-4fc1-8a09-c2907772409a",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "Bei der Wiederholung der Übungsaufgaben sollte beachtet werden, dass nicht jede Lösung wichtig für die Prüfung ist."
                                            },
                                            {
                                                "example_id": "0a24b4f0-9bf0-4a78-87e9-3e008d63358e",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "Die Wiederholungen der Taten sind zu verhindern, indem man präventiv alles unternimmt, um eine Wiederholung zu ermöglichen."
                                            },
                                            {
                                                "example_id": "ea1a6088-0c5f-4412-a655-b63deaf47c25",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "„Schlafentzug für eine Nacht oder auch nur eine halbe Nacht (bevorzugt der zweiten Nachthälfte) wirkt eindeutig antidepressiv, wenn auch oft nur kurze Zeit, so dass Wiederholungen angezeigt sind.“"
                                            },
                                            {
                                                "example_id": "d6eaf741-9084-4ae5-8311-ba50e641d815",
                                                "sense_id": "99baed46-f832-314f-ba44-c57ec83ce56a",
                                                "text": "„Wir werden immer wieder sehen, dass Wieland der Maßregel folgte, dass Wiederholungen nicht gefallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cb07d03-f6b4-3399-be2a-685b72d97b4a",
                                        "entry_id": "b327cd12-b8c2-3d32-be07-527f29be9791",
                                        "glosses": [
                                            "erneute Ausstrahlung einer Sendung"
                                        ],
                                        "tags": [
                                            "Rundfunk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c196c39-1335-4ce7-9272-f06b73bcd810",
                                                "sense_id": "8cb07d03-f6b4-3399-be2a-685b72d97b4a",
                                                "text": "Das Radio- und Fernsehprogramm ist voller Wiederholungen, so dass es sinnvoller ist entweder schlafen zu gehen oder einen Artikel zum Thema Wiederholung ins Internet einzusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fecf0035-a6af-3cb4-af62-4d7147a81482",
