                "senses": [
                    {
                        "sense_id": "845f1132-5ab2-3b2d-abe4-4d216e0b3d71",
                        "entry_id": "6055e6bf-b63e-3c99-9664-f74b547117ba",
                        "glosses": [
                            "To cross again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119b3fd9-7a6c-4b02-bf01-26ead1516cf8",
                                "sense_id": "845f1132-5ab2-3b2d-abe4-4d216e0b3d71",
                                "text": "The doctor recrossed his legs and followed her impassive gaze which was fixed on the long bread-knife that suddenly appeared to fill the room."
                            },
                            {
                                "example_id": "cc0a4032-9d94-42be-8f76-47d43d3fab3a",
                                "sense_id": "845f1132-5ab2-3b2d-abe4-4d216e0b3d71",
                                "text": "At North Queensferry Station, a short distance beyond the end of the bridge, we left the railway, and made our way down the hill to the pier, to recross the firth by the ferry."
                            },
                            {
                                "example_id": "b53319e5-b5ba-41b5-a972-ba9a1312c916",
                                "sense_id": "845f1132-5ab2-3b2d-abe4-4d216e0b3d71",
                                "text": "Rail and river play tag up the valley and passengers can peer down on the dark moorland waters as we cross and recross the Esk as the '158' threads its way along the route."
                            }
                        ]
                    }
                ],
