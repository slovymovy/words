                        "examples": [
                            {
                                "example_id": "3e798d0a-4de4-4e68-81ae-5a4fbbaeaa83",
                                "sense_id": "b0969684-c8e6-34ec-adf0-704b756f3ec2",
                                "text": "Some relief in this situation will be brought about this year through the procurement of 51 surplus housing units from several Federal installations in the West, the use of 25 trailers as a temporary expedient, and the moving and reerection of 250 surplus federally owned housing units available at Camp Pickett, Va."
                            },
                            {
                                "example_id": "bdbaebba-d03e-41f6-bbf8-cd0d96d254b6",
                                "sense_id": "b0969684-c8e6-34ec-adf0-704b756f3ec2",
                                "text": "When specified that the superstructure is to be salvaged for reerection, all members and loose parts shall be properly matchmarked, all machjined steel surfaces treated with an approved anti-rust compound, and all loose parts wired to adjacent members, or packed in marked boxes."
                            },
                            {
                                "example_id": "ab7009bc-93bf-4559-ae8a-19dbb1f4b288",
                                "sense_id": "b0969684-c8e6-34ec-adf0-704b756f3ec2",
                                "text": "The Catholic Church was a \"gift\" from the Knights of Columbus, who promised to raise $30,000 for its reerection."
                            },
                            {
                                "example_id": "034450df-6e7b-434f-8e23-1dd6277d15fe",
                                "sense_id": "b0969684-c8e6-34ec-adf0-704b756f3ec2",
                                "text": "On September 10, 1834, von Klenze organized a festival, presided over by King Otto, to celebrate the start of the \"reerections” on the Acropolis."
                            }
                        ]
