                        "glosses": [
                            "Poker de nouveau (sur Facebook)."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "9a57a8a7-bc93-4012-b435-de227748ef2b",
                                "sense_id": "5fae4fde-afb1-33fe-95a5-ef8ef35e82f9",
                                "text": "Quand quelqu'un vous poke, vous devez répondre à ce poke, et en répondant, vous pokez à nouveau l'autre personne qui doit vous repoker, et ainsi de suite, ça peut durer des jours, des semaines, des mois, voire des années, alors ne mettez pas le doigt dans l'engrenage, vous n'en sortirez pas vivant."
                            },
                            {
                                "example_id": "08aa313c-7af6-4b04-a998-a45daf481a0c",
                                "sense_id": "5fae4fde-afb1-33fe-95a5-ef8ef35e82f9",
                                "text": "Je te poke, tu me repokes"
                            }
                        ]
                    }
