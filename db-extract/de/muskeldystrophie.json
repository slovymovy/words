                        "entry_id": "e7b19c76-0799-3b16-a65b-c08d5f668b53",
                        "glosses": [
                            "genetisch bedingte Erkrankung, die durch fortschreitende Degeneration der Muskulatur gekennzeichnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21013a4-5b7c-4c91-b71c-182f1bbf214d",
                                "sense_id": "b2786c48-d0bc-3598-88ba-7e400343fcd5",
                                "text": "„Sie hatten nie über die Muskeldystrophie gesprochen.“"
                            },
                            {
                                "example_id": "8f9e656b-0cf7-4dff-bf44-96c3466630f3",
                                "sense_id": "b2786c48-d0bc-3598-88ba-7e400343fcd5",
                                "text": "„Der frei gewordene Platz wird dann in letzter Minute mit Gratisanzeigen für Selbsthilfegruppen im Kampf gegen Krebs oder Muskeldystrophie gefüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
