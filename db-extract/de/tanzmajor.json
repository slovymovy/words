                "senses": [
                    {
                        "sense_id": "7f5faae8-2e7b-3cf5-92bc-5845179252f3",
                        "entry_id": "70bd9fbb-39c3-38c8-a9aa-1e4e58a3c3fe",
                        "glosses": [
                            "männlicher Tanzpartner des Tanzmariechens"
                        ],
                        "tags": [
                            "Karneval",
                            "Fasching",
                            "Fastnacht"
                        ],
                        "examples": [
                            {
                                "example_id": "bd0e3bf4-1697-4499-b6fb-967dd867ec24",
                                "sense_id": "7f5faae8-2e7b-3cf5-92bc-5845179252f3",
                                "text": "„Als männliche Variante des Tanzmariechens wählte man den Namen Tanzmajor aus.“"
                            },
                            {
                                "example_id": "133f4675-4cd8-4cf1-959c-1a42101e3f39",
                                "sense_id": "7f5faae8-2e7b-3cf5-92bc-5845179252f3",
                                "text": "„Das Festkomitee Bottroper Karneval nahm sich einen weiteren Herzenswunsch des Tanzmajors an.“"
                            },
                            {
                                "example_id": "596245fa-389b-43b3-9974-83be2c4d3871",
                                "sense_id": "7f5faae8-2e7b-3cf5-92bc-5845179252f3",
                                "text": "„Ein Jahr später wurde er dann aktiver Gardist der Prinzengarde, ehe er zum Tanzmajor aufstieg.“"
                            },
                            {
                                "example_id": "f8d91d73-bd5e-4fa7-81e8-b09da9b1f94a",
                                "sense_id": "7f5faae8-2e7b-3cf5-92bc-5845179252f3",
                                "text": "„Der Tanzsport hat in Randerath einen besonderen Stellenwert, mit Mariechen wie Nina und Finja, Tanzmajor Tarek sowie der Funkengarde ist der Verein hervorragend aufgestellt.“"
                            },
                            {
                                "example_id": "2b40baa8-29a5-4929-b97d-bc41fe65c59c",
                                "sense_id": "7f5faae8-2e7b-3cf5-92bc-5845179252f3",
                                "text": "„Denn Jungen, also Tanzmajore, können sich nicht als Solotänzer für überregionale Wettbewerbe qualifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
