    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5bd74939-341e-3739-bb91-93e84c4767ec",
                    "sense_definition": "Louer avec enthousiasme, célébrer avec ferveur les mérites ou la grandeur de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "louange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le discours officiel visait à <w>exalter</w> le dévouement et le courage remarquable des bénévoles."
                        },
                        {
                            "text": "Les poètes de cette génération cherchaient à <w>exalter</w> les mérites de la liberté retrouvée."
                        }
                    ],
                    "synonyms": [
                        "glorifier",
                        "louer",
                        "célébrer",
                        "vanter"
                    ],
                    "antonyms": [
                        "dénigrer",
                        "rabaisser",
                        "déprécier"
                    ],
                    "common_phrases": [
                        "exalter les mérites",
                        "exalter la gloire"
                    ]
                },
                {
                    "sense_id": "4f4b2fd7-fd97-3690-908f-fbd6cf37bda4",
                    "sense_definition": "Porter les sentiments, l'esprit ou l'imagination à un très haut degré d'intensité ou d'enthousiasme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La découverte de ces paysages grandioses venait d'<w>exalter</w> l'imagination du jeune artiste."
                        },
                        {
                            "text": "La musique entraînante finit par <w>exalter</w> l'esprit de toute la foule en liesse."
                        }
                    ],
                    "synonyms": [
                        "enflammer",
                        "stimuler",
                        "transporter",
                        "passionner"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer",
                        "tempérer"
                    ],
                    "common_phrases": [
                        "exalter l'imagination",
                        "exalter les passions"
                    ]
                },
                {
                    "sense_id": "8a2e7872-baf8-3a0c-9432-73826303af54",
                    "sense_definition": "S'enflammer, s'enthousiasmer vivement ou se laisser emporter par une passion excessive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enthousiasme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a constamment tendance à s'<w>exalter</w> dès qu'il défend un projet qui lui tient à cœur."
                        },
                        {
                            "text": "Les auditeurs commencèrent à s'<w>exalter</w> en entendant ces nouvelles propositions audacieuses."
                        }
                    ],
                    "synonyms": [
                        "s'enflammer",
                        "s'enthousiasmer",
                        "s'emporter"
                    ],
                    "antonyms": [
                        "se calmer",
                        "se modérer"
                    ],
                    "common_phrases": [
                        "s'exalter facilement",
                        "s'exalter pour une cause"
                    ]
                },
                {
                    "sense_id": "9ab5f683-1329-3b38-8a08-4a83900baff9",
                    "sense_definition": "Élever très haut, porter à son point le plus éminent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces victoires militaires éclatantes ont contribué à <w>exalter</w> la puissance du nouveau souverain."
                        },
                        {
                            "text": "Dans son traité, le philosophe tente d'<w>exalter</w> la dignité morale au-dessus des richesses matérielles."
                        }
                    ],
                    "synonyms": [
                        "élever",
                        "hausser",
                        "magnifier"
                    ],
                    "antonyms": [
                        "abaisser"
                    ],
                    "common_phrases": [
                        "exalter la puissance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "au sens propre ou matériel"
                        }
                    ]
                }
            ]
        }
    ]
