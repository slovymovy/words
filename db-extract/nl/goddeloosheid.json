                        "target_lang_word": "Gottlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gottlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4242dd54-cf25-344d-a356-b5727e07d957",
                                        "entry_id": "127fb6c7-f601-3ac6-8bbb-36d7d8b2797d",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, ohne Gottesglauben zu sein oder Gebote Gottes zu missachten; das Gottlossein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d08ee13-01d4-4cc8-a972-e38da1162b7f",
                                                "sense_id": "4242dd54-cf25-344d-a356-b5727e07d957",
                                                "text": "„Als Perikles’ Macht zeitweise schwindet, wird Anaxagoras von dessen politischen Gegnern der Gottlosigkeit angeklagt.“"
                                            },
                                            {
                                                "example_id": "6bef3f29-de8b-436d-9cd0-f989ea92a5b8",
                                                "sense_id": "4242dd54-cf25-344d-a356-b5727e07d957",
                                                "text": "„Im Prozess vor Pilatus stellen die Hohepriester schließlich ihre eigene Gottlosigkeit heraus. Durch ihr Treubekenntnis zum Kaiser – ‚Wir haben keinen anderen König als den Kaiser‘ – verwerfen sie Gott als den wahren König Israels, begehen damit einen Bundesbruch und setzen zugleich die Hinrichtung Jesu durch.“"
                                            },
                                            {
                                                "example_id": "7a468416-3187-4e20-90b8-4bb91977733e",
                                                "sense_id": "4242dd54-cf25-344d-a356-b5727e07d957",
                                                "text": "„Man klagte den armen Ségur bei der Inquisition der Gottlosigkeit an und fand es verwerflich, daß er sich mit einem Wasser zu waschen wagte, das als der Urin unseres Heilands erscheinen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
