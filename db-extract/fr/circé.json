                                        "entry_id": "28bdfc0a-3419-3e97-b64e-6766d27607a4",
                                        "glosses": [
                                            "Zauberin in der griechischen Sage; Tochter von Helios und Perse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80818abd-b786-4d35-9c48-28add1655b26",
                                                "sense_id": "021e6cc1-4e21-32a8-9e41-5eedcdd6e30c",
                                                "text": "„Odysseus 2 gelingt es, der Zauberin Kirke zu widerstehen, den Hades zu durchschreiten und sich von der verführerischen Kalypso zu lösen, bis er endlich bei der geglückten Ankunft in Ithaka seine überraschte Gattin Penelope wieder in die Arme schließen kann.“"
                                            },
                                            {
                                                "example_id": "3953b0d0-c9fd-4439-9fbf-f7e96839c5b2",
                                                "sense_id": "021e6cc1-4e21-32a8-9e41-5eedcdd6e30c",
                                                "text": "„In der antiken Mythologie war es nur Kirke, einer Zauberin und unwiderstehlichen Verführerin gegeben, Männer in Schweine, d.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
