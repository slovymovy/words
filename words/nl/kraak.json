{
    "word_family": [
        "kraken",
        "kraker",
        "kraakpand"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e97c22ba-3cbf-3ea8-9316-583da9d6cdcd",
                    "sense_definition": "Het kraken of bezetten van een leegstaand gebouw.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bezetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kraak</w> van het oude kantoorpand verliep zonder incidenten.",
                            "target_lang_translations": {
                                "en": "The <w>squatting</w> of the old office building went without incident."
                            }
                        },
                        {
                            "text": "Zij waren betrokken bij een illegale <w>kraak</w> in het centrum.",
                            "target_lang_translations": {
                                "en": "They were involved in an illegal <w>squat</w> in the center."
                            }
                        }
                    ],
                    "common_phrases": [
                        "illegale kraak"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of squatting or occupying an empty building."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squat",
                                "target_lang_sense_clarification": "the act of occupying an empty building"
                            },
                            {
                                "target_lang_word": "squatting",
                                "target_lang_sense_clarification": "the practice of occupying an empty building"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "853092b7-4411-31cd-aa51-a6caf77b8f7c",
                    "sense_definition": "Een inbraak of diefstal waarbij men zich met geweld toegang verschaft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misdaad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie onderzoekt een grote <w>kraak</w> bij de juwelier.",
                            "target_lang_translations": {
                                "en": "The police are investigating a major <w>heist</w> at the jeweler's."
                            }
                        },
                        {
                            "text": "Na de snelle <w>kraak</w> gingen de daders er vandoor met de buit.",
                            "target_lang_translations": {
                                "en": "After the quick <w>break-in</w>, the perpetrators made off with the loot."
                            }
                        }
                    ],
                    "synonyms": [
                        "inbraak"
                    ],
                    "common_phrases": [
                        "een snelle kraak"
                    ],
                    "target_lang_definitions": {
                        "en": "A burglary, robbery, or break-in, especially one involving force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heist",
                                "target_lang_sense_clarification": "a robbery or burglary"
                            },
                            {
                                "target_lang_word": "break-in",
                                "target_lang_sense_clarification": "illegal entry into a building"
                            },
                            {
                                "target_lang_word": "burglary",
                                "target_lang_sense_clarification": "illegal entry to commit theft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3bd96c1-3563-3026-9628-85ca59a3f46a",
                    "sense_definition": "Een kort, scherp geluid van iets dat breekt of buigt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde een luide <w>kraak</w> toen de tak afbrak.",
                            "target_lang_translations": {
                                "en": "I heard a loud <w>crack</w> when the branch broke off."
                            }
                        },
                        {
                            "text": "Met een doffe <w>kraak</w> gaf de houten vloer eindelijk mee.",
                            "target_lang_translations": {
                                "en": "With a dull <w>creak</w>, the wooden floor finally gave way."
                            }
                        }
                    ],
                    "synonyms": [
                        "gekraak"
                    ],
                    "common_phrases": [
                        "een luide kraak"
                    ],
                    "target_lang_definitions": {
                        "en": "A short, sharp sound of something breaking or bending."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "a sharp noise"
                            },
                            {
                                "target_lang_word": "creak",
                                "target_lang_sense_clarification": "a squeaking or grating sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef920671-9045-3f32-9b55-febe4103b278",
                    "sense_definition": "Een legendarisch, reusachtig zeemonster uit de Noordse folklore, vaak voorgesteld als een gigantische inktvis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zeelieden geloofden dat de <w>kraak</w> hele schepen kon verzwelgen.",
                            "target_lang_translations": {
                                "en": "The sailors believed that the <w>kraken</w> could swallow entire ships."
                            }
                        },
                        {
                            "text": "In oude verhalen wordt de <w>kraak</w> beschreven als een angstaanjagend zeemonster.",
                            "target_lang_translations": {
                                "en": "In old stories, the <w>kraken</w> is described as a terrifying sea monster."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeemonster",
                        "zeegedrocht"
                    ],
                    "target_lang_definitions": {
                        "en": "A legendary, giant sea monster from Norse folklore, often depicted as a giant squid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kraken",
                                "target_lang_sense_clarification": "mythological sea monster"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ac48661-7c15-310c-a3a4-79ebdc8e9402",
                    "sense_definition": "Een groot, historisch zeilschip uit de 15e tot 17e eeuw.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Spaanse <w>kraak</w> was geladen met goud en specerijen.",
                            "target_lang_translations": {
                                "en": "The Spanish <w>carrack</w> was laden with gold and spices."
                            }
                        },
                        {
                            "text": "Dit type <w>kraak</w> werd veel gebruikt voor verre ontdekkingsreizen.",
                            "target_lang_translations": {
                                "en": "This type of <w>carrack</w> was widely used for long voyages of discovery."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A large, historical sailing ship from the 15th to 17th century."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carrack",
                                "target_lang_sense_clarification": "historical sailing ship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42713d74-c847-3045-a3b9-89a323d63f3b",
                    "sense_definition": "Een galerij of verhoogde zolder in een kerk of schuur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het orgel was op de <w>kraak</w> van de kerk geplaatst.",
                            "target_lang_translations": {
                                "en": "The organ was placed on the <w>loft</w> of the church."
                            }
                        },
                        {
                            "text": "Vanaf de houten <w>kraak</w> had men een goed overzicht over de zaal.",
                            "target_lang_translations": {
                                "en": "From the wooden <w>gallery</w>, one had a good view of the hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "hangzolder"
                    ],
                    "target_lang_definitions": {
                        "en": "A gallery or elevated loft in a church or barn."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loft",
                                "target_lang_sense_clarification": "elevated gallery in a church or barn"
                            },
                            {
                                "target_lang_word": "gallery",
                                "target_lang_sense_clarification": "raised platform or balcony"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b96219ca-7450-399c-8b1a-771a00f5bdc3",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kraken</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kraak</w> de noten met een zware metalen tang.",
                            "target_lang_translations": {
                                "en": "I <w>crack</w> the nuts with heavy metal pliers."
                            }
                        },
                        {
                            "text": "Elke keer als ik opsta, <w>kraak</w> ik mijn gewrichten.",
                            "target_lang_translations": {
                                "en": "Every time I stand up, I <w>crack</w> my joints."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'kraken' (to crack, creak, or hack)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "first-person singular present of to crack"
                            },
                            {
                                "target_lang_word": "creak",
                                "target_lang_sense_clarification": "first-person singular present of to creak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b747d18-c738-380c-bbc5-591c418f16c4",
                    "sense_definition": "Gebiedende wijs van <w>kraken</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kraak</w> die code voordat de tijd om is!",
                            "target_lang_translations": {
                                "en": "<w>Crack</w> that code before time runs out!"
                            }
                        },
                        {
                            "text": "<w>Kraak</w> de noten voor het bakken van de taart.",
                            "target_lang_translations": {
                                "en": "<w>Crack</w> the nuts before baking the cake."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'kraken' (to crack, creak, or hack)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "imperative of to crack"
                            }
                        ]
                    }
                }
            ]
        }
    ]
