                        "examples": [
                            {
                                "example_id": "9071a6ad-2baf-4cab-85b2-cc9c21b43a99",
                                "sense_id": "5b174069-808d-355b-923b-9b28291debdf",
                                "text": "Vuistdik glas stalen pinnen in de portieren, een zuurstoftank in de kofferbak. Ajo Fliervoet uit Ammerzoden is eigenaar van de tank... euh, Cadillac van Freddy Heineken."
                            },
                            {
                                "example_id": "54649637-0c84-4e5b-8ed1-5bc730297280",
                                "sense_id": "5b174069-808d-355b-923b-9b28291debdf",
                                "text": "„Het bijzondere aan deze steenmeteoriet is dat hij uit lichte en donkere stukken bestaat”, zegt Langbroek. „Door een botsing zijn twee stukken samengevoegd. Ze hebben meer dan 20 miljoen jaar door de ruimte gezweefd. En dan slaat zo’n vuistdik brokstuk als een kleine tijdcapsule neer in het huis van de familie Wichmann.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "a7af8ba1-62ab-3f13-aca6-9b26a8314447",
                        "entry_id": "701d4c33-4d26-354d-b2af-21d56a918287",
                        "glosses": [
                            "heel erg omvangrijk"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "58205dcd-9901-4c98-9f3c-8dc0f8da27d1",
                                "sense_id": "a7af8ba1-62ab-3f13-aca6-9b26a8314447",
                                "text": "F. staat te boek als een veelpleger en zowel de reclassering als justitie heeft inmiddels een vuistdik dossier van de Oldenzaler. De straf valt voor hem zo hoog uit doordat hij nog een straf van vier en een maand open had staan. Die worden nu in navolging van de twee maanden die hem woensdag werden opgelegd, ook ten uitvoer gebracht."
                            }
                        ]
                    }
