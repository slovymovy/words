            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf8448ba-04e9-37b0-8099-e6b778345825",
                    "sense_definition": "Qui est typique ou caractéristique d'un ensemble, d'un groupe ou d'une époque.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tableau ancien est un exemple très <w>représentatif</w> de la peinture classique de cette époque."
                        },
                        {
                            "text": "Les opinions de cet auteur sont particulièrement <w>représentatives</w> des idées du dix-huitième siècle."
                        }
                    ],
                    "synonyms": [
                        "caractéristique",
                        "typique"
                    ],
                    "antonyms": [
                        "atypique"
                    ],
                    "common_phrases": [
                        "exemple représentatif",
                        "cas représentatif"
                    ]
                },
                {
                    "sense_id": "ea2828c6-8de9-30ed-830f-140bb8f7dc3d",
                    "sense_definition": "En statistique, qualifie un échantillon dont la composition reflète fidèlement la population étudiée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'institut de sondage a interrogé un échantillon <w>représentatif</w> de la population française."
                        },
                        {
                            "text": "Pour obtenir des résultats fiables, les chercheurs doivent constituer une sélection rigoureusement <w>représentative</w>."
                        }
                    ],
                    "common_phrases": [
                        "échantillon représentatif",
                        "panel représentatif"
                    ]
                },
                {
                    "sense_id": "571e3a0e-e079-3cfe-a687-8f3bb54c8f16",
                    "sense_definition": "En politique, qualifie un régime ou un gouvernement où les citoyens délèguent leur pouvoir à des élus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans une démocratie <w>représentative</w>, les citoyens expriment leur volonté en votant pour des députés."
                        },
                        {
                            "text": "Ce pays a mis en place un système <w>représentatif</w> après des années de transition politique."
                        }
                    ],
                    "common_phrases": [
                        "démocratie représentative",
                        "gouvernement représentatif",
                        "régime représentatif"
                    ]
                },
                {
                    "sense_id": "904ffdb7-8d6a-3c2a-9c77-2d24396c25e5",
                    "sense_definition": "Qui a pour fonction de représenter, d'évoquer ou de figurer une réalité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces symboles traditionnels avaient une valeur purement <w>représentative</w> au sein des cérémonies royales."
                        },
                        {
                            "text": "L'artiste refuse toute forme d'art <w>représentatif</w> et préfère explorer l'abstraction pure."
                        }
                    ],
                    "synonyms": [
                        "figuratif",
                        "symbolique"
                    ],
                    "common_phrases": [
