                        "source_sense_description": "проблесковый маячок",
                        "target_lang_word": "gyrophare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gyrophare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "759faeea-a4ce-389f-81ae-9dcd903630b3",
                                        "entry_id": "30fbee53-8770-3fb8-b9c7-f76aec313912",
                                        "glosses": [
                                            "Feu spécial d’avertissement émettant de la lumière tournant autour d’un axe vertical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb1cbd3-2989-4b15-a1d2-496dde6a4e53",
                                                "sense_id": "759faeea-a4ce-389f-81ae-9dcd903630b3",
                                                "text": "Si on a les yeux bleus, c’est à cause des gyrophares."
                                            },
                                            {
                                                "example_id": "83d38685-9f74-4fc8-b75f-96ad85b44d7e",
                                                "sense_id": "759faeea-a4ce-389f-81ae-9dcd903630b3",
                                                "text": "Dans mon champ de vision, par-dessus l’épaule de Mancini, le gyrophare tournoie sur le toit de la voiture de police."
                                            },
                                            {
                                                "example_id": "c89cc34a-e248-456a-81e0-79fc85a4be9b",
                                                "sense_id": "759faeea-a4ce-389f-81ae-9dcd903630b3",
                                                "text": "Selon la législation en vigueur, les gyrophares à deux tons sont réservés aux policiers en intervention. Ils ne doivent être utilisés que dans de situations dîtes d'urgence. Dans le cas contraire, les policiers sont tenus de respecter le Code de la route, comme les autres usagers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
