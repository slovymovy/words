                "senses": [
                    {
                        "sense_id": "afdc7e11-d078-34d7-ad55-51381f7fe8fb",
                        "entry_id": "b7382982-1e86-3360-9e2d-bf33e08b50a0",
                        "glosses": [
                            "Tochter des Firmeninhabers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7854fc7b-fbd0-4b87-9f4f-0b5d46e7fc2f",
                                "sense_id": "afdc7e11-d078-34d7-ad55-51381f7fe8fb",
                                "text": "Nachdem der Inhaber des Unternehmens schwer an Krebs erkrankte, musste die Juniorin die Firma übernommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77d98dfd-b097-351d-a530-e278e15e1d57",
                        "entry_id": "b7382982-1e86-3360-9e2d-bf33e08b50a0",
                        "glosses": [
                            "junge Sportlerin einer festgelegten Altersklasse, die je nach Sportart variiert"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "64c8e604-7139-457d-a527-1c04937c1e10",
                                "sense_id": "77d98dfd-b097-351d-a530-e278e15e1d57",
                                "text": "„Als Juniorin stand sie schon auf Platz 279 in der Damen-Weltrangliste.“"
                            },
                            {
                                "example_id": "3181aa85-f57b-43a8-be4d-a5fe0cd41da0",
                                "sense_id": "77d98dfd-b097-351d-a530-e278e15e1d57",
                                "text": "„Die Prüfung in Oxford und ihr erster Wettkampf als Juniorin über die olympische Distanz bei der Elite spukten im Kopf umher.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
