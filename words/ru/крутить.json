                            {
                                "target_lang_word": "spin",
                                "target_lang_sense_clarification": "rotate rapidly (e.g. a globe)"
                            },
                            {
                                "target_lang_word": "twirl",
                                "target_lang_sense_clarification": "rotate lightly or rapidly"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "girar",
                                "target_lang_sense_clarification": "hacer que algo rote sobre su eje"
                            },
                            {
                                "target_lang_word": "hacer girar",
                                "target_lang_sense_clarification": "poner algo en movimiento circular"
