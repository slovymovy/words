                        "cross_references": [
                            {
                                "target_word": "period",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd3480d4-cd93-3c84-9330-fa3db10d1832",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A length of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ed3aab-33a2-4375-b0e9-dc78e144635b",
                                                "sense_id": "dd3480d4-cd93-3c84-9330-fa3db10d1832",
                                                "text": "There was a period of confusion following the announcement."
                                            },
                                            {
                                                "example_id": "d1d23858-9e15-4742-9008-6559e0bab5cb",
                                                "sense_id": "dd3480d4-cd93-3c84-9330-fa3db10d1832",
                                                "text": "You'll be on probation for a six-month period."
                                            },
                                            {
                                                "example_id": "dbdb97e3-13b9-4102-bf61-820f060c80ca",
                                                "sense_id": "dd3480d4-cd93-3c84-9330-fa3db10d1832",
                                                "text": "Philip Miles, defending, said: \"This was a single instance, there was no allegation of continuing behaviour over a long period of time.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "087b538f-718b-3cf5-8c05-40161fbe0284",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A length of time in history seen as a single coherent entity; an epoch, era."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "602ea58b-071b-483a-a4a5-7241df2163b0",
                                                "sense_id": "087b538f-718b-3cf5-8c05-40161fbe0284",
                                                "text": "Food rationing continued in the post-war period."
                                            },
                                            {
                                                "example_id": "7513f33d-1f7a-4ef0-89f2-d6dc2c047e57",
                                                "sense_id": "087b538f-718b-3cf5-8c05-40161fbe0284",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "725f5341-bb15-4067-b85b-cc80620cd630",
                                                "sense_id": "087b538f-718b-3cf5-8c05-40161fbe0284",
                                                "text": "Sung Yung-hsi of Ch’u-hsiung was a government student during the Chia-ch’ing period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ed35ae-fe0e-325b-91d6-4e186a4dadc9",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "The punctuation mark “.” (indicating the ending of a sentence or marking an abbreviation)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff54232-efc5-43d2-9477-6f4b8a4541a3",
                                                "sense_id": "d6ed35ae-fe0e-325b-91d6-4e186a4dadc9",
                                                "text": "‘You know, a period? The black spot at the end of a sentence — what do you call them over there?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a785557-2d56-398b-a282-b27fd48d9b9a",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A decisive end to something; a stop."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1a73d2-1eab-4f74-8cdc-830f6f507cec",
                                                "sense_id": "4a785557-2d56-398b-a282-b27fd48d9b9a",
                                                "text": "My sufferings, physical and mental, are more than I can bear, and when such small arrangements as I have to make for your future well-being are completed it is my intention to put a period to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c1d7f9-fca5-381d-a604-167138df71a9",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "The length of time during which the same characteristics of a periodic phenomenon recur, such as the repetition of a wave or the rotation of a planet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3b38119-cd59-3af9-8963-20bd416d5ba2",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "Female menstruation; an episode of this."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3afe6177-b232-4018-a994-91ed5069b5b6",
                                                "sense_id": "e3b38119-cd59-3af9-8963-20bd416d5ba2",
                                                "text": "When she is on her period, she prefers not to go swimming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43f92c3-b94d-35a1-ae50-a4f59aca92f7",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "Female menstruation; an episode of this.",
                                            "The set of symptoms associated with menstruation, even if not accompanied by menstruation; an episode of these symptoms."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2137186-1f15-3fb0-8eba-f47448fa88f0",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A section of an artist's, writer's (etc.) career distinguished by a given quality, preoccupation etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e16c533a-01af-4326-8627-8072a9cea7b6",
                                                "sense_id": "e2137186-1f15-3fb0-8eba-f47448fa88f0",
                                                "text": "This is one of the last paintings Picasso created during his Blue Period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3d6f112-806e-3631-bf4c-7af323f95eac",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "Each of the divisions into which a school day is split, allocated to a given subject or activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9254cd09-2a49-4bab-87a8-0cd4a5b51005",
                                                "sense_id": "b3d6f112-806e-3631-bf4c-7af323f95eac",
                                                "text": "I have math class in second period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6563a448-32f6-304b-9d9c-a59777361536",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "Each of the intervals, typically three, of which a game is divided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "395ac5ae-74b8-4cd6-95f0-ed59942c13c9",
                                                "sense_id": "6563a448-32f6-304b-9d9c-a59777361536",
                                                "text": "Gretzky scored in the last minute of the second period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a570f9-ad4c-3dbe-816c-4fdd229a4812",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "One or more additional intervals to decide a tied game, an overtime period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddad9f06-63f4-4c7e-a393-7d3a58b7e1ac",
                                                "sense_id": "85a570f9-ad4c-3dbe-816c-4fdd229a4812",
                                                "text": "They won in the first overtime period."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f239d8a6-14d6-3834-869e-d46249870efb",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "The length of time for a disease to run its course."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "An end or conclusion; the final point of a process, a state, an event, etc."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b892eed-b5e4-4453-b19e-a7782d832ea7",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "As thus all gazed on hir, so she glaunced hir lookes on all, surueying them as curiously, as they noted hir exactly, but at last she set downe her period on the face of Alexis […]"
                                            },
                                            {
                                                "example_id": "cd7dc16f-4982-4bd3-9e01-de0658e2a1ce",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "And if my death might make this island happy,\nAnd prove the period of their tyranny,\nI would expend it with all willingness:"
                                            },
                                            {
                                                "example_id": "c6040b7b-ea2d-44f6-89bd-4e1ea5aaaa4f",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "Why now let me die, for I haue liu'd long enough : This is the period of my ambition : O this bleſſed houre."
                                            },
                                            {
                                                "example_id": "a4c23940-078d-4519-a8a2-00940105cc5a",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "All comes to one period, whether man make an end of himſelfe, or whether he endure-it[…]."
                                            },
                                            {
                                                "example_id": "36bd28cb-1680-44ad-9b4f-7ec2bd61781c",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "When Loue thus in his Center ends,\nDesire and Hope, his inward friends\nAre shaken off: while Doubt and Griefe,\nThe weakest giuers of reliefe,\nStand in his councell as the chiefe:\nAnd now he to his period brought,\nFrom Loue becomes some other thought."
                                            },
                                            {
                                                "example_id": "3524460f-3e64-459e-a286-675947415c08",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "Set up an hour-glasse; hee’l go on untill\nThe last sand make his Period."
                                            },
                                            {
                                                "example_id": "296c1999-bd93-4947-b070-6df9d08a886b",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "[…]and yet this is but the ἀρχή ὠδίνων, the Beginning of those evils which shall never End till eternity hath a period[…]"
                                            },
                                            {
                                                "example_id": "e218d716-a8ff-4f95-9184-57386239cd23",
                                                "sense_id": "b765f820-2e24-3423-a90d-2578e9ca9d09",
                                                "text": "So ſpake th’ Archangel Michael, then paus’d, / As at the Worlds great period ; and our Sire / Replete with joy and wonder thus repli’d."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "559996a3-d989-3131-970c-e5a2b2ed1350",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A complete sentence, especially one expressing a single thought or making a balanced, rhythmic whole."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8db684-c821-435d-9703-ca41e9ca5ed1",
                                                "sense_id": "559996a3-d989-3131-970c-e5a2b2ed1350",
                                                "text": "Periods are beautiful when they are not too long."
                                            },
                                            {
                                                "example_id": "66166c0b-bbeb-4dfa-8490-dbb5c858662b",
                                                "sense_id": "559996a3-d989-3131-970c-e5a2b2ed1350",
                                                "text": "that such iron moulds as these shall have autority to knaw out the choicest periods of exquisitest books, and to commit such a treacherous fraud against the orphan remainders of worthiest men after death, the more sorrow will belong to that haples race of men, whose misfortune it is to have understanding."
                                            },
                                            {
                                                "example_id": "31c86b66-0a70-4084-b1ad-4cf761d369eb",
                                                "sense_id": "559996a3-d989-3131-970c-e5a2b2ed1350",
                                                "text": "In declamatory periods Dr Fordyce spins out Rousseau's eloquence […]"
                                            },
                                            {
                                                "example_id": "b843ed5e-8386-4d68-9b03-4ee3b147c92b",
                                                "sense_id": "559996a3-d989-3131-970c-e5a2b2ed1350",
                                                "text": "A very superior gentleman, Mr. Kenge. Truly eloquent indeed. Some of his periods quite majestic!"
                                            },
                                            {
                                                "example_id": "96058efc-8bb3-4e86-941e-75d565587da8",
                                                "sense_id": "559996a3-d989-3131-970c-e5a2b2ed1350",
                                                "text": "He writhed for twenty minutes under the flowery and eulogistic periods of the president, and rose himself in the state of confused indignation which the Briton feels when he is publicly approved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599b2d9f-840d-35fa-bb71-d123a9f51b1e",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A specific moment during a given process; a point, a stage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fca7a1e1-411d-421b-8c29-3f9dacc5d3e2",
                                                "sense_id": "599b2d9f-840d-35fa-bb71-d123a9f51b1e",
                                                "text": "The Death of Patroclus was the most eminent Period; and consequently the most proper Time for such Games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c01636-be99-3c50-b599-e4010c692cb8",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A row in the periodic table of the elements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b528073-b3f5-3c27-8050-9fb833815dd0",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A geochronologic unit of millions to tens of millions of years; a subdivision of an era, and subdivided into epochs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e84ea8e4-a759-4c50-b84d-9987f95f3a91",
                                                "sense_id": "7b528073-b3f5-3c27-8050-9fb833815dd0",
                                                "text": "These fossils are from the Jurassic period."
                                            },
                                            {
                                                "example_id": "71a07de7-6919-48af-ac17-20490e97362f",
                                                "sense_id": "7b528073-b3f5-3c27-8050-9fb833815dd0",
                                                "text": "Fossils are particularly well described from the Carboniferous, Triassic, Jurassic and Cretaceous periods and have been found in the USA, England, Russia, Lebanon and Germany. Sites such as Lyme Regis in Dorset have particularly yielded number of Jurassic “squid” ink sacs and nodules (Doguzhaeva et al. 2004)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51d7d915-6c92-3eb0-9d3e-cfa9c44d78ed",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "A Drosophila gene, the gene product of which is involved in regulation of the circadian rhythm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72733775-b16c-4a8b-b20f-baaa0987d020",
                                                "sense_id": "51d7d915-6c92-3eb0-9d3e-cfa9c44d78ed",
                                                "text": "Polyclonal antibodies were prepared against the period gene product, which influences biological rhythms in D. melanogaster, by using small synthetic peptides from the per sequence as immunogens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82987239-3df2-31b4-92ff-108d2c0015c3",
                                        "entry_id": "9af114e8-7e3c-34c0-afe7-872e6f3d61bf",
                                        "glosses": [
                                            "Two phrases (an antecedent and a consequent phrase)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
