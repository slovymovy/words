                "forms": [
                    {
                        "form_id": "f8a2c9d9-bcaf-4cd1-866d-919f50f333d9",
                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
                        "tags": [
                            "plural"
                        ],
                        "form": "kartuizers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fc0cb5e-5f67-3a46-a923-d95e63c06bee",
                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
                        "glosses": [
                            "kloosterling van de strenge contemplatieve orde van Sint-Bruno"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0e9423-5dd3-4b92-ae11-3612468932ba",
                                "sense_id": "4fc0cb5e-5f67-3a46-a923-d95e63c06bee",
                                "text": "Eenzaamheid en rust tekenen de kloosterorde van de kartuizers."
                            },
                            {
                                "example_id": "7b6ec5e5-ccf4-4112-8022-3d8e3741f2b2",
                                "sense_id": "4fc0cb5e-5f67-3a46-a923-d95e63c06bee",
                                "text": "Het resultaat is een documentaire die volgens de publiciteitscampagne „een meditatie over het leven” is. We hoeven niet te weten wie kartuizers zijn. We moeten ons gedurende die drie uur zelf een beetje kartuizer gaan voelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "feb9e223-5d28-363e-b13c-2d572c5b1edf",
                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
                        "glosses": [
                            "ras van mollige huiskatten met een kortharige, blauwgrijze vacht, felle, oranjegele ogen en een vrij grote ronde kop met kleine oren\\nKartuizers zijn goede muizenvangers en prettige gezelschapsdieren."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d288778c-068c-4b65-888b-8662b7000c84",
                                "sense_id": "feb9e223-5d28-363e-b13c-2d572c5b1edf",
                                "text": "Snel wijdde hij enkele rituele lofzangen aan haar, passend bij de karakteristieke gratie en deugden van een kat van het ras der kartuizers, klein en volmaakt. “Mijn beertje met dikke wangetjes... Fijn-fijn-fijn poesje... Mijn blauw duifje... Parelkleurig duiveltje.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "654640a9-3b2f-39be-b62d-c171bf15d7ba",
                        "entry_id": "67f2c2eb-1182-3425-8354-c2e0fcf5f3da",
