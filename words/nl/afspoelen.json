{
    "word_family": [
        "spoelen",
        "spoeling",
        "afspoeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3065b1ea-749b-309b-8409-75178a4c3802",
                    "sense_definition": "Iets oppervlakkig reinigen door het onder stromend water te houden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reinigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb de vuile borden even <w>afgespoeld</w> voordat ik ze in de vaatwasser zette.",
                            "target_lang_translations": {
                                "fr": "J'ai <w>rincé</w> rapidement les assiettes sales avant de les mettre dans le lave-vaisselle."
                            }
                        },
                        {
                            "text": "Vergeet niet om de groenten goed <w>af</w> te <w>spoelen</w> onder de kraan.",
                            "target_lang_translations": {
                                "fr": "N'oubliez pas de bien <w>rincer</w> les légumes sous le robinet."
                            }
                        }
                    ],
                    "synonyms": [
                        "wassen",
                        "schoonspoelen"
                    ],
                    "common_phrases": [
                        "even afspoelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Nettoyer superficiellement quelque chose en le passant sous l'eau courante."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rincer",
                                "target_lang_sense_clarification": "Nettoyer rapidement à l'eau."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbf5a8ba-1cc7-3fdf-871e-f92badefeef4",
                    "sense_definition": "Door stromend water van zijn plek gehaald worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de hevige regenval is veel zand van de oprit <w>afgespoeld</w>.",
                            "target_lang_translations": {
                                "fr": "À cause des fortes pluies, beaucoup de sable a été <w>emporté</w> de l'allée."
                            }
                        },
                        {
                            "text": "Het speelgoed lag buiten en is door de storm in de sloot <w>afgespoeld</w>.",
                            "target_lang_translations": {
                                "fr": "Le jouet était dehors et a été <w>emporté</w> dans le fossé par la tempête."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegspoelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Être déplacé ou emporté par l'action de l'eau courante."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "être emporté",
                                "target_lang_sense_clarification": "Déplacé par un courant d'eau."
                            },
                            {
                                "target_lang_word": "être lessivé",
                                "target_lang_sense_clarification": "Enlevé par le ruissellement de l'eau."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7caa8e3-ac9a-3076-9b02-d2b0f7ebd0c5",
                    "sense_definition": "Een opgewonden draad of band van een klos afwentelen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "afwikkelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb het hele garen <w>afgespoeld</w> en opnieuw opgewonden.",
                            "target_lang_translations": {
                                "fr": "J'ai <w>déroulé</w> tout le fil et je l'ai réenroulé."
                            }
                        },
                        {
                            "text": "De naaister moest de oude draad eerst <w>afspoelen</w> van de klos.",
                            "target_lang_translations": {
                                "fr": "La couturière a dû d'abord <w>dévider</w> le vieux fil de la bobine."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwikkelen"
                    ],
                    "antonyms": [
                        "opspoelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Wordt in deze betekenis zelden meer gebruikt; afwikkelen is gebruikelijker."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Dérouler un fil ou une bande d'une bobine."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dérouler",
                                "target_lang_sense_clarification": "Action de défaire un fil d'une bobine."
                            },
                            {
                                "target_lang_word": "dévider",
                                "target_lang_sense_clarification": "Action de vider une bobine de son fil."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}