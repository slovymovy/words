                            },
                            {
                                "target_lang_word": "adamak",
                                "target_lang_sense_clarification": "zamanını veya emeğini vermek"
                            },
                            {
                                "target_lang_word": "saygı sunmak",
                                "target_lang_sense_clarification": "hürmet göstermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "致敬",
                                "target_lang_sense_clarification": "表达敬意"
                            },
                            {
                                "target_lang_word": "奉献",
                                "target_lang_sense_clarification": "献出时间或精力"
                            }
                        ]
                    }
                }
