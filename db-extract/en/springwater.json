                    {
                        "translation_id": "ee9df2a3-4e7e-4f45-b4eb-bf3786be588d",
                        "source_entry_id": "52f1fe07-e52c-35a1-9042-7557b278daed",
                        "source_sense_description": "water originating from a spring",
                        "target_lang_word": "eau de source",
