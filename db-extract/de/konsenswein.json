                "senses": [
                    {
                        "sense_id": "00401ed1-a665-35c1-8634-105ff11d5651",
                        "entry_id": "4b9327a7-7f09-3188-87ad-e251adae3e15",
                        "glosses": [
                            "Wein, der von der Mehrzahl der Leute akzeptiert und getrunken werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79910e85-8d78-4061-a14a-8032085fd9d3",
                                "sense_id": "00401ed1-a665-35c1-8634-105ff11d5651",
                                "text": "„Mit ein wenig Mut im Gepäck muss es nicht immer der glattgebügelte, allzu nett grinsende Konsenswein sein, sondern man sollte getrost einmal einen herben Tropfen genießen.“"
                            },
                            {
                                "example_id": "786988e7-e60a-48e7-82d0-b7d34ee87ee4",
                                "sense_id": "00401ed1-a665-35c1-8634-105ff11d5651",
                                "text": "„Grauburgunder gilt als der Konsenswein für jede Gelegenheit.“"
                            },
                            {
                                "example_id": "08ddbaa6-8275-41f1-b2b3-6365836b16d7",
                                "sense_id": "00401ed1-a665-35c1-8634-105ff11d5651",
                                "text": "„Der Merlot der zweitgrößten Winery Israels war ein Konsenswein. Allgemein gefälliges Urteil, aber kein Spitzenplatz und kaum Ablehnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
