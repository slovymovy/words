                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb736c3-98da-42a1-975a-bf65bcc4bb73",
                                "sense_id": "bc27ab2d-3452-3658-b3e4-9b310d54d3c2",
                                "text": "A couple of somewhat wheezy Highland \"River\" class 4-6-0s have succeeded in hauling 450-ton stock trains between Stranraer and Ayr."
                            }
                        ]
                    }
                ],
                "translations": [
