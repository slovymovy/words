                                    {
                                        "sense_id": "9bc6a560-f08c-33da-b495-14a5e8b948d0",
                                        "entry_id": "c00b98a9-931b-3340-9ffb-f61455fefd3e",
                                        "glosses": [
                                            "Degraded from one's social class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aafe71a0-742c-4b76-91bc-20cd25e244b3",
                                                "sense_id": "9bc6a560-f08c-33da-b495-14a5e8b948d0",
                                                "text": "Having married a plebian and so become déclassée, the daughter of a patrician was barred by the patrician matrons from sacrifices at the shrine of Patrician Chastity ‘in the cattle market by the round temple of Hercules’."
                                            }
