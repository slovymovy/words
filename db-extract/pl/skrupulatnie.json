                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cb1f966-96af-4001-87ba-abdabd94b74c",
                        "source_entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                        "source_sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                        "target_lang_word": "meticulously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meticulously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92061a75-0202-3c92-9f43-c6e01331f9be",
                                        "entry_id": "37b3d378-ac3c-333c-bac6-c2278238178c",
                                        "glosses": [
                                            "In a meticulous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66af1d3b-3698-48e2-8ec6-f1da176d0165",
                                                "sense_id": "92061a75-0202-3c92-9f43-c6e01331f9be",
                                                "text": "Near-synonyms: carefully, methodically, precisely, rigorously, scrupulously, thoroughly"
                                            },
                                            {
                                                "example_id": "9db544c8-4e24-4cdf-abba-13b4783e4d68",
                                                "sense_id": "92061a75-0202-3c92-9f43-c6e01331f9be",
                                                "text": "In fact, they ran that forty-three minutes’ meeting so meticulously, they even took input from the public with predictable results."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a100ff4-3f28-4bb1-b9da-7b0cba7eed9b",
                        "source_entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                        "source_sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                        "target_lang_word": "painstakingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "painstakingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe080873-6971-3e7f-aa70-e0992a97cfde",
                                        "entry_id": "9e093b7b-4d03-3fd0-b6e3-31250b7d52d4",
                                        "glosses": [
                                            "In a painstaking manner; very slowly and carefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "315df810-afc1-4547-a1fe-14fe79c99c2e",
                                                "sense_id": "fe080873-6971-3e7f-aa70-e0992a97cfde",
                                                "text": "I wish he had had a dog, just so we could see how painstakingly he would have divided that dog among the family, in his careful business way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34f94fca-4442-4739-ab5b-0487cd798dc3",
                        "source_entry_id": "6d1c04b8-4723-31a4-81f1-817a23bea5d0",
                        "source_sense_id": "27182d07-e9b8-31ab-93b3-867a06bb45bd",
                        "target_lang_word": "punctiliously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punctiliously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c11ec9dc-d1fe-394f-9daf-c7755c2ddfa3",
                                        "entry_id": "bd714bcc-42f9-3f7b-b535-c2e7ec1f1c0e",
                                        "glosses": [
                                            "In a punctilious manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac26dae5-6d78-4001-a49b-65c055d22880",
                                                "sense_id": "c11ec9dc-d1fe-394f-9daf-c7755c2ddfa3",
                                                "text": "Monsieur Thuran became a frequent visitor at the home of Hazel Strong’s uncle in Cape Town. His attentions were very marked, but they were so punctiliously arranged to meet the girl’s every wish that she came to depend upon him more and more. Did she or her mother or a cousin require an escort—was there a little friendly service to be rendered, the genial and ubiquitous Monsieur Thuran was always available."
                                            },
                                            {
                                                "example_id": "d18341f4-7763-46f4-984a-629a168b1478",
                                                "sense_id": "c11ec9dc-d1fe-394f-9daf-c7755c2ddfa3",
                                                "text": "Confused for the moment by Podson's impersonation of a genteel stranger making an afternoon call, she now recognized his gentle fluff of whiskers, and dived at Jasper to cover her embarrassment. With Jasper out of action, Podson was able to raise his hat punctiliously and say, \"Good afternoon.\""
                                            },
                                            {
                                                "example_id": "f22be234-c824-4a95-9c57-f0432ae17755",
                                                "sense_id": "c11ec9dc-d1fe-394f-9daf-c7755c2ddfa3",
                                                "text": "I imagine the Dreamward’s food being even more varied and punctiliously prepared, the ship’s Gift Shop less expensive and its casino less depressing and its stage entertainment less cheesy and its pillow mints bigger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
