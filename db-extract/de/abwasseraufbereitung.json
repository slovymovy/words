                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b178f04-d8f1-4c52-a5fe-6af61661fbdf",
                                "sense_id": "7ed767ef-4083-3e3b-b182-1f97bb974992",
                                "text": "Die Abwasseraufbereitung ist notwendig, damit die Fließgewässer nicht übermäßig verschmutzt werden."
                            },
                            {
                                "example_id": "36c0a8fd-b013-4ab7-b79d-7efbaa63dabe",
                                "sense_id": "7ed767ef-4083-3e3b-b182-1f97bb974992",
                                "text": "„Durch die platzsparende Anlagentechnik und einfachere Abwasseraufbereitung sind die Betriebskosten im Vergleich zum getrennten Verfahren erheblich geringer.“"
                            },
                            {
                                "example_id": "81fdb245-262f-4306-9e50-5ce12027e82a",
                                "sense_id": "7ed767ef-4083-3e3b-b182-1f97bb974992",
                                "text": "„Bei der biologischen Abwasseraufbereitung werden organische und anorganische Wasserinhaltsstoffe mikrobiell abgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
