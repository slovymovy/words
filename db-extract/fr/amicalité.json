                        "glosses": [
                            "Fait de se montrer amical ; caractère de ce qui est amical."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b290399b-8411-47a7-9357-3b831c529163",
                                "sense_id": "dc7856f2-26d9-3b20-ac6d-6631706f61e9",
                                "text": "La jeune femme n’ignorait rien de l’amicalité qui liait son Levantin au gardien du port, mais, curieusement, alors même qu’elle se mêlait de contrôler tous les faits et gestes de son homme, elle ne pipait mot."
                            }
                        ]
                    },
