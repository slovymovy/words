                "senses": [
                    {
                        "sense_id": "7e29ce2b-1d96-3d3a-a53c-c0bbe48822b1",
                        "entry_id": "0a24d00d-011e-393f-b05c-50fcc25e3c6a",
                        "glosses": [
                            "Annuler une amputation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eba7cae-497c-4b20-b1d1-60874d886065",
                                "sense_id": "7e29ce2b-1d96-3d3a-a53c-c0bbe48822b1",
                                "text": "Les maintenant sont “désamputés” de ces rapports, et ainsi “démutilés”, ils ne se font plus simplement suite (constituant un l’un après l’autre), mais se comprennent comme chacun possédant dans sa suite part des précédents et des suivants."
                            },
                            {
                                "example_id": "3a056a04-4d47-4ebd-8644-144cafb1cf5e",
                                "sense_id": "7e29ce2b-1d96-3d3a-a53c-c0bbe48822b1",
                                "text": "Je vous désampute bien volontiers de votre pseudo et, concernant le mien, vous décerne un Herlock Sholmès d'argent."
                            },
                            {
                                "example_id": "1d81c793-26c6-4381-99a1-3bac69bd50aa",
                                "sense_id": "7e29ce2b-1d96-3d3a-a53c-c0bbe48822b1",
                                "text": "La ception nous désampute."
                            }
                        ]
                    }
