{
    "word_family": [
        "thirsty",
        "thirstiness",
        "bloodthirsty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e52b2e8-5bc1-3b59-8fb0-a6a541e114cb",
                    "sense_definition": "A physical sensation of dryness in the mouth and throat caused by a need for liquid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_need",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After running for five miles in the sun, I had a terrible <w>thirst</w>.",
                            "target_lang_translations": {
                                "ru": "После пятимильного бега на солнце меня мучила ужасная <w>жажда</w>."
                            }
                        },
                        {
                            "text": "The long hike in the mountains helped us develop a great <w>thirst</w> for cold water.",
                            "target_lang_translations": {
                                "ru": "Долгий поход в горах вызвал у нас сильную <w>жажду</w>, и нам очень хотелось холодной воды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quench one's thirst",
                        "great thirst",
                        "die of thirst"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое ощущение сухости во рту и горле, вызванное потребностью в жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жажда",
                                "target_lang_sense_clarification": "физиологическая потребность пить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "831d4e75-7f69-3876-8552-7b2e770fa2cb",
                    "sense_definition": "A strong and eager desire or craving for something non-physical.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young student showed an incredible <w>thirst</w> for knowledge during the science fair.",
                            "target_lang_translations": {
                                "ru": "Молодой студент проявил невероятную <w>жажду</w> знаний во время научной ярмарки."
                            }
                        },
                        {
                            "text": "Her constant <w>thirst</w> for adventure led her to travel across the entire continent alone.",
                            "target_lang_translations": {
                                "ru": "Ее постоянная <w>жажда</w> приключений заставила ее в одиночку пересечь весь континент."
                            }
                        }
                    ],
                    "synonyms": [
                        "craving",
                        "longing",
                        "hunger",
                        "appetite"
                    ],
                    "common_phrases": [
                        "thirst for knowledge",
                        "thirst for adventure",
                        "thirst for power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное и нетерпеливое желание или тяга к чему-либо нематериальному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жажда",
                                "target_lang_sense_clarification": "сильное стремление к чему-либо"
                            },
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "сильное влечение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66630ca5-4e84-3800-b3af-2e55a8cf82d1",
                    "sense_definition": "A strong sexual desire or lust for someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was clear to everyone in the room that he had a <w>thirst</w> for her.",
                            "target_lang_translations": {
                                "ru": "Всем в комнате было ясно, что он испытывает к ней <w>вожделение</w>."
                            }
                        },
                        {
                            "text": "The novel describes a deep <w>thirst</w> that the two characters felt for one another.",
                            "target_lang_translations": {
                                "ru": "В романе описывается глубокая <w>страсть</w>, которую герои испытывали друг к другу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in modern slang contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное сексуальное желание или вожделение к кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вожделение",
                                "target_lang_sense_clarification": "сильное чувственное влечение"
                            },
                            {
                                "target_lang_word": "страсть",
                                "target_lang_sense_clarification": "сильное чувство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45af6cbb-5d19-3f7f-9628-5e5c563cdb7d",
                    "sense_definition": "To feel a need to drink or to experience the sensation of being thirsty.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_need",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers <w>thirsted</w> for water after their supplies ran out in the desert.",
                            "target_lang_translations": {
                                "ru": "Путешественники <w>испытывали жажду</w> после того, как в пустыне закончились запасы воды."
                            }
                        },
                        {
                            "text": "Even though they were near the river, the cattle <w>thirsted</w> because the water was too muddy.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то, что скот был у реки, животные <w>хотели пить</w>, потому что вода была слишком мутной."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать потребность выпить или испытывать ощущение жажды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хотеть пить",
                                "target_lang_sense_clarification": "испытывать потребность в воде"
                            },
                            {
                                "target_lang_word": "испытывать жажду",
                                "target_lang_sense_clarification": "ощущать сухость во рту"
                            },
                            {
                                "target_lang_word": "жаждать",
                                "target_lang_sense_clarification": "книжный вариант потребности в воде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57597f12-5477-308d-8278-814588b4cc68",
                    "sense_definition": "To have a very strong or vehement desire for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ambitious politicians <w>thirst</w> for power and influence over the masses.",
                            "target_lang_translations": {
                                "ru": "Многие амбициозные политики <w>жаждут</w> власти и влияния на массы."
                            }
                        },
                        {
                            "text": "The artist <w>thirsted</w> for recognition after years of working in complete obscurity.",
                            "target_lang_translations": {
                                "ru": "Художник <w>жаждал</w> признания после многих лет работы в полной безвестности."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "thirst for revenge",
                        "thirst for recognition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь очень сильное или страстное желание чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаждать",
                                "target_lang_sense_clarification": "страстно желать чего-либо"
                            },
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "сильно хотеть достичь чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}