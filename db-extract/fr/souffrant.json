                    {
                        "sense_id": "ade8b3c8-05c4-3e19-969d-8b7bd11f3b9d",
                        "entry_id": "e6170479-b9cd-37cb-b27e-9059a94d0852",
                        "glosses": [
                            "Personne qui souffre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502c69c7-b094-47ad-8011-c7142404fe26",
                                "sense_id": "ade8b3c8-05c4-3e19-969d-8b7bd11f3b9d",
                                "text": "J’ai secouru les opprimés, j’ai soulagé les souffrants."
                            },
                            {
                                "example_id": "b3010142-ac7b-4728-a731-070c3667251d",
                                "sense_id": "ade8b3c8-05c4-3e19-969d-8b7bd11f3b9d",
                                "text": "Le mieux était de contrefaire le souffrant, moi qui n’avais jamais manqué un cours."
                            },
                            {
                                "example_id": "dc16d1a7-0ba6-41e9-b958-13f7a8c179a9",
                                "sense_id": "ade8b3c8-05c4-3e19-969d-8b7bd11f3b9d",
                                "text": "… sa saturation iconographique de crucifixions, présentées par ordre, est systématiquement entourée de récits, puis allégorisée dans le but de consoler les souffrants de toutes les croix (physiques, passionnelles, sociales)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a262079-fc3c-434e-9bc3-86a417f259cc",
                        "source_entry_id": "e6170479-b9cd-37cb-b27e-9059a94d0852",
                        "source_sense_id": "ade8b3c8-05c4-3e19-969d-8b7bd11f3b9d",
                        "target_lang_word": "sufferer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sufferer",
