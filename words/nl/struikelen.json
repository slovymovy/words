{
    "word_family": [
        "struikelblok",
        "struikeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2951e70-9603-33f3-a331-df9a79a411d2",
                    "sense_definition": "het evenwicht verliezen doordat de voet ergens tegenaan stoot of achter blijft haken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op dat je niet zult <w>struikelen</w> over die losse stoeptegel.",
                            "target_lang_translations": {
                                "en": "Be careful not to <w>trip</w> over that loose paving stone."
                            }
                        },
                        {
                            "text": "Hij <w>struikelde</w> over een boomwortel en viel languit op het pad.",
                            "target_lang_translations": {
                                "en": "He <w>stumbled</w> over a tree root and fell flat on the path."
                            }
                        }
                    ],
                    "synonyms": [
                        "strompelen",
                        "tuimelen"
                    ],
                    "common_phrases": [
                        "over een drempel struikelen",
                        "bijna struikelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to lose one's balance because the foot hits something or gets caught"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trip",
                                "target_lang_sense_clarification": "to catch one's foot on something and lose balance"
                            },
                            {
                                "target_lang_word": "stumble",
                                "target_lang_sense_clarification": "to trip or momentarily lose balance while walking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25397662-2e03-3291-ace9-a18c0bffb984",
                    "sense_definition": "figuurlijk een fout maken of vastlopen bij een moeilijke taak of passage",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fouten maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De student bleef <w>struikelen</w> over de uitspraak van die moeilijke woorden.",
                            "target_lang_translations": {
                                "en": "The student kept <w>stumbling</w> over the pronunciation of those difficult words."
                            }
                        },
                        {
                            "text": "Veel kandidaten <w>struikelen</w> over de laatste vraag van het examen.",
                            "target_lang_translations": {
                                "en": "Many candidates <w>trip up</w> on the last question of the exam."
                            }
                        }
                    ],
                    "synonyms": [
                        "haperen",
                        "vastlopen"
                    ],
                    "common_phrases": [
                        "over woorden struikelen",
                        "over een vraag struikelen"
                    ],
                    "target_lang_definitions": {
                        "en": "figuratively to make a mistake or get stuck during a difficult task or passage"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stumble",
                                "target_lang_sense_clarification": "to make a mistake or hesitate, especially in speech or a task"
                            },
                            {
                                "target_lang_word": "trip up",
                                "target_lang_sense_clarification": "to make a mistake or cause someone to make a mistake"
                            },
                            {
                                "target_lang_word": "falter",
                                "target_lang_sense_clarification": "to lose momentum or hesitate"
                            }
                        ]
                    }
                }
            ]
        }
    ]
