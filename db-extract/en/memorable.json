                        "entry_id": "462f375a-88d3-30db-803d-0175a6f22bdd",
                        "glosses": [
                            "Worthy to be remembered; very important or remarkable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40cba3d3-b495-43b6-b1fe-d97d928cc30a",
                                "sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                                "text": "a memorable holiday"
                            },
                            {
                                "example_id": "870d81a6-a7b1-4758-b239-0671fa4dd8ad",
                                "sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                                "text": "Men have surviving Fame to gain,\nBy Tombs, by Books, by memorable Deeds"
                            },
                            {
                                "example_id": "7ffc9542-54f0-45fa-958f-3dfdd4c83cfb",
                                "sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                                "text": "But Mr. Hunt hated the character immediately -- Elmo wasn't edgy enough -- and, on one memorable morning, brought him into the Muppeteers' lounge \"hanging by the rods,\" the chopsticklike bars that control his paws."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "124cbba5-4452-483f-a463-d428842762b1",
                        "source_entry_id": "462f375a-88d3-30db-803d-0175a6f22bdd",
                        "source_sense_id": "85d70cb6-c41b-3e8b-8ac4-c12fb8d1fb85",
                        "source_sense_description": "worthy of being remembered",
                        "target_lang_word": "memorabel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "memorabel",
