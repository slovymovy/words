            {
                "entry_id": "1fcb078c-b0d9-3079-809b-abc1cf450c9b",
                "word": "protohistoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ada871fb-b80e-3f18-8a83-e758e8d6fbbc",
                        "entry_id": "1fcb078c-b0d9-3079-809b-abc1cf450c9b",
                        "glosses": [
                            "Période d’une région du monde où l’écriture était encore inconnue mais sur laquelle on a tout de même des traces écrites provenant d’autres régions du monde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c2a9fc-3018-4975-b36c-50251f3958aa",
                                "sense_id": "ada871fb-b80e-3f18-8a83-e758e8d6fbbc",
                                "text": "La protohistoire est l’étape au cours de laquelle des populations ne possédant pas elles-mêmes l’écriture sont mentionnées par des textes émanant d’autres peuples contemporains : c’est le cas par exemple des Gaulois d’avant la conquête romaine, décrits par des auteurs grecs et latins."
                            }
                        ]
                    },
                    {
                        "sense_id": "893f20c4-21e3-33a7-857e-fe26770f2dac",
                        "entry_id": "1fcb078c-b0d9-3079-809b-abc1cf450c9b",
                        "glosses": [
                            "Tout débuts, prolégomènes d'un phénomène historique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9009532-dead-4f3d-8957-f3b00b64976d",
                                "sense_id": "893f20c4-21e3-33a7-857e-fe26770f2dac",
                                "text": "… il semble bien que la protohistoire du cinéma porno en France ait débuté en 1968 à Cocheren, une petite ville de Lorraine où la modeste salle du « Lido » afficha une programmation de films importés d'Allemagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fc880a2-0e91-4e32-be4c-683c73cb0ce1",
                        "source_entry_id": "1fcb078c-b0d9-3079-809b-abc1cf450c9b",
                        "target_lang_word": "protohistory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protohistory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0948f018-9b94-3a4a-a846-a23183baa405",
                                        "entry_id": "02b533b8-c87b-35ca-92b7-5d4d05919418",
                                        "glosses": [
                                            "The period between prehistory and history, during which a culture or civilization has not yet developed writing, but other cultures have already noted its existence in their own writings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ae53f0-2697-4c02-8ec3-1de38093ff16",
                                                "sense_id": "0948f018-9b94-3a4a-a846-a23183baa405",
                                                "text": "And at all times, now as in proto-history, the membrum virile is the symbol of creation, the ultimate basis and source of life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
