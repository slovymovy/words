                                "sense_id": "abdf1720-6f6c-3781-b53d-e2856be08b53",
                                "text": "L’affinement des métaux."
                            },
                            {
                                "example_id": "67b00bda-ef3e-44cd-a38d-9eccc5c9d070",
                                "sense_id": "abdf1720-6f6c-3781-b53d-e2856be08b53",
                                "text": "Le vent rassemblait les nuages vers l’est, et le soleil faisait un affinement translucide, de l’autre côté, dans les marbrures grises du ciel."
                            },
                            {
                                "example_id": "caf8c143-0252-4ddb-8f11-16048263bcc1",
                                "sense_id": "abdf1720-6f6c-3781-b53d-e2856be08b53",
                                "text": "L’objectif principal de mon atelier était l’affinement du schéma corporel."
                            }
                        ]
                    }
