{
    "word_family": [
        "commandant",
        "commande",
        "commandement",
        "commanditaire",
        "commanditer",
        "télécommande"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d323a28-fb62-340b-a5b7-fc56577f63f1",
                    "sense_definition": "Demander la fourniture d'un bien, d'un produit ou d'un service auprès d'un commerçant ou d'un établissement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous pouvons <w>commander</w> une pizza pour le dîner ce soir."
                        },
                        {
                            "text": "Le client <w>commande</w> un café et un croissant au serveur."
                        }
                    ],
                    "antonyms": [
                        "annuler"
                    ],
                    "common_phrases": [
                        "commander un repas",
                        "commander en ligne"
                    ]
                },
                {
                    "sense_id": "41f78b18-5fd4-3c4a-8dc6-579187f4ee0d",
                    "sense_definition": "Donner un ordre, prescrire avec autorité à quelqu'un de faire quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "autorité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>commande</w> aux élèves de faire silence immédiatement."
                        },
                        {
                            "text": "Il lui a <w>commandé</w> de quitter la pièce sans attendre."
                        }
                    ],
                    "synonyms": [
                        "ordonner",
                        "exiger"
                    ],
                    "antonyms": [
                        "obéir",
                        "prier"
                    ],
                    "common_phrases": [
                        "commander de faire"
                    ]
                },
                {
                    "sense_id": "48a5904c-c137-3eb8-a726-851bdddf2f16",
                    "sense_definition": "Avoir l'autorité supérieure sur une troupe, un navire ou une organisation militaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce capitaine expérimenté <w>commande</w> le régiment depuis deux ans."
                        },
                        {
                            "text": "L'officier supérieur <w>commandait</w> l'ensemble des opérations maritimes."
                        }
                    ],
                    "synonyms": [
                        "diriger"
                    ],
                    "common_phrases": [
                        "commander une troupe",
                        "commander en chef"
                    ]
                },
                {
                    "sense_id": "4c4bf9a5-5490-32a9-8200-9bc56529c952",
                    "sense_definition": "Exiger, inspirer ou dicter par nécessité morale, logique ou naturelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La prudence nous <w>commande</w> de vérifier chaque détail avant d'agir."
                        },
                        {
                            "text": "Son courage exceptionnel face à l'adversité <w>commande</w> le respect."
                        }
                    ],
                    "synonyms": [
                        "imposer",
                        "dicter"
                    ],
                    "common_phrases": [
                        "commander le respect",
                        "la prudence commande"
                    ]
                },
                {
                    "sense_id": "ce444ea1-e5fe-33b1-95d0-824b91cbaab6",
                    "sense_definition": "Actionner ou piloter le fonctionnement d'un mécanisme, d'un moteur ou d'un appareil.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un bouton situé sur le côté permet de <w>commander</w> le système d'alarme."
                        },
                        {
                            "text": "Cette vanne principale est directement <w>commandée</w> par un moteur électrique."
                        }
                    ],
                    "synonyms": [
                        "actionner",
                        "piloter"
                    ],
                    "common_phrases": [
                        "commander à distance"
                    ]
                },
                {
                    "sense_id": "dfac9cab-e644-3d14-9003-c0d80c528751",
                    "sense_definition": "Dominer un lieu ou un paysage par sa hauteur ou sa position géographique stratégique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille forteresse médiévale <w>commande</w> toute la vallée environnante."
                        },
                        {
                            "text": "Depuis ce haut sommet, le regard <w>commandait</w> l'ensemble des collines."
                        }
                    ],
                    "synonyms": [
                        "dominer",
                        "surplomber"
                    ],
                    "common_phrases": [
                        "commander la vallée"
                    ]
                }
            ]
        }
    ]
}