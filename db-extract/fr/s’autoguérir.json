                        "glosses": [
                            "Se guérir tout seul, par ses propres moyens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81280c2f-13a2-4676-8901-051d20132f81",
                                "sense_id": "95694aca-026b-37ad-9171-4226494c68da",
                                "text": "Il a tenté de s’autoguérir par un travail considérable sur la langue et par une démarche initiatique."
                            },
                            {
                                "example_id": "41e78dbd-e8d6-4258-8c1a-46797fe824f5",
                                "sense_id": "95694aca-026b-37ad-9171-4226494c68da",
                                "text": "Mais il ne pourra en aucun cas se substituer aux efforts entrepris par l'organisme pour s’autoguérir ; il devra, au contraire, l’y aider."
                            }
                        ]
                    }
