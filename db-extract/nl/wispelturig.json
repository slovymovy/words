                "senses": [
                    {
                        "sense_id": "9af14e6d-88b2-3a04-9c17-9dcc6a2760b0",
                        "entry_id": "12f5512d-586d-3b27-9507-82903c0c7b5e",
                        "glosses": [
                            "veranderlijk in gedrag en gedachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcecff66-cc11-4c69-8a04-23c19bd750ca",
                                "sense_id": "9af14e6d-88b2-3a04-9c17-9dcc6a2760b0",
                                "text": "De moderne consument is wispelturig en niet langer merktrouw."
                            },
                            {
                                "example_id": "c1d93216-e4cc-42cf-98ef-8e41de7caaab",
                                "sense_id": "9af14e6d-88b2-3a04-9c17-9dcc6a2760b0",
                                "text": "Bij het Jesse-bashen, noteert Ton den Boom in zijn taalrubriek in Trouw, vielen nogal wat woorden uit het zelfde woordveld: 'gedraai', 'zwalkend optreden', 'onverwachte wending', 'draai', 'gezwabber'. Klaver werd, kortom, wispelturig gevonden. En: 'Wie wispelturig heet te zijn, is niet geschikt als bedrijfspoedel van Rutte.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "048a758d-d471-4ee9-908c-ecbbe0789766",
                        "source_entry_id": "12f5512d-586d-3b27-9507-82903c0c7b5e",
                        "source_sense_id": "9af14e6d-88b2-3a04-9c17-9dcc6a2760b0",
