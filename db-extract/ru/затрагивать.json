                                                "sense_id": "2005e701-e6bb-368d-9733-51edda9f934e",
                                                "text": "Er wollte kein Weib, das zuvor berührt worden war."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
