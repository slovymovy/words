                ],
                "senses": [
                    {
                        "sense_id": "8475a1b4-8552-35f5-9766-eb5b126f6b70",
                        "entry_id": "5c926495-be38-37b3-9c47-f9177ec7611a",
                        "glosses": [
                            "pies Oriona, przeniesiony na firmament jako gwiazda Syriusz (1.2)"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "30081110-dae3-480f-b78f-b63011582662",
                                "sense_id": "8475a1b4-8552-35f5-9766-eb5b126f6b70",
                                "text": "Orionowi podczas polowania towarzyszył pies Syriusz."
                            },
                            {
                                "example_id": "e6ea7aab-b2c7-4ba4-8238-b7f9c0a56279",
                                "sense_id": "8475a1b4-8552-35f5-9766-eb5b126f6b70",
                                "text": "Myśliwy Orion został po śmierci przeniesiony między gwiazdy wraz z psem Syriuszem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c14b75dc-8450-3761-9b40-78e0d8fc3885",
                        "entry_id": "5c926495-be38-37b3-9c47-f9177ec7611a",
                        "glosses": [
                            "najjaśniejsza gwiazda na nocnym niebie, znajdująca się w gwiazdozbiorze Wielkiego Psa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aee1926-2223-4a49-8549-c7e7ebdeb94d",
                                "sense_id": "c14b75dc-8450-3761-9b40-78e0d8fc3885",
                                "text": "Syriusz, zwany także Psią Gwiazdą lub Kanikułą, jest gwiazdą podwójną i jedną z gwiazd położonych najbliżej Ziemi."
                            },
                            {
                                "example_id": "62a49a95-c142-4514-80d4-e47d0d2991e4",
                                "sense_id": "c14b75dc-8450-3761-9b40-78e0d8fc3885",
                                "text": "Gwiazdozbiór Oriona widnieje na niebie niedaleko Syriusza, który jest z nim mitologicznie powiązany."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ab13896-177a-4e6a-b623-a70599850de2",
