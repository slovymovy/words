        "fr-extract.jsonl": [
            {
                "entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                "word": "impudeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c142b3a1-23a6-41ee-97e0-8eb547dbbcc4",
                        "entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                        "tags": [
                            "plural"
                        ],
                        "form": "impudeurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                        "entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                        "glosses": [
                            "Défaut de pudeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb9fcaf2-342e-475c-8356-a68a6bc6c316",
                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                "text": "Leurs chansons et les gestes de leur danse étaient d’une impudeur ardente qui enflammait peu à peu les spectateurs très nombreux ce soir-là."
                            },
                            {
                                "example_id": "df21ecd0-95e4-49e1-ae28-a00740e61a48",
                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                "text": "[…] la chaste fille fit tomber ses vêtements avec une impudeur sublime, et, relevant ses cheveux comme Aphrodite sortant de la mer, elle se tint debout sous le rayon lumineux."
                            },
                            {
                                "example_id": "73d6948d-74ab-4fb3-b15e-d42f347db2eb",
                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                "text": "Une blouse de soie blanche ouvrait les bras avec une sorte d’impudeur sur le fauteuil à bascule."
                            },
                            {
                                "example_id": "1343a1ad-bc2d-4645-9558-a3cd5f899391",
                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                "text": "Il se rappela qu’elle portait une robe si étroitement ajustée que certaines parties de son corps se laissaient voir avec précision, et que la robe fût rouge aggravait cette impudeur."
                            },
                            {
                                "example_id": "debb03cc-2a1f-4a4e-8536-da333641184d",
                                "sense_id": "1522a179-c92e-3c98-ab7d-f6b646a0dab1",
                                "text": "On dit que ces professionnelles ont des charmes secrets, […] ; qu’un homme vicieux trouve en elles des partenaires expertes, aux impudeurs extraordinaires, aux habiles jeux de la débauche et de la lubricité."
                            }
                        ]
                    },
                    {
                        "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                        "entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                        "glosses": [
                            "Défaut de la retenue qu’exige le sentiment de la dignité personnelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf23601-b6ec-4bbd-82b7-03ff4d53b5a0",
                                "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                                "text": "Gorgés de biens, ils ont l’impudeur de demander encore."
                            },
                            {
                                "example_id": "aa00a248-9bf6-4d6c-b399-b11ef60f482c",
                                "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                                "text": "Moi, les politiciens me choquent, par l’impudeur avec laquelle ils mentent"
                            },
                            {
                                "example_id": "64e396f7-1879-4265-a0ce-40687ef10ffe",
                                "sense_id": "abe64b31-0346-323b-b457-b458ef3e795e",
                                "text": "L’impudeur de certains jeunes professeurs ne connaîtra donc plus de bornes ? Sous l’influence des romans libertins et du cinéma immoral, l’Université elle-même se croit tout permis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c28c9af9-6295-4c5c-bc35-537920935b74",
                        "source_entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                        "target_lang_word": "shamelessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shamelessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85b57162-10d1-3e5b-84ca-fba431ac44b9",
                                        "entry_id": "a69b135c-ea7b-3356-a35a-70136c1cd619",
                                        "glosses": [
                                            "The state or characteristic of being shameless."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a701f52-ee7e-4e84-9092-0659be2b4f2e",
                                                "sense_id": "85b57162-10d1-3e5b-84ca-fba431ac44b9",
                                                "text": "[H]e added to all his other shamelessness this, that he offered the patriarch a large sum of money to buy a bishopric of him."
                                            },
                                            {
                                                "example_id": "f353f0c6-79c2-4d36-8ba2-d9adb68a603c",
                                                "sense_id": "85b57162-10d1-3e5b-84ca-fba431ac44b9",
                                                "text": "\"For instance as to her shamelessness. She was always ready to run half naked about the hills. . . .\""
                                            },
                                            {
                                                "example_id": "f52067e8-5957-4058-9500-a7ae56732bef",
                                                "sense_id": "85b57162-10d1-3e5b-84ca-fba431ac44b9",
                                                "text": "She was quite honest with herself; she knew that she was watching for Clay, and she had a magnificent shamelessness in her quest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f0a92e0-07af-345e-aa56-721d7b5e4870",
                                        "entry_id": "a69b135c-ea7b-3356-a35a-70136c1cd619",
                                        "glosses": [
                                            "An utterance or action which is shameless."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d24514bf-9df1-47aa-8b1b-4fbf0d51ebda",
                                                "sense_id": "7f0a92e0-07af-345e-aa56-721d7b5e4870",
                                                "text": "Shoals of letters are published every week from all parts of the Union telling stories of the unhappiness produced by marriage, sometimes mere bursts of ill-temper, often cynical shamelessnesses, occasionally stories of deep pathos, but all intended as denunciations of the existing scheme of morals, all followed by the same remark that while marriage exists there can be no happiness for mankind."
                                            },
                                            {
                                                "example_id": "be601218-1763-413f-87da-052dd28dc23a",
                                                "sense_id": "7f0a92e0-07af-345e-aa56-721d7b5e4870",
                                                "text": "He was able to write in the gloom of his bottle only because of his noseglow nose's glow as it slid over the paper and while he scribbled & scratched nameless shamelessnesses about ethers everybody ever he met. . . ."
                                            },
                                            {
                                                "example_id": "475cd508-f956-4e0f-a1f1-b61741e16bd7",
                                                "sense_id": "7f0a92e0-07af-345e-aa56-721d7b5e4870",
                                                "text": "He asked of course after Taimsa, who was still dallying in shamelessnesses at Antioch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9646a32-b201-4b07-b62e-88612c0ad763",
                        "source_entry_id": "306729dc-e9f0-3feb-9200-280cf77a4af9",
                        "target_lang_word": "indecency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indecency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86e49754-3f19-36bd-80fa-8f84974313f3",
                                        "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                                        "glosses": [
                                            "Lack of decency; the property or degree of being indecent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be0c87a5-8997-4182-8dab-0df0ae0b4e49",
                                                "sense_id": "86e49754-3f19-36bd-80fa-8f84974313f3",
                                                "text": "One sure sign of indecency is criticizing foreigners constantly, but remaining silent about the problems within your own land, or by your own people, or both."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a99de16-971b-35c1-a05d-6daa9e2debcf",
                                        "entry_id": "04a18bf5-eac9-33b9-bea8-52e3a56957b6",
                                        "glosses": [
                                            "Something showing lack of decency; something (such as a word) that is indecent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
