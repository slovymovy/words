                        "entry_id": "c671fd67-6649-31e4-a9dc-8801c5da3217",
                        "glosses": [
                            "Any systematic procedure for statistically combining the results of many different studies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd7daebd-331c-43cf-8796-d58cef078f4c",
                                "sense_id": "f8378c42-cf65-3a1a-8984-1a801b3f6070",
                                "text": "She began asking the question, “Were you friends with your partner before you became romantically involved?” in her other research and conducted a meta-analysis for this paper."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4ebf2d6-2f23-3239-bd6e-bc60ec4bd17e",
                        "entry_id": "c671fd67-6649-31e4-a9dc-8801c5da3217",
                        "glosses": [
