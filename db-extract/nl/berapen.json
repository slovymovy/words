                                                "sense_id": "bdbe6127-28b4-3695-9438-3f5a3da004c7",
                                                "text": "A low-resolution render might look blocky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da14dc5-9814-3e55-98f5-194af5776111",
                                        "entry_id": "6403fe40-b6cb-3dbc-87ef-4b50a8919a02",
                                        "glosses": [
                                            "A surrender."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e77675c-029d-3c83-8b57-313d74e0c604",
                                        "entry_id": "6403fe40-b6cb-3dbc-87ef-4b50a8919a02",
                                        "glosses": [
                                            "A return; a payment of rent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e95c3213-2a94-4ba8-94be-7c48ccaf605b",
                                                "sense_id": "7e77675c-029d-3c83-8b57-313d74e0c604",
                                                "text": "In those early times the king's household was supported by specific renders of corn and other victuals from the tenants of the demesnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59de284f-edc8-321d-844f-63ec0b8f2a6c",
                                        "entry_id": "6403fe40-b6cb-3dbc-87ef-4b50a8919a02",
                                        "glosses": [
                                            "An account given; a statement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f74504-4fd7-4749-ad0f-fa95f1eef8b6",
                                                "sense_id": "59de284f-edc8-321d-844f-63ec0b8f2a6c",
                                                "text": "And send forth us , to make their sorrow'd render,\nTogether with a recompense more fruitful\nThan their offence can weigh down by the dram"
                                            }
                                        ]
                                    }
                                ]
                            },
