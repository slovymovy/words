            {
                "entry_id": "2b2e8953-99dc-3790-9434-38eaab0e45ad",
                "word": "courtil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "507b36c3-9a4f-4bdc-9f67-a8696d2a5cce",
                        "entry_id": "2b2e8953-99dc-3790-9434-38eaab0e45ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "courtils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91b6cc79-33d9-3896-8c82-d5365c9973e9",
                        "entry_id": "2b2e8953-99dc-3790-9434-38eaab0e45ad",
                        "glosses": [
                            "Petit jardin."
                        ],
                        "tags": [
                            "dated",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "9492f44f-bc67-4772-a153-e346d73394a0",
                                "sense_id": "91b6cc79-33d9-3896-8c82-d5365c9973e9",
                                "text": "Le plus beau pays du monde\nC’est la terre ou je naquis,\nAu printemps la rose abonde\nAux abords de ses courtils; …."
                            },
                            {
                                "example_id": "28dc46c0-46d7-45bc-b66d-82e628481f4d",
                                "sense_id": "91b6cc79-33d9-3896-8c82-d5365c9973e9",
                                "text": "Le sabotier et ses fils ne revirent plus jamais le Juif errant, mais ils plantèrent le noyau dans leur courtil."
                            },
                            {
                                "example_id": "3762d5cf-d5e4-4270-a3a5-7a6dc09644ff",
                                "sense_id": "91b6cc79-33d9-3896-8c82-d5365c9973e9",
                                "text": "Cette vigne est en votre courtil; cependant point n’aurez-vous le profit de la cueillette, répliqua maître Ogier …."
                            },
                            {
                                "example_id": "69803433-1bbf-4231-a3e7-8fcc0e75029a",
                                "sense_id": "91b6cc79-33d9-3896-8c82-d5365c9973e9",
                                "text": "Il poussa la petite barrière du courtil et s'avança vers la maison, vieux, triste, les épaules accablées et le regard à terre."
                            },
                            {
                                "example_id": "be074819-ebbf-4dfa-8e3e-f91fe9296347",
                                "sense_id": "91b6cc79-33d9-3896-8c82-d5365c9973e9",
                                "text": "Et puis voici un populeux village, un village compact, ramassé, aux ruelles étroites et tortueuses, sans jardins, sans courtils, un village serré autour de son antique clocher."
                            },
                            {
                                "example_id": "f7178925-474e-4f39-be81-95ff01d3e6f6",
                                "sense_id": "91b6cc79-33d9-3896-8c82-d5365c9973e9",
                                "text": "Il enjamba un fossé, franchit une haie; leva un échalier, entra dans un courtil délabré, fit quelque pas assez hardiment ...."
                            }
                        ]
                    }
                ],
