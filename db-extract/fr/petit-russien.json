                "senses": [
                    {
                        "sense_id": "0acda482-32e1-34e1-9d51-c7b31f05dcca",
                        "entry_id": "c9551eeb-74aa-3a1f-8d76-99b59be8c84b",
                        "glosses": [
                            "Variante de petit-russe."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "bb8e6560-af9a-4348-9e61-0cdd825159a4",
                                "sense_id": "0acda482-32e1-34e1-9d51-c7b31f05dcca",
                                "text": "D’abord la proximité des provinces petites-russiennes où, vous le savez, les eaux-de-vie se débitent librement ; quinze jours plus tard, je vous l’affirme, ce seront des soûlards invétérés."
                            },
                            {
                                "example_id": "f81e4e60-b7ee-4245-af14-07fe951703fe",
                                "sense_id": "0acda482-32e1-34e1-9d51-c7b31f05dcca",
                                "text": "Caucasiens, bohémiens, petits-russiens,\n Tous les rythmes formaient une géographie\n Intangible, qui rit du temps et le défie ;\n Et le pays entier reconnaissait les siens."
                            }
                        ]
                    }
