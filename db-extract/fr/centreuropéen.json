                ],
                "senses": [
                    {
                        "sense_id": "6b5be77f-6064-32f2-ae8b-93bd68f08b17",
                        "entry_id": "a8ca487e-32a4-3d44-a300-2378bd746106",
                        "glosses": [
                            "D’Europe centrale, relatif à l’Europe centrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c3e0a4-e788-408a-877a-8ba0f8c4af3a",
                                "sense_id": "6b5be77f-6064-32f2-ae8b-93bd68f08b17",
                                "text": "Sans appartenir au type international proprement dit, on ne pourrait le considérer comme déplacé ni dans un ensemble méditerranéen, ni dans un ensemble Ouest ou centreuropéen de la civilisation des gobelets caliciformes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d2de44b-0560-4600-a365-3a98424b66d6",
                        "source_entry_id": "a8ca487e-32a4-3d44-a300-2378bd746106",
                        "source_sense_id": "6b5be77f-6064-32f2-ae8b-93bd68f08b17",
                        "target_lang_word": "zentraleuropäisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a754b00a-4bec-40fa-baa8-2885bca040ac",
                        "source_entry_id": "a8ca487e-32a4-3d44-a300-2378bd746106",
                        "source_sense_id": "6b5be77f-6064-32f2-ae8b-93bd68f08b17",
                        "target_lang_word": "Central European",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Central European",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95d21b20-59ff-3add-965c-3346311c8f5d",
                                        "entry_id": "349130f5-f9ed-3e57-bc55-c654027e9c81",
                                        "glosses": [
                                            "Of, from, or pertaining to Central Europe, its people, or its culture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd65195d-30c5-4cc7-b8c3-3a3223a74ea1",
                                                "sense_id": "95d21b20-59ff-3add-965c-3346311c8f5d",
                                                "text": "Who knows much about the venerable traditions of Central European kingdoms like Poland-Lithuania, Bohemia, and Hungary and their valiant struggles for freedom?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Central European",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c22fb0-d33c-328f-9d0a-8e65c91e45db",
                                        "entry_id": "51c26f0d-85e7-3186-95df-e155725a00e3",
                                        "glosses": [
                                            "A Central European person; one who comes from or lives in Central Europe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "707c3b88-00ca-438c-898f-ba6744101453",
                                                "sense_id": "f5c22fb0-d33c-328f-9d0a-8e65c91e45db",
                                                "text": "Central Europeans also have in their heads a number of different historical maps and milestones that are not particularly well known outside the region or necessarily respected by their neighbors, and they still regularly use them as points of orientation."
                                            },
                                            {
                                                "example_id": "e607ddef-9f42-4da4-a740-2ab5991b83d3",
                                                "sense_id": "f5c22fb0-d33c-328f-9d0a-8e65c91e45db",
                                                "text": "Polish, Hungarian, Slovak, and Slovene national elites have tried desperately to prove that their countries do not belong to the \"East\"; that they are, indeed, Central Europeans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64f40964-8842-4003-9eac-1bcd3acce2ff",
                        "source_entry_id": "a8ca487e-32a4-3d44-a300-2378bd746106",
                        "source_sense_id": "6b5be77f-6064-32f2-ae8b-93bd68f08b17",
