                                        "entry_id": "01fdd6b4-cbfe-3f8a-9b2a-20f0721b7525",
                                        "glosses": [
                                            "jemand verstößt gegen etwas: eine Regel oder ein Gesetz brechen; sich nicht an etwas halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15238dba-571d-4264-af0f-566b99308433",
                                                "sense_id": "e60c33b0-3fd0-34fd-afe7-ed4118611a54",
                                                "text": "Er hat gegen das Gesetz verstoßen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aae6a840-64ec-36d1-a3c7-9cf534db131e",
                                        "entry_id": "01fdd6b4-cbfe-3f8a-9b2a-20f0721b7525",
                                        "glosses": [
                                            "etwas verstößt gegen etwas: nicht regel- oder gesetzeskonform sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750ae906-f147-440a-b45f-260ca5d16fcd",
                                                "sense_id": "aae6a840-64ec-36d1-a3c7-9cf534db131e",
                                                "text": "Die Vorratsdatenspeicherung verstößt gegen das Grundgesetz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "29c6841a-cfc1-3013-9293-2c24bf05be7b",
                                        "entry_id": "01fdd6b4-cbfe-3f8a-9b2a-20f0721b7525",
                                        "glosses": [
                                            "jemanden verstoßen: jemanden aus einer Gruppe (z. B. der Familie) ausschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00c7b63b-9d5f-43b5-84a1-55c0e75e60d8",
                                                "sense_id": "29c6841a-cfc1-3013-9293-2c24bf05be7b",
                                                "text": "Er wurde als Kind von seinen Eltern verstoßen."
                                            },
                                            {
                                                "example_id": "d2c4b55d-1481-4282-b8ff-43501e650ff5",
                                                "sense_id": "29c6841a-cfc1-3013-9293-2c24bf05be7b",
                                                "text": "„Da für Karl das Bündnis mit Desiderius nicht mehr von Nutzen war, verstieß er seine Frau nach kurzer Ehe und schickte sie seinem Schwiegervater zurück.“"
                                            },
                                            {
                                                "example_id": "dd93feef-b97f-46c9-9b63-84098947bd70",
                                                "sense_id": "29c6841a-cfc1-3013-9293-2c24bf05be7b",
                                                "text": "„Selbst der Herrscher der Hölle war einst ein himmlisches Wesen. Dann aber rebellierte Luzifer gegen Gott und er wurde verstoßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
