                                "target_lang_sense_clarification": "data or error codes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df2edf3d-6098-3309-a43b-637c8e996cc8",
                    "sense_definition": "het scheiden van goede van slechte exemplaren door ze handmatig of machinaal te selecteren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sorteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boeren waren de hele middag bezig met het <w>uitlezen</w> van de geoogste erwten.",
                            "target_lang_translations": {
                                "en": "The farmers spent the whole afternoon <w>sorting</w> the harvested peas."
                            }
                        },
                        {
                            "text": "Bij de kwaliteitscontrole worden de beschadigde vruchten zorgvuldig <w>uitgelezen</w>.",
                            "target_lang_translations": {
                                "en": "During quality control, the damaged fruits are carefully <w>picked out</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sorteren",
                        "triëren",
                        "uitzoeken"
                    ],
                    "common_phrases": [
                        "zaden uitlezen"
