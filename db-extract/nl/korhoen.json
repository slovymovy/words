                        "sense_id": "457b886b-b11c-3e58-8ed7-a16f4e8bda0f",
                        "entry_id": "deb81181-8eb6-33a9-9b30-7d7fdfe06843",
                        "glosses": [
                            "Lyrurus tetrix een vogel uit de ruigpoothoenders"
                        ],
                        "tags": [
                            "hoendervogels"
                        ],
                        "examples": [
                            {
                                "example_id": "503147d4-3d83-460b-b867-f37d950e65ae",
                                "sense_id": "457b886b-b11c-3e58-8ed7-a16f4e8bda0f",
                                "text": "Korhoenders zijn bijna uit Nederland verdwenen doordat geschikt terrein steeds zeldzamer geworden is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0c8579f-f73c-45e8-a952-7375a8a4d568",
                        "source_entry_id": "deb81181-8eb6-33a9-9b30-7d7fdfe06843",
                        "source_sense_id": "457b886b-b11c-3e58-8ed7-a16f4e8bda0f",
                        "source_sense_description": "Lyrurus tetrix",
                        "target_lang_word": "тетерев",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тетерев",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "87507245-f3a5-34ea-97f9-5637715a515d",
                                        "entry_id": "fff47a26-43e0-327a-9c5a-0bdf8d97cee4",
                                        "glosses": [
                                            "орнитол. крупная лесная птица из семейства тетеревиных (Lyrurus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d14ba2-ec18-4581-82d6-56a29bc0e45b",
                                                "sense_id": "87507245-f3a5-34ea-97f9-5637715a515d",
                                                "text": "К тетеревам относятся кавказский тетерев и тетерев-косач."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "274361d9-fc4b-3751-b13e-09f8f2874462",
                                        "entry_id": "fff47a26-43e0-327a-9c5a-0bdf8d97cee4",
                                        "glosses": [
                                            "орнитол. то же, что тетерев-косач, Lyrurus tetrix"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e64a10b-44e7-4ef6-acba-4bda4ccc1599",
                                                "sense_id": "274361d9-fc4b-3751-b13e-09f8f2874462",
                                                "text": "Чуть стихло, и вот уж доносится издали лёгкий хруст сухого валежника: то кровожадная куница осторожно пробирается из своего дупла к дереву, где задремал глупый красноглазый тетерев."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee5a8a68-9ab2-32a2-8155-880a4b9336a4",
                                        "entry_id": "fff47a26-43e0-327a-9c5a-0bdf8d97cee4",
                                        "glosses": [
                                            "перен. редк. глупый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5bd9c36-3863-4657-bf5d-c9f2cc081486",
                                                "sense_id": "ee5a8a68-9ab2-32a2-8155-880a4b9336a4",
                                                "text": "С удовольствием пила парное молоко и уж как, понимаю я теперь, подоить хотела, но я, тетерев, не догадывался."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
