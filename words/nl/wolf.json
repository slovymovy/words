                    "sense_id": "278485b7-372f-39ce-9a12-53192f69f13a",
                    "sense_definition": "Een wild, vleesetend zoogdier (Canis lupus) dat in groepen jaagt en voorkomt op het noordelijk halfrond.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dat gebied kun je vaak <w>wolven</w> zien lopen.",
                            "target_lang_translations": {
                                "en": "In that area you can often see <w>wolves</w> walking.",
                                "ru": "В этой местности часто можно увидеть <w>волков</w>.",
                                "pl": "W tamtej okolicy często można zobaczyć biegające <w>wilki</w>.",
                                "de": "In diesem Gebiet kann man oft <w>Wölfe</w> herumlaufen sehen.",
                                "fr": "Dans cette région, on peut souvent voir des <w>loups</w> marcher.",
                                "it": "In quella zona si possono spesso vedere dei <w>lupi</w> camminare.",
                                "cs": "V této oblasti můžete často vidět běžet <w>vlky</w>.",
                                "tr": "O bölgede sık sık <w>kurtların</w> dolaştığını görebilirsin.",
                                "es": "En esa zona a menudo se pueden ver <w>lobos</w> caminando."
                            }
                        },
                        {
                            "text": "De <w>wolf</w> is de wilde voorouder van de hond.",
                            "target_lang_translations": {
                                "en": "The <w>wolf</w> is the wild ancestor of the dog.",
                                "ru": "<w>Волк</w> — это дикий предок собаки.",
                                "pl": "<w>Wilk</w> jest dzikim przodkiem psa.",
                                "de": "Der <w>Wolf</w> ist der wilde Vorfahre des Hundes.",
                                "fr": "Le <w>loup</w> est l'ancêtre sauvage du chien.",
                                "it": "Il <w>lupo</w> è l'antenato selvatico del cane.",
                                "cs": "<w>Vlk</w> je divokým předkem psa.",
                                "tr": "<w>Kurt</w>, köpeğin vahşi atasıdır.",
                                "es": "El <w>lobo</w> es el ancestro salvaje del perro."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een wolf in schaapskleren",
                        "hongerig als een wolf",
                        "huilen met de wolven in het bos"
                    ],
                    "target_lang_definitions": {
                        "en": "A wild, carnivorous mammal (Canis lupus) that hunts in packs and is found in the northern hemisphere.",
                        "ru": "Дикое плотоядное млекопитающее (Canis lupus), которое охотится стаями и обитает в Северном полушарии.",
                        "pl": "Dziki, mięsożerny ssak (Canis lupus), który poluje w stadach i występuje na półkuli północnej.",
                        "de": "Ein wildes, fleischfressendes Säugetier (Canis lupus), das in Rudeln jagt und auf der Nordhalbkugel vorkommt.",
                        "fr": "Un mammifère carnivore sauvage (Canis lupus) qui chasse en meute et vit dans l'hémisphère nord.",
                        "it": "Un mammifero carnivoro selvatico (Canis lupus) che caccia in branco ed è diffuso nell'emisfero settentrionale.",
                        "cs": "Divoký, masožravý savec (Canis lupus), který loví ve smečkách a vyskytuje se na severní polokouli.",
                        "tr": "Kuzey yarımkürede yaşayan, sürüler hâlinde avlanan, yırtıcı ve etçil bir yaban memelisi (Canis lupus).",
                        "es": "Un mamífero carnívoro salvaje (Canis lupus) que caza en manadas y se encuentra en el hemisferio norte."
                    },
