                    {
                        "translation_id": "c055e6dc-2bea-4804-a26a-a925cad83439",
                        "source_entry_id": "7ebaaed1-1d40-3a59-be64-28b0a9ffa263",
                        "source_sense_id": "6f3e1a82-45bc-32b0-8603-2efb32680e1b",
                        "target_lang_word": "горячность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "горячность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c82c0f5d-8a41-3a35-b813-055469328d94",
                                        "entry_id": "bbb4e144-dd43-3fd5-88fb-94d73cab3cfc",
                                        "glosses": [
                                            "пылкость, увлечение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10bb4d2d-d567-4079-ac19-d9b8b9cb116b",
                                                "sense_id": "c82c0f5d-8a41-3a35-b813-055469328d94",
                                                "text": "И прошло почти 15 лет, и та искренняя горячность, с которой пытались помочь Спитаку, не должна была остаться бесследной."
                                            },
                                            {
                                                "example_id": "1970bf39-0fd4-44e9-a096-0b5a6b5d4330",
                                                "sense_id": "c82c0f5d-8a41-3a35-b813-055469328d94",
                                                "text": "Даже в минуту такого острого горя я почувствовала весь порыв, всю горячность этого поступка от почти незнакомого человека."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2ff1b86-b6b7-312e-88cc-3a683c4f7e6e",
                                        "entry_id": "bbb4e144-dd43-3fd5-88fb-94d73cab3cfc",
                                        "glosses": [
                                            "несдержанность, вспыльчивость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87be9bd-ea1e-487f-856d-f522f94e691c",
                                                "sense_id": "d2ff1b86-b6b7-312e-88cc-3a683c4f7e6e",
                                                "text": "Горячность не допустила меня тогда рассудить, что прямо любочестивый человек ревнует к делам, а не к чинам; что чины нередко выпрашиваются, а истинное почтение необходимо заслуживается; что гораздо честнее быть без вины обойдену, нежели без заслуг пожаловану."
                                            },
                                            {
