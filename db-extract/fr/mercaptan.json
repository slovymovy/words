                        "examples": [
                            {
                                "example_id": "47bd1339-b4b6-4f17-8caa-2a8d4ac1fedf",
                                "sense_id": "251e3865-4dfc-34dc-8d27-8829af70f45e",
                                "text": "Je pouvais également rejoindre Bayonne par Martre-Tolosane, […] prier pour que le vent souffle dans le bon sens afin d’échapper au^([sic]) effluves putrides de mercaptan relâchées par les raffineries de Lacq […]."
                            },
                            {
                                "example_id": "e0a59d90-0871-4bc3-9a6d-5863e355f8ff",
                                "sense_id": "251e3865-4dfc-34dc-8d27-8829af70f45e",
                                "text": "Par ailleurs des pièges sélectifs sont nécessaires afin d'éliminer les interférents tels que les hydrocarbures ou différents composés soufrés (H₂S, mercaptans et sulfures organiques)."
                            }
                        ]
