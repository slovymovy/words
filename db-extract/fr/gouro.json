                                        "entry_id": "b45c49d0-3ee8-3c59-8a8e-6e60e6251b14",
                                        "glosses": [
                                            "look, see, behold (in an imperative sense)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def56594-619b-4d9b-ab41-63bdbe6a8fa4",
                                                "sense_id": "68a70d36-34f9-39ef-974d-afefe0461e15",
                                                "text": "Caliban: Lo, lo again! Bite him to death, I prithee."
                                            },
                                            {
                                                "example_id": "c1206b7f-cc40-4da7-9a73-f8d486175958",
                                                "sense_id": "68a70d36-34f9-39ef-974d-afefe0461e15",
                                                "text": "Awake! for Morning in the Bowl of Night,\nHas flung the Stone that puts the Stars to Flight:\nAnd Lo! the Hunter of the East has caught\nThe Sultán's Turret in a Noose of light."
                                            },
                                            {
                                                "example_id": "04d9f9e0-35c9-470b-851d-674ac76d2501",
                                                "sense_id": "68a70d36-34f9-39ef-974d-afefe0461e15",
                                                "text": "[...], Lo, these many years do I serve thee, [...]."
                                            },
                                            {
                                                "example_id": "25a0c006-b4a1-4258-aa70-9f254d603315",
                                                "sense_id": "68a70d36-34f9-39ef-974d-afefe0461e15",
                                                "text": "Emperor Ling went in state to the Hall of Virtue. As he drew near the throne, a rushing whirlwind arose in the corner of the hall and, lo! from the roof beams floated down a monstrous black serpent that coiled itself up on the very seat of majesty. The Emperor fell in a swoon."
                                            },
                                            {
                                                "example_id": "caaaeb0d-fbed-4eee-abc8-f31415270489",
                                                "sense_id": "68a70d36-34f9-39ef-974d-afefe0461e15",
                                                "text": "\"Tambi will be here in...\" He computed carefully. \"... in exactly twenty seconds.\" And, lo, Tambi appeared at that very moment."
                                            }
                                        ]
                                    }
