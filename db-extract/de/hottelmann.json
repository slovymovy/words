                ],
                "senses": [
                    {
                        "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                        "entry_id": "b3b37fb1-b4f2-3416-bbd6-47adb7f5ed2c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79f420e-6f5e-4857-b82d-66342b75ff74",
                                "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                                "text": "Frau Hottelmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6d60f581-ff16-4a2a-a39d-9c93630bfe6c",
                                "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                                "text": "Herr Hottelmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "25bb75f4-f84d-4d1b-8d2c-fde055f85e22",
                                "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                                "text": "Die Hottelmanns kommen heute aus Franken."
                            },
                            {
                                "example_id": "b4b513a1-04d5-4741-80f7-a8b064f08c87",
                                "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                                "text": "Der Hottelmann trägt nie die Schals, die die Hottelmann ihm strickt."
                            },
                            {
                                "example_id": "7bda1eea-a08f-41f3-9fac-783f1739e6dc",
                                "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hottelmann kommt, geht der Herr Hottelmann.“"
                            },
                            {
                                "example_id": "d85ec3e8-4033-4439-a86f-da1c4fb34dd3",
                                "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                                "text": "Hottelmann kommt und geht."
                            },
                            {
                                "example_id": "4e74ab60-e259-448b-8f42-141be9bad4f8",
                                "sense_id": "6b5fe987-94d3-3581-853f-522c7f83743d",
                                "text": "Hottelmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
