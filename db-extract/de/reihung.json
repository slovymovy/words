                "translations": [
                    {
                        "translation_id": "bae4917e-f990-4ebe-9e97-cfaafe0ffc72",
                        "source_entry_id": "85bfb2b2-ed01-3a9e-b316-dfe18a07cd2d",
                        "source_sense_id": "c61371fb-5402-316d-858d-358af04eddd9",
                        "source_sense_description": "Informatik: Feld, Array",
                        "target_lang_word": "array",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "array",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f95a60d-3af7-3449-8be1-82ab93620642",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "Clothing and ornamentation; raiment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb411819-84ff-43d1-a216-0eada51ee1e0",
                                                "sense_id": "6f95a60d-3af7-3449-8be1-82ab93620642",
                                                "text": "Sovay, Sovay all on a day, She dressed herself in man's array, With a sword and a pistol all by her side, To meet her true love to meet her true love away did ride."
                                            },
                                            {
                                                "example_id": "8ba70f11-4562-4d70-b191-dd407466971f",
                                                "sense_id": "6f95a60d-3af7-3449-8be1-82ab93620642",
                                                "text": "In this Remembrance Emily e’re day / Aroſe, and dreſs’d her ſelf in rich Array […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1da29614-b711-3e25-8b2b-cd8e76ff6181",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "A collection laid out to be viewed in full."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5debf6d9-02b1-4a59-8089-e354f22d631b",
                                                "sense_id": "1da29614-b711-3e25-8b2b-cd8e76ff6181",
                                                "text": "The Begums' ministers, on the contrary, to extort from them the disclosure of the place which concealed the treasures, were, […] after being fettered and imprisoned, led out on to a scaffold, and this array of terrours proving unavailing, the meek tempered Middleton, as a dernier resort, menaced them with a confinement in the fortress of Chunargar. Thus, my lords, was a British garrison made the climax of cruelties!"
                                            },
                                            {
                                                "example_id": "83cc2814-08f5-40a7-8c9c-d45f81ea26a8",
                                                "sense_id": "1da29614-b711-3e25-8b2b-cd8e76ff6181",
                                                "text": "Upon leaving the center, I photographed the colorful array of petunias decorating the square in purple, pink, yellow, white, and magenta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "facb1f4f-ebd2-3a9d-8fe1-0bac5765e0e2",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "An orderly series, arrangement or sequence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f8a11b-4733-44ff-a82f-f6b757bd1efa",
                                                "sense_id": "facb1f4f-ebd2-3a9d-8fe1-0bac5765e0e2",
                                                "text": "But the chivalry of France was represented by as gallant an array of nobles and cavaliers as ever fought under the banner of the lilies"
                                            },
                                            {
                                                "example_id": "c8eae5f2-7f62-4c38-9e5f-876fe9f25386",
                                                "sense_id": "facb1f4f-ebd2-3a9d-8fe1-0bac5765e0e2",
                                                "text": "SAN FRANCISCO, July 23 — Pacific Gas & Electric, Northern California’s major utility, is announcing a commitment on Wednesday to purchase 550 megawatts of solar power to be generated by troughlike arrays of mirrors spread over nine square miles in the Mojave Desert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d851b246-284f-368e-9fe3-ebb28a723a2a",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "Order; a regular and imposing arrangement; disposition in regular lines; hence, order of battle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c638ef8-9b09-4df5-954c-b741aaec7e94",
                                                "sense_id": "d851b246-284f-368e-9fe3-ebb28a723a2a",
                                                "text": "drawn up in battle array"
                                            },
                                            {
                                                "example_id": "7248ce68-dcdd-495d-8a0a-0a492ac064ea",
                                                "sense_id": "d851b246-284f-368e-9fe3-ebb28a723a2a",
                                                "text": "wedged together in the closest array"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce61b1e9-240f-37ee-9729-d80e55c4bf0b",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "A large collection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca6635e7-02f8-4744-b7a2-e1f39430a454",
                                                "sense_id": "ce61b1e9-240f-37ee-9729-d80e55c4bf0b",
                                                "text": "We offer a dazzling array of choices."
                                            },
                                            {
                                                "example_id": "516ffd6e-b216-4918-8ac5-e82c64b5ecb1",
                                                "sense_id": "ce61b1e9-240f-37ee-9729-d80e55c4bf0b",
                                                "text": "Again his waves in milder tints unfold / Their long array of sapphire and of gold, / Mixt with the shades of many a distant isle, / That frown—where gentler ocean seems to smile."
                                            },
                                            {
                                                "example_id": "6f2af545-0547-46bd-8ff8-d7451a734967",
                                                "sense_id": "ce61b1e9-240f-37ee-9729-d80e55c4bf0b",
                                                "text": "Mario Balotelli, in the headlines for accidentally setting his house ablaze with fireworks, put City on their way with goals either side of the interval as United struggled to contain the array of attacking talent in front of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063e297f-a237-376a-81f4-54038be4f742",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "A matrix."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "519c0538-38a6-3eee-89c7-38db26fd3c31",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "Any of various data structures designed to hold multiple elements of the same type; especially, a data structure that holds these elements in adjacent memory locations so that they may be retrieved using numeric indices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c24f60c-52da-3083-9b97-c0d0a0e00dea",
                                        "entry_id": "e3fa62ab-0d1d-35b2-b901-e1fc02dbeac6",
                                        "glosses": [
                                            "A ranking or setting forth in order, by the proper officer, of a jury as impanelled in a cause; the panel itself; or the whole body of jurors summoned to attend the court."
                                        ],
