                "senses": [
                    {
                        "sense_id": "2c42528b-e202-37d0-9905-38dac4b575f3",
                        "entry_id": "f7848669-60ab-3b4a-a676-d770e9639456",
                        "glosses": [
                            "Voir une nouvelle fois une personne, un objet ou un sentiment de façon très fugitive, très rapide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d995ed3b-ca17-4ed0-b06d-926e8c63aafb",
                                "sense_id": "2c42528b-e202-37d0-9905-38dac4b575f3",
                                "text": "Il me suffit de le réentrevoir, comme hier, pour sentir quelle profonde et tendre affection me lie à lui."
                            },
                            {
                                "example_id": "b4ff8764-6bb9-4164-bd61-ce2c4f1538da",
                                "sense_id": "2c42528b-e202-37d0-9905-38dac4b575f3",
                                "text": "Quand, par hasard, ce « moi » quasi oublié se laisse réentrevoir à travers le spectacle un instant écarté, c'est le vertige, la terreur sacrée, la panique."
                            }
                        ]
                    }
