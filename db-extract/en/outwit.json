                        "cross_references": [
                            {
                                "target_word": "engañar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "dd909d10-3c00-3661-b207-f8a6d1b35ad1",
                                        "entry_id": "e7640b7b-f882-39b4-b5cb-522b5cd65d83",
                                        "glosses": [
                                            "Llevar deliberadamente a alguno a creer lo que no es cierto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e2cfb7-0335-49f8-8594-ac6cef117ecd",
                                                "sense_id": "dd909d10-3c00-3661-b207-f8a6d1b35ad1",
                                                "text": "Levantó los ojos sin miedo alguno, riendo de estas palabras. El señor acostumbraba a engañarla con bromas inverosímiles. Bien decía su padre que los Febrer eran unos caballeros serios como jueces, pero de eterno buen humor. Iba a burlarse otra vez de ella, lo mismo que cuando le hablaba de la novia de barro guardada en su torre, que había estado esperándole miles de años."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11281f4b-7e08-3fc2-8ddd-0c99fa7d8ed0",
                                        "entry_id": "e7640b7b-f882-39b4-b5cb-522b5cd65d83",
                                        "glosses": [
                                            "Dicho de un efecto sensorial, llevar a inferencias inexactas acerca de lo que le da origen; producir la ilusión de los sentidos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5355c6da-395f-43b0-915b-865d51fe4675",
                                                "sense_id": "11281f4b-7e08-3fc2-8ddd-0c99fa7d8ed0",
                                                "text": "[L]a cruz se sale del quadro como si fuera corpórea, tanto que llega a engañar la vista."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "254197ff-9bcc-352e-91c2-51b8857a51db",
                                        "entry_id": "e7640b7b-f882-39b4-b5cb-522b5cd65d83",
                                        "glosses": [
                                            "Faltar a la fidelidad conyugal, cometer adulterio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9035763-73ff-43a1-97cb-b758ac5810eb",
                                                "sense_id": "254197ff-9bcc-352e-91c2-51b8857a51db",
                                                "text": "En La Burguesa de Orleans, un fabliau, la mujer que trama engañar a su marido con su amante es descubierta por su criada, lo que resulta extraño puesto que ésta suele ser siempre fiel a su señora y cómplice de sus engaños."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ee4f1cd9-f4be-33fe-a842-8a1ece105b06",
                                        "entry_id": "e7640b7b-f882-39b4-b5cb-522b5cd65d83",
                                        "glosses": [
                                            "Desviar la atención para hacer una sensación más llevadera."
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8580cfd-621c-4014-80c4-3e720bcf4d08",
                                                "sense_id": "ee4f1cd9-f4be-33fe-a842-8a1ece105b06",
                                                "text": "A nosotros casi no nos daban de comer. Engañábamos el hambre con agua. Víctor tenia la cara llena de moretones y un ojo cerrado por la hinchazón."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
