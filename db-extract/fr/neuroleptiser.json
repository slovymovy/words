                    {
                        "sense_id": "fdd70274-f031-3f0d-bf9d-d8d99534dd57",
                        "entry_id": "c6115365-1459-3aca-b9d4-ad7557de17c3",
                        "glosses": [
                            "Donner des neuroleptiques à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d4d4f8-807f-438a-9575-563cfe05efc6",
                                "sense_id": "fdd70274-f031-3f0d-bf9d-d8d99534dd57",
                                "text": "Il faut : le « neuroleptiser encore plus », « le muter en UMD », « le mettre dehors », ou « l'enfermer jusqu'à ce qu'il se calme »."
                            },
                            {
                                "example_id": "ebf32b93-ee8c-4afa-90de-7aeebff1d2cc",
                                "sense_id": "fdd70274-f031-3f0d-bf9d-d8d99534dd57",
                                "text": "Il venait d'être délogé de chez lui après un fort Chabrol de plusieurs jours avec force lacrymogènes ; à tel point que sur les lieux, la gendarmerie nous le livrant, nous dûmes le le neuroleptiser avant de gagner l'hôpital en voiture toutes fenêtres ouvertes, larmoyants des seuls lacrymogènes qu'exhalaient ses vêtements, alors qu'il restait lui impassible, l'œil sec."
                            }
                        ]
                    }
