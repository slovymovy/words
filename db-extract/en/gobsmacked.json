                ],
                "senses": [
                    {
                        "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                        "entry_id": "91175dab-5d70-3cb2-819f-13ed3012bce0",
                        "glosses": [
                            "Flabbergasted, astounded, speechless, overawed."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6c6180aa-5a6c-4262-8b31-8ec87c39d678",
                                "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                                "text": "That wad mack im about yam sick, so ower Ilkla' moor bar-tat wish un best of luck at Ilkley Station, and when he landed back Martha wad be fare gob smacked at the yarns he wad tell 'er about Yorkshire clod-hoppers."
                            },
                            {
                                "example_id": "48f63849-3bcb-4f84-81ad-7e80d002fdf5",
                                "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                                "text": "We were as appalled and stunned and confused and gobsmacked (punched on the mouth) as anyone else."
                            },
                            {
                                "example_id": "c309307d-2081-4273-b5b5-669021e22b21",
                                "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                                "text": "\"I guess the word would be gobsmacked,\" Barclay said, of his reaction. \"I am stunned.\""
                            },
                            {
                                "example_id": "22d68746-40f6-4701-be06-934b2068c258",
                                "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                                "text": "Peterik told CNN that the use of the song caught him by surprise.\n“I was gobsmacked,” he said. “We were not asked about this at all. The first time we saw it was on national TV.”"
                            },
                            {
                                "example_id": "caf25221-603a-4ea5-a471-d4db70e60093",
                                "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                                "text": "Far from the stage, a woman approached them and said she could tell they were big fans, so she was upgrading them to the front row. “We were absolutely gobsmacked,” Ryan said."
                            },
                            {
                                "example_id": "a7478484-3a6f-4db1-a066-04c548730657",
                                "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                                "text": "A hospital consultant who treated Sergei and Yulia Skripal after they were poisoned with the nerve agent novichok was “gobsmacked” when Yulia woke and began trying to get out of bed four days after the attack."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81a9d56d-7470-43ee-89c0-052c9f6e8a13",
