                        "entry_id": "b6fe1bf7-c940-3562-b44e-82fe511d7198",
                        "glosses": [
                            "Unterfamilie der Schmetterlingsmücken, deren Biss Juckreiz und Hautrötungen verursachen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f10c134-493e-44c9-871e-78e5468f0340",
                                "sense_id": "965f2a44-4d25-340a-80a8-ff23617f6263",
                                "text": "„Wie um unsere Schwierigkeiten noch zu vergrößern, hatten uns den ganzen Tag Moskitos und Sandmücken gequält.“"
                            },
                            {
                                "example_id": "e278ef43-775d-4221-a145-aa5570227eab",
                                "sense_id": "965f2a44-4d25-340a-80a8-ff23617f6263",
                                "text": "„2001 wurden in Gehrweiler (Rheinland-Pfalz) vier Sandmücken der Art Phlebotomus perniciosus gefangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
