                            {
                                "example_id": "c09c2dd1-60f7-4bc2-a79d-907a7c626ba8",
                                "sense_id": "e64e572b-5c5e-37ec-a1d2-782a05c5aa9c",
                                "text": "Da ritt Odin ans östliche Tor,\nWo er der Wala wußte den Hügel.\nDas Wecklied begann er der Weisen zu singen,\n(Nach Norden schauend schlug er mit dem Stabe,\nSprach die Beschwörung Bescheid erheischend)\nBis gezwungen sie aufstand Unheil verkündend-."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
