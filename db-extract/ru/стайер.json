                                "target_senses": [
                                    {
                                        "sense_id": "ac3a0c7c-0c52-3613-a1f1-7deea786d598",
                                        "entry_id": "99a00f48-34fb-3189-8b5c-65a78a8eae10",
                                        "glosses": [
                                            "Teilnehmer eines Steherrennens (langstreckiges Bahnrennen mit Schrittmacher) im Radsport"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3145d204-d041-4be2-8c08-39f8d69eed20",
                                                "sense_id": "ac3a0c7c-0c52-3613-a1f1-7deea786d598",
                                                "text": "Da er ein Steher war, kam er mit dem Mannschaftsbewerb nicht zurecht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02ae45b0-961c-33fd-a288-f0600d1db2e6",
                                        "entry_id": "99a00f48-34fb-3189-8b5c-65a78a8eae10",
                                        "glosses": [
                                            "Rennpferd, das für Steherdistanzen (lange Distanzen) eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730947a0-9cdf-42ad-bc27-0ef5fd7aaa02",
                                                "sense_id": "02ae45b0-961c-33fd-a288-f0600d1db2e6",
                                                "text": "Wegen der enttäuschenden Sprintergebnisse entschloss man sich, das Pferd nur noch als Steher einzusetzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f1116141-2b8d-3bae-b221-2d07f5f8c7d3",
                                        "entry_id": "99a00f48-34fb-3189-8b5c-65a78a8eae10",
                                        "glosses": [
                                            "Pfosten"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "344a8b22-42e9-4932-9dac-5058ba1a2b3e",
                                                "sense_id": "f1116141-2b8d-3bae-b221-2d07f5f8c7d3",
                                                "text": "Dumpf hörte man den Vorschlaghammer über den ganzen Hof, als er die Steher setzte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6a82a445-6467-3597-b9a2-adcb7fc633f9",
                                        "entry_id": "99a00f48-34fb-3189-8b5c-65a78a8eae10",
                                        "glosses": [
                                            "ein Tatverdächtiger, der im Verhör schweigt"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c84eeaa-6eb9-4bd9-8f73-4cda798d1e64",
                                                "sense_id": "6a82a445-6467-3597-b9a2-adcb7fc633f9",
                                                "text": "Der Verdächtigte erwies sich als Steher, der außer seinem Namen nichts preis gab."
                                            }
