                ],
                "senses": [
                    {
                        "sense_id": "013a5880-23ec-3fbe-9e0d-7720fd479bcc",
                        "entry_id": "210ebf26-c897-30f4-8cf1-0cc9eed202a4",
                        "glosses": [
                            "of Bishkek, Bishkeker (of, from or pertaining to Bishkek in Kyrgyzstan)"
                        ],
                        "tags": [
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "ee60de0f-e673-43ae-987b-a6060accca59",
                                "sense_id": "013a5880-23ec-3fbe-9e0d-7720fd479bcc",
                                "text": "Porozumienie biszkeckie o zawieszeniu broni i zamrożenie konfliktu nie przyczyniło się do przywrócenia dostaw surowców energetycznych z Azerbejdżanu.",
                                "translation": "The Bishkek Ceasefire Agreement and the freezing of the conflict did not contribute to restoring energy supplies from Azerbaijan.",
                                "english": "The Bishkek Ceasefire Agreement and the freezing of the conflict did not contribute to restoring energy supplies from Azerbaijan."
                            },
                            {
                                "example_id": "22b88a7f-bbf4-4454-a37e-0ba36dadf30e",
                                "sense_id": "013a5880-23ec-3fbe-9e0d-7720fd479bcc",
                                "text": "W pierwszej kolejności zajęto niezasiedloną ziemię należącą do Uniwersytetu Biszkeckiego, z którym związana jest Bermet Akajewa, oraz ziemie rolników w okręgu Sokuluk, w którym Kułow odsiadywał wyrok.",
                                "translation": "In the first place, unsettled land belonging to the Bishkek University, with which Bermet Akayeva is associated, and land of farmers in the Sokuluk district, where Kulov was serving his sentence, were seized.",
                                "english": "In the first place, unsettled land belonging to the Bishkek University, with which Bermet Akayeva is associated, and land of farmers in the Sokuluk district, where Kulov was serving his sentence, were seized."
                            },
                            {
                                "example_id": "9fb02488-6911-4f8a-bdb5-9057e47dc221",
                                "sense_id": "013a5880-23ec-3fbe-9e0d-7720fd479bcc",
                                "text": "„Podpisano Deklarację Biszkecką, w której wskazano, iż system bezpieczeństwa może być tworzony, jedynie pod egidą ONZ i przy ścisłym przestrzeganiu jej Karty”.",
                                "translation": "\"The Bishkek Declaration was signed, in which it was indicated that a security system can only be created under the aegis of the UN and with strict observance of its Charter.\"",
                                "english": "\"The Bishkek Declaration was signed, in which it was indicated that a security system can only be created under the aegis of the UN and with strict observance of its Charter.\""
                            }
                        ]
                    }
