                "senses": [
                    {
                        "sense_id": "587affce-90d7-3950-8411-65277a02eb88",
                        "entry_id": "8e25c2f5-2ccc-3ad3-8596-678550069b38",
                        "glosses": [
                            "Donner une description succincte de l’action montrée par un film, pour aider les spectateurs aveugles à comprendre la narration."
                        ],
                        "tags": [
                            "Audiovisuel",
                            "Handicap"
                        ],
                        "examples": [
                            {
                                "example_id": "f06a6993-ebb4-486a-b5ab-67d892de118b",
                                "sense_id": "587affce-90d7-3950-8411-65277a02eb88",
                                "text": "La première association s'est attelée à audiodécrire des films."
                            },
                            {
                                "example_id": "4753e7cb-1664-4883-99e7-424ad5c5fc06",
                                "sense_id": "587affce-90d7-3950-8411-65277a02eb88",
                                "text": "Vous aurez également la possibilité de faire une demande de devis si vous souhaitez faire audiodécrire une œuvre audiovisuelle."
                            },
                            {
                                "example_id": "7ea0ca4e-618b-4a9c-a2cf-548b4ad11be5",
                                "sense_id": "587affce-90d7-3950-8411-65277a02eb88",
                                "text": "Seuls trois ou quatre films sont audiodécrits chaque année, regrette Patrick Saonit, chef de projet à l’association Valentin Haüy, à l’initiative de l’événement."
                            }
                        ]
                    }
