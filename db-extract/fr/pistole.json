                        "tags": [
                            "plural"
                        ],
                        "form": "pistoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1d107e4-1db1-3a88-9881-bdbfe45bf15c",
                        "entry_id": "f3ebe7d7-5342-34f5-832a-edd651b051f0",
                        "glosses": [
                            "Pistolet."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2de3471f-fff4-4c8f-b6e7-482efebd4eb9",
                        "source_entry_id": "f3ebe7d7-5342-34f5-832a-edd651b051f0",
                        "source_sense_id": "b1d107e4-1db1-3a88-9881-bdbfe45bf15c",
                        "target_lang_word": "Pistole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pistole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                        "entry_id": "490b67e8-19f6-3b58-b0fa-c06d0b806eac",
                                        "glosses": [
                                            "Schusswaffe mit kurzem Lauf, die aus der Hand abgeschossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa4dc54-c3ac-473b-9080-346ffbd1df75",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "Der Räuber bedrohte die Kassiererin mit einer Pistole."
                                            },
                                            {
                                                "example_id": "1278a15e-9e21-4b02-979c-538853190254",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "In der Kiste mit den Pistolen liegen auch die Magazine."
                                            },
                                            {
                                                "example_id": "be76cceb-230c-40d9-afe1-7b7a33164d80",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Arschloch, dachte ich, beeil du dich nur, daß du an deinen Feind kommst! Hoffentlich kriegst du eine vor den Latz geknallt, du mit deinen sechs Schuß in der Pistole!“"
                                            },
                                            {
                                                "example_id": "36b855de-7b85-4832-b787-14b09460919e",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Ohne länger zu zögern, zog ich meine Pistole und öffnete die Tür.“"
                                            },
                                            {
                                                "example_id": "ac18d01f-5ff8-4175-a806-bb7fe6225660",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Wahrscheinlich ist es also ein Hirt, wozu sein zerlumpter Burnus schon passen könnte; aber er hat einen kostbaren Gürtel um und Dolch und Pistole an der Seite.“"
                                            },
                                            {
                                                "example_id": "f158990b-1459-48e2-91aa-d04c50bb592d",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Sie sicherte die Pistole und schob sie in die Tasche zurück.“"
                                            },
                                            {
                                                "example_id": "31c7c2cb-d983-425d-aa26-33e0d45c9732",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Als er zwei Mal mit seiner Pistole betrunken herumgeballert hatte, drohte seine Frau, ihn auf der Stelle zu verlassen.“"
                                            },
                                            {
                                                "example_id": "065b6ae5-41a0-4ceb-b4ab-18cd28b8e548",
                                                "sense_id": "d3971ff5-e7cd-36dc-b9a1-debb043eee84",
                                                "text": "„Er nahm die Pistole aus dem Halfter und schoss dem Ulanen ein Loch in den Kopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4188e223-e5a3-309d-a60e-759755c3e85f",
                                        "entry_id": "490b67e8-19f6-3b58-b0fa-c06d0b806eac",
                                        "glosses": [
                                            "männliches Geschlechtsteil"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pistole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                        "entry_id": "6b38106b-e530-3db1-9be1-dfa9d4dce389",
                                        "glosses": [
                                            "ursprünglich spanische Münze aus amerikanischem Gold, später auch in anderen europäischen Ländern mit unterschiedlicher Prägung, Währung und Wert"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a068abca-7e8e-4034-97d5-7919f00776cc",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Ich wußte wohl, daß Ihr das Pferd kaufen würdet, Herr Marx, denn Ihr ſucht für den Rittmeiſter in Unna eins zu dreißig Piſtolen, und mein Bräunchen paßt Euch dazu, wie beſtellt.“"
                                            },
                                            {
                                                "example_id": "c56aee6a-5fa2-4378-8932-cb4381136b93",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Es wurde ein recht dicker Quarto-Band, für den fehlende algebraïsche Zeichen gegossen und sogar neue Patrizen geschnitten werden mußten, so daß die Ausgabe, die in tausend Exemplaren gedruckt werden sollte, Hervás auf siebenhundert Pistolen zu stehen kam.“"
                                            },
                                            {
                                                "example_id": "e2275eb3-6b19-46e0-9c96-03c07adcf0c4",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Das Pferd, ein Apfelschimmel, kostete vierzig piemontesische Pistolen; das entsprach ungefähr hundert Zechinen.“"
                                            },
                                            {
                                                "example_id": "e7d2695b-6512-4f65-929e-d97dfe0a952e",
                                                "sense_id": "ba43d60f-a695-3e1c-a1bc-d65ada422402",
                                                "text": "„Sie stammte aus Quistreham, hatte keine Verwandten, verdiente eine Pistole im Monat – kurzum, sie gefiel ihm so, daß er sie in seinen Dienst zu nehmen wünschte, damit sie der alten Germaine zur Hand ginge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "4968b84f-3178-35f1-96fd-86c74ad1cd24",
                "word": "pistole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2b10333d-943b-401e-8101-f25e6d30e3f8",
                        "entry_id": "4968b84f-3178-35f1-96fd-86c74ad1cd24",
                        "tags": [
                            "plural"
                        ],
                        "form": "pistoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61f7298d-375e-37df-a555-735caae4c856",
                        "entry_id": "4968b84f-3178-35f1-96fd-86c74ad1cd24",
                        "glosses": [
                            "Monnaie d’or espagnole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c67172-0065-45c3-9aad-3eb81c372ab5",
                                "sense_id": "61f7298d-375e-37df-a555-735caae4c856",
                                "text": "Comme je n'ignorais pas qu'il devait nous rester à peine douze ou quinze pistoles, je lui marquai mon étonnement de cette augmentation apparent de notre opulence."
                            },
                            {
                                "example_id": "d8238b20-90e6-4f5c-bfaf-6b2f7c99bc57",
                                "sense_id": "61f7298d-375e-37df-a555-735caae4c856",
                                "text": "Pistole d’or. — Demi-pistole."
                            }
                        ]
                    },
                    {
                        "sense_id": "0546fd45-b329-3d93-afbe-b9a524661ab2",
                        "entry_id": "4968b84f-3178-35f1-96fd-86c74ad1cd24",
                        "glosses": [
                            "Ancienne monnaie de compte populaire, valant dix francs."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "00c56858-19e9-47bf-b13e-e8c38acc1067",
                                "sense_id": "0546fd45-b329-3d93-afbe-b9a524661ab2",
                                "text": "— Il avait justement mon affaire, une vache douce, donnant beaucoup de lait, un lait qui était une crème, et ne mangeant presque pas ; si je voulais lui allonger quinze pistoles sur la table, autrement dit cinquante écus, la vache était à moi.\nAutant j’avais eu de mal à le faire parler tout d’abord, autant j’eus de mal à le faire taire quand il fut en train.\nEnfin nous pûmes aller nous coucher et je rêvai à ce que cette conversation venait de m’apprendre.\nQuinze pistoles ou cinquante écus, cela faisait cent cinquante francs ; et j’étais loin d’avoir une si grosse somme."
                            },
                            {
                                "example_id": "dde4ca00-97b2-41ca-911a-557b4f2062af",
                                "sense_id": "0546fd45-b329-3d93-afbe-b9a524661ab2",
                                "text": "A la foire, les Quarréens calculent encore par pistole (monnaie de compte de dix fr.) et par louis de vingt-quatre francs. L’écu de six francs et le demi-écu ont disparu : ils appartenaient au système duodécimal ; le louis de 24, du même système, devrait disparaître aussi."
                            },
                            {
                                "example_id": "dcc0ba7d-e0a0-497a-812a-e2ab5b710198",
                                "sense_id": "0546fd45-b329-3d93-afbe-b9a524661ab2",
                                "text": "Car cette chose-là coûte huit bonnes pistoles, voyez-vous, et c’est quasiment une année de ma peine."
                            },
                            {
                                "example_id": "ed6dd3f2-ce33-4e31-bbec-757501b48379",
                                "sense_id": "0546fd45-b329-3d93-afbe-b9a524661ab2",
                                "text": "Les propos légers que grand-père me tenait à table n'étaient que la petite mouture d'une pensée toujours occupée, en profondeur, de sacs de froment, de paires de bœufs, de moutons et de porcs exprimés sous les espèces mentalement maniables de kilos, quintaux et pistoles."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ae862a7-fe1d-3552-a1cf-3e571e2d97b8",
                        "entry_id": "4968b84f-3178-35f1-96fd-86c74ad1cd24",
                        "glosses": [
                            "Argent ; monnaie."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "51f984f0-3fab-4bce-99be-d95c921b6e69",
                                "sense_id": "3ae862a7-fe1d-3552-a1cf-3e571e2d97b8",
                                "text": "Le maquignon de bas étage […] tripote, drogue, maquille, défigure un cheval sur lequel il veut gagner quelques pistoles."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7bd91e2-8475-3e15-b945-779752ce70f9",
                        "entry_id": "4968b84f-3178-35f1-96fd-86c74ad1cd24",
                        "glosses": [
                            "Sorte de pruneau sans noyau, aplati, rond et d’un jaune doré."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d7956479-d8e0-3e4b-92b0-aa96187fdd1a",
                        "entry_id": "4968b84f-3178-35f1-96fd-86c74ad1cd24",
                        "glosses": [
                            "Il se disait, dans les prisons, de diverses commodités de logement et de nourriture que les prisonniers obtenaient en payant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b6b4b8d-1a18-4c03-ba78-5a2ff668a351",
                                "sense_id": "d7956479-d8e0-3e4b-92b0-aa96187fdd1a",
                                "text": "Ce détenu a été mis à la pistole."
                            }
                        ]
                    }
