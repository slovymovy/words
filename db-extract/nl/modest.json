                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a658a03-14b1-3190-9f48-5a2acedd9eb2",
                                        "entry_id": "d444be39-b0c2-351d-a035-24183c9739dd",
