                "senses": [
                    {
                        "sense_id": "7be6d578-686b-3394-a972-868b83589e30",
                        "entry_id": "1a37bdb3-e3e6-3b19-9c74-164b317d41aa",
                        "glosses": [
                            "von Erfolgen und Misserfolgen geprägte Karriere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ebf0b2b-a003-466e-a4ac-3851b15e3dc5",
                                "sense_id": "7be6d578-686b-3394-a972-868b83589e30",
                                "text": "„Kann die Frau mit der Achterbahnkarriere es nach ganz oben schaffen?“"
                            },
                            {
                                "example_id": "2827c321-dff7-470a-9ebb-611d6a9e9e6f",
                                "sense_id": "7be6d578-686b-3394-a972-868b83589e30",
                                "text": "„Kaum ein anderer Trainer hat eine solche Achterbahnkarriere hinter sich wie Sie: Ihre Mannschaften scheinen immer entweder einen ‚Lauf‘ oder eine ‚Krise‘ zu haben – wie schmal ist der Grat dazwischen?“"
                            },
                            {
                                "example_id": "7d971fe7-2e19-4f1f-83f3-1cf2059573e8",
                                "sense_id": "7be6d578-686b-3394-a972-868b83589e30",
                                "text": "„Immerhin konnte Schrader so tags darauf mit klarem Kopf und feinem Humor über den größten Erfolg seiner Achterbahnkarriere als Zehnkämpfer erzählen – die Silbermedaille bei den Weltmeisterschaften in Moskau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
