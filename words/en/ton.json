                            {
                                "target_lang_word": "许多",
                                "target_lang_sense_clarification": "指数量很多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9f68920-95b4-3977-80bf-cfb4eb66024c",
                    "sense_definition": "A unit of weight equal to 2,000 pounds in the US or 2,240 pounds in the UK; also used informally for a metric ton (1,000 kilograms).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
