                    ]
                },
                {
                    "sense_id": "ee37a5c6-094e-35f6-8d54-58f9d4fcb98e",
                    "sense_definition": "aus Angst oder Unsicherheit vor einer Aufgabe zurückweichen und einen Rückzieher machen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feigheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor der wichtigen Prüfung darfst du jetzt auf keinen Fall einfach <w>kneifen</w>."
                        },
                        {
                            "text": "Alle wollten vom Sprungturm springen, aber Markus <w>kniff</w> im letzten Moment."
