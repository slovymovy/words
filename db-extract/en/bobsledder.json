                                        "sense_id": "a5cbdbd7-c9e3-3c6c-bc5e-5a7cc7a72d91",
                                        "entry_id": "a5134f1e-3cff-3100-b7d9-98c3814f9a47",
                                        "glosses": [
                                            "sporter die met een bobslee een ijsbaan afglijdt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f343696b-07b8-4783-b17a-4ec3c3598937",
                                                "sense_id": "a5cbdbd7-c9e3-3c6c-bc5e-5a7cc7a72d91",
                                                "text": "Edwin van Calker gaat definitief als coach van de Chinese bobsleeërs naar de OIympische Spelen in Zuid-Korea."
                                            },
                                            {
                                                "example_id": "68100f9f-f247-4bd4-8a4f-66257d890282",
                                                "sense_id": "a5cbdbd7-c9e3-3c6c-bc5e-5a7cc7a72d91",
                                                "text": "Een groot deel van de 42 Russen die naar het CAS zijn gestapt veroverde een olympische medaille in Sotsji. Bobsleeër Aleksandr Zoebkov bijvoorbeeld pakte twee keer goud. Ook skeletonner Aleksander Tretiakov won goud, evenals langlaufer Aleksander Legkov. Schaatsster Olga Fatkoelina behaalde zilver op de 500 meter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04cd6623-b3d2-4165-8911-74816cb5e21d",
                        "source_entry_id": "5335ffd1-5344-33db-a7d1-39da0d83806b",
                        "source_sense_id": "d1ddad0d-8aba-3ea9-bf90-06396f3f6a44",
