                "senses": [
                    {
                        "sense_id": "fa69e18b-9468-308d-afb5-2c858f154404",
                        "entry_id": "1e97022b-9dc6-39e2-b9e5-07cf0209dc2a",
                        "glosses": [
                            "Haus, das vollständig aus Beton gebaut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8afbb95-ac2c-4680-ad17-bfaf7705d3f9",
                                "sense_id": "fa69e18b-9468-308d-afb5-2c858f154404",
                                "text": "„Das Ehepaar vid Berbisá und sein debiler Sohn wohnten in einem dreistöckigen Betonhaus in Kolbeinagjógv.“"
                            },
                            {
                                "example_id": "b989d4c9-388a-475d-a9ff-ded45c1b08b9",
                                "sense_id": "fa69e18b-9468-308d-afb5-2c858f154404",
                                "text": "„Am Ende einer dunklen Gasse angekommen, hielt Hamid vor einem niedrigen Betonhaus, wo wir von einer etwas kleineren Ausgabe von Hamid – seinem Bruder Faisal – begrüßt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
