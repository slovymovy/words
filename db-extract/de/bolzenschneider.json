                    }
                ],
                "senses": [
                    {
                        "sense_id": "add23d34-2463-3ae9-a7ed-c3a53a53a8e2",
                        "entry_id": "05b9c50e-0b95-3eda-9e25-bcc372260801",
                        "glosses": [
                            "Zange zum Trennen und Zerteilen von Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c66967-b54f-4c98-934e-c02a62dda11c",
                                "sense_id": "add23d34-2463-3ae9-a7ed-c3a53a53a8e2",
                                "text": "„Atticus nahm sich Dells Schlüsselbund und fand auch einen Bolzenschneider.“"
                            },
                            {
                                "example_id": "05345638-71f0-4252-8c67-704a39d90763",
                                "sense_id": "add23d34-2463-3ae9-a7ed-c3a53a53a8e2",
                                "text": "„Mit Nachtsichtgeräten konnten die drei sich ihren Weg vom Pier zum Zaun bahnen, um ihn knapp über der Wasseroberfläche mit Bolzenschneidern durchzutrennen.“"
                            },
                            {
                                "example_id": "3bccff3f-72bd-4caa-a301-cc96faa15114",
                                "sense_id": "add23d34-2463-3ae9-a7ed-c3a53a53a8e2",
                                "text": "„Ramses stieg vom Bike und trennte das Kettenschloss mit einem Bolzenschneider durch, den er in einer Werkzeugkiste auf der Ladefläche von Eddies Truck gefunden hatte.“"
                            },
                            {
                                "example_id": "373894d1-630c-448d-8190-9e74ff3d674c",
                                "sense_id": "add23d34-2463-3ae9-a7ed-c3a53a53a8e2",
                                "text": "„Doo-Rag funkelte ihn noch einmal an, ging dann aber gehorsam zur Rückseite des Wagens, knackte das Vorhängeschloss mit einem Bolzenschneider und kletterte auf die Ladefläche.“"
                            },
                            {
                                "example_id": "c9eb2d5f-735c-4d08-af1e-9201a9408913",
                                "sense_id": "add23d34-2463-3ae9-a7ed-c3a53a53a8e2",
                                "text": "„Auf dem Boden liegt zwar ein Bolzenschneider, doch ist er nicht stark genug, um die Kette oder das Schloss zu knacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
