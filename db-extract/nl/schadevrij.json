                "senses": [
                    {
                        "sense_id": "345a2565-8154-324a-a5a8-84e651e43bdb",
                        "entry_id": "8de86624-8485-3dab-a6b2-7addf8fe4cb4",
                        "glosses": [
                            "zonder het oplopen van een beschadiging, zonder ongelukken te krijgen of te veroorzaken, zonder dat men een schadeclaim heeft hoeven in te dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "527200f0-b1dd-4ea0-bc17-35871ae689ff",
                                "sense_id": "345a2565-8154-324a-a5a8-84e651e43bdb",
                                "text": "Vanaf 1 januari kunnen opgebouwde schadevrije jaren na overlijden worden overgedragen aan de partner die achterblijft. Dat maken het Verbond van Verzekeraars en de Consumentenbond bekend. Ook na een echtscheiding wordt het mogelijk de schadevrije jaren te verdelen met de ex-partner."
                            },
                            {
                                "example_id": "c898184b-5f74-4051-898e-097a3866c9e0",
                                "sense_id": "345a2565-8154-324a-a5a8-84e651e43bdb",
                                "text": "Getrouwde mannen veroorzaken ook minder ongelukken dan ongetrouwde mannen - vooral als ze ook al voor hun huwelijk schadevrij hebben gereden."
                            }
                        ]
                    },
                    {
                        "sense_id": "a20fee71-c953-34fb-8d1b-803274523d8b",
                        "entry_id": "8de86624-8485-3dab-a6b2-7addf8fe4cb4",
                        "glosses": [
                            "zonder een tegendoelpunt te hoeven incasseren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "792b3206-6aa9-4e3c-9611-a4b661de5739",
                                "sense_id": "a20fee71-c953-34fb-8d1b-803274523d8b",
                                "text": "Het tij dreigde te keren toen Alves halverwege het tweede bedrijf zijn noppen in de kuit van Carrasco plantte en hij met een rode kaart voortijdig richting kleedkamers moest. Barcelona kwam het resterende halfuurtje echter schadevrij door en boekte een verdiende zege."
                            },
                            {
                                "example_id": "987e757e-7fbe-4af4-bba0-8d72257c2c37",
                                "sense_id": "a20fee71-c953-34fb-8d1b-803274523d8b",
                                "text": "NEC startte met Marcel Ritzmaier rechts op het middenveld. Daarmee koos Faber voor het 4-4-2-systeem. Dat concept volstond voor een schadevrije eerste helft, al ontsnapte de Nijmeegse formatie wel 3 keer. In 2 instanties caramboleerde de bal op de lat, daarnaast redde doelman Brad Jones uitstekend op een inzet van Bilal Basacikoglu."
                            }
                        ]
                    }
