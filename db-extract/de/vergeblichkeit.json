                "senses": [
                    {
                        "sense_id": "2687903a-533d-3b10-b367-d54f94ddad1e",
                        "entry_id": "7d5f1c6f-cf3e-3b8c-84f1-a30f3f5b0f7f",
                        "glosses": [
                            "Zustand, vergeblich/nicht realisierbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4017507-b308-4e8f-9365-aee2e0706875",
                                "sense_id": "2687903a-533d-3b10-b367-d54f94ddad1e",
                                "text": "„Von einem plötzlichen Gefühl der Vergeblichkeit überwältigt, gab sie es auf, ihm andere Lösungen zu empfehlen.“"
                            },
                            {
                                "example_id": "4ed2eb28-9873-4b3e-946e-9980673705ff",
                                "sense_id": "2687903a-533d-3b10-b367-d54f94ddad1e",
                                "text": "„Und einmal im Jahr zu Ostern pilgern wir zu Müllers Ruh, einem Mahnmal der Vergeblichkeit des menschlichen Tuns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
