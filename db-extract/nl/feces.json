                                                "sense_id": "ed2f04fe-d032-39ef-9293-c2b0c32379a8",
                                                "text": "Er klagt über einen schweren Stuhl."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d24897fd-0478-327e-b1de-73ee4500b285",
                                        "entry_id": "4382472a-2f8a-375f-99d0-16fe26cbfd63",
