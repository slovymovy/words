                ],
                "senses": [
                    {
                        "sense_id": "ba7f8364-9cce-3bd2-9a98-3b0853908813",
                        "entry_id": "27ee8340-a2ea-31b0-a332-5e1f7a398b3f",
                        "glosses": [
                            "Qualité de ce qui est digestible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0fdf9c3-11d1-4d36-a58e-4242c4c70118",
                                "sense_id": "ba7f8364-9cce-3bd2-9a98-3b0853908813",
                                "text": "Il est des substances réputées d’une grande digestibilité, qui sont rejetées par le vomissement et occasionnent des troubles gastriques très sérieux."
                            },
                            {
                                "example_id": "0c9548c0-33c8-4a5b-b516-b7bd0d2fcdb0",
                                "sense_id": "ba7f8364-9cce-3bd2-9a98-3b0853908813",
                                "text": "Il est difficile d'augmenter la teneur en énergie des graines protéagineuses qui se distinguent des graines oléoprotéagineuses par leur faible teneur en lipides. Seules, des améliorations portant sur la digestibilité paraissent possibles."
                            },
                            {
                                "example_id": "6ab93345-e46d-452b-a704-09403b3f769c",
                                "sense_id": "ba7f8364-9cce-3bd2-9a98-3b0853908813",
                                "text": "La digestibilité apparente d’un aliment est la proportion de sa matière organique qui disparait dans le tube digestif."
                            }
                        ]
                    }
                ],
