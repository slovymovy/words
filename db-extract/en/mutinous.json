                "senses": [
                    {
                        "sense_id": "31e22bc5-d02b-39e3-a23b-a6dac2fdd1e5",
                        "entry_id": "4dffacc6-8b1a-3eab-a842-633bf728c30b",
                        "glosses": [
                            "Likely to commit mutiny."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85314984-8112-4276-9714-0f389c5153a5",
                                "sense_id": "31e22bc5-d02b-39e3-a23b-a6dac2fdd1e5",
                                "text": "[A]nd it is without all controuerſie, that learning doth make the minds of men gentle, generous, maniable, and pliant to gouernment; whereas Ignorance makes them churliſh, thwart, and mutinous; […]"
                            },
                            {
                                "example_id": "05d07ce8-3f46-4083-a32e-679a71c7f578",
                                "sense_id": "31e22bc5-d02b-39e3-a23b-a6dac2fdd1e5",
                                "text": "“My men grow mutinous day by day;\nMy men grow ghastly wan and weak.”\nThe stout mate thought of home; a spray\nOf salt wave washed his swarthy cheek."
                            }
                        ]
                    },
                    {
                        "sense_id": "54129d4a-32a8-3515-bd86-4799d8006ec9",
                        "entry_id": "4dffacc6-8b1a-3eab-a842-633bf728c30b",
                        "glosses": [
                            "Of, pertaining to, or constituting mutiny."
