{
    "word_family": [
        "cluster",
        "clustered",
        "clusterer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8dc2e4c-2ae2-3c96-92e5-34249e967012",
                    "sense_definition": "A grouping of a number of similar things or items together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The map displays a distinct <w>clustering</w> of cases around the city centre.",
                            "target_lang_translations": {
                                "ru": "На карте видно явное <w>скопление</w> случаев вокруг центра города."
                            }
                        },
                        {
                            "text": "Astronomers observed an unusual <w>clustering</w> of galaxies in that region.",
                            "target_lang_translations": {
                                "ru": "Астрономы зафиксировали необычную <w>концентрацию</w> галактик в этой области."
                            }
                        }
                    ],
                    "synonyms": [
                        "cluster",
                        "grouping",
                        "aggregation",
                        "cluster"
                    ],
                    "antonyms": [
                        "dispersion",
                        "scattering"
                    ],
                    "common_phrases": [
                        "data clustering",
                        "spatial clustering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скопление или объединение сходных объектов либо элементов в одну группу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кластеризация",
                                "target_lang_sense_clarification": "процесс или результат группировки"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "группа объектов, сосредоточенных в одном месте"
                            },
                            {
                                "target_lang_word": "группирование",
                                "target_lang_sense_clarification": "объединение в группы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42b81920-1d24-372c-8c3b-b0160a34c075",
                    "sense_definition": "The demographic concentration or grouping of a population based on factors such as ethnicity, wealth, or religion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sociologists study the ethnic <w>clustering</w> found in urban neighbourhoods.",
                            "target_lang_translations": {
                                "ru": "Социологи изучают этническое <w>обособление</w>, встречающееся в городских кварталах."
                            }
                        },
                        {
                            "text": "Economic factors often lead to the <w>clustering</w> of low-income families in specific suburbs.",
                            "target_lang_translations": {
                                "ru": "Экономические факторы часто приводят к <w>концентрации</w> малоимущих семей в определенных пригородах."
                            }
                        }
                    ],
                    "synonyms": [
                        "segregation",
                        "concentration"
                    ],
                    "antonyms": [
                        "integration"
                    ],
                    "common_phrases": [
                        "ethnic clustering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демографическая концентрация или расселение населения по этническому, социальному или религиозному признаку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "концентрация",
                                "target_lang_sense_clarification": "сосредоточение населения в одном районе"
                            },
                            {
                                "target_lang_word": "обособленное расселение",
                                "target_lang_sense_clarification": "компактное проживание группы населения"
                            },
                            {
                                "target_lang_word": "сегрегация",
                                "target_lang_sense_clarification": "демографическое разделение или обособление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "047b4ebc-dc55-3cd9-ad64-b9f38e314ccd",
                    "sense_definition": "A prewriting technique where ideas are written radially around a central concept in a circle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mind_mapping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher recommended <w>clustering</w> as an effective way to outline essay topics.",
                            "target_lang_translations": {
                                "ru": "Учитель порекомендовал <w>составление кластеров</w> как эффективный способ составить план эссе."
                            }
                        },
                        {
                            "text": "Before starting her first draft, she used <w>clustering</w> to organize her thoughts.",
                            "target_lang_translations": {
                                "ru": "Перед тем как приступить к первому черновику, она использовала <w>кластеризацию</w>, чтобы упорядочить мысли."
                            }
                        }
                    ],
                    "synonyms": [
                        "mind mapping",
                        "brainstorming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод мозгового штурма или подготовки к письму, при котором идеи записываются лучами вокруг центрального понятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кластеризация",
                                "target_lang_sense_clarification": "метод составления кластеров идей"
                            },
                            {
                                "target_lang_word": "составление кластеров",
                                "target_lang_sense_clarification": "техника ассоциативного связывания мыслей"
                            },
                            {
                                "target_lang_word": "майндмэппинг",
                                "target_lang_sense_clarification": "составление ментальных карт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e92af34b-6be5-33fb-a857-7b0e7e9c4c0c",
                    "sense_definition": "The undesirable contiguous grouping of occupied slots or elements in a hash table.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using quadratic probing helps to reduce primary <w>clustering</w> in the hash table.",
                            "target_lang_translations": {
                                "ru": "Использование квадратичного пробирования помогает уменьшить первичную <w>кластеризацию</w> в хеш-таблице."
                            }
                        },
                        {
                            "text": "Severe <w>clustering</w> significantly degrades lookup performance in open-address hash maps.",
                            "target_lang_translations": {
                                "ru": "Сильная <w>кластеризация</w> значительно снижает скорость поиска в хеш-таблицах с открытой адресацией."
                            }
                        }
                    ],
                    "common_phrases": [
                        "primary clustering",
                        "secondary clustering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нежелательное скопление занятых ячеек или элементов рядом друг с другом в хеш-таблице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кластеризация",
                                "target_lang_sense_clarification": "скопление коллизий в хеш-таблице"
                            },
                            {
                                "target_lang_word": "кластеринг",
                                "target_lang_sense_clarification": "термин в программировании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d955dcb6-4a53-3cb9-8aec-6efddfd7f9f3",
                    "sense_definition": "present participle and gerund of <w>cluster</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "cluster_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "People were <w>clustering</w> around the bulletin board to read the exam results.",
                            "target_lang_translations": {
                                "ru": "Люди <w>толпились</w> вокруг доски объявлений, чтобы прочитать результаты экзамена."
                            }
                        },
                        {
                            "text": "The sheep kept <w>clustering</w> together for warmth against the winter wind.",
                            "target_lang_translations": {
                                "ru": "Овцы продолжали <w>сбиваться в кучу</w>, спасаясь от зимнего ветра."
                            }
                        }
                    ],
                    "synonyms": [
                        "gathering",
                        "huddling",
                        "bunching"
                    ],
                    "antonyms": [
                        "dispersing",
                        "scattering"
                    ],
                    "common_phrases": [
                        "clustering around",
                        "clustering together"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по глаголу cluster: собираться толпой, кучковаться, скапливаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толпиться",
                                "target_lang_sense_clarification": "собираться тесной группой"
                            },
                            {
                                "target_lang_word": "кучковаться",
                                "target_lang_sense_clarification": "сбиваться в кучу"
                            },
                            {
                                "target_lang_word": "скапливаться",
                                "target_lang_sense_clarification": "собираться в одном месте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c1fd88e-f4e3-30bd-9e24-9ec86379ed51",
                    "sense_definition": "Growing or gathering in a cluster.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked under the <w>clustering</w> vines that hung over the garden wall.",
                            "target_lang_translations": {
                                "ru": "Она шла под <w>густо сплетенными</w> виноградными лозами, свисавшими с садовой ограды."
                            }
                        },
                        {
                            "text": "The botanist carefully studied the <w>clustering</w> blossoms on each branch.",
                            "target_lang_translations": {
                                "ru": "Ботаник внимательно изучил <w>растущие гроздьями</w> соцветия на каждой ветке."
                            }
                        }
                    ],
                    "synonyms": [
                        "bunched",
                        "crowded"
                    ],
                    "antonyms": [
                        "isolated",
                        "scattered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растущий или собирающийся гроздьями, пучками либо скоплениями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растущий гроздьями",
                                "target_lang_sense_clarification": "о цветах или плодах"
                            },
                            {
                                "target_lang_word": "скученный",
                                "target_lang_sense_clarification": "собранный в пучки или группы"
                            },
                            {
                                "target_lang_word": "вьющийся гроздьями",
                                "target_lang_sense_clarification": "о растениях и лозах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
