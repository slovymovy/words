            {
                "entry_id": "f34cc2ad-d28a-3e95-8745-7b9008160b4b",
                "word": "hagiographe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b3892741-3472-4143-bb34-2cb57a831742",
                        "entry_id": "f34cc2ad-d28a-3e95-8745-7b9008160b4b",
                        "tags": [
                            "plural"
                        ],
                        "form": "hagiographes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae38c083-88ff-30b3-b703-734afc8383a6",
                        "entry_id": "f34cc2ad-d28a-3e95-8745-7b9008160b4b",
                        "glosses": [
                            "Auteur qui écrit sur la vie et les actions des saints."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6149747b-65dd-47e8-bc2c-5e89c494ec65",
                                "sense_id": "ae38c083-88ff-30b3-b703-734afc8383a6",
                                "text": "Ce fait est tiré de la vie de saint Mervé, personnage resté longtemps énigmatique, que dom Lobineau classe parmi les « saints inconnus » et que la plupart des hagiographes passent sous silence."
                            },
                            {
                                "example_id": "013cb63f-430e-4cb4-9f90-30049e278f0b",
                                "sense_id": "ae38c083-88ff-30b3-b703-734afc8383a6",
                                "text": "Les Bollandistes sont des hagiographes célèbres."
                            }
                        ]
                    },
                    {
                        "sense_id": "1975997f-5d20-3923-9b7f-60ef6a264022",
                        "entry_id": "f34cc2ad-d28a-3e95-8745-7b9008160b4b",
                        "glosses": [
                            "Auteur qui fait l’hagiographie d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3062db6-752c-4ac2-b840-0e585b46127c",
                                "sense_id": "1975997f-5d20-3923-9b7f-60ef6a264022",
                                "text": "Dans le même sens un des hagiographes du grand romancier [Proust] veut qu'il ait peint l'amour, la jalousie, hors de toute vue abstraite, mais selon la méthode spinoziste."
                            },
                            {
                                "example_id": "1e957ed1-2971-40a7-bb9e-8b0c01188e50",
                                "sense_id": "1975997f-5d20-3923-9b7f-60ef6a264022",
                                "text": "– Alors vous pouvez garder vos reproches pour vos hagiographes quand ils écriront vos biographies posthumes…"
                            }
                        ]
                    }
                ],
