{
    "word_family": [
        "wed",
        "wedlock",
        "rewed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "137c170c-0b43-3cdf-807b-fc02f9d0f601",
                    "sense_definition": "A marriage ceremony; a ritual officially celebrating the beginning of a marriage.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "marriage ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are planning a small <w>wedding</w> with only their closest friends and family.",
                            "target_lang_translations": {
                                "ru": "Они планируют скромную <w>свадьбу</w> только для самых близких друзей и семьи."
                            }
                        },
                        {
                            "text": "The <w>wedding</w> ceremony was held in a beautiful garden during the sunset.",
                            "target_lang_translations": {
                                "ru": "Церемония <w>бракосочетания</w> прошла в прекрасном саду во время заката."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuptials"
                    ],
                    "common_phrases": [
                        "wedding ceremony",
                        "wedding dress",
                        "wedding ring",
                        "wedding guest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Церемония бракосочетания; ритуал, официально отмечающий начало брака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свадьба",
                                "target_lang_sense_clarification": "торжество и обряд"
                            },
                            {
                                "target_lang_word": "бракосочетание",
                                "target_lang_sense_clarification": "официальная церемония"
                            },
                            {
                                "target_lang_word": "венчание",
                                "target_lang_sense_clarification": "церковный обряд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9355cc5-3c27-3370-8bb1-92240b33d88c",
                    "sense_definition": "The joining or blending of two or more different parts, ideas, or organizations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "joining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wedding</w> of tradition and modern technology created a unique product.",
                            "target_lang_translations": {
                                "ru": "<w>Сочетание</w> традиций и современных технологий позволило создать уникальный продукт."
                            }
                        },
                        {
                            "text": "The <w>wedding</w> of the two companies took place after months of negotiations.",
                            "target_lang_translations": {
                                "ru": "<w>Слияние</w> двух компаний произошло после многомесячных переговоров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wedding of tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединение или смешение двух или более различных частей, идей или организаций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "гармоничное соединение"
                            },
                            {
                                "target_lang_word": "слияние",
                                "target_lang_sense_clarification": "объединение структур или идей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3c6b94c-f893-3934-8c0e-be683a7b5724",
                    "sense_definition": "Present participle and gerund of <w>wed</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>wedding</w> his long-time partner in a private ceremony tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра на закрытой церемонии он <w>сочетается браком</w> со своей давней партнершей."
                            }
                        },
                        {
                            "text": "The act of <w>wedding</w> two souls is considered sacred in many cultures.",
                            "target_lang_translations": {
                                "ru": "Акт <w>единения</w> двух душ считается священным во многих культурах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола wed (венчать, сочетать браком)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "венчающий",
                                "target_lang_sense_clarification": "совершающий обряд"
                            },
                            {
                                "target_lang_word": "сочетание браком",
                                "target_lang_sense_clarification": "процесс заключения брака"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b81b00-6f39-35ec-b5e6-25b48f3bc161",
                    "sense_definition": "To participate in or attend a wedding; to get married.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt completely <w>weddinged</w> out after attending four ceremonies in one month.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя совершенно <w>измотанной свадьбами</w> после посещения четырех церемоний за один месяц."
                            }
                        },
                        {
                            "text": "They decided to go <w>weddinging</w> in a small chapel in the mountains.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>обвенчаться</w> в маленькой часовне в горах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weddinged out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the sense of being exhausted by weddings"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в свадьбах или посещать их; жениться (часто иронично о чрезмерном количестве свадеб)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить по свадьбам",
                                "target_lang_sense_clarification": "посещать церемонии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "975fc389-1c95-3470-a0b3-a691acacdf87",
                    "sense_definition": "A district of the Mitte borough in Berlin, Germany.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Berlin districts",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He moved to <w>Wedding</w> because the rent was more affordable than in Kreuzberg.",
                            "target_lang_translations": {
                                "ru": "Он переехал в <w>Веддинг</w>, потому что аренда там была доступнее, чем в Кройцберге."
                            }
                        },
                        {
                            "text": "The U-Bahn line 6 runs directly through the heart of <w>Wedding</w>.",
                            "target_lang_translations": {
                                "ru": "Линия метро U6 проходит прямо через центр <w>Веддинга</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Район округа Митте в Берлине, Германия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Веддинг",
                                "target_lang_sense_clarification": "название района"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf4da799-7438-3a55-85ca-b1f95c19b480",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The professor, Dr. <w>Wedding</w>, published several papers on clinical psychology.",
                            "target_lang_translations": {
                                "ru": "Профессор, доктор <w>Уэддинг</w>, опубликовал несколько работ по клинической психологии."
                            }
                        },
                        {
                            "text": "We are looking for a person named James <w>Wedding</w> in the records.",
                            "target_lang_translations": {
                                "ru": "Мы ищем в записях человека по имени Джеймс <w>Уэддинг</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уэддинг",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}