                ],
                "senses": [
                    {
                        "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                        "entry_id": "5ae65c99-f4fa-3ecb-92bc-597dc7ab43bc",
                        "glosses": [
                            "krankhaftes Verlangen zum (regelmäßigen) Konsum von Kokain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df74c06e-5fb7-42d0-93fa-6bd16e88d9ee",
                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                "text": "„Einer Kokainsucht gehen meist Erfahrungen mit legalen und schwächeren Drogen wie Alkohol, Nikotin und Marihuana voraus.“"
                            },
                            {
                                "example_id": "12d3c7d7-0893-4fa2-aafd-128ccbb1013e",
                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                "text": "„Eine Reihe medizinischer Experten sagt, dass die Nahrungssucht genauso schwerwiegend ist wie die Nikotin- oder Kokainsucht – und möglicherweise genauso tödlich sein kann.“"
                            },
                            {
                                "example_id": "e4fde5d6-28ce-4851-906e-96640cf750da",
                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                "text": "„Die Anwendung des Kokains als Linderungsmittel bei der Morphiumentziehung hat eine der Morphiumsucht ganz entsprechende, aber noch verderblichere Kokainsucht kennen gelehrt.“"
                            },
                            {
                                "example_id": "a69eb597-a52b-4fcd-9518-d3d4dfc3847e",
                                "sense_id": "762e2d93-6e68-3526-ae9e-9f86e1446673",
                                "text": "„Um sieben Uhr stand ich auf und konnte immer noch nicht glauben, dass meine Tochter nun in eine geschlossene Maßnahme kam, zur Entzugstherapie, wegen schwerer Kokainsucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
