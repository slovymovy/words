                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2596100-40d0-38ea-b754-dd41341cdbf6",
                        "entry_id": "f68f6a3c-3294-3057-8fe1-d7571c1e2765",
                        "glosses": [
                            "Ensemble de marchandises soulevées en une seule fois par un palan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f69f750f-1c26-430a-8ac1-a19370b9c290",
                                "sense_id": "b2596100-40d0-38ea-b754-dd41341cdbf6",
                                "text": "Un boutre chargé du transbordement de marchandises entre les bateaux et le quai ayant coulé à la suite de la chute d’une palanquée de vingt sacs de ciment sur le bord de l’embarcation […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c3498d8a-5f3c-370a-b71f-59950ec797be",
                        "entry_id": "f68f6a3c-3294-3057-8fe1-d7571c1e2765",
                        "glosses": [
                            "Quantité de poissons déchargée d’un chalutier."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2b7a90f6-71cb-4d99-b5ec-2b6bea3ea0f8",
                                "sense_id": "c3498d8a-5f3c-370a-b71f-59950ec797be",
                                "text": "La quatorzième et dernière palanquée double la lisse."
                            }
                        ]
                    },
                    {
                        "sense_id": "44572309-a6a5-31fb-8d8b-347ace1321f8",
                        "entry_id": "f68f6a3c-3294-3057-8fe1-d7571c1e2765",
                        "glosses": [
                            "Grosse quantité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "28978a23-9e3c-4e47-ac22-bdc64715f6e5",
                                "sense_id": "44572309-a6a5-31fb-8d8b-347ace1321f8",
                                "text": "Rétrécie dans ses montagnes, condamnée à l’isolement, elle n’a plus de marine ni de bateaux, mais toute une palanquée d’amiraux, de capitaines de vaisseau…"
                            },
                            {
                                "example_id": "1c63efe1-fdf1-43bb-bc78-acd70a6c9bfa",
                                "sense_id": "44572309-a6a5-31fb-8d8b-347ace1321f8",
                                "text": "La salle regorgeait d’insurgés d’un mur à l’autre et, à en juger par le bruit ; il devait encore y en avoir une belle palanquée dehors."
                            }
                        ]
                    },
                    {
                        "sense_id": "de929e7b-d467-338c-84d0-25befa7de5ca",
                        "entry_id": "f68f6a3c-3294-3057-8fe1-d7571c1e2765",
                        "glosses": [
                            "Groupe de plongeurs qui effectuent une plongée ensemble. Chaque membre de la palanquée subira alors les mêmes durées d’immersion en profondeur et les mêmes efforts de nage, et doit alors respecter les mêmes préconisations de décompression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afacb380-d687-460b-af09-9b91fb4a060e",
                                "sense_id": "de929e7b-d467-338c-84d0-25befa7de5ca",
                                "text": "Plusieurs plongeurs qui effectuent ensemble une plongée présentant les mêmes caractéristiques de durée, de profondeur et de trajet constituent une palanquée.\nUne équipe est une palanquée réduite à deux plongeurs."
                            },
                            {
                                "example_id": "366d73e3-d1b1-41b1-88ae-5bb7871b1a08",
                                "sense_id": "de929e7b-d467-338c-84d0-25befa7de5ca",
                                "text": "Une palanquée constituée de débutants ne peut évoluer que dans l’espace proche."
                            }
                        ]
                    }
                ],
