                "translations": [
                    {
                        "translation_id": "1de4ddbc-26c9-497c-bb10-4426982b1a14",
                        "source_entry_id": "14112ea9-e2c5-3b25-a0ed-c6c1271c127d",
                        "source_sense_id": "2090ea91-5108-394f-bbcf-b59d731fda0e",
                        "target_lang_word": "eruptive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eruptive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69e30e9d-088d-37cd-a7f5-6ebf6f11537a",
                                        "entry_id": "1d5ab3e9-b04e-3a8a-91ce-721c10f7a370",
                                        "glosses": [
                                            "That erupts or bursts forth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "596ae0c7-535e-4c2e-b0af-ab3f0fae45cd",
                                                "sense_id": "69e30e9d-088d-37cd-a7f5-6ebf6f11537a",
                                                "text": "’Tis liſtening fear, and dumb amazement all: / When to the ſtartled eye the ſudden glance / Appears far ſouth, eruptive thro’ the cloud; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3116924-fdc1-3363-ba4c-8b3e9f31940f",
                                        "entry_id": "1d5ab3e9-b04e-3a8a-91ce-721c10f7a370",
                                        "glosses": [
                                            "Accompanied by eruptions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1436be-30f5-4ad8-953d-04a74c80fcca",
                                                "sense_id": "d3116924-fdc1-3363-ba4c-8b3e9f31940f",
                                                "text": "an eruptive fever"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf590483-7b05-36ce-bb97-88ccc94e249a",
                                        "entry_id": "1d5ab3e9-b04e-3a8a-91ce-721c10f7a370",
                                        "glosses": [
                                            "Produced by eruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce92fbae-e775-4436-8f79-b9a666390e8d",
                                                "sense_id": "cf590483-7b05-36ce-bb97-88ccc94e249a",
                                                "text": "eruptive rocks, such as the igneous or volcanic"
                                            },
                                            {
                                                "example_id": "b781196f-24ba-4061-8f4e-700edacbe043",
                                                "sense_id": "cf590483-7b05-36ce-bb97-88ccc94e249a",
                                                "text": "The region is further diversified by short ranges of eruptive mountains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eruptive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a35d2aa-96ec-3339-afdc-ffe0762d0348",
                                        "entry_id": "91ae4614-8952-3e2e-bbb9-7060b584471f",
                                        "glosses": [
                                            "An eruptive rock, one produced by eruption."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a77efb4a-eadf-41cf-a1f5-d8be4f92f842",
                        "source_entry_id": "14112ea9-e2c5-3b25-a0ed-c6c1271c127d",
                        "source_sense_id": "2090ea91-5108-394f-bbcf-b59d731fda0e",
                        "target_lang_word": "éruptif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éruptif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8faf425f-0629-39f2-aa9d-3ec43c307b67",
                                        "entry_id": "42a60dff-d360-3589-8ba1-29a21fd67081",
                                        "glosses": [
                                            "Qui est accompagné d’éruption, comme la rougeole, la variole, la scarlatine, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e7c8e4-8e6a-41c9-8258-902d8bc73250",
                                                "sense_id": "8faf425f-0629-39f2-aa9d-3ec43c307b67",
                                                "text": "Fièvre éruptive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f018a51c-5412-356d-990a-46eaa569d185",
                                        "entry_id": "42a60dff-d360-3589-8ba1-29a21fd67081",
                                        "glosses": [
                                            "Relatif aux éruptions volcaniques ; qui résulte des éruptions volcaniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca1cfee-d391-4822-975d-7db8a979bbb8",
                                                "sense_id": "f018a51c-5412-356d-990a-46eaa569d185",
                                                "text": "La connexité qui existe entre ce phénomène et les phénomènes éruptifs était une fois de plus démontrée."
                                            },
                                            {
                                                "example_id": "5efcdcee-cfb2-4d48-89b7-f6b4b0220f14",
                                                "sense_id": "f018a51c-5412-356d-990a-46eaa569d185",
                                                "text": "[…], le plateau avoisinant Rockall fut considéré comme une roche spéciale, éruptive, intrusive dans la roche stratifiée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf7368e-b46c-3cb8-906e-2a67438afbd8",
                                        "entry_id": "42a60dff-d360-3589-8ba1-29a21fd67081",
                                        "glosses": [
                                            "Qualifie des roches formées dans ces conditions."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7233cd6-b533-4515-8fd3-c09240779924",
                                                "sense_id": "fcf7368e-b46c-3cb8-906e-2a67438afbd8",
                                                "text": "Dans notre dition, les grès werféniens reposent directement et sans métamorphisme soit sur les roches éruptives et métamorphiques du Culm (Ecromagny), soit, de Lantenot au Rocheret, sur les terrains permiens […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe90e49-5c41-3573-8892-0cd4bb45f64c",
                                        "entry_id": "42a60dff-d360-3589-8ba1-29a21fd67081",
                                        "glosses": [
                                            "En parlant d'une personne, sujet aux explosions de colère."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "533c43a1-927e-4263-9d13-59b4bd03e504",
                                                "sense_id": "bbe90e49-5c41-3573-8892-0cd4bb45f64c",
                                                "text": "Il avait développé en quelque sorte une forme aiguë d'allergie à la religion qu'accentuait sa personnalité éruptive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
