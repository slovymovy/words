                    {
                        "sense_id": "aca25852-65fc-366b-a665-ae0a02dafcef",
                        "entry_id": "25225a41-3a78-381b-b5c7-2677eb3a166c",
                        "glosses": [
                            "een vrij klein stilstaand water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f2e535-4311-4fec-bf30-c7fb278c5737",
                                "sense_id": "aca25852-65fc-366b-a665-ae0a02dafcef",
                                "text": "Er zit in die poel niet zo veel vis."
                            },
                            {
                                "example_id": "3c998565-438c-46bf-a80f-f2639e6f7567",
                                "sense_id": "aca25852-65fc-366b-a665-ae0a02dafcef",
                                "text": "Het was weer eens een lange, hete dag en ik stopte pas toen ik in een diepe kloof bij een kleine poel met stilstaand groen water aankwam waar het stikte van de muggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44560cc8-6a1c-480d-9766-d5aa10c033c9",
                        "source_entry_id": "25225a41-3a78-381b-b5c7-2677eb3a166c",
                        "source_sense_id": "aca25852-65fc-366b-a665-ae0a02dafcef",
                        "source_sense_description": "een vrij klein stilstaand water",
                        "target_lang_word": "Tümpel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tümpel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dbf678d-ba9a-356a-a13d-ba80e123144a",
                                        "entry_id": "dccee28c-b2ac-329a-a0e6-e6ce7cece74f",
                                        "glosses": [
                                            "kleines, stehendes Gewässer (meist unsauber)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede16eed-e167-4d9b-8473-49c47bcef620",
                                                "sense_id": "8dbf678d-ba9a-356a-a13d-ba80e123144a",
                                                "text": "In einem Tümpel kann man Kaulquappen fangen."
                                            },
                                            {
                                                "example_id": "d795c788-11f7-4819-8295-44cffb631252",
                                                "sense_id": "8dbf678d-ba9a-356a-a13d-ba80e123144a",
                                                "text": "So ein kleiner Tümpel…"
                                            },
                                            {
                                                "example_id": "33810bed-8c93-4b2c-8ad5-c9280f83ce88",
                                                "sense_id": "8dbf678d-ba9a-356a-a13d-ba80e123144a",
                                                "text": "„Jenseits dieses Tümpels brannte ein Feuer.“"
                                            },
                                            {
                                                "example_id": "22d7a447-e612-4d92-9fb5-b934f837eb55",
                                                "sense_id": "8dbf678d-ba9a-356a-a13d-ba80e123144a",
                                                "text": "„Neben einem der Wege war ein Bach und weiter oben ein Tümpel mit grünem Zeug drauf.“"
                                            },
                                            {
                                                "example_id": "3be30703-7657-4174-9b5f-0f2e92e50834",
                                                "sense_id": "8dbf678d-ba9a-356a-a13d-ba80e123144a",
                                                "text": "„Der BVBB hatte behauptet, dass die Belastung eines Tümpels sogar doppelt so hoch sei wie in der so genannten Todeszone von Seveso.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a1f661d-8005-4ead-b9bd-c354a7733033",
                        "source_entry_id": "25225a41-3a78-381b-b5c7-2677eb3a166c",
