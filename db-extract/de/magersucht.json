                        "source_sense_id": "47f424d4-efa4-3a47-8697-fb0571ab8939",
                        "source_sense_description": "psychische Essstörung, bei der der Patient zu wenig Nahrung aufnimmt",
                        "target_lang_word": "anorexie mentale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anorexie mentale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57ca4e16-970a-39b3-bafe-2615ebbeb640",
                                        "entry_id": "a35de7d4-2d1f-3dee-8909-36939d8d3a76",
                                        "glosses": [
                                            "Trouble des conduites alimentaires, qui se manifeste notamment par une préoccupation très forte de l’apparence, qui entraîne des restrictions alimentaires drastiques."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd95f2da-8319-40e2-a34a-9ff9b218578b",
                                                "sense_id": "57ca4e16-970a-39b3-bafe-2615ebbeb640",
                                                "text": "Les troubles du comportement alimentaire (TCA) sont souvent synonymes d’anorexie mentale et de boulimie."
                                            },
                                            {
                                                "example_id": "1abf5af0-edbc-42da-a27f-d6a04a6bd7ad",
                                                "sense_id": "57ca4e16-970a-39b3-bafe-2615ebbeb640",
                                                "text": "Des femmes intelligentes — et ce qualificatif ne manque jamais d’être souligné dans les écrits cliniques sur ce trouble, allant même jusqu’à pointer combien les patientes sont des expertes de la performance intellectuelle, ce qui met en évidence la relation étroite entre l’acharnement de la pensée et l’anorexie mentale — des femmes intelligentes, donc, en prenant le chemin de l’anorexie clinique, s’extraient en quelque sorte du monde et du langage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b019c969-92f2-4924-a62b-24df0c9c20ea",
                        "source_entry_id": "e2f8898f-6b1d-3f64-b1e4-6835465e144a",
                        "source_sense_id": "47f424d4-efa4-3a47-8697-fb0571ab8939",
