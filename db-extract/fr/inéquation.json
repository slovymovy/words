                    },
                    {
                        "translation_id": "f39970e3-8206-4470-8eda-86916bdb93c3",
                        "source_entry_id": "f7d73fe8-60ef-32f2-8a41-aae2e0a8a113",
                        "source_sense_id": "b46e025a-275d-3d1c-ac09-04e16bec9e2e",
                        "target_lang_word": "inequality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inequality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a7a0a29-c82f-3351-92d4-0db192bd4b23",
                                        "entry_id": "c10c4715-ef43-32b7-8d58-78ec792aefc0",
                                        "glosses": [
                                            "An unfair, not equal, state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f1caa5c-f41c-4cb8-b914-1d061e33d4e5",
                                                "sense_id": "2a7a0a29-c82f-3351-92d4-0db192bd4b23",
                                                "text": "The inequality in living standards led to a civil war as the have nots rebelled."
                                            },
                                            {
                                                "example_id": "3c3e55b5-60cb-4e95-8584-76976d59cb93",
                                                "sense_id": "2a7a0a29-c82f-3351-92d4-0db192bd4b23",
                                                "text": "The traditional inequalities of marriage, such as changing her surname to his."
                                            },
                                            {
                                                "example_id": "d97443b3-5de8-4b62-b646-36fa0b5e816e",
                                                "sense_id": "2a7a0a29-c82f-3351-92d4-0db192bd4b23",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra–wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            },
                                            {
                                                "example_id": "7c9a1e64-b226-4eb3-bf93-f72cfde42e64",
                                                "sense_id": "2a7a0a29-c82f-3351-92d4-0db192bd4b23",
                                                "text": "With the growing awareness of climate change, congestion, and regional inequality, rail transport has re-emerged as a solution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a44590-1945-30ec-9132-97c7758ba9f0",
                                        "entry_id": "c10c4715-ef43-32b7-8d58-78ec792aefc0",
                                        "glosses": [
                                            "A statement that of two quantities one is specifically less than (or greater than) another. Symbol: < or ≤ or > or ≥ or ne , as appropriate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88d1010-205a-49f6-ae6e-12b54bb5bc5d",
                                                "sense_id": "d4a44590-1945-30ec-9132-97c7758ba9f0",
                                                "text": "The inequality x is less than y, together with that ylt;z, allows us to deduce the inequality xlt;z."
                                            },
                                            {
                                                "example_id": "740406b1-e5ff-4d44-bd70-a358b618ca43",
                                                "sense_id": "d4a44590-1945-30ec-9132-97c7758ba9f0",
                                                "text": "I then specify a set of new tight Bell inequalities for arbitrary event spaces -- the \"even/odd\" inequalities -- which have a straightforward interpretation when expressed in terms of multideviations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e12a55-fbd0-350b-8715-06266c10e123",
                                        "entry_id": "c10c4715-ef43-32b7-8d58-78ec792aefc0",
                                        "glosses": [
                                            "unevenness, irregularity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5154d76-d2aa-4535-9325-9293571d0e6e",
                                                "sense_id": "f3e12a55-fbd0-350b-8715-06266c10e123",
                                                "text": "When we behold a wide, turf-covered expanse, we should remember that its smoothness, upon which so much of its beauty depends, is mainly due to all the inequalities having been levelled by worms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
