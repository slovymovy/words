                                    }
                                ]
                            },
                            {
                                "target_word": "shopping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53440937-cba2-3c58-ad9e-105fe6634496",
                                        "entry_id": "cefe682b-402c-3de7-bd9c-6433e0ef0087",
                                        "glosses": [
                                            "The process of buying goods or services, or searching for those suitable to buy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428cf9e5-1dcc-4108-ab0d-662c491cdb91",
                                                "sense_id": "53440937-cba2-3c58-ad9e-105fe6634496",
                                                "text": "On Saturdays we usually do the shopping."
                                            },
                                            {
                                                "example_id": "97bac215-da6f-49c0-af25-fe925f98ad3c",
                                                "sense_id": "53440937-cba2-3c58-ad9e-105fe6634496",
                                                "text": "After a hard day's shopping, they had come home laden with bargains, and the dressing-room was strewed with Indian fans, ivory boxes, and lace."
                                            },
                                            {
                                                "example_id": "0b7bfda0-49ff-446d-8dc0-806bc1458f0f",
                                                "sense_id": "53440937-cba2-3c58-ad9e-105fe6634496",
                                                "text": "Here I began my shopping, was interviewed by dressmakers, and naturally had much to do to habit myself for civilized life again."
                                            },
                                            {
                                                "example_id": "1b25d922-daf9-47e0-9f38-958b60ba74d3",
                                                "sense_id": "53440937-cba2-3c58-ad9e-105fe6634496",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0daa886e-816b-3727-a3db-ca8d46b4b40d",
                                        "entry_id": "cefe682b-402c-3de7-bd9c-6433e0ef0087",
                                        "glosses": [
                                            "Recently bought goods."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b7eca64-0d56-467a-86b7-7b8af0a41ec0",
                                                "sense_id": "0daa886e-816b-3727-a3db-ca8d46b4b40d",
                                                "text": "I carried three heavy bags of shopping up the stairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70b602d3-5bde-3b5a-9f43-16d1def6eec1",
                                        "entry_id": "cefe682b-402c-3de7-bd9c-6433e0ef0087",
                                        "glosses": [
                                            "An area's combination of stores and other infrastructure and products available for people who want to shop."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00fb519f-76d4-43a0-b0db-b970c7662ebc",
                                                "sense_id": "70b602d3-5bde-3b5a-9f43-16d1def6eec1",
                                                "text": "Boston has good shopping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e90561c2-6a0a-31f4-896a-db552049bf95",
                                        "entry_id": "cefe682b-402c-3de7-bd9c-6433e0ef0087",
                                        "glosses": [
                                            "Placement in a workshop for overhaul."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a8bd099-bb38-46b8-a9fc-3dfd2e1f7cbf",
                                                "sense_id": "e90561c2-6a0a-31f4-896a-db552049bf95",
                                                "text": "The five roller-bearing A1s are now averaging 120,000 miles between shopping; this figure is an improvement of about 50 per cent on the norm of other ex-L.N.E. Pacific types."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
