                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf1b786d-64d5-4a99-a235-3f76c4e2f8d1",
                                "sense_id": "e931fb0d-4a21-33ac-8734-b84e5cb6235c",
                                "text": "Ook krijgt de VVD nu twee voltijd-gedeputeerden in plaats van een voltijder en een parttimer."
                            },
                            {
                                "example_id": "bbee9e1e-108a-4bb3-8dd9-7710afa550bb",
                                "sense_id": "e931fb0d-4a21-33ac-8734-b84e5cb6235c",
                                "text": "Zzp’er [sic!] zien zich in totaliteit wel nog altijd geconfronteerd met een lager inkomen. Hierbij zijn inkomsten uit arbeid en eventuele uitkeringen meegeteld. In 2014 was dit inkomen van mensen van wie het zzp-schap hun hoofdinkomen was € 32 duizend per jaar. Voor voltijders was dit verschil zelfs nog groter; €37 duizend voor een voltijd zzp’er en €50 duizend voor een voltijd werknemer."
                            }
                        ]
                    }
