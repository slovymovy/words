                    "sense_definition": "Urgently; with insistence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The messenger <w>instantly</w> requested an audience with the king.",
                            "target_lang_translations": {
                                "ru": "Гонец <w>настойчиво</w> потребовал аудиенции у короля.",
                                "zh": "信使<w>坚持</w>要求觐见国王。"
                            }
                        },
                        {
                            "text": "She <w>instantly</w> pressed him for a clear answer to her question.",
                            "target_lang_translations": {
                                "ru": "Она <w>настоятельно</w> требовала от него ясного ответа на свой вопрос.",
                                "zh": "她<w>强烈</w>要求他就她的问题给出一个明确的答复。"
                            }
                        }
                    ],
                    "traits": [
