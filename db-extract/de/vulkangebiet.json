                "senses": [
                    {
                        "sense_id": "aab137a0-e082-3b50-80e9-c3eefc7ba525",
                        "entry_id": "5ac1afd8-d87a-32a3-a6ac-5fd7822e5a03",
                        "glosses": [
                            "Gebiet, in dem sich mehrere Vulkane befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053ad30a-a2a0-4ec9-a596-b4a7a0bcba0b",
                                "sense_id": "aab137a0-e082-3b50-80e9-c3eefc7ba525",
                                "text": "„Diese geographisch abwechslungsreiche Region im Nordwesten von Mexiko besteht aus weiten Wüsten in Hochlagen und Ebenen, über 1600 Kilometern Küste, dem größten Vulkangebiet der Welt und überaus fruchtbaren Ackerland.“"
                            },
                            {
                                "example_id": "bb2db919-0386-425a-a5df-85bd01aa0c8c",
                                "sense_id": "aab137a0-e082-3b50-80e9-c3eefc7ba525",
                                "text": "„Die größte Ausdehnung erreicht mit ca. 600 km² das Vulkangebiet von Mitterlabill-Gleichenberg, kleinere Körper stellen der Schildvulkan von Karlsdorf-Ilz und das Vorkommen von Weitendorf-Wundschuh dar.“"
                            },
                            {
                                "example_id": "bba36c95-5597-4b6f-8926-f39e04de55ab",
                                "sense_id": "aab137a0-e082-3b50-80e9-c3eefc7ba525",
                                "text": "„Im Vulkangebiet auf Big Island sollten Sie nicht von den markierten Wegen weichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
