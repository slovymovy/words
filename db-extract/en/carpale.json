                        "glosses": [
                            "One of the bones or cartilages of the carpus, especially one of the series articulating with the metacarpals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a20b8771-3deb-4d34-91a1-5d0938facec1",
                                "sense_id": "020d3fc6-2b98-3d09-98b5-c15fd2520052",
                                "text": "[…] this being the case the bone in question contains at any rate the centrale, and I see no reason why the carpale 2 should have quite disappeared."
                            },
                            {
                                "example_id": "fc614a60-d7d4-40e2-8215-21d506619194",
                                "sense_id": "020d3fc6-2b98-3d09-98b5-c15fd2520052",
                                "text": "This indicates that the pisiform is really a secondary component which became the carpale during phylogenesis."
                            },
                            {
                                "example_id": "3fce5613-b301-4039-91d8-c2cde9028dec",
                                "sense_id": "020d3fc6-2b98-3d09-98b5-c15fd2520052",
                                "text": "The dorsal interossei are sometimes found to originate more proximal at the base of the metacarpals or even at the carpalia."
                            }
                        ]
                    }
