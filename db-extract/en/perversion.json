                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "810d9bc3-ba13-44ca-9dc0-1f859e8293b9",
                                "sense_id": "dadc1153-c448-32bc-803b-f1a4e5b8fcf3",
                                "text": "After all, the great error in human judgment is not so much wilful perversion, as that we judge according to situation, and always make that situation our own; while the chances are, that we really have not one thought, feeling, or habit, in common with those on whom we yet think ourselves qualified to decide."
                            }
                        ]
