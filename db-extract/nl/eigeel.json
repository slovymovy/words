                                "example_id": "be22a062-33ff-4834-a876-52c159256170",
                                "sense_id": "bffed697-8fe8-3457-ab53-8e0016721ebc",
                                "text": "Het eigeel heeft een rijke gele kleur.",
                                "translation": "The egg yolk has a rich yellow color.",
                                "english": "The egg yolk has a rich yellow color."
                            },
                            {
                                "example_id": "62b116d7-6c45-4f54-9a47-651b56d6be24",
                                "sense_id": "bffed697-8fe8-3457-ab53-8e0016721ebc",
                                "text": "Om de saus romiger te maken, voegde ze een eigeel toe.",
                                "translation": "To make the sauce creamier, she added an egg yolk.",
                                "english": "To make the sauce creamier, she added an egg yolk."
                            },
                            {
                                "example_id": "c5ce9e62-699f-4557-9be7-b631c1d05c3c",
                                "sense_id": "bffed697-8fe8-3457-ab53-8e0016721ebc",
                                "text": "Ik gebruikte twee eigelen voor de custard.",
                                "translation": "I used two egg yolks for the custard.",
                                "english": "I used two egg yolks for the custard."
                            }
                        ]
                    }
