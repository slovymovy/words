                ],
                "senses": [
                    {
                        "sense_id": "4199060e-a3fb-3604-b4f9-74a98ab5b0de",
                        "entry_id": "0b1ec852-9bff-3aee-b0e2-d9853e72ac43",
                        "glosses": [
                            "Teilgebiet der Mathematik, das sich mit der algebraischen Struktur der Gruppe befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f84f4a-7696-431a-8314-55f2a3f6874b",
                                "sense_id": "4199060e-a3fb-3604-b4f9-74a98ab5b0de",
                                "text": "Der norwegische Mathematiker Niels Henrik Abel gilt als einer der Mitbegründer der Gruppentheorie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "313a29f7-8666-47e6-bc3d-7e6dccc8574c",
                        "source_entry_id": "0b1ec852-9bff-3aee-b0e2-d9853e72ac43",
                        "source_sense_id": "4199060e-a3fb-3604-b4f9-74a98ab5b0de",
                        "source_sense_description": "mathematisches Teilgebiet",
                        "target_lang_word": "group theory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "group theory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe72b5be-3ff3-357c-99a8-51d39f180779",
                                        "entry_id": "49fe851c-c5cb-3db9-b53b-99acb35be9be",
                                        "glosses": [
                                            "The mathematical theory of groups."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b152fec-6712-4a1a-a41e-6eb7dc9bb3cd",
                                                "sense_id": "fe72b5be-3ff3-357c-99a8-51d39f180779",
                                                "text": "THE feeling seems to be developing among physicists that group theory can be used as and when required, as many other techniques already are, without its being necessary for everyone to study all the whys and wherefores of the mathematical details involved."
                                            },
                                            {
                                                "example_id": "5113aaba-98c2-4853-83a9-ba77a95e1562",
                                                "sense_id": "fe72b5be-3ff3-357c-99a8-51d39f180779",
                                                "text": "Planar cis and/or trans internal rotation tunnelling have been discussed in terms of group theory, leading to theoretical spectra which have been compared to experimental work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de1c106c-6454-33fd-81ec-1bee7f083e8d",
                                        "entry_id": "49fe851c-c5cb-3db9-b53b-99acb35be9be",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see group, theory; a theory about (particular kinds of) groups."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fdcb792-6732-4105-9ee4-f1b683a2e205",
                                                "sense_id": "de1c106c-6454-33fd-81ec-1bee7f083e8d",
                                                "text": "2007, Hedley G. Dimock, Rachel R. Kass, How to Observe Your Group, Captus Press, 4th Edition, page 3,\nAfter you have read over the seven group theories you'll be clearer about what makes the most sense to you for the groups with which you want to use your observation skills."
                                            },
                                            {
                                                "example_id": "c2b6558d-5275-4ca4-b595-852030060130",
                                                "sense_id": "de1c106c-6454-33fd-81ec-1bee7f083e8d",
                                                "text": "2012, Stéphanie Delaune, Steve Kremer, Daniel Pasaila, Security Protocols, Constraint Systems, and Group Theories, Bernhard Gramlich, Dale Miller, Ulrike Sattler (editors), Automated Reasoning: 6th International Joint Conference, Springer, LNAI 7364, page 165,\nIn particular we study the case where cryptographic primitives are modelled using a group theory. Group theories are a special case of monoidal theories which have been extensively studied by F. Baader and W. Nutt [20,6] who have provided a complete survey of unification in these theories. Group theories include theories for exclusive or and Abelian groups."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
