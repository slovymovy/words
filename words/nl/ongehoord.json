{
    "word_family": [
        "gehoor",
        "horen",
        "gehoorzaam"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ccbcbd72-b5d5-3964-a05f-1c78b6d9e056",
                    "sense_definition": "iets dat nog nooit eerder is voorgekomen of vertoond",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitzonderlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>ongehoord</w> dat een student zo tegen een docent spreekt.",
                            "target_lang_translations": {
                                "en": "It is <w>outrageous</w> that a student speaks to a teacher like that."
                            }
                        },
                        {
                            "text": "Zij behaalde een <w>ongehoord</w> succes met haar nieuwe boek.",
                            "target_lang_translations": {
                                "en": "She achieved <w>unprecedented</w> success with her new book."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitengewoon",
                        "ongebruikelijk"
                    ],
                    "common_phrases": [
                        "ongehoord gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that has never occurred or been seen before; unprecedented."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unprecedented",
                                "target_lang_sense_clarification": "referring to something that has never happened before"
                            },
                            {
                                "target_lang_word": "unheard-of",
                                "target_lang_sense_clarification": "referring to something surprising or unusual"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27bfeb19-746d-321a-9be5-ed9e92255fa1",
                    "sense_definition": "zeer schandelijk of onacceptabel",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negatief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>ongehoord</w> om mensen zo slecht te behandelen.",
                            "target_lang_translations": {
                                "en": "It is <w>scandalous</w> to treat people so poorly."
                            }
                        },
                        {
                            "text": "De <w>ongehoorde</w> corruptie binnen de organisatie leidde tot veel woede.",
                            "target_lang_translations": {
                                "en": "The <w>outrageous</w> corruption within the organization led to much anger."
                            }
                        }
                    ],
                    "synonyms": [
                        "schandelijk",
                        "onacceptabel"
                    ],
                    "target_lang_definitions": {
                        "en": "Very shameful, offensive, or unacceptable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outrageous",
                                "target_lang_sense_clarification": "shockingly bad or unacceptable"
                            },
                            {
                                "target_lang_word": "scandalous",
                                "target_lang_sense_clarification": "morally offensive or disgraceful"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e521a9e7-9c1e-3db3-b9dc-1845c35e2234",
                    "sense_definition": "in extreme of overmatige mate",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De prijzen in dit restaurant zijn <w>ongehoord</w> hoog.",
                            "target_lang_translations": {
                                "en": "The prices in this restaurant are <w>exorbitantly</w> high."
                            }
                        },
                        {
                            "text": "Er heerste een <w>ongehoorde</w> hitte tijdens de zomermaanden.",
                            "target_lang_translations": {
                                "en": "There was <w>extreme</w> heat during the summer months."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitensporig",
                        "extreem"
                    ],
                    "target_lang_definitions": {
                        "en": "To an extreme or excessive degree."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exorbitant",
                                "target_lang_sense_clarification": "excessively high, usually referring to prices"
                            },
                            {
                                "target_lang_word": "extreme",
                                "target_lang_sense_clarification": "reaching a high degree or intensity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0890b31d-77aa-3f1c-ac1d-4e190f0b6453",
                    "sense_definition": "niet gehoord of genegeerd in de samenleving",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwaarloosd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stem van de <w>ongehoorde</w> minderheid moet serieus genomen worden.",
                            "target_lang_translations": {
                                "en": "The voice of the <w>unheard</w> minority must be taken seriously."
                            }
                        },
                        {
                            "text": "Veel kwetsbare groepen voelen zich in dit debat <w>ongehoord</w>.",
                            "target_lang_translations": {
                                "en": "Many vulnerable groups feel <w>unheard</w> in this debate."
                            }
                        }
                    ],
                    "synonyms": [
                        "genegeerd",
                        "miskend"
                    ],
                    "antonyms": [
                        "gehoord"
                    ],
                    "target_lang_definitions": {
                        "en": "Not listened to or ignored in society."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unheard",
                                "target_lang_sense_clarification": "not given a voice or not listened to"
                            },
                            {
                                "target_lang_word": "ignored",
                                "target_lang_sense_clarification": "deliberately disregarded"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}