                            {
                                "target_word": "skid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6c1ac4-754b-3e70-bcd1-f8f86538383d",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "An out-of-control sliding motion as would result from applying the brakes too hard in a car or other vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff14b58-7ef2-422c-9550-5d8bb293e9d8",
                                                "sense_id": "5b6c1ac4-754b-3e70-bcd1-f8f86538383d",
                                                "text": "Just before hitting the guardrail the driver was able to regain control and pull out of the skid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e542e371-b4e0-384c-9599-79db3fd6eb69",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A shoe or clog, as of iron, attached to a chain, and placed under the wheel of a wagon to prevent its turning when descending a steep hill."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bdf213a-6c12-3630-80b6-99ddde1a6991",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A hook attached to a chain, used for the same purpose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef35e81d-e443-3dad-9108-2b3ab2abac12",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A piece of timber or other material used as a support, or to receive pressure.",
                                            "A runner of a sled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a07073d-c39d-46d6-9851-23ebe0dffc12",
                                                "sense_id": "ef35e81d-e443-3dad-9108-2b3ab2abac12",
                                                "text": "In the hours before daylight he sharpened the skids and tightened the lashings to prepare for the long dogsled journey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32b8c763-a894-3c13-9a69-18cd8dfba18c",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A piece of timber or other material used as a support, or to receive pressure.",
                                            "A ski-shaped runner or supporting surface as found on a helicopter or other aircraft in place of wheels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aab5610f-3000-492a-9448-79ed8ff017e0",
                                                "sense_id": "32b8c763-a894-3c13-9a69-18cd8dfba18c",
                                                "text": "Due to frequent arctic travel, the plane was equipped with long skids for snow and ice landings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94cc3349-95a4-37db-8d83-6c934949ec93",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A piece of timber or other material used as a support, or to receive pressure.",
                                            "A basic platform for the storage and transport of goods, machinery or equipment, later developed into the pallet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a8beb6a-3786-41dd-b932-be0dbf93bd34",
                                                "sense_id": "94cc3349-95a4-37db-8d83-6c934949ec93",
                                                "text": "He unloaded six skids of boxes from the truck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884908bf-0cbc-3f22-85fc-5c0a8051abae",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A piece of timber or other material used as a support, or to receive pressure.",
                                            "One of a pair of horizontal rails or timbers for supporting anything, such as a boat or barrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e74d46e-6000-4922-8d25-02ba3d974ea6",
                                                "sense_id": "884908bf-0cbc-3f22-85fc-5c0a8051abae",
                                                "text": "His head was away up in the shadows of lifeboats that stood on skids above the deck."
                                            },
                                            {
                                                "example_id": "369166c6-bf85-4350-808c-097b48b16e07",
                                                "sense_id": "884908bf-0cbc-3f22-85fc-5c0a8051abae",
                                                "text": "If the boat had been further out, we could not get to work at the wheel without beaching her further up; or either dry docking her or putting her on skids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ab3a97-8155-334c-9ec8-90c6d0757e06",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A banked sideslip where the aircraft's nose is yawed towards the low wing, often due to excessive rudder input."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c93287a9-0a25-3837-94c3-e15da5ac14de",
                                        "entry_id": "1c54b8d4-cb2a-35b8-a0df-0101a2ca852a",
                                        "glosses": [
                                            "A losing streak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0456e2-1857-431a-9994-ee9e23f102ef",
                                                "sense_id": "c93287a9-0a25-3837-94c3-e15da5ac14de",
                                                "text": "The team snapped a 3-game skid with a win over their biggest rival."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22837bdd-7ac6-3add-a53b-c30512fbbab8",
                                        "entry_id": "771e595b-f9bf-3b5e-b457-c92b65e326f0",
                                        "glosses": [
                                            "(of a wheel, sled runner, or vehicle tracks) To slide along the ground, without the rotary motion that wheels or tracks would normally have."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b549f5fc-416c-3286-8cc6-c2911aac4201",
                                        "entry_id": "771e595b-f9bf-3b5e-b457-c92b65e326f0",
                                        "glosses": [
                                            "To slide in an uncontrolled manner as in a car with the brakes applied too hard, the wheels sliding with limited spinning."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48fd3c65-a3d7-4f30-afad-2b0ee7fa91ee",
                                                "sense_id": "b549f5fc-416c-3286-8cc6-c2911aac4201",
                                                "text": "They skidded around the corner and accelerated up the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "527e0c5c-c103-32f5-b350-703309675aec",
                                        "entry_id": "771e595b-f9bf-3b5e-b457-c92b65e326f0",
                                        "glosses": [
                                            "To operate an aircraft in a banked sideslip with the nose yawed towards the low wing."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e90b682-2fcc-4ad3-b303-2ba8ddf02329",
                                                "sense_id": "527e0c5c-c103-32f5-b350-703309675aec",
                                                "text": "Don't use excessive rudder when turning, especially at low airspeed, as this causes your plane to skid through the turn, which can cause you to very rapidly enter a spin if the inner wing stalls."
                                            },
                                            {
                                                "example_id": "ee0c2633-2fed-4e30-b933-4314e5926335",
                                                "sense_id": "527e0c5c-c103-32f5-b350-703309675aec",
                                                "text": "Because of the jammed ailerons, the pilot had to use careful rudder inputs to skid his plane in order to turn it so he could get lined up with the runway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce2f483-5e8c-358c-9eba-6ef791e7ab36",
                                        "entry_id": "771e595b-f9bf-3b5e-b457-c92b65e326f0",
                                        "glosses": [
                                            "To protect or support with a skid or skids."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2502a871-646c-3deb-8216-29e7e213b024",
                                        "entry_id": "771e595b-f9bf-3b5e-b457-c92b65e326f0",
                                        "glosses": [
                                            "To cause to move on skids."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d7e89f3-e51a-3c5b-9637-b915ac55205b",
                                        "entry_id": "771e595b-f9bf-3b5e-b457-c92b65e326f0",
                                        "glosses": [
                                            "To check or halt (wagon wheels, etc.) with a skid."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
