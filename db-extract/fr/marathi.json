                        "entry_id": "96f64644-7bd6-3cb6-8bc3-b85f61bede3c",
                        "glosses": [
                            "Langue indienne appartenant à la branche indo-iranienne de la famille des langues indo-européennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1b13c73-8062-4574-a139-c545a10f326d",
                                "sense_id": "ef6fe58e-ba34-367a-9356-f230182f3cf8",
                                "text": "L’activisme identitaire autour de l’usage du marathi à Bombay illustre les tensions récurrentes qui agitent toujours l’Inde autour de son hétérogénéité culturelle."
                            }
                        ]
                    }
                ],
