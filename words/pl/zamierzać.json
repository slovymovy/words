                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намереваться",
                                "target_lang_sense_clarification": "книжный стиль, выражает наличие замысла или плана"
                            },
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "более разговорный вариант, выражает готовность к действию"
