                        "examples": [
                            {
                                "example_id": "2b38fbeb-f49c-47f8-958a-9fa02273f6d5",
                                "sense_id": "9903c40b-9824-350b-b860-d2cd3bdfd6f1",
                                "text": "The Spanish ought to have the seat of their Italian government at Genoa, and to Hispaniolize the higher classes by education."
                            },
                            {
                                "example_id": "d15e082b-5437-4044-90fc-c0ad628d6cfb",
                                "sense_id": "9903c40b-9824-350b-b860-d2cd3bdfd6f1",
                                "text": "There, however, he has naturally done all he can to Hispaniolize his pronounced African type."
                            },
                            {
                                "example_id": "4ba36594-26e5-4668-a28d-d9de698a2d17",
                                "sense_id": "9903c40b-9824-350b-b860-d2cd3bdfd6f1",
                                "text": "Spanish Christians demanded that Philip \"Hispaniolize the Moriscos.\""
                            }
                        ]
