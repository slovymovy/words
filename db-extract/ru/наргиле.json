                "senses": [
                    {
                        "sense_id": "ae0adff0-3a7c-3a45-a906-e7d32f6a89cd",
                        "entry_id": "80268ae4-ec3f-32bf-b083-0f9018352bbe",
                        "glosses": [
                            "то же, что кальян; распространённое на Ближнем Востоке устройство для курения, пропускающее дым через воду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4825c343-0cca-429d-b558-db892e2af0da",
                                "sense_id": "ae0adff0-3a7c-3a45-a906-e7d32f6a89cd",
                                "text": "И вот правоверные идут со всего мира к ней: они разуваются, целуют камень, они плачут, но потом всё-таки уходят к себе курить наргиле и целовать своих гурий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49b16e83-406f-47bb-8a84-0539b0d2b9bb",
                        "source_entry_id": "80268ae4-ec3f-32bf-b083-0f9018352bbe",
                        "source_sense_id": "ae0adff0-3a7c-3a45-a906-e7d32f6a89cd",
                        "target_lang_word": "narghile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narghile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff72b8d5-cbe7-396d-8848-2a6355c4f4e9",
                                        "entry_id": "383c882b-437f-3abd-a1a7-cafe9846eb5c",
                                        "glosses": [
                                            "A large Oriental tobacco pipe wherein the smoke is drawn through water to filter and cool it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5fd939c-7379-491d-8b75-13456dc8535c",
                                                "sense_id": "ff72b8d5-cbe7-396d-8848-2a6355c4f4e9",
                                                "text": "He went to the Pyramids and Syria, and there left his malady behind him, and returned with a fine beard, and a supply of tarbooshes and nargillies, with which he regales all his friends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46410857-fefb-45bb-b3e5-82142c63e08e",
                        "source_entry_id": "80268ae4-ec3f-32bf-b083-0f9018352bbe",
                        "source_sense_id": "ae0adff0-3a7c-3a45-a906-e7d32f6a89cd",
                        "target_lang_word": "narguile",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narguile",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4243e276-13fe-3e18-b99e-e1aee7f938da",
                                        "entry_id": "e8f870ca-00e7-387e-ba3b-2f0498a4745e",
                                        "glosses": [
                                            "Especie de pipa para fumar por lo general tabaco, compuesta de un recipiente que quema el tabaco, de un vaso con agua perfumada (por el que pasa el humo), y de un tubo con boquilla para aspirar el humo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3e89594-d0a9-41e2-a9d4-d208b8325ae3",
                        "source_entry_id": "80268ae4-ec3f-32bf-b083-0f9018352bbe",
                        "source_sense_id": "ae0adff0-3a7c-3a45-a906-e7d32f6a89cd",
                        "target_lang_word": "Nargileh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nargileh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                        "entry_id": "496c93e7-27e3-303e-9b5b-6bf98c6787b9",
                                        "glosses": [
                                            "orientalische Wasserpfeife"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47eba6e9-2570-4728-8157-858464a534e3",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Mehrere Nargîleh ſind daher ſtets in Bereitſchaft.“"
                                            },
                                            {
                                                "example_id": "9e278945-4822-4757-a2c1-a665a3161627",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„»Nimm Platz und rauche diese Nargileh – wenn du ziehst, kommt Rauch; wenn du bläst, spielt sie: Deutschland, Deutschland über alles!«“"
                                            },
                                            {
                                                "example_id": "ef985bec-bc8d-4389-919e-d5c9ed4480df",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Aber an diesem Abend, nachdem er sein Gebet verrichtet hatte und der Laden geschlossen, setzte er sich mit ihm auf den Bürgersteig und forderte ihn auf, mit ihm eine Nargileh zu rauchen, jene eigentümliche Wasserpfeife, die die Araber benutzen.“"
                                            },
                                            {
                                                "example_id": "5bc99e00-4ab2-4995-8dd0-a74907a47b03",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Für das leibliche Wohl der Gäste stehen orientalisches Essen, Tee, Kaffee und Nargilehs (Wasserpfeifen) bereit.“"
                                            },
                                            {
                                                "example_id": "3b309ad4-3bc4-44dc-adc8-116d457f8213",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Der schöne Tag, Frühlingsanfang und Neujahrsfest für die Kurden, lädt dazu ein, eine gute Nargileh zu rauchen und Tee zu trinken; ein Glas Tee ‚Limun Basrah‘, mit Zitronengeschmack aus Basra.“"
                                            },
                                            {
                                                "example_id": "99ac3dec-23d1-4ec8-9873-dbe6dcb73b0b",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Rund eine Million Menschen nutzen weltweit die auch Nargileh oder Shisha genannten Wasserpfeifen.“"
                                            },
                                            {
                                                "example_id": "ccd2f077-2a12-40b8-ac32-1cdbce0a566a",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Die Nargileh blubbert, süßlicher Tabakgeruch hängt über dem Tisch, gemütliche Rauchwölkchen schweben in Kopfhöhe.“"
                                            },
                                            {
                                                "example_id": "6a003112-face-4cd1-8aab-f831c1181c1c",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„‚Ich weiß nicht, ob sie schuld sind‘, zweifelt ein junger Mann, der an unserem Tisch seine Nargileh raucht.“"
                                            },
                                            {
                                                "example_id": "ec39dad1-55ca-463c-8479-f7d72cf20d4f",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„In den Restaurants der Altstadt, die ihre Spezialitäten meist in den Innenhöfen und auf den Dachterrassen historischer Häuser servieren, schmauchen die Touristen aus dem Golf weiterhin ihr Nargileh.“"
                                            },
                                            {
                                                "example_id": "a9f0be10-a684-4e34-a91b-ce1ffe8e333b",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Zwischen den Ruhebetten standen Taburetts mit Nargilehs und dampfende Duftschalen.“"
                                            },
                                            {
                                                "example_id": "855ea6ce-10fd-4910-a3d1-d82e584c233c",
                                                "sense_id": "0c6f1a46-2301-301d-9f76-818c041e5522",
                                                "text": "„Vergitterte Oberlichter gewährten Blicke in die überdachte Basargasse unter mir oder in ein Gewölbe, in dem Männer auf Basthockern saßen, Kaffee tranken und an ihren Nargilehs sogen, oder in die Intimität eines geheimen Hofes, von dem“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c245b8c1-4fcc-45b6-bac4-90302136211c",
                        "source_entry_id": "80268ae4-ec3f-32bf-b083-0f9018352bbe",
                        "source_sense_id": "ae0adff0-3a7c-3a45-a906-e7d32f6a89cd",
