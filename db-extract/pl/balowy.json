                                "sense_id": "f1745d59-f93b-3c3d-a2f7-6a1be9ce1da4",
                                "text": "Robiło się na zamówienie: buty z cholewami, wywrotki, takie balowe czółenka z mięciuteńkiej skórki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33744fc4-3dbe-4d41-b501-510b0dc4cde1",
                        "source_entry_id": "187cb8e2-ed0f-3a09-81a7-97c88ca232f4",
                        "source_sense_id": "f1745d59-f93b-3c3d-a2f7-6a1be9ce1da4",
                        "target_lang_word": "Ball",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ball",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c816f10d-18c6-3464-ae14-5bdc012012a5",
                                        "entry_id": "8d8ba084-ed77-3317-bfd9-b28971103086",
                                        "glosses": [
                                            "kugelförmiges Objekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2100eda5-be42-4b25-82d9-9e3665c1feae",
                                                "sense_id": "c816f10d-18c6-3464-ae14-5bdc012012a5",
                                                "text": "Sie spielten mit dem Ball."
                                            },
                                            {
                                                "example_id": "bfa40adc-04bc-4c53-8b18-9f3468c9c4e9",
                                                "sense_id": "c816f10d-18c6-3464-ae14-5bdc012012a5",
                                                "text": "„Der Ball ist rund.“ (Sepp Herberger)"
                                            },
                                            {
                                                "example_id": "73918a43-a702-4a21-82a7-d107e5d42824",
                                                "sense_id": "c816f10d-18c6-3464-ae14-5bdc012012a5",
                                                "text": "„Der schnellste Spieler ist der Ball.“ (Sepp Herberger)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08806cff-6921-31fe-b71c-4ab9ba33803d",
                                        "entry_id": "8d8ba084-ed77-3317-bfd9-b28971103086",
                                        "glosses": [
                                            "die Art, wie dieses gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37d9764-30ca-40d1-b470-350c9bedacb9",
                                                "sense_id": "08806cff-6921-31fe-b71c-4ab9ba33803d",
                                                "text": "Das war ein sehr guter Ball. Der Ball wurde abgefälscht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ball",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c719ba72-3b72-3835-a8eb-17e8210a2b2c",
                                        "entry_id": "00753b96-e909-3a16-8708-c35ec4aef1b9",
                                        "glosses": [
                                            "festliche Veranstaltung, gesellschaftliches Ereignis meist mit Tanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c067b58c-670b-47f0-80f1-8b7ef6d41085",
                                                "sense_id": "c719ba72-3b72-3835-a8eb-17e8210a2b2c",
                                                "text": "Auf diesem Ball amüsierte sich die Prominenz hervorragend."
                                            },
                                            {
                                                "example_id": "03a6e5ca-e57d-4b9b-b9e0-dacb743884e5",
                                                "sense_id": "c719ba72-3b72-3835-a8eb-17e8210a2b2c",
                                                "text": "„Es gab keinen Ball, keine Schlittenfahrt, keine Theateraufführung, ohne dass Julie dabeigewesen wäre.“"
                                            },
                                            {
                                                "example_id": "13cc4123-3faa-4c9f-8b82-cde7974d1047",
                                                "sense_id": "c719ba72-3b72-3835-a8eb-17e8210a2b2c",
                                                "text": "„Gegen Ende des Balls wurde ein Mann im Kostüm eines venezianischen Schiffers von einer sehr hübschen weiblichen Maske bedrängt, die einen schwarzen Mantel und eine Bauta nach venezianischer Mode trug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ball",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                        "entry_id": "d75b18c5-8fa2-3d6f-af37-9468ed8467d3",
                                        "glosses": [
                                            "Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28095026-ae11-40f7-9658-00e26b0c0590",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Na, da kommen ja die Balls endlich!"
                                            },
                                            {
                                                "example_id": "22960eb0-0a01-47c6-a4ee-e6a513e0fe56",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Ein bekannter Namensträger des Namens „Ball“ ist zum Beispiel der Schriftsteller Hugo Ball."
                                            },
                                            {
                                                "example_id": "11d2f1e8-7916-41a8-8aa6-8fb4c8d052c9",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Frau Ball ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "7f775b70-307e-431a-9268-8b8af0008ce1",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Herr Ball wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "cb5a92b4-19d7-4df9-9a4b-fd033b9684ff",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Die Balls fahren heute nach Lübeck."
                                            },
                                            {
                                                "example_id": "3fb4b57a-3b6d-48ff-861b-b0657dedc19d",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Der Ball trägt nie die Schals, die die Ball ihm strickt."
                                            },
                                            {
                                                "example_id": "de0e83fa-46f9-4c8c-9b81-a25a8fc864d9",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ball kommt, geht der Herr Ball.“"
                                            },
                                            {
                                                "example_id": "8e303482-1191-4730-b357-83f424439459",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Ball kommt und geht."
                                            },
                                            {
                                                "example_id": "40670598-b6bf-434d-a07e-7c6c1d7baa9c",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Balls kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "5eaf80aa-25ad-4983-8c87-0ab3fecaaa5f",
                                                "sense_id": "9fab4867-2d0d-3bc0-995e-a92450687142",
                                                "text": "Na, da kommt ja Familie Ball endlich!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ab586ca-2f8a-4a50-b981-0fed778c8cd1",
