                    {
                        "sense_id": "385238d4-6155-3a72-857e-a28c5ce277ce",
                        "entry_id": "f22fe2e7-bd1d-3284-b5c3-ed66e70b99ea",
                        "glosses": [
                            "Pronounced longer and considered as being doubled."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e352397a-80c9-4f1f-bdb9-62e0a862fe8e",
                                "sense_id": "385238d4-6155-3a72-857e-a28c5ce277ce",
                                "text": "For example, Martin (2007) notes that compounds in several languages (including English and Turkish) violate the general phonological principles in the language (e.g., English only allows geminate consonants in compounds)."
                            }
                        ]
                    }
                ],
