                ],
                "senses": [
                    {
                        "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                        "entry_id": "b47fa6ff-a4ce-359a-b297-e472e1d1523e",
                        "glosses": [
                            "Teilbereich der linguistischen Pragmatik, der sich mit Sprechakten befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf55520-8e47-40df-adc9-3e9b034e5de6",
                                "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                                "text": "Die Sprechakttheorie befasst sich mit der Frage, was jemand tatsächlich meint, wenn er sich äußert."
                            },
                            {
                                "example_id": "410d3df0-86a0-4286-8bc3-f8ff98d586dd",
                                "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                                "text": "„Mit der Sprechakttheorie sind vor allem die Namen dreier Sprachphilosophen verbunden.“ (Gemeint: L. Wittgenstein, J. L. Austin, J. R. Searle)"
                            },
                            {
                                "example_id": "6b0d2098-e46c-4f0f-8c61-a48eefbe5255",
                                "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                                "text": "„Es war die Sprechakttheorie, die einen entscheidenden Anstoss zur Entwicklung jenes Grossbereichs der modernen Sprachwissenschaft gab, den man heute Pragmatik oder Pragmalinguistik nennt.“"
                            },
                            {
                                "example_id": "5d366225-23bd-461d-bd9f-4c9afe44c11a",
                                "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                                "text": "„Die Aussage, daß Sprechen eine von sozialen Regeln (Mustern) geleitete Form zwischenmenschlicher Interaktion ist, bestimmt zugleich das Kommunikationsverständnis der Sprechakttheorie und damit der gesamten Pragmalinguistik.“"
                            },
                            {
                                "example_id": "c9128dd4-472d-467c-8f15-af95f21af8bc",
                                "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                                "text": "„Witze können aber auch entstehen, weil eine Situations- und Handlungserwartung nicht erfüllt wird, was die Pragmatik, die Sprechaktheorie erforscht.“"
                            },
                            {
                                "example_id": "5d97abf3-03fd-41eb-83e1-0d8a27e790a0",
                                "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                                "text": "„Der Philosoph John Searle ist im Alter von 93 Jahren verstorben. Seine Arbeiten zur Sprechakttheorie und zur menschlichen Intelligenz prägen die Philosophie maßgeblich – bis heute.“"
                            },
                            {
                                "example_id": "8dd90c14-f737-47e1-91eb-c824e34f18e0",
                                "sense_id": "81159b57-ce66-3b6a-a5a5-d01787e946ce",
                                "text": "„Für seine Sprechakttheorie entwarf Searle ein barockes System von Regeln und Klassifikationen, um die Sprache, dieses widerspenstige Objekt, in den Griff seiner Kategorien zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
