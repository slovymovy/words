                "senses": [
                    {
                        "sense_id": "974ae7ec-474c-3043-8e83-386819adb933",
                        "entry_id": "9a5ebbfc-580c-36b0-a9f9-8240582a8d51",
                        "glosses": [
                            "niewłaściwa hodowla (nierasowych, nierodowodowych psów, rzadziej kotów, nieposiadających uprawnień hodowlanych) prowadzona, najczęściej w celach zarobkowych, przez niekompetentną, nieuprawnioną do tego osobę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1845e6-4d1c-4624-873f-cde070e3973f",
                                "sense_id": "974ae7ec-474c-3043-8e83-386819adb933",
                                "text": "Psy w pseudohodowlach często trzymane są w klatkach, ciemnych i ciasnych pomieszczeniach, piwnicach. Bywa, że są bite"
                            },
                            {
                                "example_id": "bef88f14-08b0-40ef-91c2-5ab9c75e07d7",
                                "sense_id": "974ae7ec-474c-3043-8e83-386819adb933",
                                "text": "Wczoraj Fundacja (…) przyjęła pod opiekę 20 pekińczyków ze zlikwidowanej pseudohodowli pod Otwockiem. (…) Blisko 50 zwierząt było przetrzymywanych w koszmarnych warunkach. Stan wychudzenia wskazuje na to, że psy nie były praktycznie żywione od dłuższego czasu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
