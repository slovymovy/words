                                    {
                                        "sense_id": "8821e3f7-4222-3b95-9dbe-248880bba97f",
                                        "entry_id": "22bbc6e3-67af-3df6-b5f0-9e7ab482f158",
                                        "glosses": [
                                            "Féminin singulier de battu."
                                        ],
