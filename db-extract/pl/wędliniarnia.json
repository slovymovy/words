                                        "sense_id": "1bc05140-282e-3b87-9f26-dc4204c79f89",
                                        "entry_id": "2c0e02ba-a3b3-3e6a-a9c1-84a5b2215cc2",
                                        "glosses": [
                                            "Boutique où se fait le commerce du charcutier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
