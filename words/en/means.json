    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e139139-268e-332d-ae0a-5265a62e66c7",
                    "sense_definition": "The third-person singular form of the verb <w>mean</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A red light <w>means</w> that you have to stop the car immediately.",
                            "target_lang_translations": {
                                "ru": "Красный свет <w>означает</w>, что вы должны немедленно остановить машину.",
                                "fr": "Un feu rouge <w>signifie</w> que vous devez immédiatement arrêter la voiture."
                            }
                        },
                        {
                            "text": "She <w>means</w> well, but her advice is not always helpful.",
                            "target_lang_translations": {
                                "ru": "Она <w>хочет</w> как лучше, но её советы не всегда полезны.",
                                "fr": "Elle <w>pense bien faire</w>, mais ses conseils ne sont pas toujours utiles."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма третьего лица единственного числа глагола mean.",
                        "fr": "Forme de la troisième personne du singulier du verbe « mean » au présent."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "означает",
                                "target_lang_sense_clarification": "имеет значение, символизирует"
                            },
                            {
                                "target_lang_word": "имеет в виду",
                                "target_lang_sense_clarification": "о намерениях или мыслях"
                            },
                            {
                                "target_lang_word": "значит",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "veut dire",
                                "target_lang_sense_clarification": "signifier, avoir pour sens"
                            },
                            {
                                "target_lang_word": "signifie",
                                "target_lang_sense_clarification": "indiquer, désigner"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03ef80df-e79f-316a-b58e-5c5ee64e3ef3",
                    "sense_definition": "An instrument, method, or condition used to achieve a result.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subway is a very convenient <w>means</w> of transport in the city.",
                            "target_lang_translations": {
                                "ru": "Метро — очень удобное <w>средство</w> передвижения в городе.",
                                "fr": "Le métro est un <w>moyen</w> de transport très pratique en ville."
                            }
                        },
                        {
                            "text": "We need to find a <w>means</w> to solve this problem before it gets worse.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти <w>способ</w> решить эту проблему, пока она не усугубилась.",
                                "fr": "Nous devons trouver un <w>moyen</w> de résoudre ce problème avant qu'il n'empire."
                            }
                        }
                    ],
                    "synonyms": [
                        "way",
                        "method"
                    ],
                    "common_phrases": [
                        "by means of",
                        "means of transport",
                        "means to an end",
                        "ways and means"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, метод или условие, используемые для достижения результата.",
                        "fr": "Instrument, méthode ou condition servant à parvenir à un résultat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средство",
                                "target_lang_sense_clarification": "инструмент, орудие или прием"
                            },
                            {
                                "target_lang_word": "способ",
                                "target_lang_sense_clarification": "метод, образ действия"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "moyen",
                                "target_lang_sense_clarification": "procédé, méthode ou instrument"
                            },
                            {
                                "target_lang_word": "façon",
                                "target_lang_sense_clarification": "manière d'agir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37fa6213-b6be-32d5-bd6a-c1f40aa318c8",
                    "sense_definition": "Financial resources or wealth available to a person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has to learn to live within his <w>means</w> and stop spending so much money.",
                            "target_lang_translations": {
                                "ru": "Он должен научиться жить по <w>средствам</w> и перестать тратить так много денег.",
                                "fr": "Il doit apprendre à vivre selon ses <w>moyens</w> et arrêter de dépenser autant d'argent."
                            }
                        },
                        {
                            "text": "She is a woman of independent <w>means</w> who travels the world.",
                            "target_lang_translations": {
                                "ru": "Она женщина с собственными <w>средствами</w>, которая путешествует по миру.",
                                "fr": "C'est une femme qui dispose de ses propres <w>moyens</w> et qui voyage à travers le monde."
                            }
                        }
                    ],
                    "synonyms": [
                        "wherewithal"
                    ],
                    "common_phrases": [
                        "live beyond one's means",
                        "man of means",
                        "within one's means",
                        "private means"
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовые ресурсы или богатство, доступные человеку.",
                        "fr": "Ressources financières ou patrimoine dont dispose une personne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средства",
                                "target_lang_sense_clarification": "деньги, капитал"
                            },
                            {
                                "target_lang_word": "состояние",
                                "target_lang_sense_clarification": "богатство, накопления"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "moyens",
                                "target_lang_sense_clarification": "ressources financières"
                            },
                            {
                                "target_lang_word": "ressources",
                                "target_lang_sense_clarification": "revenus, finances"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f89bd52-bb07-3e85-b049-8ef2d7511796",
