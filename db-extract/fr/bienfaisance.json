        "fr-extract.jsonl": [
            {
                "entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
                "word": "bienfaisance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2ff03547-f9f7-481a-884d-f567d2713340",
                        "entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
                        "tags": [
                            "plural"
                        ],
                        "form": "bienfaisances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "83e86c79-8d7e-316f-85de-1c26bfb8744c",
                        "entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
                        "glosses": [
                            "Inclination à faire du bien aux autres, pratique des bienfaits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1541b8a7-5cc9-46dc-a26b-93577d1dd8fe",
                                "sense_id": "83e86c79-8d7e-316f-85de-1c26bfb8744c",
                                "text": "La bienfaisance fut sa plus belle vertu. Acte de bienfaisance. Une bienfaisance éclairée, active. Il n’eut point à se repentir de sa bienfaisance envers eux."
                            },
                            {
                                "example_id": "76d7bdaf-275a-4470-b8bd-176ec3e9adb6",
                                "sense_id": "83e86c79-8d7e-316f-85de-1c26bfb8744c",
                                "text": "Le riche, quand il s'associe à une œuvre de bienfaisance, ne donne souvent que son superflu. Le pauvre donne ce dont il a lui-même besoin, et ne craint pas de souffrir pour apaiser une souffrance."
                            }
                        ]
                    },
                    {
                        "sense_id": "4db7d6fd-e9d5-3ed3-a6aa-5f3dd847db93",
                        "entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
                        "glosses": [
                            "Bien que l’on fait dans un intérêt social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1931077-c06e-4e95-ba3f-4232c4a76f9b",
                                "sense_id": "4db7d6fd-e9d5-3ed3-a6aa-5f3dd847db93",
                                "text": "Bureau de bienfaisance."
                            },
                            {
                                "example_id": "9ab054f4-2379-4116-a240-0b5ae8f496a2",
                                "sense_id": "4db7d6fd-e9d5-3ed3-a6aa-5f3dd847db93",
                                "text": "Président de la Société de Bienfaisance, il prend sa tâche très à cœur, mais l’absence complète de charité et de solidarité l’effare."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e50b99fb-a3e2-4cc9-972e-829a7224bfc5",
                        "source_entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
                        "target_lang_word": "Wohltätigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohltätigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "567700ab-8f19-333c-b888-99824f030878",
                                        "entry_id": "da97ac13-4885-3726-aff6-e021aead38f3",
                                        "glosses": [
                                            "Wille, Bereitschaft, bedürftige Menschen zu unterstützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19acc0d3-d7f7-43c9-bd5a-b9b452998c04",
                                                "sense_id": "567700ab-8f19-333c-b888-99824f030878",
                                                "text": "„Obendrein zeigt sich die Wohltätigkeit des Bayernherzogs am Vortag von Mariä Himmelfahrt, als er zweihundert Gulden unter den Armen der Stadt Linz und unter bedürftige Soldaten verteilen lässt.“"
                                            },
                                            {
                                                "example_id": "b6b3498a-fdd4-404a-a476-b123590f1bab",
                                                "sense_id": "567700ab-8f19-333c-b888-99824f030878",
                                                "text": "„Zeitgenössische Quellen erwähnen lobend die Wohltätigkeit der Kartäuser gegenüber Armen und Kranken sowie die harte Arbeit der Mönche beim Terrassieren des Kartausengeländes und der Weinberge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "beb78155-0238-394f-b0af-666d18794151",
                                        "entry_id": "da97ac13-4885-3726-aff6-e021aead38f3",
                                        "glosses": [
                                            "Handlung, bei der [1] zum Ausdruck kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27342496-3257-4120-ab3d-e2db167b77ff",
                                                "sense_id": "beb78155-0238-394f-b0af-666d18794151",
                                                "text": "„Für seine Wohltätigkeiten wird Louis Peter 1902 von der Gemeinde Alleringhausen zum Ehrenbürger ernannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "746880c2-4438-4df7-87d7-631741846d62",
                        "source_entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
