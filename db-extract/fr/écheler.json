                ],
                "senses": [
                    {
                        "sense_id": "ada58090-15eb-3f4d-8d50-e9f5b531b14a",
                        "entry_id": "bc285aaf-33fb-355f-b00d-fe9ce2f92e1a",
                        "glosses": [
                            "Escalader en appliquant l’échelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778a21fc-36c4-4c8a-8648-ad2907dfb620",
                                "sense_id": "ada58090-15eb-3f4d-8d50-e9f5b531b14a",
                                "text": "Lequel donjon, qui est le principal corps et édifice de la force et habitation dudit chastel, est environné de bien hautes murailles qu'il serait impossible d’écheler, pourvues de six hautes tours belles et spacieuses d'assez antique édifice, […]"
                            },
                            {
                                "example_id": "17d912b8-e267-41a4-82ef-8b038c331d63",
                                "sense_id": "ada58090-15eb-3f4d-8d50-e9f5b531b14a",
                                "text": "L'on doit croire, et je le proteste, que Paris me seroit une prison effroyable, si j'y étois retenue contre le gré de mes légitimes supérieurs, et plutôt je tâcherois d’écheler les murailles de la ville pour m'échapper."
                            },
                            {
                                "example_id": "da1437fa-7f57-4b56-926e-3092b6e6f875",
                                "sense_id": "ada58090-15eb-3f4d-8d50-e9f5b531b14a",
                                "text": "Je ne vois écheler ni rempart ni muraille"
                            }
                        ]
                    },
                    {
                        "sense_id": "47f73927-d116-3c4c-b05f-29f3be87cb72",
                        "entry_id": "bc285aaf-33fb-355f-b00d-fe9ce2f92e1a",
                        "glosses": [
                            "Échelonner."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e1778164-284f-3f35-85ac-b3589d74969a",
                        "entry_id": "bc285aaf-33fb-355f-b00d-fe9ce2f92e1a",
                        "glosses": [
                            "Exposer un criminel sur une échelle pour lui faire faire amende honorable."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "a47e1f52-f22b-4ba4-8abf-0fb1ef0be699",
                                "sense_id": "e1778164-284f-3f35-85ac-b3589d74969a",
                                "text": "Celui qui a Haute-Justice a juridiction puissance & connoissance des cas requérans mort & dernier supplice, mutilation, incision de membres & autres peines corporelles comme fustiger, pilorier, écheler, bannir, marquer, déporter & autres semblables."
                            }
                        ]
                    }
