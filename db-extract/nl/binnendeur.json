                "senses": [
                    {
                        "sense_id": "6ce86424-1184-303a-9465-a9cd87d57f30",
                        "entry_id": "33332704-85c8-3f56-9c0b-a319428dde23",
                        "glosses": [
                            "een afsluiting tussen twee ruimtes in een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c2e7412-78dd-4abb-9571-646447aa4846",
                                "sense_id": "6ce86424-1184-303a-9465-a9cd87d57f30",
                                "text": "Het sluiten van binnendeuren voor het slapen gaan geeft bijna drie keer zoveel tijd om te vluchten bij brand. Dat blijkt uit een praktijkproef van de Brandwonden Stichting en de brandweer. Gesloten deuren houden de rook – de grootste bedreiging bij brand – nog enige tijd buiten de slaapkamer."
                            },
                            {
                                "example_id": "87170f68-feaa-46e2-8634-d47b671cf981",
                                "sense_id": "6ce86424-1184-303a-9465-a9cd87d57f30",
                                "text": "Een gordijn aan de deur vloog in brand, maar kon snel worden gedoofd. De voordeur was verwoest en er sneuvelde ook een raam verderop in de gang. Door de luchtdruk van de ontploffing zit er een barst in een binnendeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "682ba485-ef70-35ae-9209-51085966f9c2",
                        "entry_id": "33332704-85c8-3f56-9c0b-a319428dde23",
                        "glosses": [
                            "de deur van een getijdesluis die aan de de kant ligt waar geen eb en vloed heersen"
                        ],
