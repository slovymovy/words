                                        "sense_id": "acb32e35-4c74-32e4-bbd6-c2f76705dbc0",
                                        "entry_id": "96778dde-6749-3ca5-a3a9-85015b04dd54",
                                        "glosses": [
                                            "eines der zwölf Tierkreiszeichen (der umgangssprachlich so genannten Sternzeichen)"
                                        ],
