                "senses": [
                    {
                        "sense_id": "4cb06f90-2169-38b5-971f-484588e0338b",
                        "entry_id": "c7627c17-53b2-3d10-bb3b-ba4806ca8c5f",
                        "glosses": [
                            "Herbststurm, der im November vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c155963-2cc1-46a1-b98f-94a8944db1a7",
                                "sense_id": "4cb06f90-2169-38b5-971f-484588e0338b",
                                "text": "„Es wehte ein starker Novembersturm, und sie spürte die Kälte durch die Scheibe.“"
                            },
                            {
                                "example_id": "15181844-2876-4309-889d-f320b7c365be",
                                "sense_id": "4cb06f90-2169-38b5-971f-484588e0338b",
                                "text": "„Missmutig verließ er das Gebäude und stellte sich draußen wieder dem Regen und dem Novembersturm.“"
                            },
                            {
                                "example_id": "9d0c559a-a969-429e-8e43-c17d1e3eff9f",
                                "sense_id": "4cb06f90-2169-38b5-971f-484588e0338b",
                                "text": "[übertragen:] „Durch meinen Kopf wirbelten unentwegt Gedankenfetzen wie dürres Herbstlaub im Novembersturm.“"
                            },
                            {
                                "example_id": "6add4a60-ad2f-4021-a69b-53fcbcfb0285",
                                "sense_id": "4cb06f90-2169-38b5-971f-484588e0338b",
                                "text": "„Draußen tobte der Novembersturm in all seinem Getöse, doch in dem Schlafgemach des Schloßherrn von Brandungen herrschte eine Stille, die an Herz und Nerven zerrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
