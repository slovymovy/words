                        ],
                        "examples": [
                            {
                                "example_id": "1f91ec0b-1e13-4831-946d-a655a388f0f8",
                                "sense_id": "1ab578bc-438b-326d-bc9d-ebd9384b18ef",
                                "text": "La seule chose à faire, c'était de dire ce que tout le monde sait, c'est que le virus n’a plus tellement d’énergie, il est tout mouligas."
                            },
                            {
                                "example_id": "9525fc78-85cf-460c-b6d7-99bf4c0902cb",
                                "sense_id": "1ab578bc-438b-326d-bc9d-ebd9384b18ef",
                                "text": "Il est tout faible, tout mouligas. Y en a qui disent que c'est les globules qui z'y manquent."
                            }
                        ]
                    }
