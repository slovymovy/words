                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4d492d0-9415-4344-9db0-9155c4c066a5",
                                                "sense_id": "e65fd1bd-fd54-3f10-a510-71f72223b023",
                                                "text": "Un. Peut être. La Pannonie n’est pas la France, elle n’est pas la patrie reposant sur les libres traditions anticléricales et satiriques de Voltaire (Écrasez l’infâme). La Pannonie n’est pas la patrie des Charlie-s. Ici, on n’est pas Charlie."
                                            }
                                        ]
