                "senses": [
                    {
                        "sense_id": "d13485f2-ec64-3447-8e1a-75730b8f1569",
                        "entry_id": "c91e4539-1f44-3c13-a965-2669a731e7db",
                        "glosses": [
                            "To cause great offense to (someone)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "92d9dbd3-323d-47ab-84a6-37ce5a800f72",
                                "sense_id": "d13485f2-ec64-3447-8e1a-75730b8f1569",
                                "text": "Woe to thee who art often wandering abroad, and spendest thy time unprofitably, and scandalizest others."
                            },
                            {
                                "example_id": "cfdc135f-3ca1-4c8c-af00-263b4a023712",
                                "sense_id": "d13485f2-ec64-3447-8e1a-75730b8f1569",
                                "text": "Thou scandalizest me and irritatest my nature as much as it possibly can be irritated."
                            },
                            {
                                "example_id": "3ca2ff38-f4ce-42a2-8797-44c9aea1c0fb",
                                "sense_id": "d13485f2-ec64-3447-8e1a-75730b8f1569",
                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                            }
                        ]
                    },
                    {
                        "sense_id": "02cdc18b-a7e4-3249-a4c1-071763b84f3a",
                        "entry_id": "c91e4539-1f44-3c13-a965-2669a731e7db",
                        "glosses": [
                            "To reproach."
