                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e377f9e-178b-492f-948f-8a13381be26e",
                                                "sense_id": "a4fc1fe6-eeb3-3b9c-adc3-ae7bd47840e4",
                                                "text": "Some of the people I talked to said it could be done—but it would cost big money. More grease than I’d ever dreamed of."
                                            }
                                        ]
