                        "cross_references": [
                            {
                                "target_word": "interstitial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0106b71-938e-3cde-9db9-c13b9a6ec118",
                                        "entry_id": "cdcaf56f-c12b-374a-8126-c846adf3778f",
                                        "glosses": [
                                            "Of, relating to, or situated in an interstice."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa7acd48-a2d1-47ed-a1fe-9504beab8a59",
                                                "sense_id": "a0106b71-938e-3cde-9db9-c13b9a6ec118",
                                                "text": "The novel's interstitial chapters."
                                            },
                                            {
                                                "example_id": "d7ee21b3-0591-4ded-aab9-595f61eef699",
                                                "sense_id": "a0106b71-938e-3cde-9db9-c13b9a6ec118",
                                                "text": "The outer surface is covered with variable amounts of dental plaque and saliva. The inner surface is bathed in interstitial fluid or lymph."
                                            },
                                            {
                                                "example_id": "11cb142e-2ed1-42a3-9309-7dc17fada5cb",
                                                "sense_id": "a0106b71-938e-3cde-9db9-c13b9a6ec118",
                                                "text": "That he ran the risk of blowing out the stained-glass windows was of no consequence since no one liked them anyway, and the paper mill fumes were gnawing at the interstitial lead."
                                            },
                                            {
                                                "example_id": "1252628e-039e-42dc-808c-d34df1feb1c6",
                                                "sense_id": "a0106b71-938e-3cde-9db9-c13b9a6ec118",
                                                "text": "The interstitial fluid is located between cells and the capillaries. This fluid provides a bridge between the fluid in the intravascular compartment and the intracellular compartment. Chemicals in the blood must pass through the interstitial fluid if they are to reach cells."
                                            },
                                            {
                                                "example_id": "505aeda8-f7a5-453c-98d8-db41ea2e3670",
                                                "sense_id": "a0106b71-938e-3cde-9db9-c13b9a6ec118",
                                                "text": "Whitney is absorbed especially by Dublin's unglamorous interstitial zones: the new housing estates and labyrinths of roads, watercourses and railways where the city peters into its commuter belt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interstitial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd958021-1336-3eea-a015-850311679b9d",
                                        "entry_id": "0c2212ec-63c4-3aab-8845-8b34c8d82d45",
                                        "glosses": [
                                            "A web page, usually carrying advertising, displayed when leaving one content page for another."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d39b3e7-6c39-42df-815e-0df9117b3fec",
                                                "sense_id": "bd958021-1336-3eea-a015-850311679b9d",
                                                "text": "An interstitial appeared before the download."
                                            },
                                            {
                                                "example_id": "536bee1e-6280-4cf7-9d37-54ffdd3b876d",
                                                "sense_id": "bd958021-1336-3eea-a015-850311679b9d",
                                                "text": "Interstitials should be used sparingly. Display an ad only the first time the user accesses a piece of content, not every time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8894f506-d2fd-3f92-b475-ed9c73905266",
                                        "entry_id": "0c2212ec-63c4-3aab-8845-8b34c8d82d45",
                                        "glosses": [
                                            "An interstitial discontinuity in a crystal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b1e91e-83d2-400a-81b9-d713b8fbc2c0",
                                                "sense_id": "8894f506-d2fd-3f92-b475-ed9c73905266",
                                                "text": "2008, E. G. Seebauer et al., Defect Engineering for Ultrashallow Junctions using Surfaces, in P. J. Timans, E. P. Gusev, H. Iwai, D.-L. Kwong, M. C. Öztürk, F. Roozeboom (editors), Advanced Gate Stack, Source/Drain, and Channel Engineering for Si-Based CMOS 4: New Materials, Processes, and Equipment, ECS Transactions: Volume 13, Issue 1, page 56,\nThe second mechanism, which is the primary focus of the present paper, involves insertion of interstitials into dangling bonds at the surface."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3508177f-d0de-4f41-8ba8-3725e8a89c4f",
                        "source_entry_id": "c082750b-47bc-3e49-b9d0-d99f868bbe29",
                        "source_sense_id": "03d801d5-b5e9-318d-ba5a-88b4831c2017",
                        "target_lang_word": "interstitiel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interstitiel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e801f30b-dddf-3b07-bf35-9f8398004625",
                                        "entry_id": "90dfbbfc-07dc-3d5a-a3bf-7478a9b8153e",
                                        "glosses": [
                                            "Qui se trouve dans les interstices de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51a5cbc4-60e4-4b50-afd3-5bdf74951d41",
                                                "sense_id": "e801f30b-dddf-3b07-bf35-9f8398004625",
                                                "text": "Ces nitrures présentent un troisième type de structure : ce sont des composés interstitiels, dans lesquels les atomes d'azote occupent simplement les intervalles laissés libres par les atomes métalliques."
                                            },
                                            {
                                                "example_id": "5e329ae5-b03a-4258-b293-ecaca05866c0",
                                                "sense_id": "e801f30b-dddf-3b07-bf35-9f8398004625",
                                                "text": "— Il est des lieux, des moments pour nous refuser les satisfactions auxquelles on aspire spontanément, avec, pour conséquence, les deux vies qu'il faut mener, l'une resserrée, décevante, normale, l'autre fertile, interstitielle ou marginale, le tout contradictoire, plein de conflits et de sautes, difficile, fatigant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34cbbf60-fb32-374d-bc5a-6d818d6543ed",
                                        "entry_id": "90dfbbfc-07dc-3d5a-a3bf-7478a9b8153e",
                                        "glosses": [
                                            "Relatif au tissu de soutien qui entoure les éléments différenciés d’un organe, tissu conjonctif, ligaments, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1335adef-7846-4449-ae8f-e2eb2c639128",
                                                "sense_id": "34cbbf60-fb32-374d-bc5a-6d818d6543ed",
                                                "text": "On ne pouvait apprendre qu’à son école la pathologie du cœur et des vaisseaux, les signes prémonitoires de la tuberculose et de la néphrite interstitielle."
                                            },
                                            {
                                                "example_id": "1c92068c-8fbd-4240-868f-66cd2e6421cc",
                                                "sense_id": "34cbbf60-fb32-374d-bc5a-6d818d6543ed",
                                                "text": "Les Lapins vagotomisés et soumis à une t° de 28°C pendant 3 h présentent dans le cytoplasme des cellules hépatiques des vacuomes sous forme de gouttelettes et une infiltration de cellules rondes dans le tissu conjonctif interstitiel."
                                            },
                                            {
                                                "example_id": "a6e727aa-6517-4fe6-95db-7a715bd1d02e",
                                                "sense_id": "34cbbf60-fb32-374d-bc5a-6d818d6543ed",
                                                "text": "La matrice interstitielle contient en particulier les fibronectines, la vitronectine, la thrombospondine, l’élastine et les collagènes I, III et V."
                                            }
                                        ]
                                    }
                                ]
                            },
