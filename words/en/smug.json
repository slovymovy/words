                },
                {
                    "sense_id": "614b21ac-ee9e-3a01-b403-4f256ced2087",
                    "sense_definition": "To make smug, neat, or spruce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>smugged</w> his beard and stroked it fair before entering the hall.",
                            "target_lang_translations": {
                                "tr": "Salona girmeden önce sakalına <w>çeki düzen verdi</w> ve düzeltti."
                            }
                        },
                        {
                            "text": "She took a moment to <w>smug</w> her hair and adjust her collar.",
                            "target_lang_translations": {
                                "tr": "Saçına <w>çeki düzen vermek</w> ve yakasını düzeltmek için bir an durdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "spruce",
                        "smarten"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb meaning to make neat"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Düzenli, şık veya bakımlı hale getirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çeki düzen vermek",
                                "target_lang_sense_clarification": "Bir şeyi veya kendini daha düzgün hale getirmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c924adac-543d-3ca2-9377-cec6d0af2878",
                    "sense_definition": "To seize or confiscate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schoolmaster threatened to <w>smug</w> any toys brought into the classroom.",
                            "target_lang_translations": {
                                "tr": "Okul müdürü, sınıfa getirilen her türlü oyuncağa <w>el koymakla</w> tehdit etti."
                            }
                        },
                        {
                            "text": "The guards were quick to <w>smug</w> the contraband from the prisoners.",
                            "target_lang_translations": {
                                "tr": "Gardiyanlar, mahkumlardan kaçak mallara <w>el koymakta</w> hızlı davrandılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "confiscate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "historical schoolboy slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "El koymak veya müsadere etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "el koymak",
                                "target_lang_sense_clarification": "Bir eşyayı zorla almak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8206f326-d773-39d2-bd2a-d0e0b2279dae",
                    "sense_definition": "To hush up or keep quiet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They tried to <w>smug</w> the scandal before the press could find out.",
                            "target_lang_translations": {
                                "tr": "Basın öğrenmeden önce skandalı <w>örtbas etmeye</w> çalıştılar."
                            }
                        },
                        {
                            "text": "The details of the agreement were <w>smugged</w> by those in power.",
                            "target_lang_translations": {
                                "tr": "Anlaşmanın detayları yetkililer tarafından <w>örtbas edildi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hush up",
                        "suppress"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Üstünü örtmek veya gizlemek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "örtbas etmek",
                                "target_lang_sense_clarification": "Bir olayı veya gerçeği gizlemek."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
