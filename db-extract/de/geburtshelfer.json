                "senses": [
                    {
                        "sense_id": "8824cc0c-8f47-3f49-8fe9-c78c7c4e761f",
                        "entry_id": "ec056eb5-327f-346a-9d49-35f6d8cf818d",
                        "glosses": [
                            "Person, die eine Gebärende bei der Geburt unterstützt und den Geburtsvorgang begleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f220fa00-f26f-4590-9ae6-b455ead20a94",
                                "sense_id": "8824cc0c-8f47-3f49-8fe9-c78c7c4e761f",
                                "text": "Eine Hausgeburt sollte nur unter Aufsicht eines fachkundigen Geburtshelfers durchgeführt werden."
                            },
                            {
                                "example_id": "c1f0139f-3cf4-4612-9078-61d9a10a4d4f",
                                "sense_id": "8824cc0c-8f47-3f49-8fe9-c78c7c4e761f",
                                "text": "Bei der Geburt des Kalbes wurde der Knecht zum Geburtshelfer."
                            },
                            {
                                "example_id": "93f685e6-9147-4bcd-b134-a63006cf54c5",
                                "sense_id": "8824cc0c-8f47-3f49-8fe9-c78c7c4e761f",
                                "text": "„Zuletzt hängt er ein Gespräch an zwischen einen erfahrnen Geburts-Helfer und einer unerfahrnen Wehmutter, worinnen der grosse Schaden, den diese ofters verursachen, angezeigt wird, welchen ein verständiger Geburts-Helfer abzuwenden fähig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96a94282-3113-3af8-88b1-339f7da2e46f",
                        "entry_id": "ec056eb5-327f-346a-9d49-35f6d8cf818d",
                        "glosses": [
                            "Initiator/Verursacher von etwas Neuem"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "5024fc25-6f1b-44bc-a02a-b600b0c54784",
                                "sense_id": "96a94282-3113-3af8-88b1-339f7da2e46f",
                                "text": "„Viele Experten sehen das Alkoholverbot sogar als Geburtshelfer der organisierten Kriminalität in den USA.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c13f4b2-e754-4929-9d3a-f95bac30c707",
                        "source_entry_id": "ec056eb5-327f-346a-9d49-35f6d8cf818d",
                        "source_sense_id": "8824cc0c-8f47-3f49-8fe9-c78c7c4e761f",
                        "source_sense_description": "Person, die eine Gebärende bei der Geburt unterstützt und den Geburtsvorgang begleitet",
                        "target_lang_word": "(male) midwife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c0b68ae0-7ff4-46d6-ae63-39ee8875bb5f",
                        "source_entry_id": "ec056eb5-327f-346a-9d49-35f6d8cf818d",
                        "source_sense_id": "8824cc0c-8f47-3f49-8fe9-c78c7c4e761f",
                        "source_sense_description": "Person, die eine Gebärende bei der Geburt unterstützt und den Geburtsvorgang begleitet",
                        "target_lang_word": "акушер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "акушер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8f44f773-9da2-33ac-bc06-0e559c82867d",
                                        "entry_id": "3d05fb3c-5598-3ca5-9e81-08c9a01a20dd",
                                        "glosses": [
                                            "врач, специализирующийся на проблемах беременности и родов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ccb2d98-3dee-4c4b-9eed-fc8dec1d49f2",
                                                "sense_id": "8f44f773-9da2-33ac-bc06-0e559c82867d",
                                                "text": ".. муки, предшествовавшие моему рождению, удивили матушку самым неприятным образом .. Надобно было позвать акушера, который нашёл нужным пустить кровь .. Кровь пустили, и вскоре после этого явилась на свет я .."
                                            },
                                            {
                                                "example_id": "23045b09-e4d4-4ae5-b3d9-b8f0b43711c5",
                                                "sense_id": "8f44f773-9da2-33ac-bc06-0e559c82867d",
                                                "text": "Хотя дядюшке весьма хотелось предоставить беременность графини благотворной силе природы, но, подумав немного, он признал за лучшее согласиться на желание молодых и вместо природы ввериться хорошему акушеру .."
                                            },
                                            {
                                                "example_id": "4c678f62-9664-4135-a544-8738d41a096d",
                                                "sense_id": "8f44f773-9da2-33ac-bc06-0e559c82867d",
                                                "text": "Зина не могла застегнуть лифа; ходила в широких блузах, необыкновенно шедших к её высокой фигуре, и беспрестанно совещалась с докторами и акушерами. Она готовилась быть матерью .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
