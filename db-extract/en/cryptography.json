                                        "sense_id": "7f982b76-4f4d-356f-b231-e351fcbf6eeb",
                                        "entry_id": "64b5163f-10fe-3353-8c25-53d2b04292b9",
                                        "glosses": [
                                            "een notatiesysteem dat bedoeld is alleen voor bepaalde personen leesbaar te zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f3ab37f-8df5-4ddb-a589-c86817b211f1",
                                                "sense_id": "7f982b76-4f4d-356f-b231-e351fcbf6eeb",
                                                "text": "Het ontwerp van geheimschriften is al eeuwenlang een bezigheid van de mensheid."
                                            }
                                        ]
