                                "target_senses": [
                                    {
                                        "sense_id": "8eaac6ec-220f-36b7-920d-bfb37cf71c03",
                                        "entry_id": "6be095ef-e18b-3274-a810-59ffb648b983",
                                        "glosses": [
                                            "Se dit des mouvements qui se font en temps égaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bd61b9-042f-41f3-83d3-34cb52b146b6",
                                                "sense_id": "8eaac6ec-220f-36b7-920d-bfb37cf71c03",
                                                "text": "Mais où rencontrer des cœurs assez parfaitement isochrones, passez-moi cette expression scientifique, pour arriver à cette union céleste ?"
                                            },
                                            {
                                                "example_id": "bf6cb439-3aeb-40ce-a5e1-0be417d5d292",
                                                "sense_id": "8eaac6ec-220f-36b7-920d-bfb37cf71c03",
                                                "text": "Seigneur le Christ est nu jetez jetez sur lui\nLa robe sans couture éteignez les ardeurs\nAu puits vont se noyer tant de tintement d’heures\nQuand isochrones choient des gouttes d’eau de pluie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d85cca-ea2c-3741-8b16-6f6dacc23441",
                                        "entry_id": "6be095ef-e18b-3274-a810-59ffb648b983",
                                        "glosses": [
                                            "Caractérise des oscillations ou un mouvement ondulatoire dont la période reste constante quelle que soit l’amplitude."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
