                        "examples": [
                            {
                                "example_id": "884b1ee7-9749-45ad-a361-68625ab61ca4",
                                "sense_id": "12e475b8-f08e-36fa-94c3-37926f2ba6f6",
                                "text": "Passagiers zullen na ongeveer anderhalf uur stijgen zo’n twee uur lang de aardkluit mogen bewonderen vanuit de drukcabine. Daarna wordt de capsule losgekoppeld van de ballon voor de afdaling."
                            },
                            {
                                "example_id": "793ec5bd-23bc-47a8-8d1c-28e0a46042b3",
                                "sense_id": "12e475b8-f08e-36fa-94c3-37926f2ba6f6",
                                "text": "Voorzitter Erna Botjes van Stichting Voedselallergie noemt het voorval 'bizar'. ,,Ik vind het onbeschoft, zegt ze. Het klopt volgens haar dat er in een hoge-drukcabine deeltjes van de noten in de lucht kunnen komen. ,,Dat is een risico. Maar als ze haar een mondkapje hadden gegeven, had ze gewoon kunnen vliegen. Je kunt als vliegtuigmaatschappij ook andere snacks uitdelen."
                            }
