                "senses": [
                    {
                        "sense_id": "da2c69cf-da1d-3f1a-a433-acce0c45562f",
                        "entry_id": "b8382ff6-9419-3f36-a891-cfbe7e791699",
                        "glosses": [
                            "To make more Elizabethan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7303fd-ad9e-4b10-861e-4b9260fc47bf",
                                "sense_id": "da2c69cf-da1d-3f1a-a433-acce0c45562f",
                                "text": "Then after a fortnight's holiday the Players started to Elizabethanize their building."
                            },
                            {
                                "example_id": "51082ae5-8d6f-46d6-9837-3807fc467d82",
                                "sense_id": "da2c69cf-da1d-3f1a-a433-acce0c45562f",
                                "text": "Concerning the revival of the 16th-century stage, Bridges Adams once said to me that whilst it was possible to Elizabethanize your stage, it was impossible to Elizabethanize your audience."
                            },
                            {
                                "example_id": "023c19fd-69bc-4455-a28b-f90d26f18480",
                                "sense_id": "da2c69cf-da1d-3f1a-a433-acce0c45562f",
                                "text": "Moreover, the tendency to “Elizabethanize” the play Hamlet has made many of us think of its milieu as closely contemporary with the later years of Elizabeth I's reign."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
