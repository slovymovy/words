                                                "sense_id": "8eab242b-7fd1-3423-80ba-ad2e7e701a9c",
                                                "text": "The application form was excessively complicated."
                                            },
                                            {
                                                "example_id": "ee617cf0-2fe9-4ef7-8b25-ba8582d116dd",
                                                "sense_id": "8eab242b-7fd1-3423-80ba-ad2e7e701a9c",
                                                "text": "While Rabbit is described by Milne as being excessively “captainish” or bossy, he also receives warm praise, he has frequent visits from Pooh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dc16fbb-73cd-3217-920d-fe35dc465415",
