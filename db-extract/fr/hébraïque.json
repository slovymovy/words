                                        "sense_id": "11261ccb-8e30-3e0d-89f7-297f94248e4e",
                                        "entry_id": "e8eeaa16-e0ca-3a50-b995-60c9b92e60ac",
                                        "glosses": [
                                            "dottrina religiosa ebraica: la disciplina precettistica, lo studio e la sapienza biblica"
                                        ],
