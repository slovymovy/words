                "senses": [
                    {
                        "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                        "entry_id": "0a9f39bc-c981-362b-81b2-6ff2f92759d4",
                        "glosses": [
                            "besonderer Reiz nicht mehr zeitgemäßer Bausubstanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3bb0840-36e3-4baf-adb3-3a3d6d71e0b3",
                                "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                                "text": "„Die Wohnungen verströmen einen Rest an nostalgischem Altbaucharme.“"
                            },
                            {
                                "example_id": "95b5c1f4-4ea0-45dc-930a-a17f77c43b3d",
                                "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                                "text": "„Paul fiel sofort die hohe Decke auf, die den ihm so vertrauten Altbaucharme versprühte, ähnlich wie in Marks Wohnung.“"
                            },
                            {
                                "example_id": "756514f5-bdcd-4c0c-884a-812750184b64",
                                "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                                "text": "„Während die übrige Wohnung ihren begehrten Altbaucharme beibehalten hatte, war die Küche ultramodern.“"
                            },
                            {
                                "example_id": "1c09ad08-4aad-4d88-a63c-1a33f3073276",
                                "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                                "text": "„Sollte es Bürgerfelde werden mit seinen Altbaucharme oder doch lieber das pralle Leben in der Innenstadt?“"
                            },
                            {
                                "example_id": "37fb19be-b3f2-4afa-8752-d6ae5b25f690",
                                "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                                "text": "„Viele Objekte wurden behutsam saniert, manchen aber haben die Bauherren ihren Altbaucharme entrissen.“"
                            },
                            {
                                "example_id": "2ecb7afa-4f66-4841-8afb-de17b7574965",
                                "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                                "text": "„Daher hatte sie nicht den von mir ersehnten Altbaucharme.“"
                            },
                            {
                                "example_id": "d62e8bd4-7205-42ea-9dbc-33ea5b8f9e9f",
                                "sense_id": "225b6d0e-2226-3fb5-8393-75691c65f3ba",
                                "text": "„Zugleich hatte es aber auch seinen Altbaucharme bewahrt, wie etwa die üppigen Kranzleisten und Stuckdecken, die Drew in architektonisches Entzücken versetzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
