                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb15d7e8-d09d-46a8-94de-4bdbd8ea746f",
                                "sense_id": "6c644869-3aca-318d-95ed-33ec861fccfe",
                                "text": "Sylwia pisuje do mnie regularnie raz w miesiącu."
                            },
                            {
                                "example_id": "1ffd9b1d-522a-46ff-bf08-2d7cb06ac150",
                                "sense_id": "6c644869-3aca-318d-95ed-33ec861fccfe",
                                "text": "W biurze pracują trzy Sylwie i dwóch Tomaszów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f938e89e-e3c0-4be8-925f-c0967ca48539",
                        "source_entry_id": "e169a5ae-48cf-38db-a343-5e503bd68b18",
                        "source_sense_id": "6c644869-3aca-318d-95ed-33ec861fccfe",
                        "target_lang_word": "Silvia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silvia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8dca73-dd36-3c87-9ed4-4b679ff5a60b",
                                        "entry_id": "235a71a8-bcff-3fe1-8fe5-1630fbe3c21d",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e93bcd7-e280-4d99-b43e-be418dfb9b10",
                                                "sense_id": "9d8dca73-dd36-3c87-9ed4-4b679ff5a60b",
                                                "text": "Who is Silvia? what is she? / That all our swains commend her? / Holy, fair and wise is she; / The heaven such grace did lend her, / That she might admired be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94327549-0a8f-30d9-8448-51e8df29aa88",
                                        "entry_id": "235a71a8-bcff-3fe1-8fe5-1630fbe3c21d",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07f43cdd-5251-4c5a-bdef-f01955d95ce7",
                        "source_entry_id": "e169a5ae-48cf-38db-a343-5e503bd68b18",
                        "source_sense_id": "6c644869-3aca-318d-95ed-33ec861fccfe",
                        "target_lang_word": "Sylvia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sylvia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e38c71-d26d-34ec-aa15-85cdbaa3a21a",
                                        "entry_id": "14d2b47f-f08f-383a-b6d7-edc727099989",
                                        "glosses": [
                                            "A female given name from Latin, a popular spelling variant of Silvia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b52d13-7dba-4bca-a4cf-f49a04683a86",
                                                "sense_id": "c0e38c71-d26d-34ec-aa15-85cdbaa3a21a",
                                                "text": "What lovely names for girls there are!\nThere's Stella like the Evening Star,\nAnd Sylvia like a rustling tree, […]"
                                            },
                                            {
                                                "example_id": "4bacc98c-c886-42dc-8c5b-ab887dcf5461",
                                                "sense_id": "c0e38c71-d26d-34ec-aa15-85cdbaa3a21a",
                                                "text": "In the brouhaha over the reappointment of Superior Court Judge Sylvia Pressler, we organized massive support - telegramming, telephoning and writing to encourage the State Senate to exercise its advise and consent function responsibly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f957b61-ee5b-374c-aeb7-4b8862e882b6",
                                        "entry_id": "14d2b47f-f08f-383a-b6d7-edc727099989",
                                        "glosses": [
                                            "A minor city in Reno County, Kansas, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "534815d7-73df-3081-8a35-8ecbbb1d709b",
                                        "entry_id": "14d2b47f-f08f-383a-b6d7-edc727099989",
                                        "glosses": [
                                            "Short for Princess Rhea Silvia, the mother of Romulus and Remus, founders of Rome."
                                        ],
                                        "tags": [
                                            "Roman",
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
