                            {
                                "example_id": "9be4e0fa-a70e-43a0-9f5a-8a6d0fb612dd",
                                "sense_id": "c261f542-b01a-3d9e-96ce-7cbb4292eff2",
                                "text": "Der Spieler hat von einem Zuschauer ein Wurfgeschoss an den Kopf bekommen."
                            },
                            {
                                "example_id": "7d2c2f2a-7994-4ad3-821b-6a70f4978455",
                                "sense_id": "c261f542-b01a-3d9e-96ce-7cbb4292eff2",
                                "text": "„Da sowohl die Linden als auch die Wilhelmstraße asphaltiert waren, vermutete der amerikanische Diplomat, dass die Menschenmenge die Wurfgeschosse mitgebracht hatte, es sich also nicht um einen spontanen Ausbruch von Volkszorn handelte, sondern um eine mehr oder minder organisierte Aktion.“"
                            }
