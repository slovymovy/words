                            {
                                "example_id": "ab940da8-b7ac-46e0-a9ef-c15e57b73da8",
                                "sense_id": "f85dc01c-0d89-3fec-9b16-b91bf402f68d",
                                "text": "За молчаливостью прячется глубокий ум."
                            }
                        ]
