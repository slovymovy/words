                            },
                            {
                                "target_lang_word": "w okolicach",
                                "target_lang_sense_clarification": "blisko pewnej wartości"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "左右",
                                "target_lang_sense_clarification": "表示大约的数值"
                            },
                            {
                                "target_lang_word": "大约",
                                "target_lang_sense_clarification": "表示估计的范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f533414-6314-3552-929c-4408f364036a",
                    "sense_definition": "(Mathematics) A set of points containing a specified point, where one can move a small distance from that point without leaving the set.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In topology, a <w>neighborhood</w> of a point includes an open set containing that point.",
                            "target_lang_translations": {
                                "ru": "В топологии <w>окрестность</w> точки включает открытое множество, содержащее эту точку.",
                                "pl": "W topologii <w>otoczenie</w> punktu obejmuje zbiór otwarty zawierający ten punkt.",
                                "zh": "在拓扑学中，一点的<w>邻域</w>包含一个包含该点的开集。"
                            }
                        },
                        {
                            "text": "The algorithm checks the <w>neighborhood</w> of each pixel to determine the filter output.",
                            "target_lang_translations": {
                                "ru": "Алгоритм проверяет <w>окрестность</w> каждого пикселя для определения выходного сигнала фильтра.",
                                "pl": "Algorytm sprawdza <w>otoczenie</w> każdego piksela, aby określić wynik filtra.",
                                "zh": "该算法检查每个像素的<w>邻域</w>以确定滤波器输出。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "(Математика) Множество точек, содержащее указанную точку, где можно переместиться на небольшое расстояние от этой точки, не покидая множества.",
                        "pl": "(Matematyka) Zbiór punktów zawierający określony punkt, w którym można przesunąć się o niewielką odległość od tego punktu, nie opuszczając zbioru.",
                        "zh": "（数学）包含指定点的一个点集，在该集合中可以从该点移动一小段距离而不离开该集合。"
                    },
                    "translations": {
                        "ru": [
