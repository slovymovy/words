                        "examples": [
                            {
                                "example_id": "adcbacaf-f205-4835-a48f-12acbffd55da",
                                "sense_id": "76ad534c-0343-315f-babf-8c13cf41cc26",
                                "text": "Don Manuel se retourna du côté de Camacho ; il le vit occupé à fixer solidement son lazo à la branche d’un arbre. Au bout du lazo il y avait un nœud coulant."
                            },
                            {
                                "example_id": "c68d2ef5-5ee4-4439-9afa-ab8097e31816",
                                "sense_id": "76ad534c-0343-315f-babf-8c13cf41cc26",
                                "text": "Un homme à cheval, après avoir enlacé de son lazo les cornes d’un bœuf, peut traîner ce dernier où il le veut."
                            },
                            {
                                "example_id": "7b2f7d97-3adf-42bf-ae2a-1731665cdddb",
                                "sense_id": "76ad534c-0343-315f-babf-8c13cf41cc26",
                                "text": "Brusquement, à travers le fourré, apparut un animal de grande taille. Baxter, qui venait de développer son lazo, le lança, après l’avoir balancé au-dessus de sa tête."
                            }
                        ]
                    }
