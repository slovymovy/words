                            {
                                "example_id": "e9e7a3d6-6ede-4d48-a8e5-498d6a79f5f3",
                                "sense_id": "e96b4b0a-b6c0-31bd-82ac-8febd4952fae",
                                "text": "And yet zay nothing for me, but devise All the strićt means, to ransackle me o' my money."
                            },
                            {
                                "example_id": "f3522deb-8f56-47f1-933b-b7d7ed730c44",
                                "sense_id": "e96b4b0a-b6c0-31bd-82ac-8febd4952fae",
                                "text": "“You're making it very tough for me,” said Fox. “Someone went into Yerkes Flats last night right under the helicopter cover. They ransackled the place, killed the caretaker —\""
                            },
                            {
                                "example_id": "2e1d172e-36c9-47b0-9e4f-384867ba0a36",
                                "sense_id": "e96b4b0a-b6c0-31bd-82ac-8febd4952fae",
                                "text": "On the latter date, the Black Panther Party offices were ransackled by police; typewriters sashed, the office set on fire; newspapers and food for the breakfast program and supplies for the health clinic destroyed, and the arrestees beaten."
                            },
                            {
                                "example_id": "900bc0c4-e6e1-4ab5-9d4b-3b16fbbda862",
                                "sense_id": "e96b4b0a-b6c0-31bd-82ac-8febd4952fae",
                                "text": "I'd rather the sword drawn in a blink than the slow soul ransackled by the State."
                            }
                        ]
