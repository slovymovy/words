                "senses": [
                    {
                        "sense_id": "1201e729-3c6c-304d-98ba-cd7388ea2b05",
                        "entry_id": "10823ee8-85d2-36bc-ab03-53e03a141044",
                        "glosses": [
                            "kleines Häuschen oder Lichtkasten, in das man eine Kerze einstellen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d74bb06-852f-4ea1-b3f4-23736a953f61",
                                "sense_id": "1201e729-3c6c-304d-98ba-cd7388ea2b05",
                                "text": "„Als Beispiel dafür geben wir eines der Lichthäuschen an der Pfarrkirche zu Botzen (Fig.13), das von einer Console getragen wird, die zunächst auf einem phantastischen Kopfe ruht.“"
                            },
                            {
                                "example_id": "1ba7e094-18ce-44f4-a8a0-460773788dfe",
                                "sense_id": "1201e729-3c6c-304d-98ba-cd7388ea2b05",
                                "text": "„Lichthäuschen oder Lichtnischen erfüllen dieselbe Funktion wie die Totenleuchten und finden sich daher ausschließlich bei Kirchfriedhöfen, durchwegs integriert in der Außenmauer der jeweiligen Pfarrkirche oder des Beinhauses (Karner).“"
                            },
                            {
                                "example_id": "e1ec773d-392c-48d3-ad73-bdf0ad3dba28",
                                "sense_id": "1201e729-3c6c-304d-98ba-cd7388ea2b05",
                                "text": "„Lichthäuschen, sonst kleine Gebäude auf Kirchhöfen zur Aufnahme eines brennenden Lichtes bei Nacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
