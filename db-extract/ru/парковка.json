                "translations": [
                    {
                        "translation_id": "fdf97b12-2149-4318-b55c-a3ce35fa1754",
                        "source_entry_id": "8f1db165-085a-3b2c-ac76-ee6d0efa89d7",
                        "target_lang_word": "parking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da0a0148-8eb7-3144-b389-81131f4f1a7a",
                                        "entry_id": "980b560b-4b7e-3440-96e1-284a81ded0a9",
                                        "glosses": [
                                            "present participle and gerund of park"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51fe2079-cfbf-4423-9fc3-722482a53e13",
                                                "sense_id": "da0a0148-8eb7-3144-b389-81131f4f1a7a",
                                                "text": "Parking a car in a tight spot gave him some satisfaction. (as gerund)"
                                            },
                                            {
                                                "example_id": "e251e020-580a-4466-b93a-2db789fa45f1",
                                                "sense_id": "da0a0148-8eb7-3144-b389-81131f4f1a7a",
                                                "text": "His parking skills needed improvement. (as participial adjective)"
                                            },
                                            {
                                                "example_id": "bcbf949c-7e58-4606-a454-2e418800b680",
                                                "sense_id": "da0a0148-8eb7-3144-b389-81131f4f1a7a",
                                                "text": "They will be parking the aircraft in the desert for the next few months. (as progressive)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efe64e4d-f7d6-33ae-9b76-1159c04cfb03",
                                        "entry_id": "ebc46990-68fb-3f30-bb9e-69606cbf0d94",
                                        "glosses": [
                                            "The action of the verb to park."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e543b07-b6c1-4ccc-8eba-28e460f61930",
                                                "sense_id": "efe64e4d-f7d6-33ae-9b76-1159c04cfb03",
                                                "text": "free parking"
                                            },
                                            {
                                                "example_id": "a8fccf9e-48b1-46d5-9f76-564c36eebcbd",
                                                "sense_id": "efe64e4d-f7d6-33ae-9b76-1159c04cfb03",
                                                "text": "Parking in central London can be very difficult."
                                            },
                                            {
                                                "example_id": "1db59dc5-dcd6-4cd1-a30f-62726efda8a9",
                                                "sense_id": "efe64e4d-f7d6-33ae-9b76-1159c04cfb03",
                                                "text": "Glasgow's car-parking problem is one of the worst in the country and the frequency of the new electrified rail service ought to attract a big clientele from the city's close-packed suburbs."
                                            },
                                            {
                                                "example_id": "cf66c504-361b-4deb-9559-285ce6b0c3ac",
                                                "sense_id": "efe64e4d-f7d6-33ae-9b76-1159c04cfb03",
                                                "text": "Table 6 represents an analysis of the parking usage in the Downtown Business District, in terms of the number of parkings, 8:00 a.m. to 6:00 p.m., according to Type of Facility used, and the Purposes of the Trips […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91714f9f-b73c-35a6-9127-c7dab408cd9e",
                                        "entry_id": "ebc46990-68fb-3f30-bb9e-69606cbf0d94",
                                        "glosses": [
                                            "Space in which to park a car or other vehicle, such as a parking lot or curbside parking."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2cddfc8-4970-45fc-b993-0af7e2314eac",
                                                "sense_id": "91714f9f-b73c-35a6-9127-c7dab408cd9e",
                                                "text": "Near-synonyms: car park, carpark"
                                            },
                                            {
                                                "example_id": "24d06110-5eb9-4074-82d2-9a7b7d01d5ed",
                                                "sense_id": "91714f9f-b73c-35a6-9127-c7dab408cd9e",
                                                "text": "ample parking"
                                            },
                                            {
                                                "example_id": "927cfed6-a260-43d0-be65-6d8c570cea2d",
                                                "sense_id": "91714f9f-b73c-35a6-9127-c7dab408cd9e",
                                                "text": "parking in rear"
                                            },
                                            {
                                                "example_id": "c941a7f6-75e2-4800-8564-6005fb427e16",
                                                "sense_id": "91714f9f-b73c-35a6-9127-c7dab408cd9e",
                                                "text": "Each one of his parkings of securities was a separate count on the indictment."
                                            },
                                            {
                                                "example_id": "dee94293-ccd9-487c-99c0-8ff58e798c70",
                                                "sense_id": "91714f9f-b73c-35a6-9127-c7dab408cd9e",
                                                "text": "It can be difficult to find parking in central London."
                                            },
                                            {
                                                "example_id": "9b29d795-3b29-4350-b45c-a3692e3466fe",
                                                "sense_id": "91714f9f-b73c-35a6-9127-c7dab408cd9e",
                                                "text": "They found his car in a parking thirty miles away; apparently it had been stolen by a joyrider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3964dddc-3773-45f5-a2a9-8aee076f6519",
                        "source_entry_id": "8f1db165-085a-3b2c-ac76-ee6d0efa89d7",
                        "target_lang_word": "Parkhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parkhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97bd407c-e805-3dab-9b55-7fafe84f0da3",
                                        "entry_id": "e71f72b4-3890-3e43-8b0b-4e156d90ef84",
                                        "glosses": [
                                            "meist mehrstöckiges Gebäude, das dem Parken von Fahrzeugen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d382d5b8-e7b2-49b0-b6c8-3beb6b96d63c",
                                                "sense_id": "97bd407c-e805-3dab-9b55-7fafe84f0da3",
                                                "text": "Ein Parkhaus in der Innenstadt entlastet die Straßen und stapelt die Autos in die Höhe."
                                            },
                                            {
                                                "example_id": "a871f4e3-b7e9-487b-bda8-0972feb637bc",
                                                "sense_id": "97bd407c-e805-3dab-9b55-7fafe84f0da3",
                                                "text": "„Eine spektakuläre Hirschjagd durch das Zentrum der Südtiroler Landeshauptstadt Bozen hat am Montag für das Tier mit einem Kopfschuss geendet. Der nahezu 150 Kilo schwere Sechsender war in einem Stiegenaufgang eines Parkhauses steckengeblieben und hatte sich dabei an den Knien schwer verletzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
