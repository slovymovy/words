                    "sense_definition": "iets tot voltooiing brengen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voltooien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heb je je huiswerk voor morgen al <w>afgemaakt</w>?",
