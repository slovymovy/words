{
    "word_family": [
        "kind",
        "unkindly",
        "unkindness",
        "kindness",
        "kindly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "593f9f77-ce72-38f2-85b8-37329a5efde4",
                    "sense_definition": "Lacking kindness, sympathy, or compassion; harsh, unpleasant, or cruel.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very <w>unkind</w> of him to laugh at her mistake in front of everyone.",
                            "target_lang_translations": {
                                "fr": "C'était très <w>méchant</w> de sa part de se moquer de son erreur devant tout le monde."
                            }
                        },
                        {
                            "text": "Try not to make <w>unkind</w> remarks about people when they are trying their best.",
                            "target_lang_translations": {
                                "fr": "Essaie de ne pas faire de remarques <w>désobligeantes</w> sur les gens quand ils font de leur mieux."
                            }
                        }
                    ],
                    "synonyms": [
                        "cruel",
                        "harsh",
                        "mean",
                        "unfriendly"
                    ],
                    "antonyms": [
                        "kind",
                        "friendly",
                        "sympathetic"
                    ],
                    "common_phrases": [
                        "unkind remarks",
                        "unkind words"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui manque de gentillesse, de sympathie ou de compassion ; dur, désobligeant ou méchant."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "méchant",
                                "target_lang_sense_clarification": "qui fait preuve de méchanceté ou de malveillance"
                            },
                            {
                                "target_lang_word": "désobligeant",
                                "target_lang_sense_clarification": "qui manque d'égards, blessant dans ses propos"
                            },
                            {
                                "target_lang_word": "dur",
                                "target_lang_sense_clarification": "sévère, sans compassion"
                            },
                            {
                                "target_lang_word": "peu aimable",
                                "target_lang_sense_clarification": "froid, antipathique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd6991fd-a6d5-3877-8f0b-624ccf0613bf",
                    "sense_definition": "Contrary to nature or normal character; unnatural.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physician described the sudden high fever as an <w>unkind</w> heat that ravaged the patient's body.",
                            "target_lang_translations": {
                                "fr": "Le médecin décrivit la soudaine forte fièvre comme une chaleur <w>contre-nature</w> qui ravageait le corps du patient."
                            }
                        },
                        {
                            "text": "In the old tale, the creature was viewed with suspicion due to its strange and <w>unkind</w> appearance.",
                            "target_lang_translations": {
                                "fr": "Dans le vieux conte, la créature était considérée avec méfiance en raison de son apparence étrange et <w>dénaturée</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unnatural"
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Contraire à la nature ou au cours normal des choses ; contre-nature, anormal (archaïque)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "dénaturé",
                                "target_lang_sense_clarification": "contraire à la nature ou à l'ordre naturel"
                            },
                            {
                                "target_lang_word": "contre-nature",
                                "target_lang_sense_clarification": "anormal, non naturel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25dd4bc3-f183-3194-b0e7-e72317f90c98",
                    "sense_definition": "Having no family, offspring, or kindred; childless.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet lamented that the nobleman would die <w>unkind</w> if he left behind no heir.",
                            "target_lang_translations": {
                                "fr": "Le poète déplorait que le noble meure <w>sans descendance</w> s'il ne laissait aucun héritier derrière lui."
                            }
                        },
                        {
                            "text": "Without descendants to preserve the lineage, the ancient lord passed away solitary and <w>unkind</w>.",
                            "target_lang_translations": {
                                "fr": "Sans descendants pour perpétuer la lignée, l'ancien seigneur s'éteignit solitaire et <w>sans parenté</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "childless",
                        "kinless"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Sans descendance, sans famille ou sans postérité (obsolète)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sans descendance",
                                "target_lang_sense_clarification": "qui n'a pas d'héritier ou d'enfants"
                            },
                            {
                                "target_lang_word": "sans parenté",
                                "target_lang_sense_clarification": "dépourvu de liens de parenté ou de famille"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}