                                "example_id": "bf370238-fd76-41ae-8199-3606e74b2e17",
                                "sense_id": "36acf50d-d5aa-3a30-87fa-c7ef9220f30d",
                                "text": "— Je sais bien...mais, dit le docteur, à quoi destiné?\n— Un reconstituant, dit Nicolas."
                            }
                        ]
                    }
