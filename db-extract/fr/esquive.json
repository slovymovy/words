                    }
                ],
                "senses": [
                    {
                        "sense_id": "18e45d90-aa81-33a8-80d7-e3ad6edf5c3f",
                        "entry_id": "f6c0345a-a51f-36ed-a68a-33ba6db3cf4f",
                        "glosses": [
                            "Action d'esquiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7178e3-47b4-40fe-81d5-aa269ce9a090",
                                "sense_id": "18e45d90-aa81-33a8-80d7-e3ad6edf5c3f",
                                "text": "Le cheval, effrayé par le claquement d’ailes, et même fouetté d’un corbeau ivre qui donna de la tête dans ses flancs, s’écarta et s’enfuit au galop d’esquive à travers champs en faisant voler les étriers."
                            },
                            {
                                "example_id": "28673f4f-7627-4c96-8a39-ec37f3b67d89",
                                "sense_id": "18e45d90-aa81-33a8-80d7-e3ad6edf5c3f",
                                "text": "Il [Jean-Paul Sartre] ignorait les torpeurs, les somnolences, les fuites, les esquives, les trêves, la prudence, le respect."
                            },
                            {
                                "example_id": "d1ea6019-c267-4564-8fbb-cbc190d27acc",
                                "sense_id": "18e45d90-aa81-33a8-80d7-e3ad6edf5c3f",
                                "text": "Il utilise alors des techniques d’esquive pour éviter de porter jugement sur l’auteur…"
                            },
                            {
                                "example_id": "98dde1da-4d74-43b4-97a2-950d9a5aa349",
                                "sense_id": "18e45d90-aa81-33a8-80d7-e3ad6edf5c3f",
                                "text": "Corbett c’était l'art de l’esquive, il n’y était plus quand le coup arrivait et il frappait juste après celui-ci, il additionnait les points les uns derrière les autres… — (Dinis Machado, Ce que dit Molero, éditions Passage du Nord-Ouest, 2002)"
                            }
                        ]
                    },
                    {
                        "sense_id": "5ac4198a-2a98-39e4-92ef-321f2353abbf",
                        "entry_id": "f6c0345a-a51f-36ed-a68a-33ba6db3cf4f",
                        "glosses": [
                            "Petite pièce de bois de forme tronc-conique, utilisée pour boucher le trou destiné à recevoir un robinet sur un tonneau. On la nomme aussi broche."
                        ],
                        "tags": [
                            "Tonnellerie"
                        ],
                        "examples": []
                    }
