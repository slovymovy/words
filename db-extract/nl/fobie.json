                    {
                        "sense_id": "99680dc6-356c-333a-b163-289eb362fc53",
                        "entry_id": "bd5634a2-f13b-3ccc-91a9-0a89ba4cf86f",
                        "glosses": [
                            "een ziekelijke vrees"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1518cc-a261-44e5-b465-88abe34c1910",
                                "sense_id": "99680dc6-356c-333a-b163-289eb362fc53",
                                "text": "Gelukkig heb ik er geen fobie voor, maar ik ben er wel bang voor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb0acfcb-3234-42f6-a57d-4f504d0b8782",
                        "source_entry_id": "bd5634a2-f13b-3ccc-91a9-0a89ba4cf86f",
                        "source_sense_id": "99680dc6-356c-333a-b163-289eb362fc53",
                        "source_sense_description": "een ziekelijke vrees",
                        "target_lang_word": "Phobie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phobie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f48ee59-133f-36b6-ad7d-a36719818a5a",
                                        "entry_id": "2a6972ee-87f3-3f84-a0cc-4e2b6745581d",
                                        "glosses": [
                                            "krankhafte Angst; krankhafte Furcht; eine unbegründete, anhaltende Angst vor Situationen, Gegenständen, Tätigkeiten oder Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f73bc1b-195d-4e34-90bc-79f1ba7fd068",
                                                "sense_id": "9f48ee59-133f-36b6-ad7d-a36719818a5a",
                                                "text": "Dank Dr. Freud konnte ich von meiner Phobie vor Spinnen geheilt werden."
                                            },
                                            {
                                                "example_id": "ee4b8055-418d-4d7b-bef4-6d23a8892ae8",
                                                "sense_id": "9f48ee59-133f-36b6-ad7d-a36719818a5a",
                                                "text": "Nachts kann ich kein Auge zudrücken, denn ich habe eine Phobie vor Dunkelheit."
                                            },
                                            {
                                                "example_id": "e15b48d7-b245-4ac0-8cf6-dfda492faa20",
                                                "sense_id": "9f48ee59-133f-36b6-ad7d-a36719818a5a",
                                                "text": "Soziale Phobien äußern sich dadurch, dass die Betreffenden Angst vor negativer Bewertung der sozialen Umgebung haben."
                                            },
                                            {
                                                "example_id": "5366826c-22c7-4aaa-a2be-e22d0838f7e6",
                                                "sense_id": "9f48ee59-133f-36b6-ad7d-a36719818a5a",
                                                "text": "Generell treten Phobien bei Frauen etwa doppelt so häufig wie bei Männern auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ebedc9d-4537-3e77-b56b-7f48faca431f",
                                        "entry_id": "2a6972ee-87f3-3f84-a0cc-4e2b6745581d",
                                        "glosses": [
                                            "Angst oder Abneigung jeglicher Art"
                                        ],
                                        "tags": [
                                            "alltagssprachlich, im weiteren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4282a43b-a5c5-4e1d-ae4f-50019ba950f3",
                                                "sense_id": "3ebedc9d-4537-3e77-b56b-7f48faca431f",
                                                "text": "„Im Rahmen dieser Überlegungen ist die unter den Polen verbreitete antirussische Phobie wenig hilfreich.“"
                                            },
                                            {
                                                "example_id": "f1a55a15-f8a8-415c-930e-2160a700244f",
                                                "sense_id": "3ebedc9d-4537-3e77-b56b-7f48faca431f",
                                                "text": "„Seine Phobie gegen Einflüsse aus dem Westen hat auch im Nachbarland so manchen befallen.“"
                                            },
                                            {
                                                "example_id": "ed0b5cc1-e82e-406a-be0d-e36817a79177",
                                                "sense_id": "3ebedc9d-4537-3e77-b56b-7f48faca431f",
                                                "text": "„Die Phobie der Umweltschützer gegen Meyer und seine Meyerwerft in Papenburg, der zuliebe die Ems tiefer ausgebaggert werden soll, kann es doch nicht sein.“"
                                            },
                                            {
                                                "example_id": "7d9bc16b-be3d-4596-95f6-d5fc4880f872",
                                                "sense_id": "3ebedc9d-4537-3e77-b56b-7f48faca431f",
                                                "text": "„Wir kennen die USA genug, um die USA zu fürchten, und wir sind fast schon Amerikaner genug, um an den Phobien dieser Nation teilzuhaben.“"
                                            },
                                            {
                                                "example_id": "d1473f0d-a2cd-46e4-bcf0-6384eb77ff94",
                                                "sense_id": "3ebedc9d-4537-3e77-b56b-7f48faca431f",
                                                "text": "„Am schlimmsten ist, dass Interessen und Phobien der Höflinge der Macht mit historisierenden Argumenten als Sehnsüchte des \"Volkes\" ausgegeben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deaf69a4-55b7-4e4f-a417-53c28fe391a3",
                        "source_entry_id": "bd5634a2-f13b-3ccc-91a9-0a89ba4cf86f",
                        "source_sense_id": "99680dc6-356c-333a-b163-289eb362fc53",
                        "source_sense_description": "een ziekelijke vrees",
                        "target_lang_word": "phobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8297121e-0b7a-3929-9e3b-2071e4bd9e75",
                                        "entry_id": "7224ed71-237f-335b-a1f3-7eed6074ca18",
                                        "glosses": [
                                            "An irrational, abnormal, or obsessive fear (of something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e710c5f-b5d5-4fbe-8b76-be6f06372151",
                                                "sense_id": "8297121e-0b7a-3929-9e3b-2071e4bd9e75",
                                                "text": "I know someone with a strange phobia of ladders."
                                            },
                                            {
                                                "example_id": "41675179-5d12-49a0-9c41-c0403dc33c87",
                                                "sense_id": "8297121e-0b7a-3929-9e3b-2071e4bd9e75",
                                                "text": "It was when anthropophobia set in, when he was made uneasy by people who walked too close to him, that, sagely viewing his list and seeing how many phobias were now checked, he permitted himself to rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a93dca1-0e43-34e6-9733-d012be691794",
                                        "entry_id": "7224ed71-237f-335b-a1f3-7eed6074ca18",
                                        "glosses": [
                                            "An aversion or dislike (of something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b7d45e7-d370-4064-aceb-cef997bb4ddd",
                                                "sense_id": "8a93dca1-0e43-34e6-9733-d012be691794",
                                                "text": "Some patients have the phobia of light, and others have the phobia of darkness. Another common aversion is that of high places. The phobiac of this type can not sit in the gallery […]"
                                            },
                                            {
                                                "example_id": "9352d428-feb7-4bb1-ad81-ec11ae780ea9",
                                                "sense_id": "8a93dca1-0e43-34e6-9733-d012be691794",
                                                "text": "For some children and their parents, however, it can be difficult to determine when fears are typical and when they are developing into more serious phobias or anxiety disorders. […] But once fears become debilitating or impair daily function, they can be classified as a phobia or anxiety disorder, said Thomas Ollendick, University Distinguished Professor Emeritus of Psychology at Virginia Tech, who is known for his work with children and adolescents."
                                            },
                                            {
                                                "example_id": "d286f92d-7a17-42ab-bd61-40638215df98",
                                                "sense_id": "8a93dca1-0e43-34e6-9733-d012be691794",
                                                "text": "For as interviewer Than Win Htut expressed it, “misunderstandings about, and phobia of, gay life and homosexuality are very common in Burma.” Than Win Htut went on to observe that in Burma[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88d9d0fe-06ef-40b4-b99d-ee8e974c0b02",
                        "source_entry_id": "bd5634a2-f13b-3ccc-91a9-0a89ba4cf86f",
                        "source_sense_id": "99680dc6-356c-333a-b163-289eb362fc53",
                        "source_sense_description": "een ziekelijke vrees",
                        "target_lang_word": "phobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b154b1a0-1a4b-3087-bb38-7b48cdd46c41",
                                        "entry_id": "cccef9cd-3dc4-3659-ad22-9397bc3c1564",
                                        "glosses": [
                                            "Ensemble de troubles psychologiques axés sur un acte ou une entité extérieure capable de susciter une peur morbide et irrationnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce35320c-d367-49bc-817d-2bebfc880e79",
                                                "sense_id": "b154b1a0-1a4b-3087-bb38-7b48cdd46c41",
                                                "text": "Avoir peur de la sorcellerie et avoir une phobie de la sorcellerie sont deux états différents qui pourtant sont très proches."
                                            },
                                            {
                                                "example_id": "ad6520a1-167a-4aa3-9e90-b5fc80670e49",
                                                "sense_id": "b154b1a0-1a4b-3087-bb38-7b48cdd46c41",
                                                "text": "Gênée par mon corps, je développai des phobies : je ne supportais pas, par exemple, de boire dans un verre où j’avais déjà bu."
                                            },
                                            {
                                                "example_id": "85bc887b-c2d2-4177-8404-14e81001e3da",
                                                "sense_id": "b154b1a0-1a4b-3087-bb38-7b48cdd46c41",
                                                "text": "Madame Kell souffre d’angrophobie. Elle a peur de se mettre en colère, chose qui peut paraître humainement naturel et qui pourtant, hante sa vie. C'est une phobie que l'on dit impulsive."
                                            },
                                            {
                                                "example_id": "d17e4a22-6cff-4272-b184-0ab561e9da97",
                                                "sense_id": "b154b1a0-1a4b-3087-bb38-7b48cdd46c41",
                                                "text": "Ce B.A-BA des phobies dresse un inventaire assez vaste des quelque six cents phobies répertoriées dans le monde. Il les sectionne en trois grandes parties distinctes : les phobies physiques (la claustrophobie, la thalassophobie, l’anémophobie…), les phobies mentales (l’agoraphobie, la bacillophobie, l’anorgasmophobie, la cafféapullophobie…) et les phobies animales (l'arachnophobie, la batracophobie, la musophobie…)."
                                            },
                                            {
                                                "example_id": "0a422225-cf24-45d8-9316-3ac42cc37a45",
                                                "sense_id": "b154b1a0-1a4b-3087-bb38-7b48cdd46c41",
                                                "text": "D'après l'Institut national de la santé mentale (NIMH), 8,7% des Américains (19 millions de personnes, dont 2 fois plus de femmes que d'hommes) sont atteints en 2018 de « phobies spécifiques » comme la germophobie ou l’émétophobie, qui se manifestent par des crises d'anxiété incontrôlables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b09a811-6d28-3133-be32-5e89c18cd272",
                                        "entry_id": "cccef9cd-3dc4-3659-ad22-9397bc3c1564",
                                        "glosses": [
                                            "Haine, aversion ou mépris à l’égard d’un groupe social."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc7400d0-aa7b-483b-9325-7dd846b97dbb",
                                                "sense_id": "2b09a811-6d28-3133-be32-5e89c18cd272",
                                                "text": "Nos contemporains aiment inventer des phobies à la tonne. De la xénophobie à l’homophobie en passant par l’europhobie, la transphobie, l’handiphobie et l’islamophobie, nous avons transformé en maladie mentale ou en trouble psychologique n’importe quel désaccord avec l’idéologie dominante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
