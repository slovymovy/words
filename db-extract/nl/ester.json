                                            {
                                                "example_id": "6251dae0-8bf9-48ec-8085-7de4c9fdf7df",
                                                "sense_id": "481e37d6-6274-385f-8e3e-daf18667892b",
                                                "text": "„1971 führte [Alice] Schwarzer mit Esther Vilar, die ihr einen das weibliche Gemüt missverstehenden ‹männlichen Feminismus› vorwarf, ein zwar heftiges und aggressives, aber ernsthaftes Gespräch vor der nichtssagenden Kulisse eines Aufnahmestudios.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54529fb2-b6f0-35bb-adbd-9b48c74d37dd",
                                        "entry_id": "bc40b7d7-2bec-3b67-a63d-ca263ebf2ad8",
                                        "glosses": [
                                            "Der Vorname Esther stammt aus der Bibel. Seine genaue Herkunft ist ungeklärt. Esther wird sowohl mit dem hebräischen estēr ‚junge Frau‘ als auch mit dem altpersischen *star oder *stareh ‚Stern‘ als auch mit der babylonischen Göttin Ištar in Verbindung gebracht. Zudem kann der Name auch für ‚Myrthe‘ stehen, wenn man in ihm die persische Übersetzung des hebräischen Namens Hadassa ‚Myrthe‘ erblickt, den die Königin Ester aus dem Buch Ester getragen hat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
