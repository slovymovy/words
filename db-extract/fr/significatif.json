        "fr-extract.jsonl": [
            {
                "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                "word": "significatif",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c776f18-fd7f-4338-ab93-590637d4bdd9",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "significatifs"
                    },
                    {
                        "form_id": "ab05a46f-7048-4b7d-86a9-57b4a30d0a79",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "significative"
                    },
                    {
                        "form_id": "c7f463b5-707e-40c7-8813-5ebd258553fd",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "significatives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d5dedca-29a0-3891-8377-f63ddf293901",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "glosses": [
                            "Qui exprime bien, qui a une signification claire et précise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f1db4af-e25d-467a-aae1-78a30ac6c66b",
                                "sense_id": "8d5dedca-29a0-3891-8377-f63ddf293901",
                                "text": "Dans ce cas, l’addition d’un acaricide à l’aphicide ajoute donc de façon toujours significative 20,1 % de production."
                            },
                            {
                                "example_id": "7e054c62-cd95-4531-95ee-02de902ca777",
                                "sense_id": "8d5dedca-29a0-3891-8377-f63ddf293901",
                                "text": "En aucun cas, des différences significatives de rendement n’ont pu être mises en évidence entre l’association diméfuron + carbétamide, même à dose double de la normale, et les témoins."
                            },
                            {
                                "example_id": "87d0be15-20c6-4a35-88c7-451fdfe9f305",
                                "sense_id": "8d5dedca-29a0-3891-8377-f63ddf293901",
                                "text": "Nous avons constaté qu’une augmentation d’un microgramme par mètre cube d’air (1 µg/m³) dans la moyenne de long terme de l’exposition aux PM2,5 se traduisait par une augmentation du taux de mortalité statistiquement significative de 11%."
                            }
                        ]
                    },
                    {
                        "sense_id": "69bfba63-927c-3a8b-9595-0086a3891118",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "glosses": [
                            "Relatif à la signification."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9e6cb46d-b9c1-43e3-b1a5-9b7497de31a8",
                                "sense_id": "69bfba63-927c-3a8b-9595-0086a3891118",
                                "text": "Les unités significatives sont généralement désignées sous le nom de signes, leur sens étant dit signifié et leur forme parlée signifiant; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "31f80847-4bcf-355f-b576-c8da92a41961",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "glosses": [
                            "Qui exprime nettement la pensée, l’intention de celui qui le fait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec21dd67-df99-4b55-8068-39cb6cf7e57c",
                                "sense_id": "31f80847-4bcf-355f-b576-c8da92a41961",
                                "text": "Après avoir calculé le temps nécessaire pour sortir de la cuisine et venir tirer le cordon placé sous la porte, il resonna encore de manière à produire un carillon très significatif."
                            }
                        ]
                    },
                    {
                        "sense_id": "5abaacf6-1e0b-3923-855f-bc1d93746d17",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "glosses": [
                            "Important, remarquable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d041d2-7d8c-4143-9550-8c0eb0027f55",
                                "sense_id": "5abaacf6-1e0b-3923-855f-bc1d93746d17",
                                "text": "Parmi ses mesures les plus significatives, on peut citer le G.I. Bill of Rights de juin 1944 ouvrant, entre autres, les collèges et universités aux anciens combattants."
                            }
                        ]
                    },
                    {
                        "sense_id": "e98ba080-ce0d-3898-8026-9b76cbaf881e",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "glosses": [
                            "Qualifie l’ensemble des chiffres certains et du premier chiffre incertain d’une mesure."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9c80f43a-8726-32c5-be7e-293682d2249d",
                        "entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "glosses": [
                            "Qualifie des nombres représentatifs d'une réalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea892c43-7910-4184-95dc-3a3fd6861a2f",
                                "sense_id": "9c80f43a-8726-32c5-be7e-293682d2249d",
                                "text": "Plus d’un millier de rats de laboratoire ont été enrôlés pendant deux ans, et soumis à différentes doses de glyphosate – toutes considérées comme sans effets par la réglementation européenne. Dans tous les groupes d’animaux ayant reçu ces petites doses quotidiennes de l’ herbicide, écrivent les chercheurs, « nous avons observé une augmentation statistiquement significative, dépendante de la dose reçue, de la tendance à développer des tumeurs bénignes ou malignes sur plusieurs tissus »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eebe5cb-3666-4856-b9f5-ed90dcb3d193",
                        "source_entry_id": "bcd24c7b-5c12-3283-9bb7-373e34e38093",
                        "target_lang_word": "significant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "significant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Signifying something; carrying meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d50083ca-d662-4c0b-8221-6eff7a5557ae",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "a significant word or sound"
                                            },
                                            {
                                                "example_id": "d2c50b8b-740b-4b4d-b003-551560ec7572",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "a significant look"
                                            },
                                            {
                                                "example_id": "0ff2e66a-4b93-497b-ac15-80a4e7764b56",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "It was well said of Plotinus, that the stars were significant, but not efficient."
                                            },
                                            {
                                                "example_id": "0f716830-4a7a-49c0-8ae4-2840195b3939",
                                                "sense_id": "08126418-b227-365d-875e-4318d4839cc7",
                                                "text": "As evening came on, it grew prematurely dark and cloudy; while the waves acquired that dull indigo tint so significant of ugly weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Having a noticeable or major effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8e55726-65d0-4ddf-9544-0a5f74ec75c9",
                                                "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                                "text": "That was a significant step in the right direction."
                                            },
                                            {
                                                "example_id": "47cbac15-bf4a-4dda-82ae-98c75a24291c",
                                                "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                                "text": "The First World War was a significant event."
                                            },
                                            {
                                                "example_id": "462558ce-eda5-4528-a32f-318cf6f05823",
                                                "sense_id": "a2456383-cd43-3e08-91dc-6f966976c24c",
                                                "text": "The “little green men”—faces covered, wearing unmarked olive uniforms, speaking Russian and using Russian weapons—have played a significant role in both the occupation of Crimea and the civil war in eastern Ukraine.¹⁹⁶"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f6b8afd-20b7-3342-a1a9-c72d63c7becc",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Reasonably large in number or amount."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a5a22a1-bca2-3b43-8a25-e74996d5fb33",
                                        "entry_id": "0293a9e4-3d61-339a-9019-013f651ec39d",
                                        "glosses": [
                                            "Having a covert or hidden meaning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c0bcc7e-05b9-3d56-aaca-b94638edf67f",
