                ],
                "senses": [
                    {
                        "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                        "entry_id": "cd4ec2ab-84ac-3a7b-8636-33fc006d54c0",
                        "glosses": [
                            "Anteil von durch Recycling aus dem Abfall wiedergewonnen Roh- und Wertstoffen (beispielsweise bei Glas, Altpapier); Quotient: recycelter Abfall / Gesamtabfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bed2d5-6a6d-4c05-bb2e-cf99fa39b548",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "[Metall:] „Die Recyclingquote, der Anteil der tatsächlich wieder verwerteten Getränkedosen, liegt in Deutschland bei etwa 90 Prozent.“"
                            },
                            {
                                "example_id": "75e46259-4a9d-489c-9b78-218f5605c9b3",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„Die Recyclingquote der Siedlungsabfälle stieg von 56 % im Jahr 2002 auf 67,8 % im Jahr 2021.“"
                            },
                            {
                                "example_id": "8801e112-e13d-42bd-8c69-25dfdc37a2a2",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„Bis 2030 müssen die Recyclingquoten bei Kunststoffen um 6,6 Prozentpunkte und die Recyclingquote über alle Materialarten um 2,1 Prozentpunkte gesteigert werden.“"
                            },
                            {
                                "example_id": "f7e2380d-1d9f-45ea-a09d-c6edc27852e4",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„Folgende Recyclingquoten müssen dabei für die einzelnen Materialien erzielt werden: Von Holz müssen 25 %, von Kunststoffen und Aluminium jeweils 50 %, von eisenhaltigen Metallen und Glas jeweils 70 %, und von Papier, Pappe und Karton müssen 75 % recycelt werden.“"
                            },
                            {
                                "example_id": "cbdb6537-c753-4646-a368-179b5cc856ed",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„Nach Berechnungen des Umweltbundesamtes sinkt die Recyclingquote für Kunststoff nach dem neuen Berechnungssystem auf 43 Prozent.“"
                            },
                            {
                                "example_id": "3096d6f2-9bca-473d-ade9-29dfe3923eaa",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "[Deutschland:] „Setzt man die Ausgangsmenge von gut 14 Millionen Tonnen ins Verhältnis zu den 800.000 Tonnen Gebrauchtmaterial, die wieder in die Plastikproduktion fließen, kommt man auf eine harte Recyclingquote von nur 5,6 Prozent.“"
                            },
                            {
                                "example_id": "053cbff2-1fa5-4645-856c-33c4e407be1c",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„Neben der heterogenen Zusammensetzung der Abfälle liegt die geringe Recyclingquote laut dem Bericht vor allem am wachsenden Anteil von verschiedenen Materialien in einem Produkt, also etwa Papier, Kunststoff und Metall, wie das bei Joghurtbechern der Fall ist.“"
                            },
                            {
                                "example_id": "40859b01-5653-4d93-a592-d8b209fa4c7e",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„Die Recyclingquote von Weißblech liegt in Deutschland laut der Gesellschaft für Verpackungsmarktforschung seit Jahren bei um die 90 Prozent.“"
                            },
                            {
                                "example_id": "f3fdc7eb-4c60-4e19-8fd0-99bedbaca8d1",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„In Deutschland fällt die Entsorgung ausgedienter Solarmodule unter das Elektro- und Elektronikgerätegesetz. Danach muss die Recyclingquote bei Solaranlagen bei mindestens 80 Prozent liegen.“"
                            },
                            {
                                "example_id": "5d28ad40-eab8-4f00-a5bf-d42e1df46b38",
                                "sense_id": "21f6dc9d-4e85-37a8-b57f-74b0b92df0bd",
                                "text": "„Bei Beton und Asphalt beträgt die Recyclingquote 95 Prozent, bei Mauerwerk sind es laut Car 68 bis 70 Prozent. Aus Beton lässt sich beispielsweise Betongranulat herstellen, das beim Straßenbau als Tragschichtmaterial Einsatz findet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "20e09a81-84b6-38fc-bc64-45f91fcd384a",
                        "entry_id": "cd4ec2ab-84ac-3a7b-8636-33fc006d54c0",
                        "glosses": [
                            "Anteil recycelter Roh-/Wertstoffe, die in einem Produkt bei der Herstellung verarbeitet werden; Quotient: recycelte Roh-/Wertstoffe / Gesamtmenge der Rohstoffe (in einem Produkt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b6c11f1-5d3e-4741-b096-f67c0420403e",
                                "sense_id": "20e09a81-84b6-38fc-bc64-45f91fcd384a",
                                "text": "„Stahl ist mit 500 Mio. t pro Jahr der weltweit meistrecycelte Industriewerkstoff. Die Recyclingquote von Stahl liegt bei 70 %, die von einzelnen Stahlanwendungen z. T. bei deutlich über 90 %. Aus der hohen Recyclingquote resultiert auch, dass Stahllegierungsmetalle die Metalle mit der höchsten Lebensdauer sind.“"
                            },
                            {
                                "example_id": "89017fc7-05c9-4235-895d-753c003b9eb1",
                                "sense_id": "20e09a81-84b6-38fc-bc64-45f91fcd384a",
                                "text": "[Autobatterien:] „Ende Januar 2021 wurde eine Pilotanlage für das Recycling von Hochvolt-Batterien, die für jährlich 3600 Batterien ausgelegt ist, in Betrieb genommen. Entsprechende Anlagen können an weiteren Standorten errichtet werden. Aktuell werden Batterien aus Test- und Unfallfahrzeugen verarbeitet. Sie soll etwa 2030 hochgefahren werden und ist ausbaubar. VW wird damit seine Recyclingquote von bislang 53 Prozent auf 72 Prozent steigern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
