                "senses": [
                    {
                        "sense_id": "e0065526-3113-310a-8b7d-55a38c651e6a",
                        "entry_id": "af7780c1-c8cc-303f-acdf-51d5a7c8952b",
                        "glosses": [
                            "Donner un caractère paimpolais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f63d1aa-73e6-4bbd-a36f-28b0931ebc8f",
                                "sense_id": "e0065526-3113-310a-8b7d-55a38c651e6a",
                                "text": "Peut être que j'aurais été tenté de « Paimpoliser » d'avantage, le projet d'aménagement du port, mais ce qui a été fait est dans l'esprit de ce que nous imaginions. (sic)"
                            },
                            {
                                "example_id": "d2637159-a7d9-42f0-a147-1014f79c6a20",
                                "sense_id": "e0065526-3113-310a-8b7d-55a38c651e6a",
                                "text": "«Pas paimpolisés»"
                            },
                            {
                                "example_id": "956dbe0d-0ce1-4f4a-bd56-d81af963811e",
                                "sense_id": "e0065526-3113-310a-8b7d-55a38c651e6a",
                                "text": "Se paimpoliser sur la falaise, prendre un bain de minuit sur mon caillou, enlever les ules des jonquilles et les diviser , qu’est ce qu’il y en a des choses plus drôles à faire, que la guerre, ou d’aller voir un échafaud, c’est ben vrai ça… (sic)"
                            }
                        ]
                    }
