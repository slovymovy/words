                "senses": [
                    {
                        "sense_id": "809c0f57-96f5-302f-993d-5203b9fd90d5",
                        "entry_id": "b93b2df2-7e47-32cc-a0de-6db87cb42976",
                        "glosses": [
                            "Mund, Maul bei Mensch und Tier"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "70cadd87-3fa9-442a-8cb3-4020c93d4d7c",
                                "sense_id": "809c0f57-96f5-302f-993d-5203b9fd90d5",
                                "text": "„Große Götter, welch geöltes Göschlein hat der Knirps!“"
                            },
                            {
                                "example_id": "d0e59ee9-2986-4ef0-b963-0cd3a542b1f2",
                                "sense_id": "809c0f57-96f5-302f-993d-5203b9fd90d5",
                                "text": "„In solcher Weis bracht er ein Jahr und sechs Monden hin, um welche Zeit man nach dem Rath der Aerzt ihn anfing auszutragen, und ward nach Angab des Jahn Denyau ein schönes Ochsen-Kärchel gebauet, in selbem kutschirt' man ihn fröhlig umher: und war eine Lust ihn anzusehen, denn er hätt ein hübsch Göschlein, wohl zehn Kinn am Hals, schrie auch fast wenig […]“"
                            },
                            {
                                "example_id": "6233ac4c-09f1-4d6c-abcf-4e84ba904f9e",
                                "sense_id": "809c0f57-96f5-302f-993d-5203b9fd90d5",
                                "text": "„Und als sich bäumte wild mein Pferd, / Da schimpfte mich ein Fröschlein; / Ich war nicht faul und schwang mein Schwert / Und gab ihm eins aufs Göschlein.“"
                            },
                            {
                                "example_id": "79082843-603a-45a1-8179-1d4b0de0fd2d",
                                "sense_id": "809c0f57-96f5-302f-993d-5203b9fd90d5",
                                "text": "„Nur der Sohn, Herr Spindelbein, / Lächelt schelmisch hintendrein — / Denn das ist ein Kritikus, / Der sein Göschlein leeren muss! —“"
                            },
                            {
                                "example_id": "1ea64bfb-235a-43ed-9416-5a59c88f3e15",
                                "sense_id": "809c0f57-96f5-302f-993d-5203b9fd90d5",
                                "text": "„Es saß ein buttig Fröschlein / In Meeresufers Tang, / Und tönt' aus seinem Göschlein / Betrübten Klaggesang“"
                            },
                            {
                                "example_id": "aaa88443-4518-4e73-9e3d-58d874b1bfb0",
                                "sense_id": "809c0f57-96f5-302f-993d-5203b9fd90d5",
                                "text": "„Ich wollte mir mit diesem Thema eigentlich nur die Bestätigung einholen, das man euch pure Ironie mit dem Löffel in das Göschlein stopfen könnte und ihr es nicht merken würdet“."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
