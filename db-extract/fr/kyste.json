                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fde77b3-a0be-3202-b84b-f29356688e96",
                        "entry_id": "0c4ee1d0-ccc8-346b-814d-584d9afa9110",
                        "glosses": [
                            "Formation pathologique, creuse qui renferme des liquides ou autres matières sans que celles-ci ne communiquent avec le reste de l'organisme."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9044c57a-08ae-4434-bc14-1585a612329b",
                                "sense_id": "6fde77b3-a0be-3202-b84b-f29356688e96",
                                "text": "Iᵉʳ Cas, suivi par le docteur Penrose. — Kyste du sein droit sur le point de s’ulcérer ; sein peu volumineux et rempli par le kyste et une masse squirrheuse qui se trouvait plus spécialement au-dessous du mamelon, lequel était lui-même retiré en dedans."
                            },
                            {
                                "example_id": "cbc1b724-8ca3-4963-abea-953242ceb87b",
                                "sense_id": "6fde77b3-a0be-3202-b84b-f29356688e96",
                                "text": "Ces petites tumeurs, bien limitées à leur pourtour, siègent sous le péritoine ou dans l'épaisseur même de la séreuse ; elles contiennent une substance caséiforme, blanc jaunâtre, onctueuse et grasse au toucher, rappelant celle que l'on retrouve dans les kystes dermoïdes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b1e40b9-fb4f-4944-8a8d-35d522eaac34",
                        "source_entry_id": "0c4ee1d0-ccc8-346b-814d-584d9afa9110",
                        "source_sense_id": "6fde77b3-a0be-3202-b84b-f29356688e96",
                        "target_lang_word": "Zyste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zyste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2d24e88-647d-33f3-967c-42faf7638f7c",
                                        "entry_id": "9a0ce541-71e9-3ef0-94f6-cd88220878b2",
                                        "glosses": [
                                            "Zelle bei vielen niederen Tieren und Pflanzen, wie Bakterien und Protozoen, die mit einer dicken Membran umgeben ist und es dem jeweiligen Organismus ermöglicht, widrigen Außenbedingungen zu überdauern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3300f42-5ded-45dc-bccc-f27a01e1645c",
                                                "sense_id": "f2d24e88-647d-33f3-967c-42faf7638f7c",
                                                "text": "„Die Zysten bestimmter Bakterien, z. B. Azotobacter, entstehen durch Umwandlung der lebenden Zelle und haben eine verdickte Zellwand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20436ad0-5c3b-3926-b858-67da77b2baa7",
                                        "entry_id": "9a0ce541-71e9-3ef0-94f6-cd88220878b2",
                                        "glosses": [
                                            "Flüssigkeit enthaltene Geschwulst im Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55623e83-b133-4c87-b8b8-a21410865660",
                                                "sense_id": "20436ad0-5c3b-3926-b858-67da77b2baa7",
                                                "text": "Die Zyste muss schnellstmöglich chirurgisch entfernt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
