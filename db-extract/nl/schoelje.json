        "nl-extract.jsonl": [
            {
                "entry_id": "8a97db9e-8701-320e-b12f-50fb70286a18",
                "word": "schoelje",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "e1c62521-727e-41d6-acd3-25efd11c3f43",
                        "entry_id": "8a97db9e-8701-320e-b12f-50fb70286a18",
                        "tags": [
                            "plural"
                        ],
                        "form": "schoeljes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3840e7ba-8525-3b2a-8064-0f60f63cf4f3",
                        "entry_id": "8a97db9e-8701-320e-b12f-50fb70286a18",
                        "glosses": [
                            "een laaghartig, verdorven persoon; vaak ook gebruikt om een hele groep mee aan te duiden"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0dc37921-eeae-49cd-ada5-c18249f3de79",
                                "sense_id": "3840e7ba-8525-3b2a-8064-0f60f63cf4f3",
                                "text": "Er was een explosie bij een zogeheten flow station, vermoedelijk teweeggebracht door schoelje, maar een woordvoerder ontkende dat er militairen in de buurt waren, laat staan dat er een gewapend treffen zou hebben plaatsgehad."
                            },
                            {
                                "example_id": "ec912bdb-1000-4605-9b46-686a6ddc38b2",
                                "sense_id": "3840e7ba-8525-3b2a-8064-0f60f63cf4f3",
                                "text": "Het schoelje van Midden-Noord maakte het in november dermate bont dat ADO Den Haag morgen zonder publiek moet spelen. De KNVB moet toch wat. Of juist niet? Nee, misschien moet de voetbalbond juist helemaal niets - de club duwt zichzelf steeds verder het moeras in, net zo lang tot het ooit zo roemruchte Alles Door Oefening zichzelf reduceert tot een paar opborrelende gasbellen."
                            },
                            {
                                "example_id": "92913579-fb3f-4666-bd13-79541051cb9d",
                                "sense_id": "3840e7ba-8525-3b2a-8064-0f60f63cf4f3",
                                "text": "Creatief ruziemaken met 210 variaties (de letter s): schijtlijster, schooier, snoodaard, sappie, schrielhannes, smuigerd, smiecht, schobbejak, schlemiel, schelm, schollekop, snotaap, stoethaspel, schoelje, schavuit, snoodaard, sukkelaar, schobbejak, schobbedebonk, schorem, slampamper, sjacheraar, schorriemorrie, serpent, slampamper, snoever, smeerkanis, slapjanus, stuk verdriet, stuk ongeluk"
                            }
                        ]
                    },
                    {
                        "sense_id": "dbe0f30e-99a1-3b59-908e-a30fe4c5a8d6",
                        "entry_id": "8a97db9e-8701-320e-b12f-50fb70286a18",
                        "glosses": [
                            "een arm, berooid persoon"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1e6a110-7eff-4909-82d6-55375892d298",
                        "source_entry_id": "8a97db9e-8701-320e-b12f-50fb70286a18",
                        "source_sense_id": "3840e7ba-8525-3b2a-8064-0f60f63cf4f3",
                        "source_sense_description": "een vervelend iemand",
                        "target_lang_word": "piece of shit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piece of shit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4379f2ac-c793-3ec9-9a66-9c9d937857f6",
                                        "entry_id": "7a4e5ce2-2d0d-3b9c-8169-c5ebd58e5dd5",
                                        "glosses": [
                                            "A bad thing; an object of poor quality."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a4a4e8a-beed-404a-ba04-39f81b8b0440",
                                                "sense_id": "4379f2ac-c793-3ec9-9a66-9c9d937857f6",
                                                "text": "This shirt is a piece of shit."
                                            },
                                            {
                                                "example_id": "19477d30-fc2c-4b4d-97ac-babf1aa980a0",
                                                "sense_id": "4379f2ac-c793-3ec9-9a66-9c9d937857f6",
                                                "text": "Life's a piece of shit / When you look at it / Life's a laugh and death's a joke, it's true"
                                            },
                                            {
                                                "example_id": "367c8698-13f2-4311-a705-3890e0eb5036",
                                                "sense_id": "4379f2ac-c793-3ec9-9a66-9c9d937857f6",
                                                "text": "When Jerry speaks of “The worst piece of shit I ever read,” he is not speaking of the book, Great Balls of Fire, but of the script to the movie."
                                            },
                                            {
                                                "example_id": "03af18a7-40af-4213-a9c8-19a5a7444107",
                                                "sense_id": "4379f2ac-c793-3ec9-9a66-9c9d937857f6",
                                                "text": "Tech-savvy consumers are lining up today to be the first to purchase Sony's brand new stupid piece of shit that doesn't do the goddamn thing it's fucking supposed to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "399a1e67-b06f-303a-b419-7219243a85a6",
                                        "entry_id": "7a4e5ce2-2d0d-3b9c-8169-c5ebd58e5dd5",
                                        "glosses": [
                                            "A despicable person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "offensive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "986c48f1-611e-43c4-b8da-fafea5623751",
                                                "sense_id": "399a1e67-b06f-303a-b419-7219243a85a6",
                                                "text": "And it takes the emphasis off of cruising and sexuality, and makes it more like kind of a party thing, and everybody feels comfortable, and nobody feels like \"I'm a piece of shit 'cause I didn't get somebody tonight,\" and they don't feel so lonely."
                                            },
                                            {
                                                "example_id": "9b742158-8e9a-448f-be7e-d71a75dd6aae",
                                                "sense_id": "399a1e67-b06f-303a-b419-7219243a85a6",
                                                "text": "But then Zhao Jun switched to English and said, “I'll kick your face in, you piece of shit,” and it came out electric fluent, no one laughed. “How dare you call him a piece of shit?” the man's wife shrieked."
                                            },
                                            {
                                                "example_id": "9d3d2604-ae7b-4fae-911b-9a7207c81750",
                                                "sense_id": "399a1e67-b06f-303a-b419-7219243a85a6",
                                                "text": "While ruling is going relatively well for Alicent, motherhood isn’t; her sons have both grown up to be real pieces of shit. Aemond (now played by Ewan Mitchell) has grown from a bullied child into a bullying adult; and it’s obvious from one look into his single eye that the bullied kid we met six years ago has grown up to be the most unhinged kind of sadist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e28940d-cc09-36f5-a9a1-e9bb468eb67c",
                                        "entry_id": "7a4e5ce2-2d0d-3b9c-8169-c5ebd58e5dd5",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see piece, of, shit."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
