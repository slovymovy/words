                ],
                "senses": [
                    {
                        "sense_id": "dd98e48a-d31e-33d9-acd4-4bbf3c32ca5c",
                        "entry_id": "b385a37f-e309-3778-9cb5-deae8d918b53",
                        "glosses": [
                            "Faire en sorte que quelque chose qui était commencé ne le soit plus."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d7cdf2f3-8f4f-422c-ad22-6d3cef47fba0",
                                "sense_id": "dd98e48a-d31e-33d9-acd4-4bbf3c32ca5c",
                                "text": "Puis nous avons séjourné au Collège de Beau, où nous avons compris que toute lumière vraiment vivante revient d’une mort ; et commencé à décommencer nos journées."
                            },
                            {
                                "example_id": "6ea355bd-ef15-41b0-b990-472854ce1659",
                                "sense_id": "dd98e48a-d31e-33d9-acd4-4bbf3c32ca5c",
                                "text": "Choisir le moment du propre – l’eau que l’on boit – porter de temps en temps des vêtements neufs – prendre du temps pour tout – en avoir pour tout – petit précis de vivre ensemble – avec beaucoup de courtoisie – énormément d’attention – se définir – se décommencer – et recommencer – des pieds – des mains – des nez – pour rien – alors que la culture de l’immédiateté nous succède – la machine à affranchir est tombée en panne – ce matin j’ai appris la mort accidentelle de dieu – dans un escalier – je crois."
                            },
                            {
                                "example_id": "c660c0ec-95a0-4572-b399-452216f82ba3",
                                "sense_id": "dd98e48a-d31e-33d9-acd4-4bbf3c32ca5c",
                                "text": "essayons de nous décommencer."
                            }
                        ]
                    }
                ],
