                "senses": [
                    {
                        "sense_id": "a4dab490-1aa6-30cd-b1b0-ca5a51e27474",
                        "entry_id": "0a8bb305-2d5a-3c5f-b817-f6e9312bc042",
                        "glosses": [
                            "Donner un caractère comique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c56d06-d2b4-403d-bf97-5911bad773ce",
                                "sense_id": "a4dab490-1aa6-30cd-b1b0-ca5a51e27474",
                                "text": "Son look se comicise d’ailleurs de plus en plus au fil des pages, en même temps que l’encrage gagne en fermeté et en netteté."
                            },
                            {
                                "example_id": "7485ff65-761a-4025-bc58-3bce6fe1ae76",
                                "sense_id": "a4dab490-1aa6-30cd-b1b0-ca5a51e27474",
                                "text": "C'est vrai que c'est violent mais une violence décalée et \"comicisée\" ( ^^ ), perso j'ai adoré ce film au ciné."
                            },
                            {
                                "example_id": "9ee3829b-f825-4118-ac56-8cce4713db20",
                                "sense_id": "a4dab490-1aa6-30cd-b1b0-ca5a51e27474",
                                "text": "Maintenant c'est le style comicisé des XIII/IR$/Largo Winch (oui, ça marche mieux qu'à l'époque de Ric Hochet)..."
                            }
                        ]
                    }
