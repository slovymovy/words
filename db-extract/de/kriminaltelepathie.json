                ],
                "senses": [
                    {
                        "sense_id": "67d6149c-5c07-36ec-9930-f42995e0584c",
                        "entry_id": "a2354325-ad13-3f6d-a059-714f81ab80f0",
                        "glosses": [
                            "Teilgebiet der Kriminalistik, bei der mithilfe vermeintlich telepathischer Fähigkeiten Kriminalfälle aufgeklärt werden sollen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "aeb7f5fb-390e-41b4-b633-f651114b7a3e",
                                "sense_id": "67d6149c-5c07-36ec-9930-f42995e0584c",
                                "text": "„Das Wiener Institut kann als erster Versuch der systematischen Beschäftigung mit der Kriminaltelepathie im deutschsprachigen Raum angesehen werden.“"
                            },
                            {
                                "example_id": "509e1111-474a-483e-a498-f8735f3d417d",
                                "sense_id": "67d6149c-5c07-36ec-9930-f42995e0584c",
                                "text": "„In den 1920er Jahren stellte die Kriminaltelepathie ein außerordentlich öffentlichkeitswirksames und umstrittenes praktisches Anwendungsgebiet des Okkultismus dar.“"
                            },
                            {
                                "example_id": "3ba57a9d-4f18-400c-933b-2854d2866392",
                                "sense_id": "67d6149c-5c07-36ec-9930-f42995e0584c",
                                "text": "„Mit ihrer Einordnung der Kriminaltelepathie als eine neuartige technische Ermittlungsmethode lieferte sie sogleich eines der maßgebenden Interpretationsangebote für die in der Weimarer Republik schnell um sich greifende Praxis.“"
                            },
                            {
                                "example_id": "109f533d-eaa5-4a89-b206-e6d3e3e56353",
                                "sense_id": "67d6149c-5c07-36ec-9930-f42995e0584c",
                                "text": "„Die Kriminaltelepathie wird zwar als manchmal echt angesehen, vor ihrer praktischen Verwendung indessen gewarnt.“"
                            },
                            {
                                "example_id": "f56f80e0-e83a-4c7c-8f46-8162e0c3e879",
                                "sense_id": "67d6149c-5c07-36ec-9930-f42995e0584c",
                                "text": "„Nur durch Kampf gegen die Kritiklosigkeit der Okkultisten können die schweren Gefahren verhütet werden, die der Volksgesundheit und der Rechtssicherheit durch die Kriminaltelepathie drohen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
