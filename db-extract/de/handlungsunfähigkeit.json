                "senses": [
                    {
                        "sense_id": "98865534-fdc0-3e54-a977-bd5424bcf59f",
                        "entry_id": "aa70f29c-4b89-3a16-b0bf-dfc661ae948b",
                        "glosses": [
                            "Zustand, nicht in der Lage zu sein, etwas zu tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a63eef98-89e1-482e-b2f8-cd23cf5ebfdf",
                                "sense_id": "98865534-fdc0-3e54-a977-bd5424bcf59f",
                                "text": "„Lafontaine sagte, die Pflegedebatte belege erneut die Handlungsunfähigkeit der Regierung.“"
                            },
                            {
                                "example_id": "f8418a20-6798-47e7-adeb-6886b298fc2a",
                                "sense_id": "98865534-fdc0-3e54-a977-bd5424bcf59f",
                                "text": "„Polizeipräsident Dieter Glietsch bedauert einen der Fälle, bestreitet aber eine Handlungsunfähigkeit seiner Behörde.“"
                            },
                            {
                                "example_id": "2bd8994e-a4cd-4751-8232-9647754ab5c6",
                                "sense_id": "98865534-fdc0-3e54-a977-bd5424bcf59f",
                                "text": "„Meine mißliche Lage, meine Handlungsunfähigkeit, meine körperliche Hilflosigkeit, meine psychische Gesundheit — das alles wurde mir fast gleichgültig.“"
                            },
                            {
                                "example_id": "fb98df88-cb38-4579-8d55-acaa9ce553f2",
                                "sense_id": "98865534-fdc0-3e54-a977-bd5424bcf59f",
                                "text": "„Wird die Rolle nur teilweise oder unzulänglich ausgefüllt, stellt sich die Frage des darin positionierten Subjekts nach der eigenen Performanz, bzw. seiner Überforderung und daraus resultierenden Handlungsunfähigkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
