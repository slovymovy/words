                    "frequency": "High",
                    "semantic_group_id": "difficulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses entreprises ont dû fermer leurs portes à cause de la <w>crise</w> économique mondiale."
                        },
                        {
                            "text": "Le gouvernement cherche des solutions rapides pour sortir de la <w>crise</w> et relancer l'emploi."
                        }
                    ],
                    "synonyms": [
                        "récession"
                    ],
                    "antonyms": [
                        "prospérité",
                        "essor"
                    ],
                    "common_phrases": [
