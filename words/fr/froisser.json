    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef0b36fb-b89d-3908-abf1-a118856ee2d9",
                    "sense_definition": "Chiffonner ou plisser une étoffe, du papier ou une matière souple.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais attention à ne pas <w>froisser</w> ta chemise avant l'entretien d'embauche."
                        },
                        {
                            "text": "Il a fini par <w>froisser</w> cette lettre importante en la rangeant précipitamment dans sa poche."
                        }
                    ],
                    "antonyms": [
                        "défroisser",
                        "repasser"
                    ],
                    "common_phrases": [
                        "froisser une feuille",
                        "froisser un tissu",
                        "froisser du papier"
                    ]
                },
                {
                    "sense_id": "0cca7d33-78a9-3f52-9f72-4073923d85bc",
                    "sense_definition": "Blesser moralement une personne, heurter sa susceptibilité ou son amour-propre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses remarques maladroites risquent de <w>froisser</w> ses nouveaux collègues lors de la réunion."
                        },
                        {
                            "text": "Elle a pris soin de choisir ses mots afin de ne pas <w>froisser</w> la susceptibilité de son ami."
                        }
                    ],
                    "antonyms": [
                        "ménager",
                        "flatter"
                    ],
                    "common_phrases": [
                        "froisser quelqu'un",
                        "froisser l'amour-propre",
                        "froisser les susceptibilités"
                    ]
                },
                {
                    "sense_id": "e242b5f1-51b1-3911-8dde-4ecf361a398d",
                    "sense_definition": "Meurtrir ou léser une partie du corps par une pression ou un mouvement brusque.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a dû quitter le terrain après s'être <w>froissé</w> un muscle de la cuisse."
                        },
                        {
                            "text": "En soulevant ce lourd carton, il a craint de se <w>froisser</w> le dos pour plusieurs jours."
                        }
                    ],
                    "common_phrases": [
                        "se froisser un muscle",
                        "se froisser un nerf"
                    ]
                },
                {
                    "sense_id": "e284cf26-2363-341d-9222-6348486d89dc",
                    "sense_definition": "Se vexer, manifester du dépit ou de la rancœur face à une parole ou une attitude.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psychologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tendance à se <w>froisser</w> pour un rien dès qu'on émet une légère critique."
                        },
                        {
                            "text": "Ne te <w>froisse</w> pas, je voulais simplement te donner un avis sincère et bienveillant."
                        }
                    ],
                    "common_phrases": [
                        "se froisser pour un rien",
                        "se froisser facilement"
                    ]
                }
            ]
        }
    ]
