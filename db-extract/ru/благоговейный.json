                ],
                "senses": [
                    {
                        "sense_id": "1838ba0c-5555-3065-b022-c5b1cbf7ab86",
                        "entry_id": "e902129e-40b3-372c-9719-210b8663fe5e",
                        "glosses": [
                            "reverent, reverential, respectful"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "8001a660-095f-471e-bd07-c2cd393a20cc",
                                "sense_id": "1838ba0c-5555-3065-b022-c5b1cbf7ab86",
                                "text": "K ба́бушке он пита́л каку́ю-то почти́тельную, почти́ благогове́йную дру́жбу, но пропи́танную тако́й теплото́й, что по тому́ то́лько, как он входи́л к ней, сади́лся, смотре́л на неё́, мо́жно бы́ло заключи́ть, что он люби́л её́ без па́мяти.",
                                "translation": "His attitude to Granny was one of deferential, indeed almost reverential friendliness, but infused with such warmth that by the sheer manner in which he approached her, sat down and looked at her, you could see that he was hopelessly in love with her.",
                                "english": "His attitude to Granny was one of deferential, indeed almost reverential friendliness, but infused with such warmth that by the sheer manner in which he approached her, sat down and looked at her, you could see that he was hopelessly in love with her."
                            }
                        ]
                    }
