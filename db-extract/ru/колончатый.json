                ],
                "senses": [
                    {
                        "sense_id": "9166570a-2bc8-34aa-a1d7-03bbcbaa07a5",
                        "entry_id": "1581291f-1fed-3e87-a208-141225945bb0",
                        "glosses": [
                            "состоящий из нескольких колонок, по форме напоминающий колонку, либо имеющий к колонке иное непосредственное отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620d6667-1625-48ff-a008-950b7a3e546e",
                                "sense_id": "9166570a-2bc8-34aa-a1d7-03bbcbaa07a5",
                                "text": "Создать новый документ с колончатым форматом."
                            },
                            {
                                "example_id": "d37aba3b-b0c5-495b-b24a-8ac9a555d7c8",
                                "sense_id": "9166570a-2bc8-34aa-a1d7-03bbcbaa07a5",
                                "text": "Колончатые модули собирают из миниатюрных элементов по возможности одинаковых габаритов и форм."
                            },
                            {
                                "example_id": "bd95c7bd-56d1-4d27-a5bc-a28945652eca",
                                "sense_id": "9166570a-2bc8-34aa-a1d7-03bbcbaa07a5",
                                "text": "Реверберация и колончатое строение коры головного мозга."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07cd0754-1ee6-42b6-848c-2e7782061ec6",
                        "source_entry_id": "1581291f-1fed-3e87-a208-141225945bb0",
                        "source_sense_id": "9166570a-2bc8-34aa-a1d7-03bbcbaa07a5",
                        "target_lang_word": "cordwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b82ef61-9535-3f78-aacc-2d31de4cbdf2",
                                        "entry_id": "abdad21b-14b0-33c7-87f4-4a608c6aeacc",
                                        "glosses": [
                                            "Wood suitable for use as firewood; firewood cut and split into conveniently sized pieces for easy stacking into cords."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff98b6b2-8215-4276-91cd-b0dd6c168b79",
                                                "sense_id": "6b82ef61-9535-3f78-aacc-2d31de4cbdf2",
                                                "text": "The June rise used to be always luck for me; because as soon as that rise begins here comes cordwood floating down, and pieces of log rafts -- sometimes a dozen logs together; so all you have to do is to catch them and sell them to the wood-yards and the sawmill."
                                            },
                                            {
                                                "example_id": "3d606a2b-000e-4887-8a5f-d3e9ed0397f6",
                                                "sense_id": "6b82ef61-9535-3f78-aacc-2d31de4cbdf2",
                                                "text": "The barkeeper drew beer from two pumps immediately in front of him, and rinsed glasses in some sort of a sink under the edge of the bar. The centre of the room was occupied by a tremendous stove capable of burning whole logs of cordwood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb90903-71f0-398d-a639-e998a84e32fa",
                                        "entry_id": "abdad21b-14b0-33c7-87f4-4a608c6aeacc",
                                        "glosses": [
                                            "Split and cut wood as an economic commodity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec64630-d94e-4afe-b9ec-124d70d5c2e9",
                                                "sense_id": "7eb90903-71f0-398d-a639-e998a84e32fa",
                                                "text": "In addition to being fuel, cordwood can also be used as a fairly pretty building material."
                                            },
                                            {
                                                "example_id": "648b284a-f921-40f2-b816-2d83daff03c8",
                                                "sense_id": "7eb90903-71f0-398d-a639-e998a84e32fa",
                                                "text": "The price of the paper was two dollars a year, but he took in three subscriptions for half a dollar apiece on condition of them paying him in advance; they were going to pay in cordwood and onions as usual, but he said he had just bought the concern and knocked down the price as low as he could afford it, and was going to run it for cash."
                                            },
                                            {
                                                "example_id": "561163d0-5433-4358-a2fa-d65998a08cb8",
                                                "sense_id": "7eb90903-71f0-398d-a639-e998a84e32fa",
                                                "text": "In his earlier days he had been successful both as a small farmer and as a dealer in cordwood and hoop-poles; and many of his ventures in this line had sailed out of the tortuous rivers of South Jersey to Philadelphia, where the wood and the poles then found ready sale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff0232a6-704d-408a-a30e-94dc1f6221af",
