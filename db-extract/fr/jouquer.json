                "senses": [
                    {
                        "sense_id": "7a432cd6-603e-3a22-b428-b8d42aa53065",
                        "entry_id": "038ac767-f04b-3430-9cd8-3c797931cd8c",
                        "glosses": [
                            "Jucher."
                        ],
                        "tags": [
                            "Québec",
                            "Ouest de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "4888152d-04a8-43dd-b77a-4ad40b6f7989",
                                "sense_id": "7a432cd6-603e-3a22-b428-b8d42aa53065",
                                "text": "Notre famille a été chanceuse, parce qu'on est allés se jouquer sur notre montagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfc6836f-471a-31f1-88e9-aa3e081b3ceb",
                        "entry_id": "038ac767-f04b-3430-9cd8-3c797931cd8c",
                        "glosses": [
                            "Se jucher, être perché sur une branche, en parlant des volailles et des oiseaux."
                        ],
                        "tags": [
                            "Québec",
                            "Ouest de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "1f849e10-502d-4a0a-8d34-f8669ecb6723",
                                "sense_id": "cfc6836f-471a-31f1-88e9-aa3e081b3ceb",
                                "text": "Comme je voudrais laisser tomber ce téléphone, couper le fil, scier le poteau que je vois de la fenêtre, sur lequel les oiseaux se jouquent, comme pour me rappeler tout ce qui est interdit."
                            }
                        ]
                    }
