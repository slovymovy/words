                        "examples": [
                            {
                                "example_id": "04f7960c-15df-471c-8c0a-b04d9fc5e04b",
                                "sense_id": "ed5b0763-74f6-346a-992a-4ddceba45943",
                                "text": "Entré chez Peugeot en 1902, ce gadz'arts (Arts et Métiers Angers 1889) est passé à la fois par l'usine et par les succursales de vente."
                            },
                            {
                                "example_id": "f0541719-32a1-49e8-b300-bc8f5b166530",
                                "sense_id": "ed5b0763-74f6-346a-992a-4ddceba45943",
                                "text": "Mon avenir, quoi qu'il arrive, était donc assuré : ou je devenais polytechnicien, ou je devenais un « gadz’arts », mais dans les deux cas, je savais que mon père serait au comble du bonheur."
                            }
                        ]
                    }
