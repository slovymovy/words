                                        "entry_id": "16135646-7b2c-3770-8cd9-fa669c057fd5",
                                        "glosses": [
                                            "A gathering of elders or leaders in Pakistan or Afghanistan, especially within a tribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a35cc4c8-2540-497d-b73f-0ebdc4a82d79",
                                                "sense_id": "31741dd7-0c5d-363c-ad47-b312f276fcb6",
                                                "text": "Mr. Karzai and General Musharraf are expected to meet this week at a jirga, an assembly of leaders from their nations."
                                            }
                                        ]
