                ],
                "senses": [
                    {
                        "sense_id": "46939275-7745-3960-936f-b50294793db2",
                        "entry_id": "7795d97d-a40b-3d7d-bcc3-cc08c969d4e4",
                        "glosses": [
                            "уменьш. от стая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa98b03-f0ba-4590-b6f8-b036b86a3713",
                                "sense_id": "46939275-7745-3960-936f-b50294793db2",
                                "text": "На высокие черешни перед домом прилетела стайка перепелов."
                            }
                        ]
                    },
                    {
                        "sense_id": "83d977a9-11c0-3cd4-8b89-4c7123ebf212",
                        "entry_id": "7795d97d-a40b-3d7d-bcc3-cc08c969d4e4",
                        "glosses": [
                            "рег. хлев, помещение для домашнего скота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc131c3-55b1-4000-9b10-1da794219287",
                                "sense_id": "83d977a9-11c0-3cd4-8b89-4c7123ebf212",
                                "text": "Хозяин отпер двери стайки и загнал туда овец."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7fb8af2-f27b-3492-a5f1-526ad112ad36",
                        "entry_id": "7795d97d-a40b-3d7d-bcc3-cc08c969d4e4",
                        "glosses": [
                            "перен. небольшая группа детей или подростков"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8c5204-6df6-43e1-b691-ebc13b2295d5",
                                "sense_id": "c7fb8af2-f27b-3492-a5f1-526ad112ad36",
                                "text": "Прямо за нами идёт стайка молоденьких девушек, и вдруг одна из них, самая хорошенькая, на которую Визбор скосил глаза, говорит подруге: «Смотри, Маша, как мужик на Бормана похож»."
                            }
                        ]
                    }
                ],
