        "fr-extract.jsonl": [
            {
                "entry_id": "4cc06bd3-7d88-3001-a4de-a7392e1e0659",
                "word": "entassement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c88890c6-59f7-43f4-8402-dd9523bc05d7",
                        "entry_id": "4cc06bd3-7d88-3001-a4de-a7392e1e0659",
                        "tags": [
                            "plural"
                        ],
                        "form": "entassements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13b40003-175b-37b9-bf84-953094c283a9",
                        "entry_id": "4cc06bd3-7d88-3001-a4de-a7392e1e0659",
                        "glosses": [
                            "Action d’entasser ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd298e8f-7b06-4401-9ba1-b8705660ca8e",
                                "sense_id": "13b40003-175b-37b9-bf84-953094c283a9",
                                "text": "Oui ! sous cet entassement était enfouie Mrs. Paulina Barnett, et, avec elle, Madge, Kalumah, Thomas Black, que l’avalanche avait surpris dans leur sommeil !"
                            },
                            {
                                "example_id": "03d34a22-e2b3-4cf5-a459-3b6872178e4a",
                                "sense_id": "13b40003-175b-37b9-bf84-953094c283a9",
                                "text": "Ces entassements d’Ossa sur Pélion m’apparaissent alors comme une énorme illusion."
                            },
                            {
                                "example_id": "d9907d70-692e-4c3f-8dc7-64350cda508c",
                                "sense_id": "13b40003-175b-37b9-bf84-953094c283a9",
                                "text": "Quant à La Bruyère, […] il n’a pas cru davantage que la beauté des mots fût dans l’entassement des lettres."
                            },
                            {
                                "example_id": "a3fe015a-62d2-4f10-82b5-cd6a4e4036b4",
                                "sense_id": "13b40003-175b-37b9-bf84-953094c283a9",
                                "text": "[…], et tantôt louvoyant, tantôt escaladant, car le chemin était parsemé d’entassements de décombres, ils arrivèrent non sans peine à la muraille indiquée par le Cornouaillais."
                            },
                            {
                                "example_id": "387759ad-cf0a-4dd6-b2c3-04b20c139b3d",
                                "sense_id": "13b40003-175b-37b9-bf84-953094c283a9",
                                "text": "Sur les entassements rocheux […] provenant des poudingues démantelés par l’action glaciaire, le Chêne sessile, espèce xérophile, l’emporte sur le Hêtre même aux expositions N. et W. […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "9d506a59-4b72-3d16-bf69-fdfb5f4f8abe",
                        "entry_id": "4cc06bd3-7d88-3001-a4de-a7392e1e0659",
                        "glosses": [
                            "Rassemblement de personnes ou d’animaux dans un lieu trop étroit."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "5990a9d4-64a1-4658-8ca8-65a649b26839",
                                "sense_id": "9d506a59-4b72-3d16-bf69-fdfb5f4f8abe",
                                "text": "L’entassement des prisonniers."
                            },
                            {
                                "example_id": "5965b2db-c7aa-482f-8a48-13866fd9f451",
                                "sense_id": "9d506a59-4b72-3d16-bf69-fdfb5f4f8abe",
                                "text": "L’entassement des bestiaux dans un char."
                            },
                            {
                                "example_id": "c19fb810-eee8-4aeb-a768-0631eec9738b",
                                "sense_id": "9d506a59-4b72-3d16-bf69-fdfb5f4f8abe",
                                "text": "Les Français condamnés à l’entassement, ou menacés de l’être, sont donc avant tout des citadins, aux revenus modestes et appartenant à des familles nombreuses."
                            }
                        ]
                    }
                ],
