                                        "entry_id": "9fbe3311-8a9d-3472-b764-00c8bf1ee947",
                                        "glosses": [
                                            "een scheikundig element en kleurloos edelgas met het symbool Xe en het atoomnummer 54"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
