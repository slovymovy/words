                ],
                "senses": [
                    {
                        "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                        "entry_id": "bc84b003-ac16-39c6-b9ac-e7c29dce83fb",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91c3932-8dc0-4e47-aebe-6780e87c3cdd",
                                "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                                "text": "Frau Nathansohn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1d5c7640-f6a2-40d6-813d-82f76bcb0d72",
                                "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                                "text": "Herr Nathansohn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a2b7e0fb-5023-4989-9b23-f4dbd83d53fa",
                                "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                                "text": "Die Nathansohns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8f7cd9fc-0520-44de-a6c3-1ec9788d160f",
                                "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                                "text": "Der Nathansohn trägt nie die Schals, die die Nathansohn ihm strickt."
                            },
                            {
                                "example_id": "dd02e87e-97d8-41c1-b96f-81f68b94b0e2",
                                "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nathansohn kommt, geht der Herr Nathansohn.“"
                            },
                            {
                                "example_id": "220157c0-fcd6-4db7-9e9c-692b25d22257",
                                "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                                "text": "Nathansohn kommt und geht."
                            },
                            {
                                "example_id": "2a16ff69-367d-4967-a7d3-ca1f78f5ca75",
                                "sense_id": "65af0474-59ff-31a8-8b95-b7a00fe53dee",
                                "text": "Nathansohns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
