            "senses": [
                {
                    "sense_id": "8ee29210-1924-3bac-b034-2e0f5b62d039",
                    "sense_definition": "The study of numbers, quantities, shapes, and space; a short form of mathematics.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "math_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My favorite subject in school has always been <w>math</w>.",
                            "target_lang_translations": {
                                "ru": "Моим любимым предметом в школе всегда была <w>математика</w>.",
                                "zh": "我在学校里最喜欢的科目一直是<w>数学</w>。"
                            }
                        },
                        {
                            "text": "She has a <w>math</w> test tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У неё завтра утром контрольная по <w>математике</w>.",
                                "zh": "她明天早上有一场<w>数学</w>考试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mathematics",
                        "maths"
                    ],
                    "common_phrases": [
                        "math class",
                        "math homework",
                        "mental math",
                        "math teacher"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изучение чисел, величин, форм и пространства; сокращение от слова \"mathematics\".",
                        "zh": "研究数字、数量、形状和空间的学科；数学的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "математика",
                                "target_lang_sense_clarification": "наука и учебный предмет"
                            },
                            {
                                "target_lang_word": "матика",
                                "target_lang_sense_clarification": "школьный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数学",
                                "target_lang_sense_clarification": "科学及学科名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "434ca898-b6c5-3b6c-808e-a4f773350ebc",
                    "sense_definition": "A calculation or a set of arithmetic operations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "math_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do the <w>math</w>, you will see that buying is cheaper than renting.",
                            "target_lang_translations": {
                                "ru": "Если провести <w>расчёты</w>, ты увидишь, что покупка дешевле аренды.",
                                "zh": "如果你<w>算算账</w>，就会发现买房比租房更划算。"
                            }
                        },
                        {
                            "text": "Please check my <w>math</w> to ensure the total is correct.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверь мои <w>вычисления</w>, чтобы убедиться, что итоговая сумма верна.",
                                "zh": "请帮我检查一下<w>计算</w>，确保总数无误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calculation",
                        "arithmetic",
                        "sums",
                        "computation"
                    ],
                    "common_phrases": [
                        "do the math",
                        "check the math"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычисление или набор арифметических операций.",
                        "zh": "计算或一系列算术运算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчёты",
                                "target_lang_sense_clarification": "вычисления"
                            },
                            {
                                "target_lang_word": "подсчёты",
                                "target_lang_sense_clarification": "результат счёта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "计算",
                                "target_lang_sense_clarification": "算术运算过程"
                            },
                            {
                                "target_lang_word": "算账",
                                "target_lang_sense_clarification": "核算账目或评估利弊"
                            }
                        ]
