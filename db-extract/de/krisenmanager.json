                ],
                "senses": [
                    {
                        "sense_id": "8d665e5b-ca86-3f80-a437-5f1d2d29f121",
                        "entry_id": "5c94e9d1-d11a-3523-9a7a-38c8ff8d821c",
                        "glosses": [
                            "Person, die sachliche Problemsituationen und menschliche Konflikte zu regulieren versucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea0e7fa1-e238-458b-9b15-6512c72692a4",
                                "sense_id": "8d665e5b-ca86-3f80-a437-5f1d2d29f121",
                                "text": "„Wer gefahrenträchtige Ereignisse auf sich zutreiben läßt, wird sich bestenfalls als ein gutwilliger, an der Aufgabe wachsender, wohl kaum aber als ein sehr kompetenter Krisenmanager in der akuten Situation erweisen.“"
                            },
                            {
                                "example_id": "07ac7111-e998-4316-8869-eb44d037c612",
                                "sense_id": "8d665e5b-ca86-3f80-a437-5f1d2d29f121",
                                "text": "„Schmidts Krisenmanager Wischnewski, der am Donnerstagnachmittag 82-jährig in Köln gestorben ist, wurde damals zum Volkshelden und Star der Medien.“"
                            },
                            {
                                "example_id": "f0d80d28-e6e9-4777-a00b-6837e21fbb8f",
                                "sense_id": "8d665e5b-ca86-3f80-a437-5f1d2d29f121",
                                "text": "„Und Leipzig begann erst nach der Verpflichtung des Krisenmanagers Peter Zühlsdorff, die wenigen deutschen Experten mit einzubeziehen.“"
                            },
                            {
                                "example_id": "012af4ea-6b52-4f58-86e9-1290f9986ed0",
                                "sense_id": "8d665e5b-ca86-3f80-a437-5f1d2d29f121",
                                "text": "„Sie haben wohl davon gehört, wie er 1997 die Folgen der großen Oderflut linderte, wie er sich einen Namen als Krisenmanager machte und bald von vielen 'Der Deichgraf' genannt wurde.“"
                            },
                            {
                                "example_id": "9463f497-d688-4bc9-a8b9-f0d0d8023602",
                                "sense_id": "8d665e5b-ca86-3f80-a437-5f1d2d29f121",
                                "text": "„Gerade Romney, derzeit Gouverneur von Massachusetts, hat sich im Olympiabusiness als Krisenmanager einen ausgezeichneten Ruf erworben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
