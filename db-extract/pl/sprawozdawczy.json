                                                "example_id": "cc5af0b5-d559-4692-856a-5a97d999ea31",
                                                "sense_id": "6b8bdee2-57a2-35a2-b327-fc984c6a559f",
                                                "text": "He was required to give a thorough accounting of his time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e3613e5-18d0-3330-be01-b20737ecfac5",
                                        "entry_id": "66c2dfe8-c932-35e6-8841-ee773017d14d",
                                        "glosses": [
                                            "An equitable remedy requiring wrongfully obtained profits to be distributed to those who deserve them."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4833d5-9357-45a7-b15e-04b5f2f49c88",
                                                "sense_id": "5e3613e5-18d0-3330-be01-b20737ecfac5",
                                                "text": "In contrast, an accounting for profits, or accounting— a distinct form of relief that the majority groups with disgorgement — has a well-accepted definition: It compels a defendant to account for, and repay to a plaintiff, those profits that belong to the plaintiff in equity."
                                            }
                                        ]
                                    }
