                            {
                                "example_id": "17a8a881-41d7-4238-b15f-f8ca15dd4f6b",
                                "sense_id": "ca31d91c-06ae-380d-8250-53c080e6c28c",
                                "text": "De eerste revolutie kwam met de populaire consoles NES en de Super NES. Met een plastic pistool vogels uit de lucht schieten? Dat kon opeens. En op de bank met je Gameboy? Another first: de eerste handheld spelcomputer was geboren."
                            },
                            {
                                "example_id": "febd6c2f-8f41-4fe4-8de7-8607cb0a5162",
                                "sense_id": "ca31d91c-06ae-380d-8250-53c080e6c28c",
                                "text": "Bij afleidingen reageren bestuurders trager, gaan ze slingeren en missen informatie, zegt Jaap de Graaf van Veilig Verkeer. \"Bestuurders zien vier op de tien verkeersborden niet tijdens handheld bellen, blijkt uit onderzoek.\""
                            }
                        ]
                    }
