                "senses": [
                    {
                        "sense_id": "a391d4ef-37d9-3fc7-8f3d-e488cbbcf62c",
                        "entry_id": "59e4e759-1a93-3b82-9060-6940394957d1",
                        "glosses": [
                            "die Elektrode, an der eine Reduktionsreaktion stattfindet"
                        ],
                        "tags": [
                            "Elektrochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "7fb02b21-ed9d-49b6-be37-2df9be5ec6a6",
                                "sense_id": "a391d4ef-37d9-3fc7-8f3d-e488cbbcf62c",
                                "text": "„Die Erfindung betrifft ein Penning-Vakuummeter (1) mit einer Katode und einer Anode; um nachteilige Wirkungen der Zerstäubung der Katode zu vermeiden, wird vorgeschlagen, dass die Katode (11) zumindest überwiegend aus Titan besteht.“"
                            },
                            {
                                "example_id": "4a5a7ac6-a2cf-45bf-84e5-2531707cd053",
                                "sense_id": "a391d4ef-37d9-3fc7-8f3d-e488cbbcf62c",
                                "text": "„Bei weiterer Erhöhung der Anodenspannung sinkt der Auffängerstrom und die Leuchtschicht bewegt sich in die Richtung zur Katode.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
