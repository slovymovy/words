                            "comparative"
                        ],
                        "form": "more stifling"
                    },
                    {
                        "form_id": "c5a91a32-659b-4a1e-8290-2d5b4f4e78b8",
                        "entry_id": "c37b563b-971f-3e83-a4e7-fca29a3b1f3e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most stifling"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                        "entry_id": "c37b563b-971f-3e83-a4e7-fca29a3b1f3e",
                        "glosses": [
                            "That stifles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97cc1e41-50a0-4839-a681-9bfdbaafbba9",
                                "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                                "text": "The heat was stifling; it seemed hard to breathe and the exertion of rolling over on the bed seemed too much."
                            },
                            {
                                "example_id": "47a87e85-c3cb-4927-86ec-09d60963b323",
                                "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                                "text": "The oppression of the cabin was stifling, and Evelyn had left her; she could not bear his absence, and she followed him."
                            },
                            {
                                "example_id": "5eb79199-c568-4514-8554-a82c84c79b7a",
                                "sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                                "text": "Who would go back to the stifling, wicked cities of civilized man when the mighty reaches of the great jungle offered peace and liberty? Not he."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53526b27-4199-417d-9337-93cddcda155d",
                        "source_entry_id": "c37b563b-971f-3e83-a4e7-fca29a3b1f3e",
                        "source_sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                        "source_sense_description": "that stifles",
                        "target_lang_word": "étouffant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étouffant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e872327d-d1ef-3421-b539-ab5209b0c392",
                                        "entry_id": "a819d9f2-c882-33b5-ba2d-c7650ccbe09e",
                                        "glosses": [
                                            "Qui fait que l’on étouffe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74901c04-da1a-4577-ae8a-150d1ef63d37",
                                                "sense_id": "e872327d-d1ef-3421-b539-ab5209b0c392",
                                                "text": "Mais, pour les hommes, je n’ai pas détourné les yeux.\nCar c’est toi qui m’as donné à boire un jour d’été que l’air était étouffant."
                                            },
                                            {
                                                "example_id": "c0edfc7f-df6d-456c-b85a-2fda77f83627",
                                                "sense_id": "e872327d-d1ef-3421-b539-ab5209b0c392",
                                                "text": "Après huit heures de marche en terrain souvent difficile, par un sirocco étouffant et une température qui doit dépasser 60° au soleil, nous atteignons Ras El-Ma, la source de l’oued Fez, à douze kilomètres de la capitale."
                                            },
                                            {
                                                "example_id": "40a7c711-0c51-42a5-8fff-bed806d6d79b",
                                                "sense_id": "e872327d-d1ef-3421-b539-ab5209b0c392",
                                                "text": "Elle se plia tout à coup en deux sous l’afflux d’un rire étouffant et d’autant plus difficile à supporter qu’il devait, à cause des bêtes, demeurer silencieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a909e6b8-76a7-3f6f-8def-ee8b8f89ce29",
                                        "entry_id": "a819d9f2-c882-33b5-ba2d-c7650ccbe09e",
                                        "glosses": [
                                            "Qualifie une culture qui gêne le développement des adventices."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f22e21b-ffbd-44ef-9d4f-e3d44069c69c",
                                                "sense_id": "a909e6b8-76a7-3f6f-8def-ee8b8f89ce29",
                                                "text": "Ainsi, lorsqu’un sol argileux, compacte, se trouve, par négligence, envahi par des plantes nuisibles, à racines vivaces et traçantes, et par conséquent très difficiles à détruire, telles que celles du pas-d’âne, du chiendent et d’autres, les cultures étouffantes deviennent insuffisantes pour la destruction de ces plantes, car elles n’agissent avec efficacité que sur les espèces annuelles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "étouffant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a6fdd62-8984-317a-836a-ff17c2652006",
                                        "entry_id": "77bdb971-75a4-36c4-800e-8d0d348d135b",
                                        "glosses": [
                                            "Participe présent de étouffer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6144946c-fc2c-4bc7-b06a-f06346501e90",
                                                "sense_id": "1a6fdd62-8984-317a-836a-ff17c2652006",
                                                "text": "Ce monde est, pour lui, phantasmé à l’instar de la mère mauvaise surprotectrice, étouffant sa liberté et le gavant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6519aeaa-0778-4be4-957a-701c6d953d7d",
                        "source_entry_id": "c37b563b-971f-3e83-a4e7-fca29a3b1f3e",
                        "source_sense_id": "a3b8e753-22c1-3291-b2bb-1ed3e3719b28",
                        "source_sense_description": "that stifles",
                        "target_lang_word": "stickig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stickig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                        "entry_id": "fbf53d4a-4a9f-3344-a9ab-c3a3fc3ace8a",
                                        "glosses": [
                                            "das Gefühl ersticken zu müssen gebend; von verbrauchter Luft erfüllt; mit geringem Sauerstoffgehalt"
                                        ],
                                        "tags": [
                                            "von Luft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc5fe754-4dc6-4372-995d-f39e60c2f8af",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "Die stickige Luft nahm ihm den Atem."
                                            },
                                            {
                                                "example_id": "ae3e16f7-9a92-4ca3-a7d8-1a2e67e16786",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "Bitte öffne doch die Fenster, es ist so stickig hier."
                                            },
                                            {
                                                "example_id": "06d5c694-4898-4ec4-8e1e-5857e2c41b0e",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "In der Dachkammer war es stickig heiß."
                                            },
                                            {
                                                "example_id": "304744cd-501e-47a6-9024-35a6bd5d2cd9",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "Sie schließen sich nächtelang in ihre stickigen Studierstuben ein."
                                            },
                                            {
                                                "example_id": "cbc8c120-1729-476f-a6e4-1fa3a1231e4a",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "„Ohne es zu merken, war ich aufgestanden und lauschte den glasfeinen Tönen und perlenden Glissandi eines Cembalos oder Spinetts, die wie ein kühler, belebender Lufthauch durch das stickige Treppenhaus des Wehrturms strichen.“"
                                            },
                                            {
                                                "example_id": "07433409-d481-44de-ae64-f6cf2468c36a",
                                                "sense_id": "457e3440-4349-31dc-8f9d-aa6a99c48ee1",
                                                "text": "„Meine Mutter hatte immer Angst, dass wir Kinder durch das Loch im Holzsitz rutschen und im schwarzen, stickigen Dunkel dieses Höllenpfuhls elendig ersaufen könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
