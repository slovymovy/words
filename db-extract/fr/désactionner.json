                "senses": [
                    {
                        "sense_id": "a3584e69-0910-3763-8d9c-89b3698906c0",
                        "entry_id": "2ef1e1ff-fb55-3a0c-a3bd-2229749f1d33",
                        "glosses": [
                            "Désactiver (ce qui avait été actionné)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1a0d730-0e79-4bee-8322-fb3abd64aa4c",
                                "sense_id": "a3584e69-0910-3763-8d9c-89b3698906c0",
                                "text": "Si le bouton de commande est désactionné le relais Y est excité et cette situation est stable."
                            },
                            {
                                "example_id": "0c79879c-57a6-425a-8716-036e08e30403",
                                "sense_id": "a3584e69-0910-3763-8d9c-89b3698906c0",
                                "text": "Pour modifier vos annonces, il faudrait que vous regardiez si \"le gestionnaire des conditions de vente\" est actionné (voir colonne de gauche de votre Récapitulatif). - dans l'affirmatif, vous le désactionnez et ainsi vous retrouvez votre liberté pour modifier vos annonces comme vous le voulez concernant les livraisons en particulier..."
                            },
                            {
                                "example_id": "2ae27457-351c-400d-a4a7-ad813c8ea355",
                                "sense_id": "a3584e69-0910-3763-8d9c-89b3698906c0",
                                "text": "Cliquez sur la petite main pour actionner ou désactionner le «Like»."
                            }
                        ]
                    }
