                                "target_senses": [
                                    {
                                        "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                        "entry_id": "208c2e0d-5875-319e-99a8-4927749dd257",
                                        "glosses": [
                                            "Shaped like a U, or like the letter upsilon (υ)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f22cca0-6cde-481a-a9eb-0d9472b4b397",
                                                "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                                "text": "This stick has a hyoid shape."
                                            },
                                            {
                                                "example_id": "ca9f4adf-5ff6-480e-b41f-4726afdc3632",
                                                "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                                "text": "The hyoid bone in her throat flutters as if discharging some subvocal rosary."
                                            },
                                            {
                                                "example_id": "b5f2b2f9-93a4-42cb-9808-ccc6fe378113",
                                                "sense_id": "58e371de-39e9-3ffe-9ccf-12900b09a86b",
                                                "text": "Beebe referred to these never-before-seen creatures as monsters, as devils and dragons. But he though of their bodies as philosophies, traditions of thought, as schools of dragonism. A college drop-out, he wondered what was to be learned at their great university: An astronesthes with batteries of hells-eye lights on its cheeks, a looped string of twenty lavender glowing beads suspended from its hyoid dewlap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1138d1a6-e5a1-3466-b0d9-7a3fff890467",
                                        "entry_id": "208c2e0d-5875-319e-99a8-4927749dd257",
                                        "glosses": [
                                            "Of or pertaining to the hyoid bone."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "relational"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
