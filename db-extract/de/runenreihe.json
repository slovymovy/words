                "senses": [
                    {
                        "sense_id": "42cc5941-a88f-3ada-b53a-9bed448c3fbc",
                        "entry_id": "3ce37d8b-cd81-36d1-9ed9-16e5b8ba56bf",
                        "glosses": [
                            "geordnete Abfolge der einzelnen Schriftzeichen des Runenalphabets (Futharks)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58fe3eff-eb91-4aac-8b5e-be4bbc12883f",
                                "sense_id": "42cc5941-a88f-3ada-b53a-9bed448c3fbc",
                                "text": "„Nach ihren ersten sechs Zeichen heißt die Runenreihe - analog zum ABC - futhark.“"
                            },
                            {
                                "example_id": "ca015600-b728-4bc8-9116-6b7c814f6b59",
                                "sense_id": "42cc5941-a88f-3ada-b53a-9bed448c3fbc",
                                "text": "„Im übrigen geschieht am Übergang zur Wikingerzeit das wichtige Ereignis, daß die ältere Runenreihe mit vierundzwanzig Zeichen von einer kürzeren Reihe von nur sechzehn Runenzeichen, dem jüngeren futhark, abgelöst wird.“"
                            },
                            {
                                "example_id": "7255093e-c9d6-4794-ba0e-7da3299edeaf",
                                "sense_id": "42cc5941-a88f-3ada-b53a-9bed448c3fbc",
                                "text": "„Die im großen und ganzen festliegende Reihenfolge der Zeichen entspricht nicht der aus dem Griechischen und Lateinischen bekannten Alphabetfolge. Es empfiehlt sich daher, von Runenreihe(n) zu sprechen, noch nicht von Runenalphabet(en).“"
                            },
                            {
                                "example_id": "c21ccfc8-9592-4cc7-9c94-1e7885ed1b24",
                                "sense_id": "42cc5941-a88f-3ada-b53a-9bed448c3fbc",
                                "text": "„Neben der vollständigen Runenreihe wird das Futhark gelegentlich in mehr oder weniger verkürzter Form aufgezeichnet…“"
                            },
                            {
                                "example_id": "480de3fe-e89e-40ac-a904-152c55b3f04c",
                                "sense_id": "42cc5941-a88f-3ada-b53a-9bed448c3fbc",
                                "text": "„Das »Runen-ABC« wird nach den ersten sechs Zeichen der Runenreihe Futhark, im Altenglischen gemäß dem Lautwandel a > o Futhork genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
