{
    "word_family": [
        "convert",
        "conversion",
        "converter",
        "convertibility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79441683-b0cb-3b51-bd62-fc05713828ff",
                    "sense_definition": "a car with a roof that can be folded down or removed",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They drove along the coast in a red <w>convertible</w> with the top down.",
                            "target_lang_translations": {
                                "ru": "Они ехали вдоль побережья в красном <w>кабриолете</w> с открытым верхом.",
                                "zh": "他们开着一辆红色的<w>敞篷车</w>沿着海岸行驶，车顶是打开的。"
                            }
                        },
                        {
                            "text": "It was a beautiful day to drive a luxury <w>convertible</w> through the mountains.",
                            "target_lang_translations": {
                                "ru": "Это был прекрасный день, чтобы проехаться по горам на роскошном <w>кабриолете</w>.",
                                "zh": "在这样一个美好的日子里，开着豪华<w>敞篷车</w>穿过山脉真是太棒了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cabriolet",
                        "cabrio",
                        "roadster",
                        "drop top"
                    ],
                    "common_phrases": [
                        "luxury convertible",
                        "red convertible",
                        "drive a convertible"
                    ],
                    "target_lang_definitions": {
                        "ru": "автомобиль с откидным или съемным верхом",
                        "zh": "一种车顶可以折叠或拆卸的汽车"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабриолет",
                                "target_lang_sense_clarification": "тип кузова автомобиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敞篷车",
                                "target_lang_sense_clarification": "指车顶可开启的汽车"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "117374ef-2028-3998-bbce-4a8bec6c22f2",
                    "sense_definition": "a computer that can function as both a laptop and a tablet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>convertible</w> laptop is perfect for students who need to take handwritten notes.",
                            "target_lang_translations": {
                                "ru": "Этот <w>ноутбук-трансформер</w> идеально подходит для студентов, которым нужно делать рукописные заметки.",
                                "zh": "这款<w>二合一笔记本</w>非常适合需要手写笔记的学生。"
                            }
                        },
                        {
                            "text": "The screen on my new <w>convertible</w> rotates three hundred and sixty degrees.",
                            "target_lang_translations": {
                                "ru": "Экран на моем новом <w>трансформере</w> поворачивается на триста шестьдесят градусов.",
                                "zh": "我新买的<w>变形本</w>屏幕可以三百六十度旋转。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "convertible laptop",
                        "convertible tablet"
                    ],
                    "target_lang_definitions": {
                        "ru": "компьютер, который может работать и как ноутбук, и как планшет",
                        "zh": "既可以作为笔记本电脑又可以作为平板电脑使用的计算机"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноутбук-трансформер",
                                "target_lang_sense_clarification": "устройство 2-в-1"
                            },
                            {
                                "target_lang_word": "трансформер",
                                "target_lang_sense_clarification": "о технике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二合一笔记本",
                                "target_lang_sense_clarification": "指兼具笔记本和平板功能的设备"
                            },
                            {
                                "target_lang_word": "变形本",
                                "target_lang_sense_clarification": "指屏幕可旋转或拆卸的笔记本电脑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ba119d8-53ea-373d-919b-6a0d3044910c",
                    "sense_definition": "a financial security, such as a bond, that can be changed into a different form like common stock",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company issued <w>convertible</w> bonds to attract more investors.",
                            "target_lang_translations": {
                                "ru": "Компания выпустила <w>конвертируемые</w> облигации, чтобы привлечь больше инвесторов.",
                                "zh": "该公司发行了<w>可转换债券</w>以吸引更多投资者。"
                            }
                        },
                        {
                            "text": "Investors often prefer a <w>convertible</w> because it offers more flexibility in a changing market.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто предпочитают <w>конвертируемую</w> ценную бумагу, так как она обеспечивает большую гибкость на меняющемся рынке.",
                                "zh": "投资者通常更喜欢<w>可转换证券</w>，因为它在多变的市场中提供了更大的灵活性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "convertible bond",
                        "convertible security"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "финансовый инструмент, который может быть обменен на другой вид ценных бумаг",
                        "zh": "一种可以转换为其他形式（如普通股）的金融证券，例如债券"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конвертируемая ценная бумага",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "конвертируемая облигация",
                                "target_lang_sense_clarification": "если речь об облигации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可转换证券",
                                "target_lang_sense_clarification": "金融术语"
                            },
                            {
                                "target_lang_word": "可转换债券",
                                "target_lang_sense_clarification": "特指可转债"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc45b438-25da-3c90-b592-db5ca032a414",
                    "sense_definition": "designed to be changed from one form or use to another",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "versatility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a <w>convertible</w> sofa that turns into a bed for guests.",
                            "target_lang_translations": {
                                "ru": "Мы купили <w>раскладной</w> диван, который превращается в кровать для гостей.",
                                "zh": "我们买了一个可以变成客床的<w>可折叠</w>沙发。"
                            }
                        },
                        {
                            "text": "The nursery features a <w>convertible</w> crib that grows with the child.",
                            "target_lang_translations": {
                                "ru": "В детской стоит <w>трансформируемая</w> кроватка, которая растет вместе с ребенком.",
                                "zh": "婴儿房里有一张可以随孩子成长而调整的<w>多功能</w>婴儿床。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "convertible sofa",
                        "convertible crib",
                        "convertible furniture"
                    ],
                    "target_lang_definitions": {
                        "ru": "предназначенный для изменения формы или назначения",
                        "zh": "设计成可以从一种形式或用途改变为另一种的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трансформируемый",
                                "target_lang_sense_clarification": "о мебели или конструкциях"
                            },
                            {
                                "target_lang_word": "раскладной",
                                "target_lang_sense_clarification": "о диванах или кроватях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可折叠的",
                                "target_lang_sense_clarification": "指家具或物品"
                            },
                            {
                                "target_lang_word": "多功能的",
                                "target_lang_sense_clarification": "指用途可变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beb0ec61-10b3-3eea-89db-0521ce4d06eb",
                    "sense_definition": "able to be exchanged for another currency or for gold",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>convertible</w> currency is pegged to the value of the dollar.",
                            "target_lang_translations": {
                                "ru": "Местная <w>конвертируемая</w> валюта привязана к курсу доллара.",
                                "zh": "当地的<w>可兑换</w>货币与美元汇率挂钩。"
                            }
                        },
                        {
                            "text": "Travelers need to know if the money they carry is a fully <w>convertible</w> asset.",
                            "target_lang_translations": {
                                "ru": "Путешественникам нужно знать, являются ли деньги, которые они везут, полностью <w>конвертируемым</w> активом.",
                                "zh": "旅客需要了解他们携带的资金是否为完全<w>可兑换</w>资产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interchangeable",
                        "swappable"
                    ],
                    "antonyms": [
                        "inconvertible"
                    ],
                    "common_phrases": [
                        "convertible currency",
                        "fully convertible"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "способный обмениваться на другую валюту или золото",
                        "zh": "可以兑换成其他货币或黄金的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конвертируемый",
                                "target_lang_sense_clarification": "о валюте"
                            },
                            {
                                "target_lang_word": "обратимый",
                                "target_lang_sense_clarification": "о валюте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可兑换的",
                                "target_lang_sense_clarification": "指货币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ab38a78-accd-3cfb-84c8-8f17e29146ea",
                    "sense_definition": "able to be exchanged or used in place of something else",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some contexts, these two technical terms are <w>convertible</w> and mean the same thing.",
                            "target_lang_translations": {
                                "ru": "В некоторых контекстах эти два технических термина <w>взаимозаменяемы</w> и означают одно и то же.",
                                "zh": "在某些语境下，这两个技术术语是<w>可互换的</w>，意思相同。"
                            }
                        },
                        {
                            "text": "The author argues that power and wealth are <w>convertible</w> terms in modern society.",
                            "target_lang_translations": {
                                "ru": "Автор утверждает, что власть и богатство — это <w>равнозначные</w> понятия в современном обществе.",
                                "zh": "作者认为，在现代社会中，权力和财富是<w>等同的</w>概念。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equivalent",
                        "interchangeable",
                        "synonymous"
                    ],
                    "common_phrases": [
                        "convertible terms"
                    ],
                    "target_lang_definitions": {
                        "ru": "способный заменять друг друга или использоваться вместо чего-то другого",
                        "zh": "能够相互替换或用于替代其他事物的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взаимозаменяемый",
                                "target_lang_sense_clarification": "о понятиях или терминах"
                            },
                            {
                                "target_lang_word": "равнозначный",
                                "target_lang_sense_clarification": "о терминах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可互换的",
                                "target_lang_sense_clarification": "指概念或术语"
                            },
                            {
                                "target_lang_word": "等同的",
                                "target_lang_sense_clarification": "指意义相同"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}