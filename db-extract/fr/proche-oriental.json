                        "glosses": [
                            "Personne originaire ou habitant le Proche-Orient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974b114e-36e9-467c-853a-e65ceccd47b3",
                                "sense_id": "2d1689c5-f0c0-30ae-bac6-ffcc8379d317",
                                "text": "Il m’arrivait de dire :\n--- Hadrien, tu connais la petite Mᵐᵉ Valdotin ?\n--- Celle qui était avec un Proche-Oriental ?"
                            },
                            {
                                "example_id": "077db699-20f1-43fe-aac5-e9fe7409de63",
                                "sense_id": "2d1689c5-f0c0-30ae-bac6-ffcc8379d317",
                                "text": "Une tête en terre cuite de type europoïde, fut retrouvée à Colima (Mexique), représentant un type humain nettement différent de celui de l’indigène américain : c’est un Proche-Oriental ou Européen (fig. 52)."
                            }
                        ]
                    }
