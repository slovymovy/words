                                "target_senses": [
                                    {
                                        "sense_id": "93e5aff1-4e93-3aef-a261-fb05a0de1973",
                                        "entry_id": "c6990046-add9-3800-9da7-577e05911684",
                                        "glosses": [
                                            "główny (najniższy) poziomy człon belkowania antycznego podtrzymujący belki stropu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0e3b2f-53c6-45f5-a2cb-19c4684b4a5c",
                                                "sense_id": "93e5aff1-4e93-3aef-a261-fb05a0de1973",
                                                "text": "W skład klasycznego belkowania wchodzi architraw, fryz i gzyms."
                                            },
                                            {
                                                "example_id": "a9f53818-61e7-4e56-818a-6dfbee837d1d",
                                                "sense_id": "93e5aff1-4e93-3aef-a261-fb05a0de1973",
                                                "text": "Na architrawie świątyni delfickiej starożytni napisali: \"Poznaj samego siebie\", i za Platonem sądzili, że prawda jest przypomnieniem, anamnezą"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c628f89-63bc-441d-bc1f-6fa671fbf159",
                        "source_entry_id": "46a4c990-51fd-36e4-b761-a63192792b4b",
