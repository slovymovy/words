                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6634133-dd21-3b96-9917-cc75daef5849",
                        "entry_id": "cd1f4d04-13ad-38d1-86d0-9e09a5dc8f12",
                        "glosses": [
                            "Celui qui décrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b95f764-1026-42f5-b825-c23bb0c7adea",
                                "sense_id": "e6634133-dd21-3b96-9917-cc75daef5849",
                                "text": "[…] mais ce qu'ils nous apprennent de plus particulier et de plus utile pour notre objet, c'est à nous défier du témoignage postérieur des descripteurs de cabinets ou des nomenclateurs, qui peuplent ce nouveau monde d'animaux, lesquels ne se trouvent que dans l'ancien, et qui en désignent d'autres comme originaires de certaines contrées, où cependant jamais ils n'ont existé."
                            },
                            {
                                "example_id": "1b154d3d-d150-4752-ae63-8c96661b91e9",
                                "sense_id": "e6634133-dd21-3b96-9917-cc75daef5849",
                                "text": "Il fut aussi un descripteur de formes, mais un descripteur trop pressé, toujours par monts et par vaux, à pied, en diligence, à cheval, ramassant des plantes entre deux batailles et griffonnant en hâte leur diagnose sans se débotter, considérant comme nouveau tout ce qu’il ne se souvenait pas d’avoir vu."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
