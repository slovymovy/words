{
    "word_family": [
        "rooiing",
        "rooier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc1dbf6a-9936-3af3-87ea-bb8124f700c9",
                    "sense_definition": "Het uit de grond halen van gewassen zoals aardappelen of wortelen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer gaat vandaag de aardappels <w>rooien</w> op het veld.",
                            "target_lang_translations": {
                                "ru": "Сегодня фермер будет <w>выкапывать</w> картофель в поле."
                            }
                        },
                        {
                            "text": "Wortelen worden in de herfst machinaal <w>gerooid</w>.",
                            "target_lang_translations": {
                                "ru": "Осенью морковь <w>собирают</w> механизированным способом."
                            }
                        }
                    ],
                    "synonyms": [
                        "oogsten",
                        "opgraven"
                    ],
                    "common_phrases": [
                        "aardappels rooien"
                    ],
                    "target_lang_definitions": {
                        "ru": "Извлечение корнеплодов (например, картофеля или моркови) из земли при сборе урожая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкапывать",
                                "target_lang_sense_clarification": "о процессе извлечения корнеплодов из почвы"
                            },
                            {
                                "target_lang_word": "собирать урожай",
                                "target_lang_sense_clarification": "в контексте уборки корнеплодов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "179070be-0163-39f6-8537-c4b4f72fc767",
                    "sense_definition": "Het verwijderen van bomen of struiken uit een gebied.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude boomgaard moet worden <w>gerooid</w> om plaats te maken voor nieuwe huizen.",
                            "target_lang_translations": {
                                "ru": "Старый фруктовый сад нужно <w>выкорчевать</w>, чтобы освободить место для новых домов."
                            }
                        },
                        {
                            "text": "Het is verboden om zonder vergunning bomen te <w>rooien</w> in dit bos.",
                            "target_lang_translations": {
                                "ru": "В этом лесу запрещено <w>вырубать</w> деревья без разрешения."
                            }
                        }
                    ],
                    "synonyms": [
                        "kappen",
                        "ontbossen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удаление деревьев или кустарников с участка, часто с корнем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корчевать",
                                "target_lang_sense_clarification": "удаление деревьев вместе с корнями"
                            },
                            {
                                "target_lang_word": "вырубать",
                                "target_lang_sense_clarification": "удаление деревьев или кустарников"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee5aa1d9-fb21-363a-8f20-4ef05c04df94",
                    "sense_definition": "Zich redden of een taak tot een goed einde brengen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "redden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moet het in zijn eentje <w>rooien</w> in de grote stad.",
                            "target_lang_translations": {
                                "ru": "Ему приходится <w>справляться</w> в большом городе в одиночку."
                            }
                        },
                        {
                            "text": "Zonder hulp zal ze het niet <w>rooien</w> om dit project op tijd af te krijgen.",
                            "target_lang_translations": {
                                "ru": "Без помощи она не <w>справится</w> с тем, чтобы закончить этот проект вовремя."
                            }
                        }
                    ],
                    "synonyms": [
                        "redden",
                        "klaren"
                    ],
                    "common_phrases": [
                        "het rooien"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Wordt vaak gebruikt in informele context."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Справляться с трудностями или успешно завершать задачу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "успешно преодолевать трудности"
                            },
                            {
                                "target_lang_word": "выкручиваться",
                                "target_lang_sense_clarification": "разговорный вариант, означающий выход из сложной ситуации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}