{
    "word_family": [
        "bedauerlich",
        "bedauerlicherweise"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24744860-35fd-30ef-9f0c-a450a87cd7ea",
                    "sense_definition": "ein Geschehen oder eine eigene Entscheidung als negativ empfinden und am liebsten rückgängig machen wollen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "Reue und Bedauern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir <w>bedauern</w> die Unannehmlichkeiten, die durch die Verspätung entstanden sind."
                        },
                        {
                            "text": "Er wird seine unüberlegte Entscheidung im Nachhinein sicher noch <w>bedauern</w>."
                        }
                    ],
                    "common_phrases": [
                        "zutiefst bedauern",
                        "einen Fehler bedauern"
                    ],
                    "synonyms": [
                        "bereuen"
                    ]
                },
                {
                    "sense_id": "ef9543b9-7256-383e-a437-880ae35040cf",
                    "sense_definition": "mit jemandem Mitleid empfinden und Anteil an dessen Unglück oder Leid nehmen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Mitgefühl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Nachbarn <w>bedauerten</w> die alte Frau nach dem schweren Verlust sehr."
                        },
                        {
                            "text": "Er möchte von seinen Freunden nicht ständig nur <w>bedauert</w> werden."
                        }
                    ],
                    "common_phrases": [
                        "jemanden aufrichtig bedauern"
                    ],
                    "synonyms": [
                        "bemitleiden"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd1eb4a3-f0b6-3846-bf12-050e13e3b908",
                    "sense_definition": "schmerzliches oder negatives Gefühl über eine eigene Tat, ein Versäumnis oder einen bestimmten Umstand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Reue und Bedauern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie verließ die alte Firma nach vielen Jahren ohne großes <w>Bedauern</w>."
                        },
                        {
                            "text": "Er empfand tiefes <w>Bedauern</w> über seine verletzenden Worte."
                        }
                    ],
                    "synonyms": [
                        "Reue"
                    ],
                    "common_phrases": [
                        "ohne Bedauern",
                        "großes Bedauern empfinden"
                    ]
                },
                {
                    "sense_id": "f19680ed-e910-3573-8209-6818e1973599",
                    "sense_definition": "gefühlvolle Anteilnahme oder Mitgefühl für das Unglück beziehungsweise die schwierige Lage anderer Menschen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Mitgefühl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Bürgermeister fand herzliche Worte des <w>Bedauerns</w> für die Betroffenen."
                        },
                        {
                            "text": "Sie blickte voller <w>Bedauern</w> auf das verletzte Tier im Garten."
                        }
                    ],
                    "common_phrases": [
                        "Worte des Bedauerns",
                        "voller Bedauern"
                    ],
                    "synonyms": [
                        "Mitgefühl",
                        "Anteilnahme"
                    ]
                }
            ]
        }
    ]
