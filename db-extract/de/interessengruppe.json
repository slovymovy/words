                ],
                "senses": [
                    {
                        "sense_id": "d5c9f107-8236-3b9a-b02a-14d7573d0dc4",
                        "entry_id": "0461ed52-c3e5-3098-bc2b-42031972ae60",
                        "glosses": [
                            "Gemeinschaft von Personen mit einem gemeinsamen Anliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc5f1ee-fc2b-45bc-bfb0-195880891cb4",
                                "sense_id": "d5c9f107-8236-3b9a-b02a-14d7573d0dc4",
                                "text": "„Eine große Reform darf man sich beim Gold Plating aber nicht erwarten, will die Regierung es sich nicht total mit einer Interessengruppe verscherzen.“"
                            },
                            {
                                "example_id": "98c5039d-c724-4510-9bad-b4618c8af375",
                                "sense_id": "d5c9f107-8236-3b9a-b02a-14d7573d0dc4",
                                "text": "„Der Verdacht verdichtet sich zur Gewissheit, es müsse eine dunkle Interessengruppe hinter diesen Vorgängen stehen und bare Münze aus dem Missgeschick der gequälten Damenwelt schlagen.“"
                            },
                            {
                                "example_id": "63ac5001-f307-4763-8d7f-e1d9d5f293e7",
                                "sense_id": "d5c9f107-8236-3b9a-b02a-14d7573d0dc4",
                                "text": "„In diesen Revolten standen sich nicht einfach zwei Parteien gegenüber, sondern die Konstellationen waren durch verschiedenste Interessengruppen gekennzeichnet, die zudem wechselnde Bündnisse untereinander eingingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
