                        "source_entry_id": "48337e69-8bc2-3199-bf57-59d880623d82",
                        "source_sense_id": "90342d9d-a278-301b-92f2-c4689059bba0",
                        "source_sense_description": "Geografie: Hauptstadt des gleichnamigen Schweizer Kantons",
                        "target_lang_word": "Soleure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soleure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                                        "entry_id": "cd530074-f795-323d-b5a6-2a503def5e58",
                                        "glosses": [
                                            "Ville du canton de Soleure en Suisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f2820b-17a3-45ca-a4c1-2a8de35fb0f1",
                                                "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                                                "text": "Si vous nous envoyez quelques lettres adressées aux Délices, ne nous en envoyez à Berne qu’une fois, et gardez les suivantes jusqu’à nouvel ordre, mon cher Colini : car nous sommes un peu en l’air. Nous irons à Soleure, de là nous retournons à Monrion, et nous regagnons ensuite notre lac de Genève."
                                            },
                                            {
                                                "example_id": "ee06f145-723a-488a-a096-c5e36d11bc51",
                                                "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                                                "text": "Soleure. La belle cathédrale baroque est placée sous l’invocation des saints Urs et Victor."
                                            },
                                            {
                                                "example_id": "3eb08e21-22e0-498f-b77f-1dd839e36b4e",
                                                "sense_id": "02ea28da-59e9-3660-b9ad-7baffad51914",
                                                "text": "Ils se cherchèrent dans la région un logis qui ne fût qu’à eux seuls, et s’achetèrent enfin près de Soleure un petit pavillon délabré du XVIIIᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9f29e4f-2214-37b8-acbc-488caad150b8",
                                        "entry_id": "cd530074-f795-323d-b5a6-2a503def5e58",
                                        "glosses": [
                                            "Canton et district autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f711a07a-175b-4f74-b8be-6b603747e875",
                                                "sense_id": "d9f29e4f-2214-37b8-acbc-488caad150b8",
                                                "text": "Soleure, canton de, (Géog. mod.) canton de la Suisse, & l’onzieme en ordre. Il est borné au nord par le canton de Bâle, au midi & au levant par le canton de Berne, au couchant par ce même canton & en partie par les terres de l’évêque de Bâle. Il s’étend le long de l’Aare, en partie dans la plaine & en partie dans le mont Jura."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
