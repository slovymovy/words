                ],
                "senses": [
                    {
                        "sense_id": "4b7d201b-c0dd-3e45-bb0b-460946930e40",
                        "entry_id": "d46a2322-1729-376a-b273-ba3781f1f6db",
                        "glosses": [
                            "Relatif à Mycènes, une ancienne cité grecque, à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1737030-d186-4916-8661-30d10042fb2c",
                                "sense_id": "4b7d201b-c0dd-3e45-bb0b-460946930e40",
                                "text": "L’art mycénien."
                            },
                            {
                                "example_id": "249932b4-39ea-43d7-8d32-4dd1658df19c",
                                "sense_id": "4b7d201b-c0dd-3e45-bb0b-460946930e40",
                                "text": "Il insiste de ce point de vue sur la rupture entre le monde mycénien et la civilisation des cités-État dans cet ouvrage incontournable que sont Les Origines de la pensée grecque."
                            },
                            {
                                "example_id": "6de2469e-e745-4fe5-a3fb-a7c303a8a3fd",
                                "sense_id": "4b7d201b-c0dd-3e45-bb0b-460946930e40",
                                "text": "Pavarotti était ridicule, et génial d’une façon XIXᵉ siècle. Comme tous les grands ténors, c’était une trompette. Il avait de plus une voix immédiatement reconnaissable. Et une tête de masque mycénien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "969b238b-011f-4e96-a6e8-03bd42ebd698",
                        "source_entry_id": "d46a2322-1729-376a-b273-ba3781f1f6db",
                        "source_sense_id": "4b7d201b-c0dd-3e45-bb0b-460946930e40",
                        "target_lang_word": "mykenisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mykenisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36e60dca-60b7-335a-a494-96615c404d9a",
                                        "entry_id": "3c7a2391-d1ce-3c84-bb5b-7dd7babb0fb7",
                                        "glosses": [
                                            "die griechische Kunst und Kultur der Bronzezeit betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b48b28ec-cfd4-4716-bbce-68735e0f677e",
                                                "sense_id": "36e60dca-60b7-335a-a494-96615c404d9a",
                                                "text": "„Von mykenischer Zeit bis ins römische Kaiserreich vertrauten die Soldaten vorrangig auf den Speer als Angriffswaffe.“"
                                            },
                                            {
                                                "example_id": "f1236579-70dc-45b4-b982-c7a4f6e008c5",
                                                "sense_id": "36e60dca-60b7-335a-a494-96615c404d9a",
                                                "text": "„Insgesamt zeichnete ein hoher Qualitätsstandard die mykenische Keramikproduktion aus.“"
                                            },
                                            {
                                                "example_id": "71510f4c-14b0-49bb-a844-0f68912117f5",
                                                "sense_id": "36e60dca-60b7-335a-a494-96615c404d9a",
                                                "text": "„Mykenische Waffen, Schmuck und Keramik sind dagegen weniger ausdrucksvoll, stilistisch einfacher und von geringerer Farbqualität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "415927fd-e1f9-3ee5-80ce-2803e19e3999",
                                        "entry_id": "3c7a2391-d1ce-3c84-bb5b-7dd7babb0fb7",
                                        "glosses": [
                                            "die Sprachstufe des Griechischen der Bronzezeit betreffend, dieser Sprachstufe angehörend, in dieser Sprachstufe verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
