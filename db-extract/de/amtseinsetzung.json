                "senses": [
                    {
                        "sense_id": "78d0e9a0-ca23-3b36-bfb4-ecff41ef07ee",
                        "entry_id": "03919109-19a5-36c5-b790-844062ed4ac2",
                        "glosses": [
                            "Ernennung, Berufung in ein bestimmtes Amt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b54ae39-4bc6-4174-a2e1-52d8e6cfce08",
                                "sense_id": "78d0e9a0-ca23-3b36-bfb4-ecff41ef07ee",
                                "text": "„Im ersten Wahlgang des Unterhauses zu seiner Amtseinsetzung verfehlte Calvo Sotelo die erforderliche absolute Mehrheit (176 Stimmen) um 7 Stimmen.“"
                            },
                            {
                                "example_id": "ba7ac4f9-0fbe-400b-aeee-f0f35ade5e5b",
                                "sense_id": "78d0e9a0-ca23-3b36-bfb4-ecff41ef07ee",
                                "text": "„Auffällig ist, dass der Bischof bei der Amtseinsetzung nicht benötigt wird, sondern der Presbyter die Amtseinsetzung übernimmt.“"
                            },
                            {
                                "example_id": "f220ba7b-f11e-4f3b-b096-ebb7415414cf",
                                "sense_id": "78d0e9a0-ca23-3b36-bfb4-ecff41ef07ee",
                                "text": "„Im technischen Sinne war die Ölung oder Salbung eine Prozedur die einer Krönung oder Amtseinsetzung entspricht.“"
                            },
                            {
                                "example_id": "d10d39e6-3004-4be6-a273-99fda469654f",
                                "sense_id": "78d0e9a0-ca23-3b36-bfb4-ecff41ef07ee",
                                "text": "„Oktober 1970 demokratisch gewählt worden und überlebte kurz vor seiner Amtseinsetzung eine Mordanschlag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
