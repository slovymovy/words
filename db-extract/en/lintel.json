                                                "sense_id": "4e5a76fc-ea39-30d1-aa2d-9778664b3290",
                                                "text": "„Der Sturz der Diktatur durch die Revolution in Portugal im April 1974 brachte den Gefangenen die Freiheit.“"
                                            },
                                            {
                                                "example_id": "e6a916d6-b9f1-4183-a58b-c195ff9ef9a1",
                                                "sense_id": "4e5a76fc-ea39-30d1-aa2d-9778664b3290",
                                                "text": "„Bouvard stellte ihn zur Verfügung, denn der Triumph des Volkes hatte sein patriotisches Herz erfreut; und auch Pécuchet war hoch befriedigt, denn der Sturz des Königtums bestätigte seine Voraussagen vollkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "036f1013-64f9-358b-8bbf-b34a2f2c28c2",
                                        "entry_id": "f5189ae8-16ad-3006-9873-a82000276a0a",
                                        "glosses": [
                                            "plötzliches, heftiges Absinken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b85c6251-1b0a-405e-a5af-f17f6a44abce",
                                                "sense_id": "036f1013-64f9-358b-8bbf-b34a2f2c28c2",
                                                "text": "Der Sturz der Kurse an den Börsen war nicht vorhersehbar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "87b5f284-fec8-398a-a42f-4e9726aa7f2c",
                                        "entry_id": "f5189ae8-16ad-3006-9873-a82000276a0a",
                                        "glosses": [
                                            "ein tragendes Konstruktionselement über Türen, Fenstern oder sonstigen Maueröffnungen"
                                        ],
                                        "tags": [
                                            "mit Plural 1 und Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f0bfec4-5508-490f-9c11-eae6b071e933",
                                                "sense_id": "87b5f284-fec8-398a-a42f-4e9726aa7f2c",
                                                "text": "Über der Tür musste ein neuer Sturz eingebaut werden."
                                            }
