            {
                "entry_id": "d7bddba7-82fb-3e0f-b472-542359644d54",
                "word": "laic",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d5ab3fe5-cfb4-4de0-bd60-4e35a626bc5e",
