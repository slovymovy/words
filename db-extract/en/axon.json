                                        "entry_id": "96d6c52c-d963-3871-acc8-9e9b76f9c52f",
                                        "glosses": [
                                            "kaum verzweigter und meist mit einer speziellen Isolierschicht umgebener Fortsatz einer Nervenzelle, der elektrische Nervenimpulse von der Zelle nach außen leitet"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c278e98-30fc-4cad-960c-69cbfa9ca4b3",
                                                "sense_id": "5521aee3-014f-3878-8b81-c855dbbf3438",
                                                "text": "„Ein Neuron ist mehr als nur ein Schalter; es ist zugleich Batterie und Generator, außerdem sorgt es für die Instandhaltung seiner drei Teile; Zellkörper, Dendriten und Axon.“"
                                            },
                                            {
                                                "example_id": "2ef0555a-154d-46de-a5fa-67869762dc25",
                                                "sense_id": "5521aee3-014f-3878-8b81-c855dbbf3438",
                                                "text": "„Der Reiz läuft als elektrischer Impuls vom Körper einer Nervenzelle über einen faserigen Fortsatz, das Axon, zu den Endknöpfchen, die daraufhin chemische Botenstoffe ausschütten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
