                "senses": [
                    {
                        "sense_id": "051f67b4-6b18-3e4e-a3e1-8d691af7a50c",
                        "entry_id": "18f35f25-a8c6-3315-a760-dd2f86203e7f",
                        "glosses": [
                            "Messung, Test, Untersuchung der sprachlichen Fähigkeiten einer oder mehrerer Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898d4b94-2563-44ed-b24b-5686c39d7a70",
                                "sense_id": "051f67b4-6b18-3e4e-a3e1-8d691af7a50c",
                                "text": "Mit Sprachtests kann man herausfinden, ob jemand den Sprachstand, der seinem Alter gemäß ist, erreicht hat."
                            },
                            {
                                "example_id": "ad5585c7-4b64-4402-a2b5-05613a0bc255",
                                "sense_id": "051f67b4-6b18-3e4e-a3e1-8d691af7a50c",
                                "text": "Sprachtests dienen der möglichst objektiven Erfassung sprachlicher Leistungen oder Defizite."
                            },
                            {
                                "example_id": "beef68b0-422e-42fd-ba31-fc67f27d9ff7",
                                "sense_id": "051f67b4-6b18-3e4e-a3e1-8d691af7a50c",
                                "text": "„Bei einem Sprachtest bestimmt man die aktiven und passiven Sprachkenntnisse eines Kindes anhand verschiedener sprachlicher Merkmale, zum Beispiel anhand einer Reihe von Konsonanten, grammatikalischen Konstruktionen oder Wortschatzteilen.“"
                            },
                            {
                                "example_id": "b10443e0-1c05-4856-9a04-c24c2a83533f",
                                "sense_id": "051f67b4-6b18-3e4e-a3e1-8d691af7a50c",
                                "text": "„Ich war ziemlich überrascht, als mich der freundliche Beamte nach einem bestandenen Sprachtest fragte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
