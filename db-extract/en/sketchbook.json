                    },
                    {
                        "translation_id": "fd70536d-7acb-4b8b-a498-ba0bd75a0507",
                        "source_entry_id": "739618c0-a59a-3d17-be7e-35e406756975",
                        "source_sense_description": "book or pad with blank pages for sketching",
                        "target_lang_word": "schetsboek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schetsboek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ba37fc1-fe5b-3635-8352-0278541223bc",
                                        "entry_id": "b2c07dc5-2ff6-349a-8f9b-51bb9bce431a",
                                        "glosses": [
                                            "boek of schrift met blanco vellen papier, dat geschikt is voor het maken van tekeningen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e9575b-3f9c-4a5a-9f31-90cbef7cf7f1",
                                                "sense_id": "8ba37fc1-fe5b-3635-8352-0278541223bc",
                                                "text": "Doe mee aan de lezersactie ‘In de voetsporen van de dominee (Craandijk)’. Ga met schetsboek en (kleur)potloden op stap in Hof van Twente. Verken tussen 1 juli en 3 september 2017 de fiets- en wandelroute ‘Heerlijck Zicht’(16 km.) en leg uw mooiste indrukken vast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e4b553-5be7-3d04-a57e-ed5d8b478f10",
                                        "entry_id": "b2c07dc5-2ff6-349a-8f9b-51bb9bce431a",
                                        "glosses": [
                                            "boek met schetsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fad84be-344b-48ee-9da3-85dd7f546c16",
                                                "sense_id": "32e4b553-5be7-3d04-a57e-ed5d8b478f10",
                                                "text": "Zo had Rembrandt van Rijn een schetsboek en diverse tekeningen van hem en barokgrootmeester Peter Paul Rubens zelfs zeventien schilderijen. In de uitgebreide collectie van Rubens was Brouwer de best vertegenwoordigde kunstenaar."
                                            },
                                            {
                                                "example_id": "79b1b3d1-d0f0-4889-a62c-e2587e2aacab",
                                                "sense_id": "32e4b553-5be7-3d04-a57e-ed5d8b478f10",
                                                "text": "In Parijs is dinsdag een onbekend schetsboek van Vincent van Gogh gepresenteerd. „Imitatie”, oordeelt het Van Gogh Museum. De ontdekker is niet onder de indruk. „De expertise van het museum vertoont echt gebreken.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "393d795d-9e17-4a98-a4df-99dd8bbe2250",
                        "source_entry_id": "739618c0-a59a-3d17-be7e-35e406756975",
                        "source_sense_description": "book or pad with blank pages for sketching",
                        "target_lang_word": "carnet de croquis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "16c8374c-a3ee-43f0-a061-d040f38c5078",
                        "source_entry_id": "739618c0-a59a-3d17-be7e-35e406756975",
                        "source_sense_description": "book or pad with blank pages for sketching",
                        "target_lang_word": "Skizzenbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skizzenbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee4255bd-6aa1-31c7-b2cb-bbd0328f06b0",
                                        "entry_id": "f3d45c40-855a-3ed0-83e8-6c24ae33bf6b",
                                        "glosses": [
                                            "Buch für/mit Skizzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e300af11-3fa6-4156-8797-97ebd046f520",
                                                "sense_id": "ee4255bd-6aa1-31c7-b2cb-bbd0328f06b0",
                                                "text": "„Als er sich endlich nach Katell umsah, der in eine Ecke gelehnt mit raschen Strichen das Bild in seinem Skizzenbuch festhielt, da erst kam ihm der Gedanke, ob sich Anna wohl auch in einer dieser Gruppen befinden könne.“"
                                            },
                                            {
                                                "example_id": "ad43a1ad-e3d5-4584-b950-0e68778ce676",
                                                "sense_id": "ee4255bd-6aa1-31c7-b2cb-bbd0328f06b0",
                                                "text": "„Diese Notizen zum Verlauf des vorigen Tages werden später in ein großes Skizzenbuch kopiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bc6bbfb-1c65-4dff-b296-c8ac6dbc11a9",
