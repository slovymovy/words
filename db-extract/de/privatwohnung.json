                "senses": [
                    {
                        "sense_id": "701b2a18-d752-3cc1-bcc4-955652522a6b",
                        "entry_id": "1dc5c685-404c-3d6d-8ace-95cb0bb7b0ce",
                        "glosses": [
                            "Wohnung, die privat genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb7ecc7-a650-4cac-a7a5-827c47d14466",
                                "sense_id": "701b2a18-d752-3cc1-bcc4-955652522a6b",
                                "text": "„Bertram und den Boisserée gelang es hier, die Gemälde, die zuvor stets in Privatwohnungen aufbewahrt worden waren, erstmals öffentlich auszustellen.“"
                            },
                            {
                                "example_id": "774b8ab4-04cb-4049-a1a6-8b6354eac9b3",
                                "sense_id": "701b2a18-d752-3cc1-bcc4-955652522a6b",
                                "text": "„Die Straße bildete hier eine Art freien Platz, denn die linke Reihe der Häuser war, die zwei vordersten abgerechnet, weiter zurückgerückt und enthielt neben Privatwohnungen auch das alleinstehende Gerichtshaus und das Gefängnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
