                                    {
                                        "sense_id": "0b674e5f-0886-304a-8847-bd45df93080a",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The act of destroying or otherwise turning into nothing, or nonexistence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
