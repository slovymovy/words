                "senses": [
                    {
                        "sense_id": "bd5c1cbb-8b1a-38cc-a414-07af300b2ebc",
                        "entry_id": "7bceb892-2101-36b0-979b-569ce80fdeb7",
                        "glosses": [
                            "Hinterwäldler in den USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b44354-9e92-4698-88f3-c5e174fe116d",
                                "sense_id": "bd5c1cbb-8b1a-38cc-a414-07af300b2ebc",
                                "text": "„Nach diesem Erlebnis wandert der Hillbilly eine ganze Zeit allein in den Wäldern umher, bis er plötzlich vor dem Eingang einer riesigen Höhle steht.“"
                            },
                            {
                                "example_id": "2bb92247-52b4-4403-b138-baacb118a150",
                                "sense_id": "bd5c1cbb-8b1a-38cc-a414-07af300b2ebc",
                                "text": "„Er wußte natürlich, daß man eine Schauspielerin nicht für eine Nacht kaufen kann, aber in seinem Rausch machte es ihm Spaß, den primitiven amerikanischen ›Hillbilly‹ zu spielen.“"
                            }
                        ],
