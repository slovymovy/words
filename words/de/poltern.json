                    "frequency": "Middle",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mitten in der Nacht <w>polterte</w> plötzlich ein schwerer Koffer die Holztreppe hinunter."
                        },
                        {
                            "text": "Auf dem Dachboden <w>poltert</w> ein kleines Tier und erschreckt damit die Hausbewohner."
                        }
                    ],
                    "synonyms": [
                        "rumpeln"
                    ],
                    "antonyms": [],
                    "common_phrases": [
