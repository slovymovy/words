                    {
                        "sense_id": "fe418195-dc41-38b3-a590-871e0495e482",
                        "entry_id": "bbe606e6-1aa2-3bea-84a0-be2f717c6ec7",
                        "glosses": [
                            "To govern with too much rigidity or precision."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "84647fd4-3d30-4259-bb8d-a4431aeef4e1",
                                "sense_id": "fe418195-dc41-38b3-a590-871e0495e482",
                                "text": "In Europe, he says, we over-govern. The subjects of European governments would seem, according to his notion, to be brought into this world only to be licked and taxed."
                            },
                            {
                                "example_id": "fc78e868-f3fe-4693-9240-49d144010e13",
                                "sense_id": "fe418195-dc41-38b3-a590-871e0495e482",
                                "text": "He should not overgovern his neighbors and they should not overgovern him with countless laws calling for more clerks, more police and more rules and regulations and orders which few persons will obey."
                            }
                        ]
                    }
