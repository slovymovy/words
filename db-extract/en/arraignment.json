                "senses": [
                    {
                        "sense_id": "d40beaf1-8899-3946-ad7e-65f783c8ed93",
                        "entry_id": "e6d220f8-d9fd-36af-bf47-5b14f577cdda",
                        "glosses": [
                            "The formal charging of a defendant with an offense; in many jurisdictions it includes their response in the form of a plea, typically as guilty, not guilty, or no contest."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bb81facf-2c0b-4931-af79-f18fb4aad176",
                                "sense_id": "d40beaf1-8899-3946-ad7e-65f783c8ed93",
                                "text": "This process, Mr. Rothfeld said, could be interrupted at any moment if prosecutors in Los Angeles successfully extradite him for an arraignment on the sexual assault charges there."
                            },
                            {
                                "example_id": "764cd63e-fb3a-468b-ae6b-994f30c325ec",
                                "sense_id": "d40beaf1-8899-3946-ad7e-65f783c8ed93",
                                "text": "[…]— the indictment will remain sealed until his expected arraignment on Tuesday, when the charges will be formally revealed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b67589f-0a25-4154-93e6-64a5d9de095e",
                        "source_entry_id": "e6d220f8-d9fd-36af-bf47-5b14f577cdda",
                        "source_sense_id": "d40beaf1-8899-3946-ad7e-65f783c8ed93",
                        "source_sense_description": "charging of a defendant",
                        "target_lang_word": "voorgeleiding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voorgeleiding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bbc261ac-216a-3c83-b68b-354f99a3866b",
                                        "entry_id": "4e77d146-aef8-376a-825e-eeabb03d4e0a",
                                        "glosses": [
                                            "het door de rechter gehoord worden voordat de eigenlijke rechtszaak plaatsvindt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d3ca8f3-2c9a-4a1c-a973-3d8c488419ba",
                                                "sense_id": "bbc261ac-216a-3c83-b68b-354f99a3866b",
                                                "text": "De Russische onderzoeksjournalist die donderdag werd opgepakt is onder huisarrest geplaatst. Dat heeft de rechter besloten na zijn voorgeleiding. De 36-jarige Ivan Goloenov mag zijn rechtszaak dus thuis in relatieve vrijheid afwachten."
                                            },
                                            {
                                                "example_id": "713205a7-fbef-4b6d-9912-4d24639cb314",
                                                "sense_id": "bbc261ac-216a-3c83-b68b-354f99a3866b",
                                                "text": "Dat heeft de aanklager gezegd. De 19-jarige verdachte zei bij de voorgeleiding dat hij niet schuldig is aan de ten laste gelegde feiten. Volgens verslaggevers toonde hij geen emotie en zei hij vrijwel niets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
