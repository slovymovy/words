                                                "example_id": "560434b8-a424-4889-b811-7ea38433879f",
                                                "sense_id": "709f55b9-9fff-3525-bf6f-c43d118a1a51",
                                                "text": "De verzekering is voor een deel tussengekomen."
                                            }
                                        ]
