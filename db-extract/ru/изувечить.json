                    {
                        "form_id": "5ee36562-4e53-430e-9887-f9543171784a",
                        "entry_id": "ea3ebfbd-91ed-3f68-981f-d3816933991c",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "изуве́чивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "044e5771-d3d2-31b9-bc2b-69ae618e0446",
                        "entry_id": "ea3ebfbd-91ed-3f68-981f-d3816933991c",
                        "glosses": [
                            "нанести кому-нибудь тяжёлое телесное повреждение (повреждения), непоправимое увечье (увечья)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3e8593-52d5-4188-b780-2e8452cfd354",
                                "sense_id": "044e5771-d3d2-31b9-bc2b-69ae618e0446",
                                "text": "Хозяин рассказал мне, что сей битый мужик был теперь на сенокосе, где чужой мужик, поссорясь с ним и будучи его сильнее, так бесчеловечно его изувечил."
                            }
                        ]
                    },
                    {
                        "sense_id": "07fb5fe2-16a4-3112-8a15-8ea232898932",
                        "entry_id": "ea3ebfbd-91ed-3f68-981f-d3816933991c",
                        "glosses": [
                            "перен. привести в негодность, исковеркать что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e05b62-21f2-4050-bf97-0cc724e9411d",
                                "sense_id": "07fb5fe2-16a4-3112-8a15-8ea232898932",
                                "text": "Трактор изувечили, сани в щепки, рельсы вздыбили, и паровоза оба набок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16ba82b3-bace-4210-b970-66b84276442b",
                        "source_entry_id": "ea3ebfbd-91ed-3f68-981f-d3816933991c",
                        "source_sense_description": "нанести кому-нибудь тяжёлое телесное повреждение",
                        "target_lang_word": "mutiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22acd148-c869-3f04-8f04-b1c37fd056a4",
                                        "entry_id": "039e2485-cbd3-3571-a6ff-ee04f7340413",
                                        "glosses": [
                                            "Retrancher un membre ou quelque autre partie extérieure du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acdda36b-d7d2-4a5e-a137-f15e75725c70",
                                                "sense_id": "22acd148-c869-3f04-8f04-b1c37fd056a4",
                                                "text": "C'est sur-tout depuis quelque temps que j'ai été constamment appellé auprès des femmes mutilées par des accoucheurs et des matrônes mal-habiles que le nombre de ces victimes s'accroît tous les jours ; […]"
                                            },
                                            {
                                                "example_id": "913a3767-ab8d-4a17-95bb-6b720afc2f51",
                                                "sense_id": "22acd148-c869-3f04-8f04-b1c37fd056a4",
                                                "text": "Mutiler quelqu’un d’un bras, d’un pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c4792b-5520-3751-a878-2a89486f44c6",
                                        "entry_id": "039e2485-cbd3-3571-a6ff-ee04f7340413",
                                        "glosses": [
                                            "Enlever un morceau, une partie d'œuvres d’art, d'ouvrages de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f99ee8a2-728f-46fa-b503-c432d67ecebe",
                                                "sense_id": "73c4792b-5520-3751-a878-2a89486f44c6",
                                                "text": "Mutiler une statue."
                                            },
                                            {
                                                "example_id": "e6531b8c-7da6-4ded-91b4-f8150de4d02e",
                                                "sense_id": "73c4792b-5520-3751-a878-2a89486f44c6",
                                                "text": "On a mutilé ce chapiteau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cda0dcd-fda4-355e-91d7-934a5608c925",
                                        "entry_id": "039e2485-cbd3-3571-a6ff-ee04f7340413",
                                        "glosses": [
                                            "Défigurer."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e9df1ee-0e5d-4706-a3c5-2386244c0db8",
                                                "sense_id": "7cda0dcd-fda4-355e-91d7-934a5608c925",
                                                "text": "Ce tableau a été mutilé à coups de couteau."
                                            },
                                            {
                                                "example_id": "2a3f7ab8-7d5c-481f-b6fa-03d7fe160e1a",
                                                "sense_id": "7cda0dcd-fda4-355e-91d7-934a5608c925",
                                                "text": "Mutiler un texte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79da77af-73af-4a78-96a7-7a61f7c71d9e",
                        "source_entry_id": "ea3ebfbd-91ed-3f68-981f-d3816933991c",
                        "source_sense_description": "нанести кому-нибудь тяжёлое телесное повреждение",
                        "target_lang_word": "estropier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estropier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c31e63af-27b9-31f8-8df4-2de861499500",
                                        "entry_id": "abb058c6-2a94-3612-ab42-a1440c470106",
                                        "glosses": [
                                            "Priver de l’usage d’un membre, soit par une blessure, soit par quelque coup, soit par une maladie. → voir estropié"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9107895-224e-4e15-9a86-7fcbf5f92553",
                                                "sense_id": "c31e63af-27b9-31f8-8df4-2de861499500",
                                                "text": "Qui donc a osé estropier un animal appartenant à mon serf ? s’écria le Saxon enflammé de colère."
                                            },
                                            {
                                                "example_id": "b85013db-d73f-40d3-aca5-2808be17d918",
                                                "sense_id": "c31e63af-27b9-31f8-8df4-2de861499500",
                                                "text": "Le gros Gignoux, le maçon, qui ne faisait jamais attention à rien, ayant par mégarde posé le pied sur la patte du chien de M. Olivier, le domestique de celui-ci lui cria :\n– Enfin, vous n’allez pas estropier mon chien !"
                                            },
                                            {
                                                "example_id": "be63a091-424a-4fc0-bcab-c2515433222c",
                                                "sense_id": "c31e63af-27b9-31f8-8df4-2de861499500",
                                                "text": "Ils enlevèrent une oie, démolirent un clapier, estropièrent une chèvre, reniflèrent même les talons du piéton qui portait le courrier et enfin firent un peu de musique nocturne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61d4f6c5-13ec-340b-a0d3-d5ecba343cbf",
                                        "entry_id": "abb058c6-2a94-3612-ab42-a1440c470106",
                                        "glosses": [
                                            "Altérer, déformer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4894fcc-c684-4244-b966-b2e85dbacfdb",
                                                "sense_id": "61d4f6c5-13ec-340b-a0d3-d5ecba343cbf",
                                                "text": "Estropier un passage, une pensée, un exemple, une citation, un vers etc. - Estropier le nom d’une personne, les mots d’une langue."
                                            },
                                            {
                                                "example_id": "d022a37c-d4e8-4d60-a6fd-0383c53daa63",
                                                "sense_id": "61d4f6c5-13ec-340b-a0d3-d5ecba343cbf",
                                                "text": "TRISSOTIN : Va, va restituer tous les honteux larcins\nQue réclament sur toi les Grecs et les Latins.\nVADIUS : Va, va-t’en faire amende honorable au Parnasse,\nD’avoir fait à tes vers estropier Horace."
                                            },
                                            {
                                                "example_id": "d81d009c-3db7-4664-b224-ba750e91c1e7",
                                                "sense_id": "61d4f6c5-13ec-340b-a0d3-d5ecba343cbf",
                                                "text": "Il repartit lui-même; mais, dès qu'il fut hors de vue, il se cacha sous une ronce, guettant la route par où allait revenir morte, ou mourante, ou peut-être estropiée, défigurée à jamais, celle qu'il aimait encore d'une passion sauvage."
                                            },
                                            {
                                                "example_id": "1b4ec522-51a7-48c7-b079-9201c59a806e",
                                                "sense_id": "61d4f6c5-13ec-340b-a0d3-d5ecba343cbf",
                                                "text": "Nous comprenons journellement des étrangers qui estropient la prononciation de nos langues autrement qu’on n’estropiera jamais celle de l’Esperanto."
                                            },
                                            {
                                                "example_id": "320b1fcd-3307-4ce5-b07d-e49ba9dd0435",
                                                "sense_id": "61d4f6c5-13ec-340b-a0d3-d5ecba343cbf",
                                                "text": "Il lui était déplaisant qu’on estropiât les noms propres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccce439f-8ac0-4e0e-97e1-7eaf4117bb4d",
                        "source_entry_id": "ea3ebfbd-91ed-3f68-981f-d3816933991c",
                        "source_sense_description": "привести в негодность",
                        "target_lang_word": "détériorer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détériorer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eeacb00c-a539-3503-a242-bafa32f1d1c8",
                                        "entry_id": "a7e985cb-4ef0-344f-9e41-fea9299b6c4c",
                                        "glosses": [
                                            "Mettre en mauvais état."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac9199fc-a4f9-4941-8c44-498390204598",
                                                "sense_id": "eeacb00c-a539-3503-a242-bafa32f1d1c8",
                                                "text": "Il a laissé sa maison se détériorer."
                                            },
                                            {
                                                "example_id": "f553684f-9f8d-4f81-960a-7f69509630b7",
                                                "sense_id": "eeacb00c-a539-3503-a242-bafa32f1d1c8",
                                                "text": "Le temps détériore toutes choses."
                                            },
                                            {
                                                "example_id": "d29fcad9-13e4-4aaa-b1b5-537eeb387edc",
                                                "sense_id": "eeacb00c-a539-3503-a242-bafa32f1d1c8",
                                                "text": "Les marchandises ont été détériorées par l’humidité."
                                            },
                                            {
                                                "example_id": "6c56b939-597b-4278-bfbe-de8a4ee75e0e",
                                                "sense_id": "eeacb00c-a539-3503-a242-bafa32f1d1c8",
                                                "text": "On a laissé détériorer des tapisseries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
