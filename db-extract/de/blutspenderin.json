                        "sense_id": "3f596006-8c7d-3114-8813-dbc9e2193362",
                        "entry_id": "d8cd03bf-ce17-30de-991a-ad1b36c3e80a",
                        "glosses": [
                            "weibliche Person, die eine bestimmte Blutmenge aus dem eigenen Körper zur weiteren Verwendung entnehmen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f871ddc2-4f09-4264-9e0e-b8b517298d30",
                                "sense_id": "3f596006-8c7d-3114-8813-dbc9e2193362",
                                "text": "Blutspenderinnen helfen Leben zu retten."
                            },
                            {
                                "example_id": "350cd8db-a894-4793-8222-24c0e0018b37",
                                "sense_id": "3f596006-8c7d-3114-8813-dbc9e2193362",
                                "text": "„Letzthin ging durch die Presse eine kurze Notiz, daß in Lübecke bei Minden eine Kranke, die dringend einer Bluttransfusion bedurfte, eine Blutspenderin abwies, weil diese Rheinländerin sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
