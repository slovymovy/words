        "fr-extract.jsonl": [
            {
                "entry_id": "8dec15ce-ac99-39cb-9c9b-39c268a3e98a",
                "word": "ornithologue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32720d70-c2cf-4755-be67-360bd038b2fc",
                        "entry_id": "8dec15ce-ac99-39cb-9c9b-39c268a3e98a",
                        "tags": [
