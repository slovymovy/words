                "senses": [
                    {
                        "sense_id": "024390c4-593f-3732-a11f-be6b90a7b411",
                        "entry_id": "f18cbf23-9920-3ab2-8314-980374ebd1ed",
                        "glosses": [
                            "optoelektronisches Gerät, zur Verbesserung der visuellen Wahrnehmung bei schwachem Licht oder in der Dunkelheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84028b5b-07f4-458d-ac34-23afb71dcf7e",
                                "sense_id": "024390c4-593f-3732-a11f-be6b90a7b411",
                                "text": "„Bei den günstigen Nachtsichtgeräten werden alternativ CCD-Bildsensoren eingesetzt.“"
                            },
                            {
                                "example_id": "247698b1-edb5-492a-9b41-a0ea56f0ad1c",
                                "sense_id": "024390c4-593f-3732-a11f-be6b90a7b411",
                                "text": "„Da sich der Schwarzwild-Bestand schwer reduzieren lässt und die Wildschäden steigen, greifen Jäger, wie aus Insiderkreisen zu erfahren ist, immer öfter zu verbotenen Bejagungshilfen wie Nachtsichtgeräten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
