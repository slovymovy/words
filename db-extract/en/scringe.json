    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c6bcd63a-f709-3027-8932-8197ad97cad2",
                "word": "scringe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0d7c5cf6-d9bc-4e08-b388-f501ac1a6a0f",
                        "entry_id": "c6bcd63a-f709-3027-8932-8197ad97cad2",
                        "tags": [
                            "plural"
                        ],
                        "form": "scringes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68419230-b72a-34f1-a7e4-b0806410f647",
                        "entry_id": "c6bcd63a-f709-3027-8932-8197ad97cad2",
                        "glosses": [
                            "The act or sound of scratching or scraping."
                        ],
                        "tags": [
                            "UK",
                            "US",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "eb8b0613-3a05-4706-974c-12f8557179b1",
                                "sense_id": "68419230-b72a-34f1-a7e4-b0806410f647",
                                "text": "Any teenager who, like myself, has ever got the gooseflesh at the flush and scringe of Hopkins's assonances and alliterations proves this upon his or her pulses ."
                            },
                            {
                                "example_id": "bf5698e5-d1f9-4803-93cf-3da787f15247",
                                "sense_id": "68419230-b72a-34f1-a7e4-b0806410f647",
                                "text": "[…] to the scringe of bedsprings as the old landlady shook herself awake and reached for her false teeth,"
                            },
                            {
                                "example_id": "58a5f38e-60c4-43f8-9d35-1292f5996acf",
                                "sense_id": "68419230-b72a-34f1-a7e4-b0806410f647",
                                "text": "But Bill would have none of this: it grated upon his sensibility, like the scringe of chalk upon a slate in the schoolroom, or like our collie dog at home in Garvaghey, who, when Aunt Freda played the piano, would raise his noble nose and howl derisively."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f0d6e7d-2004-34e7-a881-11015ee1475e",
                        "entry_id": "c6bcd63a-f709-3027-8932-8197ad97cad2",
                        "glosses": [
                            "A cringe."
                        ],
                        "tags": [
                            "UK",
                            "US",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "0c35e7fc-673a-4b0e-a11b-2ab192b3f56d",
                                "sense_id": "7f0d6e7d-2004-34e7-a881-11015ee1475e",
                                "text": "Well, on that June day I embraced her with a slight scringe, and, seating her in my armchair, threw myself down upon the floor, out of reach of her arms, with my hands clasped around my knees."
                            },
                            {
                                "example_id": "0cc6ad59-9a45-44ab-b188-88ceece50ffc",
                                "sense_id": "7f0d6e7d-2004-34e7-a881-11015ee1475e",
                                "text": "Take courage, brother: you are making better progress than we are, for I cannot even get a scringe."
                            },
                            {
                                "example_id": "feced5a4-3559-4c93-9e36-6027910bac3a",
                                "sense_id": "7f0d6e7d-2004-34e7-a881-11015ee1475e",
                                "text": "A scringe of pain brought the German back to the present ."
                            }
                        ]
                    },
                    {
                        "sense_id": "faaaa329-fd42-349b-84e8-4e4f7bdc6444",
                        "entry_id": "c6bcd63a-f709-3027-8932-8197ad97cad2",
                        "glosses": [
                            "A type of dragnet with a bag in the center and a very fine mesh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34fd4e9-e075-475c-ab68-13e24c780126",
                                "sense_id": "faaaa329-fd42-349b-84e8-4e4f7bdc6444",
                                "text": "Trawling, or scringing, for salmon trout is, in some respects, similar to splashing, and is also carried on between the hours of sunset and sunrise, in the nooks, bays, and other suitable places along the sore of either the coast or of the sea-water loch, into which rivulets and streams empty themselves, although there are many places in which the splash net can be advantageously used where the scringe cannot be employed, as the latter requires a clear bottom, without any impediments, otherwise it cannot be drawn to the shore."
                            },
                            {
                                "example_id": "d2a9bc13-f4f0-447e-be9c-7a100598e506",
                                "sense_id": "faaaa329-fd42-349b-84e8-4e4f7bdc6444",
                                "text": "The scringe decidedly takes the precedence of the splash, provided sufficient strength as well as skill be employed for its effective management — because, if the net is not drawn equally and continuously towards the shore, many fish will escape."
                            },
                            {
                                "example_id": "7feb5c25-a772-405b-a777-26f84fb246ca",
                                "sense_id": "faaaa329-fd42-349b-84e8-4e4f7bdc6444",
                                "text": "Of course, with surface-swimming fish the scringe or ground seine need not touch the bottom."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9cec0b00-c379-3837-a462-24a5601a9c4c",
                "word": "scringe",
