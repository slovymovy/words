                "senses": [
                    {
                        "sense_id": "d7503dcb-5ecc-3792-aa3f-304b43148af2",
                        "entry_id": "19bbab27-1e3e-384c-be92-4197a259b9c1",
                        "glosses": [
                            "Kurzwort, das aus Silben oder Silbenteilen des Wortes besteht, aus dem es durch Kürzung hervorgegangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4a4441-759b-4ce4-a500-f5f01c1b3344",
                                "sense_id": "d7503dcb-5ecc-3792-aa3f-304b43148af2",
                                "text": "„Fleischer 1983 unterscheidet zwischen Initial- und Silbenwörtern einerseits und »eigentlichen« Kurzwörtern andererseits. “"
                            },
                            {
                                "example_id": "bfcd110c-919b-4364-8ab7-5f6e5d391d94",
                                "sense_id": "d7503dcb-5ecc-3792-aa3f-304b43148af2",
                                "text": "„Zu den multisegmentalen Kurzwörtern gehören Initialwörter entweder in Buchstabierweise (PLZ) oder in phonetischer Gebundenheit (BAföG …), Silbenwörter (Trafo) sowie Klammerformen: Sani(tärraum)zelle.“"
                            },
                            {
                                "example_id": "1f9b66ae-f149-4e3f-97fd-12f204e26d86",
                                "sense_id": "d7503dcb-5ecc-3792-aa3f-304b43148af2",
                                "text": "„Die Silben der Silbenwörter werden nach Aussprechbarkeit geformt; mit den Silbengrenzen der Langform müssen sie nichts zu tun haben…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
