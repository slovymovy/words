                ],
                "senses": [
                    {
                        "sense_id": "2ceb6d60-9227-3199-a788-0db21470c303",
                        "entry_id": "e8e3caf8-7e86-3d18-af77-6a73dca4b066",
                        "glosses": [
                            "Betrieb zur Herstellung von Quark"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53cbd714-0dc4-4905-8460-ba239494c106",
                                "sense_id": "2ceb6d60-9227-3199-a788-0db21470c303",
                                "text": "„Die Restmilchverwertung erfolgt in der Quarkerei mit einer Aufnahmekapazität von 10 000 l Milch.“"
                            },
                            {
                                "example_id": "76f77afb-f4e8-4454-a49d-fd90a9ca7eaa",
                                "sense_id": "2ceb6d60-9227-3199-a788-0db21470c303",
                                "text": "„Auch in den Betriebsräumen der Molkerei sowie in der Quarkerei und in der Butterei besteht die Gefahr der Schimmelentwicklung und der Pilzfleckenbildung an Decken und Wänden, woraus sich wieder eine erhöhte Infektionsgefahr für die Milch sowie für die Butter und den Quark ergibt.“"
                            },
                            {
                                "example_id": "8a59ea06-a841-48e6-b745-59085be246c8",
                                "sense_id": "2ceb6d60-9227-3199-a788-0db21470c303",
                                "text": "„Im Jahre 1928 eröffnete Bienert in der Karmelitenstraße einen neuen eigenen Molkereibetrieb als Frischmilchbetrieb mit Butterei, Quarkerei und Großhandel in Molkereierzeugnissen.“"
                            },
                            {
                                "example_id": "7897f6f8-1299-413a-8db7-c8394df2d5fb",
                                "sense_id": "2ceb6d60-9227-3199-a788-0db21470c303",
                                "text": "„Während seiner Ausbildung lernt er alle Bereiche des Betriebs kennen: von der Schaltwarte, wo die Milchtechnologen per Mausklick den Weg der Milch durch die Silos und Rohrleitungen der Molkerei lenken – bis zu 600 000 Liter täglich – über die Butterei oder Quarkerei bis zur Milchabfüllung.“"
                            },
                            {
                                "example_id": "10b1d504-9225-4db8-b8a1-6bc3b84849c4",
                                "sense_id": "2ceb6d60-9227-3199-a788-0db21470c303",
                                "text": "„Wenn die Quarkerei der Bayerischen Milchindustrie eG in Winkels Ende Oktober geschlossen wird, dann liegen 8000 Quadratmeter Produktionsanlagen und weitere 3000 Quadratmeter Grund brach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
