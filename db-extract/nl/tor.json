                "translations": [
                    {
                        "translation_id": "c90d2fb2-0c69-4a10-b317-a7ef70be11ef",
                        "source_entry_id": "3a80307d-a607-321b-8a14-cb58b20eb2cf",
                        "target_lang_word": "Käfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Käfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3657c80a-bbf5-3d25-b2a8-6347763edc84",
                                        "entry_id": "a7b97f55-3ac8-3c1a-bb18-6b0ae6d533c7",
                                        "glosses": [
                                            "Insekt mit harten Vorderflügeln, mit Larven- und Puppenstadium (Ordnung Coleoptera)"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "769d8ed6-31c3-41c8-a182-6691e071a7df",
                                                "sense_id": "3657c80a-bbf5-3d25-b2a8-6347763edc84",
                                                "text": "Die Igel finden immer weniger Käfer zum Fressen."
                                            },
                                            {
                                                "example_id": "9e2f1cf1-2245-4144-989d-40a9cb2e5fc2",
                                                "sense_id": "3657c80a-bbf5-3d25-b2a8-6347763edc84",
                                                "text": "„In der Zwischenzeit lungerte er im Schatten herum, schnappte Fliegen und Käfer auf dem Dach der Hütte, die Walt ihm gebaut hatte.“"
                                            },
                                            {
                                                "example_id": "d3bb5705-d6e3-4d08-922e-d4624687d5a8",
                                                "sense_id": "3657c80a-bbf5-3d25-b2a8-6347763edc84",
                                                "text": "„Denn dieser Käfer wurde im alten Ägypten als Bringer der Wiedergeburt und des Glücks verehrt.“"
                                            },
                                            {
                                                "example_id": "aa1f0f5c-191b-4b98-a346-0077f2b9d3a1",
                                                "sense_id": "3657c80a-bbf5-3d25-b2a8-6347763edc84",
                                                "text": "„Ein großer Käfer summt um die Lampe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44eda6e5-a038-36f9-9e36-2b52aefdf233",
                                        "entry_id": "a7b97f55-3ac8-3c1a-bb18-6b0ae6d533c7",
                                        "glosses": [
                                            "Umgangssprache der 1950er Jahre für ein hübsches Mädchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c93c32c-04c8-49a2-857b-b388915db551",
                                                "sense_id": "44eda6e5-a038-36f9-9e36-2b52aefdf233",
                                                "text": "Was hast du dir denn für'n Käfer aufgegabelt!?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3e826c07-fe62-3432-8401-19282b1b4dc4",
                                        "entry_id": "a7b97f55-3ac8-3c1a-bb18-6b0ae6d533c7",
                                        "glosses": [
                                            "Von Ferdinand Porsche entwickelter leichter Pkw in der Form eines Marienkäfers"
                                        ],
                                        "tags": [
                                            "Auto",
                                            "VW"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc592902-5f33-4da1-9f41-39d4b45987ee",
                                                "sense_id": "3e826c07-fe62-3432-8401-19282b1b4dc4",
                                                "text": "Mein alter Käfer läuft noch wie geschmiert."
                                            },
                                            {
                                                "example_id": "e28d4f14-bf28-4f61-9f8b-0960fed19ac0",
                                                "sense_id": "3e826c07-fe62-3432-8401-19282b1b4dc4",
                                                "text": "„Einmal fuhr Papa am Samstag nach dem Frühstück weg, um einen neuen Gebrauchtwagen zu kaufen, weil der Käfer so viele Macken hatte.“"
                                            },
                                            {
                                                "example_id": "2ba178a7-67bb-42b2-9f5f-9049496ca666",
                                                "sense_id": "3e826c07-fe62-3432-8401-19282b1b4dc4",
                                                "text": "„Gabys Käfer hielt vor einem dieser Mietshäuser aus der Jahrhundertwende in der Gegend am Eigelstein.“"
                                            },
                                            {
                                                "example_id": "0b3e958b-a6e7-4e49-a238-726713836bc5",
                                                "sense_id": "3e826c07-fe62-3432-8401-19282b1b4dc4",
                                                "text": "„Der Käfer tanzt im Schneematsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d0b0c7f-3870-4df0-82ee-d48b9e693880",
