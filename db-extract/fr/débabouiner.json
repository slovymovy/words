                ],
                "senses": [
                    {
                        "sense_id": "230b39d5-8bd4-3f18-9a42-15e4f0854a57",
                        "entry_id": "9c177dac-0c45-3fea-9270-b8642daaad6e",
                        "glosses": [
                            "Faire perdre son caractère de babouin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346c7d04-6243-46f2-b578-262bc1f941ac",
                                "sense_id": "230b39d5-8bd4-3f18-9a42-15e4f0854a57",
                                "text": "Mais le singe n’est pas fou. Avisant le sourire de mes larges babines, le temps de tondre un œuf et il se débabouine."
                            },
                            {
                                "example_id": "910cb1ca-efbf-4753-aa31-132c52468d1f",
                                "sense_id": "230b39d5-8bd4-3f18-9a42-15e4f0854a57",
                                "text": "Troublé par les hommages que l’on rend à sa belle, il fait les gros yeux au bardou (Linol est un maître du pancrace), l’asticote, celui qu’il débabouine."
                            }
                        ]
                    },
                    {
                        "sense_id": "905c01cd-8bcc-3de2-b0de-4ed8989dd55f",
                        "entry_id": "9c177dac-0c45-3fea-9270-b8642daaad6e",
                        "glosses": [
                            "Débarrasser des babouins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38640e3b-8901-4767-943c-422fc53a62b9",
                                "sense_id": "905c01cd-8bcc-3de2-b0de-4ed8989dd55f",
                                "text": "Dans ces cas-là, on reste patient et on attend que la voiture soit débabouinée avant de continuer sa route."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7130556-5065-3e35-ad31-a9c62b750858",
                        "entry_id": "9c177dac-0c45-3fea-9270-b8642daaad6e",
                        "glosses": [
                            "Retirer la terre des ceps de vigne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1018f51f-50b4-4477-9723-c6afba4f0a2c",
                                "sense_id": "b7130556-5065-3e35-ad31-a9c62b750858",
                                "text": "En mars « Débabouiner », c’est-à-dire retirer la terre des ceps avec la charrue vigneronne et un décavionneur pour faciliter la taille."
                            }
                        ]
                    }
                ],
