                "senses": [
                    {
                        "sense_id": "b4bab8af-adee-3cc6-b4ec-d149678095f4",
                        "entry_id": "171e7032-8a8a-31dc-bea2-c640e13e8f89",
                        "glosses": [
                            "Kraftfahrzeug, das speziell für Autorennen entwickelt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c32dd9b-af42-41e1-b48a-2494b0cbb183",
                                "sense_id": "b4bab8af-adee-3cc6-b4ec-d149678095f4",
                                "text": "Berühmt sind die roten Rennwagen von Ferrari."
                            },
                            {
                                "example_id": "222d8a2a-a4d8-4aef-909e-7b88ae048685",
                                "sense_id": "b4bab8af-adee-3cc6-b4ec-d149678095f4",
                                "text": "„Ein Motorradmotor treibt den Rennwagen \"TUfast\" der Maschinenbaustudenten der TU Garching an.“"
                            },
                            {
                                "example_id": "511c6078-6fa3-4915-89c3-0648f70c6f02",
                                "sense_id": "b4bab8af-adee-3cc6-b4ec-d149678095f4",
                                "text": "„Die beiden gingen, versöhnt durch den Ignoranten Kern, einträchtig in ihren abgeschabten Anzügen davon, um noch über einige Rennwagen zu streiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
