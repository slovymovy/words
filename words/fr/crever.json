{
    "word_family": [
        "crève",
        "crevaison",
        "crevard",
        "crève-cœur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ecfe78c-b7c0-3a20-9a96-2a54f3ee926f",
                    "sense_definition": "Cesser de vivre, en parlant d'un être vivant ; éprouver vivement un besoin, une douleur ou une émotion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue randonnée sous le soleil estival, je <w>crève</w> de soif."
                        },
                        {
                            "text": "Les pauvres bêtes finirent par <w>crever</w> de faim durant le rude hiver."
                        }
                    ],
                    "synonyms": [
                        "mourir"
                    ],
                    "common_phrases": [
                        "crever de faim",
                        "crever de soif",
                        "crever de chaud"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "10c9bd93-782a-316e-aa75-dd2054a572d6",
                    "sense_definition": "Percer, faire éclater ou trouer quelque chose en exerçant une pression ou un choc violent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat a réussi à <w>crever</w> le ballon avec ses griffes acérées."
                        },
                        {
                            "text": "D'un coup de pied maladroit, le gamin a <w>crevé</w> la toile tendue du parasol."
                        }
                    ],
                    "common_phrases": [
                        "crever un pneu",
                        "crever l'abcès"
                    ]
                },
                {
                    "sense_id": "77c3c56e-fab7-36ca-a250-cd7e7fa4d135",
                    "sense_definition": "Subir une perforation de pneumatique au cours d'un trajet en voiture ou à vélo.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crevaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai encore <w>crevé</w> en rentrant du bureau à cause d'un clou sur la route."
                        },
                        {
                            "text": "Si tu roules sur ces débris de verre, tu vas rapidement <w>crever</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "3a76c820-6761-3d91-98a0-d67c37d13859",
                    "sense_definition": "Se rompre ou s'ouvrir brusquement sous l'effet d'une trop forte pression interne ou extérieure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne remplis pas trop ce sac en papier car il va <w>crever</w> sous le poids."
                        },
                        {
                            "text": "Le ciel est sombre et les gros nuages d'orage vont bientôt <w>crever</w>."
                        }
                    ]
                },
                {
                    "sense_id": "b78097aa-671c-3c8e-aace-0d950e80831d",
                    "sense_definition": "Fatiguer excessivement quelqu'un, l'épuiser complètement jusqu'au bout de ses forces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fatigue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce déménagement difficile sans ascenseur m'a totalement <w>crevé</w> pour la journée."
                        },
                        {
                            "text": "Les journées continues de douze heures finissent par <w>crever</w> tous les ouvriers."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "d7492e29-c726-3309-88ec-bde006f8d534",
                    "sense_definition": "Tuer quelqu'un de manière brutale ou impitoyable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bandit furieux a menacé de <w>crever</w> le témoin s'il parlait à la police."
                        },
                        {
                            "text": "Les deux caïds du quartier ont juré de le <w>crever</w> pour venger leur frère."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argotique"
                        }
                    ]
                }
            ]
        }
    ]
