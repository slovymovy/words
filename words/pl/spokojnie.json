                    "sense_definition": "Bez problemu, z łatwością; używane, by wyrazić pewność, że coś się uda.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mamy jeszcze dużo czasu, więc <spokojnie> zdążymy na pociąg.",
                            "target_lang_translations": {
                                "ru": "У нас ещё много времени, так что мы <w>спокойно</w> успеем на поезд.",
                                "en": "We still have plenty of time, so we will <w>easily</w> make the train.",
                                "nl": "We hebben nog genoeg tijd, dus we halen <w>gemakkelijk</w> de trein.",
                                "de": "Wir haben noch viel Zeit, also werden wir <w>locker</w> den Zug erreichen.",
                                "fr": "Nous avons encore beaucoup de temps, donc nous arriverons <w>sans problème</w> à attraper le train.",
                                "it": "Abbiamo ancora molto tempo, quindi faremo <w>tranquillamente</w> in tempo per il treno.",
                                "cs": "Máme ještě dost času, takže <w>v klidu</w> stihneme vlak.",
                                "tr": "Hala çok vaktimiz var, bu yüzden trene <w>rahatlıkla</w> yetişiriz.",
                                "es": "Todavía tenemos mucho tiempo, así que <w>tranquilamente</w> llegaremos al tren.",
                                "zh": "我们还有很多时间，所以<w>完全可以</w>赶上火车。"
                            }
                        },
                        {
                            "text": "Ta ilość jedzenia <spokojnie> wystarczy dla wszystkich gości.",
                            "target_lang_translations": {
