                                "target_senses": [
                                    {
                                        "sense_id": "71457145-2951-3b08-955f-f6f10e2f8c1c",
                                        "entry_id": "06aaf44e-d62f-377d-b411-5a5710a373c1",
                                        "glosses": [
                                            "Qui est toujours vert, recouvert de feuilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "814965a1-31db-4a9b-87d4-147341e029a2",
                                                "sense_id": "71457145-2951-3b08-955f-f6f10e2f8c1c",
                                                "text": "Le palmier chanvre n’est qu’un exemple célèbre parmi d’autres. Gian-Reto Walther, de l’Université de Bayreuth, a dénombré au sud de la Suisse quinze nouvelles espèces exotiques sempervirentes qui se sont associées à la flore indigène au cours des vingt dernières années."
                                            },
                                            {
