                "senses": [
                    {
                        "sense_id": "96888862-7e51-3d34-8ff3-956dcd32037a",
                        "entry_id": "2f06eca9-cf87-3621-9fcf-f81819cb9db2",
                        "glosses": [
                            "een angst veroorzakende droom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f50271-8023-40ef-8d92-40d77285c62b",
                                "sense_id": "96888862-7e51-3d34-8ff3-956dcd32037a",
                                "text": "Starling had vijf uur lang vast geslapen toen ze in het holst van de nacht midden in een angstdroom ontwaakte."
                            },
                            {
                                "example_id": "aefdb2dc-ad96-4c3a-9c3f-85fd255f4327",
                                "sense_id": "96888862-7e51-3d34-8ff3-956dcd32037a",
                                "text": "Ik had een angstdroom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d52b6fe3-43fc-4c98-b559-68f3c8dd9dc4",
                        "source_entry_id": "2f06eca9-cf87-3621-9fcf-f81819cb9db2",
                        "source_sense_id": "96888862-7e51-3d34-8ff3-956dcd32037a",
                        "source_sense_description": "een angst veroorzakende droom",
                        "target_lang_word": "Angsttraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angsttraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd26110d-4e81-336a-9c9b-8bc98c7baeeb",
                                        "entry_id": "9670f715-be73-386d-924e-c3b13677bee3",
                                        "glosses": [
                                            "Traum, in dem Angst erlebt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4e0a5d-ce7f-4769-9797-6feafa7383a2",
                                                "sense_id": "dd26110d-4e81-336a-9c9b-8bc98c7baeeb",
                                                "text": "„Es erinnerte mich an die Zeit in Ellis Island, als ich aus dem Schlafsaal auf die unerreichbare Stadt hinübergestarrt hatte, wenn ich nachts aus meinen Angstträumen erwacht war.“"
                                            },
                                            {
                                                "example_id": "903a5ee7-0800-455a-b7ba-f2b2e9824073",
                                                "sense_id": "dd26110d-4e81-336a-9c9b-8bc98c7baeeb",
                                                "text": "„Schlaflos lag Thomas Lieven, wenn er aus solchen Angstträumen emporfuhr, lag da in der widerlichen Kasernenstube, in der sechs Mann schnarchten und stöhnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e8674a4-451c-4355-b8fc-ebebcedf8a10",
                        "source_entry_id": "2f06eca9-cf87-3621-9fcf-f81819cb9db2",
