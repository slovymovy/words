                    }
                ],
                "translations": [
                    {
                        "translation_id": "a26ef445-9178-426b-94b9-e0843dd42151",
                        "source_entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                        "source_sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                        "source_sense_description": "streek die geografisch verder weg ligt, maar economisch verbonden is met een voorliggende streek of stad",
                        "target_lang_word": "Hinterland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinterland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbffce4-6938-323d-8a86-b50d007e061f",
                                        "entry_id": "fb168d44-ea21-3d18-8944-d91de339f5b9",
                                        "glosses": [
                                            "das hinter der Front liegende Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "822b7fda-d188-4ee5-9221-e72b0eff0d1c",
                                                "sense_id": "cbbffce4-6938-323d-8a86-b50d007e061f",
                                                "text": "„Auch der nächste große Angriff kommt aus dem schwarzen Nichts heraus. Urplötzlich zuckt es aus allen Rohren. […] Diesmal hält der Damm nicht stand. Diesmal bricht die Flut eine Bresche und ergießt sich weit ins Hinterland.“"
                                            },
                                            {
                                                "example_id": "5295e580-a354-4e2f-9586-2e1e88890ff1",
                                                "sense_id": "cbbffce4-6938-323d-8a86-b50d007e061f",
                                                "text": "„Sie lehnte es rundweg ab, sich ins Hinterland bringen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                        "entry_id": "fb168d44-ea21-3d18-8944-d91de339f5b9",
                                        "glosses": [
                                            "um ein wirtschaftliches, politisches, kulturelles Zentrum gelegenes Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64c8a666-39e9-47f2-9942-488329248a80",
                                                "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                                "text": "„Sie [die Orte] sind ein Teil jener öden, lombardischen Weite, welche die Mailänder »Hinterland« nennen. Das Hinterland versorgt die Stadt mit Arbeitern, mit Waren, mit Konsumenten.“"
                                            },
                                            {
                                                "example_id": "b00f315d-1c11-47a0-a044-04d1eb5d689a",
                                                "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                                "text": "„Die Verstorbenen endeten in jenen gewaltigen Hochmooren, die sich vor 2000 Jahren im germanischen Hinterland an der Nordseeküste erstreckten.“"
                                            },
                                            {
                                                "example_id": "e941af08-b53b-4067-9cbb-37085ed54fab",
                                                "sense_id": "50915c2b-0485-3de1-a6b1-214a1bd7b614",
                                                "text": "„Der Theologe Bernhard Schwarz ist der Forschungsreisende, der 1885 von der Küste aus die erste Forschungsreise in das Hinterland von Kamerun unternommen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d89f3de6-dd5a-418e-b491-58358bb399a0",
                        "source_entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                        "source_sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                        "source_sense_description": "streek die geografisch verder weg ligt, maar economisch verbonden is met een voorliggende streek of stad",
                        "target_lang_word": "hinterland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinterland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa4f80d-97ad-3bb2-8385-9b00f6211a4c",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "The land immediately next to, and inland from, a coast."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a9a14f8-7ce3-4cfc-8781-94036840b592",
                                                "sense_id": "dfa4f80d-97ad-3bb2-8385-9b00f6211a4c",
                                                "text": "In West Wales it has never been possible until recently to exploit the magnificent natural harbour of Milford Haven, for there was no industrial hinterland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5b40cf-5337-36ce-b829-0d97f4a0786f",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "The rural territory surrounding an urban area, especially a port."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d1a5594-65b7-3c6c-baad-9a72503a4098",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "A remote or undeveloped area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0adce716-94b9-46ac-9429-53f23b055fed",
                                                "sense_id": "4d1a5594-65b7-3c6c-baad-9a72503a4098",
                                                "text": "In the film, Hanks is a veteran traversing the Texas hinterlands during the Reconstruction period when he stumbles upon a lost young white girl (Helena Zengel) who only speaks Kiowa, and is forced to undergo a dangerous journey to bring the orphan to her family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22bedc63-e7b9-38ca-a566-bce659b96d2a",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "That which is unknown or unexplored about someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea769729-10cb-41d7-8732-ed31400345e8",
                                                "sense_id": "22bedc63-e7b9-38ca-a566-bce659b96d2a",
                                                "text": "Near-synonym: shadow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "496a3a32-8f41-35f4-8fab-e2cf94e75450",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "An area of land far from the sea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f011691-9675-35f4-86ac-b33860334180",
                                        "entry_id": "d1947715-9a9f-36f6-912a-0e7ec0c096a6",
                                        "glosses": [
                                            "Anything vague or ill-defined, especially something that is ill understood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081c61d6-065b-4822-9bcb-66ff686258e9",
                                                "sense_id": "4f011691-9675-35f4-86ac-b33860334180",
                                                "text": "Near-synonym: shadowland"
                                            },
                                            {
                                                "example_id": "578236ff-bb23-427f-86af-229ae6229c4b",
                                                "sense_id": "4f011691-9675-35f4-86ac-b33860334180",
                                                "text": "This approach utilizes concepts such as naming, describing, contrasting and equating to access the hinterland between structure and meaning, and to map out the subtle ways in which texts can naturalise the ideology of the perfect female form."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ae20a81-d844-4104-9edf-8e1570ef2e54",
                        "source_entry_id": "24c70da4-2767-3749-98bf-01c42bd8398f",
                        "source_sense_id": "0bea7692-a024-39eb-ae65-104bf4f00a0a",
                        "source_sense_description": "streek die geografisch verder weg ligt, maar economisch verbonden is met een voorliggende streek of stad",
                        "target_lang_word": "arrière-pays",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-pays",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                        "entry_id": "c7d1d6e2-bb16-3275-8d16-18b0c0d665cb",
                                        "glosses": [
                                            "Contrée située à l’arrière d’une ville côtière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563ecbe6-fca2-4d59-9892-9c05e806477e",
                                                "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                                "text": "Casablanca était transformé en un presidio complétement isolé de son arrière-pays, qui était l’unique raison d’être et le seul moyen d’existence de cette ville exclusivement commerçante."
                                            },
                                            {
                                                "example_id": "97a8e1f6-53dc-4691-8abc-1ca8bd95db7e",
                                                "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                                "text": "Cette notion d’arrière-pays ne garde un sens fort, ne mérite d’être interrogée que si on la rapporte à un homme en situation, que si l’on pense le paysage comme un fragment de terre à baliser, à percevoir d’un certain lieu que nous occupons."
                                            },
                                            {
                                                "example_id": "b05a0615-4fc2-4114-8faa-8399a23a5f9d",
                                                "sense_id": "25b82550-3906-3bf1-b449-02ac7962b86e",
                                                "text": "Dès que l’on entre dans les arrière-pays varois et niçois, le climat est un peu moins tempéré, le thermomètre descendant facilement l’hiver et grimpant vite l’été."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be0868cc-de67-3c75-a509-bb019848b625",
                                        "entry_id": "c7d1d6e2-bb16-3275-8d16-18b0c0d665cb",
                                        "glosses": [
                                            "Contrée circonvoisine."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "536820b9-6c5f-434a-8595-891a63acdd38",
                                                "sense_id": "be0868cc-de67-3c75-a509-bb019848b625",
                                                "text": "On utilise sans vergogne l’arrière-pays, du moins sa partie non protégée, non mise en réserve pour accueillir des décharges intempestives, les fûts toxiques, les activités polluantes et les ayatollahs de l’écologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4df511-ef77-3731-8de7-df652fb74f85",
                                        "entry_id": "c7d1d6e2-bb16-3275-8d16-18b0c0d665cb",
                                        "glosses": [
                                            "Région plus éloignée, voire sauvage, rarement visitée."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a734718-edb5-4948-89a2-90c5019565d2",
                                                "sense_id": "6a4df511-ef77-3731-8de7-df652fb74f85",
                                                "text": "Le Québec est un vrai paradis de chasse. Plus de 20,000 orignaux ont été prélevés cette année par les 170,000 nemrods qui se sont aventurés dans l’arrière-pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
