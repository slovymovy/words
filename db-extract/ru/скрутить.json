                    },
                    {
                        "sense_id": "e7bfcf31-0870-3b9f-945b-3b40e8e6696b",
                        "entry_id": "e9e01c51-13e5-3e47-b4b3-093f1a80e94b",
                        "glosses": [
                            "to bind, to tie up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c39e502-b1ff-472f-a13b-9d96e29319e2",
                                "sense_id": "e7bfcf31-0870-3b9f-945b-3b40e8e6696b",
                                "text": "скрути́ть ру́ки кому́-либо",
                                "translation": "to pinion someone's arms; pinion someone",
                                "english": "to pinion someone's arms; pinion someone"
                            },
                            {
                                "example_id": "1288f5f3-d7bb-4fb9-abc2-0204cff6ada7",
                                "sense_id": "e7bfcf31-0870-3b9f-945b-3b40e8e6696b",
                                "text": "В золоты́х цепя́х я утопа́ю в боло́те,\nКровь моя́ чи́ще чи́стых нарко́тиков,\nВме́сте с други́ми тебя́ скру́тят на пло́щади,\nА я скручу́ с свое́й но́вой жилпло́щади",
                                "translation": "Death No More",
                                "english": "Death No More"
                            }
                        ]
                    },
                    {
                        "sense_id": "ce7638ad-ec5d-31a9-9ebc-32802339133a",
                        "entry_id": "e9e01c51-13e5-3e47-b4b3-093f1a80e94b",
                        "glosses": [
                            "to bring into submission, to subdue, to overmaster"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2c20bd7d-42c4-46b9-82b2-d0cc6c10f901",
                                "sense_id": "ce7638ad-ec5d-31a9-9ebc-32802339133a",
                                "text": "скрути́ть в бара́ний рог",
                                "translation": "make knuckle under; make toe the line",
                                "english": "make knuckle under; make toe the line"
                            }
                        ]
                    },
                    {
                        "sense_id": "6e1ed6ed-1709-34d9-b693-48f0a11b8b89",
                        "entry_id": "e9e01c51-13e5-3e47-b4b3-093f1a80e94b",
                        "glosses": [
                            "(disease) to overpower, to attack, to seize"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "146ebee9-a4a7-48fb-be99-cb9f66554074",
                                "sense_id": "6e1ed6ed-1709-34d9-b693-48f0a11b8b89",
                                "text": "его́ скрути́л парали́ч",
                                "translation": "he was paralyzed",
                                "english": "he was paralyzed"
                            },
                            {
                                "example_id": "09c449d9-1c44-4016-b9d0-4cd4105e5f07",
                                "sense_id": "6e1ed6ed-1709-34d9-b693-48f0a11b8b89",
                                "text": "меня́ скрути́ло от бо́ли",
                                "translation": "I had an attack/paroxysm of rending pain",
                                "english": "I had an attack/paroxysm of rending pain"
                            }
                        ]
                    }
