                            },
                            {
                                "target_lang_word": "рассеянность",
                                "target_lang_sense_clarification": "забывчивость в повседневных мелочах"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Unaufmerksamkeit",
