                                        "entry_id": "bcd8badc-f29e-3772-b5e8-d34ae1688860",
                                        "glosses": [
                                            "das Studienfach Jura, Rechtswissenschaft"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a405c52-abe4-4fdf-a14b-b2fa7b457ad7",
                                                "sense_id": "a6a0488f-354a-3aea-8f25-3c262794be26",
                                                "text": "Nach der Matura will Peter Jus studieren."
                                            },
                                            {
                                                "example_id": "fd0e4fd6-2aa3-4d56-a4cc-42bd35c7070d",
                                                "sense_id": "a6a0488f-354a-3aea-8f25-3c262794be26",
                                                "text": "„Der Neffe sei ein hochintelligenter junger Mann, er studiere Jus und Philosophie, und ja, er engagiere sich in der Politik.“"
