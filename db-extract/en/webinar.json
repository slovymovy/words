                                "target_senses": [
                                    {
                                        "sense_id": "bc3f5997-d1d9-3a6b-a7bc-72110ba12b47",
                                        "entry_id": "31edcfce-510f-3e53-8b76-4d78f7b6ea78",
                                        "glosses": [
                                            "een lezing, workshop, college of soortgelijke presentatie of vorm van kennisoverdracht die plaatsvindt via het internet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a825112f-a11c-464a-b9e7-a2ae7ed1e65d",
                                                "sense_id": "bc3f5997-d1d9-3a6b-a7bc-72110ba12b47",
                                                "text": "Momenteel wordt er een webinar georganiseerd om alle kennis landelijk te delen, zegt Joost Bart, patholoog bij het UMCG en voorzitter van de Nederlandse vereniging voor pathologie."
                                            },
                                            {
                                                "example_id": "c17840b5-0cb1-42cf-840d-20a6c95a9ae5",
                                                "sense_id": "bc3f5997-d1d9-3a6b-a7bc-72110ba12b47",
                                                "text": "Internetcriminelen zouden er de afgelopen weken in zijn geslaagd om het systeem achter Zoom te hacken. Ze wisten onder meer online lessen van scholen te onderbreken en plaatsten racistische teksten tijdens een webinar over antisemitisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec2fba6f-e515-42a7-9a94-728271c89bc7",
                        "source_entry_id": "d4613e6e-8c56-3ea5-bfc8-2693c9362853",
