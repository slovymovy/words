                        "examples": [
                            {
                                "example_id": "53c5361d-a132-4d64-be9b-ee5a8ffeff7f",
                                "sense_id": "839f2505-6951-38b6-8850-fa4678c14a04",
                                "text": "Dann hab i glei des Pickerl auffepickt, damit’s mi in Esterreich ned aufhoitn."
                            },
                            {
                                "example_id": "f3c9bac1-c918-4c39-bf78-e3f333c6a7a0",
                                "sense_id": "839f2505-6951-38b6-8850-fa4678c14a04",
                                "text": "„Da Berndi hot de Zeddln fias Moped überoi auffepickt: stolzer Preis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
