                "senses": [
                    {
                        "sense_id": "f2f904ca-90dc-374e-bc16-7f22af40a676",
                        "entry_id": "4bb590ac-58f5-3ad0-9b36-23a29785c531",
                        "glosses": [
                            "Chef militaire dans certaines régions d’Europe centrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5c9a19-6fa4-4eee-a3d3-ca122c75afb4",
                                "sense_id": "f2f904ca-90dc-374e-bc16-7f22af40a676",
                                "text": "Le sultan, pour tenir en haleine sa fortune et ses troupes, se jeta soudainement sur la Valachie, où un vayvode insensé de cruauté, nommé Drakul (ou Satan), faisait subir aux prisonniers turcs qu'il enlevait sur les frontières des tortures dignes de ce peuple redevenu sauvage sous lui"
                            }
                        ]
                    },
                    {
                        "sense_id": "8a403b4a-40b9-3808-8f03-3e75baca936c",
                        "entry_id": "4bb590ac-58f5-3ad0-9b36-23a29785c531",
                        "glosses": [
                            "Prince de Valachie ou de Moldavie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a0cac2-56ac-4e45-85ea-67a186d2ac15",
                                "sense_id": "8a403b4a-40b9-3808-8f03-3e75baca936c",
                                "text": "Le roi de Pologne, Étienne Battori, vayvode de Transylvanie, étant mort le 13 décembre 1586, le czar de Russie, Fœdor, se met sur les rangs ; mais il est unanimement refusé."
                            }
                        ]
                    },
                    {
                        "sense_id": "af685f25-f916-3dbe-be1f-1e57753fb31f",
                        "entry_id": "4bb590ac-58f5-3ad0-9b36-23a29785c531",
                        "glosses": [
                            "Titre slave adopté par les Turcs et devenu synonyme de gouverneur civil de province ou de district, recevant la dîme et les impôts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50396d0-f152-4f99-84c8-b44aa94caee8",
                                "sense_id": "af685f25-f916-3dbe-be1f-1e57753fb31f",
                                "text": "Je vis un moment le vayvode ; c’était un jeune Grec fort affable."
                            },
                            {
                                "example_id": "5476533f-99af-4ce3-92cf-48572f8ea35f",
                                "sense_id": "af685f25-f916-3dbe-be1f-1e57753fb31f",
                                "text": "les caloières en remplissent quelques turbes ou petits sacs de poil de bestes, lequels ils baillent aux Turcs qui sont présents, savoir au soubachi ou au vayvode."
                            }
                        ]
                    }
