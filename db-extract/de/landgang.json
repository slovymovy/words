                "senses": [
                    {
                        "sense_id": "887e645f-8868-3153-be0a-ea254be5810e",
                        "entry_id": "f51abf63-91d2-3e36-9e74-4cdde27c6206",
                        "glosses": [
                            "Verlassen des Schiffs während der arbeitsfreien Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c434eb6e-cda4-4228-93c9-e8900682ccf4",
                                "sense_id": "887e645f-8868-3153-be0a-ea254be5810e",
                                "text": "„Ambly und mir war es halbwegs schon zur Gewohnheit geworden, nach Einbruch der Dunkelheit einen kurzen Landgang anzutreten.“"
                            },
                            {
                                "example_id": "7063d1fd-b6d1-4cf0-9739-1b690792d2f9",
                                "sense_id": "887e645f-8868-3153-be0a-ea254be5810e",
                                "text": "„Es gab keine Toilette an Bord, und an einen Landgang war nicht zu denken.“"
                            },
                            {
                                "example_id": "9d2a3988-6900-495c-b033-2c92705d1e88",
                                "sense_id": "887e645f-8868-3153-be0a-ea254be5810e",
                                "text": "„Bis auf die Wachen in der Maschine und an Deck war für die Besatzung Landgang angesagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
