                    "sense_id": "7856045e-64ea-3ef1-b9f5-9edca142774d",
                    "sense_definition": "to transplant living tissue surgically",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medicine_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeons will <w>graft</w> skin from the patient's thigh to the injured area.",
