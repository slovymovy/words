                    {
                        "translation_id": "ca8d537c-7ac2-4df1-925b-968e54dbf635",
                        "source_entry_id": "62972c2e-f102-3bb9-a963-af4038f1a896",
                        "source_sense_description": "region south of the Pyrenees",
                        "target_lang_word": "Ibérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ibérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19d20f8d-57cc-3555-a8e6-33eeda1eda6f",
                                        "entry_id": "05a50bf0-b08a-3204-a1e5-a771e04da7bd",
                                        "glosses": [
                                            "Péninsule Ibérique, dans un contexte gréco-romain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c5a3eb9-3989-427a-9daa-1622a9190d00",
                                                "sense_id": "19d20f8d-57cc-3555-a8e6-33eeda1eda6f",
                                                "text": "D’importants réseaux commerciaux sont également nécessaires pour l’approvisionnement du cuivre (en provenance des îles Britanniques, d’Ibérie, des Alpes orientales et des Carpates) et surtout de l’étain, beaucoup plus rare (de Bretagne, de Loire-Atlantique, du Limousin, principalement)."
                                            },
                                            {
                                                "example_id": "ef4a2eb1-1edf-403e-adba-d3d623d6a094",
                                                "sense_id": "19d20f8d-57cc-3555-a8e6-33eeda1eda6f",
                                                "text": "Suivant quelques auteurs, les Ibères qui peuplèrent l’Espagne seraient originaires de la Géorgie, autrefois nommée Ibérie, au pied du Caucase, entre la mer Noire et la mer Caspienne."
                                            },
                                            {
                                                "example_id": "78de147a-c5c0-4866-b664-675425d0d057",
                                                "sense_id": "19d20f8d-57cc-3555-a8e6-33eeda1eda6f",
                                                "text": "Les Wisigoths pénétrèrent en Espagne dès 414, comme fédérés de l’Empire romain. L’Ibérie était alors aux mains des Vandales, installés en Bétique (l’Andalousie actuelle), des Suèves et des Alains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Ibérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4d74dd9-8ff1-398a-809a-85549f469814",
                                        "entry_id": "1405cda2-d636-3e23-9768-3276c415dede",
                                        "glosses": [
                                            "Territoire et État de l’Antiquité correspondant au royaume de Karthli et aux parties méridionale et orientale de l’actuelle République de Géorgie actuelle, dans un contexte gréco-romain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0049df4-1e68-4538-8734-dbac5dd5ad32",
                                                "sense_id": "e4d74dd9-8ff1-398a-809a-85549f469814",
                                                "text": "La conquête romaine de l’Ibérie en 65 av. J.-C. illustre les convoitises des Romains qui confièrent finalement le royaume à Polémon Iᵉʳ avant son morcellement en plusieurs principautés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e759c3fc-c222-48fa-bff0-ca5a8a303d19",
                        "source_entry_id": "62972c2e-f102-3bb9-a963-af4038f1a896",
                        "source_sense_description": "region south of the Pyrenees",
                        "target_lang_word": "Iberien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
