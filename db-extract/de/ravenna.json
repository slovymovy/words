                                        "sense_id": "719e4414-7414-387f-ba81-46f950c7d25d",
                                        "entry_id": "80f47ed5-9863-3b00-bfd7-5c7f7d3b6cd4",
                                        "glosses": [
                                            "A city, the county seat of Portage County, Ohio, United States, named after the Italian city."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
