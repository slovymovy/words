                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обступи́в"
                    },
                    {
                        "form_id": "3e762e0f-3790-4a81-8c1d-1d96f2757740",
                        "entry_id": "16a189e9-4dac-3a2e-9b12-5712f582edba",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обступи́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e7d7a1c-3450-3eaa-9ba1-d281c3b15264",
                        "entry_id": "16a189e9-4dac-3a2e-9b12-5712f582edba",
                        "glosses": [
                            "плотно окружая, встать вокруг чего-либо или кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2960692f-bba6-4e00-9071-ae499d9f2201",
                                "sense_id": "6e7d7a1c-3450-3eaa-9ba1-d281c3b15264",
                                "text": "Мальчики обступили его и тотчас устремили на него пристальные, ожидающие взгляды."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ca6dd43-457d-3147-9195-a1ceaae3fb3a",
                        "entry_id": "16a189e9-4dac-3a2e-9b12-5712f582edba",
                        "glosses": [
                            "располагаясь вокруг чего-либо, охватить что-либо со всех сторон"
                        ],
                        "tags": [
                            "о деревьях, горах и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "680d4ade-4bf8-4493-9093-d9878ac79cc1",
                                "sense_id": "6ca6dd43-457d-3147-9195-a1ceaae3fb3a",
                                "text": "Теперь он был мёртв. Сильное, цветущее тело его обступила маленькая зелёная армия лесной травы и, колыхаясь, заглянула в лицо."
                            }
                        ]
                    },
                    {
                        "sense_id": "2be93510-d540-3b5f-bc6f-98b0aedd25c4",
                        "entry_id": "16a189e9-4dac-3a2e-9b12-5712f582edba",
                        "glosses": [
                            "перен.; окутать, охватить что-либо"
                        ],
                        "tags": [
                            "о мраке, тишине и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "a062bc6a-2768-47a9-b26a-e93bcd5ab39a",
                                "sense_id": "2be93510-d540-3b5f-bc6f-98b0aedd25c4",
                                "text": "Тёмная бездна внезапно обступила его со всех сторон, и он глядел в эту темноту бессмысленно и отчаянно."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d5ee0bc-5b0d-32de-bc72-1a28516a2087",
                        "entry_id": "16a189e9-4dac-3a2e-9b12-5712f582edba",
                        "glosses": [
                            "перен.; навязчиво возникнуть в сознании; беспокоить, тревожить"
                        ],
                        "tags": [
                            "о мыслях, заботах и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "f7fe89ba-a9eb-4b7d-9550-18a947ae9e10",
                                "sense_id": "0d5ee0bc-5b0d-32de-bc72-1a28516a2087",
                                "text": "Тотчас же мысли о доме, о муже, о сыне и заботы предстоящего дня и следующих обступили её."
                            }
                        ]
                    }
                ],
