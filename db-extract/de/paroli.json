                "senses": [
                    {
                        "sense_id": "65c40f6d-f60f-3789-9231-e73ac3d05029",
                        "entry_id": "a2b67701-7c50-3bb0-92fe-c0152ded0389",
                        "glosses": [
                            "eine Erhöhung in einem bestimmten Glücksspiel, siehe Parolispiel, Pharo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "801f8bc7-bc53-4059-ba62-92156889cad2",
                                "sense_id": "65c40f6d-f60f-3789-9231-e73ac3d05029",
                                "text": "„Gewinnt das Paroli, so erhält der Spieler von der Bank das Dreifache des ursprünglichen Satzes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31663e00-dfcb-4bdc-baed-10bc74346ad5",
                        "source_entry_id": "a2b67701-7c50-3bb0-92fe-c0152ded0389",
                        "source_sense_id": "65c40f6d-f60f-3789-9231-e73ac3d05029",
                        "source_sense_description": "eine Erhöhung in einem bestimmten Glücksspiel, siehe Parolispiel, Pharo",
                        "target_lang_word": "raise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ccacd1d-5360-3fc7-8080-6a3aa0eb5059",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "096fcaca-bf62-4527-b91a-98f7913359d2",
                                                "sense_id": "0ccacd1d-5360-3fc7-8080-6a3aa0eb5059",
                                                "text": "to raise your hand if you want to say something; to raise your walking stick to defend yourself"
                                            },
                                            {
                                                "example_id": "61de23e1-8e5f-42b4-b85e-a5217bdc26f4",
                                                "sense_id": "0ccacd1d-5360-3fc7-8080-6a3aa0eb5059",
                                                "text": "the flag was raised"
                                            },
                                            {
                                                "example_id": "c550061e-1423-4eae-aadf-f902d1378b4b",
                                                "sense_id": "0ccacd1d-5360-3fc7-8080-6a3aa0eb5059",
                                                "text": "With the completion of the preliminary work of raising bridges on the Mauldeth Road-Wilmslow line, to accommodate overhead electrical equipment, further work has been put in hand on bridges on the London Midland Region main line between Manchester and Crewe."
                                            },
                                            {
                                                "example_id": "9f35c7db-05d9-44fc-82a9-7833c652dabc",
                                                "sense_id": "0ccacd1d-5360-3fc7-8080-6a3aa0eb5059",
                                                "text": "Because of the heavy traffic, the 1960-61 Christmas guide to trains between King's Cross and the north stated: \"To make travel conditions as comfortable as possible, passengers are requested to raise arm rests to enable four people to be seated on each side of those compartments which are fitted with arm rests.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c0a992-fb13-3a97-b03c-f2c7dae07fa0",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To form by the accumulation of materials or constituent parts; to build up; to erect."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f902be-1a37-4843-831f-29b18c0fa16e",
                                                "sense_id": "a9c0a992-fb13-3a97-b03c-f2c7dae07fa0",
                                                "text": "to raise a wall, or a heap of stones"
                                            },
                                            {
                                                "example_id": "40d87f07-ada8-4db4-ac71-adef3292154d",
                                                "sense_id": "a9c0a992-fb13-3a97-b03c-f2c7dae07fa0",
                                                "text": "I will raise forts against thee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef1b23b-7f3b-3f9d-98b4-046497b22d87",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To cause something to come to the surface of water."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39316671-6827-4332-a8ef-51b0ddc1c08f",
                                                "sense_id": "3ef1b23b-7f3b-3f9d-98b4-046497b22d87",
                                                "text": "The ship was raised ten years after it had sunk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54113959-6c58-3c84-8544-cf24ad1101b0",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To cause (the land or any other object) to seem higher by drawing nearer to it."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd583a6-8d82-4737-913e-b4028328edba",
                                                "sense_id": "54113959-6c58-3c84-8544-cf24ad1101b0",
                                                "text": "to raise Sandy Hook light"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "047fe999-ae4c-3c0f-95e4-bcf749450e55",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To make (bread, etc.) light, as by yeast or leaven."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f457edbb-51c7-3db1-a85d-60b9dc0e5e54",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To cause (a dead person) to live again; to resurrect."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61b3c51-c2a1-4502-a4f2-76af9d1a582e",
                                                "sense_id": "f457edbb-51c7-3db1-a85d-60b9dc0e5e54",
                                                "text": "The magic spell raised the dead from their graves!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e1fbb20-263a-34b7-a963-e0ead943667b",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To remove or break up (a blockade), either by withdrawing the ships or forces employed in enforcing it, or by driving them away or dispersing them."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b394a265-2ce3-3f74-89b0-cb1ef3f3c991",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To relinquish (a siege), or cause this to be done."
                                        ],
                                        "tags": [
                                            "physical",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9851e013-ba22-3783-b0a6-8845c9975883",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To cause to rise; to lift or elevate.",
                                            "To emboss (sheet metal), or to form it into cup-shaped or hollow articles, by hammering, stamping, or spinning."
                                        ],
                                        "tags": [
                                            "physical",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b59abe27-ae30-3af7-a131-ec32128c4909",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To create, increase or develop."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15931e7-18ac-46ff-8ff6-db97bae75700",
                                                "sense_id": "b59abe27-ae30-3af7-a131-ec32128c4909",
                                                "text": "We need to raise the motivation level in the company."
                                            },
                                            {
                                                "example_id": "4b406bf4-209a-44c9-bf45-917156234b15",
                                                "sense_id": "b59abe27-ae30-3af7-a131-ec32128c4909",
                                                "text": "to raise the quality of the products; to raise the price of goods; to raise (increase) taxes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffee9687-fde0-32ac-9398-0790492faf70",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To create, increase or develop.",
                                            "To collect or amass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "203f7d27-b1d8-49e7-b31f-02ee8abe608b",
                                                "sense_id": "ffee9687-fde0-32ac-9398-0790492faf70",
                                                "text": "to raise a lot of money for charity; to raise troops"
                                            },
                                            {
                                                "example_id": "0fe40a38-a1cc-4754-b7dd-48f8b32ed7c8",
                                                "sense_id": "ffee9687-fde0-32ac-9398-0790492faf70",
                                                "text": "But capital was proving difficult to raise; rumours were in the air that the G.W.R. and L.S.W.R. were about to patch up their quarrel, and the people of Southampton, who twelve months earlier had staged a torch-light procession to celebrate the passing of the D.N.S.R. Act, were increasingly loath to part with their cash."
                                            },
                                            {
                                                "example_id": "14f6b121-9f01-44f3-a7be-f6213afe40fa",
                                                "sense_id": "ffee9687-fde0-32ac-9398-0790492faf70",
                                                "text": "Every pound raised goes to helping some of the world's most vulnerable children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd9f5d25-f78e-37da-ae4b-578d077c45fd",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To create, increase or develop.",
                                            "To call up the forces of, to raise the troops from."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03a6a460-0ac3-4bc7-8bfc-f1db3923afa4",
                                                "sense_id": "fd9f5d25-f78e-37da-ae4b-578d077c45fd",
                                                "text": "May it pleaſe your Grace that I ſhall raiſe the ſtreets,\nTo Gard your Maieſtie through Smithfield as you walke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4173409c-83d7-35de-9087-0473eca6628e",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To create, increase or develop.",
                                            "To bring up; to grow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc8ba02-e0b9-4119-95df-8cd5eb435820",
                                                "sense_id": "4173409c-83d7-35de-9087-0473eca6628e",
                                                "text": "We visited a farm where they raise chickens."
                                            },
                                            {
                                                "example_id": "8d3b6144-1cb5-4810-8b3f-77e3210dbc8c",
                                                "sense_id": "4173409c-83d7-35de-9087-0473eca6628e",
                                                "text": "Chew with your mouth shut — were you raised in a barn?"
                                            },
                                            {
                                                "example_id": "b704961f-dffc-42b0-9393-e08a0a47b975",
                                                "sense_id": "4173409c-83d7-35de-9087-0473eca6628e",
                                                "text": "Ting Ling had disappeared from public life in 1958. She was accused of being a \"Rightist\" and was sent to a farm in Hei-lung-chiang Province in remote northeast China, worked there twelve years raising chickens, was in prison five years (1970-1975), and began to live in a village in Shansi in 1975."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6202a2f1-b87d-3ee7-a79d-165329ddf195",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To create, increase or develop.",
                                            "To promote."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3973cb2-e9ef-4e10-b3d1-8109e44f8ba3",
                                                "sense_id": "6202a2f1-b87d-3ee7-a79d-165329ddf195",
                                                "text": "to raise somebody to office"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "599af42e-b15f-3fad-a5dd-1c679e12b949",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To create, increase or develop.",
                                            "To mention (a question, issue) for discussion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2284f856-8767-4c72-bf6f-89008a2ceda7",
                                                "sense_id": "599af42e-b15f-3fad-a5dd-1c679e12b949",
                                                "text": "A few important questions were raised after the attack."
                                            },
                                            {
                                                "example_id": "ebf2b63a-271a-4c79-a65f-bae84bda5720",
                                                "sense_id": "599af42e-b15f-3fad-a5dd-1c679e12b949",
                                                "text": "President Donald Trump’s offer to most federal employees to resign now and be paid through September stunned the workers who received it – angering some, confusing many and raising questions about whether the offer is even legal."
                                            },
                                            {
                                                "example_id": "f313391b-594e-4263-8754-32704cd416b2",
                                                "sense_id": "599af42e-b15f-3fad-a5dd-1c679e12b949",
                                                "text": "All of which is to say, SignalGate raises plenty of security, privacy, and legal issues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04b0efac-041b-339f-b1f3-b8a94b19bcba",
                                        "entry_id": "63922093-2f19-3cae-8a34-7294b49daa8f",
                                        "glosses": [
                                            "To create, increase or develop.",
                                            "To create; to constitute (a use, or a beneficial interest in property)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e304eeb9-a2ac-436d-b0de-7863668fc383",
                                                "sense_id": "04b0efac-041b-339f-b1f3-b8a94b19bcba",
                                                "text": "There should be some consideration (i.e., payment or exchange) to raise a use."
                                            }
                                        ]
