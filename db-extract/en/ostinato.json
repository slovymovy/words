                        "entry_id": "86fb62f8-8016-34ca-9c65-16dbda8340ce",
                        "glosses": [
                            "A piece of melody, a chord progression, or a bass figure that is repeated over and over as a musical accompaniment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "802a4004-8cc3-4ea9-93be-ad5268337146",
                                "sense_id": "fdd0088c-ab54-3939-9e5b-e45b260008a4",
                                "text": "The piece moves in alluring spans of swirling figures, jagged lines and pointillistic outbursts, often prodded forward by ostinatos in the perky piano."
                            }
                        ]
                    }
                ],
                "translations": [
