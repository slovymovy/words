                            {
                                "example_id": "82a4e59c-8263-42ff-bfcb-143e6005fdd2",
                                "sense_id": "409ecde9-3ef0-3001-bfa8-384092f952e0",
                                "text": "Amandine Del a opté pour une autre solution."
                            },
                            {
                                "example_id": "a47af854-477f-4bb1-84af-352faf054554",
                                "sense_id": "409ecde9-3ef0-3001-bfa8-384092f952e0",
                                "text": "On notera enfin que la dernière adaptation au grand écran du « Petit Nicolas » (un dessin animé d’Amandine Fredon et Benjamin Massoubre, attendu en octobre 2022) a en partie été fabriquée à Angoulême, par le studio Shan Too."
                            },
                            {
                                "example_id": "cd3a1786-1978-44e1-8254-a15f7b6ce884",
                                "sense_id": "409ecde9-3ef0-3001-bfa8-384092f952e0",
                                "text": "Manon Deketer apporte à la France sa deuxième médaille dans ces Mondiaux, après le bronze d’Amandine Buchard, en -57 kg, vendredi."
                            }
                        ]
                    }
                ],
