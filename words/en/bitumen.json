            "senses": [
                {
                    "sense_id": "9fe631bc-d6a2-3c38-a1d8-10755afb59c4",
                    "sense_definition": "A black, sticky, highly viscous substance obtained naturally or from petroleum processing, used mainly for road surfacing and roofing.",
