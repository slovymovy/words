                                ]
                            },
                            {
                                "target_word": "úd",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9ee8ed-dda7-3c72-9c20-6bb0e1a48361",
                                        "entry_id": "06559f1b-1a59-3bb8-8970-d60e2a01f479",
                                        "glosses": [
