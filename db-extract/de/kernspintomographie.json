                    {
                        "translation_id": "815803af-c1ae-4043-8605-69e46daa6309",
                        "source_entry_id": "7057045c-b7d4-3e8b-86ba-1d9237031484",
                        "source_sense_id": "7568f806-f260-3212-b10c-6622bacd9c84",
                        "target_lang_word": "magnetic resonance imaging",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetic resonance imaging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98c7734f-4ba3-32d8-b3bc-638090b12123",
                                        "entry_id": "96bb71a7-9022-3843-8333-7486c990f41e",
                                        "glosses": [
                                            "A technique that uses nuclear magnetic resonance to form cross sectional images of the human body for diagnostic purposes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52215893-5171-3503-90fd-6c4cf04280ff",
                                        "entry_id": "96bb71a7-9022-3843-8333-7486c990f41e",
                                        "glosses": [
                                            "An instance of this technique being used; an image made using this technique."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8646afbb-1a06-4eee-8097-1d57154364ac",
                                                "sense_id": "52215893-5171-3503-90fd-6c4cf04280ff",
                                                "text": "Confirmation of the condition is made through radiographs, bone scans, or magnetic resonance imagings (MRI’s)."
                                            },
                                            {
                                                "example_id": "7bc3a26b-69bf-450a-8963-5268015178f2",
                                                "sense_id": "52215893-5171-3503-90fd-6c4cf04280ff",
                                                "text": "I had blood tests for HIV, hepatitis and scores of other illnesses, and two MRIs (magnetic resonance imagings, which show internal organs) to rule out cancer."
                                            },
                                            {
                                                "example_id": "5e9b0fdd-d38c-4028-927d-8707b8b8db80",
                                                "sense_id": "52215893-5171-3503-90fd-6c4cf04280ff",
                                                "text": "Follow-up magnetic resonance imagings showed some shrinkage of the tumor in one patient, but no complete radiological remission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6f940f2-85fa-4b5c-9a41-1490317c5277",
                        "source_entry_id": "7057045c-b7d4-3e8b-86ba-1d9237031484",
                        "source_sense_id": "7568f806-f260-3212-b10c-6622bacd9c84",
