                                            {
                                                "example_id": "4b6640dd-d1b8-48ae-9dd9-d1042ef3af7f",
                                                "sense_id": "1cf00d17-3cbf-3698-9cbb-51f5733cf7e7",
                                                "text": "Hij was zo overhaast dat hij zelfs zijn schooltas vergat mee te nemen."
