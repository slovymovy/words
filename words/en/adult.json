{
    "word_family": [
        "adulthood"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5fce4478-a814-398f-a507-b2d304749477",
                    "sense_definition": "A person or animal that has finished growing and is no longer a child.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bio_maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>adults</w> sat at the large table while the children played in the garden.",
                            "target_lang_translations": {
                                "ru": "<w>Взрослые</w> сидели за большим столом, пока дети играли в саду.",
                                "zh": "<w>成年人</w>坐在大桌旁，孩子们在花园里玩耍。"
                            }
                        },
                        {
                            "text": "An <w>adult</w> needs to sign the permission slip for the school trip.",
                            "target_lang_translations": {
                                "ru": "Разрешение на школьную поездку должен подписать <w>взрослый</w>.",
                                "zh": "学校旅行的许可单需要由一名<w>成年人</w>签字。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grown-up"
                    ],
                    "antonyms": [
                        "child"
                    ],
                    "common_phrases": [
                        "young adult",
                        "responsible adult"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, которые закончили расти и больше не являются детьми.",
                        "zh": "指已经发育成熟，不再是儿童的人或动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成年人",
                                "target_lang_sense_clarification": "指生理上成熟的人"
                            },
                            {
                                "target_lang_word": "成人",
                                "target_lang_sense_clarification": "指生理上成熟的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f154592d-2de2-33df-8de1-f01a468573bc",
                    "sense_definition": "A person who has reached the age defined by law as being fully responsible for their actions (usually 18 or 21).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many countries, you legally become an <w>adult</w> on your eighteenth birthday.",
                            "target_lang_translations": {
                                "ru": "Во многих странах вы официально становитесь <w>совершеннолетним</w> в день своего восемнадцатилетия.",
                                "zh": "在许多国家，你在十八岁生日那天在法律上就成为了<w>成年人</w>。"
                            }
                        },
                        {
                            "text": "Although he is young, he was tried as an <w>adult</w> in court.",
                            "target_lang_translations": {
                                "ru": "Хотя он молод, его судили как <w>взрослого</w>.",
                                "zh": "尽管他很年轻，但在法庭上他被当作<w>成年人</w>来审判。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legally an adult"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, достигший возраста, установленного законом для полной ответственности за свои действия (обычно 18 лет).",
                        "zh": "指在法律上达到完全承担责任年龄的人（通常为18或21岁）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершенноле́тний",
                                "target_lang_sense_clarification": "юридический статус"
                            },
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成年人",
                                "target_lang_sense_clarification": "法律意义上的成年人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed96edb2-3fe5-3e3b-a92f-a0b4070ed524",
                    "sense_definition": "Having finished growing; fully developed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bio_maturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>adult</w> bear is much larger and stronger than the cub.",
                            "target_lang_translations": {
                                "ru": "<w>Взрослый</w> медведь намного больше и сильнее медвежонка.",
                                "zh": "<w>成年</w>熊比幼崽大得多，也强壮得多。"
                            }
                        },
                        {
                            "text": "She has two <w>adult</w> sons who live in different cities.",
                            "target_lang_translations": {
                                "ru": "У нее двое <w>взрослых</w> сыновей, которые живут в разных городах.",
                                "zh": "她有两个<w>成年</w>的儿子，他们住在不同的城市。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fully grown",
                        "full-grown",
                        "grown-up"
                    ],
                    "common_phrases": [
                        "adult life",
                        "adult stem cells"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью выросший; сформировавшийся.",
                        "zh": "指已经发育完全的；成熟的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成年的",
                                "target_lang_sense_clarification": "形容词，指已发育成熟的"
                            },
                            {
                                "target_lang_word": "成体",
                                "target_lang_sense_clarification": "指生物学上的成熟个体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0b24718-23b8-32f6-87a4-e2b056523c4a",
                    "sense_definition": "Designed for, intended for, or restricted to people who are not children.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intended_audience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community center offers <w>adult</w> education classes in the evening.",
                            "target_lang_translations": {
                                "ru": "Общественный центр предлагает вечерние образовательные курсы для <w>взрослых</w>.",
                                "zh": "社区中心在晚上提供<w>成人</w>教育课程。"
                            }
                        },
                        {
                            "text": "Children under twelve must have <w>adult</w> supervision to enter the pool.",
                            "target_lang_translations": {
                                "ru": "Дети до двенадцати лет должны быть под присмотром <w>взрослых</w>, чтобы войти в бассейн.",
                                "zh": "十二岁以下的儿童进入游泳池必须有<w>成年人</w>看管。"
                            }
                        }
                    ],
                    "synonyms": [
                        "for adults",
                        "grown-up"
                    ],
                    "common_phrases": [
                        "adult education",
                        "adult supervision",
                        "adult ticket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для людей, которые не являются детьми.",
                        "zh": "指专为成年人设计、提供或仅限成年人使用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для взро́слых",
                                "target_lang_sense_clarification": "предназначенный для взрослых"
                            },
                            {
                                "target_lang_word": "взро́слый",
                                "target_lang_sense_clarification": "относящийся к взрослым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成人的",
                                "target_lang_sense_clarification": "形容词，指面向成年人的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb6a4b0b-255f-38c8-81b8-538b0ea8d5fb",
                    "sense_definition": "Containing material of an explicit sexual nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explicit_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer software blocks access to <w>adult</w> websites.",
                            "target_lang_translations": {
                                "ru": "Компьютерная программа блокирует доступ к сайтам для <w>взрослых</w>.",
                                "zh": "该计算机软件会阻止访问<w>成人</w>网站。"
                            }
                        },
                        {
                            "text": "This movie contains <w>adult</w> content and is not suitable for younger viewers.",
                            "target_lang_translations": {
                                "ru": "Этот фильм содержит контент для <w>взрослых</w> и не подходит для юных зрителей.",
                                "zh": "这部电影包含<w>成人</w>内容，不适合年轻观众观看。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pornographic",
                        "X-rated"
                    ],
                    "common_phrases": [
                        "adult movie",
                        "adult content",
                        "adult entertainment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий материалы откровенного сексуального характера.",
                        "zh": "指包含露骨性内容，仅限成年人观看的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для взро́слых",
                                "target_lang_sense_clarification": "категория 18+"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成人",
                                "target_lang_sense_clarification": "指色情或限制级内容"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6544c369-f4f3-33e4-9155-c55fd5ee7484",
                    "sense_definition": "To behave in a responsible manner typical of a grown-up, such as doing chores or paying bills.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent the whole weekend <w>adulting</w> by cleaning the house and doing my taxes.",
                            "target_lang_translations": {
                                "ru": "Я провел все выходные, <w>занимаясь взрослыми делами</w>: убирал дом и платил налоги.",
                                "zh": "我整个周末都在<w>承担成年人的责任</w>，打扫房子并处理税务。"
                            }
                        },
                        {
                            "text": "She is tired of <w>adulting</w> and just wants to watch cartoons today.",
                            "target_lang_translations": {
                                "ru": "Она устала <w>быть взрослой</w> и сегодня хочет просто смотреть мультики.",
                                "zh": "她厌倦了<w>承担成年人的责任</w>，今天只想看动画片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adulting is hard"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя ответственно, как подобает взрослому человеку (например, заниматься домашними делами или оплачивать счета).",
                        "zh": "指表现出成年人应有的负责任行为，如处理家务或支付账单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести́ себя́ как взро́слый",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "занима́ться взро́слыми дела́ми",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承担成年人的责任",
                                "target_lang_sense_clarification": "指履行成年人的义务"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}