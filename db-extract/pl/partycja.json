                                                "sense_id": "b3597ead-5428-359e-bee7-e5c32de62c05",
                                                "text": "Monarchies where partition isn't prohibited risk weakening through parcellation and civil wars between the heirs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a10eda-8c41-345a-989a-12cf6c586730",
                                        "entry_id": "f03b0460-a507-3c3c-82c2-94ccba0aaad0",
                                        "glosses": [
                                            "A vertical structure that divides a room."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
