                                        "examples": [
                                            {
                                                "example_id": "457e219b-8e1a-4499-8fde-f761a705f370",
                                                "sense_id": "88af99a7-4faa-3bae-9f32-1eb6c4ced0cd",
                                                "text": "Co byste říkal tomu dělat tady skladníka? To by nebylo špatný, co? (...) Nebudete přece pořád jen koulet s cikánama sudy!"
                                            },
                                            {
                                                "example_id": "3edf0114-ae9d-4ad7-b1dd-1a4d8b5be219",
                                                "sense_id": "88af99a7-4faa-3bae-9f32-1eb6c4ced0cd",
                                                "text": "I skladník ve šroubárně si může přečísti Vergilia v originále."
                                            }
                                        ]
