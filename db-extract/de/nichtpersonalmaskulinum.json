                    {
                        "form_id": "a1dda77c-bf59-420e-8f0a-e72a048eead2",
                        "entry_id": "24795668-a203-3097-8e49-e2fe584a41b2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nichtpersonalmaskulina"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a262b694-6fd4-36f6-9626-f8df8e9e41c7",
                        "entry_id": "24795668-a203-3097-8e49-e2fe584a41b2",
                        "glosses": [
                            "ein Genus des Polnischen und Obersorbischen, das außer dem Personalmaskulinum alle anderen Genera (belebtes Maskulinum, unbelebtes Maskulinum, Femininum und Neutrum) umfasst"
                        ],
                        "tags": [
                            "speziell Slavistik"
                        ],
                        "examples": [
                            {
                                "example_id": "ca07f696-ae12-49b5-a844-8c5012db8070",
                                "sense_id": "a262b694-6fd4-36f6-9626-f8df8e9e41c7",
                                "text": "„Im Plural gibt es zwei grammatische Geschlechter: das Personalmaskulinum (PM) und das Nichtpersonalmaskulinum (NPM), auch Sachgenus bzw. weiblich-sächliches Genus genannt.“"
                            },
                            {
                                "example_id": "b592f358-4ddd-4a5b-9931-4bbd2bdcb5bd",
                                "sense_id": "a262b694-6fd4-36f6-9626-f8df8e9e41c7",
                                "text": "„In der Gegend von Lemberg und Wilna entstand die Umgangssprache des östlichen Randgebietes (polszczyzna kresowa), die viele typische gemeinsame Merkmale hatte, regional aber durch litauische und weißrussische (Wilna) bzw. ukrainische (Lemberg) Elemente charakterisiert war. Zu den typischen Merkmalen dieser Umgangssprache gehörten u. a.: […] einheitliche Verbformen für die Personalmaskulina und Nichtpersonalmaskulina, z. B. Chłopy były // krowy sie pasły oder chłopi byli // krowy sie paśli;“"
                            },
                            {
                                "example_id": "1950d68c-cbb2-4e83-8c1b-d2f7b91cbc6e",
                                "sense_id": "a262b694-6fd4-36f6-9626-f8df8e9e41c7",
                                "text": "„Die Bildung der morphologisch stark markierten Kategorie der Personalmaskulina hob im Plural die traditionellen Genera auf und führte zu der binären Opposition Personalmaskulina — Nichtpersonalmaskulina.“"
                            },
                            {
                                "example_id": "5adb7dde-bc51-45a2-b79f-6fe40d57dc85",
                                "sense_id": "a262b694-6fd4-36f6-9626-f8df8e9e41c7",
                                "text": "„Im Pl.Fem. sind die weiteren Formen wie die der Nichtpersonalmaskulina;“"
                            },
                            {
                                "example_id": "11d8d7cb-075f-43a9-9903-28d8e6bb64e9",
                                "sense_id": "a262b694-6fd4-36f6-9626-f8df8e9e41c7",
                                "text": "„Infolgedessen spiegeln sich in der Adjektivdeklination die für das Substantiv charakteristischen Oppositionen von Belebt–Unbelebt im Singular, Personalmaskulinum–Nichtpersonalmaskulinum im Plural wider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
