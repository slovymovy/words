                                            {
                                                "example_id": "3abd7fd7-f59c-4909-9e47-a746c9b75623",
                                                "sense_id": "263f8fb8-4f1b-3900-b0fc-df66cbd816d5",
                                                "text": "De versleten sokken gooi ik weg."
                                            },
                                            {
                                                "example_id": "52cfea99-aed8-4aca-a762-0d661574e8f0",
                                                "sense_id": "263f8fb8-4f1b-3900-b0fc-df66cbd816d5",
                                                "text": "Zij waren keurig gekleed en wij zagen er woest uit en droegen versleten vodden."
                                            },
                                            {
                                                "example_id": "76931068-628c-4580-b46f-f615ba15da7e",
                                                "sense_id": "263f8fb8-4f1b-3900-b0fc-df66cbd816d5",
                                                "text": "De verlepte eetzaal met afgebladderde verf en versleten tapijten getuigde van grootsheid in een andere tijd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
