                    },
                    {
                        "translation_id": "025c20ac-b2ca-4f98-8ea3-6fc46262d332",
                        "source_entry_id": "362630cc-b052-3803-9389-d80941ef2770",
                        "source_sense_id": "fe5bdf56-9af2-3482-b899-6654cc55d26e",
                        "source_sense_description": "de taal die in Kirgizië gesproken wordt",
                        "target_lang_word": "kirghiz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kirghiz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "523f56dd-b877-3912-8955-80128e3ebb73",
                                        "entry_id": "8f98eb13-2264-3741-ada5-84f6c9e2c170",
                                        "glosses": [
                                            "Qui concerne le Kirghizistan, le peuple qui l’habite, ou sa langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad27fc9-bd5c-4d3b-8088-a88c094214bc",
                                                "sense_id": "523f56dd-b877-3912-8955-80128e3ebb73",
                                                "text": "[…] s’il y a, à la rigueur, certains types spécifiques dans quelques populations de l’Union, par exemple le type mongol, le type kirghiz, le type arménien […] il n’y a pas, en tout cas, de type russe."
                                            },
                                            {
                                                "example_id": "e21433cb-d56f-4d36-a186-72c8cf6f43ac",
                                                "sense_id": "523f56dd-b877-3912-8955-80128e3ebb73",
                                                "text": "En un instant, et de tous ses réceptacles, l’eau avait disparu. Ouroz n’en fut point surpris. Il pensa au géant souterrain des fables kirghizes. Son nom était Kol Tavisar et il buvait d’un trait lacs et torrents."
                                            },
                                            {
                                                "example_id": "6d6b5e9e-822d-4813-bc03-e51897d469b5",
                                                "sense_id": "523f56dd-b877-3912-8955-80128e3ebb73",
                                                "text": "Son Premier ministre, Daniar Oussenov, a « remis une lettre de démission », après des négociations avec l’un des chefs de l’opposition, Temir Sariev, a annoncé ce dernier à la radio kirghize Azattyk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kirghiz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c18c733-66c8-31c9-937d-b95fb6b2005b",
                                        "entry_id": "13615b59-2bae-341a-af56-b3055965ad79",
                                        "glosses": [
                                            "Langue de la famille turque parlée par les Kirghiz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88846502-2d59-4770-ab9d-92ff3753dbca",
                                                "sense_id": "9c18c733-66c8-31c9-937d-b95fb6b2005b",
                                                "text": "Le kirghiz est resté un idiome turc pur, et les mots empruntés à l’étranger ont dû subir les lois de la prononciation et obéir à l’esprit de la langue indigène."
                                            },
                                            {
                                                "example_id": "530a7ff7-5eaf-453e-8f93-2330650ac00b",
                                                "sense_id": "9c18c733-66c8-31c9-937d-b95fb6b2005b",
                                                "text": "Le turc ou tatar s’étend des rivages de la Méditerranée orientale aux bords de la Lena en Sibérie ; il se partage en cinq familles distinctes divisées à leur tour en plusieurs idiomes. En allant de l’est à l’ouest, et du nord au sud, ces cinq rameaux sont : le yakout, l’ouigour, le nogaïque, le kirghiz et le turc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
