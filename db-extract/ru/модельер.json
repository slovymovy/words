                "senses": [
                    {
                        "sense_id": "8ac444d7-7f20-3525-8d82-a847adb522a8",
                        "entry_id": "747272e8-04ff-37e2-b968-99e40e667bb5",
                        "glosses": [
                            "специалист по проектированию и изготовлению моделей одежды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9502ce94-76b1-4813-8369-6a08a0c4702c",
                                "sense_id": "8ac444d7-7f20-3525-8d82-a847adb522a8",
                                "text": "После ужина приехали модельеры и рассказывали нам, как надо красиво одеваться."
                            },
                            {
                                "example_id": "4a40d17a-dc51-4847-ac61-5e33a2895926",
                                "sense_id": "8ac444d7-7f20-3525-8d82-a847adb522a8",
                                "text": "Молодому модельеру Светлане Сиренко очень нравится создавать новые модели мужских костюмов."
                            },
                            {
                                "example_id": "7b94ea23-f4cc-4652-aaa1-4a7e34d57deb",
                                "sense_id": "8ac444d7-7f20-3525-8d82-a847adb522a8",
                                "text": "После войны власть вернулась к проблемам «высокой моды». В первую очередь был воссоздан Московский дом моделей. Уже в 1945 году его модельеры спроектировали около тысячи образцов одежды, которые должны были внедряться в производство."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94170485-c593-4be6-a9d8-b0825bd62104",
                        "source_entry_id": "747272e8-04ff-37e2-b968-99e40e667bb5",
                        "source_sense_id": "8ac444d7-7f20-3525-8d82-a847adb522a8",
                        "target_lang_word": "modeller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modeller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3985e6c-b141-3827-8191-2f912ba28b93",
                                        "entry_id": "b1ebd7ba-7475-3097-8866-27e2743e86d1",
                                        "glosses": [
                                            "Alternative spelling of modeler."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf4fbea-ea22-4a20-8fdf-e376e7c7d064",
                                                "sense_id": "c3985e6c-b141-3827-8191-2f912ba28b93",
                                                "text": "... Or the proper fan might make a model of the Underground. Probably the leading Underground modeller is John Polley, who used to be a Tube train driver."
                                            },
                                            {
                                                "example_id": "2db84140-a0f3-4f06-a4ef-8a7dd4d46c80",
                                                "sense_id": "c3985e6c-b141-3827-8191-2f912ba28b93",
                                                "text": "In an ingenious approach, a team of 11 scientists – including biologists, geneticists, glaciologists, computer scientists and ice-sheet modellers – looked at the genetics of Turquet’s octopus – a species that has been living around the Antarctic continent for about 4m years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
