                        "examples": [
                            {
                                "example_id": "0b39060c-2876-4ff8-92e5-ab483d6c3952",
                                "sense_id": "95ca988f-2f32-3473-9289-3e6f58edab8d",
                                "text": "Poor fellow! how happy would a companion make you, to whom you could relate your battles, bouts, and courtships; but mum is the order, and Jack is used to an implicit obeyance of head-quarter orders."
                            },
                            {
                                "example_id": "b187e4df-1eae-4dee-ac5f-ebb4b8e31e36",
                                "sense_id": "95ca988f-2f32-3473-9289-3e6f58edab8d",
                                "text": "One of the instructions given by experienced aviators to pupils, and for which they insist upon implicit obeyance, is: \"If your machine gets more than 30 feet high, or comes closer to the ground than 6 feet, descend at once.\""
                            },
                            {
                                "example_id": "8bfa7997-be1e-4408-9faa-3626ebef4acc",
                                "sense_id": "95ca988f-2f32-3473-9289-3e6f58edab8d",
                                "text": "The tall soldiers of Nyjord moved in ready obeyance of their commander."
                            }
                        ]
                    }
