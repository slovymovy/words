                                                "sense_id": "4385211f-ca70-356d-877f-3425923b981c",
                                                "text": "Hobbled, loudly gourmandizing the dry chess grass, they were guarded by a pair of dismounted soldiers in long, dusty coats [...]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chess",
