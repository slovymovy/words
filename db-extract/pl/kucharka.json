                    {
                        "sense_id": "cd9cec59-9f9e-39cd-8195-feb89f391cd0",
                        "entry_id": "747ce42b-84d3-3119-8764-f24efa2e574b",
                        "glosses": [
                            "kobieta lub dziewczyna, która gotuje potrawy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49ba0164-89d6-49b9-a237-23dc4cb66d77",
                                "sense_id": "cd9cec59-9f9e-39cd-8195-feb89f391cd0",
                                "text": "Maria jest świetną kucharką; przepysznie gotuje."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0522b77e-cb76-420a-a733-2f7c452844ba",
                        "source_entry_id": "747ce42b-84d3-3119-8764-f24efa2e574b",
                        "source_sense_id": "cd9cec59-9f9e-39cd-8195-feb89f391cd0",
                        "target_lang_word": "kuchařka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kuchařka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "723052f1-4fba-3abe-a317-968d1b4f782f",
                                        "entry_id": "28912bdd-1ef6-3c12-8852-19fe40368ab1",
                                        "glosses": [
                                            "žena připravující jídlo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d618b8-c102-4e09-845a-20c6ec4eb1ad",
                                                "sense_id": "723052f1-4fba-3abe-a317-968d1b4f782f",
                                                "text": "O dceru nemám strach, bude se učit kuchařkou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1161348-b637-3c20-a161-c9d50fced008",
                                        "entry_id": "28912bdd-1ef6-3c12-8852-19fe40368ab1",
                                        "glosses": [
                                            "kniha s recepty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df679cb4-b221-4b60-a703-3ba8b85005a2",
                                                "sense_id": "e1161348-b637-3c20-a161-c9d50fced008",
                                                "text": "Pavlíku, dones mi ze skříně kuchařku, upečeme bábovku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef433067-474b-418f-8045-38278acf1414",
                        "source_entry_id": "747ce42b-84d3-3119-8764-f24efa2e574b",
                        "source_sense_id": "cd9cec59-9f9e-39cd-8195-feb89f391cd0",
                        "target_lang_word": "Köchin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Köchin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "516369e7-f5c8-386b-8e24-9d84222566e9",
                                        "entry_id": "e94af6ef-8e01-3da4-bb44-9f001bcf5b7e",
                                        "glosses": [
                                            "weibliche Person, die berufsmäßig Speisen zubereitet"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a23c370-7608-4f4e-ab12-8ed4ac356880",
                                                "sense_id": "516369e7-f5c8-386b-8e24-9d84222566e9",
                                                "text": "Die Neureichs haben sogar eine eigene Köchin."
                                            },
                                            {
                                                "example_id": "1fdd5d0f-5432-45ff-8780-ac0f54b51fd1",
                                                "sense_id": "516369e7-f5c8-386b-8e24-9d84222566e9",
                                                "text": "„Ihre wundervollen Kinder würden eine gute Schule besuchen, und sie hätte drei Dienstmädchen, einen Gärtner, einen Chauffeur und eine Köchin.“"
                                            },
                                            {
                                                "example_id": "3b4f6d31-7a4f-41fd-afdf-1625f4461ee2",
                                                "sense_id": "516369e7-f5c8-386b-8e24-9d84222566e9",
                                                "text": "„Die Köchin Rosa schwenkte dort einen großen Holzlöffel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "92a4dcfd-2368-37f3-8e67-0697fc378c5a",
                                        "entry_id": "e94af6ef-8e01-3da4-bb44-9f001bcf5b7e",
                                        "glosses": [
                                            "weibliche Person, die (mehr oder weniger gut) kochen kann"
                                        ],
                                        "tags": [
                                            "im Zusammenhang mit einem Adjektiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2f5a408-2e33-4319-ae11-b5657b9d4fc0",
                                                "sense_id": "92a4dcfd-2368-37f3-8e67-0697fc378c5a",
                                                "text": "„Plötzlich kam von der Haustür her ein neuer, durchdringender Schrei, diesmal der einer Frauenstimme, und gleich darauf stürzte die Köchin in den Flur.“"
                                            },
                                            {
                                                "example_id": "9f469cf0-d710-40d7-bb90-9c4bfb80c3dc",
                                                "sense_id": "92a4dcfd-2368-37f3-8e67-0697fc378c5a",
                                                "text": "Meine Tante ist eine hervorragende Köchin."
                                            },
                                            {
                                                "example_id": "5d3ac135-4c15-4b92-bbcd-13fb7e579557",
                                                "sense_id": "92a4dcfd-2368-37f3-8e67-0697fc378c5a",
                                                "text": "„Ich werde von diesem Mädchen in fünf oder sechs Jahren noch berichten, ebenso von der ausgezeichneten Köchin Annemirl, der ich vierhundert Gulden schenkte.“"
                                            },
                                            {
                                                "example_id": "5c576f05-1e0b-43d7-9374-49c811e51f16",
                                                "sense_id": "92a4dcfd-2368-37f3-8e67-0697fc378c5a",
                                                "text": "„Die Köchin sagte, sie sei bei vielen Religionen gewesen, endlich aber bei einer gelandet, wo man das wahre Christentum verkündigte.“"
                                            },
                                            {
                                                "example_id": "12634784-885d-409d-acc7-ea7aa10dfab2",
                                                "sense_id": "92a4dcfd-2368-37f3-8e67-0697fc378c5a",
                                                "text": "„Um diese Jahreszeit blieb selbst einer hervorragenden Köchin wie Adrienne nichts anderes übrig, als alles in Butter und Salz zu ertränken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56fe0f48-2ba5-4ca8-bae6-540757ab6605",
                        "source_entry_id": "747ce42b-84d3-3119-8764-f24efa2e574b",
                        "source_sense_id": "cd9cec59-9f9e-39cd-8195-feb89f391cd0",
                        "target_lang_word": "кухарка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кухарка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c7c6dcca-9147-3e7b-b6e6-fe57974fb28f",
                                        "entry_id": "4473d54b-82e0-3835-8fe3-428f09cf3fd4",
                                        "glosses": [
                                            "работница, готовящая кушанья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a8c208-d402-4a3d-b954-13a25e6d6db4",
                                                "sense_id": "c7c6dcca-9147-3e7b-b6e6-fe57974fb28f",
                                                "text": "Я понимаю, почему теперь я в кухарки пошла, не захотела дальше быть председателем колхоза."
                                            },
                                            {
                                                "example_id": "8f37a8f5-a415-4d80-9a97-e7e01f30c411",
                                                "sense_id": "c7c6dcca-9147-3e7b-b6e6-fe57974fb28f",
                                                "text": "Был торжественный домашний обед со всеми родственниками ― тети, дяди, маленькая Эльза, а кухарка много лет потом сокрушалась, что забыла подать хрен к мясу."
                                            },
                                            {
                                                "example_id": "a883c1d8-8f97-49b7-a75a-632672a10c04",
                                                "sense_id": "c7c6dcca-9147-3e7b-b6e6-fe57974fb28f",
                                                "text": "Кухарка перетирала полотенцем груду вымытой посуды, а хозяйская дочь, присев на скамейке у стены, что-то горячо ей объясняла."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3460df4d-17e8-449b-ab06-2a0d1f3314cc",
                        "source_entry_id": "747ce42b-84d3-3119-8764-f24efa2e574b",
                        "source_sense_id": "cd9cec59-9f9e-39cd-8195-feb89f391cd0",
                        "target_lang_word": "повариха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "повариха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "772a809d-96d3-3cc9-9501-586208a93998",
                                        "entry_id": "69c731fe-ac54-3fa3-b883-3636111b5e0a",
                                        "glosses": [
                                            "разг. женск. к повар; женщина-повар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b808a81b-a780-4cea-a80c-626ce494b5fa",
                                                "sense_id": "772a809d-96d3-3cc9-9501-586208a93998",
                                                "text": "Каждый брал из рядом стоящего ящика деревянную ложку, получал от бригадира талончик на обед и вставал в очередь к котлу, где уже хлопотала повариха в белом фартуке и белой повязке на голове."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
