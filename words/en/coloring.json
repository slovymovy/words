{
    "word_family": [
        "color",
        "colorant",
        "coloration",
        "colorful",
        "colorist",
        "discolor",
        "multicolored"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1031849-981d-39ba-bf4d-3359e37710ef",
                    "sense_definition": "Any substance used to give color to something, especially food or materials.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our homemade cookies contain no artificial flavorings or <w>colorings</w>.",
                            "target_lang_translations": {
                                "ru": "Наше домашнее печенье не содержит искусственных ароматизаторов или <w>красителей</w>."
                            }
                        },
                        {
                            "text": "The chef added a drop of natural food <w>coloring</w> to make the icing look more festive.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар добавил каплю натурального пищевого <w>красителя</w>, чтобы глазурь выглядела более празднично."
                            }
                        }
                    ],
                    "synonyms": [
                        "pigment",
                        "dye."
                    ],
                    "common_phrases": [
                        "food coloring",
                        "artificial coloring",
                        "natural coloring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое вещество, используемое для придания цвета чему-либо, особенно продуктам питания или материалам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краситель",
                                "target_lang_sense_clarification": "вещество для окраски"
                            },
                            {
                                "target_lang_word": "пигмент",
                                "target_lang_sense_clarification": "красящее вещество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03ad2b83-83ca-3f55-8444-8bd501be0a8c",
                    "sense_definition": "The act or process of applying color to something, such as a picture or an object.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children spent the entire rainy afternoon busy with their <w>coloring</w> books.",
                            "target_lang_translations": {
                                "ru": "Дети провели весь дождливый день за своими книжками-<w>раскрасками</w>."
                            }
                        },
                        {
                            "text": "She finished the <w>coloring</w> of the map using bright blue for the oceans.",
                            "target_lang_translations": {
                                "ru": "Она закончила <w>раскрашивание</w> карты, используя ярко-синий цвет для океанов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coloring book",
                        "coloring pencils"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс нанесения цвета на что-либо, например, на рисунок или объект."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрашивание",
                                "target_lang_sense_clarification": "процесс нанесения цвета"
                            },
                            {
                                "target_lang_word": "окрашивание",
                                "target_lang_sense_clarification": "процесс придания цвета"
                            },
                            {
                                "target_lang_word": "раскраска",
                                "target_lang_sense_clarification": "детская книжка или процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d62219e9-e2ff-34ca-aad9-7864a679e143",
                    "sense_definition": "The natural appearance or combination of colors of a person's skin, hair, and eyes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With her pale <w>coloring</w>, she looks best when wearing soft pastel shades.",
                            "target_lang_translations": {
                                "ru": "С её бледным <w>колоритом</w> она лучше всего выглядит в мягких пастельных тонах."
                            }
                        },
                        {
                            "text": "The brothers have very different <w>coloring</w>, as one is blonde and the other has dark hair.",
                            "target_lang_translations": {
                                "ru": "У братьев очень разная <w>внешность</w>: один блондин, а у другого темные волосы."
                            }
                        }
                    ],
                    "synonyms": [
                        "coloration"
                    ],
                    "common_phrases": [
                        "natural coloring",
                        "pale coloring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественный вид или сочетание цветов кожи, волос и глаз человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колорит",
                                "target_lang_sense_clarification": "внешность, сочетание цветов"
                            },
                            {
                                "target_lang_word": "окраска",
                                "target_lang_sense_clarification": "природный цвет"
                            },
                            {
                                "target_lang_word": "цветотип",
                                "target_lang_sense_clarification": "характеристика внешности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16fbba48-b3bd-3fe4-9b1b-bbdbfef1e1c5",
                    "sense_definition": "In mathematics, the assignment of colors to elements of a graph, such as vertices, under specific constraints.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student solved the problem by applying a vertex <w>coloring</w> algorithm to the complex graph.",
                            "target_lang_translations": {
                                "ru": "Студент решил задачу, применив алгоритм <w>раскраски</w> вершин к сложному графу."
                            }
                        },
                        {
                            "text": "In graph theory, a proper <w>coloring</w> ensures that no two adjacent vertices share the same color.",
                            "target_lang_translations": {
                                "ru": "В теории графов правильная <w>раскраска</w> гарантирует, что никакие две соседние вершины не имеют одинакового цвета."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graph coloring",
                        "vertex coloring"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В математике — присвоение цветов элементам графа, таким как вершины, при определенных ограничениях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскраска",
                                "target_lang_sense_clarification": "в теории графов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "378847e0-616f-32d5-b20d-53588227e41f",
                    "sense_definition": "The present participle and gerund of <w>color</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl is <w>coloring</w> a picture of a dragon with her new crayons.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка <w>раскрашивает</w> картинку с драконом своими новыми мелками."
                            }
                        },
                        {
                            "text": "He was <w>coloring</w> inside the lines very carefully to win the school contest.",
                            "target_lang_translations": {
                                "ru": "Он очень старательно <w>раскрашивал</w> внутри контуров, чтобы победить в школьном конкурсе."
                            }
                        }
                    ],
                    "antonyms": [
                        "bleach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «color» (красить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскрашивание",
                                "target_lang_sense_clarification": "действие по глаголу"
                            },
                            {
                                "target_lang_word": "окрашивание",
                                "target_lang_sense_clarification": "процесс покраски"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9301ab29-295b-318f-8e42-a2eb5709c065",
                    "sense_definition": "Having the effect or purpose of giving color to something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory uses several <w>coloring</w> agents to ensure the plastic reaches the desired shade.",
                            "target_lang_translations": {
                                "ru": "Завод использует несколько <w>красящих</w> веществ, чтобы пластик приобрел нужный оттенок."
                            }
                        },
                        {
                            "text": "Some plants have <w>coloring</w> properties that have been used in traditional dyes for centuries.",
                            "target_lang_translations": {
                                "ru": "Некоторые растения обладают <w>красящими</w> свойствами, которые веками использовались в традиционных красителях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coloring agent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий эффект или цель придания цвета чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красящий",
                                "target_lang_sense_clarification": "придающий цвет"
                            },
                            {
                                "target_lang_word": "окрашивающий",
                                "target_lang_sense_clarification": "служащий для окраски"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}