                "senses": [
                    {
                        "sense_id": "bffe2eb8-4a5b-3692-83a6-cf9a1536111a",
                        "entry_id": "fe5f1457-31a6-33f3-ba30-4daa523d2bba",
                        "glosses": [
                            "Vermeiden von Lärm und anderen Störungen am Morgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f64bcc-bdfa-4ad7-95d9-ddf09aa2c6e6",
                                "sense_id": "bffe2eb8-4a5b-3692-83a6-cf9a1536111a",
                                "text": "„Da werden die jungen Hähne und Hühner, die seine Morgenruhe stören, für schweres Geld aufgekauft […].“"
                            },
                            {
                                "example_id": "b7a208c9-b09b-492a-9ac7-1742a2089a0f",
                                "sense_id": "bffe2eb8-4a5b-3692-83a6-cf9a1536111a",
                                "text": "„Dr. Shipley pflegte an Sonntagen seine Morgenruhe etwas länger auszudehnen.“"
                            },
                            {
                                "example_id": "2c28d313-fb74-4b73-814e-646a306b346a",
                                "sense_id": "bffe2eb8-4a5b-3692-83a6-cf9a1536111a",
                                "text": "„Ich möchte ja nicht deine Morgenruhe stören, aber es läuft gerade nicht so gut zwischen Rudger und Henrik.“"
                            },
                            {
                                "example_id": "a63aa285-a27b-4cae-a228-36910ab8161c",
                                "sense_id": "bffe2eb8-4a5b-3692-83a6-cf9a1536111a",
                                "text": "„Nur unter dem wuchtigen Salzturm am Rhein hielt sich die Morgenruhe. Dort warteten die Möwen auf Abfälle der Fischer.“"
                            },
                            {
                                "example_id": "77424712-c1f2-441f-8bf1-d18282357f38",
                                "sense_id": "bffe2eb8-4a5b-3692-83a6-cf9a1536111a",
                                "text": "„Nach und nach verdrängten glucksende Vogelrufe und vereinzeltes Affengeschrei die Morgenruhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
