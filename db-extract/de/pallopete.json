                "senses": [
                    {
                        "sense_id": "0016ab75-f71a-3dfb-8b9d-657f3564dd87",
                        "entry_id": "b24bb95c-d4c0-3970-8e88-f5e80d7afe0e",
                        "glosses": [
                            "sondersprachlich: für Polizist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6872e2c0-bb8a-46ee-b03b-263f8a96b49e",
                                "sense_id": "0016ab75-f71a-3dfb-8b9d-657f3564dd87",
                                "text": "„…ich kenne Darmkrebskranke, noch durchaus aggressiv, Agenten den Innenministeriums, hitzige Pallopeten…“"
                            },
                            {
                                "example_id": "2b275aab-8c71-4a96-b508-7c0a19dd960f",
                                "sense_id": "0016ab75-f71a-3dfb-8b9d-657f3564dd87",
                                "text": "„Fraglich bleibt es endlich, … wie die Fremdwörter Polizei, Polizist von den Gaunern und Kunden umgewandelt worden sind zu P o l i p e e, P a l l o p e t e n (auch P a l o p p e n) …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad1b70f0-8edc-41a7-8a58-0649e800a4c5",
                        "source_entry_id": "b24bb95c-d4c0-3970-8e88-f5e80d7afe0e",
                        "source_sense_id": "0016ab75-f71a-3dfb-8b9d-657f3564dd87",
                        "source_sense_description": "sondersprachlich: für Polizist",
                        "target_lang_word": "flic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f45571-8d84-3fa1-9276-8b650337028b",
                                        "entry_id": "69659c38-d931-31fc-8d28-110b5a6672c4",
                                        "glosses": [
                                            "Policier."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae29a9d9-db75-41b7-bf9e-b57345310392",
                                                "sense_id": "d6f45571-8d84-3fa1-9276-8b650337028b",
                                                "text": "Il s'déplace avec sa camionnette, en pépère, et son commerce aux yeux des flics c'est d'trimballer des peaux d'lapin."
                                            },
                                            {
                                                "example_id": "d63bbabe-8e1f-4d04-b809-53db51d2b188",
                                                "sense_id": "d6f45571-8d84-3fa1-9276-8b650337028b",
                                                "text": "Il avait cependant assisté […] à une rafle sur les quais de tous les mendigots et clochards qu'une brigade de flics avait cernés."
                                            },
                                            {
                                                "example_id": "41e0a29c-db34-4e86-bc28-67d98d508ea8",
                                                "sense_id": "d6f45571-8d84-3fa1-9276-8b650337028b",
                                                "text": "Voici Scorsese dans son élément : la rue, les fonds de cour, les bouis-bouis ensanglantés, les parrains sanguinaires et les flics pas tous nets."
                                            },
                                            {
                                                "example_id": "4707a01b-2a71-4f31-abe9-726bd704bbf1",
                                                "sense_id": "d6f45571-8d84-3fa1-9276-8b650337028b",
                                                "text": "Une bonne femme pas mal du tout l'accompagnait. Une flic, sans doute, ou sa nouvelle copine, ou les deux. Aucun ne voulait répondre aux journalistes."
                                            },
                                            {
                                                "example_id": "7fa0e59d-19af-4e97-a580-922e6ec9236b",
                                                "sense_id": "d6f45571-8d84-3fa1-9276-8b650337028b",
                                                "text": "Flic et journaliste, c'est comme chien et chat, c'est comme flic et avocat aussi. Ça s'attire, ça se respecte, ça se cajole ; jusqu'au coup de griffe qui laisse des cicatrices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6116ccb3-f019-3623-97eb-5e96b69d9a3f",
                                        "entry_id": "69659c38-d931-31fc-8d28-110b5a6672c4",
                                        "glosses": [
                                            "N’importe quel représentant des forces de l'ordre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8173994b-9635-4a6c-8c18-918e0eded5cb",
                                                "sense_id": "6116ccb3-f019-3623-97eb-5e96b69d9a3f",
                                                "text": "Et lui aussi quand il va passer le seuil de la maison des syndicats, que surveillent les flics patronaux, il pourra dire : Alors la France finit là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
