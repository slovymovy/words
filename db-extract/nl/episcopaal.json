                    },
                    {
                        "translation_id": "447a9a0c-a4ee-45b2-927c-4859404d6734",
                        "source_entry_id": "83dbf29c-eafa-3150-b268-d985874cb723",
                        "source_sense_id": "316c1302-7773-39b8-9391-b50c0cedcef3",
                        "target_lang_word": "episcopal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "episcopal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6cea0ee-c003-3f8c-bafb-2be39c6491a6",
                                        "entry_id": "3c8d4a36-51ee-334f-be62-21812b081fce",
                                        "glosses": [
                                            "Of or relating to the affairs of a bishop in various Christian churches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55984baa-4575-4d88-9718-f7349de7cd9d",
                                                "sense_id": "a6cea0ee-c003-3f8c-bafb-2be39c6491a6",
                                                "text": "Inthronization, in ancient times, immediately succeeded the rite of consecration; the new bishop being honourably placed in his episcopal chair by the prelates assembled for his consecration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ce1eeda-3741-4e68-9823-df68d1ea9cc2",
                        "source_entry_id": "83dbf29c-eafa-3150-b268-d985874cb723",
                        "source_sense_id": "316c1302-7773-39b8-9391-b50c0cedcef3",
                        "target_lang_word": "épiscopal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épiscopal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77208677-0858-37aa-8d69-929baa0dd832",
                                        "entry_id": "9ddd4646-9a72-3b3d-8bde-4088123f4a70",
                                        "glosses": [
                                            "Relatif à l’évêque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab627957-d294-4011-8b55-f8a0ab03a6a9",
                                                "sense_id": "77208677-0858-37aa-8d69-929baa0dd832",
                                                "text": "À la mort de Charles III, le corps épiscopal en Espagne se composait des hommes les plus respectables."
                                            },
                                            {
                                                "example_id": "30b51e69-6706-4550-a954-e84223f8b561",
                                                "sense_id": "77208677-0858-37aa-8d69-929baa0dd832",
                                                "text": "Voici quels étaient les usages concernant le service Fromy, d'après les décisions épiscopales portées en 1668 et 1670. Les curés de Margut binaient à Fromy tous les quinze jours."
                                            },
                                            {
                                                "example_id": "2b071ef1-cd97-4be1-8260-685f99658dfd",
                                                "sense_id": "77208677-0858-37aa-8d69-929baa0dd832",
                                                "text": "On la consultait sur le choix des domestiques, l’éducation des jeunes filles, l’art des confitures, et Monseigneur descendait chez elle dans ses tournées épiscopales."
                                            },
                                            {
                                                "example_id": "9e6ef787-4510-44e6-83b2-fc8e66d533e2",
                                                "sense_id": "77208677-0858-37aa-8d69-929baa0dd832",
                                                "text": "[L'évêque] habite le palais de l'archevêché (ou palais épiscopal) à côté de la cathédrale, et il y mène une vie princière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épiscopal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6d3e174-a440-375f-bb2d-22f1ff52ce35",
                                        "entry_id": "346c20c6-b8aa-3980-868a-1a1573e3216a",
                                        "glosses": [
                                            "Celui qui tient, en Angleterre, à l’épiscopat, par opposition aux presbytériens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ac028d-2a76-440b-9069-40742eda4147",
                                                "sense_id": "b6d3e174-a440-375f-bb2d-22f1ff52ce35",
                                                "text": "Un épiscopal."
                                            }
                                        ]
                                    }
                                ]
