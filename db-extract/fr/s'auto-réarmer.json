                ],
                "senses": [
                    {
                        "sense_id": "d8f9d81c-1a1d-3e89-ac14-ec2fd3188858",
                        "entry_id": "072cbf29-38a4-3518-be57-a34e30be65fd",
                        "glosses": [
                            "Se réarmer automatiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a3e1a74-04ce-40b5-95f4-f424fa99a8f2",
                                "sense_id": "d8f9d81c-1a1d-3e89-ac14-ec2fd3188858",
                                "text": "L’indicateur d’alarme sur le détecteur peut être programmé par l’intermédiaire de cavalier à l’intérieur de celui-ci pour mémoriser ou pour s’auto-réarmer."
                            },
                            {
                                "example_id": "9ccdc4b7-0f8c-46e8-b4e7-c0972239789a",
                                "sense_id": "d8f9d81c-1a1d-3e89-ac14-ec2fd3188858",
                                "text": "Le SVD (Snayperskaya Vintovka Dragunova) ou plus communément appelé Dragunov, fut créé en réponse à la demande soviétique, dans les années 50, d’un fusil de sniper capable de s’auto-réarmer (ou semi-automatique si vous préférez)."
                            },
                            {
                                "example_id": "83895a7d-bb8f-4bd6-ad3b-b53a6befc761",
                                "sense_id": "d8f9d81c-1a1d-3e89-ac14-ec2fd3188858",
                                "text": "On peut imaginer à partir de ça un piège qui ne peut être désamorcé que pendant un temps limité car pouvant s’auto-réarmer."
                            }
                        ]
                    }
                ],
