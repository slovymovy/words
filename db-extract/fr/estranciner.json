        "fr-extract.jsonl": [
            {
                "entry_id": "e443b52d-dda1-35b5-925f-07be16610781",
                "word": "estranciner",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a72bca56-2242-423b-ac10-5fdfac366c19",
                        "entry_id": "e443b52d-dda1-35b5-925f-07be16610781",
                        "tags": [
                            "pronominal"
                        ],
                        "form": "s’estranciner"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41d8f5ef-46f6-33d3-a71d-c2ddbf455c0b",
                        "entry_id": "e443b52d-dda1-35b5-925f-07be16610781",
                        "glosses": [
                            "Angoisser. Se morfondre, se dessécher à force de s’inquiéter."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "1473b806-47d5-4aa6-b4b8-c2f8f3e9c421",
                                "sense_id": "41d8f5ef-46f6-33d3-a71d-c2ddbf455c0b",
                                "text": "Je me suis estranciné à force de t’attendre !"
                            },
                            {
                                "example_id": "193c6c80-dbb2-4593-ac9f-51aa73d863af",
                                "sense_id": "41d8f5ef-46f6-33d3-a71d-c2ddbf455c0b",
                                "text": "Puis il prend un ton plus conciliant pour rattraper la situation : - Françoise, ça sert à rien de s’estranciner entre nous comme ça !"
                            },
                            {
                                "example_id": "b56c960f-6b7d-4101-b397-7cef0c29ddbf",
                                "sense_id": "41d8f5ef-46f6-33d3-a71d-c2ddbf455c0b",
                                "text": "Marius"
                            }
                        ]
                    },
                    {
                        "sense_id": "c94bb9eb-55d1-3c63-a182-6eacb8a7d454",
                        "entry_id": "e443b52d-dda1-35b5-925f-07be16610781",
                        "glosses": [
                            "Être trop serré, dans un vêtement par exemple."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2d15c0ea-71fe-3e5f-8efd-62bc2ff69698",
                        "entry_id": "e443b52d-dda1-35b5-925f-07be16610781",
                        "glosses": [
                            "Être très ému, tout retourné, fébrile."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "18256b26-6169-4aa1-be4d-6f4c6cf05ca3",
                                "sense_id": "2d15c0ea-71fe-3e5f-8efd-62bc2ff69698",
                                "text": "Ta tignasse grisonnante, elle s’y habituera. Tu coiffes la moustache. Au bout d’une semaine ou deux elle ne verra plus tes défauts. T’en seras tout estranciné."
                            }
                        ]
                    }
                ],
