                ],
                "senses": [
                    {
                        "sense_id": "f34d6cd2-2755-3add-8986-00117a99d625",
                        "entry_id": "2fe481f7-ae63-3c0b-9025-22153c704428",
                        "glosses": [
                            "Qui n’est pas employé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da81150d-efb4-4f2a-bd35-91b35fc4fb0c",
                                "sense_id": "f34d6cd2-2755-3add-8986-00117a99d625",
                                "text": "Certes, il laisse entendre d’abord qu’en l’homme demeurent, virtuelles ou latentes mais inemployées, disons en forme de cul-de-sac, ces furtives velléités qui, dans l’enfance, firent de chacun de nous un presque-roi."
                            },
                            {
                                "example_id": "36aa6dc5-2380-4ec2-8a95-dc5b2b81698b",
                                "sense_id": "f34d6cd2-2755-3add-8986-00117a99d625",
                                "text": "Mais son maître lui jeta une boule de papier froissé et elle se mit à rire, avec un bond démesuré, une dépense de sa force inemployée, qui la montrèrent dans toute sa splendeur."
                            },
                            {
                                "example_id": "f0de06ec-008f-4872-9bb3-f972e3d4c98d",
                                "sense_id": "f34d6cd2-2755-3add-8986-00117a99d625",
                                "text": "Quelque chose de romanesque et d’inemployé flottait donc sur la vie libre, et à beaucoup d’égards peu édifiante, que menaient dans la ville les jeunes gens nobles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04fcfd78-375e-43ea-ac33-26e26c182168",
                        "source_entry_id": "2fe481f7-ae63-3c0b-9025-22153c704428",
                        "source_sense_id": "f34d6cd2-2755-3add-8986-00117a99d625",
                        "target_lang_word": "unemployed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unemployed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                        "entry_id": "f9f378dd-1b8f-397c-b4c2-05461b3cccc9",
                                        "glosses": [
                                            "Having no job despite being able and willing to work."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab9ccf8-9d4b-4650-8627-7ac1992ee397",
                                                "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                                "text": "The government announced a new initiative to help the unemployed."
                                            },
                                            {
                                                "example_id": "2e140983-f6fd-4a55-a958-a2b75704a21f",
                                                "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                                "text": "The number of unemployed keeps rising steadily."
                                            },
                                            {
                                                "example_id": "700cbf7d-25e6-424b-8c3d-0c3a3d1361c2",
                                                "sense_id": "9a7f5ba0-d311-37bc-a764-8bfa1c381b91",
                                                "text": "Several special types of unemployed workers are described. These include nonmodal workers, threshold workers, \"the unemployables\", and the physically handicapped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8746edd8-149a-3156-be59-9b0e62655b7f",
                                        "entry_id": "f9f378dd-1b8f-397c-b4c2-05461b3cccc9",
                                        "glosses": [
                                            "Having no use, not doing work"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c1bf9d-c867-481f-b979-30da10b64586",
                                                "sense_id": "8746edd8-149a-3156-be59-9b0e62655b7f",
                                                "text": "England's attacking impetus was limited to one shot from Lampard that was comfortably collected by keeper Iker Casillas, but for all Spain's domination of the ball his England counterpart Joe Hart was unemployed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unemployed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80603858-47b5-3cf0-9e16-25358999cd61",
                                        "entry_id": "e10b1419-7679-39c9-90f2-5deba229ab84",
                                        "glosses": [
                                            "The unemployed people of a society or the world, taken collectively."
                                        ],
