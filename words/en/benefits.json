                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy <w>benefits</w> small businesses across the entire region.",
                            "target_lang_translations": {
                                "ru": "Новая политика <w>приносит пользу</w> малому бизнесу во всем регионе."
                            }
