                    {
                        "translation_id": "9fd41282-4ba6-4bc9-bb6f-26304103a0f9",
                        "source_entry_id": "40fa0334-ec6f-3282-b8ba-bc19c6fc649e",
                        "source_sense_id": "18973a0e-ae18-3a88-82ef-bd1d6e20b55b",
                        "source_sense_description": "einen Berg hinab",
                        "target_lang_word": "en aval",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en aval",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50774e47-87f3-3838-aa63-9006546c9c3f",
                                        "entry_id": "35051ded-0c43-3220-a1e2-f9ae34ef0eb5",
                                        "glosses": [
                                            "Plus bas, en descendant un cours d’eau dans le sens du courant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8fd3102-55d6-4ebf-8259-8c1840e64af0",
                                                "sense_id": "50774e47-87f3-3838-aa63-9006546c9c3f",
                                                "text": "C'est une obligation, tous les dix ans, les déversoirs installés sur la Loire et situés en aval des centrales nucléaires sont vérifiés."
                                            },
                                            {
                                                "example_id": "964c9d58-ca87-4493-a508-d17cc1311f60",
                                                "sense_id": "50774e47-87f3-3838-aa63-9006546c9c3f",
                                                "text": "À ses côtés deux jeunes l’aident à récupérer les carpes encore vivantes qui jonchent le chenal en aval de la digue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "673f067f-367d-3e34-a33b-b2a59daab9a2",
                                        "entry_id": "35051ded-0c43-3220-a1e2-f9ae34ef0eb5",
                                        "glosses": [
                                            "Plus bas dans tout autre enchaînement (hiérarchie, circulation, chronologie, causalité...)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0177967-1c2e-47da-97b2-98110bbd83ea",
                                                "sense_id": "673f067f-367d-3e34-a33b-b2a59daab9a2",
                                                "text": "Autour du véhicule s’affairent les équipes de sapeurs-pompiers, les uns s’attachant à mettre en sécurité le lieu de l’intervention avec balisage, ambulance en amont, fourgon en aval et même VPR (véhicule de protection routière), utilisé sur les 2x2 voies, tandis que d’autres, d’abord autour du véhicule, s’occupent de la victime."
                                            },
                                            {
                                                "example_id": "ff148b03-8e32-46a9-b3f2-6b7fd6a2b633",
                                                "sense_id": "673f067f-367d-3e34-a33b-b2a59daab9a2",
                                                "text": "Les conducteurs de taxis ignorent que nous travaillons en amont avec l’administration centrale et en aval avec le procureur de la république qui reste d’une manière incontestable le directeur de la police judiciaire comme le stipule l’article 12 du code de procédure pénale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
