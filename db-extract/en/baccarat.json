                                "target_senses": [
                                    {
                                        "sense_id": "2fda4e93-51ac-33fb-893e-f37c2f94208a",
                                        "entry_id": "fc860de5-cb0d-3bee-9fe9-3c9e7b0668f8",
                                        "glosses": [
                                            "rodzaj szkła kryształowego wyrabiany w hucie w Baccarat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f504fd-9920-414b-a6da-56619bcc8b52",
                                                "sense_id": "2fda4e93-51ac-33fb-893e-f37c2f94208a",
                                                "text": "W spadku po babci dostałam komplet kryształowych kieliszków z bakaratu z ręcznymi zdobieniami."
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
