                                    {
                                        "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                                        "entry_id": "f1ea29a5-0568-3e70-9db9-02a0a7e368a3",
                                        "glosses": [
                                            "Fleuve traversant la Biélorussie, la Russie et l’Ukraine pour se jeter dans la mer Noire."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df099a17-e6a3-4abc-aca4-964082dab12f",
                                                "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                                                "text": "Le Dniepr est le troisième plus long fleuve d’Europe."
                                            },
                                            {
                                                "example_id": "38a04266-8115-4040-b819-69787706bb2b",
                                                "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                                                "text": "La Bérézina se jette dans le Dniepr."
                                            },
                                            {
                                                "example_id": "c5b2168d-b9af-4fc6-ab9f-129ab2096704",
                                                "sense_id": "05c8638c-b29d-34c4-aa29-d9868316ac2c",
                                                "text": "La première nouvelle, « Confluence imaginaire », constitue un récit alterné nous entraînant des confluents du Rhône à ceux du Dniepr, sur des chemins que parcourt à vélo le narrateur, un jeune Français, tantôt seul lorsqu'il est en France et tantôt avec son ami ukrainien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc9b270-107a-32cc-ae48-f7b9a7fcaca6",
                                        "entry_id": "f1ea29a5-0568-3e70-9db9-02a0a7e368a3",
                                        "glosses": [
                                            "Variante de Dnipro."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "595ba483-1787-4bdc-ad2d-41113e69b201",
                        "source_entry_id": "c1ee4b9f-09fa-319f-a46e-e50751a02c43",
                        "source_sense_description": "river",
                        "target_lang_word": "Dnjepr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dnjepr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "624ef3ce-dbc3-34cc-a6ef-f11736f40d8d",
                                        "entry_id": "3c584e93-0768-302b-9c08-f53d0c33ce90",
                                        "glosses": [
                                            "mit 2.201 Kilometern der drittlängste Fluss in Europa, der durch Russland, Belarus und die Ukraine fließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fc8544-9239-4c44-814d-932f3acee414",
                                                "sense_id": "624ef3ce-dbc3-34cc-a6ef-f11736f40d8d",
                                                "text": "„Im Mittelabschnitt ist der Russe nahe der polnischen Grenze, im Süden aber haben unsere Truppen noch nicht einmal den Dnjepr erreicht, obwohl der Fluß dort Hunderte Kilometer nach Osten vorspringt.“"
                                            },
                                            {
                                                "example_id": "8f77101e-ca64-4ce8-abee-69e736044b89",
                                                "sense_id": "624ef3ce-dbc3-34cc-a6ef-f11736f40d8d",
                                                "text": "„In Kiew lässt der Konvertit nun alle heidnischen Götterbilder und Statuen zerschlagen oder ins Feuer werfen und befiehlt zudem seinen Untertanen, sich am Ufer des Dnjepr zu einer Massentaufe einzufinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
