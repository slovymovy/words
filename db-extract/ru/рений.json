                                                "example_id": "8baf79e5-96b1-485f-accf-16e05872726b",
                                                "sense_id": "88429a48-b687-3369-a577-d9e807077fb4",
                                                "text": "Ren czyli humanitarność jest największą cnotą człowieka, dążenie do niej stanowi najwyższy cel edukacji."
                                            }
                                        ],
                                        "sense_index_json": "\"3.1\""
                                    }
                                ]
                            }
