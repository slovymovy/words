                                "target_lang_word": "mordant",
                                "target_lang_sense_clarification": "forme verbale de mordre"
                            },
                            {
                                "target_lang_word": "en se rongeant",
                                "target_lang_sense_clarification": "pour les ongles"
                            }
                        ]
                    }
