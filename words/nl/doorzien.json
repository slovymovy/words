{
    "word_family": [
        "zicht",
        "zien",
        "doorzicht",
        "doorzichtig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25e60437-2409-3386-96d2-c7b20165a83c",
                    "sense_definition": "Inzien dat iets een poging tot bedrog is, of de ware aard van iets of iemand begrijpen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "begrijpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>doorzag</w> hun plannen onmiddellijk en weigerde mee te werken.",
                            "target_lang_translations": {
                                "en": "He <w>saw through</w> their plans immediately and refused to cooperate."
                            }
                        },
                        {
                            "text": "Het is belangrijk om een leugen snel te <w>doorzien</w>.",
                            "target_lang_translations": {
                                "en": "It is important to <w>see through</w> a lie quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorhebben"
                    ],
                    "common_phrases": [
                        "een leugen doorzien",
                        "iemands plannen doorzien"
                    ],
                    "target_lang_definitions": {
                        "en": "To realize that something is an attempt to deceive, or to understand the true nature of something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "see through",
                                "target_lang_sense_clarification": "to not be deceived by someone or something"
                            },
                            {
                                "target_lang_word": "figure out",
                                "target_lang_sense_clarification": "to understand the true nature or motive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa9cfc13-7e02-3fb4-a103-c0acd6ff7d29",
                    "sense_definition": "Iets vluchtig lezen of globaal bekijken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hadden het voorstel maar eventjes <w>doorgezien</w>.",
                            "target_lang_translations": {
                                "en": "They had only <w>looked over</w> the proposal briefly."
                            }
                        },
                        {
                            "text": "Ik moet de documenten nog snel <w>doorzien</w> voor de vergadering begint.",
                            "target_lang_translations": {
                                "en": "I still need to quickly <w>go through</w> the documents before the meeting starts."
                            }
                        }
                    ],
                    "synonyms": [
                        "doornemen"
                    ],
                    "common_phrases": [
                        "documenten doorzien",
                        "een rapport doorzien"
                    ],
                    "target_lang_definitions": {
                        "en": "To read through something quickly or look over it globally."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look over",
                                "target_lang_sense_clarification": "to quickly check or inspect"
                            },
                            {
                                "target_lang_word": "leaf through",
                                "target_lang_sense_clarification": "to turn pages and read briefly"
                            },
                            {
                                "target_lang_word": "go through",
                                "target_lang_sense_clarification": "to examine or read through"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e08c8707-987f-3031-b24b-d21553913df3",
                    "sense_definition": "Het voltooid deelwoord van <w>doorzien</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een <w>doorziene</w> blik keek de detective naar de verdachte.",
                            "target_lang_translations": {
                                "en": "With a <w>knowing</w> look, the detective stared at the suspect."
                            }
                        },
                        {
                            "text": "Dat is een reeds lang <w>doorziene</w> truc die bij niemand meer werkt.",
                            "target_lang_translations": {
                                "en": "That is a trick that has long been <w>seen through</w> and no longer works on anyone."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle used as adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The past participle of 'doorzien', used as an adjective meaning 'shrewd', 'knowing', or 'seen through'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knowing",
                                "target_lang_sense_clarification": "suggesting secret or shrewd understanding"
                            },
                            {
                                "target_lang_word": "shrewd",
                                "target_lang_sense_clarification": "having or showing sharp powers of judgment"
                            },
                            {
                                "target_lang_word": "seen-through",
                                "target_lang_sense_clarification": "already exposed or unmasked"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}