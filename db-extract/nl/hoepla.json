                "senses": [
                    {
                        "sense_id": "6e222f6d-b0af-329b-9d78-f30c3dc76b66",
                        "entry_id": "b223eec5-e82a-3dd8-a99d-f409952a25dc",
                        "glosses": [
                            "tussenwerpsel dat een plotselinge of snelle actie begeleidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f294e61-97bc-4eaf-9b69-201a517f439c",
                                "sense_id": "6e222f6d-b0af-329b-9d78-f30c3dc76b66",
                                "text": "Lips wilde eigenlijk niet weten wat hij zoal met Sidore doet. Maar hoepla, daar vertelde hij het al uit zichzelf. \"Ze zoent heerlijk.\" En zomaar wat voordelen van 'synthetische mensen': ze liegen niet en ze takelen ook niet af."
                            },
                            {
                                "example_id": "df81be63-c460-4b5e-a113-564edd31e45f",
                                "sense_id": "6e222f6d-b0af-329b-9d78-f30c3dc76b66",
                                "text": "Strand ontwierp een enorme kermiskraam die nét in de galerie past. „Hoepla”, roepen de galeriehouders bij elke worp (wat de concentratie niet helpt)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f1366a0-0722-4bfb-96a4-09d68d875291",
                        "source_entry_id": "b223eec5-e82a-3dd8-a99d-f409952a25dc",
                        "source_sense_id": "6e222f6d-b0af-329b-9d78-f30c3dc76b66",
                        "target_lang_word": "hoopla",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoopla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                                        "entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                                        "glosses": [
                                            "A bustling to-do, excited speech or noise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a768c9d-4dcc-40ea-9bb7-85ffc8006928",
                                                "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                                                "text": "Say you don't know me, or recognize my face / Say you don't care who goes to that kind of place / Knee deep in the hoopla, sinking in your fight / Too many runaways eating up the night"
                                            },
                                            {
                                                "example_id": "bc137671-9d0b-4be8-ac00-7ae115955dd3",
                                                "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                                                "text": "Campers enjoyed all of the traditional camp hoopla: color wars, shared team games with other camps and young eager college students spending their summer as counselors."
                                            },
                                            {
                                                "example_id": "d07fd3a0-5bff-41a4-b7fd-93bb245b4d63",
                                                "sense_id": "3cb8a621-4ae8-3a83-86fa-801dac3625ad",
                                                "text": "Some astronomers dislike the whole supermoon hoopla. They point out that the term originated with astrology, not astronomy; that perigee full moons are not all that rare, coming an average of every 13 months; and that their apparently swollen dimensions are often as much a matter of optical illusion and wishful blinking as of relative lunar nearness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0fed00d-18d2-3225-91fa-08a5cfcd22a1",
                                        "entry_id": "18c1f71d-6135-3063-a6ac-7a2bf9736a15",
                                        "glosses": [
                                            "A carnival game in which the player attempts to throw hoops around pegs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
