                        "entry_id": "0e904ee9-2103-32b0-85f2-f30d820ded3e",
                        "glosses": [
                            "Rough or rowdy play that can often result in unintentional physical harm."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
