                "senses": [
                    {
                        "sense_id": "50a3d95a-12cc-3b75-8094-0e8f0dec2c5d",
                        "entry_id": "c54063bd-a139-39c2-81e5-1027d25fa42a",
                        "glosses": [
                            "grafische Darstellung der Zugtrassen eines Streckenbereiches"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "02414fc3-5c42-4278-b7cf-c13a2164608f",
                                "sense_id": "50a3d95a-12cc-3b75-8094-0e8f0dec2c5d",
                                "text": "„In FBS liefern die im Bildfahrplan angelegten Züge die Ausgangsdaten für die Anfertigung darauf aufbauender Unterlagen innerhalb der anderen iPLAN-Module.“"
                            },
                            {
                                "example_id": "06d3e8b5-3550-4770-b8ad-a65d042a0067",
                                "sense_id": "50a3d95a-12cc-3b75-8094-0e8f0dec2c5d",
                                "text": "„Um einen klaren und kompakten Überblick über die einzelnen Themenfelder zu erhalten, werden neben der textlichen Beschreibung auch tabellarische Übersichten, Diagramme, Bildfahrpläne sowie diverse Karten und Pläne erstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
