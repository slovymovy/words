                                        "sense_id": "4d276228-a20d-3090-8e54-535a9eb48c5d",
                                        "entry_id": "0dd3943f-7ea3-3444-87d0-783bc9601eb1",
                                        "glosses": [
                                            "comparative form of great: more great"
