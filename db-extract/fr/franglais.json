                ],
                "senses": [
                    {
                        "sense_id": "08212046-495d-3f5a-b935-74bd85103549",
                        "entry_id": "91f63479-4c9c-38f9-9143-886efd828e1c",
                        "glosses": [
                            "Personne qui parle le franglais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc57e297-67a8-4a93-9091-056899eb8d47",
                                "sense_id": "08212046-495d-3f5a-b935-74bd85103549",
                                "text": "Dans l’aimable et luxueux restaurant de la Forêt où les joueurs du Casino viennent se refaire, les toasts du dîner d’adieu des Franglais pétilleront d’optimisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dac1c96-9e44-34c4-aeb3-51f8baacab1b",
                        "entry_id": "91f63479-4c9c-38f9-9143-886efd828e1c",
                        "glosses": [
                            "Personne ayant à la fois des origines françaises et anglaises, ou étant empreint des deux cultures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae662940-afd0-4c90-9de6-1d1d9a478bb7",
                                "sense_id": "8dac1c96-9e44-34c4-aeb3-51f8baacab1b",
                                "text": "Être Franglais n’est pas toujours évident et cela ne me donne certainement pas un sentiment d’appartenance. Au contraire, cela me donne l’impression d’être coincé au milieu de deux modes de vie, de deux types de comportements – bref, de deux cultures – ce qui explique parfaitement pourquoi je vis aux Pays-Bas. Je n’ai qu’à regarder à gauche pour voir l’Angleterre et en bas pour voir la France."
                            }
                        ]
                    }
                ],
