                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d5cdbb-cbcd-4cee-ba6c-32559e0bf335",
                                "sense_id": "cdff2092-7f8c-3705-8749-1e79698e2c6c",
                                "text": "Od kilku miesięcy biorę pigułki antykoncepcyjne, trójfazowe, podobno bardzo mało szkodliwe dla przyszłego dzieciaczka"
                            },
                            {
                                "example_id": "8862ad78-8e6c-4ab9-b476-386b8bed84b1",
                                "sense_id": "cdff2092-7f8c-3705-8749-1e79698e2c6c",
                                "text": "Przemiennik ten przekształca trójfazowe, stałoczęstotliwościowe wejście 400 V na trójfazowe, zmiennoczęstotliwościowe wyjście 400 V, aby kontrolować prędkość standardowego silnika indukcyjnego prądu zmiennego."
                            }
                        ],
