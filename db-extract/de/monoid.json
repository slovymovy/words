                "senses": [
                    {
                        "sense_id": "3211ca94-5aeb-301e-b111-34a1793b27b2",
                        "entry_id": "730754a1-1422-3223-a92c-e95405b9aa67",
                        "glosses": [
                            "algebraische Struktur bestehend aus einer Menge mit einer klammerfrei notierbaren (assoziativen) Verknüpfung und einem neutralen Element"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76be3252-5a39-4e53-99fc-96438a3a6636",
                                "sense_id": "3211ca94-5aeb-301e-b111-34a1793b27b2",
                                "text": "Die natürlichen Zahlen mit der Addition und der 0 als neutrales Element bilden ein Monoid."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e84aeb8a-00dd-47a9-aa76-1c20fa4b1306",
                        "source_entry_id": "730754a1-1422-3223-a92c-e95405b9aa67",
