                        "examples": [
                            {
                                "example_id": "5ceada91-5860-4343-b2d8-045cecda643d",
                                "sense_id": "882168ac-ece6-3580-a16d-1d537b8affc0",
                                "text": "Mr. Brezhnev departed drastically from the recent Soviet propaganda line, which has attacked the United States for conniving in the Chinese invasion, as some Soviet press comments have put it.\nHe did say that “the entire danger of any forms of connivance with that policy is more evident now than ever before.” But he did not mention the United States in this context and did not develop the argument voiced constantly by official spokesmen since the invasion that China had been emboldened by its reconciliation with the United States and that the Carter Administration had, in effect, encouraged the Chinese attack."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a23cc326-ce86-4867-951a-84dba32fa19f",
                        "source_entry_id": "df2d196c-6d82-380c-b83e-fecf141992c9",
                        "source_sense_id": "882168ac-ece6-3580-a16d-1d537b8affc0",
                        "source_sense_description": "that connives",
                        "target_lang_word": "intrigant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrigant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b18afbf2-030e-3735-a93c-cd5777d87a08",
                                        "entry_id": "99b9f25d-ec48-3453-bdf9-af6078947e65",
                                        "glosses": [
                                            "hinterhältig, intrigierend, Intrigen spinnend, Ränke schmiedend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fccffc3-3820-4756-9082-203673683fb8",
                                                "sense_id": "b18afbf2-030e-3735-a93c-cd5777d87a08",
                                                "text": "Ich kann den intriganten und arroganten Jockel nicht mehr sehen."
                                            },
                                            {
                                                "example_id": "0ab61810-e8b2-48be-a58b-01d601cdaa4d",
                                                "sense_id": "b18afbf2-030e-3735-a93c-cd5777d87a08",
                                                "text": "Jetzt wird es wieder intrigant im Büro, denn Chantal, Mandy und Jacqueline sind aus dem Urlaub zurück."
                                            },
                                            {
                                                "example_id": "47c7e767-43dc-4b7a-ab0b-91433417fbff",
                                                "sense_id": "b18afbf2-030e-3735-a93c-cd5777d87a08",
                                                "text": "„Nun musste Brüning erfahren, dass der geistig und körperlich hinfällige Hindenburg in seinen Entscheidungen zunehmend von einer intriganten Kamarilla abhängig war und zum Vehikel zutiefst partikularer Interessen einzelner rechtsnationaler und ostelbischer Gruppen wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bbd28c6-2402-4dec-97a8-35c0ae7af1ed",
                        "source_entry_id": "df2d196c-6d82-380c-b83e-fecf141992c9",
                        "source_sense_id": "882168ac-ece6-3580-a16d-1d537b8affc0",
