                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2233ad38-4a7f-37bf-bbba-59ef67534380",
                                        "entry_id": "1eae6f70-8bce-36ca-b90e-a259cb5b54d7",
                                        "glosses": [
                                            "innerer Drang nach/Lust auf Reisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d6ed4e-6d7c-4e39-8f61-3deff4c36c4d",
                                                "sense_id": "2233ad38-4a7f-37bf-bbba-59ef67534380",
                                                "text": "„Selten war die Reiselust im gehobenen Bürgertum größer, die noch geöffneten Hotels in ländlichen Ferienorten so überfüllt wie 1916/17.“"
                                            }
                                        ],
