                "senses": [
                    {
                        "sense_id": "3f5094d7-956f-3a9d-bc82-039c561dd30f",
                        "entry_id": "0c0df35c-24e9-3488-912a-ece9b4806e7f",
                        "glosses": [
                            "Parler le picard, ou en employant des mots picards, avec quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04027e25-fc69-417e-a04f-3cee63b088bb",
                                "sense_id": "3f5094d7-956f-3a9d-bc82-039c561dd30f",
                                "text": "Et cela n’est pas spécial aux hommes du peuple. J’ai habité la Picardie, et j’ai presque toujours entendu les patrons d’usine, les grands agriculteurs, les marchands, les médecins, les curés, picarder avec leurs employés, ouvriers, clients, etc."
                            },
                            {
                                "example_id": "80dd7933-4e0b-4b64-b341-c0f4aa015f81",
                                "sense_id": "3f5094d7-956f-3a9d-bc82-039c561dd30f",
                                "text": "Je suis d’oïl, et le coq chante mes amours en picardant."
                            }
                        ]
                    }
                ],
