                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est très <w>triste</w> parce qu'il a perdu son jouet préféré hier matin."
                        },
                        {
                            "text": "Elle semblait avoir l'air <w>triste</w> en apprenant la mauvaise nouvelle de son départ."
                        }
                    ],
                    "synonyms": [
                        "abattu",
                        "chagriné",
                        "malheureux"
                    ],
                    "antonyms": [
                        "content",
                        "gai",
                        "heureux",
                        "joyeux"
                    ],
                    "common_phrases": [
