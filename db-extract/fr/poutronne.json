                        "examples": [
                            {
                                "example_id": "3fc3b449-0876-4086-90d7-fac769f59511",
                                "sense_id": "85ee2909-b818-3d22-b5b6-71c6c7d69fbc",
                                "text": "J’ai déjà repéré que la Calabraise avait une fille. Une espèce de poutronne toute noiraude avec une frange noire sur les yeux noirs, un peu comme ceux de maman."
                            },
                            {
                                "example_id": "00098ce1-1cde-426b-96e9-796cd6a0f487",
                                "sense_id": "85ee2909-b818-3d22-b5b6-71c6c7d69fbc",
                                "text": "Une fête de l’œil, une jubilation de la couleur, ces autoportraits en pitre à son chevalet, cette gamine sur son cheval à bascule peinturlurée comme une poutronne, ce nu fauve et coquin entre Bonnard et Pascin, ce carnaval d'Aix qui préfigure des fêtes foraines à venir.."
                            }
                        ]
                    }
