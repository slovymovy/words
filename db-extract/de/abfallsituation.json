                        "glosses": [
                            "Situation in Bezug auf den (anfallenden) Abfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ee0d335-4042-4dd1-abd0-53d1de7a5113",
                                "sense_id": "646d390b-3f73-38ff-b74c-739b5008274d",
                                "text": "„Greenpeace hatte zuvor rund um die Stadt Adana im Südosten der Türkei die Abfallsituation untersucht und auf illegalen Müllkippen unter anderem Plastikabfall aus deutschen Supermärkten entdeckt.“"
                            },
                            {
                                "example_id": "0789dd65-6cb3-4680-bac6-2ff52d8878ea",
                                "sense_id": "646d390b-3f73-38ff-b74c-739b5008274d",
                                "text": "„Wer keinen Garten besitzt, aber dennoch seine Abfallsituation optimieren möchte, findet in der Wurmkiste eine gute Lösung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
