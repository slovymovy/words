                "senses": [
                    {
                        "sense_id": "75709595-df9a-3bcc-88f9-4e38d33bb269",
                        "entry_id": "d9f822ff-b156-3099-b441-e38cb39f8e8f",
                        "glosses": [
                            "Interessensvertretung der Studierenden an einer Hochschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4064779-fc7d-4e41-be51-0f02b10641ce",
                                "sense_id": "75709595-df9a-3bcc-88f9-4e38d33bb269",
                                "text": "„[Nadine Ponsel:] Eine gestärkte Studentenvertretung dagegen hätte in den Gremien eine bessere Position, weil sie besser arbeiten könnte.“"
                            },
                            {
                                "example_id": "f60df6b7-b1c2-4c69-9898-1e14f9cbde00",
                                "sense_id": "75709595-df9a-3bcc-88f9-4e38d33bb269",
                                "text": "„An der Berliner Humboldt-Universität eskaliert ein Streit zwischen dem Rektorat und der Studentenvertretung.“"
                            },
                            {
                                "example_id": "b713054d-6527-4ec1-a51a-a7bde8bc51e1",
                                "sense_id": "75709595-df9a-3bcc-88f9-4e38d33bb269",
                                "text": "„Die Beklagte hat diese Frage aufgrund einer Beschwerde der Studentenvertretung und einer entsprechenden Beschlussfassung der Beklagten verneint und den Kläger gekündigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
