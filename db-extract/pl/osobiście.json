                    },
                    {
                        "translation_id": "d0efb41d-9055-48cf-b7f1-c3a37b2d0d37",
                        "source_entry_id": "0cf44ae6-f049-38b3-a69b-0fd95037fb04",
                        "source_sense_id": "c5d41f9f-8f31-3169-a69e-de022ec7096b",
