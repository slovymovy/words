                ],
                "senses": [
                    {
                        "sense_id": "f3575f8b-df81-38b0-879e-5ae268279707",
                        "entry_id": "71c9188e-3006-3b8c-aafd-c7638b8e09d5",
                        "glosses": [
                            "A chemical element (symbol Co) with an atomic number of 27: a hard, lustrous, silver-gray metal."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a3dc8f3d-6f79-3c02-932f-d01a174cd13d",
                        "entry_id": "71c9188e-3006-3b8c-aafd-c7638b8e09d5",
                        "glosses": [
                            "Cobalt blue."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "29564b80-3091-4810-bbc5-f547de70a9d9",
                                "sense_id": "a3dc8f3d-6f79-3c02-932f-d01a174cd13d",
                                "text": "And although we’ve certainly seen a variety of blue shades — from periwinkle to cobalt and even Dean Cain’s indigo-washed costume from the 1990’s TV show “Lois & Clark” — Superman’s uniform is still instantly recognizable across generations. In fact, there is only one film — Zack Snyder’s 2013 “Man of Steel” — in which Superman does not wear his iconic red belted trunks."
                            }
                        ]
                    }
                ],
