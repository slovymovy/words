                "senses": [
                    {
                        "sense_id": "6752ff16-d17a-35d8-a58b-5b4764869f13",
                        "entry_id": "3fe5333b-d694-30c1-b08d-57725a710fdf",
                        "glosses": [
                            "Politiker, welcher der Opposition angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1de444-dc65-4f87-9305-01d38a8ae5ff",
                                "sense_id": "6752ff16-d17a-35d8-a58b-5b4764869f13",
                                "text": "„Der Oppositionspolitiker Jüri Ratas wurde vom Parlament in Tallinn als neuer Ministerpräsident des baltischen EU- und Nato-Landes bestätigt.“"
                            },
                            {
                                "example_id": "1b48a2d7-1e59-4499-9ef3-498cef938430",
                                "sense_id": "6752ff16-d17a-35d8-a58b-5b4764869f13",
                                "text": "„Bei einer Massendemonstration vor drei Jahren lernte er einen hoffnungsvollen Oppositionspolitiker namens Alexis Tsipras kennen.“"
                            },
                            {
                                "example_id": "fbbb118c-03c9-40a9-8b98-e42aa86adf52",
                                "sense_id": "6752ff16-d17a-35d8-a58b-5b4764869f13",
                                "text": "„Nur ein paar wenige Oppositionspolitiker und konservative Kommentatoren stimmten ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
