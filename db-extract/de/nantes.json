                        "examples": [
                            {
                                "example_id": "a3b5e10e-db26-4b99-9f1c-870b0f5889cf",
                                "sense_id": "d2d2cd5a-a7f7-3fc8-b4b2-fd8f0765968f",
                                "text": "Lucas arbeitet in Nantes bei Airbus."
                            },
                            {
                                "example_id": "b25d40ce-e33e-4b75-adbe-97f4fc6967fc",
                                "sense_id": "d2d2cd5a-a7f7-3fc8-b4b2-fd8f0765968f",
                                "text": "Von Paris aus ist Nantes in gut zwei Stunden per TGV erreichbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26770223-2631-423a-8d71-da2ed0b0254a",
                        "source_entry_id": "7d91bdd5-8dd9-32f3-9707-544961d03ac4",
                        "source_sense_id": "d2d2cd5a-a7f7-3fc8-b4b2-fd8f0765968f",
