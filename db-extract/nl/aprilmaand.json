                        "examples": [
                            {
                                "example_id": "c67cb42f-e435-466b-bb9c-e8d30c813d58",
                                "sense_id": "1a6f455e-315e-3ab4-84ce-29696848d947",
                                "text": "Andere vergelijkingen: december was dit jaar warmer dan de gemiddelde aprilmaand (9,2 graden) en bijna een graad warmer dan de warmste maartmaand (8,8 graden in 1991)."
                            },
                            {
                                "example_id": "dd590518-c4a1-4b4d-af8f-0a5fbfc5d10f",
                                "sense_id": "1a6f455e-315e-3ab4-84ce-29696848d947",
                                "text": "De lente was dit jaar fraai door een uitzonderlijk warme aprilmaand. Het was zelfs de warmste april sinds het jaar 1706. De zomer viel dit jaar tegen. Vooral in juli was het erg koel."
                            }
                        ]
