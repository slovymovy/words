                        "translation_id": "9f24d583-7054-4ca1-b30a-68086dff4130",
                        "source_entry_id": "16ca0690-4449-34e3-8b0b-6656953f6f77",
                        "source_sense_id": "b65030b8-a4b2-31ba-9469-7e26af13a05f",
                        "target_lang_word": "breakable",
