                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cervical",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "597920dd-f95d-308a-b513-5ea7cb0a0be3",
                                        "entry_id": "b5bc7453-ebb8-3640-9643-eb0762b03537",
                                        "glosses": [
                                            "Qui appartient à la nuque, à la partie postérieure du cou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78629b80-5a77-4cc8-9358-04c8c8893d27",
                                                "sense_id": "597920dd-f95d-308a-b513-5ea7cb0a0be3",
                                                "text": "La racine orthosympathique provient du plexus artériel péri-ophtalmique, lui-même des ganglions cervicaux par l’intermédiaire des fibres péricarotidiennes."
                                            },
                                            {
                                                "example_id": "132a2f6e-dd7f-44e8-a260-83669b648a5e",
                                                "sense_id": "597920dd-f95d-308a-b513-5ea7cb0a0be3",
                                                "text": "Les influx provenant des ganglions latéro-vertébraux cervicaux forment des fibres péri-carotidiennes et enfin péri-ophtalmiques autour des artères du même nom (figure 4.13)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf039136-d1a0-36bc-9baa-5cffba5cf94e",
                                        "entry_id": "b5bc7453-ebb8-3640-9643-eb0762b03537",
                                        "glosses": [
                                            "Relatif à une région du corps appelée col, par exemple le col de l’utérus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8cccf3b-db56-4bff-8008-cd2e504f9db2",
                                                "sense_id": "bf039136-d1a0-36bc-9baa-5cffba5cf94e",
                                                "text": "Chez la vache vivant en troupeau sans mâle, la détermination de la période de fécondité, en vue d’une insémination, se fait par l’observation de l’écoulement de la glaire cervicale, par la vulve, et des comportements de chevauchement entre femelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
