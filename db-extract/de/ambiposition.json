                                        "glosses": [
                                            "An adposition that can occur either before or after its complement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc2e912-45c4-48c1-a0cb-ed882b888fc3",
                                                "sense_id": "f293a930-6a8a-3d78-bfea-8d3dd08aca74",
                                                "text": "The ascribing of postpositions to Indo-European is not well founded. The elements concerned may have been ambipositions."
                                            }
