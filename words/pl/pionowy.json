{
    "word_family": [
        "pion",
        "pionowo",
        "pionować",
        "spionizować",
        "pionier"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23eec5e9-4de7-393c-9d43-30041a826e24",
                    "sense_definition": "mający kierunek prostopadły do poziomu lub do powierzchni ziemi",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kierunek_polozenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wysoki mur był zupełnie <w>pionowy</w> i nikt nie potrafił się na niego wspiąć.",
                            "target_lang_translations": {
                                "ru": "Высокая стена была абсолютно <w>вертикальной</w>, и никто не мог на неё взобраться."
                            }
                        },
                        {
                            "text": "Narysuj na kartce papieru prostą <w>pionową</w> linię za pomocą ołówka oraz linijki.",
                            "target_lang_translations": {
                                "ru": "Нарисуй на листе бумаги прямую <w>вертикальную</w> линию с помощью карандаша и линейки."
                            }
                        }
                    ],
                    "antonyms": [
                        "poziomy"
                    ],
                    "common_phrases": [
                        "linia pionowa",
                        "pozycja pionowa",
                        "pionowa ściana"
                    ],
                    "target_lang_definitions": {
                        "ru": "расположенный перпендикулярно горизонту или земной поверхности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертикальный",
                                "target_lang_sense_clarification": "о положении или направлении линии, стены"
                            },
                            {
                                "target_lang_word": "отвесный",
                                "target_lang_sense_clarification": "о крутом, почти вертикальном склоне или стене"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ec650c9-3e43-3969-9450-4fe89b232e06",
                    "sense_definition": "odbywający się wprost w górę lub w dół",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten nowoczesny samolot wojskowy ma funkcję <w>pionowego</w> startu i lądowania.",
                            "target_lang_translations": {
                                "ru": "У этого современного военного самолёта есть функция <w>вертикального</w> взлёта и посадки."
                            }
                        },
                        {
                            "text": "Dron wykonał szybki <w>pionowy</w> lot prosto w chmury.",
                            "target_lang_translations": {
                                "ru": "Дрон совершил быстрый <w>вертикальный</w> полёт прямо в облака."
                            }
                        }
                    ],
                    "antonyms": [
                        "poziomy"
                    ],
                    "common_phrases": [
                        "pionowy start"
                    ],
                    "target_lang_definitions": {
                        "ru": "направленный прямо вверх или прямо вниз"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертикальный",
                                "target_lang_sense_clarification": "о движении, взлёте, спуске"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "280e855e-73e5-31f5-871e-626a7181550e",
                    "sense_definition": "dotyczący piona w szachach lub innej grze planszowej",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po tym niespodziewanym ruchu gracza jego struktura <w>pionowa</w> stała się bardzo słaba.",
                            "target_lang_translations": {
                                "ru": "После этого неожиданного хода игрока его <w>пешечная</w> структура стала очень слабой."
                            }
                        },
                        {
                            "text": "Udało mu się stworzyć silny łańcuch <w>pionowy</w> w centrum szachownicy.",
                            "target_lang_translations": {
                                "ru": "Ему удалось создать сильную <w>пешечную</w> цепь в центре шахматной доски."
                            }
                        }
                    ],
                    "synonyms": [
                        "pionkowy"
                    ],
                    "common_phrases": [
                        "struktura pionowa",
                        "łańcuch pionowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к пешке в шахматах или других настольных играх"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пешечный",
                                "target_lang_sense_clarification": "относящийся к пешкам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}