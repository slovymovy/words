                        "examples": [
                            {
                                "example_id": "5d6a70a2-88d3-439f-95b0-78a2cfffe324",
                                "sense_id": "dbbee6d8-c593-34a3-8953-52a14ed40f68",
                                "text": "L’abbé de Montesquiou avoit déjà fait ses preuves comme agent du feu clergé, et sans partager les orgueilleuses prétentions de ce corps inhumiliable, il avoit traité ses affaires avec une grandeur dans les idées qui les firent prospérer sans fatiguer ceux qui devoient y coopérer."
                            },
                            {
                                "example_id": "286e5175-aa8e-424b-83ab-4ab8ba3c2ad9",
                                "sense_id": "dbbee6d8-c593-34a3-8953-52a14ed40f68",
                                "text": "Elle était humble, donc inhumiliable."
                            },
                            {
                                "example_id": "8e24426f-d93d-43a3-a1e9-1e438008ab32",
                                "sense_id": "dbbee6d8-c593-34a3-8953-52a14ed40f68",
                                "text": "INÈS. Je suis inhumiliable, tu peux continuer...\nHENRI. Pas de pleurnicheries ! Pour l’amour du ciel ! Vous n’allez pas nous sentimentaliser les choses avec des geignements de petite-bourgeoise. Inhumiliable ! J’apprécie le mot remarquez, …"
                            }
                        ]
