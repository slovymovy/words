        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                "word": "roseate",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d93b073e-00d7-4b76-98e7-958a715edc65",
                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more roseate"
                    },
                    {
                        "form_id": "036bea3b-c8f7-4b47-8d4a-3d168d70fac9",
                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most roseate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                        "glosses": [
                            "Like the rose flower; pink; rosy."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "a6c10759-3310-49a7-908d-256e8326da2c",
                                "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                                "text": "The countess took the roseate palm and snowy fingers of this lovely child."
                            },
                            {
                                "example_id": "459d2f29-2737-4189-bf78-166e82907e3f",
                                "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                                "text": "Now the rum, as has been said, was criminally overproof, and they had had no intoxicants for a long time. And so a couple of stiff drinks produced a beautiful and generous expansion of soul. The mean cabin became larger, the fire warmer and more cheerful, and life generally of a more roseate hue. They began to feel the prodigal Thanksgiving spirit, and to regret their limited opportunities for satisfying it."
                            },
                            {
                                "example_id": "14c2cd76-bb75-4742-ac7e-b8a64722e08e",
                                "sense_id": "411d947c-3b0d-3efb-838f-2803bd42a65d",
                                "text": "On Professor Solanka’s street, well-heeled white youths lounged in baggy garments on roseate stoops, stylishly simulating indigence while they waited for the billionairedom that would surely be along sometime soon."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d012916-ba49-3225-ba2e-7486bfe80706",
                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                        "glosses": [
                            "Full of roses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f70418-bfb3-4171-8023-80e611050c6a",
                                "sense_id": "2d012916-ba49-3225-ba2e-7486bfe80706",
                                "text": "To fund the purchase, he had to sell a late Renoir, The Judgment of Paris, with its depiction of weighty ladies frolicking in a roseate garden."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9a041de-7aea-33d1-a671-67f7cc1eba86",
                        "entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                        "glosses": [
                            "Excessively optimistic."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f815ad9b-2f88-4929-8482-ed52f438621c",
                                "sense_id": "d9a041de-7aea-33d1-a671-67f7cc1eba86",
                                "text": "Viewed from this perspective, the behaviour of the digital giants looks rather different from the roseate hallucinations of Wired magazine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "834ea4a3-74fd-46f6-9759-78f28ffbe78d",
                        "source_entry_id": "acd97314-ad19-3bc1-aecd-590504bf73b3",
                        "source_sense_description": "(formal) pink; rosy",
                        "target_lang_word": "rosâtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1713cd56-06ba-3a69-8b7e-96ada7f71bbc",
                                        "entry_id": "d8d4e98e-0b0e-319a-b91b-52dc7469f86d",
                                        "glosses": [
                                            "Qui a une teinte rosée, d’un rose sale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4e5876-ded6-4d68-bd30-77f8da8e7789",
                                                "sense_id": "1713cd56-06ba-3a69-8b7e-96ada7f71bbc",
                                                "text": "Une table carrée, d’un merisier plus rosâtre que le reste de l’ameublement, à dessus de marbre gris, grillagée de cuivre, était en face du lit, contre le mur, entre la fenêtre et la porte d’un grand cabinet de toilette."
                                            },
                                            {
                                                "example_id": "112f397f-ea3f-4ec1-b322-c962c621caff",
                                                "sense_id": "1713cd56-06ba-3a69-8b7e-96ada7f71bbc",
                                                "text": "Il portait un chandail rosâtre et ses joues trop fardées tournaient au lie de vin."
                                            },
                                            {
                                                "example_id": "d6c95c4a-09c2-4600-b282-f6d07ef1e5be",
                                                "sense_id": "1713cd56-06ba-3a69-8b7e-96ada7f71bbc",
                                                "text": "Quant à l'ambiance, elle est faite de visions terrifiantes, de hurlements de douleur, de dégueulis rosâtres, de vomissements d'injures, de transpirations gluantes, de gémissements épouvantables, de pourrissements vivants, de râles atroces, de décompositions lentes et de morts qui n'en finissent plus..."
                                            },
                                            {
                                                "example_id": "6ab02e7b-295a-4d00-a93b-91fbbb545c4e",
                                                "sense_id": "1713cd56-06ba-3a69-8b7e-96ada7f71bbc",
                                                "text": "Sa peau était rosâtre et si douce que tous les hommes rêvaient de la frôler ne fût-ce que du revers des doigts."
                                            },
                                            {
                                                "example_id": "8334a32e-2989-4de3-8764-3f19ec4bb69d",
                                                "sense_id": "1713cd56-06ba-3a69-8b7e-96ada7f71bbc",
                                                "text": "La sporée, abondante à la fin de maturité, paraît poudrer les lamelles d’une couleur crème rosâtre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
