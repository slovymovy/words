                "senses": [
                    {
                        "sense_id": "ac69d0cf-6a5c-34d4-860c-b13e8273b613",
                        "entry_id": "6d8f6a49-f367-32a7-9bc2-6daee5fd1376",
                        "glosses": [
                            "Entzündung des Parenchyms der Leber, die durch ein Virus verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264aa9a3-0a2d-4cd3-95f6-40903c39b979",
                                "sense_id": "ac69d0cf-6a5c-34d4-860c-b13e8273b613",
                                "text": "„Die hoch ansteckende und meldepflichtige Leberentzündung Virushepatitis A ist laut Robert-Koch-Institut die häufigste Reisekrankheit nach Durchfall und Atemwegserkrankungen.“"
                            },
                            {
                                "example_id": "739d826f-2a0c-4a9c-9f89-455bec25886e",
                                "sense_id": "ac69d0cf-6a5c-34d4-860c-b13e8273b613",
                                "text": "„Jährlich sterben schätzungsweise eine Million Menschen an den Folgen einer Virushepatitis B.“"
                            },
                            {
                                "example_id": "d089bcae-898c-41c5-ad2e-8b65123f2d0c",
                                "sense_id": "ac69d0cf-6a5c-34d4-860c-b13e8273b613",
                                "text": "„Bislang wurde diese Art des Krebses, das hepatozelluläre Karzinom, überwiegend bei Menschen mit Leberzirrhose aufgrund einer Virushepatitis diagnostiziert.“"
                            },
                            {
                                "example_id": "e3b5d487-b28a-4471-a5ee-6394341b64bf",
                                "sense_id": "ac69d0cf-6a5c-34d4-860c-b13e8273b613",
                                "text": "„Wenn es um Virushepatitis geht, machen Experten die Varianten B und C weitaus größeren Sorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
