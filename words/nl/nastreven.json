    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68fbd3b1-90e3-3909-9645-1b45fbcd419e",
                    "sense_definition": "een bepaald doel proberen te bereiken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doelgerichtheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het WikiWoordenboek <w>streeft</w> <w>na</w> alle woorden van alle talen in alle talen te beschrijven.",
                            "target_lang_translations": {
                                "en": "Wiktionary <w>aims</w> to describe all words of all languages in all languages."
                            }
                        },
                        {
                            "text": "Wij moeten altijd een hogere kwaliteit <w>nastreven</w> in ons dagelijks werk.",
                            "target_lang_translations": {
                                "en": "We must always <w>strive for</w> higher quality in our daily work."
                            }
                        }
                    ],
                    "synonyms": [
                        "beogen",
                        "trachten",
                        "proberen"
                    ],
                    "antonyms": [
                        "verwaarlozen",
                        "opgeven"
                    ],
                    "common_phrases": [
                        "een doel nastreven",
                        "kwaliteit nastreven",
                        "geluk nastreven"
                    ],
                    "target_lang_definitions": {
                        "en": "To try to achieve a specific goal or objective."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pursue",
                                "target_lang_sense_clarification": "to follow or go after a goal"
                            },
                            {
                                "target_lang_word": "strive for",
                                "target_lang_sense_clarification": "to make great efforts to achieve something"
                            },
                            {
                                "target_lang_word": "aim for",
                                "target_lang_sense_clarification": "to have a specific intention or goal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a4c362f-8116-3eb1-8a33-299e24bf6c02",
                    "sense_definition": "iets of iemand als voorbeeld nemen en proberen hetzelfde te doen of te zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "imitatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij hebben altijd uitvoering volgens de norm <w>nagestreefd</w>.",
                            "target_lang_translations": {
                                "en": "We have always <w>pursued</w> execution according to the standard."
                            }
                        },
                        {
                            "text": "Veel jonge muzikanten proberen de stijl van hun idolen <w>na</w> te <w>streven</w>.",
                            "target_lang_translations": {
                                "en": "Many young musicians try to <w>emulate</w> the style of their idols."
                            }
                        }
                    ],
                    "synonyms": [
                        "navolgen",
                        "imiteren",
                        "kopiëren"
                    ],
                    "common_phrases": [
                        "een ideaal nastreven",
                        "een voorbeeld nastreven"
                    ],
                    "target_lang_definitions": {
                        "en": "To take something or someone as an example and try to do or be the same."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emulate",
                                "target_lang_sense_clarification": "to match or surpass a person or achievement, typically by imitation"
                            },
                            {
                                "target_lang_word": "aspire to",
                                "target_lang_sense_clarification": "to direct one's hopes or ambitions towards achieving something"
                            },
                            {
                                "target_lang_word": "follow",
                                "target_lang_sense_clarification": "to use as a model or guide"
                            }
                        ]
                    }
                }
            ]
        }
    ]
