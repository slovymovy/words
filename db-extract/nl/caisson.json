                                    {
                                        "sense_id": "9201ae63-8046-3d09-8ce8-943dc153868f",
                                        "entry_id": "5bd5edf0-977a-377a-9dd1-250b33876bf5",
                                        "glosses": [
                                            "An enclosure from which water can be expelled, in order to give access to underwater areas for engineering works etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f96dfd-66e0-4280-a046-604240316e08",
                                                "sense_id": "9201ae63-8046-3d09-8ce8-943dc153868f",
                                                "text": "During the construction of the viaduct, the sinking of the caissons in the river bed caused much difficulty to the engineer and contractors, as a bed of running sand was encountered; in consequence, the expenditure for these foundations proved almost prohibitive."
                                            },
                                            {
                                                "example_id": "c24d17ac-b19e-4e35-9132-9f01e52ff2e6",
                                                "sense_id": "9201ae63-8046-3d09-8ce8-943dc153868f",
                                                "text": "Caissons were enclosed dry chambers built on river beds to facilitate the construction of bridge piers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ce7d2ef-b9f6-32d6-bfd8-fdea5975cad6",
                                        "entry_id": "5bd5edf0-977a-377a-9dd1-250b33876bf5",
                                        "glosses": [
                                            "The gate across the entrance to a dry dock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a2520c9-cb2a-3b89-9acb-9f07e0dd9de0",
                                        "entry_id": "5bd5edf0-977a-377a-9dd1-250b33876bf5",
                                        "glosses": [
                                            "A floating tank that can be submerged, attached to an underwater object and then pumped out to lift the object by buoyancy; a camel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e8db6a5-f666-35e4-8bae-5ce05710df37",
                                        "entry_id": "5bd5edf0-977a-377a-9dd1-250b33876bf5",
                                        "glosses": [
                                            "A two-wheeled, horse-drawn military vehicle used to carry ammunition (and a coffin at funerals)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4ea766-081f-43ae-ad3b-a4419316e778",
                                                "sense_id": "0e8db6a5-f666-35e4-8bae-5ce05710df37",
                                                "text": "Over hill, over dale / As we hit the dusty trail, / And those caissons go rolling along."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7413fead-9160-3e8a-95cc-32cd8f0753ea",
                                        "entry_id": "5bd5edf0-977a-377a-9dd1-250b33876bf5",
                                        "glosses": [
                                            "A large box to hold ammunition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac7fbaf8-9950-3e4e-a59a-94ddb4007412",
                                        "entry_id": "5bd5edf0-977a-377a-9dd1-250b33876bf5",
                                        "glosses": [
                                            "A chest filled with explosive materials, used like a mine."
                                        ],
