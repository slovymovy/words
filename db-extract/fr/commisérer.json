                        "glosses": [
                            "Ressentir, exprimer de la commisération."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "561123b1-9c40-4547-b7d4-0302449b9a8b",
                                "sense_id": "087a27bd-4933-30bc-9b33-a3f20e3527df",
                                "text": "Elle hochait la tête, d’un air de commisérer."
                            },
                            {
                                "example_id": "daff910f-87ac-466d-93fd-d14e8ce50df8",
                                "sense_id": "087a27bd-4933-30bc-9b33-a3f20e3527df",
                                "text": "On ne sait pas s'il faut rire ou pleurer, commisérer ou s'indigner."
                            },
                            {
                                "example_id": "370c24ea-40e1-4ce0-96e7-0afca19aded4",
                                "sense_id": "087a27bd-4933-30bc-9b33-a3f20e3527df",
                                "text": "Ô miracle qui me parut bien fait pour commisérer à ma détresse !"
                            },
                            {
                                "example_id": "15410dc3-28bc-4369-999b-59136044efba",
                                "sense_id": "087a27bd-4933-30bc-9b33-a3f20e3527df",
                                "text": "Tous deux commisérèrent sa mauvaise mine."
                            }
                        ]
