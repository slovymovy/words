                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "4ab30b96-6729-3385-981c-274206cfff2e",
                        "entry_id": "577cfed3-8ccf-3a78-89f1-f116aed91e63",
                        "glosses": [
