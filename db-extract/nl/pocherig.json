                                "target_senses": [
                                    {
                                        "sense_id": "f7437c9f-4a28-332b-9085-b23d999a86ff",
                                        "entry_id": "e21e2ca6-d70c-317c-9d5b-365ca5c872fb",
                                        "glosses": [
                                            "Tending to boast or brag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec77222-765b-4093-a706-2248ae60e3f9",
                                                "sense_id": "f7437c9f-4a28-332b-9085-b23d999a86ff",
                                                "text": "He wrote a boastful autobiography, recording all his great deeds."
                                            },
                                            {
                                                "example_id": "66b42905-06fc-4aae-b316-40363fedc417",
                                                "sense_id": "f7437c9f-4a28-332b-9085-b23d999a86ff",
                                                "text": "It makes one's blood boil, yet heart tremble, to think that we Englishmen and our American descendants, with their boastful cry of liberty, have been and are so guilty"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
