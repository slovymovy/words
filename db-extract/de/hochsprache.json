                    {
                        "form_id": "937111e2-b22f-4591-bf60-218758fd8acd",
                        "entry_id": "ce559f22-5538-3c95-9c17-eab7e2b2dd1b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hochsprachen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "770a3894-a855-33a0-bf9e-53be19702d79",
                        "entry_id": "ce559f22-5538-3c95-9c17-eab7e2b2dd1b",
                        "glosses": [
                            "verbindliche Form der geschriebenen und gesprochenen Sprache, die auch als Maßstab für den Schulunterricht gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b17d30ba-5646-40ec-94b8-5cc0848f82ff",
                                "sense_id": "770a3894-a855-33a0-bf9e-53be19702d79",
                                "text": "„Der Terminus »Standardsprache« beginnt den Terminus Hochsprache heute abzulösen, ohne dass man behaupten könnte, er sei glücklicher gewählt.“"
                            },
                            {
                                "example_id": "eea9a627-6d88-402b-b76f-5b1c8f5226e4",
                                "sense_id": "770a3894-a855-33a0-bf9e-53be19702d79",
                                "text": "„Die Hochsprache hat die größere kommunikative Reichweite, nicht nur geografisch, sondern auch von der Zahl der Situationen her, in denen sie, ohne dass gesellschaftliche Sanktionen drohen, angewandt werden kann.“"
                            },
                            {
                                "example_id": "bf084800-63e4-4733-80f6-40b7a31fb051",
                                "sense_id": "770a3894-a855-33a0-bf9e-53be19702d79",
                                "text": "Hochsprache wird als weitgehend synonym mit Standardsprache verstanden, weckt aber etwas andere Assoziationen."
                            },
                            {
                                "example_id": "a317bf9a-5c79-4c90-82e6-84ad904b8ee7",
                                "sense_id": "770a3894-a855-33a0-bf9e-53be19702d79",
                                "text": "„Der schriftlichen und offiziellen mündlichen Kommunikation (wie Predigt) dient die deutsche Schrift- und Hochsprache, die Standardsprache.“"
                            },
                            {
                                "example_id": "6e0bb8da-bcb9-4869-a311-53c85fa6194f",
                                "sense_id": "770a3894-a855-33a0-bf9e-53be19702d79",
                                "text": "„In dieser Situation konnte ihnen das Hochdeutsche, das sie als die dem Jiddischen ähnlichste Hochsprache empfanden, ersatzweise als Richtschnur für einen literarischen Sprachgebrauch dienen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e92a8377-91cc-3403-92d8-b9f0da918fc6",
                        "entry_id": "ce559f22-5538-3c95-9c17-eab7e2b2dd1b",
                        "glosses": [
                            "compilierbare Programmiersprache, die nicht speziell für eine Hardware konzipiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2910f21f-91cb-47aa-8768-d32d5a29ce63",
                                "sense_id": "e92a8377-91cc-3403-92d8-b9f0da918fc6",
                                "text": "„Bei der Mikrocontroller-Programmierung ist C die mit Abstand am häufigsten verwendete Hochsprache.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccb69045-a33e-422d-87ee-3ff3ab24cdd3",
                        "source_entry_id": "ce559f22-5538-3c95-9c17-eab7e2b2dd1b",
                        "source_sense_id": "770a3894-a855-33a0-bf9e-53be19702d79",
                        "target_lang_word": "standard language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "standard language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e4fc454-c00a-367b-8e74-ade3b4da4214",
                                        "entry_id": "ecda3dd0-d272-3b28-bbbf-51a3d0148420",
                                        "glosses": [
                                            "A form of a language that is institutionally promoted, regarded as the most correct or neutral variety, and is used by a population for public and formal purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b14376-bc01-43c1-9642-ce9ed1b1363e",
                                                "sense_id": "0e4fc454-c00a-367b-8e74-ade3b4da4214",
                                                "text": "In modern standard languages, norms of usage often seem to be superimposed by prescriptive norms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e58f7f11-3802-3291-8636-2f480c579f9e",
                                        "entry_id": "ecda3dd0-d272-3b28-bbbf-51a3d0148420",
                                        "glosses": [
                                            "A language that has a standard form as one of its varieties; a language that has undergone standardization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d38aec-6109-41ca-add1-f91883a96dc3",
                                                "sense_id": "e58f7f11-3802-3291-8636-2f480c579f9e",
                                                "text": "Some remain clusters of dialects like those of the Pamirs; others are at varying levels of stabilisation; some may be young standard languages, having only recently achieved that status; [...]"
                                            },
                                            {
                                                "example_id": "b60386ba-9fd6-4896-9aa6-a9a80f2a8ab3",
                                                "sense_id": "e58f7f11-3802-3291-8636-2f480c579f9e",
                                                "text": "Not all standard languages have the backing of institutions such as the Académie française. English is a good example of a standard language without such a regulatory body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85875741-4c9e-4b33-aa97-0a9a58ea3bf8",
                        "source_entry_id": "ce559f22-5538-3c95-9c17-eab7e2b2dd1b",
                        "source_sense_id": "e92a8377-91cc-3403-92d8-b9f0da918fc6",
