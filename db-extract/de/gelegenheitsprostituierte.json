                        "glosses": [
                            "Frau, die Gelegenheitsprostitution nachgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2326a3be-35d0-4d62-8f7d-37d0a26ac845",
                                "sense_id": "d89190de-086e-33d8-b51d-bae823488484",
                                "text": "„Ich musste daran denken, dass Issler Zuhälter war, Betty eine Gelegenheitsprostituierte, und ich fragte mich, ob möglicherweise eine Verbindung zwischen ihnen bestanden haben könnte - bis mir wieder einfiel, dass die Nutten in dem kleinen schwarzen Büchlein, die ich befragt hatte, mich darüber aufgeklärt hatten, dass sie immer nur als Freischaffende gearbeitet habe.“"
                            }
                        ],
