                        "source_sense_id": "ecdfba4a-9907-34c9-bbab-1bb2f29d973b",
                        "target_lang_word": "bangmaker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
