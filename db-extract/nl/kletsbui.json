                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbd543f-6d86-434a-aed5-af8b6c894ba5",
                                "sense_id": "cfb594fa-ea05-30b6-9c42-105c3e0d90d0",
                                "text": "De telefoon stond niet stil en Donna was in een van haar kletsbuien."
                            },
                            {
                                "example_id": "ad1c2636-bcfd-4d23-a664-321de59526c6",
                                "sense_id": "cfb594fa-ea05-30b6-9c42-105c3e0d90d0",
                                "text": "Ik moest wachten tot Rayan en Jon sliepen; ze waren in een kletsbui en ik wilde niet dat iemand me het Instituut uit zag gaan."
                            },
                            {
                                "example_id": "77c8c2e5-7d99-492f-aa94-80d223bc247d",
                                "sense_id": "cfb594fa-ea05-30b6-9c42-105c3e0d90d0",
                                "text": "Als ze een van haar kletsbuien heeft, zegt ze soms wel tien keer achter elkaar dat ze er lak aan heeft dat zowat iedereen erop neerkijkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "9325743e-bf74-35ac-adc8-bf4c3ec0cce4",
                        "entry_id": "83236c96-58ab-3b07-9311-f58703e0b3cd",
                        "glosses": [
                            "kortstondige periode met harde regen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd127989-5b54-496d-b4f3-119bdc37d7f3",
                                "sense_id": "9325743e-bf74-35ac-adc8-bf4c3ec0cce4",
                                "text": "Wat hoorden ze? Een donderslag! En wat kwam daarna? Een geweldige kletsbui!"
                            },
                            {
                                "example_id": "4ff8bd11-6bf9-4d8f-a2a6-c60ae8201d77",
                                "sense_id": "9325743e-bf74-35ac-adc8-bf4c3ec0cce4",
                                "text": "We trokken uit met mooi weer, we kwamen soms thuis in kletsbuien."
                            }
                        ]
                    }
