                        "entry_id": "2a2c7634-6510-3f2c-bd7a-b0029f865ba8",
                        "glosses": [
                            "Race de chien de type Spitz, originaire de Chine, de taille moyenne, à tête large et au poil long ou court, épais et abondant."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "cd410361-c1c7-4d2e-9fd1-f3e980296d0e",
                                "sense_id": "61c38bc0-b246-3d3b-a253-619887e3dc60",
                                "text": "La langue du chow-chow est violette."
                            },
                            {
                                "example_id": "60107688-1831-4940-938b-661b67132e65",
                                "sense_id": "61c38bc0-b246-3d3b-a253-619887e3dc60",
                                "text": "Le chow-chow fait partie du groupe 5 du classement des races de chien par la société centrale canine ou SCC."
                            }
                        ]
                    }
                ],
