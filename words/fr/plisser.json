            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2fc915d2-02bf-3223-a96a-52198cd83e7e",
                    "sense_definition": "Entrefermer légèrement les yeux, notamment pour se protéger d'une lumière vive ou pour fixer son attention.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ébloui par le soleil couchant, le conducteur <w>plisse</w> les yeux pour voir la route."
                        },
                        {
                            "text": "Elle <w>plissait</w> les yeux en essayant de déchiffrer les petites lettres sur le panneau."
                        }
                    ],
                    "antonyms": [
                        "écarquiller"
                    ],
                    "common_phrases": [
                        "plisser les yeux"
                    ]
                },
                {
                    "sense_id": "5f864d84-77e7-3f63-b84b-6fa9bb710a01",
                    "sense_definition": "Former des rides ou des replis sur la peau du visage sous l'effet d'une émotion ou du vieillissement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant <w>plisse</w> le nez avec dégoût en voyant les légumes amers dans son assiette."
                        },
                        {
                            "text": "Le professeur réfléchit un instant en silence et <w>plisse</w> le front avant de répondre."
                        }
                    ],
                    "synonyms": [
                        "rider",
                        "froncer"
                    ],
                    "antonyms": [
                        "dérider",
                        "lisser"
                    ],
                    "common_phrases": [
                        "plisser le front",
                        "plisser le nez"
                    ]
                },
                {
                    "sense_id": "5f863462-9a2c-304e-ab14-5a29f4684468",
                    "sense_definition": "Former des plis réguliers et durables dans une étoffe ou une pièce de vêtement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière utilise un fer spécial pour <w>plisser</w> une jupe avec une grande précision."
                        },
                        {
                            "text": "Il faut beaucoup de savoir-faire pour <w>plisser</w> du tissu aussi fin et délicat."
                        }
                    ],
                    "antonyms": [
                        "déplisser"
                    ],
                    "common_phrases": [
                        "plisser une jupe",
                        "plisser du tissu"
                    ]
                },
                {
                    "sense_id": "2994ad6f-b1ca-3635-937b-a3edb5f4872e",
                    "sense_definition": "Avoir des plis ou former des plis, en parlant d'un tissu ou d'un vêtement porté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce pantalon est trop long pour toi, le tissu <w>plisse</w> sur tes chevilles."
                        },
                        {
                            "text": "Ces rideaux en lin très lourd <w>plissent</w> avec beaucoup d'élégance dans le salon."
                        }
                    ],
                    "synonyms": [
                        "faire des plis"
                    ]
                }
            ]
        }
    ]
