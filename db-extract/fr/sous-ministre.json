                ],
                "senses": [
                    {
                        "sense_id": "5a120187-9aa4-3979-a074-467358bd8ed0",
                        "entry_id": "454ad449-955e-3c2c-968c-6dbbca3ede1f",
                        "glosses": [
                            "Celui qui remplace un ministre principal, qui est presque ministre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "844fc89d-f583-44e9-9f09-f52dc50108bb",
                                "sense_id": "5a120187-9aa4-3979-a074-467358bd8ed0",
                                "text": "Il m’arriva, en lui parlant de MM. le Tellier, Servien et Lionne, de les nommer les trois sous-ministres ; elle releva ces mots avec aigreur en me disant : dites plutôt les deux."
                            },
                            {
                                "example_id": "aa96b244-078d-42df-9df7-1ccaf47b20d7",
                                "sense_id": "5a120187-9aa4-3979-a074-467358bd8ed0",
                                "text": "«Est-ce que le fait qu’il tombe indépendant, ça va lui garder des portes ouvertes comme il l’avait dans la machine politique qui est en place par rapport aux sous-ministres et aux ministres, ou si ça peut créer une problématique?» a demandé le maire Rioux."
                            },
                            {
                                "example_id": "64bd87f9-fec3-4a9c-ac6a-b8710d773a9d",
                                "sense_id": "5a120187-9aa4-3979-a074-467358bd8ed0",
                                "text": "L’Italie et le Canada assureront la mise en place de la Feuille de route par le biais de nos deux ministères des affaires étrangères, dans le cadre du dialogue stratégique annuel au niveau des sous-ministres lancé en 2022."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5bc1b1e-f7ca-3de2-9188-5641c8e58023",
                        "entry_id": "454ad449-955e-3c2c-968c-6dbbca3ede1f",
                        "glosses": [
                            "Secrétaire d’État."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0df88632-9da1-4201-82ff-138521c9c1dd",
                                "sense_id": "d5bc1b1e-f7ca-3de2-9188-5641c8e58023",
                                "text": "Le candidat du PS a demandé au chef de l’État s’il pouvait faire du sous-ministre du Commerce extérieur, Matthias Fekl, son directeur de campagne."
                            }
                        ]
                    }
                ],
