                "senses": [
                    {
                        "sense_id": "70d34b84-61fc-3e58-9f3f-ce2cfb97797d",
                        "entry_id": "e26d885e-e01f-3829-b2d8-fd402776e774",
                        "glosses": [
                            "federartig zerfranste Eiswolke in großer Höhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0045f91d-9570-4f7c-80dc-f9354310dda6",
                                "sense_id": "70d34b84-61fc-3e58-9f3f-ce2cfb97797d",
                                "text": "„Wenn Zirren aus einer Richtung immer zahlreicher werden, ändert sich meistens das Wetter.“"
                            },
                            {
                                "example_id": "80f8d821-c2c3-4c2e-9531-999f81319436",
                                "sense_id": "70d34b84-61fc-3e58-9f3f-ce2cfb97797d",
                                "text": "Die Kondensstreifen von hochfliegenden Flugzeugen werden zu den künstlich erzeugten Zirren gezählt."
                            },
                            {
                                "example_id": "8fd70c6d-5dd2-4972-b942-0c38aac434a5",
                                "sense_id": "70d34b84-61fc-3e58-9f3f-ce2cfb97797d",
                                "text": "„Die Umwandlung eines Kondensstreifens in einen Zirrus wurde erstmals von Gierens und Jensen (1998) mit MESOSCOP simuliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ccc319f-b985-40c9-a09f-d8e23498e553",
                        "source_entry_id": "e26d885e-e01f-3829-b2d8-fd402776e774",
                        "source_sense_id": "70d34b84-61fc-3e58-9f3f-ce2cfb97797d",
