                "senses": [
                    {
                        "sense_id": "c2b2e00b-6583-3f0a-82c5-ac9b8b083ba1",
                        "entry_id": "bafc6fe5-e8db-3e83-a360-0217394f72db",
                        "glosses": [
                            "besonderer Tag, an dem kein Börsenhandel stattfindet (wie Neujahr, Karfreitag, Weihnachtstage und so weiter)"
                        ],
                        "tags": [
                            "Börsenwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "300d0ebf-68b7-462d-a924-cb9dd2fb4518",
                                "sense_id": "c2b2e00b-6583-3f0a-82c5-ac9b8b083ba1",
                                "text": "„Der Holiday Effect, oder auch Feiertagseffekt, bezeichnet die Beobachtung signifikant höherer Renditen an Handelstagen, denen ein Börsenfeiertag folgt.“"
                            },
                            {
                                "example_id": "39a3a412-6680-4a69-a07a-2df91643ca10",
                                "sense_id": "c2b2e00b-6583-3f0a-82c5-ac9b8b083ba1",
                                "text": "„Zum einen hat sich über Nacht oder an Börsenfeiertagen meist eine größere Anzahl von Aufträgen angesammelt, die gemeinsam kostengünstiger ausgeführt werden können.“"
                            },
                            {
                                "example_id": "b74abb5b-1fc8-4cf5-842c-62337c29681c",
                                "sense_id": "c2b2e00b-6583-3f0a-82c5-ac9b8b083ba1",
                                "text": "„Laut Marktanalyst Timo Emden leistet auch das lange Wochenende den herben Verlusten Vorschub: «Gerade vor Börsenfeiertagen sind Gewinnmitnahmen verlockend», zumal die Unsicherheit hoch bleibe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
