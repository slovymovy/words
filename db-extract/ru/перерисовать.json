                "senses": [
                    {
                        "sense_id": "46610588-c1c1-3084-8f9c-541f2817e45d",
                        "entry_id": "61f3c278-8f6b-33f4-a182-2abae24deea7",
                        "glosses": [
                            "нарисовать что-либо заново; переделать рисунок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f8444c3-ed1b-4087-87ac-0e223a5730d9",
                                "sense_id": "46610588-c1c1-3084-8f9c-541f2817e45d",
                                "text": "Старуха рассердилась, прогнала живописца и велела все лица перерисовать."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dc52ba7-cb20-3f46-9afc-52d653c919aa",
                        "entry_id": "61f3c278-8f6b-33f4-a182-2abae24deea7",
                        "glosses": [
                            "нарисовать, копируя представленный образец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80bd71c8-c698-4a1d-99b9-7896a317a8be",
                                "sense_id": "2dc52ba7-cb20-3f46-9afc-52d653c919aa",
                                "text": "Прежде всего надо перерисовать чертёж и положить его на место."
                            },
                            {
                                "example_id": "bb63b62c-0bfe-4994-8027-0cbf7548bc2e",
                                "sense_id": "2dc52ba7-cb20-3f46-9afc-52d653c919aa",
                                "text": "Мне поручили нарисовать (вернее, перерисовать из журнала) портрет Сталина для стенной газеты."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2b6a0f7-a60f-3407-b00e-46ec173ad66b",
                        "entry_id": "61f3c278-8f6b-33f4-a182-2abae24deea7",
                        "glosses": [
                            "разг. нарисовать, зарисовать всё или многое, всех или многих"
                        ],
