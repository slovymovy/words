            {
                "entry_id": "a847c899-29fe-30e3-b4ad-a74a51324ee1",
                "word": "Koine",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8d294629-734d-3ce3-aaab-726019347ca5",
                        "entry_id": "a847c899-29fe-30e3-b4ad-a74a51324ee1",
                        "glosses": [
                            "The “common” Greek language that developed and flourished between 300 B.C.E. and 300 C.E. (the time of the Roman Empire), and from which Modern Greek descended. It was based on the Attic and Ionian dialects of Ancient Greek."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1d3634e-9ec0-49e0-97e2-53cb440c31e7",
                        "source_entry_id": "a847c899-29fe-30e3-b4ad-a74a51324ee1",
                        "source_sense_id": "8d294629-734d-3ce3-aaab-726019347ca5",
                        "source_sense_description": "common Greek language",
                        "target_lang_word": "koiné",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8ee88b8e-7e11-44c8-9d71-098996ce86da",
                        "source_entry_id": "a847c899-29fe-30e3-b4ad-a74a51324ee1",
                        "source_sense_id": "8d294629-734d-3ce3-aaab-726019347ca5",
                        "source_sense_description": "common Greek language",
                        "target_lang_word": "Koinè",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koinè",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd57da70-98f0-31e1-bbac-e57614c7d5fb",
                                        "entry_id": "c628bcb4-24cf-3daf-ad6f-f7889a557a14",
                                        "glosses": [
                                            "Oudgrieks dat vanaf de 4e eeuw vóór tot de 15e eeuw ná Christus voertaal in het oostelijke Middellandse Zeegebied was"
                                        ],
                                        "tags": [
                                            "linguistics",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e2ecfc3-c4b9-408c-8e47-561c02b3a609",
                                                "sense_id": "cd57da70-98f0-31e1-bbac-e57614c7d5fb",
                                                "text": "Er bestaan ook goede Nederlandse woordenboeken, bijv. van klassiek Grieks waar ook het Koine is in verwerkt."
                                            },
                                            {
                                                "example_id": "f3b20c65-b936-4512-99c8-cb2c967b2dd1",
                                                "sense_id": "cd57da70-98f0-31e1-bbac-e57614c7d5fb",
                                                "text": "De nieuwe christelijke leer - die religieus een parvenu was - ging er in zekere zin dus vandoor met het Hebreeuwse Oude Testament, maar liet dit uitmonden in een nieuwe taal, het Koine-Grieks. Maar dat Koine was alleen de taal van het oostelijk deel van het Romeinse rijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8806f1a9-7351-4894-9b0c-4f15882ca7b1",
                        "source_entry_id": "a847c899-29fe-30e3-b4ad-a74a51324ee1",
                        "source_sense_id": "8d294629-734d-3ce3-aaab-726019347ca5",
                        "source_sense_description": "common Greek language",
                        "target_lang_word": "koinè",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koinè",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec801291-458f-3c9f-a11e-9eccaa966261",
                                        "entry_id": "bf477a79-0488-3083-ab31-7b28464ec17f",
                                        "glosses": [
                                            "Grec ancien normalisé à l’époque hellénistique, commun à la Grèce puis au monde antique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b99c3f2e-67ed-40a5-ad71-e9d295a06967",
                                                "sense_id": "ec801291-458f-3c9f-a11e-9eccaa966261",
                                                "text": "La koinè est devenue langue officielle de l’Empire romain d’Orient, avant de continuer d’évoluer pour donner naissance au grec moderne d’aujourd’hui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e1ed0b-a4e1-3932-9513-c5facb3ae63e",
                                        "entry_id": "bf477a79-0488-3083-ab31-7b28464ec17f",
                                        "glosses": [
                                            "Lingua franca, langue commune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c268182e-7549-4225-8fff-14b42da685af",
                                                "sense_id": "f1e1ed0b-a4e1-3932-9513-c5facb3ae63e",
                                                "text": "Le plateau iranien de cette période [proto-élamite] voit se former une sorte de koinè : toutes les différentes cultures qui émergent entretiennent des liens entre elles, et les influences réciproques sont fortes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35336839-b702-432f-8e3e-df7c46fdaf69",
                        "source_entry_id": "a847c899-29fe-30e3-b4ad-a74a51324ee1",
                        "source_sense_id": "8d294629-734d-3ce3-aaab-726019347ca5",
                        "source_sense_description": "common Greek language",
                        "target_lang_word": "Koine",
                        "target_lang_code": "de",
