                    {
                        "form_id": "9e417731-7009-45d3-9568-a8720e7ad992",
                        "entry_id": "7ad895ae-ea52-3f8d-a550-83955c670933",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Raufbolde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6d959ed-4d0b-3816-a975-ebed0d537f6c",
                        "entry_id": "7ad895ae-ea52-3f8d-a550-83955c670933",
                        "glosses": [
                            "jemand, der gerne und oft rauft"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "cfd9ca3c-ead0-4366-b941-f3e6e5b2929d",
                                "sense_id": "e6d959ed-4d0b-3816-a975-ebed0d537f6c",
                                "text": "„Ein Soldat, ein scheinbar unverbesserlicher Raufbold, hatte vor niemandem Respekt.“"
                            },
                            {
                                "example_id": "c285a5d9-2c16-4794-a86d-4bb4afe385e5",
                                "sense_id": "e6d959ed-4d0b-3816-a975-ebed0d537f6c",
                                "text": "„Rostow fuhr voraus, um diesen Auftrag auszuführen, und sah zu seinem grössten Erstaunen, dass Dolochow, dieser Kampfhahn und Raufbold Dolochow, in Moskau mit seiner alten Mutter und seiner buckligen Schwester zusammen lebte und der zärtlichste Sohn und Bruder war.“"
                            },
                            {
                                "example_id": "7ffd3f87-27a9-4074-91fb-9ad7cf7e0f89",
                                "sense_id": "e6d959ed-4d0b-3816-a975-ebed0d537f6c",
                                "text": "„Bei ihrem Anblick stieß der tapfere Raufbold einen Fluch aus und entfloh nach der einen Seite, ich nach der anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed500335-3285-4ac5-a4a4-232115f34361",
                        "source_entry_id": "7ad895ae-ea52-3f8d-a550-83955c670933",
                        "source_sense_id": "e6d959ed-4d0b-3816-a975-ebed0d537f6c",
                        "source_sense_description": "abwertend: jemand, der gerne und oft rauft",
                        "target_lang_word": "brawler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brawler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af1a63ec-fb29-3904-9504-dc109eb61d32",
                                        "entry_id": "5c133c85-32c6-3e73-a1d2-9aad5df6258f",
                                        "glosses": [
                                            "One who brawls, engages in noisy, unseemly fights."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c92286d3-0167-4149-8cfe-26cc71845d5f",
                                                "sense_id": "af1a63ec-fb29-3904-9504-dc109eb61d32",
                                                "text": "The world hath noted. And your name is great\nIn mouthes of wiſeſt Cenſure. What's the matter\nThat you vnlace your reputation thus,\nAnd ſpend your rich opinion, for the name\nOf a night-brawler? Giue me anſwer to it."
                                            },
                                            {
                                                "example_id": "c2873bb5-b49e-4e3d-882b-6102511b5611",
                                                "sense_id": "af1a63ec-fb29-3904-9504-dc109eb61d32",
                                                "text": "A Biſhop then muſt be blameleſſe, the huſband of one wife, vigilant, ſober, of good behauiour, giuen to hoſpitalitie, apt to teach;\nNot giuen to wine, no ſtriker, not greedy of filthy lucre, but patient, not a brawler, not couetous;\nOne that ruleth well his owne houſe, hauing his children in ſubiection with all grauitie.\n(For if a man know not how to rule his owne houſe, how ſhall he take care of the Church of God?)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "385439e8-6fa4-31ff-ae69-b983d099b9f8",
                                        "entry_id": "5c133c85-32c6-3e73-a1d2-9aad5df6258f",
                                        "glosses": [
                                            "A beat 'em up game."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ebf418e-93dd-45a2-835e-4466b318e7fd",
                                                "sense_id": "385439e8-6fa4-31ff-ae69-b983d099b9f8",
                                                "text": "\"Classic brawlers ranging from Double Dragon to Streets of Rage and even Brutal Legend created my initial seed of interest for working on one,\" Deighan said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2b592fe-2224-4f90-9d22-0bd37ec2528a",
                        "source_entry_id": "7ad895ae-ea52-3f8d-a550-83955c670933",
                        "source_sense_id": "e6d959ed-4d0b-3816-a975-ebed0d537f6c",
                        "source_sense_description": "abwertend: jemand, der gerne und oft rauft",
                        "target_lang_word": "хулиган",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хулиган",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b8c956c1-5395-372e-9970-324b1c2743ba",
                                        "entry_id": "a10fad7d-3c34-3457-bb77-a72a59272e87",
                                        "glosses": [
                                            "человек, грубо нарушающий общественный порядок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8f50eb-83ae-41ee-8235-fc6eb604d18e",
                                                "sense_id": "b8c956c1-5395-372e-9970-324b1c2743ba",
                                                "text": "— Кажется, у вас хулиган вырвал сумочку, — тихо сказала Лиза, — развелось их теперь, никого не боятся."
                                            },
                                            {
                                                "example_id": "b3e2e021-1f9c-45fe-bb74-587e17fbccb8",
                                                "sense_id": "b8c956c1-5395-372e-9970-324b1c2743ba",
                                                "text": "Одного слабого человека, одетого в старосолдатскую шинель, торговка булками загнала в мочевую лужу около отхожего места и стегала его по лицу тряпкой; на помощь торговке сразу появился кочующий хулиган и сразу разбил в кровь лицо ослабевшего человека, свалившегося под отхожий забор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae79bc4a-b9db-3bc6-9d75-af0ab23ad47a",
                                        "entry_id": "a10fad7d-3c34-3457-bb77-a72a59272e87",
                                        "glosses": [
                                            "разг. перен. ребёнок, не нарушающий общественный порядок, но доставляющий своим родителям неудобства своим поведением"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "хулиган",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e83d1bef-584b-323f-a93f-fdd22a048f61",
                                        "entry_id": "99ea08a7-303f-3781-a5bf-bcefa6c76c86",
                                        "glosses": [
                                            "спец. пожарный и спасательный ручной лом для вскрытия дверей и разборки конструкций, с одной стороны заканчивающийся вилкой-гвоздодёром, а с другой — головкой с теслом и шипом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e9d234e-7b4f-4c29-9a91-1c6281a4ccdd",
                                                "sense_id": "e83d1bef-584b-323f-a93f-fdd22a048f61",
                                                "text": "В руках Михаила Тихонова (слева) пожарный «хулиган» — это, по сути, лом, которым можно вскрывать замки, если на пожаре заблокировало двери."
                                            },
                                            {
                                                "example_id": "289bcd35-19cc-40e3-a6f3-7af5a64a9ba6",
                                                "sense_id": "e83d1bef-584b-323f-a93f-fdd22a048f61",
                                                "text": "Бак тестомешалки удалось отжать не сразу. Как пояснили в сахалинском региональном отделении «Россоюзспаса», он поддался ручному аварийно-спасательному инструменту, так называемому хулигану."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14101fd2-3006-4fc2-b87a-69fce4a9c478",
                        "source_entry_id": "7ad895ae-ea52-3f8d-a550-83955c670933",
                        "source_sense_id": "e6d959ed-4d0b-3816-a975-ebed0d537f6c",
                        "source_sense_description": "abwertend: jemand, der gerne und oft rauft",
                        "target_lang_word": "драчун",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "драчун",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6001a091-2f29-3704-a429-1c552112267e",
                                        "entry_id": "219bf255-16c7-3409-8dd1-783f6e0bf662",
                                        "glosses": [
                                            "разг. тот, кто любит драться, часто дерётся"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "789ca4e7-1a07-47e0-ac92-5630ea896923",
                                                "sense_id": "6001a091-2f29-3704-a429-1c552112267e",
                                                "text": "Какое скромные! Драчуны, самый буйный народ. Охота же вам быть прибитой на другой день после свадьбы."
                                            },
                                            {
                                                "example_id": "a9df7064-7abd-4f65-bf33-47d8eaac9683",
                                                "sense_id": "6001a091-2f29-3704-a429-1c552112267e",
                                                "text": "Забияка Колька, первый драчун, был сын прачки; побитая им Анютка ― дочь сапожника, жившего в подвале."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
