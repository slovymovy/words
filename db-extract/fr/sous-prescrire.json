                ],
                "senses": [
                    {
                        "sense_id": "f5d6c245-ba1f-3e58-8bb8-4bf07a202f67",
                        "entry_id": "f8ee9c7e-ea3a-3045-9895-4a4a6ecd03c5",
                        "glosses": [
                            "Prescrire insuffisamment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63e0a05b-2ca6-44a3-bfac-fd7a3a99962f",
                                "sense_id": "f5d6c245-ba1f-3e58-8bb8-4bf07a202f67",
                                "text": "Optimiser les traitements c'est donc, dans le meilleur sens du terme, éviter de sur-prescrire, mais aussi de sous-prescrire."
                            },
                            {
                                "example_id": "c6454a15-d0e9-4feb-9d6f-b94129c030ca",
                                "sense_id": "f5d6c245-ba1f-3e58-8bb8-4bf07a202f67",
                                "text": "Médecins et infirmières ont tendance à sous-prescrire les morphiniques par crainte des effets secondaires respiratoires."
                            },
                            {
                                "example_id": "48243581-d8e7-4a22-9da3-c3a72b3f5bfa",
                                "sense_id": "f5d6c245-ba1f-3e58-8bb8-4bf07a202f67",
                                "text": "Une tendance était notée parmi les praticiens à l'exception des endocrinologues de sous-prescrire l'insuline."
                            }
                        ]
                    }
                ],
