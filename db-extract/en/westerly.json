                            "superlative"
                        ],
                        "form": "most westerly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e3879ad-2335-3419-9f88-9959cf0582aa",
                        "entry_id": "5c3831a4-41fa-32fa-8ac2-1ac94f514cea",
                        "glosses": [
                            "Facing the west; directed towards the west."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e136e3ea-16ed-44ce-a08c-563aacc97793",
                                "sense_id": "0e3879ad-2335-3419-9f88-9959cf0582aa",
                                "text": "a westerly course or voyage"
                            },
                            {
                                "example_id": "43bedc2f-7f0a-4465-848d-4e2f59eb9616",
                                "sense_id": "0e3879ad-2335-3419-9f88-9959cf0582aa",
                                "text": "Tall, blue-eyed, this proud and stubborn Genoese seaman first visited Portugal, proposing his scheme for a westerly voyage in search of the Indies."
                            }
                        ]
                    },
                    {
                        "sense_id": "080a5b9b-ef40-34f3-b098-ec7cea2f8ae7",
                        "entry_id": "5c3831a4-41fa-32fa-8ac2-1ac94f514cea",
                        "glosses": [
                            "Located towards or in the west."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0997f2b3-ac5b-4b69-893d-4cfb5fd4dc28",
                                "sense_id": "080a5b9b-ef40-34f3-b098-ec7cea2f8ae7",
                                "text": "the westerly side of a lake"
                            },
                            {
                                "example_id": "9030f016-9bd1-4f49-a904-e83f69e72918",
                                "sense_id": "080a5b9b-ef40-34f3-b098-ec7cea2f8ae7",
                                "text": "The head of the North Tyne is reached at Deadwater, 36 miles from Hexham. The river has its source just on the English side of the Border, at the foot of Peel Fell, the most westerly spur of the Cheviots. At first it is a sluggish stream (hence the name Deadwater) but begins to flow more swiftly before it reaches Kielder."
                            }
                        ]
                    },
                    {
                        "sense_id": "3784785d-ea4d-3fc4-bfd4-7fcca281f95c",
                        "entry_id": "5c3831a4-41fa-32fa-8ac2-1ac94f514cea",
                        "glosses": [
                            "Coming from the west."
                        ],
                        "tags": [
                            "of wind"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6dab64-0515-42ad-9961-7479fdaa40d5",
                                "sense_id": "3784785d-ea4d-3fc4-bfd4-7fcca281f95c",
                                "text": "a westerly wind"
                            },
                            {
                                "example_id": "ef3b6c02-f60b-4a5b-bfb3-c0bfb23470bc",
                                "sense_id": "3784785d-ea4d-3fc4-bfd4-7fcca281f95c",
                                "text": "Don’t be so darn foolish. It’s the calm afore the storm, Winslow. She were a gentle westerly wind yer cursin’. Only feels roughly ‘cause you don’t know nothin’ bout nothin’ and there ain’t no trees on this here rock like your Hudson Bay bush. Nor’Easterly wind’ll come soon a-blowin’ like Gabriel’s horn. Best board up them signal house winders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "017ccfcd-b668-426a-9e49-fefd998f24ee",
                        "source_entry_id": "5c3831a4-41fa-32fa-8ac2-1ac94f514cea",
                        "source_sense_description": "to/from the west",
                        "target_lang_word": "westlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "westlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "156a6f1d-3de6-3969-8252-c4de084df21f",
                                        "entry_id": "068b004a-4520-346e-915e-d71aa56c2aa3",
                                        "glosses": [
                                            "auf den Westen, auf West bezogen, in der Richtung des Westens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f05987-24b7-4d2a-883a-dbe58a99ff7f",
                                                "sense_id": "156a6f1d-3de6-3969-8252-c4de084df21f",
                                                "text": "A liegt westlich von B."
                                            },
                                            {
                                                "example_id": "3352bb13-be4e-43bd-80a6-44d415efc6df",
                                                "sense_id": "156a6f1d-3de6-3969-8252-c4de084df21f",
                                                "text": "„Auf dem Gelände der kaiserlichen Gardetruppen, deren Kaserne er abzureißen befahl, ließ Konstantin die Lateranbasilika errichten, die sich im Laufe der Jahrhunderte als Mittelpunkt der westlichen Christenheit behaupten sollte.“"
                                            },
                                            {
                                                "example_id": "8c7218c8-ceb8-4a25-bf65-a49a31a8f338",
                                                "sense_id": "156a6f1d-3de6-3969-8252-c4de084df21f",
                                                "text": "„Sie ist landschaftlich westlicher, man möchte ruhig sagen: französischer als alle.“"
                                            },
                                            {
                                                "example_id": "4f992bb2-cbe4-4f5a-9f27-27be6aeb4f6c",
                                                "sense_id": "156a6f1d-3de6-3969-8252-c4de084df21f",
                                                "text": "„Palenque ist die westlichste große Maya-Stadt.“"
                                            },
                                            {
                                                "example_id": "f689a0e4-3689-4daf-8706-be641d082933",
                                                "sense_id": "156a6f1d-3de6-3969-8252-c4de084df21f",
                                                "text": "„Eindringlich wies Lennart Meri auf die Gefahr der russischen Großmachtfantasien hin – und verurteilte die vorherrschende westliche Appeasement-Politik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "westlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d481893-6b59-31f6-9471-7a439658003a",
                                        "entry_id": "d685e0c8-6713-3372-bd32-7261d9e28836",
                                        "glosses": [
                                            "(an einer Stelle) im Westen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c5263c-5d18-4715-85cb-663b440b787a",
                                                "sense_id": "1d481893-6b59-31f6-9471-7a439658003a",
                                                "text": "Etwas weiter westlich gibt es eine sehr schöne Bergkette."
                                            },
                                            {
                                                "example_id": "c1a19adb-d828-4c7c-8cc3-df032ec1818b",
                                                "sense_id": "1d481893-6b59-31f6-9471-7a439658003a",
                                                "text": "So weit westlich wie hier wart ihr noch nie, oder?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "westlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "666d062f-2008-39fc-8828-b05bd6194523",
                                        "entry_id": "d346172c-7cb0-3dac-bbb7-4da291854d81",
                                        "glosses": [
                                            "an einer Stelle, die sich von etwas Bestimmtem aus weiter in Richtung Westen befindet"
                                        ],
                                        "tags": [
                                            "mit Genitiv oder",
                                            "wenn das nachfolgende Wort üblicherweise ohne Artikel steht",
                                            "in Verbindung mit der Präposition „von“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82914570-419e-4359-9d40-ac8849312db4",
                                                "sense_id": "666d062f-2008-39fc-8828-b05bd6194523",
                                                "text": "Westlich der Stadt Aachen haben wir schlussendlich unser Traumgrundstück gefunden."
                                            },
                                            {
                                                "example_id": "cbdc3962-7eba-4ecf-9d74-41beae30e64f",
                                                "sense_id": "666d062f-2008-39fc-8828-b05bd6194523",
                                                "text": "Die Reisegruppe hat nun ihr Etappenziel westlich der brandenburgischen Landeshauptstadt erreicht."
                                            },
                                            {
                                                "example_id": "fd4bed6d-0924-4792-a73f-13e3aef607d5",
                                                "sense_id": "666d062f-2008-39fc-8828-b05bd6194523",
                                                "text": "In den Regionen westlich des Rheins habe ich schon viele gastfreundliche Leute kennen gelernt."
                                            },
                                            {
                                                "example_id": "6404b680-121f-4c2b-9c6b-2e6e625c3118",
                                                "sense_id": "666d062f-2008-39fc-8828-b05bd6194523",
                                                "text": "Hast du schon Lokale westlich von Nürnberg besucht?"
                                            },
                                            {
                                                "example_id": "c0340120-1156-4fe0-9225-92e86a8872c3",
                                                "sense_id": "666d062f-2008-39fc-8828-b05bd6194523",
                                                "text": "Gertrudes Gehöft liegt westlich von Hildesheim."
                                            },
                                            {
                                                "example_id": "3ca86fb6-1d56-4822-99d2-692e9f61942d",
                                                "sense_id": "666d062f-2008-39fc-8828-b05bd6194523",
                                                "text": "Westlich von hier finden Sie ein Plateau, von dem aus Sie die ganze Gegend überblicken können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
