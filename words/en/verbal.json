                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "police_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant claimed he had been <w>verballed</w> by the arresting officers.",
                            "target_lang_translations": {
                                "ru": "Подсудимый заявил, что арестовавшие его офицеры <w>приписали ему ложные показания</w>.",
                                "zh": "被告声称逮捕他的警官<w>伪造供词</w>陷害他。",
                                "es": "El acusado afirmó que los oficiales que lo arrestaron <w>habían fabricado su confesión</w>."
                            }
                        },
                        {
                            "text": "Lawyers argued that the police had <w>verballed</w> the suspect to secure a conviction.",
                            "target_lang_translations": {
                                "ru": "Адвокаты утверждали, что полиция <w>сфальсифицировала признание</w> подозреваемого, чтобы добиться обвинительного приговора.",
                                "zh": "律师辩称，警方为了定罪而<w>伪造供词</w>。",
                                "es": "Los abogados argumentaron que la policía <w>había falsificado la confesión</w> del sospechoso para asegurar una condena."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "UK, Australia"
