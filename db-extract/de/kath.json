                                    {
                                        "sense_id": "01985811-457b-329a-aa2c-eb42601a5094",
                                        "entry_id": "b7680386-d8fd-33f4-861d-b56a2880b08a",
                                        "glosses": [
                                            "Alternative form of khat, a psychoactive stimulant obtained from the plant Catha edulis."
                                        ],
