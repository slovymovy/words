                                        "entry_id": "a5d34df9-cbb9-3f80-af9e-f0cb55ca7f90",
                                        "glosses": [
                                            "Binnendüne in der Form eines Bogens oder einer Sichel"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b3a086-a380-453e-ae06-896037cc2737",
                                                "sense_id": "7d4262cb-24a3-32b3-b69d-1dbd3517a5f4",
                                                "text": "„Es gibt Zungendünen, Embryonaldünen, Urdünen und halbmondförmige Barchanen, Barchanoide und Parabeldünen, Kissendünen und Vordünen, Weißdünen und Binnendünen, erfährt der Besucher im \"Skagen Odde Naturcenter\".“"
                                            }
