                    },
                    {
                        "form_id": "20fa822b-7965-442d-89cd-36fdda0d50b8",
                        "entry_id": "da2d59a1-9fb5-3b51-97d8-5d583762198f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Votivtiere"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f90c0ed-b80a-3107-82c6-722dd39bcc26",
                        "entry_id": "da2d59a1-9fb5-3b51-97d8-5d583762198f",
                        "glosses": [
                            "eine künstlerische Tiergestalt, deren Größe nicht genormt ist, das für das Votiv des Votanten steht; Votation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a238ac04-f6d5-4ad5-a399-cd8fc59c6e10",
                                "sense_id": "4f90c0ed-b80a-3107-82c6-722dd39bcc26",
                                "text": "„Und wie seine Vorfahren schmiedet auch er weiterhin kleine Votivtiere, die Gläubige als Opfergaben, etwa bei Kirchenpatrozinien, verwenden.“"
                            },
                            {
                                "example_id": "91d7aa3d-e9db-4c86-85fe-dc27e1e07795",
                                "sense_id": "4f90c0ed-b80a-3107-82c6-722dd39bcc26",
                                "text": "„Am 11. August wird Museumsleiter Rainer Weileder um 17 Uhr die Objekte \"zum Sprechen bringen\" - die Votivtiere der Hetzenbacher Wallfahrt oder den hl. Eligius, der nicht nur Patron der Goldschmiede war, sondern auch der Hufschmiede.“"
                            },
                            {
                                "example_id": "79dffac2-956c-4fa4-ac88-99cbc9df6db5",
                                "sense_id": "4f90c0ed-b80a-3107-82c6-722dd39bcc26",
                                "text": "„Zahlreiche eiserne Votivtiere zeugen von der Gläubigkeit der Menschen im Mittelalter.“"
                            },
                            {
                                "example_id": "40294b9b-e685-48c3-b34e-88578897d857",
                                "sense_id": "4f90c0ed-b80a-3107-82c6-722dd39bcc26",
                                "text": "„Für jedes Votivtier erhielt man zudem ein schönes farbiges Wollband, mit dem der erkaufte Segen dem draußen wartenden Tier angeheftet werden konnte, ehe es dreimal feierlich um die Kirche geritten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
