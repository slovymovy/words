                        "examples": [
                            {
                                "example_id": "ba7fe553-2c7e-4fb0-96cc-8656ce57eed0",
                                "sense_id": "43af15fd-587a-3100-a990-26ac5d98d7e2",
                                "text": "On sait que, depuis quelque temps, il existe dans la marine russe des navires cuirassés d'un nouveau type, les popoffkas, ainsi appelés du nom de leur inventeur, le vice-amiral Popoff ; les popoffkas sont des vaisseaux cuirassés de forme circulaire destinés à la défense des côtes."
                            },
                            {
                                "example_id": "34e1a178-019f-4bc9-91cc-e0f4ca531039",
                                "sense_id": "43af15fd-587a-3100-a990-26ac5d98d7e2",
                                "text": "Premières expériences du tir des canons gigantesques dont est armée la popovka Novgorod."
                            }
                        ]
