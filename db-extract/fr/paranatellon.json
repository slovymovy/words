                        "entry_id": "3da7de45-1107-315c-b219-17289fd91dfc",
                        "glosses": [
                            "Astre ou constellation se levant au moment où le soleil entrait dans l'un des signes du zodiaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144fbdde-6f5b-4176-8bd3-f4c6392682ff",
                                "sense_id": "a72ca098-2b15-3772-9e4a-500d34771136",
                                "text": "Les paranatellons étaient encore les astres ou constellations qui se levaient lorsque les signes se couchaient, ou qui se couchaient lorsque les signes se levaient."
                            },
                            {
                                "example_id": "23b999b3-64c6-46f8-89e8-71a459d7905a",
                                "sense_id": "a72ca098-2b15-3772-9e4a-500d34771136",
                                "text": "Ces diverses observations servirent à construire les tables des paranatellons, qui furent d’un usage très-répandu dans l’antiquité, et qui servirent de base à tous les calendriers des anciens."
                            }
                        ]
                    }
                ],
