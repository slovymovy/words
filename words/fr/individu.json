                    ],
                    "synonyms": [
                        "spécimen",
                        "être vivant"
                    ],
                    "common_phrases": [
                        "individu adulte",
                        "individu d'une espèce"
                    ]
                },
                {
                    "sense_id": "1b69734b-ca57-3181-a365-737b3b40e9af",
                    "sense_definition": "Élément de base ou unité élémentaire d'une population faisant l'objet d'une observation statistique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>individu</w> statistique est décrit par un ensemble précis de variables quantitatives."
                        },
                        {
                            "text": "L'enquête porte sur un échantillon représentatif de cinq cents <w>individus</w> tirés au sort."
                        }
                    ],
                    "synonyms": [
                        "unité"
                    ],
                    "common_phrases": [
                        "individu statistique"
                    ]
                },
                {
                    "sense_id": "93690aac-4c0c-30c6-940e-78cafc9d26c2",
                    "sense_definition": "Entité autonome indivisible constituant une réalité singulière et irréductible.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon ce philosophe, l'<w>individu</w> ne peut être décomposé sans perdre sa nature propre."
                        },
                        {
                            "text": "La notion d'<w>individu</w> pose la question de l'identité et de la conscience de soi."
                        }
                    ],
                    "synonyms": [
                        "entité"
                    ]
                }
            ]
        }
