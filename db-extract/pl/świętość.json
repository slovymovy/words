                "senses": [
                    {
                        "sense_id": "804eb168-55ab-3874-8eff-b8c540c2d63a",
                        "entry_id": "01ff4897-e17a-3ee4-91a6-15efae06ae01",
                        "glosses": [
                            "coś otaczane szczególnym kultem i czcią"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c755175-6787-4c88-9b5a-273849ca84e4",
                                "sense_id": "804eb168-55ab-3874-8eff-b8c540c2d63a",
                                "text": "Dla wielu ludzi wiara jest świętością."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "52039bbd-6169-3ed3-959f-6889f2e1f09e",
                        "entry_id": "01ff4897-e17a-3ee4-91a6-15efae06ae01",
                        "glosses": [
                            "cecha tego co święte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94725b43-6dbd-40d2-9066-bfe29ee6339c",
                                "sense_id": "52039bbd-6169-3ed3-959f-6889f2e1f09e",
                                "text": "Szwedzi nie uszanowali świętości tego miejsca."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7cd324d-eb21-45e2-9748-f152e789378a",
                        "source_entry_id": "01ff4897-e17a-3ee4-91a6-15efae06ae01",
                        "source_sense_id": "804eb168-55ab-3874-8eff-b8c540c2d63a",
                        "target_lang_word": "holiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "755196a6-e8ab-3373-a7ae-30c187c5ce82",
                                        "entry_id": "44294510-f9f2-32c7-99f1-9d12b02a0bac",
                                        "glosses": [
                                            "The state or condition of being holy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e5f7cad-e989-4451-b45f-ba5a51ff241a",
                                                "sense_id": "755196a6-e8ab-3373-a7ae-30c187c5ce82",
                                                "text": "R. Moskowitz charges cisgender readers to be as conscious and deliberate with our religious identities as transgender and gender non-conforming people are with theirs, arguing that holiness is only achieved through continuous and unrelenting struggle and change."
                                            },
                                            {
                                                "example_id": "e76812be-72d6-4e76-90b2-aa870b2d7391",
                                                "sense_id": "755196a6-e8ab-3373-a7ae-30c187c5ce82",
                                                "text": "“Through the Sacraments, God shares his holiness with us so that we, in turn, can make the world holier,” the conference says on its website."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a34e554-b96a-4fda-9b61-fa9bbe1e3dfb",
                        "source_entry_id": "01ff4897-e17a-3ee4-91a6-15efae06ae01",
                        "source_sense_id": "804eb168-55ab-3874-8eff-b8c540c2d63a",
                        "target_lang_word": "Heiligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f08eb201-4531-3ba3-baf0-bbc568a9ab0a",
                                        "entry_id": "2fab779e-ee4c-38ff-b7e5-52721199bf62",
                                        "glosses": [
                                            "Eigenschaft, heilig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "805e9821-5751-4c07-a239-38d623645a51",
                                                "sense_id": "f08eb201-4531-3ba3-baf0-bbc568a9ab0a",
                                                "text": "„Hier hat das Wort seine ursprüngliche Bedeutung, und der Bibelvers, der die Heiligkeit Gottes bezeugt, ist ein fester Bestandteil der jüdischen Liturgie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00a22165-d48f-379b-b4e4-0625c962b1ce",
                                        "entry_id": "2fab779e-ee4c-38ff-b7e5-52721199bf62",
                                        "glosses": [
                                            "etwas/Wesen, das die Eigenschaft [1] aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c09f7c7c-ee3c-47bc-943f-94fff0953e55",
                                                "sense_id": "00a22165-d48f-379b-b4e4-0625c962b1ce",
                                                "text": "„Das Buch über die Obelisken von Rom hat der Hein auf dringenden Wunsch Seiner Eminenz Kardinal Tisserant geschrieben und durfte es nach Erscheinen auf dessen Fürsprache persönlich seiner Heiligkeit Papst Paul VI. überreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
