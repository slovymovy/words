                                "target_senses": [
                                    {
                                        "sense_id": "d4318932-fd00-30dd-93a2-16bbf7eaa360",
                                        "entry_id": "6d691649-500e-372d-b503-87c2ba5dfcf6",
                                        "glosses": [
                                            "A haircut where the hair is cut short on the sides and back and allowed to grow long on the top, as though only the hair not covered by an inverted bowl had been removed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11c5cf1e-196d-41c8-9e05-70de9159917a",
                        "source_entry_id": "13473172-46a7-379e-87ea-6ffe0677f881",
                        "source_sense_id": "0a453304-f395-38e7-aa82-24dae3e73ab1",
                        "target_lang_word": "coupe au bol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coupe au bol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38954fae-26a9-36a0-b16e-a12b468e9da5",
                                        "entry_id": "14f85ef4-5041-34a1-992e-fb12f5731821",
                                        "glosses": [
                                            "Coiffure recouvrant les oreilles sur les côtés, de même longueur derrière, et arrivant juste au dessus des yeux devant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72330ead-f30d-4fcf-9c14-da9b09d315bd",
                                                "sense_id": "38954fae-26a9-36a0-b16e-a12b468e9da5",
                                                "text": "Personne ne nous dit de la boucler, pourtant – même pas la dame avec la coupe au bol qui n'arrête pas de nous mater. Je lui adresse un petit signe de la main accompagné d'un sourire mielleux."
                                            },
                                            {
                                                "example_id": "b82fa31f-e16e-40dc-880b-e69f185aebaf",
                                                "sense_id": "38954fae-26a9-36a0-b16e-a12b468e9da5",
                                                "text": "Ils portaient ce genre de tenues, expliqua-t-il. C'était l'un des premiers groupes à avoir les cheveux longs. Pas des coupes au bol comme les Beatles, mais carrément des catogans."
                                            }
                                        ]
                                    }
                                ]
                            }
