                        "examples": [
                            {
                                "example_id": "ef630f9a-b573-4f06-8ad7-bddcddda88dd",
                                "sense_id": "ff174a4c-c0b9-3b3b-a486-071feed240fd",
                                "text": "The bogies are built up of welded sub-units which are stress-relieved before assembly by riveting."
                            },
                            {
                                "example_id": "bb6af875-8f89-4afe-ba2d-61f3ac6d8cc0",
                                "sense_id": "ff174a4c-c0b9-3b3b-a486-071feed240fd",
                                "text": "Interchange manipulation comparisons showed that all subunits are still active, if at slightly lower rates."
                            },
                            {
                                "example_id": "f6b6bf75-886b-4750-aac4-92ed65042f3c",
                                "sense_id": "ff174a4c-c0b9-3b3b-a486-071feed240fd",
                                "text": "UMISEA is a subunit in Hololive featuring idols with nautical themes. The group debuted in 2021 as the first JP+EN collab subunit. Chloe was added to the roster after holox debuted."
                            }
                        ]
                    },
