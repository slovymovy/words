                "senses": [
                    {
                        "sense_id": "f4bd491c-bec4-3c59-b80b-a5060c8db8d6",
                        "entry_id": "cb66345c-d07a-385f-a03f-a2f93ec94313",
                        "glosses": [
                            "Vorrichtung aus zwei Spulen, die elektrische Energie transformiert, das heißt ihre charakteristische Größe Spannung so ändert, dass Hochspannung am Ausgang entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a559c3d-6b16-4d92-a1e6-18b48afae562",
                                "sense_id": "f4bd491c-bec4-3c59-b80b-a5060c8db8d6",
                                "text": "„Mit einem Hochspannungstransformator können Wechselspannungen umgewandelt werden, sodass eine Hochspannung am Ausgang entsteht, die einem Vielfachen der Eingangsspannung entspricht.“"
                            },
                            {
                                "example_id": "d0d6190d-31a6-4476-9e92-0de003ead493",
                                "sense_id": "f4bd491c-bec4-3c59-b80b-a5060c8db8d6",
                                "text": "„Beim Hochspannungstransformator hat die Sekundärspule ( n2 = 12.000, linke Seite) deutlich mehr Windungen als die Primärspule ( n1 = 600, rechte Seite).“"
                            },
                            {
                                "example_id": "496f9e02-9372-47cd-821b-d5228bd09e2d",
                                "sense_id": "f4bd491c-bec4-3c59-b80b-a5060c8db8d6",
                                "text": "„In diesem Versuchsvideo ist ein Hochspannungstransformator aufgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
