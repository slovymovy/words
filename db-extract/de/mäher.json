                                "target_senses": [
                                    {
                                        "sense_id": "bb04c94d-786e-3fd6-903a-0e72e52ebad5",
                                        "entry_id": "106c5912-4359-3495-8f2e-6a929a6cbae1",
                                        "glosses": [
                                            "A person or machine which harvests or prepares tall grass for use as animal fodder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03073d38-683b-4dc3-8cd1-184aba734ec9",
                                                "sense_id": "bb04c94d-786e-3fd6-903a-0e72e52ebad5",
                                                "text": "A long rank of haymakers—men and women—proceeded with their rakes, the white shirt-sleeves, straw bonnets, and ruddy faces, radiant in the bath of sunshine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6b46449-64a8-3775-892c-4aec2c0a32a3",
                                        "entry_id": "106c5912-4359-3495-8f2e-6a929a6cbae1",
                                        "glosses": [
                                            "A particularly powerful punch, especially one which knocks down an opponent, thrown like a scythe chop for cutting hay, as agricultural haymakers used to have strong arms."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe466639-20bc-4c0d-b270-cd6403c922da",
                                                "sense_id": "f6b46449-64a8-3775-892c-4aec2c0a32a3",
                                                "text": "The saga of Newt Gingrich's ethics suddenly resembles a brawl between blindfolded boxers who flail away so wildly that each lands a haymaker on his own jaw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857170e5-1e7f-3802-bdbf-22069408dbf3",
                                        "entry_id": "106c5912-4359-3495-8f2e-6a929a6cbae1",
                                        "glosses": [
                                            "Any decisive blow, shock, or forceful action."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ab76c1-ecff-4e9e-90ea-cf06e32db880",
                                                "sense_id": "857170e5-1e7f-3802-bdbf-22069408dbf3",
                                                "text": "The real potential haymaker for the industry is a proposal, now gaining support in Congress, that would tax the profits private equity reaps on selling companies not at the low cap gains rate, but at the regular income tax rate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
