                        "glosses": [
                            "To shape or mould beforehand; prepare in advance."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7328a7fe-49c5-4058-bb0b-e72a2cc65c04",
                                "sense_id": "3216cd92-ad47-3d47-aef3-b19b1e6cc0bd",
                                "text": "Thought forecasts and foreshapes experiment, and traces out the consequences as they arise, comparing them with the sharp directness of its expectations."
                            },
                            {
                                "example_id": "9700b231-a9a6-4de9-8bef-b4a08eb3ebac",
                                "sense_id": "3216cd92-ad47-3d47-aef3-b19b1e6cc0bd",
                                "text": "What the self is to become thereby ceases to be a fate that haunts it or lies ambuscaded in its circumstances, for the self can foreshape its own career and reality."
                            },
                            {
                                "example_id": "0a108881-b2f0-4f5f-a496-515cd66c52bd",
                                "sense_id": "3216cd92-ad47-3d47-aef3-b19b1e6cc0bd",
                                "text": "Thou canst foreshape thy word; The poet is not lord […]"
                            }
                        ]
                    }
