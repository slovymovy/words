                "senses": [
                    {
                        "sense_id": "f0af46b3-2aed-3367-9409-13125e449e98",
                        "entry_id": "cd3398ce-e260-3145-857a-b40f087b4fbe",
                        "glosses": [
                            "Partie surélevée située à l'arrière de l'appui qui peut-être maçonnée, préfabriquée ou coulée en place. Il est destiné à supporter la traverse basse du dormant de la fenêtre et à assurer l'étanchéité entre l'appui et celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d220ac5-01c5-4704-9890-e0e6f567a0e1",
                                "sense_id": "f0af46b3-2aed-3367-9409-13125e449e98",
                                "text": "Le problème de l’infiltration des eaux de pluie dans la partie basse de la fenêtre fut résolu par la présence d'un jet d’eau au bas du bâti ouvrant et d'un rejingot dans la maçonnerie, […]."
                            },
                            {
                                "example_id": "e71580a8-6b5c-4255-bf97-58b7d9a2eb3d",
                                "sense_id": "f0af46b3-2aed-3367-9409-13125e449e98",
                                "text": "Le rejingot peut être en béton, en fibrociment ou constitué d’une bavette métallique. Il est fondamental que les liaisons du rejingot avec le mur n’occasionnent pas d’infiltrations au droit de l’ossature."
                            }
                        ]
                    }
