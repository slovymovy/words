                ],
                "senses": [
                    {
                        "sense_id": "8745e5a3-65da-32c4-80da-879aa51eb0bd",
                        "entry_id": "4ddbc7a5-c3e5-3e24-bca3-d68a52e40b0c",
                        "glosses": [
                            "Shelves collectively."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a9313170-6535-47cc-bfcf-036d4e5817e2",
                                "sense_id": "8745e5a3-65da-32c4-80da-879aa51eb0bd",
                                "text": "a shelving unit"
                            },
                            {
                                "example_id": "cbe7d71c-9be1-41a1-833f-a8fa9265ed46",
                                "sense_id": "8745e5a3-65da-32c4-80da-879aa51eb0bd",
                                "text": "There is ample shelving in the basement."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8d3c1bc-4f97-338f-b458-398ad662d97d",
                        "entry_id": "4ddbc7a5-c3e5-3e24-bca3-d68a52e40b0c",
                        "glosses": [
                            "The side-rails of a cart or waggon."
                        ],
                        "tags": [
                            "countable",
                            "in-plural",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0264efa8-6ebe-4e91-ae81-924cb021cab1",
                                "sense_id": "e8d3c1bc-4f97-338f-b458-398ad662d97d",
                                "text": "So, creaking and creaking, and the shelvins skirling under the weight of their load, they passed that danger point, the carts plodded into motion again […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "97b45b42-6496-3b02-9be6-13a172ed3ba7",
                        "entry_id": "4ddbc7a5-c3e5-3e24-bca3-d68a52e40b0c",
                        "glosses": [
                            "A sloping surface."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f85e0b5-3473-4bd0-b195-5b606caa0156",
                                "sense_id": "97b45b42-6496-3b02-9be6-13a172ed3ba7",
                                "text": "[…] the way was all along set so full of Snares, Traps, Gins, and Nets here, and so full of Pits, Pitfalls, deep holes and shelvings down there, that had it now been dark […] had he had a thousand souls, they had in reason been cast away;"
                            },
                            {
                                "example_id": "6bc3b1d3-9bbb-4afe-a937-50858bb8747a",
                                "sense_id": "97b45b42-6496-3b02-9be6-13a172ed3ba7",
                                "text": "[The little room] had more corners in it than the brain of an obstinate man; was full of mad closets, into which nothing could be put that was not specially invented and made for that purpose; had mysterious shelvings and bulk-heads […]"
                            },
                            {
                                "example_id": "7caf94b2-c199-40a5-8751-eea6ce03e8aa",
                                "sense_id": "97b45b42-6496-3b02-9be6-13a172ed3ba7",
                                "text": "dry light sand, blown from higher shelvings, striped the dark wet edges of the shore"
                            },
                            {
                                "example_id": "44264ce9-2501-4a3d-bf3c-9586f0916554",
                                "sense_id": "97b45b42-6496-3b02-9be6-13a172ed3ba7",
                                "text": "Frau Von Zeck settled her powerful chins upon the coarse shelving of her Wagnerian breasts […]"
                            }
                        ]
                    }
                ],
