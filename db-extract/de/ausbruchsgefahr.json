                        "glosses": [
                            "Gefahr eines Ausbruchs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "044feb98-b2f6-4892-b302-6dc0065d08ca",
                                "sense_id": "ded36b40-ab19-3c10-86ed-162da0cdae1f",
                                "text": "„Bei erhöhter Ausbruchsgefahr wird der Seilbahnbetrieb eingestellt bzw. die Kraterumgebung gesperrt; an verschiedenen Punkten der Strecke gibt es Schutzbunker.“"
                            },
                            {
                                "example_id": "de16182d-1152-459b-a874-392852ff7d27",
                                "sense_id": "ded36b40-ab19-3c10-86ed-162da0cdae1f",
                                "text": "„Verschärfte Sicherungsvorkehrungen (vgl. Nr. 60 ff, 62 ff UVollzO) sind – gestützt auf § 119 Abs. 3 – grundsätzlich zulässig, wenn einer konkreten außergewöhnlichen Gefahrenlage (z.B. akuter Suizid- oder Ausbruchsgefahr) nicht anders begegnet werden kann.“"
                            }
                        ],
