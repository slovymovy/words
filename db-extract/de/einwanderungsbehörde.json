                "senses": [
                    {
                        "sense_id": "f318f2f4-1be1-34c9-9048-43786e0f835a",
                        "entry_id": "c0d0d832-8c02-393f-b75f-52a5f3e6c5a3",
                        "glosses": [
                            "staatliche Institution, die über eine Einwanderung einer Person entscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e44559-ee19-4ca6-9f8b-3b2db513b1fb",
                                "sense_id": "f318f2f4-1be1-34c9-9048-43786e0f835a",
                                "text": "Die Einwanderungsbehörde machte Kontrollen, ob es sich bei der Hochzeit nur um eine Scheinehe zur Erlangung der Aufenthaltserlaubnis handelt."
                            },
                            {
                                "example_id": "ce10d316-5105-435d-92b2-875d7a5a7be5",
                                "sense_id": "f318f2f4-1be1-34c9-9048-43786e0f835a",
                                "text": "„Danach ging ich zur Einwanderungsbehörde, um mein Visum auf drei Monate zu verlängern.“"
                            },
                            {
                                "example_id": "68032bc1-abe6-4654-9e5d-6db307b0c125",
                                "sense_id": "f318f2f4-1be1-34c9-9048-43786e0f835a",
                                "text": "„Wir trotteten hinter ihm her in das Büro der Einwanderungsbehörde, wo wir uns in die Schlange arabischer Männer mit Säcken voller Zwiebeln anstellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
