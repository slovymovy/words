                        "entry_id": "ff2152d9-2466-3457-936c-2a812d225923",
                        "glosses": [
                            "Gebetsriemen bestehend aus Arm-Tefillin und Kopf-Tefillin, schwarzen mit Lederriemen versehenen kleinen, ledernen Gebetskapseln, die auf Pergament handgeschriebene Schriftrollen mit Texten aus der Thora, den fünf Büchern Moses, enthalten."
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "7942776c-06d8-4aab-a068-af0b0138bfc6",
                                "sense_id": "e2c3314e-ac0a-3836-bab3-da7a812f02cd",
                                "text": "Tefillin werden nur an Werktagen angelegt. An Schabbat, Feiertagen, und Zwischenfeiertagen legt man sie nicht an."
                            }
                        ],
                        "sense_index_json": "\"1\""
