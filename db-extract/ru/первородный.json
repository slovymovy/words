                ],
                "senses": [
                    {
                        "sense_id": "d3f42491-e8fd-3053-bc79-0f7ed779f38b",
                        "entry_id": "cc89bd6c-8710-369f-84f0-52f967b8fbf6",
                        "glosses": [
                            "устар. родившийся первым, прежде всех других детей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1415c63-0906-4664-abf3-fda815c53a6b",
                                "sense_id": "d3f42491-e8fd-3053-bc79-0f7ed779f38b",
                                "text": "Это был первородный сын, которого по древнейшим обрядам приносили в жертву для доказательства веры…"
                            }
                        ]
                    },
                    {
                        "sense_id": "98f8ae70-1e07-31e7-a82a-c7ce07e23997",
                        "entry_id": "cc89bd6c-8710-369f-84f0-52f967b8fbf6",
                        "glosses": [
                            "устар. произошедший, созданный прежде всех других; первозданный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6596b0f6-1323-4ddc-b73b-c00186f07a38",
                                "sense_id": "98f8ae70-1e07-31e7-a82a-c7ce07e23997",
                                "text": "Посмотрим, что будет, если, по мысли Бондарева, проповедь религиозная направит свои силы на разъяснение этого закона, и все люди признают священный первородный закон труда."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6f31268-a93e-37c2-b2ed-a4caa0eb6228",
                        "entry_id": "cc89bd6c-8710-369f-84f0-52f967b8fbf6",
                        "glosses": [
                            "устар., перен. сохранивший своё естественное состояние; нетронутый, девственный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c35e091-fe83-4ec5-9800-eddda9a25f4b",
                                "sense_id": "c6f31268-a93e-37c2-b2ed-a4caa0eb6228",
                                "text": "В действительности же под ногами — первородный скальный монолит."
                            }
                        ]
                    }
                ],
