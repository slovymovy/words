                "senses": [
                    {
                        "sense_id": "c430cb56-c612-39a3-83bf-61ff44cfb392",
                        "entry_id": "28157869-28b7-370c-8cc4-0b48159f5673",
                        "glosses": [
                            "female equivalent of напе́рсник (napérsnik): female bosom friend, intimate"
                        ],
                        "tags": [
                            "archaic",
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a87e874c-34c3-4cd7-a301-d9fce6c8ab12",
                                "sense_id": "c430cb56-c612-39a3-83bf-61ff44cfb392",
                                "text": "Порфи́рий Влади́мирыч да́же помертве́л от неожи́данности. Он смотре́л во все глаза́ на взбунтова́вшуюся напе́рсницу, и це́лая ма́сса пра́здных слов так и закипа́ла у него́ в груди́.",
                                "translation": "Porfiry Vladimirych’s blood ran cold at this unexpected turn of events. He gaped at his unruly companion, and a host of idle words surged up in his breast.",
                                "english": "Porfiry Vladimirych’s blood ran cold at this unexpected turn of events. He gaped at his unruly companion, and a host of idle words surged up in his breast."
                            }
                        ]
                    }
                ],
