                ],
                "senses": [
                    {
                        "sense_id": "c8fbef92-fb32-3fa1-b137-9bf00d5beb84",
                        "entry_id": "21bdd8f6-3501-35ab-92a7-809099182f10",
                        "glosses": [
                            "Unité de mesure de temps du Système international (SI), valant 10⁻¹⁵ seconde, et dont le symbole est fs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23dfd5a3-c2c7-43a7-b3e8-363a48157500",
                                "sense_id": "c8fbef92-fb32-3fa1-b137-9bf00d5beb84",
                                "text": "Les chiffres donnent le vertige: le système est capable d'atteindre un pic de 10 pétawatts (10 puissance 15 watts) pendant un temps ultra-bref, de l'ordre de la femtoseconde (un millionième de milliardième de seconde)."
                            },
                            {
                                "example_id": "8e1f2b19-962a-45c0-9c87-d1c7ab01024b",
                                "sense_id": "c8fbef92-fb32-3fa1-b137-9bf00d5beb84",
                                "text": "Le laser femtoseconde permet de fendre ou de cliver la cornée par une action photodisruptive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ad7e892-20fd-4e21-a967-a07593ebd481",
                        "source_entry_id": "21bdd8f6-3501-35ab-92a7-809099182f10",
                        "source_sense_id": "c8fbef92-fb32-3fa1-b137-9bf00d5beb84",
                        "target_lang_word": "femtosecond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femtosecond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c21ae821-13fa-3f3d-a6f8-8aefd8a0448b",
                                        "entry_id": "4102198e-79b8-3c60-96b7-ee45f48363b6",
                                        "glosses": [
                                            "An SI unit of time equal to 10⁻¹⁵ seconds. Symbol: fs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5cc8f95-7a9c-44a6-8dac-6925d8cc6f97",
                                                "sense_id": "c21ae821-13fa-3f3d-a6f8-8aefd8a0448b",
                                                "text": "Holonyms: picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < hour < day < week < megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "486fa4c7-f705-49b2-8d22-2b912b378c01",
                                                "sense_id": "c21ae821-13fa-3f3d-a6f8-8aefd8a0448b",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond"
                                            },
                                            {
                                                "example_id": "2f194b38-2d15-4380-acc5-4337ab6bde96",
                                                "sense_id": "c21ae821-13fa-3f3d-a6f8-8aefd8a0448b",
                                                "text": "Sheldon Cooper: My hair is growing at the rate of 4.6 yoctometers per femtosecond."
                                            },
                                            {
                                                "example_id": "8c48badd-7d0e-4f4a-98e3-c8c3726ccbf5",
                                                "sense_id": "c21ae821-13fa-3f3d-a6f8-8aefd8a0448b",
                                                "text": "The observation and manipulation of electron dynamics in matter call for attosecond light pulses, routinely available from high-order harmonic generation driven by few-femtosecond lasers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
