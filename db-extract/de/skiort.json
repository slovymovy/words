                        "sense_id": "1fb7beb7-5c7a-3a0b-b525-b456ee11045f",
                        "entry_id": "06cb0929-9365-3882-8cd9-51de9677ba80",
                        "glosses": [
                            "Ort, der viel von Skifahrern besucht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7661557-343a-4250-866a-5ee46e93ce75",
                                "sense_id": "1fb7beb7-5c7a-3a0b-b525-b456ee11045f",
                                "text": "„Womöglich lagen nur noch Skiorte vor ihm, deren Hotels alle ausgebucht waren.“"
                            },
                            {
                                "example_id": "face6f32-c64b-4390-b848-2f8698c30802",
                                "sense_id": "1fb7beb7-5c7a-3a0b-b525-b456ee11045f",
                                "text": "„Du konntest dort immer Ski laufen, allerdings musstest du dazu, außer in sehr schneereichen Wintern, erst einmal klettern, weil Schruns für einen Skiort nicht hoch genug lag.“"
                            }
                        ],
