                        "cross_references": [
                            {
                                "target_word": "automonteur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3d76d197-6426-3851-89e8-b96ec8cc5c07",
                                        "entry_id": "dd1c2c87-593d-3e30-bdf6-f0b3ba82a660",
                                        "glosses": [
                                            "vakman die de werking van motorvoertuigen met een carrosserie herstelt of verbetert"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48918d47-b545-4a28-8c18-82005a41817d",
                                                "sense_id": "3d76d197-6426-3851-89e8-b96ec8cc5c07",
                                                "text": "Mijn buurman is automonteur."
                                            },
                                            {
                                                "example_id": "c0a47553-1760-421a-a4f5-316d1b06dfc7",
                                                "sense_id": "3d76d197-6426-3851-89e8-b96ec8cc5c07",
                                                "text": "Het had bijna te moeilijk geleken in het begin, toen Clark er pessimistisch op was ingesteld dat hij naar de ambachtsschool zou gaan om blikslager, automonteur of iets dergelijks te worden."
                                            },
                                            {
                                                "example_id": "4d1110a4-efc9-45ae-ab96-e05110efc241",
                                                "sense_id": "3d76d197-6426-3851-89e8-b96ec8cc5c07",
                                                "text": "Een Belg die Slimane heette en automonteur was, had hem als slaapplek zijn garage aangeboden, een paar bushaltes van het station vandaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f16aea7-03e0-4501-ba40-818c37ff76d1",
                        "source_entry_id": "9ab1b070-2590-3dcb-9f7f-a89d52f8ce06",
                        "source_sense_id": "043ffd45-0554-3896-8e30-f7c16eac0ba8",
                        "target_lang_word": "automechanieker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automechanieker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e67d0928-7da5-300c-8d02-461d689daae8",
                                        "entry_id": "544b2aff-e3f4-329f-8c70-a905e6620578",
                                        "glosses": [
                                            "iemand die auto's onderhoudt en repareert en die een opleiding automechanica heeft gevolgd"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b34764d4-6b56-4e18-ae4b-600a74912bc6",
                                                "sense_id": "e67d0928-7da5-300c-8d02-461d689daae8",
                                                "text": "De school telt amper 200 leerlingen, en 1 leerkracht per 13 leerlingen. Het is een school voor iedereen, zowel toekomstige automechaniekers, als academici kunnen er terecht."
                                            },
                                            {
                                                "example_id": "732aef05-c703-4788-a150-a1d7ab60e7f5",
                                                "sense_id": "e67d0928-7da5-300c-8d02-461d689daae8",
                                                "text": "Wat gebeurt er als je een groepje zestienjarige anderstalige nieuwkomers samenzet met ‘blanke’ leeftijdsgenoten uit een Steinerschool en hen klaarstoomt voor een experimentele dans- en theatervoorstelling? En dat jonge geweld een podium bezorgt tijdens de Gentse Feesten? Ambities voor een toekomst als elektricien of automechanieker krijgen er een extra dimensie bij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
