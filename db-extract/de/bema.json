                                                "sense_id": "df684656-147d-3d7b-af6c-9906523aefb5",
                                                "text": "Im Chor befinden sich zu wenig Stühle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ed75d7b-c257-3313-b128-15cd5776acd2",
                                        "entry_id": "af8547a5-b1c9-333a-83bd-6dc7ff129909",
                                        "glosses": [
                                            "Platz für die Sänger auf der Orgelempore"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c7ed774-4273-4fb1-8ecd-92d0a4f35bc4",
                                                "sense_id": "4ed75d7b-c257-3313-b128-15cd5776acd2",
                                                "text": "Sonntags waren die beiden Sänger immer da, auf dem Chor der Pfarrkirche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
