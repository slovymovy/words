                ],
                "senses": [
                    {
                        "sense_id": "2d10b13a-b334-3131-92ba-b2df5c57cbb6",
                        "entry_id": "42a96807-9fd3-35e1-8d7a-39e3527831db",
                        "glosses": [
                            "To react too much or too intensely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1138f28-1589-4fc3-a1f3-e1b70ad88a61",
                                "sense_id": "2d10b13a-b334-3131-92ba-b2df5c57cbb6",
                                "text": "Please try not to overreact if she drives badly when she is first learning."
                            },
                            {
                                "example_id": "4434fbfe-6a0f-4c9d-af6b-39b43b81827d",
                                "sense_id": "2d10b13a-b334-3131-92ba-b2df5c57cbb6",
                                "text": "overreact to bad news"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1df1984f-681c-4f80-a295-cd0fa088e542",
                        "source_entry_id": "42a96807-9fd3-35e1-8d7a-39e3527831db",
                        "source_sense_id": "2d10b13a-b334-3131-92ba-b2df5c57cbb6",
                        "source_sense_description": "react too much or too intensely",
                        "target_lang_word": "s'emporter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "59e60994-bfc3-4539-9754-f11c6b02f0fe",
                        "source_entry_id": "42a96807-9fd3-35e1-8d7a-39e3527831db",
                        "source_sense_id": "2d10b13a-b334-3131-92ba-b2df5c57cbb6",
                        "source_sense_description": "react too much or too intensely",
                        "target_lang_word": "surréagir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surréagir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31220f02-20b1-3fac-b92b-e4a93fd96996",
                                        "entry_id": "db80a6ac-dfad-3295-bc10-60a966e4e7d6",
                                        "glosses": [
                                            "Réagir excessivement ou plus que la normale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079818a6-bc2f-4307-87f8-4d1bc62b90f5",
                                                "sense_id": "31220f02-20b1-3fac-b92b-e4a93fd96996",
                                                "text": "Surtout, n’oublie pas que vous avez tous les deux tendance à surréagir, alors évite de formuler tes critiques de manière trop tranchée et ne prends pas les siennes trop à cœur."
                                            },
                                            {
                                                "example_id": "bd41e2f4-4bf3-47b9-8f4b-e968bf881c4e",
                                                "sense_id": "31220f02-20b1-3fac-b92b-e4a93fd96996",
                                                "text": "Je ne suis donc légitime ni en tant que médecin, ni en tant que réalisateur. Impossible de savoir si ça lui [mon père] échappe totalement ou si c’est ma grille de lecture qui est biaisée, moi qui surréagis, surinterprète, surinvestis tous ces moments où j’ai le sentiment qu’il remet en cause ma légitimité. Je n’arrive pas encore aujourd’hui vraiment à trancher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3356481c-2196-4f67-936e-702f378250db",
                        "source_entry_id": "42a96807-9fd3-35e1-8d7a-39e3527831db",
                        "source_sense_id": "2d10b13a-b334-3131-92ba-b2df5c57cbb6",
                        "source_sense_description": "react too much or too intensely",
                        "target_lang_word": "exagérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exagérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Donner à une chose plus d’importance qu’elle n’en a en réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a1beba-52ca-42a5-bc14-cb2f090774a4",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Le caricaturiste exagère les traits les plus marquants de son modèle."
                                            },
                                            {
                                                "example_id": "8522e2d5-b94e-4d0b-87e6-9dcdea55182b",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Un comique outre sur la scène ses personnages ; un poète charge ses descriptions ; un peintre qui fait d’après nature force et exagère une passion, un contraste, des attitudes."
                                            },
                                            {
                                                "example_id": "032df44d-67f4-480a-83c2-04bef88fec36",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Vous n’avez pas le sens de la mesure, vous exagérez toujours tout !"
                                            },
                                            {
                                                "example_id": "59a9e15f-a31d-45e4-9163-2d67a5622813",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "La cravache ou la gaule est aussi nécessaire pour le travail de la haute école que pour celui du dressage, car elle doit servir à exagérer la puissance de l’écuyer pour stimuler le cheval […]."
                                            },
                                            {
                                                "example_id": "66de5f11-34ba-43f7-bdd3-410a5f2792e0",
                                                "sense_id": "460e531d-20ca-35d4-95cf-cb254f60d5ce",
                                                "text": "Sa chevelure, relevée par un peigne, exagérait la longueur de son front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "815b02a3-7efd-3ff4-9556-6c8bf05f30d8",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Faire valoir, faire ressortir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b2fae4-d691-4ebc-ada7-a493a9bec5ff",
                                                "sense_id": "815b02a3-7efd-3ff4-9556-6c8bf05f30d8",
                                                "text": "J’ai beau lui exagérer le sacrifice que je lui ai fait, il se met à rire, et me soutient qu’il m’a trouvée très-profane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50328e9-c9c6-308b-a095-e0b3d0e32972",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Dépasser la juste mesure dans ses propos ou ses actes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59ce1b67-1eb9-40a2-acf6-e8f289d9e8c6",
                                                "sense_id": "f50328e9-c9c6-308b-a095-e0b3d0e32972",
                                                "text": "N’exagère pas ou je vais me fâcher !"
                                            },
                                            {
                                                "example_id": "41eca1ca-a77a-4a77-aba1-d9890fc85946",
                                                "sense_id": "f50328e9-c9c6-308b-a095-e0b3d0e32972",
                                                "text": "Je ne crois pas exagérer en disant qu’il faisait au moins deux mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61632b63-ea0e-3310-a83b-d938d3b268bc",
                                        "entry_id": "1b9a690c-b84d-3804-adf2-bdf9ceea535d",
                                        "glosses": [
                                            "Se faire de quelque chose une idée excessive."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cecb0c45-dd4b-448f-bd67-2f5f41461023",
                                                "sense_id": "61632b63-ea0e-3310-a83b-d938d3b268bc",
                                                "text": "Dans l’obscurité, elle s’était exagéré la hauteur de l’obstacle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23dc53ed-3ab2-44bb-b0c7-030d33c6e31a",
                        "source_entry_id": "42a96807-9fd3-35e1-8d7a-39e3527831db",
                        "source_sense_id": "2d10b13a-b334-3131-92ba-b2df5c57cbb6",
                        "source_sense_description": "react too much or too intensely",
                        "target_lang_word": "überreagieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überreagieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a43e3a09-b84c-3c56-a0ad-fe0a8ead2941",
                                        "entry_id": "68efd4ae-fec9-3aaf-9967-bf32da2d2e94",
                                        "glosses": [
                                            "übertrieben, unangemessen emotional auf eine Situation reagieren"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d5802c2-6e8f-4366-9078-a869cd5f8dca",
                                                "sense_id": "a43e3a09-b84c-3c56-a0ad-fe0a8ead2941",
                                                "text": "Dass die USA auf die verbalen Entgleisungen und das Imponiergehabe des philippinischen Präsidenten nicht überreagieren, lässt sich auch damit begründen, dass sich bisher faktisch nicht viel geändert hat."
                                            },
                                            {
                                                "example_id": "3b00d71f-c416-4dc5-90c8-11b8b49aac96",
                                                "sense_id": "a43e3a09-b84c-3c56-a0ad-fe0a8ead2941",
                                                "text": "Hyperaktive Kinder neigen dazu, emotional zu überreagieren, von Euphorie und Enthusiasmus bis hin zur Launenhaftigkeit."
                                            },
                                            {
                                                "example_id": "17d6b1d1-9691-4d70-8816-f0cb9853504d",
                                                "sense_id": "a43e3a09-b84c-3c56-a0ad-fe0a8ead2941",
                                                "text": "Ausgeprägte Verletzungen können erhebliche Komplikationen nach sich ziehen, weil aufgrund von zerstörtem Gewebe das Immunsystem überreagieren kann und Mikroorganismen in den Körper eindringen."
                                            },
                                            {
                                                "example_id": "413de1e7-6c23-44ab-b4dc-5acdd3a800da",
                                                "sense_id": "a43e3a09-b84c-3c56-a0ad-fe0a8ead2941",
                                                "text": "Wenn der Fahrer überreagiert und hektisch wird, dann kann es kritisch werden."
                                            },
                                            {
                                                "example_id": "3e24cab2-6ee3-406b-9936-3bd3ef246905",
                                                "sense_id": "a43e3a09-b84c-3c56-a0ad-fe0a8ead2941",
                                                "text": "Der Polizeichef von New York, William Bratton, warf seinem Kollegen Beck vor, überreagiert und die Angst der Bürger unnötig geschürt zu haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
