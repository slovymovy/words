                    {
                        "sense_id": "a80430a6-e412-349f-96b7-0cc0ed43ef58",
                        "entry_id": "ed08903f-eede-3cd9-b2eb-9439ca8be1bd",
                        "glosses": [
                            "natürliche Vertiefung der Landoberfläche, die von einem Fließgewässer (insbesondere einem Bach) geschaffen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40983f4-bb13-45c0-9910-a1c912a0a8a4",
                                "sense_id": "a80430a6-e412-349f-96b7-0cc0ed43ef58",
                                "text": "Das Bachbett war vollkommen ausgetrocknet."
                            },
                            {
                                "example_id": "da3a6ade-a878-41d3-b88d-2fd486ff3ea2",
                                "sense_id": "a80430a6-e412-349f-96b7-0cc0ed43ef58",
                                "text": "„Die ersten paar Stunden pflügten wir durch die Wüste wie zuvor, fuhren durch ausgetrocknete Bachbetten, wichen Kamelgrasbüscheln aus und erklommen steile Felshänge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
