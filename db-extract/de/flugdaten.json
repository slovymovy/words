                                "example_id": "57783506-442c-4599-a81b-601d77e431f8",
                                "sense_id": "d55d5ada-1cab-3521-b64a-32bbc93ef0bf",
                                "text": "„Flugdaten nach dem Absturz zeigen, dass der Luftverkehr mittlerweile vor allem über Bulgarien und die Türkei umgeleitet wird.“"
                            },
                            {
                                "example_id": "fda14cda-c700-4e04-b267-e32dbca94646",
                                "sense_id": "d55d5ada-1cab-3521-b64a-32bbc93ef0bf",
                                "text": "„Die wichtigsten Flugdaten könnten zum Beispiel in Echtzeit über Satelliten übertragen werden.“"
                            },
                            {
                                "example_id": "93c85871-b356-46ef-94b5-b7d08976d334",
                                "sense_id": "d55d5ada-1cab-3521-b64a-32bbc93ef0bf",
                                "text": "„Umso wichtiger sei deshalb der Aufbau eines neuen Übertragungssystems für Flugdaten basierend auf dem Acars.“"
                            }
