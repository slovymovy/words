                        "examples": [
                            {
                                "example_id": "98015db0-03a8-4875-bd69-0817276d8fca",
                                "sense_id": "d31e03ca-ab60-33c6-b7a2-d458afb1a340",
                                "text": "De komst van het eroscentrum krijgt geen bijval van de oppositie. Zo is de grootste partij, de PvdA, faliekant tegen en ook het CDA, de ChristenUnie en Arnhems Belang willen de raamprostitutie niet terug."
                            },
                            {
                                "example_id": "32c48541-355e-4c4b-b4b1-c82a9ba3d572",
                                "sense_id": "d31e03ca-ab60-33c6-b7a2-d458afb1a340",
                                "text": "ALMELO - De buren in de Marktstraat in Almelo zijn er niet blij mee, maar begin volgend jaar wordt de voormalige Massagesalon Eléon omgedoopt in Eroscentrum Marktstraat 13. De eigenaar die met het verhaal eigenlijk nog niet in de krant wil, begrijpt de opwinding niet zo goed."
                            }
                        ]
