                        "entry_id": "129199b1-4d35-3f1d-85a6-a9ed73440e73",
                        "glosses": [
                            "eines der drei wichtigsten Schriftsysteme der japanischen Sprache, übernommen aus den traditionellen chinesischen Schriftzeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "726aed2a-e44c-447d-8869-1f79c8098573",
                                "sense_id": "63831ed9-b658-3908-bd82-6b88e6cf76dc",
                                "text": "„Auch diese Untersuchungen erbrachten das Resultat, daß bei der Verarbeitung von Kanji und Kanamoji unterschiedliche kognitive Strategien zur Anwendung kommen und daß dabei die cerebralen Hemisphären verschiedene Rollen spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
