                ],
                "senses": [
                    {
                        "sense_id": "d0e01c13-891d-3064-b0a3-851403fc37d1",
                        "entry_id": "eb7a5944-fe64-38fb-9c47-89cdbeb1b330",
                        "glosses": [
                            "Petite monnaie romaine qui valait cinq centièmes de lire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1401dd3-2bf6-467e-8603-f20a60482ba4",
                                "sense_id": "d0e01c13-891d-3064-b0a3-851403fc37d1",
                                "text": "Le capucin seul se leva et me fit des politesses qui aboutirent à l'humble demande d'un baïoque, un sou du pays, pour les besoins de son ordre. Je lui en donnai cinq, qu'il reçut avec une profonde reconnaissance."
                            },
                            {
                                "example_id": "2122bf0a-d744-45e9-97c5-af200473cd91",
                                "sense_id": "d0e01c13-891d-3064-b0a3-851403fc37d1",
                                "text": "Elle n’aura pas un baïoque de l’héritage des comtes de Montefalcone, c’est moi qui vous le dis."
                            },
                            {
                                "example_id": "73af44dd-d8d6-438a-9aaa-a46f9522b2eb",
                                "sense_id": "d0e01c13-891d-3064-b0a3-851403fc37d1",
                                "text": "« Tu trouveras également pliées dans du papier à faire les filtres cinquante baïoques »."
                            }
                        ]
                    },
                    {
                        "sense_id": "df39dbf9-5ee3-3122-a20f-ae21d8e1320f",
                        "entry_id": "eb7a5944-fe64-38fb-9c47-89cdbeb1b330",
                        "glosses": [
                            "Ancienne monnaie de cuivre des États pontificaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b573f5-d386-479c-92c8-bf6112145b35",
                                "sense_id": "df39dbf9-5ee3-3122-a20f-ae21d8e1320f",
                                "text": "Un écu romain valait cent baïoques."
                            }
                        ]
                    }
