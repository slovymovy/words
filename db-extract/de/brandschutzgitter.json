                ],
                "senses": [
                    {
                        "sense_id": "ea33ef24-9d1c-3d13-8fd0-058b1b1d50ed",
                        "entry_id": "ed964982-cefa-37c3-9c7b-f6024d4aea10",
                        "glosses": [
                            "gitterförmige Wand- oder Türverkleidung, durch die Luft hindurchströmen kann und die sich im Brandfall selbsttätig verschließt"
                        ],
                        "tags": [
                            "Brandschott"
                        ],
                        "examples": [
                            {
                                "example_id": "104fc2d6-153a-4445-ae6d-40ffad1beaf3",
                                "sense_id": "ea33ef24-9d1c-3d13-8fd0-058b1b1d50ed",
                                "text": "„Die Brandschutzgitter werden in Wände oder Türen eingesetzt, um zu verhindern, dass Flammen und Hitze sich im Brandfall ausbreiten.“"
                            },
                            {
                                "example_id": "4c7f8b5d-7399-4b61-a87c-f609f1eaa02a",
                                "sense_id": "ea33ef24-9d1c-3d13-8fd0-058b1b1d50ed",
                                "text": "„Das Brandschott besteht aus einem Brandschutzgitter mit Ausgleichblech und einem Befestigungsprofil.“"
                            },
                            {
                                "example_id": "80320190-5067-4f7a-84cf-02690569474a",
                                "sense_id": "ea33ef24-9d1c-3d13-8fd0-058b1b1d50ed",
                                "text": "„Brandschutzgitter gibt es für den Türeinbau, den Einbau im Mauerwerk.“"
                            },
                            {
                                "example_id": "6bb21ade-4eb4-4c98-a0ac-488eaf828d94",
                                "sense_id": "ea33ef24-9d1c-3d13-8fd0-058b1b1d50ed",
                                "text": "„Das Brandschutzgitter aus Aluminium ist auf der oberen Profilseite beidseitig mit einer Beschichtung versehen, die bei Überschreiten von ca. 150°C reagiert und den Lufteinlass bzw. Hinterlüftungsspalt mit einem nichtbrennbaren, luftundurchlässigen Schaum verschließt.“"
                            },
                            {
                                "example_id": "78cddd74-ca16-467d-8e24-1db2037dc8b2",
                                "sense_id": "ea33ef24-9d1c-3d13-8fd0-058b1b1d50ed",
                                "text": "„Die Brandschutzgitter sind mit einem Bezug aus Wildlederimitat geschützt. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
