                                "target_lang_word": "scrub",
                                "target_lang_sense_clarification": "To clean something thoroughly with water and soap."
                            },
                            {
                                "target_lang_word": "wash",
                                "target_lang_sense_clarification": "To clean using water and soap."
                            }
                        ]
