                                    {
                                        "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                        "entry_id": "89c5b136-0f0f-3719-aa59-630e57b18612",
                                        "glosses": [
                                            "Grande caisse sur un train à deux ou quatre roues qui servait ordinairement pour porter des vivres et des munitions à l’armée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7edbb25a-2125-4cf1-a9f0-da52ccd0e70a",
                                                "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                                "text": "Les caissons de l’artillerie."
                                            },
                                            {
                                                "example_id": "aa611e4d-34cf-4309-8729-7eaf019c4523",
                                                "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                                "text": "Les caissons des vivres."
                                            },
                                            {
                                                "example_id": "9884b207-3f94-4a9c-9df2-244908ac6a47",
                                                "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                                "text": "Les caissons des munitionnaires."
                                            },
                                            {
                                                "example_id": "ecc65e9f-b54e-480e-a93c-9bae6927c76b",
                                                "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                                "text": "Les cours étaient remplies de caissons de l’artillerie, ouverts et chargés de poudre, préparés pour la revue du lendemain."
                                            },
                                            {
                                                "example_id": "d56745a5-8a8b-4236-bda8-c3c8c170007f",
                                                "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                                "text": "Il regarda la colonne du mois de décembre, et, trouvant au quatrième jour de ce mois le nom de sainte Barbe, il se rappela qu’il venait de voir passer des espèces de petits canons et caissons."
                                            },
                                            {
                                                "example_id": "9087c7f9-7cba-4d2f-a434-29d6fbd1b2ec",
                                                "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                                "text": "Les cipayes, conduits par Sougriva, avaient mis le feu aux tentes, chargé le colonel Barclay par-derrière, tiré sur leurs propres officiers, encloué les canons des batteries, mis le feu aux caissons et jeté tout le camp dans un terrible désordre."
                                            },
                                            {
                                                "example_id": "01cbd3a6-885f-4e07-95fa-4e79cbd4d40c",
                                                "sense_id": "21d8901c-1312-3756-ac74-fdaa1559b454",
                                                "text": "Ces paroles inouïes entrèrent dans l’âme du vieux Courtemanche, comme de la mitraille dans un caisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b1ce317-d5c8-3b81-abc4-2ff54edb7e7c",
                                        "entry_id": "89c5b136-0f0f-3719-aa59-630e57b18612",
                                        "glosses": [
                                            "Coffre à l’arrière du navire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec795920-a090-3384-bc21-f5b7d67ee036",
                                        "entry_id": "89c5b136-0f0f-3719-aa59-630e57b18612",
                                        "glosses": [
                                            "Coffre ménagé sous le siège ou à l’arrière d’une voiture."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "442c6347-22c5-3204-b198-0f9ae55e36d6",
                                        "entry_id": "89c5b136-0f0f-3719-aa59-630e57b18612",
                                        "glosses": [
                                            "Coffre en charpente dont on se sert pour établir des fondations dans l’eau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48942518-6c2a-3225-8cdb-cc51852d5efb",
                                        "entry_id": "89c5b136-0f0f-3719-aa59-630e57b18612",
                                        "glosses": [
                                            "Compartiment, renfoncement orné de moulures dont on décore les plafonds et les voûtes."
                                        ],
                                        "tags": [
                                            "Ornement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24c2d165-4e84-4bd4-a790-a36958945622",
                                                "sense_id": "48942518-6c2a-3225-8cdb-cc51852d5efb",
                                                "text": "À l’intérieur, son plafond est de style mudéjar, à caissons de bois de cèdre incrusté d’ivoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c814f027-19b1-3112-81d5-16051a7bd180",
                                        "entry_id": "89c5b136-0f0f-3719-aa59-630e57b18612",
                                        "glosses": [
                                            "Échantillon zonal d’une teinte et/ou d’un poncif, inséré dans la légende pour en indiquer la signification."
                                        ],
                                        "tags": [
                                            "Documentation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5f32e03-b47a-33a1-a794-c736b9722a7e",
                                        "entry_id": "89c5b136-0f0f-3719-aa59-630e57b18612",
                                        "glosses": [
                                            "Caisson de basse, lors des free parties."
                                        ],
