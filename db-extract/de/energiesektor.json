                "senses": [
                    {
                        "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                        "entry_id": "8137ca33-a81e-3165-aa28-5acae90dfc86",
                        "glosses": [
                            "Bereich, der sich mit der Erzeugung und Verteilung von Strom, Erdgas und Fernwärme befasst; Gesamtheit aller Strom/Erdgas/Fernwärme erzeugenden/verteilenden Unternehmen; Gesamtheit der Unternehmen eines Gebietes, die sich mit der Förderung von meist fossilen Rohstoffen, beispielsweise Kohle/Rohöl/Erdgas, auch Uran, befassen"
                        ],
                        "tags": [
                            "zusätzlich auch"
                        ],
                        "examples": [
                            {
                                "example_id": "d840fa9d-5abb-44d0-8f26-024e55313e6e",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„Der Energiesektor in Polen ist mit 161.438 GWh der sechstgrößte in der Europäischen Union.“"
                            },
                            {
                                "example_id": "7fa74c7e-426b-4ffd-9c84-0e087392ab46",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„Mexiko baut in schwierigem ökonomischem Umfeld seinen Energiesektor um.“"
                            },
                            {
                                "example_id": "a7c77e41-b60c-4290-89ae-a002ed4fca94",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "[Schlagzeile:] Gefährliches Klimagas – Methanemissionen im Energiesektor deutlich höher als offiziell angegeben"
                            },
                            {
                                "example_id": "ddbf4add-bde5-4f8b-abd8-d8345a41e49a",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„»Wir sind ein Energiestaat und der Energiesektor bringt uns Hunderte Millionen Dollar Steuereinnahmen«, betont etwa Riley Moore, der Schatzmeister des Bundesstaates West Virginia, im Gespräch mit der New York Times.“"
                            },
                            {
                                "example_id": "27e39970-bc70-406c-a98f-5528b9f9f4cf",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„Noch 24 Stunden, dann endet die Frist zur Mitzeichung einer öffentlichen Petition an den Deutschen Bundestag für mehr Wettbewerb auf dem Energiesektor.“"
                            },
                            {
                                "example_id": "1c9243e0-f361-4153-a172-45152aa568fa",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„Die deutsche Wirtschaft, die sich von russischem Gas abhängig gemacht hatte, musste eine starke Teuerung im Energiesektor hinnehmen.“"
                            },
                            {
                                "example_id": "2d992530-ffe6-4ce0-8548-b0348bc8e9f9",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„Die geplanten Investitionen im Energiesektor bis 2020 belaufen sich auf 3,9 Mrd. Euro (Stand 2009).“"
                            },
                            {
                                "example_id": "c13637c1-1a65-4801-8f6b-2c612b2af4f6",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "[USA 2018:] „China sagte zu, mehr US-Produkte zu kaufen, etwa aus der Landwirtschaft und dem Energie- und Industriesektor.“"
                            },
                            {
                                "example_id": "aa2a9a84-0568-4370-a3ad-ec5f482baa7c",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„Der Dogan-Konzern, an den für den Verkauf rund 890 Millionen Euro fließen sollen, ist ebenfalls im Energie- und Industriesektor aktiv.“"
                            },
                            {
                                "example_id": "27ce7e01-35fa-4ee6-a1b3-d64f7113dac1",
                                "sense_id": "f0424104-6a48-3318-8829-22f619cc9984",
                                "text": "„Wie bei anderen Pleiten im Energiesektor spielten hohe Renditen Prozent eine Rolle, um die Investoren anzulocken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
