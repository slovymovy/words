                ],
                "senses": [
                    {
                        "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                        "entry_id": "2f6095f1-37cb-3190-b06d-f968eb77e025",
                        "glosses": [
                            "messbarer Gehalt an Methan (chemisch: CH₄) in der Atmosphäre oder der Atemluft"
                        ],
                        "tags": [
                            "Klima"
                        ],
                        "examples": [
                            {
                                "example_id": "111c5914-e171-437e-8f83-74fffb2cb0df",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Die atmosphärische Methankonzentration wird in parts per billion (ppb) gemessen, also in Teilchen pro Milliarde.“"
                            },
                            {
                                "example_id": "31978cc5-4618-4b6c-bd70-f8747092abbc",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Das zweitwichtigste Treibhausgas verzeichnete 2021 einen Rekordanstieg. Schon 2020 war die Methankonzentration schneller gestiegen als je zuvor in den Aufzeichnungen.“"
                            },
                            {
                                "example_id": "04bcf1ad-df37-4d50-b37c-1853ef480983",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Die Methankonzentration in der Atmosphäre ist heute zweieinhalb Mal höher als vor der Industrialisierung.“"
                            },
                            {
                                "example_id": "c82a0d7a-02f4-40a6-90db-22aa5229eaa2",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Mit 1896 ppb ist die Methankonzentration mehr als zweieinhalb mal so hoch wie vor Beginn der Industrialisierung.“"
                            },
                            {
                                "example_id": "45e83ce7-d5bd-46ec-90b5-2946e9b5729f",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Seit 1750 ist die Methankonzentration im Jahresmittelwert von 730 ppb auf etwa 1909 ppb im Jahr 2021 angestiegen, das geht aus Daten der US-amerikanischen Wetter- und Ozeanografiebehörde NOAA hervor.“"
                            },
                            {
                                "example_id": "61f86f2f-73e1-4cd9-8383-bc4cf6f3b95d",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Nach Angaben des IPCC ist die heutige Methankonzentration in der Atmosphäre so hoch wie seit mindestens 800.000 Jahren nicht mehr.“"
                            },
                            {
                                "example_id": "8a890c1b-cb66-4ca3-9e9e-2aaedff411fb",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Froitzenheim und Kollegen werteten Satellitendaten der monatlichen Methankonzentrationen in den Jahren 2020 und 2021 aus.“"
                            },
                            {
                                "example_id": "2e8fd794-bbb0-4fcf-bef2-eede9a0586c6",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„Die Forschenden aus den Niederlanden verwendeten für ihre Studie Daten des Troposphären-Überwachungsinstruments TROPOMI, das seit Oktober 2017 täglich globale Informationen über die Methankonzentration in der Atmosphäre mit einer räumlichen Auflösung von 5,5 x 7 km² liefern.“"
                            },
                            {
                                "example_id": "c01881c9-c428-41a4-bb62-468576d8c8c1",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„In Schächten auf der ehemaligen Deponie in Châtel-Saint-Denis ist die Methankonzentration zu hoch.“"
                            },
                            {
                                "example_id": "dbbd932a-a003-49cf-a2ee-1cebd35bc3f0",
                                "sense_id": "29dcc507-fc6f-3641-8c5b-ff2f802e54d9",
                                "text": "„In einer Tiefe von rund 800 Meter war es am Donnerstagabend zu einer verheerenden Explosion eines Luft-Methangas-Gemisches gekommen. Die Mine ist geschlossen. Aufgrund der hohen Methankonzentration wurde die Rettungsaktion zunächst eingestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
