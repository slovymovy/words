                        "source_sense_id": "96c83ecc-effb-34fb-8aa6-49e6862123ac",
                        "source_sense_description": "weißes, kristallines Pulver, das vor allem als Farbstoff genutzt wird",
                        "target_lang_word": "dioxyde de titane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dioxyde de titane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "073f39fe-6735-3f2d-bf0a-b60f3cabd2c4",
                                        "entry_id": "ef809333-f882-3010-bdd6-d1fa497a0ff3",
                                        "glosses": [
                                            "Oxyde quadrivalent du titane, de formule TiO₂ et produit essentiellement à partir d’ilménites ou de rutiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88182850-83cb-4147-9803-786137ba8c99",
                                                "sense_id": "073f39fe-6735-3f2d-bf0a-b60f3cabd2c4",
                                                "text": "La production de M&M’s sans dioxyde de titane débutera à partir de mi-2019 sur le site de Haguenau, et doit s'étaler jusqu'à mi-2020. Un délai nécessaire pour intégrer l’amidon de riz dans la recette en remplacement de l'additif, plus connu sous le nom de E171."
                                            },
                                            {
                                                "example_id": "a57e55e2-c99b-41fd-8b9d-759fa4df74e3",
                                                "sense_id": "073f39fe-6735-3f2d-bf0a-b60f3cabd2c4",
                                                "text": "Rio Tinto Fer et Titane construit une usine de 9 millions de dollars pour produire 3 tonnes d’oxyde de scandium par année. Le procédé utilise les sous-produits issus de la production de dioxyde de titane."
                                            },
                                            {
                                                "example_id": "7865c6cb-6528-4f36-ac18-d72a3a10f7a8",
                                                "sense_id": "073f39fe-6735-3f2d-bf0a-b60f3cabd2c4",
                                                "text": "Limitez notamment l’oxyde de zinc et le dioxyde de titane dans la composition du produit choisi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
