                "forms": [
                    {
                        "form_id": "1709b065-735f-45d2-ab1c-e6fd4e0c8ab9",
                        "entry_id": "2514783e-d3c1-3376-a5ed-ce85e66fd1ce",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "royalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0ae47834-58f7-30c7-9ddb-5997ddc25eee",
                        "entry_id": "2514783e-d3c1-3376-a5ed-ce85e66fd1ce",
                        "glosses": [
                            "Qui soutient le gouvernement d’une reine ou d’un roi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1140020-9fe3-43a7-b681-8cd83c504e42",
                                "sense_id": "0ae47834-58f7-30c7-9ddb-5997ddc25eee",
                                "text": "[…] ; puis des délégations du faubourg, où Roumestan est adoré pour ses convictions royalistes, des députations d’ourdisseuses s’en vont par bandes dans toute la largeur du boulevard, la tête hardie sous le ruban arlésien."
                            },
                            {
                                "example_id": "d272fcfa-82d0-4432-a757-f94ef091f8c7",
                                "sense_id": "0ae47834-58f7-30c7-9ddb-5997ddc25eee",
                                "text": "Friand de la lame il s’est, sous la Restauration, aligné, une douzaine de fois, aux côtés des « brigands de la Loire » en face des gentilshommes royalistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "de070cea-2a3c-339d-9dc2-5949c8eab9ab",
                        "entry_id": "2514783e-d3c1-3376-a5ed-ce85e66fd1ce",
                        "glosses": [
                            "Qui soutient les valeurs de Ségolène Royal."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a8f7e896-8ce7-3c09-8df5-b2b9dc83c7cf",
                "word": "royaliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "353ea833-f333-46c7-9c87-8d84eb6dfad9",
                        "entry_id": "a8f7e896-8ce7-3c09-8df5-b2b9dc83c7cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "royalistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c829c3b-18fb-31ab-8278-c6f87840d6e7",
                        "entry_id": "a8f7e896-8ce7-3c09-8df5-b2b9dc83c7cf",
                        "glosses": [
                            "Personne partisane de la monarchie et du royalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a951b00-e1a9-44b4-90fe-61b041643ecc",
                                "sense_id": "6c829c3b-18fb-31ab-8278-c6f87840d6e7",
                                "text": "Les royalistes inaugurèrent leurs triomphes dans l’Ouest par d’épouvantables tueries."
                            },
                            {
                                "example_id": "370172cd-8730-40bb-b8ee-89a79dfa0673",
                                "sense_id": "6c829c3b-18fb-31ab-8278-c6f87840d6e7",
                                "text": "Les royalistes n'étaient pas fâchés que quelqu'un — fût-ce une enfant — se montrât, vis-à-vis des traîneurs de sabres impériaux, plus sévères que leurs rois."
                            },
                            {
                                "example_id": "c0ce6bf7-41d4-45c2-bf11-b6f718ecc2f1",
                                "sense_id": "6c829c3b-18fb-31ab-8278-c6f87840d6e7",
                                "text": "Une position qui ne satisfait ni les militants du MNR ni ceux du FN, qui rassemblent des gens de « sensibilités différentes » et mélangent des catholiques traditionalistes, des anciens de l’OAS, des royalistes, des racialistes, des paganistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f370fc22-47f6-37e0-9e8f-203e5b8bae24",
                        "entry_id": "a8f7e896-8ce7-3c09-8df5-b2b9dc83c7cf",
                        "glosses": [
                            "Personne partisane de la politicienne Ségolène Royal."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "9ec19d89-81a1-47cc-a0cd-41415cfa71d6",
                                "sense_id": "f370fc22-47f6-37e0-9e8f-203e5b8bae24",
                                "text": "C’est pourquoi la mise en parallèle de l’émeute électorale du 29 mai 2005 et de la sédition royaliste de 2006-2007 s’impose. Il importe peu que Ségolène Royal ait préconisé le oui au fameux référendum : beaucoup de partisans du non se reconnaissaient dans sa démarche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adf380e2-8163-45c0-a535-a970d816dcd6",
                        "source_entry_id": "a8f7e896-8ce7-3c09-8df5-b2b9dc83c7cf",
                        "source_sense_description": "Partisan de la monarchie",
                        "target_lang_word": "royalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "royalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10358c07-9b5c-314d-9057-c799f3335e77",
                                        "entry_id": "c735c410-f52c-30df-afb5-9effd69ab6b5",
                                        "glosses": [
                                            "royalistic"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ac411c-804e-459f-af50-15d7074832fd",
                                                "sense_id": "10358c07-9b5c-314d-9057-c799f3335e77",
                                                "text": "For a time, it was the only Royalist stronghold between London and Exeter, but it fell at last when a member of the garrison turned traitor and admitted the Parliamentary besiegers who destroyed it with gunpowder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "royalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb23abe4-c03b-3f55-9b48-19f1e671a660",
                                        "entry_id": "b85e9bb9-f6d3-3482-8279-cae25c9967a7",
                                        "glosses": [
                                            "A monarchist (supporter of monarchy) or supporter of a particular royal régime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f76262d-0113-3939-b635-b893028abb8a",
                                        "entry_id": "b85e9bb9-f6d3-3482-8279-cae25c9967a7",
                                        "glosses": [
                                            "A legitimist, a supporter of a particular royal line, especially one in danger of being dispossessed of a throne or actually dispossessed of such, and claiming to have the better claim to the throne on the basis of line of descent; especially:",
                                            "a Cavalier, a supporter of King Charles I of England during the English Civil War."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d5438fd-f707-3d9d-8077-014910156a96",
                                        "entry_id": "b85e9bb9-f6d3-3482-8279-cae25c9967a7",
                                        "glosses": [
                                            "A legitimist, a supporter of a particular royal line, especially one in danger of being dispossessed of a throne or actually dispossessed of such, and claiming to have the better claim to the throne on the basis of line of descent; especially:",
                                            "a supporter of the House of Bourbon, in France since the 18th century and especially during the French Revolution."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59fee887-01bf-35aa-8618-986a03e43ad3",
                                        "entry_id": "b85e9bb9-f6d3-3482-8279-cae25c9967a7",
                                        "glosses": [
                                            "A legitimist, a supporter of a particular royal line, especially one in danger of being dispossessed of a throne or actually dispossessed of such, and claiming to have the better claim to the throne on the basis of line of descent; especially:",
                                            "a supporter of Ferdinand VII of Spain in Spanish South America during the South American Wars of Independence of the 1810s and 1820s."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
