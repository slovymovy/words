                "senses": [
                    {
                        "sense_id": "bc1b5d7e-e5ff-325e-918c-5f406a941b01",
                        "entry_id": "fb27e2ae-e187-3bb3-a693-81b67d0b5bc0",
                        "glosses": [
                            "Qualifie les vertus principales telles que définies par les théologues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d22773d-b02f-4c86-b318-df57645db61a",
                                "sense_id": "bc1b5d7e-e5ff-325e-918c-5f406a941b01",
                                "text": "Le fantôme qui nous accompagne est vraiment un fantôme de raison : on peut le chasser en l’aspergeant avec l’eau bénite de la première vertu théologale."
                            },
                            {
                                "example_id": "54818e2b-70c7-4c81-b5bf-52129692a059",
                                "sense_id": "bc1b5d7e-e5ff-325e-918c-5f406a941b01",
                                "text": "La fierté, toujours la fierté ! Qu’est-ce que c’est, d’abord ? Je n’avais jamais pensé que la fierté fût une des vertus théologales…"
                            },
                            {
                                "example_id": "39dc8b8a-2df4-4997-bdbd-a8aa085b4ba0",
                                "sense_id": "bc1b5d7e-e5ff-325e-918c-5f406a941b01",
                                "text": "Cette statuette, moulée sur une des Vertus théologales de Notre-Dame de Brou, si ingénue et si gracieuse dans son état naturel, fait maintenant des contorsions et me tire la langue."
                            }
                        ]
                    }
                ],
