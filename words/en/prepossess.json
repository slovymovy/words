                    "frequency": "VeryLow",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was entirely <w>prepossessed</w> with worries about the upcoming examination."
                        },
                        {
                            "text": "Ancient superstitions continue to <w>prepossess</w> the minds of the isolated villagers."
                        }
                    ],
                    "synonyms": [
                        "preoccupy",
                        "obsess"
                    ],
                    "common_phrases": [
                        "prepossessed with"
                    ],
                    "traits": [
