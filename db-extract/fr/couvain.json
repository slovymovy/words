                                "target_senses": [
                                    {
                                        "sense_id": "afdd3741-d2bb-3501-960d-cd4c9616cf3b",
                                        "entry_id": "0ef6818e-b834-3d01-a6ee-73cd6a92e049",
                                        "glosses": [
                                            "Vorgang des Brütens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c68ca879-0984-4d4e-8cdb-aef8f61f856f",
                                                "sense_id": "afdd3741-d2bb-3501-960d-cd4c9616cf3b",
                                                "text": "„Das Nest wird für das Gelege, die Brut, die Speicherung von Futter und zum Schutz der Nestlinge während der Aufzucht verwandt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01c85f46-7099-3f96-88ac-9d2201c1d4ed",
                                        "entry_id": "0ef6818e-b834-3d01-a6ee-73cd6a92e049",
                                        "glosses": [
                                            "Gelege und Nachkommenschaft von Vögeln, Fischen, Reptilien und Insekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bff491d-aa7c-4c35-b5c0-1098396861a5",
                                                "sense_id": "01c85f46-7099-3f96-88ac-9d2201c1d4ed",
                                                "text": "„Im Sinne dieses Bundesgesetzes ist: 1. »Bienenvolk« die Gesamtheit der in einer Bienenwohnung (Beute) lebenden Bienen mit ihrer Brut und ihren Waben; …“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8320fe9e-4e8e-3be8-978b-fbc70d803002",
                                        "entry_id": "0ef6818e-b834-3d01-a6ee-73cd6a92e049",
                                        "glosses": [
                                            "Pack"
                                        ],
                                        "tags": [
                                            "pejorativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b2f071c-0199-415a-ad97-ecb0a0381b01",
                                                "sense_id": "8320fe9e-4e8e-3be8-978b-fbc70d803002",
                                                "text": "„Dieser hatte im März - mitten im Europa- und Kommunalwahlkampf - bei einer Veranstaltung zum bundesweiten Projekt ‚Schule ohne Rassismus - Schule mit Courage‘ vor einem Wiedererstarken der ‚braunen Brut‘ gewarnt und die NPD-Anhänger als ‚Wiedergänger der alten Nazis‘ bezeichnet.“"
                                            },
                                            {
                                                "example_id": "cf2c071f-e898-49e7-9e17-878e496b12e5",
                                                "sense_id": "8320fe9e-4e8e-3be8-978b-fbc70d803002",
                                                "text": "„Die schlimmste Brut von Gläubigen waren weiße Evagelikale.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
