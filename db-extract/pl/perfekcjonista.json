                "translations": [
                    {
                        "translation_id": "3377ef8f-3ea5-48f0-b0ec-cec1a3260347",
                        "source_entry_id": "329f2ba1-fd8c-3e91-9485-d0f03a121e59",
                        "source_sense_id": "d2fd756c-cb5e-3b9d-8e48-415f29f2631c",
                        "target_lang_word": "perfectionist",
