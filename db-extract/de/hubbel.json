                "senses": [
                    {
                        "sense_id": "51f3f3ea-7666-37c2-9e2b-1d242bf907eb",
                        "entry_id": "2153f4b7-26ec-388a-b797-993a7cb05420",
                        "glosses": [
                            "unebene Stelle, kleine Ausbuchtung in einer Oberfläche"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "5df7487e-d5c2-4e4b-95ca-a0b81995481e",
                                "sense_id": "51f3f3ea-7666-37c2-9e2b-1d242bf907eb",
                                "text": "„Der Roller rollt, aber ich spüre jeden Hubbel, jeden Stein. Keine gemütliche Spazierfahrt.“"
                            },
                            {
                                "example_id": "64f67e1e-5091-4d29-8113-15761da56b6c",
                                "sense_id": "51f3f3ea-7666-37c2-9e2b-1d242bf907eb",
                                "text": "„Dieser kleine Hubbel würde eines Tages zu Bobbys Bruder oder Schwester werden.“"
                            },
                            {
                                "example_id": "8766367b-52cf-4971-b3af-afd27fd0f838",
                                "sense_id": "51f3f3ea-7666-37c2-9e2b-1d242bf907eb",
                                "text": "„Ich spürte die Hubbel des unebenen Rasens unter meinem Po.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd2b4c2c-dfc7-3393-8cb5-7ec8db63853e",
                        "entry_id": "2153f4b7-26ec-388a-b797-993a7cb05420",
                        "glosses": [
                            "kleine Erhöhung im Gelände"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "9cf4b2d4-7e03-4152-94dc-ddbf74e64916",
                                "sense_id": "dd2b4c2c-dfc7-3393-8cb5-7ec8db63853e",
                                "text": "Selbst wenn du noch so unsportlich bist, schaffst du es bestimmt auf diesen Hubbel hinauf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
