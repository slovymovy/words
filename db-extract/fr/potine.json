                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "91764337-b3cf-38c9-8ed8-a78a481691f6",
                        "entry_id": "08d123b0-d660-3b87-8131-cd4c8baa036f",
                        "glosses": [
                            "Sorte de terrine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41584210-9528-4370-864e-9743033ceb20",
                                "sense_id": "91764337-b3cf-38c9-8ed8-a78a481691f6",
                                "text": "Pour faire cuire la potine, il est préférable de luter le couvercle à la farine et à l’eau."
                            },
                            {
                                "example_id": "10c8549b-b908-4c05-ad80-77114335e74c",
                                "sense_id": "91764337-b3cf-38c9-8ed8-a78a481691f6",
                                "text": "Les potines de lapin avaient succédé aux chapons farcis, les tartes Tatin aux clafoutis"
                            }
                        ]
                    }
