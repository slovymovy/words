                                        "sense_id": "ff50572e-959b-3cd0-95c3-4bffa915d74a",
                                        "entry_id": "f58f69a4-de56-3a71-bc6f-42df53ea438e",
                                        "glosses": [
                                            "A rare, black and white mammal, Ailuropoda melanoleuca, in the ursid (bear) family."
                                        ],
