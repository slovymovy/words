                            {
                                "target_lang_word": "riverbed",
                                "target_lang_sense_clarification": "channel bottom of a river"
                            },
                            {
                                "target_lang_word": "bed",
                                "target_lang_sense_clarification": "bottom of a watercourse"
                            }
                        ]
                    }
                }
            ]
        }
