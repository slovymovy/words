    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae4f3328-9a6b-3223-8391-93d8df6137a7",
                    "sense_definition": "Mettre au monde un enfant, lui donner la vie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "naissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de travail à la maternité, elle a enfin <w>accouché</w> d'une fille en parfaite santé."
                        },
                        {
                            "text": "Elle a fait le choix d'<w>accoucher</w> à domicile en présence d'une sage-femme expérimentée."
                        }
                    ],
                    "synonyms": [
                        "donner naissance",
                        "enfanter",
                        "mettre au monde"
                    ],
                    "common_phrases": [
                        "accoucher d'un garçon",
                        "accoucher à domicile"
                    ]
                },
                {
                    "sense_id": "ee988fe0-209c-3b86-ab56-1663f98b25f8",
                    "sense_definition": "Aider ou assister une femme au moment de mettre au monde son enfant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin de garde a dû <w>accoucher</w> une femme arrivée en urgence à l'hôpital."
                        },
                        {
                            "text": "Cette sage-femme dévouée a <w>accouché</w> des centaines de mères au cours de sa carrière."
                        }
                    ],
                    "common_phrases": [
                        "accoucher une femme"
                    ]
                },
                {
                    "sense_id": "340a80e2-3e9a-38bc-af1c-8e3baf41bd92",
                    "sense_definition": "Produire ou faire aboutir péniblement un ouvrage, une idée ou un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des nuits de travail acharné, l'équipe a enfin <w>accouché</w> d'un projet remarquable."
                        },
                        {
                            "text": "Les négociateurs ont <w>accouché</w> d'un compromis fragile après une longue semaine de réunions."
                        }
                    ],
                    "common_phrases": [
                        "accoucher d'une idée",
                        "accoucher d'un projet"
                    ]
                },
                {
                    "sense_id": "c60b8fc8-b51b-3b52-9677-1984a1f6fb19",
                    "sense_definition": "Finir par dire ou avouer ce que l'on hésitait à exprimer ou dissimulait.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de tergiverser et <w>accouche</w>, nous n'avons pas toute la journée devant nous !"
                        },
                        {
                            "text": "Le témoin a fini par <w>accoucher</w> et a révélé la cachette des complices aux inspecteurs."
                        }
                    ],
                    "synonyms": [
                        "balancer",
                        "cracher le morceau"
                    ],
                    "common_phrases": [
                        "allez accouche"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
        }
    ]
