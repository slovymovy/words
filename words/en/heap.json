                    "sense_definition": "Used to mean very or much, often in a stereotypical or dated context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old book contained the phrase <w>heap</w> big chief.",
                            "target_lang_translations": {
                                "cs": "Ve staré knize se objevilo spojení <w>moc</w> velký náčelník."
                            }
                        },
                        {
                            "text": "This usage is considered offensive and is <w>heap</w> outdated.",
                            "target_lang_translations": {
                                "cs": "Toto užití je považováno za urážlivé a je <w>velmi</w> zastaralé."
