                        ],
                        "form": "der Erdkugel"
                    },
                    {
                        "form_id": "e80449e9-ed41-435e-94c2-a2c8579c2285",
                        "entry_id": "c959669a-2bfb-3488-ba6c-4061fc6d6ab9",
                        "tags": [
                            "dative",
