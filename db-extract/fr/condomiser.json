                ],
                "senses": [
                    {
                        "sense_id": "4dc2b3cb-c951-36b6-8050-aef8f1d27c72",
                        "entry_id": "f84d3c07-2f70-33dd-a95f-d2ac4fc8dcf5",
                        "glosses": [
                            "Protéger en utilisant un préservatif."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e6f8a596-ac27-4716-be76-e12e58c6914d",
                                "sense_id": "4dc2b3cb-c951-36b6-8050-aef8f1d27c72",
                                "text": "Je suis pute et pour toi médecin ou lologue tous azimuts, je suis objet à assainir, à désintoxiquer, à désengrosser, à « condomiser »."
                            },
                            {
                                "example_id": "35352af7-47b6-45fc-85b1-8ffd59fe9c33",
                                "sense_id": "4dc2b3cb-c951-36b6-8050-aef8f1d27c72",
                                "text": "Les parents n’étaient pas en reste, surveillant leurs rejetons du coin de l’œil, amusés par cette curiosité remarquable, égarée parmi le catalogue des véhicules proprets et conforme au monde sanglé, airbagué, standardisé, condomisé, dans des carrosseries sans rayures, sans gloire, et sans nicotine, dont l’ultime conquête aura été l’extinction et la mise à mort des cendriers."
                            }
                        ]
                    }
                ],
