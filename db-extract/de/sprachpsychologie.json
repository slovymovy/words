                "senses": [
                    {
                        "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                        "entry_id": "86742724-1398-34e8-935c-23a25dfd55fb",
                        "glosses": [
                            "Fächerübergreifendes Forschungsgebiet, in dem Linguisten, Psychologen, Mediziner etc. die Sprachverarbeitung durch Sprecher (Schreiber) und Hörer (Leser) ebenso wie auch den Spracherwerb (Erstspracherwerb/Zweitspracherwerb) erforschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd01fab7-e6e4-41e7-95b4-49a1d458787c",
                                "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                                "text": "„Die Sprachpsychologie oder Psycholinguistik zielt auf eine wissenschaftliche Beschreibung nicht der Sprache, sondern des Prozesses der Sprachbenutzung.“"
                            },
                            {
                                "example_id": "e9192e34-b01c-4236-893b-af18293c841e",
                                "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                                "text": "„In allererster Annäherung formuliert, geht es der Sprachpsychologie bekanntlich um denjenigen Ausschnitt des menschlichen Handelns, den man Sprechen, Schreiben und so fort nennt.“"
                            },
                            {
                                "example_id": "ee5f9cac-b239-4cac-b45d-04fe37e3a0be",
                                "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                                "text": "Hauptgegenstände der Sprachpsychologie sind Spracherwerb, Sprachproduktion und Sprachrezeption."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "631811ac-3849-42ed-a297-9e2ad0d8910b",
                        "source_entry_id": "86742724-1398-34e8-935c-23a25dfd55fb",
                        "source_sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                        "target_lang_word": "psycholinguistics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psycholinguistics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                                        "entry_id": "5a7fa93a-183b-332c-8042-3ddf57ca71ad",
                                        "glosses": [
                                            "The interdisciplinary field of study which concerns the acquisition, comprehension and production of language in its spoken, written and signed forms, using concepts and approaches from linguistics, psychology and cognitive science."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9587d5-6749-42a8-b512-8b474d3a149c",
                                                "sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                                                "text": "Psycholinguistics is mainly concerned with the mechanisms by which language is processed and represented in the mind and brain: i.e., the psychological and neurobiological factors that enable humans to acquire, comprehend, produce and use language."
                                            },
                                            {
                                                "example_id": "a5fa516d-619b-4b97-af35-f805c8c9571f",
                                                "sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                                                "text": "Psycholinguistics began with attempts to test the empirical validity of various formal linguistic concepts."
                                            },
                                            {
                                                "example_id": "3c93b961-01de-444e-b3fd-fde0c4fce0b3",
                                                "sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                                                "text": "2006, Nobuhiro Furuyama, 44: Language and gesture as a single communicative system, Mineharu Nakayama, Reiko Mazuka, Yasuhiro Shirai, Ping Li (editors), The Handbook of East Asian Psycholinguistics, Volume 2: Japanese, Cambridge University Press, page 333,\nSpeech-gesture research is one of the emerging fields in psycholinguistics that, by referring to speech-accompanying gestures, attempts to elucidate the underlying process in which qualitatively different types of thinking, e.g. imagistic thinking and linguistic thinking, become coordinated with one another."
                                            },
                                            {
                                                "example_id": "43450230-6cc1-4d57-9a67-32d0f4a431bb",
                                                "sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                                                "text": "The seeds for work on processing have their roots in early L2 research, but the psycholinguistics of SLA didn't really take off until the 1990s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
