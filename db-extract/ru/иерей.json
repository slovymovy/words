                        ]
                    },
                    {
                        "translation_id": "a861b2e2-6fba-4ec2-9040-bd79f1221ec5",
                        "source_entry_id": "db80b89f-7a77-3326-aa77-7ef37f9b76b4",
                        "source_sense_id": "9518cefd-40f1-3327-94a4-2f2eef694858",
                        "target_lang_word": "hierofanta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a1f805eb-19fa-4c9a-9bf2-c6792cbd5261",
                        "source_entry_id": "db80b89f-7a77-3326-aa77-7ef37f9b76b4",
                        "source_sense_id": "9518cefd-40f1-3327-94a4-2f2eef694858",
                        "target_lang_word": "Priester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Priester",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ae542ea-c065-3622-b19a-d686fd5ccb1b",
                                        "entry_id": "1e62bcd2-281b-313d-bc6b-6dc9ac2eb7e9",
                                        "glosses": [
                                            "Mittler zwischen dem menschlichen und göttlichen Bereich, zum Beispiel durch Opfer"
                                        ],
                                        "tags": [
                                            "Religionsgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9fa4c0a-0905-475f-8a67-cb7de33e3f3c",
                                                "sense_id": "1ae542ea-c065-3622-b19a-d686fd5ccb1b",
                                                "text": "Die ägyptischen Priester waren hoch angesehen."
                                            },
                                            {
                                                "example_id": "8b1ee45e-a616-4924-982b-fe3b86dd7a5f",
                                                "sense_id": "1ae542ea-c065-3622-b19a-d686fd5ccb1b",
                                                "text": "„Der Priester als Mittler zwischen Mensch und göttlicher Welt findet sich auch heute noch bei Kulturen mit Ackerbau und Viehzucht (zu denen die Kelten gehörten), während der Schamane bei den Jägern, Sammlern und Hirtennomaden anzutreffen ist.“"
                                            },
                                            {
                                                "example_id": "29cd2fc9-6310-4ee0-bbb6-5d1ebddb283c",
                                                "sense_id": "1ae542ea-c065-3622-b19a-d686fd5ccb1b",
                                                "text": "„Die dargestellten Personen tragen eindeutig keltische Kleidung, eine Szene stellt wahrscheinlich Opferhandlungen mit einem Priester dar.“"
                                            },
                                            {
                                                "example_id": "9da5938e-8d58-45ac-9aec-46c08eb8102f",
                                                "sense_id": "1ae542ea-c065-3622-b19a-d686fd5ccb1b",
                                                "text": "„Der Arzt sieht den Menschen in seiner ganzen Schwäche, der Advokat in seiner ganzen Schlechtigkeit und der Priester in seiner ganzen Dummheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "12430f78-678a-30f2-b2bd-6539233d5bda",
                                        "entry_id": "1e62bcd2-281b-313d-bc6b-6dc9ac2eb7e9",
                                        "glosses": [
                                            "Amtsträger in der Kirche, dauerhaft bestellt durch die Priesterweihe"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a790eef-7bb1-4188-b558-295025b24b41",
                                                "sense_id": "12430f78-678a-30f2-b2bd-6539233d5bda",
                                                "text": "„Der Arzt sieht den Menschen in seiner ganzen Schwäche, der Advokat in seiner ganzen Schlechtigkeit und der Priester in seiner ganzen Dummheit.“"
                                            },
                                            {
                                                "example_id": "5f29b311-b083-415a-a232-332dc59539fd",
                                                "sense_id": "12430f78-678a-30f2-b2bd-6539233d5bda",
                                                "text": "Als Priester kann man Pfarrer werden."
                                            },
                                            {
                                                "example_id": "caf4068c-9094-470c-a480-a4033c75793f",
                                                "sense_id": "12430f78-678a-30f2-b2bd-6539233d5bda",
                                                "text": "„Es nützte nichts, weder der Priester noch sonst jemand vermochte ihn davon abzubringen, daß ich nicht sein Diener, sondern sein Sklave sei…“"
                                            },
                                            {
                                                "example_id": "b44e075a-fcd0-47e1-958e-4229cbc99e19",
                                                "sense_id": "12430f78-678a-30f2-b2bd-6539233d5bda",
                                                "text": "„Der Priester ist nicht gekommen.“"
                                            },
                                            {
                                                "example_id": "344e5cb2-63e4-4c0c-8231-ffec84eeda5f",
                                                "sense_id": "12430f78-678a-30f2-b2bd-6539233d5bda",
                                                "text": "„Dieser Mann konnte nicht schreiben; aber er schämte sich dessen nicht, denn mit Ausnahme des Priesters und eines Wundarztes besaß niemand im Regiment diese Fertigkeit.“"
                                            },
                                            {
                                                "example_id": "6bea9c30-d48d-40b8-bd8d-b807a478ce55",
                                                "sense_id": "12430f78-678a-30f2-b2bd-6539233d5bda",
                                                "text": "„Mochten Adam, Eva (»Heua« bei Luther), Noah und ihr Schöpfer Deutsch gesprochen haben oder nicht, die Priester an den Altären, die Gelehrten auf den Kathedern und die Studenten am Biertisch sprachen Latein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a895e293-cff0-4024-a327-71f36ffd5475",
                        "source_entry_id": "db80b89f-7a77-3326-aa77-7ef37f9b76b4",
                        "source_sense_id": "9518cefd-40f1-3327-94a4-2f2eef694858",
                        "target_lang_word": "prêtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prêtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                        "entry_id": "51881c19-d688-3f80-8fe4-f770ab279057",
                                        "glosses": [
                                            "Celui qui exerce une fonction sacrée et qui préside aux cérémonies d’un culte religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeba3851-cf86-4fd1-9e05-aee0b03d6fbe",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "Quand un prêtre dit : \"Adorez Dieu, soyez juste, indulgent, compatissant\", c'est alors un très bon médecin. Quand il dit : \"Croyez-moi, ou vous serez brûlé\", c'est un assassin."
                                            },
                                            {
                                                "example_id": "2fcdb4ca-9417-4c86-808a-d987a953d063",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "Nouer des relations amicales dans une paroisse d’expatriés qui perd et accueille constamment de nouveaux membres suppose de surmonter une barrière culturelle autant que linguistique, difficulté dont les autorités anglophones de la cathédrale ne semblent pas toujours conscientes : l’évêque, la prêtre assistante et le membre du conseil paroissial extérieur à Lambda que j’ai rencontrés ont tous souligné la très bonne intégration des membres du groupe dans la paroisse, notamment des francophones."
                                            },
                                            {
                                                "example_id": "52255d98-a7f0-4559-b16c-78a69b16b7c5",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "On ouvrit la séance par un sacrifice à Cérès. Des prêtres immolèrent un jeune cochon, et de son sang purifièrent l'enceinte."
                                            },
                                            {
                                                "example_id": "a8e04324-d01b-4236-8d67-e90333f7d646",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "Prêtres, ex-nobles, créanciers, chacun dans un intérêt différent, loyal chez les uns, cupide chez les autres, aveugle chez la plupart, tous enfin conspirèrent l’union de Bernard Bryond avec Henriette Lechantre."
                                            },
                                            {
                                                "example_id": "c2aa3108-ac2a-4ac6-90e8-315a6ebafb52",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "VAGNER.\nPardonnez ! Je vous entendais déclamer ; vous lisez sûrement une tragédie grecque, et je pourrais />profiter dans cet art, qui est aujourd’hui fort en faveur. J’ai entendu dire souvent qu’un comédien peut en remontrer à un prêtre.\nFAUST.\nOui, si le prêtre est un comédien, comme il peut bien arriver de notre temps."
                                            },
                                            {
                                                "example_id": "03fcd6a8-dfb2-4991-b23f-db1688f92e29",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "L’approche de la nuit, et le désir si naturel de prolonger ma vie, m’avait fait recourir à cet expédient, connaissant le pouvoir que les prêtres exercent sur l’esprit de toutes les nations barbares."
                                            },
                                            {
                                                "example_id": "2bca5283-5bbf-4265-9b1d-ec9bcc9f50aa",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "M. Lerambert, qui fait, comme moi, sa tournée, est aussi très frappé de cet ascendant du clergé. Les prêtres sont les véritables maîtres en province. Druides sous César, évêques sous Clovis, Pépin, Hugues Capet, Louis le Gros, plus tard si puissants sous Louis XIV et Napoléon, ils tiennent toujours la France."
                                            },
                                            {
                                                "example_id": "21c95c84-5046-419d-81ca-67e4ce51dee8",
                                                "sense_id": "360765ef-740e-3177-ac5d-f4f6fca98665",
                                                "text": "Le culte zoroastrique, organisé par une caste de prêtres au pouvoir quasi souverain, consistait en purifications qui se déroulaient autour du feu sacré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                        "entry_id": "51881c19-d688-3f80-8fe4-f770ab279057",
                                        "glosses": [
                                            "Celui qui, dans l’Église catholique romaine ou dans l’Église vieille--catholique, a reçu l’ordre du sacerdoce, en vertu duquel il a le pouvoir de dire la messe et d’administrer les sacrements."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45f683ab-13c1-447f-adac-db2a1f10df1e",
                                                "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                                "text": "Elle ne suivait aucune pratique religieuse. Pour elle, un prêtre était un fonctionnaire public dont l'utilité lui paraissait contestable."
                                            },
                                            {
                                                "example_id": "795cf529-1096-432c-a128-67f71ab4fcf8",
                                                "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                                "text": "Sur l'autel, et au-dessous du portrait, était le coffret qui renfermait les ferrets de diamants. Le duc s'approcha de l'autel, s'agenouilla comme eût pu faire un prêtre devant le Christ; puis il ouvrit le coffret."
                                            },
                                            {
                                                "example_id": "6b689c30-bfc9-49cf-80ee-cee53c9c6ebe",
                                                "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                                "text": "Les farouches Vendéens, excités par la voix de leurs prêtres, par les discours des ministres du Dieu de miséricorde, égorgeaient, brûlaient vifs, enterraient vivants les républicains qui tombaient entre leurs mains."
                                            },
                                            {
                                                "example_id": "08d42dfb-b422-418b-affa-b1ad2d18d628",
                                                "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                                "text": "Encore aujourd'hui, le diocèse de Rodez est, de tous, celui qui fournit le plus grand nombre de prêtres, le plus grand nombre de missionnaires."
                                            },
                                            {
                                                "example_id": "40f35079-4596-49c3-b637-5132bd6bbddf",
                                                "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                                "text": "Des prêtres prêchaient que les malheurs du pays étaient la conséquence des hérésies et de la négligence des devoirs religieux."
                                            },
                                            {
                                                "example_id": "e500ccf0-46a0-4030-bd53-1fcbe36aea56",
                                                "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                                "text": "Intérieurement, le prêtre se réjouissait : il allait regrouper ses ouailles pas tellement impies, en vérité."
                                            },
                                            {
                                                "example_id": "ed651ee3-ace9-4b36-a1ec-cce684a6eda0",
                                                "sense_id": "28385e67-a0c0-34fe-8f21-3fc885d0ddc1",
                                                "text": "Baptisée Église catholique chrétienne en Suisse, l’Église vieille-catholique s’est scindée de Rome dans les années 1870. Elle autorise le mariage des prêtres, l’ordination des femmes et le mariage des homosexuels et gens divorcés. Micheline Schobbens est la première Belge prêtre ordonnée par cette Église. Depuis octobre 2022, elle dit la messe, marie, baptise, confirme et pratique tous les autres sacrements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "934be015-61d3-3198-a685-212520116274",
                                        "entry_id": "51881c19-d688-3f80-8fe4-f770ab279057",
                                        "glosses": [
                                            "Ministre qui était consacré au service du tabernacle du temple, dans la loi juive."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf43e51-0837-4a7c-8405-05e91e2ca807",
                                                "sense_id": "934be015-61d3-3198-a685-212520116274",
                                                "text": "Le grand prêtre de la loi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prêtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52cd2b53-1b6f-3f09-99ad-74fc6e326b62",
                                        "entry_id": "7aba868d-6913-3f78-bce2-eae9afae49d6",
                                        "glosses": [
                                            "Espèce de petit poisson osseux, une athérine de l'Atlantique et de Méditerranée, de nom scientifique Atherina presbyter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4de938dd-58d0-3ea7-9d42-8879ac5a483f",
                                        "entry_id": "7aba868d-6913-3f78-bce2-eae9afae49d6",
                                        "glosses": [
                                            "Nom vernaculaire attribué également à d’autres athérines : joël (Atherina boyeri), sauclet (Atherina hepsetus)."
                                        ],
                                        "tags": [
