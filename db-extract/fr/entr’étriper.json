                        "examples": [
                            {
                                "example_id": "1f9a86a5-af87-40ba-9645-9c416d1c353e",
                                "sense_id": "2b4efc85-c9e9-3849-9de0-c17fe2a60581",
                                "text": "Malheur, car son recrutement ne dépassait guère les rebuts de l'Assistance plus les rejetons du garde-champêtre et du chef de gare, assez pour s'entr'étriper aux carrefours avec nous les galopins calotins à l'aller comme au retour."
                            },
                            {
                                "example_id": "869e17ac-90b3-4867-9883-d635283f7c57",
                                "sense_id": "2b4efc85-c9e9-3849-9de0-c17fe2a60581",
                                "text": "Mais nous pensions aussi que s'ils désiraient vraiment « s'entr'étriper », ils pourraient le faire ailleurs que sur le territoire de la Belgique."
                            }
                        ]
