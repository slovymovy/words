                        }
                    ]
                },
                {
                    "sense_id": "af443788-187f-3565-8ebb-62f84694a7b8",
                    "sense_definition": "A device designed to capture sound waves by engraving them onto a physical medium; a recording lathe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "audio_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early sound engineers used a mechanical <w>phonograph</w> to cut audio grooves directly into wax."
                        },
                        {
                            "text": "Vibrations from the singer's voice moved a diaphragm inside the recording <w>phonograph</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
