                "senses": [
                    {
                        "sense_id": "a7b3eeaa-cf2d-3c10-90ea-f16b2e008936",
                        "entry_id": "e9f27a5b-e580-3b07-a876-d4d15b6d8cc7",
                        "glosses": [
                            "The branch of anthropology that deals with the geographical distribution of the human race in its different divisions, as distinguished by physical character, language, institutions, and customs, in contradistinction to ethnography, which deals historically with the origin and filiation of races and nations."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "64b58cc3-6f50-44b8-89a4-b3dd2951ced5",
                                "sense_id": "a7b3eeaa-cf2d-3c10-90ea-f16b2e008936",
                                "text": "Anthropography should treat of the varieties of the human race, as at present existing, and as determined by those physiological characters in which the best judges agree[…]"
                            }
                        ]
                    }
                ],
