                                        "entry_id": "92b9c1e8-f6ff-3cca-a5b6-dd17ab324283",
                                        "glosses": [
                                            "Einstellung/Zustand, frei von jeglichen Sorgen, Bedenken zu sein, sich nicht über jemanden oder etwas Sorgen, negative Gedanken zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "762e3884-acfa-4d94-8ad2-4d57a4a602c6",
                                                "sense_id": "c111c85d-2f7f-3bb0-9b18-9d366046e451",
                                                "text": "„Eine wunderbare Unbesorgtheit war damit über die Welt gekommen, denn was sollte diesen Aufstieg unterbrechen, was den Elan hemmen, der aus seinem eigenen Schwung immer neue Kräfte zog?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d254af83-8d94-4b8d-9d86-0ef5296788ef",
