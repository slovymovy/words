                ],
                "translations": [
                    {
                        "translation_id": "29ca7a94-534c-47d0-b3ee-7e5be9de9f84",
                        "source_entry_id": "63b4e687-a878-360b-8631-4278f8669530",
                        "source_sense_id": "d30784b1-0d0f-3488-8d26-d43849cd866b",
                        "target_lang_word": "Wasserstrahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserstrahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c85861e-67c0-3630-b6aa-bc23975a051c",
                                        "entry_id": "c63ce994-ee6c-324b-8daa-50c0954a1ddf",
                                        "glosses": [
                                            "aus einer Öffnung unter Druck gebündelt austretendes Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3344ce5a-bb28-4167-b086-a43ce3b37ac3",
                                                "sense_id": "0c85861e-67c0-3630-b6aa-bc23975a051c",
                                                "text": "Er nahm den Schlauch und richtete den Wasserstrahl direkt auf seine Schwester, um sie zu ärgern."
                                            },
                                            {
                                                "example_id": "b646f619-d466-464f-8d0e-cc2da0f797a0",
                                                "sense_id": "0c85861e-67c0-3630-b6aa-bc23975a051c",
                                                "text": "„John Henrys Muskeln schwollen und zuckten, während er sich unter dem kalten Wasserstrahl einseifte.“"
                                            },
                                            {
                                                "example_id": "ba9bcdc9-33e4-40d3-ae67-c32406cf16c1",
                                                "sense_id": "0c85861e-67c0-3630-b6aa-bc23975a051c",
                                                "text": "„Eine Brunnenfigur lenkte aus einem spitz zulaufenden Gefäß einen Wasserstrahl an die eine Seite des Beckens.“"
                                            },
                                            {
                                                "example_id": "74230f4f-a986-4e6c-8ebc-d78c55eea641",
                                                "sense_id": "0c85861e-67c0-3630-b6aa-bc23975a051c",
                                                "text": "„Inmitten des Weihers hatte man eine Klippe gebaut, aus der vier Wasserstrahlen in halber Speerhöhe emporsprühten, um im Absturz wieder in den Weiher zu fallen.“"
                                            },
                                            {
                                                "example_id": "e1a12a66-ee35-42a1-b5d5-eebaf2c97403",
                                                "sense_id": "0c85861e-67c0-3630-b6aa-bc23975a051c",
                                                "text": "„Um den Wasserzufluß in das Innere des Granithauses zu vermehren, wurde der Spalt erweitert, durch den sich ein Wasserstrahl aus dem See in den alten Abfluß ergoß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
