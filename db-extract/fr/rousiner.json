                        "glosses": [
                            "S’activer sans grand résultat."
                        ],
                        "tags": [
                            "Bretagne"
                        ],
                        "examples": [
                            {
                                "example_id": "474adfe1-3572-47e2-b1a8-cc971fcb8aff",
                                "sense_id": "64505638-84e5-3e3f-a3d5-a6c612b4ef22",
                                "text": "Maintenant, je me mets à rousiner, pensa-t-il dès qu’il fut chez lui."
                            },
                            {
                                "example_id": "349bdbd3-2f61-4759-8cd5-fa9ef1b0a8f2",
                                "sense_id": "64505638-84e5-3e3f-a3d5-a6c612b4ef22",
                                "text": "Quand il joua au cow-boy résistant, il n'avait pas les premiers rôles, il rousinait avec l'un l'autre dans la campagne de la poche sud de Saint-Nazaire."
                            }
                        ]
                    }
