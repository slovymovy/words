                        "examples": [
                            {
                                "example_id": "095e6a27-9f8e-4f2f-a496-319d8361a22d",
                                "sense_id": "f7d1ff21-6374-3952-bbf9-b20e36a8b8b9",
                                "text": "„Wurde man beim Warenschmuggel ertappt, gehörte es zum ungeschriebenen Moralkodex des Lagers, den mitbeteiligten SS–Mann nicht preiszugeben.“"
                            },
                            {
                                "example_id": "93b02760-7e8e-4979-9c75-a4ae0be72000",
                                "sense_id": "f7d1ff21-6374-3952-bbf9-b20e36a8b8b9",
                                "text": "„Eine Aktion gegen Warenschmuggel und organisierte Kriminalität im vor allem von Serben bewohnten Teil des Kosovos sorgte für Unruhe.“"
                            },
                            {
                                "example_id": "ad5d3598-6dd9-49c8-9433-ec4ba59a6448",
                                "sense_id": "f7d1ff21-6374-3952-bbf9-b20e36a8b8b9",
                                "text": "„Dutzende von Nationalgardisten stehen an den informellen Grenzübergängen am Fluss, über die seit je reger Warenschmuggel betrieben wird.“"
                            }
                        ],
