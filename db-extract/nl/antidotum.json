                        "source_sense_id": "b87aef3b-48c1-3af2-96cb-a017ae032921",
                        "source_sense_description": "een tegengif",
                        "target_lang_word": "Antidot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antidot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                        "entry_id": "50084bdb-81a2-3d9e-9603-b0b0a8811997",
                                        "glosses": [
                                            "Mittel gegen die Wirkungen einer Vergiftung; Gegengift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c4fd033-14e6-48f9-855a-32ad5af8acaf",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "Die Wirkung des Antidotes ist zu bezweifeln."
                                            },
                                            {
                                                "example_id": "4e649720-e964-4c75-853f-82c85de31d79",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "„Mir war klar, daß es Schwerarbeit sein würde, einen Lastwagen zehn- bis zwölftausend Meilen weit zu fahren, allein und unversorgt, über alle Arten von Straßen, aber für mich stellte es das Antidot gegen das Gift des berufsmäßig kranken Mannes dar.“"
                                            },
                                            {
                                                "example_id": "ce6a0c06-d27a-4052-946f-df1df52a1510",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "„Er verlobt sich, wie er sagt, als Antidot gegen seine Leidenschaft; er bemüht sich, sie zureichend liebenswert zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0dccbfa-128d-4a67-9910-be64234a4f0d",
                        "source_entry_id": "6438c9bb-6a65-36db-82d4-bc520fe935ce",
                        "source_sense_id": "b87aef3b-48c1-3af2-96cb-a017ae032921",
                        "source_sense_description": "een tegengif",
                        "target_lang_word": "Antidoton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antidoton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c2b132e-033e-322f-8b91-ea422338fb08",
                                        "entry_id": "7f2f19b9-6c4d-3b67-8e54-e701b4b6b0ad",
                                        "glosses": [
                                            "Gegenmittel, Gegengift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7519a71c-e3f6-462e-87cd-769e57c2d09a",
                                                "sense_id": "6c2b132e-033e-322f-8b91-ea422338fb08",
                                                "text": "„Wie werden Vergiftungen mit Schwermetallen behandelt? Durch Antidota, die mit dem Schwermetallkation stabile Chelatkomplexe bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62cb9255-a83f-423a-8cf6-04c31c0292c3",
                        "source_entry_id": "6438c9bb-6a65-36db-82d4-bc520fe935ce",
                        "source_sense_id": "b87aef3b-48c1-3af2-96cb-a017ae032921",
                        "source_sense_description": "een tegengif",
                        "target_lang_word": "antidote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "A remedy to counteract the effects of poison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b7735c-1257-4918-9383-3c93a9d7d028",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "She reached the hospital in time to receive the antidote for the snake venom."
                                            },
                                            {
                                                "example_id": "5aac5a50-1006-4105-9e7a-2e3f1ad27857",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "Can'ſt thou not Miniſter to a minde diſeas'd, / Plucke from the Memory a rooted Sorrow, / Raze out the written troubles of the Braine, / And with ſome ſweet Obliuious Antidote / Cleanſe the ſtufft boſome, of that perillous ſtuffe / Which weighes vpon the heart?"
                                            },
                                            {
                                                "example_id": "cdf4ea79-5fc4-4469-b790-6be4dc7f2024",
                                                "sense_id": "dd664e9e-0084-3fe2-b665-368ddf1661ff",
                                                "text": "The druids […] believed that mistletoe could make barren animals fecund, and that it was an antidote to all poisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                        "entry_id": "01d80192-eb6e-309d-af38-f111196a50b8",
                                        "glosses": [
                                            "Something that counteracts or prevents something harmful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2f5e10-8245-404b-ba50-51fbf1181644",
                                                "sense_id": "081c830e-b4ed-355a-94e8-77377901d1ea",
                                                "text": "We need an antidote for this misinformation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antidote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                                        "entry_id": "cae26b1b-59de-3f2f-b169-165bfb9a4c1d",
                                        "glosses": [
                                            "To counteract as an antidote."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e55f23-4124-4643-963c-6d68923f9409",
                                                "sense_id": "4a0c9300-0a89-30a1-975c-8681c8d1e8a9",
                                                "text": "For his part, the patient must avoid some commonplace substances in order to avoid antidoting or stopping the action of the homeopathic remedy[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7b6a50a-05bd-46fa-a695-97111069b533",
                        "source_entry_id": "6438c9bb-6a65-36db-82d4-bc520fe935ce",
                        "source_sense_id": "b87aef3b-48c1-3af2-96cb-a017ae032921",
