                "senses": [
                    {
                        "sense_id": "7e01b72e-a0f8-3da5-8f2d-d20f0d2c0d59",
                        "entry_id": "f2c6a2cd-ba83-3c4d-96fd-c097a12e0e5c",
                        "glosses": [
                            "Occupation préférée, d’importance secondaire par rapport aux activités principales de la vie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d722320-e291-4c14-aab7-72cd75086ef5",
                                "sense_id": "7e01b72e-a0f8-3da5-8f2d-d20f0d2c0d59",
                                "text": "La foi est parfois présentée comme un hobby religieux."
                            },
                            {
                                "example_id": "8c3eb108-e89c-4eac-8dd3-9f0378473407",
                                "sense_id": "7e01b72e-a0f8-3da5-8f2d-d20f0d2c0d59",
                                "text": "UN HOBBY ?\n Comme m’a demandé Vincent Dessureault hier à QUB radio : « Ça prend quoi pour qu’on décide de te garder en dedans parce que tu représentes un danger ? »\n Il faut que tu aies fabriqué 14 bombes, j’imagine...\n Quatorze, on te garde. Treize, on te laisse aller...\n C’est considéré comme un hobby. Comme collectionner des timbres."
                            },
                            {
                                "example_id": "f0416c90-51f0-40a5-9edd-cda056d7b419",
                                "sense_id": "7e01b72e-a0f8-3da5-8f2d-d20f0d2c0d59",
                                "text": "Ce patron d'une PME de pièces détachées automobiles a un hobby. Certains font du tir à l'arc ou collectionnent les grille-pain. Lui essaie de résoudre des disparitions mystérieuses ou des cold cases sur lesquelles la police s'est cassée les dents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "011530b8-8527-48ed-9309-bc058d0c327c",
                        "source_entry_id": "f2c6a2cd-ba83-3c4d-96fd-c097a12e0e5c",
                        "source_sense_id": "7e01b72e-a0f8-3da5-8f2d-d20f0d2c0d59",
                        "target_lang_word": "Hobby",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hobby",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                        "entry_id": "86d04b54-5c4d-369c-82fc-bad40e21ee62",
                                        "glosses": [
                                            "Betätigung, Steckenpferd, Interessengebiet; etwas, das man freiwillig und gerne tut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94e4306-d0a9-4b5b-af35-649f53ebc51b",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "Wenn jemand ganz viel Glück hat, hat er einen Beruf, der zugleich sein Hobby ist."
                                            },
                                            {
                                                "example_id": "0aad44ff-5ced-4f66-98b1-13532b21601f",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "In der Pension kann er endlich seinen Hobbys nachgehen."
                                            },
                                            {
                                                "example_id": "7ae0a110-e374-4131-889e-846dc5589013",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Roger Militon war ein Glücksritter auf der Suche nach einer reichen Frau, die ihm seine Hobbys finanzieren sollte.“"
                                            },
                                            {
                                                "example_id": "7741a0fb-864e-4345-9b5a-4e879ad3f709",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Auch eine Unfallversicherung kann sinnvoll sein, für extravagante Hobbys wie Fallschirmspringen oder Extrembergsteigen sind allerdings Zusatzdeckungen erforderlich.“"
                                            },
                                            {
                                                "example_id": "9dcb23f9-cf3a-4df6-a539-74cae01a97e4",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Hinter dieser Gegebenheit verbirgt sich das Geheimnis, warum Risikosport und Grenzgang, aber auch zahlreiche Sportformen und Hobbies im mittleren Gefahrenbereich Außenstehenden keinen inneren Zugang gewähren.“"
                                            },
                                            {
                                                "example_id": "3ca06733-3d99-4079-9930-785eba5eaa45",
                                                "sense_id": "745637ae-1cc2-35e1-a713-ec62c797bea4",
                                                "text": "„Eine Blondine beschließt, sich für die Wintermonate ein ganz neues Hobby zuzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abab492d-bf08-41f1-a52c-7c8a9360df67",
                        "source_entry_id": "f2c6a2cd-ba83-3c4d-96fd-c097a12e0e5c",
