                            "short-form"
                        ],
                        "form": "окамене́лы"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd6e9ea2-7269-316a-802c-5d4b493219f4",
                        "entry_id": "9ea691c6-9e6b-334e-b818-406c67e0f467",
                        "glosses": [
                            "палеонт. подвергшийся окаменению, превратившийся в камень; окаменевший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67e0e5c8-c590-4ea9-be25-cf9afbf7ccce",
                                "sense_id": "fd6e9ea2-7269-316a-802c-5d4b493219f4",
                                "text": "Окаменелые остатки растений находят повсеместно, даже в Арктике мелового периода."
                            }
                        ]
                    },
                    {
                        "sense_id": "91a93f99-4180-3160-8546-15d08c3edffc",
                        "entry_id": "9ea691c6-9e6b-334e-b818-406c67e0f467",
                        "glosses": [
                            "разг. ставший твёрдым, чёрствым от долгого лежания, высыхания, замерзания и т. п"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a573d283-6d20-4618-8ac1-676caf6d15fa",
                                "sense_id": "91a93f99-4180-3160-8546-15d08c3edffc",
                                "text": "Я иду улицей нашего совхоза, привычно маневрируя между окаменелыми грядами черной грязи, навоза, мусора."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2da897a-7fc5-3953-ba62-af4ad6a83b7c",
                        "entry_id": "9ea691c6-9e6b-334e-b818-406c67e0f467",
                        "glosses": [
                            "перен., книжн. утративший подвижность; также свидетельствующий об утрате подвижности; неподвижный, безжизненный, окаменевший"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0ff889-503b-4885-b45d-31f2c6e9abcc",
                                "sense_id": "e2da897a-7fc5-3953-ba62-af4ad6a83b7c",
                                "text": "Он взялся за стержень темными окаменелыми пальцами и внезапно потянул на себя."
                            },
                            {
                                "example_id": "aca449a1-706b-43ac-8943-830a44e91821",
                                "sense_id": "e2da897a-7fc5-3953-ba62-af4ad6a83b7c",
                                "text": "За бруствером окопа он не мог видеть финна, но, увидев меня в окаменелой позе, спросил, что со мной."
                            }
                        ]
                    },
                    {
                        "sense_id": "80405c69-5ced-3798-9112-0e18712c816a",
                        "entry_id": "9ea691c6-9e6b-334e-b818-406c67e0f467",
                        "glosses": [
                            "перен. ничего не выражающий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b074135-f427-4cb1-853f-7c8b053d02bc",
                                "sense_id": "80405c69-5ced-3798-9112-0e18712c816a",
                                "text": "Окаменелый взгляд."
                            },
                            {
                                "example_id": "65c28891-7c78-477f-800b-fc7d17a00219",
                                "sense_id": "80405c69-5ced-3798-9112-0e18712c816a",
                                "text": "Марианна слушала его с каким-то окаменелым вниманием."
                            }
                        ]
                    },
                    {
                        "sense_id": "7575af05-e37c-3dfc-bcda-d16a79180387",
                        "entry_id": "9ea691c6-9e6b-334e-b818-406c67e0f467",
                        "glosses": [
                            "перен. утративший способность чувствовать, проявлять какие-либо чувства; также обусловленный неспособностью чувствовать; безжалостный, суровый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88dff195-6b7d-468a-bcd7-77660992f055",
                                "sense_id": "7575af05-e37c-3dfc-bcda-d16a79180387",
                                "text": "Разве же не очевидно, что здесь окаменелая психология мещанина провозглашается общим законом человеческого мышления?"
                            },
                            {
                                "example_id": "6de44c9d-7b8e-4049-a5ae-4dbedc4932ee",
                                "sense_id": "7575af05-e37c-3dfc-bcda-d16a79180387",
                                "text": "Для нераскаянных, окаменелых, думаю, нужна бы публичная исповедь перед всей церковью, как в древней церкви."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "950bd5f5-36a6-4b08-b479-30871735290d",
                        "source_entry_id": "9ea691c6-9e6b-334e-b818-406c67e0f467",
                        "source_sense_description": "подвергшийся окаменению, превратившийся в камень",
                        "target_lang_word": "petrified",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petrified",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba436a61-22f0-3c13-a115-94ba6f94e1bf",
                                        "entry_id": "70238022-6323-3cf9-9683-7775495a0472",
                                        "glosses": [
                                            "Having undergone the process of petrification (transformation into a stony substance); turned to stone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf708963-7f95-4541-bea8-a231cf183bb0",
                                                "sense_id": "ba436a61-22f0-3c13-a115-94ba6f94e1bf",
                                                "text": "On Yule-eve alone can petrified Giants receive back their life for the space of seven hours, if one of their race embraces them, and is, at the same time, willing to sacrifice a hundred years of their own life."
                                            },
                                            {
                                                "example_id": "60b21d5b-0fbd-43e8-afe1-c38ab1fef1f3",
                                                "sense_id": "ba436a61-22f0-3c13-a115-94ba6f94e1bf",
                                                "text": "Entering Avebury from any direction is like stepping back into the past. Before the centre of the village is reached, the road passes through an immense circle of brooding stones which stand like petrified ghosts of an age about which little is known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87113368-f39d-301c-9771-34b4b87b29cc",
                                        "entry_id": "70238022-6323-3cf9-9683-7775495a0472",
                                        "glosses": [
                                            "Extremely afraid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
