                ],
                "senses": [
                    {
                        "sense_id": "35ef4bf7-7abb-3f12-9a60-c3d74c962e86",
                        "entry_id": "aedd5a18-c487-3a89-b145-87673ad6e8f1",
                        "glosses": [
                            "Anstalt, an welcher wissenschaftlich geforscht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad9bdd5-28d4-4099-9262-c8caa6214c2b",
                                "sense_id": "35ef4bf7-7abb-3f12-9a60-c3d74c962e86",
                                "text": "„Ein Team der Universität Bremen griff für die Untersuchung zusammen mit anderen Forschungseinrichtungen auf Sedimentproben zurück.“"
                            },
                            {
                                "example_id": "2c8659b3-8893-4d63-9ca2-e22073b86f2b",
                                "sense_id": "35ef4bf7-7abb-3f12-9a60-c3d74c962e86",
                                "text": "Meine Forschungseinrichtung geht mir über alles."
                            },
                            {
                                "example_id": "83642d68-0c17-40bc-97e4-1400635faef0",
                                "sense_id": "35ef4bf7-7abb-3f12-9a60-c3d74c962e86",
                                "text": "„Das Karolinska-Institut gilt als eine der angesehensten Lehr- und Forschungseinrichtungen für Medizin.“"
                            },
                            {
                                "example_id": "c68e825f-842a-4403-8701-00b876a594b1",
                                "sense_id": "35ef4bf7-7abb-3f12-9a60-c3d74c962e86",
                                "text": "„Diese gigantische Sammlung ist nicht nur die größte Sammlung von Medien und Karten der Welt, sondern auch eine der bedeutendsten Forschungseinrichtungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
