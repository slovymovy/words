                        "source_sense_id": "c0039cac-ce3e-31fa-bec1-35bdba41eb12",
                        "source_sense_description": "een luchtvaartuig dat door middel van een hefschroef verticaal kan opstijgen en landen",
                        "target_lang_word": "Hubschrauber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hubschrauber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2cec0b-bb06-3142-a5c8-03efbd9f3392",
                                        "entry_id": "6bbcb75a-4199-3a20-9199-4e0f1dbeee34",
                                        "glosses": [
                                            "Luftfahrzeug, das durch einen oder mehrere waagerechte Rotoren in der Luft gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a34f54-e04e-4c08-8ab4-e1af85552b56",
                                                "sense_id": "2c2cec0b-bb06-3142-a5c8-03efbd9f3392",
                                                "text": "Der Präsident kam mit einem Hubschrauber zur Konferenz."
                                            },
                                            {
                                                "example_id": "47d7e6e8-d3eb-4c5b-9a79-4b4f54843175",
                                                "sense_id": "2c2cec0b-bb06-3142-a5c8-03efbd9f3392",
                                                "text": "„Die US Army vermeldete gemeinsam mit dem Rüstungskonzern Raytheon, erfolgreiche Testversuche mit Laserwaffen in Hubschraubern durchgeführt zu haben.“"
                                            },
                                            {
                                                "example_id": "acf1d270-5b9f-40fb-95a6-6904492a3f7c",
                                                "sense_id": "2c2cec0b-bb06-3142-a5c8-03efbd9f3392",
                                                "text": "„Zwar seien die Einsätze teuer, die dabei verwendete Wärmebildkamera erziele aber so gute Erfolge, dass die Hubschrauber einfach öfter angefordert würden, erklärt Werner Senn, Abteilungsleiter der Flugpolizei im Innenministerium.“"
                                            },
                                            {
                                                "example_id": "08c199c4-8c74-403a-81d0-d473971c91a2",
                                                "sense_id": "2c2cec0b-bb06-3142-a5c8-03efbd9f3392",
                                                "text": "„Um die Bilder präzise zu fotografieren, band sie sich an einen Hubschrauber und schwebte über den Bildern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74e357d4-dd5f-4f00-add3-fdf3bb021e12",
                        "source_entry_id": "e46ec9da-7ced-3a10-aaae-1bd71d9e288f",
                        "source_sense_id": "c0039cac-ce3e-31fa-bec1-35bdba41eb12",
