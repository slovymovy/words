                        "entry_id": "fc08ddb4-a883-3763-b2b7-f6741e36158d",
                        "glosses": [
                            "lekarz specjalista zajmujący się rozpoznawaniem, profilaktyką i leczeniem chorób gruczołów wydzielania wewnętrznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84a7795c-0c86-4696-9362-43ee77b4ce1b",
                                "sense_id": "3e2c4aa6-62a7-3366-8249-2b7dadb202bd",
                                "text": "Po ukończeniu 50 roku życia wizyty u endokrynologa mogą być konieczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3db135ec-b2d9-4111-ace9-bb695f0d3394",
                        "source_entry_id": "fc08ddb4-a883-3763-b2b7-f6741e36158d",
                        "source_sense_id": "3e2c4aa6-62a7-3366-8249-2b7dadb202bd",
                        "target_lang_word": "endocrinologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endocrinologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5995e2b0-ab65-30d9-8918-0d5ae47dba4f",
                                        "entry_id": "ab5b4fd2-afea-3db5-a016-ab0df4d9a1fa",
                                        "glosses": [
                                            "A person who is skilled at, or practices, endocrinology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7522d6e-6222-4c23-8b3a-f9229be0a33a",
                                                "sense_id": "5995e2b0-ab65-30d9-8918-0d5ae47dba4f",
                                                "text": "Some endocrinologists argue that our core understanding of T, as a fundamentally male sex hormone, is inherently flawed."
                                            },
                                            {
                                                "example_id": "132e5498-f494-432e-9f41-fe0239cce136",
                                                "sense_id": "5995e2b0-ab65-30d9-8918-0d5ae47dba4f",
                                                "text": "They standardize the terminology that professionals should use with patients and reaffirms the role that an endocrinologist should play in the patient’s broader individualized care."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "479d4df8-72dd-462b-9fa6-209c80198473",
                        "source_entry_id": "fc08ddb4-a883-3763-b2b7-f6741e36158d",
                        "source_sense_id": "3e2c4aa6-62a7-3366-8249-2b7dadb202bd",
