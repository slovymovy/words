                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "splash",
                                "target_lang_sense_clarification": "to hit or agitate liquid so it disperses"
                            },
                            {
                                "target_lang_word": "splatter",
                                "target_lang_sense_clarification": "to scatter liquid in an uneven mess"
                            },
                            {
                                "target_lang_word": "spatter",
                                "target_lang_sense_clarification": "to splash with small drops"
                            }
                        ]
                    }
                },
                {
