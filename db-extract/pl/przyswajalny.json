                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b2c2aea-24e0-4b26-9387-2492f538560d",
                                "sense_id": "f4a08104-7dfc-361a-b2ca-2b835aaa4c04",
                                "text": "Wapń w tym produkcie jest dobrze przyswajalny."
