                "senses": [
                    {
                        "sense_id": "82514297-2da2-34df-8a90-a438a6b21be6",
                        "entry_id": "cccabccf-cacd-32ca-9a48-f82eabf5f64f",
                        "glosses": [
                            "Qui ne varie pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f04c4e-5bfb-476b-9c47-0e9a00f8bc5c",
                                "sense_id": "82514297-2da2-34df-8a90-a438a6b21be6",
                                "text": "La différentielle totale d'une fonction de plusieurs variables est invariante dans tout changement de variable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7cd627f-2ad3-4a82-9ca1-da0230eb8320",
