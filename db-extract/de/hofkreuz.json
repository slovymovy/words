                ],
                "senses": [
                    {
                        "sense_id": "e79d3388-453d-358a-b2a6-8ef2c605eae1",
                        "entry_id": "cc2d57bc-5733-3cfc-8b3d-5e55983992fe",
                        "glosses": [
                            "privates, gesegnetes Kreuz an einem Hof; zumeist an der öffentlichen Zufahrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0abd9a-e5ee-4237-a7f8-6f44683dea94",
                                "sense_id": "e79d3388-453d-358a-b2a6-8ef2c605eae1",
                                "text": "„Das Hofkreuz der Hofanlage Stotter in der Rinkeroder Bauerschaft Hemmer wird unter Denkmalschutz gestellt und in die Denkmalliste eingetragen.“"
                            },
                            {
                                "example_id": "804f7193-b93f-49a7-8e2d-0cda02e5b0bd",
                                "sense_id": "e79d3388-453d-358a-b2a6-8ef2c605eae1",
                                "text": "„Am 23. September 2006 wurde das Hofkreuz vom Domvikar André Ciszewki im Beisein von Pastor Hermann Bredenbrock und aller Geschwister Lastering mit ihren Ehefrauen geweiht."
                            },
                            {
                                "example_id": "e60c40d3-f4bb-4dbc-a8b9-d06a4eb30d83",
                                "sense_id": "e79d3388-453d-358a-b2a6-8ef2c605eae1",
                                "text": "„Oft gibt es mehrere Gründe für das Aufstellen eines Hofkreuzes, wie auf dem Hof Könning-Hüging in der Raesfelder Bauerschaft Homer geschehen: Johann Könning heiratete im Jahr 1870 Katharina Wenning aus Borkenwirthe.“"
                            },
                            {
                                "example_id": "1c478601-84d5-47ac-ab8f-0bd24f4d0c1b",
                                "sense_id": "e79d3388-453d-358a-b2a6-8ef2c605eae1",
                                "text": "„Seine Frau Ilse und er dagegen wollten ihrer Tochter und ihrem Schwiegersohn ein besonderes Geschenk zur Silberhochzeit machen: Sie stiften dem Hof Langsenkamp in Belm-Vehrte ein Hofkreuz zum Dank, wie der 83-Jährige sagt: „für die gute Entwicklung des Hofes und die vier gesunden Enkelkinder!“ Anlässlich der Bittprozession der Belmer Kirchengemeinde St. Dionysius und St. Josef wurde das Kreuz vor Christi Himmelfahrt eingeweiht.“"
                            },
                            {
                                "example_id": "f0225d13-6a92-46e7-9d83-26b929383dbd",
                                "sense_id": "e79d3388-453d-358a-b2a6-8ef2c605eae1",
                                "text": "„Bei dem Korpus des Hofkreuzes handelt es sich um eine ungewöhnliche, künstlerisch-eigenständige Arbeit aus der 2. Hälfte des 19. Jahrhunderts, die deutlich aus der Masse der zu dieser Zeit entstandenen Hofkreuze herausfällt.“"
                            },
                            {
                                "example_id": "a55ffbb7-ae7e-4bd6-a724-8c0bef1891d4",
                                "sense_id": "e79d3388-453d-358a-b2a6-8ef2c605eae1",
                                "text": "„Die Familie Anton und Irmgard Bawidamann in Nordhausen hat ein Hofkreuz errichtet, das nun feierlich geweiht worden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
