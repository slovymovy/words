                        "glosses": [
                            "A batted ball that travels toward the pitcher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "920e8334-e0f2-42ec-a3df-75949d2a8684",
                                "sense_id": "98744ef4-e740-3229-ae19-7024190a0839",
                                "text": "It's a comebacker past second base for a single."
                            },
                            {
                                "example_id": "2f2d7984-f9de-4d9b-a3cb-3523d071d01e",
                                "sense_id": "98744ef4-e740-3229-ae19-7024190a0839",
                                "text": "The pitcher fields the comebacker and throws it to first for the out."
                            },
                            {
                                "example_id": "26c8cd02-4090-40b4-909f-f6c9cd46affd",
                                "sense_id": "98744ef4-e740-3229-ae19-7024190a0839",
                                "text": "Hendricks was only able to throw 52 pitches, surrendering two runs in 3.2 innings before being forced out of action when Angel Pagan's comebacker hit his right forearm."
                            },
                            {
                                "example_id": "f16f143f-b0d1-437b-9050-459046a4450a",
                                "sense_id": "98744ef4-e740-3229-ae19-7024190a0839",
                                "text": "The next hitter, Jayson Werth, reached on a broken-bat infield single, and Greg Dobbs walked to load the bases, but Heilman induced a comebacker from Chris Coste to end the rally."
                            }
                        ]
                    },
                    {
                        "sense_id": "19ba46ce-c0ff-3a7d-8bb8-50b7b995ae4e",
                        "entry_id": "ecd871cc-a4c3-3dba-aba5-d945900c09dc",
                        "glosses": [
                            "One who makes a comeback."
