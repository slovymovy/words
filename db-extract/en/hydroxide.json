                                        "examples": [
                                            {
                                                "example_id": "b5ea75a9-2f4a-464d-a4e2-157d3db5a483",
                                                "sense_id": "b6451289-780a-38d4-81ec-3c2a83817873",
                                                "text": "La molécule d’eau qui perd un proton devient un ion hydroxyde."
                                            }
