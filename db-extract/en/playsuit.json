                        "glosses": [
                            "A one-piece stretch garment worn by very young children."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "787d32d5-93dc-42a6-b4e3-1efeb4a1ee42",
                                "sense_id": "139e6e4b-d20f-37f6-88c4-911f87e0b0d3",
                                "text": "Like Marsha, his hair was tinged a faint rusty red. Sound asleep in a chair in the corner was a small girl, perhaps three, in a rumpled playsuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff23aac1-f756-3151-a867-77c1d5feffd6",
