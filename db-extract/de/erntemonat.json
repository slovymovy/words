                        "translation_id": "13166ab1-67f5-4590-b5dc-5c4c5a9596a7",
                        "source_entry_id": "9670bd7e-c044-36c9-85b8-8fab605e2404",
                        "source_sense_id": "d1da0851-69d4-336e-9f71-592254ad2433",
                        "source_sense_description": "zehnter Monat des französischen Revolutionskalenders",
                        "target_lang_word": "messidor",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "messidor",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44424b87-d4a1-3ef6-a672-414b601407c7",
                                        "entry_id": "7d6f9de7-3e80-37c6-b4ff-fcf7df9a3b83",
                                        "glosses": [
                                            "Dixième mois du calendrier républicain, qui commençait le 19 ou le 20 juin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b56f83ab-5251-3605-9fc5-a70fa00f38f9",
                                        "entry_id": "7d6f9de7-3e80-37c6-b4ff-fcf7df9a3b83",
                                        "glosses": [
                                            "Se dit d’une lourde imitation des styles antiques, en vogue sous le Directoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "765fae81-0534-443d-b9e4-5530a56a3b68",
                                                "sense_id": "b56f83ab-5251-3605-9fc5-a70fa00f38f9",
                                                "text": "Beaucoup de gens sont encore de cet avis en Espagne, où le goût messidor fleurit dans toute sa pureté …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4782246-f13d-4a3f-94a7-a89fc499db37",
                        "source_entry_id": "9670bd7e-c044-36c9-85b8-8fab605e2404",
                        "source_sense_id": "d1da0851-69d4-336e-9f71-592254ad2433",
                        "source_sense_description": "zehnter Monat des französischen Revolutionskalenders",
                        "target_lang_word": "août",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "août",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad814cb4-d9ee-3fdd-8669-3517b6bbc3e0",
                                        "entry_id": "c1a913d9-1720-3a53-9cf6-b42a6d09a029",
                                        "glosses": [
                                            "Huitième mois de l’année du calendrier grégorien, constitué de 31 jours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f18c66f-4198-4f6a-b619-4b7658887e02",
                                                "sense_id": "ad814cb4-d9ee-3fdd-8669-3517b6bbc3e0",
                                                "text": "[…] mais l’on n’était qu’en juin et, sauf pour les poires de moisson qui mûrissent en août, il fallait encore attendre longtemps avant de savourer concurremment les pommes du verger et la vengeance désirée."
                                            },
                                            {
                                                "example_id": "0b5ac73e-2a0e-433c-aefb-2dbaa77f016d",
                                                "sense_id": "ad814cb4-d9ee-3fdd-8669-3517b6bbc3e0",
                                                "text": "Elle était si meurtrière que, du mois d’août à la fin décembre, elle ne fit pas moins de 800 victimes de tout âge et de toute condition."
                                            },
                                            {
                                                "example_id": "edc5819f-ed95-47b2-9237-8e2252eec649",
                                                "sense_id": "ad814cb4-d9ee-3fdd-8669-3517b6bbc3e0",
                                                "text": "Le lundi, dix-huitième jour du mois d’août 1572, il y avait grande fête au Louvre."
                                            },
                                            {
                                                "example_id": "7bf5c711-d0ad-45c1-acce-37be508676ba",
                                                "sense_id": "ad814cb4-d9ee-3fdd-8669-3517b6bbc3e0",
                                                "text": "Après avoir passé par Brühl, Cologne, Stolberg et Malmédy, il entre le 16 août 1914 en Belgique. Le lendemain il est à Francorchamps, à sept kilomètres de Stavelot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0899afa0-eb70-3c94-8788-03f9499dafb1",
                                        "entry_id": "c1a913d9-1720-3a53-9cf6-b42a6d09a029",
                                        "glosses": [
                                            "Moissons."
                                        ],
                                        "tags": [
                                            "dated",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa7712de-bf8a-4bef-b3a1-5c547e99e38e",
                                                "sense_id": "0899afa0-eb70-3c94-8788-03f9499dafb1",
                                                "text": "Il est temps de faire l’août."
                                            },
                                            {
                                                "example_id": "ba0d6697-aba6-4cd2-a89b-e3c70d51f290",
                                                "sense_id": "0899afa0-eb70-3c94-8788-03f9499dafb1",
                                                "text": "L’août n’était pas commencé."
                                            }
