                                                "sense_id": "82a95bea-1545-3e7f-a911-7fdd7e6d19b7",
                                                "text": "„Nun, dieses simple Argument klingt etwas wirklichkeitsfremd, wie das ganze Projekt der Gütergemeinschaft.“"
                                            },
                                            {
                                                "example_id": "80643ce9-a34c-4b95-bc7b-fd636133f8b4",
                                                "sense_id": "82a95bea-1545-3e7f-a911-7fdd7e6d19b7",
                                                "text": "„Also der Gedanke einer wirtschaftlichen Unabhängigkeit scheint mir ziemlich wirklichkeitsfremd.“"
                                            },
                                            {
                                                "example_id": "ceba83e6-8cc9-4496-ae72-f5f2664cf005",
                                                "sense_id": "82a95bea-1545-3e7f-a911-7fdd7e6d19b7",
                                                "text": "„Daher sei es wirklichkeitsfremd, dass gerade diese Menschen keine Straftaten begehen werden.“"
                                            }
                                        ],
