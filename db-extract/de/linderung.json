                "senses": [
                    {
                        "sense_id": "5094d6e0-e9a3-31c7-8b18-327d363f40c6",
                        "entry_id": "5cf7e273-18c4-3bc2-b7ec-61608f561caf",
                        "glosses": [
                            "Abnahme oder Verringerung einer unangenehmen Erscheinung (Leiden, Schmerzen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01091059-bded-4865-acd9-20de4f2bf3a2",
                                "sense_id": "5094d6e0-e9a3-31c7-8b18-327d363f40c6",
                                "text": "„Irgendwann brachte auch die Arbeit keine Linderung mehr, sondern nur neue Pein.“"
                            },
                            {
                                "example_id": "f17fc8bd-b0c4-46c9-b682-bdbb52e3b408",
                                "sense_id": "5094d6e0-e9a3-31c7-8b18-327d363f40c6",
                                "text": "„Er starb 1928 am Magenkrebs; Morphium und Veronal waren die Nothelfer, die ihm auf seinem schweren Weg aus dem Leben ein wenig Linderung verschafften.“"
                            },
                            {
                                "example_id": "2aacbd38-5428-49e5-90c0-1c5050c8b307",
                                "sense_id": "5094d6e0-e9a3-31c7-8b18-327d363f40c6",
                                "text": "„Statt Linderung verspürte Irmgard Ried nach dem Besuch noch mehr Druck, weil es für ihr Leid offensichtlich keinen legitimen Grund gab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbbd8ae7-33db-437d-9e80-7fb5d63820c4",
                        "source_entry_id": "5cf7e273-18c4-3bc2-b7ec-61608f561caf",
                        "source_sense_id": "5094d6e0-e9a3-31c7-8b18-327d363f40c6",
                        "source_sense_description": "Abnahme oder Verringerung einer unangenehmen Erscheinung (Leiden, Schmerzen)",
                        "target_lang_word": "relief",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7e4df3-b5cb-37c6-992b-97d9886e1e82",
                                        "entry_id": "e06585a5-3710-35a8-a194-b8aac2fc892c",
                                        "glosses": [
                                            "The removal of stress or discomfort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f23eba6-e7cf-4ffa-b625-f7c0dfefe7ab",
                                                "sense_id": "1e7e4df3-b5cb-37c6-992b-97d9886e1e82",
                                                "text": "I sighed with relief when I found out that my daughter hadn't got lost, but was waiting for me at home."
                                            },
                                            {
                                                "example_id": "e96054b9-8c54-4e52-89c3-cfb01e9499d7",
                                                "sense_id": "1e7e4df3-b5cb-37c6-992b-97d9886e1e82",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness,[…]. It was with a palpable relief that he heard the first warning notes of the figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a4af54-602a-342e-8184-60a0ccfd1b51",
                                        "entry_id": "e06585a5-3710-35a8-a194-b8aac2fc892c",
                                        "glosses": [
                                            "The feeling associated with the removal of stress or discomfort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09cc2f7b-df7c-48f8-b360-1088d21ebcf5",
                                                "sense_id": "63a4af54-602a-342e-8184-60a0ccfd1b51",
                                                "text": "Tony's face expressed relief, and Nettie sat silent for a moment until the vicar said “It was a generous impulse, but it may have been a momentary one,[…].”"
                                            },
                                            {
                                                "example_id": "e07280f9-da53-4449-aa6f-a51524c796e8",
                                                "sense_id": "63a4af54-602a-342e-8184-60a0ccfd1b51",
                                                "text": "DfT's action was greeted with great relief in many quarters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c838c4c-c0fe-3577-b262-dc6821a45da4",
                                        "entry_id": "e06585a5-3710-35a8-a194-b8aac2fc892c",
                                        "glosses": [
                                            "Release from a post or duty, as when replaced by another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce51940e-e8e6-340b-b3b9-d36c4d9ac31c",
                                        "entry_id": "e06585a5-3710-35a8-a194-b8aac2fc892c",
                                        "glosses": [
                                            "The person who takes over a shift for another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa653a6-e6de-40ab-bf6e-039a2bd55898",
                                                "sense_id": "ce51940e-e8e6-340b-b3b9-d36c4d9ac31c",
                                                "text": "Officer Schmidt can finally go home because his relief has arrived."
                                            },
                                            {
                                                "example_id": "a028514e-7863-4494-ac41-4acdf315e2fd",
                                                "sense_id": "ce51940e-e8e6-340b-b3b9-d36c4d9ac31c",
                                                "text": "At Leeds a relief crew was waiting—but without a relief locomotive; after some discussion, the new men offered to take on the A3. [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5632ef29-a5f7-3cc8-bc47-c4b6c2994083",
                                        "entry_id": "e06585a5-3710-35a8-a194-b8aac2fc892c",
                                        "glosses": [
                                            "Aid or assistance offered in time of need."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "143acc11-6c4a-496b-8f22-a2e9c72c2c28",
                                                "sense_id": "5632ef29-a5f7-3cc8-bc47-c4b6c2994083",
                                                "text": "Relief arrived quickly after the disaster."
                                            },
                                            {
                                                "example_id": "69804e92-6408-4a63-b9d9-101b035bea3c",
                                                "sense_id": "5632ef29-a5f7-3cc8-bc47-c4b6c2994083",
