                "senses": [
                    {
                        "sense_id": "2317d2ac-6e2c-3825-bdbb-1fa440bd009a",
                        "entry_id": "b7779a09-7a2b-32f7-ac54-a271881ba4c9",
                        "glosses": [
                            "Donner un caractère rappelant le miel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a28097fd-eb56-4b72-a81b-2ad76ace3117",
                                "sense_id": "2317d2ac-6e2c-3825-bdbb-1fa440bd009a",
                                "text": "Mielliser ma voix en écho à la tienne."
                            },
                            {
                                "example_id": "e3030915-3a31-4f54-9760-9235d5bc49ca",
                                "sense_id": "2317d2ac-6e2c-3825-bdbb-1fa440bd009a",
                                "text": "Je connais le chemin des apothicaires et je citronnise, miellise, rhumise à tout va!"
                            },
                            {
                                "example_id": "b034986e-4d57-4332-86c3-ab3e2c02bb1e",
                                "sense_id": "2317d2ac-6e2c-3825-bdbb-1fa440bd009a",
                                "text": "Avec la lasure incolore, la protection ne semble pas assez épaisse ou plutôt pas assez efficace.. de toutes manières, le sapin avec le temps, et surtout le soleil va se mielliser, se colorer de lui-même... comme ce qu'on observe sur des meubles en pin..."
                            }
                        ]
                    }
