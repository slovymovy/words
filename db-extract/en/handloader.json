                        "sense_id": "9564aedd-300e-330a-944f-f078357a09ff",
                        "entry_id": "26862b13-c222-324a-95c5-1e6e1163edd4",
                        "glosses": [
                            "Someone who handloads their cartridges for firearms (shotguns, rifles, pistols, or revolvers)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1309f9-581c-4324-9e5a-75e3c187f95c",
                                "sense_id": "9564aedd-300e-330a-944f-f078357a09ff",
                                "text": "Their household subscribes to a monthly magazine devoted specifically to handloaders."
                            },
                            {
                                "example_id": "fdce10ab-8ffe-48d0-8620-97b07963910e",
                                "sense_id": "9564aedd-300e-330a-944f-f078357a09ff",
                                "text": "[…] it's a handloader’s dream in that it shoots well with most anything you put in it. I have shot bullets of all types, weights and shapes, including lead[,] and they all worked. Savage, Marlin, Remington and various imported rifles all are chambered […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "2cd7a251-0d7f-3b2e-a8ee-9b1da6f04ea5",
                        "entry_id": "26862b13-c222-324a-95c5-1e6e1163edd4",
                        "glosses": [
                            "A firearm, usually a pistol or rifle, into which cartridges are loaded manually."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4641254-249f-4e85-ab02-896db4f0c66f",
                                "sense_id": "2cd7a251-0d7f-3b2e-a8ee-9b1da6f04ea5",
                                "text": "So I told him he should ditch his handloader and get himself a nice autoloader, like an M1911."
                            }
                        ]
                    }
                ],
