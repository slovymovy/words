        "fr-extract.jsonl": [
            {
                "entry_id": "8b8d6de7-fdf6-3bb3-88db-f71524bfa0ac",
                "word": "acheminement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2413c8b1-8a5f-458d-b56d-902416187ca9",
                        "entry_id": "8b8d6de7-fdf6-3bb3-88db-f71524bfa0ac",
                        "tags": [
                            "plural"
                        ],
                        "form": "acheminements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f09b943-27c5-39b2-a5ab-9137669e4c77",
                        "entry_id": "8b8d6de7-fdf6-3bb3-88db-f71524bfa0ac",
                        "glosses": [
                            "Entrée, avancement dans une voie, vers un but."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6cb6dc-2130-40bc-a7a1-44bece666abe",
                                "sense_id": "7f09b943-27c5-39b2-a5ab-9137669e4c77",
                                "text": "C’est un grand acheminement à la paix."
                            },
                            {
                                "example_id": "a3e66cc3-0fcc-406f-b293-c47176f5aa07",
                                "sense_id": "7f09b943-27c5-39b2-a5ab-9137669e4c77",
                                "text": "Leur répartition sur les différents chantiers, en fonction de la position géographique des cercles pourvoyeurs, permettait l'acheminement des recrues, par les soins des commandants de cercle, dans les conditions les meilleures."
                            },
                            {
                                "example_id": "9bd83a26-9fa2-4970-b712-1cf0f325c583",
                                "sense_id": "7f09b943-27c5-39b2-a5ab-9137669e4c77",
                                "text": "D'après le groupe, elle découle aussi des problèmes d' acheminement liés au conflit en Mer rouge, avec des tirs de missiles par les Houthis sur les navires, et d'un sabotage dans son usine en Allemagne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f09e5f1f-7316-4a38-baa7-1d3854f744ee",
                        "source_entry_id": "8b8d6de7-fdf6-3bb3-88db-f71524bfa0ac",
                        "source_sense_id": "7f09b943-27c5-39b2-a5ab-9137669e4c77",
                        "target_lang_word": "Beförderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beförderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f54233-6bc6-32a2-93a0-73ac0b306005",
                                        "entry_id": "8d206e38-d774-377d-a334-3d237e59246a",
                                        "glosses": [
                                            "das Befördern oder das Transportieren von Gütern oder Personen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e11e9f3-d4b5-4fc4-b1bf-aaf4426aff7a",
                                                "sense_id": "f5f54233-6bc6-32a2-93a0-73ac0b306005",
                                                "text": "Die Beförderung der Reisenden erfolgt bei Zugausfällen durch einen Ersatzverkehr mit Bussen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65452d40-8d73-359e-ab75-b25005f47565",
                                        "entry_id": "8d206e38-d774-377d-a334-3d237e59246a",
                                        "glosses": [
                                            "die Einsetzung einer Person in eine höhere Stellung beziehungsweise Position im Berufsleben"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b258cd4-0342-4fc5-aafc-cc289dd99336",
                                                "sense_id": "65452d40-8d73-359e-ab75-b25005f47565",
                                                "text": "Kuniberts Beförderung zum Filialleiter liegt nun auch wieder fast zehn Jahre zurück."
                                            },
                                            {
                                                "example_id": "098dc84e-dc45-461f-b487-9eca991ed7a1",
                                                "sense_id": "65452d40-8d73-359e-ab75-b25005f47565",
                                                "text": "„Papas Beförderung zum Regierungsbaudirektor war unter Dach und Fach.“"
                                            },
                                            {
                                                "example_id": "2112b2ee-5a1b-4657-aa08-b4abd3854f82",
                                                "sense_id": "65452d40-8d73-359e-ab75-b25005f47565",
                                                "text": "„Beförderungen aus dem funktionslosen Beförderungsamt der Studienrätin bzw. des Studienrats im Grund- bzw. im Hauptschuldienst werden gesondert geregelt.“"
                                            },
                                            {
                                                "example_id": "a148e6db-081d-4fd5-b7ff-bb20948b26f6",
                                                "sense_id": "65452d40-8d73-359e-ab75-b25005f47565",
                                                "text": "„Er begab sich damals zu Jing Bo-djau und flehte ihn aus Anlaß seiner Beförderung zum stellvertretenden Kurierpostleiter an, Simen Tjing für ihn um ein Darlehen für seine Ausgaben bei Vorgesetzten und Untergebenen zu bitten.“"
                                            },
                                            {
                                                "example_id": "4114f606-ea8b-4c7a-b726-6ed3c2af5d3d",
                                                "sense_id": "65452d40-8d73-359e-ab75-b25005f47565",
                                                "text": "„In jedem Fall aber mussten am folgenden Tage zahlreiche Auszeichnungen verliehen und zahlreiche Beförderungen vorgenommen werden, und allerhand neue Männer mussten hervortreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b37fdd11-984f-405c-aeeb-0887b0a1604b",
                        "source_entry_id": "8b8d6de7-fdf6-3bb3-88db-f71524bfa0ac",
                        "source_sense_id": "7f09b943-27c5-39b2-a5ab-9137669e4c77",
                        "target_lang_word": "delivery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delivery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51a119f0-e9ee-3924-8a77-89077228f3df",
