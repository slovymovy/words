                    "semantic_group_id": "success_exam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn zusje is in één keer <w>geslaagd</w> voor haar rijexamen.",
                            "target_lang_translations": {
                                "en": "My little sister <w>passed</w> her driving test on the first try.",
