                        "cross_references": [
                            {
                                "target_word": "segregationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "012a20eb-bdb7-32fe-99a4-dae3e14e8cf8",
                                        "entry_id": "f8d07b27-b61a-38c3-905f-3dfab0627db8",
                                        "glosses": [
                                            "A person who supports or believes in segregation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a86baf7-8690-4ebd-b843-d4c5f3212e7a",
                                                "sense_id": "012a20eb-bdb7-32fe-99a4-dae3e14e8cf8",
                                                "text": "Her [Rosa Parks'] arrest launched a 381-day Montgomery bus boycott in which 40,000 Black people, mostly all working people, fought the segregationist bosses."
                                            },
                                            {
                                                "example_id": "15b065bd-9fac-4cc7-ba83-197d2e599697",
                                                "sense_id": "012a20eb-bdb7-32fe-99a4-dae3e14e8cf8",
                                                "text": "In 2003, Biden eulogized South Carolina Republican Sen. Strom Thurmond, one of the most notorious segregationists in American politics for most of his career who had “moved to the good side” later in life, Biden said."
                                            },
                                            {
                                                "example_id": "5a22d6d6-4530-4a44-bcb4-2cf09adbdd1e",
                                                "sense_id": "012a20eb-bdb7-32fe-99a4-dae3e14e8cf8",
                                                "text": "On March 18, 1965, Wallace, who was a segregationist, told the Alabama legislature that he intended to ask for federal troops “to provide for the safety and welfare of the so called demonstrators.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "segregationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f2d39a9-211e-37f6-b2e5-e941cc90a4e2",
                                        "entry_id": "dfef5960-14bb-3a7a-a110-c06e3aa7ee7f",
                                        "glosses": [
                                            "Causing or promoting segregation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5cfba32-537c-41ca-9605-419cf5331a5a",
                                                "sense_id": "3f2d39a9-211e-37f6-b2e5-e941cc90a4e2",
                                                "text": "In that way, all integrationist Judaisms differ from all segregationist ones."
                                            },
                                            {
                                                "example_id": "3c43a347-9a5a-4f8f-b752-48df82365f3d",
                                                "sense_id": "3f2d39a9-211e-37f6-b2e5-e941cc90a4e2",
                                                "text": "This logic exposes the segregationist intent of tuition grants beneath the superficial color blindness."
                                            },
                                            {
                                                "example_id": "5857daa4-5725-48ef-b55d-314884bbcbb5",
                                                "sense_id": "3f2d39a9-211e-37f6-b2e5-e941cc90a4e2",
                                                "text": "'It locks us into our differences,' Tony said, 'it's segregationist."
                                            },
                                            {
                                                "example_id": "7e3ab0eb-2702-47c9-9284-c22f07c5aad2",
                                                "sense_id": "3f2d39a9-211e-37f6-b2e5-e941cc90a4e2",
                                                "text": "But it became more common during the civil rights era, when the federal government clashed with officials in Southern, segregationist states."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
