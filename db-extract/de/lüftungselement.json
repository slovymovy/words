                "senses": [
                    {
                        "sense_id": "bfb483c8-2f03-3807-8f2c-3831abb39a5d",
                        "entry_id": "d7f41c1c-9cde-3c1c-8ecc-def16b94ab05",
                        "glosses": [
                            "Bauteil oder hergestellte Öffnung durch die Luft strömen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3d3036-796c-476a-85f8-0f5316415c27",
                                "sense_id": "bfb483c8-2f03-3807-8f2c-3831abb39a5d",
                                "text": "„Das Lüftungselement ist für alle Profilsysteme (sowohl Kunststoff als auch Holz) von 62 mm bis 90 mm Bautiefe einsetzbar.“"
                            },
                            {
                                "example_id": "0961061d-ef70-4670-8b06-77b3f2269803",
                                "sense_id": "bfb483c8-2f03-3807-8f2c-3831abb39a5d",
                                "text": "„ Die innovativen Lüftungselemente sind auch in Verbindung mit Lüftungssystemen einsetzbar.“"
                            },
                            {
                                "example_id": "9baf8b8a-af5e-48c1-a666-42e5b586b0f0",
                                "sense_id": "bfb483c8-2f03-3807-8f2c-3831abb39a5d",
                                "text": "„Alle Lüftungselemente können an eine intelligente Steuerung angeschlossen werden, welche über Temperaturfühler, Feuchtigkeitsfühler, Regenmelder und Sonnenstandsmelder die nötige Lüftung veranlassen.“"
                            },
                            {
                                "example_id": "993440f2-cf43-436b-a374-bf0f90f1f9e3",
                                "sense_id": "bfb483c8-2f03-3807-8f2c-3831abb39a5d",
                                "text": "„Lüftungselemente mit über 400 kg sind keine Seltenheit mehr.“"
                            },
                            {
                                "example_id": "130999e8-dd24-439f-a950-d8f32a16b19d",
                                "sense_id": "bfb483c8-2f03-3807-8f2c-3831abb39a5d",
                                "text": "„Die Lüftungselemente lassen Ihr Dach atmen und unterbinden damit Feuchteschäden und Schimmelbildung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
