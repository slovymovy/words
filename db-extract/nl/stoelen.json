                "senses": [
                    {
                        "sense_id": "efe46de7-7383-3bf3-8008-b8149a6dda01",
                        "entry_id": "a266cc93-868c-305c-9443-2208d872bb6d",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord stoel"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5abda8f1-dc7f-4ab3-b9a8-84fdf3bdfdee",
                                "sense_id": "efe46de7-7383-3bf3-8008-b8149a6dda01",
                                "text": "Stoelen of tafels hadden we niet."
                            },
                            {
                                "example_id": "e52722fd-cc8f-4fd0-a636-7bc82757e5cb",
                                "sense_id": "efe46de7-7383-3bf3-8008-b8149a6dda01",
                                "text": "De leugenaar lla en Cornelia proberen wat te slapen in twee van de rozenhouten stoelen die ze vanuit de ontvangkamer naar boven hebben gezeuld."
                            },
                            {
                                "example_id": "bc94f297-5d14-4d67-b8b9-77645012b271",
                                "sense_id": "efe46de7-7383-3bf3-8008-b8149a6dda01",
                                "text": "' 4 Cynth trouwde met Samuel voor de burgerlijke stand in Wandsworth, in een kleine ruimte die rook naar bureaucratie en goedkoop parfum, met donkergroene muren en ijzeren stoelen."
                            }
                        ]
                    }
