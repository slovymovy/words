                "senses": [
                    {
                        "sense_id": "31d8720f-6589-3dff-9be9-7ffdf9fe45bc",
                        "entry_id": "781422c7-58df-380f-828a-e78f6c466d98",
                        "glosses": [
                            "Marque de nuance pour indiquer qu'un passage doit être joué progressivement moins fort."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2f10ec7d-7629-3af2-ba96-c98f6975d186",
                        "entry_id": "781422c7-58df-380f-828a-e78f6c466d98",
                        "glosses": [
                            "Ce passage joué ainsi."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d6c83cbf-b6b2-40f5-9b62-b93ee95563f4",
                                "sense_id": "2f10ec7d-7629-3af2-ba96-c98f6975d186",
                                "text": "La fin ressemblait plus à un épuisement qu'à un arrêt — un diminuendo où le martèlement du rythme se changea en un chuchotement qui se prolongea bien au-delà du vrai silence où il finit par se fondre."
                            },
                            {
                                "example_id": "2b214bdc-9094-437d-9937-84c72733f9b9",
                                "sense_id": "2f10ec7d-7629-3af2-ba96-c98f6975d186",
                                "text": "Alors, tandis que Berlaudier, la tête penchée et le coude en l’air, tirait un trait noir le long d’une règle, un long trille s’éleva, s’enfla, puis s’effaça diminuendo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f7162f1-c026-4e1e-8bdb-6e10e9a1842e",
                        "source_entry_id": "781422c7-58df-380f-828a-e78f6c466d98",
                        "target_lang_word": "diminuendo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diminuendo",
