                        "glosses": [
                            "System, nach dem manchen Zahlen eine symbolische Bedeutung zukommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d742bb4-1863-48ea-9b99-97f2cf451cae",
                                "sense_id": "cd68819d-f6f9-3294-a065-d89f00729553",
                                "text": "In der Zahlensymbolik steht die Zahl 7 häufig als Zahl der Vollkommenheit und Vollendetheit."
                            },
                            {
                                "example_id": "26e2991a-79d8-46e6-93ea-0904fa21f9ca",
                                "sense_id": "cd68819d-f6f9-3294-a065-d89f00729553",
                                "text": "„Besonders intensiv und vielfältig wurde Zahlensymbolik sowohl in Dichtung als auch in Philosophie eingearbeitet.“"
                            },
                            {
                                "example_id": "961f6997-53be-498f-9b12-24d6ce8faade",
                                "sense_id": "cd68819d-f6f9-3294-a065-d89f00729553",
                                "text": "„Zahlensymbolik und Zahlenmystik waren zentrale Bestandteile der pythagoräischen Zahlenlehre.“"
                            }
                        ],
