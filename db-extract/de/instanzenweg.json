                ],
                "senses": [
                    {
                        "sense_id": "1c0a3258-5a9f-3da2-922b-624f29edf798",
                        "entry_id": "1c024d8d-e0cc-3421-b4b1-57576271e03a",
                        "glosses": [
                            "festgelegte Reihenfolge in Organisationen (oft: Behörden) für das Durchlaufen einer Information, beispielsweise bei einer Anfrage, Anordnung, einem Antrag oder einer Weisung"
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "6e277b86-360b-4a53-a5ae-dc7aa68e2b19",
                                "sense_id": "1c0a3258-5a9f-3da2-922b-624f29edf798",
                                "text": "„Die Weitergabe von Informationen auf dem Instanzenweg sichert, daß alle Stellen einer Linie informiert werden.“"
                            },
                            {
                                "example_id": "1e5d7b6d-85dd-4bff-bc8b-004693ccee06",
                                "sense_id": "1c0a3258-5a9f-3da2-922b-624f29edf798",
                                "text": "„Der Instanzenweg, den Mohls Anträge für die Bibliothek durchlaufen mußten, war sehr umständlich und dementsprechend zeitraubend.“"
                            },
                            {
                                "example_id": "f04a400b-a466-4146-8aa0-54f29ed8230f",
                                "sense_id": "1c0a3258-5a9f-3da2-922b-624f29edf798",
                                "text": "„Ereignet sich ein mögliches \"Heilungswunder\" in Lourdes, muss der Geheilte einen langen Instanzenweg durchlaufen, bevor die wunderbare Heilung anerkannt wird.“"
                            },
                            {
                                "example_id": "026df2dc-4b5e-493d-aec5-7e33352a48f8",
                                "sense_id": "1c0a3258-5a9f-3da2-922b-624f29edf798",
                                "text": "„Einen Tag würde außerdem der Brief für den Instanzenweg im Gefängnis brauchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                        "entry_id": "1c024d8d-e0cc-3421-b4b1-57576271e03a",
                        "glosses": [
                            "festgelegte Reihenfolge für das Durchlaufen einer Klage vor Gerichten infolge von Berufungsverfahren von der niedrigsten bis zur letzen Instanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c350e8-7a53-428d-8078-d50fc9b85153",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Obendrein muss kein Betroffener ein solches Urteil unwidersprochen hinnehmen. Der Rechts- und Instanzenweg steht jedem offen.“"
                            },
                            {
                                "example_id": "21575a1f-d19d-4904-9079-b7df8884d0eb",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Schon in der Verhandlung hatte Schoemaker angekündigt, dass man den Instanzenweg weiter beschreiten wolle.“"
                            },
                            {
                                "example_id": "f1e43951-e7b8-4560-a0f8-6c6b5bed88a4",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Assange hat den juristischen Instanzenweg gegen seine Auslieferung in Großbritannien erfolglos ausgeschöpft.“"
                            },
                            {
                                "example_id": "1a27df2e-6037-4f5e-a625-b9ab6159480c",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Die Karlsruher Richter verwiesen die Muslimin, die derzeit den Führerschein macht, zunächst auf den Instanzenweg vor die Verwaltungsgerichte.“"
                            },
                            {
                                "example_id": "f3a86cd7-9926-4295-b9c4-3248ddf64a55",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Mangelhafte Brustimplantate haben eine heute 64-Jährige auf den Instanzenweg getrieben.“"
                            },
                            {
                                "example_id": "008f0247-16f2-44f4-8607-58532fe5447a",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Genau das aber will der klagende Rektor jetzt grundsätzlich klären lassen. »Es war klar, dass der Instanzenweg beschritten werden muss - bis zum Bundesverwaltungsgericht, gegebenenfalls bis zum Bundesgerichtshof«, sagte sein Anwalt, Ralph Heiermann, dem NDR.“"
                            },
                            {
                                "example_id": "654f07a1-9d1d-4447-91b9-58c0d903e492",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Die Auseinandersetzung mit Deutschlands größtem Privatvermieter hat Obst schon vor knapp fünf Jahren nicht gescheut, als er gegen möglicherweise überhöhte Nebenkostenabrechnungen klagte und auf dem bisherigen Instanzenweg großteils Recht bekam.“Julian Raff: Kieferngarten: Baustellen-Ärger zwischen Vonovia und ihren Mietern. In: sueddeutsche.de. 15. September 2021, ISSN 0174-4917 (URL, abgerufen am 1. August 2022) ."
                            },
                            {
                                "example_id": "d10ac731-e996-4fb4-a2ac-387a377f5816",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Trump hat nun immer noch die Möglichkeit, den Instanzenweg zu durchschreiten.“"
                            },
                            {
                                "example_id": "678cdd94-3ea2-417e-a273-092b81005f30",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Die US-Regierung entschloss sich daraufhin zu dem ungewöhnlichen Schritt, den weiteren Instanzenweg nicht abzuwarten und wandte sich direkt an den Supreme Court.“"
                            },
                            {
                                "example_id": "c534af81-acaa-443a-bc86-1d1ed1e44f49",
                                "sense_id": "4c23d83c-96cf-3d8c-878c-3bc5ee151184",
                                "text": "„Sie verbündeten sich, zogen gemeinsam vor Gericht, verklagten die Stadt wegen Lärmbelästigung, machten Wertminderung ihrer Grundstücke geltend, nahmen dabei auch den Instanzenweg bis hin zum Bundesgericht in Kauf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
