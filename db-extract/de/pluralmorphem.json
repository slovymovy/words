                "senses": [
                    {
                        "sense_id": "4735a623-186e-3ac2-9900-fc1f5f4b2b1f",
                        "entry_id": "4950c44b-3cbc-3abd-a42b-2d4e17e0807c",
                        "glosses": [
                            "grammatisches Morphem, das den Plural ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93a2c30-4e76-4056-befa-73dfe1b46a34",
                                "sense_id": "4735a623-186e-3ac2-9900-fc1f5f4b2b1f",
                                "text": "„Die kontextabhängigen lautliche Realisierungen dieses Morphems, die sogenannten Allomorphe des Pluralmorphems, leiten wir durch morphophonologische Regeln ab.“"
                            },
                            {
                                "example_id": "4dfcc776-d873-4e91-be21-75f2ae725aa0",
                                "sense_id": "4735a623-186e-3ac2-9900-fc1f5f4b2b1f",
                                "text": "„Über die Allomorphe des deutschen Pluralmorphems lagen mir drei Statistiken vor, die alle innerhalb der letzten vier Jahre veröffentlicht wurden; die umfangreichste Sprachstatistik für das Deutsche (Meier 1964) macht hierzu keine Angaben.“"
                            },
                            {
                                "example_id": "6755455a-f4e0-4ce5-ba93-0cc78f359cbc",
                                "sense_id": "4735a623-186e-3ac2-9900-fc1f5f4b2b1f",
                                "text": "„Beim Pluralmorphem kann die Variante /z/ als die am wenigsten restringierte zur Grundlage gemacht werden.“"
                            },
                            {
                                "example_id": "1dc556ed-86f1-4a53-acca-0f4e3232c841",
                                "sense_id": "4735a623-186e-3ac2-9900-fc1f5f4b2b1f",
                                "text": "„Die Menge aller Morphe, die den Plural ausdrücken, bildet das deutsche Pluralmorphem: {/s/, /n/, /e/, /Umlaut/, /er/, /Umlaut + er/, /Umlaut+ e/, /en/, ‚Null-Morph‘}.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
