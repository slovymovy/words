        "fr-extract.jsonl": [
            {
                "entry_id": "2f6b78a5-f66f-35d9-9edc-3664a1a10425",
                "word": "kayfabe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fbc2a8e7-b29f-338b-b161-2b6283d56003",
                        "entry_id": "2f6b78a5-f66f-35d9-9edc-3664a1a10425",
                        "glosses": [
                            "Fait de donner l'illusion que les combats de catch ne sont pas arrangés."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "18fbb396-c082-4a8b-8892-51155ca1ae14",
                                "sense_id": "fbc2a8e7-b29f-338b-b161-2b6283d56003",
                                "text": "Le format choisi évite soigneusement de dévoiler toutes les ficelles du métier et s'abstient d'aborder les petits secrets qui faisaient les choux gras des shoot interviews, néanmoins il ne ressuscite pas pour autant la notion du kayfabe qui consistait auparavant à tout cacher au public."
                            }
                        ]
                    },
                    {
                        "sense_id": "aeae0188-8d46-374c-a374-2f568c688c68",
                        "entry_id": "2f6b78a5-f66f-35d9-9edc-3664a1a10425",
                        "glosses": [
                            "Suspension consentie de l’incrédulité dans le cadre d’une œuvre de fiction."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "08329e3b-fb07-3adb-9683-6491d05bdd38",
                        "entry_id": "2f6b78a5-f66f-35d9-9edc-3664a1a10425",
                        "glosses": [
                            "Fait de jouer un rôle au quotidien dans un milieu professionnel, généralement de prétendre l’enthousiasme et l’implication dans son travail."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c573b95-014a-4cb1-a16a-75bf69f76f62",
                        "source_entry_id": "2f6b78a5-f66f-35d9-9edc-3664a1a10425",
                        "target_lang_word": "kayfabe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kayfabe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c50873-7a61-3367-a212-c9847fdb162d",
                                        "entry_id": "4d85d68c-9727-3ff8-8a3b-c0b8ce0a6035",
                                        "glosses": [
                                            "The act, situation, or code of portraying staged events, performances, rivalries, etc as authentic or spontaneous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5083db-86a5-4ceb-b96f-bf758ad6c2b0",
                                                "sense_id": "c1c50873-7a61-3367-a212-c9847fdb162d",
                                                "text": "\"Jack, Gordon and I were talking about how we heard Ric Flair do an interview where he said there was no such thing as kay-fabe any more,\" said Blair, referring to the fact most wrestler secrets were exposed in the 1990s."
                                            },
                                            {
                                                "example_id": "ec8690b3-7136-4f5a-9789-82acfd149104",
                                                "sense_id": "c1c50873-7a61-3367-a212-c9847fdb162d",
                                                "text": "Suddenly, I heard a shout behind me: \"Kayfabe! Kayfabe!\" It was Gagne, freaking out and twitching and gesturing. He was afraid that some of the marks would see us in such close proximity and wonder why I wasn't choking out Wahoo with the velvet rope leading to the reservation counter, or carving him up with the ticket agent's pen. The thing was that, with the exception of the AWA guys, the terminal was empty."
                                            },
                                            {
                                                "example_id": "fbbf2561-dd22-4e8b-9e33-36ce36fe69b7",
                                                "sense_id": "c1c50873-7a61-3367-a212-c9847fdb162d",
                                                "text": "I've been breaking kayfabe a lot lately and it's bad, completely unprofessional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0292fbe-7e91-3b87-af7a-6c2b3a38721b",
                                        "entry_id": "4d85d68c-9727-3ff8-8a3b-c0b8ce0a6035",
                                        "glosses": [
                                            "Similar fakery or suspension of disbelief in other contexts."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dbc0d85-a9ae-45ff-b7cd-752817b192bd",
                                                "sense_id": "e0292fbe-7e91-3b87-af7a-6c2b3a38721b",
                                                "text": "Business historian Fiona A. E. McQuarrie has noted that the concept of kayfabe is not uncommon outside the realm of professional wrestling, as many corporations \"formally require their members to maintain public silence on company issues or not to express any explicit criticism of the company, through such means as employment contracts or through contracts governing severance or termination of employment.\""
                                            },
                                            {
                                                "example_id": "8fbdb65d-f2da-4dee-a486-d794420caf3a",
                                                "sense_id": "e0292fbe-7e91-3b87-af7a-6c2b3a38721b",
                                                "text": "The Republican brand will be tarnished even more as mainstream media outlets and late-night comedians gleefully broadcast Moore’s asininity to the broader public. But, yeah, sure: It’ll be entertaining for people who now follow politics like it’s one long pro-wrestling kayfabe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kayfabe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23e9fad1-a4be-3cdf-ab25-0760145311ee",
                                        "entry_id": "6541f925-d4fe-3ac5-a883-58ddf26df8d7",
                                        "glosses": [
                                            "Of or related to kayfabe, especially forbidden to mention or show in order to maintain kayfabe."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd0f16e-16bc-4755-bf3f-c515e29c0a8c",
                                                "sense_id": "23e9fad1-a4be-3cdf-ab25-0760145311ee",
                                                "text": "My wife... currently serves as a Florida State Senator... My kayfabe wife has enormous fake breasts, bleach blonde hair, and a nose that is too small for her face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kayfabe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62d38d37-2499-3e56-b156-036c6a78e63a",
                                        "entry_id": "371c4010-1ded-3e00-973b-19c539991908",
                                        "glosses": [
                                            "To maintain kayfabe, to deceive by staying in character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2865835-a00c-4168-8e31-15799da450ae",
                                                "sense_id": "62d38d37-2499-3e56-b156-036c6a78e63a",
                                                "text": "...Mascaras was never one of the boys. Here's an example: after his matches, he'd shower with his mask on. I understand protecting your image, but the guy was kayfabing us."
                                            },
                                            {
                                                "example_id": "844b1a60-bb08-4095-8fcf-9f53e38f6ead",
                                                "sense_id": "62d38d37-2499-3e56-b156-036c6a78e63a",
                                                "text": "He joked around with me and had me laughing so hard that it was tough not to feel silly about being \"kayfabed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
