                "senses": [
                    {
                        "sense_id": "e4c89c57-6471-3e8e-832e-f8cb7cf81919",
                        "entry_id": "c62df316-b8d5-3cbc-8d4e-bd3a5c2a2677",
                        "glosses": [
                            "wdychanie pary wodnej, gazów lub substancji w celach leczniczych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
