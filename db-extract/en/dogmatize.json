                                        "glosses": [
                                            "Donner à un enseignement ou à une opinion un caractère dogmatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac73661d-e831-4d7f-9fa8-b66781d49489",
                                                "sense_id": "6f78db5e-cd53-39db-bb98-9e53b33ec39c",
                                                "text": "Peut-être qu'il n'aurait pas convenu, dans un livre où l'on se proposait de dogmatiser le crime et la tyrannie, de mettre au jour ce qui devrait la détruire."
                                            },
                                            {
                                                "example_id": "832ab20b-3864-48d1-91c8-bb1fc4a41410",
                                                "sense_id": "6f78db5e-cd53-39db-bb98-9e53b33ec39c",
                                                "text": "Encore une ou deux histoires, et nous dogmatiserons."
                                            }
                                        ]
                                    },
