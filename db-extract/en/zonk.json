                                            {
                                                "example_id": "41dfb3c9-062c-4913-947a-070189c86ee2",
                                                "sense_id": "cc278092-6ce3-35f6-8d40-69e8f35d484a",
                                                "text": "Mist, schon wieder eine Niete!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ae98a4e-82b5-388c-a003-577e080a5de1",
                                        "entry_id": "88cbd7eb-b1de-3235-b0dc-b3713310c85d",
                                        "glosses": [
                                            "unfähiger Mensch, Versager"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afea8886-77b4-488b-b3e1-c7b55969ddef",
                                                "sense_id": "4ae98a4e-82b5-388c-a003-577e080a5de1",
                                                "text": "Im Rechnen ist er eine Niete."
                                            },
                                            {
                                                "example_id": "109fcc41-bd57-4fef-9e11-9e9bf3d15886",
                                                "sense_id": "4ae98a4e-82b5-388c-a003-577e080a5de1",
                                                "text": "„Philip hatte mir klar gezeigt, was für eine Niete ich als Freundin gewesen war, weil ich seine Bedürfnisse nicht hatte sehen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ba5e886f-9561-3b8c-8544-9ef31da04ff6",
                                        "entry_id": "88cbd7eb-b1de-3235-b0dc-b3713310c85d",
                                        "glosses": [
                                            "Verbindungsbolzen aus Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e879e1-058f-409f-8df4-9164b350cd7a",
                                                "sense_id": "ba5e886f-9561-3b8c-8544-9ef31da04ff6",
                                                "text": "Für alle genormten Nieten, ausgenommen Blindnieten und Nieten für den Bereich der Luft- und Raumfahrt, sind ihre technischen Lieferbedingungen festgelegt."
                                            },
                                            {
                                                "example_id": "b67c22ae-128a-4dc9-9619-6506bf237ab8",
                                                "sense_id": "ba5e886f-9561-3b8c-8544-9ef31da04ff6",
                                                "text": "„Auf dem Boden liegen Feilen, Meißel, Bohrer, Taue, Drähte, Drahtkisten, Rohre, Räder, Schrauben, Nieten, Töpfe mit Lacken, Kleistern und Fetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
