                    {
                        "translation_id": "0c21e85b-e321-4276-9b6c-fbe851a3aeeb",
                        "source_entry_id": "2861bdd0-917b-3502-837a-53bc959936ad",
                        "source_sense_id": "c1852cbe-6687-3e4f-8be5-1a4430939918",
                        "source_sense_description": "Gebiet der Sahara, in dem Ton-, Silt- und Sandsedimente zu Salzabscheidungen inkrustiniert sind",
                        "target_lang_word": "sebkha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sebkha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "325d1b25-a24f-3350-9936-c2396f7dd105",
                                        "entry_id": "580a2621-8e89-35c7-8870-0d6454d65aa0",
                                        "glosses": [
                                            "Dépression à forte salinité plus ou moins séparée d’un milieu marin, dans des régions arides supratidales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d44ecf7e-9b55-4ea9-8c27-03a0b76330c6",
                                                "sense_id": "325d1b25-a24f-3350-9936-c2396f7dd105",
                                                "text": "Les chotts ou sebkhas sont autant de lacs et d’étangs salés où l’évaporation de l’été dépose une couche de sel brut."
                                            },
                                            {
                                                "example_id": "f91d7516-3fb3-41a6-8d1c-1b48e036775c",
                                                "sense_id": "325d1b25-a24f-3350-9936-c2396f7dd105",
                                                "text": "La vaste sebkha d’Oran."
                                            },
                                            {
                                                "example_id": "83b26776-c46b-4529-9556-56a0043b8f6c",
                                                "sense_id": "325d1b25-a24f-3350-9936-c2396f7dd105",
                                                "text": "Les indigènes désignent sous le nom de chotts ou sebkhas des bas-fonds vaseux, couverts de matières salines, où l’eau ne séjourne qu’à certains moments de l’année."
                                            },
                                            {
                                                "example_id": "f8395665-9144-4801-8501-e8c9be1f24d4",
                                                "sense_id": "325d1b25-a24f-3350-9936-c2396f7dd105",
                                                "text": "On peut donc, ici, observer la transformation d’un lac d’eau douce permanent en une sebkha inondée épisodiquement seulement, qui précède l’aridification à partir d’environ – 3200."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
