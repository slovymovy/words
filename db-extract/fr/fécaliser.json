                "senses": [
                    {
                        "sense_id": "eb0148aa-8847-322b-b7ec-d0b3dd4856c1",
                        "entry_id": "ebb4cd11-f763-35e9-aa11-254e16f309fc",
                        "glosses": [
                            "Donner un caractère fécal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8c35ee-66d1-4824-8272-5dd3f679c9d4",
                                "sense_id": "eb0148aa-8847-322b-b7ec-d0b3dd4856c1",
                                "text": "Plus l'entourage a manifesté son dégout tôt, plus l'enfant va fécaliser les objets en les considérant comme dégoutants, à bannir etc."
                            },
                            {
                                "example_id": "4311982d-6ec4-4625-9500-d224eb0794b3",
                                "sense_id": "eb0148aa-8847-322b-b7ec-d0b3dd4856c1",
                                "text": "Tant qu'il n'est pas fécalisé, on peut dire qu'il « reste sur le jabot », sur l'estomac, d'un bon nombre de sujets."
                            },
                            {
                                "example_id": "5e12e0eb-0a20-4561-b19d-316d8cc4c1de",
                                "sense_id": "eb0148aa-8847-322b-b7ec-d0b3dd4856c1",
                                "text": "Fécaliser l'analisé, c'est là le secret de la domination anale."
                            }
                        ]
                    }
                ],
