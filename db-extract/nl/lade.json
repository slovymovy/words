                "senses": [
                    {
                        "sense_id": "01f7519e-32b0-3f27-a442-1dbd32134d07",
                        "entry_id": "85a47e94-561d-3715-b337-82aa5d10bbac",
                        "glosses": [
                            "platte uitschuifbare bak in een meubelstuk, bedoeld als bergplaats van losse voorwerpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e64c5c-0638-431e-bac1-c13a5a5d4885",
                                "sense_id": "01f7519e-32b0-3f27-a442-1dbd32134d07",
                                "text": "Het legde het afgedroogde bestek in de ene lade en de onderzetters in de andere."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41b7140b-d34a-4fa9-afe4-24c553128ef6",
                        "source_entry_id": "85a47e94-561d-3715-b337-82aa5d10bbac",
                        "source_sense_id": "01f7519e-32b0-3f27-a442-1dbd32134d07",
                        "source_sense_description": "uitschuifbare bergplaats",
                        "target_lang_word": "Schublade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schublade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                        "entry_id": "fcb962e2-40e8-38b5-8785-b9487e51d43d",
                                        "glosses": [
                                            "oben offenes Behältnis, das in einem Möbelstück eingebaut ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2f974e-4a76-47f8-91cb-95149f6da168",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "Der Dieb durchwühlte die Schublade nach Wertgegenständen."
                                            },
                                            {
                                                "example_id": "fa68644e-30e9-48c0-8718-1ad592348b9d",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "„Sie machen unser Leben ordentlicher: Schubladen!“"
                                            },
                                            {
                                                "example_id": "01bf2faa-7778-48d9-bae6-5b4ed1a63f36",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "„Auf diese Weise stieß ich auch auf mein Tagebuch, das viele Jahre zuvor weggelegt und dann auf dem Boden einer Schublade fast vergessen worden war.“"
                                            },
                                            {
                                                "example_id": "3c8a295d-d22f-43f5-94c5-8ff3f674e5bc",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "„Er blieb auf der Treppe liegen, während sie panisch die Schubladen im Empfangstresen durchsuchte.“"
                                            },
                                            {
                                                "example_id": "8dcbcc6c-cb22-4b72-8f4a-f7869e5a1936",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "„Grenfeld öffnete die Schubladen einer Kommode.“"
                                            },
                                            {
                                                "example_id": "ad8cba44-bf91-4602-95e4-80ff43c39766",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "„Mit der linken Hand zog er mit einem heftigen Ruck die mittlere Schublade direkt unter der Tischplatte auf.“"
                                            },
                                            {
                                                "example_id": "643d77b5-eae0-4fce-84ab-c87fc51a5e55",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "„Ihre Schubladen klemmen oder schließen nicht mehr richtig? Kein Grund, sie komplett auszutauschen […].“"
                                            },
                                            {
                                                "example_id": "4a8bb7f8-f251-4458-a8e6-53c109049b09",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "[Smartphones:] „Unglaubliche zehn Millionen Geräte liegen unbenutzt in Österreichs Schubladen.“"
                                            },
                                            {
                                                "example_id": "29ec815b-0094-4899-8d2a-244a11fad0f4",
                                                "sense_id": "30b93825-b528-3cba-9b70-f14a762d55f4",
                                                "text": "„Arbeitsrecht - Darf der Chef Schubladen durchsuchen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8d68945-3742-3800-ae0c-a788f3825899",
                                        "entry_id": "fcb962e2-40e8-38b5-8785-b9487e51d43d",
                                        "glosses": [
                                            "Kategorie, in die jemand oder etwas durch andere einsortiert wird, häufig vorschnell, fälschlicherweise oder aufgrund von Vorurteilen"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62441e1d-828e-4519-a999-13ab838c1636",
                                                "sense_id": "b8d68945-3742-3800-ae0c-a788f3825899",
                                                "text": "Wenn Frauen körperliche Beschwerden schildern, werden sie von einigen Medizinern schnell in die Schublade „psychosomatisch“ gesteckt."
                                            },
                                            {
                                                "example_id": "bba90a9f-866f-4bbd-b77b-9bdc6579ec10",
                                                "sense_id": "b8d68945-3742-3800-ae0c-a788f3825899",
                                                "text": "„Bisexuelle passen in keine Schublade.“"
                                            },
                                            {
                                                "example_id": "5d3b4bba-d514-4cca-ab57-10647848b937",
                                                "sense_id": "b8d68945-3742-3800-ae0c-a788f3825899",
                                                "text": "„Solche Kommentare zeigen, dass es immer noch Menschen gibt, die in Schubladen denken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49bdc3ad-eb80-4795-8e96-4141b3be2196",
                        "source_entry_id": "85a47e94-561d-3715-b337-82aa5d10bbac",
                        "source_sense_id": "01f7519e-32b0-3f27-a442-1dbd32134d07",
                        "source_sense_description": "uitschuifbare bergplaats",
                        "target_lang_word": "drawer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drawer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7574290-b98c-316a-a193-38238d931e6a",
                                        "entry_id": "b4485c96-a375-3278-9b27-7a6649dc9286",
                                        "glosses": [
                                            "An open-topped box that can be slid in and out of the cabinet that contains it, used for storing clothing or other articles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49730179-1805-4bfa-9757-92638f869747",
                                                "sense_id": "d7574290-b98c-316a-a193-38238d931e6a",
                                                "text": "He knelt down and began shoving the drawer into the slot; the rail was misaligned so he banged it with the heel of his hand. It stuck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e431cf29-0141-3a64-870b-8ca045672127",
                                        "entry_id": "b4485c96-a375-3278-9b27-7a6649dc9286",
                                        "glosses": [
                                            "A side panel containing supplementary content."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26bebe78-5175-3b7f-96d8-6fd5a242c235",
                                        "entry_id": "b4485c96-a375-3278-9b27-7a6649dc9286",
                                        "glosses": [
                                            "Attributive form of drawers."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "503b8497-250b-46ab-a5cd-0e658bc1a459",
                                                "sense_id": "26bebe78-5175-3b7f-96d8-6fd5a242c235",
                                                "text": "The step-ins are of two sorts; the knicker combination with open bloomer and chemise top; and circular drawer style, with chemise top and gussets at back and front that give extra width at the bottom."
                                            },
                                            {
                                                "example_id": "64ed4a27-ec1e-491f-a783-ce4e6e6fd953",
                                                "sense_id": "26bebe78-5175-3b7f-96d8-6fd5a242c235",
                                                "text": "Customers in the underwear department at MacDougal-Southwick’s, on the other hand, have evinced quite an interest in the French drawer style, with binding in contrasting color and the separate vests also bound in the contrasting color."
                                            },
                                            {
                                                "example_id": "dc52f7c7-4b88-4437-a4ce-b31e60263dca",
                                                "sense_id": "26bebe78-5175-3b7f-96d8-6fd5a242c235",
                                                "text": "Today men of every age are turning to the athletic pull-over shirt and drawer type of underwear."
                                            },
                                            {
                                                "example_id": "cca70b14-18b2-49ec-9bbc-79e1e7ed14bb",
                                                "sense_id": "26bebe78-5175-3b7f-96d8-6fd5a242c235",
                                                "text": "Men’s Balbriggan Shirts and Drawers / 50ᶜ ea. / For the man who wants the shirt-and-drawer type of underwear but, naturally, wants lightweight now."
                                            },
                                            {
                                                "example_id": "96a514cb-f5f3-43b9-a942-d24f20bf46ca",
                                                "sense_id": "26bebe78-5175-3b7f-96d8-6fd5a242c235",
                                                "text": "Leloir described les calecons, drawer-type undergarment worn by French ladies (wc)."
                                            },
                                            {
                                                "example_id": "f0a1b684-7f96-40d4-ba90-b079c8a0060a",
                                                "sense_id": "26bebe78-5175-3b7f-96d8-6fd5a242c235",
                                                "text": "The Sikh code of conduct does not restrict how Sikhs dress, except that they must wear kashera (drawer-type, cotton tie-able underwear) and a turban."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drawer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "182f05e5-9a12-3801-a71c-af5570724dac",
                                        "entry_id": "66ef587c-516a-33ec-ac72-e04f0c100011",
                                        "glosses": [
                                            "Agent noun of draw; one who draws."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb3dd652-060d-424e-bbbd-b9120a870eef",
                                                "sense_id": "182f05e5-9a12-3801-a71c-af5570724dac",
                                                "text": "Lawyers for Mr. Abbott argued that the maps were drawn to help Republicans maintain power but not to discriminate, and that drawers did not know where district offices were located."
                                            },
                                            {
                                                "example_id": "2e9bb745-bbaf-416d-b3a7-876af721440a",
                                                "sense_id": "182f05e5-9a12-3801-a71c-af5570724dac",
                                                "text": "Wanted: discreet drawer of royal bath [title] ... [T]he successful applicant for the role of \"housekeeping assistant\" mus also be prepared for rather less conventional tasks; such as running the Queen's bath and cleaning her priceless antiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67b9122-5738-3a0e-9703-1c2509607e10",
                                        "entry_id": "66ef587c-516a-33ec-ac72-e04f0c100011",
                                        "glosses": [
                                            "An artist who primarily makes drawings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccf8ec76-a699-35a9-82f5-584117188115",
                                        "entry_id": "66ef587c-516a-33ec-ac72-e04f0c100011",
                                        "glosses": [
                                            "One who writes a bank draft, check/cheque, or promissory note."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43708dc-23c7-4547-a096-e6af8292fa0e",
                                                "sense_id": "ccf8ec76-a699-35a9-82f5-584117188115",
                                                "text": "There is no doubt that the stipulation of nonguarantee of an acceptance inserted in a bill of exchange by the drawer has the effect of excluding the liability of guarantee for the indorsers as well as for the drawer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdabb492-20d8-3894-9be8-395c0a244a47",
                                        "entry_id": "66ef587c-516a-33ec-ac72-e04f0c100011",
                                        "glosses": [
                                            "A barman; a person who draws the beer from the taps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8abc9b7d-6c23-4a29-ba62-f79fe4716dcd",
                                                "sense_id": "cdabb492-20d8-3894-9be8-395c0a244a47",
                                                "text": "When the good lieutenant applied himself to the door, he applied himself likewise to the bell; and the drawer immediately attending, he dispatched him for a file of musqueteers and a surgeon."
                                            },
                                            {
                                                "example_id": "4205e0a8-b3f0-42fb-a4e6-995f78e6b393",
                                                "sense_id": "cdabb492-20d8-3894-9be8-395c0a244a47",
                                                "text": "He came down to the Pied Horse Inn, where I was a drawer, at Newmarket, twice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0579dd2f-0d55-3675-8817-12d4026f3cd6",
                                        "entry_id": "66ef587c-516a-33ec-ac72-e04f0c100011",
                                        "glosses": [
                                            "Someone who taps palm sap for making toddy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82bfd9f7-6641-4016-8597-18efd6176b81",
                                                "sense_id": "0579dd2f-0d55-3675-8817-12d4026f3cd6",
                                                "text": "A turban and loincloth soaked in blood had been found; also a staff. These properties were known to have belonged to a toddy drawer. He had disappeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41f2b024-d96b-3002-89c9-5f32de8ec779",
                                        "entry_id": "66ef587c-516a-33ec-ac72-e04f0c100011",
                                        "glosses": [
                                            "A wagoner or person who pushes underground tubs."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a5ec472-66dd-4ff9-ba4a-ec373a0a9a26",
                        "source_entry_id": "85a47e94-561d-3715-b337-82aa5d10bbac",
                        "source_sense_id": "01f7519e-32b0-3f27-a442-1dbd32134d07",
                        "source_sense_description": "uitschuifbare bergplaats",
                        "target_lang_word": "tiroir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiroir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b48a39da-b222-3198-ae1a-86bcec5f2f30",
                                        "entry_id": "81e8eccb-97bb-3ef7-ad54-5809fa02c4fb",
                                        "glosses": [
                                            "Casier, compartiment coulissant dans un meuble grâce à une poignée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d41fa4-6245-46eb-9ad1-cabf508aa4e3",
                                                "sense_id": "b48a39da-b222-3198-ae1a-86bcec5f2f30",
                                                "text": "Dans un tiroir, il y avait trente billets de mille francs, trente, attachés, par paquets de dix, avec des faveurs roses, ainsi que des lettres d’amour…"
                                            },
                                            {
                                                "example_id": "cfd02b2a-b033-4e1f-a33f-0361478cdad1",
                                                "sense_id": "b48a39da-b222-3198-ae1a-86bcec5f2f30",
                                                "text": "On emploie pour l’emmagasinement des cocons, des tiroirs dont le fond est constitué par un grillage métallique, désignés sous le nom de canisses ou claies."
                                            },
                                            {
                                                "example_id": "2325a248-cecb-4b94-95c2-e9986fbef11d",
                                                "sense_id": "b48a39da-b222-3198-ae1a-86bcec5f2f30",
                                                "text": "Henri se leva, fouilla dans un tiroir, exhuma tout un lot de paperasses qu’il éparpilla sur la table."
                                            },
                                            {
                                                "example_id": "0de2184e-70b1-4958-b62e-13c2fcdb409e",
                                                "sense_id": "b48a39da-b222-3198-ae1a-86bcec5f2f30",
                                                "text": "L’homme noir s’était levé à demi et cherchait avec impatience une lettre dans le tiroir de sa table de sapin qui s’ouvrit en criant."
                                            },
                                            {
                                                "example_id": "016865cb-f2ea-4e56-928c-09a2935bd4da",
                                                "sense_id": "b48a39da-b222-3198-ae1a-86bcec5f2f30",
                                                "text": "Elle ouvre le premier tiroir de sa coiffeuse pour s'emparer de l’original de son travail. Elle va le détruire, le réduire en cendres dans la jolie cheminée du salon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae9d3216-1b4d-3fbd-931d-d8436875b1e2",
                                        "entry_id": "81e8eccb-97bb-3ef7-ad54-5809fa02c4fb",
                                        "glosses": [
                                            "Panneau mobile qui coulisse sous le plancher de scène."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdac7cf4-0f2d-3ef0-abf9-8e5107995540",
                                        "entry_id": "81e8eccb-97bb-3ef7-ad54-5809fa02c4fb",
                                        "glosses": [
                                            "Prolongement de voie en impasse permettant le retournement des rames. On dit aussi tiroir de manœuvre et tiroir de retournement."
