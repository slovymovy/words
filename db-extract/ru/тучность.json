                                        "examples": [
                                            {
                                                "example_id": "0c875e60-3827-4e8c-8213-1ed04467880d",
                                                "sense_id": "78f20e94-a936-30f2-99e4-ae6d800f0fe3",
                                                "text": "\"Why this sudden concern about adiposity?\" asked Hardman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddc7286e-da6d-31c6-b11a-640de822f44b",
