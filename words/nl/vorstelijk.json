    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "61834b37-8163-3135-87bc-622927445517",
                    "sense_definition": "behorend bij of passend bij een vorst of koning",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koninklijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bediende wilde alleen maar buigen voor <w>vorstelijke</w> personen.",
                            "target_lang_translations": {
                                "en": "The servant only wanted to bow to <w>royal</w> persons."
                            }
                        },
                        {
                            "text": "Het paleis was ingericht met een <w>vorstelijke</w> pracht die indruk maakte op alle gasten.",
                            "target_lang_translations": {
                                "en": "The palace was furnished with a <w>regal</w> splendor that impressed all the guests."
                            }
                        }
                    ],
                    "synonyms": [
                        "prinselijk",
                        "koninklijk"
                    ],
                    "common_phrases": [
                        "vorstelijke familie",
                        "vorstelijke waardigheid"
                    ],
                    "target_lang_definitions": {
                        "en": "belonging to or befitting a monarch or king"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "royal",
                                "target_lang_sense_clarification": "relating to a monarch or their family"
                            },
                            {
                                "target_lang_word": "regal",
                                "target_lang_sense_clarification": "befitting or resembling a monarch"
                            },
                            {
                                "target_lang_word": "princely",
                                "target_lang_sense_clarification": "relating to a prince or sovereign"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e152d27-2fdb-3e6e-b5ce-8731421edc4e",
                    "sense_definition": "zeer groot, luxueus of indrukwekkend van kwaliteit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "luxe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange wandeling genoten we van een <w>vorstelijk</w> ontbijt in het hotel.",
                            "target_lang_translations": {
                                "en": "After the long walk, we enjoyed a <w>sumptuous</w> breakfast at the hotel."
                            }
                        },
                        {
                            "text": "Zij boden ons een <w>vorstelijk</w> onthaal aan bij onze aankomst.",
                            "target_lang_translations": {
                                "en": "They offered us a <w>magnificent</w> welcome upon our arrival."
                            }
                        }
                    ],
                    "synonyms": [
                        "royaal"
                    ],
                    "common_phrases": [
                        "vorstelijk onthaal",
                        "vorstelijk ontbijt"
                    ],
                    "target_lang_definitions": {
                        "en": "very large, luxurious, or impressive in quality"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sumptuous",
                                "target_lang_sense_clarification": "splendid and expensive-looking"
                            },
                            {
                                "target_lang_word": "magnificent",
                                "target_lang_sense_clarification": "impressively beautiful or elaborate"
                            },
                            {
                                "target_lang_word": "grand",
                                "target_lang_sense_clarification": "magnificent and imposing in appearance"
                            },
                            {
                                "target_lang_word": "royal",
                                "target_lang_sense_clarification": "of more than common size or excellence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55977305-105a-381a-baf8-c69c7f58478c",
                    "sense_definition": "zeer vrijgevig of overvloedig",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vrijgevigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur kreeg een <w>vorstelijke</w> beloning voor zijn jarenlange inzet.",
                            "target_lang_translations": {
                                "en": "The director received a <w>princely</w> reward for his years of dedication."
                            }
                        },
                        {
                            "text": "Hij gaf de ober een <w>vorstelijke</w> fooi omdat de service uitstekend was.",
                            "target_lang_translations": {
                                "en": "He gave the waiter a <w>generous</w> tip because the service was excellent."
                            }
                        }
                    ],
                    "synonyms": [
                        "royaal"
                    ],
                    "common_phrases": [
                        "vorstelijke beloning",
                        "vorstelijke fooi"
                    ],
                    "target_lang_definitions": {
                        "en": "very generous or abundant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "princely",
                                "target_lang_sense_clarification": "very generous (of a sum of money)"
                            },
                            {
                                "target_lang_word": "generous",
                                "target_lang_sense_clarification": "showing a readiness to give more than is necessary"
                            },
                            {
                                "target_lang_word": "lavish",
                                "target_lang_sense_clarification": "sumptuously rich or elaborate"
                            },
                            {
                                "target_lang_word": "handsome",
                                "target_lang_sense_clarification": "substantial or generous in amount"
                            }
                        ]
                    }
                }
            ]
        }
    ]
