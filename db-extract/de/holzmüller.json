                ],
                "senses": [
                    {
                        "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                        "entry_id": "6009e732-738a-3386-b33e-61f1e9d7a090",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386b95ee-b4ba-4a4a-b9aa-9a5d2c734e68",
                                "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                                "text": "Frau Holzmüller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c357d629-7c76-443a-92de-0a0555798b9a",
                                "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                                "text": "Herr Holzmüller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "efdda018-af4f-4364-bb61-14a6076caf77",
                                "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                                "text": "Die Holzmüllers fahren heute nach Leipzig."
                            },
                            {
                                "example_id": "ef17c5b5-9d01-4af1-9107-d33c61324139",
                                "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                                "text": "Der Holzmüller trägt nie die Pullover, die die Holzmüller ihm strickt."
                            },
                            {
                                "example_id": "b42cbc3f-fabc-41a6-978f-d8736430adb8",
                                "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Holzmüller kommt, geht der Herr Holzmüller.“"
                            },
                            {
                                "example_id": "36dc5eb5-596a-451a-ad82-f2decde0cfe9",
                                "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                                "text": "Holzmüller kommt und geht."
                            },
                            {
                                "example_id": "b9f32268-46f3-478a-9d8c-5a768c330df7",
                                "sense_id": "45c7e26e-1bf5-3356-9859-f278348f237b",
                                "text": "Holzmüllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
