                    {
                        "sense_id": "baaddc53-aca5-376d-af36-5e45c441af34",
                        "entry_id": "b6b63bf5-2e7f-34f4-91d0-f6c4401be6fc",
                        "glosses": [
                            "vuur dat delen van een huis of woongebouw verteert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1da1f549-8a7f-4438-bcb0-8ce35afdf8c3",
                                "sense_id": "baaddc53-aca5-376d-af36-5e45c441af34",
                                "text": "Bij het blussen van een uitslaande woningbrand in Amsterdam Nieuw-West heeft de brandweer vanochtend een lichaam gevonden."
                            },
                            {
                                "example_id": "eae6d90d-5448-4a45-920c-3db4e671ded7",
                                "sense_id": "baaddc53-aca5-376d-af36-5e45c441af34",
                                "text": "De voorz. zou nog wel willen vernemen, hoe de raad denkt over het laten werken van de Ter Apeler brandspuit bij branden buiten de gemeente zooals thans bij den veenbrand onder de gem. Emmen. Het meerendeel der leden acht het niet wenschelijk in zoo'n geval de brandspuit buiten de gemeente te voeren; iets anders is het bij woningbrand op betrekkelijk korten afstand in andere gemeenten."
                            }
                        ]
                    }
