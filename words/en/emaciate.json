{
    "word_family": [
        "emaciation",
        "emaciated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75381e2c-b1ba-34c1-8823-162271755214",
                    "sense_definition": "To cause someone or something to become abnormally thin and weak, typically through lack of food or disease.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "make_or_become_thin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prolonged illness and lack of food threatened to <w>emaciate</w> the patient entirely.",
                            "target_lang_translations": {
                                "es": "La enfermedad prolongada y la falta de alimento amenazaban con <w>demacrar</w> por completo al paciente."
                            }
                        },
                        {
                            "text": "The strict famine continued to <w>emaciate</w> the entire village throughout the harsh winter.",
                            "target_lang_translations": {
                                "es": "La severa hambruna continuó <w>extenuando</w> a todo el pueblo a lo largo del crudo invierno."
                            }
                        }
                    ],
                    "synonyms": [
                        "waste",
                        "atrophy"
                    ],
                    "antonyms": [
                        "fatten"
                    ],
                    "target_lang_definitions": {
                        "es": "Hacer que alguien o algo adelgace y se debilite de forma extrema, generalmente por falta de alimento o por enfermedad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "demacrar",
                                "target_lang_sense_clarification": "hacer enflaquecer de forma enfermiza"
                            },
                            {
                                "target_lang_word": "emaciar",
                                "target_lang_sense_clarification": "adelgazar extremadamente (culto)"
                            },
                            {
                                "target_lang_word": "extenuar",
                                "target_lang_sense_clarification": "debilitar y adelgazar por hambre o fatiga"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be9e4313-845e-3e31-95be-b9f7fa678a4a",
                    "sense_definition": "To lose a great deal of weight and become abnormally thin or wasted away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_or_become_thin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper nutrition, the captive began to <w>emaciate</w> week by week.",
                            "target_lang_translations": {
                                "es": "Sin una nutrición adecuada, el cautivo empezó a <w>demacrarse</w> semana tras semana."
                            }
                        },
                        {
                            "text": "The stray dog will slowly <w>emaciate</w> if it cannot find regular sustenance.",
                            "target_lang_translations": {
                                "es": "El perro callejero se <w>consumirá</w> lentamente si no logra encontrar sustento con regularidad."
                            }
                        }
                    ],
                    "synonyms": [
                        "waste away",
                        "pine"
                    ],
                    "target_lang_definitions": {
                        "es": "Perder mucho peso y quedar sumamente delgado, consumido o debilitado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "demacrarse",
                                "target_lang_sense_clarification": "adelgazar y desmejorarse de forma notable"
                            },
                            {
                                "target_lang_word": "emaciarse",
                                "target_lang_sense_clarification": "perder masa corporal en extremo (culto)"
                            },
                            {
                                "target_lang_word": "consumirse",
                                "target_lang_sense_clarification": "debilitarse y perder peso por enfermedad o hambre"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d1576307-3a62-3f52-9e5a-8105327d3e49",
                    "sense_definition": "Abnormally thin or gaunt; <w>emaciated</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_or_become_thin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>emaciate</w> frame showed how severely the journey had tested his endurance.",
                            "target_lang_translations": {
                                "es": "Su complexión <w>demacrada</w> mostraba cuán duramente había puesto a prueba el viaje su resistencia."
                            }
                        },
                        {
                            "text": "The poet described her pale and <w>emaciate</w> appearance in the verse.",
                            "target_lang_translations": {
                                "es": "El poeta describió su aspecto pálido y <w>emaciado</w> en el verso."
                            }
                        }
                    ],
                    "synonyms": [
                        "emaciated",
                        "gaunt",
                        "skeletal"
                    ],
                    "antonyms": [
                        "plump",
                        "fat"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used as an adjective synonym for emaciated"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Anormalmente delgado, demacrado o consumido."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "demacrado",
                                "target_lang_sense_clarification": "extremadamente delgado y con aspecto enfermizo"
                            },
                            {
                                "target_lang_word": "emaciado",
                                "target_lang_sense_clarification": "sumamente consumido o esquelético (culto)"
                            },
                            {
                                "target_lang_word": "esquelético",
                                "target_lang_sense_clarification": "en los huesos"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}