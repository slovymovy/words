                "senses": [
                    {
                        "sense_id": "d9672217-d3f6-372f-bf75-d8e6873df1ca",
                        "entry_id": "564d5d8d-a420-3421-a3cf-02daf9f71f7b",
                        "glosses": [
                            "истор. та, которая продаёт булавки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b159ce-3c18-4ba7-ba88-bb31e737d379",
                                "sense_id": "d9672217-d3f6-372f-bf75-d8e6873df1ca",
                                "text": "Камердинер пустился на поиски и нашёл у одной булавочницы девочку 14 лет удивительной красоты, её племянницу."
                            }
                        ]
                    },
                    {
                        "sense_id": "7adc1bc1-66c1-33b8-8652-4efa911f8e88",
                        "entry_id": "564d5d8d-a420-3421-a3cf-02daf9f71f7b",
                        "glosses": [
                            "разг. коробочка или подушечка для булавок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3482b3c8-b117-4f13-a382-e2bd21bf39f9",
                                "sense_id": "7adc1bc1-66c1-33b8-8652-4efa911f8e88",
                                "text": "Как и его комната, обставленная креслами с бахромой и украшенная пестрыми подушечками-булавочницами… Джэспер Холт имел вид почти аристократический."
                            }
                        ]
                    }
