                ],
                "senses": [
                    {
                        "sense_id": "7692afcd-5fd3-3668-a056-ebe76a262472",
                        "entry_id": "c3c8e8ff-7c76-365b-980c-88acd89d18a7",
                        "glosses": [
                            "вспахать (пространство между чем-нибудь)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b7ee09-017b-4e53-8fdb-15bc5ae6cdc1",
                                "sense_id": "7692afcd-5fd3-3668-a056-ebe76a262472",
                                "text": "А углуби-ка её, пропаши хорошенько, пробери её так, как немец пробирает, ― хлеба не оберёшься."
                            },
                            {
                                "example_id": "6c0874b3-fc37-4aa7-9756-f7c954997c80",
                                "sense_id": "7692afcd-5fd3-3668-a056-ebe76a262472",
                                "text": "Картофель пропахан, зеленеет между черными бороздами, рожь налила все зерно."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6de828d-302c-3ee5-945b-d277cb3b00ea",
                        "entry_id": "c3c8e8ff-7c76-365b-980c-88acd89d18a7",
                        "glosses": [
                            "провести борозду плугом, сохой"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2177367d-c418-31e1-a0bf-fc61e36cc472",
                        "entry_id": "c3c8e8ff-7c76-365b-980c-88acd89d18a7",
                        "glosses": [
                            "провести какое-нибудь определенное время в пахоте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254cf3b0-266f-4b6c-a767-05fa5ae3b62d",
                                "sense_id": "2177367d-c418-31e1-a0bf-fc61e36cc472",
                                "text": "Пропахать до ночи. Пропахать весь день поле."
                            }
                        ]
                    }
