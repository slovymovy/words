                                "example_id": "af599303-4bfc-44eb-95b6-0e819fa6794d",
                                "sense_id": "9dc98c4e-14ac-3473-99a5-3ee1413a2b6b",
                                "text": "Heuglijk nieuws in bange tijden. De Apenheul meldt deze eerste paasdag de geboorte van een hanuman langoer."
                            },
                            {
                                "example_id": "25855df4-329b-46e6-a6c2-58f4c637f173",
                                "sense_id": "9dc98c4e-14ac-3473-99a5-3ee1413a2b6b",
                                "text": "Tot voor kort werden nog tamme grijze langoeren, een grotere apensoort, aan de ministeries ingezet om kleinere apen die op talloze plaatsen voor problemen zorgen op afstand te houden."
                            }
                        ]
                    }
