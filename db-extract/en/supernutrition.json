    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9309a7bf-6296-3cbc-8198-9439541f7a07",
                "word": "supernutrition",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "631135f7-c286-3202-9b83-6d2f07b2aa32",
                        "entry_id": "9309a7bf-6296-3cbc-8198-9439541f7a07",
                        "glosses": [
                            "The presence of excessive quantities of nutrients, especially such as leads to hypertrophy or to excessive growth."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "61396e0c-0c9a-44e8-a942-678e9e1feae1",
                                "sense_id": "631135f7-c286-3202-9b83-6d2f07b2aa32",
                                "text": "The sarcomatous testicle, for example, as it was formerly called, in conformity with the nomenclature of the English surgeon, is merely a chronic enlargement of that organ, the result of inflammatory deposits and supernutrition of its proper structures."
                            },
                            {
                                "example_id": "9890374a-bd82-4ffe-85bf-45673afb6cb5",
                                "sense_id": "631135f7-c286-3202-9b83-6d2f07b2aa32",
                                "text": "The result is that the veins become overcharged with blood, and we are taught by physiology that wherever there is overcharge of the venous circulation there results supernutrition, and primarily from that there develops new connective tissue."
                            },
                            {
                                "example_id": "61027282-0647-4840-870e-05343663b85e",
                                "sense_id": "631135f7-c286-3202-9b83-6d2f07b2aa32",
                                "text": "The principal feature of carcinomatous cell proliferations can be denoted as hypermitosis, depending upon supernutrition of the cells."
                            },
                            {
                                "example_id": "9369ca79-83be-4ff8-8a98-a097343debd7",
                                "sense_id": "631135f7-c286-3202-9b83-6d2f07b2aa32",
                                "text": "The protein of the blood plasma is not a constant but a fluctuating quantity, being lowered in sickness and subnutrition and raised in supernutrition."
                            },
                            {
                                "example_id": "c93f364c-548d-4996-a9fa-baec3cfb0c1d",
                                "sense_id": "631135f7-c286-3202-9b83-6d2f07b2aa32",
                                "text": "The pollution includes heavy metals, nitrogen, phosphorus, sulfides and supernutrition."
                            }
                        ]
                    },
                    {
                        "sense_id": "12b6c0c0-8dc4-3be9-a78d-d870c82b6216",
                        "entry_id": "9309a7bf-6296-3cbc-8198-9439541f7a07",
                        "glosses": [
                            "The ingestion of large amounts of nutrients; Hyperalimentation."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a6b774f-ee09-4a5c-a337-288e84e97129",
                                "sense_id": "12b6c0c0-8dc4-3be9-a78d-d870c82b6216",
                                "text": "This text explains in layperson's terms how supernutrition, magnetic therapy and other cutting edge therapies can offer hope to those suffering from so-called untreatable conditions."
                            },
                            {
                                "example_id": "abafd225-0ebd-4115-a2cb-ce438fa3c398",
                                "sense_id": "12b6c0c0-8dc4-3be9-a78d-d870c82b6216",
                                "text": "Although both skeletal and dental development can be delayed by undernutrition or advanced by supernutrition, the dentition is much more resistant to environmental effects than is the skeleton[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "8e285674-aece-3ef2-8e7f-367372064f26",
                        "entry_id": "9309a7bf-6296-3cbc-8198-9439541f7a07",
                        "glosses": [
                            "Overeating."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a96161df-997c-4d47-8ca0-46d4fcbf6da0",
                                "sense_id": "8e285674-aece-3ef2-8e7f-367372064f26",
                                "text": "Biernacki (1909) sought to determine with dogs the effects of \"supernutrition\" on mineral metabolism. The foods added to the standard diets were butter, sugar and eggs."
                            },
                            {
                                "example_id": "39b59e07-028b-4ca0-9416-4f43bf81bf24",
                                "sense_id": "8e285674-aece-3ef2-8e7f-367372064f26",
                                "text": "But how to change attitudes and habits in nutrition when global acting enterprises earn their money by selling billion tons of sugar and meat followed by drugs to cure diseases caused by supernutrition."
                            }
                        ]
                    }
