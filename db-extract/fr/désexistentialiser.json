                ],
                "senses": [
                    {
                        "sense_id": "022427c7-a1e9-3609-a1cd-6b57bfc39d76",
                        "entry_id": "3073ade6-ffa8-3b3e-ba0c-24318bdd8799",
                        "glosses": [
                            "Ne pas considérer d’un point de vue existentiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc67248-07e6-4b8d-933e-4f0506a3be29",
                                "sense_id": "022427c7-a1e9-3609-a1cd-6b57bfc39d76",
                                "text": "Qu’on ne s’effraie pas ; je ne suis pas de ceux qui savourent leur « en soi » ; je ne me suis, relativement, trouvé qu’en dehors de moi, en me « désexistentialisant » au maximum."
                            },
                            {
                                "example_id": "0a54fa65-91c4-4062-879f-b34c9ef02959",
                                "sense_id": "022427c7-a1e9-3609-a1cd-6b57bfc39d76",
                                "text": "L’action du chrétien, telle celle de Marthe, consiste dès lors à se désexistentialiser pour faire place à la pure présence de la Déité qui réclame le néant."
                            }
                        ]
                    }
                ],
