            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5946025a-6e8e-3d07-9e66-de096d157b1c",
                    "sense_definition": "Petit étui plat, généralement en cuir ou en tissu, conçu pour conserver sur soi des billets de banque, des cartes bancaires et des pièces d'identité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "objet_personnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a sorti son <w>portefeuille</w> pour payer l'addition au restaurant."
                        },
                        {
                            "text": "J'ai oublié mon <w>portefeuille</w> avec mes papiers d'identité à la maison."
                        }
                    ],
                    "synonyms": [
                        "larfeuille",
                        "morlingue",
                        "porte-pèze"
                    ],
                    "common_phrases": [
                        "mettre la main au portefeuille",
                        "perdre son portefeuille"
                    ]
                },
                {
                    "sense_id": "251820a7-9810-3acf-bc19-f99309fb8073",
                    "sense_definition": "Employé en apposition pour désigner un vêtement qui se ferme en croisant un pan sur l'autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mode",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle porte souvent une robe <w>portefeuille</w> très élégante pour aller travailler."
                        },
                        {
                            "text": "Cette jupe <w>portefeuille</w> noire s'attache simplement sur le côté."
                        }
                    ],
                    "common_phrases": [
                        "robe portefeuille",
                        "jupe portefeuille"
                    ]
                },
                {
                    "sense_id": "c155b258-5e20-3b37-83ab-3e38da216368",
                    "sense_definition": "Grand étui en carton, en cuir ou en toile destiné à ranger et transporter des documents ou des dessins.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "classement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte range tous ses plans dans un grand <w>portefeuille</w> en carton."
                        },
                        {
                            "text": "Il a rassemblé ses documents importants dans plusieurs <w>portefeuilles</w> étiquetés."
                        }
                    ],
                    "common_phrases": [
                        "portefeuille de maroquin"
                    ]
                },
                {
                    "sense_id": "70155982-1b04-355f-a423-a9c9bd6005b4",
                    "sense_definition": "Ensemble des valeurs mobilières, titres boursiers ou créances financières détenus par un particulier, une entreprise ou un établissement bancaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'analyste conseille de diversifier son <w>portefeuille</w> d'actions pour limiter les risques."
                        },
                        {
                            "text": "La banque gère un important <w>portefeuille</w> de titres pour ses clients."
                        }
                    ],
                    "common_phrases": [
                        "portefeuille d'actions",
                        "gestion de portefeuille"
                    ]
                },
                {
                    "sense_id": "746fe877-e67b-31a9-8d5b-bb5a4b59305c",
                    "sense_definition": "Charge, mandat ou fonction attribuée à un ministre au sein d'un gouvernement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le Premier ministre lui a confié le <w>portefeuille</w> de l'Éducation nationale."
                        },
                        {
                            "text": "Plusieurs députés espéraient obtenir un <w>portefeuille</w> lors du remaniement ministériel."
                        }
                    ],
                    "common_phrases": [
                        "portefeuille ministériel",
                        "ministre sans portefeuille"
                    ]
                },
                {
                    "sense_id": "80e63209-a08b-398e-973c-4f2b852d61fc",
                    "sense_definition": "Ensemble ou recueil d'œuvres graphiques, de dessins ou d'estampes constituant la sélection d'un artiste ou d'un amateur d'art.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune illustrateur a présenté son <w>portefeuille</w> de dessins à la maison d'édition."
                        },
                        {
                            "text": "Ce musée conserve le <w>portefeuille</w> complet des gravures du maître flamand."
