                        "examples": [
                            {
                                "example_id": "12a8b142-82b1-4569-8c31-10dd8f79c242",
                                "sense_id": "e99cb541-beee-3b7f-a4ab-cb3b55c90755",
                                "text": "Drumb last vns brauchen dieser zeit/\nEs ist nichts mit der Ewigkeit.\nDaruon die Pfaffen immer sagen:\nDarauff wil ichs frey tapffer wagn.\nIch geb nicht drumb ein Pappelstiel/\nKürtzweil zu treiben ist mein will.",
                                "translation": "So let’s rock time’s opportunity/\nThere is nothing like eternity\nOf which the imams all day quethe\nThus I dare the life free and keen\nAbout that fuss I care no bit/\nThe pursuit of delight I hit.",
                                "english": "So let’s rock time’s opportunity/\nThere is nothing like eternity\nOf which the imams all day quethe\nThus I dare the life free and keen\nAbout that fuss I care no bit/\nThe pursuit of delight I hit."
                            },
                            {
                                "example_id": "32f2b680-1b66-45ce-abc8-16d12b81c298",
                                "sense_id": "e99cb541-beee-3b7f-a4ab-cb3b55c90755",
                                "text": "Laufen ihm immer noch junge Talente nach, die sich ein Engagement erhoffen, und die für einen Pappenstiel für ihn spielen wollen?",
                                "translation": "Are there still young talents running after him hoping for an engagement and willing to play for a pittance?",
                                "english": "Are there still young talents running after him hoping for an engagement and willing to play for a pittance?"
                            }
                        ]
                    }
