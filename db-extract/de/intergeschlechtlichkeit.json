                                    {
                                        "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                        "entry_id": "8c30c302-3a83-3962-afe9-391e149bf83e",
                                        "glosses": [
                                            "Fait pour un être humain ou un animal de posséder des caractéristiques sexuelles qui ne correspondent pas aux définitions de mâle ou femelle selon les normes en vigueur."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1117bc3-b3a5-49b0-b3f8-08bcf2af8187",
                                                "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                                "text": "A l’exception du free-martinisme bovin, l’intersexualité est rare chez les animaux domestiques."
                                            },
                                            {
                                                "example_id": "34254a46-36bd-4560-bae0-1bb447f64a36",
                                                "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                                "text": "La dysphorie de genre est liée au désir d’avoir un corps dont le sexe est en accord avec la perception de soi et l’intersexualité est liée au fait d’être pourvu d’un corps qui n’appartient pas d’emblée à un sexe défini."
                                            },
                                            {
                                                "example_id": "910782ed-aa30-4cbf-b0ab-7e3f7040eb72",
                                                "sense_id": "9fcc12a7-6958-3bef-b755-32d602e9c8e5",
                                                "text": "La découverte de son intersexualité — cachée par ses parents « pour la protéger », et les médecins, qui n’ont eu de cesse de couloir la « réparer », — a bouleversé sa vie."
                                            }
                                        ]
                                    }
