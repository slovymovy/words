                        "cross_references": [
                            {
                                "target_word": "koortsthermometer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb6e095-9acd-361d-9d83-3e6972828841",
                                        "entry_id": "83889e74-aaf3-3945-bd41-1d54937bd960",
                                        "glosses": [
                                            "meetinstrument voor het bepalen van de lichaamstemperatuur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76c9e1ce-e17c-434d-8e0f-244bcbb173e2",
                                                "sense_id": "cbb6e095-9acd-361d-9d83-3e6972828841",
                                                "text": "NASA kan hulp vragen aan ondernemingen, het kan ook andersom. Zo heeft Diatek, een bedrijf in San Diego, met behulp van NASA de oorthermometer ontwikkeld, die de lichaamstemperatuur opneemt door meting van infraroodstraling. Sneller, hygiënischer en minder onaangenaam dan een koortsthermometer."
                                            },
                                            {
                                                "example_id": "2e0a865c-1a67-4c68-8b57-a6beb49602d3",
                                                "sense_id": "cbb6e095-9acd-361d-9d83-3e6972828841",
                                                "text": "Een medewerkster van de apotheek liet rond kwart voor 12 maandagochtend een koortsthermometer op de grond vallen. Die viel kapot, het kwik rolde alle kanten op. In totaal zo'n 50 artsen, medewerkers en patiënten moesten daarop het gebouw verlaten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a53f1a37-eff9-472d-9690-64f206d48126",
                        "source_entry_id": "1ae638d5-a15c-3393-a82a-d5a2a292c23f",
                        "source_sense_id": "7251e5f8-27e6-3494-a513-9b10086070f8",
                        "source_sense_description": "Thermometer, mit dem die Körpertemperatur gemessen werden kann",
                        "target_lang_word": "градусник",
