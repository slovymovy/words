                        "glosses": [
                            "To turn (something) into trash; to lower the quality of."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "26323f2b-5678-47a6-94a9-f9ce69ea0508",
                                "sense_id": "39b82289-34d3-300a-adb9-016b8dde390d",
                                "text": "Today many people are cheapening themselves, devaluating their lives, trashifying their characters. They have strayed from and lost the high regard for themselves."
                            },
                            {
                                "example_id": "6b20f96f-fcd2-4076-8019-853983c6cf31",
                                "sense_id": "39b82289-34d3-300a-adb9-016b8dde390d",
                                "text": "Trashify all reports with irrelevant data, maps, charts, and computer readouts."
                            },
                            {
                                "example_id": "a1d925d0-35e9-48ba-a69c-d9e2d384356b",
                                "sense_id": "39b82289-34d3-300a-adb9-016b8dde390d",
                                "text": "Same with font-sizes, have to bump it up a point or 2 because Netscape 4 displays it smaller than the rest of the browsers, so to get it to look \"acceptable\" in that 13%, you have to trashify the remaining 87% by placing bloated, non-compliant code which makes performance much worse."
                            }
                        ]
                    }
