    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "367a2f0e-b260-3637-a684-d0e9ae722c73",
                "word": "kippering",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fdac58c2-0370-3b25-89f5-fafa0b858842",
                        "entry_id": "367a2f0e-b260-3637-a684-d0e9ae722c73",
                        "glosses": [
                            "The trait of walking on the front legs while dragging the hind legs (applied to a dog)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "715c1853-521b-4a2d-adff-c753fa60967b",
                                "sense_id": "fdac58c2-0370-3b25-89f5-fafa0b858842",
                                "text": "An owner describes their \"endearing habit of nosewrinkling, woo-woo-wooing, and kippering (walking on front legs, sliding rear like a seal).\""
                            },
                            {
                                "example_id": "796dd563-386d-4723-9f5f-990a5d69b1a9",
                                "sense_id": "fdac58c2-0370-3b25-89f5-fafa0b858842",
                                "text": "Kippering is a trait in young Sussex where the dog propels themselves forward with their forelegs while dragging their rear legs extended behind them. Some adult dogs will also do this and it is considered normal for the breed."
                            },
                            {
                                "example_id": "48630f3c-b6d9-4e5f-b3a1-9773d6e06050",
                                "sense_id": "fdac58c2-0370-3b25-89f5-fafa0b858842",
                                "text": "Many Sussex like to propel themselves forward with their front legs while dragging their hind legs outstretched behind them—this is known as kippering and it is a normal breed trait."
                            }
                        ]
                    },
                    {
                        "sense_id": "29619d6d-f780-371d-9b7e-c471eb214c85",
                        "entry_id": "367a2f0e-b260-3637-a684-d0e9ae722c73",
                        "glosses": [
                            "The development of an acquired hypospadias, usually as a result of long use of a catheter."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3d1a745-58d2-4e6f-a059-f14e9defcf4a",
                                "sense_id": "29619d6d-f780-371d-9b7e-c471eb214c85",
                                "text": "The latter is so often remote from where the tube has been that it is difficult to see how any drainage short of “kippering” the patient could eliminate it."
                            },
                            {
                                "example_id": "ba8a618c-45b4-4069-8211-dc3744d49add",
                                "sense_id": "29619d6d-f780-371d-9b7e-c471eb214c85",
                                "text": "The suprapubic route (suprapubic catheter [SPC]) is preferred over the urethral because of pressure necrosis of the ventral surface of the distal penile urethra in men (acquired hypospadias —“kippering” of the penis) and pressure necrosis of the bladder neck in women, which becomes so wide that urine leaks around the catheter (\"patulous\" urethra)"
                            },
                            {
                                "example_id": "00b48d5f-f33c-413b-983d-06640438e77d",
                                "sense_id": "29619d6d-f780-371d-9b7e-c471eb214c85",
                                "text": "It is commonly thought to be due to urological surgery and particularly instrumentation but it can occur without this, such as with the kippering of the urethra that one sees with an indwelling catheter (Fig. 4.6.9), or the damage to the shaft of the penis and the urethra within caused by protracted condom drainage."
                            }
                        ]
                    }
                ],
