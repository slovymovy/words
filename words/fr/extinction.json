    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c099939-5206-3f06-8a8d-4a6ada08494c",
                    "sense_definition": "Fait d'éteindre une flamme ou une lumière, ou disparition complète et irréversible d'une espèce vivante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques s'inquiètent de l'<w>extinction</w> rapide de nombreuses espèces animales."
                        },
                        {
                            "text": "Le règlement de la colonie prévoit l'<w>extinction</w> des feux à vingt-deux heures."
                        }
                    ],
                    "synonyms": [
                        "disparition",
                        "anéantissement"
                    ],
                    "antonyms": [
                        "apparition",
                        "allumage"
                    ],
                    "common_phrases": [
                        "extinction des espèces",
                        "extinction des feux",
                        "extinction de voix"
                    ]
                },
                {
                    "sense_id": "4ec8ded3-6162-30f7-a35d-a6304a1b30df",
                    "sense_definition": "Annulation légale ou fin programmée d'un droit, d'une obligation ou d'une dette.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le remboursement complet a entraîné l'<w>extinction</w> de la dette bancaire."
                        },
                        {
                            "text": "La signature du nouveau traité a provoqué l'<w>extinction</w> immédiate des anciens privilèges."
                        }
                    ],
                    "synonyms": [
                        "abolition",
                        "annulation"
                    ],
                    "antonyms": [
                        "création",
                        "renouvellement"
                    ],
                    "common_phrases": [
                        "extinction d'une dette",
                        "voie d'extinction"
                    ]
                },
                {
                    "sense_id": "7a62105a-5fd7-3889-9cc0-41a81c1db635",
                    "sense_definition": "Épuisement total des forces physiques ou de l'énergie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fatigue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur a parlé jusqu'à l'<w>extinction</w> complète de sa voix."
                        },
                        {
                            "text": "Les manifestants ont crié leurs revendications jusqu'à <w>extinction</w> de leurs forces."
