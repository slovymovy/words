        "fr-extract.jsonl": [
            {
                "entry_id": "b96df620-afcf-3ee6-b288-787ca2393bd5",
                "word": "relaxe",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36acf6aa-5172-3f47-8901-b487686bf8f9",
                        "entry_id": "b96df620-afcf-3ee6-b288-787ca2393bd5",
                        "glosses": [
                            "Relaxant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b710089c-2879-4334-a922-1949c6c69264",
                                "sense_id": "36acf6aa-5172-3f47-8901-b487686bf8f9",
                                "text": "Mollement enfoncé dans un fauteuil relaxe de la salle de séjour de son appartement privé, un verre de whisky à portée de la main, Jacques Dubois-Rimbert laissait paresseusement errer son regard sur les toiles de maîtres qui ornaient les murs aux teintes beige rosé de la pièce."
                            },
                            {
                                "example_id": "e1a8ca48-90f6-403b-b278-15bc22f2044d",
                                "sense_id": "36acf6aa-5172-3f47-8901-b487686bf8f9",
                                "text": "Siegfried s’y trouvait, en effet, étendu dans un fauteuil relaxe et plongé dans un vieux roman de la Terre."
                            },
                            {
                                "example_id": "95542398-ea4a-4a5c-84af-451481a54952",
                                "sense_id": "36acf6aa-5172-3f47-8901-b487686bf8f9",
                                "text": "La vieille femme s’assit dans son fauteuil relaxe, judicieusement installé à proximité de la baie vitrée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c3edcf54-3814-3f83-9e29-8de29ca27111",
                "word": "relaxe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d8a77b53-a644-49b4-b7cb-8209eaf6d9e2",
                        "entry_id": "c3edcf54-3814-3f83-9e29-8de29ca27111",
                        "tags": [
                            "plural"
                        ],
                        "form": "relaxes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "686343bb-3467-35c3-9e1b-41f79e7707c3",
                        "entry_id": "c3edcf54-3814-3f83-9e29-8de29ca27111",
                        "glosses": [
                            "Jugement qui prononce la cessation des poursuites contre un prévenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3c7181-c60b-4ba0-8fbc-aa1dda36b842",
                                "sense_id": "686343bb-3467-35c3-9e1b-41f79e7707c3",
                                "text": "Plaider la relaxe."
                            },
                            {
                                "example_id": "bdc9eb95-60ef-4ea7-ba90-e0ef4dc13d45",
                                "sense_id": "686343bb-3467-35c3-9e1b-41f79e7707c3",
                                "text": "Il n’y avait pas eu ici de condamnation prononcée, puisqu'il y avait eu relaxe."
                            },
                            {
                                "example_id": "f7dffdfe-c08e-4339-843f-fe94d7ae0c16",
                                "sense_id": "686343bb-3467-35c3-9e1b-41f79e7707c3",
                                "text": "Attendu, dès lors, qu’en prononçant le relaxe du prévenu des poursuites dirigées contre lui…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80639a16-e05d-4abc-9ee5-b464074c2298",
                        "source_entry_id": "c3edcf54-3814-3f83-9e29-8de29ca27111",
                        "source_sense_id": "686343bb-3467-35c3-9e1b-41f79e7707c3",
                        "target_lang_word": "vrijspraak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vrijspraak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b68f0c88-d7c8-3fe4-bfac-41200f12f164",
                                        "entry_id": "a770cf52-a5a3-388c-bb6b-4bd75cb22abd",
                                        "glosses": [
                                            "uitspraak in een strafproces, die inhoudt dat de rechter niet wettig en overtuigend bewezen acht dat de verdachte het ten laste gelegde feit heeft begaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a750270e-1498-481c-9961-312b0173d6f1",
                                                "sense_id": "b68f0c88-d7c8-3fe4-bfac-41200f12f164",
                                                "text": "Vrijspraak betekent niet dat je het niet gedaan hebt, het betekent alleen maar dat het niet bewezen kan worden."
                                            },
                                            {
                                                "example_id": "acc4bc26-adeb-43be-a598-aebedd1899aa",
                                                "sense_id": "b68f0c88-d7c8-3fe4-bfac-41200f12f164",
                                                "text": "De Nederlandse levensmiddelentechnoloog Harm Fitié (44), in China wegens doodslag op zijn buurman tot twaalf jaar cel veroordeeld, heeft al zijn hoop op vrijspraak of een nieuw proces gevestigd op het hooggerechtshof in Beijing. „Hij heeft geloof in het Chinese systeem niet helemaal verloren. Dat houdt hem op de been. Zwaar is het wel”, vertelt zijn Franse vriendin Dianne Vandesmet. Zij werkte in Beijing als journaliste bij de Chinese staatstelevisie en bij de Franse Kamer van Koophandel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
