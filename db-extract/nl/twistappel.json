        "nl-extract.jsonl": [
            {
                "entry_id": "8e93f83b-46a3-3704-9eab-103e099d1000",
                "word": "twistappel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8fad0f8e-a2d6-4dbb-b5fb-339f0de44934",
                        "entry_id": "8e93f83b-46a3-3704-9eab-103e099d1000",
                        "tags": [
                            "plural"
                        ],
                        "form": "twistappels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bf88091-33a8-30a8-a8a4-cc090dfa91b2",
                        "entry_id": "8e93f83b-46a3-3704-9eab-103e099d1000",
                        "glosses": [
                            "iets waar mensen of groepen van mensen ruzie over hebben / de aanleiding tot tweedracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae24092-0863-46fe-b301-844dab9fb86d",
                                "sense_id": "4bf88091-33a8-30a8-a8a4-cc090dfa91b2",
                                "text": "Ook de Ierse grens blijft een twistappel. Ierland, nog in de Unie, wil niet dat er een harde grens komt met Noord-Ierland, dat bij het VK hoort. Maar tegelijk kan Ierland ook niet de vrijhaven worden van waar Europese producten zonder probleem het VK binnenkomen."
                            },
                            {
                                "example_id": "399e0a0f-f4ac-4d42-8c6b-df7e714142fb",
                                "sense_id": "4bf88091-33a8-30a8-a8a4-cc090dfa91b2",
                                "text": "Servië en Albanië hebben al decennia een moeizame verstandhouding. Een van de belangrijkste twistappels is nog altijd Kosovo. De voormalige Servische provincie, waar etnische Albanezen veruit in de meerderheid zijn, maakte zich in 2008 met geweld los van Belgrado."
                            },
                            {
                                "example_id": "b174ccec-e7fb-4a07-90a8-3fdf458631a7",
                                "sense_id": "4bf88091-33a8-30a8-a8a4-cc090dfa91b2",
                                "text": "De twistappel van de dag is de manier waarop Schiphol in het verleden is gegroeid. Volgens veel betrokkenen - met de KLM voorop - heeft Schiphol-topman Jos Nijhuis veel te veel budgetmaatschappijen naar de luchthaven gelokt. Voor de luchtvaartmaatschappijen die belangrijke intercontinentale vluchten uitvoeren, - met de KLM voorop - is nu juist te weinig plaats. Want Schiphol heeft het maximum van 500 duizend starts en landingen al bereikt."
                            }
                        ]
                    },
                    {
                        "sense_id": "b77f9797-7d69-3f82-9a47-7fe5fa12850b",
                        "entry_id": "8e93f83b-46a3-3704-9eab-103e099d1000",
                        "glosses": [
                            "de appel met het opschrift 'voor de mooiste' die door Paris aan Aphrodite wordt gegeven"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f034596e-57bc-46d4-972d-e58682cb02f9",
                        "source_entry_id": "8e93f83b-46a3-3704-9eab-103e099d1000",
                        "source_sense_id": "4bf88091-33a8-30a8-a8a4-cc090dfa91b2",
                        "target_lang_word": "apple of discord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apple of discord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                        "entry_id": "d7d2a12c-33e0-3784-bcb3-66521ef82a86",
                                        "glosses": [
                                            "An object or topic which sows anger and dissension; something which causes argument, rivalry, or strife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddbad97f-8d14-4d2c-b49a-cc1527ae4e88",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "He has determined to enter the cabinet surrounded with creatures only, and, as to the Parliament, to trust to his dexterity and strength in throwing the apple of discord, occasions for doing which will, he imagines, soon and frequently occur."
                                            },
                                            {
                                                "example_id": "537bc2fd-a5c5-4fef-a3cb-1eb0b9b46d30",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "He [Pope Pius VII] had hardly regained Rome when a domestic incident in the Bonaparte family became the immediate cause of that struggle between Pope and Emperor which only ended with the downfall of Napoleon's power. This apple of discord was the outraged honour of a Protestant girl, which the Holy Father maintained in the face of her angered Imperial brother-in-law."
                                            },
                                            {
                                                "example_id": "af88d489-c741-4128-8a07-56dc1fc8c3d6",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "The apportionment of U.S. military assistance to Turkey and Greece has become an apple of discord almost as bitterly disputed by the recipients as the one Aphrodite received from Paris, which touched off the Trojan Wars."
                                            },
                                            {
                                                "example_id": "b73c789c-60a8-4f64-b270-7bed0baf21d4",
                                                "sense_id": "367e1ded-39ee-36f7-a317-5cb164301b20",
                                                "text": "As in the old days when the tribes were fighting each other over hunting grounds, territories and agricultural land, today DRC [the Democratic Republic of the Congo] is prone to many internal conflicts. Especially in the eastern part of the country today's apples of discord appear to be the much-coveted minerals such as gold, diamonds, coltan, and uranium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b24049e-e546-4cfc-9b6f-e39b68391cfa",
                        "source_entry_id": "8e93f83b-46a3-3704-9eab-103e099d1000",
                        "source_sense_id": "4bf88091-33a8-30a8-a8a4-cc090dfa91b2",
                        "target_lang_word": "bone of contention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bone of contention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f666f0c-88ef-379e-9e71-70156616c096",
                                        "entry_id": "5e7dd3fb-4ff7-3999-9e54-7c8dba87a4bb",
                                        "glosses": [
                                            "Something that continues to be disputed; something on which no agreement can be reached."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ea1a2f-c83a-45f6-80d4-e5db0042c0fe",
                                                "sense_id": "7f666f0c-88ef-379e-9e71-70156616c096",
                                                "text": "It is still a bone of contention whether to go ahead with the original plan in light of the new evidence."
                                            },
                                            {
                                                "example_id": "741437a1-8f85-4b34-a62f-7522e5c96433",
                                                "sense_id": "7f666f0c-88ef-379e-9e71-70156616c096",
                                                "text": "England's \"Football Coming Home\" anthem became a serious bone of contention at the World Cup - with Croatia using it as a sign of arrogance from their opponents in the build up to the semi-final."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
