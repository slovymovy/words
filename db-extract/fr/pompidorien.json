                        "examples": [
                            {
                                "example_id": "9a1b8a19-9d44-4986-a48b-0ccd119d205c",
                                "sense_id": "967e913d-fbe0-3f41-9ab1-cd6d176ed5ef",
                                "text": "Pompidolien ou Pompidoliste serait légitime en langue d'oil. M. Pompidou étant un homme de langue d'oc, les occitanistes tiennent que la consonne doit être un R et proposent Pompidorien ou même Pompitorien."
                            },
                            {
                                "example_id": "0dbbbd12-8cab-4498-8fa9-b5a618727885",
                                "sense_id": "967e913d-fbe0-3f41-9ab1-cd6d176ed5ef",
                                "text": "À l'époque pompidorienne, l'impression dominante est celle d'une liaison entre les divers aspects de notre politique étrangère."
                            }
                        ]
                    }
