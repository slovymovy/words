                "senses": [
                    {
                        "sense_id": "f477ec70-b907-3048-8de5-51026a4dfa1d",
                        "entry_id": "51679192-99e8-336b-a1a9-f5f07a481f74",
                        "glosses": [
                            "meistens dem Heiligen Martin von Tours ^(→ WP) geweihtes Gotteshaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c230d5f-bbe0-4052-b73b-bf7017aa813e",
                                "sense_id": "f477ec70-b907-3048-8de5-51026a4dfa1d",
                                "text": "„Lange glaubte ich, daß die evangelische Martinskirche, die ihre Gründung, wie an vielen Orten des schwäbischen Landes, dem großen Frankenheiligen verdankt, ihren Namen zu Ehren Martin Luthers trage.“"
                            },
                            {
                                "example_id": "1604434b-2507-4beb-925e-713a6be13f8d",
                                "sense_id": "f477ec70-b907-3048-8de5-51026a4dfa1d",
                                "text": "„Der Streit zwischen den Pro-Palästina-Demonstranten und Gottesdienstbesuchern der evangelischen Martinskirche ist laut Landesbischof Ernst-Wilhelm Gohl nach einer Predigt des Pfarrers im Oktober 2023 entbrannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
