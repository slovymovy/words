                    {
                        "sense_id": "f7ce561c-5da1-3652-9673-74350c2cf1b8",
                        "entry_id": "6ef4bfbb-0eb3-30b3-9760-9a4031d5321c",
                        "glosses": [
                            "gesprek in besloten kring of onder vier ogen; vaak met een inhoud die niet voor anderen bestemd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2ec1e2-84b0-472e-aa97-89d216e761d2",
                                "sense_id": "f7ce561c-5da1-3652-9673-74350c2cf1b8",
                                "text": "Wij hadden gisteren een gezellig onderonsje."
                            }
                        ]
                    },
                    {
                        "sense_id": "b06ab235-2082-3b7b-8d63-e138777e2ddb",
                        "entry_id": "6ef4bfbb-0eb3-30b3-9760-9a4031d5321c",
                        "glosses": [
                            "bijeenkomst met weinig mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0bba2f4-78b5-4fd6-8035-d2d350e4a7a8",
                                "sense_id": "b06ab235-2082-3b7b-8d63-e138777e2ddb",
                                "text": "Er waren muzikanten, toneelspelers, kunstenmakers, goochelaars, sneltekenaars en grappenmakers. Je kon van alles eten en er was drinken in overvloed. Nog nooit had de hoofdstad zo'n feest gevierd. Zelfs de verjaardag van Koning Palet was hierbij vergeleken maar een onderonsje."
                            }
                        ]
                    }
                ],
