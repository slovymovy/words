                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62baeecf-2080-4a6f-945c-feed85cc3f30",
                                                "sense_id": "cf2744cc-131a-3de9-a2c5-311178822e74",
                                                "text": "Mijn besef kwam toen we hem naar de operatietafel brachten, waar de chirurg de tumor uit zijn maag zou snijden."
                                            },
                                            {
                                                "example_id": "0f13b253-6886-449b-82d0-2e026126b6df",
                                                "sense_id": "cf2744cc-131a-3de9-a2c5-311178822e74",
                                                "text": "De tumor in mijn hoofd bleek operabel en had nog geen vitale functies aangetast."
                                            },
                                            {
                                                "example_id": "a97be35b-154c-40ec-8939-57a64a890d30",
                                                "sense_id": "cf2744cc-131a-3de9-a2c5-311178822e74",
                                                "text": "De dokter moest haar het vreselijke nieuws over de tumor mededelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3906941-b86e-4605-bc08-0616739af402",
