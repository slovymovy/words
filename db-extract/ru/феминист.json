                                    {
                                        "sense_id": "c93f0138-3b4c-3f26-878e-000292c8c5f0",
                                        "entry_id": "d427520c-6d49-3187-aa78-b47818d5dadd",
                                        "glosses": [
                                            "Relating to or in accordance with feminism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d495edf-aa1a-45a0-b3ce-7feb6053f4cb",
                                                "sense_id": "c93f0138-3b4c-3f26-878e-000292c8c5f0",
                                                "text": "Feminist struggle takes place anytime anywhere any female or male resists sexism, sexist exploitation, and oppression."
                                            },
                                            {
                                                "example_id": "22cd97fc-5bc0-4e23-b199-6859290d0795",
                                                "sense_id": "c93f0138-3b4c-3f26-878e-000292c8c5f0",
                                                "text": "Whatever else, Irréversible is already a succès de scandale. [Gaspar] Noé's claims that it is a \"feminist\" movie sound far-fetched, but he certainly offers an extraordinarily pessimistic view of male sexuality."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feminist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a31b5bf4-ce7c-367b-a68d-0654aaefdc3d",
                                        "entry_id": "491ba3b0-2910-35d7-a215-8694cc604bba",
                                        "glosses": [
                                            "An advocate of feminism; a person who believes in bringing about the equality of the sexes (of women and men) in all aspects of public and private life."
