                                "example_id": "9d82f809-3c41-4a04-b1a4-4cf632eba6db",
                                "sense_id": "aed1fa46-7f8d-3852-aef9-4affab290ca7",
                                "text": "homely manners",
                                "translation": "简单的礼仪"
                            },
                            {
                                "example_id": "0a2930cc-1c98-4646-827d-17c75156ccbe",
                                "sense_id": "aed1fa46-7f8d-3852-aef9-4affab290ca7",
                                "text": "Now Strephon daily entertains\n His Chloe in the homeliest strains."
                            },
                            {
                                "example_id": "99c16157-7e55-45e9-8537-a01ec8bc409b",
                                "sense_id": "aed1fa46-7f8d-3852-aef9-4affab290ca7",
                                "text": "There is no simple way to define precisely a complex arrangement of parts, however homely the object may appear to be."
