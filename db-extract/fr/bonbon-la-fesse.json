                        "examples": [
                            {
                                "example_id": "967aea8a-2532-41fd-ab1e-cb61a54f06bf",
                                "sense_id": "0ba87860-79ec-3c9f-8e2f-17c4be6df20f",
                                "text": "C’est sur cette commode que se passe mon premier souvenir avec ma mère : j’ai la fièvre, elle me met un « bonbon-la-fesse » dans le popotin."
                            },
                            {
                                "example_id": "6cc4a958-b601-4cf1-8299-a26d98bb1359",
                                "sense_id": "0ba87860-79ec-3c9f-8e2f-17c4be6df20f",
                                "text": "Vous « coulez » une lettre à la poste, et pardonnez-moi celle-là, car je la trouve très mignonne : un suppositoire s’appelle là-bas un « bonbon-la-fesse »."
                            }
                        ]
                    }
