                                "sense_id": "bc5dc902-12df-325d-b887-1325788fb9da",
                                "text": "Herr Achleitner ist ein begnadeter Landschaftsmaler."
                            },
                            {
                                "example_id": "6ac4272a-e753-46bf-bf76-5a324597fff5",
                                "sense_id": "bc5dc902-12df-325d-b887-1325788fb9da",
                                "text": "Bei den Achleitners hängt der Haussegen schief."
                            },
                            {
                                "example_id": "0d95e5b7-f926-43bf-a6ed-2f0178ded72b",
                                "sense_id": "bc5dc902-12df-325d-b887-1325788fb9da",
                                "text": "Die Achleitner studiert BWL, der Achleitner Slawistik."
