                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in the small village of <w>Western</w>, Nebraska.",
                            "target_lang_translations": {
                                "ru": "Он вырос в маленькой деревне <w>Вестерн</w>, штат Небраска.",
                                "zh": "他在内布拉斯加州的一个叫<w>韦斯特恩</w>的小村庄长大。"
                            }
