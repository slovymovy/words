                        "form": "die Versuchsballons"
                    },
                    {
                        "form_id": "4761eaf5-9c72-4771-8a2b-a00d7dc090b1",
                        "entry_id": "4bca4a8d-e123-3457-a7c1-f37306014cbf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Versuchsballone"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f41e071-6efa-3de0-bfda-d9bd5e60316a",
                        "entry_id": "4bca4a8d-e123-3457-a7c1-f37306014cbf",
                        "glosses": [
                            "ein Ballon zur Untersuchung der Atmosphäre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e27d9f56-872a-46e3-b30b-610f84d9af6b",
                                "sense_id": "6f41e071-6efa-3de0-bfda-d9bd5e60316a",
                                "text": "Am Dorfrand wird ein Versuchsballon losgelassen, und alle Augen folgen ihm hoch in den Himmel hinauf."
                            },
                            {
                                "example_id": "04ceea16-ad8b-4c9c-872b-af996e2eaac0",
                                "sense_id": "6f41e071-6efa-3de0-bfda-d9bd5e60316a",
                                "text": "„Weitere fünfmal startete er den Versuchsballon, fünfmal scheiterte er. Doch dann, beim sechsten Mal, am 3. Juli 2002, war es endlich soweit: Steve Fossett umrundete als erster Ballon-Solist die Erde - in dreizehneinhalb Tagen, in knapp zwei Wochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                        "entry_id": "4bca4a8d-e123-3457-a7c1-f37306014cbf",
                        "glosses": [
                            "ein Vorstoß zur Gewinnung ersten Aufschlusses"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ebf4a307-2691-4a65-8ada-9fa078090841",
                                "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                                "text": "Die Marketingabteilung startet deshalb mit der kleinen Probeflasche einen Versuchsballon, um den Markt zu erkunden."
                            },
                            {
                                "example_id": "664422a5-9a7b-45d0-8802-592f3b800ec4",
                                "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                                "text": "„»Als eine Art Versuchsballon haben wir vor zwei Jahren als Kleinserie den A1 quattro aufgelegt. Die 333 Exemplare waren nach kurzer Zeit verkauft«, sagt Schwab.“"
                            },
                            {
                                "example_id": "51eafe0f-9089-4fb3-b76b-5ff4800c4c9f",
                                "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                                "text": "„Der Autoverkehr soll aus Kempten raus - aber wie? Die Stadt startet nun einen Versuchsballon und verleiht kostenlos Lastenräder an Betriebe - als Lieferwagen-Ersatz.“"
                            },
                            {
                                "example_id": "7123f792-a7a1-4015-9b06-c0a841a0dbf5",
                                "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                                "text": "„Als Versuchsballon gestartet, erkämpft sich die Show [Anmerkung: \"Quizduell\"] nach anfänglichen technischen Schwierigkeiten schließlich einen festen Platz im Programm.“"
                            },
                            {
                                "example_id": "bde28877-a996-43f6-81f4-355ff2a07772",
                                "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                                "text": "„Auch wenn das allererste Jazzfest 1990 natürlich als Versuchsballon stieg, wurde es sofort wahrgenommen.“"
                            },
                            {
                                "example_id": "b962c180-c1ca-4fa1-bac7-52fcebbb9db6",
                                "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                                "text": "„[…] CETA [ist] eine Art Versuchsballon dafür, ob die EU überhaupt noch Handelsabkommen mit irgendjemandem auf der Welt abschließen kann.“"
                            },
                            {
                                "example_id": "9789346d-6cd8-46ee-9ad6-497d7b8e0da1",
                                "sense_id": "ca2d29e1-604b-3e0b-b5fc-ac80d483584a",
                                "text": "„Ob Trump als Präsident wirklich die Axt an die Grundlagen von Amerikas Chinapolitik legen würde, ob er mit seinen Interview-Äußerungen lediglich einen Versuchsballon startete oder das Spielfeld für künftige Verhandlungen abgesteckt hat, sorgt in Taiwan genauso für Kopfzerbrechen wie im Rest der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
