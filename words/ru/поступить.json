{
    "word_family": [
        "поступать",
        "поступок",
        "поступление",
        "доступ",
        "выступ",
        "приступ"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf0bf9d7-f125-3548-8376-03cab677be54",
                    "sense_definition": "Совершить какое-либо действие, повести себя определённым образом.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Почему ты так <w>поступил</w> в этой ситуации?",
                            "target_lang_translations": {
                                "en": "Why did you <w>act</w> that way in this situation?",
                                "tr": "Bu durumda neden böyle <w>davrandın</w>?"
                            }
                        },
                        {
                            "text": "Мы решили <w>поступить</w> по совести и вернуть найденные деньги.",
                            "target_lang_translations": {
                                "en": "We decided to <w>act</w> according to conscience and return the found money.",
                                "tr": "Vicdanımıza göre <w>hareket etmeye</w> ve bulunan parayı geri vermeye karar verdik."
                            }
                        }
                    ],
                    "synonyms": [
                        "делать",
                        "сделать",
                        "действовать"
                    ],
                    "common_phrases": [
                        "поступить правильно",
                        "поступить плохо",
                        "поступить по закону",
                        "поступить иначе",
                        "как поступить"
                    ],
                    "target_lang_definitions": {
                        "en": "To commit an action or behave in a certain way.",
                        "tr": "Bir eylemde bulunmak veya belirli bir şekilde davranmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "act",
                                "target_lang_sense_clarification": "to behave or take action"
                            },
                            {
                                "target_lang_word": "do",
                                "target_lang_sense_clarification": "to perform an action"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "davranmak",
                                "target_lang_sense_clarification": "birine veya bir duruma karşı tutum sergilemek"
                            },
                            {
                                "target_lang_word": "hareket etmek",
                                "target_lang_sense_clarification": "bir eylemde bulunmak veya bir yol izlemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9267b9d-81ab-3b0f-b492-4b159880947b",
                    "sense_definition": "Быть принятым, зачисленным в учебное заведение или на работу.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "enrollment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат хочет <w>поступить</w> в медицинский университет.",
                            "target_lang_translations": {
                                "en": "My brother wants to <w>enter</w> medical university.",
                                "tr": "Kardeşim tıp fakültesine <w>girmek</w> istiyor."
                            }
                        },
                        {
                            "text": "После школы она сразу <w>поступила</w> на работу в магазин.",
                            "target_lang_translations": {
                                "en": "After school, she immediately <w>got</w> a job at a shop.",
                                "tr": "Okuldan sonra hemen bir mağazada işe <w>başladı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "устроиться",
                        "зачислиться",
                        "пройти",
                        "записаться"
                    ],
                    "antonyms": [
                        "отчислиться",
                        "уволиться",
                        "выбыть",
                        "уйти"
                    ],
                    "common_phrases": [
                        "поступить в университет",
                        "поступить в институт",
                        "поступить на работу",
                        "поступить на службу"
                    ],
                    "target_lang_definitions": {
                        "en": "To be accepted or enrolled in an educational institution or for a job.",
                        "tr": "Bir eğitim kurumuna veya bir işe kabul edilmek, kayıt yaptırmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enter",
                                "target_lang_sense_clarification": "an institution or profession"
                            },
                            {
                                "target_lang_word": "enroll",
                                "target_lang_sense_clarification": "in a school or university"
                            },
                            {
                                "target_lang_word": "join",
                                "target_lang_sense_clarification": "an organization or workforce"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "girmek",
                                "target_lang_sense_clarification": "bir okul veya kuruma kabul edilmek"
                            },
                            {
                                "target_lang_word": "başlamak",
                                "target_lang_sense_clarification": "bir işe veya göreve giriş yapmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d3229c0-1cb5-3355-b650-1be49287be14",
                    "sense_definition": "Прибыть, быть доставленным или полученным (о деньгах, товарах, информации).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arrival",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На наш счёт вчера <w>поступили</w> деньги от заказчика.",
                            "target_lang_translations": {
                                "en": "Money from the client <w>arrived</w> in our account yesterday.",
                                "tr": "Müşteriden gelen para dün hesabımıza <w>geldi</w>."
                            }
                        },
                        {
                            "text": "В магазин <w>поступила</w> новая коллекция зимней одежды.",
                            "target_lang_translations": {
                                "en": "A new collection of winter clothes has <w>arrived</w> at the store.",
                                "tr": "Mağazaya yeni kışlık kıyafet koleksiyonu <w>geldi</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поступить в продажу",
                        "поступить на счёт",
                        "поступить в распоряжение",
                        "поступило предложение",
                        "поступило сообщение"
                    ],
                    "target_lang_definitions": {
                        "en": "To arrive, be delivered, or received (regarding money, goods, or information).",
                        "tr": "Ulaşmak, teslim edilmek veya alınmak (para, mal veya bilgi hakkında)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arrive",
                                "target_lang_sense_clarification": "to reach a destination"
                            },
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "to be received or become available"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gelmek",
                                "target_lang_sense_clarification": "bir yere ulaşmak veya teslim edilmek"
                            },
                            {
                                "target_lang_word": "ulaşmak",
                                "target_lang_sense_clarification": "bir yere varmak veya iletilmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cdbba42-9fd9-3cbe-89a0-6a105ffa1f4a",
                    "sense_definition": "Обойтись с кем-либо или чем-либо определённым образом, совершить действие по отношению к кому-то.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не знаю, как <w>поступить</w> с этими старыми вещами.",
                            "target_lang_translations": {
                                "en": "I don't know how to <w>deal</w> with these old things.",
                                "tr": "Bu eski eşyalarla ne <w>yapacağımı</w> bilmiyorum."
                            }
                        },
                        {
                            "text": "Он <w>поступил</w> с нами очень несправедливо.",
                            "target_lang_translations": {
                                "en": "He <w>treated</w> us very unfairly.",
                                "tr": "Bize karşı çok adaletsiz <w>davrandı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поступить жестоко с",
                        "поступить справедливо с",
                        "поступить честно с"
                    ],
                    "target_lang_definitions": {
                        "en": "To treat someone or something in a specific way; to take action towards someone.",
                        "tr": "Birine veya bir şeye karşı belirli bir şekilde davranmak; bir şey hakkında işlem yapmak."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "treat",
                                "target_lang_sense_clarification": "to behave towards someone"
                            },
                            {
                                "target_lang_word": "deal with",
                                "target_lang_sense_clarification": "to handle or manage something"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "davranmak",
                                "target_lang_sense_clarification": "birine karşı tutum sergilemek"
                            },
                            {
                                "target_lang_word": "yapmak",
                                "target_lang_sense_clarification": "bir şeyle ilgili işlem veya eylemde bulunmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}