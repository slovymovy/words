                "senses": [
                    {
                        "sense_id": "02091bfb-ab51-3d2f-bdc5-87d022231e30",
                        "entry_id": "d5ffd502-7f86-3dbc-8c3f-c8493d7b422b",
                        "glosses": [
                            "wirtschaftliches Unternehmen im Besitz einer Familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d086695-a7fb-4e90-85e4-78dee07f2bfa",
                                "sense_id": "02091bfb-ab51-3d2f-bdc5-87d022231e30",
                                "text": "„Er hat nach seiner Ausbildung im Familienbetrieb Agraringenieurwesen studiert, er redet über seine Erfahrungen in England und über eine Reise nach Schweden…“"
                            },
                            {
                                "example_id": "db415321-e9da-49f8-a136-f67c829af2a7",
                                "sense_id": "02091bfb-ab51-3d2f-bdc5-87d022231e30",
                                "text": "„Genau wie Sungs Laden waren auch diese Läden Familienbetriebe und Warenarchive, Orte für Schwätzchen, Paketannahmestelle, letzte Hoffnung am Abend auf Backpulver, Ventile, Glühbirnen und Grußkarten.“"
                            },
                            {
                                "example_id": "ffca974e-f76c-43ea-b9ff-d69cc2811344",
                                "sense_id": "02091bfb-ab51-3d2f-bdc5-87d022231e30",
                                "text": "„Es war ein Familienbetrieb, gediegen, Stammkundschaft.“"
                            },
                            {
                                "example_id": "af3fd25d-f186-40b9-aabe-32b887640218",
                                "sense_id": "02091bfb-ab51-3d2f-bdc5-87d022231e30",
                                "text": "„Sie arbeiten im Familienbetrieb, der Molkerei, aber die Eltern wollen sie glüklich verheiratet sehen, und Tewje erählt, wie es ihnen dabei ergeht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
