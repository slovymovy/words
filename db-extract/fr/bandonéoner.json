                                "example_id": "8a8ad4fd-b178-4235-a939-688f9784f931",
                                "sense_id": "8980c4c8-8e5f-3d57-9f5b-0b0260aea927",
                                "text": "Pilleur de ciboires, traqueur d'identités, empêcheur de bandonéoner en rond, empoisonneur d'illusions, dénicheur de remakes, improvisateur atonal, avorteur splénétique, provocateur ataraxique, chercheur du nulle-part-encore-dit,"
                            },
                            {
                                "example_id": "593ce204-28dd-4893-afed-e4a4e1b60ce1",
                                "sense_id": "8980c4c8-8e5f-3d57-9f5b-0b0260aea927",
                                "text": "Et le bandonéon bandonéone en de subtils balancements de l'homme perché, que la bise aide dans son mouvement."
                            }
                        ]
                    }
