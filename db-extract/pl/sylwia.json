                                    {
                                        "sense_id": "b4669449-dd90-32d6-a938-e3c7b2a38da4",
                                        "entry_id": "d57dc007-6bbf-3232-9fa9-518f5309241b",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98dd5cd-1a6c-49ac-91d6-98a7f8128ad9",
                                                "sense_id": "b4669449-dd90-32d6-a938-e3c7b2a38da4",
                                                "text": "Quand je t’ai vu la première fois Sylvie\n C’est à Québec sous les remparts tout gris\n On s’est promis comme des enfants la vie\n Depuis je t’aime éperduement Sylvie"
                                            },
                                            {
                                                "example_id": "2ce4b1ac-bbd0-4976-957e-b4d9b68ce7ab",
                                                "sense_id": "b4669449-dd90-32d6-a938-e3c7b2a38da4",
                                                "text": "Deux byrrhs, Sylvie et une menthe à l’eau !"
                                            },
                                            {
                                                "example_id": "9941c45d-864e-4610-8a30-ece3a7e15178",
                                                "sense_id": "b4669449-dd90-32d6-a938-e3c7b2a38da4",
                                                "text": "Les rôles ne sont pas définis à l’avance, à chacun de les inventer, note la sociologue Sylvie Cadolle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
