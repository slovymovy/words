                ],
                "translations": [
                    {
                        "translation_id": "674610e6-609c-4641-94e6-ac6953e2fc50",
                        "source_entry_id": "a87cc216-91b2-3d93-8847-b8119e20d324",
                        "source_sense_id": "8acbb617-220b-3bf9-99fa-31b8065ed87a",
                        "source_sense_description": "het gekleurde vlies in het oog waarin de pupil zich bevindt",
                        "target_lang_word": "Regenbogenhaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenbogenhaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b186cec9-027f-3e06-b9a4-f1be79626df4",
                                        "entry_id": "e561f007-0229-3084-80dd-279a08f97a70",
                                        "glosses": [
                                            "Blende des Auges, die durch die Hornhaut (Cornea) hindurchscheint und die ringförmig die Pupille umgibt und durch Muskeln verkleinert oder vergrößert werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f294e1e5-09ef-4d91-a7c4-0c2fb33f26da",
                                                "sense_id": "b186cec9-027f-3e06-b9a4-f1be79626df4",
                                                "text": "Die Farbe der Regenbogenhaut hängt von den Melanozyten ab."
                                            },
                                            {
                                                "example_id": "076200b9-8f02-4daa-8e65-cf8e43f54cda",
                                                "sense_id": "b186cec9-027f-3e06-b9a4-f1be79626df4",
                                                "text": "Da diese bei Säuglingen noch nicht vollständig ausgebildet sind, haben sie meist eine graublaue Regenbogenhaut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e16a3646-692b-4b6f-99e9-9cea974e0354",
                        "source_entry_id": "a87cc216-91b2-3d93-8847-b8119e20d324",
                        "source_sense_id": "8acbb617-220b-3bf9-99fa-31b8065ed87a",
                        "source_sense_description": "het gekleurde vlies in het oog waarin de pupil zich bevindt",
                        "target_lang_word": "Iris",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iris",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca92c862-098a-3350-b3db-cb75cd523968",
                                        "entry_id": "82c2e5df-7ad2-3263-9b82-ebf6a2c2f5d7",
                                        "glosses": [
                                            "(Plural: Iris oder [selten] Iriden, Irides): Regenbogenhaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82dc878a-dd9e-4d4d-8528-21b2cc9f82dd",
                                                "sense_id": "ca92c862-098a-3350-b3db-cb75cd523968",
                                                "text": "Die Färbung der Iris ist ein wichtiges individuelles Erkennungsmerkmalen eines Menschen und ist sogar im Personalausweis vermerkt."
                                            },
                                            {
                                                "example_id": "94408ee7-b985-4d78-b670-db80d874e080",
                                                "sense_id": "ca92c862-098a-3350-b3db-cb75cd523968",
                                                "text": "„Außerdem war die Iris braun.“"
                                            },
                                            {
                                                "example_id": "3d982c8b-756c-4b3d-a67e-ab1f30110877",
                                                "sense_id": "ca92c862-098a-3350-b3db-cb75cd523968",
                                                "text": "„Auf der Iris schwammen blaue Kontaktlinsen.“"
                                            },
                                            {
                                                "example_id": "3e8c69ba-f6e6-44a2-95d0-10780fe77399",
                                                "sense_id": "ca92c862-098a-3350-b3db-cb75cd523968",
                                                "text": "„Unter der dunklen Iris sieht man das Weiße.“"
                                            },
                                            {
                                                "example_id": "ab85a05e-6c60-450e-9616-0b423b9b3d86",
                                                "sense_id": "ca92c862-098a-3350-b3db-cb75cd523968",
                                                "text": "„Die Augen hatte er so verdreht, dass die Iris unter den Lidern verschwand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04b8eb7e-a202-3723-abaf-c36648ba3a54",
                                        "entry_id": "82c2e5df-7ad2-3263-9b82-ebf6a2c2f5d7",
                                        "glosses": [
                                            "(Plural: Iris): Schwertlilie (Trivialname der Arten aus der Gattung der Schwertlilien (Iris)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2d00790-fb1e-4e98-b19b-aee59dca6efd",
                                                "sense_id": "04b8eb7e-a202-3723-abaf-c36648ba3a54",
                                                "text": "Die Blüten der Iris gehören zu den imposantesten Formen der Natur."
                                            },
                                            {
                                                "example_id": "016bcecf-ddb5-41d3-8a5e-761d6b6d1fe4",
                                                "sense_id": "04b8eb7e-a202-3723-abaf-c36648ba3a54",
                                                "text": "Iris sind eine in den gemäßigten Zonen der Nordhalbkugel heimische Gattung der Schwertliliengewächse mit ca. 300 Arten, die nach ihren Überdauerungsorganen in Zwiebel- und Rhizom-Iris unterteilt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "647fe7d7-ed42-374e-b3d7-827fc8534a10",
                                        "entry_id": "82c2e5df-7ad2-3263-9b82-ebf6a2c2f5d7",
                                        "glosses": [
                                            "geflügelte Götterbotin (als Verkörperung des Regenbogens)"
                                        ],
                                        "tags": [
                                            "griechische Mythologie (kein Plural)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1da5c8-2496-4889-ae9f-3830a99dde68",
                                                "sense_id": "647fe7d7-ed42-374e-b3d7-827fc8534a10",
                                                "text": "In der Vorstellung der alten Griechen konnte Iris auch Winde erzeugen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Iris",
