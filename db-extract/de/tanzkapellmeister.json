                "senses": [
                    {
                        "sense_id": "6d2f555d-6924-3a51-9cc4-11fdebd5ecd1",
                        "entry_id": "33c639e4-7e1f-385d-be7e-539621c6e5c1",
                        "glosses": [
                            "musikalischer Leiter einer sogenannten Tanzkapelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfed43be-9af4-43bc-aebb-f127c1518c0a",
                                "sense_id": "6d2f555d-6924-3a51-9cc4-11fdebd5ecd1",
                                "text": "„Ernst Josef Aufricht hatte Mackeben, bis dahin ein erfolgreicher Tanzkapellmeister, 1929 engagiert, die Uraufführung der «Dreigroschenoper» von Brecht und Weill musikalisch einzustudieren und, sicher ist sicher, ein Arrangement der Uralt-Musik von Pepusch bereitzuhalten, falls die Musik von Weill nicht zünden sollte.“"
                            },
                            {
                                "example_id": "44c2fc51-2179-4c53-a7d1-eaca6444752e",
                                "sense_id": "6d2f555d-6924-3a51-9cc4-11fdebd5ecd1",
                                "text": "„Eugène, Eugy, wie die englische Mutter den Namen ausspricht, oder Eugen, wie er selbst sich später nennt: Der 1864 in Glasgow als Sohn eines französischen Tanzkapellmeisters geborene Junge macht schnell Fortschritte und beeindruckt bald die internationalen Größen der musikalischen Szene.“"
                            },
                            {
                                "example_id": "2c921a13-a600-479a-ab5b-da1b88d6b74d",
                                "sense_id": "6d2f555d-6924-3a51-9cc4-11fdebd5ecd1",
                                "text": "„Joseph Lanner, 1801 in Wien; geboren und 1843 ebenda gestorben, zählte neben Johann Strauß (Vater) zu den herausragenden Tanzkapellmeistern Wiens seiner Zeit.“"
                            },
                            {
                                "example_id": "9fcb17f9-5f69-412c-85d5-cdbe12233b8f",
                                "sense_id": "6d2f555d-6924-3a51-9cc4-11fdebd5ecd1",
                                "text": "„Der in Bremen gebürtige Hans \"James\" Last, 44, einst mehrfach als Deutschlands bester Jazz-Kontrabassist prämiert, ist heute der erfolgreichste Tanzkapellmeister der Welt.“"
                            },
                            {
                                "example_id": "e4865c86-1958-4f15-98dc-6c24836f9905",
                                "sense_id": "6d2f555d-6924-3a51-9cc4-11fdebd5ecd1",
                                "text": "„Warum muß Horst Jankowski, der doch ein guter Jazz- und Pop-Pianist und ein gewiß hervorragender Tanzkapellmeister (beim RIAS Berlin) ist, unbedingt mit klassischer Musik explodieren?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
