                "word": "parquet",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bb235798-a0fd-44f4-b1ad-400feb3eb56b",
                        "entry_id": "5a2c9351-7c4d-368f-9dc2-3e7cfb16626f",
                        "tags": [
                            "plural"
                        ],
                        "form": "parquets"
