                            {
                                "target_word": "death certificate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2384b445-89c9-3d58-88e2-dbd509453b64",
                                        "entry_id": "cf4e0134-e77c-30ab-8f98-47d3c1719666",
                                        "glosses": [
                                            "A document issued by a medical practitioner, or by a registrar, certifying the date, location and cause of a person's death as later entered in an official register of deaths."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc26fb80-9f27-4f7f-89a8-cfc1f3d6d50b",
                                                "sense_id": "2384b445-89c9-3d58-88e2-dbd509453b64",
                                                "text": "Meanwhile, the death certificate was as good as signed by the North Eastern Region on December 1 last, when all mineral workings were withdrawn from the H. & B. route and seven additional services were substituted on the N.E.R. route out of Hull; [...]."
                                            }
                                        ]
