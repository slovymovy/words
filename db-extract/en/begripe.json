                        "glosses": [
                            "To lay hold of; apprehend; grip; grasp."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c1c87735-1e2f-4cd8-9fce-cac25136db6d",
                                "sense_id": "9958a82d-669e-33ee-a3a0-1ec53ee870c1",
                                "text": "He, with his middle feet, begriped his paunch, And took the arms with the anterior; And then he bit both one and other cheek."
                            },
                            {
                                "example_id": "5acc4731-8590-4863-8a4c-0ddad9b8bf52",
                                "sense_id": "9958a82d-669e-33ee-a3a0-1ec53ee870c1",
                                "text": "And as for this sword there shall never man begripe it at the handle but one, but he shall pass all other. In the name of God, said Percivale, I shall essay to handle it. So he set his hand to the sword, but he might not begripe it."
                            }
                        ]
