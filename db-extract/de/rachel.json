                                "target_senses": [
                                    {
                                        "sense_id": "4b67b166-0c84-34c4-85ec-d6bcef36a695",
                                        "entry_id": "5b1454c4-ac6c-3104-a45f-82c2723ce814",
                                        "glosses": [
                                            "Dans la Bible, cousine et seconde femme de Jacob."
                                        ],
                                        "tags": [
