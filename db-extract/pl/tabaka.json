                        "cross_references": [
                            {
                                "target_word": "snuff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ac779f-1c3f-3fa8-905c-77791ea6dbc0",
                                        "entry_id": "02a7e40f-9e4c-3f45-9633-32cb17a9b907",
                                        "glosses": [
                                            "Finely ground or pulverized tobacco (or other plant derivative) intended for use by being sniffed or snorted into the nose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1091935-eb11-4820-9a95-cd4d0514a739",
                                                "sense_id": "f2ac779f-1c3f-3fa8-905c-77791ea6dbc0",
                                                "text": "The native of some South American tribes use this drug as an aphrodisiac in the form of a snuff called cohoba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b917ff-0830-30a7-9cb5-3d758e38e3bb",
                                        "entry_id": "02a7e40f-9e4c-3f45-9633-32cb17a9b907",
                                        "glosses": [
                                            "Fine-ground or minced tobacco, dry or moistened, intended for use by placing a pinch behind the lip or beneath the tongue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dac8faf-94f8-4501-ba2c-72967f94e5f1",
                                                "sense_id": "e9b917ff-0830-30a7-9cb5-3d758e38e3bb",
                                                "text": "Dry snuffs are often adulterated with quicklime, and moist snuffs, as rappee, with ammonia, hellebore, pearl-ash, etc."
                                            },
                                            {
                                                "example_id": "e46a6528-2309-40fe-9698-101f4560c525",
                                                "sense_id": "e9b917ff-0830-30a7-9cb5-3d758e38e3bb",
                                                "text": "[…] most of the women dipped snuff and of course had a spit-cup in the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc7b98a4-98ce-3127-839e-d7a6f95a50af",
                                        "entry_id": "02a7e40f-9e4c-3f45-9633-32cb17a9b907",
                                        "glosses": [
                                            "A snort or sniff of fine-ground, powdered, or pulverized tobacco."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1f0c5d6-9396-3a64-9993-34a0abffd39a",
                                        "entry_id": "02a7e40f-9e4c-3f45-9633-32cb17a9b907",
                                        "glosses": [
                                            "The act of briskly inhaling by the nose; a sniff, a snort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21e35909-a8ce-379b-9541-ba1c19c62292",
                                        "entry_id": "02a7e40f-9e4c-3f45-9633-32cb17a9b907",
                                        "glosses": [
                                            "Resentment or skepticism expressed by quickly drawing air through the nose; snuffling; sniffling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "beb87a01-a112-3fd8-96c7-e47bad86d1e0",
                                        "entry_id": "02a7e40f-9e4c-3f45-9633-32cb17a9b907",
                                        "glosses": [
                                            "Snot, mucus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
