                        "entry_id": "830373fc-d38b-37e1-8e76-c883027c850d",
                        "glosses": [
                            "Partie charnue, saillante, mobile et contractile, au milieu du voile du palais, à l’entrée du gosier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65b3b61f-b560-4500-994b-9dc82ae03a2d",
                                "sense_id": "8353e2a4-ba39-3ac3-b9a9-69ddf6d8d906",
                                "text": "Il a la luette enflée."
                            },
                            {
                                "example_id": "4ebeb167-573b-42e2-bf09-185535023043",
                                "sense_id": "8353e2a4-ba39-3ac3-b9a9-69ddf6d8d906",
                                "text": "La sensation de corps étranger, déterminée par la luette pendante, aurait attiré l’attention des malades, puis des médecins, sur cet organe insignifiant, simple appendice du voile."
                            }
                        ]
                    }
