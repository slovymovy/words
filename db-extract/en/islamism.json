                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9cef593-53f8-44a3-afb1-1cc5cd2610cf",
                        "source_entry_id": "7a6822aa-c65b-3de3-9c8b-a78b19e4cf5a",
                        "source_sense_description": "Islamic fundamentalism",
                        "target_lang_word": "ислами́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ислами́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "85d6344b-549c-331d-b4f3-ce29f2d951ee",
                                        "entry_id": "004f27dd-28af-3702-a141-2675f09ff6d5",
                                        "glosses": [
                                            "устар. то же, что ислам; монотеистическая религия, признающая Мухаммада пророком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65a80571-05bb-4645-b0c1-4b4db805cef2",
                                                "sense_id": "85d6344b-549c-331d-b4f3-ce29f2d951ee",
                                                "text": "По несчастию, забыли прибавить, что усердие к церкви было тем более бескорыстно у него, чем твёрже он верил в исламизм."
                                            },
                                            {
                                                "example_id": "986014ae-e7fe-42cc-9f8e-c27f012a84d2",
                                                "sense_id": "85d6344b-549c-331d-b4f3-ce29f2d951ee",
                                                "text": "Кроме того, исламизм представляется автором как особая, независимая от христианства религия, тогда как магометанство есть не что иное, как протестантство против Византийского извращенного, перешедшего в многобожие христианства, и протестантство, имеющее в основе своей те же предания, как и христианство, почерпнутые только в апокрифических библейских и евангельских сказаниях."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290c438e-8ebf-3ae3-b9ad-c8f789a71060",
                                        "entry_id": "004f27dd-28af-3702-a141-2675f09ff6d5",
                                        "glosses": [
                                            "религиозно-политическая идеология имеющая своей конечной целью упразднение светского государства и установление «исламского порядка»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0121f6-e3b7-4960-afbc-1eb8a351b69b",
                                                "sense_id": "290c438e-8ebf-3ae3-b9ad-c8f789a71060",
                                                "text": "В традициях советского востоковедения ученый разграничивает понятия «исламский фундаментализм» и «исламизм», который он трактует как политическое выражение фундаментализма."
                                            },
                                            {
                                                "example_id": "d527b9c2-f1a5-4851-bb0f-0aee5aa95210",
                                                "sense_id": "290c438e-8ebf-3ae3-b9ad-c8f789a71060",
                                                "text": "Существует также связь ислама и исламизма: всякий исламист — мусульманин, но не всякий мусульманин — исламист. Как политическая идеология исламизм противостоит иным идеологиям и политическим системам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
