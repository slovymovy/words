                "forms": [
                    {
                        "form_id": "922910d7-7df2-4da6-ba1c-dab6610c8e2c",
                        "entry_id": "a82bbff7-49b3-34f6-b0d7-127672023303",
                        "tags": [
                            "plural"
                        ],
                        "form": "fossae"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2ed243e-1e4e-3ac8-bdd1-af0923f6801d",
                        "entry_id": "a82bbff7-49b3-34f6-b0d7-127672023303",
                        "glosses": [
                            "A pit, groove, cavity, or depression."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "35aa3bc6-bb1c-36d3-ac84-7a06f3490403",
                        "entry_id": "a82bbff7-49b3-34f6-b0d7-127672023303",
                        "glosses": [
                            "A long, narrow, shallow depression on the body of an extraterrestrial body, such as a planet or moon."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dbbcf56-aa57-44d4-88a3-818e45d32fd5",
                        "source_entry_id": "a82bbff7-49b3-34f6-b0d7-127672023303",
                        "source_sense_description": "pit, groove, cavity",
                        "target_lang_word": "Vertiefung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertiefung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fab65338-9d08-3bfa-b8fe-0ee50b47df97",
                                        "entry_id": "62030514-80be-3653-96df-cd805b71b4cc",
                                        "glosses": [
                                            "das gedankliche Vertiefen durch intensive Beschäftigung mit etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28c267e-bb55-4ba2-a6d2-6bae36de4225",
                                                "sense_id": "fab65338-9d08-3bfa-b8fe-0ee50b47df97",
                                                "text": "„Diese Vertiefung soll noch durch die theologische Reflexion und aufgrund des »Beitrags, den die verschiedenen Humanwissenschaften und Kulturen einbringen können«, weitergeführt werden.“"
                                            },
                                            {
                                                "example_id": "5a5384d4-8803-4439-8d5b-5a6e7429b7d2",
                                                "sense_id": "fab65338-9d08-3bfa-b8fe-0ee50b47df97",
                                                "text": "„Weder die Vertiefung in die Musik noch in das Gebet konnten ihn davon abhalten, diesen Schrei auszustoßen, sobald jemand in das warme Wohnzimmer huschte oder es huschend verließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "edf7d553-40c8-3af7-8646-96bce9b1f940",
                                        "entry_id": "62030514-80be-3653-96df-cd805b71b4cc",
                                        "glosses": [
                                            "eine Delle auf einer Oberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6728954-5b14-4c9e-8f90-e531e5841050",
                                                "sense_id": "edf7d553-40c8-3af7-8646-96bce9b1f940",
                                                "text": "„In dieser Gehirnhälfte wurden Fremdkörper und Unregelmäßigkeiten offensichtlich nicht geschätzt. In den Wänden waren überall Vertiefungen, manche quadratisch, manche halbkugelförmig, in verschiedenen Größen. Die umherschwirrenden Kugeln und Würfel suchten sich ihre passende Vertiefung, parkten darin und brummten dabei in sie hinein.“"
                                            },
                                            {
                                                "example_id": "3c18c375-0b12-493d-b481-77f2cc72a664",
                                                "sense_id": "edf7d553-40c8-3af7-8646-96bce9b1f940",
                                                "text": "„Im Laufe der Jahrhunderte haben die Inselbewohner die Steine aufgesammelt, halbkreisförmige Mäuerchen gebaut und auf deren Innenseite kleine Vertiefungen angelegt.“"
                                            },
                                            {
                                                "example_id": "bd786203-a6c1-4fb3-9740-28f590263c71",
                                                "sense_id": "edf7d553-40c8-3af7-8646-96bce9b1f940",
                                                "text": "„Doch unter dem Tor hatten sich Vertiefungen gebildet, wohl vom jahrelangen Ein- und Ausfahren der Erntewagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b4c63eb-aad2-4db1-b47c-02384e583dfd",
                        "source_entry_id": "a82bbff7-49b3-34f6-b0d7-127672023303",
