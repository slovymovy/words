    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc6a8373-0bc2-3a7d-b133-7d86665bb2d1",
                    "sense_definition": "Qui manifeste un attachement ardent, passionné et sincère envers une personne, une cause ou une croyance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ferveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chercheur est un <w>fervent</w> défenseur de la protection de l'environnement."
                        },
                        {
                            "text": "Elle est restée une <w>fervente</w> admiratrice de ce pianiste tout au long de sa vie."
                        }
                    ],
                    "synonyms": [
                        "ardent",
                        "dévoué",
                        "passionné",
                        "zélé"
                    ],
                    "antonyms": [
                        "indifférent",
                        "tiède"
                    ],
                    "common_phrases": [
                        "fervent admirateur",
                        "fervent défenseur",
                        "fervent partisan"
                    ]
                },
                {
                    "sense_id": "d8a507be-bdd8-3de0-8372-0fe33ec5af59",
                    "sense_definition": "Qui est empreint d'une ardeur vive, intense et sincère, notamment dans l'expression des sentiments ou de la foi.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ferveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles adressèrent une <w>fervente</w> prière pour le rétablissement de leur voisin."
                        },
                        {
                            "text": "Le jeune homme garde le <w>fervent</w> espoir de réaliser ses projets à l'étranger."
                        }
                    ],
                    "synonyms": [
                        "ardent",
                        "intense",
                        "passionné"
                    ],
                    "antonyms": [
                        "froid",
                        "tiède"
                    ],
                    "common_phrases": [
                        "fervent espoir",
                        "fervente prière"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8380a82-be0f-3fbf-98f9-50a0828cf0c0",
                    "sense_definition": "Personne animée d'une grande passion ou d'une admiration sincère pour quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ferveur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée attire de nombreux <w>fervents</w> d'art moderne venus du monde entier."
                        },
                        {
                            "text": "En tant que <w>fervente</w> d'opéra classique, elle ne manque aucune nouvelle représentation."
                        }
                    ],
                    "synonyms": [
                        "adepte",
                        "amateur",
                        "passionné"
                    ],
                    "antonyms": [
                        "détracteur"
                    ],
                    "common_phrases": [
                        "fervents de la première heure",
                        "fervent d'art moderne"
                    ]
                }
            ]
        }
