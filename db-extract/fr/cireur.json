                        "translation_id": "107b6588-eee4-4095-958b-12e7ae8f626c",
                        "source_entry_id": "3ab24564-5595-3724-9c50-51a9e559bad4",
                        "source_sense_id": "8e894166-5deb-342d-9dec-28b4b7e9286b",
