            {
                "entry_id": "69c1be86-1664-3123-9fb2-0db9564f4ba0",
                "word": "storytelling",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "01528440-c387-37b6-9898-5bee062d1aec",
                        "entry_id": "69c1be86-1664-3123-9fb2-0db9564f4ba0",
                        "glosses": [
                            "Mise en récit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e499989-6b62-4652-9283-2436e7584be8",
                                "sense_id": "01528440-c387-37b6-9898-5bee062d1aec",
                                "text": "Le storytelling est la technique de communication la plus efficace du moment… et pas seulement : nous avons de tout temps communiqué en racontant des histoires, en les échangeant."
                            },
                            {
                                "example_id": "f147da49-6acc-4aa1-b12f-c85f101d2f35",
                                "sense_id": "01528440-c387-37b6-9898-5bee062d1aec",
                                "text": "Il y avait donc déjà le storytelling, communication narrative permettant aux marques d’utiliser des histoires pour repenser leur stratégie et poursuivre leur développement."
                            },
                            {
                                "example_id": "1567222c-b00f-45f0-b829-0381489b2968",
                                "sense_id": "01528440-c387-37b6-9898-5bee062d1aec",
                                "text": "C’est vrai que, sur le papier, le storytelling a de l’allure."
                            },
                            {
                                "example_id": "97ae7efe-d3b0-4acd-9cee-25afca13d6c0",
                                "sense_id": "01528440-c387-37b6-9898-5bee062d1aec",
                                "text": "Mais tout cela ne cadrait pas avec le storytelling politique."
                            }
                        ]
                    }
                ],
