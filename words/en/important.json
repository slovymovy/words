                    "sense_id": "ebf7e241-66c9-3cd6-92c0-4ee3922d9f5f",
                    "sense_definition": "Having great value, meaning, or influence.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>important</w> to wash your hands before eating.",
                            "target_lang_translations": {
                                "ru": "<w>Ва́жно</w> мыть руки перед едой.",
                                "nl": "Het is <w>belangrijk</w> om je handen te wassen voor het eten.",
                                "pl": "<w>Ważne</w> jest, aby myć ręce przed jedzeniem.",
                                "de": "Es ist <w>wichtig</w>, sich vor dem Essen die Hände zu waschen.",
                                "fr": "Il est <w>important</w> de se laver les mains avant de manger.",
                                "it": "È <w>importante</w> lavarsi le mani prima di mangiare.",
                                "cs": "Je <w>důležité</w> si před jídlem umýt ruce.",
                                "tr": "Yemek yemeden önce ellerinizi yıkamak <w>önemlidir</w>.",
                                "es": "Es <w>importante</w> lavarse las manos antes de comer.",
                                "zh": "饭前洗手很<w>重要</w>。"
                            }
                        },
                        {
                            "text": "Education plays a very <w>important</w> role in a child's life.",
                            "target_lang_translations": {
                                "ru": "Образование играет очень <w>ва́жную</w> роль в жизни ребёнка.",
                                "nl": "Onderwijs speelt een zeer <w>belangrijke</w> rol in het leven van een kind.",
                                "pl": "Edukacja odgrywa bardzo <w>ważną</w> rolę w życiu dziecka.",
                                "de": "Bildung spielt eine sehr <w>wichtige</w> Rolle im Leben eines Kindes.",
                                "fr": "L'éducation joue un rôle très <w>important</w> dans la vie d'un enfant.",
                                "it": "L'istruzione gioca un ruolo molto <w>importante</w> nella vita di un bambino.",
                                "cs": "Vzdělání hraje v životě dítěte velmi <w>důležitou</w> roli.",
                                "tr": "Eğitim, bir çocuğun hayatında çok <w>önemli</w> bir rol oynar.",
                                "es": "La educación juega un papel muy <w>importante</w> en la vida de un niño.",
                                "zh": "教育在孩子的成长过程中起着非常<w>重要</w>的作用。"
                            }
                        }
                    ],
