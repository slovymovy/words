        "fr-extract.jsonl": [
            {
                "entry_id": "83cc507d-bdc0-33c3-a05c-1cedc57016d9",
                "word": "hackathon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4aa7983e-c268-4dd5-ad91-e2474b2fbeca",
                        "entry_id": "83cc507d-bdc0-33c3-a05c-1cedc57016d9",
                        "tags": [
                            "plural"
                        ],
                        "form": "hackathons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                        "entry_id": "83cc507d-bdc0-33c3-a05c-1cedc57016d9",
                        "glosses": [
                            "Événement où des programmeurs se rencontrent pour collaborer au développement de logiciels."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "4591c986-3241-42e4-8b3b-d9f788c98733",
                                "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                                "text": "Les ambassades en diffusent à l’occasion de salons et de festivals, et organisent même des « hackathons » (fabrication d’un projet VR en 48 heures chrono) à Singapour ou à New York…"
                            },
                            {
                                "example_id": "f9b1b7d7-3778-4cb7-a091-b63ad4970447",
                                "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                                "text": "En mai s’est tenu un hackathon GNOME pour réduire la consommation de ressources d’une session typique de GNOME."
                            },
                            {
                                "example_id": "cd9b8724-d04a-49eb-b239-a05fc73657da",
                                "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                                "text": "Un hackathon, une compétition d’innovation, est également prévu en partenariat avec Île-de-France Mobilités."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79668aee-5fed-45ce-93d9-0300b4a148ff",
                        "source_entry_id": "83cc507d-bdc0-33c3-a05c-1cedc57016d9",
                        "source_sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                        "target_lang_word": "hackathon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hackathon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                                        "entry_id": "ec011a06-f512-3b2a-9c92-904b0d232d1f",
                                        "glosses": [
                                            "An event where programmers and others meet for collaborative software development, usually over several days."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49ca2ed7-7c6c-4643-8478-f11a6dd172d1",
                                                "sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                                                "text": "If these are opinions I'm sure that it happens to have something to do with the immense amounts of caffeine and sugar that I've ingested over the course of his 50hr hackathon."
                                            },
                                            {
                                                "example_id": "90385946-8f11-43a6-bb79-dff6ee8bc260",
                                                "sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                                                "text": "Just after the Hack-A-Thon. A little tired, but it's still early, just after 3 a.m. I log onto^([sic]) the Vax and find that two of the people from the Hack-A-Thon are already on. I VMSphone RJLEWIS, a hacker and the president of our computer club, to ask him why he left the 'thon early. He answers after quite a few rings - no surprise, he was probably doing some hacking. He answers, \"This isn't Crash.\" Hmm...probably one of his roommates. Another person joins the conversation - RLCOLLINS, one of his roommates - saying \"This is Crash.\" Ok, I'm confused. \"Why?,\" I ask. RJLEWIS responds that this is a person named Debbie and it's her first time on the computer."
                                            },
                                            {
                                                "example_id": "66f4776b-b8b4-4e04-b948-83c2c603825a",
                                                "sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                                                "text": "I bet you most programmers started out \"hacking.\" You think you're alone in that, but I'm sure you can find hundreds of people in this newsgroup with \"48-hour hack-a-thon\" or similar kinds of stories. They may have been working with punched cards or with all-text displays, but hacking is hacking. That's why some of the dreaded professional programmers will see your fixation with obscure tricks as nothing more than a phase they've been through themselves."
                                            },
                                            {
                                                "example_id": "488e6e1d-f74d-421b-a6e2-cce44ee93052",
                                                "sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                                                "text": "UNITED ARTISTS, THE ONION, AND THE VIRTUAL GAMING CENTER PERSENT: THE 24 HOUR HACKATHON! n promotion of the new moive \"HACKERS\" (the fast-paced cyberpunk thriller opens in theaters September 15th), we are giving away a some great prizes! Be the first person to \"hack\" into our special web site on the internet and win a BRAND NEW COMPUTER SYSTEM! Fifty runners-up will receive special HACKERS gift packs."
                                            },
                                            {
                                                "example_id": "463e95ba-2e28-43ed-b7ca-d8db7762e17a",
                                                "sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                                                "text": "Startup Bus is arguably the looniest of the many hackathons that take place every weekend across the country. A hackathon is a marathon computer-programming competition that, among computer programmers, is slightly less popular than video games, Ultimate Frisbee, or Game of Thrones. It lasts 24 hours to five days, and usually there is a lot of Red Bull and very little sleep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
