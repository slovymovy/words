                        "examples": [
                            {
                                "example_id": "95553c71-b7c3-4fce-b6ad-e1e8da5f48c2",
                                "sense_id": "292e9234-cee0-37a0-babe-b6ccb9632a86",
                                "text": "Sur ce col que la Bible compare à une tour pour sa rondeur, rêve une tête sphingienne qui regarde devant elle, mais au-delà du réel."
                            },
                            {
                                "example_id": "776da86e-5f97-4e1b-98c0-0185cf13e211",
                                "sense_id": "292e9234-cee0-37a0-babe-b6ccb9632a86",
                                "text": "Terre sphingienne, l’île fait effort pour transformer ses rochers à l’image du grand chat à tête humaine qui couche plus haut, du côté des Pyramides. Pas la moindre pierre qui n’ait déjà l’air d’un commencement de sphinx."
                            }
                        ]
                    }
