                    "sense_definition": "A legally binding contract that can be enforced in a court of law.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should read the rental <w>agreement</w> carefully before signing.",
                            "target_lang_translations": {
