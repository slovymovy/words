                    {
                        "sense_id": "4a8139d6-462d-33c7-8fe0-b462c5b507e8",
                        "entry_id": "bb290ce7-2525-36e8-84ac-248e96c53418",
                        "glosses": [
                            "To recreationally take small amounts of psychedelic drugs in the belief that it will aid productivity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6caf4c5c-6447-41a0-9691-567ad03ed0be",
                                "sense_id": "4a8139d6-462d-33c7-8fe0-b462c5b507e8",
                                "text": "microdose on LSD"
                            },
                            {
                                "example_id": "d967e124-eafa-4339-a7fa-124ef6914b67",
                                "sense_id": "4a8139d6-462d-33c7-8fe0-b462c5b507e8",
                                "text": "What I feel that micro-dosing does is to slightly rearrange my neural furniture so that glimmers of full-on psychedelic states are constantly pouring into my awareness."
                            },
                            {
                                "example_id": "a299ce6c-72e7-4154-8d79-f96fe25ed819",
                                "sense_id": "4a8139d6-462d-33c7-8fe0-b462c5b507e8",
                                "text": "How Microdosing Made a Mega Difference in My Mood, My Marriage, and My Life"
                            },
                            {
                                "example_id": "940d257e-d99a-4c5e-ab95-d5c7a935e865",
                                "sense_id": "4a8139d6-462d-33c7-8fe0-b462c5b507e8",
                                "text": "Microdosing is typically defined by experts as taking 5 percent to 10 percent of a full dose of a psychedelic, usually LSD or psilocybin, as a way to get the supposed mental health benefits of the drug without the hallucinogenic high."
                            },
                            {
                                "example_id": "20a2a992-0390-4fdd-9a39-49a7570bda57",
                                "sense_id": "4a8139d6-462d-33c7-8fe0-b462c5b507e8",
                                "text": "You microdose while you wifing hoes / I macrodose while I'm mackin' hoes"
                            },
                            {
                                "example_id": "221185a1-38b4-440a-8ac0-f0e3447c36e5",
                                "sense_id": "4a8139d6-462d-33c7-8fe0-b462c5b507e8",
                                "text": "And just like any other tech company, we're expanding our minds by microdosing ketamine."
                            }
                        ]
                    }
