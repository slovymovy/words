                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Своими постоянными придирками и замечаниями он меня просто <доехал>.",
                            "target_lang_translations": {
                                "en": "With his constant nitpicking and remarks, he simply <wore> me <out>.",
                                "nl": "Met zijn constante gezeur en opmerkingen heeft hij me echt <w>afgemat</w>.",
                                "pl": "Swoim ciągłym czepianiem się i uwagami po prostu mnie <w>wykończył</w>.",
                                "de": "Mit seiner ständigen Nörgelei und seinen Bemerkungen hat er mich einfach <w>fertiggemacht</w>.",
                                "fr": "Avec ses critiques et ses remarques constantes, il m'a tout simplement <w>épuisé</w>.",
                                "it": "Con le sue continue critiche e osservazioni mi ha proprio <esasperato>.",
                                "cs": "Svým neustálým rýpáním a poznámkami mě úplně <w>dorazil</w>.",
                                "tr": "Sürekli kusur bulmaları ve eleştirileriyle beni resmen <w>bezdirdi</w>.",
                                "es": "Con sus constantes críticas y comentarios, simplemente me <w>agotó</w>.",
                                "zh": "他那没完没了的挑剔和指责简直让我<w>烦透</w>了。"
                            }
                        },
                        {
                            "text": "Эта бесконечная и тяжёлая работа вконец нас <доехала>.",
                            "target_lang_translations": {
                                "en": "This endless and hard work completely <finished> us <off>.",
                                "nl": "Dit eindeloze en zware werk heeft ons volledig <w>gesloopt</w>.",
                                "pl": "Ta niekończąca się i ciężka praca kompletnie nas <w>wykończyła</w>.",
                                "de": "Diese endlose und schwere Arbeit hat uns völlig <w>zermürbt</w>.",
                                "fr": "Ce travail interminable et difficile nous a complètement <w>épuisés</w>.",
                                "it": "Questo lavoro infinito e pesante ci ha <finito> del tutto.",
                                "cs": "Tato nekonečná a těžká práce nás úplně <w>dorazila</w>.",
                                "tr": "Bu bitmek bilmeyen ağır iş bizi tamamen <w>tüketti</w>.",
                                "es": "Este trabajo interminable y pesado nos <w>hartó</w> por completo.",
                                "zh": "这没完没了的繁重工作把我们彻底<w>折磨</w>垮了。"
                            }
