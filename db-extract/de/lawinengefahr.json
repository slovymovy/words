                "senses": [
                    {
                        "sense_id": "fd8aa07f-10f7-3804-9690-a1c504628d13",
                        "entry_id": "2b33361f-c4e4-3e9b-bfb2-93e97a3d8e35",
                        "glosses": [
                            "Risque d'avalanche, danger d'avalanche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d47032cb-a7bd-4e03-9e98-5b5834e9ed3e",
                                "sense_id": "fd8aa07f-10f7-3804-9690-a1c504628d13",
                                "text": "In zahlreichen Alpentälern herrscht hohe Lawinengefahr und einige Gemeinden sind von der Außenwelt abgeschnitten.",
                                "translation": "Dans de nombreuses vallées alpines, le risque d'avalanche est élevé et certaines communes sont coupées du monde extérieur."
                            },
                            {
                                "example_id": "455bf14e-1a0c-45b4-9e5e-924b06828ebb",
                                "sense_id": "fd8aa07f-10f7-3804-9690-a1c504628d13",
                                "text": "In der Aussendung wird zudem vor einer zunehmenden Lawinengefahr im Hochgebirge gewarnt. Das frühwinterliche Wetter soll über das Wochenende hinaus anhalten.",
                                "translation": "Le communiqué avertit également d’un danger d'avalanche croissant en haute montagne. Le temps de début d'hiver va probablement se prolonger au-delà du week-end."
                            }
                        ]
                    }
                ],
