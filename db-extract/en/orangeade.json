                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c258cd-0f27-4818-8fb7-3267f6f6d004",
                                                "sense_id": "f37024eb-1cc7-3c17-8b64-c5cdef7616e0",
                                                "text": "c’est la mode aujourd’hui de prévenir ainsi la soif : les uns prennent de l’orangeade ou de l’eau de limon, les autres de l’eau de mélisse."
                                            },
                                            {
                                                "example_id": "7de6ebb7-1532-4d54-ab80-88392fe42d9b",
                                                "sense_id": "f37024eb-1cc7-3c17-8b64-c5cdef7616e0",
                                                "text": "Mais elle avait pris la route avant l'aube et sous l’orage. Pour voir sa fille, pour l'entendre, pour ne pas l’inquiéter. Après avoir bu son orangeade..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d99eaa8d-b57b-4bac-9842-41a66a4a89ad",
                        "source_entry_id": "0e5b8896-3d7a-3d78-ba32-40091081b457",
                        "source_sense_description": "soda water and orange juice",
                        "target_lang_word": "Orangenlimonade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orangenlimonade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12fef15b-f9e9-3712-b982-b215c96d9048",
                                        "entry_id": "f65bd2f5-2fba-3131-9d2e-cc621a4fbd22",
                                        "glosses": [
                                            "alkoholfreies, kohlensäurehaltiges Erfrischungsgetränk aus Orangensaft (Zucker und Wasser)"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Germany",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62fbefc-ad89-4c6c-951f-cb241fde40f6",
                                                "sense_id": "12fef15b-f9e9-3712-b982-b215c96d9048",
                                                "text": "„Wer meint, er könne im Sommer die Apfelsine durch eine Orangenlimonade ersetzen, irrt gewaltig; Zitruslimonaden, müssen nicht die Spur einer Frucht enthalten.“"
                                            },
                                            {
                                                "example_id": "76c0c354-9997-483a-b906-6ec0cd23827d",
                                                "sense_id": "12fef15b-f9e9-3712-b982-b215c96d9048",
                                                "text": "„So kostete etwa in einem Wiener Supermarkt ein Liter Orangensaft ([…]) 8,90 Schilling, ein Liter Orangennektar ([…]) 12,90 S und eineinhalb Liter Orangenlimonade ([…]) 17,90 S.“"
                                            },
                                            {
                                                "example_id": "c185039d-6665-4969-a191-acbf1810832f",
                                                "sense_id": "12fef15b-f9e9-3712-b982-b215c96d9048",
                                                "text": "„Am stärksten gefragt waren 2002 einmal mehr Cola-Getränke (45,6%), gefolgt von Orangenlimonaden (15,0%), Kräuterlimonaden (12,9%), Zitruslimonaden (11,0%) und Wellnessdrinks (7,1%).“"
                                            },
                                            {
                                                "example_id": "420f5dc0-5144-4c03-b4f1-bbef15c7c958",
                                                "sense_id": "12fef15b-f9e9-3712-b982-b215c96d9048",
                                                "text": "„Er schob sich die Schrotflinte in die Armbeuge, nahm eine Dose Orangenlimonade aus dem Kühlschrank, riss mit dem Zeigefinger den Verschluss auf, trank daraus und lauschte auf etwaige, auf das metallische Klicken der Dose folgende Geräusche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
