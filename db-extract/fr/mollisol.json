                        "glosses": [
                            "Couche du sol, au-dessus du pergélisol, qui gèle en hiver et dégèle en été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1141ba7a-08d1-4200-9018-b9271121f64d",
                                "sense_id": "a24f62e2-2c4e-3c4a-a39f-410922e59429",
                                "text": "La tranche de sol qui dégèle en été au-dessus du pergélisol est appelée mollisol (couche active des Anglo-Saxons). Son épaisseur diminue avec la latitude : au Canada, elle est d’environ 2,5 m aux marges de la forêt de résineux ; elle n’est plus que de 1,5 m dans la toundra boisée et de 0,5 m à Resolute."
                            }
                        ]
                    }
