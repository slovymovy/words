                            "text": "Mr. <w>Queen</w> was appointed as the new director of the company.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Куин</w> был назначен новым директором компании.",
                                "zh": "<w>奎因</w>先生被任命为公司新任董事。"
                            }
                        }
                    ],
