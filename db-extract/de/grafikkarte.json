                                        "entry_id": "46153dff-0315-3670-b5a1-e50da0294b8e",
                                        "glosses": [
                                            "A circuit board that generates and controls the visual display on a computer screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8799a444-6945-45ef-989e-b54a46dd9f01",
                                                "sense_id": "50a4a435-e88e-3497-910d-d3b6273cf53a",
                                                "text": "Sitting down in front of her desktop, Veneza starts working, even though she hasn’t had a chance to install the new graphics card yet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
