                                    },
                                    {
                                        "sense_id": "fcc8b972-fb30-323b-802f-faa9996a2fde",
                                        "entry_id": "6878ed79-ec62-3d78-9bdd-05bb4de3e78c",
                                        "glosses": [
                                            "One who or that which makes a tweeting noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9af2ff-151c-4e93-8744-bf7b886f0baf",
                                                "sense_id": "fcc8b972-fb30-323b-802f-faa9996a2fde",
                                                "text": "The little tweeter birds that had kept her company this morning were now absent, leaving nothing but the whisper of the trees as a light breeze gently wandered by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c306a545-06e7-317f-8079-f4d6e062b061",
                                        "entry_id": "6878ed79-ec62-3d78-9bdd-05bb4de3e78c",
                                        "glosses": [
                                            "One who posts messages (\\\"tweets\\\") on the social networking site Twitter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ab78a8-b222-4b10-b236-864ef8cc6494",
                                                "sense_id": "c306a545-06e7-317f-8079-f4d6e062b061",
                                                "text": "The latest addition to these daily outpourings are suggested tweets to circulate. Fortunately I am not a tweeter, so I swiftly delete all these unread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d71e9e7b-218f-3195-9ced-4637f5139993",
                                        "entry_id": "6878ed79-ec62-3d78-9bdd-05bb4de3e78c",
                                        "glosses": [
                                            "A poster on a microblogging social networking service."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
