                                        "sense_id": "4dd7681c-f4bf-3377-a01b-257fdd4755e1",
                                        "entry_id": "75169c01-4cc1-368a-b27a-306d47827640",
                                        "glosses": [
                                            "blijvend, niet-tijdelijk (bij financiën: het uiteindelijke periodieke bedrag)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6290f95-fe8f-492a-bd1b-e70487a9d85f",
                                                "sense_id": "4dd7681c-f4bf-3377-a01b-257fdd4755e1",
                                                "text": "De wet Hillen wordt vanaf 2019 in 20 jaar afgeschaft. Dit is een lastenverzwaring van 0,1 mld euro in 2021 en 1,1 mld euro structureel."
                                            },
                                            {
                                                "example_id": "e623668a-80be-4628-b87b-3efaf0688b7a",
                                                "sense_id": "4dd7681c-f4bf-3377-a01b-257fdd4755e1",
                                                "text": "Zou het mogelijk zijn om deze trails een structureel onderdeel van mijn leven te maken in plaats van een sabbatical om de tig jaar? Het idee alleen al om mijn werk wat regelmatiger te kunnen afwisselen met een wandeling in de natuur gaf me rust."
                                            },
                                            {
                                                "example_id": "ddbd32a1-0d60-4609-acc3-25f207f68a5f",
                                                "sense_id": "4dd7681c-f4bf-3377-a01b-257fdd4755e1",
                                                "text": "\"Bij institutioneel racisme gaat het typisch om ingebakken, structurele mechanismen\", voegt Nationaal Coördinator tegen Discriminatie en Racisme (NCDR) Rabin Baldewsingh toe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fffb951e-b9b8-4673-8c21-7cfddba326da",
                        "source_entry_id": "89a6634d-cf56-3462-8ffd-a2d2b0a71c43",
                        "source_sense_description": "of, relating to, or having structure",
                        "target_lang_word": "structurel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "structurel",
