                        "glosses": [
                            "het ei van een kievit vooral bekend van het zoeken naar kievitseieren dat gedaan wordt in Friesland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2edff0a-ed8b-4029-b5df-9f6dc2c158bb",
                                "sense_id": "12158e3b-c1cf-3b78-be95-db86ce548642",
                                "text": "Lenie Lowik en haar dochter Marion Krikhaar hebben maandagochtend rond half tien het eerste kievitsei gevonden aan de Geesterseveldweg tegenover de klootschietersbaan van De Huier in Geesteren."
                            },
                            {
                                "example_id": "5bd8a60a-079e-4673-9500-6e6cf8b59811",
                                "sense_id": "12158e3b-c1cf-3b78-be95-db86ce548642",
                                "text": "Burgemeester Joost van Oostrum neemt dinsdagmiddag symbolisch eerste kievitsei van Berkelland in ontvangst. Hij krijgt het ei niet echt in handen: hij moet het doen met een sneak preview. Oftewel: het blijft bij gluren van een eindje."
                            }
                        ]
