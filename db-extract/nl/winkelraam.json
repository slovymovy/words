                        "glosses": [
                            "het grote raam van een winkel waarachter de te verkopen producten zijn geëtaleerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eee348c-b55a-41ef-8287-976d96b8a473",
                                "sense_id": "f4cc1fda-ef53-3c47-999e-4fe36545db69",
                                "text": "Nou kon het niet meer, begreep-ie; die vent had natuurlijk gezien, van welke kant hij kwam' en hij zou het heel verdacht vinden: Een jongen die aan kwam lopen' en even voor 't winkelraam kwam staan, en dan weer terugging! En Kees stapte weg: de andere kant uit dan hij wou."
                            }
                        ]
                    }
