            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ffc0876-3031-3bde-a445-cc1a239212e0",
                    "sense_definition": "Ouvrage de recherche approfondi rédigé et soutenu devant un jury pour obtenir un grade universitaire, notamment le doctorat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "université",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de recherche, elle va enfin soutenir sa <w>thèse</w> devant un jury d'experts."
                        },
                        {
                            "text": "Son directeur de recherche l'aide à choisir un bon sujet pour sa <w>thèse</w> de doctorat."
                        }
                    ],
                    "synonyms": [
                        "dissertation",
                        "mémoire"
                    ],
                    "common_phrases": [
                        "thèse de doctorat",
                        "soutenir sa thèse",
                        "sujet de thèse"
                    ]
                },
                {
                    "sense_id": "7f30f4bf-5d48-3355-9aa4-b62ec667698a",
                    "sense_definition": "Proposition théorique ou opinion argumentée que l'on soutient ou que l'on défend.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a réuni plusieurs preuves solides pour défendre sa <w>thèse</w> face aux critiques."
                        },
                        {
                            "text": "Les enquêteurs de la police privilégient pour l'instant la <w>thèse</w> d'un accident."
                        }
                    ],
                    "synonyms": [
                        "opinion",
                        "théorie"
                    ],
                    "common_phrases": [
                        "défendre une thèse",
                        "thèse du complot",
                        "thèse officielle"
                    ]
                },
                {
                    "sense_id": "40255a35-f23e-3c94-acce-117babcfdb2c",
                    "sense_definition": "Dans la démarche dialectique, première proposition affirmative que l'on formule avant de lui opposer une contradiction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans sa dissertation de philosophie, l'élève présente d'abord la <w>thèse</w> avant de développer les objections."
                        },
                        {
                            "text": "La méthode dialectique commence par poser une <w>thèse</w> pour ensuite examiner sa contradiction."
                        }
                    ],
                    "antonyms": [
                        "antithèse"
                    ],
                    "common_phrases": [
                        "thèse antithèse synthèse"
                    ]
                }
            ]
        }
