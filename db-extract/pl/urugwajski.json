                    },
                    {
                        "translation_id": "e0882b88-67a5-4820-8efa-a84aa257875d",
                        "source_entry_id": "64c21184-9de2-3f3b-a842-f479e0852abd",
                        "source_sense_id": "9b6b4183-214b-3088-92ae-3f0eb9f2bcfb",
