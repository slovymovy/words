                                                "sense_id": "66d00455-19fd-3eee-9b55-96b89eb6c380",
                                                "text": "O secretismo nas reuniões estratégicas impedia que os funcionários soubessem dos próximos passos da empresa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9e2a238-ff3e-3166-a5d1-06769125c519",
                                        "entry_id": "ee2d75b6-987b-343a-bd8b-b40a9bffa66c",
                                        "glosses": [
