                                "sense_id": "0c41fddb-1484-3968-ad40-642464a734a2",
                                "text": "Dit is de tafel waarop de vaas staat."
                            },
                            {
                                "example_id": "ab7aceef-c32d-4196-bd33-3605925cc37c",
                                "sense_id": "0c41fddb-1484-3968-ad40-642464a734a2",
                                "text": "Het viel mij best tegen toen ik een bord zag waarop mile 1 stond."
                            },
