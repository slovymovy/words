                        },
                        {
                            "text": "Мне нужно срочно <увидеть> врача.",
                            "target_lang_translations": {
                                "en": "I need to <w>see</w> a doctor urgently.",
                                "de": "Ich muss dringend einen Arzt <w>sprechen</w>.",
                                "zh": "我需要尽快<w>见</w>医生。",
                                "nl": "Ik moet dringend een arts <w>zien</w>.",
                                "pl": "Muszę pilnie <w>zobaczyć się</w> z lekarzem.",
                                "fr": "J'ai besoin de <w>voir</w> un médecin en urgence.",
                                "it": "Ho bisogno di <w>vedere</w> un medico urgentemente.",
                                "cs": "Potřebuji nutně <w>uvidět</w> lékaře.",
                                "tr": "Acilen bir doktora <w>görünmem</w> gerekiyor.",
                                "es": "Necesito <w>ver</w> a un médico urgentemente."
