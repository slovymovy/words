                "senses": [
                    {
                        "sense_id": "fcd75499-f14c-3def-bf26-943f3a34ae3b",
                        "entry_id": "4f412436-ebe0-3640-b00f-230903650a20",
                        "glosses": [
                            "Retirer le heaume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ac3879-7bf4-456e-9b16-e619e48701bf",
                                "sense_id": "fcd75499-f14c-3def-bf26-943f3a34ae3b",
                                "text": "Celui qui demeurera le plus longtemps sur les rangs sans déheaumer."
                            },
                            {
                                "example_id": "a11b934c-7027-4d8b-9e4a-1f19c17407f3",
                                "sense_id": "fcd75499-f14c-3def-bf26-943f3a34ae3b",
                                "text": "Hors du décompte, il existe des coups qui sont particulièrement appréciés de la foule, comme « déheaumer » son adversaire, c’est-à-dire faire sauter le casque de son adversaire avec sa lance."
                            }
                        ]
                    }
