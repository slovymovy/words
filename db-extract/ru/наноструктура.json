                                                "example_id": "b4b13b17-ff71-4c44-afa7-5e4ebc0c4275",
                                                "sense_id": "7d7d75bf-63eb-3bc6-9389-73020a2e3f3b",
                                                "text": "In the close vicinity of a chiral nanostructure, the circular dichroism of a biomolecule could be greatly enhanced, due to the interaction with the local superchiral fields."
                                            }
