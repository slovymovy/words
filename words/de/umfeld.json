                    "frequency": "High",
                    "semantic_group_id": "verhaeltnisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das wirtschaftliche <w>Umfeld</w> hat sich im vergangenen Jahr für viele Betriebe deutlich verschlechtert."
                        },
                        {
                            "text": "In einem politisch unsicheren <w>Umfeld</w> sind langfristige Investitionen mit erheblichen Risiken verbunden."
                        }
                    ],
                    "synonyms": [
