                "senses": [
                    {
                        "sense_id": "567f18b8-2db2-3f3e-92dd-25bedf31e9f7",
                        "entry_id": "11202afe-8e0c-348d-b995-2e96369030a9",
                        "glosses": [
                            "Offiziersrang zwischen dem Oberleutnant zur See und dem Stabskapitänleutnant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bf7085e-055f-42b7-bc10-3d2d2f32d7ac",
                                "sense_id": "567f18b8-2db2-3f3e-92dd-25bedf31e9f7",
                                "text": "„Nach Dienstgradgruppen unterscheidet man Generale/Admirale, Stabsoffiziere, Hauptleute/Kapitänleutnante, Leutnante und Offizieranwärter; in den meisten Dienstgradgruppen sind mehrere Dienstgrade zusammengefasst (Dienstgradabzeichen).“"
                            },
                            {
                                "example_id": "1d55fbdc-f4b2-4358-a96c-f22083abff66",
                                "sense_id": "567f18b8-2db2-3f3e-92dd-25bedf31e9f7",
                                "text": "„Dann erzählte ein Matrose von seinen Erlebnissen an Bord eines Auslandkreuzers. Da hatte auf einem Ausflug ein Kapitänleutnant ein Krokodil erlegt und ließ es häuten und die Haut auf dem Achterdeck zum Trocknen ausspannen.“"
                            },
                            {
                                "example_id": "44d7d9d1-cb0e-4ece-8712-c5d4814b463a",
                                "sense_id": "567f18b8-2db2-3f3e-92dd-25bedf31e9f7",
                                "text": "„Hier kannte der brave Major Brenner einen Kapitänleutnant der Kriegsmarine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b663f24a-a07d-339b-b699-d361aa5de1ed",
