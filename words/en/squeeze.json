                                "target_lang_sense_clarification": "в ограниченное пространство"
                            },
                            {
                                "target_lang_word": "впихнуть",
                                "target_lang_sense_clarification": "разместить с трудом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挤",
                                "target_lang_sense_clarification": "进入狭窄空间"
                            },
                            {
                                "target_lang_word": "塞",
                                "target_lang_sense_clarification": "强行放入"
                            },
                            {
                                "target_lang_word": "挤过",
                                "target_lang_sense_clarification": "通过狭窄处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9a86543-5d29-332b-8928-96356121be22",
                    "sense_definition": "To embrace someone closely or give them a tight, affectionate hug.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave her daughter a big <w>squeeze</w> before she left for school.",
                            "target_lang_translations": {
                                "ru": "Она крепко <w>обняла</w> дочь перед тем, как та ушла в школу.",
                                "zh": "女儿去上学前，她给了她一个大大的<w>拥抱</w>。"
                            }
                        },
                        {
                            "text": "He would <w>squeeze</w> her hand gently to show that he was listening.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>сжимал</w> её руку, чтобы показать, что слушает.",
                                "zh": "他会轻轻<w>握</w>一下她的手，表示他在听。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "condense"
                    ],
                    "antonyms": [
                        "release"
                    ],
                    "common_phrases": [
                        "squeeze someone's hand",
                        "give a tight squeeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крепко обнимать кого-либо или нежно сжимать руку в знак привязанности.",
                        "zh": "亲密地拥抱或温柔地握住。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "руку или в объятиях"
                            },
                            {
                                "target_lang_word": "пожать",
                                "target_lang_sense_clarification": "руку"
                            },
                            {
                                "target_lang_word": "прижать",
                                "target_lang_sense_clarification": "к себе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧握",
                                "target_lang_sense_clarification": "握住手"
                            },
                            {
                                "target_lang_word": "拥抱",
                                "target_lang_sense_clarification": "亲密动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0f198cc-f6c4-3ac5-a8d9-ebf7996fa6e0",
                    "sense_definition": "To put someone in a difficult position by presenting conflicting demands or limited choices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pressure_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am being <w>squeezed</w> between my demanding job and my volunteer work.",
                            "target_lang_translations": {
                                "ru": "Я <w>разрываюсь</w> между требовательной работой и волонтерской деятельностью.",
                                "zh": "我正被繁重的工作和志愿服务<w>挤压</w>得喘不过气来。"
                            }
                        },
                        {
                            "text": "The rising costs of living are starting to <w>squeeze</w> middle-class families.",
                            "target_lang_translations": {
                                "ru": "Растущая стоимость жизни начинает <w>давить</w> на семьи среднего класса.",
                                "zh": "不断上涨的生活成本开始<w>压迫</w>中产阶级家庭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "condense"
                    ],
                    "common_phrases": [
                        "squeezed from both sides",
                        "squeeze the budget"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставить кого-либо в затруднительное положение из-за противоречивых требований или ограниченного выбора.",
                        "zh": "因相互冲突的要求或有限的选择而使人处于困境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зажимать",
                                "target_lang_sense_clarification": "в тиски обстоятельств"
                            },
                            {
                                "target_lang_word": "оказывать давление",
                                "target_lang_sense_clarification": "финансовое или моральное"
                            },
                            {
                                "target_lang_word": "стеснять",
                                "target_lang_sense_clarification": "в средствах или возможностях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挤压",
                                "target_lang_sense_clarification": "施加压力"
                            },
                            {
                                "target_lang_word": "逼迫",
                                "target_lang_sense_clarification": "使处于困境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4625c6f0-7b72-3278-8380-662f6110a04e",
                    "sense_definition": "To oppress or harass someone with hardships, heavy burdens, or excessive taxes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "oppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government continues to <w>squeeze</w> every penny of profit from small businesses.",
                            "target_lang_translations": {
                                "ru": "Правительство продолжает <w>выжимать</w> каждый цент прибыли из малого бизнеса.",
                                "zh": "政府继续从小型企业中<w>榨取</w>每一分利润。"
                            }
                        },
                        {
                            "text": "During the war, the local population was <w>squeezed</w> by heavy military taxes.",
                            "target_lang_translations": {
                                "ru": "Во время войны местное население <w>душили</w> тяжелыми военными налогами.",
                                "zh": "战争期间，当地民众被沉重的军事税收<w>压榨</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "condense"
                    ],
                    "common_phrases": [
                        "squeeze for money",
                        "squeeze every penny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угнетать или изводить кого-либо трудностями, тяжелым бременем или чрезмерными налогами.",
                        "zh": "通过困难、沉重负担或过高税收来压迫或骚扰某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выжимать",
                                "target_lang_sense_clarification": "все соки или деньги"
                            },
                            {
                                "target_lang_word": "притеснять",
                                "target_lang_sense_clarification": "налогами или поборами"
                            },
                            {
                                "target_lang_word": "обирать",
                                "target_lang_sense_clarification": "до нитки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "榨取",
                                "target_lang_sense_clarification": "获取利益"
                            },
                            {
                                "target_lang_word": "压榨",
                                "target_lang_sense_clarification": "剥削"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebd71f6c-3e30-38c6-a541-1ae0363bfa3f",
                    "sense_definition": "In baseball, to attempt to score a runner from third base by bunting the ball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach decided to <w>squeeze</w> in the winning run with a perfect bunt.",
                            "target_lang_translations": {
                                "ru": "Тренер решил <w>выжать</w> победное очко с помощью идеального банта.",
                                "zh": "教练决定通过一次完美的短打来<w>强迫取分</w>，赢得比赛。"
                            }
                        },
                        {
                            "text": "They tried to <w>squeeze</w> the runner home, but the pitcher was too fast.",
                            "target_lang_translations": {
                                "ru": "Они пытались <w>завести</w> раннера домой, но питчер был слишком быстр.",
                                "zh": "他们试图通过短打让跑垒员<w>跑回</w>本垒，但投球手动作太快了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compress",
                        "condense"
                    ],
                    "common_phrases": [
                        "squeeze play",
                        "squeeze in a runner"
                    ],
                    "traits": [
