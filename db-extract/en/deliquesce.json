                ],
                "senses": [
                    {
                        "sense_id": "91e7275b-047b-32f2-8fce-d7ab3677612f",
                        "entry_id": "3e307784-3584-3dc0-908b-fd9a6e88449d",
                        "glosses": [
                            "To melt by absorbing water and disappearing."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a4fb5a2-b091-4143-923b-b9d648bf56ed",
                                "sense_id": "91e7275b-047b-32f2-8fce-d7ab3677612f",
                                "text": "But I could find no saltpetre; indeed, no nitrates of any kind. Doubtless they had deliquesced ages ago."
                            },
                            {
                                "example_id": "ac598073-c5cd-4712-9399-4d8bf4da3b94",
                                "sense_id": "91e7275b-047b-32f2-8fce-d7ab3677612f",
                                "text": "The buildings were Victorian ruins; there were never any razor blades; cheap socks deliquesced beneath your feet."
                            },
                            {
                                "example_id": "ed046ca2-a116-4c69-a398-a0fb10fb3144",
                                "sense_id": "91e7275b-047b-32f2-8fce-d7ab3677612f",
                                "text": "When he tried to extract the liver, which should have been firm and meaty, it deliquesced into a bloody sludge, sliding goopily through his fingers."
                            },
                            {
                                "example_id": "605a65a2-cbe0-4d57-8dcd-64f131b1fe25",
                                "sense_id": "91e7275b-047b-32f2-8fce-d7ab3677612f",
                                "text": "When mystery deliquesced into renewed bitching over the cramped ride, Alfred issued a second moan-bark: longer, louder, and impossible to ignore."
                            }
                        ]
                    },
                    {
                        "sense_id": "5260407b-e95b-3fe2-a430-05f45f8855f9",
                        "entry_id": "3e307784-3584-3dc0-908b-fd9a6e88449d",
                        "glosses": [
                            "To become liquid by absorbing water from the atmosphere and dissolving in it."
                        ],
                        "tags": [
                            "intransitive",
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "d4610156-7173-4490-8123-fdf8c52b92b0",
                                "sense_id": "5260407b-e95b-3fe2-a430-05f45f8855f9",
                                "text": "Some salts will deliquesce when left exposed."
                            }
                        ]
                    }
                ],
