                "senses": [
                    {
                        "sense_id": "8b4c4026-cce2-3b5d-8c87-fdb238cb41c7",
                        "entry_id": "19307964-612c-3178-a1a1-e34e655312a7",
                        "glosses": [
                            "Rapprocher de Nicolas Sarkozy par les idées ou par le style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6414371-bc8e-4c69-bcdb-70532468a90c",
                                "sense_id": "8b4c4026-cce2-3b5d-8c87-fdb238cb41c7",
                                "text": "En tout cas c'est le Maire de Troyes qui parait être le mieux placé depuis que l'ex-pr a \" sarkozysé\" Fillon."
                            },
                            {
                                "example_id": "de895408-88f0-4fcb-8a30-4ee547ba4adc",
                                "sense_id": "8b4c4026-cce2-3b5d-8c87-fdb238cb41c7",
                                "text": "\"Je vous dis qu'ils vont 'sarkozyser' Fillon\", prophétise Gilbert Collard."
                            },
                            {
                                "example_id": "17e7462f-dce3-4bf6-b10f-e1f889fb973b",
                                "sense_id": "8b4c4026-cce2-3b5d-8c87-fdb238cb41c7",
                                "text": "Le parti s'est tour à tour chiraquisé, balladurisé et sarkozysé."
                            }
                        ]
                    }
