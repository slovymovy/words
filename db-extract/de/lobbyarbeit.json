                        "examples": [
                            {
                                "example_id": "92c14339-3b1d-40b7-9ada-c3a69ced0dab",
                                "sense_id": "21f5ffae-204a-3322-a4dd-4230d331b498",
                                "text": "In den USA geht man mit Lobbyarbeit transparenter um: Der US-Pharmaverband PhRMA, die wichtigste Interessenvertretung der Arzneimittelindustrie in dem Land, hat im vergangenen Jahr so viel Geld für Lobbyarbeit ausgegeben wie nie zuvor.",
                                "translation": "In the USA, lobbying is handled more transparently: the US pharmaceutical association PhRMA, the most important advocacy group for the drug industry in the country, spent more money on lobbying than ever before in the past year.",
                                "english": "In the USA, lobbying is handled more transparently: the US pharmaceutical association PhRMA, the most important advocacy group for the drug industry in the country, spent more money on lobbying than ever before in the past year."
                            },
                            {
                                "example_id": "86bdd300-7f48-4bf7-a541-77a3c4679778",
                                "sense_id": "21f5ffae-204a-3322-a4dd-4230d331b498",
                                "text": "Für den Kreuzfahrttourismus in Venedig gebe es keine Lösung, sagte Petra Reski: „Aber die Lobbyarbeit der Kreuzfahrtindustrie ist sehr erfolgreich, und die italienische Regierung ist in all den Jahren immer wieder eingeknickt.",
                                "translation": "There is no solution for cruise tourism in Venice, said Petra Reski: \"But the lobbying of the cruise industry is very successful, and the Italian government has caved in over the years",
                                "english": "There is no solution for cruise tourism in Venice, said Petra Reski: \"But the lobbying of the cruise industry is very successful, and the Italian government has caved in over the years"
                            },
                            {
                                "example_id": "50c0a9e3-8d3c-4b80-8d54-fcc60dd05196",
                                "sense_id": "21f5ffae-204a-3322-a4dd-4230d331b498",
                                "text": "Nachdem juristische Feinheiten einem Auskunftsrecht im Weg stehen, will die Plattform nun erneut wissen, ob in dem Büro Lobbyarbeit für Russland betrieben wurde.",
                                "translation": "After legal subtleties stand in the way of a right to information, the platform now wants to know again whether lobbying for Russia was carried out in the office.",
                                "english": "After legal subtleties stand in the way of a right to information, the platform now wants to know again whether lobbying for Russia was carried out in the office."
                            }
                        ]
                    }
                ],
