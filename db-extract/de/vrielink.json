                "senses": [
                    {
                        "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                        "entry_id": "481555b3-5ad1-32a8-b6d8-f02524242103",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb7a9308-4970-498e-9787-67a048efd55e",
                                "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                                "text": "Frau Vrielink ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4fd9e5f6-b2a1-4764-9c05-77c3900f78e5",
                                "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                                "text": "Herr Vrielink wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "25c39e00-9387-420f-ae61-dc1559fafcc1",
                                "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                                "text": "Die Vrielinks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "091c115a-ff5e-40ea-bb6b-d773fe2aa154",
                                "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                                "text": "Der Vrielink trägt nie die Schals, die die Vrielink ihm strickt."
                            },
                            {
                                "example_id": "c61c604a-c5cd-4bf7-bf88-55c4064ed5b7",
                                "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vrielink kommt, geht der Herr Vrielink.“"
                            },
                            {
                                "example_id": "87f35f2d-3dad-4381-932f-791b406ff284",
                                "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                                "text": "Vrielink kommt und geht."
                            },
                            {
                                "example_id": "2c59953c-4232-407c-b916-174539c4ac39",
                                "sense_id": "329b5f99-d62f-3071-a1fe-c9368856d01e",
                                "text": "Vrielinks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
