            "pos": "verb",
            "senses": [
                {
                    "sense_id": "852e7032-78e3-39cb-8726-0bd994636ae1",
                    "sense_definition": "Faire passer un corps solide dans un liquide de manière à former une solution homogène.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>dissoudre</w> complètement cette poudre dans un verre d'eau avant de la boire."
                        },
                        {
                            "text": "Le sel commence à se <w>dissoudre</w> dès qu'on le plonge dans l'eau bouillante."
                        }
                    ],
                    "synonyms": [
                        "diluer"
                    ],
                    "antonyms": [
                        "précipiter",
                        "cristalliser"
                    ],
                    "common_phrases": [
                        "dissoudre dans un liquide",
                        "dissoudre un comprimé",
                        "dissoudre du sel"
                    ]
                },
                {
                    "sense_id": "51300ec5-0a92-36de-813a-300f2307e5f9",
                    "sense_definition": "Mettre officiellement fin à une institution, une assemblée politique, une société ou une union légale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit_politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président a décidé de <w>dissoudre</w> cette institution afin de renouveler la confiance des citoyens."
                        },
                        {
                            "text": "Les deux associés ont convenu de <w>dissoudre</w> leur entreprise après plusieurs mois de désaccords constants."
                        }
                    ],
                    "synonyms": [
                        "démanteler",
                        "rompre",
                        "résilier"
                    ],
                    "antonyms": [
                        "constituer",
                        "fonder",
                        "instituer"
                    ],
                    "common_phrases": [
                        "dissoudre une assemblée",
                        "dissoudre une société",
                        "dissoudre un mariage"
                    ]
                },
                {
                    "sense_id": "3c80bc1f-ec19-349b-84ba-eee2571ec946",
                    "sense_definition": "Faire disparaître progressivement quelque chose, ou s'évanouir au point de ne plus exister.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disparition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous ses doutes ont fini par se <w>dissoudre</w> face aux explications claires et rassurantes du professeur."
                        },
                        {
                            "text": "Dans le brouillard épais de l'aube, la silhouette de la montagne semblait peu à peu se <w>dissoudre</w>."
                        }
                    ],
                    "synonyms": [
                        "disparaître",
                        "se dissiper",
                        "s'évanouir"
                    ],
                    "antonyms": [
                        "apparaître",
                        "se matérialiser"
                    ],
                    "common_phrases": [
                        "dissoudre les doutes",
                        "dissoudre les tensions"
                    ]
                }
            ]
        }
