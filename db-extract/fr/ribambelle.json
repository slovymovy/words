                "senses": [
                    {
                        "sense_id": "71633156-e69b-3f41-802a-6d91136e0d52",
                        "entry_id": "565b7a2c-6c32-31d2-9d9e-422c8af6a66a",
                        "glosses": [
                            "Kyrielle ; longue suite."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a658c3f3-2f6d-43b9-bd36-3ea954d633ac",
                                "sense_id": "71633156-e69b-3f41-802a-6d91136e0d52",
                                "text": "Il […] regarda longuement cette ribambelle de maisons et d’arbres qui semblaient se donner la main et sauter devant ses yeux une gigantesque farandole."
                            },
                            {
                                "example_id": "3c8a516c-de0f-4206-88a4-9cc6347e7244",
                                "sense_id": "71633156-e69b-3f41-802a-6d91136e0d52",
                                "text": "J'ai une ribambelle de stylos bleus, à ne savoir que faire"
                            },
                            {
                                "example_id": "2bf671d3-bca6-462d-aa34-428a0b0e16c2",
                                "sense_id": "71633156-e69b-3f41-802a-6d91136e0d52",
                                "text": "Rue de l’Exposition, à Grenelle, grouillait autour de ce malheureux une ribambelle de malfichus."
                            },
                            {
                                "example_id": "313b1c67-f39e-4d3d-8ab9-6f63c6a5f487",
                                "sense_id": "71633156-e69b-3f41-802a-6d91136e0d52",
                                "text": "[…] et sa voix monotone me narrait, avec une complaisance affreuse, la mort, dans le souterrain du palais du gouverneur, de plusieurs familles et d'une ribambelle d’enfants."
                            },
                            {
                                "example_id": "7b0e4e31-b185-4600-87dc-fb32374150c6",
                                "sense_id": "71633156-e69b-3f41-802a-6d91136e0d52",
                                "text": "Lors de cette conférence, on a vu l’ancien maire de New York se présenter au micro pour impliquer dans la fraude électorale qu’il entend démasquer une ribambelle de vilains, allant du dictateur vénézuélien décédé Hugo Chavez à l’incontournable Bonhomme sept-heure de la droite fêlée complotiste, George Soros."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ceccdbb-4b8e-3aaa-9a5c-45946f162f40",
                        "entry_id": "565b7a2c-6c32-31d2-9d9e-422c8af6a66a",
                        "glosses": [
                            "Frise de tapisserie."
                        ],
