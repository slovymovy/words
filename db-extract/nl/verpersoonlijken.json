                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "657804ef-0e30-3406-8609-378f488bd65c",
                                        "entry_id": "b3f58922-b16b-30fc-b06c-ff672c48d0ea",
                                        "glosses": [
                                            "To make an epitome of; to shorten; to condense."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
