{
    "word_family": [
        "trekken",
        "uittrek",
        "uittrekking",
        "uittrekbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ec708b3-8fc4-30a1-bb8e-1defc62e4b5a",
                    "sense_definition": "kledingstukken of schoeisel van het lichaam verwijderen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was erg warm in de kamer, dus hij besloot zijn dikke trui <w>uit te trekken</w>.",
                            "target_lang_translations": {
                                "en": "It was very warm in the room, so he decided to <w>take off</w> his thick sweater."
                            }
                        },
                        {
                            "text": "Vergeet niet je natte schoenen <w>uit te trekken</w> voordat je de woonkamer binnenstapt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>take off</w> your wet shoes before stepping into the living room."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitdoen",
                        "uitkleden"
                    ],
                    "antonyms": [
                        "aantrekken",
                        "aandoen"
                    ],
                    "common_phrases": [
                        "schoenen uittrekken",
                        "jas uittrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove clothing or footwear from the body"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take off",
                                "target_lang_sense_clarification": "clothing or shoes"
                            },
                            {
                                "target_lang_word": "undress",
                                "target_lang_sense_clarification": "to remove all clothes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc8090dd-7ade-3b2c-b4e7-71f536612eff",
                    "sense_definition": "iets met kracht uit een vaste positie of uit een ander object trekken",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tandarts moest helaas een kies <w>uittrekken</w> omdat de ontsteking te erg was.",
                            "target_lang_translations": {
                                "en": "The dentist unfortunately had to <w>pull out</w> a molar because the inflammation was too severe."
                            }
                        },
                        {
                            "text": "Om die kleine splinter <w>uit te trekken</w> kun je het beste een schone pincet gebruiken.",
                            "target_lang_translations": {
                                "en": "To <w>pull out</w> that small splinter, it's best to use clean tweezers."
                            }
                        }
                    ],
                    "synonyms": [
                        "extraheren",
                        "onttrekken"
                    ],
                    "common_phrases": [
                        "een tand uittrekken",
                        "een splinter uittrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "to pull something out of a fixed position or another object with force"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull out",
                                "target_lang_sense_clarification": "general removal with force"
                            },
                            {
                                "target_lang_word": "extract",
                                "target_lang_sense_clarification": "medical or technical removal"
                            },
                            {
                                "target_lang_word": "draw out",
                                "target_lang_sense_clarification": "to pull something out slowly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adce92fb-8a4b-3a39-83a4-a2fb414fc21d",
                    "sense_definition": "een bepaalde hoeveelheid tijd of geld reserveren voor een specifiek doel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reserveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid gaat extra geld <w>uittrekken</w> voor de verbetering van het openbaar vervoer.",
                            "target_lang_translations": {
                                "en": "The government is going to <w>allocate</w> extra money for the improvement of public transport."
                            }
                        },
                        {
                            "text": "We moeten voldoende tijd <w>uittrekken</w> om dit complexe project goed voor te bereiden.",
                            "target_lang_translations": {
                                "en": "We need to <w>set aside</w> enough time to prepare this complex project properly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tijd uittrekken",
                        "geld uittrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "to reserve or allocate a certain amount of time or money for a specific purpose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "allocate",
                                "target_lang_sense_clarification": "funds or resources"
                            },
                            {
                                "target_lang_word": "set aside",
                                "target_lang_sense_clarification": "time or money"
                            },
                            {
                                "target_lang_word": "allow",
                                "target_lang_sense_clarification": "time for a task"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36a58767-67c3-3339-bcec-1e975c0468a3",
                    "sense_definition": "zich in een groep verplaatsen uit een bepaald gebied of land",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verplaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de gewonnen strijd zagen we de soldaten langzaam het verwoeste gebied <w>uittrekken</w>.",
                            "target_lang_translations": {
                                "en": "After the battle was won, we saw the soldiers slowly <w>marching out</w> of the devastated area."
                            }
                        },
                        {
                            "text": "Duizenden vluchtelingen zijn vorig jaar het land <w>uitgetrokken</w> op zoek naar veiligheid.",
                            "target_lang_translations": {
                                "en": "Thousands of refugees <w>moved out</w> of the country last year in search of safety."
                            }
                        }
                    ],
                    "synonyms": [
                        "onttrekken",
                        "uitkleden"
                    ],
                    "common_phrases": [
                        "het land uittrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "to move out of a certain area or country as a group"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "march out",
                                "target_lang_sense_clarification": "military or organized group"
                            },
                            {
                                "target_lang_word": "move out",
                                "target_lang_sense_clarification": "leaving an area"
                            },
                            {
                                "target_lang_word": "depart",
                                "target_lang_sense_clarification": "formal leaving"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67920359-8bf1-36e7-800b-d8450bba9a0d",
                    "sense_definition": "een beknopte samenvatting of overzicht maken van een tekst of informatie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "samenvatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De student heeft de belangrijkste punten uit het dikke boek <w>uitgetrokken</w> voor zijn verslag.",
                            "target_lang_translations": {
                                "en": "The student <w>extracted</w> the most important points from the thick book for his report."
                            }
                        },
                        {
                            "text": "Kun je de kerncijfers uit dit jaarverslag <w>uittrekken</w> voor de presentatie van morgen?",
                            "target_lang_translations": {
                                "en": "Can you <w>extract</w> the key figures from this annual report for tomorrow's presentation?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "een uittreksel maken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a concise summary or overview of a text or information"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extract",
                                "target_lang_sense_clarification": "information or main points"
                            },
                            {
                                "target_lang_word": "summarize",
                                "target_lang_sense_clarification": "to give a brief statement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
