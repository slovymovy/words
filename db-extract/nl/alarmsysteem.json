                    {
                        "sense_id": "0e8cccd5-6dc4-324b-a217-210fa8186b57",
                        "entry_id": "d175bdbc-186d-3a3c-a493-fe66b359b6e3",
                        "glosses": [
                            "een elektronisch systeem dat een alarm geeft bij gevaarlijke gebeurtenissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c308d1-afa1-42b4-893a-ef9b70a65f2d",
                                "sense_id": "0e8cccd5-6dc4-324b-a217-210fa8186b57",
                                "text": "Een alarmsysteem is meestal te vinden in belangrijke gebouwen en soms in woningen of voertuigen."
                            },
                            {
                                "example_id": "c14708c5-7a9a-40f8-8e9b-f6edcfe244fb",
                                "sense_id": "0e8cccd5-6dc4-324b-a217-210fa8186b57",
                                "text": "Je had een gouden ring op een roodfluwelen kussentje in een vitrine zien liggen, maar als je je hand in de vitrine stak om hem te pakken, viel je blik nog net op tijd op het alarmsysteem en trok je hem weer terug."
                            }
                        ]
                    }
