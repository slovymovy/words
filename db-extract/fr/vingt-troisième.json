                ],
                "senses": [
                    {
                        "sense_id": "b9b21465-573e-3c6e-85a7-1d052af6788c",
                        "entry_id": "a7ddc933-4005-3f6f-a433-9f9c75927975",
                        "glosses": [
                            "Adjectif numéral ordinal correspondant au nombre 23. Qui est au rang dont le numéro est vingt-trois (23)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe805ce-81c5-4c42-a867-513076284d2f",
                                "sense_id": "b9b21465-573e-3c6e-85a7-1d052af6788c",
                                "text": "Je dois te dire, Sylvius, où je portai mes pas ce vingt-troisième jour de novembre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebbdf474-6421-48ab-a6b6-2d56362d43c8",
                        "source_entry_id": "a7ddc933-4005-3f6f-a433-9f9c75927975",
                        "source_sense_id": "b9b21465-573e-3c6e-85a7-1d052af6788c",
                        "target_lang_word": "dreiundzwanzigste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreiundzwanzigste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e9517bf-23b7-390a-a327-6b34241672b5",
                                        "entry_id": "f614feab-4a95-357c-ab61-50b1f5e3c38f",
                                        "glosses": [
                                            "nach dem oder der zweiundzwanzigsten kommend; in einer Reihenfolge an Stelle dreiundzwanzig"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f40cda2-91b4-4750-9596-99033ca0d0fd",
                                                "sense_id": "3e9517bf-23b7-390a-a327-6b34241672b5",
                                                "text": "„Die dreiundzwanzigste und le[t]zte Sitzung, die auf den August anberaumt war, kam erst am 7. jenes Monats zu Stande, wiederum unter dem Vorsitz des Papstes.“"
                                            },
                                            {
                                                "example_id": "803606df-f5bb-4803-be89-a88abe4b90b1",
                                                "sense_id": "3e9517bf-23b7-390a-a327-6b34241672b5",
                                                "text": "„… Der dreiundzwanzigste August ist nicht so weit entfernt – und das Komitee, Sorokin, sie sprechen das letzte Wort.“"
                                            },
                                            {
                                                "example_id": "9dacb9f0-5d25-4586-9911-8fbdc707858b",
                                                "sense_id": "3e9517bf-23b7-390a-a327-6b34241672b5",
                                                "text": "„In Ägypten herrschten als zweiundzwanzigste, dreiundzwanzigste und vierundzwanzigste Dynastie von 945 bis 712 die Libyer;“"
                                            },
                                            {
                                                "example_id": "70479507-d358-4eba-8f33-a8a76686ba80",
                                                "sense_id": "3e9517bf-23b7-390a-a327-6b34241672b5",
                                                "text": "„Eine volle Ernte indeß bekommt man erst ein Jahr später, im dreiundzwanzigsten Monat vom Beginn der Pflanzung.“"
                                            },
                                            {
                                                "example_id": "2efe694c-53a1-4605-a071-9de3af2f7440",
                                                "sense_id": "3e9517bf-23b7-390a-a327-6b34241672b5",
                                                "text": "„Der dreiundzwanzigste Baron, der den Titel von seiner Mutter erbte, war über seinen Vater ein Enkel von John Russell, 4. Duke of Bedford.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
