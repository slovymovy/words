{
    "word_family": [
        "climb",
        "climber",
        "climbable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0c4f57c-3a85-3b62-9b8b-e64246242d05",
                    "sense_definition": "Present participle and gerund of <w>climb</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat is <w>climbing</w> the tree in the backyard.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>лезет</w> на дерево на заднем дворе.",
                                "zh": "猫正在后院<w>爬</w>树。"
                            }
                        },
                        {
                            "text": "We are <w>climbing</w> the stairs to get to the roof.",
                            "target_lang_translations": {
                                "ru": "Мы <w>поднимаемся</w> по лестнице, чтобы попасть на крышу.",
                                "zh": "我们正在<w>爬</w>楼梯去屋顶。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола climb.",
                        "zh": "动词 climb 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лезть",
                                "target_lang_sense_clarification": "карабкаться"
                            },
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "с усилием"
                            },
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "двигаться вверх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爬",
                                "target_lang_sense_clarification": "攀爬"
                            },
                            {
                                "target_lang_word": "攀登",
                                "target_lang_sense_clarification": "费力向上"
                            },
                            {
                                "target_lang_word": "上升",
                                "target_lang_sense_clarification": "向上移动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a22b365-a053-37ee-b974-f916496ddc09",
                    "sense_definition": "The sport or activity of ascending mountains, cliffs, or walls, often using ropes and special equipment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rock <w>climbing</w> has become a very popular hobby recently.",
                            "target_lang_translations": {
                                "ru": "<w>Скалолазание</w> в последнее время стало очень популярным хобби.",
                                "zh": "<w>攀岩</w>最近成了一项非常受欢迎的爱好。"
                            }
                        },
                        {
                            "text": "You need proper shoes and a helmet for safe <w>climbing</w>.",
                            "target_lang_translations": {
                                "ru": "Для безопасного <w>лазания</w> нужны подходящая обувь и шлем.",
                                "zh": "为了安全地<w>攀登</w>，你需要合适的鞋子和头盔。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mountaineering"
                    ],
                    "common_phrases": [
                        "rock climbing",
                        "mountain climbing",
                        "ice climbing",
                        "go climbing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спорт или занятие, заключающееся в восхождении на горы, скалы или стены.",
                        "zh": "攀登高山、岩壁或墙壁的运动或活动，通常使用绳索和特殊装备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скалолазание",
                                "target_lang_sense_clarification": "вид спорта"
                            },
                            {
                                "target_lang_word": "альпинизм",
                                "target_lang_sense_clarification": "восхождение в горах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "攀岩",
                                "target_lang_sense_clarification": "体育运动"
                            },
                            {
                                "target_lang_word": "登山",
                                "target_lang_sense_clarification": "攀登高山"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a68b9f7-b81f-31c0-b96f-241aca6b3211",
                    "sense_definition": "The act or process of going upward or ascending.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>climbing</w> of the steep hill left us completely breathless.",
                            "target_lang_translations": {
                                "ru": "<w>Подъем</w> на крутой холм оставил нас совершенно без сил.",
                                "zh": "<w>攀登</w>这座陡峭的山丘让我们气喘吁吁。"
                            }
                        },
                        {
                            "text": "His rapid <w>climbing</w> of the corporate ladder surprised his colleagues.",
                            "target_lang_translations": {
                                "ru": "Его быстрый <w>подъем</w> по карьерной лестнице удивил коллег.",
                                "zh": "他在职场上的迅速<w>晋升</w>让同事们感到惊讶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ascent",
                        "ascension",
                        "rising"
                    ],
                    "antonyms": [
                        "descent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс движения вверх.",
                        "zh": "向上移动或攀登的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "восхождение",
                                "target_lang_sense_clarification": "на вершину"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "攀登",
                                "target_lang_sense_clarification": "过程"
                            },
                            {
                                "target_lang_word": "上升",
                                "target_lang_sense_clarification": "向上移动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6fa306fd-5e38-33ee-9e72-56b290106d98",
                    "sense_definition": "Describing a plant that grows upwards by attaching itself to a support or surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We planted a <w>climbing</w> rose against the garden wall.",
                            "target_lang_translations": {
                                "ru": "Мы посадили <w>плетистую</w> розу у садовой стены.",
                                "zh": "我们在花园墙边种了一株<w>攀援</w>玫瑰。"
                            }
                        },
                        {
                            "text": "Ivy is a vigorous <w>climbing</w> plant that covers old buildings.",
                            "target_lang_translations": {
                                "ru": "Плющ — это мощное <w>вьющееся</w> растение, которое покрывает старые здания.",
                                "zh": "常春藤是一种生命力旺盛的<w>攀援</w>植物，覆盖着古老的建筑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vining",
                        "trailing"
                    ],
                    "common_phrases": [
                        "climbing plant",
                        "climbing rose",
                        "climbing ivy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает растение, которое растет вверх, прикрепляясь к опоре или поверхности.",
                        "zh": "指通过附着在支撑物或表面上向上生长的植物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вьющийся",
                                "target_lang_sense_clarification": "о растениях"
                            },
                            {
                                "target_lang_word": "плетистый",
                                "target_lang_sense_clarification": "о розах и кустарниках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "攀援",
                                "target_lang_sense_clarification": "指植物生长方式"
                            },
                            {
                                "target_lang_word": "藤本",
                                "target_lang_sense_clarification": "指植物类型"
                            }
                        ]
                    }
                }
            ]
        }
    ]
