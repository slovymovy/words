                                        "sense_id": "0ca894a9-b661-3da5-9b8d-6f25cf3c5829",
                                        "entry_id": "96c78416-4c06-3061-a74d-cc205d8953cb",
                                        "glosses": [
                                            "A process in which the particles of a powder are welded together by pressure and heating to a temperature below its melting point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94cdee74-506a-421b-8fe6-3ec43ee51a76",
                                                "sense_id": "0ca894a9-b661-3da5-9b8d-6f25cf3c5829",
                                                "text": "The idea was to build a thick pavement of high-density dry snow, allowing it to \"age-harden\" like concrete. The latter process, technically known as sintering, depends on the progressive formation of intergranular bonds, mainly by temperature-dependent vapor diffusion."
                                            }
                                        ]
                                    }
                                ]
                            }
