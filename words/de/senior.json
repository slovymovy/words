            "senses": [
                {
                    "sense_id": "37b53cca-5a7e-3057-8efe-506812d40e55",
                    "sense_definition": "nachgestellt bei Eigennamen: der Ältere von zwei Personen, meist Vater und Sohn mit gleichem Namen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Herr Schäfer <w>senior</w> gründete die Schreinerei vor mehr als fünfzig Jahren in diesem Dorf."
                        },
                        {
                            "text": "Auf dem Briefkopf stand der Name des Vaters mit dem Zusatz „<w>senior</w>“."
