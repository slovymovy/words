                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bdf96238-f6e8-4145-9f6f-18f94fc4418e",
                        "entry_id": "2e9a3bf1-8862-343a-8d83-b91e3b006cdb",
                        "tags": [
                            "plural"
                        ],
                        "form": "papillotements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "542a4731-2966-3822-9287-c5fec7031d57",
                        "entry_id": "2e9a3bf1-8862-343a-8d83-b91e3b006cdb",
                        "glosses": [
                            "Action de papilloter, effet produit par cela."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb89f2b-1d89-40dc-936b-49c9d71be84a",
                                "sense_id": "542a4731-2966-3822-9287-c5fec7031d57",
                                "text": "C’est un papillotement chromique de jaune, de rose, de noir, et de vert, ainsi qu’une palette tournante, et appartenant tour à tour à Breughel, Steen, Teniers, Goya, Manet et Monticelli."
                            },
                            {
                                "example_id": "4c6a3716-7fea-4ac7-a15b-bdc004ef0fd9",
                                "sense_id": "542a4731-2966-3822-9287-c5fec7031d57",
                                "text": "La rumeur du grenier la pénètre. Ce remugle de foin, de sacs, ce papillotement de couleurs, et cette chaleur du soleil qui filtre en été par les fentes du toit comme une éventail d'or."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca40ad7e-45b1-3b4c-957a-7584cbf52050",
                        "entry_id": "2e9a3bf1-8862-343a-8d83-b91e3b006cdb",
                        "glosses": [
                            "Fluctuation de tension électrique causée par des perturbations électromagnétiques ou par des variations de puissance sur le réseau porteur de cette tension."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9417459-4829-4a4d-88de-018ef267f61f",
                        "source_entry_id": "2e9a3bf1-8862-343a-8d83-b91e3b006cdb",
                        "target_lang_word": "flicker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flicker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c27be8ab-e6d2-3274-80e2-71b9d93a2b5c",
                                        "entry_id": "f1e68afb-2eff-3331-996b-bf24154feb89",
                                        "glosses": [
                                            "An unsteady flash of light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed216bb-3b32-4def-97ce-55165bb4001a",
                                                "sense_id": "c27be8ab-e6d2-3274-80e2-71b9d93a2b5c",
                                                "text": "the flicker of the dying candle"
                                            },
                                            {
                                                "example_id": "140d3791-178a-43e8-b98f-e62e3c07fac0",
                                                "sense_id": "c27be8ab-e6d2-3274-80e2-71b9d93a2b5c",
                                                "text": "the flicker of an old movie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664d3be2-0f15-3ebb-9dbf-6d4e3c74ce29",
                                        "entry_id": "f1e68afb-2eff-3331-996b-bf24154feb89",
                                        "glosses": [
                                            "A short moment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5fd7d6-6a58-466f-b3b0-79bc6957726b",
                                                "sense_id": "664d3be2-0f15-3ebb-9dbf-6d4e3c74ce29",
                                                "text": "a flicker of hope"
                                            },
                                            {
                                                "example_id": "2270e888-e95a-44cc-820d-e65b458e9046",
                                                "sense_id": "664d3be2-0f15-3ebb-9dbf-6d4e3c74ce29",
                                                "text": "a flicker of recognition passed through my mind."
                                            },
                                            {
                                                "example_id": "9499c5d7-7419-4a04-ae0b-221f6a1c4a4c",
                                                "sense_id": "664d3be2-0f15-3ebb-9dbf-6d4e3c74ce29",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flicker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be8a24b7-f40c-3d22-b35f-5dd9499d8889",
                                        "entry_id": "a2bb75fa-48f2-3ea9-bb4d-c91047ac7f34",
                                        "glosses": [
                                            "To burn or shine unsteadily, or with a wavering light."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b5a6ff5-11c6-4090-add7-6460d24b1491",
                                                "sense_id": "be8a24b7-f40c-3d22-b35f-5dd9499d8889",
                                                "text": "The shadows flicker to and fro."
                                            },
                                            {
                                                "example_id": "0b22222a-c095-470e-af01-dae8cd75dad3",
                                                "sense_id": "be8a24b7-f40c-3d22-b35f-5dd9499d8889",
                                                "text": "Long after his cigar burnt bitter, he sat with eyes fixed on the blaze. When the flames at last began to flicker and subside, his lids fluttered, then drooped; but he had lost all reckoning of time when he opened them again to find Miss Erroll in furs and ball-gown kneeling on the hearth and heaping kindling on the coals, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                                        "entry_id": "a2bb75fa-48f2-3ea9-bb4d-c91047ac7f34",
                                        "glosses": [
                                            "To keep going on and off; to appear and disappear for short moments; to flutter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "421bfd9d-4122-4dd2-88a6-435988848217",
                                                "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                                                "text": "A strong desire to smash up everything in the room kept flickering in his head."
                                            },
                                            {
                                                "example_id": "e74afe21-51cb-48ca-8ae5-ad28ea15a43a",
                                                "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                                                "text": "There I lay on one side with a thin and rotten plank between the dead man and me, dazed with the blow to my head, and breathing hard; while the glow of torches as they came down the passage reddened and flickered on the roof above."
                                            },
                                            {
                                                "example_id": "e563c03b-de5a-4e55-aad2-443608df82c9",
                                                "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                                                "text": "The ruddy brick floor smiled up at the smoky ceiling; the oaken settles, shiny with long wear, exchanged cheerful glances with each other; plates on the dresser grinned at pots on the shelf, and the merry firelight flickered and played over everything without distinction."
                                            },
                                            {
                                                "example_id": "d3f11e70-3913-4727-9cfd-52ffc95b521c",
                                                "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                                                "text": "I have seen the moment of my greatness flicker, / And I have seen the eternal Footman hold my coat, and snicker, / And in short, I was afraid."
                                            },
                                            {
                                                "example_id": "55bbe34c-8fe5-4ef8-9814-e570a8469457",
                                                "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                                                "text": "1967, Barry Mason (writer), Tom Jones (performer), Delilah\nI saw the light on the night that I passed by her window / I saw the flickering shadow of love on her blind"
                                            },
                                            {
                                                "example_id": "d6fd47f8-dabc-4066-8d91-4926b45493e0",
                                                "sense_id": "e65abe7a-b892-3cc8-99df-185e2e836730",
                                                "text": "In a city where media companies and hospitals have armed guards, this accessibility is unusual. Inside, drivers sit and chat in between shifts, the overhead fan whirring and causing the dim electric light to flicker over their faces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "549f8cdf-d5ec-3513-bf80-fb167cbb7dae",
                                        "entry_id": "a2bb75fa-48f2-3ea9-bb4d-c91047ac7f34",
                                        "glosses": [
                                            "To flutter or flap."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3adfcb1-75f1-47f1-aa20-773ad20a024a",
                                                "sense_id": "549f8cdf-d5ec-3513-bf80-fb167cbb7dae",
                                                "text": "And flickering on her nest made short essays to sing."
                                            },
                                            {
                                                "example_id": "0c2c20c5-76d3-411e-96fa-e4696043a58b",
                                                "sense_id": "549f8cdf-d5ec-3513-bf80-fb167cbb7dae",
                                                "text": "But the child saw her; was it possible? He turned his head towards her, and flickered his baby hands, and cooed with that indescribable voice that goes to every woman's heart."
                                            }
                                        ]
                                    }
                                ]
                            },
