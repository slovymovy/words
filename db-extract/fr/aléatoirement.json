                "entry_id": "3e955ff2-47ba-381a-a019-c875410e6c38",
                "word": "aléatoirement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7f4e4cf-210f-3ac7-8b83-d952ee64b1fc",
                        "entry_id": "3e955ff2-47ba-381a-a019-c875410e6c38",
                        "glosses": [
                            "D’une manière aléatoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd3805c-69b1-40ec-b2e3-c18ed96c35a6",
                                "sense_id": "e7f4e4cf-210f-3ac7-8b83-d952ee64b1fc",
                                "text": "Comment alors aurait-elle pu aléatoirement transiger sur un legs plus ou moins important, puisqu'il n'y avait ni testament ni legs ?"
                            },
                            {
                                "example_id": "f08f5df0-d076-4a33-8c48-96e87a887f8f",
                                "sense_id": "e7f4e4cf-210f-3ac7-8b83-d952ee64b1fc",
                                "text": "On remarque que l'erreur de mesure se répartit sensiblement aléatoirement sur l'image et que son amplitude est de l'ordre de ± 0,02°C."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0818f319-e7bb-47ea-9952-d41fdb92e69a",
                        "source_entry_id": "3e955ff2-47ba-381a-a019-c875410e6c38",
                        "source_sense_id": "e7f4e4cf-210f-3ac7-8b83-d952ee64b1fc",
                        "target_lang_word": "randomly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "randomly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                                        "entry_id": "8e860b17-ac23-3d8e-bafa-054ad2ba7b7c",
                                        "glosses": [
                                            "In a random manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "705c4769-cfe6-4852-89ca-db421665512d",
                                                "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                                                "text": "It is easy to implement, is not cost-prohibitive, and provides unbiased randomly sampled data in an ethically acceptable manner."
                                            },
                                            {
                                                "example_id": "4959182c-db48-4fad-9039-9a9d3a4c593c",
                                                "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                                                "text": "Every microgame lasts five seconds until it shifts to the next randomly selected ruleset."
                                            },
                                            {
                                                "example_id": "63ec5c8e-1de7-4f9d-aa81-65b24ef0a3f0",
                                                "sense_id": "6fe05d33-8d8f-345f-9d1f-63b0cb626219",
                                                "text": "I just randomly remembered this dream from 2 years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab502c4-92f4-3c76-b042-b07a27cc0074",
                                        "entry_id": "8e860b17-ac23-3d8e-bafa-054ad2ba7b7c",
                                        "glosses": [
                                            "By random access; at any point at a given time; not sequentially."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ccb4bb8-572e-41b0-821b-72e33db71486",
                                                "sense_id": "fab502c4-92f4-3c76-b042-b07a27cc0074",
                                                "text": "When a file is accessed randomly, the programmer must specify the relative record number."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
