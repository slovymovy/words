                    {
                        "translation_id": "ccb18ddc-08bc-48f6-b2b5-9c54a2f19e52",
                        "source_entry_id": "31adeafd-be1e-3760-904f-5443affaecb9",
                        "source_sense_description": "region in Inner Asia",
                        "target_lang_word": "Tibet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tibet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85289f4e-4fd7-3e3e-9b52-f4600d0db0e6",
                                        "entry_id": "f49c8e6f-c368-3bbe-be5d-f5284a503b20",
                                        "glosses": [
                                            "Zone géographique située au nord de l’Himalaya, qu’on appelle le « Toit du monde », formée de hauts plateaux désertiques dominés par de puissantes chaînes de montagnes d’ouest en est."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "520aaab6-d37f-437d-8c28-6023851cf513",
                                                "sense_id": "85289f4e-4fd7-3e3e-9b52-f4600d0db0e6",
                                                "text": "Une série de cinq empreintes de mains et cinq empreintes de pieds préservées dans du calcaire d'eau douce déposé autour d'une source chaude a été découverte près d'un affluent de la rivière Xiong Qu, près du village de Quesang, à environ 80 km au nord-ouest de Lhassa, au Tibet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea7d1aa1-6ac3-3a97-96c3-1b41195f67c9",
                                        "entry_id": "f49c8e6f-c368-3bbe-be5d-f5284a503b20",
                                        "glosses": [
                                            "Région autonome de Chine située dans l’Himalaya, occupant ce territoire."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0b1bfe-39d7-409f-9466-0522937d7cd4",
                                                "sense_id": "ea7d1aa1-6ac3-3a97-96c3-1b41195f67c9",
                                                "text": "Le dalaï-lama venait de quitter son palais du Potala, à Lhassa, à la faveur d’une tempête de sable, et de prendre la fuite avec des moinillons de douze ans et de vieux lamas au souffle perdu, pour échapper aux troupes du général chinois Tan Kuan-san qui envahissaient le Tibet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8b1475-53b3-32e2-a431-440c692c8980",
                                        "entry_id": "f49c8e6f-c368-3bbe-be5d-f5284a503b20",
                                        "glosses": [
                                            "Zone de peuplement des Tibétains correspondant à une aire linguistique où le tibétain est la langue majoritairement utilisée, ainsi qu’à une aire culturelle à la spécificité marquée."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08bae45f-7a5c-468c-84e5-09ea0b3642e8",
                                                "sense_id": "9f8b1475-53b3-32e2-a431-440c692c8980",
                                                "text": "Le bouddhisme lamaïque a créé depuis le XIIIᵉ siècle des liens étroits entre le Tibet et la Mongolie."
                                            },
                                            {
                                                "example_id": "48623cd5-9cc3-4817-9a35-5b1c100ab7b9",
                                                "sense_id": "9f8b1475-53b3-32e2-a431-440c692c8980",
                                                "text": "Peu de chefs religieux bénéficient d’une réputation aussi enviable que celle de Tenzin Gyasto, chef spirituel et temporel du Tibet bouddhiste, qui se fait aussi appeler Sa Sainteté le dalaï-lama."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b19c6db7-3daf-492f-8f58-5f5d9821cb40",
                        "source_entry_id": "31adeafd-be1e-3760-904f-5443affaecb9",
                        "source_sense_description": "region in Inner Asia",
                        "target_lang_word": "Tibet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tibet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df1f39ff-a60c-33fc-aa22-7f598654d53d",
                                        "entry_id": "165cc80f-3733-3f86-8d73-73b44799a9f9",
                                        "glosses": [
                                            "Hochland in Zentralasien"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3b7f32c-8f65-4c75-9090-431e5aa7467a",
                                                "sense_id": "df1f39ff-a60c-33fc-aa22-7f598654d53d",
                                                "text": "„In Tibet herrscht Hochlandklima mit großen Tagestemperaturschwankungen und viel Sonnenschein.“"
                                            },
                                            {
                                                "example_id": "557b8699-bb39-431f-b38c-638d81949cb2",
                                                "sense_id": "df1f39ff-a60c-33fc-aa22-7f598654d53d",
                                                "text": "„Dieser Tage waren Mönche aus dem Tibet mit ihren orangefarbenen Kutten zu Gast in Norddeutschland.“"
                                            },
                                            {
                                                "example_id": "b76c8860-e52c-4728-bce7-f66d8709bc64",
                                                "sense_id": "df1f39ff-a60c-33fc-aa22-7f598654d53d",
                                                "text": "„Er hatte sieben Jahre lang in der Hauptstadt Tibets und in den Zentren des Buddhismus in Bhutan und Nepal studiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "364d423e-5109-3cca-a364-7315a276502e",
                                        "entry_id": "165cc80f-3733-3f86-8d73-73b44799a9f9",
                                        "glosses": [
                                            "Verwaltungseinheit der Volksrepublik China, die etwa die Hälfte des gleichnamigen Hochlands umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a93ebd-a8a3-4936-83ff-2e4725af3257",
                                                "sense_id": "364d423e-5109-3cca-a364-7315a276502e",
                                                "text": "„Nach offiziellen chinesischen Angaben gibt es zurzeit in Tibet wieder über 1700 Stätten für tibetisch-buddhistische Aktivitäten mit etwa 46.000 buddhistischen Mönchen und Nonnen.“"
                                            },
                                            {
                                                "example_id": "bdaa2684-0830-43c7-9ad7-5da3ce397e58",
                                                "sense_id": "364d423e-5109-3cca-a364-7315a276502e",
                                                "text": "„Der Dalai Lama lebt seit 1959 im Exil. Peking wirft ihm vor, auf die Unabhängigkeit Tibets hinzuarbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tibet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef73d47f-46dd-3785-a8a6-981b87a238a4",
                                        "entry_id": "d1c380b6-b84a-3fd9-baf5-b3237fe48be6",
                                        "glosses": [
                                            "Wolle der Tibetziege"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d5b37f-86e7-4c23-a626-00cac890cd47",
                                                "sense_id": "ef73d47f-46dd-3785-a8a6-981b87a238a4",
                                                "text": "Tibet ist Kaschmir und Mohair sehr ähnlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd7f1029-0fb0-3416-a9e1-480de1462ac3",
