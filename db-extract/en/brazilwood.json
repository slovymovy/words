                        "entry_id": "65b6bedf-0ce5-3bd3-9dc9-e6152cdf527b",
                        "glosses": [
                            "The wood of this tree."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d912f74b-f00d-4ba4-addb-eed7bc93d4cb",
                                "sense_id": "c981ece6-8c32-3aa3-968f-6aee034a1a03",
                                "text": "He would take with him red brasilwood from the East Indies – a dye-wood that was so valued that when a few years later the Portuguese found it in the New World, they would name a country after it."
                            }
                        ]
                    }
                ],
                "translations": [
