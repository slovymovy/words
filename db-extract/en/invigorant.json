                        "entry_id": "d025409b-37f9-3b40-bffe-5729cc3a6297",
                        "glosses": [
                            "Something that invigorates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef34e91e-4a07-4c2e-9db8-b66c728f647c",
                                "sense_id": "2edf70d6-0bc8-3287-8356-3de5ccc4c0bc",
                                "text": "CONCENTRATED PHOSOGEN, absolutely pure, the most perfect nervous invigorant in the world, for physicians' and druggists' use, in pound flasks; $5 each, per dozen $40."
                            },
                            {
                                "example_id": "88ade41f-03cf-43f5-a604-50f5683931af",
                                "sense_id": "2edf70d6-0bc8-3287-8356-3de5ccc4c0bc",
                                "text": "Recreation is a soul invigorant, and reinforces and accentuates the best form of rest."
                            },
                            {
                                "example_id": "45acf9e7-897a-4c88-981d-5c5846b5c7d3",
                                "sense_id": "2edf70d6-0bc8-3287-8356-3de5ccc4c0bc",
                                "text": "Religion serves as a guide, as nourishment, as invigorant to good education."
                            },
                            {
                                "example_id": "5a1ac50d-6a7d-48e5-9c1e-f8a24b038d74",
                                "sense_id": "2edf70d6-0bc8-3287-8356-3de5ccc4c0bc",
                                "text": "Our men had set out suddenly and without preparation, and thus the large ration of the enemy, crackers and bacon, was a real invigorant for them."
                            }
                        ]
                    }
                ],
