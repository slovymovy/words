                    },
                    {
                        "translation_id": "3db9113f-c513-44f5-b95b-361139d0f497",
                        "source_entry_id": "fe1af989-4cb8-3cbf-ad19-e7bdbbd29a24",
                        "source_sense_id": "932bc526-8db5-3451-b69b-1cf4341438c1",
                        "target_lang_word": "Maas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                        "entry_id": "a1bbb0fe-eb9e-359b-b4af-bbb48ec6e992",
                                        "glosses": [
                                            "Fluss in Frankreich, Belgien und den Niederlanden"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2f2a6d-d739-4b4f-8b8e-1ca9f8e5d2c1",
                                                "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                                "text": "Die Maas hat eine Länge von 925 km."
                                            },
                                            {
                                                "example_id": "e4919b37-1135-4e95-ac01-a4d99798a4d8",
                                                "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                                "text": "Wir überquerten die Maas."
                                            },
                                            {
                                                "example_id": "85316cdc-ec63-4076-891a-1e7b912b3d56",
                                                "sense_id": "0b46bb8b-9acd-3f9b-a98c-33fd40e33b83",
                                                "text": "Die Kinder versuchten, in der Maas zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                        "entry_id": "27cbf0ae-954b-3fe3-9331-d86da8678e6a",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e011c146-132b-4a21-9f74-e089542a9499",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Frau Maas ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ae7ea15e-323b-4a16-8f7e-b8ed2d543971",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Herr Maas wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "65f98b84-6094-4b6b-a3c6-4e8c0aab440c",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Die Maasens kommen heute aus dem Breisgau."
                                            },
                                            {
                                                "example_id": "07805a3c-7a75-46a7-be7e-004e949de78c",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Der Maas trägt nie die Schals, die die Maas ihm strickt."
                                            },
                                            {
                                                "example_id": "ec5f9ac6-fc8e-4c0b-9061-930e5cf79939",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Maas kommt, geht der Herr Maas.“"
                                            },
                                            {
                                                "example_id": "f5a3b6e9-26ea-4eba-a6c7-37b71e0c4774",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Maas kommt und geht."
                                            },
                                            {
                                                "example_id": "01df8e19-535a-4eda-8053-8d3795cccf1b",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "Maasens kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "bce09a61-f0d7-4fac-93fa-39e648174f29",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "An verregneten Herbsttagen ist Familie Maas liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "05fa8acd-a0d8-4a0e-b7ea-d96da74c9391",
                                                "sense_id": "95f87a56-39a4-3ee6-a75c-91be4f2a6e7c",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Maas das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
