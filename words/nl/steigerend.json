{
    "word_family": [
        "steigeren"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "668de841-0418-33fa-a58f-cf77aa0be266",
                    "sense_definition": "op de achterpoten staand of opgericht (vooral van paarden)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "paard_houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het logo van het bekende automerk toont een zwart <w>steigerend</w> paard op een gele achtergrond.",
                            "target_lang_translations": {
                                "pl": "Logo znanej marki samochodów przedstawia czarnego konia <w>stającego dęba</w> na żółtym tle."
                            }
                        },
                        {
                            "text": "De ruiter probeerde het <w>steigerende</w> dier snel weer onder controle te krijgen.",
                            "target_lang_translations": {
                                "pl": "Jeździec próbował szybko opanować <w>stające dęba</w> zwierzę."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steigerend paard",
                        "steigerende hengst"
                    ],
                    "target_lang_definitions": {
                        "pl": "stojący na tylnych nogach lub wspięty (zwłaszcza o koniu)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stający dęba",
                                "target_lang_sense_clarification": "o koniu unoszącym się na tylnych nogach"
                            },
                            {
                                "target_lang_word": "wspięty",
                                "target_lang_sense_clarification": "heraldycznie lub w pozycji na tylnych nogach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91e7c45d-1ba5-30ab-a4b7-44ca3a3842c7",
                    "sense_definition": "onvoltooid deelwoord van <w>steigeren</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deelwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het paard schrok van het vuurwerk en ging luid briesend en <w>steigerend</w> achteruit.",
                            "target_lang_translations": {
                                "pl": "Koń przestraszył się fajerwerków i zaczął cofać się, głośno parskając i <w>stając dęba</w>."
                            }
                        },
                        {
                            "text": "Zich hevig <w>steigerend</w> probeerde het dier aan de greep van zijn verzorger te ontsnappen.",
                            "target_lang_translations": {
                                "pl": "Gwałtownie <w>stając dęba</w>, zwierzę próbowało wyrwać się z uścisku opiekuna."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "imiesłów przysłówkowy współczesny od czasownika wspinać się / stawać dęba"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stając dęba",
                                "target_lang_sense_clarification": "unosząc się na tylnych kończynach"
                            },
                            {
                                "target_lang_word": "wspinając się",
                                "target_lang_sense_clarification": "o koniu stającym na tylnych nogach"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}