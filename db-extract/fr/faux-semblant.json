        "fr-extract.jsonl": [
            {
                "entry_id": "961791d1-f6d8-34c7-92f4-4f8a06f24084",
                "word": "faux-semblant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "99705ec0-5358-448e-9a22-605203bfb484",
                        "entry_id": "961791d1-f6d8-34c7-92f4-4f8a06f24084",
                        "tags": [
                            "plural"
                        ],
                        "form": "faux-semblants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c5bf1c8-b8cc-3556-84b3-ee06ab32aa23",
                        "entry_id": "961791d1-f6d8-34c7-92f4-4f8a06f24084",
                        "glosses": [
                            "Affectation de sentiments qu’on n’éprouve pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc74cb56-6ccb-4070-a9e9-ea0e81e30ddf",
                                "sense_id": "9c5bf1c8-b8cc-3556-84b3-ee06ab32aa23",
                                "text": "Je ne crois guère à son indignation : ce n’est qu’un faux-semblant."
                            },
                            {
                                "example_id": "82563b43-cc4b-4d07-ad48-5c76eb14f6a1",
                                "sense_id": "9c5bf1c8-b8cc-3556-84b3-ee06ab32aa23",
                                "text": "Pourquoi cette débauche affreusement simple, dépouillée de tout ce qui, d’habitude, lui sert d’excuse, réduite à sa pure horreur, sans ombre de sentiment, sans le moindre faux-semblant de tendresse ?"
                            },
                            {
                                "example_id": "79a60a4a-e54b-45ae-880e-88757631271d",
                                "sense_id": "9c5bf1c8-b8cc-3556-84b3-ee06ab32aa23",
                                "text": "Mais comme le montre l’exemple nazi, le hurlement pseudo-médiéval non seulement ne remplace pas l’analyse rationnelle des causes des difficultés, mais en outre détourne les attentions et les énergies en direction de faux-semblants."
                            }
                        ]
                    },
                    {
                        "sense_id": "919f18e1-3a31-331a-9584-cecffe70e974",
                        "entry_id": "961791d1-f6d8-34c7-92f4-4f8a06f24084",
                        "glosses": [
                            "Apparence trompeuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991ab9b9-e122-4355-a1b2-75c759979b5a",
                                "sense_id": "919f18e1-3a31-331a-9584-cecffe70e974",
                                "text": "La plupart des patronymes se répétaient et se ressemblaient, à croire que ces gens vivaient tous en cousinage. Mais ce n'était qu'un faux-semblant, le postier de Péronville l'avait bien avertie là-dessus. Elle l'entendait encore lui dire :« Ne te trompe surtout pas de destinataires, ma fille,quand tu liras tes enveloppes ! »"
                            },
                            {
                                "example_id": "55d53375-4e47-418a-a2b5-ef5fab075ab6",
                                "sense_id": "919f18e1-3a31-331a-9584-cecffe70e974",
                                "text": "De nouveau il crachinait. Le printemps du dimanche n'avait été qu'un faux-semblant et l'aube du lundi avait ramené les nuages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb248f09-6f47-43d1-bf72-e78328120dc9",
                        "source_entry_id": "961791d1-f6d8-34c7-92f4-4f8a06f24084",
                        "target_lang_word": "Mache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8254034b-e0a5-38e1-a2a6-4d988606ad90",
                                        "entry_id": "2854e2a3-418c-3e55-a05e-42a68166c8d7",
                                        "glosses": [
                                            "übertriebene, unechte Darstellung, um sich selbst wichtig zu machen, um etwas besonders positiv erscheinen zu lassen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d60f2e-cc2e-4ceb-95ad-da76838556f0",
                                                "sense_id": "8254034b-e0a5-38e1-a2a6-4d988606ad90",
                                                "text": "„Die Sprache, der Look, alles nur Mache, um dem Beef-Publikum zu gefallen? Der Verdacht liegt natürlich nahe, als Mauerblümchen geht man in der Welt des Internet-Streamings ja unter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b581b6ff-9425-374e-9fd2-be4110970885",
                                        "entry_id": "2854e2a3-418c-3e55-a05e-42a68166c8d7",
                                        "glosses": [
                                            "Art der Ausführung"
                                        ],
                                        "tags": [
                                            "besonders in Bezug auf eine künstlerische Arbeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3a6e674-6a5a-4666-8d8c-4cec058c0fef",
                                                "sense_id": "b581b6ff-9425-374e-9fd2-be4110970885",
                                                "text": "„Sowohl der erste als auch der zweite Teil dieses Detektivromans … ist in seiner Mache erstklassig und reich an hochspannenden Momenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "436ea474-c79b-45aa-8661-9142403f35e2",
                        "source_entry_id": "961791d1-f6d8-34c7-92f4-4f8a06f24084",
                        "target_lang_word": "Trugbild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trugbild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6893a6b-7290-332e-a863-12b344baa512",
                                        "entry_id": "1f5ce297-962f-35a0-beb5-ee34c0f0026b",
                                        "glosses": [
                                            "Bild/Vorstellung, die etwas nicht Vorhandenes darstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32a4245-9ee1-4205-8fe2-e4454914aec6",
                                                "sense_id": "f6893a6b-7290-332e-a863-12b344baa512",
                                                "text": "„Es war kein Trugbild.“"
                                            },
                                            {
                                                "example_id": "27e5f01e-bd49-4eed-8742-758eb2705b2a",
                                                "sense_id": "f6893a6b-7290-332e-a863-12b344baa512",
                                                "text": "„Schließlich konnten die Dämonen, die sich Pachecos bemächtigt hatten, ja auch seine Sinne verwirren und ihm allerlei Trugbilder vorgaukeln.“"
                                            },
                                            {
                                                "example_id": "5532ebee-21d3-45e5-a73f-deb6c224fbe1",
                                                "sense_id": "f6893a6b-7290-332e-a863-12b344baa512",
                                                "text": "„Als sie hier stand, erschien ihr das andere Leben wie ein Trugbild.“"
                                            },
                                            {
                                                "example_id": "d43f12ab-5702-4c4a-8076-2f9c5825f62d",
                                                "sense_id": "f6893a6b-7290-332e-a863-12b344baa512",
                                                "text": "„Jeder von uns sitzt solchen Zwängen und Trugbildern auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc3c905d-1690-415a-9023-be2068213e7a",
                        "source_entry_id": "961791d1-f6d8-34c7-92f4-4f8a06f24084",
                        "target_lang_word": "pretense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pretense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                        "entry_id": "60b926d9-f71b-3319-8065-e9a297e91a47",
                                        "glosses": [
                                            "The action of pretending; false or simulated show or appearance; false or hypocritical assertion or representation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da619e53-eefa-4e8f-919a-81ffdcb2ab66",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "He visited the king under the pretense of friendliness."
                                            },
                                            {
                                                "example_id": "e0990fad-662e-4308-9aa3-85486840ab03",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "\"Lady Little\", the title that she used, was just a pretense."
                                            },
                                            {
                                                "example_id": "a0c098c4-63a2-4829-9da7-5f9a350388a3",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "She appeared to weep uncontrollably, but it was all pretense."
                                            },
                                            {
                                                "example_id": "2281f7c1-a770-4072-9a9a-b256f4593625",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "Great armaments were, therefore, put on foot in Moravia and Bohemia, while the elector of Saxony, under a pretence of military parade, drew together about ſixteen thouſand men, which were poſted in a ſtrong ſituation at Pirna."
                                            },
                                            {
                                                "example_id": "9fde7b16-497b-4d55-aa0c-0c1bdd45de52",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "The London Saturday Review pays the following well-merited compliment to two American lady authors: “Very few of even our best writers can compass a book for the young which shall be all that it ought to be, avoiding, on the one hand, extravagant sensationality and a standard so high as to be outside human nature altogether; on the other, vapid silliness, which no grown girl can accept as fitting food for her mind at all, and which irritates, as all pretense and make-believe must.[…]”"
                                            },
                                            {
                                                "example_id": "5c345adb-ebb7-4f6f-b3fe-583be2154dca",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy. [...] Passengers wander restlessly about or hurry, with futile energy, from place to place. Pushing men hustle each other at the windows of the purser's office, under pretence of expecting letters or despatching telegrams."
                                            },
                                            {
                                                "example_id": "afbde74b-0001-4681-8bea-05264f0c060c",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "In pilot work we have used the method described in Experiment 2 on children′s memory for the content of their own false beliefs and pretence and asked them to differentiate between belief and pretence."
                                            },
                                            {
                                                "example_id": "724046be-1729-48f3-93d4-210a19a4e571",
                                                "sense_id": "c0d116c2-c131-36ed-979d-5c196099d78f",
                                                "text": "That part of education that turned up in the latest phase of our argument, the cross-examination of the empty pretence of wisdom, is none other, we must declare, than the true-blooded kind of sophistry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f189fc8-570a-3aeb-bde9-9a86ce46a15c",
                                        "entry_id": "60b926d9-f71b-3319-8065-e9a297e91a47",
                                        "glosses": [
                                            "Affectation or ostentation of manner."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb17ac84-93e3-4258-8c68-80d014af686b",
                                                "sense_id": "4f189fc8-570a-3aeb-bde9-9a86ce46a15c",
                                                "text": "She was a plain-speaking woman without a hint of pretense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b548ea0-4db2-3d55-bd79-efa33f4c5616",
                                        "entry_id": "60b926d9-f71b-3319-8065-e9a297e91a47",
                                        "glosses": [
                                            "Intention or purpose not real but professed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76ac465e-e571-4816-971b-f19d61ec235f",
                                                "sense_id": "2b548ea0-4db2-3d55-bd79-efa33f4c5616",
                                                "text": "with only a pretense of accuracy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d57019-6d32-3b71-8ffe-33918b7406ce",
                                        "entry_id": "60b926d9-f71b-3319-8065-e9a297e91a47",
                                        "glosses": [
                                            "An unsupported claim made or implied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d44b402-cd03-4f6b-9229-a6d8e00514b7",
                                                "sense_id": "08d57019-6d32-3b71-8ffe-33918b7406ce",
                                                "text": "He was gentlemanly, steady, tractable, with a thorough knowledge of his duties; and in time, when yet very young, he became chief mate of a fine ship, without ever having been tested by those events of the sea that show in the light of day the inner worth of a man, the edge of his temper, and the fibre of his stuff; that reveal the quality of his resistance and the secret truth of his pretences, not only to others but also to himself."
                                            },
                                            {
                                                "example_id": "8457d60d-ec51-48b2-8c07-552cb9efaa11",
                                                "sense_id": "08d57019-6d32-3b71-8ffe-33918b7406ce",
                                                "text": "They wished to demask hidden metaphysics, to demask the false pretenses of sentences purportively descriptive but de facto metaphysical or evaluative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea389408-962d-38e3-a4e4-7e6c39d96415",
                                        "entry_id": "60b926d9-f71b-3319-8065-e9a297e91a47",
                                        "glosses": [
                                            "An insincere attempt to reach a specific condition or quality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e81b9f92-1c8b-3c74-aa9b-07941d2a00fe",
                                        "entry_id": "60b926d9-f71b-3319-8065-e9a297e91a47",
                                        "glosses": [
                                            "Intention; design."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50c5d7c-3386-48d0-91e2-86d0e827dceb",
                                                "sense_id": "e81b9f92-1c8b-3c74-aa9b-07941d2a00fe",
                                                "text": "A very pretence and purpose of unkindness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
