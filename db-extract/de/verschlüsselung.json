                        ],
                        "form": "die Verschlüsselung"
                    },
                    {
                        "form_id": "3047c322-0921-492a-baee-b6e4c8c7baf9",
                        "entry_id": "8fd1e28e-f533-3111-80e9-8403ee6fbbf4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Verschlüsselungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                        "entry_id": "8fd1e28e-f533-3111-80e9-8403ee6fbbf4",
                        "glosses": [
                            "Umwandlung einer lesbaren Information mittels eines Verfahrens in eine nur mit einem Schlüssel lesbare Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5edf9f47-7a2e-438f-a6d9-e9e1e481ecd8",
                                "sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                                "text": "Mein Netzwerk kommt ohne Verschlüsselung der Client-Authentifizierung aus."
                            },
                            {
                                "example_id": "97dd0adc-e928-4361-a18b-0d929e0eca43",
                                "sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                                "text": "„Dies geschieht durch den Mechanismus der Verschlüsselung; die zugrundeliegende Idee ist, daß nur derjenige, der den geheimen Schlüssel besitzt, die verschlüsselte Nachricht entschlüsseln kann.“"
                            },
                            {
                                "example_id": "4271db45-cecb-4614-8379-15e3334775ca",
                                "sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                                "text": "„Von besonderer Bedeutung war die sichere Verschlüsselung der Nachrichten, denn ein Heer von Abhörspezialisten in allen wichtigen imperialistischen Staaten war - zu Lande und auf Schiffen - mit nichts anderem beschäftigt, als Tag und Nacht auf allen Wellenlängen geheime Funksprüche abzufangen, zu registrieren, den Sendeort durch Funkpeilung festzustellen und aufgefangene Funksprüche an andere Spezialisten weiterzugeben, die in der Entzifferung von verschlüsselten Nachrichten geübt waren."
                            },
                            {
                                "example_id": "5bcdf9b7-a03f-4e6e-9cba-bc4b5cde6b77",
                                "sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                                "text": "„McCormick etwa interessierte sich wohl schon seit Kindertagen für die Verschlüsselung von Texten, war auf diesem Gebiet aber alles andere als ein Profi.“"
                            },
                            {
                                "example_id": "74a7ba67-fc7e-41a2-a09f-d44c5484a469",
                                "sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                                "text": "„Und so begann Amalia mir etwas über Kryptografie, die Wissenschaft von der Verschlüsselung von Informationen, zu erzählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "746675e8-47e0-4a60-a0a2-b43fd3fe911c",
                        "source_entry_id": "8fd1e28e-f533-3111-80e9-8403ee6fbbf4",
                        "source_sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                        "source_sense_description": "Kodierung",
                        "target_lang_word": "encryption",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encryption",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38742777-4eee-38b2-aa00-23befb9953a3",
                                        "entry_id": "8f7171d2-606e-3a63-b186-da6c49ae1977",
                                        "glosses": [
                                            "The process of obscuring information to make it unreadable without special knowledge, key files, or passwords."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a60279ce-6468-402e-8790-7f14e7412f5e",
                                                "sense_id": "38742777-4eee-38b2-aa00-23befb9953a3",
                                                "text": "Fully homomorphic encryption (FHE) is a new encryption technique that enables computing on data blindly, without decrypting it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e928eb-1a01-39da-855d-2049b2b94290",
                                        "entry_id": "8f7171d2-606e-3a63-b186-da6c49ae1977",
                                        "glosses": [
                                            "A ciphertext, a cryptogram, an encrypted value. Usually used with the preposition \\\"of\\\" followed by the value that is hidden in it."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04ffd16d-4d37-4056-a871-c97145cd5fa2",
                                                "sense_id": "88e928eb-1a01-39da-855d-2049b2b94290",
                                                "text": "As ZT() can only test whether a single ciphertext is an encryption of zero, it cannot work when there are more than one ciphertext to test."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0b37431-83fb-4ad2-b4d1-a7879b0438b1",
                        "source_entry_id": "8fd1e28e-f533-3111-80e9-8403ee6fbbf4",
                        "source_sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                        "source_sense_description": "Kodierung",
                        "target_lang_word": "chiffrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiffrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c7ffd0a-efdf-32d2-9c29-125df4009933",
                                        "entry_id": "90b0287d-8df5-308f-bb5b-615962800b11",
                                        "glosses": [
                                            "Procédé utilisé en cryptographie permettant de protéger un document en le rendant incompréhensible à toute personne ne possédant pas la clé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eba174e2-c9df-4c08-9dd3-4bd197bafbe0",
                                                "sense_id": "7c7ffd0a-efdf-32d2-9c29-125df4009933",
                                                "text": "Depuis lors, les clés de chiffrement ont gagné en complexité et sont \"dimensionnées pour être impossibles à résoudre en un temps raisonnable, compte tenu des ressources informatiques et des connaissances mathématiques actuelles\" selon les termes des experts de l’Agence française de sécurité des systèmes d’information (ANSSI)"
                                            },
                                            {
                                                "example_id": "fcd1bb63-5668-4079-9599-5d1361a3536e",
                                                "sense_id": "7c7ffd0a-efdf-32d2-9c29-125df4009933",
                                                "text": "La pratique du chiffrement numérique revêt du reste une valeur mystique chez de nombreux alchimistes versés dans les mystères de la kabbale et spéculant sur les équivalences secrètes unissant les lettres de l’alphabet hébraïque, les nombres, et les mesures et proportions de l’harmonie universelle."
                                            },
                                            {
                                                "example_id": "20e23809-746c-4ce4-80d5-f47aa7ed5e18",
                                                "sense_id": "7c7ffd0a-efdf-32d2-9c29-125df4009933",
                                                "text": "Les autorités et les entreprises technologiques s’affrontent violemment depuis des mois, aux États-Unis principalement, autour de la question du chiffrement."
                                            },
                                            {
                                                "example_id": "0c3357ab-a862-4fad-9847-3a339f419a86",
                                                "sense_id": "7c7ffd0a-efdf-32d2-9c29-125df4009933",
                                                "text": "Le nouveau locataire de la Maison blanche s’était en effet plusieurs fois attaqué à Apple et à Amazon durant la campagne. Et certaines de ses positions – sur les visas de travail, la neutralité du Net ou encore le chiffrement des données – étaient considérées comme de potentiels freins pour la croissance de leur activité."
                                            },
                                            {
                                                "example_id": "4426a5e8-a3b0-49a0-a7c3-b935b75900a8",
                                                "sense_id": "7c7ffd0a-efdf-32d2-9c29-125df4009933",
                                                "text": "Enfin, la cryptographie quantique est une technique de chiffrement sûre. Pour chiffrer un message, il faut mélanger ce dernier avec une série de chiffres, appelée clé. Celle-ci servant également à déchiffrer, elle doit seulement être ­connue des deux personnes désirant échanger confidentiellement."
                                            },
                                            {
                                                "example_id": "da394e67-88a6-42a1-a74e-f94dfcabec5e",
                                                "sense_id": "7c7ffd0a-efdf-32d2-9c29-125df4009933",
                                                "text": "Le chiffrement Trilitère présente une analogie très forte avec l’encodage binaire en électronique, qui convertit les lettres en chiffres, des 0 et des 1."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "592c9186-a427-40ce-b6d4-be5e4570bb2f",
                        "source_entry_id": "8fd1e28e-f533-3111-80e9-8403ee6fbbf4",
                        "source_sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                        "source_sense_description": "Kodierung",
                        "target_lang_word": "cryptage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18bdc7cc-30d6-3d76-870e-aa5ab4ce07bd",
                                        "entry_id": "5bcab1f7-488e-3228-80c5-9829bcb3a94f",
                                        "glosses": [
                                            "Chiffrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "791cd7c0-9d72-4a7c-b0ae-9b1e692743ad",
                                                "sense_id": "18bdc7cc-30d6-3d76-870e-aa5ab4ce07bd",
                                                "text": "Le premier chiffrage (ou cryptage) moderne fut sans doute celui utilisé par Jules César dans les années 50 avant notre ère, le chiffrage par substitution : à chaque lettre de l'alphabet est substituée une autre lettre, […]."
                                            },
                                            {
                                                "example_id": "84748fd4-84c2-4ce1-9ee3-a7cd828fb90b",
                                                "sense_id": "18bdc7cc-30d6-3d76-870e-aa5ab4ce07bd",
                                                "text": "Utilisant pour code personnel des algorithmes beaucoup plus sophistiqués que le matériel standard de cryptage des données, il était en principe impiratable par les superordinateurs du gouvernement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f82ec4f8-935d-3839-8973-671ca7a48ddf",
                                        "entry_id": "5bcab1f7-488e-3228-80c5-9829bcb3a94f",
                                        "glosses": [
                                            "Bahutage à l’École polytechnique."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3e62bd3-f15b-44ab-8711-fdc79c026cee",
                        "source_entry_id": "8fd1e28e-f533-3111-80e9-8403ee6fbbf4",
                        "source_sense_id": "5f4f910b-e14f-32ab-9b79-7327206288e9",
                        "source_sense_description": "Kodierung",
                        "target_lang_word": "chiffrage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiffrage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "583d0d52-5e5f-39ae-bef2-aa3dbe4aa624",
                                        "entry_id": "c81fe55a-c16c-34e8-91d7-4b544b5c7e26",
                                        "glosses": [
                                            "Action d’écrire en chiffre ; cette écriture elle-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "908a5135-4d74-4e48-8d6b-fd1fa86ee135",
                                                "sense_id": "583d0d52-5e5f-39ae-bef2-aa3dbe4aa624",
                                                "text": "Ces nouveaux thermomètres métalliques n'ont point ces graves inconvénients , la division et le chiffrage sont en relief de 2 millim. sur le fond , ils sont d'une telle grandeur qu'ils peuvent être lus à une assez grande distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd97fa8-e49d-3955-8fc8-df42979329b2",
                                        "entry_id": "c81fe55a-c16c-34e8-91d7-4b544b5c7e26",
                                        "glosses": [
                                            "Transcription ou notation de la musique en chiffres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dda169f-f05d-440e-9f88-5984b86e418a",
                                                "sense_id": "1fd97fa8-e49d-3955-8fc8-df42979329b2",
                                                "text": "Dans les premiers temps, l'harmonie étant des plus simples, le chiffrage l'était aussi: toute note de basse était supposée porter l'accord parfait dont l'espèce majeure ou mineure se reconnaissait au moyen du bémol, du bécarre ou du dièze placés devant le chiffre 3, qui servait à désigner la tierce de l'accord; les autres chiffres n'étaient employés que pour indiquer les exceptions, c'est-à-dire les accords de sixte, et les retards de quarte, de septième, etc."
                                            },
                                            {
                                                "example_id": "e0201b7e-e4c5-4eba-a9a1-aad5e3c74e1a",
                                                "sense_id": "1fd97fa8-e49d-3955-8fc8-df42979329b2",
                                                "text": "En musique classique, V⁷₊ est le chiffrage d’un accord de septième de dominante."
                                            },
                                            {
                                                "example_id": "018058b1-0e31-422e-83d1-ee5ba46cf429",
                                                "sense_id": "1fd97fa8-e49d-3955-8fc8-df42979329b2",
                                                "text": "En jazz, Dm7 G7 Cmaj7 est le chiffrage du turnaround de do majeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1d0dab-c467-3263-bcd7-c93ea0e7825d",
                                        "entry_id": "c81fe55a-c16c-34e8-91d7-4b544b5c7e26",
                                        "glosses": [
                                            "Action de chiffrer un document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d5ef85-3b4b-4449-8041-b0beeb0e11a7",
                                                "sense_id": "fc1d0dab-c467-3263-bcd7-c93ea0e7825d",
                                                "text": "Gvozdiline a récupéré dans l'appartement de l'officier des appareils photo Minox, des rouleaux de pellicule, du carbone blanc, des grilles de chiffrage, deux dossiers momentanément soustraits à la bibliothèque confidentielle de l'état-major de l'Armée rouge."
                                            },
                                            {
                                                "example_id": "c0e8565d-4065-46df-a790-ce1ce10e218c",
                                                "sense_id": "fc1d0dab-c467-3263-bcd7-c93ea0e7825d",
                                                "text": "L’algorithme de chiffrage dépend de certains paramètres que l'on appelle clé. La connaissance de la clé permet d'effectuer l’opération inverse, à savoir revenir de l'espace des cryptogrammes à l'espace des messages; cette opération s'appelle déchiffrage."
                                            },
                                            {
                                                "example_id": "edb304a2-739e-41d0-a11c-36d92257761e",
                                                "sense_id": "fc1d0dab-c467-3263-bcd7-c93ea0e7825d",
                                                "text": "La clé du chiffrage doit être gardée secrète au cas où un œil indiscret arriverait à intercepter le message."
                                            },
                                            {
                                                "example_id": "40896184-0822-402d-b693-e453d48d12ed",
                                                "sense_id": "fc1d0dab-c467-3263-bcd7-c93ea0e7825d",
                                                "text": "Le premier chiffrage (ou cryptage) moderne fut sans doute celui utilisé par Jules César dans les années 50 avant notre ère, le chiffrage par substitution : à chaque lettre de l'alphabet est substituée une autre lettre, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e4679e-c7be-34f5-a074-54a6e5514637",
                                        "entry_id": "c81fe55a-c16c-34e8-91d7-4b544b5c7e26",
                                        "glosses": [
                                            "Évaluation financière d'un projet."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d383b66a-4995-45be-86a6-94c1bedd4628",
                                                "sense_id": "58e4679e-c7be-34f5-a074-54a6e5514637",
                                                "text": "De par sa position, le chef de projet peut être amené à établir lui-même le chiffrage d'une prestation. En général, cette action fait suite à la remise d'une consultation sous la forme d'un cahier des charges."
                                            },
                                            {
                                                "example_id": "710b4512-d8a9-488f-a102-b7315da70f43",
                                                "sense_id": "58e4679e-c7be-34f5-a074-54a6e5514637",
                                                "text": "Une fois terminé, le chiffrage doit être communiqué sous la forme d'une note détaillée expliquant chaque poste de dépense.\nCe n'est pas toujours le cas : le chiffrage est quelque fois communiqué brut, dans un mail, sans explication."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
