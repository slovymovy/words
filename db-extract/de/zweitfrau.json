                        "entry_id": "433a4563-5567-3e95-b136-ce55eb7e6ee4",
                        "glosses": [
                            "zweite oder weitere Frau in bigamischen oder polygamen Beziehungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e40e30c0-f58c-4792-bb78-ea48426dc35d",
                                "sense_id": "b60357de-8f65-3fe2-a36a-c3daeb0150bd",
                                "text": "Der Scheich nahm sie zu seiner Zweitfrau."
                            },
                            {
                                "example_id": "1a63c713-8393-4a36-ba9d-a032d9ed529d",
                                "sense_id": "b60357de-8f65-3fe2-a36a-c3daeb0150bd",
                                "text": "„Konnte es sein, dass der auferstandene Mann nur Teile seiner Familie bei uns untergebracht hatte und noch eine Zweitfrau in Sommerfeld und eine Drittfrau in Stuttgart hatte?“"
                            }
                        ],
