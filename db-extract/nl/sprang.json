                ],
                "senses": [
                    {
                        "sense_id": "70784b5c-8b2e-315f-979e-5057cf329569",
                        "entry_id": "afa74ffc-5326-34c5-81d1-a7e19e58e262",
                        "glosses": [
                            "gegraven beken waarmee opwellend water wordt aangevoerd"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "0a02d65c-bc21-4211-8e11-5717ed4453e2",
                                "sense_id": "70784b5c-8b2e-315f-979e-5057cf329569",
                                "text": "Een sprang is een onderaardse waterader die op een bepaalde plek aan de oppervlakte komt."
                            },
                            {
                                "example_id": "4f998afd-761f-4d21-920d-51289ca1a7c7",
                                "sense_id": "70784b5c-8b2e-315f-979e-5057cf329569",
                                "text": "Hier ligt een sprang met diepe win-putten."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1519033-9eae-3bd3-af2c-b19bd368bf05",
                        "entry_id": "afa74ffc-5326-34c5-81d1-a7e19e58e262",
                        "glosses": [
                            "de op een hoge paal geplaatste ijzeren vertakking met daarop de houten vogels die als doelwit dienen"
                        ],
                        "tags": [
                            "vogelschieten"
                        ],
                        "examples": [
                            {
                                "example_id": "ca978fc3-7707-4f06-9f99-e28ef77c5fbb",
                                "sense_id": "b1519033-9eae-3bd3-af2c-b19bd368bf05",
                                "text": "Elke zondagmiddag wordt, 't zij hier 't zij daar, op ‘staande of liggende wip’, buiten of onder dak, met handboog en met pijlen geschoten naar een sprang met hoogvogel, zijvogels en ‘gewone’ vogels."
                            },
                            {
                                "example_id": "e32f8629-056d-40ee-adee-b9fa8ba05afb",
                                "sense_id": "b1519033-9eae-3bd3-af2c-b19bd368bf05",
                                "text": "Op eene kleine weide, die hem toebehoorde, en dicht bij de Lei gelegen was, had hun vader eene sprang laten oprichten, waar zij zich vermaken konden met den gaai te schieten, hetgeen zij dan ook bijna onverpoosd deden, sedert zij in vacantie waren; want thans woonden zij in het College van St.- Barbara te Gent."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b23c406-4aeb-36f8-95b4-4b5ee06caf08",
                        "entry_id": "afa74ffc-5326-34c5-81d1-a7e19e58e262",
                        "glosses": [
                            "ijzeren oog waarmee de vang vastzit aan de vangbalk\\nDe vang is een rond het aswiel gebogen plank of band die via vangbalk wordt aangetrokken om als een rem de molen tot stilstand te brengen."
                        ],
                        "tags": [
                            "molenaarsambacht"
                        ],
                        "examples": [
                            {
                                "example_id": "fbdc3e36-6277-4592-9362-7965b74dee69",
                                "sense_id": "5b23c406-4aeb-36f8-95b4-4b5ee06caf08",
                                "text": "Vang. Reminrichting van de molen, voornamelijk bestaande uit een stalen vangplank (of -band), een ijzeren vanghaak (of -sabel) (waarmee de vangplank aan het vangeinde vastgemaakt is aan een voeghout (oorspronkelijk houten vangsabel)), een sprang (waarmee de vangplank vastgemaakt is aan de vangbalk), een vangbalk, een vangezel, een vangtrommel, een vangtouw, een vangketting, en een keervang."
                            }
                        ]
                    }
