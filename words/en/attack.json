{
    "word_family": [
        "attacker",
        "counter-attack",
        "unattackable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5bdb768e-4417-3510-9480-b2ccb12d68ae",
                    "sense_definition": "To apply violent force to someone or something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_assault",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild animal will only <w>attack</w> if it feels cornered or threatened.",
                            "target_lang_translations": {
                                "ru": "Дикое животное <w>нападет</w> только в том случае, если почувствует себя загнанным в угол или под угрозой."
                            }
                        },
                        {
                            "text": "The enemy forces began to <w>attack</w> the city at dawn.",
                            "target_lang_translations": {
                                "ru": "Вражеские войска начали <w>атаковать</w> город на рассвете."
                            }
                        }
                    ],
                    "synonyms": [
                        "assail",
                        "assault",
                        "strike"
                    ],
                    "antonyms": [
                        "defend"
                    ],
                    "common_phrases": [
                        "attack the enemy",
                        "suddenly attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применять физическую силу к кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "совершать нападение"
                            },
                            {
                                "target_lang_word": "нападать",
                                "target_lang_sense_clarification": "начинать враждебные действия"
                            },
                            {
                                "target_lang_word": "напасть",
                                "target_lang_sense_clarification": "совершить агрессивное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ae3ed9f-7471-33af-a0a1-fc4747b478ab",
                    "sense_definition": "To aggressively challenge a person, idea, or policy with words or criticism.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verbal_assault",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper article <w>attacked</w> the government's new economic policy.",
                            "target_lang_translations": {
                                "ru": "Газетная статья <w>раскритиковала</w> новую экономическую политику правительства."
                            }
                        },
                        {
                            "text": "Opposition leaders continue to <w>attack</w> the proposed changes to the law.",
                            "target_lang_translations": {
                                "ru": "Лидеры оппозиции продолжают <w>нападать</w> на предложенные изменения в законе."
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "impugn"
                    ],
                    "antonyms": [
                        "defend"
                    ],
                    "common_phrases": [
                        "attack a policy",
                        "verbally attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Агрессивно оспаривать чьи-либо идеи, политику или личность с помощью слов или критики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критиковать",
                                "target_lang_sense_clarification": "подчеркивать недостатки"
                            },
                            {
                                "target_lang_word": "нападать",
                                "target_lang_sense_clarification": "обрушиваться с обвинениями"
                            },
                            {
                                "target_lang_word": "напасть",
                                "target_lang_sense_clarification": "приступить с придирками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63decb17-5b3c-3709-9115-ff2246ee5770",
                    "sense_definition": "To deal with a task or problem in a direct and energetic way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "energetic_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should <w>attack</w> the problem from a different angle to find a solution.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>подойти</w> к решению проблемы с другой стороны, чтобы найти выход."
                            }
                        },
                        {
                            "text": "After a short break, she <w>attacked</w> her pile of homework with renewed energy.",
                            "target_lang_translations": {
                                "ru": "После небольшого перерыва она с новыми силами <w>набросилась</w> на гору домашней работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "tackle",
                        "address"
                    ],
                    "common_phrases": [
                        "attack a problem",
                        "attack the task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительно и энергично браться за решение задачи или проблемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взяться",
                                "target_lang_sense_clarification": "энергично приступить к делу"
                            },
                            {
                                "target_lang_word": "наброситься",
                                "target_lang_sense_clarification": "с жаром приняться за что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc826c0-476e-377b-9cd5-926e5fea3e49",
                    "sense_definition": "To begin to affect or damage something, such as a disease affecting a body or a chemical affecting a material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The virus can <w>attack</w> the immune system very quickly.",
                            "target_lang_translations": {
                                "ru": "Вирус может очень быстро <w>поразить</w> иммунную систему."
                            }
                        },
                        {
                            "text": "The acidic rain began to <w>attack</w> the surface of the ancient stone statues.",
                            "target_lang_translations": {
                                "ru": "Кислотный дождь начал <w>разрушать</w> поверхность древних каменных статуй."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrode",
                        "infect"
                    ],
                    "common_phrases": [
                        "attack the body",
                        "attack the surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать воздействовать или разрушать что-либо (о болезни или химическом веществе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "о болезни или вирусе"
                            },
                            {
                                "target_lang_word": "разрушать",
                                "target_lang_sense_clarification": "о химическом воздействии"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "начинать воздействие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47004919-8cb2-3086-b222-e086737680aa",
                    "sense_definition": "An attempt to cause damage, injury, or death to an opponent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_assault",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers prepared for a sudden <w>attack</w> on the fort.",
                            "target_lang_translations": {
                                "ru": "Солдаты готовились к внезапному <w>нападению</w> на форт."
                            }
                        },
                        {
                            "text": "There have been several reports of shark <w>attacks</w> near the coast this summer.",
                            "target_lang_translations": {
                                "ru": "Этим летом поступило несколько сообщений о <w>нападениях</w> акул у побережья."
                            }
                        }
                    ],
                    "synonyms": [
                        "assault",
                        "onslaught"
                    ],
                    "antonyms": [
                        "defend"
                    ],
                    "common_phrases": [
                        "surprise attack",
                        "terrorist attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка нанести ущерб, увечье или смерть противнику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападение",
                                "target_lang_sense_clarification": "стремительное действие с целью вреда"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "тактическое наступление"
                            },
                            {
                                "target_lang_word": "штурм",
                                "target_lang_sense_clarification": "атака укрепленной позиции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58dc6a9c-ed5a-38b2-a788-dbf03ab0d0fb",
                    "sense_definition": "The sudden onset of a disease or medical condition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was rushed to the hospital after suffering a heart <w>attack</w>.",
                            "target_lang_translations": {
                                "ru": "Его срочно доставили в больницу после сердечного <w>приступа</w>."
                            }
                        },
                        {
                            "text": "She had a severe <w>attack</w> of asthma during the exercise.",
                            "target_lang_translations": {
                                "ru": "Во время упражнения у нее случился сильный <w>приступ</w> астмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "seizure",
                        "fit"
                    ],
                    "common_phrases": [
                        "heart attack",
                        "panic attack",
                        "asthma attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное проявление болезни или медицинского состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "обострение болезни"
                            },
                            {
                                "target_lang_word": "припадок",
                                "target_lang_sense_clarification": "острое проявление с судорогами"
                            },
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "внезапный тяжелый недуг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9344790e-7093-3d4e-b4bd-ce51dde73cd1",
                    "sense_definition": "A verbal or written criticism intended to damage someone's reputation or credibility.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verbal_assault",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced a personal <w>attack</w> from his rivals during the debate.",
                            "target_lang_translations": {
                                "ru": "Во время дебатов политик столкнулся с личными <w>нападками</w> со стороны своих соперников."
                            }
                        },
                        {
                            "text": "The editorial was a direct <w>attack</w> on the company's ethics.",
                            "target_lang_translations": {
                                "ru": "Редакционная статья была прямой <w>атакой</w> на этику компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "criticism",
                        "denunciation"
                    ],
                    "common_phrases": [
                        "personal attack",
                        "scathing attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Словесная или письменная критика, направленная на подрыв репутации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпад",
                                "target_lang_sense_clarification": "враждебное выступление"
                            },
                            {
                                "target_lang_word": "нападки",
                                "target_lang_sense_clarification": "серия обвинений"
                            },
                            {
                                "target_lang_word": "критика",
                                "target_lang_sense_clarification": "указание на недостатки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7991f005-830a-3f98-9f6a-7b4cd335d52c",
                    "sense_definition": "An attempt to exploit a vulnerability in a computer system or network.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cyber_security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's website was down due to a cyber <w>attack</w>.",
                            "target_lang_translations": {
                                "ru": "Сайт компании не работал из-за кибер<w>атаки</w>."
                            }
                        },
                        {
                            "text": "A sophisticated hacker <w>attack</w> compromised the bank's security.",
                            "target_lang_translations": {
                                "ru": "Сложная хакерская <w>атака</w> поставила под угрозу безопасность банка."
                            }
                        }
                    ],
                    "synonyms": [
                        "hack",
                        "intrusion"
                    ],
                    "common_phrases": [
                        "cyber attack",
                        "hacker attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Попытка использовать уязвимость в компьютерной системе или сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "кибернетическое воздействие"
                            },
                            {
                                "target_lang_word": "взлом",
                                "target_lang_sense_clarification": "несанкционированный доступ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68207276-5e9e-3067-8d28-3091b08e6e52",
                    "sense_definition": "The amount of time taken for the volume of an audio signal or musical note to reach its maximum level.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "audio_dynamics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The synthesizer allows you to adjust the <w>attack</w> of the sound.",
                            "target_lang_translations": {
                                "ru": "Синтезатор позволяет настраивать <w>атаку</w> звука."
                            }
                        },
                        {
                            "text": "A drum hit has a very fast <w>attack</w> compared to a violin note.",
                            "target_lang_translations": {
                                "ru": "Удар барабана имеет очень быструю <w>атаку</w> по сравнению с нотой скрипки."
                            }
                        }
                    ],
                    "synonyms": [
                        "onset"
                    ],
                    "antonyms": [
                        "decay",
                        "release"
                    ],
                    "common_phrases": [
                        "fast attack",
                        "slow attack"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in music and audio engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Время, за которое громкость аудиосигнала или музыкальной ноты достигает максимума."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "начало музыкального звука"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5cdf3b50-25ed-3385-b532-f2c8d2012a9a",
                    "sense_definition": "Designed or kept for the purpose of confrontation or aggression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aggressive_purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police used an <w>attack</w> dog to catch the fleeing suspect.",
                            "target_lang_translations": {
                                "ru": "Полиция использовала <w>служебную</w> собаку, чтобы поймать убегающего подозреваемого."
                            }
                        },
                        {
                            "text": "The candidate released a controversial <w>attack</w> ad on television.",
                            "target_lang_translations": {
                                "ru": "Кандидат выпустил на телевидении спорный <w>агитационный</w> ролик, направленный против оппонента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "attack dog",
                        "attack ad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для нападения или агрессивного противостояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "атакующий",
                                "target_lang_sense_clarification": "совершающий нападение"
                            },
                            {
                                "target_lang_word": "наступательный",
                                "target_lang_sense_clarification": "связанный с наступлением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}