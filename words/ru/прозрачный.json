{
    "word_family": [
        "прозрачность",
        "прозрачно"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d69fa9e0-e8c1-3b53-bbcf-624e68176815",
                    "sense_definition": "пропускающий свет; такой, сквозь который можно видеть",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_transparency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него было <w>прозрачное</w> стекло в окне.",
                            "target_lang_translations": {
                                "tr": "Penceresinde <w>saydam</w> bir cam vardı."
                            }
                        },
                        {
                            "text": "Вода в этом горном озере очень <w>прозрачная</w>.",
                            "target_lang_translations": {
                                "tr": "Bu dağ gölündeki su çok <w>berrak</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "просвечивающий"
                    ],
                    "antonyms": [
                        "непрозрачный"
                    ],
                    "common_phrases": [
                        "прозрачное стекло",
                        "прозрачная вода"
                    ],
                    "target_lang_definitions": {
                        "tr": "Işığı geçiren, arkası görülebilen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saydam",
                                "target_lang_sense_clarification": "Işığı geçiren, arkası görünen nesneler için kullanılır."
                            },
                            {
                                "target_lang_word": "şeffaf",
                                "target_lang_sense_clarification": "Işığı geçiren, berrak ve net görünen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "017c50f2-4f67-31e4-b23d-09b985406119",
                    "sense_definition": "ясный, дающий возможность далеко видеть",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_transparency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Был <w>прозрачный</w> зимний день с ярким солнцем.",
                            "target_lang_translations": {
                                "tr": "Parlak güneşli, <w>berrak</w> bir kış günüydü."
                            }
                        },
                        {
                            "text": "Воздух после дождя стал очень <w>прозрачным</w>.",
                            "target_lang_translations": {
                                "tr": "Yağmurdan sonra hava çok <w>berrak</w> oldu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "прозрачный воздух"
                    ],
                    "target_lang_definitions": {
                        "tr": "Uzağı görmeye olanak tanıyan, açık ve net (hava, atmosfer)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "berrak",
                                "target_lang_sense_clarification": "Hava veya suyun temiz ve görüşü engellememesi durumu."
                            },
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "Havanın net ve görüşün kısıtlanmadığı durumlar için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "896bdcb6-3f8e-3ca8-947e-ec4b3aa141e0",
                    "sense_definition": "перен. легко воспринимаемый, простой, ясный",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автор изложил свои мысли в <w>прозрачной</w> форме.",
                            "target_lang_translations": {
                                "tr": "Yazar düşüncelerini <w>anlaşılır</w> bir biçimde ifade etti."
                            }
                        },
                        {
                            "text": "У него был <w>прозрачный</w> план действий на будущее.",
                            "target_lang_translations": {
                                "tr": "Gelecek için <w>açık</w> bir eylem planı vardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "прозрачный смысл"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kolayca anlaşılan, açık, net ve basit."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "anlaşılır",
                                "target_lang_sense_clarification": "Karmaşık olmayan, kolay kavranan fikirler için."
                            },
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "Net ve anlaşılır bir ifade tarzı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c412675c-095b-3e30-88e7-a6d1f49ed0ff",
                    "sense_definition": "перен. явный, открытый, незамаскированный",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был <w>прозрачный</w> намек на его ошибку.",
                            "target_lang_translations": {
                                "tr": "Bu, hatasına dair <w>bariz</w> bir imaydı."
                            }
                        },
                        {
                            "text": "Его мотивы были вполне <w>прозрачны</w> для всех окружающих.",
                            "target_lang_translations": {
                                "tr": "Motivasyonları çevresindeki herkes için oldukça <w>açıktı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "прозрачный намек"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gizlenmemiş, bariz, açıkça belli olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bariz",
                                "target_lang_sense_clarification": "Gizlenmeye çalışılmayan, herkesçe fark edilen."
                            },
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "Gizli olmayan, doğrudan ifade edilen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2b3e817-6675-3587-af67-2747d07c8277",
                    "sense_definition": "тонкий, просвечивающий; сквозной, ажурный",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_transparency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На ней было легкое <w>прозрачное</w> платье из шелка.",
                            "target_lang_translations": {
                                "tr": "Üzerinde ipekten, hafif ve <w>ince</w> bir elbise vardı."
                            }
                        },
                        {
                            "text": "Ткань была настолько <w>прозрачной</w>, что все было видно.",
                            "target_lang_translations": {
                                "tr": "Kumaş o kadar <w>inceydi</w> ki her şey görünüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "просвечивающий"
                    ],
                    "common_phrases": [
                        "прозрачная ткань"
                    ],
                    "target_lang_definitions": {
                        "tr": "İnce, içini gösteren (kumaş vb.)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ince",
                                "target_lang_sense_clarification": "Kumaşın dokusunun içini gösterecek kadar ince olması."
                            },
                            {
                                "target_lang_word": "tül gibi",
                                "target_lang_sense_clarification": "Çok ince ve içini gösteren kumaşlar için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "197fc501-9dfc-3b7b-836f-8abe1dad0991",
                    "sense_definition": "обладающий тонкой, просвечивающей кожей",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_transparency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У ребенка была очень бледная и <w>прозрачная</w> кожа.",
                            "target_lang_translations": {
                                "tr": "Çocuğun çok solgun ve <w>ince</w> bir cildi vardı."
                            }
                        },
                        {
                            "text": "Старик имел <w>прозрачные</w> руки с видными венами.",
                            "target_lang_translations": {
                                "tr": "Yaşlı adamın damarları görünen <w>ince</w> elleri vardı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok ince, damarların göründüğü kadar solgun ve hassas cilt."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ince",
                                "target_lang_sense_clarification": "Cildin çok hassas ve damarların görünecek kadar ince olması."
                            },
                            {
                                "target_lang_word": "solgun",
                                "target_lang_sense_clarification": "Sağlıksız veya çok açık renkli, damarlı cilt."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}