                        "examples": [
                            {
                                "example_id": "379709ae-bfe3-4ed1-a2c7-233038fcbb7a",
                                "sense_id": "5ee2c449-646c-3cac-9556-81ea9bd398fd",
                                "text": "Il est probable que la décomposition par la chaleur de l'acide acétique et des composés du même ordre à équivalents plus élevés, étant opérée dans des conditions déshydrogénantes, formera, outre la benzine, toute la série des carbures analogues."
                            },
                            {
                                "example_id": "35cb7444-6fc4-4503-95fa-962c808315dc",
                                "sense_id": "5ee2c449-646c-3cac-9556-81ea9bd398fd",
                                "text": "Il est bien admis à l’heure actuelle, que tout catalyseur hydrogénant est aussi un catalyseur déshydrogénant, que tout catalyseur hydratant est lui-même un catalyseur déshydratant, etc."
                            }
                        ]
