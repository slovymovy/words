                "forms": [],
                "senses": [
                    {
                        "sense_id": "c2941791-1dd0-3647-9365-3f55e7133e92",
                        "entry_id": "dc4cdbcc-c2db-38f7-bf3d-7a8b147b9978",
                        "glosses": [
                            "grain; corn (any cereal)"
                        ],
                        "tags": [
                            "neuter",
                            "no-diminutive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "430fd944-54ac-49b9-a783-d8f62b9501c9",
                                "sense_id": "c2941791-1dd0-3647-9365-3f55e7133e92",
                                "text": "Het veld stond vol met rijpe aren vol met koren.",
                                "translation": "The field was filled with ripe ears full of grain.",
                                "english": "The field was filled with ripe ears full of grain."
                            },
                            {
                                "example_id": "204d1380-85bc-4ee9-9cf1-b48f405777fe",
                                "sense_id": "c2941791-1dd0-3647-9365-3f55e7133e92",
                                "text": "Koren is een belangrijke voedselbron voor mens en dier.",
                                "translation": "Grain is an important food source for humans and animals.",
                                "english": "Grain is an important food source for humans and animals."
                            },
                            {
                                "example_id": "f4da0835-b77c-4139-92d4-11ba09167f4f",
                                "sense_id": "c2941791-1dd0-3647-9365-3f55e7133e92",
                                "text": "In de herfst wordt het koren geoogst.",
                                "translation": "In the autumn, the grain is harvested.",
                                "english": "In the autumn, the grain is harvested."
                            }
                        ]
                    }
                ],
