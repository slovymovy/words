                                "target_senses": [
                                    {
                                        "sense_id": "b96680d3-0f2e-3d4b-b45c-2994d369f75d",
                                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                                        "glosses": [
                                            "One that preserves the peace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66af21ea-6408-48b6-8198-cba63e5b3b7e",
                                                "sense_id": "b96680d3-0f2e-3d4b-b45c-2994d369f75d",
                                                "text": "Roughly 1200 years ago, the turians were invited to join the Citadel Council to fulfill the role of galactic peacekeepers. The turians have the largest fleet in Citadel space, and they make up the single largest portion of the Council's military forces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                                        "glosses": [
                                            "A member of a military force charged with peacekeeping duties in a troublespot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e962c55-8728-4811-97d6-611910fd9aad",
                                                "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                                "text": "The grainy footage showed the peacekeepers first bound and beaten, then hooded and dead, hanging by the neck from a wooden ceiling beam. ."
                                            },
                                            {
                                                "example_id": "7353b710-d615-4155-be1f-2962ca36f5fc",
                                                "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                                "text": "Dozens of NATO peacekeepers were injured after they were attacked by ethnic Serbs in northern Kosovo, during protests over the installation of ethnically Albanian mayors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de1a298f-57e5-3a3c-865e-ac9ef42adc1a",
                                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                                        "glosses": [
                                            "An officer of the peace (police officer) in a force run by a Canadian aboriginal community."
                                        ],
                                        "tags": [
