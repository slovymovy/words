                "forms": [],
                "senses": [
                    {
                        "sense_id": "0841a584-2e42-3ffa-bdb9-397dd401f036",
                        "entry_id": "986ef41d-ed75-307e-aa7e-d56f5da1d0b0",
                        "glosses": [
                            "vragend over wat?, over welk?"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e8e1c2-79be-4482-a79b-118ba53d7954",
                                "sense_id": "0841a584-2e42-3ffa-bdb9-397dd401f036",
                                "text": "Waarover heeft hij het eigenlijk?"
                            }
                        ]
                    },
                    {
                        "sense_id": "09e57606-4ff5-389d-a9c1-aa96274795cf",
                        "entry_id": "986ef41d-ed75-307e-aa7e-d56f5da1d0b0",
                        "glosses": [
                            "betrekkelijk over wat, over hetwelk, dewelke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a451555b-4903-4d7d-bec4-44c1a45b65de",
                                "sense_id": "09e57606-4ff5-389d-a9c1-aa96274795cf",
                                "text": "Dit is de renteverhoging waarover hij het alsmaar had."
                            },
                            {
                                "example_id": "1d193dc4-2427-4739-89d1-38d4a94641d3",
                                "sense_id": "09e57606-4ff5-389d-a9c1-aa96274795cf",
                                "text": "Al mijn energie richtte zich op een bepaalde vraag waarover ik uren kon blijven nadenken om vervolgens een helder antwoord voor mezelf te formuleren."
                            },
                            {
                                "example_id": "0a55663d-1cd4-4eb6-b133-dc9ea014d3b0",
                                "sense_id": "09e57606-4ff5-389d-a9c1-aa96274795cf",
                                "text": "Geen vooruitzicht op kinderen, geen gedeelde nachtelijke geheimen, geen huishouden waarover ik de scepter zwaai - ik ben slechts de baas over een poppenhuis waarin geen enkele levende ziel kan wonen."
                            },
                            {
                                "example_id": "8656ebbc-75bc-47b6-8032-1be91a2f9693",
                                "sense_id": "09e57606-4ff5-389d-a9c1-aa96274795cf",
                                "text": "Thea slaapt nu waarschijnlijk ook ' Maar waar en bij wie Thea slaapt zijn vragen waarover ze beslist niet willen nadenken."
                            }
                        ]
                    }
                ],
