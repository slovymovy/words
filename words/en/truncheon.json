                    "target_lang_definitions": {
                        "nl": "Iemand slaan of afranselen met een wapenstok of knuppel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "knuppelen",
                                "target_lang_sense_clarification": "slaan met een knuppel"
                            },
                            {
                                "target_lang_word": "neerslaan",
                                "target_lang_sense_clarification": "met een wapenstok"
                            }
                        ]
                    }
                }
            ]
        }
    ]
