                        "glosses": [
                            "To saddle again, to put a saddle back on (e.g. a horse)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7624797a-5da4-4516-943c-d4b83c65b5fe",
                                "sense_id": "14c56d99-31fb-3820-a996-7369a5b18f08",
                                "text": "They accept the proffered kerans with a look of bewilderment, as though quite unable to comprehend why I should tender them money, and they lay it carelessly down on the sand while they assist the sowars to resaddle their horses."
                            },
                            {
                                "example_id": "3f59fd39-f31b-4091-8d57-968ccf12529a",
                                "sense_id": "14c56d99-31fb-3820-a996-7369a5b18f08",
                                "text": "The marquis at once agreed to the plan, and Rupert went down into the stable yard, and began to resaddle the horses."
                            }
                        ]
                    }
