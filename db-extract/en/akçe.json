                        "entry_id": "a5addc01-9e7c-33c4-8c2d-26d514002589",
                        "glosses": [
                            "A silver coin minted during the Ottoman Empire, valued at one-third of a para."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ce6be63d-df68-46b2-93a5-51070fa559c9",
                                "sense_id": "d19de7b5-d9d9-3c9e-b3a0-b68a3847701e",
                                "text": "Worth the sum of two thousand two hundred akches, this is all a final gift to the said maiden if he fails to marry her within the appointed period of time."
                            },
                            {
                                "example_id": "76c783b1-26b2-4bbb-a364-6088bc410688",
                                "sense_id": "d19de7b5-d9d9-3c9e-b3a0-b68a3847701e",
                                "text": "The corvée is an archaic feature, absent from later statutes, but the notion that 50 akçes was the rate of compensation due for loss of tithes lingered."
                            }
                        ]
                    }
