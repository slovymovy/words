                        "entry_id": "35c46369-7ed4-3b04-b95e-856c1b691e8d",
                        "glosses": [
                            "ursprünglich in Japan, Ostchina und Korea heimische Hirschart, die seit 1900 auch in Österreich und Deutschland vorkommt und viele Ähnlichkeiten zum Damwild aufweist"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "16e3ff4d-64d0-4a54-b8fb-25275bb4562f",
                                "sense_id": "99a390df-7a41-3b51-952d-902d7f9faa2a",
                                "text": "„Nach Zerstörung der Einzäunung zu Ende des Zweiten Weltkriegs ist das Sikawild in Niederösterreich am Ostrong und in den Tullner Auen Standwild in freier Wildbahn.“"
                            },
                            {
                                "example_id": "768c7290-01b1-4957-896a-19bfecc8db9d",
                                "sense_id": "99a390df-7a41-3b51-952d-902d7f9faa2a",
                                "text": "„In der Größe, Körperform und im Sommerhaar ähnelt das Sikawild sehr dem Damwild, sein Winterhaar ist aber länger und zottig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
