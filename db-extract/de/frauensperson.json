                        ],
                        "form": "die Frauensperson"
                    },
                    {
                        "form_id": "4f546e14-5085-4376-9072-e1b689681027",
                        "entry_id": "4b9f6387-fef6-3a08-a145-f22d75875b66",
                        "tags": [
                            "accusative",
