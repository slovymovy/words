                ],
                "senses": [
                    {
                        "sense_id": "3aa90b47-e466-38e1-87b8-5c9002b71e89",
                        "entry_id": "934dc492-41fe-38b2-970a-e82547713464",
                        "glosses": [
                            "Laufband, dessen Lauffläche aus einzelnen, miteinander verbundenen Lamellen (schmalen, beweglichen Platten) besteht"
                        ],
                        "tags": [
                            "Laufsport",
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "8c8740ba-2925-4507-af78-ed38bc1e3a1c",
                                "sense_id": "3aa90b47-e466-38e1-87b8-5c9002b71e89",
                                "text": "„Zur Ausstattung gehören darüber hinaus ein überbreites, ebenerdiges Lamellenlaufband (Woodway) sowie ein Ruderergometer.“"
                            },
                            {
                                "example_id": "cd321bd1-97ac-4fec-903d-8f00cb272854",
                                "sense_id": "3aa90b47-e466-38e1-87b8-5c9002b71e89",
                                "text": "„Der Individuelle Laktatstufentest (Ausbelastungstest) wird mittels Laktat Scout4 Handmessgerät mit Teststreifen auf einem Sprintex Lamellenlaufband durchgeführt.“"
                            },
                            {
                                "example_id": "0aaa215e-72fc-476b-a424-bfca53546d88",
                                "sense_id": "3aa90b47-e466-38e1-87b8-5c9002b71e89",
                                "text": "„Das bogenförmige Design ist der Höhepunkt der langjährigen Entwicklung eines nichtmotorisierten Lamellenlaufbandes.“"
                            },
                            {
                                "example_id": "9269d916-6de6-4c85-8275-eded3e16d496",
                                "sense_id": "3aa90b47-e466-38e1-87b8-5c9002b71e89",
                                "text": "„WOODWAY Lamellenlaufbänder sind so hochwertig gebaut und langlebig, dass schätzungsweise 95% aller Laufbänder, die in den letzten 20 Jahren gebaut wurden, immer noch im Einsatz sind.“"
                            },
                            {
                                "example_id": "8db54058-6ba0-4694-a2bd-f44130ab6392",
                                "sense_id": "3aa90b47-e466-38e1-87b8-5c9002b71e89",
                                "text": "„Die Laufbandanalyse im Sensomotorikzentrum Frankfurt beinhaltet je nach gewählter Option eine Untersuchung von Fuß, Knie, Beinachse, Becken und Rücken auf dem Lamellenlaufband.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
