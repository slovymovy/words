                ],
                "senses": [
                    {
                        "sense_id": "9094f1a9-75ec-3398-80af-c6585a7b6296",
                        "entry_id": "18559c68-0907-3501-9561-63b09e962537",
                        "glosses": [
                            "veel en hoge eisen stellend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9aebc9d-2d88-49fe-a752-ec27434226c7",
                                "sense_id": "9094f1a9-75ec-3398-80af-c6585a7b6296",
                                "text": "Werknemers zijn over het algemeen veeleisender geworden, onder meer door de toename van het jobaanbod."
                            },
                            {
                                "example_id": "79800294-4ab4-4791-a69d-17670310da6c",
                                "sense_id": "9094f1a9-75ec-3398-80af-c6585a7b6296",
                                "text": "Ze was niet veeleisend wat betreft hun kwaliteit of herkomst. Ze had foto's van Clemenceau, Maurras, Poincaré, Jaurès, Joffre, Briand... Sinds ze haar man had verloren, die het bevel voerde over een groep geniformeerde suppoosten in het Musée du Louvre, bezorgden grote mannen haar heftige sensaties."
                            }
                        ]
                    }
