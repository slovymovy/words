                        {
                            "text": "A <w>nuke</w> based on made-up reasons can be undone with an un-nuke.",
                            "target_lang_translations": {
                                "ru": "<w>Нюк</w>, основанный на выдуманных причинах, можно отменить с помощью ан-нюка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in file-sharing and warez communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предупреждающая метка на цифровом релизе, обозначающая его как некачественный или недействительный."
