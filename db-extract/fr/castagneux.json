                        "examples": [
                            {
                                "example_id": "97aec325-b343-41d4-9edf-71540aea1d1c",
                                "sense_id": "8e044563-75be-33e7-8cef-fdf9aafb2d93",
                                "text": "Le castagneux est un grèbe beaucoup moins grand que tous les autres."
                            },
                            {
                                "example_id": "41dea717-764b-4dce-845b-94d08bb9280b",
                                "sense_id": "8e044563-75be-33e7-8cef-fdf9aafb2d93",
                                "text": "J’ai acheté un canard sauvage mâle, un nyroca (anas leucophthalmos) mâle et un castagneux mâle vieux à gorge rousse."
                            },
                            {
                                "example_id": "d1fcea18-9377-4a5b-8ddc-2245e2cd7680",
                                "sense_id": "8e044563-75be-33e7-8cef-fdf9aafb2d93",
                                "text": "Le castagneux fréquente tout plan d'eau douce, même de faible surface, les rivières au cours lent, envahis et ceinturés ou bordés par la végétation."
                            }
                        ]
