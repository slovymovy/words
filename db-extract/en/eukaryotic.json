                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eukaryoot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "228e854a-632c-3531-a5e6-c60c46d70c7a",
                                        "entry_id": "be8debd4-2899-36c9-a371-df5257f27b5b",
                                        "glosses": [
                                            "met cellen die een celkern hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed6c3ee2-6d90-466a-8fa8-2d7f1d636d0d",
                                                "sense_id": "228e854a-632c-3531-a5e6-c60c46d70c7a",
                                                "text": "Al het moderne leven is óf prokaryoot, óf eukaryoot."
                                            },
                                            {
                                                "example_id": "23460552-d6b0-4f72-83b0-84b3a79a087e",
                                                "sense_id": "228e854a-632c-3531-a5e6-c60c46d70c7a",
                                                "text": "Dezelfde groep heeft nu eveneens de kristalstructuur van het proteasoom van een eukaryoot organisme (cellen hebben kern met daarin het erfelijk materiaal) opgehelderd: van de gist Saccharomyces cerevisiae (Nature, 3 april)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eukaryoot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ec09cee2-ed62-3d2e-b06d-d96253c5ffec",
                                        "entry_id": "95f82e2c-2567-3c82-a134-1df50bdc0b73",
                                        "glosses": [
                                            "levensvorm met cellen die een celkern hebben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3850dc50-65c3-4ec7-897d-fd1a64c60fc3",
                                                "sense_id": "ec09cee2-ed62-3d2e-b06d-d96253c5ffec",
                                                "text": "Dit nieuwe organisme, de eerste eukaryoot, kon door zijn gespecialiseerde, zuurstofafhankelijke ademhaling ineens veel meer energie genereren, waardoor hij een concurrentievoordeel kreeg. Uit deze eukaryoot ontwikkelden zich alle meercelligen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56c0f69a-d97a-4dec-9813-bf2090279008",
                        "source_entry_id": "c07a116d-65bd-3469-829a-55f35389de9e",
                        "source_sense_description": "having complex cells",
                        "target_lang_word": "eukaryotisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4f6790b0-98bb-4d13-baa4-05c9c1572c19",
                        "source_entry_id": "c07a116d-65bd-3469-829a-55f35389de9e",
                        "source_sense_description": "having complex cells",
                        "target_lang_word": "eucaryote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eucaryote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7c6ca8-287a-34d9-b5af-67d338dd3112",
                                        "entry_id": "476408e5-27f9-3ed6-b2e2-2fa955e36a35",
                                        "glosses": [
                                            "Se dit d’une cellule dont les chromosomes sont inclus dans un noyau séparé du cytoplasme par une membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b7a6cd-5618-4863-b0f4-831c56700907",
                                                "sense_id": "7a7c6ca8-287a-34d9-b5af-67d338dd3112",
                                                "text": "Les protistes eucaryotes."
                                            },
                                            {
                                                "example_id": "6efdac5b-81db-4b13-9544-a3ca6026b9b7",
                                                "sense_id": "7a7c6ca8-287a-34d9-b5af-67d338dd3112",
                                                "text": "Les gènes eucaryotes sont exprimés différemment de ceux des bactéries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eucaryote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                        "entry_id": "b7cec5cd-8280-3390-a8ef-7304e6831e65",
                                        "glosses": [
                                            "Organisme vivant caractérisé par le fait que la majorité du matériel génétique cellulaire est contenu dans un noyau constitué par une enveloppe nucléaire (un « vrai noyau »), par opposition aux procaryotes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd92961-6897-4b62-a561-ad4894abbf29",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Champignons et levures sont aussi des organismes pluricellulaires eucaryotes."
                                            },
                                            {
                                                "example_id": "e3e616b8-5a52-414f-823b-3062bed82b30",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Les eucaryotes apparaissent il y a 1 à 1,5 milliards d'années, pour bientôt se diviser en deux règnes : végétal et animal."
                                            },
                                            {
                                                "example_id": "f7351a27-306b-40a9-b5ea-67f4c72fd6e6",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Les algues vertes, donc, font partie, de par leur système de reproduction, du groupe des eucaryotes. Leurs organes reproducteurs sont formés de sporocystes et/ou de gamétocystes."
                                            },
                                            {
                                                "example_id": "fe0ed20f-bc09-4323-b20d-2f69cf66764f",
                                                "sense_id": "ba3c279a-7efa-34ac-a508-0500312c88d0",
                                                "text": "Sans compter que le modèle proposé par Patrick Forterre ne prétend pas que l’ancêtre tant recherché était exactement un eucaryote (ceux-ci ont évolués depuis), mais seulement qu’il avait un génome semblable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
