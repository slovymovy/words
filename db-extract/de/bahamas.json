                                                "example_id": "61bd0398-f3b2-4348-9252-4a485620220d",
                                                "sense_id": "35a06307-625c-3bb2-9e51-916f0cc3b2e0",
                                                "text": "Elle va aux Bahamas."
                                            },
                                            {
                                                "example_id": "e9b3719d-378c-45a2-b2ca-24b09c29ae84",
                                                "sense_id": "35a06307-625c-3bb2-9e51-916f0cc3b2e0",
                                                "text": "Au siècle dernier, un naufrage jetait un Français, Henri Gaullieur, sur les bancs de sable à fleur d’eau que sont les îles Caïques, dans l’archipel des Bahamas."
                                            }
