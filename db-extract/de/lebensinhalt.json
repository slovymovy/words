                ],
                "senses": [
                    {
                        "sense_id": "64d74910-a84e-3466-a854-6813b2c56f11",
                        "entry_id": "4cd52b8b-4bbd-3a5d-9eee-34ad67d5470e",
                        "glosses": [
                            "Gesamtheit dessen, was eine Person in ihrem Leben umtreibt, immer wieder beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0726e2d-9ba5-449f-a3f8-df51164f793d",
                                "sense_id": "64d74910-a84e-3466-a854-6813b2c56f11",
                                "text": "„Und plötzlich nun das Gegenteil davon in Berlin, wo Berührungen jeder Art, unaufhörliche, zum eigentlichen Lebensinhalt geworden waren.“"
                            },
                            {
                                "example_id": "fe0c7010-69df-499e-b2af-25adda778ed5",
                                "sense_id": "64d74910-a84e-3466-a854-6813b2c56f11",
                                "text": "„Die Arbeit im Kontor stellte jedoch nicht den wichtigsten Lebensinhalt des jungen Mannes da: Denn mehr noch verstand er sich als Dichter.“"
                            },
                            {
                                "example_id": "c2a24d9b-2c1c-40e7-a9ea-5bad5eea7820",
                                "sense_id": "64d74910-a84e-3466-a854-6813b2c56f11",
                                "text": "„Dann fing ich an, die Pferde zum Lebensinhalt zu erklären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
