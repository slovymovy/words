    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a993077c-b410-3342-982b-a5e71f646347",
                    "sense_definition": "Designed to be prepared very quickly and easily, usually by adding liquid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually drink <w>instant</w> coffee when I am in a hurry.",
                            "target_lang_translations": {
                                "ru": "Я обычно пью <w>растворимый</w> кофе, когда спешу.",
                                "de": "Normalerweise trinke ich <w>löslichen</w> Kaffee, wenn ich es eilig habe.",
                                "pl": "Zazwyczaj piję kawę <w>rozpuszczalną</w>, kiedy się spieszę.",
                                "tr": "Acelem olduğunda genellikle <w>hazır</w> kahve içerim.",
                                "zh": "我赶时间的时候通常喝<w>速溶</w>咖啡。"
                            }
                        },
                        {
                            "text": "Students often eat <w>instant</w> noodles because they are cheap and easy to make.",
                            "target_lang_translations": {
                                "ru": "Студенты часто едят лапшу <w>быстрого приготовления</w>, потому что она дешевая и ее легко готовить.",
                                "de": "Studenten essen oft <w>Instant</w>-Nudeln, weil sie billig und einfach zuzubereiten sind.",
                                "pl": "Studenci często jedzą makaron <w>błyskawiczny</w>, ponieważ jest tani i łatwy w przygotowaniu.",
                                "tr": "Öğrenciler ucuz ve yapımı kolay olduğu için sık sık <w>hazır</w> makarna yerler.",
                                "zh": "学生们经常吃<w>方便</w>面，因为它们便宜又好做。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "instant coffee",
                        "instant noodles",
                        "instant soup",
                        "instant mashed potato"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для очень быстрого и легкого приготовления, обычно путем добавления жидкости.",
                        "de": "So konzipiert, dass es sehr schnell und einfach zubereitet werden kann, meist durch Zugabe von Flüssigkeit.",
                        "pl": "Przeznaczony do bardzo szybkiego i łatwego przygotowania, zazwyczaj poprzez dodanie płynu.",
                        "tr": "Genellikle sıvı eklenerek çok hızlı ve kolay bir şekilde hazırlanmak üzere tasarlanmış.",
                        "zh": "指为了快速方便地准备而设计，通常只需加入液体即可食用的食品或饮料。"
                    },
                    "translations": {
                        "ru": [
