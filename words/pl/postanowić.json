                    "sense_definition": "podjąć decyzję o zrobieniu czegoś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decyzja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długiej rozmowie z rodzicami <w>postanowiłem</w> zmienić kierunek studiów.",
                            "target_lang_translations": {
                                "en": "After a long talk with my parents, I <w>decided</w> to change my field of study."
                            }
                        },
                        {
                            "text": "Wspólnie <w>postanowiliśmy</w> spędzić tegoroczne wakacje nad polskim morzem.",
                            "target_lang_translations": {
                                "en": "Together, we <w>decided</w> to spend this year's vacation at the Polish seaside."
                            }
                        }
                    ],
                    "synonyms": [
