                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab51e8a5-7546-4eed-b18b-396d74ae0f67",
                                                "sense_id": "fc2ee7c1-95c4-3e92-a756-9da56e1f722a",
                                                "text": "Le train régional hybride bibi est conçu pour rouler sur des voies ferroviaires électrifiées ou non et recevoir des tensions électriques différentes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bibi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aad0cc22-ec01-3145-ae51-774540013555",
                                        "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                                        "glosses": [
                                            "Petit chapeau de dame."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c4816ee-80a0-40d5-abf8-385549c5b3f6",
                                                "sense_id": "aad0cc22-ec01-3145-ae51-774540013555",
                                                "text": "Son bibi de satin rose, à passe très étroite, posé si en avant, et, comme elle disait, à la chien, descendait presque jusqu’au bout de son petit nez."
                                            },
                                            {
                                                "example_id": "21ff8ac5-cb31-4c15-9e05-f77bdad77c56",
                                                "sense_id": "aad0cc22-ec01-3145-ae51-774540013555",
                                                "text": "Sous le règne de Louis-Philippe, les monstrueux chapeaux de dames furent remplacés par les bibis microscopiques."
                                            },
                                            {
                                                "example_id": "4faf2170-e120-4fc6-8cdc-f3ed688cd8e3",
                                                "sense_id": "aad0cc22-ec01-3145-ae51-774540013555",
                                                "text": "Donc, trouver une bonne raison d’ôter le vilain bibi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b86a4305-6b64-3185-a97c-740106398d97",
                                        "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                                        "glosses": [
                                            "Bibelot, objet de petite taille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af606078-0884-39bb-8bff-433b2ee05ef2",
                                        "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                                        "glosses": [
                                            "Bibelot, objet de petite taille.",
                                            "Couteau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4affc7-c911-4130-891b-8397f07af770",
                                                "sense_id": "af606078-0884-39bb-8bff-433b2ee05ef2",
                                                "text": "Devant le blave à ressort, remise Bibi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25589bff-ba64-35f0-9c65-6ed297f031c9",
                                        "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                                        "glosses": [
                                            "Bibelot, objet de petite taille.",
                                            "Pince."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdd624cc-e3bb-400f-903a-3979da0ad3d5",
                                                "sense_id": "25589bff-ba64-35f0-9c65-6ed297f031c9",
                                                "text": "Pour s’en tenir à la réponse relatée par Hortein, … bibi, désignant une pince monseigneur aussi bien qu’une fausse clef, signifie outil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63e0465-13e7-3edc-892e-6e1c0eb5cb81",
                                        "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                                        "glosses": [
                                            "Bibelot, objet de petite taille.",
                                            "Appât pour la pêche, siponcle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc9d324d-d84f-3c85-82d2-bea1c484b960",
                                        "entry_id": "50a6bd9e-c2c0-3ab5-ab63-55400108467d",
                                        "glosses": [
                                            "Biberon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0cdbcad-5fab-487c-ab39-7022644c23de",
                                                "sense_id": "cc9d324d-d84f-3c85-82d2-bea1c484b960",
                                                "text": "Le gamin réclamait son bibi toute la journée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bibi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5412d9-5b15-390c-a661-69eb581c705d",
                                        "entry_id": "6ad8bf0a-1655-3d2d-9415-afbfbcac8cdf",
                                        "glosses": [
                                            "Femme de chambre, domestique, employée de maison, souvent originaire d’Inde."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1761d036-1ded-4ea9-a693-ccfc19f6cb4e",
                                                "sense_id": "fa5412d9-5b15-390c-a661-69eb581c705d",
                                                "text": "Le lendemain du décès de mon cher Mécene, notre auguste Impératrice me fit dire par une bibi sa chambre,…."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f1450c-6e58-3b98-9236-50f6df7a74ec",
                                        "entry_id": "6ad8bf0a-1655-3d2d-9415-afbfbcac8cdf",
                                        "glosses": [
                                            "Femme d’origine indienne."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "offensive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bibi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                        "entry_id": "6564b9db-129d-37fd-b541-d448c557e218",
                                        "glosses": [
                                            "Moi."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89ebda1c-d0d4-4cfb-b980-003bc4f652ae",
                                                "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                                "text": "— Alors, vous ne viendrez point ? …\n— Jamais de la vie ! Aller exposer Bibi sans qu’on sache de quoi il retourne ? Vous n’y pensez pas, mon petit !"
                                            },
                                            {
                                                "example_id": "a00ee5ba-f38a-48d1-ad44-3c470acf1d51",
                                                "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                                "text": "Hein ! c’est ingénieux… Une idée à Bibi ça…"
                                            },
                                            {
                                                "example_id": "3fdfac23-8082-4406-a56d-b86659a3f79b",
                                                "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                                "text": "« Ces messieurs sont des juges. Ils viennent arrêter le voyageur du 7. Le voyageur du 7 est un assassin anarchiste. Les assassins anarchistes portent sur eux quatre revolvers à chargeurs et deux cents cartouches blindées. Il y aura sûrement une cartouche blindée pour la peau de bibi. »"
                                            },
                                            {
                                                "example_id": "757ef448-9eb2-4170-bc9c-23153fffcc50",
                                                "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                                "text": "Ça, mon vieux, c’est de l’or ; et je compte pas le temps de l’éducation, le premier bénéfice et l’agréable pour bibi à s’envoyer en douce les premiers coups."
                                            },
                                            {
                                                "example_id": "041806ed-a7b9-4171-ba88-83d57e0bf611",
                                                "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                                "text": "Qui c’est qui aura les ennuis? C’est bibi…"
                                            },
                                            {
                                                "example_id": "86e59230-71f4-4202-9ce1-8c1522eaf59b",
                                                "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                                "text": "La surprise c’est pour lui, mais le chocolat c’est pour bibi."
                                            },
                                            {
                                                "example_id": "9f66db4a-081e-4999-bee7-895064358ba1",
                                                "sense_id": "c2650829-9731-343e-a7ce-2fb5d6d50a26",
                                                "text": "Motus minus. Le génie, c’est bibi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bibi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b18f2dcc-9e65-318a-b1d4-8cdd775eb6ad",
                                        "entry_id": "d60f9466-0735-32a4-b7bf-489d2298e12c",
                                        "glosses": [
                                            "Bicraver, vendre, dealer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce79dcae-a3d4-49eb-8bcd-a3880c4794e8",
                                                "sense_id": "b18f2dcc-9e65-318a-b1d4-8cdd775eb6ad",
                                                "text": "Bibi d’la patate aux p’tits fils de bourges"
                                            },
                                            {
                                                "example_id": "78431717-1dd5-4b6e-acce-461214b3a483",
                                                "sense_id": "b18f2dcc-9e65-318a-b1d4-8cdd775eb6ad",
                                                "text": "Tu sais les miens bibi aussi, élevés sous des pluies acides"
                                            },
                                            {
                                                "example_id": "72d14917-eaed-497e-aa22-58c2727308c7",
                                                "sense_id": "b18f2dcc-9e65-318a-b1d4-8cdd775eb6ad",
                                                "text": "Elle la coupe et j’la bibi comme Big Meech"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72962262-3b08-4734-a721-eaa23d91adf2",
                        "source_entry_id": "6abfd9c3-0c7e-3fab-a312-0f3f8c06bc98",
                        "source_sense_description": "fool or idiot",
                        "target_lang_word": "Dummkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dummkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                        "entry_id": "b5ab529b-6045-333b-aa6e-fa5857841d8c",
                                        "glosses": [
                                            "dummer Mensch"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d766c218-9b4a-4a95-853b-f7216bb29309",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "Ich Dummkopf, dass ich die Schule abgebrochen habe!"
                                            },
                                            {
                                                "example_id": "cb12cc2a-833e-42e8-a38d-781479c290dd",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Nur Dummköpfe verlangen von euch, dass ihr eure Herkunft, eure Sprache und euren Glauben verleugnet.“"
                                            },
                                            {
                                                "example_id": "b0e128b8-38e9-4cbc-a6e9-ae178e29b143",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Heinrich Cuno ist ein unwissender Dummkopf, der sich vor Eitelkeit aufbläht.“"
                                            },
                                            {
                                                "example_id": "e24fcf47-41f7-4619-b127-a7ab3bd367c5",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Er war ein Dummkopf mit dem Verstand eines Hanswurstes und hielt alle, sie ihm zuhörten, für noch einfältiger.“"
                                            },
                                            {
                                                "example_id": "eb90df82-e3cd-4b6f-acf7-0cc6367134f7",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Ich muß an jener Frau wohl doch leidenschaftlicher gehangen haben, als ich selber wußte; sonst würde es mir nicht so schwerfallen, zuzugeben, daß jener Dummkopf sie geliebt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c41b45ba-a417-44b3-8a15-5cf8066dd76a",
                        "source_entry_id": "6abfd9c3-0c7e-3fab-a312-0f3f8c06bc98",
                        "source_sense_description": "fool or idiot",
                        "target_lang_word": "Idiot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idiot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                        "entry_id": "92619ca5-9602-3bbf-a589-6af92f40b52f",
                                        "glosses": [
                                            "ein vermeintlich dummer, wenig intelligenter, unwissender Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da56600-cf6a-46e8-92f6-f5a930b1c196",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "„Du wärst wirklich ein Idiot, wenn du so einen dummen Fehler machen würdest.“"
                                            },
                                            {
                                                "example_id": "36c7a8a1-c633-4d2c-8705-112610d4e4c1",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "Und ich Idiot bezahle noch die erste Rate."
                                            },
                                            {
                                                "example_id": "9cd817d6-befb-43e8-942a-e8ea03dbb436",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "Das weiß doch jeder Idiot, dass man damit nicht durchkommt."
                                            },
                                            {
                                                "example_id": "919a730a-e3b0-49d5-ac2e-7bcf911b8696",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "Kein Idiot käme auf die Idee, mit einer Kerze da hinein zu gehen."
                                            },
                                            {
                                                "example_id": "2b06fab6-63b6-4962-a033-92b6d63effea",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "„Nach seiner Theorie bestanden alle Völker der Welt aus lauten, ungebildeten und ahnungslosen Idioten.“"
                                            },
                                            {
                                                "example_id": "5129665b-ddd8-4ce4-9a1e-177bb8b607e5",
                                                "sense_id": "5f8ee82c-8208-3acf-9668-6827924366d8",
                                                "text": "„Sie nennen einen »Außenseiter«, der nicht stiehlt, einen Dummkopf, einen Idioten, einen Dussel und einen Einfaltspinsel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf7f3768-353d-3e38-af42-49b87302a2b5",
                                        "entry_id": "92619ca5-9602-3bbf-a589-6af92f40b52f",
                                        "glosses": [
                                            "ein an Idiotie leidenden Mensch"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2416351-7339-49f5-80d9-db421bfbccf2",
                                                "sense_id": "cf7f3768-353d-3e38-af42-49b87302a2b5",
                                                "text": "1897 fand eine Konferenz der Vorsteher evangelischer Idioten- und Epileptischenanstalten statt."
                                            }
                                        ],
