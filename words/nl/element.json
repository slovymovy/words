                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wetenschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goud is een chemisch <w>element</w> dat al sinds de oudheid bekend is.",
                            "target_lang_translations": {
                                "en": "Gold is a chemical <w>element</w> that has been known since antiquity."
                            }
                        },
                        {
                            "text": "Elk <w>element</w> in het periodiek systeem heeft een uniek atoomnummer.",
                            "target_lang_translations": {
