                        ]
                    },
                    {
                        "translation_id": "968d7045-be82-496f-8477-c9094e754c46",
                        "source_entry_id": "2d5f73a9-3876-3684-b430-43347caba505",
                        "source_sense_description": "язвительность",
                        "target_lang_word": "caustic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caustic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb9c290-d36b-3bae-a812-04aec13574b4",
                                        "entry_id": "ea73a889-4209-3683-8ac0-158a27602b4b",
                                        "glosses": [
                                            "Capable of burning, corroding or destroying organic tissue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                        "entry_id": "ea73a889-4209-3683-8ac0-158a27602b4b",
                                        "glosses": [
                                            "Sharp, bitter, cutting, biting, and sarcastic in a scathing way."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "176a41da-7dcf-411f-bd32-cba6553ed11b",
                                                "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                                "text": "\"How now!\" said Scrooge, caustic and cold as ever."
                                            },
                                            {
                                                "example_id": "b9ce6e64-5d14-4387-8cb3-e636fbc933d3",
                                                "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                                "text": "The bargain was not concluded as easily as might have been expected though, for Scadder was caustic and ill-humoured, and cast much unnecessary opposition in the way"
                                            },
                                            {
                                                "example_id": "3a7b0bbc-a809-4df1-b858-ef69063dd600",
                                                "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                                "text": "Madame Beck esteemed me learned and blue; Miss Fanshawe, caustic, ironic, and cynical"
                                            },
                                            {
                                                "example_id": "206c4c42-3588-4951-9b66-9f0b89b70fcf",
                                                "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                                "text": "The Secretary and the Assistant-Secretaries would say little caustic things about him to the senior clerks, and seemed somewhat to begrudge him his new honours."
                                            },
                                            {
                                                "example_id": "1e1830d5-de97-4524-92bd-dd037466f4a2",
                                                "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                                "text": "this set of worthies, who were only too prone to shut up their emotions with caustic words."
                                            },
                                            {
                                                "example_id": "388ce333-2106-4da5-8cc2-00d840ba81c9",
                                                "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            },
                                            {
                                                "example_id": "25d48aaf-5af2-4350-b28b-d644e897b937",
                                                "sense_id": "5ddbc0c1-3503-3547-8143-89df0c4b929f",
                                                "text": "though he came too late / To join the martyrs, there was still a place / Among the tempters for a caustic tongue / / To test the resolution of the young / With tales of the small failings of the great"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caustic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c93cb482-1ecc-3f8f-9d16-c1fe710b4424",
                                        "entry_id": "b9293273-0e84-3726-9cbe-315aa6d40c25",
                                        "glosses": [
                                            "Any substance or means which, applied to animal or other organic tissue, burns, corrodes, or destroys it by chemical action; an escharotic."
                                        ],
