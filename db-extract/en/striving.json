                        "sense_id": "1a2ed2f6-c890-31ca-9620-92eab3ec624b",
                        "entry_id": "a2d618c3-9006-307b-b760-e52bafa7ea21",
                        "glosses": [
                            "Effort; the act of one who strives."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a65cdd2b-837d-42c9-9d97-96aac442dca5",
                                "sense_id": "1a2ed2f6-c890-31ca-9620-92eab3ec624b",
                                "text": "Repudiating the excessive sexualism of Freud and insisting upon the importance of the food-seeking impulse, especially in childhood, he regards all the primary impulses as differentiations of one fundamental energy, the life force which sustains all our strivings, both conscious and unconscious […]"
                            },
                            {
                                "example_id": "6ecb3b6a-e37c-4b22-ad36-ba61f2a82fce",
                                "sense_id": "1a2ed2f6-c890-31ca-9620-92eab3ec624b",
                                "text": "Sexual virility, coital potency rides high and arrogant over the commercial, artistic, social strivings of contemporary society[.]"
                            },
                            {
                                "example_id": "bbb36ed0-a63b-4ba6-beca-fbdb7d0668a5",
                                "sense_id": "1a2ed2f6-c890-31ca-9620-92eab3ec624b",
                                "text": "Do we really want all those strivings and contrivings—all those thoughts and assumptions someone has cleverly etched into the hardware and software we are using—to remain invisible?"
                            }
                        ]
                    }
                ],
