                                "sense_id": "f849f15e-17ff-3860-a963-879533040229",
                                "text": "Une dentelle enrichie de broderies."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c4feff8-99f0-3c74-a080-fa488dd26edc",
                        "entry_id": "6f97bc31-4751-3b1f-b7e5-d6b51b41a315",
                        "glosses": [
                            "Dont la teneur est augmentée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6e1dca30-ef4c-4465-9ceb-9fb82776954c",
                                "sense_id": "3c4feff8-99f0-3c74-a080-fa488dd26edc",
                                "text": "Un savon saponifié à froid surgras enrichi en huiles végétales pour une peau bien hydratée (savon à froid Délicatesse d’ânesse, Louise émoi, 4,50 €)."
                            }
                        ]
                    },
                    {
