                        "source_sense_description": "schreibmaschinenähnliches Gerät zur Übermittlung von Textnachrichten mittels elektrischer Signale",
                        "target_lang_word": "teleprinter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teleprinter",
