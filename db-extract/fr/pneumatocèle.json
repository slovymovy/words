                "senses": [
                    {
                        "sense_id": "bf3f66d8-c835-31c2-8c0c-21412acce51c",
                        "entry_id": "352861ae-be0e-3356-846b-facb58d32dee",
                        "glosses": [
                            "Cavité, tumeur, tuméfaction emplie de gaz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f05837f-70a4-4c31-bece-605272bc7b81",
                                "sense_id": "bf3f66d8-c835-31c2-8c0c-21412acce51c",
                                "text": "Le diagnostic est posé : ce patient présente ce que les spécialistes appellent une pneumocéphalie, encore appelée pneumatocèle intracrânienne, définie par la présence d’air sous la voûte crânienne."
                            },
                            {
                                "example_id": "bac4cbad-f728-41a7-ad4b-b0636e55b6c9",
                                "sense_id": "bf3f66d8-c835-31c2-8c0c-21412acce51c",
                                "text": "La pneumatocèle vaginale (de Verneuil) appelée également pneumatocèle scrotale, se caractérise par une distension (élargissement) de la tunique vaginale (membrane entourant le testicule), consécutivement à la présence de gaz."
                            },
                            {
                                "example_id": "14760567-b41f-436c-9f31-3979df4ea948",
                                "sense_id": "bf3f66d8-c835-31c2-8c0c-21412acce51c",
                                "text": "La pneumatocèle pulmonaire est une cavité soufflée remplie d’air développée dans le parenchyme pulmonaire. C’est une lésion rare."
                            }
                        ]
                    }
