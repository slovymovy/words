                    {
                        "sense_id": "fd94a23e-fac7-3383-addb-81d81efee64e",
                        "entry_id": "2a9b675c-ac6b-3cdc-aff7-8ae01827a503",
                        "glosses": [
                            "kreisförmiger Bereich, der von einer Lichtquelle erhellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a08f60-7169-48ca-869a-6fcdb8ffdf00",
                                "sense_id": "fd94a23e-fac7-3383-addb-81d81efee64e",
                                "text": "„Es war eine dunkle Straße, und der Lichtkreis der Laterne fiel in einen Park, schnitt ein rundes Stück Rasen aus der Dunkelheit heraus; es war ringsum still.“"
                            },
                            {
                                "example_id": "f2f5a2df-4d17-43b7-9304-39f08cd18a06",
                                "sense_id": "fd94a23e-fac7-3383-addb-81d81efee64e",
                                "text": "„Ben saß an seinem Kinderschreibtisch, auch um ihn herum Notizbücher und Zettel im Schein einer Lampe, die einen Lichtkreis aufs Papier warf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
