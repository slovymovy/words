                        "form_id": "a7dc9f0d-cc06-4a74-a68b-8277abd5f52b",
                        "entry_id": "dcd4487e-2132-3206-bc89-5b1f1c8a85d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "prodigalities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b57baeb-834f-3be7-903e-2bba65ef2e9f",
                        "entry_id": "dcd4487e-2132-3206-bc89-5b1f1c8a85d5",
                        "glosses": [
                            "Wasteful extravagance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0a09a2f6-e651-42c3-804c-9a880980fffe",
                                "sense_id": "6b57baeb-834f-3be7-903e-2bba65ef2e9f",
                                "text": "The plain where he was riding was one immense thicket of the gum cistus, whose frail white leaves, just veined with the faintest pink, fell in showers at the least movement of the passer-by. What a prodigality of blossom!—for the gum cistus, born and withered in an hour, is the most ephemeral of flowers."
                            },
                            {
                                "example_id": "37560d1a-e857-440d-9da3-f9c3bc3a1c4e",
                                "sense_id": "6b57baeb-834f-3be7-903e-2bba65ef2e9f",
                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e36a0ea-68de-3852-a6a2-fccc10a2eda8",
                        "entry_id": "dcd4487e-2132-3206-bc89-5b1f1c8a85d5",
                        "glosses": [
                            "Lavish generosity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
