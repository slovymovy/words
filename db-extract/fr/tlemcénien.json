                        "entry_id": "837d02ac-505a-3735-a6c9-1ddb278a722d",
                        "glosses": [
                            "Habitant de la ville ou de la région de Tlemcen, dans le nord-ouest de l’Algérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6255d7f-b061-4b0a-9bcd-651d2a78f7fa",
                                "sense_id": "733f6e4a-dd8a-3419-beea-984839190dd7",
                                "text": "À côté du bloc kabyle, qui fournit à toutes les couches de la bourgeoisie, se trouve le bloc de Tlemcéniens qui ne rayonne guère au-delà de l’Oranie où ils tiennent négoce, tels les Benachenou installés à Relizane."
                            },
                            {
                                "example_id": "fdd90f60-b5f0-4e6a-a0b1-1eaa974f3db4",
                                "sense_id": "733f6e4a-dd8a-3419-beea-984839190dd7",
                                "text": "Les Tlemcéniens restent fiers de leurs beautés architecturales."
                            }
                        ]
                    }
                ],
