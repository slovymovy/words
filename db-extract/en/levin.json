                        "sense_id": "58c37ba4-781c-33d4-9686-5e2ab9143794",
                        "entry_id": "ee7b2a19-1fdd-3713-b872-e340e34a3efe",
                        "glosses": [
                            "A male given name."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0dc60d4f-de02-3233-b0c9-6d6eb07c9b4e",
                        "entry_id": "ee7b2a19-1fdd-3713-b872-e340e34a3efe",
                        "glosses": [
                            "A town in Manawatū-Whanganui, New Zealand. Named after William Levin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b675cfc-9257-48d9-8a1e-9fe34f0bd148",
                                "sense_id": "0dc60d4f-de02-3233-b0c9-6d6eb07c9b4e",
                                "text": "The latter's loss of time between Manakau and Levin was due to the mishap of dropping the tablet at Ohau, which entailed an out-of-course stop of 3 min. to recover it."
                            }
                        ]
                    }
                ],
