                "senses": [
                    {
                        "sense_id": "fc642789-7896-3cfd-bd2b-21ec022ade97",
                        "entry_id": "548feaf7-d1cb-3fed-8793-354e7ccf2cd9",
                        "glosses": [
                            "Gewalt, die von Siedlern ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e802a16-d7ae-4dfc-ab41-e248c3c7fed3",
                                "sense_id": "fc642789-7896-3cfd-bd2b-21ec022ade97",
                                "text": "„Nicht behandelt wurden Naturrituale und Feiertage und die Rolle von Volkssagen im Nationalismus, ebenso wenig Straßensperren, Enteignungen, Landraub, Verhinderung von Eheschließungen, Siedlergewalt, Kapitulation der Armee und die ewige Sehnsucht nach einem starken Führer.“"
                            },
                            {
                                "example_id": "65de4817-0c65-4ecb-989d-c6fe67f592d1",
                                "sense_id": "fc642789-7896-3cfd-bd2b-21ec022ade97",
                                "text": "„Seit dem Hebron-Protokoll von 1997 ist das Stadtzentrum geteilt: Der Teil der Altstadt, in dem die Siedler leben, steht unter direkter Kontrolle des Militärs und der palästinensischen Bevölkerung ist der Zugang teils verwehrt, teils nur mit Genehmigung möglich; Siedler- und Militärgewalt gehören zum Alltag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
