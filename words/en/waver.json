{
    "word_family": [
        "waverer",
        "wavering",
        "unwavering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95a084c3-efaa-3ea5-83f7-6e8b3fad52d4",
                    "sense_definition": "To begin to weaken or show signs of weakening in resolve; to falter or give way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resolve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite all the terrible things that happened to her, she never <w>wavered</w> from her beliefs.",
                            "target_lang_translations": {
                                "ru": "Несмотря на все ужасы, которые с ней случились, она ни разу не <w>отступила</w> от своих убеждений."
                            }
                        },
                        {
                            "text": "The soldiers began to <w>waver</w> in their loyalty when they realized the battle was lost.",
                            "target_lang_translations": {
                                "ru": "Солдаты начали <w>колебаться</w> в своей верности, когда поняли, что битва проиграна."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waver in loyalty",
                        "never waver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать слабеть или проявлять признаки ослабления решимости; дрогнуть или уступить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрогнуть",
                                "target_lang_sense_clarification": "о решимости или уверенности"
                            },
                            {
                                "target_lang_word": "поколебаться",
                                "target_lang_sense_clarification": "в своих убеждениях"
                            },
                            {
                                "target_lang_word": "ослабеть",
                                "target_lang_sense_clarification": "о воле или верности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae4580a3-f1e3-3dfd-ac29-cddd3e01f27f",
                    "sense_definition": "To feel or show doubt or indecision; to be indecisive between choices; to vacillate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He continued to <w>waver</w> between the two job offers for several weeks.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>колебаться</w> между двумя предложениями о работе в течение нескольких недель."
                            }
                        },
                        {
                            "text": "If you <w>waver</w> between choices for too long, you might miss both opportunities.",
                            "target_lang_translations": {
                                "ru": "Если слишком долго <w>выбирать</w> между вариантами, можно упустить обе возможности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waver between choices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать или проявлять сомнение или нерешительность; колебаться между вариантами выбора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "при выборе"
                            },
                            {
                                "target_lang_word": "медлить",
                                "target_lang_sense_clarification": "из-за нерешительности"
                            },
                            {
                                "target_lang_word": "сомневаться",
                                "target_lang_sense_clarification": "в принятии решения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6b9e0cb-ecc0-3ca9-b788-607e8eb39278",
                    "sense_definition": "To swing or wave, especially in the air or wind; to flutter.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Brightly colored flowers <w>wavered</w> in the breeze along the garden path.",
                            "target_lang_translations": {
                                "ru": "Яркие цветы <w>колыхались</w> на ветру вдоль садовой дорожки."
                            }
                        },
                        {
                            "text": "The banners were <w>wavering</w> in the wind above the castle walls.",
                            "target_lang_translations": {
                                "ru": "Знамена <w>развевались</w> на ветру над стенами замка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waver in the breeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качаться или развеваться, особенно на воздухе или на ветру; трепетать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колыхаться",
                                "target_lang_sense_clarification": "на ветру"
                            },
                            {
                                "target_lang_word": "развеваться",
                                "target_lang_sense_clarification": "о флагах или ткани"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "на ветру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdd8c98a-8458-3e8f-ad63-b083e8d64315",
                    "sense_definition": "Of light, shadow, or a partly obscured thing: to flicker, to glimmer, or to quiver.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candle flame began to <w>waver</w> as a cold draft entered the room.",
                            "target_lang_translations": {
                                "ru": "Пламя свечи начало <w>дрожать</w>, когда в комнату проник холодный сквозняк."
                            }
                        },
                        {
                            "text": "Shadows <w>wavered</w> on the wall as the fire burned low in the hearth.",
                            "target_lang_translations": {
                                "ru": "Тени <w>колебались</w> на стене, пока огонь в очаге догорал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wavering light"
                    ],
                    "target_lang_definitions": {
                        "ru": "О свете, тени или частично скрытом предмете: мерцать, теплиться или дрожать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "о пламени или свете"
                            },
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "о свете"
                            },
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "о тенях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d2a5a8c-2c19-33c0-80d9-559984be09f1",
                    "sense_definition": "Of a body part or the voice: to become unsteady; to shake or tremble.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unsteady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His voice <w>wavered</w> when the reporter brought up the controversial topic.",
                            "target_lang_translations": {
                                "ru": "Его голос <w>дрогнул</w>, когда репортер поднял спорную тему."
                            }
                        },
                        {
                            "text": "Her hands started to <w>waver</w> as she tried to hold the heavy tray.",
                            "target_lang_translations": {
                                "ru": "Ее руки начали <w>дрожать</w>, когда она попыталась удержать тяжелый поднос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voice wavered"
                    ],
                    "target_lang_definitions": {
                        "ru": "О части тела или голосе: стать неустойчивым; дрожать или трепетать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрогнуть",
                                "target_lang_sense_clarification": "о голосе"
                            },
                            {
                                "target_lang_word": "задрожать",
                                "target_lang_sense_clarification": "о руках или голосе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94ed7dee-f0ca-325a-bd55-986de3fd13a7",
                    "sense_definition": "To sway back and forth, as if about to fall; to reel, stagger, or totter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unsteady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhausted runner began to <w>waver</w> on his feet just before the finish line.",
                            "target_lang_translations": {
                                "ru": "Изможденный бегун начал <w>шататься</w> на ногах прямо перед финишем."
                            }
                        },
                        {
                            "text": "Tom often heard her praying, as she <w>wavered</w> and trembled, and seemed about to fall down.",
                            "target_lang_translations": {
                                "ru": "Том часто слышал, как она молилась, <w>пошатываясь</w> и дрожа, и, казалось, вот-вот упадет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качаться взад-вперед, как будто собираясь упасть; шататься или идти нетвердой походкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шататься",
                                "target_lang_sense_clarification": "от усталости или слабости"
                            },
                            {
                                "target_lang_word": "пошатываться",
                                "target_lang_sense_clarification": "едва держась на ногах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ff60eb9-23c6-3992-a37d-fac32f9f963f",
                    "sense_definition": "To change, fluctuate, or vary in quality or state.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The value of the currency began to <w>waver</w> due to the political instability.",
                            "target_lang_translations": {
                                "ru": "Курс валюты начал <w>колебаться</w> из-за политической нестабильности."
                            }
                        },
                        {
                            "text": "His mood would <w>waver</w> between extreme excitement and deep sadness.",
                            "target_lang_translations": {
                                "ru": "Его настроение <w>менялось</w> от крайнего возбуждения до глубокой печали."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Меняться, колебаться или варьироваться в качестве или состоянии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "о курсе валют или настроении"
                            },
                            {
                                "target_lang_word": "меняться",
                                "target_lang_sense_clarification": "непостоянно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abca1daf-d3aa-3f59-af66-99d76b6ab9ac",
                    "sense_definition": "To move without purpose or a specified destination; to roam or wander.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Michael watched him down the corridor, saw him <w>waver</w> into the dusky street.",
                            "target_lang_translations": {
                                "ru": "Майкл проводил его взглядом по коридору и увидел, как тот неуверенно <w>вышел</w> на темную улицу."
                            }
                        },
                        {
                            "text": "The lost travelers continued to <w>waver</w> through the woods without a map.",
                            "target_lang_translations": {
                                "ru": "Заблудившиеся путешественники продолжали <w>брести</w> через лес без карты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться без цели или определенного пункта назначения; бродить или скитаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "неуверенно или бесцельно"
                            },
                            {
                                "target_lang_word": "скитаться",
                                "target_lang_sense_clarification": "без ясного пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20c78070-3568-3871-a97d-4d20d9025878",
                    "sense_definition": "To deviate from a course; to stray or wander away from a path.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheep began to <w>waver</w> away from the rest of the flock.",
                            "target_lang_translations": {
                                "ru": "Овца начала <w>отбиваться</w> от остального стада."
                            }
                        },
                        {
                            "text": "He swore that the beast did <w>waver</w> away from him as he affirmed in his claim.",
                            "target_lang_translations": {
                                "ru": "Он клялся, что зверь действительно <w>отклонился</w> от него, как он и утверждал в своем заявлении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waver away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклоняться от курса; сбиваться с пути или уходить в сторону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбиться",
                                "target_lang_sense_clarification": "от стада или группы"
                            },
                            {
                                "target_lang_word": "отклониться",
                                "target_lang_sense_clarification": "от пути"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f1f38f3-ef2d-34ba-a65e-59b9f3eb367a",
                    "sense_definition": "Of the mind or wits: to become confused, unsteady, or to reel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am weary and I feel my wits <w>wavering</w> after so many hours of work.",
                            "target_lang_translations": {
                                "ru": "Я устал и чувствую, как мои мысли <w>путаются</w> после стольких часов работы."
                            }
                        },
                        {
                            "text": "In his fever, his thoughts began to <w>waver</w> and lose all logic.",
                            "target_lang_translations": {
                                "ru": "В лихорадке его мысли начали <w>мутиться</w> и терять всякую логику."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wits wavering"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to describe mental state"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Об уме или рассудке: запутаться, стать неустойчивым или помутиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путаться",
                                "target_lang_sense_clarification": "о мыслях или сознании"
                            },
                            {
                                "target_lang_word": "мутиться",
                                "target_lang_sense_clarification": "о рассудке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91b3f59e-9175-3fb0-99d5-a1a7ffc3ebaa",
                    "sense_definition": "To cause someone or something to move back and forth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor was <w>wavering</w> the light upon a pole to signal the other ship.",
                            "target_lang_translations": {
                                "ru": "Моряк <w>раскачивал</w> фонарь на шесте, чтобы подать сигнал другому кораблю."
                            }
                        },
                        {
                            "text": "He <w>wavered</w> his head like a proud horse playing with its bridle.",
                            "target_lang_translations": {
                                "ru": "Он <w>покачивал</w> головой, словно гордый конь, играющий со своей уздечкой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо или что-либо двигаться взад-вперед."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махать",
                                "target_lang_sense_clarification": "чем-либо для сигнала"
                            },
                            {
                                "target_lang_word": "покачивать",
                                "target_lang_sense_clarification": "головой или предметом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20ebb96c-cc99-3a20-b47b-259ca40b5def",
                    "sense_definition": "To cause someone to begin to weaken in resolve.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "resolve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant pressure of the tide was <w>wavering</w> the barons every hour.",
                            "target_lang_translations": {
                                "ru": "Постоянное давление обстоятельств с каждым часом <w>колебало</w> решимость баронов."
                            }
                        },
                        {
                            "text": "Nothing could <w>waver</w> him from his chosen path of righteousness.",
                            "target_lang_translations": {
                                "ru": "Ничто не могло <w>заставить</w> его <w>свернуть</w> с избранного пути праведности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо начать терять решимость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поколебать",
                                "target_lang_sense_clarification": "чью-то решимость"
                            },
                            {
                                "target_lang_word": "сбить",
                                "target_lang_sense_clarification": "с пути или намерения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a1262ff-8704-3cd9-9158-7dcd4e213a0e",
                    "sense_definition": "A state of beginning to weaken or showing signs of weakening in resolve; a falter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resolve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was not a <w>waver</w>, doubt, or hesitation when the commander gave the order.",
                            "target_lang_translations": {
                                "ru": "Не было ни <w>колебания</w>, ни сомнения, ни тени нерешительности, когда командир отдал приказ."
                            }
                        },
                        {
                            "text": "Even in the face of danger, there was no <w>waver</w> in his determination.",
                            "target_lang_translations": {
                                "ru": "Даже перед лицом опасности в его решимости не было ни малейшей <w>слабины</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "not a waver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние начала ослабления решимости; минутная слабость или заминка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "в решимости"
                            },
                            {
                                "target_lang_word": "неуверенность",
                                "target_lang_sense_clarification": "в действиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2cb7ab9-36a1-3221-bbae-cb5b03398c72",
                    "sense_definition": "A state of feeling or showing doubt or indecision; a vacillation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indecision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is on the <w>waver</w> about whether to accept the marriage proposal.",
                            "target_lang_translations": {
                                "ru": "Она в <w>раздумьях</w> о том, принимать ли предложение о замужестве."
                            }
                        },
                        {
                            "text": "His sudden <w>waver</w> made everyone realize he wasn't sure of the plan.",
                            "target_lang_translations": {
                                "ru": "Его внезапная <w>нерешительность</w> дала всем понять, что он не уверен в плане."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the waver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние чувства или проявления сомнения или нерешительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "при принятии решения"
                            },
                            {
                                "target_lang_word": "нерешительность",
                                "target_lang_sense_clarification": "в выборе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36040c30-0dbe-3ecf-ad93-42f6c1e0a5b8",
                    "sense_definition": "An act of moving back and forth, swinging, or waving; a flutter or tremble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat watching the <w>waver</w> of the candles in the draughty room.",
                            "target_lang_translations": {
                                "ru": "Она сидела, наблюдая за <w>дрожанием</w> свечей в комнате со сквозняками."
                            }
                        },
                        {
