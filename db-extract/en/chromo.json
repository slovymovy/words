                    {
                        "sense_id": "63ad87e3-6c44-3c27-86f9-1543f02680f2",
                        "entry_id": "1c7e335e-2246-3dbd-abef-e60aeb5560e1",
                        "glosses": [
                            "A color print produced by chromolithography."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0385d49e-b941-4a94-b73d-693ff7071fe9",
                                "sense_id": "63ad87e3-6c44-3c27-86f9-1543f02680f2",
                                "text": "All Nature is smiling, in fact, with one large, comprehensive smile, exactly like a first-class PRANG chromo with a fresh coat of varnish upon it."
                            },
                            {
                                "example_id": "76fcd647-9bc8-4193-b7a7-528e5c5bf8cb",
                                "sense_id": "63ad87e3-6c44-3c27-86f9-1543f02680f2",
                                "text": "It was manifest that we all felt that we ought to send the poor shoemaker SOMETHING. There was long and thoughtful discussion of this point; and we finally decided to send him a chromo."
                            },
                            {
                                "example_id": "016d6e8a-3cf7-4100-bcba-7205de6ab8f4",
                                "sense_id": "63ad87e3-6c44-3c27-86f9-1543f02680f2",
                                "text": "The neglected warehouse turned out to be a treasury of calendar art from the 1930s through the 1970s, years when chromo art calendars were a major advertising medium, a vehicle for national pride, and a fixture in nearly every home, business, and school."
                            }
                        ]
                    }
                ],
