                    {
                        "translation_id": "b6516ffa-e3d0-4c7e-879c-7c134546bc41",
                        "source_entry_id": "7eed0317-85ad-3025-b84c-ed14f43763bf",
                        "source_sense_id": "53c07f68-e20b-3650-a689-59f7214dd59a",
