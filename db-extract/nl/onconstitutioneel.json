                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635f2d43-8822-40a5-8231-55b0e31aee9b",
                                "sense_id": "8779a9a4-a198-342f-be2d-c0e429b78069",
                                "text": "\"De gedwongen verkoop is onconstitutioneel en in strijd met Sterlings contract\", staat in de aanklacht. Maar bovendien is het \"achterbaks\"."
                            },
                            {
                                "example_id": "fcd9a5ac-b819-48d3-905d-7791ea368b05",
                                "sense_id": "8779a9a4-a198-342f-be2d-c0e429b78069",
                                "text": "Tegenstanders zeiden dat de rechter zijn eigen agenda erdoor gedrukt had. \"Dit is een schaamteloos onconstitutioneel besluit, want het huwelijk staat niet in de grondwet\", zei een opponent."
                            }
                        ]
                    }
