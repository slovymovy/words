                "senses": [
                    {
                        "sense_id": "fb199f07-c4fc-3c06-87e7-5474d4714fe1",
                        "entry_id": "6fee7213-7cfc-3ba6-9229-38d8d1d5ca3b",
                        "glosses": [
                            "Ort, an dem sich Prostituierte aufhalten, um Freier zu empfangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee354ec6-bc28-48b6-aa26-adef71c1cd7a",
                                "sense_id": "fb199f07-c4fc-3c06-87e7-5474d4714fe1",
                                "text": "„Der Straßenstrich ist nur wenige Minuten vom Potsdamer Platz entfernt, und wer am Kottbusser Tor der U-Bahn entsteigt, muss sich seinen Weg durch die Junkies bahnen.“"
                            },
                            {
                                "example_id": "7f17215f-7cdb-4f5e-83fa-3e9c9c459648",
                                "sense_id": "fb199f07-c4fc-3c06-87e7-5474d4714fe1",
                                "text": "„Pits Nase wie ein Navigationsgerät nutzend, steuerte ich den Roten zu einem der Straßenstriche von Phoenix.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
