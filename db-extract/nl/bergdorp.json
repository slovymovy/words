                "senses": [
                    {
                        "sense_id": "c1d8b7b5-dfbc-3e43-9fa2-2371ab54af50",
                        "entry_id": "3715005c-891c-3aac-82c8-042e97972f30",
                        "glosses": [
                            "een dorp of kleine plaats in de bergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5845e80-7253-4937-9dbe-9f8ab1cf0c32",
                                "sense_id": "c1d8b7b5-dfbc-3e43-9fa2-2371ab54af50",
                                "text": "Goed nieuws voor de Twin Peaks fans: na 25 jaar komt er eind deze maand een vervolg op de klassieker van David Lynch. Bij Studio/K en LAB111 gaan ze terug naar het bergdorp waar Dale Cooper onderzoek deed naar de moord op Laura Palmer en kun je alvast in de stemming komen tijdens een marathon van het eerste seizoen."
                            },
                            {
                                "example_id": "53a03776-ddda-4266-9697-a3afa965ee03",
                                "sense_id": "c1d8b7b5-dfbc-3e43-9fa2-2371ab54af50",
                                "text": "Zakarin was de sterkste uit een kopgroep van in totaal veertien renners die op de eerste van vier beklimmingen de aanval koos. Zakarin soleerde op de lastige slotklim naar het Zwitserse bergdorp Finhaut-Emosson naar de grootste zege uit zijn loopbaan."
                            },
                            {
                                "example_id": "66285a6d-2330-4dcc-91ba-f44329905773",
                                "sense_id": "c1d8b7b5-dfbc-3e43-9fa2-2371ab54af50",
                                "text": "Wandelend door de vele kleine bergdorpjes langs de trail heb ik het Amerikaanse volk leren kennen als vriendelijk, respectvol en opvallend gastvrij."
                            }
                        ]
                    }
                ],
