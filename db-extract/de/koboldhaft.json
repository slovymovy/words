                "senses": [
                    {
                        "sense_id": "472a06a6-6924-30d3-be71-5f742a1cdc97",
                        "entry_id": "76a20f26-cf28-3376-9e97-e173e15397f7",
                        "glosses": [
                            "wie ein Kobold, an einen Kobold erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a7c51d-4ea3-47e0-bf9b-2570b4942813",
                                "sense_id": "472a06a6-6924-30d3-be71-5f742a1cdc97",
                                "text": "„Eines Tages sah er im vollen Herbstmittagslicht ein koboldhaftes Wesen aus dem Wald kommen und dann in zagem Schaukeltrab und mit verängstigter Miene vor ihm den Pfad entlangziehen.“"
                            },
                            {
                                "example_id": "4e996e6f-006c-42d6-923d-5918c09ba6b6",
                                "sense_id": "472a06a6-6924-30d3-be71-5f742a1cdc97",
                                "text": "„Jetzt tanzte es koboldhaft in ihren Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
