                "senses": [
                    {
                        "sense_id": "de686020-b06d-3cab-912b-7e8e46ff27c1",
                        "entry_id": "158a3263-44b9-3322-b07e-1232c7aae964",
                        "glosses": [
                            "Mettre sous la dépendance des ministères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc09a19-1b18-4b74-9a2f-f1043de91e26",
                                "sense_id": "de686020-b06d-3cab-912b-7e8e46ff27c1",
                                "text": "Aussi les nationalistes flamands accusèrent-ils la France de vouloir « maroquiniser » la Belgique."
                            }
                        ]
                    },
                    {
                        "sense_id": "ded0059c-deb2-3cda-93be-912732c0c7d1",
                        "entry_id": "158a3263-44b9-3322-b07e-1232c7aae964",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "602a71b9-111d-4c44-a1c5-4593b53ff96d",
                                "sense_id": "ded0059c-deb2-3cda-93be-912732c0c7d1",
                                "text": "Depuis la proclamation de l’Indépendance, en 1956, et en particulier depuis le départ de nombreux éléments de la population étrangère ou Israélite, l’aspect de cette ville, qui tend à se « maroquiniser », a été profondément altéré dans certains de ses quartiers, ceux qui précisément étaient surtout habités ou fréquentés par les « rapatriés »."
                            }
                        ]
                    }
