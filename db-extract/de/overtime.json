                "senses": [
                    {
                        "sense_id": "a3cc02a2-f99e-3941-acf1-29e58c7e256a",
                        "entry_id": "c766b061-c4e7-3953-8cd5-2c9f8b42d07a",
                        "glosses": [
                            "Verlängerung eines Spiels, wenn es am Ende der regulären Spielzeit unentschieden steht"
                        ],
                        "tags": [
                            "Basketball",
                            "Eishockey",
                            "Football"
                        ],
                        "examples": [
                            {
                                "example_id": "9a732013-2ce8-4793-8e07-e77a1308c940",
                                "sense_id": "a3cc02a2-f99e-3941-acf1-29e58c7e256a",
                                "text": "„Die Partie gegen Serbien wäre beinahe in die Overtime gegangen.“"
                            },
                            {
                                "example_id": "9c1c5ca9-e4fb-4fba-b798-088ba8c28e90",
                                "sense_id": "a3cc02a2-f99e-3941-acf1-29e58c7e256a",
                                "text": "„In der dritten Minute der Overtime sorgte Conor Sheary für die Entscheidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
