                                                "sense_id": "fb3e48ac-2341-3938-9883-b2f00901b4dc",
                                                "text": "Ce pilote est trop hasardeux."
                                            },
                                            {
                                                "example_id": "1d9f6bd8-b36d-4e9c-a4df-50c4551ec211",
                                                "sense_id": "fb3e48ac-2341-3938-9883-b2f00901b4dc",
                                                "text": "Un joueur, un marchand, un écrivain hasardeux."
                                            },
