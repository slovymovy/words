                        "glosses": [
                            "minderheidskabinet dat is ontstaan als het vorige kabinet is afgetreden en er nog verkiezingen moeten worden gehouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3fb41d-a861-4b28-bcfa-d81f6fc95b8c",
                                "sense_id": "8910d30d-d341-3097-b8f8-09f28554ca04",
                                "text": "Bruins was kort staatssecretaris van Onderwijs, Cultuur en Wetenschappen, van 7 juli 2006 tot 22 februari 2007 in het overgangskabinet Balkenende III. Daarna was hij onder meer waarnemend burgemeester in Leidschendam-Voorburg. Van 2008 tot en met 2011 maakte Bruins deel uit van de raad van bestuur van Connexxion Holding NV."
                            },
                            {
                                "example_id": "0d722c52-574b-4960-9b0f-4bb1131404dd",
                                "sense_id": "8910d30d-d341-3097-b8f8-09f28554ca04",
                                "text": "Pieter Winsemius (VVD) was maar heel kort minister in het overgangskabinet Balkenende III. Hij zei tegen de woningcorporaties dat ze snel beter moesten gaan presteren, omdat de politiek het geduld aan het verliezen was."
                            }
                        ]
