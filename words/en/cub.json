                {
                    "sense_id": "66541e44-25b4-3b07-88ca-ae33d8956abe",
                    "sense_definition": "The young of certain carnivorous mammals, such as bears, lions, wolves, or foxes.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother bear stayed close to her <w>cub</w> while searching for food.",
                            "target_lang_translations": {
                                "ru": "Медведица держалась рядом со своим <w>медвежонком</w>, пока искала пищу."
                            }
                        },
                        {
                            "text": "We were thrilled to see a lion <w>cub</w> playing in the grass.",
                            "target_lang_translations": {
                                "ru": "Мы были в восторге, увидев играющего в траве <w>львёнка</w>."
                            }
