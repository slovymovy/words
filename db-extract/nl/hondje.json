                    {
                        "sense_id": "6331bcc3-8317-38ca-ab9b-41e61149ec07",
                        "entry_id": "31d29461-4317-344b-8b2f-1d193cd1d00e",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord hond"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "236b3959-6667-49cf-a93e-1150922f98ec",
                                "sense_id": "6331bcc3-8317-38ca-ab9b-41e61149ec07",
                                "text": "Ik gluur tussen de nog gesloten gordijnen door naar beneden en zie dat ze haar hondje roept, een kefferig exemplaar met een jasje aan."
                            },
                            {
                                "example_id": "6881bcc4-d272-4ff2-b141-ebc5f60becc8",
                                "sense_id": "6331bcc3-8317-38ca-ab9b-41e61149ec07",
                                "text": "Honden zijn bijvoorbeeld duurder dan katten en een klein hondje is goedkoper dan een herdershond."
                            }
                        ]
                    },
                    {
                        "sense_id": "1144c1c0-10c3-3460-a763-490ce2579d63",
                        "entry_id": "31d29461-4317-344b-8b2f-1d193cd1d00e",
                        "glosses": [
                            "alleen verkleinwoord plank met daaronder vier kleine zwenkwielen voor het verplaatsen van zware, grote zaken, bijvoorbeeld meubels"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "90f33d5f-796c-4fde-92be-9e00069ca2dc",
                                "sense_id": "1144c1c0-10c3-3460-a763-490ce2579d63",
                                "text": "Of verhuizen een zwaar beroep is? “Heb je wel eens een wasmachine naar zolder getild”, antwoordt Noël. De hulpmiddelen, zoals het ‘hondje’, zijn belangrijk."
                            }
                        ]
                    }
                ],
