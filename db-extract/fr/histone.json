                "senses": [
                    {
                        "sense_id": "0f5bb5f2-6eca-3aba-9ccf-7ceefb9d4016",
                        "entry_id": "db454a16-9b11-3f85-98fe-a9e41625cd63",
                        "glosses": [
                            "Protéine de base de la chromatine, présente dans les nucléosomes et jouant un rôle important dans l’empaquetage et le repliement de l’ADN."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "e698a58a-2a82-4e4a-a895-59c0f895d2f4",
                                "sense_id": "0f5bb5f2-6eca-3aba-9ccf-7ceefb9d4016",
                                "text": "Celui-ci peut être soit circulant et déposé dans le glomérule (couple ADN–anti-ADN), soit être formé in situ dans le glomérule, l’antigène, par exemple une histone cationique, étant fixé (« planté ») sur la MBG."
                            },
                            {
                                "example_id": "4d2a17b5-4db9-485e-acb3-ce0fe83024cf",
                                "sense_id": "0f5bb5f2-6eca-3aba-9ccf-7ceefb9d4016",
                                "text": "Au sein des chromosomes, l’ADN, chargé négativement, s’enroule autour de protéines chargées positivement, les histones."
                            }
                        ]
                    }
                ],
