                        "glosses": [
                            "Miner en dessous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd085f4-0e7e-43e6-9109-8af7f2e11300",
                                "sense_id": "5f3d7811-3a42-32a4-8ecc-2d880f451932",
                                "text": "La mer a sous-miné le tramway, dont elle a tordu les rails de toutes les façons et dans toutes les formes possibles"
                            }
                        ]
                    },
                    {
                        "sense_id": "56527fba-d97f-3efe-95a1-8aa0745bbc9a",
