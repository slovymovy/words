                        "glosses": [
                            "een woonkamer in een boerderij of in een burgerwoning, die alleen bij speciale gelegenheden gebruikt werd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15a775b-0a2f-4da5-8644-5e47d45a6451",
                                "sense_id": "8015e04d-2327-3490-b0c1-431933b4cf0b",
                                "text": "Ze lag thuis op een deur in de pronkkamer."
                            },
                            {
                                "example_id": "4b980cc6-545c-4939-9f3a-bc7763c8a283",
                                "sense_id": "8015e04d-2327-3490-b0c1-431933b4cf0b",
                                "text": "Hij prees de Overijsselse gemeente als een van de veiligste van Nederland, als het om woninginbraken gaat. In de pronkkamer van een restaurant in Staphorst decoreerde hij op traditionele Staphorster wijze een politiepet. En natuurlijk zette de minister de pet ook op."
                            }
                        ]
                    }
