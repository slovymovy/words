        "ru-extract.jsonl": [
            {
                "entry_id": "f6ef713c-6fc2-3dc6-8255-6f171bb7345b",
                "word": "слыхать",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ed1c47f-a013-37e2-a01f-33d687b898a2",
                        "entry_id": "f6ef713c-6fc2-3dc6-8255-6f171bb7345b",
                        "glosses": [
                            "предик. можно слышать, услышать; слышно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23142001-61ec-42cc-9679-9ff431ead3d4",
                                "sense_id": "4ed1c47f-a013-37e2-a01f-33d687b898a2",
                                "text": "Стариковы комнаты находились в верхнем этаже, и внизу было слыхать, как супруги бранятся по хозяйству."
                            },
                            {
                                "example_id": "6a158163-c2b6-4061-b70f-832ba5e61dd9",
                                "sense_id": "4ed1c47f-a013-37e2-a01f-33d687b898a2",
                                "text": "Но в доме не слыхать ни шороха, ни шелеста."
                            },
                            {
                                "example_id": "0b33f27a-4df5-4897-bbc3-9d55b67e08b0",
                                "sense_id": "4ed1c47f-a013-37e2-a01f-33d687b898a2",
                                "text": "Подходим, окликаем ― не слыхать ничего; входим, наконец, в сарай…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f2fc118c-ed3a-3e45-9878-4a3e34c6eb5a",
                        "entry_id": "f6ef713c-6fc2-3dc6-8255-6f171bb7345b",
                        "glosses": [
                            "вводн. сл., прост. как будто, как известно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2122cbe6-3671-42e5-aa65-d51000327c21",
                                "sense_id": "f2fc118c-ed3a-3e45-9878-4a3e34c6eb5a",
                                "text": "― Слыхать, побил вас турка? ― Выходит, покуда побил."
                            },
                            {
                                "example_id": "4d5eaec9-2285-40e8-9381-3bfd47512e30",
                                "sense_id": "f2fc118c-ed3a-3e45-9878-4a3e34c6eb5a",
                                "text": "― А сестра Мария, слыхать, обженихалась."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "6f15e289-58e1-49dd-8835-aa3357ad3bba",
                        "source_entry_id": "f6ef713c-6fc2-3dc6-8255-6f171bb7345b",
