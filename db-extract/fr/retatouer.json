                "senses": [
                    {
                        "sense_id": "383063d0-62e3-3f2a-a84e-c68118010628",
                        "entry_id": "6e9ae861-ce96-35c1-81ec-12343a706868",
                        "glosses": [
                            "Tatouer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ea40b8c-e919-4ef2-8d73-eb80c3b889d9",
                                "sense_id": "383063d0-62e3-3f2a-a84e-c68118010628",
                                "text": "Mais les indigènes ingénieux ont imaginé de retatouer leurs ennemis après leur mort pour augmenter leur valeur marchande."
                            },
                            {
                                "example_id": "679400d9-4b33-4c60-a02a-af6a56705303",
                                "sense_id": "383063d0-62e3-3f2a-a84e-c68118010628",
                                "text": "Il y a environ un mois, ce Moïse a fait retatouer sa fille Rosalie, sans doute pour la débaptiser aussi, ou de peur que le baptême n'eut enlevé toute valeur à son premier tatouage."
                            }
                        ]
                    }
