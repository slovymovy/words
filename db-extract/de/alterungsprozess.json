                ],
                "senses": [
                    {
                        "sense_id": "6ea3336f-7411-3532-ade2-db490da0bc60",
                        "entry_id": "fb5f2351-ebb1-3dbd-9b05-515aada3d83f",
                        "glosses": [
                            "die unaufhaltsame, mit der Zeit fortschreitende Veränderung an Menschen und Dingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aa9a8f2-e109-4b58-8bc7-8b6de0153f39",
                                "sense_id": "6ea3336f-7411-3532-ade2-db490da0bc60",
                                "text": "„In der Schwerelosigkeit läuft der Alterungsprozess im Zeitraffer ab: Muskelabbau, Osteoporose, Rückenbeschwerden, Kreislauf- und Orientierungsprobleme, zunehmende Kraftlosigkeit sowie Probleme im Immunsystem.“"
                            },
                            {
                                "example_id": "94195e8e-d9af-4fb6-8a45-c372ff3b2500",
                                "sense_id": "6ea3336f-7411-3532-ade2-db490da0bc60",
                                "text": "„Wer weiß denn schon, wie lange sich ein Film hält? Sind es 30, sind es 40 Jahre für ein Farbdia? Der Alterungsprozess ist abhängig von der Sorgfalt der Lagerung und der früheren Umsicht im Entwicklungsbad.“"
                            },
                            {
                                "example_id": "29a70efe-1c4c-4770-92e8-50bd47c8b238",
                                "sense_id": "6ea3336f-7411-3532-ade2-db490da0bc60",
                                "text": "„Die Weine aus Semillon sind sehr alterungsfähig. Beim Alterungsprozess verliert er die vordergründige Süße und der Wein beginnt leicht zu karamellisieren und wirkt dabei fast trocken.“"
                            },
                            {
                                "example_id": "a37ecc51-525d-490e-a317-71ffe615de23",
                                "sense_id": "6ea3336f-7411-3532-ade2-db490da0bc60",
                                "text": "„Solche Witze gab es von dem betagten Reichspräsidenten Hindenburg, dessen Alterungsprozess die schnelle Agonie und den galoppierenden Untergang der Weimarer Republik spiegelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
