                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89935dd-00a1-4a0c-b12d-c9eff0a34961",
                                "sense_id": "99182801-303a-352e-84b3-e122fba0486d",
                                "text": "W czasie rodzinnego obiadu dziadkowie rozmawiali o polityce, a babcie o szydełkowaniu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
