                    {
                        "form_id": "814fc6c6-1829-4a98-96aa-211d6812b7b4",
                        "entry_id": "4440cc06-616d-3be5-992f-b421a803b9f7",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "rougeaudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86c5b769-ed74-3459-9bba-2d24510fbefe",
                        "entry_id": "4440cc06-616d-3be5-992f-b421a803b9f7",
                        "glosses": [
                            "Qui a le teint rouge, un peu haut en couleur."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4b146aee-b8fa-43ec-8e50-30d9d37ee75d",
                                "sense_id": "86c5b769-ed74-3459-9bba-2d24510fbefe",
                                "text": "Elle vit un gros petit homme à ventre saillant, à figure rougeaude, mais vieille et ridée, qui affectait de sourire et qui souriait mal ; […]."
                            },
                            {
                                "example_id": "3246cd77-fd82-4ad7-82a7-5586cc927687",
                                "sense_id": "86c5b769-ed74-3459-9bba-2d24510fbefe",
                                "text": "Leur maître, un jeune gentilhomme courtaud et rougeaud, ne cessait de les encourager de la voix et du geste."
                            },
                            {
                                "example_id": "fc8f6e50-7d01-474f-b1da-e88aa0dfd833",
                                "sense_id": "86c5b769-ed74-3459-9bba-2d24510fbefe",
                                "text": "Sa face rougeaude avait des tons de monnaie de cuivre."
                            },
                            {
                                "example_id": "ce2b6fc1-bdf4-4e65-a1c6-21cabe938756",
                                "sense_id": "86c5b769-ed74-3459-9bba-2d24510fbefe",
                                "text": "Et cette petite boule rougeaude et vagissante que tu étais, je la voyais surtout comme un poids sur mon existence et comme une entrave à ma liberté."
                            },
                            {
                                "example_id": "bc97ce43-cf70-4587-80ac-d2b2bf341c11",
                                "sense_id": "86c5b769-ed74-3459-9bba-2d24510fbefe",
                                "text": "Rougeauds, ridés, les bébés aux yeux laiteux m’importunaient."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8f523392-db78-37eb-bddd-ea35db74a129",
                "word": "rougeaud",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2478071a-0051-4f90-b4c4-9660c6c976ed",
