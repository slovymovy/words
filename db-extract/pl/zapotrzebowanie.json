                    }
                ],
                "translations": [
                    {
                        "translation_id": "a61240c7-8082-4703-bb46-9b030f23a4bd",
                        "source_entry_id": "bab0b7f7-0973-3547-9bdd-4b5d752a695a",
                        "source_sense_id": "35dfbeda-0d4e-3c72-860e-c7a2d6872ecf",
                        "target_lang_word": "Bedarf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bedarf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                        "entry_id": "20cda698-c0ce-3022-a815-919fe4b67b95",
                                        "glosses": [
                                            "etwas, das gebraucht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79980df-1c57-4936-b664-9da762a537d3",
                                                "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                                "text": "Durch das Wirtschaftswachstum steigt der Bedarf an Fachkräften."
                                            },
                                            {
                                                "example_id": "aeee5a3a-65c3-4087-b435-656d97f8210d",
                                                "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                                "text": "Bei Bedarf dürfen Sie mich gerne wieder anrufen."
                                            },
                                            {
                                                "example_id": "eb76953e-2d4b-4f1e-b80b-8b7ac9aede1c",
                                                "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                                "text": "Früher neue Bedarfe erkennen und deswegen schneller reagieren."
                                            },
                                            {
                                                "example_id": "d028f8ad-7e1a-41c4-8f26-56a1e2e8cc25",
                                                "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                                "text": "Die Festlegung einer Vorlaufproduktion ist bei saisonalem Bedarf notwendig."
                                            },
                                            {
                                                "example_id": "fc9ff471-640a-4c21-9c07-db55f22e727a",
                                                "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                                "text": "„Für die Deckung ihres restlichen Bedarfes waren die Menschen auf regional je unterschiedliche Formen des Schwarzmarktes angewiesen.“"
                                            },
                                            {
                                                "example_id": "348e9df8-dc2a-4919-b3d6-4c1fb21fa77c",
                                                "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                                "text": "„Viele Artikel des täglichen Bedarfs, vom Lippenstift bis zum Abflußreiniger, dürfen nicht in den Handel gebracht werden, bevor ihre gesundheitliche Unbedenklichkeit nachgewiesen ist.“"
                                            },
                                            {
                                                "example_id": "62f34b9a-0ffa-488d-b306-33ae33996060",
                                                "sense_id": "4e86bd91-36a4-3bad-b6cf-4dd97406d3e2",
                                                "text": "„Bouvard würde seine Möbel mitnehmen, Pécuchet seinen großen schwarzen Tisch; sie würden die Vorhänge verwenden, und mit ein wenig Küchengeschirr wäre ihr Bedarf zur Genüge gedeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dcb3f56-43ae-42fc-9dfd-cb08aa7c049f",
                        "source_entry_id": "bab0b7f7-0973-3547-9bdd-4b5d752a695a",
                        "source_sense_id": "cd1cad93-2d68-3df3-a90a-3f7e3e828f01",
                        "target_lang_word": "Anforderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anforderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aed453da-6c3f-3f84-ba4b-3d9cf8b97132",
                                        "entry_id": "d0d304bf-e8a0-30c6-8c95-75cc0e25951d",
                                        "glosses": [
                                            "Forderung mit dem Ziel, etwas Bestimmtes zu erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa536ddf-027e-4048-97e5-54ebf7fc4bd6",
                                                "sense_id": "aed453da-6c3f-3f84-ba4b-3d9cf8b97132",
                                                "text": "Wir sind mit der Anforderung des Baumaterials ein bisschen spät dran."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1c310d9-16a9-33c3-ad6a-92a28dcf37dc",
                                        "entry_id": "d0d304bf-e8a0-30c6-8c95-75cc0e25951d",
                                        "glosses": [
                                            "Eigenschaft oder Fähigkeit, die zur Bewältigung bestimmter Aufgaben vorhanden sein muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5e16a8-980c-416d-8d74-7000d56b7376",
                                                "sense_id": "e1c310d9-16a9-33c3-ad6a-92a28dcf37dc",
                                                "text": "Er war den Anforderungen seines Berufes nicht gewachsen."
                                            },
                                            {
                                                "example_id": "f0aa21a7-837f-4123-853e-2d87d0327611",
                                                "sense_id": "e1c310d9-16a9-33c3-ad6a-92a28dcf37dc",
                                                "text": "„Sie stellt aber auch Anforderungen an die Bürger als Sprachrezipienten, an ihr sprachliches Wissen und Können, etwa bei der Aufnahme von Wortungetümen wie »Wachstumsbeschleunigungsgesetz«.“"
                                            },
                                            {
                                                "example_id": "c16a682f-c482-48af-bcf8-163f9ecca454",
                                                "sense_id": "e1c310d9-16a9-33c3-ad6a-92a28dcf37dc",
                                                "text": "„Die Anforderungen an uns Männer sind in den letzten Jahrzehnten immer komplexer und widersprüchlicher geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f63a5838-cbbf-4664-81c7-873f60f58603",
                        "source_entry_id": "bab0b7f7-0973-3547-9bdd-4b5d752a695a",
                        "source_sense_id": "cd1cad93-2d68-3df3-a90a-3f7e3e828f01",
                        "target_lang_word": "Auftrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auftrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbaddb35-f29a-39e8-988f-c9c3c023e279",
                                        "entry_id": "edfd820c-935d-317d-b0e2-0c044a861053",
                                        "glosses": [
                                            "mündliche oder schriftliche Aufforderungen einer Stelle oder einer Person an eine andere Stelle oder Person"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f72bdae-42b4-4b8c-ad22-9803265d7a1d",
                                                "sense_id": "dbaddb35-f29a-39e8-988f-c9c3c023e279",
                                                "text": "Ich hole im Auftrag meiner Eltern das Paket ab."
                                            },
                                            {
                                                "example_id": "508a87f1-95e0-47c0-88b7-9077eb38d661",
                                                "sense_id": "dbaddb35-f29a-39e8-988f-c9c3c023e279",
                                                "text": "„Seit dem Aufruf hat Ali 80 Prozent der Aufträge verloren, sein Sohn musste das Studium abbrechen.“"
                                            },
                                            {
                                                "example_id": "311405f9-7150-423e-a6d0-ff62c13288aa",
                                                "sense_id": "dbaddb35-f29a-39e8-988f-c9c3c023e279",
                                                "text": "„Bevor ich antworten konnte, fragte er mich, womit ich jetzt mein Geld verdiene, und ich erzählte ihm von meinen Aufträgen als Ghostwriterin eines Ghostwriters.“"
                                            },
                                            {
                                                "example_id": "51d90fca-6105-43c8-963c-f3c946b3dcb5",
                                                "sense_id": "dbaddb35-f29a-39e8-988f-c9c3c023e279",
                                                "text": "„Alpatytsch hatte jetzt alle seine Aufträge erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44d67f6b-ea6c-37ac-afa7-cedade09213c",
                                        "entry_id": "edfd820c-935d-317d-b0e2-0c044a861053",
                                        "glosses": [
                                            "Rechtsgeschäft, das den Beauftragten verpflichtet, unentgeltlich ein Geschäft für den Auftraggeber zu besorgen"
                                        ],
                                        "tags": [
                                            "Zivilrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c2fe38-8b12-44d1-b4cf-28001b04c49d",
                                                "sense_id": "44d67f6b-ea6c-37ac-afa7-cedade09213c",
                                                "text": "Bald kamen die ersten Aufträge zum Start der Soyuz-2 und damit auch Geld in die Kassen, mit dem die Weiterentwicklung finanziert werden konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "467b9db6-04f7-3b6d-857d-114fafbbaebb",
                                        "entry_id": "edfd820c-935d-317d-b0e2-0c044a861053",
                                        "glosses": [
                                            "jede Anweisung oder Mitteilung einer übergeordneten öffentlichen Behörde an eine nachgeordnete Behörde"
                                        ],
                                        "tags": [
                                            "Verwaltung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "097acfcf-6531-4adb-887f-f9f593ba19ce",
                                                "sense_id": "467b9db6-04f7-3b6d-857d-114fafbbaebb",
                                                "text": "„Der Auslöser zur Schulprofilierung stammte aus einem „behördlichen Auftrag“, einem Erlass der regionalen Schulbehörde.“"
                                            },
                                            {
                                                "example_id": "7804e357-350a-443f-832c-07f7a2efa5d1",
                                                "sense_id": "467b9db6-04f7-3b6d-857d-114fafbbaebb",
                                                "text": "„Als ich der Prinzessin berichtete, welche Aufträge die Oberin erhalten hatte, fand sie, daß der Kardinal nicht großzügiger hätte vorgehen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f57215af-2eed-3d6f-a2ac-2ee0c4d5fa70",
                                        "entry_id": "edfd820c-935d-317d-b0e2-0c044a861053",
                                        "glosses": [
                                            "Aufgabe, die einem militärischen Führer von dessen übergeordneter Führung gestellt wird, wobei der Weg zum Ziel grundsätzlich nicht vorgegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b6faaa-1ea5-4bac-aa94-2c066f5a5fab",
                                                "sense_id": "f57215af-2eed-3d6f-a2ac-2ee0c4d5fa70",
                                                "text": "Die Einheit erhielt den Auftrag, die Geisel zu befreien."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "91f0fc47-4a58-38a4-b388-0203a45578e0",
