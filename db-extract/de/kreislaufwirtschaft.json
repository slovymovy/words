                    {
                        "form_id": "1ead3067-2664-4cc3-a1bf-5ba06212d305",
                        "entry_id": "8ed70596-9e83-371a-86e5-b1f1095b8269",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kreislaufwirtschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                        "entry_id": "8ed70596-9e83-371a-86e5-b1f1095b8269",
                        "glosses": [
                            "Wirtschaft, die durch Wiederverwendung, Reparatur und Recycling die Ziele verfolgt, den Ressourceneinsatz, die Abfälle, Emissionen und den Energieverbrauch weitgehend zu minimieren"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "6d681be7-fefd-4920-a512-0c0e9b8f8e8d",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Die Verpackungsindustrie wird zunehmend auf das Konzept der Kreislaufwirtschaft ausgerichtet, bei dem Materialien und Ressourcen so lange wie möglich im Wirtschaftskreislauf gehalten werden.“"
                            },
                            {
                                "example_id": "82e227c4-7fff-4163-85d6-a86f24efd18c",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "[Schlagzeile:] „Warum die Kreislaufwirtschaft noch nicht rund läuft“"
                            },
                            {
                                "example_id": "9f6da8a6-243b-4bc7-bef0-81266856fdee",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Die Umstellung auf eine \"Kreislaufwirtschaft\" ist entscheidend beim Thema Klimaschutz und Nachhaltigkeit, sagen Experten.“"
                            },
                            {
                                "example_id": "133f0fae-9cc2-4882-8218-9bc9f3d03ef4",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Von einer Transformation zu einer Kreislaufwirtschaft sind wir allerdings noch weit entfernt, sie hat gerade erst begonnen.“"
                            },
                            {
                                "example_id": "78234910-e03a-47ec-a989-d4a2625d582a",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Die Kreislaufwirtschaft funktioniert nicht gut in Deutschland.“"
                            },
                            {
                                "example_id": "4fcaf854-a0ce-4937-a019-9071b62577ee",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Ob Küchengeräte, Kleidungsstücke oder Verpackungen: In der Kreislaufwirtschaft werden alle Produkte möglichst nachhaltig hergestellt. Das Ziel: Ressourcen schonen und Umweltschäden auf ein Minimum reduzieren.“"
                            },
                            {
                                "example_id": "e57dd410-aae9-4315-8b41-4be876ec4711",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Der Ruf von Architekten und Naturschutzverbänden nach einem bundesweiten Abrissmoratorium und mehr Kreislaufwirtschaft, um der Klimakrise zu trotzen – auch im Ahrtal verhallt er ungehört.“"
                            },
                            {
                                "example_id": "9ad46d4f-124e-4fa5-b5b4-1c9345945b4e",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Sowohl Michael Wick wie auch Tobias Metzger sind von der Kreislaufwirtschaft überzeugt.“"
                            },
                            {
                                "example_id": "6778dc5d-b421-464f-8f25-2eaedf037cd0",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Ihr Ziel ist es, den Einsatz von Recyclingmaterial zu steigern. Wiederaufbereitete Baustoffe sollen verstärkt in die Kreislaufwirtschaft zurückgeführt werden.“"
                            },
                            {
                                "example_id": "57e2024e-cf63-4506-b673-9cd31bac5ccb",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Kein Hersteller kann allein eine Kreislaufwirtschaft aufbauen. Verschiedene Firmen müssen zusammenarbeiten.“"
                            },
                            {
                                "example_id": "56b770a4-06e7-4ba1-ba0f-ec4d20b22b08",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Der Nationalrat hat nun einer Vorlage zugestimmt, die die Kreislaufwirtschaft fördern will.“"
                            },
                            {
                                "example_id": "aa3ce260-6df9-4727-9cca-530e377d91da",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Wirtschaftlich würde sich der Umstieg auf eine Kreislaufwirtschaft laut UNEP lohnen.“"
                            },
                            {
                                "example_id": "04f3ddb1-4716-4e01-8d03-6875ae7620e4",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Gleichzeitig könnte die Einführung einer Kreislaufwirtschaft in den kommenden Jahren global 700 000 neue Arbeitsplätze schaffen.“"
                            },
                            {
                                "example_id": "51dc64b2-0007-4c54-a67f-56eb08be62b2",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Diese im Rahmen eines Umbaus zu einer Kreislaufwirtschaft festgelegten Ziele sehen für 2025 vor, dass mindestens 55 Prozent der „Siedlungsabfälle“ (Abfälle aus Haushalten und ähnliche Abfälle aus Unternehmen) recycelt und für die Wiederverwertung vorbereitet werden.“"
                            },
                            {
                                "example_id": "40f245bd-0cfe-4cd6-b994-0ab9afe0cc5b",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Doch da sind die Verbraucher gefordert: Wer diese Art der Kreislaufwirtschaft durch Komposte unterstützen will – der wirft in den Bioabfalleimer nur das, was auch wirklich reingehört.“"
                            },
                            {
                                "example_id": "fda63f41-5bbb-42f8-8e9a-e375b4532e00",
                                "sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                                "text": "„Im Herbst letzten Jahres hat der diplomierte Geo-Ökologe Florian Sorg eine neue Stelle angetreten. Er wurde Koordinator für Kreislaufwirtschaft im Rathaus Stuttgart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
