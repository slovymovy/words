{
    "word_family": [
        "beschaven",
        "beschaafd",
        "beschavingsdrang",
        "beschavingsniveau"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b16a543-8af1-38fb-aa05-f79500888e8d",
                    "sense_definition": "Een complexe menselijke samenleving met een hoge graad van sociale, politieke en culturele ontwikkeling.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "samenleving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Griekse <w>beschaving</w> heeft een enorme invloed gehad op de moderne westerse wereld.",
                            "target_lang_translations": {
                                "en": "Greek <w>civilization</w> has had a huge influence on the modern Western world."
                            }
                        },
                        {
                            "text": "Archeologen hebben resten gevonden van een oude <w>beschaving</w> die duizenden jaren geleden bloeide.",
                            "target_lang_translations": {
                                "en": "Archaeologists have found remains of an ancient <w>civilization</w> that flourished thousands of years ago."
                            }
                        }
                    ],
                    "synonyms": [
                        "civilisatie"
                    ],
                    "common_phrases": [
                        "westerse beschaving",
                        "oude beschavingen",
                        "bakermat van de beschaving"
                    ],
                    "target_lang_definitions": {
                        "en": "A complex human society with a high degree of social, political, and cultural development."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "civilization",
                                "target_lang_sense_clarification": "a complex human society"
                            },
                            {
                                "target_lang_word": "civilisation",
                                "target_lang_sense_clarification": "British spelling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aba8a9ab-0b99-3d24-b0cf-0d451049ea9f",
                    "sense_definition": "De bewoonde wereld met moderne voorzieningen, in tegenstelling tot de wildernis of afgelegen natuur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "samenleving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na drie weken in de jungle te hebben overleefd, keerden de ontdekkingsreizigers eindelijk terug naar de <w>beschaving</w>.",
                            "target_lang_translations": {
                                "en": "After surviving in the jungle for three weeks, the explorers finally returned to <w>civilization</w>."
                            }
                        },
                        {
                            "text": "In dit afgelegen bergdorpje ben je ver verwijderd van de moderne <w>beschaving</w>.",
                            "target_lang_translations": {
                                "en": "In this remote mountain village, you are far removed from modern <w>civilization</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "wildernis"
                    ],
                    "common_phrases": [
                        "terug naar de beschaving",
                        "ver van de beschaving"
                    ],
                    "target_lang_definitions": {
                        "en": "The inhabited world with modern amenities, as opposed to the wilderness or remote nature."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "civilization",
                                "target_lang_sense_clarification": "modern society and its comforts"
                            },
                            {
                                "target_lang_word": "the modern world",
                                "target_lang_sense_clarification": "society with modern technology"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "212b2a37-edf4-3a7d-b7c4-07a763505b68",
                    "sense_definition": "Goede manieren en fatsoenlijk gedrag in de omgang met anderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het getuigt van weinig <w>beschaving</w> om mensen voortdurend te onderbreken tijdens een gesprek.",
                            "target_lang_translations": {
                                "en": "It shows a lack of <w>civility</w> to constantly interrupt people during a conversation."
                            }
                        },
                        {
                            "text": "Zij vindt een beleefde begroeting een essentieel teken van <w>beschaving</w>.",
                            "target_lang_translations": {
                                "en": "She considers a polite greeting an essential sign of <w>civilization</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "civilisatie"
                    ],
                    "antonyms": [
                        "onbeschoftheid",
                        "barbaarsheid"
                    ],
                    "common_phrases": [
                        "teken van beschaving",
                        "gebrek aan beschaving"
                    ],
                    "target_lang_definitions": {
                        "en": "Good manners and decent behavior in interaction with others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "civility",
                                "target_lang_sense_clarification": "politeness and courtesy"
                            },
                            {
                                "target_lang_word": "civilization",
                                "target_lang_sense_clarification": "refined behavior"
                            },
                            {
                                "target_lang_word": "decency",
                                "target_lang_sense_clarification": "proper behavior"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5050e789-649a-38a3-ba6e-186ac3eb16c9",
                    "sense_definition": "De mate waarin iemand cultureel en intellectueel gevormd of ontwikkeld is.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn brede kennis van klassieke muziek en literatuur wijst op een hoge mate van persoonlijke <w>beschaving</w>.",
                            "target_lang_translations": {
                                "en": "His broad knowledge of classical music and literature points to a high degree of personal <w>refinement</w>."
                            }
                        },
                        {
                            "text": "Zonder enige vorm van <w>beschaving</w> leefden zij enkel voor hun eigen gewin.",
                            "target_lang_translations": {
                                "en": "Without any form of <w>culture</w>, they lived only for their own gain."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vorm van beschaving"
                    ],
                    "target_lang_definitions": {
                        "en": "The degree to which someone is culturally and intellectually formed or developed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "refinement",
                                "target_lang_sense_clarification": "cultural and intellectual sophistication"
                            },
                            {
                                "target_lang_word": "culture",
                                "target_lang_sense_clarification": "personal development and education"
                            },
                            {
                                "target_lang_word": "sophistication",
                                "target_lang_sense_clarification": "intellectual maturity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}