                    {
                        "sense_id": "74988838-2016-3893-918c-98c00ce64a0c",
                        "entry_id": "b3401e64-a65d-3aa0-86b9-857f7b0d5bc5",
                        "glosses": [
                            "een vorm van weefsel dat deel uitmaakt van alle organen van het lichaam van mens en dier en een steunende, dan wel verzorgende functie heeft"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3805dbc-5521-40b3-995e-890a34ce15ca",
                        "source_entry_id": "b3401e64-a65d-3aa0-86b9-857f7b0d5bc5",
                        "source_sense_id": "74988838-2016-3893-918c-98c00ce64a0c",
                        "source_sense_description": "weefselsoort dat dient ter ondersteuning en verbinding",
                        "target_lang_word": "Bindegewebe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bindegewebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c872ad6-196f-3ba2-a404-de23c58a1647",
                                        "entry_id": "65b47a97-03e7-3cc5-8587-6482be2571d2",
                                        "glosses": [
                                            "Gewebe bei Tieren aus locker verstreuten Zellen und viel extrazellulärer Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66abaca8-f64d-41f0-a9b2-3425aee4068c",
                                                "sense_id": "8c872ad6-196f-3ba2-a404-de23c58a1647",
                                                "text": "Blut ist ein Sonderfall des Bindegewebes, da die extrazelluläre Substanz flüssig ist."
                                            },
                                            {
                                                "example_id": "d3ca2117-1b51-4635-9816-20400010fa57",
                                                "sense_id": "8c872ad6-196f-3ba2-a404-de23c58a1647",
                                                "text": "„Damit verhindert der Reflex übermäßige, für das Bindegewebe gefährliche Muskelspannungen.“"
                                            },
                                            {
                                                "example_id": "3558a0f8-a876-4cd3-a56b-563460d3ce9e",
                                                "sense_id": "8c872ad6-196f-3ba2-a404-de23c58a1647",
                                                "text": "„Diese Übersäuerung im Gewebe beeinträchtigt die Funktion von Muskeln und Bindegewebe, wodurch die Verletzungsgefahr ansteigt.“"
                                            },
                                            {
                                                "example_id": "0fcbd6ba-29d9-4698-ae66-2eede1b6c76d",
                                                "sense_id": "8c872ad6-196f-3ba2-a404-de23c58a1647",
                                                "text": "„Dabei handelt es sich um jene Eiweiße, aus denen viele Bindegewebe bestehen und die auch in den Knochen reichlich vorkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
