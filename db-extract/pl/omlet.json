                            },
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f5300680-d5f2-3be4-b29f-6dbda4665d4e",
                                        "entry_id": "c3aa138c-5e36-391d-9b45-d3a46f4738bc",
                                        "glosses": [
                                            "Coito entre mujeres."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c0ea0cb-6fb9-408b-9b73-7e5918daed96",
                                                "sense_id": "f5300680-d5f2-3be4-b29f-6dbda4665d4e",
                                                "text": "Esta tuerca, según las del gremio, es una tortillera clásica, de las que hacen ‘tortilla’ de verdad, pubis contra pubis, y no acepta otras variantes de amor sáfico."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e53a0971-e52b-420e-bddb-cba2e7f74404",
                        "source_entry_id": "575e8feb-862d-343f-a67c-d986ed1581e2",
                        "source_sense_id": "707d7f3d-50df-31e2-af5a-65ab70a183d6",
                        "target_lang_word": "Omelett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Omelett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7aa36c76-3608-30bd-8156-ed23925359bc",
                                        "entry_id": "1faec2a3-ac24-307d-be79-d89bd24a3416",
                                        "glosses": [
                                            "Eierkuchen, der aus verrührten Eiern, welche in der Pfanne angebraten werden, zubereitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d35698-4e29-4d79-9b8a-0db05743bd67",
                                                "sense_id": "7aa36c76-3608-30bd-8156-ed23925359bc",
                                                "text": "Als wir neulich bei einem Arbeitskollegen eingeladen waren, gab es leckere Omeletts zu essen."
                                            },
                                            {
                                                "example_id": "1ee7c59a-0034-4983-b0ff-f9d5bf4945a5",
                                                "sense_id": "7aa36c76-3608-30bd-8156-ed23925359bc",
                                                "text": "Dieses Rezept ergibt sieben Omelette."
                                            },
                                            {
                                                "example_id": "5f3586aa-225e-49a9-9da4-2853d0eede42",
                                                "sense_id": "7aa36c76-3608-30bd-8156-ed23925359bc",
                                                "text": "Heute essen wir Omelett."
                                            },
                                            {
                                                "example_id": "4ef50e4c-4678-4a8a-a1ef-e9db5e70c3c2",
                                                "sense_id": "7aa36c76-3608-30bd-8156-ed23925359bc",
                                                "text": "„Er hatte nicht mit ihr zum Essen gerechnet, sagte aber nichts, teilte das Omelett und legte eine Hälfte für sie auf einen Teller.“"
                                            },
                                            {
                                                "example_id": "47c31f78-3d59-49be-98e5-3702be71e725",
                                                "sense_id": "7aa36c76-3608-30bd-8156-ed23925359bc",
                                                "text": "„Ich bestellte ein Omelett und eine Cola und aß, während ich im Bett lag und fernsah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e250b4a-85aa-4813-9870-95c1c5f89256",
                        "source_entry_id": "575e8feb-862d-343f-a67c-d986ed1581e2",
                        "source_sense_id": "707d7f3d-50df-31e2-af5a-65ab70a183d6",
                        "target_lang_word": "Omelette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Omelette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84d4ab91-24c1-3c13-bc6d-c153853ab948",
                                        "entry_id": "f60c60bc-3995-3768-9814-a99e7cea1049",
                                        "glosses": [
                                            "Omelett"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1c68e25-6aaa-4119-abfd-f6e095b5650e",
                                                "sense_id": "84d4ab91-24c1-3c13-bc6d-c153853ab948",
                                                "text": "„Für mich ließ sie eine heiße Omelette machen, die sie mit selbst eingemachten Erdbeeren füllte.“"
                                            },
                                            {
                                                "example_id": "f04d1c0a-0a6a-467e-8400-3577fa4b5511",
                                                "sense_id": "84d4ab91-24c1-3c13-bc6d-c153853ab948",
                                                "text": "„Und sie versprach leichte Kost, Milch, Eier, geröstetes Brot, Gemüsesuppen, ein gutes rotes Beefsteak mit Spinat zu Mittag und hinterdrein eine handliche Omelette mit Apfel-Marmelade darin, kurz, Dinge, die nährten und dabei einem heikligen Magen genehm seien wie also dem seinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
