                "senses": [
                    {
                        "sense_id": "d8f58ebb-fe21-3580-b413-8ac359f6f821",
                        "entry_id": "f5cb0e8e-3d31-3d12-badd-ac3018b11686",
                        "glosses": [
                            "Auteur de pamphlets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d85a43-a132-4a3a-97eb-3228ab553666",
                                "sense_id": "d8f58ebb-fe21-3580-b413-8ac359f6f821",
                                "text": "Le pamphlétaire de la France Juive peut se vanter d’avoir trouvé le bon coin et le bon endroit."
                            },
                            {
                                "example_id": "52672252-2876-43e1-9614-5213108b8a11",
                                "sense_id": "d8f58ebb-fe21-3580-b413-8ac359f6f821",
                                "text": "Le roi, en 1837, ne put parvenir à faire doter le duc de Nemours : le pamphlétaire Cormenin avait trop vigoureusement attaqué cette dotation."
                            },
                            {
                                "example_id": "d853f3cb-e643-4858-be19-e7dbd56d4f0d",
                                "sense_id": "d8f58ebb-fe21-3580-b413-8ac359f6f821",
                                "text": "En littérature, le pamphlet a cédé la place à l'essai. L'essayiste sème sa pensée dans les sillons qu'a creusés la mode. Le pamphlétaire laboure à côté. C'est mal vu."
                            }
                        ]
                    }
