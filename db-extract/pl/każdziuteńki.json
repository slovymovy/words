                        "sense_id": "74e0e709-d62e-35d5-bfb1-8cddeeb0e019",
                        "entry_id": "31c12d0b-07bc-3913-9fda-2988edad876e",
                        "glosses": [
                            "od: każdy"
                        ],
                        "tags": [
                            "colloquial",
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "643b251b-dd7f-4c45-9ffb-30e45eeff1cf",
                                "sense_id": "74e0e709-d62e-35d5-bfb1-8cddeeb0e019",
                                "text": "Wzięła taką paczkę i zaczęła liczyć koperty, każdą, każdziuteńką bez wyjątku traktując poślinionym obficie palcem, aż cmokało"
                            },
                            {
                                "example_id": "c59a467e-0897-4ee7-95f9-463691d054f4",
                                "sense_id": "74e0e709-d62e-35d5-bfb1-8cddeeb0e019",
                                "text": "Na ryby – w każdziuteńki wolny dzień // Na ryby– nad leniwą rzeczkę w cień // zabieramy sprzęt i starkę…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
