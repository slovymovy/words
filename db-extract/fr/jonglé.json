                        "glosses": [
                            "Qui contient ou fait référence à des éléments de jonglage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd8cb80-d6b4-45fa-aa45-d4436467b0ce",
                                "sense_id": "4b1679f6-fa01-30ee-84c2-9aeabc098d46",
                                "text": "Parcours jonglé enchaîné avec une passe croisée."
                            },
                            {
                                "example_id": "7b497364-d39a-4494-b3bb-2d4f505039d2",
                                "sense_id": "4b1679f6-fa01-30ee-84c2-9aeabc098d46",
                                "text": "En lâche-t-il une par mégarde, celle-ci retrouve aussitôt sa place dans la continuité jonglée, à moins que l'artiste n'en lâche une autre intentionnellement, pour créer avec la première un effet de symétrie et faire doute le spectateur de son inadvertance."
                            }
                        ]
                    }
                ],
