                                            {
                                                "example_id": "421cd527-b998-43c5-9380-e7bb99fc95d9",
                                                "sense_id": "86b3adc2-29bd-361a-8d4d-d055e08772f9",
                                                "text": "„Ein Sumpf zieht am Gebirge hin, verpestet alles schon Errungene; den faulen Pfuhl auch abzuziehn, das Letzte wär’ das Höchsterrungene.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bd76019-eb30-33d9-8ce9-3fe2256daaab",
                                        "entry_id": "1222cc5b-3b0a-33a2-8f59-fbbaf7bc565d",
                                        "glosses": [
                                            "Sinnbild für Schmutz, für Sünde"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e63e07de-d1a8-4f5a-b80e-05f34393e032",
                                                "sense_id": "9bd76019-eb30-33d9-8ce9-3fe2256daaab",
                                                "text": "„Ganz ähnlich jenem ersten abscheulichen Rädelsführer, der tausend Legionen schuldloser Engel in rebellisches Feuer fachte und mit sich hinab in den tiefen Pfuhl der Verdammung zog“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c95012a-ab99-3c20-9342-acff285bb9bf",
