                                            },
                                            {
                                                "example_id": "bdeb4bf4-746f-45c7-8359-56ffb03aa92f",
                                                "sense_id": "097d3ce5-aaa5-39d2-a5f7-5cc471c68858",
                                                "text": "achievable score"
                                            },
                                            {
                                                "example_id": "0c4c903e-76a6-4a7f-80f5-2c32ea5865c9",
                                                "sense_id": "097d3ce5-aaa5-39d2-a5f7-5cc471c68858",
                                                "text": "Kelly adds that \"more electric haulage of freight, therefore speeding it up\" is key here. And he hopes that is achievable in the next five years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20690d1-7810-3a68-ad5d-082cb4b88351",
