        "ru-extract.jsonl": [
            {
                "entry_id": "b1cef613-0c3b-3346-971c-b1c61ec4020b",
                "word": "некрасиво",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2987f0a6-24b8-34da-ad8c-781778ab767a",
                        "entry_id": "b1cef613-0c3b-3346-971c-b1c61ec4020b",
                        "glosses": [
                            "наречие к некрасивый"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "90d759a3-f21f-415b-a817-6af8c3585c5e",
                                "sense_id": "2987f0a6-24b8-34da-ad8c-781778ab767a",
                                "text": "У иных были лица, точно дурно высеченный хлеб: щеку раздуло в одну сторону, подбородок покосило в другую, верхнюю губу вынесло пузырем, которая в прибавку к тому еще и треснула; словом, совсем некрасиво."
                            },
                            {
                                "example_id": "2da39f64-7dda-455f-9962-60dd29117b63",
                                "sense_id": "2987f0a6-24b8-34da-ad8c-781778ab767a",
                                "text": "Силыч был среднего роста, некрасиво скроен, но крепко сшит и обладал замечательной силой…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f5851013-34da-376e-93e6-f36756c4facc",
                        "entry_id": "b1cef613-0c3b-3346-971c-b1c61ec4020b",
                        "glosses": [
                            "является некрасивым"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "3ece5dfb-2480-49c4-a2f1-111a77c144fc",
                                "sense_id": "f5851013-34da-376e-93e6-f36756c4facc",
                                "text": "Я знаю, что было бы очень некрасиво, если б вдруг все стали ничего не делать."
                            },
                            {
                                "example_id": "47fd0d55-790a-4998-9d6d-2e6c2338e5d5",
                                "sense_id": "f5851013-34da-376e-93e6-f36756c4facc",
                                "text": "Да и кая польза вдаваться в исследования, коль скоро тебя каждоминутно подмывает заглянуть в другую комнату, не шмыгнул ли там кто? По-моему, это предосудительно и даже… некрасиво!"
                            }
                        ]
                    }
                ],
