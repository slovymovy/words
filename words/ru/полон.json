                    "sense_definition": "Мужское имя.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего хорошего друга зовут <w>Полон</w>.",
                            "target_lang_translations": {
                                "en": "My good friend is named <w>Polon</w>."
                            }
                        },
                        {
                            "text": "Я познакомился с человеком по имени <w>Полон</w> на конференции.",
                            "target_lang_translations": {
                                "en": "I met a man named <w>Polon</w> at the conference."
                            }
                        }
                    ],
                    "target_lang_definitions": {
