                                            {
                                                "example_id": "c8de80ea-21b0-4c24-9b57-159bbc044071",
                                                "sense_id": "7d2ff282-8fd6-3772-bb49-8d7c776aef4b",
                                                "text": "Hochschulen wollen in Deutschland zukünftig die Studierenden nach eigenen Kriterien auswählen dürfen."
