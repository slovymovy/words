                                        "sense_id": "15f837cb-1f4d-3918-8863-f2efe0f38847",
                                        "entry_id": "e0759f5c-a727-32a2-9ba2-1633c6e84c29",
                                        "glosses": [
                                            "Cualidad de aquello que no tiene una existencia real."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f495ce-ebc5-4102-8adf-f152123959ac",
                                                "sense_id": "15f837cb-1f4d-3918-8863-f2efe0f38847",
                                                "text": "Una vaga sensación de haber participado en alguna extraña tragedia se le pasó por la cabeza una o dos veces, pero con la irrealidad de un sueño"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
