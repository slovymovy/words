                        "examples": [
                            {
                                "example_id": "3579b511-1200-44b2-8e52-8f0fcb708445",
                                "sense_id": "cbd5c9c1-7b66-35f6-9d22-c9a6316ebcb7",
                                "text": "Alien introduceerde ook de eerste echte vrouwelijke actieheldin. Sigourney Weaver maakte van astronaut Ripley een onvergetelijke vertolking die weliswaar doodsbang is, maar voldoende inventief is om het monster af te troeven."
                            },
                            {
                                "example_id": "fd1141de-06bb-4460-a1ae-da2a11779445",
                                "sense_id": "cbd5c9c1-7b66-35f6-9d22-c9a6316ebcb7",
                                "text": "Zodra Moss 40 was geworden, kreeg zij opeens oma-rollen aangeboden. Moss, nu 53, is binnenkort overigens te zien als actieheldin in het vierde deel van The Matrix."
                            }
                        ]
