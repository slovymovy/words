                "senses": [
                    {
                        "sense_id": "35c7a7e9-997a-355c-893d-ef45f70ce95e",
                        "entry_id": "f7fab893-db14-3065-b689-a2e0cb261354",
                        "glosses": [
                            "Lemmus Link, niewielki gryzoń występujący licznie w tundrze północnej Europy, Azji i Ameryki Północnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec88b7d-b443-462a-bd05-8f0302973d32",
                                "sense_id": "35c7a7e9-997a-355c-893d-ef45f70ce95e",
                                "text": "W populacjach lemingów występują cykliczne zmiany liczebności"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c08d8260-9c34-4ebd-92d1-d8db0b61c5ad",
                        "source_entry_id": "f7fab893-db14-3065-b689-a2e0cb261354",
                        "source_sense_id": "35c7a7e9-997a-355c-893d-ef45f70ce95e",
                        "target_lang_word": "lemming",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "009c4bc0-3936-3041-9197-6f62e1919ba6",
                                        "entry_id": "1b72e009-28af-3472-bdba-6e93cf148639",
                                        "glosses": [
                                            "A small arctic and subarctic rodent of the tribes Lemmini, Dicrostonychini and Lagurini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2132e0cc-b058-4cb7-a3ad-b62c063ce8a9",
                                                "sense_id": "009c4bc0-3936-3041-9197-6f62e1919ba6",
                                                "text": "The well-known lemmings, in severe winters, at long intervals, move down from the mountains of Scandinavia in immense numbers, crossing lakes and rivers, eating their way through haystacks, and surmounting every obstacle till they reach the sea, whence very few return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968e179e-7ffe-3fb6-8229-3ec32336cc42",
                                        "entry_id": "1b72e009-28af-3472-bdba-6e93cf148639",
                                        "glosses": [
                                            "Any member of a group given to conformity or groupthink, especially a group poised to follow a leader off a cliff."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23374f3d-d4be-4fe8-8ef2-e2d0e36fd21c",
                                                "sense_id": "968e179e-7ffe-3fb6-8229-3ec32336cc42",
                                                "text": "Lemmings are strongly cohesive, but could be, in organisational terms, highly destructive for the business."
                                            },
                                            {
                                                "example_id": "42bd7697-332e-46a5-b8eb-d24382353c92",
                                                "sense_id": "968e179e-7ffe-3fb6-8229-3ec32336cc42",
                                                "text": "Like a lemming, I followed the crowd, got to the right line and was concentrating hard when queried by the customs officer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dceeaec-ffb9-4533-b354-f6a2755b39cf",
                        "source_entry_id": "f7fab893-db14-3065-b689-a2e0cb261354",
                        "source_sense_id": "35c7a7e9-997a-355c-893d-ef45f70ce95e",
                        "target_lang_word": "lemming",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemming",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                        "entry_id": "da3045a4-fcc0-3d99-a360-8ef68214d9e0",
                                        "glosses": [
                                            "Petit rongeur subnival vivant généralement dans les régions arctiques, et migrateur."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34f4bae0-43fe-4485-938e-ecbb1bc82ab2",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "Linné est le premier naturaliste qui ait étudié les Lemmings dans les montagnes de la Laponie, mais il n’assista point à une migration."
                                            },
                                            {
                                                "example_id": "84ce2321-2a66-4075-b434-b30e1aa58c3e",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "En tête du cortège, les lemmings au pelage tacheté de jaune ambré, de roux et de noir."
                                            },
                                            {
                                                "example_id": "d68d230a-bb4a-473d-81e5-e7934fc81ef6",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "Quand au danger que pourraient représenter les rapaces pour les oies, il est négligeable. S'ils ne dédaignent pas un oison à l'occasion, ils préfèrent de loin les lemmings."
                                            },
                                            {
                                                "example_id": "bc7f0461-2d00-46e3-a5af-cae111eb0941",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "Les migrations du lemming dans les contrées septentrionales."
                                            },
                                            {
                                                "example_id": "3b1b443c-5768-4e81-8933-9ad38b911770",
                                                "sense_id": "546e5f5e-9d8d-3359-8ccd-8c5fa62bf737",
                                                "text": "En mentant de façon flagrante sur l’intégrité du vote, il a galvanisé les dizaines de millions d’Américains qui le suivent tels des lemmings vers le précipice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aca7703-0e46-4e86-9e3c-7571ecefe4a4",
                        "source_entry_id": "f7fab893-db14-3065-b689-a2e0cb261354",
                        "source_sense_id": "35c7a7e9-997a-355c-893d-ef45f70ce95e",
                        "target_lang_word": "lemming",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemming",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1132abb6-e3cc-3932-884f-83043cc6296a",
                                        "entry_id": "f832881b-5c4c-33dd-a36a-67c4555f82f6",
                                        "glosses": [
                                            "een knaagdier dat vooral in het hoge noorden op de toendra's voorkomt"
                                        ],
                                        "tags": [
                                            "knaagdieren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e9a31e-a763-428f-aba4-3cb297889f34",
                                                "sense_id": "1132abb6-e3cc-3932-884f-83043cc6296a",
                                                "text": "Als ze in het noorden van Canada wil overleven, moet ze haar dieet volgens de onderzoekers wel aanpassen. Daar leven vossen vooral van lemmingen, in Spitsbergen eten ze vooral zeedieren als zeevogels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8875a18-809f-4029-942c-289e1b5b2f5a",
                        "source_entry_id": "f7fab893-db14-3065-b689-a2e0cb261354",
                        "source_sense_id": "35c7a7e9-997a-355c-893d-ef45f70ce95e",
                        "target_lang_word": "лемминг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лемминг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd95064-0157-39e5-93a4-0e3319a4d368",
                                        "entry_id": "9b188423-952c-38ee-9827-2c114e76c1d1",
                                        "glosses": [
                                            "зоол. небольшой зверёк подсемейства полёвковых семейства хомяков, грызун с длинной буро-желтой пятнистой шерстью, обитающий в лесах и тундре Евразии и Северной Америки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16bc071-9fcf-41c7-b697-177417aea22f",
                                                "sense_id": "1bd95064-0157-39e5-93a4-0e3319a4d368",
                                                "text": "Переселяющиеся лемминги, издавая писк определённой частоты, способны увлечь за собой даже овцебыков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d961ca-de26-3cbf-9357-4adbeb93146a",
                                        "entry_id": "9b188423-952c-38ee-9827-2c114e76c1d1",
                                        "glosses": [
                                            "перен., интернет. недалёкий человек с ограниченными интересами, бездумно следующий за толпой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14c27ed9-f30a-4058-8528-bdbe2216f210",
                                                "sense_id": "64d961ca-de26-3cbf-9357-4adbeb93146a",
                                                "text": "Обычные клубные лемминги, обитающие в ночных заведениях и отсыпающие свое днем в офисных клетках."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
