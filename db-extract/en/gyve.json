{
    "word": "gyve",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7bafea20-b06b-3733-ab0a-d0e0a8ecdb6e",
                "word": "gyve",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5bb511a4-4ac0-4ae1-972b-02bcf35ac0ee",
                        "entry_id": "7bafea20-b06b-3733-ab0a-d0e0a8ecdb6e",
                        "tags": [
                            "plural"
                        ],
                        "form": "gyves"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21ea1776-4b9f-300e-b660-f73012c43e6b",
                        "entry_id": "7bafea20-b06b-3733-ab0a-d0e0a8ecdb6e",
                        "glosses": [
                            "A shackle or fetter, especially for the leg."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "c590d1ad-b12e-41ae-a35e-98d35d0410df",
                                "sense_id": "21ea1776-4b9f-300e-b660-f73012c43e6b",
                                "text": "[…] I would have thee gone:\nAnd yet no further than a wanton’s bird;\nWho lets it hop a little from her hand,\nLike a poor prisoner in his twisted gyves,\nAnd with a silk thread plucks it back again,\nSo loving-jealous of his liberty."
                            },
                            {
                                "example_id": "2ca27c8b-47ed-40fe-9485-b60e4bbd95da",
                                "sense_id": "21ea1776-4b9f-300e-b660-f73012c43e6b",
                                "text": "With head and heart and hand I’ll strive\nTo break the rod, and rend the gyve,—\nThe spoiler of his prey deprive,—"
                            },
                            {
                                "example_id": "1d9db106-7f39-44e9-8262-0ad327e957d9",
                                "sense_id": "21ea1776-4b9f-300e-b660-f73012c43e6b",
                                "text": "Our gyves were removed and our possessions returned to us, except for my Banker’s Special."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "19a209f3-f7a9-3bbb-976c-98644b33325a",
                "word": "gyve",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c8234dda-e4e2-463e-8907-d026a62327b7",
                        "entry_id": "19a209f3-f7a9-3bbb-976c-98644b33325a",
                        "tags": [
                            "present",
