                                        "entry_id": "3e8a1e01-a3d1-33fc-bcde-3aba11e006a1",
                                        "glosses": [
                                            "A contiguous showcase of still images of a fashion designer or fashion brand’s collection."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39b9a398-b495-4fc4-9585-90dd8954a484",
                                                "sense_id": "69489368-c37d-356e-9ebe-7ea5b8c8ad6b",
                                                "text": "A new line called Suno replicated the staging of Mr. Sidibé’s photographs for its lookbook, right down to the checkerboard marble floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a403814e-30c0-3907-93c7-46b123eb3731",
                                        "entry_id": "3e8a1e01-a3d1-33fc-bcde-3aba11e006a1",
                                        "glosses": [
                                            "A showcase of photographs etc. describing how a film should look."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6240af5-528e-4f24-b10d-d02e3f94b44b",
                                                "sense_id": "a403814e-30c0-3907-93c7-46b123eb3731",
                                                "text": "Mainly useful for feature films, the look book helps define the look in terms of the cinematography and design that you hope to achieve. It can contain stills from other films or photos as a visual reference […]"
                                            }
                                        ]
                                    }
                                ]
                            },
