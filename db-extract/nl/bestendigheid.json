                                        "sense_id": "c7b64c81-8f4b-37a9-8ae4-d65ddfb0929f",
                                        "entry_id": "f2712c6d-5461-3e84-8c87-2a1e3b593952",
                                        "glosses": [
                                            "The tendency to recover from perturbations."
