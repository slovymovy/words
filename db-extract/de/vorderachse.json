                "senses": [
                    {
                        "sense_id": "8c99d57f-5f2f-3558-ac7a-3efca89b3606",
                        "entry_id": "800fdf5f-f5bd-336a-bc61-c448cba51adf",
                        "glosses": [
                            "vor dem Fahrzeugschwerpunkt angebrachte Achse, die die Vorderräder trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a111a77a-17ba-4791-9ebd-e250f4a62cbb",
                                "sense_id": "8c99d57f-5f2f-3558-ac7a-3efca89b3606",
                                "text": "„Das Modell Dynamic verfügte unter anderem über ein Zweikreis-Bremssystem und eine Einzelradaufhängung an der Vorderachse.“"
                            },
                            {
                                "example_id": "7f88c5a1-76c8-45b9-9b56-5c986f8e7932",
                                "sense_id": "8c99d57f-5f2f-3558-ac7a-3efca89b3606",
                                "text": "„Der Stellmacher wohnte eine Viertelmeile entfernt; ich dachte zuerst daran, die Deichsel mit Stricken an die Vorderachse zu binden und den Wagen hinzufahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
