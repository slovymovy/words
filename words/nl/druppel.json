                },
                {
                    "sense_id": "b9a03ccd-80d4-3b55-8269-0dc8dee5e7ad",
                    "sense_definition": "gebiedende wijs van <w>druppelen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Druppel</w> de saus langzaam over het vlees voor de beste smaak.",
                            "target_lang_translations": {
                                "en": "<w>Drizzle</w> the sauce slowly over the meat for the best flavor.",
                                "ru": "<w>Полей</w> мясо соусом по капле для лучшего вкуса."
                            }
                        },
                        {
                            "text": "<w>Druppel</w> niet op de vloer terwijl je de natte paraplu vasthoudt.",
                            "target_lang_translations": {
                                "en": "Do not <w>drip</w> on the floor while holding the wet umbrella.",
                                "ru": "Не <w>капай</w> на пол, пока держишь мокрый зонт."
                            }
                        }
