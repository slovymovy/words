                        "curieusement calme"
                    ]
                },
                {
                    "sense_id": "8d5726c4-7dd5-337c-9520-e76a2c8c15df",
                    "sense_definition": "Avec curiosité, avec le désir attentif d'apprendre, de voir ou de savoir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'est penché pour regarder <w>curieusement</w> l'intérieur du paquet mystérieux."
                        },
                        {
                            "text": "Le voyageur observait <w>curieusement</w> les coutumes et les danses des habitants locaux."
                        }
                    ],
                    "common_phrases": [
                        "regarder curieusement",
                        "observer curieusement"
                    ]
                },
                {
