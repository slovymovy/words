{
    "word_family": [
        "смутить",
        "смутиться",
        "смущение",
        "смущённо",
        "смущённость"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71da2191-487e-3372-bb91-43fddbe7da90",
                    "sense_definition": "Испытывающий неловкость, замешательство или стыд; находящийся в состоянии смущения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feeling_embarrassed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он стоял перед учителем с совершенно <w>смущённым</w> видом, не зная, что ответить на вопрос.",
                            "target_lang_translations": {
                                "en": "He stood before the teacher looking completely <w>embarrassed</w>, not knowing how to answer the question."
                            }
                        },
                        {
                            "text": "Она почувствовала себя крайне <w>смущённой</w>, когда все гости внезапно замолчали и посмотрели на неё.",
                            "target_lang_translations": {
                                "en": "She felt extremely <w>embarrassed</w> when all the guests suddenly fell silent and looked at her."
                            }
                        }
                    ],
                    "synonyms": [
                        "сбитый с толку",
                        "смятенный"
                    ],
                    "antonyms": [
                        "уверенный",
                        "решительный"
                    ],
                    "common_phrases": [
                        "смущённый вид",
                        "смущённый юноша"
                    ],
                    "target_lang_definitions": {
                        "en": "Feeling awkward, self-conscious, or ashamed; being in a state of embarrassment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "embarrassed",
                                "target_lang_sense_clarification": "feeling self-conscious, awkward, or ashamed"
                            },
                            {
                                "target_lang_word": "confused",
                                "target_lang_sense_clarification": "disconcerted or flustered"
                            },
                            {
                                "target_lang_word": "abashed",
                                "target_lang_sense_clarification": "embarrassed and disconcerted"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da705566-6ede-317f-a8a8-d2bc5798694e",
                    "sense_definition": "Выражающий замешательство, неловкость или стыд (о взгляде, улыбке, голосе и т. д.).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expressing_embarrassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На её лице появилась слабая, <w>смущённая</w> улыбка, когда ей сделали неожиданный комплимент.",
                            "target_lang_translations": {
                                "en": "A faint, <w>sheepish</w> smile appeared on her face when she was given an unexpected compliment."
                            }
                        },
                        {
                            "text": "Он ответил тихим и <w>смущённым</w> голосом, стараясь не смотреть собеседнику в глаза.",
                            "target_lang_translations": {
                                "en": "He answered in a quiet and <w>embarrassed</w> voice, trying not to look his interlocutor in the eye."
                            }
                        }
                    ],
                    "synonyms": [
                        "смятенный"
                    ],
                    "antonyms": [
                        "уверенный",
                        "дерзкий"
                    ],
                    "common_phrases": [
                        "смущённая улыбка",
                        "смущённый взгляд"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing embarrassment, awkwardness, or shame (of a look, smile, voice, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "embarrassed",
                                "target_lang_sense_clarification": "showing or expressing embarrassment"
                            },
                            {
                                "target_lang_word": "sheepish",
                                "target_lang_sense_clarification": "showing embarrassment from shame or a lack of self-confidence"
                            },
                            {
                                "target_lang_word": "abashed",
                                "target_lang_sense_clarification": "expressing disconcertion or shame"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a719b058-e751-3116-b165-5d8a390426ea",
                    "sense_definition": "Страдательное причастие прошедшего времени совершенного вида от глагола <w>смутить</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Шум в зале был внезапно прерван, и докладчик, явно <w>смущённый</w> такой реакцией, замолчал.",
                            "target_lang_translations": {
                                "en": "The noise in the hall was suddenly cut short, and the speaker, clearly <w>disconcerted</w> by such a reaction, fell silent."
                            }
                        },
                        {
                            "text": "Отец был глубоко <w>смущён</w> поведением своего сына на праздничном ужине.",
                            "target_lang_translations": {
                                "en": "The father was deeply <w>embarrassed</w> by his son's behavior at the festive dinner."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'смутить' (to embarrass, confuse, or disconcert)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "embarrassed",
                                "target_lang_sense_clarification": "made to feel self-conscious or ashamed"
                            },
                            {
                                "target_lang_word": "confused",
                                "target_lang_sense_clarification": "disconcerted or thrown off balance"
                            },
                            {
                                "target_lang_word": "disconcerted",
                                "target_lang_sense_clarification": "disturbed, unsettled, or confused"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}