                                    },
                                    {
                                        "sense_id": "8c4f1e50-5539-3190-b8a7-90d6018351bc",
                                        "entry_id": "c53577e3-84cf-3ea1-be1a-6bcdd882983e",
                                        "glosses": [
                                            "Alone, without another's immediate company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba115a7-4ab1-4c73-ba53-5078f684ec3f",
                                                "sense_id": "8c4f1e50-5539-3190-b8a7-90d6018351bc",
                                                "text": "She sat by herself in the corner, waiting quietly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d88495b1-c607-3f79-ba41-2e11e8a5ec6f",
