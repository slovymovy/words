                                        "glosses": [
                                            "Causing apprehension, fear or alarm; frightening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05488f1-4201-4d5c-8c45-9bc29691de95",
                                                "sense_id": "0d8493be-3f64-3520-a002-50221512655e",
                                                "text": "Another stop at the 731-yard Sharpthorne Tunnel allowed the apprentices to see how a combination of water and a \"chemical soup\" is destroying the rails at an alarming rate."
