            "senses": [
                {
                    "sense_id": "a77632df-fdb0-3db8-b913-832333e2af00",
                    "sense_definition": "To remove or alter parts of a text, film, or other work that are considered offensive, vulgar, or unseemly, often resulting in a weakened version.",
