                        "glosses": [
                            "A North American wild duck, Aythya valisineria, popular as a game bird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696cfa37-7169-4f5c-8c81-e88d7b5d70a6",
                                "sense_id": "2c081939-6163-3ac8-829c-af4bcf5233ff",
                                "text": "1857 The Private Correspondence of Daniel Webster\nYesterday, I received a great present from Mr. Webster, from Washington; a large basket of canvasback ducks and a large turkey."
                            },
                            {
                                "example_id": "4ef1c324-e1b1-4870-bfc7-41f044977a70",
                                "sense_id": "2c081939-6163-3ac8-829c-af4bcf5233ff",
                                "text": "The native State of Patrick Henry Hanway was a moss-grown member of the republic and had been one of the original thirteen. It possessed with other impedimenta a moss-grown aristocracy that borrowed money, devoured canvasbacks, drank burgundy, wore spotless tow in summer, clung to the duello, and talked of days of greatness which had been before the war."
                            }
                        ]
                    }
