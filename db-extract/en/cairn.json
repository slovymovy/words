                                        "sense_id": "e2a07873-ddff-31c7-80ad-d7f3d9ef5f0d",
                                        "entry_id": "fbf5aacc-75c8-35cf-ae5a-4c808e78f5af",
                                        "glosses": [
                                            "форма родительного падежа множественного числа существительного тура"
                                        ],
