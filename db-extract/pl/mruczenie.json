                "translations": [
                    {
                        "translation_id": "5e85f83c-809b-4115-9c95-c6fea94a6e37",
                        "source_entry_id": "e536d050-6bc9-33c3-b037-4b394b0ebd0e",
                        "source_sense_id": "1d8d6a36-e874-3f18-9352-059d69d90380",
                        "target_lang_word": "murmure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "murmure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fe2c770-cf35-3b14-bb50-19149833af5f",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Bruit de voix sourd et confus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "816e865c-ceb5-4cb8-a4c5-ec6acee27361",
                                                "sense_id": "9fe2c770-cf35-3b14-bb50-19149833af5f",
                                                "text": "Et je n’entendis plus qu’un murmure confus, semblable au murmure de la marée montante, ou au rugissement sauvage qui s’élève dans le bestiaire quand on vient d’ouvrir l’arène."
                                            },
                                            {
                                                "example_id": "9d227327-7a25-4af2-b090-f9e850729c5c",
                                                "sense_id": "9fe2c770-cf35-3b14-bb50-19149833af5f",
                                                "text": "Le sang coule à flots. Le gémissement des blessés, le murmure étouffé de ceux qui s’efforcent de se dégager de cette mêlée de mort et de mourants, navrent le cœur du soldat, auteur innocent de ce massacre."
                                            },
                                            {
                                                "example_id": "cb42b409-07cc-4333-9636-750e31a540b0",
                                                "sense_id": "9fe2c770-cf35-3b14-bb50-19149833af5f",
                                                "text": "Brrr ! fit Bert, en se cramponnant à la balustrade, et quelques soldats auprès de lui firent entendre un murmure d’horreur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd4ea17-d66c-38a6-a15d-a9b69870238e",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Bruit et les plaintes que font des personnes mécontentes."
                                        ],
                                        "tags": [
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55432139-228b-4cbf-b71e-2c30ccf4b477",
                                                "sense_id": "ebd4ea17-d66c-38a6-a15d-a9b69870238e",
                                                "text": "Le nouvel impôt a excité de grands murmures."
                                            },
                                            {
                                                "example_id": "29388c8b-29e9-48ef-9ad2-bc6dc29bae65",
                                                "sense_id": "ebd4ea17-d66c-38a6-a15d-a9b69870238e",
                                                "text": "Des murmures se sont élevés contre cette mesure."
                                            },
                                            {
                                                "example_id": "f5f0d79e-1007-47e9-b62f-6a08487059fb",
                                                "sense_id": "ebd4ea17-d66c-38a6-a15d-a9b69870238e",
                                                "text": "Un début d’émeute se produit le mardi 18 mai, lorsque François Renard, marchand et notable du conseil général de la commune, refuse de vendre du blé à des habitants de Bruyères ; des murmures se développent et « sa personne et ses biens sont exposés à l’animosité du peuple » […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68784c82-4c29-35c6-8dfd-3d4e81562463",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Plainte sourde d’une seule personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e027ca-7c5b-4fd5-8b39-ca549f72d799",
                                                "sense_id": "68784c82-4c29-35c6-8dfd-3d4e81562463",
                                                "text": "Il apprit le coup qui le frappait sans se permettre le moindre murmure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d0781dd-7ef8-349e-b63f-cb00cb159138",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Parole dite à voix très basse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecc2ea5d-c8ad-464c-8739-2a3299ff935e",
                                                "sense_id": "5d0781dd-7ef8-349e-b63f-cb00cb159138",
                                                "text": "Je ne sais pas écrire la poésie du cri ou de la révolte. J'expérimente plutôt le murmure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a1cb31-e00d-359c-8a9c-5a4d88e67c77",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Mouvement secret de l’âme."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73ce3f82-eb0e-488a-9969-be0c1eec09f0",
                                                "sense_id": "e7a1cb31-e00d-359c-8a9c-5a4d88e67c77",
                                                "text": "Il eut bien de la peine à étouffer les murmures de son cœur."
                                            },
                                            {
                                                "example_id": "622685b7-1abc-4d2b-9709-0ed3f2db3d1a",
                                                "sense_id": "e7a1cb31-e00d-359c-8a9c-5a4d88e67c77",
                                                "text": "La voix de la raison étouffa en lui les murmures de l’amour."
                                            },
                                            {
                                                "example_id": "e65237e6-fe52-4662-84e7-10c748c8e1eb",
                                                "sense_id": "e7a1cb31-e00d-359c-8a9c-5a4d88e67c77",
                                                "text": "Les murmures du sang, les murmures de la vanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b66d63f-7638-34bc-8ee6-1376bd4bb459",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Bruissement léger que font les eaux en coulant, ou le vent quand il agite doucement les feuilles des arbres, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9618411c-aea4-44bf-93d5-9a2d15068413",
                                                "sense_id": "1b66d63f-7638-34bc-8ee6-1376bd4bb459",
                                                "text": "La basse-cour, les écuries, l’étable reportées dans les bâtiments de la faisanderie et cachées par des massifs, au lieu d’attrister le regard par leurs inconvénients, mêlaient au continuel bruissement particulier aux forêts ces murmures, ces roucoulements, ces battements d’ailes, l’un des plus délicieux accompagnements de la continuelle mélodie que chante la nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc25562-1795-30e1-9c03-3949d0e6ed2b",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Bruit léger que l’on entend en auscultant, lorsque les poumons sont sains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b063a45-bf28-4635-bbec-f97e60f95a4d",
                                                "sense_id": "afc25562-1795-30e1-9c03-3949d0e6ed2b",
                                                "text": "Murmure respiratoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a9854fa-b831-3c1b-a980-7ec2f3f78e0c",
                                        "entry_id": "a7c06c52-fafe-3b62-90ac-fe9588d9e721",
                                        "glosses": [
                                            "Regroupement important d’oiseaux en vol, nuage d’oiseaux, en particulier des étourneaux."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "murmure",
