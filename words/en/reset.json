{
    "word_family": [
        "resettable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ecbc11d9-be7e-3af4-9dda-734312d13da4",
                    "sense_definition": "To set back to the initial state or condition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restore_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>reset</w> the router if the internet connection is slow.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>перезагрузите</w> роутер, если интернет работает медленно.",
                                "zh": "如果网络连接缓慢，请<w>重启</w>路由器。"
                            }
                        },
                        {
                            "text": "I had to <w>reset</w> my password because I forgot the old one.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>сбросить</w> пароль, так как я забыл старый.",
                                "zh": "因为忘记了旧密码，我不得不<w>重置</w>了密码。"
                            }
                        }
                    ],
                    "synonyms": [
                        "restart",
                        "reboot"
                    ],
                    "common_phrases": [
                        "reset the password",
                        "reset the clock",
                        "reset to default",
                        "reset the machine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть в исходное состояние или условие.",
                        "zh": "将设备、系统或设置恢复到初始状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбросить",
                                "target_lang_sense_clarification": "настройки, пароль"
                            },
                            {
                                "target_lang_word": "перезагрузить",
                                "target_lang_sense_clarification": "устройство, систему"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重置",
                                "target_lang_sense_clarification": "恢复初始设置或数据"
                            },
                            {
                                "target_lang_word": "重启",
                                "target_lang_sense_clarification": "重新启动设备或系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a904f903-5af3-37a5-8c58-87ab160533c7",
                    "sense_definition": "To adjust or position something differently, such as a broken bone or a gemstone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adjust_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor managed to <w>reset</w> the broken bone without needing surgery.",
                            "target_lang_translations": {
                                "ru": "Врачу удалось <w>вправить</w> сломанную кость без операции.",
                                "zh": "医生无需手术就成功地为他进行了骨折<w>复位</w>。"
                            }
                        },
                        {
                            "text": "She decided to <w>reset</w> the diamond in a more modern ring.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>переоправить</w> бриллиант в более современное кольцо.",
                                "zh": "她决定将这颗钻石<w>重新镶嵌</w>到一枚更现代的戒指上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reset a bone",
                        "reset a stone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вправить или изменить положение чего-либо (например, сломанной кости или драгоценного камня).",
                        "zh": "调整或改变某物的位置，例如复位骨折的骨头或重新镶嵌宝石。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вправить",
                                "target_lang_sense_clarification": "кость"
                            },
                            {
                                "target_lang_word": "переоправить",
                                "target_lang_sense_clarification": "драгоценный камень"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复位",
                                "target_lang_sense_clarification": "使骨折部位恢复原位"
                            },
                            {
                                "target_lang_word": "重新镶嵌",
                                "target_lang_sense_clarification": "更换宝石的底座"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f730a624-ddd1-34af-8c8a-cb4a0f474197",
                    "sense_definition": "To receive and hide stolen goods or criminals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a serious crime to <w>reset</w> goods taken during a robbery.",
                            "target_lang_translations": {
                                "ru": "Это серьезное преступление — <w>укрывать</w> вещи, похищенные во время ограбления.",
                                "zh": "非法<w>销赃</w>抢劫所得的财物是严重的犯罪行为。"
                            }
                        },
                        {
                            "text": "The gang was charged with conspiring to <w>reset</w> stolen property.",
                            "target_lang_translations": {
                                "ru": "Банде было предъявлено обвинение в сговоре с целью <w>сбыта</w> краденого имущества.",
                                "zh": "该团伙被指控密谋<w>窝藏</w>赃物。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать и укрывать краденые товары или преступников.",
                        "zh": "接收并藏匿赃物或窝藏罪犯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрывать краденое",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "销赃",
                                "target_lang_sense_clarification": "处理或隐藏赃物"
                            },
                            {
                                "target_lang_word": "窝藏",
                                "target_lang_sense_clarification": "非法藏匿罪犯或赃物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9972cbad-3bcc-3bb6-962a-38f3de078641",
                    "sense_definition": "The act of returning a device, system, or situation to its original condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "restore_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick <w>reset</w> usually fixes the software glitch.",
                            "target_lang_translations": {
                                "ru": "Быстрая <w>перезагрузка</w> обычно устраняет программный сбой.",
                                "zh": "快速<w>重启</w>通常能解决软件故障。"
                            }
                        },
                        {
                            "text": "The team needs a mental <w>reset</w> after the disappointing season.",
                            "target_lang_translations": {
                                "ru": "Команде нужна психологическая <w>перезагрузка</w> после неудачного сезона.",
                                "zh": "在令人失望的赛季之后，团队需要进行一次心理<w>调整</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zeroization"
                    ],
                    "common_phrases": [
                        "factory reset",
                        "hard reset",
                        "hit the reset"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по возвращению устройства, системы или ситуации в исходное состояние.",
                        "zh": "将设备、系统或情况恢复到原始状态的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сброс",
                                "target_lang_sense_clarification": "настроек, данных"
                            },
                            {
                                "target_lang_word": "перезагрузка",
                                "target_lang_sense_clarification": "системы, ментальная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重置",
                                "target_lang_sense_clarification": "恢复出厂设置或初始状态"
                            },
                            {
                                "target_lang_word": "重启",
                                "target_lang_sense_clarification": "系统重新启动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "087cae6c-76bf-3b63-8200-02b6b7b51a4d",
                    "sense_definition": "A device, such as a button or switch, used to restart a system.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "device_button",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a paperclip to press the <w>reset</w> on the back of the unit.",
                            "target_lang_translations": {
                                "ru": "Используйте скрепку, чтобы нажать кнопку <w>сброса</w> на задней панели устройства.",
                                "zh": "用回形针按下设备背面的<w>重置键</w>。"
                            }
                        },
                        {
                            "text": "I cannot find the <w>reset</w> for this game console.",
                            "target_lang_translations": {
                                "ru": "Я не могу найти кнопку <w>перезагрузки</w> на этой игровой консоли.",
                                "zh": "我找不到这台游戏机的<w>重启键</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "press the reset",
                        "reset button"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, такое как кнопка или переключатель, используемое для перезапуска системы.",
                        "zh": "用于重启系统的装置，如按钮或开关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кнопка сброса",
                                "target_lang_sense_clarification": "элемент управления"
                            },
                            {
                                "target_lang_word": "кнопка перезагрузки",
                                "target_lang_sense_clarification": "элемент управления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重置键",
                                "target_lang_sense_clarification": "用于恢复初始状态的按钮"
                            },
                            {
                                "target_lang_word": "重启键",
                                "target_lang_sense_clarification": "用于重新启动的按钮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f48d65b-3453-327b-9036-caaab7803293",
                    "sense_definition": "The crime of knowingly receiving stolen goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury found him guilty of theft and <w>reset</w>.",
                            "target_lang_translations": {
                                "ru": "Присяжные признали его виновным в краже и <w>укрывательстве краденого</w>.",
                                "zh": "陪审团裁定他犯有盗窃罪和<w>销赃罪</w>。"
                            }
                        },
                        {
                            "text": "Charges of <w>reset</w> were brought against the shopkeeper.",
                            "target_lang_translations": {
                                "ru": "Против владельца магазина были выдвинуты обвинения в <w>скупке краденого</w>.",
                                "zh": "店主被指控犯有<w>窝藏赃物</w>罪。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преступление, заключающееся в сознательном получении краденого.",
                        "zh": "明知是赃物而予以接收的犯罪行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрывательство краденого",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "скупка краденого",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "销赃罪",
                                "target_lang_sense_clarification": "法律术语"
                            },
                            {
                                "target_lang_word": "窝藏赃物",
                                "target_lang_sense_clarification": "法律术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}