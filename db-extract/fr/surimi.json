                                        "sense_id": "f1f693e3-aea3-3ce2-8710-ee67bf534847",
                                        "entry_id": "54ff7153-d3e1-384c-8fc6-ff0453022edd",
                                        "glosses": [
                                            "geformte und gefärbte Masse aus gemahlenem Fischfleisch"
