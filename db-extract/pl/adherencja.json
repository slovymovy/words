                "senses": [
                    {
                        "sense_id": "b0bd6854-f84a-3884-908f-c5bcec2f6946",
                        "entry_id": "a7522ae3-65d4-396f-8406-c3a45acbdee7",
                        "glosses": [
                            "Befürwortung, Unterstützung"
                        ],
                        "tags": [],
