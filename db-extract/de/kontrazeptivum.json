                            {
                                "example_id": "45a3a4c1-1d9a-4632-93b5-0f370ec69759",
                                "sense_id": "668eb7a7-5467-3a66-9232-1969c9cd4ff0",
                                "text": "Es gibt verschiedene Arten von Kontrazeptiva: Pessare, Pillen, Spritzen."
