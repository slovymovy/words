                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9408d2d4-7b7e-4088-8942-256ad2759216",
                                                "sense_id": "51a4ba34-8eae-3d5c-8eb7-868f7e02dac8",
                                                "text": "Frau Kärcher ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "fb7a955e-c00c-4232-a4ea-de3035e50ed5",
                                                "sense_id": "51a4ba34-8eae-3d5c-8eb7-868f7e02dac8",
                                                "text": "Herr Kärcher wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "2a93a81a-70b0-44ab-9f98-f79838eab58e",
                                                "sense_id": "51a4ba34-8eae-3d5c-8eb7-868f7e02dac8",
                                                "text": "Die Kärchers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "5d422ae3-9899-4e1b-a43d-8b169816f609",
                                                "sense_id": "51a4ba34-8eae-3d5c-8eb7-868f7e02dac8",
                                                "text": "Der Kärcher trägt nie die Schals, die die Kärcher ihm strickt."
                                            },
                                            {
                                                "example_id": "3f7559d6-fdc8-4dfb-8b8e-a6b625fe2778",
                                                "sense_id": "51a4ba34-8eae-3d5c-8eb7-868f7e02dac8",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kärcher kommt, geht der Herr Kärcher.“"
                                            },
                                            {
                                                "example_id": "139813e8-e9fd-4f57-815d-4da97cc211aa",
                                                "sense_id": "51a4ba34-8eae-3d5c-8eb7-868f7e02dac8",
                                                "text": "Kärcher kommt und geht."
                                            },
                                            {
                                                "example_id": "96048181-fcc7-493f-851a-82efa12f44c3",
                                                "sense_id": "51a4ba34-8eae-3d5c-8eb7-868f7e02dac8",
                                                "text": "Kärchers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
