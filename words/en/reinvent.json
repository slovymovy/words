    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c6fe2a2-8f80-3f68-b170-befd78c7fe22",
                    "sense_definition": "To create or develop something that already exists, often wasting time by not using existing solutions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>reinvent</w> the wheel when there are already efficient tools available for this task."
                        },
                        {
                            "text": "The team spent weeks <w>reinventing</w> the wheel instead of using the company's existing software library."
                        }
                    ],
                    "common_phrases": [
                        "reinvent the wheel"
                    ]
                },
                {
                    "sense_id": "f59e7fb6-bd6c-3026-bb3f-43740a23f0dc",
                    "sense_definition": "To change or transform something or someone into a new form, style, or image.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist managed to <w>reinvent</w> herself after years of silence by releasing a completely different album."
                        },
                        {
                            "text": "The company needs to <w>reinvent</w> its brand image to attract a younger generation of customers."
                        }
                    ],
                    "synonyms": [
                        "transform",
                        "revamp",
                        "rebrand"
                    ],
                    "common_phrases": [
                        "reinvent oneself"
                    ]
                }
            ]
        }
    ]
}