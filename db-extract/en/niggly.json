                        "examples": [
                            {
                                "example_id": "6b7cf0b2-fa74-4eed-9a5e-f5e2c81d2532",
                                "sense_id": "f5a102cb-177d-38df-ae70-68f0c4de3f95",
                                "text": "With so much at stake, both teams were hesitant and cagey early on, the game with littered with late tackles and niggly fouls."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2107b3c-766f-3fff-bee5-393d56d7c629",
                        "entry_id": "5ce1815f-871e-307f-ab0b-f39d406959e5",
                        "glosses": [
                            "Trivial, insignificant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a761b2ee-83ff-4cbf-9899-f09c7d7554c0",
                                "sense_id": "e2107b3c-766f-3fff-bee5-393d56d7c629",
                                "text": "They'd argue a lot, about little niggly things — and they had never been like that."
                            },
                            {
                                "example_id": "4d9d7d20-4c03-4516-b181-edaf2cd9f583",
                                "sense_id": "e2107b3c-766f-3fff-bee5-393d56d7c629",
                                "text": "You soon discover there isn't time (nor is there any need) to put in the niggly details. The essence of the pose is its attitude or action and a hint of the model."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b9cd169-1223-3e52-8764-8bce6287715c",
                        "entry_id": "5ce1815f-871e-307f-ab0b-f39d406959e5",
                        "glosses": [
                            "Pernickety, paying too much attention to small details."
                        ],
                        "tags": [],
                        "examples": [
