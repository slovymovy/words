                ],
                "senses": [
                    {
                        "sense_id": "910cca28-0eb8-334f-9580-666e01c5aab2",
                        "entry_id": "3db2d2b3-1913-3ef8-adef-19e91aebd490",
                        "glosses": [
                            "Habitant de l’Albanie du Caucase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df53547-cdc5-423d-ab5f-58f84ceb7402",
                                "sense_id": "910cca28-0eb8-334f-9580-666e01c5aab2",
                                "text": "Comme on le voit, l’armement des Albaniens, tel que nous le décrit Strabon, correspond exactement aux trouvailles récentes, et le géographe du début de notre ère est en tout point contrôlé."
                            },
                            {
                                "example_id": "6cf81909-ae71-44af-aa6f-f400a1adaf2c",
                                "sense_id": "910cca28-0eb8-334f-9580-666e01c5aab2",
                                "text": "Les sources écrites et la culture matérielle attestent l’existence en Albanie, à partir du Iᵉʳ siècle, après J.-C, d’un ethnos dominant : celui des Albaniens, au milieu d’une mosaïque d’autres ethnos …"
                            }
                        ]
                    },
                    {
                        "sense_id": "5a770072-14af-3df1-9cee-0f8c390e3685",
                        "entry_id": "3db2d2b3-1913-3ef8-adef-19e91aebd490",
                        "glosses": [
                            "Albanais."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b079d4b7-4f24-48a2-8a51-f3dcc17e609d",
                                "sense_id": "5a770072-14af-3df1-9cee-0f8c390e3685",
                                "text": "Au mois de mars 1811, un Albanien, homme de bonne mine et très-robuste, vint s’offrir pour entrer à mon service."
                            }
                        ]
                    }
                ],
