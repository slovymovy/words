                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed1b03ee-74a3-3068-b49e-b4e973ee3693",
                        "entry_id": "669b82fa-ad87-3118-a8be-cc052bc00a4e",
                        "glosses": [
                            "Nom de famille anglais correspondant pour son sens à Boulanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf60a7c2-0469-4865-903a-d4197b975998",
                                "sense_id": "ed1b03ee-74a3-3068-b49e-b4e973ee3693",
                                "text": "George Lucas propose aussi un caméo à Kenny Baker, l’éternel R2D2."
                            },
                            {
                                "example_id": "dcf47868-530c-496a-ad13-c1fc6b7ce00f",
                                "sense_id": "ed1b03ee-74a3-3068-b49e-b4e973ee3693",
                                "text": "J’ai passé quelques semaines chez moi avec les rideaux fermés à écouter du Julien Baker."
                            },
                            {
                                "example_id": "f3dcf915-4ee4-42e4-aeda-902ed271a99b",
                                "sense_id": "ed1b03ee-74a3-3068-b49e-b4e973ee3693",
                                "text": "Steve Zahn, Jared Harris, Dylan Baker et John Magaro sont irrésistibles dans cette comédie à suspense que les frères Coen ne renieraient probablement pas et dont la sortie française est annoncée pour avril 2024."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
