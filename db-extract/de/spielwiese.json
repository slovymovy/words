                        ],
                        "form": "die Spielwiesen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b783297-6b8a-3eb0-92a9-8a07010ec18d",
                        "entry_id": "0cb98135-bfee-36ba-b1ce-2290b619f0ca",
                        "glosses": [
                            "freie Grasfläche, auf der gespielt werden kann/darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a91a566-ee91-4c23-ac53-33f58965e2bb",
                                "sense_id": "8b783297-6b8a-3eb0-92a9-8a07010ec18d",
                                "text": "Geht bitte auf die Spielwiese spielen!"
                            },
                            {
                                "example_id": "229d14ae-daa3-408b-9c05-43cb39622a21",
                                "sense_id": "8b783297-6b8a-3eb0-92a9-8a07010ec18d",
                                "text": "„Erstaunlicherweise sind zum Beispiel eingespielte Sportgruppen in Freizeitsituationen am Strand oder auf Spielwiesen manchmal nur unter großen Schwierigkeiten dazu imstande, eine längere Spielphase gemeinsam zu gestalten, ohne daß ein Leiter eingreift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "222307ce-0146-3979-a67e-9c8eee18612f",
                        "entry_id": "0cb98135-bfee-36ba-b1ce-2290b619f0ca",
                        "glosses": [
                            "Thema, Feld häufig ergebnisloser politischer, ideologischer, rhetorischer Auseinandersetzungen"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e6db53b0-6dc5-4209-90db-e9c0826c3cc7",
                                "sense_id": "222307ce-0146-3979-a67e-9c8eee18612f",
                                "text": "Die Bildungspolitik ist zu einer Spielwiese für Politiker geworden, die jeden Realitätsbezug verloren haben."
                            },
                            {
                                "example_id": "9ff8340a-89f3-4067-898b-88ac7f6dd24a",
                                "sense_id": "222307ce-0146-3979-a67e-9c8eee18612f",
                                "text": "„\"Der öffentliche Dienst eignet sich nicht als Spielwiese für Machtpolitik\", sagte Heesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5992cf6-2f21-40bf-92f6-26593bc2f148",
                        "source_entry_id": "0cb98135-bfee-36ba-b1ce-2290b619f0ca",
                        "source_sense_id": "8b783297-6b8a-3eb0-92a9-8a07010ec18d",
                        "source_sense_description": "freie Grasfläche, auf der gespielt werden kann/darf",
                        "target_lang_word": "playground",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playground",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A large open space for children to play in, usually having dedicated play equipment (such as swings and slides)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c89c6887-7417-4180-b43b-1840ffb6711c",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The kids have to go to the playground during recess, no matter the weather."
                                            },
                                            {
                                                "example_id": "81f8f73c-9c8b-458b-9b0a-c315e4067230",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "The local council have set up a new playground, equipped with slides, swings, and a climbing wall."
                                            },
                                            {
                                                "example_id": "9296211f-5b27-42b7-9f0a-0b28bf2f263d",
                                                "sense_id": "f1fb86af-ac69-33f8-a4b0-021cc9e0ac84",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "Any physical or metaphysical space in which a person or organization has free rein to do as they please."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bf7cf8e-9a25-470f-9187-ac1beff6a217",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "The exclusive tropical island was a millionaire's playground."
                                            },
                                            {
                                                "example_id": "8271b7cf-89c4-4a19-9571-e910c334a078",
                                                "sense_id": "e0b05d68-59d1-3603-a099-4c635073da28",
                                                "text": "Kjelsås (six miles) marks the end of the suburbs, and the line immediately plunges into Nordmarka. This vast untamed area of forest and mountain (much of it over 2,000 ft. above sea level), interspersed with innumerable lakes, large and small, is known as Oslo's playground."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37c8473-d51b-3c12-aa38-3dc2ed5145b9",
                                        "entry_id": "f9c1c5ae-dbd2-31ab-bba1-92f249720e2f",
                                        "glosses": [
                                            "A sandbox for testing calls to an application programming interface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "584d6504-8b9c-4c1e-b506-5d597e3bbf01",
                        "source_entry_id": "0cb98135-bfee-36ba-b1ce-2290b619f0ca",
                        "source_sense_id": "8b783297-6b8a-3eb0-92a9-8a07010ec18d",
                        "source_sense_description": "freie Grasfläche, auf der gespielt werden kann/darf",
                        "target_lang_word": "playing field",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playing field",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af83404e-18d1-38b5-9672-8eab18290d16",
                                        "entry_id": "73d1e3f3-b562-36ea-a88e-464b5b057297",
                                        "glosses": [
                                            "A field on which a game, especially a ball game, is played."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9816cb5d-8936-3928-bcde-5146043223bb",
                                        "entry_id": "73d1e3f3-b562-36ea-a88e-464b5b057297",
                                        "glosses": [
                                            "Any place or context within which competitive activity takes place, such as market competition between companies."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884c8f84-a838-4b2d-9120-91056d2a5be0",
                                                "sense_id": "9816cb5d-8936-3928-bcde-5146043223bb",
                                                "text": "A shake-up of transport taxes is needed to create a 'level green playing field' that better reflects how environmentally damaging each mode of transport is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
