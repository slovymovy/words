                ],
                "senses": [
                    {
                        "sense_id": "64966f63-d8dd-39db-9f04-c3b471fa0f5b",
                        "entry_id": "21eb3a5c-fcc3-3539-8a5c-3fc7efcae6fb",
                        "glosses": [
                            "Ne rien faire, ne comporter comme un flemmard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef6d180-82c1-4945-9c2e-c90fcf78758f",
                                "sense_id": "64966f63-d8dd-39db-9f04-c3b471fa0f5b",
                                "text": "Il est important au contraire de s'accorder du temps, de « flémardiser » de temps à autre et même parfois de s'accorder de longues pauses."
                            },
                            {
                                "example_id": "fb65bee1-9975-4f28-b894-ff0a54ece11c",
                                "sense_id": "64966f63-d8dd-39db-9f04-c3b471fa0f5b",
                                "text": "Buller, paresser, se prélasser, flémardiser, se délasser, fénéanter, paresser, se reposer, se détendre, glander, flâner, lézarder, se relaxer, récupérer, ronfler, piquer un somme, roupiller, somnoler, siester, s'assoupir, pioncer, DORMIR!"
                            },
                            {
                                "example_id": "013eee34-c085-4527-93b3-7bfd05e9129a",
                                "sense_id": "64966f63-d8dd-39db-9f04-c3b471fa0f5b",
                                "text": "Ouf, nous avons trouvé un super camping à 20km de là où nous avons passés 3 nuits (le temps de faire la lessive et le temps de flémardiser un peu!"
                            }
                        ]
                    }
                ],
