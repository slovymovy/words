                "senses": [
                    {
                        "sense_id": "90bd8118-12a3-3bff-a61c-3bfe1a898036",
                        "entry_id": "6aa98f41-eb1a-3cb6-8d92-899eb35b222c",
                        "glosses": [
                            "Beschädigung oder Zerstörung eines Dinges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b3ae152-dc17-43a9-a181-b85acba32c22",
                                "sense_id": "90bd8118-12a3-3bff-a61c-3bfe1a898036",
                                "text": "Bei dem Unwetter entstanden Sachschäden in Millionenhöhe, Personen wurden jedoch nicht verletzt."
                            },
                            {
                                "example_id": "cceadb00-975a-4bbf-8351-f81ffd358a56",
                                "sense_id": "90bd8118-12a3-3bff-a61c-3bfe1a898036",
                                "text": "Sachschäden können von leichten Kratzern (zum Beispiel auf einem Schmuckstück) bis hin zu völliger Zerstörung (beispielsweise eines Bauwerks) reichen."
                            },
                            {
                                "example_id": "a5397c4b-84ca-417a-a5a3-1054bf3746cf",
                                "sense_id": "90bd8118-12a3-3bff-a61c-3bfe1a898036",
                                "text": "Ein dreifacher Sabotageakt in Maisfeldern in Coesfeld und in Nordkirchen-Capelle verursachte einen Sachschaden von über 40.000 Euro."
                            },
                            {
                                "example_id": "fa8cb5c2-ed70-403e-bec1-b9b0c7d75af9",
                                "sense_id": "90bd8118-12a3-3bff-a61c-3bfe1a898036",
                                "text": "„Der Sachschaden ist groß - der immaterielle ist nicht wiedergutzumachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
