{
    "word_family": [
        "douser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a14065f-cac2-392b-a97b-16a459aea5c3",
                    "sense_definition": "To put out or extinguish a fire or light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters managed to <w>douse</w> the flames before the fire could spread to the neighboring houses.",
                            "target_lang_translations": {
                                "pl": "Strażakom udało się <w>ugasić</w> płomienie, zanim ogień zdołał rozprzestrzenić się na sąsiednie domy."
                            }
                        },
                        {
                            "text": "Please <w>douse</w> the campfire completely with water before we go to sleep.",
                            "target_lang_translations": {
                                "pl": "Proszę całkowicie <w>zalać</w> ognisko wodą, zanim pójdziemy spać."
                            }
                        }
                    ],
                    "synonyms": [
                        "extinguish",
                        "quench",
                        "put out"
                    ],
                    "antonyms": [
                        "ignite",
                        "kindle"
                    ],
                    "common_phrases": [
                        "douse the flames",
                        "douse the campfire",
                        "douse the light"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ugasić lub zdusić ogień albo światło."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gasić",
                                "target_lang_sense_clarification": "ogień, światło"
                            },
                            {
                                "target_lang_word": "ugasić",
                                "target_lang_sense_clarification": "ogień, płomienie"
                            },
                            {
                                "target_lang_word": "zdusić",
                                "target_lang_sense_clarification": "płomienie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f3f194-9dac-3a28-9ed7-1040c24e41ad",
                    "sense_definition": "To plunge suddenly into water; to drench or pour liquid over.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>douse</w> him with cold water to wake him up from his deep sleep.",
                            "target_lang_translations": {
                                "pl": "Zdecydowali się <w>oblać</w> go zimną wodą, aby obudzić go z głębokiego snu."
                            }
                        },
                        {
                            "text": "Be careful not to <w>douse</w> your clothes when you clean the aquarium.",
                            "target_lang_translations": {
                                "pl": "Uważaj, aby nie <w>zmoczyć</w> ubrań podczas czyszczenia akwarium."
                            }
                        }
                    ],
                    "synonyms": [
                        "drench",
                        "soak",
                        "souse",
                        "submerge"
                    ],
                    "antonyms": [
                        "dry"
                    ],
                    "common_phrases": [
                        "douse with water"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nagle zanurzyć w wodzie; oblać lub zalać płynem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oblewać",
                                "target_lang_sense_clarification": "wodą, płynem"
                            },
                            {
                                "target_lang_word": "oblać",
                                "target_lang_sense_clarification": "wodą, płynem"
                            },
                            {
                                "target_lang_word": "zmoczyć",
                                "target_lang_sense_clarification": "całkowicie, zmoczyć ubranie"
                            },
                            {
                                "target_lang_word": "zanurzyć",
                                "target_lang_sense_clarification": "w wodzie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f339dc5d-be5c-3469-8c25-d4fa1637d689",
                    "sense_definition": "To fall suddenly into water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clumsy sailor slipped on the wet deck and was about to <w>douse</w> in the cold sea.",
                            "target_lang_translations": {
                                "pl": "Niezgułowaty marynarz poślizgnął się na mokrym pokładzie i o mało co nie <w>wpadł</w> do zimnego morza."
                            }
                        },
                        {
                            "text": "He watched the heavy stone <w>douse</w> into the lake, creating large ripples.",
                            "target_lang_translations": {
                                "pl": "Patrzył, jak ciężki kamień <w>plusnął</w> w jezioro, tworząc duże fale."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunge",
                        "fall"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English to mean falling into water."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nagle wpaść lub wpaść z pluskiem do wody."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wpaść",
                                "target_lang_sense_clarification": "do wody"
                            },
                            {
                                "target_lang_word": "plusnąć",
                                "target_lang_sense_clarification": "wpaść z pluskiem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5990093-e0c0-3aeb-81d6-076a9eaa386a",
                    "sense_definition": "To lower or slacken a sail quickly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the sudden squall hit the vessel, the captain ordered the crew to <w>douse</w> the topsail immediately.",
                            "target_lang_translations": {
                                "pl": "Gdy nagły szkwał uderzył w statek, kapitan nakazał załodze natychmiast <w>zrzucić</w> marsel."
                            }
                        },
                        {
                            "text": "They had to <w>douse</w> the sails to slow down the ship before entering the narrow harbor.",
                            "target_lang_translations": {
                                "pl": "Musieli <w>opuścić</w> żagle, aby spowolnić statek przed wejściem do wąskiego portu."
                            }
                        }
                    ],
                    "synonyms": [
                        "lower",
                        "slacken"
                    ],
                    "antonyms": [
                        "hoist"
                    ],
                    "common_phrases": [
                        "douse the topsail"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in nautical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Szybko opuścić lub poluzować żagiel."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrzucić",
                                "target_lang_sense_clarification": "żagiel"
                            },
                            {
                                "target_lang_word": "opuszczać",
                                "target_lang_sense_clarification": "żagiel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b34818ec-80a1-309e-8be2-21ab3eb64d2d",
                    "sense_definition": "To strike, beat, or thrash.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry mob threatened to <w>douse</w> the thief if he did not return the stolen goods.",
                            "target_lang_translations": {
                                "pl": "Wściekły tłum groził, że <w>zbije</w> złodzieja, jeśli ten nie odda skradzionych rzeczy."
                            }
                        },
                        {
                            "text": "In the old story, the master would <w>douse</w> his lazy servants with a heavy stick.",
                            "target_lang_translations": {
                                "pl": "W starej opowieści pan <w>okładał</w> swoich leniwych służących ciężkim kijem."
                            }
                        }
                    ],
                    "synonyms": [
                        "beat",
                        "thrash",
                        "strike"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is obsolete and rarely understood today."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Uderzyć, zbić lub wychłostać."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zbić",
                                "target_lang_sense_clarification": "uderzyć, wychłostać"
                            },
                            {
                                "target_lang_word": "chłostać",
                                "target_lang_sense_clarification": "bić kijem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecfff98d-7ccb-3e98-ae7a-46f88607ad2f",
                    "sense_definition": "A sudden plunging into water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick <w>douse</w> in the icy lake refreshed him after a long and exhausting hike.",
                            "target_lang_translations": {
                                "pl": "Szybkie <w>zanurzenie</w> w lodowatym jeziorze orzeźwiło go po długiej i wyczerpującej wędrówce."
                            }
                        },
                        {
                            "text": "She gave the dirty vegetables a thorough <w>douse</w> in the sink before chopping them.",
                            "target_lang_translations": {
                                "pl": "Przed pokrojeniem brudnych warzyw zafundowała im dokładne <w>płukanie</w> w zlewie."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunge",
                        "dip",
                        "immersion"
                    ],
                    "common_phrases": [
                        "douse in cold water"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nagłe zanurzenie w wodzie lub oblanie wodą."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zanurzenie",
                                "target_lang_sense_clarification": "w wodzie"
                            },
                            {
                                "target_lang_word": "oblanie",
                                "target_lang_sense_clarification": "wodą"
                            },
                            {
                                "target_lang_word": "kąpiel",
                                "target_lang_sense_clarification": "szybka, orzeźwiająca"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dbf0092-58e6-345e-a29d-48a9abaea67e",
                    "sense_definition": "A blow or strike, especially to the face.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a heavy <w>douse</w> to the jaw during the chaotic bar brawl.",
                            "target_lang_translations": {
                                "pl": "Otrzymał mocny <w>cios</w> w szczękę podczas chaotycznej bójki w barze."
                            }
                        },
                        {
                            "text": "The boxer avoided a sharp <w>douse</w> by ducking quickly under his opponent's arm.",
                            "target_lang_translations": {
                                "pl": "Bokser uniknął ostrego <w>uderzenia</w>, robiąc szybki unik pod ramieniem przeciwnika."
                            }
                        }
                    ],
                    "synonyms": [
                        "blow",
                        "strike",
                        "punch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Archaic or dialectal slang for a physical blow."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Cios lub uderzenie, szczególnie w twarz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cios",
                                "target_lang_sense_clarification": "uderzenie w twarz"
                            },
                            {
                                "target_lang_word": "uderzenie",
                                "target_lang_sense_clarification": "fizyczne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ab989384-3d3d-334d-ae40-495e003c4088",
                    "sense_definition": "A English <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Douse</w> and his family to join us for the annual neighborhood barbecue.",
                            "target_lang_translations": {
                                "pl": "Zaprosiliśmy pana <w>Douse'a</w> i jego rodzinę na corocznego sąsiedzkiego grilla."
                            }
                        },
                        {
                            "text": "The local library has a collection of historical documents donated by the <w>Douse</w> family.",
                            "target_lang_translations": {
                                "pl": "Lokalna biblioteka posiada kolekcję dokumentów historycznych podarowanych przez rodzinę <w>Douse</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Angielskie nazwisko."
                    },
                    "translations": {
                        "pl": []
                    }
                }
            ]
        }
    ]
}