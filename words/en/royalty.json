{
    "word_family": [
        "royal",
        "royalist",
        "royally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8740a77-fc70-3daa-a012-dd601a0128b0",
                    "sense_definition": "People of royal rank, plus their families, treated as a group.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "monarch_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd gathered outside the palace to catch a glimpse of the visiting <w>royalty</w>.",
                            "target_lang_translations": {
                                "ru": "Толпа собралась у дворца, чтобы хоть краем глаза увидеть приезжих <w>членов королевской семьи</w>.",
                                "zh": "人群聚集在宫殿外，想一睹来访的<w>王室成员</w>的风采。"
                            }
                        },
                        {
                            "text": "Even though they were just tourists, the hotel staff treated them like <w>royalty</w>.",
                            "target_lang_translations": {
                                "ru": "Хотя они были обычными туристами, персонал отеля обращался с ними как с <w>королевскими особами</w>.",
                                "zh": "尽管他们只是游客，酒店工作人员还是像对待<w>王室成员</w>一样接待他们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "royals",
                        "nobility",
                        "aristocracy",
                        "monarchs"
                    ],
                    "antonyms": [
                        "commoners",
                        "subjects"
                    ],
                    "common_phrases": [
                        "British royalty",
                        "member of royalty",
                        "treated like royalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Члены королевской семьи или люди королевского происхождения как группа.",
                        "zh": "具有王室身份的人及其家属，统称为一个群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "члены королевской семьи",
                                "target_lang_sense_clarification": "группа людей"
                            },
                            {
                                "target_lang_word": "королевские особы",
                                "target_lang_sense_clarification": "отдельные представители"
                            },
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "аристократия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "王室成员",
                                "target_lang_sense_clarification": "作为群体的国王、王后及其家属"
                            },
                            {
                                "target_lang_word": "皇室成员",
                                "target_lang_sense_clarification": "较正式，也可指皇室成员整体"
                            },
                            {
                                "target_lang_word": "王族",
                                "target_lang_sense_clarification": "强调王族出身或家族身份"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8a4fe1d-30d4-3185-a53b-9b9ca25efbc6",
                    "sense_definition": "Payment made to a writer, composer, inventor, etc., for the sale or use of their intellectual property or invention.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author receives a small <w>royalty</w> for every copy of the book that is sold.",
                            "target_lang_translations": {
                                "ru": "Автор получает небольшой <w>гонорар</w> за каждый проданный экземпляр книги.",
                                "zh": "这位作者每卖出一本书都会收到一小笔<w>版税</w>。"
                            }
                        },
                        {
                            "text": "Many musicians rely on <w>royalties</w> from radio play to make a living.",
                            "target_lang_translations": {
                                "ru": "Многие музыканты живут на <w>авторские отчисления</w> от ротации на радио.",
                                "zh": "许多音乐人靠电台播放带来的<w>版税</w>谋生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fee",
                        "percentage",
                        "cut",
                        "compensation"
                    ],
                    "common_phrases": [
                        "royalty payment",
                        "royalty check",
                        "live off royalties",
                        "pay royalties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата писателю, композитору или изобретателю за использование их интеллектуальной собственности.",
                        "zh": "作家、作曲家、发明人等因其知识产权或发明被销售或使用而获得的报酬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гонорар",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "авторские отчисления",
                                "target_lang_sense_clarification": "процент от продаж"
                            },
                            {
                                "target_lang_word": "роялти",
                                "target_lang_sense_clarification": "финансовый термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版税",
                                "target_lang_sense_clarification": "最常用，指作品销售或使用带来的分成"
                            },
                            {
                                "target_lang_word": "特许权使用费",
                                "target_lang_sense_clarification": "较正式，强调许可使用所支付的费用"
                            },
                            {
                                "target_lang_word": "版权使用费",
                                "target_lang_sense_clarification": "强调著作权或版权的使用收入"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc7132e-84d9-3ae0-81f4-52d9bcc4b750",
                    "sense_definition": "The rank, status, power, or authority of a monarch.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monarch_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed ancient artifacts that symbolized the <w>royalty</w> of the past empire.",
                            "target_lang_translations": {
                                "ru": "В музее были выставлены древние артефакты, символизировавшие <w>королевскую власть</w> прошлой империи.",
                                "zh": "博物馆展出了象征着昔日帝国<w>王权</w>的古代文物。"
                            }
                        },
                        {
                            "text": "She carried herself with an air of natural <w>royalty</w> that commanded respect.",
                            "target_lang_translations": {
                                "ru": "Она держалась с видом естественного <w>величия</w>, внушавшего уважение.",
                                "zh": "她举手投足间流露出一种天生的<w>王者风范</w>，令人肃然起敬。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sovereignty",
                        "kingship",
                        "majesty"
                    ],
                    "common_phrases": [
                        "symbols of royalty",
                        "stripped of royalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранг, статус, власть или авторитет монарха.",
                        "zh": "君主的等级、地位、权力或权威。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королевский сан",
                                "target_lang_sense_clarification": "статус"
                            },
                            {
                                "target_lang_word": "царственность",
                                "target_lang_sense_clarification": "качество"
                            },
                            {
                                "target_lang_word": "величие",
                                "target_lang_sense_clarification": "внешний вид или аура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "王权",
                                "target_lang_sense_clarification": "强调君主的权力或统治权"
                            },
                            {
                                "target_lang_word": "君主身份",
                                "target_lang_sense_clarification": "强调作为君主的身份或地位"
                            },
                            {
                                "target_lang_word": "王者风范",
                                "target_lang_sense_clarification": "强调王者般的气度与威仪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29ccb755-321d-37d5-aafb-ce0fb51fcec1",
                    "sense_definition": "Someone in a highly privileged or respected position within a specific field or group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous director is considered Hollywood <w>royalty</w> after decades of making hit films.",
                            "target_lang_translations": {
                                "ru": "После десятилетий создания хитов этот знаменитый режиссер считается <w>элитой</w> Голливуда.",
                                "zh": "这位著名导演在拍出几十年卖座影片之后，被认为是好莱坞的<w>顶级人物</w>。"
                            }
                        },
                        {
                            "text": "In the world of fashion, she is treated as <w>royalty</w> wherever she goes.",
                            "target_lang_translations": {
                                "ru": "В мире моды её принимают как <w>королеву</w>, куда бы она ни пошла.",
                                "zh": "在时尚界，她无论走到哪里都被当成<w>女王级人物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "VIP",
                        "elite",
                        "dignitary"
                    ],
                    "common_phrases": [
                        "Hollywood royalty",
                        "football royalty",
                        "pop royalty"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "metaphorical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, занимающие особо привилегированное или уважаемое положение в определенной сфере.",
                        "zh": "在某一领域或群体中处于高度特权或备受尊敬地位的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элита",
                                "target_lang_sense_clarification": "избранный круг"
                            },
                            {
                                "target_lang_word": "короли",
                                "target_lang_sense_clarification": "метафорически о лидерах сферы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顶级人物",
                                "target_lang_sense_clarification": "指某个领域中地位最高、最受尊敬的人"
                            },
                            {
                                "target_lang_word": "大咖",
                                "target_lang_sense_clarification": "口语色彩较强，指圈内很有分量的人"
                            },
                            {
                                "target_lang_word": "女王级人物",
                                "target_lang_sense_clarification": "比喻在某领域像王室般受尊崇的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3272d172-cc1c-3270-9e26-2af44da135a1",
                    "sense_definition": "The payment received by an owner of real property for the exploitation of mineral rights, such as oil or gas, on that property.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family became wealthy thanks to the oil <w>royalty</w> generated by their land in Texas.",
                            "target_lang_translations": {
                                "ru": "Семья разбогатела благодаря нефтяному <w>роялти</w>, получаемому с их земли в Техасе.",
                                "zh": "这家人靠得克萨斯那块土地带来的石油<w>特许权使用费</w>发了财。"
                            }
                        },
                        {
                            "text": "Mining companies must pay a <w>royalty</w> to the government for extracting resources from public land.",
                            "target_lang_translations": {
                                "ru": "Горнодобывающие компании обязаны платить правительству <w>роялти</w> за добычу ресурсов на государственных землях.",
                                "zh": "矿业公司从公有土地开采资源时，必须向政府缴纳<w>资源开采权使用费</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oil royalty",
                        "mineral royalty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата владельцу земли за право добычи полезных ископаемых на его участке.",
                        "zh": "不动产所有人因其土地上的矿产权益被开发利用（如石油或天然气）而获得的款项。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роялти",
                                "target_lang_sense_clarification": "периодический платеж"
                            },
                            {
                                "target_lang_word": "рента",
                                "target_lang_sense_clarification": "доход с имущества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特许权使用费",
                                "target_lang_sense_clarification": "用于石油、天然气等资源开发中的分成或费用"
                            },
                            {
                                "target_lang_word": "资源开采权使用费",
                                "target_lang_sense_clarification": "强调因资源开采权而支付的费用"
                            },
                            {
                                "target_lang_word": "矿产权使用费",
                                "target_lang_sense_clarification": "特指矿产资源开发相关的费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f37caf07-df8d-3c4d-af6e-97a3940d02c8",
                    "sense_definition": "A royal right or prerogative, such as the right to exploit a natural resource.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "monarch_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, the hunting of deer in the forest was a <w>royalty</w> reserved for the king.",
                            "target_lang_translations": {
                                "ru": "В средневековье охота на оленей в лесу была <w>королевской привилегией</w>, закрепленной за монархом.",
                                "zh": "在中世纪，在森林里猎鹿是国王专享的<w>王室特权</w>。"
                            }
                        },
                        {
                            "text": "The crown retained the <w>royalty</w> over all gold mines discovered in the colony.",
                            "target_lang_translations": {
                                "ru": "Корона сохранила за собой <w>право</w> на все золотые прииски, открытые в колонии.",
                                "zh": "王室保留了对殖民地所有新发现金矿的<w>专有权</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prerogative",
                        "privilege",
                        "right"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Королевское право или привилегия (устар.).",
                        "zh": "王室享有的一种权利或特权，例如开发自然资源的权利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королевская привилегия",
                                "target_lang_sense_clarification": "исключительное право"
                            },
                            {
                                "target_lang_word": "прерогатива",
                                "target_lang_sense_clarification": "преимущественное право"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "王室特权",
                                "target_lang_sense_clarification": "指君主独享的权利或待遇"
                            },
                            {
                                "target_lang_word": "专有权",
                                "target_lang_sense_clarification": "强调法律或历史语境中的专属权利"
                            },
                            {
                                "target_lang_word": "君主特权",
                                "target_lang_sense_clarification": "较正式，指统治者保有的特殊权利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fd7c01a-d625-3e4c-a15e-89cc135440e6",
                    "sense_definition": "A starting hand consisting of a king and a queen in the game of Texas hold 'em.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to bet high when he looked down and saw he had been dealt <w>royalty</w>.",
                            "target_lang_translations": {
                                "ru": "Он решил сделать крупную ставку, когда посмотрел вниз и увидел, что ему сдали <w>марьяж</w>.",
                                "zh": "他低头一看，发现自己拿到了<w>KQ起手牌</w>，便决定下重注。"
                            }
                        },
                        {
                            "text": "The commentator announced that the player held <w>royalty</w>, giving him a strong chance to win.",
                            "target_lang_translations": {
                                "ru": "Комментатор объявил, что у игрока <w>марьяж</w>, что давало ему хорошие шансы на победу.",
                                "zh": "解说员宣布这名玩家手里是<w>KQ起手牌</w>，这让他很有希望获胜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "poker"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стартовая рука в покере, состоящая из короля и дамы.",
                        "zh": "在得州扑克中，由一张国王和一张皇后组成的起手牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марьяж",
                                "target_lang_sense_clarification": "сленг игроков в покер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "KQ起手牌",
                                "target_lang_sense_clarification": "指德州扑克中由K和Q组成的起手牌"
                            },
                            {
                                "target_lang_word": "国王皇后起手牌",
                                "target_lang_sense_clarification": "解释性说法，适合教学说明"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "02506586-f240-3c55-a6ea-171fbb440e4a",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We were introduced to Mr. <w>Royalty</w> at the business conference last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе на бизнес-конференции нас представили мистеру <w>Ройалти</w>.",
                                "zh": "上周的商务会议上，有人把我们介绍给了<w>罗亚尔蒂</w>先生。"
                            }
                        },
                        {
                            "text": "I was surprised to learn that <w>Royalty</w> is actually a family name in this area.",
                            "target_lang_translations": {
                                "ru": "Я с удивлением узнал, что <w>Ройалти</w> — это действительно фамилия в этой местности.",
                                "zh": "我很惊讶地得知，<w>罗亚尔蒂</w>在这一带居然真的是一个姓氏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ройалти",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗亚尔蒂",
                                "target_lang_sense_clarification": "英文姓氏的音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}