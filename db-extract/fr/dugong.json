        "fr-extract.jsonl": [
            {
                "entry_id": "a151bcd3-eb0d-32ac-b9df-061545d1fae7",
                "word": "dugong",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc5171f2-9994-4994-bc36-fbea9e130fd2",
                        "entry_id": "a151bcd3-eb0d-32ac-b9df-061545d1fae7",
                        "tags": [
                            "plural"
                        ],
                        "form": "dugongs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                        "entry_id": "a151bcd3-eb0d-32ac-b9df-061545d1fae7",
                        "glosses": [
                            "Mammifère marin au corps fuselé et à queue échancrée, qui appartient à l’ordre des siréniens avec les lamantins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3ab8c50-83b0-4780-a886-95f63054c1ee",
                                "sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                                "text": "— Est-ce que ce dugong est dangereux à attaquer ? demandai-je malgré le haussement d’épaule du Canadien."
                            },
                            {
                                "example_id": "52ff1bfe-e6dd-4b62-94c4-f9d494b93102",
                                "sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                                "text": "D’après les indigènes, un poisson qu’ils appellent mammba, a des mamelles qui donnent du lait ; c’est probablement un dugong."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cab0f092-e1c7-4762-a881-c96544b8c1f4",
                        "source_entry_id": "a151bcd3-eb0d-32ac-b9df-061545d1fae7",
                        "source_sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                        "target_lang_word": "Dugong",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dugong",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                        "entry_id": "7199dca1-d6c6-33f9-8e4d-ec808c7c1362",
                                        "glosses": [
                                            "ein herbivores Säugetier, das die australischen und philippinischen Küstengewässer sowie die des Roten Meeres bewohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91568b3-1a4d-45b0-ae84-8d736fadc29f",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Hier auf Utupua schweben die Dugongs noch über den Riffen, müden Walfischen gleich, mit dem sanften Blick der Sirene."
                                            },
                                            {
                                                "example_id": "a354f9ac-1ba7-4caa-9126-8178774c1ac9",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Er war ins Meer gesprungen und hatte den vier Meter langen Dugong an der Schwanzflosse gepackt, damit Biologen das Tier zu Forschungszwecken markieren konnten."
                                            },
                                            {
                                                "example_id": "3f01dfba-a752-499c-82bc-90cfd22617ff",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "In der Resolution Bay auf Tanna haben sich seit 1970 Dugongs an die dort lebenden Fischer angeschlossen."
                                            },
                                            {
                                                "example_id": "ef5c858f-1ee7-4926-a81d-09a20b5e53b5",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Die Dugonge gelten bei den Malayen für das Muster ehelicher Zärtlichkeit und man erzählt, dass sie die Thränen dieses Thiers als ein sicheres Mittel betrachten, sich die Gegenliebe einer geliebten Person zu verschaffen."
                                            },
                                            {
                                                "example_id": "e24c0e79-d661-40a4-be00-bf6cf289b57a",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Strände und kleine Inseln bieten Lebensraum für Seevögel, Meeressäuger, Haie, Schildkröten und Mantas, in der Dungonab-Bucht leben auch Dugongs."
                                            },
                                            {
                                                "example_id": "9f24e570-b05d-489e-ba70-a4c1f8564d52",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "„Diesmal täuschte sich der junge Forscher, denn es war kein Manati, sondern ein Dugong mit großen Nasenlöchern über dem Maul.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbc825f9-b63c-4dc6-9283-41c8d3469651",
                        "source_entry_id": "a151bcd3-eb0d-32ac-b9df-061545d1fae7",
                        "source_sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                        "target_lang_word": "dugong",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dugong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                                        "entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                                        "glosses": [
                                            "A plant-eating aquatic marine mammal, of the species Dugong dugon, found in tropical regions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d439a8a-8ef2-4d6c-a066-ef8de110dac2",
                                                "sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                                                "text": "The Ceylong dugong is an extraordinary and interesting animal which is often seen on the coast. It is plentiful in and about the Gulf of Manaar, and resembles somewhat a huge, thickly-made, bluff-headed seal."
                                            },
                                            {
                                                "example_id": "9ba6a425-7786-4953-b243-54b147dfcea9",
                                                "sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                                                "text": "“What are those things that aren’t seals? Much worse than seals. Big, blubbery things. Dugongs.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
