                                    {
                                        "sense_id": "f3a6c0a7-8738-305c-aad3-f6bebfb4d988",
                                        "entry_id": "a5a1bcb4-33a3-3406-9c47-05fa78462b62",
                                        "glosses": [
                                            "gemeinschaftlich; mit mehreren/vielen Personen zusammen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e85481-1e90-48e0-aa33-913cdcad7e67",
                                                "sense_id": "f3a6c0a7-8738-305c-aad3-f6bebfb4d988",
                                                "text": "Die Anschläge vom 11. September 2001 auf das World Trade Center haben sich in das kollektive Gedächtnis der US-Amerikaner eingebrannt."
                                            },
                                            {
                                                "example_id": "72ef13d8-a31f-45c7-9ddd-5782a10b20d0",
                                                "sense_id": "f3a6c0a7-8738-305c-aad3-f6bebfb4d988",
                                                "text": "Durch kollektive Anstrengungen können wir auch große Projekte, wie ein Wörterbuch, bewältigen."
                                            },
                                            {
                                                "example_id": "7336a0ec-36be-4e82-8539-5ca65d04ae0d",
                                                "sense_id": "f3a6c0a7-8738-305c-aad3-f6bebfb4d988",
                                                "text": "„Die Folgen von kollektiven Katastrophen hatten in der Psychoanalyse kein Gewicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "827061b4-7809-3a0a-b72d-e1fce79bf443",
                                        "entry_id": "a5a1bcb4-33a3-3406-9c47-05fa78462b62",
                                        "glosses": [
                                            "eine unbestimmte Anzahl gleichartiger Komponenten betreffend oder zu einer Gesamtheit zusammenfassend"
                                        ],
                                        "tags": [
                                            "übertragen oder abstrakt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e993b24-5a24-4c41-af29-375128642cf4",
                                                "sense_id": "827061b4-7809-3a0a-b72d-e1fce79bf443",
                                                "text": "„Eine Besonderheit sind kollektive Sprachcodes, die in der Norm ISO 639-1 nicht vorgesehen sind. Sie ermöglichen eine Kennzeichnung von Gruppen von Sprachen, für die eine Zuordnung von Kennungen zu den einzelnen Sprachen nicht vorgesehen ist.“"
                                            },
                                            {
                                                "example_id": "6bf8215a-bd00-49e4-a963-f324e0b02cc9",
                                                "sense_id": "827061b4-7809-3a0a-b72d-e1fce79bf443",
                                                "text": "„In Nominalphrasen steht das Nomen eher am Ende. Adjektive, Genitiv-Attribute, Zahlwörter und Demonstrativa stehen davor, Berufsbezeichnungen etc. und kollektive Zahlwörter dahinter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24d6968e-0583-4b8f-a550-da9ce0af0b84",
                        "source_entry_id": "7abfaf00-6574-3bb5-9e2c-647c6e11330d",
