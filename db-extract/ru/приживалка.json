                "senses": [
                    {
                        "sense_id": "0bbabd57-401a-3eae-bd88-360111ff6684",
                        "entry_id": "3ef58fdb-83d1-3e39-b492-5e49bbc0ec93",
                        "glosses": [
                            "a poor female non-serf (noblewoman, intellectual, merchant) who lived in a rich person's house at the owner's expense, did not have any particular responsibilities/occupation and entertained and kept the owner company"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1b1afabd-13f2-416a-874b-c8487bccd1ca",
                                "sense_id": "0bbabd57-401a-3eae-bd88-360111ff6684",
                                "text": "Из бесконтрольной и бранчивой обладательницы головлёвских имений Арина Петровна сделалась скромною приживалкой в доме младшего сына, приживалкой праздною и не имеющею никакого голоса в хозяйственных распоряжениях.",
                                "translation": "After being the absolute and fractious mistress of the Golovlev estates, Arina Petrovna is now a humble dependant in the household of her youngest son, a dependant with nothing to do and with no voice in the domestic management.",
                                "english": "After being the absolute and fractious mistress of the Golovlev estates, Arina Petrovna is now a humble dependant in the household of her youngest son, a dependant with nothing to do and with no voice in the domestic management."
                            }
                        ]
                    },
                    {
                        "sense_id": "b73b9945-7107-3a38-a192-3d97060e8aa5",
                        "entry_id": "3ef58fdb-83d1-3e39-b492-5e49bbc0ec93",
                        "glosses": [
                            "a female living at someone else's expense; dependent, parasite, leech"
                        ],
                        "tags": [
                            "disapproving",
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
