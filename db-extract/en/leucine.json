                                    {
                                        "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                        "entry_id": "cdd63b46-b1e7-3ed2-b75f-121e148bb7a6",
                                        "glosses": [
                                            "eine Aminosäure, Bestandteil der Proteine"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db064159-3c9f-4f63-a348-36edd6a1e973",
                                                "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                                "text": "Leucin ist eine essentielle Aminosäure."
                                            },
                                            {
                                                "example_id": "ad96c895-9427-450a-92fd-5d8dc1c1822f",
                                                "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                                "text": "„Valin, Leucin und Isoleucin werden vom Gehirn besonders leicht aufgenommen und dort dem Stoffwechsel zugeführt, während die anderen Aminosäuren vorwiegend in der Leber abgebaut werden.“"
                                            },
                                            {
                                                "example_id": "f1307857-65ef-4d51-9c22-df661fcf94f7",
                                                "sense_id": "12683d1e-68d1-320b-89ae-baa781708af6",
                                                "text": "„Die Leucine konnten nur durch sehr hydrophobe und sperrige Aminosäuren ersetzt werden, ohne den Transport von Ist2 zu beeinträchtigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
