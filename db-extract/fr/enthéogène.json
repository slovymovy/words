                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "079e2783-bb94-4312-a56b-d10b5a8dfebc",
                        "entry_id": "dc942154-14b1-345a-ab06-1d50d463654f",
                        "tags": [
