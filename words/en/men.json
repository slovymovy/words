                },
                {
                    "sense_id": "1d8abc6a-e618-3fca-8648-0aa7582722d3",
                    "sense_definition": "Human beings in general, regardless of gender.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_humanity",
                    "name_type": "no",
                    "examples": [
                        {
