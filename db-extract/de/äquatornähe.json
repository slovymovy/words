                            {
                                "example_id": "b2d7f604-b287-45a2-aa9f-a76db664d6a4",
                                "sense_id": "da32dd40-0226-3f0d-a5fa-70bd8c08f283",
                                "text": "„Hurrikane kommen in Äquatornähe mit 8–32 km/h voran; in weiterer Entfernung vom Äquator legen sie bis zu 80 km in der Stunde zurück.“"
                            },
                            {
                                "example_id": "1f6d431b-0b41-4f93-825b-0c515bb0fec8",
                                "sense_id": "da32dd40-0226-3f0d-a5fa-70bd8c08f283",
                                "text": "„Dass dunkelhäutige Menschengruppen in Äquatornähe leben und hellhäutige in höheren Breiten, führen Anthropologen seit langem auf die Sonnenstrahlung zurück.“"
                            }
