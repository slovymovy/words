                                        "sense_id": "e2142a4b-ad74-3fdd-917e-4d5fd16cebbd",
                                        "entry_id": "9048ca24-e11a-3250-b5f2-9a9b9ec1386e",
                                        "glosses": [
                                            "To act as the master of ceremonies (for)."
                                        ],
