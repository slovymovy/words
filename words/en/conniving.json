{
    "word_family": [
        "connive",
        "connivance",
        "conniver"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4aa1b9d3-84c1-33c1-9539-9c7d7b89cb49",
                    "sense_definition": "Engaged in secret, dishonest, or illegal activities to achieve a goal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deceptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conniving</w> manager stole money from the company for years.",
                            "target_lang_translations": {
                                "ru": "<w>Коварный</w> менеджер годами воровал деньги из компании."
                            }
                        },
                        {
                            "text": "She felt trapped by her <w>conniving</w> business partner who was plotting against her.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя в ловушке из-за своего <w>плетущего интриги</w> делового партнера, строившего против нее козни."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceitful",
                        "scheming",
                        "crafty",
                        "sly"
                    ],
                    "antonyms": [
                        "honest",
                        "sincere"
                    ],
                    "common_phrases": [
                        "conniving person",
                        "conniving scheme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занимающийся тайными, нечестными или незаконными делами для достижения своих целей; коварный, плетущий интриги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "склонный к злым умыслам и обману"
                            },
                            {
                                "target_lang_word": "изворотливый",
                                "target_lang_sense_clarification": "ловкий в обмане и уловках"
                            },
                            {
                                "target_lang_word": "интригующий",
                                "target_lang_sense_clarification": "плетущий интриги и заговоры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "882168ac-ece6-3580-a16d-1d537b8affc0",
                    "sense_definition": "Present participle and gerund of <w>connive</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deceptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official was accused of <w>conniving</w> with the criminals to hide the evidence.",
                            "target_lang_translations": {
                                "ru": "Чиновника обвинили во <w>вступлении в сговор</w> с преступниками с целью сокрытия улик."
                            }
                        },
                        {
                            "text": "By <w>conniving</w> to keep the truth hidden, they caused a major scandal.",
                            "target_lang_translations": {
                                "ru": "<w>Сговорившись</w> скрыть правду, они спровоцировали крупный скандал."
                            }
                        }
                    ],
                    "synonyms": [
                        "colluding",
                        "plotting",
                        "conspiring"
                    ],
                    "common_phrases": [
                        "conniving with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия или герундия от connive: потворствование, вступление в тайный сговор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потворствующий",
                                "target_lang_sense_clarification": "попускающий незаконные или предосудительные действия"
                            },
                            {
                                "target_lang_word": "вступающий в сговор",
                                "target_lang_sense_clarification": "тайно сотрудничающий ради дурных целей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}