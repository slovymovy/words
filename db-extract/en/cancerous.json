                                    {
                                        "sense_id": "70e798d1-229b-36e3-b5ff-8c26e1eb5efd",
                                        "entry_id": "c79eb5c9-4a4d-371b-9b4b-0218b4850aa5",
                                        "glosses": [
                                            "Malade atteint d'un cancer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01bfd35c-b859-4298-b767-deea16476222",
                                                "sense_id": "70e798d1-229b-36e3-b5ff-8c26e1eb5efd",
                                                "text": "Cette fragilité est-elle propre aux os des cancéreux, ou tient-elle au développement des cancers multiples dans le système osseux ?"
                                            },
                                            {
                                                "example_id": "a81164f9-55ca-4bfa-84e6-f1f9a23abf0a",
                                                "sense_id": "70e798d1-229b-36e3-b5ff-8c26e1eb5efd",
                                                "text": "Je reconnais que tu as beaucoup changé sur ce chapitre : maintenant, tu soignes les cancéreuses, c'est entendu!"
                                            },
                                            {
                                                "example_id": "76b30e3c-933c-4db2-acd4-dd337aa209da",
                                                "sense_id": "70e798d1-229b-36e3-b5ff-8c26e1eb5efd",
                                                "text": "Il s’en fout que tu attrapes la COVID, que tu participes à engorger le système de santé et que tu prennes la place d’un cancéreux à l’hôpital."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
