                ],
                "senses": [
                    {
                        "sense_id": "2edc66cf-9c1a-3392-87de-f8c42d3c2932",
                        "entry_id": "3849c3b5-80f1-386c-b8ea-20b277d1f94a",
                        "glosses": [
                            "Suffix, das dem Stamm eines Verbs folgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93041a30-18b8-4035-8397-49d6eef09ca9",
                                "sense_id": "2edc66cf-9c1a-3392-87de-f8c42d3c2932",
                                "text": "Im Deutschen gibt es sozusagen eine begrenzte Zahl von Verbalsuffixen, die hinter einer Basis angefügt werden können."
                            },
                            {
                                "example_id": "4f8da569-815f-4731-a2f0-a719850b317d",
                                "sense_id": "2edc66cf-9c1a-3392-87de-f8c42d3c2932",
                                "text": "Dabei gilt folgende Regel: bei prädikativer Verwendung bleibt (wie im Deutschen) das Substantiv unverändert, das prädikativ gebrauchte Adjektiv erhält eine Suffixkopula oder ein Verbalsuffix, das dem Genus und Numerus des Substantivs entspricht."
                            },
                            {
                                "example_id": "de5a320b-74f4-4cab-87b6-207dd89a26e6",
                                "sense_id": "2edc66cf-9c1a-3392-87de-f8c42d3c2932",
                                "text": "Die Onbinkei fungiert bei Verben der fünfstufigen Verbalflexion (vgl. fünfstufiges Verb) vor Verbalsuffixen und Postpositionen, die mit t anlauten (te, ta, tara, tari)."
                            },
                            {
                                "example_id": "acfa69b8-208c-4ce6-9ed5-bd408c4017ab",
                                "sense_id": "2edc66cf-9c1a-3392-87de-f8c42d3c2932",
                                "text": "„Dieses Verb ist gebildet aus dem Adjektiv blöd(e) und einem Verbsuffix -eln – ein recht produktives Verbalsuffix der deutschen Sprache: …“"
                            },
                            {
                                "example_id": "89a7db81-c125-4913-9ccf-0740a90e7da1",
                                "sense_id": "2edc66cf-9c1a-3392-87de-f8c42d3c2932",
                                "text": "„Dasselbe gilt für die Verbalsuffixe el und er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
