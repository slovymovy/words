                                "target_senses": [
                                    {
                                        "sense_id": "846e1328-1cd5-31f8-bd31-9bc27a044eb0",
                                        "entry_id": "f29649c9-6b6b-3899-91b7-6ef91a5b413c",
                                        "glosses": [
                                            "A device for recording video footage, often a portable one used by amateurs; also as a fixed installation for surveillance purposes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "958ddf1e-a0f0-46bf-a7e0-45fe786b576c",
                        "source_entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                        "source_sense_id": "b689d614-202f-3639-935f-efed416959d5",
                        "target_lang_word": "camcorder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camcorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf4b051f-3751-3965-828f-bd24caedfac9",
                                        "entry_id": "a2215b96-45aa-3530-94bb-5f357e3e936f",
                                        "glosses": [
                                            "A camera recorder: a portable electronic device for recording images and audio on to a storage device, hence functioning as a camera and a recorder in a single unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1fc0c8d-a221-4f86-b84e-56f1fe9fe994",
                                                "sense_id": "cf4b051f-3751-3965-828f-bd24caedfac9",
                                                "text": "You know where you never see a camcorder? At a funeral. Wouldn't that be fun? Especially if you didn't know any of the people there. Why not go to a stranger's funeral, and bring your camcorder? Have a little fun! Zoom in on the corpse's nose hairs. Then pull back, and pan over to the widow's tears. Get a tight shot of that. Do a montage of people wracked with grief. Then go home and put a laugh track on it! Smoke a joint and show it to your friends. That would be a lot of fun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camcorder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec326dd-8d06-3a54-af27-98bee393e7fc",
                                        "entry_id": "96210d27-8f55-32f4-9aa8-084b52a460f8",
                                        "glosses": [
                                            "To record using a camcorder."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71ae1d91-dead-4e06-9eed-5d9165f3b7fa",
                        "source_entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                        "source_sense_id": "b689d614-202f-3639-935f-efed416959d5",
                        "target_lang_word": "videocamera",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4b717c82-e863-481a-a46e-2aaaf6860510",
                        "source_entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                        "source_sense_id": "b689d614-202f-3639-935f-efed416959d5",
                        "target_lang_word": "Camcorder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Camcorder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ca716cc-6a23-30f9-84c4-fd21848c2fb4",
                                        "entry_id": "87cdbe8d-a493-3023-a712-c68676181e81",
                                        "glosses": [
                                            "tragbares Gerät zum kabellosen Aufnehmen von Filmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00a5c815-f1eb-4415-a281-a44b10f797ad",
                                                "sense_id": "2ca716cc-6a23-30f9-84c4-fd21848c2fb4",
                                                "text": "„Der HC-X2000 von Panasonic ist ein Camcorder für die Generation Youtube mit gigantischem Zoombereich.“"
                                            },
                                            {
                                                "example_id": "698ff2d2-1ab9-4d0f-86d8-9ca9da60dfa8",
                                                "sense_id": "2ca716cc-6a23-30f9-84c4-fd21848c2fb4",
                                                "text": "„Fotografieren und Filmen mit einem Gerät: Mit den neuen Camcorder ist das möglich - bei einfacher Bedienung und in herausragender Qualität.“"
                                            },
                                            {
                                                "example_id": "3d4f097f-b5c5-4da2-a427-7bf12679e307",
                                                "sense_id": "2ca716cc-6a23-30f9-84c4-fd21848c2fb4",
                                                "text": "„Sie sind ein wenig aus der Mode gekommen, doch was Camcorder heute leisten, zeigt eine Neuheit von Panasonic exemplarisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e407e1a9-5554-4e97-b7f8-99ec2f592882",
                        "source_entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                        "source_sense_id": "b689d614-202f-3639-935f-efed416959d5",
                        "target_lang_word": "Kamkorder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4566d95d-d262-4c9c-8f40-bc8fda5f75fc",
                        "source_entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                        "source_sense_id": "b689d614-202f-3639-935f-efed416959d5",
                        "target_lang_word": "Videokamera",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Videokamera",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c386c69-7486-371b-91ba-d0b92af44697",
                                        "entry_id": "9d4a4556-9c83-3a50-a638-98a63686b258",
                                        "glosses": [
                                            "technisches Gerät, mit dem Filmsequenzen elektronisch aufgezeichnet werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a15bbbe-bd3e-40a4-9445-9f235b1966bd",
                                                "sense_id": "8c386c69-7486-371b-91ba-d0b92af44697",
                                                "text": "Er will mit seiner neuen Videokamera die wichtigsten Momente im Leben seiner Kinder festhalten."
                                            },
                                            {
                                                "example_id": "1077652a-4fca-4fc7-bbdb-b98436877a16",
                                                "sense_id": "8c386c69-7486-371b-91ba-d0b92af44697",
                                                "text": "„Für technische Einbauten an der Fassade, zu denen neben Parabolantennen übrigens auch Klimaanlagen, Alarmanlagen und Videokameras zählen, muss je nach Standort und Größe eine Bewilligung seitens der Baubehörde eingeholt werden.“"
                                            },
                                            {
                                                "example_id": "b534fc56-b616-42d4-b29c-930accbb403b",
                                                "sense_id": "8c386c69-7486-371b-91ba-d0b92af44697",
                                                "text": "„Als der Beamte eine Pause macht, läuft die Videokamera dennoch weiter.“"
                                            },
                                            {
                                                "example_id": "001832da-e6e4-4298-955c-6791302050be",
                                                "sense_id": "8c386c69-7486-371b-91ba-d0b92af44697",
                                                "text": "„Ich schnappte mir meine Videokamera, kickte die Fahrertür auf und ging zum Haus.“"
                                            },
                                            {
                                                "example_id": "2294cbac-047c-40a4-b250-d305c988d59b",
                                                "sense_id": "8c386c69-7486-371b-91ba-d0b92af44697",
                                                "text": "„Unser (beschwipstes) Liebesspiel war ins Blickfeld der Videokameras geraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
