                {
                    "sense_id": "6da57c4e-bd8a-330b-a03c-0662334ff116",
                    "sense_definition": "Consommer ou avaler très rapidement un repas ou un aliment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consommation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pressé par l'horaire du train, il <w>expédie</w> son déjeuner en dix minutes.",
                            "target_lang_translations": {
                                "en": "Pressed for time by his train timetable, he <w>bolts</w> his lunch in ten minutes.",
                                "ru": "Торопясь на поезд, он <w>проглатывает</w> обед за десять минут.",
                                "de": "Unter Zeitdruck wegen des Zugs <w>verschlingt</w> er sein Mittagessen in zehn Minuten.",
                                "es": "Apurado por el horario del tren, <w>engulle</w> su almuerzo en diez minutos.",
                                "zh": "因为火车时间紧，他十分钟就把午饭<w>囫囵吞下</w>了。"
                            }
                        },
                        {
                            "text": "Nous avons dû <w>expédier</w> le petit-déjeuner avant de partir au travail.",
                            "target_lang_translations": {
                                "en": "We had to <w>gobble</w> our breakfast before leaving for work.",
                                "ru": "Нам пришлось наскоро <w>проглотить</w> завтрак перед уходом на работу.",
                                "de": "Wir mussten das Frühstück <w>herunterschlingen</w>, bevor wir zur Arbeit gingen.",
                                "es": "Tuvimos que <w>engullir</w> el desayuno antes de salir al trabajo.",
                                "zh": "我们不得不在上班前<w>狼吞虎咽</w>地吃完早饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "avaler",
                        "engloutir"
                    ],
                    "antonyms": [
                        "savourer"
                    ],
                    "common_phrases": [
                        "expédier son déjeuner",
                        "expédier son repas"
                    ],
                    "target_lang_definitions": {
