    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ddd5d1e1-9f9d-321d-971e-38edad959ca0",
                "word": "depopulate",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d7c75c8-ac9e-3230-b377-90b3124539f9",
                        "entry_id": "ddd5d1e1-9f9d-321d-971e-38edad959ca0",
                        "glosses": [
                            "Depopulated (sense 1)."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2993f6e5-0ed1-4967-8cd4-661f40445816",
                                "sense_id": "7d7c75c8-ac9e-3230-b377-90b3124539f9",
                                "text": "And ſo in that realme were continually two kynges, vntil the kynge of Mede had depopulate the country, and brought the people in captiuite to the citie of Babylon: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c5e5bd69-3e1b-3986-8d22-a227a01a1ed6",
                        "entry_id": "ddd5d1e1-9f9d-321d-971e-38edad959ca0",
                        "glosses": [
                            "Barren, devoid of inhabitants; utterly destroyed, devastated ."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "86d19a6a-d811-4a84-a8fe-08b5aabaf6ad",
                                "sense_id": "c5e5bd69-3e1b-3986-8d22-a227a01a1ed6",
                                "text": "A world it was to see […] his daily peregrinacion in the desert, felles and craggy mountains of that bareine vnfertile and depopulate countrey."
                            },
                            {
                                "example_id": "cfb94368-6f01-469d-870d-a98ecd497128",
                                "sense_id": "c5e5bd69-3e1b-3986-8d22-a227a01a1ed6",
                                "text": "Wroth for bright-cheekt Bryseis losse; whom from Lyrnessus spoiles,\n(His owne exploit) he brought away, as trophee of his toiles,\nWhen that town was depopulate;"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8ced28ee-e663-3d5b-8b27-9532e57f0519",
                "word": "depopulate",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2ea05148-819c-40e2-a609-29b1bf50d1d2",
                        "entry_id": "8ced28ee-e663-3d5b-8b27-9532e57f0519",
