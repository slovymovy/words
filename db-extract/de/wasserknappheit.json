                        "form": "die Wasserknappheit"
                    },
                    {
                        "form_id": "5cbfb5b1-e012-4e3e-911b-7dd489670bb4",
                        "entry_id": "6097b347-d1dc-3a70-8fbc-713a34747e7b",
                        "tags": [
                            "accusative",
