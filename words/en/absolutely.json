{
    "word_family": [
        "absolute",
        "absolution",
        "absolutism",
        "absolutist"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                    "sense_definition": "Used to emphasize that something is completely true or to add force to an adjective; extremely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain was <w>absolutely</w> breathtaking.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был <w>абсолютно</w> захватывающим.",
                                "zh": "从山顶看到的景色<w>绝对</w>令人叹为观止。"
                            }
                        },
                        {
                            "text": "I am <w>absolutely</w> sure that we are on the right path.",
                            "target_lang_translations": {
                                "ru": "Я <w>абсолютно</w> уверен, что мы на правильном пути.",
                                "zh": "我<w>绝对</w>肯定我们走在正确的道路上。"
                            }
                        },
                        {
                            "text": "There is <w>absolutely</w> nothing we can do to change the outcome now.",
                            "target_lang_translations": {
                                "ru": "Мы <w>совершенно</w> ничего не можем сделать, чтобы изменить исход сейчас.",
                                "zh": "我们现在<w>绝对</w>没有办法改变结果了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "totally",
                        "utterly",
                        "entirely",
                        "perfectly",
                        "fully",
                        "definitely",
                        "really"
                    ],
                    "antonyms": [
                        "slightly",
                        "somewhat",
                        "partially"
                    ],
                    "common_phrases": [
                        "absolutely necessary",
                        "absolutely right",
                        "absolutely sure",
                        "absolutely not",
                        "absolutely nothing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания того, что что-то является полностью истинным, или для усиления прилагательного; совершенно, чрезвычайно.",
                        "zh": "用于强调某事完全属实，或加强形容词的语气；极其，完全。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абсолютно",
                                "target_lang_sense_clarification": "полностью, всецело"
                            },
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "совсем, в высшей степени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝对",
                                "target_lang_sense_clarification": "完全地，极其"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "彻底地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47da8542-fd0e-34ac-b563-c913654db3dd",
                    "sense_definition": "In an unconditional manner; without any restriction, doubt, or reservation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She believed <w>absolutely</w> in the justice and importance of her cause.",
                            "target_lang_translations": {
                                "ru": "Она <w>безоговорочно</w> верила в справедливость и важность своего дела.",
                                "zh": "她<w>无条件地</w>相信她所从事事业的正义性和重要性。"
                            }
                        },
                        {
                            "text": "The monarch ruled the country <w>absolutely</w> for more than forty years.",
                            "target_lang_translations": {
                                "ru": "Монарх правил страной <w>неограниченно</w> более сорока лет.",
                                "zh": "这位君主<w>绝对地</w>统治了这个国家四十多年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unconditionally",
                        "wholly"
                    ],
                    "antonyms": [
                        "conditionally",
                        "partially"
                    ],
                    "common_phrases": [
                        "trust absolutely",
                        "govern absolutely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Безоговорочно; без каких-либо ограничений, сомнений или условий.",
                        "zh": "以无条件的方式；没有任何限制、怀疑或保留。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безоговорочно",
                                "target_lang_sense_clarification": "без возражений и условий"
                            },
                            {
                                "target_lang_word": "безусловно",
                                "target_lang_sense_clarification": "без всяких условий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无条件地",
                                "target_lang_sense_clarification": "不设任何前提"
                            },
                            {
                                "target_lang_word": "绝对地",
                                "target_lang_sense_clarification": "不容置疑地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                    "sense_definition": "Independently; viewed on its own without connection to other things or factors.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must judge the artwork <w>absolutely</w>, rather than comparing it to modern trends.",
                            "target_lang_translations": {
                                "ru": "Мы должны оценивать произведение искусства <w>безотносительно</w>, а не сравнивать его с современными тенденциями.",
                                "zh": "我们必须<w>独立地</w>评价这件艺术品，而不是将其与现代潮流进行比较。"
                            }
                        },
                        {
                            "text": "Truth should be valued <w>absolutely</w>, regardless of the immediate consequences.",
                            "target_lang_translations": {
                                "ru": "Истину следует ценить <w>абсолютно</w>, независимо от сиюминутных последствий.",
                                "zh": "真理应当被<w>绝对地</w>重视，而不应考虑眼前的后果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "independently",
                        "separately"
                    ],
                    "antonyms": [
                        "relatively"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Независимо; рассматривается само по себе, без связи с другими вещами или факторами.",
                        "zh": "独立地；孤立地看待，不与其他事物或因素联系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безотносительно",
                                "target_lang_sense_clarification": "независимо от обстоятельств"
                            },
                            {
                                "target_lang_word": "независимо",
                                "target_lang_sense_clarification": "обособленно, самостоятельно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "独立地",
                                "target_lang_sense_clarification": "不依赖其他因素"
                            },
                            {
                                "target_lang_word": "绝对地",
                                "target_lang_sense_clarification": "脱离相对关系地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                    "sense_definition": "Used to express strong agreement or certainty; yes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you want to come to the cinema with us? <w>Absolutely</w>!",
                            "target_lang_translations": {
                                "ru": "Ты хочешь пойти с нами в кино? <w>Конечно</w>!",
                                "zh": "你想和我们一起去看电影吗？<w>当然</w>！"
                            }
                        },
                        {
                            "text": "Is it safe to swim in this part of the river? <w>Absolutely</w>.",
                            "target_lang_translations": {
                                "ru": "Безопасно ли купаться в этой части реки? <w>Абсолютно</w>.",
                                "zh": "在这段河里游泳安全吗？<w>绝对</w>安全。"
                            }
                        }
                    ],
                    "synonyms": [
                        "certainly",
                        "definitely",
                        "sure",
                        "totally",
                        "of course"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения решительного согласия или уверенности; да.",
                        "zh": "用于表示强烈的同意或确定；当然，没错。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "разумеется"
                            },
                            {
                                "target_lang_word": "безусловно",
                                "target_lang_sense_clarification": "несомненно"
                            },
                            {
                                "target_lang_word": "точно",
                                "target_lang_sense_clarification": "именно так"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当然",
                                "target_lang_sense_clarification": "表示完全同意"
                            },
                            {
                                "target_lang_word": "绝对是",
                                "target_lang_sense_clarification": "表示非常确定"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}