                                    {
                                        "sense_id": "cd4ca02f-40aa-31be-ad03-391185a7c845",
                                        "entry_id": "74dcea10-bda3-30a5-be2b-c309467d3236",
                                        "glosses": [
                                            "Dispenser d’impôt, offrir un avantage fiscal."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Luxembourg"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72362350-c066-489f-bd06-688e442659a9",
                                                "sense_id": "cd4ca02f-40aa-31be-ad03-391185a7c845",
                                                "text": "Lorsque le bénéfice de cession ou de cessation d’une entreprise commerciale comprend une plus-value réalisée sur un immeuble, la plus-value d’ordre monétaire peut, sur demande, être immunisée."
                                            },
                                            {
                                                "example_id": "4a5666db-3dfc-4986-82c2-646e47794f3f",
                                                "sense_id": "cd4ca02f-40aa-31be-ad03-391185a7c845",
                                                "text": "Parfois, une partie du bénéfice de votre société peut se voir immunisée d’impôt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26404afc-dc95-4e33-a382-76610290849e",
                        "source_entry_id": "30061836-8d41-3a1a-a70d-3b86e7fe77a8",
                        "source_sense_description": "to inoculate someone, as thus produce immunity from a disease",
                        "target_lang_word": "immunisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immunisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df2db94b-0da3-3626-90f6-7f8d1ce5a6a1",
                                        "entry_id": "58ac79fb-9a06-3a75-bb94-6e7c4efa6209",
                                        "glosses": [
                                            "den Organismus gegen pathogene Keime widerstandsfähig, unempfindlich machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76b3b1a0-4c39-4306-983c-4482f689c891",
                                                "sense_id": "df2db94b-0da3-3626-90f6-7f8d1ce5a6a1",
                                                "text": "Unter Vollantigen sind solche Körper zu verstehen, die zur Antikörperbildung führen, d. h. mit denen man immunisieren kann."
                                            },
                                            {
                                                "example_id": "17cf2c77-4e93-49a5-88bc-a32fa03baf88",
                                                "sense_id": "df2db94b-0da3-3626-90f6-7f8d1ce5a6a1",
                                                "text": "Wenn wir entfernte Tierarten mit ihrem Blut gegenseitig immunisieren, erhalten wir hauptsächlich artspezifische Antikörper."
                                            },
                                            {
                                                "example_id": "0f8bab39-90d9-4831-8696-3882999b3c2d",
                                                "sense_id": "df2db94b-0da3-3626-90f6-7f8d1ce5a6a1",
                                                "text": "Nach DANIELOPOLU hat man nicht zwei Arten von Antikörpern zu unterscheiden, von welchen die einen immunisieren, während die anderen anaphylaktisch machen."
                                            },
                                            {
                                                "example_id": "d366847c-f9fd-45ee-9b2b-bbcc19f14ded",
                                                "sense_id": "df2db94b-0da3-3626-90f6-7f8d1ce5a6a1",
                                                "text": "Sie werfen die Frage auf, ob es nicht auch möglich wäre, Menschen mit Hilfe steigender Mengen solcher abgetöteter Kulturen zu immunisieren."
                                            },
                                            {
                                                "example_id": "fb827ff2-8999-4ca4-8b47-39b748ddc315",
                                                "sense_id": "df2db94b-0da3-3626-90f6-7f8d1ce5a6a1",
                                                "text": "Der Engländer Edward Jenner entdeckte 1797, dass man den Menschen mit Kuhpocken impfen und immunisieren kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
