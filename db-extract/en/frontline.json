                                    {
                                        "sense_id": "76efda1d-c0ef-3ea8-a006-b17c9ea206b1",
                                        "entry_id": "44d58129-4952-325b-83f6-eb8c178aeb17",
                                        "glosses": [
                                            "de lijn waarlangs gevochten wordt in een frontoorlog"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a12e14c6-9558-4114-8e09-61562b9211d9",
                                                "sense_id": "76efda1d-c0ef-3ea8-a006-b17c9ea206b1",
                                                "text": "Igor Plotniski, de rebellenleider van de zelfuitgeroepen Republiek van Loehansk, zei dat zijn troepen zich houden aan de overeenkomst om zware wapens terug te trekken van de frontlijn. Dat berichtte het Russische persbureau TASS."
                                            },
                                            {
                                                "example_id": "953b3f2c-4c81-4120-b905-7b853842cf41",
                                                "sense_id": "76efda1d-c0ef-3ea8-a006-b17c9ea206b1",
                                                "text": "Op 24 augustus wordt voor het eerst de Great War Remembrance Race verreden, een koers die voert van Nieuwpoort naar Ieper langs de frontlijn waar tussen 1914 en 1918 een loopgravenoorlog honderdduizenden levens kostte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f777094b-7d97-4083-9514-49f5c43c6ac8",
                        "source_entry_id": "a6059ebe-4e6c-3b2c-8ce6-015ed64a63bc",
                        "source_sense_description": "military: located at a front",
                        "target_lang_word": "ligne de front",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ligne de front",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd7c259-17e8-36eb-bc55-7a7cc20dd1ff",
                                        "entry_id": "2d32c635-4185-3502-9057-2cc4220fb967",
                                        "glosses": [
                                            "Ligne fictive séparant deux forces armées ennemies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43fa753-bc4f-4001-9169-a740afeb3527",
                                                "sense_id": "3fd7c259-17e8-36eb-bc55-7a7cc20dd1ff",
                                                "text": "Il y a tellement de gens qui sont sur la ligne de front dans le Donbass, à Kherson, à Zaporijie, ils ressentent cela tous les jours."
                                            },
                                            {
                                                "example_id": "c193375d-c68b-4b39-81a3-fb215734336d",
                                                "sense_id": "3fd7c259-17e8-36eb-bc55-7a7cc20dd1ff",
                                                "text": "\"Plus les Russes avancent, plus ils débloqueront toute la ligne de front pour se déplacer, plus les Ukrainiens auront besoin de ressources pour les contenir\", estime Pasi Paroinen du groupe OSINT Black Bird Group, basé en Finlande, cité par le Kyiv Independant."
                                            },
                                            {
                                                "example_id": "e33e213a-99c7-4d32-875c-25e896e76259",
                                                "sense_id": "3fd7c259-17e8-36eb-bc55-7a7cc20dd1ff",
                                                "text": "De ligne de front en ligne de front, il parcourait la Finlande, donnant aux soldats les dernières nouvelles des villes, démystifiant les rumeurs, coupant la tête aux \"on-dit\"...."
                                            },
                                            {
                                                "example_id": "c84021b6-fedb-47ab-a0ab-894094cddc62",
                                                "sense_id": "3fd7c259-17e8-36eb-bc55-7a7cc20dd1ff",
                                                "text": "L’artillerie tenta de rapprocher encore un peu ses pièces de la ligne de front."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
