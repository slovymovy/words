                    {
                        "sense_id": "4122cbdd-9424-3dcc-a05c-bdc48d973caa",
                        "entry_id": "6b7717a1-3848-38cc-b0eb-b58a5216150b",
                        "glosses": [
                            "ein Flüchtling, der per Boot über das Meer oder einen großen See aus seiner Heimat geflohen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d624d8-cc17-4e09-ad10-cca9194d2347",
                                "sense_id": "4122cbdd-9424-3dcc-a05c-bdc48d973caa",
                                "text": "Die Zahl der Bootsflüchtlinge auf der Insel Kos nimmt ständig zu."
                            },
                            {
                                "example_id": "2d3310b1-6f82-4594-8774-bb56fb3a0d6b",
                                "sense_id": "4122cbdd-9424-3dcc-a05c-bdc48d973caa",
                                "text": "„So war die Hafenpolizei milde gestimmt und ließ illegale jüdische Bootsflüchtlinge aus Europa zu ihr kommen, anstatt sie zu verhaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
