                            {
                                "example_id": "bd5aa51d-dcdc-4c59-bd43-295483826ea2",
                                "sense_id": "83b6f7e2-b69c-3cbf-9f18-585c29d4a06c",
                                "text": "„Zu diesem Zweck bedienen sie sich einer anderen Art von Arena, nämlich eines ‚Laufkompensators‘: eine 60 Zentimeter durchmessende Plastikkugel, die so gelagert ist, dass sie sich in alle Richtungen frei drehen kann.“"
                            },
                            {
                                "example_id": "66e6b4d4-428a-49c0-8be1-d3febf6aaa58",
                                "sense_id": "83b6f7e2-b69c-3cbf-9f18-585c29d4a06c",
                                "text": "„Die Rauschmittel waren in einer kleinen gelben Plastikkugel versteckt.“"
                            }
                        ],
