{
    "word_family": [
        "manque",
        "manquement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c59cecc-3f51-3fb9-9789-05b2fae37683",
                    "sense_definition": "Être regretté par quelqu'un en raison de son absence ou de son éloignement.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "absence_affective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis ton départ pour l'université, tu me <w>manques</w> beaucoup au quotidien."
                        },
                        {
                            "text": "Mes amis d'enfance me <w>manquent</w> chaque fois que je repense à mon village natal."
                        }
                    ],
                    "common_phrases": [
                        "manquer beaucoup"
                    ]
                },
                {
                    "sense_id": "39cd3a88-58e6-308e-95fb-226fbbde5788",
                    "sense_definition": "Être dépourvu d'une chose nécessaire ou ne pas en posséder en quantité suffisante.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deficit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>manquons</w> cruellement de temps pour finir ce projet avant la fin de la semaine."
                        },
                        {
                            "text": "Le professeur a <w>manqué</w> de patience envers ces élèves particulièrement bruyants."
                        }
                    ],
                    "common_phrases": [
                        "manquer de temps",
                        "manquer de patience"
                    ]
                },
                {
                    "sense_id": "a6ce1ba8-b8fc-37be-866e-86a2d754af80",
                    "sense_definition": "Ne pas réussir à attraper, ne pas atteindre un but ou une cible visée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "echec_cible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu ne te dépêches pas, tu vas <w>manquer</w> le train de huit heures."
                        },
                        {
                            "text": "Le tireur a <w>manqué</w> sa cible de quelques centimètres seulement."
                        }
                    ],
                    "synonyms": [
                        "rater",
                        "louper"
                    ],
                    "antonyms": [
                        "toucher"
                    ],
                    "common_phrases": [
                        "manquer le train",
                        "manquer une occasion"
                    ]
                },
                {
                    "sense_id": "626f0ea4-76e3-3fae-878b-8498ce82551a",
                    "sense_definition": "Ne pas se trouver là où l'on devrait être, faire défaut par son absence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deficit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deux personnes importantes <w>manquent</w> encore à la réunion de ce matin."
                        },
                        {
                            "text": "Il <w>manque</w> plusieurs pages au début de ce vieux livre d'histoire."
                        }
                    ],
                    "common_phrases": [
                        "manquer à l'appel"
                    ]
                },
                {
                    "sense_id": "3087cc32-cf49-3950-8e3e-d51c5d175404",
                    "sense_definition": "Faillir, être tout près de subir ou de faire un événement fâcheux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En descendant l'escalier glissant, il a <w>manqué</w> tomber sur les marches."
                        },
                        {
                            "text": "Le conducteur a <w>manqué</w> percuter un arbre tombé en travers de la chaussée."
                        }
                    ],
                    "common_phrases": [
                        "manquer de tomber"
                    ]
                },
                {
                    "sense_id": "695d74d0-ad95-30ff-b4cc-8f2edefcfc9e",
                    "sense_definition": "Faiblir, s'épuiser ou se dérober, en parlant des forces physiques ou morales.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des heures d'effort sous la canicule, les forces ont fini par lui <w>manquer</w>."
                        },
                        {
                            "text": "Le courage lui a <w>manqué</w> au moment d'annoncer cette terrible nouvelle."
                        }
                    ]
                }
            ]
        }
    ]
}