                },
                {
                    "sense_id": "588f414f-8a11-39b5-995f-15c4e0c627da",
                    "sense_definition": "Qui n'est pas au courant d'un fait précis ou d'un domaine particulier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manque_de_savoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle était totalement <w>ignorante</w> des véritables intentions de ses associés.",
                            "target_lang_translations": {
                                "en": "She was completely <w>unaware</w> of her associates' true intentions.",
                                "ru": "Она была совершенно <w>неосведомлена</w> об истинных намерениях своих компаньонов.",
                                "de": "Sie war über die wahren Absichten ihrer Geschäftspartner völlig <w>ahnungslos</w>.",
                                "es": "Estaba totalmente <w>ajena</w> a las verdaderas intenciones de sus socios.",
                                "zh": "她对合伙人的真实意图完全<w>不知情</w>。"
                            }
                        },
                        {
                            "text": "Je suis tout à fait <w>ignorant</w> en droit et je préfère consulter un avocat.",
                            "target_lang_translations": {
                                "en": "I'm totally <w>ignorant</w> when it comes to law, so I'd rather consult a lawyer.",
                                "ru": "Я совершенно <w>несведущ</w> в юриспруденции и предпочитаю проконсультироваться с адвокатом.",
                                "de": "Ich bin in Rechtsfragen völlig <w>unkundig</w> und ziehe es deshalb vor, einen Anwalt zu konsultieren.",
                                "es": "Soy totalmente <w>profano</w> en materia de derecho y prefiero consultar a un abogado.",
                                "zh": "我对法律完全<w>不熟悉</w>，所以更愿意去咨询律师。"
                            }
                        }
                    ],
                    "antonyms": [
                        "informé",
                        "conscient"
                    ],
                    "common_phrases": [
                        "ignorant du danger",
                        "ignorant des faits"
                    ],
                    "target_lang_definitions": {
                        "en": "Not aware of a specific fact or a particular field.",
