                        "glosses": [
                            "een uitgespannen doek met een leus erop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3677b28-06fb-4db2-b120-d1f920bd4b87",
                                "sense_id": "caa526ac-91f5-3650-af14-69421132d09a",
                                "text": "Het spandoek is een ideaal middel om uw mening uit te dragen."
                            }
                        ]
