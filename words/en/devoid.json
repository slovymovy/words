{
    "word_family": [
        "void",
        "avoid",
        "avoidance"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8b4a7ac-1e4e-38ef-adbf-fb00bef7224b",
                    "sense_definition": "Completely without; having none of.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I went searching for a knife, but the kitchen was <w>devoid</w> of anything sharper than a spoon.",
                            "target_lang_translations": {
                                "ru": "Я пошел искать нож, но на кухне <w>не было</w> ничего острее ложки.",
                                "nl": "Ik ging op zoek naar een mes, maar de keuken was <w>verstoken van</w> alles wat scherper was dan een lepel."
                            }
                        },
                        {
                            "text": "His voice was completely <w>devoid</w> of emotion as he delivered the bad news.",
                            "target_lang_translations": {
                                "ru": "Его голос был совершенно <w>лишен</w> эмоций, когда он сообщал плохие новости.",
                                "nl": "Zijn stem was volledig <w>vrij van</w> emotie toen hij het slechte nieuws bracht."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty",
                        "vacant"
                    ],
                    "antonyms": [
                        "full",
                        "replete"
                    ],
                    "common_phrases": [
                        "devoid of emotion",
                        "devoid of meaning",
                        "completely devoid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью лишенный чего-либо; не имеющий в себе чего-либо.",
                        "nl": "Helemaal zonder; ergens niet over beschikken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишенный",
                                "target_lang_sense_clarification": "не имеющий чего-либо (например, эмоций, смысла)"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "не содержащий ничего внутри"
                            },
                            {
                                "target_lang_word": "свободный",
                                "target_lang_sense_clarification": "в значении «свободный от чего-либо»"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verstoken zijn van",
                                "target_lang_sense_clarification": "niet beschikken over iets, vaak gebruikt in formele context"
                            },
                            {
                                "target_lang_word": "vrij van",
                                "target_lang_sense_clarification": "zonder aanwezigheid van iets"
                            },
                            {
                                "target_lang_word": "leeg",
                                "target_lang_sense_clarification": "niets bevattend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80cf4576-ba39-38cc-aa34-691a8087c118",
                    "sense_definition": "To empty out; to remove.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child will <w>devoid</w> the garbage after he devours his sandwich.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>выбросит</w> мусор после того, как съест свой бутерброд.",
                                "nl": "Het kind zal de prullenbak <w>leegmaken</w> nadat hij zijn broodje op heeft."
                            }
                        },
                        {
                            "text": "They had to <w>devoid</w> the container of its contents before shipping it.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>опустошить</w> контейнер перед отправкой.",
                                "nl": "Ze moesten de container <w>ontledigen</w> voordat ze hem verzonden."
                            }
                        }
                    ],
                    "antonyms": [
                        "fill"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This verb sense is extremely rare and largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опустошать, удалять содержимое (устаревшее значение).",
                        "nl": "Leegmaken; de inhoud verwijderen (verouderd)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "делать пустым, удалять содержимое"
                            },
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "избавляться от содержимого"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "leegmaken",
                                "target_lang_sense_clarification": "de inhoud uit iets halen"
                            },
                            {
                                "target_lang_word": "ontledigen",
                                "target_lang_sense_clarification": "formeel woord voor het leegmaken van een ruimte of voorwerp"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}