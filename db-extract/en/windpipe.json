                                        "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                        "entry_id": "c687dd61-0883-3ac2-83cc-50a7bddf86df",
                                        "glosses": [
                                            "Teil der Atemwege; Zubringer der Atemluft zu den Bronchien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743a64c3-f349-4f16-bbeb-38fe4660ba3e",
                                                "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                                "text": "Sie lachte beim Trinken, so dass etwas Wein in die Luftröhre gelangte."
                                            },
                                            {
                                                "example_id": "2c43dd4f-92e6-4c82-af89-74cf6aa27432",
                                                "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                                "text": "„Die Beschreibung von Stimmritze, Nase mit Velum, Mund, Zunge, Zähnen und Lippen als Artikulatoren und von Lunge, Luftröhre und Larynx mit Glottis als zur Stimmerzeugung notwendigen Werkzeugen entspricht im Wesentlichen der auch heute noch in der artikulatorischen Phonetik benutzten Klassifikation.“"
                                            },
                                            {
                                                "example_id": "90f3f7d5-36bf-4f84-94af-49c42b99bfe4",
                                                "sense_id": "73337b48-45af-3610-941c-ba7dc2621a15",
                                                "text": "„Mit Schwellungen an Lippen, Zunge und in der Luftröhre war der Student bewusstlos ins Krankenhaus eingeliefert worden, sein Zustand war lebensbedrohend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
