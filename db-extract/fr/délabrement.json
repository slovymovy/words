        "fr-extract.jsonl": [
            {
                "entry_id": "43ef4def-d736-370a-8a2a-8866d12e4bc6",
                "word": "délabrement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e958727-8a6e-4ed3-b02b-97de19563b9c",
                        "entry_id": "43ef4def-d736-370a-8a2a-8866d12e4bc6",
                        "tags": [
                            "plural"
                        ],
                        "form": "délabrements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                        "entry_id": "43ef4def-d736-370a-8a2a-8866d12e4bc6",
                        "glosses": [
                            "Action de ce qui se délabre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0527dd53-4ef4-4737-9bd1-9757f01f4b8b",
                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                "text": "Elle se sent déjà engloutie dans le délabrement d'une caravane qui, à chaque kilomètre, se détraquera un peu plus."
                            },
                            {
                                "example_id": "adae2043-6fb2-4d1b-9338-d9baae5427c0",
                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                "text": "Savourer encore quarante pages de Mustang, c’est un meilleur rapport qualité-prix que pour tant d’œuvres littéraires qu’on se doit de lire sous peine de délabrement intellectuel."
                            },
                            {
                                "example_id": "787a57cd-4fe9-4fa3-8c92-64aff3772b83",
                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                "text": "Le délabrement de ses affaires."
                            },
                            {
                                "example_id": "422eb991-f741-4c8f-9041-9a79ea6e201e",
                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                "text": "Le délabrement de sa santé."
                            },
                            {
                                "example_id": "7dc3ad46-efd6-431a-9e4f-1cd967a56252",
                                "sense_id": "ee30182b-4453-383c-a6f6-d14f874ee5ab",
                                "text": "On avait reproché à Zola d’avoir noté que se rendant à Sedan pour y signer sa capitulation devant Bismarck, Napoléon III s’était maquillé pour masquer le délabrement de sa santé inscrit sur son visage. Schöndorfer rappelle qu’à Diên Biên Phu le général de Lattre de Tassigny se maquillait lui aussi pour les mêmes raisons."
                            }
                        ]
                    },
                    {
                        "sense_id": "984a531b-5cef-3cde-a569-3833864695bb",
                        "entry_id": "43ef4def-d736-370a-8a2a-8866d12e4bc6",
                        "glosses": [
                            "État de ce qui est délabré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b2e83f-3f7f-459d-be46-d6f6579092cb",
                                "sense_id": "984a531b-5cef-3cde-a569-3833864695bb",
                                "text": "La tuberculose, la sous-alimentation décimaient ces victimes de la guerre et elles nous arrivaient dans un état de délabrement, de dénuement total."
                            },
                            {
                                "example_id": "9370fce0-75ad-4132-9230-dedc94395758",
                                "sense_id": "984a531b-5cef-3cde-a569-3833864695bb",
                                "text": "D'autres seront déportés pour fait de résistance : Benoît Jean, Bombardier Gabriel, Vouaux Jean. Souvent, dans un état de délabrement physique à leur retour, ils retrouveront leur village meurtri, par l’occupation et les luttes qui y eurent lieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c25fffd5-375b-42f6-a756-4435d511c863",
                        "source_entry_id": "43ef4def-d736-370a-8a2a-8866d12e4bc6",
                        "source_sense_description": "État de ce qui est délabré (1)",
                        "target_lang_word": "disrepair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disrepair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01bcc729-d976-3aae-b6e8-fd2518b42eb3",
                                        "entry_id": "eb632bd4-bef6-35f7-8e04-9d303f01ee93",
                                        "glosses": [
                                            "The state of being in poor condition, in need of repair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075e97d4-9aad-4b32-8812-a57a953203a7",
                                                "sense_id": "01bcc729-d976-3aae-b6e8-fd2518b42eb3",
                                                "text": "The sewing machine is in disrepair."
                                            },
                                            {
                                                "example_id": "6e96bb74-e72c-4aa2-bc7b-86e92f965e07",
                                                "sense_id": "01bcc729-d976-3aae-b6e8-fd2518b42eb3",
                                                "text": "The house had fallen into such disrepair that no agent would show it to buyers."
                                            },
                                            {
                                                "example_id": "01435cf8-dfa5-4d9f-9abe-1fabd1bfc4a5",
                                                "sense_id": "01bcc729-d976-3aae-b6e8-fd2518b42eb3",
                                                "text": "All the A.C.V. four-wheel diesel railbuses are now stored in seeming disrepair at Derby Friargate."
                                            },
                                            {
                                                "example_id": "c53f8614-5236-4381-a6c6-0259137d8803",
                                                "sense_id": "01bcc729-d976-3aae-b6e8-fd2518b42eb3",
                                                "text": "We've defended other nations' borders while refusing to defend our own, and spent trillions and trillions of dollars overseas while America's infrastructure has fallen into disrepair and decay."
                                            },
                                            {
                                                "example_id": "893b76ae-9546-45d7-b26b-6a3f1ce55566",
                                                "sense_id": "01bcc729-d976-3aae-b6e8-fd2518b42eb3",
                                                "text": "The overriding reason that the public estate - be it roads, hospitals or schools - has fallen into disrepair is the continuing lack of economic growth, which has meant no budget can be found to keep assets in a good state of repair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disrepair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59026b13-d28e-30f6-a879-dbc86d71cfae",
                                        "entry_id": "a0198265-0f2f-3d00-9a96-88901f7bc5d0",
                                        "glosses": [
                                            "To get into a state of disrepair."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43de563f-69a6-4764-96b5-605161eae6ee",
                                                "sense_id": "59026b13-d28e-30f6-a879-dbc86d71cfae",
                                                "text": "The house was disrepairing before your very eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
