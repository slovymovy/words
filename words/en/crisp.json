{
    "word_family": [
        "crispy",
        "crispness",
        "crisply",
        "crispen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d77c2648-fe30-3551-9c4b-f61d82d1e1f0",
                    "sense_definition": "Having a consistency which is hard yet brittle, and easily broken with a sharp snap; often used to describe fresh food.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "texture_brittle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crisp</w> snow crunched loudly under our boots.",
                            "target_lang_translations": {
                                "ru": "<w>Хрустящий</w> снег громко скрипел под нашими ботинками.",
                                "zh": "靴子踩在<w>脆</w>雪上发出咯吱咯吱的响声。"
                            }
                        },
                        {
                            "text": "I enjoy eating a <w>crisp</w> apple for a snack.",
                            "target_lang_translations": {
                                "ru": "Мне нравится есть <w>хрустящее</w> яблоко на перекус.",
                                "zh": "我喜欢吃个<w>脆</w>苹果当零食。"
                            }
                        }
                    ],
                    "antonyms": [
                        "flabby"
                    ],
                    "common_phrases": [
                        "crisp apple",
                        "crisp bacon",
                        "crisp lettuce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий твердую, но ломкую консистенцию, легко ломающийся с резким хрустом; часто используется для описания свежих продуктов.",
                        "zh": "指食物或物体质地坚硬而脆，容易折断或咬碎，常用于形容新鲜的食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрустящий",
                                "target_lang_sense_clarification": "о еде или текстуре"
                            },
                            {
                                "target_lang_word": "свежий",
                                "target_lang_sense_clarification": "о продуктах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脆的",
                                "target_lang_sense_clarification": "形容食物口感"
                            },
                            {
                                "target_lang_word": "酥脆的",
                                "target_lang_sense_clarification": "形容口感酥脆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6cdb567-7b3f-3301-95c1-e878e02b78d8",
                    "sense_definition": "Of air or weather: pleasantly cool, dry, and invigorating.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "weather_cool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a long walk in the <w>crisp</w> autumn air.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на долгую прогулку по <w>свежему</w> осеннему воздуху.",
                                "zh": "我们在<w>清爽</w>的秋日空气中散了很久的步。"
                            }
                        },
                        {
                            "text": "The morning was <w>crisp</w> and sunny, perfect for a hike.",
                            "target_lang_translations": {
                                "ru": "Утро было <w>свежим</w> и солнечным, идеальным для похода.",
                                "zh": "早晨<w>清爽</w>且阳光明媚，非常适合徒步旅行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crisp air",
                        "crisp morning",
                        "crisp autumn day"
                    ],
                    "target_lang_definitions": {
                        "ru": "О воздухе или погоде: приятно прохладный, сухой и бодрящий.",
                        "zh": "指空气或天气：凉爽、干燥且令人精神振奋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свежий",
                                "target_lang_sense_clarification": "о воздухе"
                            },
                            {
                                "target_lang_word": "бодрящий",
                                "target_lang_sense_clarification": "о погоде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清爽的",
                                "target_lang_sense_clarification": "形容空气或天气"
                            },
                            {
                                "target_lang_word": "凉爽的",
                                "target_lang_sense_clarification": "形容天气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca2b1059-b53b-33c5-931b-83bed7e9266e",
                    "sense_definition": "Of fabric, paper, or similar materials: firm, stiff, smooth, and unwrinkled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "texture_stiff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on a fresh, <w>crisp</w> shirt for the interview.",
                            "target_lang_translations": {
                                "ru": "Он надел свежую, <w>накрахмаленную</w> рубашку на собеседование.",
                                "zh": "他穿了一件干净、<w>挺括</w>的衬衫去参加面试。"
                            }
                        },
                        {
                            "text": "The nurse changed the bed with clean, <w>crisp</w> sheets.",
                            "target_lang_translations": {
                                "ru": "Медсестра перестелила кровать чистыми, <w>хрустящими</w> простынями.",
                                "zh": "护士换上了干净、<w>平整</w>的床单。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crisp shirt",
                        "crisp sheets",
                        "crisp paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "О ткани, бумаге или подобных материалах: твердый, жесткий, гладкий и немятый.",
                        "zh": "指织物、纸张等材料：挺括、平整且没有褶皱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрустящий",
                                "target_lang_sense_clarification": "о ткани или бумаге"
                            },
                            {
                                "target_lang_word": "накрахмаленный",
                                "target_lang_sense_clarification": "о рубашке или белье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挺括的",
                                "target_lang_sense_clarification": "形容衣物平整"
                            },
                            {
                                "target_lang_word": "平整的",
                                "target_lang_sense_clarification": "形容纸张或布料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ece4afb1-e333-345f-80c2-0e5a86018f1b",
                    "sense_definition": "Of an image or sound: clearly defined, sharp, and easy to see or hear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity_sharp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new television set has a very <w>crisp</w> image.",
                            "target_lang_translations": {
                                "ru": "У этого нового телевизора очень <w>чёткое</w> изображение.",
                                "zh": "这台新电视的图像非常<w>清晰</w>。"
                            }
                        },
                        {
                            "text": "The sound from the speakers was <w>crisp</w> and clear.",
                            "target_lang_translations": {
                                "ru": "Звук из колонок был <w>чётким</w> и ясным.",
                                "zh": "扬声器发出的声音<w>清晰</w>明亮。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crisp image",
                        "crisp sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Об изображении или звуке: четко очерченный, резкий и легкий для восприятия.",
                        "zh": "指图像或声音：轮廓清晰、锐利，易于辨认或听清。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёткий",
                                "target_lang_sense_clarification": "об изображении или звуке"
                            },
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о звуке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清晰的",
                                "target_lang_sense_clarification": "形容图像或声音"
                            },
                            {
                                "target_lang_word": "清脆的",
                                "target_lang_sense_clarification": "形容声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec80cce5-4b0f-33da-8180-0af99a30d11c",
                    "sense_definition": "Of a person's manner, speech, or action: quick, precise, and brief; brisk.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner_brisk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave a <w>crisp</w> answer to the difficult question.",
                            "target_lang_translations": {
                                "ru": "Менеджер дал <w>чёткий</w> ответ на сложный вопрос.",
                                "zh": "经理对那个难题给出了<w>干脆</w>的回答。"
                            }
                        },
                        {
                            "text": "Her writing style is <w>crisp</w> and professional.",
                            "target_lang_translations": {
                                "ru": "Её стиль письма <w>лаконичный</w> и профессиональный.",
                                "zh": "她的写作风格<w>简洁</w>且专业。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crisp answer",
                        "crisp tone",
                        "crisp style"
                    ],
                    "target_lang_definitions": {
                        "ru": "О манере, речи или действиях человека: быстрый, точный и краткий; решительный.",
                        "zh": "指人的态度、言谈或行动：干脆、利落、简明扼要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёткий",
                                "target_lang_sense_clarification": "об ответе или действии"
                            },
                            {
                                "target_lang_word": "лаконичный",
                                "target_lang_sense_clarification": "о стиле речи"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о тоне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "干脆的",
                                "target_lang_sense_clarification": "形容态度或回答"
                            },
                            {
                                "target_lang_word": "简洁的",
                                "target_lang_sense_clarification": "形容文风或言谈"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "649393cc-bebb-3496-98f9-75724fa9982e",
                    "sense_definition": "A thin slice of potato deep-fried until brittle and crunchy, eaten as a snack.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_snack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a packet of cheese and onion <w>crisps</w>.",
                            "target_lang_translations": {
                                "ru": "Она купила пачку <w>чипсов</w> с сыром и луком.",
                                "zh": "她买了一包芝士洋葱味的<w>薯片</w>。"
                            }
                        },
                        {
                            "text": "Would you like some potato <w>crisps</w> with your sandwich?",
                            "target_lang_translations": {
                                "ru": "Хотите картофельные <w>чипсы</w> к сэндвичу?",
                                "zh": "你的三明治要配点<w>薯片</w>吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "chip",
                        "potato chip"
                    ],
                    "common_phrases": [
                        "packet of crisps",
                        "bag of crisps",
                        "potato crisps"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий ломтик картофеля, обжаренный во фритюре до хруста, употребляемый как закуска.",
                        "zh": "一种切成薄片并油炸至酥脆的马铃薯零食。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чипсы",
                                "target_lang_sense_clarification": "британский английский"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薯片",
                                "target_lang_sense_clarification": "马铃薯零食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63df1611-e896-3582-9106-b8940731fe56",
                    "sense_definition": "Used in the phrase 'to a crisp': a state of being burned, charred, or dried out completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_burnt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally left the toast in too long and it burned to a <w>crisp</w>.",
                            "target_lang_translations": {
                                "ru": "Я случайно оставил тост слишком надолго, и он сгорел <w>до углей</w>.",
                                "zh": "我不小心把吐司烤太久，结果<w>烧焦</w>了。"
                            }
                        },
                        {
                            "text": "He stayed in the sun all day and roasted to a <w>crisp</w>.",
                            "target_lang_translations": {
                                "ru": "Он пробыл на солнце весь день и обгорел <w>до корочки</w>.",
                                "zh": "他在太阳下待了一整天，皮肤都<w>晒伤</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "burnt to a crisp",
                        "roasted to a crisp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в выражении 'to a crisp': состояние, когда что-то полностью сгорело, обуглилось или высохло.",
                        "zh": "用于短语 'to a crisp'：指完全烧焦、烤焦或干透的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "до хруста",
                                "target_lang_sense_clarification": "в идиомах"
                            },
                            {
                                "target_lang_word": "до углей",
                                "target_lang_sense_clarification": "о сильной степени обжарки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烧焦",
                                "target_lang_sense_clarification": "指食物烤糊"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a408fbc-a637-369e-92a3-b83866aee633",
