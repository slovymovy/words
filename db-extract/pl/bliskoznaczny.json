                                        "entry_id": "32b5dea9-ee2b-39ca-9a32-73d7302029a2",
                                        "glosses": [
                                            "Having a similar (sometimes identical) meaning. (See Usage notes below)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde42b82-f697-4529-a353-5b371e42067c",
                                                "sense_id": "07a333f1-c7d7-3846-86d5-1998a0cd6a98",
                                                "text": "He was not far wrong, for nothing strikes me more forcibly than the universal tendency to grumble: conversation and complaint are synonymous terms."
                                            },
                                            {
                                                "example_id": "808c221f-92cf-49ec-8ff9-48285b5e7150",
                                                "sense_id": "07a333f1-c7d7-3846-86d5-1998a0cd6a98",
                                                "text": "Jews and Israel are not synonymous; nor is support for Palestine synonymous with anti-Semitism; nor is questioning the orthodoxy of the Republican party, which the majority of us do with relish, an insult to Jewry."
                                            },
                                            {
                                                "example_id": "ce1e0350-52eb-44f4-b828-215f520f634d",
                                                "sense_id": "07a333f1-c7d7-3846-86d5-1998a0cd6a98",
                                                "text": "For much of the time that incels have self-described as such, their collective worldview has been synonymous with the ‘blackpill’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e91a73-3ec0-3f7c-803f-067ab392b418",
                                        "entry_id": "32b5dea9-ee2b-39ca-9a32-73d7302029a2",
                                        "glosses": [
                                            "Of, or being a synonym."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf444cb0-18a7-3f7f-a21b-182e97c097d4",
                                        "entry_id": "32b5dea9-ee2b-39ca-9a32-73d7302029a2",
                                        "glosses": [
                                            "Such that both its forms yield the same sequenced protein."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
