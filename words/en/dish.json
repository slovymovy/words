                    "sense_definition": "To gossip or share private information about someone else.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the whole afternoon <w>dishing</w> about their neighbors' secrets.",
                            "target_lang_translations": {
                                "ru": "Они провели весь день, <w>сплетничая</w> о секретах своих соседей."
                            }
                        },
                        {
                            "text": "It is not polite to <w>dish</w> the dirt on your coworkers.",
                            "target_lang_translations": {
                                "ru": "Невежливо <w>перемывать косточки</w> своим коллегам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dish the dirt"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal verb for gossiping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплетничать или делиться частной информацией о ком-то другом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетничать",
                                "target_lang_sense_clarification": "обсуждать других"
                            },
                            {
                                "target_lang_word": "судачить",
                                "target_lang_sense_clarification": "разг. о сплетнях"
                            }
                        ]
                    }
