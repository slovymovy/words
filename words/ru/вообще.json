                        "es": [
                            {
                                "target_lang_word": "increíble",
                                "target_lang_sense_clarification": "usado para expresar sorpresa o choque"
                            },
                            {
                                "target_lang_word": "totalmente",
                                "target_lang_sense_clarification": "intensificador coloquial"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "vraiment",
                                "target_lang_sense_clarification": "intensificateur émotionnel"
                            },
                            {
                                "target_lang_word": "incroyable",
                                "target_lang_sense_clarification": "utilisé pour exprimer le choc ou la surprise"
                            },
                            {
                                "target_lang_word": "totalement",
                                "target_lang_sense_clarification": "intensificateur pour des états extrêmes"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简直",
                                "target_lang_sense_clarification": "用于加强语气，表示不可思议"
                            },
                            {
                                "target_lang_word": "太",
                                "target_lang_sense_clarification": "口语中加强感叹语气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f4df710-5517-36d0-a7d1-d94a364a4892",
                    "sense_definition": "В общих чертах, приблизительно, не вдаваясь в подробности.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я представляю себе этот план <w>вообще</w>, без конкретных деталей.",
                            "target_lang_translations": {
                                "en": "I imagine this plan <w>in general terms</w>, without specific details.",
                                "es": "Me imagino este plan <w>a grandes rasgos</w>, sin detalles concretos.",
                                "fr": "J'imagine ce plan <w>en gros</w>, sans détails précis.",
                                "zh": "我<w>大体上</w>构思了这个计划，没有具体的细节。"
                            }
                        },
                        {
                            "text": "Мы договорились <w>вообще</w>, а подробности обсудим при встрече.",
                            "target_lang_translations": {
                                "en": "We agreed <w>in principle</w>, and we will discuss the details when we meet.",
                                "es": "Hemos acordado <w>en principio</w>, y discutiremos los detalles cuando nos reunamos.",
                                "fr": "Nous sommes tombés d'accord <w>en principe</w>, et nous discuterons des détails lors de notre rencontre.",
                                "zh": "我们已经<w>原则上</w>达成了一致，细节见面再谈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в общих чертах",
                        "приблизительно"
                    ],
                    "target_lang_definitions": {
                        "en": "In general terms, approximately, without going into details.",
                        "es": "En términos generales, aproximadamente, sin entrar en detalles.",
                        "fr": "En termes généraux, approximativement, sans entrer dans les détails.",
                        "zh": "大体上，粗略地，不涉及细节。"
                    },
