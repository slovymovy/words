                    {
                        "translation_id": "a4f0dfce-d773-4365-a3a6-04fe3aec615a",
                        "source_entry_id": "79f64eef-39f8-336f-a0a7-2a2023443632",
                        "source_sense_id": "ee81d66a-914f-3609-87bf-201e1ca75025",
                        "source_sense_description": "unbrauchbare Dinge, Stoffe und Ähnliches, die in privaten Haushalten anfallen",
                        "target_lang_word": "ordures ménagères",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordures ménagères",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66cc1eed-0cf5-3a35-b41d-261b7956b198",
                                        "entry_id": "e007c861-50d4-31c7-9969-a85dc1f0b58a",
                                        "glosses": [
                                            "Déchets domestiques produits par les activités quotidiennes des ménages (restes alimentaires, emballages, objets usagés), collectés par les services municipaux."
                                        ],
                                        "tags": [
                                            "Gestion des déchets"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d680732-1f02-4ece-88b8-01be25ee7d06",
                                                "sense_id": "66cc1eed-0cf5-3a35-b41d-261b7956b198",
                                                "text": "Le danger des mouches et le danger des odeurs subsistent si les ordures ménagères ne sont pas complètement recouvertes par une couche de terre meuble ou de sable, ce qui est pratiquement impossible, […]."
                                            },
                                            {
                                                "example_id": "3b6524e6-e5e1-4d03-800a-62076a433977",
                                                "sense_id": "66cc1eed-0cf5-3a35-b41d-261b7956b198",
                                                "text": "Le service d'élimination des ordures ménagères est un service public local mis en œuvre par les collectivités locales et les établissements publics de coopération intercommunale."
                                            },
                                            {
                                                "example_id": "03a77da9-3fb2-4336-b5a6-4cefa3158b4a",
                                                "sense_id": "66cc1eed-0cf5-3a35-b41d-261b7956b198",
                                                "text": "254 kilos. C’est la quantité d’ordures ménagères produite chaque année par un Français. Soit le poids de deux réfrigérateurs américains. Une fois collectées, les poubelles grises sont envoyées en décharge ou brûlées dans des incinérateurs."
                                            },
                                            {
                                                "example_id": "a258835f-80b2-47d0-8fff-a4cdaf0f6f12",
                                                "sense_id": "66cc1eed-0cf5-3a35-b41d-261b7956b198",
                                                "text": "Il convient bien de différencier les déchets ménagers et assimilés (DMA), qui sont l'ensemble des ordures jetées par un ménage (poubelle grise, poubelle de tri, encombrants, déchets dangereux, etc.) et les ordures ménagères résiduelles (OMR), qui composent uniquement la poubelle grise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
