                "senses": [
                    {
                        "sense_id": "58014b38-bfff-3dab-91f7-3932c4cc7d3d",
                        "entry_id": "8b8c5dfe-a400-3819-8a86-583ec136f3c1",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным успокоение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144083b6-396b-4e72-88be-fd2e0a1dd544",
                                "sense_id": "58014b38-bfff-3dab-91f7-3932c4cc7d3d",
                                "text": "Он сделал успокоительный жест рукой: мол, порядок, гражданочка, можете рассчитывать на полное мое уважение."
                            }
                        ]
                    },
