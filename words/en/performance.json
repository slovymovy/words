{
    "word_family": [
        "perform",
        "performer",
        "performative",
        "performing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f95664fc-901c-3894-ad90-66642e02ea91",
                    "sense_definition": "A live show, concert, play, or other form of entertainment presented to an audience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a mix of old and new songs during their 90-minute <w>performance</w>.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла смесь старых и новых песен во время своего 90-минутного <w>выступления</w>.",
                                "zh": "乐队在他们90分钟的<w>演出</w>中演唱了新老歌曲的串烧。"
                            }
                        },
                        {
                            "text": "We bought tickets to see the evening <w>performance</w> of the ballet.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты на вечернее <w>представление</w> балета.",
                                "zh": "我们买了芭蕾舞晚场<w>表演</w>的票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "show",
                        "presentation",
                        "concert",
                        "production",
                        "act",
                        "gig"
                    ],
                    "common_phrases": [
                        "live performance",
                        "give a performance",
                        "theatrical performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живое шоу, концерт, пьеса или другая форма развлечения, представленная публике.",
                        "zh": "在观众面前进行的现场表演、音乐会、戏剧或其他娱乐形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступление",
                                "target_lang_sense_clarification": "исполнение номеров перед публикой (концерт, речь)"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "зрелищное действо, шоу"
                            },
                            {
                                "target_lang_word": "спектакль",
                                "target_lang_sense_clarification": "театральная постановка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表演",
                                "target_lang_sense_clarification": "泛指各种艺术形式的演出"
                            },
                            {
                                "target_lang_word": "演出",
                                "target_lang_sense_clarification": "指正式的舞台表演或节目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8eb9f87-e6fa-31f5-be90-c3839c97ca8b",
                    "sense_definition": "The standard or quality of how well a person, machine, or organization functions or completes a task.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Better <w>performance</w> means more work accomplished in a shorter time.",
                            "target_lang_translations": {
                                "ru": "Более высокая <w>производительность</w> означает больше работы, выполненной за меньшее время.",
                                "zh": "更好的<w>表现</w>意味着在更短的时间内完成更多的工作。"
                            }
                        },
                        {
                            "text": "The manager conducted a review to evaluate the <w>performance</w> of the team.",
                            "target_lang_translations": {
                                "ru": "Менеджер провел проверку, чтобы оценить <w>эффективность</w> работы команды.",
                                "zh": "经理进行了一次评估，以考察团队的<w>业绩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "efficiency",
                        "functioning",
                        "operation"
                    ],
                    "common_phrases": [
                        "high performance",
                        "performance review",
                        "improve performance",
                        "poor performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество функционирования человека, машины или организации; эффективность выполнения задач.",
                        "zh": "人、机器或组织运作或完成任务的质量或水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производительность",
                                "target_lang_sense_clarification": "способность производить определенное количество работы (обычно о технике)"
                            },
                            {
                                "target_lang_word": "эффективность",
                                "target_lang_sense_clarification": "результативность работы (людей или процессов)"
                            },
                            {
                                "target_lang_word": "рабочие характеристики",
                                "target_lang_sense_clarification": "технические показатели работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表现",
                                "target_lang_sense_clarification": "指人或团队在工作中的实际水平"
                            },
                            {
                                "target_lang_word": "性能",
                                "target_lang_sense_clarification": "指机器或设备的运行能力"
                            },
                            {
                                "target_lang_word": "业绩",
                                "target_lang_sense_clarification": "指组织或个人的工作成果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5f2730b-d787-345e-9a75-bfb4e062cc82",
                    "sense_definition": "The act of carrying out or executing a duty, task, or action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was extremely diligent in the <w>performance</w> of his duties.",
                            "target_lang_translations": {
                                "ru": "Он был чрезвычайно усерден при <w>исполнении</w> своих обязанностей.",
                                "zh": "他在<w>履行</w>职责时非常勤勉。"
                            }
                        },
                        {
                            "text": "The <w>performance</w> of this undertaking requires careful planning and execution.",
                            "target_lang_translations": {
                                "ru": "<w>Выполнение</w> этого начинания требует тщательного планирования и осуществления.",
                                "zh": "这项任务的<w>执行</w>需要周密的计划和实施。"
                            }
                        }
                    ],
                    "synonyms": [
                        "execution",
                        "implementation",
                        "discharge",
                        "accomplishment"
                    ],
                    "common_phrases": [
                        "performance of duties",
                        "in the performance of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс выполнения или осуществления долга, задачи или действия.",
                        "zh": "执行或实施职责、任务或行动的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнение",
                                "target_lang_sense_clarification": "осуществление обязанностей или долга"
                            },
                            {
                                "target_lang_word": "выполнение",
                                "target_lang_sense_clarification": "реализация задачи или плана"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "履行",
                                "target_lang_sense_clarification": "指执行职责或义务"
                            },
                            {
                                "target_lang_word": "执行",
                                "target_lang_sense_clarification": "指实施某项任务或计划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44aca60f-9e9e-3dfb-b45b-00a6cb2aef00",
                    "sense_definition": "The actual use of language in concrete situations by native speakers, as opposed to their internal linguistic knowledge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chomsky distinguished between linguistic competence and linguistic <w>performance</w>.",
                            "target_lang_translations": {
                                "ru": "Хомский проводил различие между языковой компетенцией и языковым <w>исполнением</w>.",
                                "zh": "乔姆斯基区分了语言能力和<w>语言运用</w>。"
                            }
                        },
                        {
                            "text": "Errors in speech are often attributed to <w>performance</w> rather than a lack of knowledge.",
                            "target_lang_translations": {
                                "ru": "Ошибки в речи часто приписывают особенностям <w>исполнения</w>, а не недостатку знаний.",
                                "zh": "言语中的错误通常被归因于<w>语言运用</w>，而非知识匮乏。"
                            }
                        }
                    ],
                    "antonyms": [
                        "competence"
                    ],
                    "common_phrases": [
                        "linguistic performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Реальное использование языка в конкретных ситуациях носителями языка (в отличие от языкового знания).",
                        "zh": "语言学中指语言使用者在具体情境中对语言的实际运用，与内在的语言能力相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнение",
                                "target_lang_sense_clarification": "лингвистический термин (противопоставляется компетенции)"
                            },
                            {
                                "target_lang_word": "речевая деятельность",
                                "target_lang_sense_clarification": "процесс использования языка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "语言运用",
                                "target_lang_sense_clarification": "语言学中与语言能力相对的概念"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}