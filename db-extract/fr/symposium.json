                        "form": "symposion"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b35fd59-ff68-3c1b-bf59-a850b79d3868",
                        "entry_id": "d7710d45-0902-34c1-8d96-f747aa348e57",
                        "glosses": [
                            "Seconde partie d'un repas, correspondant aujourd'hui au dessert, pendant laquelle un groupe restreint de convives buvaient et discouraient sur un sujet."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "7e7b031a-1c16-428d-94bd-3ed2f5f1ab5e",
                                "sense_id": "0b35fd59-ff68-3c1b-bf59-a850b79d3868",
                                "text": "Pour les Grecs, ce cérémonial prend une forme particulière à travers la pratique du symposium, dont la traduction par le mot banquet ne reflète qu’une partie seulement de la définition."
                            }
                        ]
                    },
                    {
                        "sense_id": "b92b3bb5-3df0-3ffe-ae98-b586e146a235",
                        "entry_id": "d7710d45-0902-34c1-8d96-f747aa348e57",
                        "glosses": [
                            "Congrès scientifique réunissant des spécialistes et traitant d’un sujet particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c95808-9531-49ab-9011-4399e952e305",
                                "sense_id": "b92b3bb5-3df0-3ffe-ae98-b586e146a235",
                                "text": "Cette discussion […] est toujours actuelle, car l’on pouvait lire, dans le compte rendu d’un récent symposium, une spirituelle apostrophe du même C. H. Andrews, président de la session."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e063c822-7cbd-4b75-a44a-2dbfb632589c",
                        "source_entry_id": "d7710d45-0902-34c1-8d96-f747aa348e57",
                        "target_lang_word": "Symposion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
