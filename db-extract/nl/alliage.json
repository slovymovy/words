                                        "glosses": [
                                            "homogene Mischung unterschiedlicher Metalle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af7172e-7cef-41ac-9fe7-267b91b440be",
                                                "sense_id": "c23d3bb7-6889-3224-846a-e1d94c0174c4",
                                                "text": "Legierungen wurden schon früh in der Menschheitsgeschichte erfunden."
                                            },
                                            {
                                                "example_id": "8afc81ae-f9b8-40a7-84fc-bcd301129958",
                                                "sense_id": "c23d3bb7-6889-3224-846a-e1d94c0174c4",
                                                "text": "„In die nun leere Hülle gießt er das heiße, flüssige Metall, eine Legierung aus Kupfer und anderen Elementen, vor allem Zinn oder Zink.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de0abcec-cf56-4ece-a8c7-0617fc852046",
                        "source_entry_id": "2b77d286-a718-32bf-acfd-040affd3729e",
                        "target_lang_word": "alloy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alloy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "353b5281-aeed-35ea-abe3-70e51512c50b",
                                        "entry_id": "6ab4ca3b-58d1-311f-b904-acaee64505e6",
                                        "glosses": [
                                            "A metal that is a combination of two or more elements, at least one of which is a metal, a base metal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f11e0ac-8b8e-3284-b4fb-07842f80b025",
                                        "entry_id": "6ab4ca3b-58d1-311f-b904-acaee64505e6",
                                        "glosses": [
                                            "A metal of lesser value, mixed with a metal of greater value."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "259108fa-cdfb-4521-a40a-4c150a831d16",
                                                "sense_id": "1f11e0ac-8b8e-3284-b4fb-07842f80b025",
                                                "text": "gold without alloy"
                                            },
                                            {
                                                "example_id": "10c87afd-4a78-4680-a0fe-6ab2beb876cf",
                                                "sense_id": "1f11e0ac-8b8e-3284-b4fb-07842f80b025",
                                                "text": "Many of these coins are preserved at the British Museum, in London, and at the Ashmolean Museum, in Oxford, and are all of pure gold, without alloy, and in a good state of preservation. Boadicea, Queen of the Iceni, is also said to have[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56ddb9a1-982c-3b0c-9a0a-1b07e8764c6a",
                                        "entry_id": "6ab4ca3b-58d1-311f-b904-acaee64505e6",
                                        "glosses": [
                                            "An admixture; something added which stains, taints etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b42cc80d-209d-4297-bb40-48a1881c9b72",
                                                "sense_id": "56ddb9a1-982c-3b0c-9a0a-1b07e8764c6a",
                                                "text": "Metrodorus said that in sadnesse there is some aloy of pleasure."
                                            },
                                            {
                                                "example_id": "1610e3ba-a928-4603-835b-366a412e87fe",
                                                "sense_id": "56ddb9a1-982c-3b0c-9a0a-1b07e8764c6a",
                                                "text": "The sole grievance and alloy thus removed in the prospect of Harriet’s welfare, she was really in danger of becoming too happy for security."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abbad2ed-ced6-3060-ab54-4892775e5d09",
                                        "entry_id": "6ab4ca3b-58d1-311f-b904-acaee64505e6",
                                        "glosses": [
                                            "Fusion, marriage, combination."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b5fb2b-14b3-45db-9c34-f0dca17e29b0",
                                                "sense_id": "abbad2ed-ced6-3060-ab54-4892775e5d09",
                                                "text": "SETH KITANGE TELEVISION AND RADIO Upheaval at CBS. […] Bill Moyers, a CBS News commentator and special correspondent, expressed his dismay in an interview with Newsweek in which he said, “Television news has never been pure. It has always been an alloy of journalism and show business.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alloy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc2a2068-8b11-3ce3-a72c-69fd7226cfa0",
                                        "entry_id": "85a87172-bc8b-37d6-b8b8-1770aa69ba57",
                                        "glosses": [
                                            "To mix or combine; often used of metals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ad8c320-f946-380e-babe-6616cc11b22a",
                                        "entry_id": "85a87172-bc8b-37d6-b8b8-1770aa69ba57",
                                        "glosses": [
                                            "To reduce the purity of by mixing with a less valuable substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "834921fb-a38d-46ec-ad76-58764d8360f4",
                                                "sense_id": "6ad8c320-f946-380e-babe-6616cc11b22a",
                                                "text": "to alloy gold with silver or copper, or silver with copper"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f3a0ae4-7818-34fd-9ed6-0ebe82074e27",
                                        "entry_id": "85a87172-bc8b-37d6-b8b8-1770aa69ba57",
                                        "glosses": [
                                            "To impair or debase by mixture."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8f8c0e3-be96-493e-bb4c-c26b8d425f0b",
                                                "sense_id": "3f3a0ae4-7818-34fd-9ed6-0ebe82074e27",
                                                "text": "to alloy pleasure with misfortunes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e568ed58-94fd-402f-a3f2-2401e615af8f",
                        "source_entry_id": "2b77d286-a718-32bf-acfd-040affd3729e",
                        "target_lang_word": "alliage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alliage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "336eeb3f-d05c-30ae-bd83-6c26efc5db0f",
                                        "entry_id": "14f27e6c-0a59-33cc-a58c-5a3dc0c59648",
                                        "glosses": [
                                            "Action de combiner plusieurs éléments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4793d9dd-4b81-4ca3-b2eb-f944d2992a99",
                                                "sense_id": "336eeb3f-d05c-30ae-bd83-6c26efc5db0f",
                                                "text": "L'alliage des métaux est une technologie très ancienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c98f8af9-5639-362a-b61d-148b19b61021",
                                        "entry_id": "14f27e6c-0a59-33cc-a58c-5a3dc0c59648",
                                        "glosses": [
                                            "Produit résultant de la combinaison d'un métal avec un ou plusieurs autres corps, éléments, le plus souvent métallique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2660668-d9c2-4bf5-b005-325180d7f504",
                                                "sense_id": "c98f8af9-5639-362a-b61d-148b19b61021",
                                                "text": "Il souleva le siège et le tint en équilibre sur son petit doigt.\n– C’est assez léger, hein ? Alliage d’aluminium et de magnésium, et on a fait le vide à l’intérieur."
                                            },
                                            {
                                                "example_id": "60b91bdc-818a-478a-b543-66db259f7659",
                                                "sense_id": "c98f8af9-5639-362a-b61d-148b19b61021",
                                                "text": "Bien que le carbone ne soit pas un métal, on considère que lʼacier est un alliage parce que le fer est modifié par sa présence."
                                            },
                                            {
                                                "example_id": "fdd1a268-cd63-42d8-bc7d-73060331e180",
                                                "sense_id": "c98f8af9-5639-362a-b61d-148b19b61021",
                                                "text": "L'alliage fusible de Darcet, composé de bismuth, de plomb et d'étain, à une température de fusion de 94°C"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a3ae5c-d5c0-38e7-b84d-628de1e09880",
                                        "entry_id": "14f27e6c-0a59-33cc-a58c-5a3dc0c59648",
                                        "glosses": [
                                            "Quelqu’un des éléments que l’on combine avec un métal plus précieux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c82a607-d9f8-4758-a622-bce0e13acbe9",
                                                "sense_id": "93a3ae5c-d5c0-38e7-b84d-628de1e09880",
                                                "text": "L’emploi du plomb doré, de cet alliage relativement moins coûteux, fut une des trouvailles de Versailles."
                                            },
                                            {
                                                "example_id": "9898a81b-d50a-4268-9fbf-3c6bf1970569",
                                                "sense_id": "93a3ae5c-d5c0-38e7-b84d-628de1e09880",
                                                "text": "L’argent et le cuivre servent d’alliage à l’or. — De l’or sans alliage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "755fff99-8717-3d0d-912c-4a44e72984f7",
                                        "entry_id": "14f27e6c-0a59-33cc-a58c-5a3dc0c59648",
                                        "glosses": [
                                            "Mélange, rencontre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac92e06-135e-4bad-8877-9b2616929362",
                                                "sense_id": "755fff99-8717-3d0d-912c-4a44e72984f7",
                                                "text": "Cet édifice résulte de l'alliage entre les architectures greco-romaine et byzantine."
                                            },
                                            {
                                                "example_id": "23c091f0-307a-4249-8e56-458350df1065",
                                                "sense_id": "755fff99-8717-3d0d-912c-4a44e72984f7",
                                                "text": "Il faut en convenir, le regard de Julien était atroce, sa physionomie hideuse ; elle respirait le crime sans alliage."
                                            },
                                            {
                                                "example_id": "7a4210c1-59ad-40af-b870-517e73e0e79b",
                                                "sense_id": "755fff99-8717-3d0d-912c-4a44e72984f7",
                                                "text": "Emma s’aperçut que son bonheur n’était pas exempt de tout alliage : il restait deux sujets de préoccupation : son père et Henriette."
                                            },
                                            {
                                                "example_id": "9bce9711-e8db-4f01-8620-720f461d62ff",
                                                "sense_id": "755fff99-8717-3d0d-912c-4a44e72984f7",
                                                "text": "Il était cet alliage étrange : un athée ami des prêtres, un individualiste syndiqué, un libertaire admirateur de Lénine, un nostalgique sans tendresse pour les nostalgies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
