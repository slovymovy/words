                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "фиска́льны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2d76aff-d6ed-3468-a252-d707c06baa9c",
                        "entry_id": "416d46ea-3894-341c-bc1d-5f0af7725668",
                        "glosses": [
                            "связанный с фиском, служащий интересам государственной казны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016815b5-09e2-403e-b2d5-0725fbcd8044",
                                "sense_id": "f2d76aff-d6ed-3468-a252-d707c06baa9c",
                                "text": "Я никому ничего не должен, я плачу обществу деньги в виде фискальных поборов за то, чтоб меня не обокрали, не прибили и не убили, а больше никто ничего с меня требовать не смеет."
                            },
                            {
                                "example_id": "b7d8ae05-fba5-4fff-9193-db5b9929f4c9",
                                "sense_id": "f2d76aff-d6ed-3468-a252-d707c06baa9c",
                                "text": "Фискальная система, по которой община платила подати за тех, кто бежал от фиска, заставляла посадских людей самих просить запрета менять им место жительства."
                            }
                        ]
