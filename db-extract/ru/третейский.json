                ],
                "senses": [
                    {
                        "sense_id": "cf0e7d01-b644-330e-80b6-478b39bd5243",
                        "entry_id": "ba1f6d65-9935-37c1-a2cd-a5f253ca9e87",
                        "glosses": [
                            "связанный с судейством, разбором спора, конфликта и т. п. третьей, незаинтересованной стороной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf23bed2-9750-4d2d-80e3-141d4bc9e8a7",
                                "sense_id": "cf0e7d01-b644-330e-80b6-478b39bd5243",
                                "text": "Правительства согласятся решать свои несогласия третейским судом и потому распустят войска."
                            },
                            {
                                "example_id": "bcb90e24-e090-4551-93e2-11a14f361da0",
                                "sense_id": "cf0e7d01-b644-330e-80b6-478b39bd5243",
                                "text": "Президент американского третейского бюро Джон Баррет, горячий эсперантист, уклонился от председательствования по болезни."
                            },
                            {
                                "example_id": "4ba6f282-8ced-496a-b067-f9fef2c4866b",
                                "sense_id": "cf0e7d01-b644-330e-80b6-478b39bd5243",
                                "text": "Во всех конфликтах своей родни она была третейским судьёй, непререкаемым авторитетом."
                            }
                        ]
                    }
                ],
