                    "frequency": "High",
                    "semantic_group_id": "injustice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trouver une solution convenable n'est pas facile face à une décision aussi <w>injuste</w>."
                        },
                        {
                            "text": "Les élèves trouvaient que cette punition collective était particulièrement <w>injuste</w>."
                        }
                    ],
