                "senses": [
                    {
                        "sense_id": "0014a005-8acc-3082-9e6a-ccf6996c7173",
                        "entry_id": "d2d3f3b4-1cdd-3f84-bc9b-dd2dadab684c",
                        "glosses": [
                            "Donner un caractère superhumain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbf7326-3894-4831-b214-d1da0ee2c2c9",
                                "sense_id": "0014a005-8acc-3082-9e6a-ccf6996c7173",
                                "text": "Dans tous les cas, il y a de plus en plus, au-delà de cette condescendance etde cette pitié, la tentation pressante d’humaniser ou de super-humaniser l'homme noir."
                            },
                            {
                                "example_id": "7887d0e5-0942-490f-8148-254eeaca4d84",
                                "sense_id": "0014a005-8acc-3082-9e6a-ccf6996c7173",
                                "text": "Dans une Europe super-humanisée, cette espèce a réussi à s'adapter, à exploiter au mieux les ressources disponibles."
                            },
                            {
                                "example_id": "353d2586-beda-4d96-98f2-ae0103596691",
                                "sense_id": "0014a005-8acc-3082-9e6a-ccf6996c7173",
                                "text": "Charabia spatio-temporel, héros super-humanisés, mais au final un film un peu moins oubliable que les autres de la série"
                            }
                        ]
                    }
                ],
