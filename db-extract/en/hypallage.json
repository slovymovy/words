                        "entry_id": "64ac1b07-90c1-399a-b781-460c90586a76",
                        "glosses": [
                            "A construction in which a modifier with meaning associated with one word appears grammatically applied to another, often used as a literary device."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": []
                    }
