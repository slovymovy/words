                                "target_senses": [
                                    {
                                        "sense_id": "a3410693-1914-3a3a-8080-a55786b00ba8",
                                        "entry_id": "987631d1-69df-34eb-b421-4a7b5246bacb",
                                        "glosses": [
                                            "место, на которое можно стать, твёрдо опереться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28264ec9-67b4-41aa-94ec-5d856c694a1b",
                                                "sense_id": "a3410693-1914-3a3a-8080-a55786b00ba8",
                                                "text": "Ноги, не находя опоры, скользили по склону горы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fa8401-1149-3f29-84ec-8545db06da91",
                                        "entry_id": "987631d1-69df-34eb-b421-4a7b5246bacb",
                                        "glosses": [
                                            "то, что поддерживает или удерживает что-нибудь в постоянном положении, на что опирается что-нибудь, кто-нибудь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0d5507-46f3-47d6-94d9-b2121ee63fe8",
                                                "sense_id": "04fa8401-1149-3f29-84ec-8545db06da91",
                                                "text": "Тонкая трость — плохая опора больному."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7893ab9c-c3f8-3c9a-a342-dec5bf9b155a",
                                        "entry_id": "987631d1-69df-34eb-b421-4a7b5246bacb",
                                        "glosses": [
                                            "техн. сооружения, несущие на себе сложные конструкции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97da2905-7a38-4068-8248-ecd20542be7a",
                                                "sense_id": "7893ab9c-c3f8-3c9a-a342-dec5bf9b155a",
                                                "text": "Концевые опоры моста называются устоями, а промежуточные опоры — быками."
                                            },
                                            {
                                                "example_id": "d3db6161-498f-4084-acf4-f1f34aad4178",
                                                "sense_id": "7893ab9c-c3f8-3c9a-a342-dec5bf9b155a",
                                                "text": "Опоры ЛЭП."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f3e701-55fa-323d-a328-6f9fe3772b8c",
                                        "entry_id": "987631d1-69df-34eb-b421-4a7b5246bacb",
                                        "glosses": [
                                            "перен., книжн. то, что способствует чему-то, даёт помощь и поддержку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa75db6-2a4b-40b8-84fa-d2887c3879a5",
                                                "sense_id": "32f3e701-55fa-323d-a328-6f9fe3772b8c",
                                                "text": "Опора милая стареющих отцов, младые сыновья."
                                            },
                                            {
                                                "example_id": "8e7ee1e0-fedc-4235-910a-52d5b783c968",
                                                "sense_id": "32f3e701-55fa-323d-a328-6f9fe3772b8c",
                                                "text": "Опорою гибнущим, слабым, больным мы будем в тюрьме ненавистной."
                                            },
                                            {
                                                "example_id": "4505b163-acc9-463e-896c-27523d098a0a",
                                                "sense_id": "32f3e701-55fa-323d-a328-6f9fe3772b8c",
                                                "text": "Внучку зовут Алиса — это моя надежда и опора, моя маленькая помощница."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af4b5baf-552f-3e4d-ba19-5974688e8c53",
                                        "entry_id": "987631d1-69df-34eb-b421-4a7b5246bacb",
                                        "glosses": [
                                            "действие по глаг. опереть-опирать и опереться-опираться; упор (редко)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15228819-cc60-46ef-835f-ff0231da4f06",
                                                "sense_id": "af4b5baf-552f-3e4d-ba19-5974688e8c53",
                                                "text": "Точка опоры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
