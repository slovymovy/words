                    {
                        "form_id": "307f5856-a956-42e6-8c86-ff968f8cd882",
                        "entry_id": "82927b86-3b18-3a3a-86af-b0c1f91f0309",
                        "tags": [
                            "feminine"
                        ],
                        "form": "péquenote"
