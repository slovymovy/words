                        "glosses": [
                            "Périr à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7c16bd9-28f0-42fa-b248-1da6e1c41222",
                                "sense_id": "03793720-a0d4-3444-b407-35d3bbb65887",
                                "text": "Alors, accumulés et serrés, des théâtres prospéraient là, qui maintenant ne s'efforcent ailleurs de renaître que pour languir et repérir."
                            },
                            {
                                "example_id": "0e18b439-6007-4c28-a986-c3c3614ed740",
                                "sense_id": "03793720-a0d4-3444-b407-35d3bbb65887",
                                "text": "Notre salut d'une heure ne nous a pas été donné pour nous laisser repérir."
                            }
                        ]
                    }
