                        "entry_id": "ec140811-fc9a-378a-94f5-84a6e7191f84",
                        "glosses": [
                            "stworzona przez Darwina teoria ewolucji, która wyjaśnia powstawanie gatunków doborem naturalnym i walką o byt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7a692f-0c60-4382-8f2e-dc09e62ab2cf",
                                "sense_id": "ba576a26-c4ba-3ad4-b12d-d274cbe175f6",
                                "text": "Ideą przewodnią darwinizmu jest koncepcja doboru naturalnego, nazywana walką o byt"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
