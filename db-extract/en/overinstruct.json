                        "glosses": [
                            "To instruct excessively."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bab0126f-c7db-498a-bc4a-e4da03ae1781",
                                "sense_id": "a80667ff-e620-3241-93ec-1cb4c7f78826",
                                "text": "It is a common fault to overinstruct the composing room—to tell them the size of type to use in every line and in every corner."
                            },
                            {
                                "example_id": "6697202a-efd0-47b5-9dff-d23e45ed6af0",
                                "sense_id": "a80667ff-e620-3241-93ec-1cb4c7f78826",
                                "text": "…feminist critics found fault with the magazine’s tendency to overinstruct readers on how to become some stereotype of a woman they might not be naturally…."
                            },
                            {
                                "example_id": "e77c8204-9778-4823-b920-0bf35de2ec02",
                                "sense_id": "a80667ff-e620-3241-93ec-1cb4c7f78826",
                                "text": "Verbal instructions are often overdone and are often unable to capture the many subtle aspects of skilled movements. …The most important message here is do not overinstruct."
                            }
                        ]
                    }
