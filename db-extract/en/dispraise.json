                    },
                    {
                        "translation_id": "4557102c-cbe9-4655-b1f8-272fdc41c7ea",
                        "source_entry_id": "67a0588b-4bc7-384e-81c8-776ad8388a20",
                        "source_sense_id": "2b48d25e-3a1a-3f99-9b0c-7034902e1c8b",
