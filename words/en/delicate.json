{
    "word_family": [
        "delicacy",
        "delicately",
        "delicateness",
        "indelicate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "27cdf8b1-85f2-3f47-864e-4fd195ea763b",
                    "sense_definition": "Easily damaged or requiring careful handling.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fragility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Those clothes are made from <w>delicate</w> lace and should be washed by hand.",
                            "target_lang_translations": {
                                "ru": "Эта одежда сделана из <w>нежного</w> кружева, и её следует стирать вручную."
                            }
                        },
                        {
                            "text": "The <w>delicate</w> negotiations required a lot of patience from both sides.",
                            "target_lang_translations": {
                                "ru": "<w>Тонкие</w> переговоры потребовали большого терпения от обеих сторон."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragile"
                    ],
                    "antonyms": [
                        "robust",
                        "sturdy",
                        "tough"
                    ],
                    "common_phrases": [
                        "delicate situation",
                        "delicate balance",
                        "delicate matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко повреждаемый или требующий осторожного обращения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "о вещах"
                            },
                            {
                                "target_lang_word": "деликатный",
                                "target_lang_sense_clarification": "о ситуациях или вопросах"
                            },
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о переговорах или работе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a313f88e-5a42-30db-8d14-0b6537c1d516",
                    "sense_definition": "Characterized by a fine structure, thin lines, or small details.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spider wove a <w>delicate</w> web between the branches of the tree.",
                            "target_lang_translations": {
                                "ru": "Паук сплел <w>изящную</w> паутину между ветвями дерева."
                            }
                        },
                        {
                            "text": "She has a <w>delicate</w> pattern of freckles across her nose.",
                            "target_lang_translations": {
                                "ru": "У неё на носу <w>тонкий</w> узор из веснушек."
                            }
                        }
                    ],
                    "antonyms": [
                        "coarse",
                        "thick"
                    ],
                    "common_phrases": [
                        "delicate features",
                        "delicate pattern",
                        "delicate structure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся тонкой структурой, изящными линиями или мелкими деталями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изящный",
                                "target_lang_sense_clarification": "красивый и тонкий"
                            },
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о чертах или узорах"
                            },
                            {
                                "target_lang_word": "нежный",
                                "target_lang_sense_clarification": "о структуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89d527eb-c0c6-3078-bb95-fbb04159bf7a",
                    "sense_definition": "Pleasing to the senses in a subtle or refined way, such as a light flavor or scent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tea has a <w>delicate</w> flavor that is lost if you add too much sugar.",
                            "target_lang_translations": {
                                "ru": "У этого чая <w>тонкий</w> вкус, который теряется, если добавить слишком много сахара."
                            }
                        },
                        {
                            "text": "A <w>delicate</w> fragrance of roses filled the entire room.",
                            "target_lang_translations": {
                                "ru": "<w>Нежный</w> аромат роз наполнил всю комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragile"
                    ],
                    "antonyms": [
                        "strong",
                        "pungent",
                        "overpowering"
                    ],
                    "common_phrases": [
                        "delicate flavor",
                        "delicate fragrance",
                        "delicate scent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный для чувств в едва уловимой или утонченной форме, например, легкий вкус или аромат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о вкусе или запахе"
                            },
                            {
                                "target_lang_word": "нежный",
                                "target_lang_sense_clarification": "ощущаемый слегка"
                            },
                            {
                                "target_lang_word": "изысканный",
                                "target_lang_sense_clarification": "утонченный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c00bac8-7638-327a-9010-1297ac109539",
                    "sense_definition": "Light or softly tinted, referring to a color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted a <w>delicate</w> shade of blue.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в <w>нежный</w> оттенок голубого."
                            }
                        },
                        {
                            "text": "She wore a dress in a <w>delicate</w> pink color for the wedding.",
                            "target_lang_translations": {
                                "ru": "На свадьбу она надела платье <w>мягкого</w> розового цвета."
                            }
                        }
                    ],
                    "antonyms": [
                        "bold",
                        "vibrant",
                        "dark"
                    ],
                    "common_phrases": [
                        "delicate shade",
                        "delicate color",
                        "delicate tint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светлый или мягкий оттенок цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нежный",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "неяркий"
                            },
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "едва заметный оттенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cb56751-570a-36b9-bf9a-748c84408f3c",
                    "sense_definition": "Of weak health; easily becoming sick or unable to endure hardship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>delicate</w> child was often kept home from school during the winter.",
                            "target_lang_translations": {
                                "ru": "<w>Болезненного</w> ребенка зимой часто оставляли дома, не пуская в школу."
                            }
                        },
                        {
                            "text": "He has been in <w>delicate</w> health since his operation last year.",
                            "target_lang_translations": {
                                "ru": "У него <w>хрупкое</w> здоровье после прошлогодней операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragile"
                    ],
                    "antonyms": [
                        "healthy",
                        "robust",
                        "vigorous"
                    ],
                    "common_phrases": [
                        "delicate health",
                        "delicate constitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий слабым здоровьем; легко заболевающий или неспособный переносить трудности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрупкий",
                                "target_lang_sense_clarification": "о здоровье"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о конституции тела"
                            },
                            {
                                "target_lang_word": "болезненный",
                                "target_lang_sense_clarification": "часто болеющий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc0fc9c5-9660-32f6-8653-8d2a24a9d1af",
                    "sense_definition": "Refined, gentle, and considerate of the feelings of others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very <w>delicate</w> of you not to mention his recent failure.",
                            "target_lang_translations": {
                                "ru": "С вашей стороны было очень <w>деликатно</w> не упоминать о его недавней неудаче."
                            }
                        },
                        {
                            "text": "He handled the sensitive topic with <w>delicate</w> thoughtfulness.",
                            "target_lang_translations": {
                                "ru": "Он подошел к этой щекотливой теме с <w>чуткой</w> вдумчивостью."
                            }
                        }
                    ],
                    "antonyms": [
                        "tactless",
                        "rude",
                        "insensitive"
                    ],
                    "common_phrases": [
                        "delicate touch",
                        "delicate manners"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утонченный, мягкий и внимательный к чувствам других."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатный",
                                "target_lang_sense_clarification": "тактичный"
                            },
                            {
                                "target_lang_word": "чуткий",
                                "target_lang_sense_clarification": "внимательный к другим"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "о манерах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5efaa9d6-c781-3e27-b49e-26102724cae0",
                    "sense_definition": "Intended for use with fragile items, especially on a machine setting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fragility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should set the washing machine to the <w>delicate</w> cycle for those silks.",
                            "target_lang_translations": {
                                "ru": "Для этих шелковых вещей вам следует установить стиральную машину на <w>деликатный</w> режим."
                            }
                        },
                        {
                            "text": "Always use a <w>delicate</w> wash for your most expensive clothing.",
                            "target_lang_translations": {
                                "ru": "Всегда используйте <w>бережную</w> стирку для самой дорогой одежды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "delicate cycle",
                        "delicate wash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для использования с хрупкими вещами, особенно в настройках машин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатный",
                                "target_lang_sense_clarification": "о режиме стирки"
                            },
                            {
                                "target_lang_word": "бережный",
                                "target_lang_sense_clarification": "о стирке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de74f7ee-70c0-32dd-ace3-c55c0f8839c2",
                    "sense_definition": "Highly discriminating, perceptive, or sensitive to small differences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor has a <w>delicate</w> ear for music and notices every mistake.",
                            "target_lang_translations": {
                                "ru": "У дирижера <w>тонкий</w> музыкальный слух, и он замечает каждую ошибку."
                            }
                        },
                        {
                            "text": "A <w>delicate</w> taste is required to distinguish between these two vintage wines.",
                            "target_lang_translations": {
                                "ru": "Чтобы отличить эти два винтажных вина, требуется <w>изысканный</w> вкус."
                            }
                        }
                    ],
                    "common_phrases": [
                        "delicate ear",
                        "delicate taste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий высокой проницательностью или чувствительностью к мелким различиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о слухе или вкусе"
                            },
                            {
                                "target_lang_word": "чуткий",
                                "target_lang_sense_clarification": "восприимчивый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b048877-28b9-3016-898b-54f4c1ad6d87",
                    "sense_definition": "Capable of responding to or showing very slight changes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory uses a <w>delicate</w> instrument to measure the chemical reactions.",
                            "target_lang_translations": {
                                "ru": "Лаборатория использует <w>чувствительный</w> прибор для измерения химических реакций."
                            }
                        },
                        {
                            "text": "This <w>delicate</w> thermometer can detect even the smallest change in temperature.",
                            "target_lang_translations": {
                                "ru": "Этот <w>точный</w> термометр может уловить даже малейшее изменение температуры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "delicate instrument",
                        "delicate mechanism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный реагировать на очень незначительные изменения или показывать их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "об инструментах"
                            },
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "о приборах"
                            },
                            {
                                "target_lang_word": "прецизионный",
                                "target_lang_sense_clarification": "высокоточный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "219349c8-64ee-36d7-91d6-174961d96696",
                    "sense_definition": "Feeling unwell, especially due to a hangover.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am feeling a bit <w>delicate</w> this morning after the party last night.",
                            "target_lang_translations": {
                                "ru": "Этим утром я чувствую себя немного <w>разбитым</w> после вчерашней вечеринки."
                            }
                        },
                        {
                            "text": "Please don't shout; my head is quite <w>delicate</w> right now.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не кричи, моя голова сейчас очень <w>слабая</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "feeling delicate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used humorously regarding hangovers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохо себя чувствующий, особенно из-за похмелья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбитый",
                                "target_lang_sense_clarification": "о состоянии после выпивки"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "о самочувствии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eef903e-cfc5-30dd-a8da-a98190575ed1",
                    "sense_definition": "A delicate item of clothing, such as underwear or items made of silk.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to separate your <w>delicates</w> from the heavy towels before washing.",
                            "target_lang_translations": {
                                "ru": "Перед стиркой обязательно отделите <w>деликатные вещи</w> от тяжелых полотенец."
                            }
                        },
                        {
                            "text": "She bought a special mesh bag to protect her <w>delicates</w> in the laundry.",
                            "target_lang_translations": {
                                "ru": "Она купила специальный сетчатый мешок, чтобы защитить свое <w>тонкое белье</w> при стирке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wash delicates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкое изделие из одежды, например, нижнее белье или вещи из шелка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатные вещи",
                                "target_lang_sense_clarification": "одежда, требующая бережной стирки"
                            },
                            {
                                "target_lang_word": "тонкое белье",
                                "target_lang_sense_clarification": "изделия из шелка или кружева"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5ba933c-2a24-3b3d-8d6b-7776920a1abb",
                    "sense_definition": "A choice dainty or a luxury food item; a <w>delicacy</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The table was spread with all sorts of <w>delicates</w> from around the world.",
                            "target_lang_translations": {
                                "ru": "Стол был уставлен всевозможными <w>деликатесами</w> со всего мира."
                            }
                        },
                        {
                            "text": "He preferred simple meals over the expensive <w>delicates</w> served at the palace.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал простую еду дорогим <w>лакомствам</w>, которые подавали во дворце."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now usually replaced by 'delicacy'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изысканное лакомство или роскошный продукт питания; деликатес."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатес",
                                "target_lang_sense_clarification": "изысканная еда"
                            },
                            {
                                "target_lang_word": "лакомство",
                                "target_lang_sense_clarification": "вкусная еда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}