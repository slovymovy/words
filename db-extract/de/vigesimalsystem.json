                        "examples": [
                            {
                                "example_id": "0c807204-8ea4-4580-a06f-97fb338dbfd1",
                                "sense_id": "97e73bc0-005f-3d57-9cb3-d88452434f13",
                                "text": "Die Maya rechneten wahrscheinlich im Vigesimalsystem."
                            },
                            {
                                "example_id": "00ee93c5-7d78-45c8-ac7e-df50ae8ab72e",
                                "sense_id": "97e73bc0-005f-3d57-9cb3-d88452434f13",
                                "text": "„Entsprechend dem Vigesimalsystem der Zahlen war das Jahr in 18 Abschnitte zu jeweils 20 Tagen eingeteilt.“"
                            },
                            {
                                "example_id": "55a417e4-98ba-49ed-bc9d-86798713952f",
                                "sense_id": "97e73bc0-005f-3d57-9cb3-d88452434f13",
                                "text": "„Da die 20 die Grundzahl war, sprechen wir vom Vigesimalsystem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
