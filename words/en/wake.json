                            "target_lang_translations": {
                                "ru": "Мистер <w>Уэйк</w> будет вести собрание в конференц-зале сегодня.",
                                "de": "Herr <w>Wake</w> leitet heute das Meeting im Konferenzraum.",
                                "zh": "<w>韦克</w>先生今天将在会议室主持会议。"
                            }
                        },
                        {
