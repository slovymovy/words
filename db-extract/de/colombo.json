                "senses": [
                    {
                        "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                        "entry_id": "d3828871-1baa-3b9c-98cb-3492a32f22f7",
                        "glosses": [
                            "de facto Hauptstadt von Sri Lanka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7245e3-cae6-4c51-aa60-9893f821ea89",
                                "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                                "text": "„Colombo ist seit dem 5. Jahrhundert als Hafenstadt bekannt, die unter anderem römischen, arabischen und chinesischen Händlern als Station diente.“"
                            },
                            {
                                "example_id": "a122b317-bc4e-4a81-a727-bd745a673e4b",
                                "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                                "text": "„Im 16. Jahrhundert nahmen die Portugiesen einige Küstengebiete Sri Lankas, unter anderem Colombo und seinen Hafen, in Besitz.“"
                            },
                            {
                                "example_id": "1229ca80-fc31-4902-91dd-c0cede7c4fee",
                                "sense_id": "835ac2a3-72b7-307d-ada1-fbbd4834dd50",
                                "text": "„In Sri Lankas Hauptstadt Colombo hat am Mittwoch eine Regierungskommission ihre Arbeit aufgenommen, die sich mit den letzten Jahren des Bürgerkriegs gegen die Rebellen der Befreiungstiger für Tamil Eelam (LTTE) befasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
