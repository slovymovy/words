                "translations": [
                    {
                        "translation_id": "73f8057b-75f5-4a5a-8a05-1a78dc60bfec",
                        "source_entry_id": "d817875f-681b-3c3d-a88b-e0488b50c1a9",
                        "source_sense_id": "773f2bf2-847f-3554-8dc2-2566851cd1fa",
                        "target_lang_word": "tapoter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapoter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee887121-7c55-3e10-beda-1f3d7a9719c4",
                                        "entry_id": "5545e7da-196d-3250-afb8-d869273f9287",
                                        "glosses": [
                                            "Donner de petits coups à plusieurs reprises."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cd80932-8fe0-45b2-99e5-9e43dc0f6934",
                                                "sense_id": "ee887121-7c55-3e10-beda-1f3d7a9719c4",
                                                "text": "Pendant qu’elle s’asseyait sur le talus, tapotant sa joue comme on tapote une jupe froissée, il sentait des larmes, grosses comme des remords, lui monter aux yeux, mais la pression était cependant trop faible et elles s’arrêtèrent à sa gorge."
                                            },
                                            {
                                                "example_id": "3330d987-3ef7-4bd2-ae3e-e609135fbac1",
                                                "sense_id": "ee887121-7c55-3e10-beda-1f3d7a9719c4",
                                                "text": "En même temps, il glissait sa large patte sous la jupe de la fille qui ne broncha point et tapotait délicatement une callipygie orgueilleuse et prévenante."
                                            },
                                            {
                                                "example_id": "b007ecec-5caf-4185-988c-5eb00dd3352b",
                                                "sense_id": "ee887121-7c55-3e10-beda-1f3d7a9719c4",
                                                "text": "— Et,de toute façon, je ne sais pas trop comment la guédille au homard prendrait ces retrouvailles avec son milieu naturel, renchérit-il, en se tapotant le ventre."
                                            },
                                            {
                                                "example_id": "020a02de-d8e3-4fc4-b1a4-81eba71553b5",
                                                "sense_id": "ee887121-7c55-3e10-beda-1f3d7a9719c4",
                                                "text": "Mais Françoise ne l'écoutait plus, elle avait sorti le grand jeu : crinière rejetée en arrière, regard de serial fuckeuse, et doigt tapotant négligemment une joue fardée à la truelle."
                                            },
                                            {
                                                "example_id": "0787126c-8cd1-4e78-aa96-db48db9249c4",
                                                "sense_id": "ee887121-7c55-3e10-beda-1f3d7a9719c4",
                                                "text": "Tapotez sur l’icône App Store pour naviguer sans fil parmi des dizaines de milliers d’applications pouvant être regroupées sous les catégories jeux, travail, voyage, réseaux sociaux, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9f1fd89-557e-3b83-a837-7003eb10224f",
                                        "entry_id": "5545e7da-196d-3250-afb8-d869273f9287",
                                        "glosses": [
                                            "Jouer mal ou négligemment, en parlant d’un pianiste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
