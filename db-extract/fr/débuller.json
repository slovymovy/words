                "senses": [
                    {
                        "sense_id": "a864c3bb-981f-352e-aa8e-f8d38de08aa5",
                        "entry_id": "9611266d-530d-3f36-b891-8575093839c4",
                        "glosses": [
                            "Enlever les bulles présentes dans (un liquide)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62633f4b-9d75-4fe3-8934-b0d46813455d",
                                "sense_id": "a864c3bb-981f-352e-aa8e-f8d38de08aa5",
                                "text": "Le principe consiste à débuller puis re-segmenter le flux aussi près que possible de la colonne."
                            },
                            {
                                "example_id": "32d3260e-c24a-4f9a-a943-18a8f59ac1ee",
                                "sense_id": "a864c3bb-981f-352e-aa8e-f8d38de08aa5",
                                "text": "Déposer le mélange avec régularité, savoir bien l'étaler, le débuller, traiter avec soin le congé des plinthes : ce sont des techniques qui ne s'acquièrent pas en quelques chantiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4a48dd1-4654-3f26-8950-1b9f45b09373",
                        "entry_id": "9611266d-530d-3f36-b891-8575093839c4",
                        "glosses": [
                            "Filmer pour rendre la ligne d’horizon oblique à l’écran."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "note": "En référence au niveau à bulle qui équipe les pieds de caméra",
                        "examples": [
