                "senses": [
                    {
                        "sense_id": "8928fcfd-c842-3499-a9d8-a01672cdfc76",
                        "entry_id": "2d4793a0-2df4-37fd-a92a-ce9b97e34a24",
                        "glosses": [
                            "Bien placé, bien installé."
                        ],
                        "tags": [
