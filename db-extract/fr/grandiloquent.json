                    {
                        "translation_id": "87d01a48-0122-4862-a5bd-ae96156ac804",
                        "source_entry_id": "75d260fa-c704-3665-998a-c6efe2f0a385",
                        "target_lang_word": "altisonante",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
