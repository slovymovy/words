                "senses": [
                    {
                        "sense_id": "3e5b88e4-5f66-395e-be5c-594ebd773394",
                        "entry_id": "cda2ae4e-2a0e-3dcc-a757-5b99d56fd7b0",
                        "glosses": [
                            "Comprendre de nouveau quelque chose dont on a oublié le sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "228b885a-5bb6-47d1-b9e4-eba23326193f",
                                "sense_id": "3e5b88e4-5f66-395e-be5c-594ebd773394",
                                "text": "Quitter la ville pour vivre à la campagne permet de recomprendre le sens de la vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f49e7255-4d66-3991-8c37-53a38f1fa865",
                        "entry_id": "cda2ae4e-2a0e-3dcc-a757-5b99d56fd7b0",
                        "glosses": [
                            "Avoir une nouvelle compréhension de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc32800-70e7-403e-9215-7315ffe70f68",
                                "sense_id": "f49e7255-4d66-3991-8c37-53a38f1fa865",
                                "text": "Mais il faut recomprendre la constitution pour qu'elle fasse fond sur l'être et non plus sur une « matière passive » conçue comme immanente : « L'être-pour ne peut paraître que sur fond d'en-soi » (Carnets, 431)."
                            }
                        ]
                    }
