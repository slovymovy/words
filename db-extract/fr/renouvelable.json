        "fr-extract.jsonl": [
            {
                "entry_id": "9604aacd-3208-360b-b3eb-3e7a8b0184b7",
                "word": "renouvelable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "594ff309-8b06-473d-a24e-765ffe9d3b6f",
                        "entry_id": "9604aacd-3208-360b-b3eb-3e7a8b0184b7",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "renouvelables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a27328a-b680-37b2-9e1f-bfb22c6060d6",
                        "entry_id": "9604aacd-3208-360b-b3eb-3e7a8b0184b7",
                        "glosses": [
                            "Qui peut être renouvelé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa236e05-1e3d-4d55-a22b-def0f8f36643",
                                "sense_id": "0a27328a-b680-37b2-9e1f-bfb22c6060d6",
                                "text": "Billet, obligation renouvelable."
                            },
                            {
                                "example_id": "bdd8b0e7-10f3-461a-bccf-9a8711098384",
                                "sense_id": "0a27328a-b680-37b2-9e1f-bfb22c6060d6",
                                "text": "Car le compte à rebours a commencé : dans 5 jours, il sera présenté au juge des libertés, qui va décider de son maintien en rétention pendant 15 jours renouvelables."
                            },
                            {
                                "example_id": "327e410a-6056-4c50-b2f7-54276627b6b0",
                                "sense_id": "0a27328a-b680-37b2-9e1f-bfb22c6060d6",
                                "text": "Socrates avait fièrement tenu à souligner, aux côtés du président américain, « la priorité que les deux pays attribuent aux énergies renouvelables et aux véhicules électriques ». — (« Barack Obama fait tache au sommet de l’Otan », leSoir.be, 19 novembre 2010)"
                            },
                            {
                                "example_id": "74723a0c-073c-4bf7-891a-3344faa9cb19",
                                "sense_id": "0a27328a-b680-37b2-9e1f-bfb22c6060d6",
                                "text": "Fendt et Trelleborg ont développé conjointement les pneus TM1 Eco Power spécialement conçus pour la gamme électrique. 60 % des composants de ces pneus proviennent de sources renouvelables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "597ad846-29e3-49bf-bc77-51b8001c1b3e",
                        "source_entry_id": "9604aacd-3208-360b-b3eb-3e7a8b0184b7",
                        "source_sense_id": "0a27328a-b680-37b2-9e1f-bfb22c6060d6",
                        "target_lang_word": "erneuerbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erneuerbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71c0b6a2-5602-363b-b3f4-17bdeb0ab04d",
                                        "entry_id": "f6398574-8a5c-3b26-abe0-74a7b6f85d3d",
                                        "glosses": [
                                            "für etwas Neues geeignet, zum Renovieren geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ccd5bf-ac52-43f6-acd8-52d970d4c3de",
                                                "sense_id": "71c0b6a2-5602-363b-b3f4-17bdeb0ab04d",
                                                "text": "Der erneuerbare Teil des Hauses wurde nicht abgerissen."
                                            },
                                            {
                                                "example_id": "13f36dcb-27a7-4a71-8fd7-2a74681b1469",
                                                "sense_id": "71c0b6a2-5602-363b-b3f4-17bdeb0ab04d",
                                                "text": "„Energie ist nicht erneuerbar.“"
                                            },
                                            {
                                                "example_id": "b46871ef-7e3b-496d-a003-3788ecdcd366",
                                                "sense_id": "71c0b6a2-5602-363b-b3f4-17bdeb0ab04d",
                                                "text": "„Der Begriff ‚erneuerbare Energien‘ ist nicht im streng physikalischen Sinne zu verstehen, denn Energie lässt sich nach dem Energieerhaltungssatz weder vernichten noch erschaffen, sondern lediglich in verschiedene Formen überführen“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f1bd89c-3e34-41ab-aa48-333c181e7e15",
                        "source_entry_id": "9604aacd-3208-360b-b3eb-3e7a8b0184b7",
                        "source_sense_id": "0a27328a-b680-37b2-9e1f-bfb22c6060d6",
                        "target_lang_word": "renewable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renewable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1eacc800-c715-3df7-9c33-1704925d2e9c",
                                        "entry_id": "d5370029-5bcd-3c5b-b915-25df28b8dd43",
                                        "glosses": [
                                            "Able to be renewed; capable of renewal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f4db24-4acf-48d1-af0b-b02a81521d43",
                                                "sense_id": "1eacc800-c715-3df7-9c33-1704925d2e9c",
                                                "text": "Under the pilot project, the private sector will supply, install, operate and maintain e-vehicle charging stations; monitor and verify the energy efficiency, performance and savings in using renewable energy; and optimize the use of clean energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                        "entry_id": "d5370029-5bcd-3c5b-b915-25df28b8dd43",
                                        "glosses": [
                                            "Sustainable; able to be regrown or renewed; having an ongoing or continuous source of supply."
                                        ],
                                        "tags": [
                                            "of a resource"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43984897-1f40-4ab2-baee-af56881d956a",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable sources of energy"
                                            },
                                            {
                                                "example_id": "b76420fd-ebf5-4151-bf74-d9d3e4f8e0bb",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "Solar and wind power are renewable, but coal is not."
                                            },
                                            {
                                                "example_id": "666de4f8-c13a-4982-9722-07dfdd20ba65",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable resource"
                                            },
                                            {
                                                "example_id": "78d500ef-6109-441e-9e33-e0a81aa7fd27",
                                                "sense_id": "38d8a445-558b-3d3e-bb15-3a0f3c48eccf",
                                                "text": "renewable energy"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "renewable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1351d5af-6651-3bdd-8059-c1da77270483",
                                        "entry_id": "0fd3c107-2cb2-3f68-8c32-2a84e9dbbb6c",
                                        "glosses": [
                                            "A thing that is renewable",
                                            "A renewable resource or source of energy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95de28b-b768-4fea-b2a4-41c49035a5c8",
                                                "sense_id": "1351d5af-6651-3bdd-8059-c1da77270483",
                                                "text": "Klein diagnoses impressively what hasn’t worked. No more claptrap about fracked gas as a bridge to renewables. Enough already of the international summit meetings that produce sirocco-quality hot air, and nonbinding agreements that bind us all to more emissions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                        "entry_id": "0fd3c107-2cb2-3f68-8c32-2a84e9dbbb6c",
                                        "glosses": [
                                            "A thing that is renewable",
                                            "A renewable fuse; a fuse which can be opened in order to replace the element."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf5c417-866e-4baf-a6f3-8ab13bcd1f67",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "You'll find the link can be removed from a \"Union\" Renewable and replaced before most fuses can be taken apart."
                                            },
                                            {
                                                "example_id": "63d2bf21-b684-4d45-b5af-f450937ab251",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "It is a pretty safe bet that he can show you where you are using fuses of the wrong type (renewables for non-renewables and vice versa ) -or where fuses that ought to be good for twenty or more renewals are ready for the scrap"
                                            },
                                            {
                                                "example_id": "e64f9ee2-f881-42bd-8604-5cd32331c321",
                                                "sense_id": "3721b816-82ef-3e42-bb41-e5aeee1dda0e",
                                                "text": "Here is a newly designed All-Purpose Superfuse. Use it wherever you need One-Times, Renewables or Dual Element fuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
