                "senses": [
                    {
                        "sense_id": "27b9a2df-cfa5-3f4c-b3da-037240811a3e",
                        "entry_id": "718ac4e1-2cfb-3eda-bc72-5e5a93f12ab3",
                        "glosses": [
                            "Der Heideherr hatte die Aufgabe, die Ländereien zu verwalten und zu verpachten."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79c99574-1a3d-4a44-8b52-dcd87ab371de",
                                "sense_id": "27b9a2df-cfa5-3f4c-b3da-037240811a3e",
                                "text": "\"Unangefochten von seinen Mitbürgern legte der Heideherr Heyseler dort eine Eichenallee an.\""
                            },
                            {
                                "example_id": "c5dcc44b-aaae-46fa-abc4-bff94b7e8bf2",
                                "sense_id": "27b9a2df-cfa5-3f4c-b3da-037240811a3e",
                                "text": "„Ansonsten soll dieses Departement derjenige Policenrathmann, der die beste Kenntniß vom Forstwesen hat, als eigentlicher Heideherr oder Stadtforstinspektor mit den beyden Stadtförstern, als Unterbedienten verwalten.“"
                            },
                            {
                                "example_id": "fa51a43a-b65e-437a-b65b-f5523bf0dc9f",
                                "sense_id": "27b9a2df-cfa5-3f4c-b3da-037240811a3e",
                                "text": "„Einer der Ratsherren wurde Heideherr, ein anderer verwaltete die Ökonomie-Angelegenheiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
