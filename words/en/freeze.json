{
    "word_family": [
        "freezer",
        "freezing",
        "frozen",
        "antifreeze",
        "deep-freeze"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "285d5ee9-a20f-339a-88fc-c5e2b7e2e912",
                    "sense_definition": "Especially of a liquid, to become solid due to low temperature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water in the lake <w>froze</w> solid overnight.",
                            "target_lang_translations": {
                                "ru": "Вода в озере за ночь полностью <w>замёрзла</w>.",
                                "zh": "湖里的水一夜之间完全<w>结冰</w>了。"
                            }
                        },
                        {
                            "text": "Running water does not <w>freeze</w> as easily as still water.",
                            "target_lang_translations": {
                                "ru": "Проточная вода <w>замерзает</w> не так легко, как стоячая.",
                                "zh": "流动的水不像静止的水那样容易<w>结冰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solidify"
                    ],
                    "antonyms": [
                        "liquify",
                        "unfreeze"
                    ],
                    "common_phrases": [
                        "freeze solid",
                        "freeze over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращаться в лёд или твердеть под воздействием низкой температуры (обычно о жидкости).",
                        "zh": "指液体等因温度降低而变成固体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замерза́ть",
                                "target_lang_sense_clarification": "превращаться в лёд"
                            },
                            {
                                "target_lang_word": "замёрзнуть",
                                "target_lang_sense_clarification": "превратиться в лёд (сов. вид)"
                            },
                            {
                                "target_lang_word": "застыва́ть",
                                "target_lang_sense_clarification": "твердеть от холода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结冰",
                                "target_lang_sense_clarification": "液体变成冰"
                            },
                            {
                                "target_lang_word": "冻结",
                                "target_lang_sense_clarification": "变成固体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7b72e8c-2cd5-3fda-a8c4-5aac15fee91c",
                    "sense_definition": "To be affected by extreme cold.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>freezing</w> in here, so please close the window.",
                            "target_lang_translations": {
                                "ru": "Здесь очень <w>холодно</w>, пожалуйста, закрой окно.",
                                "zh": "这儿冷得要命，请把窗户关上。"
                            }
                        },
                        {
                            "text": "Don't go outside wearing just a t-shirt or you will <w>freeze</w>.",
                            "target_lang_translations": {
                                "ru": "Не ходи на улицу в одной футболке, иначе <w>замёрзнешь</w>.",
                                "zh": "别只穿一件T恤就出门，不然你会<w>冻</w>坏的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "freeze to death",
                        "freezing cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильный холод, страдать от мороза.",
                        "zh": "感到极度寒冷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мёрзнуть",
                                "target_lang_sense_clarification": "чувствовать холод"
                            },
                            {
                                "target_lang_word": "замерза́ть",
                                "target_lang_sense_clarification": "сильно зябнуть"
                            },
                            {
                                "target_lang_word": "замёрзнуть",
                                "target_lang_sense_clarification": "озябнуть (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冻",
                                "target_lang_sense_clarification": "感到寒冷"
                            },
                            {
                                "target_lang_word": "受冻",
                                "target_lang_sense_clarification": "遭受寒冷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd10a16-4620-3cca-99f0-c23b8f3f38aa",
                    "sense_definition": "To lower something's temperature to the point that it freezes or becomes hard, often to preserve it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>freeze</w> meat twice if it has thawed.",
                            "target_lang_translations": {
                                "ru": "Не следует повторно <w>замораживать</w> мясо, если оно оттаяло.",
                                "zh": "肉解冻后不应该再次<w>冷冻</w>。"
                            }
                        },
                        {
                            "text": "We decided to <w>freeze</w> the leftovers to eat them next week.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>заморозить</w> остатки еды, чтобы съесть их на следующей неделе.",
                                "zh": "我们决定把剩菜<w>冷冻</w>起来下周吃。"
                            }
                        }
                    ],
                    "antonyms": [
                        "defrost"
                    ],
                    "common_phrases": [
                        "freeze food",
                        "deep freeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать продукты воздействию низкой температуры для их длительного хранения.",
                        "zh": "通过降低温度使物体变硬或结冰，通常为了保存。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замора́живать",
                                "target_lang_sense_clarification": "продукты"
                            },
                            {
                                "target_lang_word": "заморо́зить",
                                "target_lang_sense_clarification": "продукты (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷冻",
                                "target_lang_sense_clarification": "低温保存食物"
                            },
                            {
                                "target_lang_word": "冻结",
                                "target_lang_sense_clarification": "使物体变硬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "798ae929-c012-3e6f-acb0-f2b9dbe46d0d",
                    "sense_definition": "To stop moving suddenly or become motionless due to attentiveness, fear, or surprise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "motionless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite all of the rehearsals, I <w>froze</w> as soon as I got on stage.",
                            "target_lang_translations": {
                                "ru": "Несмотря на все репетиции, я <w>замер</w>, как только вышел на сцену.",
                                "zh": "尽管排练了很多次，我一上台还是<w>僵住</w>了。"
                            }
                        },
                        {
                            "text": "The deer <w>froze</w> in the headlights when it saw the car approaching.",
                            "target_lang_translations": {
                                "ru": "Олень <w>застыл</w> в свете фар, когда увидел приближающуюся машину.",
                                "zh": "那只鹿看到车开过来时，在车灯前<w>僵住</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "halt",
                        "stop dead",
                        "go still"
                    ],
                    "common_phrases": [
                        "freeze in place",
                        "freeze with fear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно остановиться и перестать двигаться из-за страха, удивления или внимания.",
                        "zh": "因恐惧、惊讶或专注而突然停止动作，变得僵硬。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замира́ть",
                                "target_lang_sense_clarification": "становиться неподвижным"
                            },
                            {
                                "target_lang_word": "застыва́ть",
                                "target_lang_sense_clarification": "останавливаться в позе"
                            },
                            {
                                "target_lang_word": "цепене́ть",
                                "target_lang_sense_clarification": "от страха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "僵住",
                                "target_lang_sense_clarification": "因惊吓而停止动作"
                            },
                            {
                                "target_lang_word": "呆住",
                                "target_lang_sense_clarification": "因惊讶而不动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42165251-5bad-3f3c-b882-ab88f5781b7f",
                    "sense_definition": "Of machines and software, to come to a sudden halt or stop functioning.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "motionless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since the last update, the program <w>freezes</w> after a few minutes of use.",
                            "target_lang_translations": {
                                "ru": "После последнего обновления программа <w>зависает</w> через несколько минут использования.",
                                "zh": "自上次更新以来，程序用了几分钟就会<w>死机</w>。"
                            }
                        },
                        {
                            "text": "My computer screen <w>froze</w> right in the middle of the presentation.",
                            "target_lang_translations": {
                                "ru": "Мой экран компьютера <w>завис</w> прямо посреди презентации.",
                                "zh": "我的电脑屏幕在演示过程中突然<w>死机</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hang",
                        "lock up",
                        "seize up",
                        "freeze up",
                        "grind to a halt",
                        "stop working",
                        "crash"
                    ],
                    "common_phrases": [
                        "screen freeze",
                        "system freeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "О компьютере или программе: перестать реагировать на действия пользователя, зависнуть.",
                        "zh": "指机器或软件突然停止运行或失去响应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависа́ть",
                                "target_lang_sense_clarification": "о программе"
                            },
                            {
                                "target_lang_word": "ви́снуть",
                                "target_lang_sense_clarification": "разг. о технике"
                            },
                            {
                                "target_lang_word": "зави́снуть",
                                "target_lang_sense_clarification": "перестать работать (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死机",
                                "target_lang_sense_clarification": "电脑停止响应"
                            },
                            {
                                "target_lang_word": "卡住",
                                "target_lang_sense_clarification": "程序停止运行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c687d893-f06b-3853-baeb-70e0c9702303",
                    "sense_definition": "To prevent the movement or liquidation of a person's financial assets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fixed_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court decided to <w>freeze</w> the criminal's bank account during the investigation.",
                            "target_lang_translations": {
                                "ru": "Суд решил <w>заморозить</w> банковский счет преступника на время расследования.",
                                "zh": "法院决定在调查期间<w>冻结</w>该罪犯的银行账户。"
                            }
                        },
                        {
                            "text": "Authorities can <w>freeze</w> assets if they suspect illegal activity.",
                            "target_lang_translations": {
                                "ru": "Власти могут <w>заморозить</w> активы, если подозревают незаконную деятельность.",
                                "zh": "如果怀疑有非法活动，当局可以<w>冻结</w>资产。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "freeze assets",
                        "freeze an account"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блокировать доступ к финансовым активам или счетам, предотвращая их использование.",
                        "zh": "限制或禁止个人金融资产的流动或变现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замора́живать",
                                "target_lang_sense_clarification": "счета или активы"
                            },
                            {
                                "target_lang_word": "заморо́зить",
                                "target_lang_sense_clarification": "счета (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冻结",
                                "target_lang_sense_clarification": "限制资产使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c239af53-293d-3704-afb0-eda03453942a",
                    "sense_definition": "To keep prices, spending, or wages at the same level without any increase.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fixed_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government promised to <w>freeze</w> rail fares for the next year.",
                            "target_lang_translations": {
                                "ru": "Правительство пообещало <w>заморозить</w> тарифы на железнодорожные перевозки на следующий год.",
                                "zh": "政府承诺明年将<w>冻结</w>铁路票价。"
                            }
                        },
                        {
                            "text": "The company had to <w>freeze</w> salaries due to the economic downturn.",
                            "target_lang_translations": {
                                "ru": "Компании пришлось <w>заморозить</w> зарплаты из-за экономического спада.",
                                "zh": "由于经济低迷，公司不得不<w>冻结</w>工资。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "freeze prices",
                        "wage freeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фиксировать цены, зарплаты или расходы на текущем уровне, запрещая их повышение.",
                        "zh": "将价格、支出或工资维持在同一水平，不予增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замора́живать",
                                "target_lang_sense_clarification": "цены или зарплаты"
                            },
                            {
                                "target_lang_word": "заморо́зить",
                                "target_lang_sense_clarification": "цены (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冻结",
                                "target_lang_sense_clarification": "固定价格或工资"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2327ddeb-8a68-3d6a-b39b-e35534ac971a",
                    "sense_definition": "A period of intensely cold weather.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden plants died after the sudden <w>freeze</w> last night.",
                            "target_lang_translations": {
                                "ru": "Садовые растения погибли после внезапных <w>заморозков</w> прошлой ночью.",
                                "zh": "昨晚突如其来的<w>霜冻</w>导致花园里的植物枯死了。"
                            }
                        },
                        {
                            "text": "Farmers are worried about a late spring <w>freeze</w> damaging the crops.",
                            "target_lang_translations": {
                                "ru": "Фермеры обеспокоены тем, что поздние весенние <w>заморозки</w> повредят урожай.",
                                "zh": "农民们担心春季晚来的<w>霜冻</w>会损害庄稼。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deep freeze",
                        "big freeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период очень холодной погоды, заморозки.",
                        "zh": "一段极度寒冷的天气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за́морозки",
                                "target_lang_sense_clarification": "похолодание"
                            },
                            {
                                "target_lang_word": "моро́зы",
                                "target_lang_sense_clarification": "холодная погода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霜冻",
                                "target_lang_sense_clarification": "寒冷天气"
                            },
                            {
                                "target_lang_word": "严寒",
                                "target_lang_sense_clarification": "极冷时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a2f0bf8-de7e-3752-91eb-2dd405c09b7d",
                    "sense_definition": "The state when a computer program or system ceases to respond to inputs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "halt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My laptop suffered a <w>freeze</w> and I lost all my unsaved work.",
                            "target_lang_translations": {
                                "ru": "На моем ноутбуке произошло <w>зависание</w>, и я потерял всю несохраненную работу.",
                                "zh": "我的笔记本电脑发生了<w>死机</w>，我所有未保存的工作都丢失了。"
                            }
                        },
                        {
                            "text": "A system <w>freeze</w> forced the technicians to restart the server manually.",
                            "target_lang_translations": {
                                "ru": "Системное <w>зависание</w> заставило техников перезагрузить сервер вручную.",
                                "zh": "系统<w>死机</w>迫使技术人员手动重启服务器。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "computer freeze",
                        "system freeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, когда компьютерная система перестает отвечать на запросы.",
                        "zh": "计算机程序或系统停止响应输入的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависа́ние",
                                "target_lang_sense_clarification": "компьютера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死机",
                                "target_lang_sense_clarification": "系统停止响应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce10293-5507-3cca-acbb-64516475ca74",
                    "sense_definition": "A halt of a regular operation or policy, such as spending or hiring.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "halt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many politicians are advocating a <w>freeze</w> in federal spending.",
                            "target_lang_translations": {
                                "ru": "Многие политики выступают за <w>замораживание</w> федеральных расходов.",
                                "zh": "许多政客主张<w>冻结</w>联邦支出。"
                            }
                        },
                        {
                            "text": "The company announced a hiring <w>freeze</w> to reduce costs.",
                            "target_lang_translations": {
                                "ru": "Компания объявила о <w>приостановке</w> найма сотрудников для снижения расходов.",
                                "zh": "公司宣布<w>冻结</w>招聘以削减成本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hiring freeze",
                        "spending freeze",
                        "wage freeze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная остановка или прекращение какой-либо деятельности или политики.",
                        "zh": "对常规操作或政策（如支出或招聘）的暂停。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замора́живание",
                                "target_lang_sense_clarification": "процесса"
                            },
                            {
                                "target_lang_word": "приостано́вка",
                                "target_lang_sense_clarification": "деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冻结",
                                "target_lang_sense_clarification": "停止某项活动"
                            },
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "暂时停止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba4130c2-eb17-39b5-b07d-e49845648f36",
                    "sense_definition": "Obsolete form of frieze (a coarse woolen cloth).",
                    "learner_level": "C2",
