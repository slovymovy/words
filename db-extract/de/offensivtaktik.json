                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e58ab1-6441-44a5-8386-521054ec3c30",
                                "sense_id": "e23da3f6-d99b-3f66-b0ea-fd0186659eef",
                                "text": "„Der Hang zu einer aggressiven Offensivtaktik beeinflusste im Heer auch die Haltung zu spezifischen Waffen.“"
                            },
                            {
                                "example_id": "54e059ce-ff9d-4db7-8f29-b277bfa42678",
                                "sense_id": "e23da3f6-d99b-3f66-b0ea-fd0186659eef",
                                "text": "„Seine mutige Offensivtaktik will Bosz auch gegen die Dortmunder, die in den vergangenen drei Bundesligaspielen jeweils fünf Tore erzielten, nicht prinzipiell ändern […].“"
                            },
                            {
                                "example_id": "edb0d1c9-727a-4873-abaa-d85a5b0eedcc",
                                "sense_id": "e23da3f6-d99b-3f66-b0ea-fd0186659eef",
                                "text": "„Von den öffentlichen und kontroversen Diskussionen über die mutige Offensivtaktik des Trainers hält Mittelfeldspieler Nuri Sahin wenig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
