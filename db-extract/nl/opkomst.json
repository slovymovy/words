                        ],
                        "examples": [
                            {
                                "example_id": "5e99a17a-861f-44fc-bdfd-5da6c171fa3a",
                                "sense_id": "7c151235-6bac-3200-9c36-948917715b50",
                                "text": "Ze schilderde de opkomst van de zon boven de bergen.",
                                "translation": "She painted the sunrise over the mountains.",
                                "english": "She painted the sunrise over the mountains."
                            },
                            {
                                "example_id": "3a50ecf7-b4e9-4a42-9d33-715585cf189e",
                                "sense_id": "7c151235-6bac-3200-9c36-948917715b50",
                                "text": "De opkomst van de zon was prachtig vanmorgen.",
                                "translation": "The rise of the sun was beautiful this morning.",
                                "english": "The rise of the sun was beautiful this morning."
                            },
                            {
                                "example_id": "1130ed80-17bf-443f-bef9-c63897627e79",
                                "sense_id": "7c151235-6bac-3200-9c36-948917715b50",
                                "text": "Veel mensen genieten van de opkomst van de maan.",
                                "translation": "Many people enjoy the rise of the moon.",
                                "english": "Many people enjoy the rise of the moon."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5c5b2ca-380c-35cf-a867-8f8793a5d7da",
                        "entry_id": "9fd1e31d-7de0-35c1-9896-517e0c20349f",
