                    {
                        "form_id": "511f697d-f68a-472c-95ec-df8177caf216",
                        "entry_id": "c6c7e60f-6790-3a7e-9227-8fa8919cb568",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Packerln"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5b8241c-3db2-3c16-8e8b-a7357e9f0550",
                        "entry_id": "c6c7e60f-6790-3a7e-9227-8fa8919cb568",
                        "glosses": [
                            "verpackte kleine Menge einer Ware"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "d8bba198-c631-4af6-a54a-eefe8e70cef4",
                                "sense_id": "a5b8241c-3db2-3c16-8e8b-a7357e9f0550",
                                "text": "„Greifen Sie eher zur Flasche als zum Packerl?“"
                            },
                            {
                                "example_id": "29ac97c7-6532-49d8-aedc-ad0e76e0b83c",
                                "sense_id": "a5b8241c-3db2-3c16-8e8b-a7357e9f0550",
                                "text": "„Und das, was ein Packerl Orangensaft dann am Ende an der europäischen Supermarktkassa kostet, kommt aufgrund der zynischen Regeln des Marktes auch nur zu einem kleinen Bruchteil bei jenen an, die am härtesten arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fdbdbbfb-c053-3d25-a414-2c1cfc254842",
                        "entry_id": "c6c7e60f-6790-3a7e-9227-8fa8919cb568",
                        "glosses": [
                            "Postpaket"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "dde6bcf9-acab-4dd0-9f0e-041432465188",
                                "sense_id": "fdbdbbfb-c053-3d25-a414-2c1cfc254842",
                                "text": "[Schlagzeile:] „Schnäppchen ade: Die 22-Euro-Freigrenze für China-Packerl fällt mit 1. Juli“"
                            },
                            {
                                "example_id": "bb3fd724-f48b-4bc4-bbb4-61f0e4f43429",
                                "sense_id": "fdbdbbfb-c053-3d25-a414-2c1cfc254842",
                                "text": "„Knapp 2.500 Packerl aus dem Bezirk Kitzbühel wurden nach Rumänien geliefert und sorgten dort für leuchtende Kinderaugen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6fe3d321-a6d2-39b4-8766-203dc3407501",
                        "entry_id": "c6c7e60f-6790-3a7e-9227-8fa8919cb568",
                        "glosses": [
                            "Geschenkpaket"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "51b6ce16-fd2f-4c40-a673-da7f59d54c1a",
                                "sense_id": "6fe3d321-a6d2-39b4-8766-203dc3407501",
                                "text": "„Knapp 2.500 Packerl aus dem Bezirk Kitzbühel wurden nach Rumänien geliefert und sorgten dort für leuchtende Kinderaugen.“"
                            },
                            {
                                "example_id": "7acf9bdd-6e6d-4fc0-90ac-778d605abcf5",
                                "sense_id": "6fe3d321-a6d2-39b4-8766-203dc3407501",
                                "text": "„Wem das zu wenig festlich ist, kann das Packerl mit allerlei Schleifen aufpimpen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
