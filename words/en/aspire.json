{
    "word_family": [
        "aspiration",
        "aspirant",
        "aspirational",
        "aspiring"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9273f80b-50b1-3fdb-be01-140b64a9baa0",
                    "sense_definition": "To have a strong desire or ambition to achieve something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young students <w>aspire</w> to become successful doctors after they finish their university studies.",
                            "target_lang_translations": {
                                "ru": "Многие молодые студенты <w>стремятся</w> стать успешными врачами после окончания учебы в университете."
                            }
                        },
                        {
                            "text": "If you <w>aspire</w> to greatness, you must be willing to work harder than everyone else around you.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>стремитесь</w> к величию, вы должны быть готовы работать усерднее, чем все остальные вокруг вас."
                            }
                        }
                    ],
                    "synonyms": [
                        "crave",
                        "pursue",
                        "strive",
                        "yearn",
                        "dream"
                    ],
                    "common_phrases": [
                        "aspire to greatness",
                        "aspire to become",
                        "aspire to do"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь сильное желание или амбицию достичь чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "настойчиво добиваться цели"
                            },
                            {
                                "target_lang_word": "жаждать",
                                "target_lang_sense_clarification": "очень сильно желать"
                            },
                            {
                                "target_lang_word": "претендовать",
                                "target_lang_sense_clarification": "рассчитывать на что-то высокое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca81921d-1203-375c-a527-612a2ddbb145",
                    "sense_definition": "To rise high or move upward; to be very tall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snowy points of the mountains <w>aspired</w> far above the clouds, reflecting a rosy hue in the sunset.",
                            "target_lang_translations": {
                                "ru": "Снежные пики гор <w>возносились</w> далеко над облаками, отражая розовый оттенок на закате."
                            }
                        },
                        {
                            "text": "In the center of the city, a sumptuous temple <w>aspires</w> toward the stars with its magnificent towers.",
                            "target_lang_translations": {
                                "ru": "В центре города великолепный храм своими величественными башнями <w>устремляется</w> к звездам."
                            }
                        }
                    ],
                    "synonyms": [
                        "ascend",
                        "mount",
                        "rise",
                        "soar",
                        "tower"
                    ],
                    "common_phrases": [
                        "aspire toward the stars"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься высоко или быть очень высоким; возвышаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возноситься",
                                "target_lang_sense_clarification": "подниматься ввысь"
                            },
                            {
                                "target_lang_word": "устремляться",
                                "target_lang_sense_clarification": "быть направленным вверх"
                            },
                            {
                                "target_lang_word": "выситься",
                                "target_lang_sense_clarification": "быть очень высоким"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5999a341-a425-39a7-9a9e-c68c137d0976",
                    "sense_definition": "To reach the top of something or to go as high as a certain point.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave spirit of the fallen soldier hath <w>aspired</w> the clouds in the heavens above.",
                            "target_lang_translations": {
                                "ru": "Храбрый дух павшего воина <w>достиг</w> облаков в небесах."
                            }
                        },
                        {
                            "text": "The cliffs were so high that even the strongest birds could scarce <w>aspire</w> their ridgy tops.",
                            "target_lang_translations": {
                                "ru": "Скалы были так высоки, что даже самые сильные птицы едва могли <w>достичь</w> их гребнистых вершин."
                            }
                        }
                    ],
                    "synonyms": [
                        "ascend",
                        "mount"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигать вершины чего-либо или подниматься до определенной высокой точки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "добираться до верха"
                            },
                            {
                                "target_lang_word": "подниматься",
                                "target_lang_sense_clarification": "всходить на высоту"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}