                    "semantic_group_id": "justification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aucune circonstance ne peut <w>légitimer</w> le recours à une telle violence."
                        },
                        {
                            "text": "Le directeur tente de <w>légitimer</w> une décision très impopulaire auprès de ses équipes."
                        }
                    ],
