                "forms": [],
                "senses": [
                    {
                        "sense_id": "9fb2a26f-0ccf-35b9-841a-83deccf27b49",
                        "entry_id": "b2a82d7f-db72-36fb-8b78-babcd42a83eb",
                        "glosses": [
                            "De façon créative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "302ccdb1-56f3-4b02-988d-15bc5555b3f9",
                                "sense_id": "9fb2a26f-0ccf-35b9-841a-83deccf27b49",
                                "text": "Une telle connaissance productive, que rien d’intérieur ne limite, appartient à la Divinité seule, qui, étant le fondement réel de toutes choses, produit créativement, par la connaissance qu’elle a de l’idée, l’être de l’idée même."
                            },
                            {
                                "example_id": "3cbb8761-5fbb-4665-9461-b23a2a214da3",
                                "sense_id": "9fb2a26f-0ccf-35b9-841a-83deccf27b49",
                                "text": "Créativement parlant, elle me paraît au point mort."
                            }
                        ]
                    },
