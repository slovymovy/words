        "pl-extract.jsonl": [],
        "fr-extract.jsonl": [
            {
                "entry_id": "a16a4c0f-4a7f-38a2-8ba1-52187cafdf50",
                "word": "sire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b7d0aa05-826f-4db9-9cb5-a8444c8d47b7",
                        "entry_id": "a16a4c0f-4a7f-38a2-8ba1-52187cafdf50",
                        "tags": [
                            "plural"
                        ],
                        "form": "sires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a798d5b-caaa-3ed3-9160-aa56cb13f7ae",
                        "entry_id": "a16a4c0f-4a7f-38a2-8ba1-52187cafdf50",
                        "glosses": [
                            "Seigneur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e4f93afa-8dc9-4919-9ca9-8b88ade18f0a",
                                "sense_id": "4a798d5b-caaa-3ed3-9160-aa56cb13f7ae",
                                "text": "Et me fut dit que le sire de la Trémoille étoit envoyé de par le duc et les seigneurs au roi, à Paris, pour savoir son plaisir, et pour impétrer que on les pût combattre."
                            },
                            {
                                "example_id": "d9244d54-a7ea-431c-9cae-057976c71e3d",
                                "sense_id": "4a798d5b-caaa-3ed3-9160-aa56cb13f7ae",
                                "text": "L’archevêque défendit à ses sujets de payer au sire de Beaujeu le cens d’un brotteau, ou terre à faire paître le bétail, près du pont du Rhône, brotteau dont les sires de Beaujeu s’étaient emparés […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c58c5803-4d21-3df6-b8fb-7bfc2d4f30bd",
                        "entry_id": "a16a4c0f-4a7f-38a2-8ba1-52187cafdf50",
                        "glosses": [
                            "Titre que l’on donne aux empereurs et aux rois, en leur parlant ou en leur écrivant. Prend alors une majuscule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e319aa7c-4757-4af0-b057-2aa2956b1ad4",
                                "sense_id": "c58c5803-4d21-3df6-b8fb-7bfc2d4f30bd",
                                "text": "Alors, Sire, dit Catherine, vos sujets les huguenots feront comme le sanglier à qui on ne met pas un épieu dans la gorge : ils découdront le trône."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5aa433b-ebe3-30c6-a211-d2f2c662961d",
                        "entry_id": "a16a4c0f-4a7f-38a2-8ba1-52187cafdf50",
                        "glosses": [
                            "Étalon qui a engendré une lignée reconnue."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab4aa773-6d00-4dd7-9a56-a0b506e1abae",
                        "source_entry_id": "a16a4c0f-4a7f-38a2-8ba1-52187cafdf50",
                        "source_sense_id": "4a798d5b-caaa-3ed3-9160-aa56cb13f7ae",
                        "source_sense_description": "(Désuet) Seigneur",
                        "target_lang_word": "sire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc057a8b-5378-3b69-b892-70701ce80b98",
                                        "entry_id": "cf42ed7e-26be-38e7-88c6-dd267610c0dc",
                                        "glosses": [
                                            "A lord, master, or other person in authority, most commonly used vocatively: formerly in speaking to elders and superiors, later only when addressing a sovereign."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a20af737-1b80-36a2-bcd0-1a67c779c986",
                                        "entry_id": "cf42ed7e-26be-38e7-88c6-dd267610c0dc",
                                        "glosses": [
                                            "A male animal that has fathered a particular offspring (especially used of domestic animals and/or in biological research)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9274348-8dc1-3e83-8031-5e32cb1eb8d2",
                                        "entry_id": "cf42ed7e-26be-38e7-88c6-dd267610c0dc",
                                        "glosses": [
                                            "A father; the head of a family; the husband."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "520b622a-aedb-478f-9570-9d3bb3be8458",
                                                "sense_id": "d9274348-8dc1-3e83-8031-5e32cb1eb8d2",
                                                "text": "He but a Duke, would haue his Sonne a King, / And raiſe his iſſue like a louing Sire."
                                            },
                                            {
                                                "example_id": "f1ec1064-eaec-4cf4-a114-49c5e41bd5ab",
                                                "sense_id": "d9274348-8dc1-3e83-8031-5e32cb1eb8d2",
                                                "text": "Sometimes, also, he reproached himself, for abandoning those abodes where his father had dwelt. “Who knows,” said he to himself, “whether the shades of the departed are allowed to pursue, every where, the objects of their affection? Perhaps it is only permitted them to wander about the spot where their ashes repose! Perhaps in this moment does the spirit of my sire regret the absence of his son, while distance prevents my hearing his voice, exerted to recall me.[”]"
                                            },
                                            {
                                                "example_id": "0f81f25f-98d4-4a84-8a3d-2c4f715492f8",
                                                "sense_id": "d9274348-8dc1-3e83-8031-5e32cb1eb8d2",
                                                "text": "The concession of the King, who, be it also remembered, is a Bourbon, under such circumstances, is one of a suspicious character. Those who remember how faithlessly his father behaved in 1821, under precisely similar circumstances, to his subjects, cannot help entertaining the apprehensions that the son, like the sire, is playing fast and loose with his people, and that he will turn on them when the Austrians come to his relief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df2fc027-0f98-37f7-a947-3fa28840d6a8",
                                        "entry_id": "cf42ed7e-26be-38e7-88c6-dd267610c0dc",
                                        "glosses": [
                                            "A creator; a maker; an author; an originator."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "946e02b1-5b0c-4777-b2ec-18a6e72553bf",
                                                "sense_id": "df2fc027-0f98-37f7-a947-3fa28840d6a8",
                                                "text": "Most musical of mourners, weep again! / Lament anew, Urania!—He died, / Who was the sire of an immortal strain, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1002bb89-fcfb-32ac-906c-4fad926b4f09",
                                        "entry_id": "cf42ed7e-26be-38e7-88c6-dd267610c0dc",
                                        "glosses": [
                                            "The vampire who turned another person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "106d91e9-ba02-457a-b05a-fca68b334f0c",
                                                "sense_id": "1002bb89-fcfb-32ac-906c-4fad926b4f09",
                                                "text": "There is a toxin in a vampire’s fangs that will infect its victim when the sire drinks deeply and fully of their blood."
                                            },
                                            {
                                                "example_id": "e9294910-daf1-40a4-86a5-7b2a5061f384",
                                                "sense_id": "1002bb89-fcfb-32ac-906c-4fad926b4f09",
                                                "text": "Ever since Antonio’s escape from his sire in 1942, he had never been tempted to return to the vampire fold."
                                            },
                                            {
                                                "example_id": "62015ecc-707b-43d4-b11d-5f3cab5ab878",
                                                "sense_id": "1002bb89-fcfb-32ac-906c-4fad926b4f09",
                                                "text": "“She is my sire. I cannot defy her as long as she is more powerful than me.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b682f94-7cb0-3cf8-8f3c-d95ac028cf8a",
                                        "entry_id": "1e9cdfd5-246a-3460-acbd-8ce0466d4e62",
                                        "glosses": [
                                            "To father; to beget."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62405a48-fa93-4d6d-a7fd-c68b0d9d1879",
                                                "sense_id": "5b682f94-7cb0-3cf8-8f3c-d95ac028cf8a",
                                                "text": "In these travels, my father sired thirteen children in all, four boys and nine girls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29b09e1-cf2b-3067-bffc-fc1ade15b05e",
                                        "entry_id": "1e9cdfd5-246a-3460-acbd-8ce0466d4e62",
                                        "glosses": [
                                            "To turn (another person) into a vampire."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a59630e5-d10c-49ee-891c-f09df6a3b73d",
                                                "sense_id": "a29b09e1-cf2b-3067-bffc-fc1ade15b05e",
                                                "text": "“Do you think they were wannabes, then? Groupies who found a willing vamp to sire them?”"
                                            },
                                            {
                                                "example_id": "a1972e93-033b-47aa-be5b-175ce934bedc",
                                                "sense_id": "a29b09e1-cf2b-3067-bffc-fc1ade15b05e",
                                                "text": "He wondered if she regretted siring him. Or marrying him."
                                            },
                                            {
                                                "example_id": "76d50337-ddc9-4123-95c2-0f8a0495275b",
                                                "sense_id": "a29b09e1-cf2b-3067-bffc-fc1ade15b05e",
                                                "text": "I'd never sired another vampire before and I was at a loss of what to do with the rats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b960439-7161-44bb-a968-8fd9f4488c19",
                        "source_entry_id": "a16a4c0f-4a7f-38a2-8ba1-52187cafdf50",
