                                        "sense_id": "5f0e020c-e737-34dc-ac9f-c4c9bace0b5d",
                                        "entry_id": "d2d5da53-6113-31df-9054-624aee389d82",
                                        "glosses": [
                                            "To move quickly or in an uncontrolled manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b89c6ce1-7f1c-4b16-9e82-0a276f062184",
                                                "sense_id": "5f0e020c-e737-34dc-ac9f-c4c9bace0b5d",
                                                "text": "He came barrelling around the corner and I almost hit him."
                                            },
                                            {
                                                "example_id": "7cacab7b-2f4d-4ce7-b87b-4d3907286bda",
                                                "sense_id": "5f0e020c-e737-34dc-ac9f-c4c9bace0b5d",
                                                "text": "Snow shattered and spilled down the slope. Within seconds, the avalanche was the size of more than a thousand cars barreling down the mountain and weighed millions of pounds."
                                            },
                                            {
                                                "example_id": "b9935cc2-7a98-4135-a2d8-1e7c87c5d495",
                                                "sense_id": "5f0e020c-e737-34dc-ac9f-c4c9bace0b5d",
                                                "text": "Days before Trump’s inauguration, his envoy to the Middle East, Steve Witkoff, barrelled into Israel with a demand to meet Netanyahu on Shabbat in order to strongarm him into negotiating a ceasefire deal with Hamas in Gaza."
                                            }
                                        ]
                                    },
