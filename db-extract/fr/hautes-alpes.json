                "senses": [
                    {
                        "sense_id": "8face224-717c-3634-9280-7be61d1345b3",
                        "entry_id": "1e8d6996-759e-38dc-a201-d551521b29e4",
                        "glosses": [
                            "Département français de la région Provence-Alpes-Côte d'Azur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3bca898-1332-4dd7-819b-1cff3ced7541",
                                "sense_id": "8face224-717c-3634-9280-7be61d1345b3",
                                "text": "De temps immémorial, les mélézeins des Hautes-Alpes ont été exploités par la méthode jardinatoire."
                            },
                            {
                                "example_id": "8e5aaa12-c628-40ac-8a6b-063ffc8a6547",
                                "sense_id": "8face224-717c-3634-9280-7be61d1345b3",
                                "text": "[…] il venait de recevoir un papier, sans doute bleu horizon, qui l’invitait à se présenter incessamment sous peu dans un quelconque bureau de la caserne de Gap (Hautes-Alpes). La feuille indiquait sans équivoque que l’on envisageait de l’incorporer de force […]"
                            },
                            {
                                "example_id": "8af5ba0a-4240-4a20-b9e8-9d913c5cc899",
                                "sense_id": "8face224-717c-3634-9280-7be61d1345b3",
                                "text": "Dans le village des Andrieux (Hautes-Alpes), les ménagères vont le premier de l’an à la fontaine, d’aussi bonne heure que possible."
                            }
                        ]
                    }
                ],
