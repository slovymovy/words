                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc710a16-d369-3f11-8a51-7f93b2c003e6",
                                        "entry_id": "3bdd989f-b932-3122-9fe4-d61439978fe5",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif du verbe aider."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12876834-8bd0-4fef-9bca-915dbe06d9ed",
                                                "sense_id": "dc710a16-d369-3f11-8a51-7f93b2c003e6",
                                                "text": "Hé ! toi, aide-donc cette chétiote, un brin !"
                                            },
                                            {
