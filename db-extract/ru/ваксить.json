                                        "sense_id": "4cfe58c0-5e52-31f0-af74-2f41b352bfd6",
                                        "entry_id": "16da33fe-fb9c-36c3-a4b1-2e9c4d7489bf",
                                        "glosses": [
                                            "A substance used to polish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e641864-dbd1-4516-b7f0-482b046ec9a4",
                                                "sense_id": "4cfe58c0-5e52-31f0-af74-2f41b352bfd6",
                                                "text": "A good silver polish will remove tarnish easily."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "538abba5-87da-3ff0-be63-11d4b7a53869",
                                        "entry_id": "16da33fe-fb9c-36c3-a4b1-2e9c4d7489bf",
                                        "glosses": [
                                            "Cleanliness; smoothness, shininess."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae6c916-6a41-4ec7-a681-925bf21b7854",
                                                "sense_id": "538abba5-87da-3ff0-be63-11d4b7a53869",
                                                "text": "The floor was waxed to a high polish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f45b80-9868-360a-9261-91e44b753756",
                                        "entry_id": "16da33fe-fb9c-36c3-a4b1-2e9c4d7489bf",
                                        "glosses": [
                                            "Refinement; cleanliness in performance or presentation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8991051d-4d6b-49a6-8237-3ce27ab920d9",
                                                "sense_id": "28f45b80-9868-360a-9261-91e44b753756",
                                                "text": "The lecturer showed a lot of polish at his last talk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45245ae8-4980-3edf-bea4-42e63b09f85e",
                                        "entry_id": "7822e8af-093c-3f07-a372-0333a9b8e846",
                                        "glosses": [
                                            "To shine; to make a surface very smooth or shiny by rubbing, cleaning, or grinding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971f07f3-a10a-420e-8b45-b96007634d43",
                                                "sense_id": "45245ae8-4980-3edf-bea4-42e63b09f85e",
                                                "text": "He polished up the chrome until it gleamed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca8f2f5c-f5f4-3bb3-8c6b-93439a719ee0",
                                        "entry_id": "7822e8af-093c-3f07-a372-0333a9b8e846",
                                        "glosses": [
                                            "To refine; remove imperfections from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f88de9-617e-4f01-9851-f31c9357ad14",
                                                "sense_id": "ca8f2f5c-f5f4-3bb3-8c6b-93439a719ee0",
                                                "text": "The band has polished its performance since the last concert."
                                            },
                                            {
                                                "example_id": "9f9968e9-1fc3-4e25-8d9b-4bb40faf0c7f",
                                                "sense_id": "ca8f2f5c-f5f4-3bb3-8c6b-93439a719ee0",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caa836b3-d90e-335a-924f-f7f03bf808e0",
                                        "entry_id": "7822e8af-093c-3f07-a372-0333a9b8e846",
                                        "glosses": [
                                            "To apply shoe polish to shoes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95f57cc2-4388-3f39-98e1-535402248aa6",
                                        "entry_id": "7822e8af-093c-3f07-a372-0333a9b8e846",
                                        "glosses": [
                                            "To become smooth, as from friction; to receive a gloss; to take a smooth and glossy surface."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c97b180-73d6-4523-be7d-70467e36a61f",
                                                "sense_id": "95f57cc2-4388-3f39-98e1-535402248aa6",
                                                "text": "Steel polishes well."
                                            },
                                            {
                                                "example_id": "24192bcb-4de2-4382-90f5-66134458d072",
                                                "sense_id": "95f57cc2-4388-3f39-98e1-535402248aa6",
                                                "text": "The other [gold], whether it will polish so well Wherein for the latter [brass] it is probable it will"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea1b00f-e3f5-3afb-89bd-1d09b7ce7a32",
                                        "entry_id": "7822e8af-093c-3f07-a372-0333a9b8e846",
                                        "glosses": [
                                            "To refine; to wear off the rudeness, coarseness, or rusticity of; to make elegant and polite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9df2223c-5ac8-4a9b-9c26-39a9a9f677e2",
                                                "sense_id": "3ea1b00f-e3f5-3afb-89bd-1d09b7ce7a32",
                                                "text": "Arts that polish Life."
                                            }
                                        ]
                                    }
                                ]
                            }
