                ],
                "senses": [
                    {
                        "sense_id": "365c42c6-d17f-35bf-a0b3-bdaa82afffb8",
                        "entry_id": "24daaeac-3bc9-36a0-b8e1-446e1e38d87c",
                        "glosses": [
                            "politische Partei, die mit Ablegern in zahlreichen arabischen Ländern aktiv ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1da94e-0801-4e71-bebe-bdf45f0743ae",
                                "sense_id": "365c42c6-d17f-35bf-a0b3-bdaa82afffb8",
                                "text": "„Sie war entstanden als Reaktion auf die arabisch-nationalistischen Gruppierungen wie die Baath-Partei, auf kommunistische, linke und islamistische Bewegungen wie die Muslimbruderschaft, die für einen gesellschaftlichen Wandel plädierten, noch bevor andere Probleme, insbesondere das Palästina-Problem, angegangen werden konnten.“"
                            },
                            {
                                "example_id": "ff375248-abf1-4af1-93bb-9c0e32d4aa4b",
                                "sense_id": "365c42c6-d17f-35bf-a0b3-bdaa82afffb8",
                                "text": "„Wärehdn die PLO die Wahlen 1972 boykottierte, nahmen die Fatah, DFLP, PFLP, die Kommunisten und die Baath-Partei 1976 als Palästinensische Nationale Front teil und gewannen haushoch.“"
                            },
                            {
                                "example_id": "b3191269-1ecc-4d9e-8171-28be9a517839",
                                "sense_id": "365c42c6-d17f-35bf-a0b3-bdaa82afffb8",
                                "text": "„›Die Frage ist nämlich, wer die eigentliche Macht hinter Hafez dem Löwen ist. Ist es die syrisch-arabische Baath-Partei? Nein, natürlich nicht! Völlig absurd!‹“"
                            },
                            {
                                "example_id": "0e15b258-a52d-4ffe-b653-da655313285d",
                                "sense_id": "365c42c6-d17f-35bf-a0b3-bdaa82afffb8",
                                "text": "„Seine Nachforschungen ergaben, dass die Leibgarde aus einem speziellen Fonds bei einer Bank bezahlt wurde, die Führungspersönlichkeiten der regierenden Baath-Partei gehörte, und das beunruhigte Drexler noch mehr als der Personenschutz an sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
