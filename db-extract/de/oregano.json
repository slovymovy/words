                    {
                        "translation_id": "488e89cc-d721-45b0-b827-c653fa5d8750",
                        "source_entry_id": "85cf167b-03b0-301c-b2a9-a5d9a9eb7986",
                        "source_sense_id": "de6a2dc2-1217-3a0b-8e83-bd7f7a083ace",
