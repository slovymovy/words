                                            "zdroj kmitů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b62564-5650-4a74-b97d-f2bd9a1a0e32",
                                                "sense_id": "352d42d9-ce39-34e4-97a9-7d29c31f622c",
                                                "text": "Nový prototyp kruhového oscilátoru z grafenu a zlatých spojů byl chemickou cestou (odpařováním) vytvořen přímo v obvodu. Cílem bylo využít rychlost elektronů v grafenu pro co nejvyšší frekvenci kruhového oscilátoru."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0721fedd-485a-4fce-b770-5165ba51b8d9",
                        "source_entry_id": "a6370db3-cacb-3845-8c4f-6fe9a2e0e74e",
                        "source_sense_description": "an electronic circuit used to generate a continuous output waveform",
                        "target_lang_word": "oscillateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oscillateur",
