                        "cross_references": [
                            {
                                "target_word": "Lafette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                        "entry_id": "50b24143-ca40-3f2d-bb25-64a16e6f033b",
                                        "glosses": [
                                            "fahrbares Untergestell, auf dem ein Geschütz (eine Waffe, eine Kanone) montiert werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac183c80-da86-49dd-8858-89548c8dc3df",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Das QF 4 inch (102 mm) war ein britisches Schiffsgeschütz aus dem Ersten Weltkrieg, das mit geeigneten Lafetten an die Verwendung als schweres Flugzeugabwehrgeschütz an Land und zur See angepasst wurde.“"
                                            },
                                            {
                                                "example_id": "60dc64a3-fcdb-4df1-a954-cbaccd5378f6",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Jetzt wurde der Sarg auf der Lafette abgestellt.“"
                                            },
                                            {
                                                "example_id": "820a1428-155e-4692-94a0-b9689145b441",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Unsere Backbordkanonen wurden an Land gebracht und in einem Blockhaus untergestellt, während die Steuerbordkanonen auf ihren Lafetten stehen blieben.“"
                                            },
                                            {
                                                "example_id": "76db75b9-e255-473c-be45-0c10ad005f5c",
                                                "sense_id": "bf5b3a8c-3311-3d7f-9fa8-f59dff167c72",
                                                "text": "„Martins Kanoniere waren insofern im Vorteil, als sie ihre Habseligkeiten an die Lafetten hängen oder in die Munitionswagen geben konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
