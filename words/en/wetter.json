{
    "word_family": [
        "wet",
        "wetness",
        "wetting"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bdb698b6-2b48-391b-9c67-725359790dfa",
                    "sense_definition": "Comparative form of <w>wet</w>: more wet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grass is <w>wetter</w> today because it rained all night.",
                            "target_lang_translations": {
                                "ru": "Трава сегодня <w>более мокрая</w>, потому что всю ночь шел дождь."
                            }
                        },
                        {
                            "text": "My shoes are <w>wetter</w> than yours after walking through the puddle.",
                            "target_lang_translations": {
                                "ru": "Мои ботинки <w>более мокрые</w>, чем твои, после того как я прошел через лужу."
                            }
                        }
                    ],
                    "antonyms": [
                        "drier"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень прилагательного «мокрый»: более влажный или мокрый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более мокрый",
                                "target_lang_sense_clarification": "прямое сравнение степени влажности"
                            },
                            {
                                "target_lang_word": "более влажный",
                                "target_lang_sense_clarification": "используется для описания среды или поверхностей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5fc526ac-fa04-3b2a-a6ce-4d85f290b56d",
                    "sense_definition": "Someone who wets something as part of a process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>wetter</w> applied the solution to the fabric before the dyeing process.",
                            "target_lang_translations": {
                                "ru": "<w>Увлажнитель</w> нанес раствор на ткань перед процессом окрашивания."
                            }
                        },
                        {
                            "text": "As a professional <w>wetter</w>, he ensures the materials are properly prepared for treatment.",
                            "target_lang_translations": {
                                "ru": "Будучи профессиональным <w>увлажнителем</w>, он следит за тем, чтобы материалы были должным образом подготовлены к обработке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто увлажняет что-либо в процессе производства или обработки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увлажнитель",
                                "target_lang_sense_clarification": "лицо или устройство, выполняющее процесс увлажнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1c59d8d-bc2d-3148-b5c4-7b1bd6791977",
                    "sense_definition": "A chemical substance used to help a liquid spread over a surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding a <w>wetter</w> to the paint helps it cover the wall more evenly.",
                            "target_lang_translations": {
                                "ru": "Добавление <w>смачивателя</w> в краску помогает ей более равномерно покрыть стену."
                            }
                        },
                        {
                            "text": "The industrial <w>wetter</w> reduces surface tension for better cleaning results.",
                            "target_lang_translations": {
                                "ru": "Промышленный <w>смачиватель</w> снижает поверхностное натяжение для достижения лучших результатов очистки."
                            }
                        }
                    ],
                    "synonyms": [
                        "surfactant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическое вещество, способствующее растеканию жидкости по поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смачиватель",
                                "target_lang_sense_clarification": "поверхностно-активное вещество"
                            },
                            {
                                "target_lang_word": "ПАВ",
                                "target_lang_sense_clarification": "аббревиатура для поверхностно-активного вещества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef6ac470-36f7-30c3-87bf-74000f23722b",
                    "sense_definition": "A person who habitually wets the bed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor provided advice to help the young <w>wetter</w> overcome the issue.",
                            "target_lang_translations": {
                                "ru": "Врач дал советы, чтобы помочь юному <w>страдающему энурезом</w> справиться с этой проблемой."
                            }
                        },
                        {
                            "text": "Many children are <w>wetters</w> at a young age but eventually grow out of it.",
                            "target_lang_translations": {
                                "ru": "Многие дети в раннем возрасте <w>страдают энурезом</w>, но со временем это проходит."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedwetter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, страдающий энурезом (обычно ребенок)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдающий энурезом",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "656bc1fd-d997-3195-8c9c-b46f353bec3a",
                    "sense_definition": "A weapon used to commit a stabbing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal hid the <w>wetter</w> in a dark alleyway after the attack.",
                            "target_lang_translations": {
                                "ru": "Преступник спрятал <w>нож</w> в темном переулке после нападения."
                            }
                        },
                        {
                            "text": "Police recovered the <w>wetter</w> used in the violent confrontation.",
                            "target_lang_translations": {
                                "ru": "Полиция обнаружила <w>нож</w>, использованный в жестокой стычке."
                            }
                        }
                    ],
                    "synonyms": [
                        "knife",
                        "blade"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название холодного оружия, используемого для нанесения колотых ран."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нож",
                                "target_lang_sense_clarification": "криминальный жаргон"
                            },
                            {
                                "target_lang_word": "перо",
                                "target_lang_sense_clarification": "воровской жаргон для обозначения ножа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}