                "senses": [
                    {
                        "sense_id": "3d232d07-2b9f-3d9d-a22a-22ac9bfc9ef4",
                        "entry_id": "14472348-6fcf-3516-9f45-85fc24f9fb40",
                        "glosses": [
                            "reines Instrumentalstück der mittelalterlichen französischen Musik"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ba4f12a-5de9-3932-94a3-50481a97d3dc",
                        "entry_id": "14472348-6fcf-3516-9f45-85fc24f9fb40",
                        "glosses": [
                            "kurze gereimte altfranzösische Erzählung, die vorwiegend Stoffe aus der Welt des König Arthus behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f2df03-3acc-4261-a5db-f6b852fd44fe",
                                "sense_id": "7ba4f12a-5de9-3932-94a3-50481a97d3dc",
                                "text": "Marie de France ist die bedeutendste Verfasserin der Lais."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8ec97b80-6e84-3d45-a696-3512a0010a18",
                        "entry_id": "14472348-6fcf-3516-9f45-85fc24f9fb40",
                        "glosses": [
                            "altfranzösisches liedhaftes Gedicht, das auf unterschiedlich langen Abschnitten und nicht auf Strophen aufbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df32e96c-2298-45f3-b049-f58f1179d7dc",
                                "sense_id": "8ec97b80-6e84-3d45-a696-3512a0010a18",
                                "text": "Christine de Pisan verfasste Lais."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a696571-3391-4ce2-998d-a9f36ec0e44a",
                        "source_entry_id": "14472348-6fcf-3516-9f45-85fc24f9fb40",
                        "source_sense_id": "7ba4f12a-5de9-3932-94a3-50481a97d3dc",
                        "target_lang_word": "lai",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a87617f-ecfd-3d50-b61d-2724e6506c8e",
                                        "entry_id": "f1f7777b-72e9-3924-b2fa-ff7273b545ee",
                                        "glosses": [
                                            "Laïc, convers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e15a32-1da2-4042-a339-630f6af6761d",
                                                "sense_id": "2a87617f-ecfd-3d50-b61d-2724e6506c8e",
                                                "text": "Un second frère lai conduisait une mule de rechange, chargée, selon toute probabilité, du bagage de son supérieur."
                                            },
                                            {
                                                "example_id": "f362d221-5008-4fa0-9a8f-1d8bd573ed43",
                                                "sense_id": "2a87617f-ecfd-3d50-b61d-2724e6506c8e",
                                                "text": "Bazin devint frère lai."
                                            },
                                            {
                                                "example_id": "3ab9e459-6b82-495c-bbe6-7677f9a89c25",
                                                "sense_id": "2a87617f-ecfd-3d50-b61d-2724e6506c8e",
                                                "text": "Sœur laie, sœur converse."
                                            },
                                            {
                                                "example_id": "4d7d3d8e-cd3a-488c-bef9-c7a9eebefc9f",
                                                "sense_id": "2a87617f-ecfd-3d50-b61d-2724e6506c8e",
                                                "text": "— Nous le jurons ! dirent encore à genoux les deux jeunes sœurs laies en fondant en larmes, parce qu’elles n’étaient pas animées par une résolution aussi forte que celle de la supérieure."
                                            },
                                            {
                                                "example_id": "80960f14-b351-4732-a265-102a5dc74aee",
                                                "sense_id": "2a87617f-ecfd-3d50-b61d-2724e6506c8e",
                                                "text": "Mais sans doute il eût recommencé une cinquième fois, si son père ne lui eût fait la menace formelle de le tenir pendant vingt ans comme frère lai dans un cloître, ajoutant le serment qu’il ne verrait jamais la setch, s’il n’apprenait à fond tout ce qu’on enseignait à l’académie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa69c76b-705d-3ef4-8987-f6019c8d345b",
                                        "entry_id": "f1f7777b-72e9-3924-b2fa-ff7273b545ee",
                                        "glosses": [
                                            "Séculier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8428008d-51b9-42b5-88cd-3f18ec98836f",
                                                "sense_id": "fa69c76b-705d-3ef4-8987-f6019c8d345b",
                                                "text": "Cour laie, tribunal séculier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lai",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc7cf47e-06b9-33be-acce-1f0db6fc42e2",
                                        "entry_id": "481b2eb7-4008-3f32-a6a6-d76cc33cd724",
                                        "glosses": [
                                            "Petit poème narratif, en vers octosyllabique, inspiré de sujets sérieux ou passionnés, empruntés le plus souvent à d’anciennes légendes."
                                        ],
                                        "tags": [
                                            "Wikipédia ou le TLFi indiquent plusieurs sens diachroniques ; à préciser ou à vérifier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ce882a-a42b-4877-9690-4b4cb74fd88e",
                                                "sense_id": "fc7cf47e-06b9-33be-acce-1f0db6fc42e2",
                                                "text": "Je fis jadis chansons et lais.\nAvec joie alors je chantais.\nAujourd’hui mourant de regrets,\nC’est mon chant de mort que je fais."
                                            },
                                            {
                                                "example_id": "062172ca-cc5a-4d30-af78-87e6679f446a",
                                                "sense_id": "fc7cf47e-06b9-33be-acce-1f0db6fc42e2",
                                                "text": "Nous irons, mes frères et moi, dans les villes, nous nous tiendrons avec un luth sur la place publique, le jour du marché. Les bonnes gens s’approcheront de nous, et nous leur dirons : « Nous sommes les jongleurs du bon Dieu, et nous allons vous chanter un lai. Si vous en êtes contents, vous nous donnerez une récompense. »"
                                            },
                                            {
                                                "example_id": "c44293d1-b775-4d79-ab91-6cac46fb925c",
                                                "sense_id": "fc7cf47e-06b9-33be-acce-1f0db6fc42e2",
                                                "text": "Moi qui sais des lais pour les reines\nLes complaintes de mes années\nDes hymnes d’esclave aux murènes\nLa romance du mal aimé\nEt des chansons pour les sirènes."
                                            },
                                            {
                                                "example_id": "d1ffa0fa-f849-49d3-b83a-03e663741d5a",
                                                "sense_id": "fc7cf47e-06b9-33be-acce-1f0db6fc42e2",
                                                "text": "Ce corniaud de chanteur y verrait, pourquoi pas ? l’occasion d’un lai."
                                            },
                                            {
                                                "example_id": "c9abad1d-9593-486d-94de-7bc494c04392",
                                                "sense_id": "fc7cf47e-06b9-33be-acce-1f0db6fc42e2",
                                                "text": "C’est ainsi que dans le lai du dernier ménestrel, Walter Scott décrit les transformations que le célèbre magicien sir Michel Scott pouvait opérer, au moyen de son merveilleux grimoire comme des opérations de glamour."
                                            },
                                            {
                                                "example_id": "288a7127-2d05-448e-a2f3-1f3ca36a6beb",
                                                "sense_id": "fc7cf47e-06b9-33be-acce-1f0db6fc42e2",
                                                "text": "Quand les Noëls d’usage furent chantés, nous les installâmes à chanter des chansons et des lais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
