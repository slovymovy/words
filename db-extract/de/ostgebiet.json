                                "example_id": "483edf80-b10d-48d1-acba-9f37021a7e80",
                                "sense_id": "4f758825-96c1-3717-8ec2-6092d3cd4614",
                                "text": "Das Ostgebiet beginnt hinter den Bergen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af0cb3ba-827f-3f73-96da-6d6343dfee01",
                        "entry_id": "f5715941-0d99-3017-8cee-c0a830e5e6f0",
                        "glosses": [
                            "historisches Siedlungsgebiet von Deutschen im Osten des ehemaligen Deutschen Reiches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c3cd26-1b33-4bf3-8df6-2ae1f659d260",
                                "sense_id": "af0cb3ba-827f-3f73-96da-6d6343dfee01",
                                "text": "„Insgesamt wurden mehrere Hunderttausende deutsche Siedler aus den Ostgebieten nach dem Krieg in Lagern inhaftiert oder mussten - teilweise jahrelang - Zwangsarbeit leisten.“"
                            },
                            {
                                "example_id": "86a09181-6ffe-43a7-94b2-a7614523d94b",
                                "sense_id": "af0cb3ba-827f-3f73-96da-6d6343dfee01",
                                "text": "„Gleichwohl muss dem Nachspüren einer nationalen Tragödie – und um eine solche handelt es sich bei der ethnischen Säuberung der ehemaligen Ostgebiete – heute nicht mehr unterstellt werden, damit deutsche Untaten relativieren zu wollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
