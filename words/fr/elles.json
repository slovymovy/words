                {
                    "sense_id": "382b9ab2-7630-3d53-801b-f2f47cd63e27",
                    "sense_definition": "Pronom personnel sujet de la troisième personne du pluriel féminin, désignant un groupe de personnes, d'animaux ou d'objets de genre féminin.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronom_sujet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes deux sœurs sont à l'université et <w>elles</w> étudient la médecine."
                        },
                        {
                            "text": "Ces fleurs sont magnifiques parce qu'<w>elles</w> s'épanouissent au printemps."
                        }
                    ],
                    "antonyms": [
                        "ils"
                    ],
                    "common_phrases": [
                        "elles aussi",
                        "elles sont",
                        "elles ont"
                    ]
                },
                {
                    "sense_id": "01ae578a-b619-3c2e-bb78-63744cb15fec",
                    "sense_definition": "Pronom personnel tonique ou disjoint de la troisième personne du pluriel féminin, employé après une préposition ou pour insister.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronom_tonique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous sommes allés au restaurant avec <w>elles</w> hier soir."
                        },
                        {
                            "text": "Ce cadeau d'anniversaire est préparé spécialement pour <w>elles</w>."
                        }
                    ],
                    "antonyms": [
                        "eux"
                    ],
                    "common_phrases": [
                        "avec elles",
                        "pour elles",
                        "chez elles"
                    ]
                },
                {
                    "sense_id": "a89b2a9b-4ce0-30a9-b003-834df1e56f05",
                    "sense_definition": "Pronom tonique féminin pluriel employé en apposition pour marquer un contraste ou une opposition par rapport à un autre groupe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pronom_tonique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les garçons sont partis tôt, les filles, <w>elles</w>, ont préféré rester."
                        },
                        {
                            "text": "Quant à <w>elles</w>, leur décision a été prise sans aucune hésitation."
                        }
                    ],
                    "common_phrases": [
                        "quant à elles"
                    ]
                }
            ]
        },
