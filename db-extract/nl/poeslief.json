                ],
                "senses": [
                    {
                        "sense_id": "38514b13-3b7d-3fdc-a2ae-ad9ff682283c",
                        "entry_id": "afb0dec7-3bb7-3eda-b16e-637868d8a0ce",
                        "glosses": [
                            "schijnbaar erg lief"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ca3c2ff-7b3d-4453-b472-54a7d5b25025",
                                "sense_id": "38514b13-3b7d-3fdc-a2ae-ad9ff682283c",
                                "text": "Zij vroeg poeslief aan haar leraar of hij haar toch maar een voldoende wilde geven voor het proefwerk dat ze heel slecht gemaakt had."
                            },
                            {
                                "example_id": "46679595-fcb0-4e3b-bf6b-429e2a5d980b",
                                "sense_id": "38514b13-3b7d-3fdc-a2ae-ad9ff682283c",
                                "text": "Ook zei ze dat in bepaalde omstandigheden iedereen slecht kon worden. Als voorbeeld noemde ze Mengele, die regelmatig in de kinderbarak verscheen en dan poeslief deed, terwijl hij je met een vingerwijzing de dood in kon sturen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e8902b5-1ea6-343a-ad31-0a56e1c04156",
                        "entry_id": "afb0dec7-3bb7-3eda-b16e-637868d8a0ce",
                        "glosses": [
                            "buitengewoon aardig en tegemoetkomend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896b7fd4-6cb5-46e0-92ee-e70e87676dc7",
                                "sense_id": "0e8902b5-1ea6-343a-ad31-0a56e1c04156",
                                "text": "Ze kon aandachtig luisteren en was heel attent. Als er iemand jarig was, was zij de eerste die een felicitatie stuurde. De datums wist ze uit haar hoofd, vertelt broer Marnix Verbaan. „En haar huis stond vol met ingelijste foto’s van de familie.” Niet dat ze altijd poeslief was, zegt Verbaan. „Ze had het hart op de tong en liet zich de kaas niet van het brood eten.”"
                            }
                        ]
                    }
