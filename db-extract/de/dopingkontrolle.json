                        "glosses": [
                            "Überprüfung (vor allem von Sportlern) daraufhin, ob das Dopingverbot beachtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3615943f-32f6-4247-9b18-ccb91e051e13",
                                "sense_id": "227dbd3d-2e9a-3fea-a626-5d70176bd86a",
                                "text": "Bei Dopingkontrollen sind schon oft Sportler der Einnahme unerlaubter Mittel überführt worden."
                            },
                            {
                                "example_id": "c8a75c08-3ace-4291-9f52-265e2d33ab09",
                                "sense_id": "227dbd3d-2e9a-3fea-a626-5d70176bd86a",
                                "text": "„Damit sie bis zu 80 Kilometer schnell rasen können, geben ihnen ihre Besitzer neuerdings oftmals Kokain. Deshalb sind Dopingkontrollen bei Windhundrennen inzwischen keine Ausnahme mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
