            {
                "entry_id": "8629ed8c-44db-31f9-9ec2-26ef1c52975c",
                "word": "tondeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b90df709-e6e7-46ef-a2b9-423b11346c56",
                        "entry_id": "8629ed8c-44db-31f9-9ec2-26ef1c52975c",
                        "tags": [
