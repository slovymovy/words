                            "wykorzystujący elementy charakterystyczne dla gotyku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a75bd65-6219-4778-9225-a565ce7bfdd5",
                                "sense_id": "db46e835-17f3-39c2-bee4-0440c90571be",
                                "text": "Jadąc tramwajem przez Załęże, mijamy piękny neogotycki kościół pod wezwaniem św. Józefa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
