                                        "entry_id": "e4e1c54d-b749-391e-ae19-23eb2202acda",
                                        "glosses": [
                                            "A person or animal shaped like a potato, that is, with a large belly and/or short legs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
