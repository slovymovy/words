                "senses": [
                    {
                        "sense_id": "35bae64e-1729-39aa-99b4-e8e0c1d73c72",
                        "entry_id": "3a1eb9cf-62ea-3b0d-9b31-02fd4de256f0",
                        "glosses": [
                            "Verzögerung oder Ausfall im Vergleich zur normalen Sprachentwicklung (Spracherwerb)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa3104f-b773-4567-8e27-3cc812343afd",
                                "sense_id": "35bae64e-1729-39aa-99b4-e8e0c1d73c72",
                                "text": "Sprachentwicklungsstörungen führen dazu, dass ein Kind seine Sprache nicht altersgemäß beherrscht."
                            },
                            {
                                "example_id": "320957c8-3352-4c5e-885c-82b278b2da58",
                                "sense_id": "35bae64e-1729-39aa-99b4-e8e0c1d73c72",
                                "text": "„Die mögliche Komplexität von Sprachentwicklungsstörungen verweist darauf, daß diese als fakultative oder obligatorische Anteile sogenannter Mehrfachbehinderungen (…) oder gemeinsam mit anderen Behinderungsformen auftreten können (…)“"
                            },
                            {
                                "example_id": "4831d916-5e5d-4d29-bf1d-3d3f32784761",
                                "sense_id": "35bae64e-1729-39aa-99b4-e8e0c1d73c72",
                                "text": "„Weiterhin wird auf die differentialdiagnostische Abgrenzung zwischen Sprachentwicklungsverzögerung und Sprachentwicklungsstörung eingegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
