                        "examples": [
                            {
                                "example_id": "55a68ab8-f73a-4902-82ad-4f34483bc028",
                                "sense_id": "244771cf-9596-3bbd-8b3d-c2b119b2c152",
                                "text": "Tijdens de oorlog werd er een veldhospitaal opgezet om gewonde soldaten te behandelen.",
                                "translation": "During the war, a field hospital was set up to treat injured soldiers.",
                                "english": "During the war, a field hospital was set up to treat injured soldiers."
                            },
                            {
                                "example_id": "435ca371-9f64-4f52-903b-f1e5614b06ca",
                                "sense_id": "244771cf-9596-3bbd-8b3d-c2b119b2c152",
                                "text": "Het medische team van het veldhospitaal werkte dag en nacht om levens te redden op het slagveld.",
                                "translation": "The medical team of the field hospital worked day and night to save lives on the battlefield.",
                                "english": "The medical team of the field hospital worked day and night to save lives on the battlefield."
                            },
                            {
                                "example_id": "282c0067-ac40-4eca-94c5-5c5ba6417815",
                                "sense_id": "244771cf-9596-3bbd-8b3d-c2b119b2c152",
                                "text": "Het veldhospitaaltje was uitgerust met basisfaciliteiten om eerste hulp te bieden aan gewonden.",
                                "translation": "The field hospital was equipped with basic facilities to provide first aid to the injured.",
                                "english": "The field hospital was equipped with basic facilities to provide first aid to the injured."
                            }
                        ]
