                    "sense_definition": "To number again; to assign new numbers to a series of items.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "renumber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor had to <w>renumerate</w> the chapters after a new section was inserted."
                        },
                        {
                            "text": "The clerk will <w>renumerate</w> the pages to keep them in sequential order."
                        }
                    ],
                    "synonyms": [
                        "renumber"
                    ],
                    "common_phrases": [
                        "renumerate the pages",
                        "renumerate the chapters"
                    ]
                },
                {
                    "sense_id": "1066005a-b4b9-3566-bfcc-f4bd5fa7c451",
                    "sense_definition": "To count again; to recount a set of items.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The auditor chose to <w>renumerate</w> the items in stock to verify the total."
                        },
                        {
                            "text": "Officials decided to <w>renumerate</w> the ballots after finding an inconsistency in the records."
                        }
                    ],
                    "synonyms": [
