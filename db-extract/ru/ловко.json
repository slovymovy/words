                        "entry_id": "ffa2f76d-9fc2-3bd5-85aa-83febbe12c3b",
                        "glosses": [
                            "наречие к ловкий; быстро и точно, искусно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
