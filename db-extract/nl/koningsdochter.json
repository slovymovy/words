                "senses": [
                    {
                        "sense_id": "af6c7cf3-9fbb-3d49-b54e-1ee66dba6003",
                        "entry_id": "cb7fa019-5c46-3105-8978-890ccfd4d829",
                        "glosses": [
                            "de dochter van een koning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8679c328-2bd1-4dfb-a6ab-fd2fab51d650",
                                "sense_id": "af6c7cf3-9fbb-3d49-b54e-1ee66dba6003",
                                "text": "Hoewel het volwassen leven van Prins Willem van Oranje uitermate succesvol begon met het trouwen van de Engelse koningsdochter Anna, een vermaarde schoonheid voor wie, wegens het protestantisme, maar weinig hoven openstonden en die om dezelfde reden Lodewijk xv had afgewezen, liet het vervolgens niets dan teleurstellingen en vernederingen zien, zo veel dat Koning George II er ten slotte een hartgrondige hekel aan zijn schoonzoon door kreeg."
                            },
                            {
                                "example_id": "ac1f3c6d-a3d7-483c-9e7c-e32e33bbc0b4",
                                "sense_id": "af6c7cf3-9fbb-3d49-b54e-1ee66dba6003",
                                "text": "Wanneer haar vader op 30 april koning wordt, wordt Amalia Prinses van Oranje. Het is voor het eerst dat een koningsdochter de titel draagt, dat was tot nu toe voorbehouden aan de mannelijke troonopvolgers."
                            }
                        ]
                    }
