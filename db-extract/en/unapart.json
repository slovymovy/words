                        "glosses": [
                            "Not apart; together."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887ec68f-0d0c-42fe-a777-fbca66779d6c",
                                "sense_id": "12d1fd13-7bad-333a-8529-02e987c4398d",
                                "text": "As, afar, yet ever unapart, / His great heart Calls the world."
                            },
                            {
                                "example_id": "40b32fea-7dbd-4d22-9b80-44d8e19f1070",
                                "sense_id": "12d1fd13-7bad-333a-8529-02e987c4398d",
                                "text": "Parallel, unapart, — The billowy glide down from the wind's crest; At last, the nest."
                            },
                            {
                                "example_id": "49c7bc70-070c-4cb4-ac7d-221d69ab4453",
                                "sense_id": "12d1fd13-7bad-333a-8529-02e987c4398d",
                                "text": "What a part we'd have played, unapart, had we stayed. What April fools we were then!"
                            }
                        ]
                    }
