{
    "word_family": [
        "staken",
        "staker",
        "staking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c127470-9d96-37b2-a2f7-a3819656d657",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>staken</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "staken_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>staak</w> mijn werkzaamheden vandaag om aandacht te vragen voor betere arbeidsvoorwaarden.",
                            "target_lang_translations": {
                                "en": "I <w>am halting</w> my work today to draw attention to better working conditions."
                            }
                        },
                        {
                            "text": "Als de onderhandelingen mislukken, <w>staak</w> ik samen met mijn collega's vanaf morgen.",
                            "target_lang_translations": {
                                "en": "If negotiations fail, I <w>will go on strike</w> together with my colleagues starting tomorrow."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "persoonsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present indicative of 'staken': to go on strike, stop, or cease"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "stop working as a protest (first-person singular)"
                            },
                            {
                                "target_lang_word": "cease",
                                "target_lang_sense_clarification": "stop or bring to an end"
                            },
                            {
                                "target_lang_word": "halt",
                                "target_lang_sense_clarification": "stop an activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a676a2a3-5179-3f4a-9ca6-f7952edd8525",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>staken</w> bij inversie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "staken_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Staak</w> je morgen ook mee tegen de nieuwe bezuinigingen op het openbaar vervoer?",
                            "target_lang_translations": {
                                "en": "<w>Are</w> you also <w>striking</w> tomorrow against the new cuts to public transport?"
                            }
                        },
                        {
                            "text": "Waarom <w>staak</w> je het onderzoek juist nu we bijna bij een oplossing zijn?",
                            "target_lang_translations": {
                                "en": "Why <w>are you stopping</w> the investigation right now when we are close to a solution?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inversievorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present indicative of 'staken' with inversion: strike, stop, or cease"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "stop working as a protest (with subject inversion)"
                            },
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "discontinue an activity or process"
                            },
                            {
                                "target_lang_word": "cease",
                                "target_lang_sense_clarification": "bring to an end"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e6c685-f40f-304b-b78b-0e808a2eaa01",
                    "sense_definition": "gebiedende wijs van <w>staken</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "staken_vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Staak</w> het vuren onmiddellijk en trek alle troepen terug uit de bezette zone.",
                            "target_lang_translations": {
                                "en": "<w>Cease</w> fire immediately and withdraw all troops from the occupied zone."
                            }
                        },
                        {
                            "text": "<w>Staak</w> die nutteloze ruzie en laten we samen naar een oplossing zoeken.",
                            "target_lang_translations": {
                                "en": "<w>Stop</w> that pointless argument and let's look for a solution together."
                            }
                        }
                    ],
                    "common_phrases": [
                        "staak het vuren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative of 'staken': stop, cease, or halt"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cease",
                                "target_lang_sense_clarification": "stop an action immediately (command)"
                            },
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "halt or discontinue (command)"
                            },
                            {
                                "target_lang_word": "halt",
                                "target_lang_sense_clarification": "bring to a stop"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62be3b39-47b2-3b7b-a864-d898b857b9c9",
                    "sense_definition": "lange stok of paal die in de grond is gezet om planten te ondersteunen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "paal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tuinman bond de jonge bonenplanten zorgvuldig vast aan een houten <w>staak</w>.",
                            "target_lang_translations": {
                                "en": "The gardener carefully tied the young bean plants to a wooden <w>stake</w>."
                            }
                        },
                        {
                            "text": "Hij sloeg een stevige <w>staak</w> in de grond om de jonge boom tegen de wind te beschermen.",
                            "target_lang_translations": {
                                "en": "He drove a sturdy <w>stake</w> into the ground to protect the young tree from the wind."
                            }
                        }
                    ],
                    "synonyms": [
                        "stok",
                        "paal"
                    ],
                    "target_lang_definitions": {
                        "en": "a long stick, post, or pole driven into the ground to support plants"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stake",
                                "target_lang_sense_clarification": "wooden or metal post used to support plants"
                            },
                            {
                                "target_lang_word": "post",
                                "target_lang_sense_clarification": "upright piece of timber or metal"
                            },
                            {
                                "target_lang_word": "pole",
                                "target_lang_sense_clarification": "long, slender support"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c40f4f4f-316b-36c6-9cfd-4c30cd259134",
                    "sense_definition": "lang en opvallend mager persoon",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die lange <w>staak</w> stak met kop en schouders boven de rest van de menigte uit.",
                            "target_lang_translations": {
                                "en": "That tall <w>beanpole</w> stood head and shoulders above the rest of the crowd."
                            }
                        },
                        {
                            "text": "Na zijn groeispurt was hij veranderd in een magere <w>staak</w> met veel te lange benen.",
                            "target_lang_translations": {
                                "en": "After his growth spurt, he had turned into a skinny <w>beanpole</w> with far too long legs."
                            }
                        }
                    ],
                    "synonyms": [
                        "bonenstaak"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele aanduiding voor een persoon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a very tall and noticeably thin person; a beanpole"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beanpole",
                                "target_lang_sense_clarification": "tall, skinny person"
                            },
                            {
                                "target_lang_word": "lamppost",
                                "target_lang_sense_clarification": "colloquial for an exceptionally tall, thin person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fac350ad-b53c-32b8-a73e-545e252befd2",
                    "sense_definition": "verticale paal van een doel bij bepaalde balsporten",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "paal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schot van de aanvaller spatte met een doffe klap uiteen op de linker <w>staak</w>.",
                            "target_lang_translations": {
                                "en": "The attacker's shot hit the left <w>post</w> with a dull thud."
                            }
                        },
                        {
                            "text": "De bal raakte de <w>staak</w> en ketste vervolgens via de rug van de doelman het doel in.",
                            "target_lang_translations": {
                                "en": "The ball struck the <w>post</w> and then deflected off the goalkeeper's back into the net."
                            }
                        }
                    ],
                    "synonyms": [
                        "doelpaal"
                    ],
                    "target_lang_definitions": {
