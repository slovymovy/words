                        "entry_id": "36ff8eb2-97c2-357b-9f18-dc771a13d999",
                        "glosses": [
                            "Petite pince utilisée pour arracher les poils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00836378-2d05-46d6-a604-a43f4613acc9",
                                "sense_id": "412a6ddf-5278-3a2b-b7dc-adbd42686e1f",
                                "text": "La coquetterie ne date pas d'hier : on a retrouvé des épiloirs datant de l'époque préhistorique."
                            },
                            {
                                "example_id": "88ee75ff-ff6f-4181-84b6-fb9be5c509b0",
                                "sense_id": "412a6ddf-5278-3a2b-b7dc-adbd42686e1f",
                                "text": "Il suffit d’en appliquer une couche de l’épaisseur d’une ligne sur une partie couverte de poils, pour qu’en enlevant la pâle, au bout de trois minutes, à l’aide d’un épiloir en ivoire ou d’un linge, on trouve la peau sous-jancente débarrassée de poils, sans que l’épiderme soir aucunement entamé ou excorié et sans que l’individu ait éprouvé la moindre douleur."
                            }
                        ]
                    }
