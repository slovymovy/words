                ],
                "senses": [
                    {
                        "sense_id": "855e0ff4-d813-3931-b0eb-69a08caf4b4f",
                        "entry_id": "0bea9686-0818-3962-bab0-1c4de1c59d43",
                        "glosses": [
                            "iemand die veel tegenspoed te verduren heeft gehad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab818a87-7c1a-40a0-9e91-ab4ebe983dfb",
                                "sense_id": "855e0ff4-d813-3931-b0eb-69a08caf4b4f",
                                "text": "Er is al volop kritiek op de pyjamadagen. Onze rusthuisbewoners vragen hier niet om, aldus de plaatselijke welzijnsorganisatie. 'Zorgpersoneel moet opkomen voor zijn patiënten. Het zijn juist sukkelaars die in zulke rusthuizen belanden. Je moet hen er niet bij laten zitten als schooiers', stelt een geriater."
                            }
                        ]
                    },
                    {
                        "sense_id": "054cd74b-6605-3426-87e2-2f17fbc76c03",
                        "entry_id": "0bea9686-0818-3962-bab0-1c4de1c59d43",
                        "glosses": [
                            "iemand die veel domme fouten heeft gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bed6ec-44f7-4ffd-931e-5d7d3cc15298",
                                "sense_id": "054cd74b-6605-3426-87e2-2f17fbc76c03",
                                "text": "In Amsterdam is 55 miljoen zoek. Bij de gemeente. Niemand begrijpt het. Ook niet de D66-wethouder, die juist orde op zaken zou stellen. Hij is een professional, beweerde men bij zijn aantreden. Het blijkt net zo'n sukkelaar als een lange lijst voorgangers."
                            },
                            {
                                "example_id": "a9d34088-4b7c-46aa-a547-4be42e9e2edb",
                                "sense_id": "054cd74b-6605-3426-87e2-2f17fbc76c03",
                                "text": "Ik heb die persoon en alle andere “hoogdravers” teruggeschreven dat ze hun opgefokte praat hier bij mij thuis eens in mijn gezicht mogen komen aframmelen. Ik zal hen dan gepast van antwoord dienen, op mijn manier. Niemand van al die “sukkelaars” heeft na mijn wederwoord nog gepiept.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7be1fd57-ec5b-4ace-b4de-6548b69047a7",
                        "source_entry_id": "0bea9686-0818-3962-bab0-1c4de1c59d43",
                        "source_sense_id": "855e0ff4-d813-3931-b0eb-69a08caf4b4f",
                        "target_lang_word": "pauper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pauper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14a3e439-c36d-32c8-9835-9ee70f608f03",
                                        "entry_id": "d5a6c5d3-48dc-3441-a152-15f6dbffe203",
                                        "glosses": [
                                            "One who is extremely poor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b59eecc-a40b-4eab-8478-0fa52e47792a",
                                                "sense_id": "14a3e439-c36d-32c8-9835-9ee70f608f03",
                                                "text": "He has hundreds of thousands of dollars in the bank, and he lives like a pauper!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "186e0cd9-0d9f-37ed-9a2e-330e4e0fe140",
                                        "entry_id": "d5a6c5d3-48dc-3441-a152-15f6dbffe203",
                                        "glosses": [
                                            "One living on or eligible for public charity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pauper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e37c8cba-4cb1-3a0a-af18-d57991bd2d93",
                                        "entry_id": "5e5aa977-8290-331c-a02c-8af8f277d026",
                                        "glosses": [
                                            "To make a pauper of; to drive into poverty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90da3bd3-d499-4449-aee1-4c36cbaa82f0",
                                                "sense_id": "e37c8cba-4cb1-3a0a-af18-d57991bd2d93",
                                                "text": "“There's no sense in you paupering yourself because you're too stubborn to take my money.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
