                "senses": [
                    {
                        "sense_id": "65cc754b-a862-36cf-b19c-80f13caf194f",
                        "entry_id": "1e982795-6dca-3987-bfa4-9f8ac07557da",
                        "glosses": [
                            "online erreichbares, freies und offenes Lehrbuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a86161d9-0fb7-4056-a952-bf1f9b0e7ab8",
                                "sense_id": "65cc754b-a862-36cf-b19c-80f13caf194f",
                                "text": "Jeder kann ein neues Wikibook beginnen oder bei anderen mithelfen."
                            },
                            {
                                "example_id": "1871e5dc-7858-4dc0-9e27-66c57e091f2e",
                                "sense_id": "65cc754b-a862-36cf-b19c-80f13caf194f",
                                "text": "„Hinnehmen muss Ludewig allerdings, dass es bereits ein Wikibook zur Knotenkunde gibt - kostenlos im Internet.“"
                            },
                            {
                                "example_id": "3b811b08-8297-4ec8-bdb0-9b07fb5c6a0e",
                                "sense_id": "65cc754b-a862-36cf-b19c-80f13caf194f",
                                "text": "„In einem weiteren Versuch, der als Beispiel dient, wurde gemeinsam mit (Lehramts-)Studierenden an der TU Darmstadt das Projekt gestartet, ein öffentliches Wikibook zum Thema Lehren, Lernen und Bildung zu erstellen.“"
                            },
                            {
                                "example_id": "49c5e9b7-2e6c-4f00-8342-43c04b6f9156",
                                "sense_id": "65cc754b-a862-36cf-b19c-80f13caf194f",
                                "text": "„[…], wie z. B. im Falle des Wikibooks C-Programmierung, auf das unter der URL http://de.wikibooks.org/wiki/CProgrammierung zugegriffen werden kann.“"
                            },
                            {
                                "example_id": "357ed39d-451e-4792-a084-9f36d862027e",
                                "sense_id": "65cc754b-a862-36cf-b19c-80f13caf194f",
                                "text": "„Die nachfolgende Liste von ZEWS zusammen mit ihren jeweiligen Kombinationsmöglichkeiten in Zusammenhang mit Substantiven und Beispielen wurde dem Wikibook Chinesische Grammatik entnommen.“"
                            },
                            {
                                "example_id": "28fe283a-c709-42c4-a3b5-9bc1a44abcd8",
                                "sense_id": "65cc754b-a862-36cf-b19c-80f13caf194f",
                                "text": "„Darüber schrieb ich 2006 ein Wikibook „Gehirn und Sprache“ sowie ein paar Artikel bei Wikipedia (Formatio retikularis, ARAS, Ähnlichkeit in der Philosophie, Evolution der Großhirnrinde, Pyramidenzelle), alles unter dem nickname „elser“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
