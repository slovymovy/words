                    {
                        "form_id": "0475a030-b025-43dc-aa83-5d42a462a5ed",
                        "entry_id": "c23e94aa-ddbe-3fbe-9835-2b47b18a46c7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Autosemantika"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3eae698b-8db6-3882-a9cd-3cc8b68a3f5d",
                        "entry_id": "c23e94aa-ddbe-3fbe-9835-2b47b18a46c7",
                        "glosses": [
                            "Wort, das eine eigenständige, lexikalische Bedeutung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bd8f695-35de-4cd9-9075-9fd7ed82fae1",
                                "sense_id": "3eae698b-8db6-3882-a9cd-3cc8b68a3f5d",
                                "text": "„Hier stehen Vollwörter, also kompakte Autosemantika, im Mittelpunkt, deren Sinn tradierte/konventionalisierte Texterwartungen verfremdet.“"
                            },
                            {
                                "example_id": "52f100ee-d9cc-4531-b6cf-85d604452dd7",
                                "sense_id": "3eae698b-8db6-3882-a9cd-3cc8b68a3f5d",
                                "text": "Wörter mit eigenständiger, lexikalischer Bedeutung wie „Haus“, „Tier“, „Wolke“ sind Autosemantika."
                            },
                            {
                                "example_id": "78e22264-9967-4de3-b195-b1caf3b4056e",
                                "sense_id": "3eae698b-8db6-3882-a9cd-3cc8b68a3f5d",
                                "text": "Substantive, Verben, Adjektive und Adverbien sind Autosemantika."
                            },
                            {
                                "example_id": "1480c4ca-3d4b-4fca-96d6-f092e2dbe562",
                                "sense_id": "3eae698b-8db6-3882-a9cd-3cc8b68a3f5d",
                                "text": "„Autosemantika sind relativ selbständige, begriffliche Bedeutung tragende Wörter, Synsemantika besitzen keine semantische Selbständigkeit, sondern dienen der Organisation der Rede.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
