                "senses": [
                    {
                        "sense_id": "3c9bf557-71b1-3a9d-979d-0553bbec979c",
                        "entry_id": "3deab88a-f02f-39fc-9733-33faef1277f2",
                        "glosses": [
                            "комп. жарг. клавиатурная клавиша (Caps Lock), включающая постоянный режим печати прописными буквами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd959e94-4e2c-42f5-85db-ef37e494269b",
                                "sense_id": "3c9bf557-71b1-3a9d-979d-0553bbec979c",
                                "text": "А у кого-то, кажется, запал капс."
                            },
                            {
                                "example_id": "54c2f58b-273e-4735-b1ad-7513895ee30a",
                                "sense_id": "3c9bf557-71b1-3a9d-979d-0553bbec979c",
                                "text": "На днях почистил клавиатуру, неожиданно для себя обнаружил в ней таракана, обезглавленного клавишей капса."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c0f2748-98ee-3e30-bda1-53d2891da354",
                        "entry_id": "3deab88a-f02f-39fc-9733-33faef1277f2",
                        "glosses": [
                            "интернет. режим ввода текста прописными буквами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5bb7f3b-3ead-433f-81b1-7f3041e8cd7f",
                                "sense_id": "9c0f2748-98ee-3e30-bda1-53d2891da354",
                                "text": "Не злоупотребляйте «капсом». Текст, написанный прописными буквами, — неудобочитаем и воспринимается читателем как КРИЧАЩИЙ."
                            },
                            {
                                "example_id": "d1677a07-0433-4f68-b330-e7479421f76f",
                                "sense_id": "9c0f2748-98ee-3e30-bda1-53d2891da354",
                                "text": "Ты пишешь с капсом и диким количеством восклицательных знаков."
                            }
                        ]
                    }
                ],
