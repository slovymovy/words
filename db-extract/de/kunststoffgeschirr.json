                ],
                "senses": [
                    {
                        "sense_id": "2e7ca1cc-e4f6-3808-ae3d-3f56e2e4dd4f",
                        "entry_id": "0f71e41b-6846-32e1-8e69-b8920955b84b",
                        "glosses": [
                            "aus Plastik/Kunststoff bestehendes Geschirr"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "534d99ac-1297-4892-b827-2d0b51f09936",
                                "sense_id": "2e7ca1cc-e4f6-3808-ae3d-3f56e2e4dd4f",
                                "text": "„Mehrstoffkocher, Titantöpfe und Kunststoffgeschirr sind unverwüstliche Begleiter auf Reisen in die entlegensten Gebiete der Welt.“"
                            },
                            {
                                "example_id": "16d6c77c-9641-41d5-9cfd-063e18b20a28",
                                "sense_id": "2e7ca1cc-e4f6-3808-ae3d-3f56e2e4dd4f",
                                "text": "„Hester packte gerade das Kunststoffgeschirr aus, das wir an den Strand mitgenommen hatten.“"
                            },
                            {
                                "example_id": "17bc84a1-680b-4c53-886f-981578ae0819",
                                "sense_id": "2e7ca1cc-e4f6-3808-ae3d-3f56e2e4dd4f",
                                "text": "„Kunststoffgeschirr zum Wegwerfen und Plastikbesteck sind schon aus ökologischer Sicht out.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
