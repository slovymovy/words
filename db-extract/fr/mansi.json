                "entry_id": "37809ebd-2afc-3668-a8f6-1b32992fafde",
                "word": "Mansi",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "139afb81-09d5-38a8-92c3-8e7da4c6bcd4",
                        "entry_id": "37809ebd-2afc-3668-a8f6-1b32992fafde",
                        "glosses": [
                            "Giovanni Domenico Mansi, théologien et historien italien du XVIIIᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96609149-8e45-4f2c-a9fb-a8c95f854573",
                                "sense_id": "139afb81-09d5-38a8-92c3-8e7da4c6bcd4",
                                "text": "Je me suis attaché premièrement au témoignage impartial et oculaire du cardinal de Saint-Georges, ensuite au jugement des historiens les plus désintéressés et les plus graves, tels que Mansi et Dœllinger. Mansi me parait avoir caractérisé Boniface VIII avec une équité parfaite."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7129abc2-dd73-358e-aad3-8005035ac013",
                "word": "Mansi",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e0330ec2-fc8c-3b46-a2fe-c6383b2eb78f",
                        "entry_id": "7129abc2-dd73-358e-aad3-8005035ac013",
                        "glosses": [
                            "Nom de famille d’origine italienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d7d1993-6a10-497f-9333-44ff20d674f8",
                                "sense_id": "e0330ec2-fc8c-3b46-a2fe-c6383b2eb78f",
                                "text": "L’histoire de Lucques est celle d’une cité laborieuse de marchands qui pendant des siècles a vendu ses précieuses étoffes sur les principaux marchés européens. Parmi eux, la famille Mansi, nouveaux riches du XVIIᵉ siècle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "039bf08a-0905-3456-88e8-c564680e59b5",
                "word": "mansi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2c416232-4cad-3a96-b204-a11652c778db",
                        "entry_id": "039bf08a-0905-3456-88e8-c564680e59b5",
                        "glosses": [
                            "Langue ougrienne parlée par les Mansis, un peuple du Nord-Ouest de la Sibérie, installé principalement au bord des rivières Sosva et Konda et de leurs affluents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28590eb7-0e8e-4143-896c-d743a124e6ce",
                                "sense_id": "2c416232-4cad-3a96-b204-a11652c778db",
                                "text": "La littérature en mansi produite au cours des soixante ou quatre-vingts dernières années pourrait tenir en un seul volume pas très épais ; en revanche, en langue russe, elle est étonnamment riche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02b67ded-c6f2-4b81-8aae-2d32e5d4ca0e",
                        "source_entry_id": "039bf08a-0905-3456-88e8-c564680e59b5",
                        "source_sense_id": "2c416232-4cad-3a96-b204-a11652c778db",
