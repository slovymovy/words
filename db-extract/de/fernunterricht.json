                "senses": [
                    {
                        "sense_id": "6e2be637-4efa-3bf9-b528-03f514363aa6",
                        "entry_id": "370e100c-5838-338d-84aa-d5301ae530e4",
                        "glosses": [
                            "Durchführung des Unterrichts in räumlicher Distanz zwischen Lehrern und Schülern mit technischen Kommunikationsmitteln, wobei der Lernerfolg überwacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad00cf1d-65fb-4e31-8132-704cd39e1169",
                                "sense_id": "6e2be637-4efa-3bf9-b528-03f514363aa6",
                                "text": "Wie alle Berliner Schulen mussten auch wir uns im Frühjahr 2020 abrupt auf Fernunterricht einstellen."
                            },
                            {
                                "example_id": "b13f4fe5-71ef-483c-9dfe-c147993a5bed",
                                "sense_id": "6e2be637-4efa-3bf9-b528-03f514363aa6",
                                "text": "Wir lassen Sie im Fernunterricht nicht allein!"
                            },
                            {
                                "example_id": "a748c8f0-d86c-4b7d-b0cf-4cb7e451d4f9",
                                "sense_id": "6e2be637-4efa-3bf9-b528-03f514363aa6",
                                "text": "In einer separaten Liste werden die Materialien aufgeführt, die sich besonders für den Fernunterricht eignen."
                            },
                            {
                                "example_id": "c2cf1ec0-9acb-44fa-a04b-5cf8562ec384",
                                "sense_id": "6e2be637-4efa-3bf9-b528-03f514363aa6",
                                "text": "Die zur Verfügung gestellten Fragebögen sollen Schulleiter/innen und Lehrpersonen dabei unterstützen, Feedback zu Fernunterricht auf unkomplizierten und sicheren Wegen einzuholen."
                            },
                            {
                                "example_id": "bd98b0e2-e78f-4048-a876-1b1dfdbf73c8",
                                "sense_id": "6e2be637-4efa-3bf9-b528-03f514363aa6",
                                "text": "Ein wichtiger Bestandteil des Fernunterrichts ist die Lenkung und Betreuung des Teilnehmers am Lehrgang durch Korrektoren, Fernlehrer und Studienleiter, wodurch eine ständige Kontrolle des Lernfortschrittes gesichert wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
