                    "frequency": "Low",
                    "semantic_group_id": "wealth_and_luxury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opera house was famous for its <w>opulent</w> interior and grand marble staircases.",
                            "target_lang_translations": {
                                "ru": "Оперный театр славился своим <w>пышным</w> интерьером и величественными мраморными лестницами."
                            }
                        },
                        {
                            "text": "He lived in an <w>opulent</w> mansion that overlooked the entire valley.",
                            "target_lang_translations": {
