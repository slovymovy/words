    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78e94227-caf3-3843-a460-43e8f2a34de7",
                    "sense_definition": "to, do czego się dąży i co zamierza się osiągnąć",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dążyć",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moim głównym <w>celem</w> na ten rok jest nauka języka obcego.",
                            "target_lang_translations": {
                                "ru": "Моей главной <w>целью</w> на этот год является изучение иностранного языка."
                            }
                        },
                        {
                            "text": "Musimy jasno określić nasze <w>cele</w>, aby zrealizować ten projekt na czas.",
                            "target_lang_translations": {
                                "ru": "Мы должны чётко определить наши <w>цели</w>, чтобы реализовать этот проект вовремя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "osiągnąć cel",
                        "cel podróży"
                    ],
                    "target_lang_definitions": {
                        "ru": "то, к чему стремятся и чего намереваются достичь"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "жизненная, осознанное стремление или намерение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30cc328c-5f47-3c92-973e-1fd948740b07",
                    "sense_definition": "obiekt, w który mierzy się z broni lub który chce się trafić",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tarcza",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Żołnierz wycelował broń i bez trudu trafił w wyznaczony <w>cel</w>.",
                            "target_lang_translations": {
                                "ru": "Солдат прицелился и без труда попал в назначенную <w>цель</w>."
                            }
                        },
                        {
                            "text": "Strzelec uważnie obserwował ruchomy <w>cel</w> na strzelnicy.",
                            "target_lang_translations": {
                                "ru": "Стрелок внимательно наблюдал за движущейся <w>мишенью</w> на стрельбище."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruchomy cel",
                        "trafić w cel"
                    ],
                    "target_lang_definitions": {
                        "ru": "объект, в который целятся из оружия или в который хотят попасть"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "объект для поражения при стрельбе"
                            },
                            {
                                "target_lang_word": "мишень",
                                "target_lang_sense_clarification": "предмет для учебной или спортивной стрельбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23df7717-9e2c-39cf-b0b9-c0d0ead51db3",
                    "sense_definition": "osoba lub rzecz będąca przedmiotem czyichś działań, zainteresowania lub ataku",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obiekt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młody polityk szybko stał się <w>celem</w> ostrych ataków ze strony mediów.",
                            "target_lang_translations": {
                                "ru": "Молодой политик быстро стал <w>мишенью</w> для резких нападок со стороны СМИ."
                            }
