                                    {
                                        "sense_id": "05cf1449-9793-365b-825f-235e278f07d0",
                                        "entry_id": "f15d5117-5f81-34c7-9066-1ab73a1fd4e4",
                                        "glosses": [
                                            "Suzhou, a city in southern Jiangsu province in China, whence:",
                                            "A commandery of imperial China around Suzhou."
                                        ],
                                        "tags": [
