                    "frequency": "Low",
                    "semantic_group_id": "elektronik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Anschließen des Kabels hat sich leider ein empfindlicher <w>Pin</w> verbogen."
                        },
                        {
                            "text": "Dieser Mikrochip besitzt insgesamt zweiunddreißig kleine <w>Pins</w> zur Signalübertragung."
