                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed076e3d-d9af-32e7-9e64-88c37d20b6b1",
                        "entry_id": "0f90ae20-a502-3c8f-b124-b12cd02b8dfa",
                        "glosses": [
                            "проводя чем-либо мягким по поверхности, удалить с неё пыль, грязь или жидкость, сделать более сухой и чистой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485f66aa-df4d-48a3-8cc7-da957ddd74bb",
                                "sense_id": "ed076e3d-d9af-32e7-9e64-88c37d20b6b1",
                                "text": "Вытереть стол мокрой тряпкой."
                            },
                            {
                                "example_id": "c9bc2bd5-e1df-4f9d-a135-d83b3ff88d78",
                                "sense_id": "ed076e3d-d9af-32e7-9e64-88c37d20b6b1",
                                "text": "Вытереть книжную полку."
                            }
                        ]
                    },
                    {
                        "sense_id": "b27d2d45-d18a-3253-87ac-ebb15fbabfc5",
                        "entry_id": "0f90ae20-a502-3c8f-b124-b12cd02b8dfa",
                        "glosses": [
                            "перен., редк. износить, сделать потёртым"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9a304aa-3532-4d1a-87b6-80317d2faba4",
                        "source_entry_id": "0f90ae20-a502-3c8f-b124-b12cd02b8dfa",
                        "target_lang_word": "effacer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effacer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "067e0f56-cda5-3b39-b7be-beec4afb84a9",
                                        "entry_id": "4332be3f-6fe5-3562-8d31-12feca9e3e93",
                                        "glosses": [
                                            "Faire disparaître plus ou moins, en parlant de la forme, des couleurs de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89756189-738c-4542-b4e9-886698b79640",
                                                "sense_id": "067e0f56-cda5-3b39-b7be-beec4afb84a9",
                                                "text": "Insensiblement la sombre humeur qu’on voyait sur leurs traits s’atténuait, s’effaçait. De menaçants, ils devenaient gouailleurs, puis doucereux, entreprenants."
                                            },
                                            {
                                                "example_id": "65f89bc9-27f0-45a7-8f88-d24c89c9afe9",
                                                "sense_id": "067e0f56-cda5-3b39-b7be-beec4afb84a9",
                                                "text": "Le temps a effacé les traits et les couleurs de ce tableau. Effacer l’empreinte d’une médaille, ou, simplement, Effacer une médaille."
                                            },
                                            {
                                                "example_id": "862d248a-cf9c-4e9e-87af-e5f5033d7563",
                                                "sense_id": "067e0f56-cda5-3b39-b7be-beec4afb84a9",
                                                "text": "Ses dernières actions ont effacé les taches de sa vie passée."
                                            },
                                            {
                                                "example_id": "a35e1e91-a69d-4e8f-b818-c36b616d77d9",
                                                "sense_id": "067e0f56-cda5-3b39-b7be-beec4afb84a9",
                                                "text": "Dans l’Ukraine occupée, l’éducation est devenue un instrument essentiel de la guerre. D’abord, effacer l’identité ukrainienne, en remplaçant les enseignants et en interdisant de parler l’ukrainien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64858351-b4ba-3eca-8d88-1d1a1db199c4",
                                        "entry_id": "4332be3f-6fe5-3562-8d31-12feca9e3e93",
                                        "glosses": [
                                            "Annuler."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e274fa60-66bf-476b-832f-97964f81ca7a",
                                                "sense_id": "64858351-b4ba-3eca-8d88-1d1a1db199c4",
                                                "text": "Voila deux chiffres qui vont faire mentir les Cassandre : après les 332 100 emplois détruits en 2020, 330 800 emplois ont été créés sur le premier semestre 2021 en France. Autrement dit, l’effet de la crise liée au Covid-19 sur l’emploi salarié est d’ores et déjà effacé, selon les estimations provisoires publiées vendredi 6 août par l’Institut national de la statistique et des études économiques (Insee)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f25ff9-f2d1-3983-ad2e-ac268417af38",
                                        "entry_id": "4332be3f-6fe5-3562-8d31-12feca9e3e93",
                                        "glosses": [
                                            "Surpasser, éclipser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4af07f59-b57b-47b7-b5d3-9bdddefcf000",
                                                "sense_id": "39f25ff9-f2d1-3983-ad2e-ac268417af38",
                                                "text": "Cet homme a effacé la gloire de ses ancêtres, il a effacé tous ceux qui l’ont précédé. Dans ce bal, elle effaçait par sa beauté toutes les autres femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd47908-1a49-3d55-a408-4334e5819e17",
                                        "entry_id": "4332be3f-6fe5-3562-8d31-12feca9e3e93",
                                        "glosses": [
                                            "Pardonner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c31c98c8-e92e-46bb-9952-d02dd92aa966",
                                                "sense_id": "bfd47908-1a49-3d55-a408-4334e5819e17",
                                                "text": "Que sont devenus les casuistes ? Gens simples, qui prenaient les péchés un à un, et par grand effort, effaçait celui-ci, puis celui-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "503e0e95-8954-3e33-ae95-67462c381e72",
                                        "entry_id": "4332be3f-6fe5-3562-8d31-12feca9e3e93",
                                        "glosses": [
                                            "S’écarter pour laisser passer quelqu’un ou pour lui laisser l'avantage."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0031123b-dbca-4104-9d20-c5c8fde8218b",
                                                "sense_id": "503e0e95-8954-3e33-ae95-67462c381e72",
                                                "text": "La star internationale, hyperglamour sur les marches du Palais — le 20 mai, aux côtés des deux cinéastes belges et de Fabrizio Rongione — peut-elle encore s’effacer au profit de son personnage ?"
                                            },
                                            {
                                                "example_id": "d0fdd57d-6a15-4087-8d0b-af5a0abf21e5",
                                                "sense_id": "503e0e95-8954-3e33-ae95-67462c381e72",
                                                "text": "Il s’effaçait pour faire briller son ami"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "477cca0b-38e8-4ea3-8544-9e1eff750ea8",
                        "source_entry_id": "0f90ae20-a502-3c8f-b124-b12cd02b8dfa",
                        "target_lang_word": "essuyer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essuyer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee55368c-f4a9-3d62-a6a3-36b0e0abbd59",
                                        "entry_id": "3119bcb6-d5ff-3f8c-bd8a-0212a2ef30d0",
                                        "glosses": [
                                            "Sécher en frottant, par exemple avec un objet absorbant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddab37f7-981c-470b-a629-7b28ce80e75b",
                                                "sense_id": "ee55368c-f4a9-3d62-a6a3-36b0e0abbd59",
                                                "text": "Elle s’est éclipsée ; elle est revenue, tiède et savonneuse ; puis, toute fraîche, la figure rosissante, essuyant des gouttelettes d’eau."
                                            },
                                            {
                                                "example_id": "30de5f38-617c-49fb-a760-16e34153910d",
                                                "sense_id": "ee55368c-f4a9-3d62-a6a3-36b0e0abbd59",
                                                "text": "Des larmes lui coulaient bien tranquillement sur les joues, sans qu’il pensât à les essuyer."
                                            },
                                            {
                                                "example_id": "5a927dc7-be7b-4e22-a8bc-3bef2023ea1d",
                                                "sense_id": "ee55368c-f4a9-3d62-a6a3-36b0e0abbd59",
                                                "text": "Au fond de la pièce, le barman mélomane refait le plein de son distributeur de cacahuètes et essuie une dernière fois le comptoir, après avoir ravitaillé le présentoir d’œufs durs."
                                            },
                                            {
                                                "example_id": "a137504b-2204-472c-b18b-fe01d3171a94",
                                                "sense_id": "ee55368c-f4a9-3d62-a6a3-36b0e0abbd59",
                                                "text": "Oui, comment quelqu’un a-t-il pu entrer ici et en ressortir, répéta le vieil humme en s’essuyant le front du revers de sa manche."
                                            },
                                            {
                                                "example_id": "c20bfc30-d8b2-45bd-a6d7-0fa29d715029",
                                                "sense_id": "ee55368c-f4a9-3d62-a6a3-36b0e0abbd59",
                                                "text": "J'essayais de me frayer un passage entre les faroteurs qui se trémoussaient en s’essuyant le front avec des billets de dix mille francs CFA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7910638c-7f37-3fa1-8cd7-d3dd13ee499d",
                                        "entry_id": "3119bcb6-d5ff-3f8c-bd8a-0212a2ef30d0",
                                        "glosses": [
                                            "Sécher en parlant du vent, du soleil, etc."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c209bcd-832c-4505-aa52-672419e54133",
                                                "sense_id": "7910638c-7f37-3fa1-8cd7-d3dd13ee499d",
                                                "text": "Le vent, le soleil essuie les chemins, essuie la terre qui a été trempée par la pluie. ^([1])"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee3d526-6ead-3699-98fd-7da35d845bbc",
                                        "entry_id": "3119bcb6-d5ff-3f8c-bd8a-0212a2ef30d0",
                                        "glosses": [
                                            "Enlever la poussière ou la saleté en frottant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c8a3f9b-98a9-443a-9bb7-f5424670ec76",
                                                "sense_id": "cee3d526-6ead-3699-98fd-7da35d845bbc",
                                                "text": "Le cabaretier, très digne, essuya le marbre d'un coup de torchon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                        "entry_id": "3119bcb6-d5ff-3f8c-bd8a-0212a2ef30d0",
                                        "glosses": [
                                            "Devoir supporter, éprouver, subir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08bee7fa-5500-484a-82f2-cd6075e233a6",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "Puisque j'ai essuyé, dit-il, un si cruel caprice d'une fille élevée à la cour, il faut que j'épouse une citoyenne."
                                            },
                                            {
                                                "example_id": "12203f39-ff20-4f61-9789-9ecc306167b6",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "On sait qu'il a essuyé bien d'autres aventures qui ont été fidèlement écrites."
                                            },
                                            {
                                                "example_id": "bfc87c81-89f3-4e1d-b2b8-44451cd1fe48",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "Nous essuyâmes un grain de quelques heures qui me donna une idée d’une tempête sur mer."
                                            },
                                            {
                                                "example_id": "668728b0-3fe0-4042-8590-7ab1fcb7a046",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "À bien prendre les choses, la gloire des vaincus égale celle des vainqueurs, et elle est plus touchante. Il convient, pour rendre un désastre admirable, de célébrer le général et l’armée qui l’ont essuyé, et de publier ces beaux épisodes qui assurent la supériorité morale de l’infortune."
                                            },
                                            {
                                                "example_id": "d04378fe-db7a-4a45-85d7-59cae4746393",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "Pour mille fois moins que cela j'avais essuyé ses colères de fou, personne n'était à l'abri d'elles, un roi ne l'eût pas intimidé."
                                            },
                                            {
                                                "example_id": "31acabad-1f2f-4dd8-9616-d614f78a63c3",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "Essuyer le feu nourri de l’adversaire."
                                            },
                                            {
                                                "example_id": "502e3c9c-09c2-487a-8de8-0a1a0fe1ddbf",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "Essuyer de lourdes pertes."
                                            },
                                            {
                                                "example_id": "15f5725e-d472-4c21-a724-65af52e147d5",
                                                "sense_id": "d0cf18e6-2978-3857-96e9-1cbbc43813ec",
                                                "text": "Essuyer des affronts, des outrages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
