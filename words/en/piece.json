    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db7bf0d6-6a67-3705-afe4-a1af19892a67",
                    "sense_definition": "A part of a larger whole, usually in such a form that it is able to be separated from other parts.",
