                        "glosses": [
                            "гражданин, житель или уроженец Мали"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9b193a-4710-42bc-b09d-e24c85af2771",
                                "sense_id": "fbc9fca6-4f76-316d-95bc-e89d69b567ed",
                                "text": "19 ноября 2021 года президент «Велеса» Евгений Шиленков сообщил «Матч ТВ», что малиец Майга получил российское гражданство."
                            }
                        ]
                    }
                ],
