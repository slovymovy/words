                        ],
                        "form": "строе́ниях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4b080a5-9fe5-3ce2-bec1-5502274bbc4a",
                        "entry_id": "de8b00c6-0230-3dc5-ae49-ca39af8957b4",
                        "glosses": [
                            "искусственная надземная неподвижная структура, имеющая внутренний объём; результат строительства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9491ed0-7abd-459b-a60c-ac05683846e4",
                                "sense_id": "f4b080a5-9fe5-3ce2-bec1-5502274bbc4a",
                                "text": "Непонятное строение на полуострове."
                            },
                            {
                                "example_id": "eedfce50-45f7-47b5-8ccb-4fc431c30e05",
                                "sense_id": "f4b080a5-9fe5-3ce2-bec1-5502274bbc4a",
                                "text": "Не присваиваются адреса временным строениям и сооружениям."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd36e298-3967-3216-8a2a-10480193079b",
                        "entry_id": "de8b00c6-0230-3dc5-ae49-ca39af8957b4",
                        "glosses": [
                            "устройство, детали структуры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "730af6bf-80b9-4f96-b53f-5497a62ceed4",
                                "sense_id": "fd36e298-3967-3216-8a2a-10480193079b",
                                "text": "Мы предсказываем строение блок-сополимера и рассчитываем, какой должна быть скорость реакции, чтобы смесь не успела расслоиться."
                            },
                            {
                                "example_id": "43a9b3bd-05f9-49bf-9921-7471751b3527",
                                "sense_id": "fd36e298-3967-3216-8a2a-10480193079b",
                                "text": "Строение атома"
                            }
                        ]
                    },
                    {
                        "sense_id": "66bd3df9-cd66-3d8e-ba30-93e07de3798b",
                        "entry_id": "de8b00c6-0230-3dc5-ae49-ca39af8957b4",
                        "glosses": [
                            "структура, устройство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8501c48-e21c-4241-bea9-2935e235612b",
                                "sense_id": "66bd3df9-cd66-3d8e-ba30-93e07de3798b",
                                "text": "В ходе многолетних разведочных работ были детализированы морфология, состав и строение залежей."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbe4e785-3dbe-3682-af35-a095b5e85977",
                        "entry_id": "de8b00c6-0230-3dc5-ae49-ca39af8957b4",
                        "glosses": [
                            "структура, организация"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9657a715-4463-4468-8ad9-cb621407506e",
                                "sense_id": "cbe4e785-3dbe-3682-af35-a095b5e85977",
                                "text": "Но и в недрах собственно исследовательской работы психологов наверняка есть обстоятельства (находки, открытия, новые подходы), которые тоже, как можно ожидать, изменят строение нашей науки в будущем."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "868da615-53e6-4d8b-9d04-5f8459edbdda",
