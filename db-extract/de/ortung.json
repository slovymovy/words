                                    },
                                    {
                                        "sense_id": "828d8f3d-0f0c-39d4-a705-8cf3da513a3d",
                                        "entry_id": "a288b448-4b74-305a-bad5-4db0a325f77d",
                                        "glosses": [
                                            "A systematic method of adding multiplicative inverses to a ring."
                                        ],
                                        "tags": [
