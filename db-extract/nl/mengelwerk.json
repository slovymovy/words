                    {
                        "sense_id": "9ce32b66-12c0-3b3c-b8f9-24ad88b938cf",
                        "entry_id": "ba532ef1-43c8-3491-a7b6-aafe88287bc4",
                        "glosses": [
                            "drukwerk dat bestaat uit een verzameling heel diverse teksten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1244cea-0ff2-4046-83f1-dd3e98e94f9d",
                                "sense_id": "9ce32b66-12c0-3b3c-b8f9-24ad88b938cf",
                                "text": "Het is een bekend gezegde dat sommigen hoogleraar worden vanwege hun kennis, anderen door hun kennissen. Voor dr. Oepke Noordmans (1903-1944) gold het een noch het ander. Kennis en kennissen bezat hij genoeg, maar het hoogleraarschap kwam niet. Inmiddels verscheen het laatste deel van Noordmans’ verzameld werk. Het bevat mengelwerk, ofwel overgeschoten brokskens."
                            },
                            {
                                "example_id": "d6da7c71-f96e-4458-8cc6-0b55cf26bc91",
                                "sense_id": "9ce32b66-12c0-3b3c-b8f9-24ad88b938cf",
                                "text": "De Gids wordt opgericht door Potgieter en Robidé van der Aa. Aanvankelijk bestaat de inhoud van De Gids deels uit boekbesprekingen en deels uit \"mengelwerk\", zoals gebruikelijk in die tijd, maar het tijdschrift krijgt na een tiental jaren een meer algemeen cultureel, liberaal politiek karakter."
                            }
                        ]
                    }
