                {
                    "sense_id": "fc1c9f69-52b0-3419-a9c1-b0e6aaadb195",
                    "sense_definition": "Явным, ощутимым образом; так, что это можно увидеть или заметить.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_perceptible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За последнее время он <w>заметно</w> похудел.",
                            "target_lang_translations": {
                                "en": "He has lost weight <w>noticeably</w> recently.",
                                "de": "In letzter Zeit hat er <w>merklich</w> abgenommen.",
                                "nl": "Hij is de laatste tijd <w>merkbaar</w> afgevallen.",
                                "pl": "Ostatnio <w>wyraźnie</w> schudł.",
                                "fr": "Il a <w>nettement</w> maigri ces derniers temps.",
                                "it": "Ultimamente è <w>notevolmente</w> dimagrito.",
                                "cs": "V poslední době <w>znatelně</w> zhubl.",
                                "tr": "Son zamanlarda <w>gözle görülür biçimde</w> zayıfladı.",
                                "es": "Últimamente ha adelgazado <w>notablemente</w>.",
                                "zh": "他最近<w>明显</w>瘦了。"
                            }
                        },
                        {
                            "text": "Качество нашей работы <w>заметно</w> улучшилось за этот год.",
                            "target_lang_translations": {
                                "en": "The quality of our work has improved <w>significantly</w> this year.",
                                "de": "Die Qualität unserer Arbeit hat sich in diesem Jahr <w>deutlich</w> verbessert.",
                                "nl": "De kwaliteit van ons werk is dit jaar <w>aanzienlijk</w> verbeterd.",
                                "pl": "Jakość naszej pracy <w>znacznie</w> poprawiła się w tym roku.",
                                "fr": "La qualité de notre travail s'est <w>sensiblement</w> améliorée cette année.",
                                "it": "La qualità del nostro lavoro è <w>visibilmente</w> migliorata quest'anno.",
                                "cs": "Kvalita naší práce se za tento rok <w>výrazně</w> zlepšila.",
                                "tr": "İşimizin kalitesi bu yıl <w>önemli ölçüde</w> arttı.",
                                "es": "La calidad de nuestro trabajo ha mejorado <w>significativamente</w> este año.",
                                "zh": "今年我们工作的质量<w>显著</w>提高了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "явно",
                        "ощутимо",
                        "значительно",
                        "существенно"
                    ],
                    "antonyms": [
                        "незаметно"
                    ],
                    "common_phrases": [
                        "заметно лучше",
                        "заметно отличаться",
                        "заметно измениться",
                        "стало заметно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is easy to see, notice, or feel; to a significant degree.",
                        "de": "In einer Weise, die leicht zu sehen, zu bemerken oder zu spüren ist; in erheblichem Maße.",
                        "nl": "Op een manier die gemakkelijk te zien, op te merken of te voelen is; in aanzienlijke mate.",
                        "pl": "W sposób wyraźny, odczuwalny; tak, że można to łatwo dostrzec lub zauważyć.",
                        "fr": "De manière évidente, perceptible ou significative; de façon à ce que cela puisse être vu ou remarqué.",
                        "it": "In modo chiaro, percepibile o significativo; in modo tale da poter essere visto o notato.",
                        "cs": "Způsobem, který je snadno viditelný, vnímatelný nebo znatelný; v podstatné míře.",
                        "tr": "Açık, hissedilir bir şekilde; görülebilecek veya fark edilebilecek derecede.",
                        "es": "De una manera clara, perceptible o significativa; de tal forma que se puede ver o notar fácilmente.",
                        "zh": "以明显、可感知的方式；达到显著的程度。"
                    },
