                "senses": [
                    {
                        "sense_id": "69fc0369-a2c9-3b27-bea1-8c6ee55733ad",
                        "entry_id": "4e13ba8c-df20-3830-8620-7565f84b2ab4",
                        "glosses": [
                            "solowa melorecytacja w antycznym dramacie greckim, w szczególności monolog o charakterze lamentacyjnym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "eed66ad4-eb2d-35c9-bb0c-d636a52f2786",
                        "entry_id": "4e13ba8c-df20-3830-8620-7565f84b2ab4",
                        "glosses": [
                            "gatunek muzyczny wyróżniający się jednolitą linią melodyczną i takimż akompaniamentem"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28e61719-6b69-4d8e-9ac3-e8c39396241c",
                        "source_entry_id": "4e13ba8c-df20-3830-8620-7565f84b2ab4",
                        "source_sense_id": "69fc0369-a2c9-3b27-bea1-8c6ee55733ad",
                        "target_lang_word": "monody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e4c482-e520-3929-8843-9fc84458dd13",
                                        "entry_id": "be3a1233-7641-3215-937f-b64c4e51ca47",
                                        "glosses": [
                                            "An ode, as in Greek drama, for a single voice, often specifically a mournful song or dirge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c961e5e7-36ad-3887-baf2-4f840150a4cf",
                                        "entry_id": "be3a1233-7641-3215-937f-b64c4e51ca47",
                                        "glosses": [
                                            "Any poem mourning the death of someone; an elegy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af4922e7-1a36-3762-b72b-215d961ef288",
                                        "entry_id": "be3a1233-7641-3215-937f-b64c4e51ca47",
                                        "glosses": [
                                            "A monotonous or mournful noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9923e0cc-d1e2-4f09-ab46-dad07e7bcb97",
                                                "sense_id": "af4922e7-1a36-3762-b72b-215d961ef288",
                                                "text": "Stroke by stroke, the great familiar monody of that incomparable curfew rose and fell in the stillness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9621556-3e63-3073-8e51-35b6d9b7de14",
                                        "entry_id": "be3a1233-7641-3215-937f-b64c4e51ca47",
                                        "glosses": [
                                            "A composition having a single melodic line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c7f841e-ee36-435d-b84f-4bed045231de",
                                                "sense_id": "b9621556-3e63-3073-8e51-35b6d9b7de14",
                                                "text": "All directions in life were blocked to him. He could not think, he could not sleep, his heart thudded to a deadening monody of fear. Fear that is itself the penalty of all things feared."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42fb4e35-b0b5-47ee-9b93-181ee5fa159a",
                        "source_entry_id": "4e13ba8c-df20-3830-8620-7565f84b2ab4",
                        "source_sense_id": "69fc0369-a2c9-3b27-bea1-8c6ee55733ad",
                        "target_lang_word": "monodie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6013bba4-ecdb-4fc0-8289-973279517fce",
                        "source_entry_id": "4e13ba8c-df20-3830-8620-7565f84b2ab4",
                        "source_sense_id": "69fc0369-a2c9-3b27-bea1-8c6ee55733ad",
                        "target_lang_word": "monodie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monodie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd8d4c7d-8f86-36cc-89f9-da6bc6f2135d",
                                        "entry_id": "84af0472-f4be-3f16-be24-945c73939a08",
                                        "glosses": [
                                            "Structure musicale dont les différentes parties — instrumentales ou vocales — sont constamment séparées par un intervalle d’unisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1498181-4ff4-4b0e-8c94-09dc0fa40a8f",
                                                "sense_id": "fd8d4c7d-8f86-36cc-89f9-da6bc6f2135d",
                                                "text": "Le plain-chant, le chant ambrosien et le chant byzantin utilisent la monodie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e0ada5-d6b6-3caf-9cab-fa5b3abdc86a",
                                        "entry_id": "84af0472-f4be-3f16-be24-945c73939a08",
                                        "glosses": [
                                            "Chant à une seule voix et sans accompagnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e926c7b5-b607-4428-8bdc-e029f2550e10",
                                                "sense_id": "14e0ada5-d6b6-3caf-9cab-fa5b3abdc86a",
                                                "text": "Chose remarquable ! jusqu’à la fin du XVIᵉ siècle, l’individualité humaine n’a pas eu son expression dans la musique. La monodie grecque était chorale. La monodie liturgique était […] tout à fait impersonnelle d’expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46371f9e-8f6a-39f1-a2e1-7cf2a17fa8ac",
                                        "entry_id": "84af0472-f4be-3f16-be24-945c73939a08",
                                        "glosses": [
                                            "Procédé d’écriture musicale combinant et opposant, d’une part, une partie principale réalisant la mélodie, et d’autre part, un accompagnement de cette première partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf91d6d-bc84-4341-a0fa-ce3e1d153fcb",
                                                "sense_id": "46371f9e-8f6a-39f1-a2e1-7cf2a17fa8ac",
                                                "text": "La monodie est une mélodie accompagnée d’accords."
                                            },
                                            {
                                                "example_id": "7d7da5a2-cbe9-4551-bbbe-4d8d80a8478d",
                                                "sense_id": "46371f9e-8f6a-39f1-a2e1-7cf2a17fa8ac",
                                                "text": "Egon, qui possède en plus les sept notes de la gamme, songe tout haut que ce livre en partie grotesque pourrait servir de trame à une discordante musique, bête et grossière comme la vie, avec çà et là des bouffées de joie et des rayons de soleil, et s’achever non pas en un chœur exultant ou suppliant, mais en monodie pure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e116600b-b2ec-4fbd-a2ba-1b85092d41b8",
