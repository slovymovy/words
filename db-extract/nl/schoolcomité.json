                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ec3c8c-6331-4a2f-8744-53453cef7279",
                                "sense_id": "e414aade-1c2a-351a-8591-a0e3fa56be38",
                                "text": "Sinds haar ontstaan in 1942 groeide het Centraal Katholiek Schoolcomité van Antwerpen uit tot een efficiënt en effectief schoolbestuur. Vanuit het Algemeen Secretariaat in de Otto Veniusstraat ondersteunen de bestuurders en beleidsondersteuners hun scholen. Uitgaande van een christelijke inspiratie bouwt CKSA onderwijs en zorg uit voor 33 onderwijsinstellingen, ongeveer 8000 kinderen en jongeren en meer dan 1400 personeelsleden."
                            }
