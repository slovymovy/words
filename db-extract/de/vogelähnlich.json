                        "glosses": [
                            "einem Vogel ähnelnd, wie ein Vogel aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a43cb19d-a4f3-430c-8f86-06d2765575f6",
                                "sense_id": "8a78ebe1-43a1-3262-9f5f-986419f674cc",
                                "text": "„Sid senkte verwirrt den Kopf. Sein vogelähnliches Gesicht verzerrte sich.“"
                            },
                            {
                                "example_id": "5eeb0859-251f-423e-afdf-4fd1f7b56477",
                                "sense_id": "8a78ebe1-43a1-3262-9f5f-986419f674cc",
                                "text": "„Paul sah die vogelähnlich leuchtenden Augen der Ehrwürdigen Mutter Gaius Helen Mohiam, während Feyd-Rautha Harkonnen sich etwas im Hintergrund hielt.“"
                            }
                        ],
