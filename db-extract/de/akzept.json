                "senses": [
                    {
                        "sense_id": "7e99a2d8-9166-3017-81f6-bb1573d41683",
                        "entry_id": "d7827026-43b7-33f4-a653-b00a52c2909b",
                        "glosses": [
                            "Annahmeerklärung auf einem Wechsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72dac01-dda6-474a-b0f0-633fe1c0bc7d",
                                "sense_id": "7e99a2d8-9166-3017-81f6-bb1573d41683",
                                "text": "In der Praxis wird die Mehrzahl der Wechsel bereits unmittelbar bei der Ausstellung mit Akzept versehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a74f274-154b-3df2-b552-dfb2beff30d3",
                        "entry_id": "d7827026-43b7-33f4-a653-b00a52c2909b",
                        "glosses": [
                            "akzeptierter Wechsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f04a251f-693a-485e-9a85-9ef5815f789b",
                                "sense_id": "3a74f274-154b-3df2-b552-dfb2beff30d3",
                                "text": "Bei einem Akzept ist die Zahlungsverpflichtung des Bezogenen gesichert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
