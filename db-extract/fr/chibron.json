                        "entry_id": "a6bf76e5-d98b-3f1e-a838-358376c4dd7c",
                        "glosses": [
                            "Pénis."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cb00746f-a505-414b-a692-8c58ef70f3e3",
                                "sense_id": "9be4a3bf-8722-3bc2-a846-ad2f0f33b705",
                                "text": "Elle aime tant sucer ! Surtout quand un autre homme l’encule, et sans timidité ! Un chibron dans le cul, un chibron dans la bouche !"
                            }
                        ]
                    },
                    {
                        "sense_id": "1db856ce-9ce7-3732-be62-720eeb831067",
                        "entry_id": "a6bf76e5-d98b-3f1e-a838-358376c4dd7c",
                        "glosses": [
                            "Personne incapable ou très mauvaise lors d’un exercice."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ecd6ca68-1f38-47da-9b51-f1e7e06e9706",
                                "sense_id": "1db856ce-9ce7-3732-be62-720eeb831067",
                                "text": "J’ai joué comme un chibron, j’avais ma copine à la maison et j’avais pas vraiment la tête à ça…"
                            },
                            {
                                "example_id": "ada4094c-6391-4c8a-bfb0-9a516a75c2a1",
                                "sense_id": "1db856ce-9ce7-3732-be62-720eeb831067",
                                "text": "J’ai pas d’appareil :) pour le moment je suis un chibron avec, c’était déjà pas brillant avec un crayon alors un stylet…"
                            }
                        ]
                    }
                ],
