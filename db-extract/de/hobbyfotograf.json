                "senses": [
                    {
                        "sense_id": "e5bcc556-2c42-3a26-ac87-eb6d422a7e75",
                        "entry_id": "0fb240b7-aed3-3e9c-af66-93a2fb1ff6b1",
                        "glosses": [
                            "(männliche^☆) Person, die nicht beruflich fotografiert, sondern das Fotografieren nur als Hobby ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e538604-0214-4e59-85e2-549e258c6a0d",
                                "sense_id": "e5bcc556-2c42-3a26-ac87-eb6d422a7e75",
                                "text": "„Für die einen sind sie runtergekommene Ruinen, für die anderen nostalgisches Kopfkino: Sogenannte 'Lost Places' sind der neue Trend unter Hobbyfotografen. Sie erkunden regelmäßig leer stehende Gebäude, Orte mit Geschichte, an denen früher Leben herrschte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
