                ],
                "senses": [
                    {
                        "sense_id": "b7bcaa47-a66d-3b90-a7b2-28d5fa92bfd5",
                        "entry_id": "28d07dfa-3947-384e-b803-9eba35da73bf",
                        "glosses": [
                            "(meist unterirdischer) Gang, dessen Existenz vor der Öffentlichkeit verborgen bleiben soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0bff328-aa65-442a-a411-a3f806982d73",
                                "sense_id": "b7bcaa47-a66d-3b90-a7b2-28d5fa92bfd5",
                                "text": "„Im oberösterreichischen Örtchen Steinerberg ist ein mittelalterlicher Geheimgang entdeckt worden.“"
                            },
                            {
                                "example_id": "9b3131fa-874f-4900-b663-b89832dfa4e5",
                                "sense_id": "b7bcaa47-a66d-3b90-a7b2-28d5fa92bfd5",
                                "text": "„Zudem beherbergte er einen Geheimgang, einen schmalen Stollen, durch den man des Schloss unbemerkt verlassen konnte.“"
                            },
                            {
                                "example_id": "5f05e976-f704-4356-bff9-8ebd9e394d63",
                                "sense_id": "b7bcaa47-a66d-3b90-a7b2-28d5fa92bfd5",
                                "text": "„Es gab dort sogar einen Geheimgang, erinnerte sich meine Mutter später, der direkt hinunter zum Meer führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
