{
    "word_family": [
        "swayer",
        "swayable",
        "unswayed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8f2883a-707f-3526-8812-d38c9257ed2e",
                    "sense_definition": "To move or swing slowly from side to side or backward and forward.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall trees began to <w>sway</w> gently in the evening breeze.",
                            "target_lang_translations": {
                                "ru": "Высокие деревья начали плавно <w>качаться</w> на вечернем ветру."
                            }
                        },
                        {
                            "text": "It was beautiful to watch the crowd <w>sway</w> to the music during the concert.",
                            "target_lang_translations": {
                                "ru": "Было прекрасно наблюдать, как толпа <w>раскачивается</w> в такт музыке во время концерта."
                            }
                        }
                    ],
                    "synonyms": [
                        "rock",
                        "swing"
                    ],
                    "common_phrases": [
                        "sway to the music",
                        "sway in the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно двигаться или раскачиваться из стороны в сторону или вперед-назад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качаться",
                                "target_lang_sense_clarification": "ритмично колебаться"
                            },
                            {
                                "target_lang_word": "раскачиваться",
                                "target_lang_sense_clarification": "приходить в движение из стороны в сторону"
                            },
                            {
                                "target_lang_word": "колыхаться",
                                "target_lang_sense_clarification": "о растениях или ткани на ветру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96f7ec3-c6e4-3ecf-bb80-443f323d18d5",
                    "sense_definition": "To influence or change someone's opinion or decision through persuasion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer tried his best to <w>sway</w> the jury with new evidence.",
                            "target_lang_translations": {
                                "ru": "Адвокат изо всех сил старался <w>склонить</w> присяжных на свою сторону с помощью новых улик."
                            }
                        },
                        {
                            "text": "Do you think you can <w>sway</w> their decision before the final vote?",
                            "target_lang_translations": {
                                "ru": "Думаешь, ты сможешь <w>изменить</w> их решение до финального голосования?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sway their decision",
                        "sway public opinion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влиять на чье-либо мнение или решение или изменять его с помощью убеждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "убеждать принять чью-то сторону"
                            },
                            {
                                "target_lang_word": "повлиять",
                                "target_lang_sense_clarification": "оказать воздействие на решение"
                            },
                            {
                                "target_lang_word": "переубеждать",
                                "target_lang_sense_clarification": "заставить изменить мнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420b2100-304c-3bca-8fe1-6cbae52b1fe0",
                    "sense_definition": "To move or wield something, such as a weapon or symbol of power, with the hand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was born to <w>sway</w> the sceptre over his vast lands.",
                            "target_lang_translations": {
                                "ru": "Король был рожден, чтобы <w>владеть</w> скипетром над своими обширными землями."
                            }
                        },
                        {
                            "text": "He watched the blacksmith <w>sway</w> the heavy hammer against the glowing metal.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как кузнец <w>заносит</w> тяжелый молот над раскаленным металлом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sway the sceptre"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Держать или размахивать чем-либо (например, оружием или символом власти) в руке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владеть",
                                "target_lang_sense_clarification": "управлять скипетром или оружием"
                            },
                            {
                                "target_lang_word": "заносить",
                                "target_lang_sense_clarification": "поднимать для удара, например молот"
                            },
                            {
                                "target_lang_word": "взмахивать",
                                "target_lang_sense_clarification": "делать движение рукой с предметом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00624278-af71-318e-b2fd-2f4110041bec",
                    "sense_definition": "To hoist a mast or yard into its proper position on a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors worked together to <w>sway</w> up the yards before setting sail.",
                            "target_lang_translations": {
                                "ru": "Матросы дружно работали, чтобы <w>поднять</w> реи перед отплытием."
                            }
                        },
                        {
                            "text": "It takes significant strength and coordination to <w>sway</w> the heavy mast into place.",
                            "target_lang_translations": {
                                "ru": "Требуется значительная сила и координация, чтобы <w>установить</w> тяжелую мачту на место."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sway up the yards"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "nautical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать мачту или рею в надлежащее положение на корабле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "устанавливать рангоут"
                            },
                            {
                                "target_lang_word": "выстреливать",
                                "target_lang_sense_clarification": "морской термин для установки рангоута"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43503765-d1ab-3ccf-b6bf-9cbf69c8d204",
                    "sense_definition": "A rhythmic rocking or swinging motion from side to side.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old song caused a little <w>sway</w> in everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Старая песня заставила всех в комнате начать легкое <w>покачивание</w>."
                            }
                        },
                        {
                            "text": "The bridge had a noticeable <w>sway</w> when the heavy trucks drove across it.",
                            "target_lang_translations": {
                                "ru": "У моста было заметное <w>колебание</w>, когда по нему проезжали тяжелые грузовики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gentle sway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритмичное покачивание или движение из стороны в сторону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качание",
                                "target_lang_sense_clarification": "процесс движения из стороны в сторону"
                            },
                            {
                                "target_lang_word": "покачивание",
                                "target_lang_sense_clarification": "легкое ритмичное движение"
                            },
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "физическое движение конструкции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9815bfbd-03dd-351f-99d8-41108035ac6b",
                    "sense_definition": "Power, influence, or authority that affects someone's actions or beliefs.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I doubt I will hold much <w>sway</w> with someone so powerful and independent.",
                            "target_lang_translations": {
                                "ru": "Сомневаюсь, что я буду иметь большое <w>влияние</w> на кого-то столь могущественного и независимого."
                            }
                        },
                        {
                            "text": "The religious leader held considerable <w>sway</w> over the local community.",
                            "target_lang_translations": {
                                "ru": "Религиозный лидер имел значительный <w>авторитет</w> в местной общине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold sway",
                        "considerable sway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила, влияние или авторитет, воздействующие на чьи-либо действия или убеждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "влияние",
                                "target_lang_sense_clarification": "авторитет, воздействующий на других"
                            },
                            {
                                "target_lang_word": "вес",
                                "target_lang_sense_clarification": "значимость мнения в обществе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed703ccc-0b88-3acd-a5a8-0b3320825923",
                    "sense_definition": "The exercise of control, dominion, or sovereign rule.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military still holds <w>sway</w> in a democracy that has yet to mature.",
                            "target_lang_translations": {
                                "ru": "Военные все еще удерживают <w>власть</w> в демократии, которая еще не окрепла."
                            }
                        },
                        {
                            "text": "Under the <w>sway</w> of the empire, many small nations lost their independence.",
                            "target_lang_translations": {
                                "ru": "Под <w>господством</w> империи многие малые народы потеряли свою независимость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "under the sway of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществление контроля, господства или суверенной власти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "власть",
                                "target_lang_sense_clarification": "господство или управление"
                            },
                            {
                                "target_lang_word": "господство",
                                "target_lang_sense_clarification": "полный контроль над территорией"
                            }
                        ]
                    }
                }
            ]
        },
        {
