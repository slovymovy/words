                                            {
                                                "example_id": "1024e8dd-891c-4b7f-bdec-ab1a83eef6f5",
                                                "sense_id": "2c845710-e5b3-38e9-bdf3-c34483de29c6",
                                                "text": "„Schon die christliche Ikonografie des Frühmittelalters kennt Engelfiguren als Adoranten oder Assistenzfiguren.“"
                                            },
                                            {
                                                "example_id": "65841864-1d0a-4681-b134-de5153763d59",
                                                "sense_id": "2c845710-e5b3-38e9-bdf3-c34483de29c6",
                                                "text": "„Bis 1981 waren die wechselnden Mitglieder des Unternehmens mit facettenreichen Fragestellungen zur Ikonografie der römischen Kaiserzeit befasst […].“"
                                            },
                                            {
                                                "example_id": "293dcd22-a900-44f2-abd3-386e2ae55d53",
                                                "sense_id": "2c845710-e5b3-38e9-bdf3-c34483de29c6",
                                                "text": "„Dieses Zupfinstrument [Harfe] tragen in Ikonografien seit frühester Zeit die Engel […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
