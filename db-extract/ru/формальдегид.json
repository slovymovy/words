                "senses": [
                    {
                        "sense_id": "b9165133-74ab-3212-93e0-4cb58b96cd28",
                        "entry_id": "b284148f-558f-3326-b879-95f49184b8a8",
                        "glosses": [
                            "хим. органическое соединение, простейший альдегид; бесцветный газ с резким запахом, хорошо растворимый в воде, спиртах и полярных растворителях, CH₂O"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2759192-3f94-4bdc-984d-2058b676c03c",
                                "sense_id": "b9165133-74ab-3212-93e0-4cb58b96cd28",
                                "text": "Реагируя с избытком формальдегида, метиламин даёт диметиламин и, наконец, триметиламин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff1d3f08-3145-4ceb-b92b-88d6a380bd1a",
