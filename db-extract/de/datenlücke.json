                ],
                "senses": [
                    {
                        "sense_id": "5148f876-ca52-34a8-be59-7a84a2e1ac4a",
                        "entry_id": "f68a038e-1afe-35d1-9bb9-b102d371e4a5",
                        "glosses": [
                            "Angriffspunkt in der IT-Struktur einer Organisation, die von Hackern ausgenutzt werden kann, um an (meist vertrauliche) Daten zu gelangen"
                        ],
                        "tags": [
                            "IT-Sicherheit"
                        ],
                        "examples": [
                            {
                                "example_id": "9fb6e2ae-cc0e-4cdb-b550-5b1a4234c718",
                                "sense_id": "5148f876-ca52-34a8-be59-7a84a2e1ac4a",
                                "text": "„Chinesische Hacker haben eine Datenlücke bei Microsoft ausgenutzt und sich illegal große Mengen an Daten beschafft.“"
                            },
                            {
                                "example_id": "ceb61f85-9b0b-4b00-a808-56642f5b629f",
                                "sense_id": "5148f876-ca52-34a8-be59-7a84a2e1ac4a",
                                "text": "„»Intern sind die US-Manager besorgt um ihre Datenlücken und ihre Datensicherheit«, sagt Heim. \"Sie zeigen es nicht so, um Aktivisten nicht auf Ideen zu bringen.«“"
                            },
                            {
                                "example_id": "64917f72-fe10-43a3-8138-0aa471d798cc",
                                "sense_id": "5148f876-ca52-34a8-be59-7a84a2e1ac4a",
                                "text": "„Twitch weiß von der Datenlücke. Das Unternehmen twitterte am vergangenen Mittwoch, dass es den Hack bestätigen könne.“"
                            },
                            {
                                "example_id": "65399e79-67ac-4be7-a13a-8a820e61549d",
                                "sense_id": "5148f876-ca52-34a8-be59-7a84a2e1ac4a",
                                "text": "„Potenziell könnten Profile von bis zu 500.000 Konten bei Google Plus betroffen sein. Der Konzern teilte allerdings mit, er könne keine weitergehenden Angaben machen, weil Nutzungslogs nur zwei Wochen lang gespeichert würden. Bis zu 438 Apps könnten auf die Schnittstelle mit der Datenlücke zugegriffen haben.“"
                            },
                            {
                                "example_id": "456d2695-fab4-4b7a-99d4-688ab4118f0e",
                                "sense_id": "5148f876-ca52-34a8-be59-7a84a2e1ac4a",
                                "text": "„Zu den Daten gehörten unter anderem Cookies und Token zur Authentifizierung. Nach Angaben von Cloudflare gibt es allerdings keine Anzeichen dafür, dass die Datenlücke ausgenutzt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                        "entry_id": "f68a038e-1afe-35d1-9bb9-b102d371e4a5",
                        "glosses": [
                            "Tatsache, wegen mangelnder, zu geringer oder fehlerhafter Erhebung von Daten in einem Bereich keine oder zu geringe Kenntnisse zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa71d063-2451-4c5f-af70-87e513725961",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "In der Coronapandemie tappen Entscheider wegen der Datenlücken in deutschen Gesundheitsdaten im Dunkeln."
                            },
                            {
                                "example_id": "50325e2c-3dc7-4d0c-b366-7c72ead094af",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "„Es gibt Datenlücken.“"
                            },
                            {
                                "example_id": "00fe2e1b-7311-467b-a49a-8f9cb3fe2a2f",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "[Coronapandemie 2021 – Der Mediziner Christian Drosten:] „»Es gibt wieder mal in Deutschland eine Datenlücke.«“"
                            },
                            {
                                "example_id": "9639e5f2-855c-4bd9-af3c-a4621da8d8db",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "[Schlagzeile:] „Datenlücke in der Medizin: Frauen noch immer im Nachteil“"
                            },
                            {
                                "example_id": "d467fc69-58f4-4aa1-b041-9fc8289bc4f9",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "[Schlagzeile:] „Datenlücke: Wie viele Menschen sitzen wegen Fahren ohne Ticket im Gefängnis?“"
                            },
                            {
                                "example_id": "7159e1f5-8e7c-4ab6-bc8e-58ca59b4e8f1",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "[Coronapandemie 2020:] „Da es allerdings am Donnerstag zeitweise zu Datenlücken bei der Übermittlung von Infektionszahlen gekommen war, könnten in der jüngsten Zahl entsprechende Nachmeldungen enthalten sein.“"
                            },
                            {
                                "example_id": "a6687a77-69c2-44b6-bb3a-f5874407d07d",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "„Das Bromwich-Team nutzte nun Wetterdaten anderer zumeist über die Küstenregionen der Antarktis verteilten Stationen und berechnete so die mit großer Wahrscheinlichkeit in der Byrd-Region herrschenden Temperaturen. Damit konnte es die Datenlücken schließen und eine langfristige Temperaturkurve für die Inlandregion erstellen.“"
                            },
                            {
                                "example_id": "7ba873a9-b150-4d62-b171-5e030b26fab1",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "„Nachts wird es immer heller, das zeigen Satelliten- und Luftaufnahmen. Wer diese Lichtverschmutzung verursacht, ist aber oft unklar. Um diese Datenlücke zu schließen, hat ein Team aus Bürgerwissenschaftlern und Forscherinnen eine neue App entwickelt.“"
                            },
                            {
                                "example_id": "ffe13296-5ef1-4b39-a2e5-fb25fdaa5cfc",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "[Orale Aufnahme von Kohlenwasserstoffen aus mineralölhaltigen Produkten in Lippenstiften:] „Das BfR sieht eine abschließende Risikobewertung erschwert, da hinsichtlich einer möglichen oralen Aufnahme aus Lippenstiften noch Datenlücken bestehen.“"
                            },
                            {
                                "example_id": "a28a6aab-c64c-47f6-8e72-5a59c3d629da",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "„Eine Lösung hat Nahles auch für das Problem der Datenlücke gefunden, das in der vergangenen Woche bekannt wurde: Die Rentenversicherung weiß für Zeiten der Arbeitslosigkeit vor 2001 nicht, ob das als Beitragszeit zählende Arbeitslosengeld oder Arbeitslosenhilfe gezahlt wurde.“"
                            },
                            {
                                "example_id": "7e9d37ee-94ed-432e-9e21-f9e7b591baad",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "[Coronapandemie 2022 – Geboostert oder nicht:] „Die Kassenärztliche Vereinigung gibt an, dass die Datenlücke im Austausch mit dem RKI jetzt möglichst schnell geschlossen werden soll.“"
                            },
                            {
                                "example_id": "d60e3567-323a-4f30-a160-cf54e1f7f4cf",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "„Zusammenarbeit: Der vermehrte Austausch von Daten zwischen Wissenschaftlern und Staaten kann Datenlücken schließen, insbesondere in Entwicklungs- und Schwellenländern.“"
                            },
                            {
                                "example_id": "7f42d41c-4e45-4003-97ee-1c39171bdb16",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "„Die Abflussmenge des Malagarasi wurde am Pegel Mberagule über die Jahre 2010 bis 2019, kurz vor der Mündung, in m³/s gemessen. Es ist anzumerken, dass in den niederschlagsreichen Jahren 2017 und 2018 während der Regenzeit eine Datenlücke in den Aufzeichnungen ist. Es ist entsprechend möglich, dass die Maximalwerte höher liegen.“"
                            },
                            {
                                "example_id": "bbddb56f-82f2-4b31-b5d0-161ab780114e",
                                "sense_id": "fc12a82b-0a0f-365f-a4a4-b8f5dc4ea8c9",
                                "text": "„Diese Datenlücke hat auch damit zu tun, dass der Bundesregierung eine verbindliche Arbeitsdefinition von Rassismus fehlt, die uns für diese Frage sensibilisieren würde. Es stimmt also, dass wir dieser Frage schwer empirisch nachgehen können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
