                        "cross_references": [
                            {
                                "target_word": "gentleness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                                        "entry_id": "a4ab9e27-34c2-3a79-a550-50513ad89726",
                                        "glosses": [
                                            "The state of being gentle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a98d8c-0f14-413a-a88e-3ee5ca9b21fa",
                                                "sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                                                "text": "[S]he [Sabrina, a water nymph] reviv'd, / And undervvent a quicke, immortall change / Made goddeſſe of the river; ſtill ſhe retaines / Her maiden gentleneſſe, […]",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "f2e19bb4-fd34-42e7-b61d-cec78593ff83",
                                                "sense_id": "b63ce856-cbfd-385f-9d5d-f04db239bcb4",
                                                "text": "Willie spends his bus money home playing a song to dance to on the jukebox in an effort to comfort Sam, and unlike Hally, who struck out at his old friend when his life began to go wrong, Sam does not pass down Hally's hatefulness, but instead treats Willie with the same gentleness he has shown toward him throughout the play."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37d1ed0a-7e65-4033-b81a-90f7c7db2e48",
                        "source_entry_id": "2f1b8ee2-a199-32c6-9f20-5bffe16c71ed",
                        "source_sense_id": "242c3a77-62df-3366-bfab-2cf6f8b22e99",
                        "target_lang_word": "mildness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mildness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ecf0a98-c0a0-3f0a-aa3b-54938cce3547",
                                        "entry_id": "098d6912-544e-325e-bdeb-8767be4006a2",
                                        "glosses": [
                                            "The quality of being mild; gentleness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5df3505-ae14-49bf-a0d9-66b4b36f0f0b",
                                                "sense_id": "1ecf0a98-c0a0-3f0a-aa3b-54938cce3547",
                                                "text": "A ſnowy Feather ſpangled white he beares,\nTo ſignifie the mildneſſe of his minde,\nThat ſatiate with ſpoile refuſeth blood:"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9f1197c-3f07-4487-b698-5984a83455de",
                        "source_entry_id": "2f1b8ee2-a199-32c6-9f20-5bffe16c71ed",
                        "source_sense_id": "242c3a77-62df-3366-bfab-2cf6f8b22e99",
                        "target_lang_word": "placidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8faf360d-8fdf-3b46-8573-6891907807b2",
                                        "entry_id": "8f4d16c1-394b-3968-b439-9491738fc3f4",
                                        "glosses": [
                                            "Douceur naturelle ; caractère calme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327f5f14-5f2f-4d74-a639-7d9a810ab02d",
                                                "sense_id": "8faf360d-8fdf-3b46-8573-6891907807b2",
                                                "text": "Ce fils de paysan, blêmi dans les soucis du commerce, gras de vie sédentaire, cachant ses appétits haineux sous la placidité naturelle de ses traits, avait en effet l’air nul et solennel, la carrure imbécile qui pose un homme dans un salon officiel."
                                            },
                                            {
                                                "example_id": "b038a172-50c9-405d-91d2-8ac2b7e2ffae",
                                                "sense_id": "8faf360d-8fdf-3b46-8573-6891907807b2",
                                                "text": "La falaise … vous écrasait de sa placidité formidable et elle vous charmait pourtant ; car on la contemplait malgré soi et les yeux ne s’en lassaient pas."
                                            },
                                            {
                                                "example_id": "9095939b-1df0-4f53-adc6-5722ca61bc94",
                                                "sense_id": "8faf360d-8fdf-3b46-8573-6891907807b2",
                                                "text": "Alors, il faudra que moi j’attende ce jugement aux Cinq-Fontaines, entre ton Oncle, qui me narguera, et Adalbert qui ne se fera pas de bile et dont la placidité me mettra hors de moi."
                                            },
                                            {
                                                "example_id": "2ddf64d4-ee86-45e3-95a8-676ae423b5f8",
                                                "sense_id": "8faf360d-8fdf-3b46-8573-6891907807b2",
                                                "text": "Malgré sa corpulence excessive, l’autorité de M. Hector sur ses subordonnés n’est guère contestable. Il la doit surtout à sa placidité étudiée, au ton solennel et ampoulé qu’il affecte en s’exprimant, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e615d8c2-5d47-4eb7-bf20-b7ad7b4843f5",
                        "source_entry_id": "2f1b8ee2-a199-32c6-9f20-5bffe16c71ed",
                        "source_sense_id": "242c3a77-62df-3366-bfab-2cf6f8b22e99",
                        "target_lang_word": "Milde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4b2f53b-e856-3ab6-9f16-7f076736ad50",
                                        "entry_id": "bad4b1c9-2fd8-32fe-adbc-c3b17efcd5bd",
                                        "glosses": [
                                            "die Charaktereigenschaft der Sanftmut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39018ffd-381b-456d-bcdd-85f35626b106",
                                                "sense_id": "c4b2f53b-e856-3ab6-9f16-7f076736ad50",
                                                "text": "Auffällig unter lauter Fanatikern war seine Milde."
                                            },
                                            {
                                                "example_id": "5122189c-b74a-48c1-971a-26ef55e38fe3",
                                                "sense_id": "c4b2f53b-e856-3ab6-9f16-7f076736ad50",
                                                "text": "„Seine Frömmigkeit wird durch zahlreiche Andachtsübungen bezeugt, und seine Milde zeigt sich darin, daß er die Begnadigung des Generals Debelle durchsetzte, der die Waffen gegen ihn erhoben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cec2cb08-2be5-3465-8b51-efa48ff67312",
                                        "entry_id": "bad4b1c9-2fd8-32fe-adbc-c3b17efcd5bd",
                                        "glosses": [
                                            "die Eigenschaft von Speisen und Getränken, keine Reizstoffe zu enthalten (nicht scharf, gewürzt, salzig oder hochalkoholisch zu sein)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e10b2568-1c17-43e4-8b8b-114d302266e6",
                                                "sense_id": "cec2cb08-2be5-3465-8b51-efa48ff67312",
                                                "text": "Die Milde der warmen Milch beruhigte seine Magenschmerzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Milde",
