                            {
                                "target_lang_word": "поло́ска",
                                "target_lang_sense_clarification": "узкая линия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "条纹",
                                "target_lang_sense_clarification": "颜色不同的长条"
                            },
                            {
                                "target_lang_word": "带状物",
                                "target_lang_sense_clarification": "长条区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be869981-24a9-3a8a-a76b-e39f5d940526",
                    "sense_definition": "A specific range of frequencies, wavelengths, or values, especially in radio or physics.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strip_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio station broadcasts on a very popular frequency <w>band</w>.",
                            "target_lang_translations": {
                                "ru": "Радиостанция вещает в очень популярном частотном <w>диапазоне</w>.",
                                "zh": "这家电台在一个非常受欢迎的频率<w>波段</w>广播。"
                            }
                        },
                        {
                            "text": "Scientists analyzed the absorption <w>band</w> to identify the chemical elements.",
                            "target_lang_translations": {
                                "ru": "Ученые проанализировали <w>полосу</w> поглощения, чтобы определить химические элементы.",
                                "zh": "科学家们分析了吸收<w>带</w>以识别化学元素。"
                            }
                        }
                    ],
                    "synonyms": [
                        "range",
                        "spectrum",
                        "frequency"
                    ],
                    "common_phrases": [
                        "frequency band",
                        "broad band"
                    ],
