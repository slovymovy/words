                        ],
                        "examples": [
                            {
                                "example_id": "9e4173df-41fc-4c9d-822f-49d74075ba25",
                                "sense_id": "b0f35233-8242-3648-b20a-a6731e31380d",
                                "text": "CHEVRONNE, or Chevronny, ſignifies the dividing of the ſhield ſeveral times chevron-wiſe."
                            }
                        ]
                    },
                    {
                        "sense_id": "073c52c2-99a1-3638-80e7-abfc69c73423",
                        "entry_id": "eb527925-42b1-33d6-8f9c-575c2f31c6e7",
                        "glosses": [
                            "Chevron-shaped, zigzag, especially (heraldry) chevronwise."
