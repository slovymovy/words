                                        "entry_id": "eccb0be2-ff63-31b5-8791-7be995c9994b",
                                        "glosses": [
                                            "A tropical wetlands region of central South America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1630f05-7a29-4b97-a179-f496326724b1",
                                                "sense_id": "ae35092e-64c6-3592-b14a-6eb69a060fe3",
                                                "text": "Usually flooded for much of the year, the Pantanal in recent years has been parched by a string of severe droughts that scientists have linked to deforestation and climate change."
                                            }
                                        ]
                                    }
