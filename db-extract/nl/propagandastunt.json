                        "examples": [
                            {
                                "example_id": "b49162d1-5949-4a59-b6ec-ddbcb25fdd02",
                                "sense_id": "2c5a9416-70c2-35ba-8718-4d25c14c6623",
                                "text": "Ze maakt zich zorgen over de ontwikkelingen in Afghanistan en de gevolgen daarvan voor vrouwen. \"Ze zeggen dat ze de rechten van vrouwen zullen respecteren, maar dat kan ook een propagandastunt zijn. De afgelopen dagen hebben we al dingen gezien die daarop lijken te wijzen. Zo werd een vrouwelijke nieuwspresentator van de staatsomroep al vrij snel door de Taliban van het scherm verbannen.\""
                            },
                            {
                                "example_id": "4df6b856-821c-4004-833a-d648904ec022",
                                "sense_id": "2c5a9416-70c2-35ba-8718-4d25c14c6623",
                                "text": "Eigenlijk was het een dure propagandastunt om internationaal geloof in het Bunkerproject te consolideren."
                            },
                            {
                                "example_id": "2c418e8a-9a85-4b95-9f3a-36b6dcf2d2b7",
                                "sense_id": "2c5a9416-70c2-35ba-8718-4d25c14c6623",
                                "text": "Of was het toch meer een handige propagandastunt? Herweijer was in 1906 geboren in een protestants gezin in het Brabantse Zevenbergen."
                            }
                        ]
                    }
