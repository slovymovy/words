                ],
                "senses": [
                    {
                        "sense_id": "c61830d7-6fe6-362e-803f-a402ee0d41c9",
                        "entry_id": "c9f7f6f9-68c1-346a-8edf-cca57e578d97",
                        "glosses": [
                            "ironia dotycząca samego siebie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1207207f-afde-441a-9e9c-0b38fb7d72bf",
                                "sense_id": "c61830d7-6fe6-362e-803f-a402ee0d41c9",
                                "text": "Konstrukcja, wielowątkowość, powtórzenia, autoironie, są to symptomy, powiedzmy, literackie. Dosłowne doświadczenie bycia przy umieraniu bliskiego człowieka staje się początkiem opowieści o literaturze i naszej wyobraźni"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2884cda9-47b6-46c0-9426-bf7f1796d72e",
                        "source_entry_id": "c9f7f6f9-68c1-346a-8edf-cca57e578d97",
                        "source_sense_id": "c61830d7-6fe6-362e-803f-a402ee0d41c9",
                        "target_lang_word": "autodérision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodérision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                        "entry_id": "bbfd3f83-0192-3494-837d-a78060cdbae7",
                                        "glosses": [
                                            "Attitude consistant à se tourner soi-même en dérision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4da1e2-8ead-4746-95b8-9493c4e18877",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "Autant pour moi est une locution de modestie, avec un brin d’autodérision. Elle est elliptique et signifie : « Je ne suis pas meilleur qu’un autre, j’ai autant d’erreurs que vous à mon service : autant pour moi. »"
                                            },
                                            {
                                                "example_id": "82588a9d-2c8c-4f7d-8dc4-bed92989895d",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "L’autodérision, que je sache, c’était l’essence même des monologues de Deschamps."
                                            },
                                            {
                                                "example_id": "a399ce68-ff20-4edb-a81e-f2fdf5f151ab",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "Visiblement peu encline à l’autodérision, Nicki Minaj a bloqué manu militari le compte d’un fan qui venait de publier un portrait d’elle peu flatteur sur Twitter."
                                            },
                                            {
                                                "example_id": "0d429963-b0cc-432d-affa-87cb0a2badf2",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "L'autodérision est sœur de l'humilité et dégonfle tout ego surdimensionné.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07d7b18e-169c-4eca-8b6c-45110d313df5",
                        "source_entry_id": "c9f7f6f9-68c1-346a-8edf-cca57e578d97",
                        "source_sense_id": "c61830d7-6fe6-362e-803f-a402ee0d41c9",
                        "target_lang_word": "Selbstironie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstironie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                        "entry_id": "7f288d52-8985-3178-9696-1bafa2eb64a3",
                                        "glosses": [
                                            "Ironie, die sich auf die eigenen Ansichten, Werte oder Handlungen bezieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9550793-1229-4b20-b23e-532c73735aec",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "Peter liebt die Selbstironie, er nimmt sich immer wieder gekonnt selbst auf den Arm."
                                            },
                                            {
                                                "example_id": "19619216-53e4-47e9-b0f5-9bccf14de90d",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "Da ist wenig zu merken vom Wortwitz, von der Selbstironie und der Frechheit, die ihm Freunde attestieren."
                                            },
                                            {
                                                "example_id": "43f9dcc7-22d3-400c-a512-0c4545e71eb4",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "„Sie verfolgen stattdessen eine Karriere als Unternehmerin, Designerin und Anwältin, wobei ihnen, wie den meisten Männern, dabei erst die Leichtigkeit und dann die Selbstironie abhandenkommt.“"
                                            },
                                            {
                                                "example_id": "e583504d-9966-4bdc-8626-d53ab606444e",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "„Er lachte voller Selbstironie und fummelte dann an den Knöpfen des Autoradios herum.“"
                                            },
                                            {
                                                "example_id": "1ea92cc9-31f1-432e-acde-1a700d94e4a8",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "„Man kann sagen, mit den Juden reisten ihr Witz, ihre skeptische Klugheit, ihre Selbstironie und ihre Geschicklichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13c00de9-0619-4e63-99d1-0e2a14f67da5",
                        "source_entry_id": "c9f7f6f9-68c1-346a-8edf-cca57e578d97",
                        "source_sense_id": "c61830d7-6fe6-362e-803f-a402ee0d41c9",
