                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55006430-4d7f-4deb-9ebb-d5793b7deb66",
                                "sense_id": "7bbee620-c5e6-3c75-8290-dc868d019565",
                                "text": "Sinds het begin van de negentiende eeuw was de Kaukasus - die deel uitmaakte van het tsarenrijk - na Siberië het belangrijkste verbanningsoord."
                            },
                            {
                                "example_id": "bcb470fd-bf8c-4cff-baeb-2189f774b028",
                                "sense_id": "7bbee620-c5e6-3c75-8290-dc868d019565",
                                "text": "Tegelijkertijd geldt Ivan de Verschrikkelijke ook als de grondlegger van het machtige Russische tsarenrijk en introduceerde hij de boekdrukkunst in Rusland. Verder liet hij onder meer de Vasili-kathedraal bouwen, nog altijd de blikvanger van het Rode Plein in Moskou."
                            }
                        ]
                    }
