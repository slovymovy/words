                        ],
                        "form": "den Auslaut"
                    },
                    {
                        "form_id": "71c5ec52-a8c9-4fbd-9c6a-0966b3bc4038",
                        "entry_id": "b167c059-2255-3744-9fa0-f0bdd9d99d29",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Auslaute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f52b3c5b-450e-3e8d-b44a-134999a8cc0b",
                        "entry_id": "b167c059-2255-3744-9fa0-f0bdd9d99d29",
                        "glosses": [
                            "letzter Laut eines Wortes oder einer Silbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7117188-f439-46fc-a29f-d0eb254b6bbd",
                                "sense_id": "f52b3c5b-450e-3e8d-b44a-134999a8cc0b",
                                "text": "Der Laut [h] kommt im Deutschen im Auslaut nicht vor."
                            },
                            {
                                "example_id": "de28902b-b139-438c-a465-d1bd0f01c9fc",
                                "sense_id": "f52b3c5b-450e-3e8d-b44a-134999a8cc0b",
                                "text": "„In der Standardlautung ist die Stimmhaftigkeitskorrelation gültig für Anlaut und Inlaut, während sie im Auslaut aufgehoben ist.“"
                            },
                            {
                                "example_id": "4efbf315-a89a-49d3-ae00-659e66cc5078",
                                "sense_id": "f52b3c5b-450e-3e8d-b44a-134999a8cc0b",
                                "text": "„Im Auslaut haben die indogermanischen Laute (besonders die Konsonanten, teilweise auch die Vokale) öfters eine andere Behandlung erfahren als im Inlaut der Wörter .“"
                            },
                            {
                                "example_id": "0dff99db-1612-4f7c-aa60-4a52071a3aec",
                                "sense_id": "f52b3c5b-450e-3e8d-b44a-134999a8cc0b",
                                "text": "„Hieraus resultiert auch, dass diese sogenannten harten Einsätze für Deutsche in morphologischer Hinsicht als starkes Grenzsignal wirken, was für das Dänische nicht zutreffend ist, da sich der (phonemisch relevante) Stoßton immer im In- oder Auslaut von Wörtern befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5116fd47-ff87-3e54-bc41-74cb1ec8848e",
                        "entry_id": "b167c059-2255-3744-9fa0-f0bdd9d99d29",
                        "glosses": [
                            "Gruppe von Lauten nach dem Silbengipfel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "054908a1-a47f-4c54-95cc-2ace41ac5364",
                                "sense_id": "5116fd47-ff87-3e54-bc41-74cb1ec8848e",
                                "text": "Der Laut [h] kommt im Deutschen im Auslaut nicht vor."
                            },
                            {
                                "example_id": "e459bc7e-f7c2-4866-9e31-e9321094c8f3",
                                "sense_id": "5116fd47-ff87-3e54-bc41-74cb1ec8848e",
                                "text": "Gross stellt unter dem Begriff Auslaut die mögliche Struktur von Konsonantengruppen im Silbenauslaut dar."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
