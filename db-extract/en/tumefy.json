                        "sense_id": "30f0c539-959c-3755-8a9a-396d4c3f6d09",
                        "entry_id": "acfe9a8d-98a7-3b4d-a269-9cdcb1c9e426",
                        "glosses": [
                            "To cause to swell."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6c307033-aa70-41e2-a0bf-73aa1912018f",
                                "sense_id": "30f0c539-959c-3755-8a9a-396d4c3f6d09",
                                "text": "to swell, tumefy, stiffen, not the diction only, but the tenor of the thought"
                            }
                        ]
                    },
                    {
                        "sense_id": "01b79d2f-9a5e-3d10-b3cf-8302ddb4a099",
                        "entry_id": "acfe9a8d-98a7-3b4d-a269-9cdcb1c9e426",
                        "glosses": [
                            "To swell; to rise into a tumour."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4c7cb7cf-b012-413a-a990-cd9cba6d160c",
                                "sense_id": "01b79d2f-9a5e-3d10-b3cf-8302ddb4a099",
                                "text": "[…] Lanfrank takes Notice of Tract. 3. Doct. 3. cap. 18. ſaying, \"I have ſeen many who being full of Humours, have made an Iſſue under the Knee, before due Purgation had been premis'd; whence, by reaſon of the too great Defluxion of Humours, the Legs tumified, ſo that the cauterized Place corrupted, and a Cancer (or rather cacoethic Ulcer) was thereby made, with which great Difficulty was cur'd.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3b4f252-66ea-442a-aab6-341318a1f3cb",
                        "source_entry_id": "acfe9a8d-98a7-3b4d-a269-9cdcb1c9e426",
                        "source_sense_description": "to cause to swell",
                        "target_lang_word": "tuméfier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuméfier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dff3294-1872-33ab-8c19-6cd2243adcec",
                                        "entry_id": "17ebb416-9f7d-3e6f-9983-705e78394efb",
                                        "glosses": [
                                            "Causer de la tuméfaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b283c23-9657-42ca-8b8e-15701779cd8c",
                                                "sense_id": "1dff3294-1872-33ab-8c19-6cd2243adcec",
                                                "text": "La fluxion lui a tuméfié tout le visage."
                                            },
                                            {
                                                "example_id": "f591fd59-e9ad-4edb-82a7-cfc7e398f920",
                                                "sense_id": "1dff3294-1872-33ab-8c19-6cd2243adcec",
                                                "text": "Les jambes enflent, refusent de la porter, et elle se tuméfie, immobile, sur un grabat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18fd9277-2649-454a-85e5-ea2c622e1f43",
                        "source_entry_id": "acfe9a8d-98a7-3b4d-a269-9cdcb1c9e426",
                        "source_sense_description": "to cause to swell",
                        "target_lang_word": "προκαλώ",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
