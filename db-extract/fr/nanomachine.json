                        "sense_id": "20703441-c590-3406-825f-a8c3f1cb4d23",
                        "entry_id": "de964f0d-a068-3309-b51f-eaa22e66f7be",
                        "glosses": [
                            "Machine à l’échelle du nanomètre."
                        ],
                        "tags": [
                            "Industrie",
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "182c798c-3ccb-4c17-a2b9-93ab7f195089",
                                "sense_id": "20703441-c590-3406-825f-a8c3f1cb4d23",
                                "text": "Il lui expliqua qu’il avait mis au point une nanomachine spécialement pour son petit frère, basé sur l’infime partie du génome codé de leur père gardée en elle."
                            },
                            {
                                "example_id": "9333b1b4-f279-48d3-ba43-878e15ef4294",
                                "sense_id": "20703441-c590-3406-825f-a8c3f1cb4d23",
                                "text": "Nous pouvons même utiliser des nanomachines et transformer nos corps. Pourtant, nous ne le faisons pas. Nous attendons l’avis des vieilles barbes de la Commission sur ce qui est humain et ce qui ne l’est pas."
                            }
                        ]
                    },
