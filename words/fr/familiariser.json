    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be1961a0-6ca8-33df-84b4-cd3b18c7a6e8",
                    "sense_definition": "Rendre familier avec quelqu'un ou quelque chose ; habituer à une présence ou à une situation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accoutumance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouvel entraîneur essaie de <w>familiariser</w> les joueurs avec sa méthode de travail."
                        },
                        {
                            "text": "Il faut quelques jours pour <w>familiariser</w> un jeune chien à son nouvel environnement."
                        }
                    ],
                    "synonyms": [
                        "accoutumer",
                        "habituer",
                        "adapter"
                    ],
                    "antonyms": [
                        "désaccoutumer",
                        "déshabituer"
                    ],
                    "common_phrases": [
                        "se familiariser avec",
                        "familiariser son esprit"
                    ]
                },
                {
                    "sense_id": "0054da10-99ae-362e-bf61-e9df28c4ef03",
                    "sense_definition": "Apprendre à bien connaître, comprendre ou maîtriser une notion ou une pratique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apprentissage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce stage pratique permet aux étudiants de se <w>familiariser</w> avec les outils numériques."
                        },
                        {
                            "text": "Elle a pris le temps de se <w>familiariser</w> avec les coutumes de ce pays."
                        }
                    ],
                    "synonyms": [
                        "assimiler",
                        "apprendre"
                    ],
                    "antonyms": [
                        "ignorer"
                    ],
                    "common_phrases": [
                        "se familiariser avec les règles",
                        "se familiariser avec le fonctionnement"
                    ]
                },
                {
                    "sense_id": "a5487e85-8ffd-399c-b01a-8ba628158a60",
                    "sense_definition": "Prendre des manières trop familières ou des libertés excessives avec quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur n'apprécie guère les employés qui se <w>familiarisent</w> dès le premier jour."
                        },
                        {
                            "text": "Il vaut mieux garder ses distances et éviter de trop se <w>familiariser</w> en milieu professionnel."
                        }
                    ]
                }
            ]
        }
    ]
