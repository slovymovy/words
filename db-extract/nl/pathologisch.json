                                    },
                                    {
                                        "sense_id": "94030a93-afd6-3a29-a814-a8b7bb886e47",
                                        "entry_id": "0713647d-d672-393d-b3a3-d046710f4f72",
                                        "glosses": [
                                            "sich wie eine Krankheit äußernd, von der Normalität abweichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
