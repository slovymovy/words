                        "translation_id": "0c50fb10-11ad-406b-9063-551efb2b6383",
                        "source_entry_id": "49af89f7-984e-3503-b7c8-3015542cd4e9",
                        "source_sense_id": "94817e14-d21f-3a02-9d3e-37e8759db6f3",
                        "source_sense_description": "bildungssprachlich: Eigenschaft, autoritär und herrisch zu sein",
                        "target_lang_word": "autoritarisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autoritarisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5852963b-d7af-3c78-9a66-04250e4dca23",
                                        "entry_id": "e973bab9-8cb0-3c76-8224-a97437c93319",
                                        "glosses": [
                                            "Manière d’agir de ceux qui font de l’autorité le principe de leur action, de leur parole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e13bae-6b29-47ef-8d5e-87de5cfd71c6",
                                                "sense_id": "5852963b-d7af-3c78-9a66-04250e4dca23",
                                                "text": "Après six mois d’autoritarisme désordonné : procès de presse à tort et à travers, révocations irritantes de fonctionnaires, persécutions de tout ordre, l’entreprise du Seize Mai échouait piteusement."
                                            },
                                            {
                                                "example_id": "5b0949dc-d801-4beb-b2c4-bd949155839b",
                                                "sense_id": "5852963b-d7af-3c78-9a66-04250e4dca23",
                                                "text": "En Allemagne, en France, et même dans l’Angleterre victorienne, la montée de l’autoritarisme familial produit des schizophrènes, des suicidés, des alcooliques. L'éducation devient persécution."
                                            },
                                            {
                                                "example_id": "7f01c143-ff5a-4151-9fa1-f2acb2a8b87f",
                                                "sense_id": "5852963b-d7af-3c78-9a66-04250e4dca23",
                                                "text": "Donald Trump a failli lamentablement, mais il a quand même presque été réélu. On peine à imaginer jusqu’où un leader avec tous ses atouts, l’appui inconditionnel d’un grand parti et avec en prime la compétence, aurait pu – ou pourrait un jour – mener les États-Unis dans la voie vers l’autoritarisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
