                                "target_senses": [
                                    {
                                        "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                                        "entry_id": "35c7a51d-1419-37ca-a718-f020370daf89",
                                        "glosses": [
                                            "Bonbon am Stiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51b07bcd-eb06-451e-90e6-02f4bced7f70",
                                                "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                                                "text": "Ich lutsche einen Lolli."
                                            },
                                            {
                                                "example_id": "dfbdcb3d-5e58-492d-ac27-0d944a3e87f5",
                                                "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                                                "text": "Sie hat den Lolli ihrem Sohn geschenkt."
                                            },
                                            {
                                                "example_id": "814491d5-b1de-4e22-a69f-565446ddf3b5",
                                                "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                                                "text": "„Der Verkäufer streichelte Chrissi zum Abschied über den Kopf, und sie strahlte über das ganze Gesicht, weil der Honig ihren Finger in einen süßen Lolli verwandelt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee8e8dba-011a-4bf0-9b02-56f9501da16f",
                        "source_entry_id": "234c41c4-6c78-3bf4-b2a8-9172e20a14fc",
                        "source_sense_id": "10be1a05-91d1-317c-8950-4110c3db5e58",
                        "source_sense_description": "snoepje",
                        "target_lang_word": "Lutscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lutscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10a2ad1e-4324-3d03-8be5-7d29a7db305f",
                                        "entry_id": "6cd58421-37b2-3c2e-87da-b62981d43de8",
                                        "glosses": [
                                            "Bonbon am Stiel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a102bd4d-3479-43fc-be27-658bbba71349",
                                                "sense_id": "10a2ad1e-4324-3d03-8be5-7d29a7db305f",
                                                "text": "Lea hob den Lutscher vom Boden auf, beachtete die kleinen Dreckkrümel daran nicht weiter und steckte ihn in den Mund."
                                            },
                                            {
                                                "example_id": "f7750f88-171c-44bd-95d0-b3ab4776edc1",
                                                "sense_id": "10a2ad1e-4324-3d03-8be5-7d29a7db305f",
                                                "text": "„Als mein Lutscher alle war, kaute ich noch den Stiel durch.“"
                                            },
                                            {
                                                "example_id": "216acc90-a1ad-4b7c-9e3c-6bfa222f7dc3",
                                                "sense_id": "10a2ad1e-4324-3d03-8be5-7d29a7db305f",
                                                "text": "„Die Frau schenkte Rosa und Bobby jeweils einen Lutscher mit Zitronengeschmack.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5574f60-c9fe-3bc4-880c-da9cfa1f716a",
                                        "entry_id": "6cd58421-37b2-3c2e-87da-b62981d43de8",
                                        "glosses": [
                                            "Versager, Schmarotzer"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a104869-1820-494d-b79e-e7b7c5c5a3cc",
                                                "sense_id": "d5574f60-c9fe-3bc4-880c-da9cfa1f716a",
                                                "text": "Du Lutscher kannst mir gar nichts!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bc4df787-d774-38e5-95b7-9d6c0b43a803",
                                        "entry_id": "6cd58421-37b2-3c2e-87da-b62981d43de8",
                                        "glosses": [
                                            "Schnuller"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789cb33f-7847-4200-8586-3b74aa65db4b",
                                                "sense_id": "bc4df787-d774-38e5-95b7-9d6c0b43a803",
                                                "text": "Wenn es schreit, steck ihm einfach den Lutscher in den Mund!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e2af8d6e-a32a-3a61-92d3-b450988685bb",
                                        "entry_id": "6cd58421-37b2-3c2e-87da-b62981d43de8",
                                        "glosses": [
                                            "Person, die sich im Windschatten anderer Fahrer hält"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f8e0cb8-9ea4-4718-aa77-ca50cbddcb4f",
                                                "sense_id": "e2af8d6e-a32a-3a61-92d3-b450988685bb",
                                                "text": "Sei kein Lutscher, das ist unsportlich!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3336ca41-7d89-4897-ba35-61c234a7c706",
                        "source_entry_id": "234c41c4-6c78-3bf4-b2a8-9172e20a14fc",
