                ],
                "senses": [
                    {
                        "sense_id": "ce169872-ade2-39ba-8fab-784adb4b4e8e",
                        "entry_id": "451962dc-48e8-3756-b7eb-4e15a53176cd",
                        "glosses": [
                            "Eigenschaft/Zustand von etwas, nicht klar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4144e013-0645-48a6-af77-018e8002f617",
                                "sense_id": "ce169872-ade2-39ba-8fab-784adb4b4e8e",
                                "text": "„Jetzt entdeckte er zu seinem eigenen Erstaunen, dass es in allen diesen Fragen gar keine Unklarheit und Ratlosigkeit mehr gab.“"
                            },
                            {
                                "example_id": "1a881864-c21c-4dae-ad02-ee71866789f3",
                                "sense_id": "ce169872-ade2-39ba-8fab-784adb4b4e8e",
                                "text": "„Und nun trat er wieder an Cécile heran, um sich wegen einiger ihm vorgeworfenen Unklarheiten in seinem gestrigen Morgenbillet, so gut es ging, zu verantworten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bb1b17d2-5995-3d20-b932-cfd928ffc06b",
                        "entry_id": "451962dc-48e8-3756-b7eb-4e15a53176cd",
                        "glosses": [
                            "jemand oder etwas mit Bedingung [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "950fac6f-9316-4a62-b1e3-43b56a7dce60",
                                "sense_id": "bb1b17d2-5995-3d20-b932-cfd928ffc06b",
                                "text": "Es ist nötig, auch die letzten Unklarheiten zu beseitigen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
