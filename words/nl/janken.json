                    "sense_definition": "op een luidruchtige of vervelende manier huilen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "huilen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit hij daar nu alweer te <w>janken</w> als een klein kind?",
                            "target_lang_translations": {
                                "en": "Is he sitting there <w>bawling</w> like a little child again?"
                            }
                        },
                        {
                            "text": "Stop met dat <w>janken</w> en vertel me wat er echt aan de hand is.",
                            "target_lang_translations": {
                                "en": "Stop that <w>whining</w> and tell me what is really going on."
                            }
                        }
                    ],
                    "synonyms": [
                        "grienen",
                        "huilen",
                        "jammeren",
                        "blèren"
                    ],
                    "antonyms": [
                        "lachen"
                    ],
                    "common_phrases": [
                        "zitten te janken",
                        "janken als een kind"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cry in a loud, annoying, or persistent manner, often used pejoratively."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to whine",
                                "target_lang_sense_clarification": "complaining in an annoying way"
                            },
                            {
                                "target_lang_word": "to bawl",
                                "target_lang_sense_clarification": "crying loudly and uncontrollably"
                            },
                            {
                                "target_lang_word": "to blubber",
                                "target_lang_sense_clarification": "crying noisily and excessively"
                            },
                            {
                                "target_lang_word": "to cry",
                                "target_lang_sense_clarification": "general term, but used informally for janken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76be2f26-d4ed-3658-89c2-b80653ef38c8",
                    "sense_definition": "een langgerekt, klagend geluid maken, meestal door honden of wolven",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond <w>jankte</w> zachtjes door de pijn in zijn poot.",
                            "target_lang_translations": {
                                "en": "The dog <w>whined</w> softly because of the pain in its paw."
                            }
                        },
                        {
                            "text": "In de verte hoorden we een wolf <w>janken</w> naar de maan.",
                            "target_lang_translations": {
                                "en": "In the distance, we heard a wolf <w>howling</w> at the moon."
                            }
                        }
                    ],
                    "synonyms": [
                        "huilen"
                    ],
                    "common_phrases": [
                        "janken naar de maan"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a long, high-pitched, complaining sound, typically by dogs or wolves."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to whine",
                                "target_lang_sense_clarification": "a high-pitched cry from a dog"
                            },
                            {
                                "target_lang_word": "to howl",
                                "target_lang_sense_clarification": "a long, loud cry by a wolf or dog"
                            },
                            {
                                "target_lang_word": "to yelp",
                                "target_lang_sense_clarification": "a short, sharp cry of pain"
                            }
                        ]
