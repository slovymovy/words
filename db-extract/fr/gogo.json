        "fr-extract.jsonl": [
            {
                "entry_id": "eeb18ee4-8eaf-3f34-855e-da609232ec2a",
                "word": "gogo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b385daa-ad9b-441c-a972-dee1473bc02e",
                        "entry_id": "eeb18ee4-8eaf-3f34-855e-da609232ec2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "gogos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee62ac31-e024-3b0d-bd56-41d7f1763c9a",
                        "entry_id": "eeb18ee4-8eaf-3f34-855e-da609232ec2a",
                        "glosses": [
                            "Personne qui est d’une crédulité niaise et se laisse facilement duper en matière d’affaires et de finances."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "775de1c2-6fa8-4f0b-a0cf-415bf7e069f4",
                                "sense_id": "ee62ac31-e024-3b0d-bd56-41d7f1763c9a",
                                "text": "Eh bien ! moi, j’aime mieux un mange-tout, passionné comme toi pour les femmes, que ces froids banquiers sans âme qu’on dit vertueux et qui ruinent des milliers de familles avec leurs rails qui sont de l’or pour eux et du fer pour les Gogos !"
                            },
                            {
                                "example_id": "d82dec4d-f846-4b19-9c43-a53e3642abe3",
                                "sense_id": "ee62ac31-e024-3b0d-bd56-41d7f1763c9a",
                                "text": "Il n’y a pas un jour qu’on n’entende parler d’avoués, de notaires, de banquiers, d’assureurs de toutes catégories qui se sont sauvés à l’étranger avec des millions volés aux gogos, avec la complicité des lois et des magistrats."
                            },
                            {
                                "example_id": "f7101098-44f8-4cb1-ae63-9b4a797679c4",
                                "sense_id": "ee62ac31-e024-3b0d-bd56-41d7f1763c9a",
                                "text": "Mais voilà, tant qu’il y aura des gogos, il y aura des affaires véreuses, des gens pour les lancer et des « experts » intéressés pour faire de très beaux rapports."
                            },
                            {
                                "example_id": "a51bc6d9-b5bf-46d4-b37b-4179d0a8ac48",
                                "sense_id": "ee62ac31-e024-3b0d-bd56-41d7f1763c9a",
                                "text": "« Nous en avons assez de cette littérature au jus de serpillière, de ce vocabulaire crapuleux pour snobinards décomposés, de ces personnages maladifs, hagards et malfaisants, et de ces auteurs qui jouent la note naturaliste pour étonner les gogos. »"
                            },
                            {
                                "example_id": "8f355cc6-1f3b-4a00-a768-fdee15e01c6d",
                                "sense_id": "ee62ac31-e024-3b0d-bd56-41d7f1763c9a",
                                "text": "C’est des conneries pour les gogos de ton espèce, tu comprends ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90c48ac0-8c04-48f7-9d61-840a6fd05d4d",
                        "source_entry_id": "eeb18ee4-8eaf-3f34-855e-da609232ec2a",
                        "source_sense_id": "ee62ac31-e024-3b0d-bd56-41d7f1763c9a",
                        "target_lang_word": "dupe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dupe",
