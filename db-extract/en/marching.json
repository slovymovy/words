                        ],
                        "examples": [
                            {
                                "example_id": "71848c44-5854-43a8-b566-aba032c8d8bd",
                                "sense_id": "9142e442-658f-36e6-b985-6c63ef51dd08",
                                "text": "[T]he occasional trees, the stone-heaps, the marching fences, the stumps, the saplings, the cows, and the feeding sheep."
                            }
                        ]
