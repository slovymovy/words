                        ]
                    },
                    {
                        "translation_id": "9042b3e4-70d1-48ca-a5e8-b4068e6cdb73",
                        "source_entry_id": "10d7ab86-3d34-31b3-8376-c5376c131dd8",
                        "source_sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                        "source_sense_description": "wood intended to be burned, typically for heat",
                        "target_lang_word": "brandhout",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brandhout",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "edbebdf5-bb58-3239-85d9-b570188fcfc7",
                                        "entry_id": "123a893b-9b83-3fd5-adce-50918538e471",
                                        "glosses": [
                                            "hout dat gebruikt wordt om te verbranden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa59bae3-6153-4015-aebc-d87a6e6515e5",
                                                "sense_id": "edbebdf5-bb58-3239-85d9-b570188fcfc7",
                                                "text": "Het brandhout was bijna op, dus werd er een boom omgehakt."
                                            },
                                            {
                                                "example_id": "bc932f7e-ebd1-4e71-8571-805cc061c739",
                                                "sense_id": "edbebdf5-bb58-3239-85d9-b570188fcfc7",
                                                "text": "De geur van groene zeep, het geknetter van het verse en harsrijke brandhout in de speksteenkachel en het vliesje ijs op de pis waren dus een reinigingsbad voor zijn ziel, een verheven herinnering aan hoeveel hij aan God te danken had."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a06339a5-1366-3433-8dcd-485020170dcc",
                                        "entry_id": "123a893b-9b83-3fd5-adce-50918538e471",
                                        "glosses": [
                                            "hout van een te slechte kwaliteit om er iets van te maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9042d7-f2b8-4937-95c8-4c1e9df3e386",
                                                "sense_id": "a06339a5-1366-3433-8dcd-485020170dcc",
                                                "text": "De bank was gemaakt van brandhout en stortte meteen in elkaar toen de jongen erop ging zitten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a555d9b-71a5-462e-bb09-f09fc7fda485",
                        "source_entry_id": "10d7ab86-3d34-31b3-8376-c5376c131dd8",
                        "source_sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                        "source_sense_description": "wood intended to be burned, typically for heat",
                        "target_lang_word": "bois de chauffage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bois de chauffage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                        "entry_id": "53347ea6-1fa3-31ca-af19-42b49c314a0b",
                                        "glosses": [
                                            "Bois destiné à être brûlé pour le chauffage d’une habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eba00c2-26ac-470e-9bca-048881f6739b",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Il n'était plus exilé dans la petite maison en ruines du Rialto, réduit à transporter du bois de chauffage dans sa gondole rapiécée, en danger perpétuel de pécher seul par la faute des rouées qui ne sont même pas encore filles mais qui coquinent comme si elles l'étaient."
                                            },
                                            {
                                                "example_id": "85c6a464-f862-429d-af89-18e13f0ac986",
                                                "sense_id": "91783f41-0ba9-3be5-b4f0-b2224f457c99",
                                                "text": "Cela peut donc ensuite servir de bois de chauffage, d’agro-carburant ou encore de matériau de construction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aeae2837-3ac7-4d19-99dd-16fe6a43f252",
                        "source_entry_id": "10d7ab86-3d34-31b3-8376-c5376c131dd8",
                        "source_sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                        "source_sense_description": "wood intended to be burned, typically for heat",
                        "target_lang_word": "Brennholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brennholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                        "entry_id": "6f72fcdb-8088-3436-8917-92753da8aecb",
                                        "glosses": [
                                            "Holz, das zum Heizen oder Kochen verbrannt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2affdf3-272f-4671-bb7b-34a362f25982",
                                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                                "text": "Ich gehe heute in den Wald, um Brennholz zu sammeln."
                                            },
                                            {
                                                "example_id": "78d7b83b-6755-4d68-b167-e7724b0b8b13",
                                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                                "text": "„Als er einen ausreichenden Vorrat an Brennholz aufgestapelt hatte, beschloss er, gleich ein Signalfeuer zu machen.“"
                                            },
                                            {
                                                "example_id": "6f2f3f5e-7d65-4edf-ac0c-8fb5db5d4eee",
                                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                                "text": "„Mit Brennholz schwer bepackte Frauen trabten ins Tal.“"
                                            },
                                            {
                                                "example_id": "ed910185-77b3-4920-ab3d-f009b3cd5722",
                                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                                "text": "„Tagsüber verließ sie mit ein paar Frauen und kleinen Kindern das Lager, um Brennholz zum Kochen zu sammeln, eskortiert von Soldaten der Friedenstruppe der Afrikanischen Union.“"
                                            },
                                            {
                                                "example_id": "5fa1fc97-4c6c-4b95-bf44-6f07a579cd02",
                                                "sense_id": "160e89ea-2e17-33c1-b873-630acd358081",
                                                "text": "„Brennholz gab es ausreichend, und überall wurde gefeuert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73c5dce1-9f15-475e-9677-1d354a3aad61",
                        "source_entry_id": "10d7ab86-3d34-31b3-8376-c5376c131dd8",
                        "source_sense_id": "319ff822-7413-33dc-956d-ee00d64bf638",
                        "source_sense_description": "wood intended to be burned, typically for heat",
                        "target_lang_word": "Feuerholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                        "entry_id": "ad27fbd7-7c9d-3083-ab1a-93eb4640d54c",
                                        "glosses": [
                                            "Holz, das zum Heizen oder Kochen genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edfbe573-91c2-4976-9a42-1238ea2e5ae5",
                                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                                "text": "Das Feuerholz aus dem Wald ist noch nass und muss erst getrocknet werden."
                                            },
                                            {
                                                "example_id": "b04ce935-d4c0-47b2-8604-c4a95a3c15ad",
                                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                                "text": "„Als wir Feuerholz suchten, entdeckten wir eine Wegkreuzung und menschliche Spuren, die vielleicht acht Tage alt waren.“"
                                            },
                                            {
                                                "example_id": "7f1d4850-a1f1-4505-bc36-518c7f5fe06e",
                                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                                "text": "„Er brauchte Unmengen Feuerholz und den Rest des Tages pendelte Brian zwischen dem Lagerplatz und dem Wald hin und her, um genug Äste heranzuschleppen.“"
                                            },
                                            {
                                                "example_id": "20ba31cf-733e-44d9-a0c2-d30413dba7c2",
                                                "sense_id": "35a57b8a-857a-3378-b272-4ff8f4042c57",
                                                "text": "„Er war gerade dabei, Feuerholz zu sammeln, als er sah, wie sie aus Maria Antonownas Haus und über die schneebedeckte Straße in Richtung Wald schoss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
