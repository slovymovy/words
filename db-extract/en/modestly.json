    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                "word": "modestly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "90b96b5a-38f3-4e4c-9fc5-0d9483c558ad",
                        "entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more modestly"
                    },
                    {
                        "form_id": "943d92a0-de45-4a37-86a7-7a26f73872d6",
                        "entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most modestly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7d074ed-56f7-3ac2-9c29-989dda9c56c2",
                        "entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                        "glosses": [
                            "In a modest manner; with humility."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9eeef8-a3b4-4d48-85d6-3045afcc6311",
                                "sense_id": "a7d074ed-56f7-3ac2-9c29-989dda9c56c2",
                                "text": "The man bowed modestly and left the dinner table."
                            },
                            {
                                "example_id": "b4ebcc62-5e60-4d09-b40e-64f0287076d8",
                                "sense_id": "a7d074ed-56f7-3ac2-9c29-989dda9c56c2",
                                "text": "An hour later, Trump and Starmer were gathered in the modestly named Donald J Trump Ballroom for the press conference proper."
                            }
                        ]
                    },
                    {
                        "sense_id": "465931d8-aa49-34d7-b5cf-58606e2d670d",
                        "entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                        "glosses": [
                            "To a small degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40e3ba7-df23-4f8f-88cd-7172b012034f",
                                "sense_id": "465931d8-aa49-34d7-b5cf-58606e2d670d",
                                "text": "These new shuttlelike craft might modestly reduce the cost of getting to low earth orbit."
                            },
                            {
                                "example_id": "3325b01a-9e01-4339-a931-d069637db88d",
                                "sense_id": "465931d8-aa49-34d7-b5cf-58606e2d670d",
                                "text": "One of several factors to his success this election was modestly boosting his support among men, a shift concentrated among younger voters, according to AP VoteCast, survey of more than 120,000 voters nationwide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09c0b101-bdfd-4370-bc01-286169df32ad",
                        "source_entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                        "source_sense_description": "in a modest manner",
                        "target_lang_word": "bescheiden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bescheiden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cb197f-1305-3fba-a161-b3285d97f8c7",
                                        "entry_id": "0c854811-ddd1-32a5-884f-e9daa947fabf",
                                        "glosses": [
                                            "geen te hoge verwachtingen van zichzelf hebbend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd99a135-27a4-4e4d-bdd0-96f038e60281",
                                                "sense_id": "c1cb197f-1305-3fba-a161-b3285d97f8c7",
                                                "text": "Hij is een zeer bescheiden jongen, maar hij heeft veel talent."
                                            },
                                            {
                                                "example_id": "8d5892f6-a10d-4aa7-a0f9-41fc148264ca",
                                                "sense_id": "c1cb197f-1305-3fba-a161-b3285d97f8c7",
                                                "text": "De Franse president Macron prijst de paus ook voor zijn inzet voor armen en kwetsbaren. Hij noemt hem een bescheiden man die \"altijd aan de zijde van de meest kwetsbaren stond\". De Notre-Dame in Parijs luidt de klokken 88 keer als eerbetoon aan de paus, die 88 jaar is geworden."
                                            },
                                            {
                                                "example_id": "c3566924-73d8-4370-863a-06b51e8d2d18",
                                                "sense_id": "c1cb197f-1305-3fba-a161-b3285d97f8c7",
                                                "text": "Hij stelde zich bescheiden op."
                                            },
                                            {
                                                "example_id": "f0b97b3d-2c6f-4ac0-8b6f-3d7c07f80799",
                                                "sense_id": "c1cb197f-1305-3fba-a161-b3285d97f8c7",
                                                "text": "Ze was heel lief, stelde me gerust en ik heb haar leren kennen als een bescheiden en warme vrouw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d60eff0c-17d3-3640-a5de-4f90de007985",
                                        "entry_id": "0c854811-ddd1-32a5-884f-e9daa947fabf",
                                        "glosses": [
                                            "oordeel hebbende, verstandig"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a90ae50e-0431-430f-876c-b2fb16cc2eac",
                                                "sense_id": "d60eff0c-17d3-3640-a5de-4f90de007985",
                                                "text": "Aan den bescheiden lezer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "814d5781-8f32-3609-8b2a-f8e3081586f1",
                                        "entry_id": "0c854811-ddd1-32a5-884f-e9daa947fabf",
                                        "glosses": [
                                            "niet groots of talrijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "889cff55-ba5a-49b5-a810-2bec9da6ffab",
                                                "sense_id": "814d5781-8f32-3609-8b2a-f8e3081586f1",
                                                "text": "Met bescheiden hulpmiddelen trok hij het oerwoud in."
                                            },
                                            {
                                                "example_id": "b12e8dc8-ed27-4188-a84e-2bda68001758",
                                                "sense_id": "814d5781-8f32-3609-8b2a-f8e3081586f1",
                                                "text": "ING wil de beloning van zijn huidige bestuursvoorzitter dit jaar met ruim 50 procent verhogen, tot ruim 3 miljoen euro. Zelfs na de verhoging blijft zijn loon \"bescheiden\" in vergelijking met vergelijkbare bedrijven, stelt ING."
                                            },
                                            {
                                                "example_id": "03aaa859-5da7-4357-9307-16db7b5fc493",
                                                "sense_id": "814d5781-8f32-3609-8b2a-f8e3081586f1",
                                                "text": "De economie van Rusland is vrij bescheiden en ongeveer even groot als de drie Benelux-landen bij elkaar."
                                            },
                                            {
                                                "example_id": "53ae2f1f-fc79-4078-86be-a6d1db214943",
                                                "sense_id": "814d5781-8f32-3609-8b2a-f8e3081586f1",
                                                "text": "De andere vleugel biedt ruimte aan de lounge, de ontbijtzaal en ons bescheiden restaurant, waar ik een vaste tafel voor u heb gereserveerd aan het raam met uitzicht op de pergola en de rozentuin, of wat daarvan over is, waarachter u de vijver kunt zien glinsteren. De fontein is helaas al een paar jaar buiten gebruik, maar ik kan u verzekeren dat onze kokkin haar uiterste best zal doen om u mild te stemmen jegens dit euvel.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9912c4e1-c8d1-362e-bfb7-7d4a6eb7474b",
                                        "entry_id": "0c854811-ddd1-32a5-884f-e9daa947fabf",
                                        "glosses": [
                                            "niet opdringerig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664d0fab-421a-42cf-af12-9fcd2069503f",
                                                "sense_id": "9912c4e1-c8d1-362e-bfb7-7d4a6eb7474b",
                                                "text": "Naar mijn bescheiden mening is dat niet waar."
                                            },
                                            {
                                                "example_id": "779cdc77-05ec-4436-9209-55c2150521f2",
                                                "sense_id": "9912c4e1-c8d1-362e-bfb7-7d4a6eb7474b",
                                                "text": "Albert Maillard. Hij was een slanke jongen met een enigszins traag, bescheiden karakter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bescheiden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "96c51ce9-e024-37d5-ad17-4d77219975cb",
                                        "entry_id": "399fe6c3-110d-3f27-af56-1fec80c0d79d",
                                        "glosses": [
