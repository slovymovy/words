                        "entry_id": "e5ac6d10-9fd6-3044-bc0d-fe6e9501edad",
                        "glosses": [
                            "wywodzący się z założeń, tez utworzonych przez Immanuela Kanta; związany z jego filozofią"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a14e8d0-f229-4f18-93c0-c05cfc8c247e",
                                "sense_id": "72ff415f-1505-30bc-8d2f-cbd4262234f9",
                                "text": "Innym przykładem całkowicie nowego sposobu myślenia jest kantowskie przekonanie o niepoznawalności świata rzeczy samych w sobie, z jednoczesnym uznawaniem przez niego poznawalności świata zjawisk"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
