                "senses": [
                    {
                        "sense_id": "553782d2-0a8a-3528-850b-4e0b02bbc6cc",
                        "entry_id": "22fb51de-da04-36b1-8829-5b83d3b9393e",
                        "glosses": [
                            "Genre de la famille des pinacées (Pinaceae ou famille des pins), originaire d’Asie et d’Amérique du Nord.→ voir Tsuga"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa3a0d9e-564b-49ff-b058-060535fdd7a0",
                                "sense_id": "553782d2-0a8a-3528-850b-4e0b02bbc6cc",
                                "text": "Les tsugas se distinguent par des aiguilles planes comme celles des sapins, avec les cônes pendants comme ceux des épicéas."
                            }
                        ]
                    },
                    {
                        "sense_id": "372edb5a-90e8-3146-a9a3-2b141fa91867",
                        "entry_id": "22fb51de-da04-36b1-8829-5b83d3b9393e",
                        "glosses": [
                            "Arbres de ce genre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724e3f75-4e72-44e3-b2cd-ae4c45ce73d4",
                                "sense_id": "372edb5a-90e8-3146-a9a3-2b141fa91867",
                                "text": "Une petite rivière, encaissée, coule juste au-dessous du bois d’épinettes, d’épicéas et de tsugas, tout en velours bleu sombre et gris clair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
