                "senses": [
                    {
                        "sense_id": "be1bf3e0-93d4-368a-a29d-55ebf27f605a",
                        "entry_id": "99759dc0-a7e5-39d1-943a-232f41ff5548",
                        "glosses": [
                            "Orthographe ancienne, qui se rencontre aux XVIIᵉ et XVIIIᵉ siècles, de enflammer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c87034ab-7eed-40e2-9994-2133c3fce101",
                                "sense_id": "be1bf3e0-93d4-368a-a29d-55ebf27f605a",
                                "text": "Mais sa fureur ne fut pas encore satisfaite, & la constance des Martyrs ne fit que l’enflâmer davantage."
                            },
                            {
                                "example_id": "0694a68e-1b97-4bd9-ae10-6e920a6ad1a0",
                                "sense_id": "be1bf3e0-93d4-368a-a29d-55ebf27f605a",
                                "text": "Dans un si beau jour tout doit s’enflâmer, Le tems heureux des Jeux est le tems d’aimer."
                            }
                        ]
                    }
