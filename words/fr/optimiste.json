    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9442f5fe-75e1-39bd-a7b6-cd7be149d7d8",
                    "sense_definition": "Qui est naturellement disposé à voir le bon côté des choses et à envisager l'avenir avec confiance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les difficultés actuelles, mon frère reste toujours <w>optimiste</w> pour la suite de ses études."
                        },
                        {
                            "text": "Elle a une nature <w>optimiste</w> qui lui permet d'aborder chaque nouvelle journée avec le sourire."
                        }
                    ],
                    "synonyms": [
                        "positif",
                        "confiant"
                    ],
                    "antonyms": [
                        "pessimiste"
                    ],
                    "common_phrases": [
                        "nature optimiste",
                        "rester optimiste"
                    ]
                },
                {
                    "sense_id": "51bd9432-3276-3b54-ad5e-f217336bbc29",
                    "sense_definition": "Qui laisse présager une évolution favorable ou prometteuse ; encourageant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analystes économiques ont publié des prévisions <w>optimistes</w> pour la croissance de l'année prochaine."
                        },
                        {
                            "text": "Ce scénario <w>optimiste</w> repose sur une baisse rapide de l'inflation au cours des prochains mois."
                        }
                    ],
                    "synonyms": [
                        "encourageant",
                        "favorable",
                        "prometteur"
                    ],
                    "antonyms": [
                        "pessimiste"
                    ],
                    "common_phrases": [
                        "prévisions optimistes",
                        "scénario optimiste"
                    ]
                },
                {
                    "sense_id": "1da423c7-6c81-31a3-b42e-a63c00ecef33",
                    "sense_definition": "Relatif à la doctrine ou au système philosophique de l'optimisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur consacre son cours d'histoire des idées à l'étude de la doctrine <w>optimiste</w> de Leibniz."
                        },
                        {
                            "text": "Cette philosophie <w>optimiste</w> soutient que notre monde est le meilleur des mondes possibles."
                        }
                    ],
                    "common_phrases": [
                        "doctrine optimiste",
                        "philosophie optimiste"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c2e35b7-9b17-3074-9a75-0ca434a17804",
                    "sense_definition": "Personne qui a une disposition naturelle à voir les aspects positifs de la vie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père est un éternel <w>optimiste</w> qui trouve toujours une raison de se réjouir."
                        },
                        {
                            "text": "En vrai <w>optimiste</w>, elle refuse de céder à l'inquiétude devant les imprévus du quotidien."
                        }
                    ],
                    "antonyms": [
                        "pessimiste"
                    ],
                    "common_phrases": [
                        "éternel optimiste",
                        "grand optimiste"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4bdbebf5-5661-3e64-a599-3ed079705852",
                    "sense_definition": "Prénom masculin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Optimiste</w> est un prénom très rare dont l'usage reste tout à fait exceptionnel en France."
                        },
                        {
                            "text": "Le jeune <w>Optimiste</w> a reçu ce prénom original en hommage à l'esprit positif de sa famille."
                        }
                    ]
                }
            ]
        }
    ]
