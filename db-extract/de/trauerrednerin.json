                        "sense_id": "2a0281d9-22d0-3a6a-8369-7ace0c737f58",
                        "entry_id": "e47630e2-c5a0-31b4-8cd1-ac41d30be46e",
                        "glosses": [
                            "Frau, die eine Trauerrede hält und auch andere Aufgaben im Rahmen der Trauerfeier übernehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "883b11e8-5557-476c-879c-bb9da0c496f9",
                                "sense_id": "2a0281d9-22d0-3a6a-8369-7ace0c737f58",
                                "text": "„Sie würden die Grabrede zusammen schreiben, hatten sie beschlossen, die dann von einer Trauerrednerin verlesen würde, denn keine der beiden Frauen fühlte sich stark genug, selbst aufzustehen und zu sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
