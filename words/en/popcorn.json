        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60b8b03a-85a6-3e3c-b7ad-cf90f5007c27",
                    "sense_definition": "To stand or jump up quickly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The excited guinea pig began to <w>popcorn</w> around its cage when I brought in fresh vegetables.",
                            "target_lang_translations": {
                                "ru": "Взволнованная морская свинка начала <w>попкорнить</w> по клетке, когда я принес свежие овощи.",
                                "zh": "当我拿来新鲜蔬菜时，兴奋的豚鼠开始在笼子里<w>跳跃</w>。",
                                "es": "El conejillo de indias, emocionado, empezó a <w>dar saltitos</w> por su jaula cuando traje verduras frescas."
                            }
                        },
                        {
                            "text": "It is fun to watch the small animals <w>popcorn</w> with joy.",
                            "target_lang_translations": {
                                "ru": "Забавно наблюдать, как маленькие зверьки <w>подпрыгивают</w> от радости.",
                                "zh": "看着小动物们高兴地<w>跳跃</w>很有趣。",
                                "es": "Es divertido ver a los animalitos <w>brincar</w> de alegría."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used primarily by pet owners to describe guinea pig behavior"
                        }
                    ],
