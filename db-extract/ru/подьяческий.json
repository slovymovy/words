                ],
                "senses": [
                    {
                        "sense_id": "ff0e566d-9056-3214-af87-0d008480b6fc",
                        "entry_id": "fdcf1522-72bc-3993-a408-b58cc6337588",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным подьячий; свойственный, характерный для подьячего; чиновничий, канцелярский"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec10e752-846c-45fc-a6f1-92626231a429",
                                "sense_id": "ff0e566d-9056-3214-af87-0d008480b6fc",
                                "text": "У нас, почтеннейший, и не такие, как ты, люди полируются и военная их косточка мигом привыкает к нашему подьяческому хомутику."
                            }
                        ]
                    },
                    {
                        "sense_id": "a081b808-e988-3e72-b7ed-b7717457bf72",
                        "entry_id": "fdcf1522-72bc-3993-a408-b58cc6337588",
                        "glosses": [
                            "принадлежащий подьячему"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b26dcf-1d5b-45b0-9cc1-8d00254d28b9",
                                "sense_id": "a081b808-e988-3e72-b7ed-b7717457bf72",
                                "text": "К сему извету подьяческой сын Андреян Лошаков вместо доносителя Ивана Каина по ево прошению руку приложил."
                            }
                        ]
                    }
