                        "entry_id": "b6e04c68-460b-3a7b-aeaa-3bf0199d36ac",
                        "glosses": [
                            "oficjalne uznanie zmarłego za świętego i zezwolenie na jego publiczny kult w Kościele katolickim lub Cerkwi prawosławnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ce2f00-5918-4681-b825-eb167fcc0bd8",
                                "sense_id": "7bcc3bb8-5f3a-31a5-9dcf-a0479b2e1103",
                                "text": "Wczoraj papież dokonał kolejnej kanonizacji."
                            }
