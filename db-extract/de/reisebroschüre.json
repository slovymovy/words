                "senses": [
                    {
                        "sense_id": "015bf098-5e32-35ba-9ad7-1fb9d793f0eb",
                        "entry_id": "e777094d-9e07-3e04-944f-0b0231223b6b",
                        "glosses": [
                            "kleine, geheftete, nicht gebundene Schrift mit wenigen Seiten, in der für Reisen geworben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c137aab-b089-456d-b3a4-b29564e5093d",
                                "sense_id": "015bf098-5e32-35ba-9ad7-1fb9d793f0eb",
                                "text": "„Im Bus nach Landskrona las sie Reisebroschüren.“"
                            },
                            {
                                "example_id": "ef34e32d-5e5b-4a5a-865a-2c8f94a27452",
                                "sense_id": "015bf098-5e32-35ba-9ad7-1fb9d793f0eb",
                                "text": "„Zum Glück fand der Großteil seiner überschwänglichen Rede, die aus einer Reisebroschüre hätte stammen können, im Wagen statt, sodass ich nur Bruchteile davon zu hören bekam, als wir anhielten, um unser Nachtlager aufzuschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
