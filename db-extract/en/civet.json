                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd8bf492-1e3e-361c-a88c-9fcc92ba47e6",
                                        "entry_id": "9263ca41-39b0-3ca1-9f63-f203842430eb",
                                        "glosses": [
                                            "Viverridé carnivore d’Afrique et d’Asie, au corps allongé, recherché pour le musc sécrété par deux glandes anales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a81a6d-cb4f-43e7-982e-2c72288b5a81",
                                                "sense_id": "dd8bf492-1e3e-361c-a88c-9fcc92ba47e6",
                                                "text": "La genette du bassin méditerranéen est la seule parente européenne des civettes."
                                            },
                                            {
                                                "example_id": "8af20895-62a8-42a8-ae05-c3f1d8a33c1f",
                                                "sense_id": "dd8bf492-1e3e-361c-a88c-9fcc92ba47e6",
                                                "text": "Cette dernière avait travaillé dans la cantine d’une usine située dans la ville de Quang Zhouxing, au nord de la Chine, qui servait de la civette, interdite à la consommation par le gouvernement après l’épidémie de SRAS de 2003."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9df7dd72-d5cd-3ade-a6c0-4b65b59ca60c",
                                        "entry_id": "9263ca41-39b0-3ca1-9f63-f203842430eb",
                                        "glosses": [
                                            "Fourrure de cet animal, également recherchée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "007f8699-d2fd-4fa0-ba43-412db2fa3796",
                                                "sense_id": "9df7dd72-d5cd-3ade-a6c0-4b65b59ca60c",
                                                "text": "La civette, la panthère, continuent à triompher sur les modèles du matin."
                                            },
                                            {
                                                "example_id": "a93824eb-0113-4b7b-9293-08eeed3b1073",
                                                "sense_id": "9df7dd72-d5cd-3ade-a6c0-4b65b59ca60c",
                                                "text": "Poupette se fit durement gronder et punir pour avoir perdu un collet de civette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "382ac3e2-1052-36ce-a749-b5391d130592",
                                        "entry_id": "9263ca41-39b0-3ca1-9f63-f203842430eb",
                                        "glosses": [
                                            "Musc de l’animal, utilisé dans la préparation de parfums."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655fe8c2-182b-4865-8c06-b85f7b5773ca",
                                                "sense_id": "382ac3e2-1052-36ce-a749-b5391d130592",
                                                "text": "L'odeur des chandelles fumeuses me vaut mieux que civette, benjoin, ambre gris."
                                            },
                                            {
                                                "example_id": "3f9a7a4a-52d7-4dd2-9ec7-7a0c9c1b6f1e",
                                                "sense_id": "382ac3e2-1052-36ce-a749-b5391d130592",
                                                "text": "Bien beau jeune homme tout de même... et bien mis, et flairant comme une civette."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "civette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93c0feaa-b598-3c11-96ed-6046b85250af",
                                        "entry_id": "3f97f2d8-7c2a-3fc0-9d41-6db4c96bfadb",
                                        "glosses": [
                                            "Tabac parfumé, tabac à priser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "462656f5-0046-4e0d-9dd0-306aa695a051",
                                                "sense_id": "93c0feaa-b598-3c11-96ed-6046b85250af",
                                                "text": "Il y avait des odeurs fines et piquantes qui faisaient froid dans le nez comme des prises de civette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea00eb9a-4fcd-33db-899e-cbe215ac2710",
                                        "entry_id": "3f97f2d8-7c2a-3fc0-9d41-6db4c96bfadb",
                                        "glosses": [
                                            "Débit de tabac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11dd8095-7284-4f15-b26c-93160aaaf6fc",
                                                "sense_id": "ea00eb9a-4fcd-33db-899e-cbe215ac2710",
                                                "text": "Nous avions eu jadis la curiosité d’esquisser ce calcul pour Marseille, en utilisant l’Annuaire du téléphone de l’année 1957. Il s’y trouvait un peu plus de 1 500 « bars » (y compris les « bars-restaurants » et « bars-tabacs » – mais non compris les lieux dénommés « café », « civettes », etc., et non compris les bars qui n’auraient pas le téléphone."
                                            },
                                            {
                                                "example_id": "eca0202c-ab76-4d3a-8c13-cdd3ed9f17b2",
                                                "sense_id": "ea00eb9a-4fcd-33db-899e-cbe215ac2710",
                                                "text": "Des bataillons de VRP lancés dans tout le pays à l’assaut des bars-tabacs, des tabacs-presse, des civettes repérables de loin grâce à leur célèbre carotte rouge."
                                            }
                                        ]
                                    }
                                ]
                            },
