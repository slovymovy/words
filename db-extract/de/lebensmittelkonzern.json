                "senses": [
                    {
                        "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                        "entry_id": "362f76e2-5097-354e-9312-1c0d5b9517b9",
                        "glosses": [
                            "Großunternehmen, das Nahrungsmittel oder Getränke industriell aufbereitet und verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c654d1f-7a54-4ebf-9265-2282718dbd27",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Der Lebensmittelkonzern behält die wichtigsten europäischen Wassermarken“ […]."
                            },
                            {
                                "example_id": "2caea3b6-eabc-4e44-a822-811affc3416f",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Der Schweizer Lebensmittelkonzern Nestlé“ […] „will das Risiko von Kinderarbeit reduzieren.“"
                            },
                            {
                                "example_id": "44f677bd-5914-49fd-b575-64e5457c22e7",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Der Lebensmittelkonzern Danone hat 2012 versucht, mit einem neuen, angeblich „umweltfreundlicheren“ Joghurtbecher in die Werbung zu gehen.“"
                            },
                            {
                                "example_id": "0c631e7f-a142-4ba5-ac5d-9f2b938a9925",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Zuvor war er Manager beim Lebensmittelkonzern Unilever,“ […]."
                            },
                            {
                                "example_id": "b9023627-a8e5-449f-84d5-57c1f3750ebb",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Dr. Oetker, ein deutscher Lebensmittelkonzern, löschte nach Bekanntwerden des Datenlecks seine Facebook-Seite für einen kurzen Zeitraum.“"
                            },
                            {
                                "example_id": "bb8ddc83-0a92-4bb5-bea2-bf2a559fb6dd",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Polar braut normalerweise 80 Prozent des Bieres in Venezuela und ist der größte private Lebensmittelkonzern des Landes.“"
                            },
                            {
                                "example_id": "4b9fcff1-d201-4fd5-ac84-8329900f05e0",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Der Pferdefleisch-Skandal hat nun den weltgrößten Lebensmittelkonzern erreicht: Nestlé nahm Tiefkühlgerichte in Italien, Spanien und Frankreich vom Markt. Das zugelieferte Fleisch stammt aus Deutschland.“"
                            },
                            {
                                "example_id": "92968388-045d-4423-850a-41f943d579cb",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Der Lebensmittelkonzern wächst weiter.“"
                            },
                            {
                                "example_id": "7947fef8-4871-49f5-9995-67f049255f7d",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Lebensmittelkonzerne lobbyieren massiv gegen die Zuckersteuer.“"
                            },
                            {
                                "example_id": "5e2b8f90-1325-4b09-96bd-edf22f54ec77",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Der Lebensmittelkonzern hat mit Problemen auf seinen Märkten in Russland und Brasilien zu kämpfen,“ […]."
                            },
                            {
                                "example_id": "506cc6dd-9749-4269-a862-eab1ea568e23",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Die indische Regierung fordert offenbar vom Lebensmittelkonzern knapp 100 Millionen Franken Schadenersatz wegen den zu hohen Bleiwerten in seinen Maggi-Nudeln.“"
                            },
                            {
                                "example_id": "364b75ca-6338-4d64-871c-9ecb5d792bf7",
                                "sense_id": "35cc94cd-4156-397e-abe6-7c32f416602e",
                                "text": "„Nach Korruptions- und Dopingvorwürfen will sich der Lebensmittelkonzern aus einem Sponsoringvertrag mit dem Leichtathletik-Weltverband zurückziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
