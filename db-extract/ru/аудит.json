                "senses": [
                    {
                        "sense_id": "243d02cb-584a-32e6-a50d-184d4daa1eff",
                        "entry_id": "83e426c3-a95d-3246-9685-f1b90a885afa",
                        "glosses": [
                            "фин. независимая проверка бухгалтерского учёта организации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4068398-8ed6-4645-b7ee-652ab0edfd71",
                                "sense_id": "243d02cb-584a-32e6-a50d-184d4daa1eff",
                                "text": "Грамотный бухгалтерский учёт и аудит – залог успешной работы всей организации."
                            }
                        ]
                    },
                    {
                        "sense_id": "4898b84b-931e-3cba-b6a9-5a342133fbb5",
                        "entry_id": "83e426c3-a95d-3246-9685-f1b90a885afa",
                        "glosses": [
                            "аттестация сотрудников предприятия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87890eb-7e48-487e-88ed-99b6f6377086",
                                "sense_id": "4898b84b-931e-3cba-b6a9-5a342133fbb5",
                                "text": "Наша компания занимается аудитом персонала уже 5 лет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c5d89bd-9009-4c6a-b7fa-2909cef75173",
                        "source_entry_id": "83e426c3-a95d-3246-9685-f1b90a885afa",
                        "target_lang_word": "audit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e9eb1d1-3229-36a2-8b51-e9dd338ef368",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "A judicial examination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d43b87bd-d5a2-3f8c-8c9a-6a93afd448ba",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "An examination in general."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4228634-fa46-3a29-89fe-7b161f8fddd3",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "An independent review and examination of records and activities to assess the adequacy of system controls, to ensure compliance with established policies and operational procedures, and to recommend necessary changes in controls, policies, or procedures"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d792d8-87e0-4a29-8e39-9a0ca67e6a15",
                                                "sense_id": "c4228634-fa46-3a29-89fe-7b161f8fddd3",
                                                "text": "National Assembly audit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d3727c-73b7-3990-a165-c13918ea3476",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "The result of such an examination, or an account as adjusted by auditors; final account."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3695635-f3e8-4baa-8b6c-9e64c9a826ec",
                                                "sense_id": "42d3727c-73b7-3990-a165-c13918ea3476",
                                                "text": "Yet I can make my audit up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792faba4-9a40-356f-a217-a3bbe726ef04",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "Spiritual counseling, which forms the core of Dianetics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56a8031-6fd8-43f8-a672-835c6f3ef626",
                                                "sense_id": "792faba4-9a40-356f-a217-a3bbe726ef04",
                                                "text": "[ Werner Erhard said:] I got a lot of benefit from auditing. It was the fastest and deepest way to handle situations that I had yet encountered."
                                            },
                                            {
                                                "example_id": "c4a4c360-85e5-4ecf-9d36-66a38bc59772",
                                                "sense_id": "792faba4-9a40-356f-a217-a3bbe726ef04",
                                                "text": "The trainings of Landmark, Block Training and UP Hans Schuster und Partner thus display strong similarities with the self-improvement seminars of Scientology, which are incidentally called 'auditing sessions', a term taken from the business world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac29932-08bc-3950-ac24-dce7516468a0",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "A general receptacle or receiver."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "305bd6e6-63db-4669-b38a-86388d4ee1b9",
                                                "sense_id": "9ac29932-08bc-3950-ac24-dce7516468a0",
                                                "text": ", \"A Funeral Sermon\"\nIt [a little brook] paid to its common audit no more than the revenues of a little cloud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "695b7e4a-6c00-3173-a411-80b428a84a41",
                                        "entry_id": "32207a8e-cb7d-3d8f-9b3b-99962d95809d",
                                        "glosses": [
                                            "An audience; a hearing."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb1e18c7-997e-4ead-b927-64b675f0c45d",
                                                "sense_id": "695b7e4a-6c00-3173-a411-80b428a84a41",
                                                "text": "With his Oriſons I meddle not, for hee appeals to a high Audit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "audit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78171ad2-d5cd-3a84-9337-208e5bebd061",
                                        "entry_id": "66b6bf43-2849-36fa-a4da-636c15cf62d4",
                                        "glosses": [
                                            "To examine and adjust (e.g. an account)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c047980-5842-496c-9fbe-81929ed43627",
                                                "sense_id": "78171ad2-d5cd-3a84-9337-208e5bebd061",
                                                "text": "to audit the accounts of a treasure, or of parties who have a suit depending in court"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e27a3b8-da14-3961-8162-92c1564637f2",
                                        "entry_id": "66b6bf43-2849-36fa-a4da-636c15cf62d4",
                                        "glosses": [
                                            "To conduct an independent review and examination of system records and activities in order to test the adequacy and effectiveness of data security and data integrity procedures, to ensure compliance with established policy and operational procedures, and to recommend any necessary changes"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4737b610-166a-36c1-b395-ca67977c5f34",
                                        "entry_id": "66b6bf43-2849-36fa-a4da-636c15cf62d4",
                                        "glosses": [
                                            "To counsel spiritually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366f0221-d1c2-433a-ab78-1fb7fba346cf",
                                                "sense_id": "4737b610-166a-36c1-b395-ca67977c5f34",
                                                "text": "In John's case, I suspect, when he lost Diana he went back to his Scientology church to be audited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efbb028b-4fae-33ab-ad6a-4e67cf3998ae",
                                        "entry_id": "66b6bf43-2849-36fa-a4da-636c15cf62d4",
                                        "glosses": [
                                            "To attend an academic class without the opportunity to receive academic credit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74854121-0e0b-44d8-a0d1-c40a072b1ea2",
                        "source_entry_id": "83e426c3-a95d-3246-9685-f1b90a885afa",
                        "target_lang_word": "Audit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Audit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                                        "entry_id": "9f279317-5f22-33df-bee7-d4cec4d5137c",
                                        "glosses": [
                                            "unabhängige und genaue Überprüfung von Aufzeichnungen, Aktivitäten oder Ähnlichem, um festzustellen, ob bestehende Richtlinien und vorgegebene Verfahrensweisen eingehalten werden, und um notwendige Veränderungen zu empfehlen"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8967976-6804-4eab-96d2-9dd46aa10058",
                                                "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                                                "text": "„Heute werden in fast allen Bereichen von Unternehmen oder Organisationen von Zeit zu Zeit Audits durchgeführt […]“"
                                            },
                                            {
                                                "example_id": "fe00363b-8231-4a73-9180-755f2f7be99f",
                                                "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                                                "text": "„Zwar gilt innerhalb eines Konzerns weltweit der gleiche Audit. Aber im länderübergreifenden Qualitätsvergleich wenden die Konzerne einen Umrechnungsfaktor an, der Gewichtungsunterschiede amerikanischer und europäischer Käuferpräferenzen ausgleicht.“"
                                            },
                                            {
                                                "example_id": "c6dd80a3-4f7c-44fa-80c7-2120dec51ac6",
                                                "sense_id": "a691137e-1731-3bee-a649-cbb0328d5339",
                                                "text": "„Ratschläge oder Aussagen ‚Bei uns wird das ganz anders gemacht…!‘ sind tödlich für einen Audit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b9e429f-2e5c-3967-80a7-bf436485201d",
                                        "entry_id": "9f279317-5f22-33df-bee7-d4cec4d5137c",
                                        "glosses": [
                                            "für bestimmte Leistungen in einem Bereich verliehene Auszeichnung an Unternehmen, Organisationen, Kommunen oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
