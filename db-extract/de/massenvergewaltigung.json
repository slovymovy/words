                ],
                "senses": [
                    {
                        "sense_id": "d0596038-33cd-3ff8-af03-b1ee11566feb",
                        "entry_id": "8f6566ad-6399-3a90-8026-9ac8984666e3",
                        "glosses": [
                            "Vergewaltigung einer oder mehrerer Personen durch eine große Zahl von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17b159ca-1cb9-4bd2-959c-ea2e7f6091de",
                                "sense_id": "d0596038-33cd-3ff8-af03-b1ee11566feb",
                                "text": "„Eine Gruppe junger Frauen, die sich nicht an den Boykott hielten, wurden in ihrem Wohnheim attackiert, und 16 von ihnen wurden Opfer einer Massenvergewaltigung.“"
                            },
                            {
                                "example_id": "b427c70f-062c-4b5d-98f3-9e13b90aaa13",
                                "sense_id": "d0596038-33cd-3ff8-af03-b1ee11566feb",
                                "text": "„Sie sind die politische Basis noch für den dümmsten aller Kriegsherren, fähig dazu, ein Dorf zu kontrollieren, einen Überfall zu leiten, eine Massenvergewaltigung durchzuführen oder Lynchjustiz zu üben.“"
                            },
                            {
                                "example_id": "55142957-dc57-4323-9615-519941875310",
                                "sense_id": "d0596038-33cd-3ff8-af03-b1ee11566feb",
                                "text": "„Colonel Slatter hatte die Hintergründe so umrissen: Früher habe es Kunst um der Kunst willen gegeben, jetzt hätten wir Krieg um des Krieges willen. Keine territorialen Eroberungen, keine Sklavenjagden, keine Massenvergewaltigungen, scheiß auf die Ölquellen, was interessieren uns die mineralischen Bodenschätze.“"
                            },
                            {
                                "example_id": "f0484848-32c6-4973-a387-c02d3d2e3741",
                                "sense_id": "d0596038-33cd-3ff8-af03-b1ee11566feb",
                                "text": "„Die Plünderungen und die Brandstiftungen, das gezielte und viel zu oft beiläufige Morden, die Massenvergewaltigungen, all das erlebte der Arzt aus nächster Nähe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
