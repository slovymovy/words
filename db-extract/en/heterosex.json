                        "examples": [
                            {
                                "example_id": "c45c930b-c5e3-4f29-a601-a6ce68d83097",
                                "sense_id": "6a231e82-e563-32bd-ac7a-a45358adcaa6",
                                "text": "For example, the heterosexing of public space means that while heterosexual couples can hold hands or kiss goodbye in the street, the same behaviour from same-sex couples is likely to attract attention and sometimes verbal or physical sanctions against them."
                            },
                            {
                                "example_id": "212e8e1d-3c9e-4b17-af3e-79d23ff887cb",
                                "sense_id": "6a231e82-e563-32bd-ac7a-a45358adcaa6",
                                "text": "Although each society defines its own norms, most of them assign a higher status to men over women, to heterosexual persons over non-heterosexual ones, and to heterosexed bodies over non-heterosexed ones."
                            }
                        ]
                    }
