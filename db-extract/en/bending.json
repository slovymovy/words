                ],
                "senses": [
                    {
                        "sense_id": "31fdf3b7-7981-3cab-bca9-3fba268b54ef",
                        "entry_id": "b5723be5-9b2f-3a14-8228-d35ab22b96d7",
                        "glosses": [
                            "Capable of being bent without breaking; able to be turned or twisted without breaking."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55e1b680-2951-41fa-9af2-73b1032f4afb",
                        "source_entry_id": "b5723be5-9b2f-3a14-8228-d35ab22b96d7",
                        "source_sense_id": "31fdf3b7-7981-3cab-bca9-3fba268b54ef",
                        "source_sense_description": "motion or action",
                        "target_lang_word": "flexion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flexion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2353c5-bc29-3a0b-adb6-1602fa2047a1",
                                        "entry_id": "02ac8daa-2e5b-3e23-a35d-b9b97a7f9b2a",
                                        "glosses": [
                                            "État de ce qui est fléchi."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d564592-3c70-393e-b18b-969b3ff84e6f",
                                        "entry_id": "02ac8daa-2e5b-3e23-a35d-b9b97a7f9b2a",
                                        "glosses": [
                                            "Déformation élastique d’un solide soumis à une force perpendiculaire à sa longueur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9788388c-a04b-4908-8643-4014ff1c1b21",
                                                "sense_id": "7d564592-3c70-393e-b18b-969b3ff84e6f",
                                                "text": "L'ouverture du pont d'Ewell est de 14m,63, et la flexion statique due à la charge que nous venons d'indiquer est d'un peu plus de 0m,005."
                                            },
                                            {
                                                "example_id": "8c10ab97-fca0-4f5c-913e-3273b1fdff6b",
                                                "sense_id": "7d564592-3c70-393e-b18b-969b3ff84e6f",
                                                "text": "Après déformation, la ligne moyenne d’une poutre soumise à la flexion est appelée la déformée de la poutre; elle constitue une courbe plane dans le cas de la flexion simple examinée jusqu’ici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e12c6986-6abd-33a6-9320-bda9aaabd357",
                                        "entry_id": "02ac8daa-2e5b-3e23-a35d-b9b97a7f9b2a",
                                        "glosses": [
                                            "Action de fléchir, en parlant de certains muscles ou de certaines articulations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11772e50-0728-4fa5-8639-8f96c70daa64",
                                                "sense_id": "e12c6986-6abd-33a6-9320-bda9aaabd357",
                                                "text": "La notion de raideur sur prothèse du genou est relative. Un genou normal fléchit jusqu’à 150° mais la flexion d'un genou prothétique dépasse rarement 120°."
                                            },
                                            {
                                                "example_id": "dca082ae-c780-4e66-8a70-170a56a29528",
                                                "sense_id": "e12c6986-6abd-33a6-9320-bda9aaabd357",
                                                "text": "Les mouvements de flexion et d’extension de l’avant-bras sont gérés par plusieurs muscles dont le biceps (muscle fléchisseur) et le triceps (muscle extenseur)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4b5fd3-ebf9-31aa-8e79-a8f1a284e6c1",
                                        "entry_id": "02ac8daa-2e5b-3e23-a35d-b9b97a7f9b2a",
                                        "glosses": [
                                            "Modification de la forme d’un mot par rapport à ce qui est considéré comme sa forme de base, par exemple par la mise au pluriel, par la conjugaison, par la déclinaison, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec615c01-dc98-4ce8-940c-cbf8b07fa090",
                                                "sense_id": "0d4b5fd3-ebf9-31aa-8e79-a8f1a284e6c1",
                                                "text": "Qu’un mot grec à l’état de flexion se soit conservé entier, inaltéré, dans les ouvrages des historiens chinois, c'est un fait inattendu qu’on est d’abord tenté de déclarer impossible ; […]."
                                            },
                                            {
                                                "example_id": "e1e28cbb-228c-4bf4-8100-9b203786d34d",
                                                "sense_id": "0d4b5fd3-ebf9-31aa-8e79-a8f1a284e6c1",
                                                "text": "Madame Martin demanda ce que c’était qu’une flexion.\n— Oh ! madame, si je vous donne des éclaircissements, nous allons tout embrouiller."
                                            },
                                            {
                                                "example_id": "0a447039-b12d-4f81-9fb4-733c078b8a9d",
                                                "sense_id": "0d4b5fd3-ebf9-31aa-8e79-a8f1a284e6c1",
                                                "text": "Par contraste, l’approche de la typologie partielle ne considère que des parties de la morphologie, par exemple la flexion verbale ou la flexion nominale, et à l'intérieur de celles-ci le nombre, le genre, etc."
                                            },
                                            {
                                                "example_id": "2b80b315-f3e3-4d2e-a5af-d9f094e8a971",
                                                "sense_id": "0d4b5fd3-ebf9-31aa-8e79-a8f1a284e6c1",
                                                "text": "Le verbe peut se définir par sa flexion temporelle qui est une propriété unique du verbe français tandis que la flexion en genre, en nombre et en personne peut se trouver dans d'autres monèmes."
                                            },
                                            {
                                                "example_id": "f6bcc249-19d4-4413-aa9f-4f2ae8691a08",
                                                "sense_id": "0d4b5fd3-ebf9-31aa-8e79-a8f1a284e6c1",
                                                "text": "La flexion de l'adjectif marque les mêmes traits grammaticaux que celle du substantif : • nombre (singulier / pluriel) • genre (masculin / féminin) • état (absolu / construit)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
