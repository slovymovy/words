            {
                "entry_id": "f9cf1593-8692-3ab3-87e7-7385df867a21",
                "word": "Falcon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "340556ec-1e16-3bd1-a2ef-401a6b48338d",
                        "entry_id": "f9cf1593-8692-3ab3-87e7-7385df867a21",
                        "glosses": [
                            "Nom d’une gamme d’avions d’affaire de Dassault."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c894461f-4a57-4826-9797-a4f88743fae0",
                                "sense_id": "340556ec-1e16-3bd1-a2ef-401a6b48338d",
                                "text": "Le Falcon 7X du président de la République du Congo Denis Sassou Nguesso a été adjugé aux enchères 7,1 millions d’euros, mardi, au Grand Hôtel de Bordeaux."
                            },
                            {
                                "example_id": "c7b606eb-390f-4aa4-8043-bf0ac73fa974",
                                "sense_id": "340556ec-1e16-3bd1-a2ef-401a6b48338d",
                                "text": "Un nouveau jet privé Dassault Falcon coûte entre 26 millions de dollars pour un Falcon 2000S de 2021 et 62,5 millions de dollars pour un Falcon 8X de 2022."
                            },
                            {
                                "example_id": "8a9d5157-cadb-4916-9992-e52a5f87cc1f",
                                "sense_id": "340556ec-1e16-3bd1-a2ef-401a6b48338d",
                                "text": "Ainsi, le Falcon 2000S, le nouveau-né qui vient d'être lancé et qui affiche déjà une vingtaine de commandes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8e36a0f3-f752-3c2f-9430-07df549970db",
