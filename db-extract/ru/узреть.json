                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erblicken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5421ee9d-d255-36a3-8707-d9b2024964a9",
                                        "entry_id": "5ef2fcf5-1221-3d7b-859d-70a6b68ea14d",
                                        "glosses": [
                                            "etwas oder jemanden mit den Augen (einem Blick) wahrnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee0ffac-a98e-4006-8a9a-a2e7a4205ab3",
                                                "sense_id": "5421ee9d-d255-36a3-8707-d9b2024964a9",
                                                "text": "„Er sah sich nach allen Seiten um und erblickte zwei weibliche Gestalten auf einem Hügel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72baecd2-5270-3c66-9be4-a175f09fbc4e",
                                        "entry_id": "5ef2fcf5-1221-3d7b-859d-70a6b68ea14d",
                                        "glosses": [
                                            "etwas oder jemand eine Bedeutung geben; glauben, dass man den Kern gefunden hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab41a8c-008f-4787-9c26-acc84aac2f1f",
                                                "sense_id": "72baecd2-5270-3c66-9be4-a175f09fbc4e",
                                                "text": "„Montesquieu schliesslich erblickt in der individuellen Freiheit das eigentliche Gut, das es zu schützen gilt.“"
                                            },
                                            {
                                                "example_id": "ebd07234-7ce1-40b6-8a03-dc4c07b23106",
                                                "sense_id": "72baecd2-5270-3c66-9be4-a175f09fbc4e",
                                                "text": "„Ich erblicke in ihm den Retter Frankreichs; er soll es wissen, dass er im Direktorium nur Bewunderer und Freunde hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
