                        "entry_id": "a44b4385-3dc3-35f9-86db-03286fc6a82d",
                        "glosses": [
                            "podstawa, najczęściej w postaci trójnogu ze składanymi nogami, wykonana z metalu lub drewna, służąca do stabilizowania mocowanych na niej przyrządów, np. aparatu fotograficznego, kamery, urządzeń geodezyjnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ad7a05d-77e2-45f3-8b5c-77a96f41de80",
                                "sense_id": "f64e0186-9757-34fa-a262-c9d0356b4df2",
                                "text": "W Zamku Królewskim można wykonywać zdjęcia, ale bez flasha i bez statywu"
                            },
                            {
                                "example_id": "ebc566fc-5df7-48a4-b7ce-837cf671071c",
                                "sense_id": "f64e0186-9757-34fa-a262-c9d0356b4df2",
                                "text": "Bez statywu nie zarejestrujemy też ujęć do stworzenia panoramy z prawdziwego zdarzenia, nie mówiąc już o wygodzie korzystania z podnoszenia lustra i samowyzwalacza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
