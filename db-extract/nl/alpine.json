                                        "sense_id": "44356399-5271-3264-93fa-5e3fa34a2a7c",
                                        "entry_id": "263901c1-792b-3f1b-ba54-d053032054dd",
                                        "glosses": [
                                            "Of, relating to, or inhabiting mountains, especially above the timberline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a11a519-f3d6-4c6c-b2db-045781cc1b1e",
                                                "sense_id": "44356399-5271-3264-93fa-5e3fa34a2a7c",
                                                "text": "alpine snows"
