                                        "sense_id": "3ee9d996-910b-3037-aedc-69899465994a",
                                        "entry_id": "c30fc5be-8cbf-32cb-b155-b38949267784",
                                        "glosses": [
                                            "Alternative form of rack (“to cause to suffer pain, etc.”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a856857-a644-47e7-b6a0-59d8ef7e5204",
                                                "sense_id": "3ee9d996-910b-3037-aedc-69899465994a",
                                                "text": "It marked her first performance in over four years after revealing that her body had been wracked with painful spasms following her diagnosis with the rare and chronic neurological disorder."
                                            }
                                        ]
                                    }
                                ]
                            }
