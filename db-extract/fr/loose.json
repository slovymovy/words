                        "examples": [
                            {
                                "example_id": "529d7eee-3a87-4c82-b2c1-6914c25abb83",
                                "sense_id": "004f8bf7-d036-3bad-a2e2-097df146fa09",
                                "text": "Le fin fond de la loose ça existe, se disait Isolde. La preuve, je l’ai atteint. La responsable de production lui avait donné un travail encore plus pénible que traduire du blabla prétentieux et gentillet: […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbc96001-048d-3d7d-b04b-e4a78fc760a2",
                        "entry_id": "cd0d0696-5ded-3cb2-b9bf-fabb9f1dbebe",
                        "glosses": [
                            "Nullité ; grande médiocrité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5343ff1e-d6f3-4352-9bb2-75c28407b80d",
                                "sense_id": "dbc96001-048d-3d7d-b04b-e4a78fc760a2",
                                "text": "J’pense que j’ai coché la case vide de la loose pour pas les copier et m’raconter que j’étais différent."
                            },
                            {
                                "example_id": "267b726f-b637-4b2c-927d-d0a3a8ef4dcd",
                                "sense_id": "dbc96001-048d-3d7d-b04b-e4a78fc760a2",
                                "text": "Vous savez tout pour être un perdant accompli, un authentique professionnel de la loose. Vous n’avez plus rien à faire. Vous avez atteint le sommet et ce livre ne peut plus rien vous apprendre… sauf à vous occuper des perdants débutants []."
                            }
                        ]
