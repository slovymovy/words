                                        "entry_id": "62459074-da4e-3518-ab57-0a40bc78b80b",
                                        "glosses": [
                                            "That which is innermost; the core."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f05afce4-966b-441d-b216-459f99a66d7b",
                                                "sense_id": "d225d0b6-794e-369e-ae86-7702ee085aa3",
                                                "text": "[…] he had decided to not seek outside of himself where companionship and friendliness might be a soothing submergence. It seemed he had instead chosen to turn deeply inwards, towards the measures and pains of his wracked innermosts."
                                            }
                                        ]
