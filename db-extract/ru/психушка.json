                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funny farm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2e55ce-f148-38b1-aefa-5bfaf5231c0f",
                                        "entry_id": "e7f194d9-b627-37f6-b9a1-eee374c09b8f",
                                        "glosses": [
                                            "An insane asylum."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c7b61c-5108-4cbf-8d14-b2ac1e58ef26",
                                                "sense_id": "ab2e55ce-f148-38b1-aefa-5bfaf5231c0f",
                                                "text": "Paddy the Duke was right. I had one more \"tour of duty\" to put in at the funny farm. They turned me loose a few days after he left, sometime in the winter months of 1959, but in a little more than a year's time I would be back at Avalon Valley; and I would be a very sick man."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b05b1d2-d0b5-49a5-bdc7-e59ed005cbfe",
                        "source_entry_id": "3fe1f5f6-6364-3dd0-9e25-9310b35af923",
                        "source_sense_id": "a3f9d31c-c920-35b1-a9f9-966f1b5f3ab4",
                        "target_lang_word": "loony bin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loony bin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc45e2d-9100-3ea8-b53a-ae697585b1c4",
                                        "entry_id": "c63f004f-ea02-3b1b-b046-990fcbaa00d0",
                                        "glosses": [
                                            "A lunatic asylum."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a24ce19-8cdf-485e-a7a1-1ef35a9d0aa2",
                                                "sense_id": "edc45e2d-9100-3ea8-b53a-ae697585b1c4",
                                                "text": "And perhaps, of course, her dreams had seemed more real to other people, too, than life could be—there was always that impossibility, more real than anything which seemed merely possible—at least in this old house by the roaring waves, this loony bin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
