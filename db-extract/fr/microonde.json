                                                "example_id": "02abc14f-694c-4fd1-bdaf-8428fcc9af53",
                                                "sense_id": "92f8c7e8-f35b-3a51-bbab-d22aab5872f1",
                                                "text": "Mikrowellen werden häufig zur Wärmeerzeugung eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "860ed10b-6140-38bc-87e2-cb3aa3b02438",
