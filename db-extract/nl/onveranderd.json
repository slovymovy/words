                        "examples": [
                            {
                                "example_id": "beeb6792-ad2f-4b13-ba46-db238bbfc80f",
                                "sense_id": "ee21b498-d667-3207-975b-766f68cda660",
                                "text": "De situatie in Libië is al enige tijd onveranderd gebleven en er woedt nog steeds een oorlog die veel bloed vergt."
                            }
                        ]
                    }
                ],
                "translations": [
