                        "tags": [],
                        "examples": [
                            {
                                "example_id": "774f05cf-2e94-4d7e-8d89-81a47d09edbd",
                                "sense_id": "01083fd1-8aaa-3c33-a14b-15d39aaf51ee",
                                "text": "Despite being shot on tiny budget, the student film looked incredibly cinematic."
