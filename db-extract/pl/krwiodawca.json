                                        "glosses": [
                                            "физ. примесь в кристаллической решётке, которая отдаёт кристаллу электрон"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87dba9b9-ba90-3c98-9714-0ec9868e9fd8",
                                        "entry_id": "5479769b-a079-317a-a03d-1ec2c41f4ccb",
                                        "glosses": [
                                            "экон. кредитор, предоставляющий ссуду на льготных условиях или безвозмездно с целью оказания финансовой помощи"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac3429ba-fc45-3c94-89a1-f6071ccc5752",
                                        "entry_id": "5479769b-a079-317a-a03d-1ec2c41f4ccb",
