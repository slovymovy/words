                "senses": [
                    {
                        "sense_id": "dbf581c7-5f42-3df2-8a74-304286e9909b",
                        "entry_id": "8bd9348d-e935-3b38-8226-e82eac53d34d",
                        "glosses": [
                            "Facharzt für die Neurologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608f4aca-2ec1-4841-a32c-764bff8a305c",
                                "sense_id": "dbf581c7-5f42-3df2-8a74-304286e9909b",
                                "text": "Wegen häufiger Kopfschmerzen erhielt ich einen Untersuchungstermin in der Praxis eines Nervenarztes."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9cad9312-ac1c-3f87-bd30-5dbc053245d4",
                        "entry_id": "8bd9348d-e935-3b38-8226-e82eac53d34d",
                        "glosses": [
                            "Arzt für psychische Probleme"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "be7a4ab6-29c7-4ce8-b51e-324faf5f6457",
                                "sense_id": "9cad9312-ac1c-3f87-bd30-5dbc053245d4",
                                "text": "Der Nervenarzt verschrieb ihm nach langen Gesprächen ein Medikament gegen Depression."
                            },
                            {
                                "example_id": "e98320a6-5c6c-4d05-b036-107dc737e4a5",
                                "sense_id": "9cad9312-ac1c-3f87-bd30-5dbc053245d4",
                                "text": "„In der Berggasse ordiniere ein Nervenarzt, von dem er einiges halte.“"
                            },
                            {
                                "example_id": "37e51d09-bf12-4c6c-85e5-27b6d455f158",
                                "sense_id": "9cad9312-ac1c-3f87-bd30-5dbc053245d4",
                                "text": "„Eine bekümmerte Dame bittet den Nervenarzt um Beistand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
