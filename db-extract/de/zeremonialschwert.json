                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa0bd8fa-6954-4901-a6e8-fcdf102e5b6d",
                                "sense_id": "3b5506d9-ddbd-392b-be95-ca410603bf11",
                                "text": "„Auch die Einführung von Zeremonialschwertern geht nach der Tradition auf diesen Ogiso zurück; auf vielen Reliefplatten ist ein Oba oder ein Würdenträger mit einem solchen Schwert abgebildet.“"
                            },
                            {
                                "example_id": "b077a63f-e5ed-497a-9dff-15946b7a6cf6",
                                "sense_id": "3b5506d9-ddbd-392b-be95-ca410603bf11",
                                "text": "„Es handelte sich um ein Zeremonialschwert, doch Quincy, einst Captain der Florettmannschaft an der Wayne State University, konnte recht geschickt damit umgehen - und an diesem Abend hatte er für alle Fälle noch eine Pistole eingesteckt.“"
                            }
                        ],
