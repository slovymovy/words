                                    {
                                        "sense_id": "d2034e62-fe14-358f-9188-1285d6467751",
                                        "entry_id": "a170a3ef-f265-3b14-a44e-b8623db810ac",
                                        "glosses": [
                                            "ein Teil des Dickdarms beim Menschen und generell bei den Säugetieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45affc16-539e-4199-88e1-420353eca797",
                                                "sense_id": "d2034e62-fe14-358f-9188-1285d6467751",
                                                "text": "Der Grimmdarm ist ein Teil des Dickdarms."
                                            },
                                            {
                                                "example_id": "36cb1f24-6088-4bfa-954b-87b9e4087af8",
                                                "sense_id": "d2034e62-fe14-358f-9188-1285d6467751",
                                                "text": "„Die deutsche Bezeichnung Grimmdarm wird sowohl in der Wissenschaft als auch in der Alltagssprache nur noch selten verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
