                        "glosses": [
                            "myśl lub pogląd przypisywane Jezusowi Chrystusowi, nie utrwalone w ewangeliach kanonicznych, przekazane w pozostałych księgach nowotestamentalnych lub apokryfach"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
