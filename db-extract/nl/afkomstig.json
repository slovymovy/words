                                                "example_id": "eb6658b1-2d52-441e-a9d7-a3b22be6442b",
                                                "sense_id": "d85f3a62-354f-3bea-b046-37617c700d16",
                                                "text": "„Flugpionier Erich Henneberger, dessen Vorfahren aus Randersacker stammten, nahm ein tragisches Ende in der früheren Kolonie Deutsch-Ostafrika. Er starb beim Absturz des Flugzeuges am 15. November 1914, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
