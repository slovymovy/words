                                "sense_id": "1c7abd54-35a5-31d8-9fa5-e26501afa587",
                                "text": "Schoenmaken, schoorsteenvegen, spoorzoeken, steenhouwen, strooplikken en stroopsmeren voorbeelden van werkwoorden die niet-vervoegbaar zijn."
                            },
                            {
                                "example_id": "1c49c2de-809a-4d61-9b69-fb3762cfec5c",
                                "sense_id": "1c7abd54-35a5-31d8-9fa5-e26501afa587",
                                "text": "Maken, vegen, zoeken, houwen, likken en smeren zijn voorbeelden van werkwoorden die wel vervoegbaar zijn."
                            }
                        ]
