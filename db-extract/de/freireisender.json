                ],
                "senses": [
                    {
                        "sense_id": "e095e8bb-74bf-3c54-a05d-e733b03f5a7b",
                        "entry_id": "7bcc3189-0007-3d40-9680-201b866ab8b2",
                        "glosses": [
                            "Wandergeselle, der keinem Schacht angehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd509862-b1c8-4915-b57e-5472b9e87417",
                                "sense_id": "e095e8bb-74bf-3c54-a05d-e733b03f5a7b",
                                "text": "„Bierbrauer Ingo Alex hat vom Leben als Freireisender noch lange nicht genug, […].“"
                            },
                            {
                                "example_id": "10983a62-1a61-4ac4-a81c-30923da489b1",
                                "sense_id": "e095e8bb-74bf-3c54-a05d-e733b03f5a7b",
                                "text": "„Noch ist er ein Freireisender.“"
                            },
                            {
                                "example_id": "302901cd-4ac6-4dcf-9cf6-a566168d051f",
                                "sense_id": "e095e8bb-74bf-3c54-a05d-e733b03f5a7b",
                                "text": "„Er hatte als Freireisender zum Start ein eigenes Wanderbuch angelegt; aber erst bei einem Treffen in Slowenien schloss er sich einem der Schächte an und übertrug seine bisherigen Eintragungen in das offizielle Wanderbuch.“"
                            },
                            {
                                "example_id": "f5f5b68a-ed8f-4423-8d7b-23dc205a7bca",
                                "sense_id": "e095e8bb-74bf-3c54-a05d-e733b03f5a7b",
                                "text": "„Die Frauen sind Freireisende auf Wanderschaft. Sie gehören also keinem der Schächte, Vereinigungen der Handwerker, an.“"
                            },
                            {
                                "example_id": "30f075fc-9302-46c2-80d0-c5dd1b9483fc",
                                "sense_id": "e095e8bb-74bf-3c54-a05d-e733b03f5a7b",
                                "text": "„An der Krawatte („Ehrbarkeit“) erkennt man, welchem Schacht jemand angehört; Freireisende tragen keine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
