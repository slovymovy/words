                        "entry_id": "2937d643-2b0b-33d9-9b46-8c7d20e83e8a",
                        "glosses": [
                            "Celle qui scrute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f84a86c-d5ae-4da4-9fc8-2b5565b5d62f",
                                "sense_id": "25909983-5737-3b12-80e5-5d8d1dd9ef23",
                                "text": "C’était une grande scrutatrice humaine, un esprit trempé et aiguisé pour découvrir."
                            }
                        ]
                    },
                    {
                        "sense_id": "edb3315b-e3cc-39ac-a879-01aa14678d8d",
                        "entry_id": "2937d643-2b0b-33d9-9b46-8c7d20e83e8a",
                        "glosses": [
                            "Personne désignée pour prendre part à l’organisation du scrutin, à sa vérification et à son dépouillement."
                        ],
                        "tags": [
                            "Élection"
                        ],
                        "examples": [
                            {
                                "example_id": "7ff701ff-8315-4d95-8a05-fb1f5b2c3db6",
                                "sense_id": "edb3315b-e3cc-39ac-a879-01aa14678d8d",
                                "text": "Cela va faire 10 ans que Lili est scrutatrice. Elle déplie et lit les bulletins de vote avec une bonne cadence mais elle sait que la vitesse de son équipe sera vite perturbée : « On va être ralentit parce qu’on trouve un peu tout et n’importe quoi dans les enveloppes »"
                            }
                        ]
                    }
