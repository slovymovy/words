                                                "sense_id": "8ed2cbce-d702-3a6c-bfb5-0d449f4b412c",
                                                "text": "Unsere Geschichtslehrerin ist sehr streng. Kommt jemand nur kurz zu spät, muss er eine Strafarbeit schreiben."
                                            },
                                            {
                                                "example_id": "96ca46e0-41ea-4b0d-b440-340065e72908",
                                                "sense_id": "8ed2cbce-d702-3a6c-bfb5-0d449f4b412c",
                                                "text": "… Sind Bundesstaaten mit strengeren Waffengesetzen sicherer, oder ist es besser, wenn jeder eine Waffe bei sich hat? In zehn Jahren kann Amerika Bilanz ziehen. Bis dahin werden weiter jedes Jahr 30.000 Amerikaner durch Schusswaffen ums Leben kommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49c57eba-3668-3114-ab43-03c7405d2a2a",
                                        "entry_id": "bae82eaf-fa33-3285-82e6-52c1130b499c",
                                        "glosses": [
                                            "mit negativen Aspekten und Entbehrungen verbunden"
                                        ],
                                        "tags": [
                                            "zeitliche Abschnitte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4db98114-43a2-43d3-9267-f06cbd6905ce",
                                                "sense_id": "49c57eba-3668-3114-ab43-03c7405d2a2a",
                                                "text": "Uns steht eine strenge Zeit der Enthaltsamkeit bevor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bf4f973d-ed39-32f7-8f90-5338e5c99483",
                                        "entry_id": "bae82eaf-fa33-3285-82e6-52c1130b499c",
                                        "glosses": [
                                            "sich durch betonte Einfachheit auszeichnend"
                                        ],
                                        "tags": [
                                            "von einem Stil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e9d52d6-3140-4783-85a8-f23e00560add",
                                                "sense_id": "bf4f973d-ed39-32f7-8f90-5338e5c99483",
                                                "text": "Das Design zeichnet sich durch eine einfache, strenge Linienführung aus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0a49042f-254e-3d13-8d0e-d73d3de9f47e",
                                        "entry_id": "bae82eaf-fa33-3285-82e6-52c1130b499c",
                                        "glosses": [
                                            "intensiv und unangenehm"
                                        ],
