                ],
                "senses": [
                    {
                        "sense_id": "bbd8e17d-73ce-3f36-a12d-079e8768733e",
                        "entry_id": "06106c47-94f2-3b9b-8819-9b81ff177b30",
                        "glosses": [
                            "Politik, die die Frage von Flüchtlingen betrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55acfe6c-c508-4403-ab73-c00d6a1605fb",
                                "sense_id": "bbd8e17d-73ce-3f36-a12d-079e8768733e",
                                "text": "„Asylpolitik in der EU besteht in dem Versuch, eine einheitliche Asyl- und Flüchtlingspolitik in der Europäischen Union zu verwirklichen.“"
                            },
                            {
                                "example_id": "0bb74eef-8697-4be5-a66e-b73f425408fa",
                                "sense_id": "bbd8e17d-73ce-3f36-a12d-079e8768733e",
                                "text": "„Berlin zog angesichts des anhaltenden Zustroms von Flüchtlingen die Notbremse und hat wieder Grenzkontrollen eingeführt. Bundesinnenminister Thomas de Maizière begründete die Kehrtwende der Regierung in der Flüchtlingspolitik am Sonntagabend auch mit der Sicherheitslage.“"
                            },
                            {
                                "example_id": "a5864dfa-83c0-43df-a727-f96fa21679a9",
                                "sense_id": "bbd8e17d-73ce-3f36-a12d-079e8768733e",
                                "text": "„Was für die SPD Schröders Agenda war, könnte für die Union Merkels Flüchtlingspolitik werden.“"
                            },
                            {
                                "example_id": "00177f3f-0948-491c-981d-7ccc72554371",
                                "sense_id": "bbd8e17d-73ce-3f36-a12d-079e8768733e",
                                "text": "„In der CDU gibt es kaum eine schärfere Kritikerin der Flüchtlingspolitik als Steinbach, selbst die CSU wirkt dagegen milde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
