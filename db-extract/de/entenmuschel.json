                        "glosses": [
                            "sessiles Krebstier aus der Klasse der Rankenfüßer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4763d4-3b69-438a-b893-9b0363e4564c",
                                "sense_id": "7c8efa5a-8c78-329f-b7af-9557b04bbe33",
                                "text": "Im Mittelalter gab es eine Theorie, nach der sich Nonnengänse aus Entenmuscheln entwickeln sollten."
                            },
                            {
                                "example_id": "a911c763-11d2-46d2-81db-bd427cb00106",
                                "sense_id": "7c8efa5a-8c78-329f-b7af-9557b04bbe33",
                                "text": "„Hier und da fanden sich schleimige Objekte von rätselhafter Form, bedeckt von Algen und mit Entenmuscheln verkrustet, die Klenze für uralte Schiffe in ihrem Meeresgrab hielt.“"
                            }
                        ],
