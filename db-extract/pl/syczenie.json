                                        "entry_id": "5f614795-8a94-34ae-8c96-f63061644911",
                                        "glosses": [
                                            "that produces or is accompanied with a hiss"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
