                ],
                "senses": [
                    {
                        "sense_id": "777dec5f-564a-3a21-91a2-5d38a27c8e2e",
                        "entry_id": "30cdcad4-5c6f-38b5-a6f1-93b12b8e7de4",
                        "glosses": [
                            "größtmöglicher Kreis auf einer Kugeloberfläche; sein Mittelpunkt fällt immer mit dem Mittelpunkt der Kugel zusammen"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "f40ec5ab-1f7b-490c-8741-4d1a33529aea",
                                "sense_id": "777dec5f-564a-3a21-91a2-5d38a27c8e2e",
                                "text": "„Der Äquator der Erde ist der auf ihrer Oberfläche angenommene Großkreis, auf dessen Ebene (die Äquatorebene) die Erdachse senkrecht steht.“"
                            },
                            {
                                "example_id": "48a4dbcb-5af3-496e-ae74-a7e7a2a834e1",
                                "sense_id": "777dec5f-564a-3a21-91a2-5d38a27c8e2e",
                                "text": "„Die Längenkreise sind jene Großkreise auf einer kugelförmig gedachten Erdoberfläche, die in Nord-Südrichtung verlaufen und durch beide Rotationspole der Erde gehen.“"
                            },
                            {
                                "example_id": "27c028f7-ab3e-4e99-82df-4614fcb880c9",
                                "sense_id": "777dec5f-564a-3a21-91a2-5d38a27c8e2e",
                                "text": "„Entfernungen auf einem Großkreis werden auf zwei Arten angegeben: in Seemeilen oder im Maß eines Winkels, dessen Scheitel im Erdmittelpunkt liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "943b8d81-4bf8-4cec-a41d-e2efbc9ed741",
