                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2f954620-f1ad-312e-bb98-cefd05a2e79c",
                                        "entry_id": "d516d023-718c-352f-98eb-5b9e9c7e91d8",
                                        "glosses": [
                                            "Disziplinarmaßnahme, die jemandem ein Fehlverhalten vor Augen führt; tadelnde Ansprache"
