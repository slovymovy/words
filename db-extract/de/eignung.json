                    {
                        "translation_id": "2c8ba142-892d-446f-99bb-4f822eb0a75b",
                        "source_entry_id": "98ba16d8-982b-3d32-9747-7bd48b92f5a4",
                        "source_sense_id": "152b0d18-6614-3b3a-8aae-3ca03d4a106b",
                        "source_sense_description": "Eigenschaft, passend, tauglich zu sein",
