                                "target_senses": [
                                    {
                                        "sense_id": "d89430a4-e9f2-35ce-bdb7-cec35007dd3f",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "The hair of the sheep, llama and some other ruminants."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "135c5baa-0767-454b-8c76-69e967aac69a",
                                                "sense_id": "d89430a4-e9f2-35ce-bdb7-cec35007dd3f",
                                                "text": "The sheep were caught and plucked, because shears had not yet been invented to cut the wool from the sheep's back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faba724b-bffb-300c-b380-426084cd12f5",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "A cloth or yarn made from such hair."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fdb726-8433-4f53-b81b-f8da598fbf5b",
                                                "sense_id": "faba724b-bffb-300c-b380-426084cd12f5",
                                                "text": "Spielvogel said wet cleaning also has limitations; while it is fine for cottons and fabrics worn in warm climates, he said, it can damage heavy wools or structured clothes like suit jackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceffa4c6-809f-350f-9a53-0b4ccd4e77a7",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "Anything with a fibrous texture like that of sheep's wool."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d199151-95eb-49bf-bc0f-a286518201b0",
                                                "sense_id": "ceffa4c6-809f-350f-9a53-0b4ccd4e77a7",
                                                "text": "The groundsels have leaves covered in wool for insulation[…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "363ce039-617c-3cac-ac1b-2941b515c941",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "A fine fiber obtained from the leaves of certain trees, such as firs and pines."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd881d85-1032-3e1e-815b-6826a3a3fd2a",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "Short, thick hair, especially when crisped or curled."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acde8bd5-55ee-4cfe-94c6-5ebb3dbc9eff",
                                                "sense_id": "bd881d85-1032-3e1e-815b-6826a3a3fd2a",
                                                "text": "wool of bat and tongue of dog"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669ac09b-b60b-3383-97bb-abd83c56380e",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "Yarn, including that made from synthetic fibers."
                                        ],
                                        "tags": [
                                            "British",
                                            "New-Zealand",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c59872f-9f54-3529-ba4c-87ee54ac23f5",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "A woolly back; a resident of a satellite town outside Liverpool, such as St Helens or Warrington. See also Yonner."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25f1c0ce-a5db-3e26-b6c5-2b406107c14f",
                                        "entry_id": "b354760e-e283-3bab-9f19-7c63090a1568",
                                        "glosses": [
                                            "A marijuana cigarette or cigar laced with crack cocaine."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b578bd1f-0457-4e67-ba00-8ee51953e33a",
                                                "sense_id": "25f1c0ce-a5db-3e26-b6c5-2b406107c14f",
                                                "text": "The object of your affection is the treetop connection / Where basically you love to smoke your wools"
                                            },
                                            {
                                                "example_id": "b8aa9316-63de-4172-b385-da363d86f1df",
                                                "sense_id": "25f1c0ce-a5db-3e26-b6c5-2b406107c14f",
                                                "text": "He rocked Caesar's chains, he pushed Caesar's Range / Smokin' mad wools all day, with Caesar's change"
                                            },
                                            {
                                                "example_id": "3210f550-ccf6-454c-baf2-4f01a187b757",
                                                "sense_id": "25f1c0ce-a5db-3e26-b6c5-2b406107c14f",
                                                "text": "Lopez said the shooter's name was Lou, known on the street as Wool Lou, because he sold \"wools,\" which were cigarettes rolled up with crack cocaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f9bcbc6-e6ab-432b-a4c6-5d18e02aa64f",
                        "source_entry_id": "1dbd57b9-e280-3e1f-a17f-0111caf95988",
