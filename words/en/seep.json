                        {
                            "text": "The heavy morning rain <w>seeped</w> the ground completely.",
                            "target_lang_translations": {
                                "tr": "Sabahki şiddetli yağmur toprağı tamamen <w>ıslattı</w>.",
                                "ru": "Утренний проливной дождь полностью <w>пропитал</w> землю.",
                                "cs": "Ranní silný déšť půdu úplně <w>nasákl</w>."
