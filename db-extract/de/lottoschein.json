                ],
                "senses": [
                    {
                        "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                        "entry_id": "74444347-d0d3-3d11-af9f-1817082389d8",
                        "glosses": [
                            "Papier, bei dem man Zahlen ankreuzt und an einem Wettspiel/einer Ziehung teilnimmt und gewinnt, wenn die Zahlen auf dem Lottoschein mit den gezogenen Zahlen übereinstimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "175d7ce9-ec4f-471b-bf6e-da0b061d5928",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "Meine Eltern haben ihr ganzes Leben lang Lottoscheine abgegeben, aber nie ernsthaft etwas gewonnen."
                            },
                            {
                                "example_id": "e5dadbd3-077f-409c-a05d-daa8f7d52ca6",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Ich habe mich dann später so aus dem Krankenhaus entlassen lassen, dass ich den Lottoschein abgeben konnte, der blieb leider ohne Gewinn.“"
                            },
                            {
                                "example_id": "7840fd8d-86b7-4eb5-abff-fe05f00fb20b",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Nun ist mein Vater schwer erkrankt, und damit ist der verantwortungsvollste Job in unserer Familie auf mich übergegangen. Ich muss Sorge tragen, dass der Lottoschein allwöchentlich abgegeben ist!“"
                            },
                            {
                                "example_id": "1ffa96a7-80db-4b6b-989c-b1c2b559d9f0",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Werden also etwa für 10.000 Euro Lottoscheine verkauft, bleiben in der Annahmestelle 750 Euro, beim Finanzministerium 1.670 Euro. 5.000 Euro davon werden auf die verschiedenen Gewinnklassen (siehe oben) verteilt.“"
                            },
                            {
                                "example_id": "59af711c-b43d-46a3-a3ec-5f52f0d573f2",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„In seinem Späti verkauft Nafiz vor allem Biere aus Bayern, aber auch Whiskey, italienisches Olivenöl, Wein und Lottoscheine.“"
                            },
                            {
                                "example_id": "7a45048a-4036-49f5-87d8-7fb01cf5ae73",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Auf dem Weg zur Metro geht Lossény noch kurz in den Kiosk. Zigaretten kaufen. Und Lottoscheine ausfüllen, wie jeden Freitag.“"
                            },
                            {
                                "example_id": "ebeebb63-66ac-4ff9-8254-d1b8812077cd",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Viel besser ist es, Lottozahlen über 31 zu tippen und auch nicht unbedingt Muster auf dem Lottoschein anzukreuzen. Ein Chaos auf dem Tippschein erhöht die Wahrscheinlichkeit auf größere Gewinne.“"
                            },
                            {
                                "example_id": "12418be1-6e84-442f-b88e-0457fc468cd9",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„In Katalonien wie überall in Spanien werden fieberhaft die Lottoscheine verglichen, denn dies ist wie in jedem Jahr der Tag der großen Weihnachtslotterie.“"
                            },
                            {
                                "example_id": "29abe7df-e355-4a19-8669-ac034dd79d54",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Als sie glaubt, dass sie gewonnen hat, will sie den Lottoschein holen um sofort anzurufen. Aber der Lottoschein ist verschwunden!“"
                            },
                            {
                                "example_id": "f8e5a9c5-464e-4d32-8144-88e8ceacf274",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Abgegeben wurde der Lottoschein mit den sechs richtigen Kreuzchen in der Dorfkneipe.“"
                            },
                            {
                                "example_id": "cb93db5f-cd04-4cbc-a9db-3cc459a6c419",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„22. August 2009 – Nach 87 Ziehungen wird in Italien der Jackpot in Höhe von 147,8 Mio. € geknackt. Der Lottoschein war in einer Bar im toskanischen Dorf Bagnone abgegeben worden.“"
                            },
                            {
                                "example_id": "73276ca5-a6d5-4fa6-b019-ce3f3c4cc23c",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„Der Glückspilz, der als bundesweit einziger die Gewinnzahlen 6, 22, 27, 34, 35 und 43 und die Superzahl 5 richtig auf seinem Lottoschein angekreuzt hat, kann sich über stolze 21.196.805,20 Euro freuen – das ist der größte Einzellottogewinn in Norden Deutschlands und der zweithöchste aller Zeiten.“"
                            },
                            {
                                "example_id": "ccb3ca02-f354-432a-b7de-e56d05e5c559",
                                "sense_id": "d32cb08b-d452-34df-a35d-94436b003607",
                                "text": "„11, 14, 35, 44 und 45. Plus die Zusatzzahlen 5 und 6. Diese Ziffern hatte der bisher unbekannte Gewinner auf seinem Lottoschein angekreuzt und damit am Freitag den Eurojackpot geknackt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
