                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b33a211-3fec-3bd9-80b7-364810b93c6c",
                        "entry_id": "d5869ea8-a626-3a6d-a8b9-a7508f31254b",
                        "glosses": [
                            "Son dont la fréquence est supérieure à 20 000 Hz, imperceptible par l’oreille humaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6941c0d8-c326-4302-8028-88e919c7b142",
                                "sense_id": "6b33a211-3fec-3bd9-80b7-364810b93c6c",
                                "text": "La distribution estivale du Murin des marais Myotis dasycneme dans l’ouest des Flandres a été déterminée par des prospections avec détecteur d'ultrasons et un suivi par radiolocalisation destinés à évaluer les déplacements et l’activité de chasse de l’espèce."
                            },
                            {
                                "example_id": "56597194-22fb-48d1-b5e8-3bcb5be9f4d6",
                                "sense_id": "6b33a211-3fec-3bd9-80b7-364810b93c6c",
                                "text": "J’espérais que l’écriture me donnerait à entendre ce qui m’avait échappé, ces ultrasons indéchiffrables pour des oreilles normales, comme si les heures passées à fouiller dans des caisses ou assise devant un ordinateur pouvaient me doter enfin d’une ouïe particulière, plus sensible, telle qu’en possèdent certains animaux et, je crois, les chiens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4cadd77-e86c-41ec-9a5d-f9a776489480",
                        "source_entry_id": "d5869ea8-a626-3a6d-a8b9-a7508f31254b",
                        "source_sense_id": "6b33a211-3fec-3bd9-80b7-364810b93c6c",
                        "target_lang_word": "Ultraschall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ultraschall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba7c7979-7e98-3745-a1ae-ef20d16225cf",
                                        "entry_id": "1216256e-741f-33a8-b7a9-9d8ba821d9f9",
                                        "glosses": [
                                            "Schall mit Frequenzen, die höher sind als die, die der Mensch wahrnehmen kann, ab ungefähr 20 000 Hertz"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35db792b-29d3-409d-bd54-c65cd7e6f5cc",
                                                "sense_id": "ba7c7979-7e98-3745-a1ae-ef20d16225cf",
                                                "text": "Beim Zahnarzt kann man seine Zähne mittels Ultraschall reinigen lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "233a88c2-16a8-3956-a332-314a0273691b",
                                        "entry_id": "1216256e-741f-33a8-b7a9-9d8ba821d9f9",
                                        "glosses": [
                                            "kurz für Ultraschalluntersuchung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e6f5bc1-9a33-442d-9815-e3fa215d84b0",
                                                "sense_id": "233a88c2-16a8-3956-a332-314a0273691b",
                                                "text": "Kannst du Frau Meiner zum Ultraschall bringen?"
                                            },
                                            {
                                                "example_id": "8ec23948-3af2-4842-942b-64a184519085",
                                                "sense_id": "233a88c2-16a8-3956-a332-314a0273691b",
                                                "text": "Schwangere Frauen gehen regelmäßig zum Ultraschall."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3259fa57-e36f-4c99-84eb-fcca79db44df",
                        "source_entry_id": "d5869ea8-a626-3a6d-a8b9-a7508f31254b",
                        "source_sense_id": "6b33a211-3fec-3bd9-80b7-364810b93c6c",
