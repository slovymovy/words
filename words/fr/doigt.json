{
    "word_family": [
        "doigté",
        "doigter",
        "doigtier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad9df7bd-36c5-360a-8c6d-0616bcb08cd1",
                    "sense_definition": "Chacune des parties articulées et mobiles qui terminent la main chez l'être humain.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle porte une jolie bague en argent à son <w>doigt</w>."
                        },
                        {
                            "text": "Il s'est brûlé le <w>doigt</w> en touchant le plat chaud."
                        }
                    ],
                    "common_phrases": [
                        "bout des doigts",
                        "croiser les doigts",
                        "montrer du doigt",
                        "claquer des doigts"
                    ]
                },
                {
                    "sense_id": "7c906594-3c65-34a9-adca-1d7f231ae8ca",
                    "sense_definition": "Orteil, partie articulée située à l'extrémité du pied.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me suis heurté le petit <w>doigt</w> de pied contre le lit."
                        },
                        {
                            "text": "Elle a plongé ses <w>doigts</w> de pied dans l'eau de la mer."
                        }
                    ],
                    "common_phrases": [
                        "doigt de pied"
                    ],
                    "synonyms": [
                        "orteil"
                    ]
                },
                {
                    "sense_id": "e7fa4fca-0dd5-327c-be7c-a7fd718a57b5",
                    "sense_definition": "Très petite quantité d'une boisson ou d'une matière, correspondant à peu près à la largeur d'un doigt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a seulement demandé un <w>doigt</w> de vin au fond de son verre."
                        },
                        {
                            "text": "Ajoutez un <w>doigt</w> de lait pour adoucir le café trop fort."
                        }
                    ],
                    "common_phrases": [
                        "un doigt de vin"
                    ]
                },
                {
                    "sense_id": "0c5590c5-65ec-3a41-bd96-dcd431c99624",
                    "sense_definition": "Geste d'insulte consistant à tendre le majeur vers quelqu'un ; doigt d'honneur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Énervé par les klaxons, le motard a fait un <w>doigt</w> au chauffeur."
                        },
                        {
                            "text": "Adresser un <w>doigt</w> d'honneur dans la rue est un comportement vulgaire."
                        }
                    ],
                    "common_phrases": [
                        "faire un doigt",
                        "doigt d'honneur"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "geste grossier et insultant"
                        }
                    ]
                },
                {
                    "sense_id": "fec60767-864e-3a95-b975-cff140b4e36e",
                    "sense_definition": "Partie d'un gant conçue pour envelopper un doigt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>doigt</w> de ce vieux gant en cuir est complètement troué."
                        },
                        {
                            "text": "Elle ajuste soigneusement chaque <w>doigt</w> de ses gants en laine."
                        }
                    ],
                    "common_phrases": [
                        "doigt de gant"
                    ]
                },
                {
                    "sense_id": "3605ce03-a893-3bfe-b8e0-e8143d363ece",
                    "sense_definition": "Chacune des extrémités articulées de la patte de certains animaux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>doigts</w> de cet oiseau lui permettent de s'agripper à la branche."
                        },
                        {
                            "text": "Chez le canard, les <w>doigts</w> sont reliés par une membrane palmée."
                        }
                    ]
                },
                {
                    "sense_id": "f5bd6f07-01a2-3e0a-b46c-5cf337382912",
                    "sense_definition": "Ancienne unité de mesure de longueur correspondant à l'épaisseur d'un doigt, soit environ deux centimètres.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux meuble dépasse du mur d'au moins deux <w>doigts</w>."
                        },
                        {
                            "text": "La planche a été rabotée pour lui retirer un <w>doigt</w> d'épaisseur."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "ancienne unité de mesure"
                        }
                    ]
                },
                {
                    "sense_id": "fefea744-1c2a-35c5-820a-be4f8d500b07",
                    "sense_definition": "Chacune des bananes individuelles regroupées sur une main d'un régime.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a détaché un <w>doigt</w> mûr du bouquet de bananes."
                        },
                        {
                            "text": "Chaque main de ce bananier comporte une quinzaine de <w>doigts</w> bien développés."
                        }
                    ]
                }
            ]
        }
    ]
}