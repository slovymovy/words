                        "entry_id": "495b7ef0-5c43-319c-b631-0d42dfc72091",
                        "glosses": [
                            "Lehre, die dem Machtinteresse den Vorrang gegenüber der Moral gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2fff7d-145f-4759-a76a-df93fda80679",
                                "sense_id": "4786feb4-36c5-37dd-a426-e60b77df0942",
                                "text": "„Aber der unverantwortliche Machiavellismus vieler Beteiligten sorgte dafür, daß es nicht bei halbwegs kontrollierbaren Rivalitäten blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
