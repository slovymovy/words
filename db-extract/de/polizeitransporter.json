                "senses": [
                    {
                        "sense_id": "3a8d071d-ef62-3354-aa08-70ed8a19592f",
                        "entry_id": "922bd016-fdd2-3231-a412-cec9ad8d75a2",
                        "glosses": [
                            "von der Polizei genutztes Transportfahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26eaefee-1e47-40fd-b875-0054b9f7a625",
                                "sense_id": "3a8d071d-ef62-3354-aa08-70ed8a19592f",
                                "text": "„Sommer, das heißt Spätschichten mit Schlagstock und Polizeitransportern im Western District, mit ungefähr dreihundert schweren Jungs auf der Edmondson Avenue zwischen Payson Avenue und Pulaski Highway, die einander und jeden vorbeifahrenden Streifenwagen provozierend mustern.“"
                            },
                            {
                                "example_id": "3fbd17e0-083b-4add-b3e7-d82f49ec7989",
                                "sense_id": "3a8d071d-ef62-3354-aa08-70ed8a19592f",
                                "text": "„‚Draußen steht ein Polizeitransporter. Ich hoffe, sie sind nicht wegen dir hier.‘“"
                            },
                            {
                                "example_id": "ee0e211f-dcb7-40fd-be09-b4a6ee0b0a01",
                                "sense_id": "3a8d071d-ef62-3354-aa08-70ed8a19592f",
                                "text": "„Der Cop, der die Hecktür des Polizeitransporters öffnete, konnte gerade noch die Augen schließen.“"
                            },
                            {
                                "example_id": "68589c11-054e-41e6-8bc8-d5ea3975eaa2",
                                "sense_id": "3a8d071d-ef62-3354-aa08-70ed8a19592f",
                                "text": "„Ein Polizeitransporter versperrte die Straße zur Waterfront.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
