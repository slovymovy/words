                        ]
                    },
                    {
                        "translation_id": "034b8e4f-206f-4042-a4cd-7f9184f90bc3",
                        "source_entry_id": "8c81d10d-6ca5-38fc-a030-00bbdc6cc636",
                        "source_sense_id": "070537ef-0968-33c5-b978-38ba1143ea90",
                        "target_lang_word": "uiteindelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uiteindelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ef5587e1-55b5-3571-81db-9b9d890620cd",
                                        "entry_id": "d0c30811-7103-364d-ad33-74a35654a899",
                                        "glosses": [
                                            "afsluitend, niet tussendoor maar op het eind komend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c7600de-473d-4356-830e-e8783e9a366f",
                                                "sense_id": "ef5587e1-55b5-3571-81db-9b9d890620cd",
                                                "text": "Het uiteindelijke resultaat telt."
                                            },
                                            {
                                                "example_id": "9ae56197-8e21-480c-981c-7feb20949e19",
                                                "sense_id": "ef5587e1-55b5-3571-81db-9b9d890620cd",
                                                "text": "List woonde vanaf haar zevende jaar, na omzwervingen in weeshuizen, bij Jaap en Marie List op Vlieland. Uiteindelijk nam ze ook hun achternaam aan. Tot haar achttiende verbleef ze op het Waddeneiland, om vervolgens haar geluk te beproeven in Amsterdam, waar ze tot aan haar overlijden op 78-jarige leeftijd woonde."
                                            },
                                            {
                                                "example_id": "34992e66-1873-4968-81a9-87b6b1c2e31e",
                                                "sense_id": "ef5587e1-55b5-3571-81db-9b9d890620cd",
                                                "text": "Eerder werd al bekend dat verdachte Tetsuya Yamagami wrok tegen Abe koesterde, omdat de politicus volgens hem verbonden was aan een religieuze groep. Het is niet duidelijk waarom de 41-jarige man uiteindelijk Abe als slachtoffer koos."
                                            },
                                            {
                                                "example_id": "203f85e3-fd9a-43f9-aede-89b5d3a56b64",
                                                "sense_id": "ef5587e1-55b5-3571-81db-9b9d890620cd",
                                                "text": "Ook staten als Californië en Louisiana die vanwege bosbranden, aardbevingen en overstromingen ook als risicovol zijn aangemerkt, zien het aanbod van verzekeringsmaatschappijen snel afnemen. Dat leidt tot stijgende prijzen en steeds minder keuzevrijheid voor huiseigenaren, die het soms niet meer kunnen opbrengen in een bepaald gebied te wonen en uiteindelijk ook vertrekken."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uiteindelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1a6f6d-63be-3e8b-a2a9-2330195ce71a",
                                        "entry_id": "c9089f6f-a1ab-303e-baca-2d02693e2348",
                                        "glosses": [
                                            "na een hele tijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a43371-f8a3-43c8-99ed-d9274961816c",
                                                "sense_id": "5e1a6f6d-63be-3e8b-a2a9-2330195ce71a",
                                                "text": "Uiteindelijk zal het hem wel lukken."
                                            },
                                            {
                                                "example_id": "c4b3f404-4f08-4138-af3b-900a86bfb886",
                                                "sense_id": "5e1a6f6d-63be-3e8b-a2a9-2330195ce71a",
                                                "text": "Meteen na de start, meldde ze zich vooraan, pal achter Can, en pal voor Grøvdal en de Zwitserse Fabienne Schlumpf. Maar gaandeweg begon ze van vermoeidheid te trekkebekken en kort daarop groeide het gat met de koplopers, Can, Schlumpf en uiteindelijk ook de Noorse."
                                            },
                                            {
                                                "example_id": "a1d436a0-67ff-4daa-ae00-85829a4fb5e9",
                                                "sense_id": "5e1a6f6d-63be-3e8b-a2a9-2330195ce71a",
                                                "text": "De Slag om de Schelde was hierbij heel belangrijk. Soldaten uit Canada, Groot-Brittannië en Polen vochten vijf weken lang tegen soldaten uit Duitsland. Het was heel zwaar maar uiteindelijk wonnen ze. Dit werd afgelopen weekend herdacht in Terneuzen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71d9c29a-761e-49d3-ac69-689ce5025af8",
                        "source_entry_id": "8c81d10d-6ca5-38fc-a030-00bbdc6cc636",
                        "source_sense_id": "070537ef-0968-33c5-b978-38ba1143ea90",
                        "target_lang_word": "в конце концов",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "в конце концов",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "773bb84c-c270-3c62-bfa1-6b7e680bc9e0",
                                        "entry_id": "749913b5-a6cb-3129-ba00-b873fea5eeea",
                                        "glosses": [
                                            "в результате, в итоге"
                                        ],
                                        "tags": [
                                            "нареч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8574d75-36f7-452b-a64b-e9f292ef9b8b",
                                                "sense_id": "773bb84c-c270-3c62-bfa1-6b7e680bc9e0",
                                                "text": "Я всё ещё сидел у костра, но в конце концов поборол своё волнение и улёгся спать."
                                            },
                                            {
                                                "example_id": "21ec637d-221a-4b20-aa24-fb999c286ed0",
                                                "sense_id": "773bb84c-c270-3c62-bfa1-6b7e680bc9e0",
                                                "text": "В конце концов мы договорились, что через месяц поедем на Новую Землю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f76b8ad8-196a-3059-8abe-fd9ee1680f61",
                                        "entry_id": "749913b5-a6cb-3129-ba00-b873fea5eeea",
                                        "glosses": [
                                            "вводн. сл. выражает недовольство, нетерпение, раздражение или указывает на то, что соотносящееся с ним высказывание является заключительным"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753ef2e8-2e07-4437-9a44-7859784e9381",
                                                "sense_id": "f76b8ad8-196a-3059-8abe-fd9ee1680f61",
                                                "text": "Это нахальство! Это чёрт знает что такое! Мне это надоело, в конце концов. Сейчас же подать сюда всех лошадей!"
                                            },
                                            {
                                                "example_id": "927ad1a3-cdf8-492a-85f5-f26a2c503d73",
                                                "sense_id": "f76b8ad8-196a-3059-8abe-fd9ee1680f61",
                                                "text": "В конце концов, может, и хорошо, что разрушил: одиночество тоже с каких-то пор перестало быть для него спасением, как не было им и многолюдье."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
