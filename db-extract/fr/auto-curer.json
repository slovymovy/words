                    },
                    {
                        "sense_id": "b2e97979-2f34-39b0-9878-9453d030fcdf",
                        "entry_id": "d4bc6a0f-967e-34f2-8f25-766d37cc2a36",
                        "glosses": [
                            "Se curer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "27d60d71-894a-4426-815c-9fa5550cdf33",
                                "sense_id": "b2e97979-2f34-39b0-9878-9453d030fcdf",
                                "text": "Les inondations permettent aussi d'auto-curer le fond des cours d'eau ce qui est bénéfique pour les poissons et les amphibiens."
                            },
                            {
                                "example_id": "3dc79497-2053-492d-938c-278e750c1d91",
                                "sense_id": "b2e97979-2f34-39b0-9878-9453d030fcdf",
                                "text": "Faut apprendre à s'auto-curer c'est comme les maladies, faut éviter de tout de suite sauter les médocs et laisser le corps se démerder."
                            }
                        ]
                    }
